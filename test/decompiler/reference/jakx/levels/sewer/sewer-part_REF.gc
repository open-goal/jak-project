;; definition for function spt-func-birth-on-height-die-drip-sewer
;; INFO: Used lq/sq
;; WARN: Return type mismatch (pointer process) vs none.
(defun spt-func-birth-on-height-die-drip-sewer ((arg0 sparticle-system) (arg1 sparticle-cpuinfo) (arg2 sparticle-launchinfo))
  (let ((f1-0 (-> arg1 key 0 origin trans y))
        (f2-0 (-> arg1 omega))
        )
    (when (< (-> arg2 launchrot y) (+ f1-0 f2-0))
      (sp-kill-particle arg0 arg1)
      (let ((v1-3 (make-sound-instance (-> *sound-info* 465) 0 (the-as handle #f))))
        (cond
          (v1-3
            (let ((a0-2 (-> v1-3 trans))
                  (a1-2 (new 'stack-no-clear 'vector))
                  )
              (set! (-> a1-2 x) (-> arg2 launchrot x))
              (set! (-> a1-2 y) (-> arg2 launchrot y))
              (set! (-> a1-2 z) (-> arg2 launchrot z))
              (set! (-> a1-2 w) 1.0)
              (set! (-> a0-2 quad) (-> a1-2 quad))
              )
            (logior! (-> v1-3 flags) 96)
            (-> v1-3 id)
            )
          (else
            0
            )
          )
        )
      (when (rand-vu-percent? 1.0)
        (let ((v1-7 (-> *launch-matrix* trans))
              (a0-6 (new 'stack-no-clear 'vector))
              )
          (set! (-> a0-6 x) (-> arg2 launchrot x))
          (set! (-> a0-6 y) (-> arg2 launchrot y))
          (set! (-> a0-6 z) (-> arg2 launchrot z))
          (set! (-> a0-6 w) 1.0)
          (set! (-> v1-7 quad) (-> a0-6 quad))
          )
        (set! (-> *part-tracker-params-default* group) (-> *part-group-id-table* 458))
        (vector-reset! (-> *part-tracker-params-default* local-offset))
        (set! (-> *part-tracker-params-default* duration) (the-as uint 0))
        (set! (-> *part-tracker-params-default* callback) #f)
        (set! (-> *part-tracker-params-default* userdata) (the-as uint #f))
        (set! (-> *part-tracker-params-default* target) #f)
        (set! (-> *part-tracker-params-default* mat-joint) *launch-matrix*)
        (set! (-> *part-tracker-params-default* local-space-param) 0)
        (set! (-> *part-tracker-params-default* local-space-callback) #f)
        (set! (-> *part-tracker-params-default* subsampler-num) 1.0)
        *part-tracker-params-default*
        (if (logtest? (-> *part-group-id-table* 458 flags) (sp-group-flag sp13))
            (process-spawn
              part-tracker-subsampler
              :init part-tracker-subsampler-init
              *part-tracker-params-default*
              :name "part-tracker-subsampler"
              :to *entity-pool*
              :unk 0
              )
            (process-spawn
              part-tracker
              :init part-tracker-init
              *part-tracker-params-default*
              :name "part-tracker"
              :to *entity-pool*
              :unk 0
              )
            )
        )
      )
    )
  (none)
  )


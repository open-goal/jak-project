(in-package goal)

;; definition of type drome-tunnel-drum
(deftype drome-tunnel-drum (process-drawable)
  ((sound-id  uint32)
   )
  (:state-methods
    idle
    )
  )

;; definition for method 3 of type drome-tunnel-drum
(defmethod inspect ((this drome-tunnel-drum))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type process-drawable inspect)))
    (t9-0 this)
    )
  (format #t "~2Tsound-id: ~D~%" (-> this sound-id))
  (label cfg-4)
  this
  )

;; failed to figure out what this is:

;; definition for method 45 of type kras-pump-break
(defmethod in-vis? ((this kras-pump-break))
  (new 'stack-no-clear 'vector)
  (let ((v1-2 (-> this entity extra)))
    (-> v1-2 level)
    (new 'stack-no-clear 'vector)
    (if (-> this level all-visible?)
        (vis-dist-ok? (-> this entity trans) (-> v1-2 vis-dist))
        (vis-cull-all? (-> this level) (-> v1-2 vis-id))
        )
    )
  )

;; failed to figure out what this is:
(defstate idle (kras-pump-break)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('explode)
       (let ((gp-0 (alloc-msg self 'explode)))
         (send-msg self gp-0 -2 64)
         (free-msg self gp-0)
         )
       (let ((v0-0 #t))
         (set! (-> self exploded) v0-0)
         v0-0
         )
       )
      )
    )
  :code sleep-code
  :post (behavior ()
    (cond
      ((and (in-vis? self) (not (handle->process (-> self drawable))))
       (spawn-drawable self)
       )
      ((and (not (in-vis? self)) (handle->process (-> self drawable)))
       (kill-drawable self)
       )
      )
    )
  )


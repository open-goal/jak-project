(defstate explode (kras-pump-break-draw)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('touched)
       (let ((s4-0 (-> block param 0)))
         (send-event proc 'set 'wheel-fire)
         (let ((s5-0
                 (new 'static 'attack-info :mask (attack-mask attacker id damage vehicle-damage-factor vehicle-impulse-factor))
                 )
               )
           (let* ((v1-6 *game-info*)
                  (a0-6 (+ (-> v1-6 attack-id) 1))
                  )
             (set! (-> v1-6 attack-id) a0-6)
             (set! (-> s5-0 id) a0-6)
             )
           (set! (-> s5-0 damage) 2.0)
           (set! (-> s5-0 vehicle-damage-factor) 1.0)
           (set! (-> s5-0 vehicle-impulse-factor) 1.0)
           (set! (-> s5-0 attacker) (process->handle self))
           (send-event proc 'attack s4-0 s5-0)
           (if (nonzero? (-> s5-0 attacker))
               (send-event (handle->process (-> s5-0 attacker)) 'you-attacked 'attack proc s5-0)
               )
           )
         )
       )
      (('go-die)
       (go empty-state)
       )
      )
    0
    )
  :enter (behavior ()
    (call-parent-state-handler enter)
    (setup-masks (-> self draw) 1 2)
    (let ((v1-5 (make-sound-instance snd-gas-pump-flame (new 'static 'sound-id) (the-as handle #f))))
      (set! (-> self flame-sound) (the-as sound-id (if v1-5
                                                       (the-as int (-> v1-5 id))
                                                       0
                                                       )
                                          )
            )
      )
    (let ((v1-9 (the-as (inline-array collide-shape-prim-mesh) (&+ (-> self root root-prim) 80))))
      (set! (-> v1-9 0 prim-core collide-as) (collide-spec))
      (set! (-> v1-9 1 prim-core collide-as) (collide-spec))
      (set! (-> v1-9 2 prim-core collide-as) (collide-spec obstacle camera-blocker pusher))
      (set! (-> v1-9 3 prim-core collide-as) (collide-spec obstacle camera-blocker pusher))
      (set! (-> v1-9 4 prim-core collide-as) (collide-spec obstacle camera-blocker pusher))
      (set! (-> v1-9 5 prim-core collide-as) (collide-spec obstacle camera-blocker pusher))
      )
    )
  :exit (behavior ()
    (sound-stop (-> self flame-sound) #t)
    )
  :code sleep-code
  :post (behavior ()
    (if (nonzero? (-> self part))
        (spawn-from-mat (-> self part) (-> self node-list data 3 bone transform))
        )
    )
  )

;; definition for method 64 of type kras-pump-break-draw
;; WARN: Return type mismatch (pointer process) vs none.
(defmethod spawn-debris-and-parts ((this kras-pump-break-draw))
  (let ((v1-1 (make-sound-instance snd-gas-pump-break (new 'static 'sound-id) (the-as handle #f))))
    (if v1-1
        (-> v1-1 id)
        0
        )
    )
  (let ((a1-2 (new 'stack 'debris-tuning (the-as uint 0))))
    (set! (-> a1-2 scale-rand-lo) 1.0)
    (set! (-> a1-2 scale-rand-hi) 2.0)
    (set-vector! (-> a1-2 fountain-rand-transv-lo) -122880.0 122880.0 -122880.0 1.0)
    (vector+! (-> a1-2 fountain-rand-transv-lo) (-> a1-2 fountain-rand-transv-lo) (-> this impact-velocity))
    (set-vector! (-> a1-2 fountain-rand-transv-hi) 122880.0 368640.0 122880.0 1.0)
    (vector+! (-> a1-2 fountain-rand-transv-hi) (-> a1-2 fountain-rand-transv-hi) (-> this impact-velocity))
    (set! (-> a1-2 fountain-rand-transv-hi w) 16384.0)
    (set! (-> a1-2 duration) (the-as uint 1200))
    (debris-spawn this a1-2 *kras-pump-debris-params* (the-as process-drawable #f))
    )
  (set! (-> *part-tracker-params-default* group) (-> *part-group-id-table* 394))
  (vector-reset! (-> *part-tracker-params-default* local-offset))
  (set! (-> *part-tracker-params-default* duration) (the-as uint 1500))
  (set! (-> *part-tracker-params-default* callback) #f)
  (set! (-> *part-tracker-params-default* userdata) (the-as uint #f))
  (set! (-> *part-tracker-params-default* target) #f)
  (set! (-> *part-tracker-params-default* mat-joint) (-> this node-list data 3 bone transform))
  (set! (-> *part-tracker-params-default* local-space-param) 0)
  (set! (-> *part-tracker-params-default* local-space-callback) #f)
  (set! (-> *part-tracker-params-default* subsampler-num) 1.0)
  *part-tracker-params-default*
  (if (logtest? (-> *part-group-id-table* 394 flags) (sp-group-flag sp13))
      (process-spawn
        part-tracker-subsampler
        :init part-tracker-subsampler-init
        *part-tracker-params-default*
        :name "part-tracker-subsampler"
        :to *entity-pool*
        :unk 0
        )
      (process-spawn
        part-tracker
        :init part-tracker-init
        *part-tracker-params-default*
        :name "part-tracker"
        :to *entity-pool*
        :unk 0
        )
      )
  (none)
  )


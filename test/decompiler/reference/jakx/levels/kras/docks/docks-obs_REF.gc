;;-*-Lisp-*-
(in-package goal)

;; definition of type wind-rotor
(deftype wind-rotor (process-drawable)
  ()
  (:state-methods
    idle
    )
  )

;; definition for method 3 of type wind-rotor
(defmethod inspect ((this wind-rotor))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type process-drawable inspect)))
    (t9-0 this)
    )
  (label cfg-4)
  this
  )

;; failed to figure out what this is:
(defskelgroup skel-wind-rotor wind-rotor wind-rotor-lod0-jg wind-rotor-spin-ja
              ((wind-rotor-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 0 0 40)
              :origin-joint-index 3
              )

;; definition for method 11 of type wind-rotor
(defmethod init-from-entity! ((this wind-rotor) (arg0 entity-actor))
  (logior! (-> this mask) (process-mask actor-pause))
  (stack-size-set! (-> this main-thread) 32)
  (set! (-> this root) (new 'process 'trsqv))
  (process-drawable-from-entity! this arg0)
  (process-drawable-method-42
    this
    (art-group-get-by-name *level* "skel-wind-rotor" (the-as (pointer level) #f))
    0
    )
  (go (method-of-object this idle))
  )

;; failed to figure out what this is:
(defstate idle (wind-rotor)
  :virtual #t
  :code (behavior ()
    (let* ((f30-0 65536.0)
           (v1-2 (/ (the-as int (rand-uint31-gen *random-generator*)) 256))
           (v1-3 (the-as number (logior #x3f800000 v1-2)))
           (f0-3 (* f30-0 (+ -1.0 (the-as float v1-3))))
           )
      (quaternion-rotate-z! (the-as quaternion (-> self root rot)) (the-as quaternion (-> self root rot)) f0-3)
      )
    (until #f
      (quaternion-rotate-z!
        (the-as quaternion (-> self root rot))
        (the-as quaternion (-> self root rot))
        (* 16384.0 (seconds-per-frame))
        )
      (suspend)
      )
    #f
    )
  :post ja-post
  )





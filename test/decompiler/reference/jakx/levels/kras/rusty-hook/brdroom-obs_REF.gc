    )
  )

;; definition for method 3 of type brd-pool-water
(defmethod inspect ((this brd-pool-water))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type process-drawable inspect)))
    (t9-0 this)
    )
  (label cfg-4)
  this
  )


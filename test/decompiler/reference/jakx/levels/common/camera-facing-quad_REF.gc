;;-*-Lisp-*-
(in-package goal)

;; definition of type camera-facing-quad
(deftype camera-facing-quad (prim-client)
  ((pos     vector  :inline)
   (height  float)
   (width   float)
   (strip   prim-strip)
   (color   rgba)
   )
  (:methods
    (camera-facing-quad-method-10 (_type_ texture-id) texture-id)
    (camera-facing-quad-method-11 (_type_) connection)
    (camera-facing-quad-method-12 (_type_ prim-strip vector rgba float float) none)
    (camera-facing-quad-method-13 (_type_ vector float float rgba) rgba)
    )
  )

;; definition for method 3 of type camera-facing-quad
(defmethod inspect ((this camera-facing-quad))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this (-> this type))
  (format #t "~1Tpos: #<vector @ #x~X>~%" (-> this pos))
  (format #t "~1Theight: ~f~%" (-> this height))
  (format #t "~1Twidth: ~f~%" (-> this width))
  (format #t "~1Tstrip: ~A~%" (-> this strip))
  (format #t "~1Tcolor: ~D~%" (-> this color))
  (label cfg-4)
  this
  )

;; definition for method 13 of type camera-facing-quad
;; INFO: Used lq/sq
(defmethod camera-facing-quad-method-13 ((this camera-facing-quad) (arg0 vector) (arg1 float) (arg2 float) (arg3 rgba))
  (set! (-> this pos quad) (-> arg0 quad))
  (set! (-> this width) arg1)
  (set! (-> this height) arg2)
  (set! (-> this color) arg3)
  arg3
  )

;; definition for method 12 of type camera-facing-quad
;; INFO: Used lq/sq
;; WARN: Return type mismatch int vs none.
(defmethod camera-facing-quad-method-12 ((this camera-facing-quad) (arg0 prim-strip) (arg1 vector) (arg2 rgba) (arg3 float) (arg4 float))
  (let ((v1-3 (-> arg0 data (-> arg0 num-verts))))
    (set! (-> v1-3 pos quad) (-> arg1 quad))
    (set! (-> v1-3 col) arg2)
    (set! (-> v1-3 stq x) arg3)
    (set! (-> v1-3 stq y) arg4)
    )
  (+! (-> arg0 num-verts) 1)
  0
  (none)
  )

;; definition for method 10 of type camera-facing-quad
(defmethod camera-facing-quad-method-10 ((this camera-facing-quad) (arg0 texture-id))
  (set! (-> this strip) (new 'process 'prim-strip 4 (the-as texture-id texture-id) (the-as string #f)))
  (set! (-> this strip texture-index) 7)
  (set! (-> this strip level) (-> *level* level-default))
  (set! (-> this strip tex-id) arg0)
  arg0
  )

;; definition for method 9 of type camera-facing-quad
;; INFO: Used lq/sq
;; WARN: Function (method 9 camera-facing-quad) has a return type of none, but the expression builder found a return statement.
(defmethod prim-client-method-9 ((this camera-facing-quad))
  (rlet ((vf0 :class vf)
         (vf4 :class vf)
         (vf5 :class vf)
         (vf6 :class vf)
         )
    (init-vf0-vector)
    (clear-strip (-> this strip))
    (set! (-> this strip alpha) (new 'static 'gs-alpha :b #x2 :d #x1))
    (set! (-> this strip clamp) (new 'static 'gs-clamp))
    (if (< (-> this strip allocated-num-verts) (-> this strip num-verts))
        (return #f)
        )
    (let ((s5-0 (new 'stack-no-clear 'camera-facing-quad-stackvar0)))
      (matrix-copy! (-> s5-0 mat) (-> (view-get-active-math-camera) inv-camera-rot))
      (set! (-> s5-0 vecs 0 quad) (-> s5-0 mat rvec quad))
      (set! (-> s5-0 vecs 1 quad) (-> (new 'static 'vector :y 1.0 :w 1.0) quad))
      (let ((v1-9 (-> this pos)))
        (let ((f1-0 (-> this height))
              (f0-0 (-> this width))
              )
          (vector-float*! (-> s5-0 vecs 2) (-> s5-0 vecs 0) (- (/ f0-0 2)))
          (vector+float*! (-> s5-0 vecs 2) (-> s5-0 vecs 2) (-> s5-0 vecs 1) (/ f1-0 2))
          (vector+float*! (-> s5-0 vecs 3) (-> s5-0 vecs 2) (-> s5-0 vecs 1) (- f1-0))
          (vector+float*! (-> s5-0 vecs 4) (-> s5-0 vecs 2) (-> s5-0 vecs 0) f0-0)
          (vector+float*! (-> s5-0 vecs 5) (-> s5-0 vecs 3) (-> s5-0 vecs 0) f0-0)
          )
        (let ((a2-7 (-> s5-0 vecs 2)))
          (let ((a0-20 (-> s5-0 vecs 2))
                (a1-6 v1-9)
                )
            (.lvf vf4 (&-> a0-20 quad))
            (.lvf vf5 (&-> a1-6 quad))
            )
          (.mov.vf.w vf6 vf0)
          (.add.vf.xyz vf6 vf4 vf5)
          (.svf (&-> a2-7 quad) vf6)
          )
        (let ((a2-8 (-> s5-0 vecs 3)))
          (let ((a0-21 (-> s5-0 vecs 3))
                (a1-7 v1-9)
                )
            (.lvf vf4 (&-> a0-21 quad))
            (.lvf vf5 (&-> a1-7 quad))
            )
          (.mov.vf.w vf6 vf0)
          (.add.vf.xyz vf6 vf4 vf5)
          (.svf (&-> a2-8 quad) vf6)
          )
        (let ((a2-9 (-> s5-0 vecs 4)))
          (let ((a0-22 (-> s5-0 vecs 4))
                (a1-8 v1-9)
                )
            (.lvf vf4 (&-> a0-22 quad))
            (.lvf vf5 (&-> a1-8 quad))
            )
          (.mov.vf.w vf6 vf0)
          (.add.vf.xyz vf6 vf4 vf5)
          (.svf (&-> a2-9 quad) vf6)
          )
        (let ((a1-9 (-> s5-0 vecs 5)))
          (.lvf vf4 (&-> (-> s5-0 vecs 5) quad))
          (.lvf vf5 (&-> v1-9 quad))
          (.mov.vf.w vf6 vf0)
          (.add.vf.xyz vf6 vf4 vf5)
          (.svf (&-> a1-9 quad) vf6)
          )
        )
      (let ((s4-1 (-> this strip))
            (s3-0 (-> this color))
            )
        (camera-facing-quad-method-12 this s4-1 (-> s5-0 vecs 2) s3-0 0.0 0.0)
        (camera-facing-quad-method-12 this s4-1 (-> s5-0 vecs 3) s3-0 0.0 1.0)
        (camera-facing-quad-method-12 this s4-1 (-> s5-0 vecs 4) s3-0 1.0 0.0)
        (camera-facing-quad-method-12 this s4-1 (-> s5-0 vecs 5) s3-0 1.0 1.0)
        )
      )
    (none)
    )
  )

;; definition for method 11 of type camera-facing-quad
(defmethod camera-facing-quad-method-11 ((this camera-facing-quad))
  (with-pp
    (add-connection *prim-client-engine* pp #f pp this #f)
    )
  )

;; definition for method 7 of type camera-facing-quad
;; WARN: Return type mismatch prim-client vs camera-facing-quad.
(defmethod relocate ((this camera-facing-quad) (offset int))
  (if (nonzero? (-> this strip))
      (&+! (-> this strip) offset)
      )
  (the-as camera-facing-quad ((method-of-type prim-client relocate) this offset))
  )





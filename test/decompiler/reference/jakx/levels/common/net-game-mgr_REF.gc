;;-*-Lisp-*-
(in-package goal)

;; definition for symbol *intro-hud-view*, type (array hud-item)
(define *intro-hud-view*
  (new 'static 'boxed-array :type hud-item
    (new 'static 'hud-place-event
      :alpha #xff
      :width #x1e2
      :height #x182
      :scale #x100
      :flags (hud-item-flag fullscreen)
      :effect #f
      :items (new 'static 'boxed-array :type hud-item
        (new 'static 'hud-localized-string
          :alpha #xff
          :position-y 50
          :width #x15e
          :height 32
          :zval #xfff0
          :scale #x166
          :flags (hud-item-flag center-x bit10 bit17)
          :effect (new 'static 'hud-effect-group
            :items (new 'static 'boxed-array :type hud-effect
              (new 'static 'hud-effect-font-effect :message 'enter :delay #x96 :font-effect #xd)
              (new 'static 'hud-effect-offscreen :message 'enter :delay #x96)
              (new 'static 'hud-effect-font-effect :message 'exit :font-effect #xc)
              )
            )
          :color #x36
          :font-flags (hud-string-flag middle)
          :has-outline #t
          )
        (new 'static 'hud-localized-string
          :alpha #xff
          :position-y -50
          :width #x15e
          :height 32
          :zval #xfff0
          :scale #x166
          :flags (hud-item-flag center-x align-bottom bit17)
          :effect (new 'static 'hud-effect-group
            :items (new 'static 'boxed-array :type hud-effect
              (new 'static 'hud-effect-font-effect :message 'enter :delay #x12c :font-effect #x11)
              (new 'static 'hud-effect-offscreen :message 'enter :delay #x12c)
              (new 'static 'hud-effect-font-effect :message 'exit :font-effect #xc)
              )
            )
          :color #x36
          :font-flags (hud-string-flag middle)
          :has-outline #t
          )
        (new 'static 'hud-item-string
          :alpha #xff
          :position-y -20
          :width #x12c
          :height 32
          :zval #xfff0
          :scale #x99
          :flags (hud-item-flag center-x align-bottom)
          :effect (new 'static 'hud-effect-group
            :items (new 'static 'boxed-array :type hud-effect
              (new 'static 'hud-effect-font-effect :message 'enter :delay #x12c :font-effect #x12)
              (new 'static 'hud-effect-offscreen :message 'enter :delay #x12c)
              (new 'static 'hud-effect-font-effect :message 'exit :font-effect #xc)
              )
            )
          :font-effect #x8
          :color #x38
          :font-flags (hud-string-flag middle)
          :has-outline #t
          )
        (new 'static 'hud-item-string
          :alpha #xff
          :position-y 20
          :width #x12c
          :height 32
          :zval #xfff0
          :scale #x99
          :flags (hud-item-flag bit8 bit10)
          :effect (new 'static 'hud-effect-group
            :items (new 'static 'boxed-array :type hud-effect
              (new 'static 'hud-effect-font-effect :message 'enter :delay #x12c :font-effect #x12)
              (new 'static 'hud-effect-offscreen :message 'enter :delay #x12c)
              (new 'static 'hud-effect-font-effect :message 'exit :font-effect #xc)
              )
            )
          :font-effect #x8
          :color #x38
          :has-outline #t
          )
        (new 'static 'hud-item-string
          :alpha #xff
          :position-y 20
          :width #x12c
          :height 32
          :zval #xfff0
          :scale #x99
          :flags (hud-item-flag center-x bit10)
          :effect (new 'static 'hud-effect-group
            :items (new 'static 'boxed-array :type hud-effect
              (new 'static 'hud-effect-font-effect :message 'enter :delay #x12c :font-effect #x12)
              (new 'static 'hud-effect-offscreen :message 'enter :delay #x12c)

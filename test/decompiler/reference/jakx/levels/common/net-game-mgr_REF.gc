;; definition for function set-battle-camera-matrix
;; INFO: Used lq/sq
;; WARN: Return type mismatch int vs object.
(defbehavior set-battle-camera-matrix camera-slave ((arg0 vector) (arg1 quaternion) (arg2 symbol) (arg3 float) (arg4 float) (arg5 float))
  (let ((s3-0 (new 'stack-no-clear 'inline-array 'matrix 2)))
    (quaternion->matrix (-> s3-0 0) arg1)
    (set! (-> s3-0 0 trans quad) (-> arg0 quad))
    (set-vector! (-> s3-0 1 fvec) 0.0 (* arg3 (sin arg4)) (- (* arg3 (cos arg4))) 1.0)
    (vector-matrix*! (-> s3-0 1 uvec) (-> s3-0 1 fvec) (-> s3-0 0))
    (vector-! (-> s3-0 1 rvec) arg0 (-> s3-0 1 uvec))
    (vector-normalize! (-> s3-0 1 rvec) 1.0)
    (forward-down->inv-matrix (-> s3-0 0) (-> s3-0 1 rvec) (new 'static 'vector :y -1.0 :w 1.0))
    (let ((s2-1 (new 'stack-no-clear 'inline-array 'quaternion 2)))
      (matrix->quaternion (-> s2-1 1) (-> s3-0 0))
      (matrix->quaternion (-> s2-1 0) (-> self tracking inv-mat))
      (quaternion-copy! (-> s2-1 0) (-> s2-1 1))
      (quaternion->matrix (-> self tracking inv-mat) (-> s2-1 0))
      )
    )
  (vector+float*! (-> self trans) arg0 (-> self tracking inv-mat fvec) (- arg3))
  (+! (-> self trans y) arg5)
  0
  )

;; definition for function cam-battle-intro-player-update
;; INFO: Used lq/sq
;; WARN: Return type mismatch int vs object.
(defbehavior cam-battle-intro-player-update camera-slave ((arg0 float) (arg1 vehicle) (arg2 symbol))
  (let ((s5-0 (new 'stack-no-clear 'inline-array 'quaternion 1)))
    (quaternion-copy! (-> s5-0 0) (-> arg1 root rotation))
    (let ((f30-0 (square arg0)))
      (quaternion-rotate-y! (-> s5-0 0) (-> s5-0 0) (* 47331.555 arg0))
      (quaternion->matrix (-> self tracking inv-mat) (-> s5-0 0))
      (let ((s3-0 (new 'stack-no-clear 'inline-array 'vector 1)))
        (set! (-> s3-0 0 quad) (-> self tracking inv-mat fvec quad))
        (set! (-> s3-0 0 y) 0.0)
        (vector-normalize! (-> s3-0 0) 1.0)
        (quaternion-look-at! (-> s5-0 0) (-> s3-0 0) *up-vector*)
        )
      (if (demo?)
          (set-battle-camera-matrix
            (-> arg1 root trans)
            (-> s5-0 0)
            #f
            (+ 53248.0 (* -12288.0 arg0))
            (+ 2366.578 (* 910.2222 f30-0))
            (+ 12288.0 (* -8192.0 f30-0))
            )
          (set-battle-camera-matrix
            (-> arg1 root trans)
            (-> s5-0 0)
            #f
            (+ 53248.0 (* -28672.0 arg0))
            (+ 2366.578 (* 2184.5334 f30-0))
            (+ 12288.0 (* -20480.0 f30-0))
            )
          )
      )
    )
  0
  )

;; definition for function cam-battle-intro-update
;; WARN: Return type mismatch int vs object.
(defbehavior cam-battle-intro-update camera-slave ((arg0 time-frame) (arg1 vector) (arg2 vector))
  (let ((s5-0 (new 'stack-no-clear 'inline-array 'quaternion 1))
        (f30-0 (* 0.00095238094 (the float arg0)))
        )
    (quaternion-look-at! (-> s5-0 0) arg2 *up-vector*)
    (cond
      ((demo?)
       (quaternion-rotate-y! (-> s5-0 0) (-> s5-0 0) (+ 18204.445 (* 32768.0 f30-0)))
       (set-battle-camera-matrix arg1 (-> s5-0 0) #f 49152.0 2730.6667 4096.0)
       )
      (else
        (quaternion-rotate-y! (-> s5-0 0) (-> s5-0 0) (+ 27306.666 (* 8192.0 f30-0)))
        (set-battle-camera-matrix arg1 (-> s5-0 0) #f 40960.0 2730.6667 4096.0)
        )
      )
    )
  0
  )

;; definition for function update-framing
;; WARN: Return type mismatch float vs object.
(defbehavior update-framing camera-slave ((arg0 int))
  (when *net-game-mgr*
    (let ((f30-0
            (fmax 0.0 (fmin 1.0 (* 0.0016666667 (the float (- (- (- (if *net-mgr*
                                                                        (-> *net-mgr* game-state time)
                                                                        0
                                                                        )
                                                                    (if *net-world*
                                                                        (-> *net-world* net-state game-start-time)
                                                                        0
                                                                        )
                                                                    )
                                                                 (if *net-world*
                                                                     (-> *net-world* net-state total-pause-time)
                                                                     0
                                                                     )
                                                                 )
                                                              (- (-> *net-game-mgr* intro-end-time) (+ arg0 900))
                                                              )
                                                     )
                                   )
                            )
                  )
            )
          )
      (if (< (- (-> *net-game-mgr* intro-end-time) (- (- (if *net-mgr*
                                                             (-> *net-mgr* game-state time)
                                                             0
                                                             )
                                                         (if *net-world*
                                                             (-> *net-world* net-state game-start-time)
                                                             0
                                                             )
                                                         )
                                                      (if *net-world*
                                                          (-> *net-world* net-state total-pause-time)
                                                          0
                                                          )
                                                      )
                )
             300
             )
          (send-event (handle->process (-> self intro-handle)) 'kill-hud 0)
          )
      (cond
        ((zero? (-> *viewport-array* mode))
         (set-setting! 'letterbox 'abs (* 0.5 (- 1.0 f30-0)) 0)
         )
        ((< f30-0 1.0)
         (set-setting! 'letterbox 'abs 0.01 0)
         )
        (else
          (set-setting! 'letterbox 'abs 0.0 0)
          )
        )
      )
    (let ((f30-1
            (fmax 0.0 (fmin 1.0 (* 0.0016666667 (the float (- (- (- (if *net-mgr*
                                                                        (-> *net-mgr* game-state time)
                                                                        0
                                                                        )
                                                                    (if *net-world*
                                                                        (-> *net-world* net-state game-start-time)
                                                                        0
                                                                        )
                                                                    )
                                                                 (if *net-world*
                                                                     (-> *net-world* net-state total-pause-time)
                                                                     0
                                                                     )
                                                                 )
                                                              (- (-> *net-game-mgr* intro-end-time) (+ arg0 1080))
                                                              )
                                                     )
                                   )
                            )
                  )
            )
          )
      (if (< 0.0 f30-1)
          (set! (-> self fov)
                (lerp (-> self fov) (-> (the-as camera-master (view-get-active-camera)) settings fov) (/ f30-1 20))
                )
          (set! (-> self fov) 10922.667)
          )
      )
    )
  )

;; definition for method 71 of type net-game-mgr
(defmethod get-counter-texture ((this net-game-mgr))
  (get-texture hud-team-deathmatch-counter-01 level-default-minimap)
  )

;; definition for function do-battle-intro
;; WARN: Return type mismatch symbol vs object.

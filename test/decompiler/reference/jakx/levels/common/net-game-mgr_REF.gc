;; definition for method 61 of type net-game-mgr
;; WARN: Return type mismatch int vs none.
(defmethod finish-game ((this net-game-mgr) (arg0 symbol))
  (set! (-> this scheduled-finish-mode) arg0)
  (case arg0
    (('finish)
     (sort-players this #f)
     (if (= (if *net-mgr*
                (-> *net-mgr* game-state local-machine-idx)
                0
                )
            (-> *net-mgr* game-state session-master-idx)
            )
         (generate-random-player-stats this)
         )
     (when (if (= (/ (-> this sorted-ids-s8 0) 2) (if *net-mgr*
                                                      (-> *net-mgr* game-state local-machine-idx)
                                                      0
                                                      )
                  )
               #t
               #f
               )
       )
     (set! (-> *net-world* net-state green-room-stats scheduled-finish-time) (-> this scheduled-finish-time))
     (send-event *net-world* 'green-room-stats-update)
     (end-of-race-start-preload)
     (set-time! (-> this state-time))
     )
    (('abort)
     (set! (-> *game-info* playing-grand-prix?) #f)
     (set! (-> this scheduled-finish-time) 0)
     0
     )
    (('restart)
     (set! (-> this scheduled-finish-time) 0)
     0
     )
    )
  (set-setting! 'event-finished? #t 0.0 0)
  (send-event (handle->process (-> this stats-hud 0)) 'hide-and-die)
  (send-event (handle->process (-> this stats-hud 1)) 'hide-and-die)
  (post-game-clan-stats-adjust arg0)
  (when (if (= (/ (* (if *net-mgr*
                         (-> *net-mgr* game-state local-machine-idx)
                         0
                         )
                     2
                     )

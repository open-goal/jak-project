      (send-event (handle->process (-> this hud-player-indicators s5-0)) 'hide-and-die)
      (set! (-> this hud-player-indicators s5-0) (the-as handle #f))
      )
    )
  (set! *net-game-mgr* #f)
  ((method-of-type process-nettable deactivate) this)
  (none)
  )


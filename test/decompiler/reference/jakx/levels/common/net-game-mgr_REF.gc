(defmethod game-mgr-event-handler ((this net-game-mgr) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (case arg2
    (('set-finish-time)
     (set! (-> this scheduled-finish-time) (+ (- (- (if *net-mgr*
                                                        (-> *net-mgr* game-state time)
                                                        0
                                                        )
                                                    (if *net-world*
                                                        (-> *net-world* net-state game-start-time)
                                                        0
                                                        )
                                                    )
                                                 (if *net-world*
                                                     (-> *net-world* net-state total-pause-time)
                                                     0
                                                     )
                                                 )
                                              (-> arg3 param 0)
                                              )
           )
     (let ((s5-0 (alloc-msg this 'set-finish-time)))
       (write-int32 s5-0 (-> this scheduled-finish-time))
       (send-msg this s5-0 -2 80)
       (free-msg this s5-0)
       )
     )
    (('finish-game)
     (when (= (-> this scheduled-finish-time) -1)
       (set! (-> this scheduled-finish-time) (+ (- (- (if *net-mgr*
                                                          (-> *net-mgr* game-state time)
                                                          0
                                                          )
                                                      (if *net-world*
                                                          (-> *net-world* net-state game-start-time)
                                                          0
                                                          )
                                                      )
                                                   (if *net-world*
                                                       (-> *net-world* net-state total-pause-time)
                                                       0
                                                       )
                                                   )
                                                (-> arg3 param 0)
                                                )
             )
       (let ((s5-1 (alloc-msg this 'game-finished)))
         (write-int32 s5-1 (-> this scheduled-finish-time))
         (send-msg this s5-1 -2 80)
         (free-msg this s5-1)
         )
       (finish-game this 'finish)
       )
     )
    (('abort-game)
     (let ((s5-2 (alloc-msg this 'game-aborted)))
       (send-msg this s5-2 -2 80)
       (free-msg this s5-2)
       )
     (finish-game this 'abort)
     )
    (('restart-game)
     (if (or (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'playing-sp-game))
             (and (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'playing-game))
                  (= (if *net-world*
                         (the-as int (-> *net-world* task-node-info net-play-mode))
                         18
                         )
                     3
                     )
                  )
             )
         (finish-game this 'restart)
         )
     )
    (('game-finished?)
     (-> this scheduled-finish-mode)
     )
    (('stats-biggest-air)
     (let ((f0-0 (the-as float (-> arg3 param 0)))
           (a1-15 (-> *medius-my-player* ladder-stats))
           )
       (set-stat-if-better! (-> *net-player-ladder-stats-info* biggest-air) (the-as (pointer int32) a1-15) f0-0)
       )
     )
    (('stats-vehicle-death)
     (if (!= (-> this scheduled-finish-time) -1)
         (return #f)
         )
     (let ((gp-1 (-> *medius-my-player* ladder-stats))
           (s4-0 (-> arg3 param 0))
           (s5-3 (-> arg3 param 1))
           )
       (let* ((a0-49 (-> *net-players* s5-3))
              (v1-63 (if a0-49
                         (get-vehicle a0-49)
                         (the-as wvehicle #f)
                         )
                     )
              )
         (when (and (!= s4-0 s5-3) (or (not v1-63) (!= (-> v1-63 info vehicle-type) 15)))
           (when (and (and (>= (the-as int s4-0) 0) (< (the-as int s4-0) 16))
                      (= (/ (the-as int s4-0) 2) (if *net-mgr*
                                                     (-> *net-mgr* game-state local-machine-idx)
                                                     0
                                                     )
                         )
                      )
             (if (and (>= (the-as int s5-3) 0) (< (the-as int s5-3) 16))
                 (add-to-stat! (-> *net-player-ladder-stats-info* human-kills) (the-as (pointer int32) gp-1) 1.0)
                 (add-to-stat! (-> *net-player-ladder-stats-info* cpu-kills) (the-as (pointer int32) gp-1) 1.0)
                 )
             )
           )
         )
       (if (and (= (/ (the-as int s5-3) 2) (if *net-mgr*
                                               (-> *net-mgr* game-state local-machine-idx)
                                               0
                                               )
                   )
                (and (>= (the-as int s5-3) 0) (< (the-as int s5-3) 16))
                )
           (add-to-stat! (-> *net-player-ladder-stats-info* deaths) (the-as (pointer int32) gp-1) 1.0)
           )
       )
     )
    )
  )


;; definition for function current-level-difficulty
(defun current-level-difficulty ()
  (case *game-mode*
    (('adventure)
     (cond
       ((logtest? (-> *game-info* secrets) (game-secrets hero-mode))
        1.0
        )
       (else
         (let* ((v1-4 (get-open-task-node-info))
                (f0-1 (* 0.003921569 (the float (-> v1-4 ai-difficulty))))
                )
           (if (and (!= (-> v1-4 medals 0) 3) (< (-> v1-4 ai-easier-after) (-> v1-4 play-count)))
               (fmax
                 (* 0.003921569 (the float (-> v1-4 ai-min-difficulty)))
                 (- f0-1 (* 0.003921569
                            (the float (-> v1-4 ai-difficulty-step))
                            (the float (- (-> v1-4 play-count) (-> v1-4 ai-easier-after)))
                            )
                    )
                 )
               f0-1
               )
           )
         )
       )
     )
    (else
      (let ((v1-8 (-> *net-world* net-state vehicle-class)))
        (cond
          ((zero? v1-8)
           0.5
           )
          ((or (= v1-8 1) (= v1-8 2))
           1.0
           )
          )
        )
      )
    )
  )

;; definition for function difficulty-stats
(defun difficulty-stats ()
  (let ((gp-0 (get-open-task-node-info)))
    (format 0 "----------------------------~%")
    (format 0 "Current Difficulty = ~f~%" (current-level-difficulty))
    (format 0 "----------------------------~%")
    (format 0 "play-count             = ~d~%" (-> gp-0 play-count))
    (format 0 "ai-difficulty          = ~f~%" (* 0.003921569 (the float (-> gp-0 ai-difficulty))))
    (format 0 "ai-easier-after        = ~d~%" (-> gp-0 ai-easier-after))
    (format 0 "ai-min-difficulty      = ~f~%" (* 0.003921569 (the float (-> gp-0 ai-min-difficulty))))
    (format 0 "ai-difficulty-step     = ~f~%" (* 0.003921569 (the float (-> gp-0 ai-difficulty-step))))
    )
  (format 0 "----------------------------~%")
  )

;; definition for function are-we-in-time-trial-mode?
(defun are-we-in-time-trial-mode? ()
  (= (if *net-world*
         (the-as int (-> *net-world* task-node-info net-play-mode))
         18
         )
     3
     )
  )

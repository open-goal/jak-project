  )

;; definition for function quit-game-stats-update
;; WARN: Return type mismatch int vs object.
(defun quit-game-stats-update ()
  (when (!= (if *net-world*
                (the-as int (-> *net-world* task-node-info net-play-mode))
                18
                )
            3
            )
    (cond
      ((< (cond
            ((not *net-game-mgr*)
             0
             )
            ((< (-> *net-game-mgr* intro-end-time) 0)
             0
             )
            (else
              (max 0 (- (- (- (if *net-mgr*
                                  (-> *net-mgr* game-state time)
                                  0
                                  )
                              (if *net-world*
                                  (-> *net-world* net-state game-start-time)
                                  0
                                  )
                              )
                           (if *net-world*
                               (-> *net-world* net-state total-pause-time)
                               0
                               )
                           )
                        (-> *net-game-mgr* intro-end-time)
                        )
                   )
              )
            )
          4500
          )
       (award-overall-score #f)
       )
      (else
        (if (got-other-players)
            (add-to-stat!
              (-> *net-player-ladder-stats-info* events-ended-or-quit)
              (the-as (pointer int32) (-> *medius-my-player* ladder-stats))
              1.0
              )
            )
        )
      )
    )
  0
  )

;; definition for method 77 of type net-game-mgr
;; WARN: Return type mismatch int vs none.
;; WARN: Function (method 77 net-game-mgr) has a return type of none, but the expression builder found a return statement.
(defmethod stats-end-event ((this net-game-mgr) (arg0 symbol))
  (if *stats-adjusted*
      (return #f)
      )
  (set! *stats-adjusted* #t)
  (when (and (!= arg0 'finish) (!= (if *net-world*
                                       (the-as int (-> *net-world* task-node-info net-play-mode))
                                       18
                                       )
                                   3
                                   )
             )
    (cond
      ((or (< (- (- (if *net-mgr*
                        (-> *net-mgr* game-state time)
                        0
                        )
                    (if *net-world*
                        (-> *net-world* net-state game-start-time)
                        0
                        )
                    )
                 (if *net-world*
                     (-> *net-world* net-state total-pause-time)
                     0
                     )
                 )
              4500
              )
           (!= (if *net-mgr*
                   (-> *net-mgr* game-state local-machine-idx)
                   0
                   )
               (-> *net-mgr* game-state session-master-idx)
               )
           )
       (award-overall-score #f)
       )
      (else
        (if (got-other-players)
            (add-to-stat!
              (-> *net-player-ladder-stats-info* events-ended-or-quit)
              (the-as (pointer int32) (-> *medius-my-player* ladder-stats))
              1.0
              )
            )
        )
      )
    )
  (let ((gp-0 (-> *medius-my-player* ladder-stats))
        (a2-1 0)
        (s3-0 0)
        (s2-0 0)
        (s4-0 (-> *net-players* (* (if *net-mgr*
                                       (-> *net-mgr* game-state local-machine-idx)
                                       0
                                       )
                                   2
                                   )
                  )
              )
        )
    (when s4-0
      (dotimes (v1-34 8)
        (if (and (logtest? (-> *net-mgr* game-state connected-bitfield) (ash 1 v1-34))
                 (and *net-process-mgr*
                      (= (-> *net-process-mgr* machines v1-34 state) (net-process-mgr-machine-state running))
                      )
                 )
            (+! s3-0 1)
            )
        )
      (dotimes (v1-37 24)
        (if (and (< v1-37 16) (-> *net-players* v1-37))
            (+! a2-1 1)
            )
        (if (-> *net-players* v1-37)
            (+! s2-0 1)
            )
        )
      (format 0 "total human players: ~D~%" a2-1)
      (format 0 "total machines: ~D~%" s3-0)
      (add-to-stat!
        (-> *net-player-ladder-stats-info* time-spent-playing)
        (the-as (pointer int32) gp-0)
        (* 0.0033333334 (the float (- (- (if *net-mgr*
                                             (-> *net-mgr* game-state time)
                                             0
                                             )
                                         (if *net-world*
                                             (-> *net-world* net-state game-start-time)
                                             0
                                             )
                                         )
                                      (if *net-world*
                                          (-> *net-world* net-state total-pause-time)
                                          0
                                          )
                                      )
                             )
           )
        )
      (let ((v1-50 (the int (* 0.0005462438 (-> s4-0 top-speed)))))
        (when (< v1-50 1000)
          (let ((v1-52 (+ (* v1-50 32) (-> *net-world*
                                           net-state
                                           players
                                           (* (if *net-mgr*
                                                  (-> *net-mgr* game-state local-machine-idx)
                                                  0
                                                  )
                                              2
                                              )
                                           vehicle-selection
                                           )
                          )
                       )
                )
            (set-stat-if-better!
              (-> *net-player-ladder-stats-info* top-speed)
              (the-as (pointer int32) gp-0)
              (the float v1-52)
              )
            )
          )
        )
      (when (and (= arg0 'finish) (!= (if *net-world*
                                          (the-as int (-> *net-world* task-node-info net-play-mode))
                                          18
                                          )
                                      3
                                      )
                 )
        (add-to-stat! (-> *net-player-ladder-stats-info* events-played) (the-as (pointer int32) gp-0) 1.0)
        (cond
          ((type? this net-game-mgr-race)
           (add-to-stat! (-> *net-player-ladder-stats-info* track-events-played) (the-as (pointer int32) gp-0) 1.0)
           )
          ((type? this net-game-mgr-deathmatch)
           (add-to-stat! (-> *net-player-ladder-stats-info* arena-events-played) (the-as (pointer int32) gp-0) 1.0)
           )
          )
        (let ((s1-1 (-> *net-players* (* (if *net-mgr*
                                             (-> *net-mgr* game-state local-machine-idx)
                                             0
                                             )
                                         2
                                         )
                        )
                    )
              )
          (when (and (zero? (-> s1-1 rank)) (and (< 1 s2-0) (< 1 s3-0)))
            (add-to-stat! (-> *net-player-ladder-stats-info* events-won) (the-as (pointer int32) gp-0) 1.0)
            (cond
              ((type? this net-game-mgr-race)
               (add-to-stat! (-> *net-player-ladder-stats-info* track-events-won) (the-as (pointer int32) gp-0) 1.0)
               )
              ((type? this net-game-mgr-deathmatch)
               (add-to-stat! (-> *net-player-ladder-stats-info* arena-events-won) (the-as (pointer int32) gp-0) 1.0)
               )
              )
            )
          (when (and (>= 2 (-> s1-1 rank)) (< 3 s2-0) (< 3 s3-0))
            (cond
              ((type? this net-game-mgr-race)
               (add-to-stat! (-> *net-player-ladder-stats-info* track-events-top-three) (the-as (pointer int32) gp-0) 1.0)
               )
              ((type? this net-game-mgr-deathmatch)
               (add-to-stat! (-> *net-player-ladder-stats-info* arena-events-top-three) (the-as (pointer int32) gp-0) 1.0)
               )
              )
            )
          )
        (award-overall-score #t)
        (case (if *net-world*
                  (the-as int (-> *net-world* task-node-info net-play-mode))
                  18
                  )
          ((4)
           (set-stat-if-better!
             (-> *net-player-ladder-stats-info* best-deathmatch-kills)
             (the-as (pointer int32) gp-0)
             (the float (-> s4-0 score))
             )
           )
          ((5)
           (set-stat-if-better!
             (-> *net-player-ladder-stats-info* best-hunt-score)
             (the-as (pointer int32) gp-0)
             (the float (-> s4-0 score))
             )
           )
          ((11)
           (set-stat-if-better!
             (-> *net-player-ladder-stats-info* best-artifact-score)
             (the-as (pointer int32) gp-0)
             (the float (-> s4-0 score))
             )
           )
          )
        )
      (let ((s5-1 (as-type s4-0 net-player-race)))
        (when s5-1
          (when (or (zero? (if *net-world*
                               (the-as int (-> *net-world* task-node-info net-play-mode))
                               18
                               )
                           )
                    (= (if *net-world*
                           (the-as int (-> *net-world* task-node-info net-play-mode))
                           18
                           )
                       3
                       )
                    )
            (when (!= (-> s5-1 best-lap-time) #x7fffffff)
              (let ((s4-1 (-> s5-1 best-lap-time)))
                (format 0 "best lap time was ~D~%" s4-1)
                (when (< s4-1 #x2bf20)
                  (let ((s4-2 (+ (* s4-1 32) (-> *net-world*
                                                 net-state
                                                 players
                                                 (* (if *net-mgr*
                                                        (-> *net-mgr* game-state local-machine-idx)
                                                        0
                                                        )
                                                    2
                                                    )
                                                 vehicle-selection
                                                 )
                                 )
                              )
                        )
                    (dotimes (s3-1 (length *net-player-ladder-stats-info-array*))
                      (let ((a0-83 (-> *net-player-ladder-stats-info-array* s3-1)))
                        (if (and (= (-> a0-83 tp) (stat-type lap-time))
                                 (= (-> a0-83 taskname) (-> *task-level* (-> *net-world* task-info task-level)))
                                 )
                            (set-stat-if-better! a0-83 (the-as (pointer int32) gp-0) (the float s4-2))
                            )
                        )
                      )
                    )
                  )
                )
              )
            )
          (when (= (if *net-world*
                       (the-as int (-> *net-world* task-node-info net-play-mode))
                       18
                       )
                   3
                   )
            (when (> (-> s5-1 finish-time) 0)
              (let ((s5-2 (-> s5-1 finish-time)))
                (format 0 "finish time was ~D~%" s5-2)
                (when (< s5-2 #x2bf20)
                  (let ((s5-3 (+ (* s5-2 32) (-> *net-world*
                                                 net-state
                                                 players
                                                 (* (if *net-mgr*
                                                        (-> *net-mgr* game-state local-machine-idx)
                                                        0
                                                        )
                                                    2
                                                    )
                                                 vehicle-selection
                                                 )
                                 )
                              )
                        )
                    (dotimes (s4-3 (length *net-player-ladder-stats-info-array*))
                      (let ((a0-94 (-> *net-player-ladder-stats-info-array* s4-3)))
                        (if (and (= (-> a0-94 tp) (stat-type time-trial))
                                 (= (-> a0-94 taskname) (-> *task-level* (-> *net-world* task-info task-level)))
                                 )
                            (set-stat-if-better! a0-94 (the-as (pointer int32) gp-0) (the float s5-3))
                            )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  0
  (none)

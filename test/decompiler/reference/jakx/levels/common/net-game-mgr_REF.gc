          )
        (+! s5-0 1)
        )
      )
    (if (< s5-0 2)
        (return #f)
        )
    (if (<= gp-1 0)
        (set! gp-1 1)
        )
    (set! *user-pts-at-stake* gp-1)
    (set! *total-pts-at-stake* (* gp-1 s5-0))
    )
  (set! *overall-score-penalty*
        (min
          (overall-score-amount-to-gamble (the-as int (-> *medius-my-player* ladder-stats overall-score)))
          *user-pts-at-stake*
          )
        )
  (set! (-> *medius-my-player* ladder-stats overall-score)
        (- (-> *medius-my-player* ladder-stats overall-score) (the-as uint *overall-score-penalty*))
        )
  (set! (-> *medius-my-player* ladder-stats overall-score)
        (the-as uint (max 1 (the-as int (-> *medius-my-player* ladder-stats overall-score))))
        )
  (format 0 "applying penalty of ~D~%" *overall-score-penalty*)
  0
  (none)
  )

;; definition for function got-other-players

;; definition for symbol *intro-hud-view-proc*, type intro-hud-view
(define *intro-hud-view-proc* (the-as intro-hud-view #f))

;; definition of type intro-hud-view
(deftype intro-hud-view (in-game-hud)
  ()
  )

;; definition for method 3 of type intro-hud-view
(defmethod inspect ((this intro-hud-view))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type in-game-hud inspect)))
    (t9-0 this)
    )
  (label cfg-4)
  this
  )

;; definition for method 7 of type intro-hud-view
;; WARN: Return type mismatch in-game-hud vs intro-hud-view.
(defmethod relocate ((this intro-hud-view) (offset int))
  (set! *intro-hud-view-proc* this)
  (if (nonzero? *intro-hud-view-proc*)
      (set! *intro-hud-view-proc* (&+ *intro-hud-view-proc* offset))
      )
  (the-as intro-hud-view ((method-of-type in-game-hud relocate) this offset))
  )

;; definition for method 26 of type intro-hud-view
(defmethod init-callback ((this intro-hud-view))
  (set! (-> this items) *intro-hud-view*)
  (set! (-> this manager) (new 'static 'basic-manager))
  (set! *intro-hud-view-proc* this)
  ((method-of-type in-game-hud init-callback) this)
  (none)
  )

;; definition for method 10 of type intro-hud-view
(defmethod deactivate ((this intro-hud-view))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (set! *intro-hud-view-proc* #f)
  ((method-of-type in-game-hud deactivate) this)
  (none)
  )

;; definition for method 24 of type intro-hud-view
(defmethod draw ((this intro-hud-view))
  (when *debug-hud*
    (set! (-> this real-items) *intro-hud-view*)
    (init-callback this)
    )
  ((method-of-type in-game-hud draw) this)
  (none)
  )

;; definition for function spawn-intro-hud-view
;; WARN: Return type mismatch process vs intro-hud-view.
(defun spawn-intro-hud-view ()
  (the-as
    intro-hud-view
    (cond
      (*intro-hud-view-proc*
        *intro-hud-view-proc*
        )
      (*net-game-mgr*
        (let ((v0-0 (ppointer->process
                      (process-spawn intro-hud-view :init hud-init-by-other :name "intro-hud-view" :to *net-game-mgr*)
                      )
                    )
              )
          (when v0-0
            (set! (-> (the-as intro-hud-view v0-0) inited-strings-count) 0)
            0
            )
          v0-0
          )
        )
      (else
        (the-as process #f)
        )
      )
    )
  )

;; definition for method 17 of type intro-hud-view
(defmethod hide-during-letterbox? ((this intro-hud-view))
  #f
  )


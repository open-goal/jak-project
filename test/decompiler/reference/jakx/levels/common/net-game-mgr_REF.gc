              )
            )
          :font-effect #x8
          :color #x38
          :font-flags (hud-string-flag middle)
          :has-outline #t
          )
        (new 'static 'hud-item-string
          :alpha #xff
          :position-y 20
          :width #x12c
          :height 32
          :zval #xfff0
          :scale #x99
          :flags (hud-item-flag align-right bit10)
          :effect (new 'static 'hud-effect-group
            :items (new 'static 'boxed-array :type hud-effect
              (new 'static 'hud-effect-font-effect :message 'enter :delay #x12c :font-effect #x12)
              (new 'static 'hud-effect-offscreen :message 'enter :delay #x12c)
              (new 'static 'hud-effect-font-effect :message 'exit :font-effect #xc)
              )
            )
          :font-effect #x8
          :color #x38
          :font-flags (hud-string-flag right)
          :has-outline #t
          )
        )
      :hide-titles #f

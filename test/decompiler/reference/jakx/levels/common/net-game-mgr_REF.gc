(defun got-other-players ()
  (dotimes (v1-0 *active-net-non-spectator-count*)
    (let ((a0-2 (-> *active-net-non-spectators* v1-0)))
      (when a0-2
        (if (and (and (>= (-> a0-2 player-id) 0) (< (-> a0-2 player-id) 16))
                 (!= (if *net-mgr*
                         (-> *net-mgr* game-state local-machine-idx)
                         0
                         )
                     (/ (-> a0-2 player-id) 2)
                     )
                 )
            (return (the-as object #t))
            )
        )
      )
    )

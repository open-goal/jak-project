                                )
                        )
                  )
                (let* ((sv-32 (new 'static 'res-tag))
                       (a0-14 (res-lump-data (-> s0-0 extra) 'linear-vel (inline-array vector) :tag-ptr (& sv-32)))
                       )
                  (when a0-14
                    (set! (-> this result vels) a0-14)
                    (let ((sv-128 (new 'stack-no-clear 'inline-array 'vector 2)))
                      (get-anim-offset
                        a0-14
                        (-> this active anim-offset)
                        (-> (the-as art-joint-anim s0-0) speed)
                        (-> sv-128 0)
                        (-> sv-128 1)
                        )
                      (vector-! (-> this result moved-no-frac) (-> this result moved-no-frac) (-> sv-128 0))
                      )
                    )
                  )
                )
              (set! (-> this result cur-frame) 0.0)
              (set! (-> this result total-frames) (the-as int (* s4-0 (the-as uint (the int (floor f22-0))))))
              )
            )
          (cond
            ((-> this result vels)
             (let ((v1-51 (-> this result total-frames))
                   (a0-17 (the int f28-0))

;;-*-Lisp-*-
(in-package goal)

;; definition of type net-anim-path
(deftype net-anim-path (uint8)
  ((path-idx uint8 :offset   0 :size   7)
   (reversed uint8 :offset   7 :size   1)
   )
  )

;; definition of type net-anim-state
(deftype net-anim-state (structure)
  ((timestamp    int32)
   (anim-idx     int16)
   (anim-offset  float)
   (anim-rate    float)
   (vel          vector  :inline)
   (path-info    net-anim-path)
   (path-offset  float)
   (anim-looped  symbol)
   (need-snap    symbol)
   )
  )

;; definition for method 3 of type net-anim-state
(defmethod inspect ((this net-anim-state))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'net-anim-state)
  (format #t "~1Ttimestamp: ~D~%" (-> this timestamp))
  (format #t "~1Tanim-idx: ~D~%" (-> this anim-idx))
  (format #t "~1Tanim-offset: ~f~%" (-> this anim-offset))
  (format #t "~1Tanim-rate: ~f~%" (-> this anim-rate))
  (format #t "~1Tvel: #<vector @ #x~X>~%" (-> this vel))
  (format #t "~1Tpath-info: ~D~%" (-> this path-info))
  (format #t "~1Tpath-offset: ~f~%" (-> this path-offset))
  (format #t "~1Tanim-looped: ~A~%" (-> this anim-looped))
  (format #t "~1Tneed-snap: ~A~%" (-> this need-snap))
  (label cfg-4)
  this
  )

;; definition for function encode-net-anim-state
;; WARN: Return type mismatch none vs object.
(defun encode-net-anim-state ((arg0 net-anim-control) (arg1 mem-buffer))
  (write-int32 arg1 (-> arg0 active timestamp))
  (write-int16 arg1 (-> arg0 active anim-idx))
  (write-float arg1 (-> arg0 active anim-offset))
  (write-float arg1 (-> arg0 active anim-rate))
  (write-vector arg1 (-> arg0 active vel))
  (write-int8 arg1 (the-as int (-> arg0 active path-info)))
  (write-float arg1 (-> arg0 active path-offset))
  (write-bool arg1 (-> arg0 active anim-looped))
  )

;; definition for function decode-net-anim-state
;; WARN: Return type mismatch symbol vs none.
(defun decode-net-anim-state ((arg0 net-anim-control) (arg1 mem-buffer))
  (set! (-> arg0 active timestamp) (read-int32 arg1))
  (set! (-> arg0 active anim-idx) (read-int16 arg1))
  (set! (-> arg0 active anim-offset) (read-float arg1))
  (set! (-> arg0 active anim-rate) (read-float arg1))
  (read-vector arg1 (-> arg0 active vel))
  (set! (-> arg0 active path-info) (the-as net-anim-path (read-int8 arg1)))
  (set! (-> arg0 active path-offset) (read-float arg1))
  (set! (-> arg0 active anim-looped) (read-bool arg1))
  (none)
  )

;; definition of type net-anim-result
(deftype net-anim-result (structure)
  ((now                 int32)
   (moved               vector  :inline)
   (path-pos            float)
   (path-pos-dist       float)
   (cur-frame           float)
   (cur-loops           int32)
   (anim-wrapped        symbol)
   (path-wrapped        symbol)
   (projected-end-time  int32)
   (total-frames        int32)
   (moved-no-frac       vector  :inline)
   (vels                (inline-array vector))
   (last-snap-time      int32)
   )
  )

;; definition for method 3 of type net-anim-result
(defmethod inspect ((this net-anim-result))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'net-anim-result)
  (format #t "~1Tnow: ~D~%" (-> this now))
  (format #t "~1Tmoved: #<vector @ #x~X>~%" (-> this moved))
  (format #t "~1Tpath-pos: ~f~%" (-> this path-pos))
  (format #t "~1Tpath-pos-dist: ~f~%" (-> this path-pos-dist))
  (format #t "~1Tcur-frame: ~f~%" (-> this cur-frame))
  (format #t "~1Tcur-loops: ~D~%" (-> this cur-loops))
  (format #t "~1Tanim-wrapped: ~A~%" (-> this anim-wrapped))
  (format #t "~1Tpath-wrapped: ~A~%" (-> this path-wrapped))
  (format #t "~1Tprojected-end-time: ~D~%" (-> this projected-end-time))
  (format #t "~1Ttotal-frames: ~D~%" (-> this total-frames))
  (format #t "~1Tmoved-no-frac: #<vector @ #x~X>~%" (-> this moved-no-frac))
  (format #t "~1Tvels: #x~X~%" (-> this vels))
  (format #t "~1Tlast-snap-time: ~D~%" (-> this last-snap-time))
  (label cfg-4)
  this
  )

;; definition of type net-anim-control
(deftype net-anim-control (structure)
  ((active      net-anim-state   :inline)
   (result      net-anim-result  :inline)
   (path-array  (pointer path-control))
   )
  (:methods
    (update! (_type_ process-focusable int symbol) none)
    (set-path! (_type_ int int symbol float) none)
    (set-anim! (_type_ int int float float symbol vector) none)
    )
  )

;; definition for method 3 of type net-anim-control
(defmethod inspect ((this net-anim-control))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'net-anim-control)
  (format #t "~1Tactive: #<net-anim-state @ #x~X>~%" (-> this active))
  (format #t "~1Tresult: #<net-anim-result @ #x~X>~%" (-> this result))
  (format #t "~1Tpath-array: #x~X~%" (-> this path-array))
  (label cfg-4)
  this
  )

;; definition for function safe-mod
(defun safe-mod ((arg0 float))
  (- arg0 (floor arg0))
  )

;; definition for function get-dist-based-path-pos
(defun get-dist-based-path-pos ((arg0 path-control) (arg1 float))
  (let ((v0-1 (- arg1 (floor arg1))))
    (when (-> arg0 distmap)
      (let* ((a0-2 (* 128.0 v0-1))
             (v1-3 (the int a0-2))
             (f0-7 (- a0-2 (* (the float (the int (/ a0-2 1.0))) 1.0)))
             (f1-6 (-> arg0 distmap v1-3))
             )
        (set! v0-1 (+ f1-6 (* f0-7 (- (-> arg0 distmap (+ v1-3 1)) f1-6))))
        )
      )
    v0-1
    )
  )

;; definition for function get-anim-offset
;; INFO: Used lq/sq
;; WARN: Return type mismatch int vs object.
(defun get-anim-offset ((arg0 (inline-array vector)) (arg1 float) (arg2 float) (arg3 vector) (arg4 vector))
  (let ((v1-0 (the int arg1))
        (f0-3 (- arg1 (* (the float (the int (/ arg1 1.0))) 1.0)))
        )
    (set! (-> arg4 quad) (the-as uint128 0))
    (dotimes (a1-4 v1-0)
      (vector+float*! arg4 arg4 (-> arg0 a1-4) (/ 0.016666668 arg2))
      )
    (vector+float*! arg3 arg4 (-> arg0 v1-0) (* f0-3 (/ 0.016666668 arg2)))
    )
  0
  )

;; definition for method 11 of type net-anim-control
;; INFO: Used lq/sq
;; WARN: Return type mismatch int vs none.
(defmethod set-anim! ((this net-anim-control) (arg0 int) (arg1 int) (arg2 float) (arg3 float) (arg4 symbol) (arg5 vector))
  (set! (-> this active timestamp) arg0)
  (set! (-> this active anim-idx) arg1)
  (set! (-> this active anim-offset) arg2)
  (set! (-> this active anim-rate) arg3)
  (set! (-> this active anim-looped) arg4)
  (set! (-> this active path-info path-idx) (-> this active path-info path-idx))
  (set! (-> this active path-info reversed) (if (= (-> this active path-info reversed) 1)
                                                1
                                                0
                                                )
        )
  (set! (-> this active path-offset) (-> this result path-pos-dist))
  (set! (-> this active vel quad) (-> arg5 quad))
  (set! (-> this active need-snap) #t)
  0
  (none)
  )

;; definition for method 10 of type net-anim-control
;; INFO: Used lq/sq
;; WARN: Return type mismatch int vs none.
(defmethod set-path! ((this net-anim-control) (arg0 int) (arg1 int) (arg2 symbol) (arg3 float))
  (set! (-> this active timestamp) arg0)
  (set! (-> this active anim-idx) (-> this active anim-idx))
  (set! (-> this active anim-offset) (-> this result cur-frame))
  (set! (-> this active anim-rate) (-> this active anim-rate))
  (set! (-> this active anim-looped) (-> this active anim-looped))
  (set! (-> this active path-info path-idx) arg1)
  (set! (-> this active path-info reversed) (if arg2
                                                1
                                                0
                                                )
        )
  (set! (-> this active path-offset) arg3)
  (set! (-> this active vel quad) (-> this active vel quad))
  (set! (-> this active need-snap) #t)
  0
  (none)
  )

;; definition for method 9 of type net-anim-control
;; INFO: Used lq/sq
;; WARN: Return type mismatch int vs none.
(defmethod update! ((this net-anim-control) (arg0 process-focusable) (arg1 int) (arg2 symbol))
  (local-vars (v1-33 symbol))
  (rlet ((acc :class vf)
         (vf0 :class vf)
         (vf1 :class vf)
         (vf2 :class vf)
         (vf3 :class vf)
         (vf4 :class vf)
         )
    (init-vf0-vector)
    (if (or (< 1500 (- arg1 (-> this result last-snap-time))) (-> this active need-snap))
        (set! arg2 #t)
        )
    (when arg2
      (set! (-> this result last-snap-time) arg1)
      (set! (-> this active need-snap) #f)
      )
    (let* ((f26-0 (* 0.0033333334 (the float (- arg1 (-> this active timestamp)))))
           (s0-0 (-> arg0 draw art-group data (-> this active anim-idx)))
           (s4-0 (+ (-> (the-as art-joint-anim s0-0) frames num-frames) -1))
           (f30-0 (* 60.0 (-> this active anim-rate) (-> (the-as art-joint-anim s0-0) speed)))
           )
      (let ((f28-0 (+ (-> this active anim-offset) (* f30-0 f26-0))))
        (let ((v1-17 (-> this active path-info path-idx))
              (s1-0 (the-as path-control #f))
              (f24-0 0.0)
              )
          (when (!= v1-17 127)
            (set! s1-0 (-> this path-array v1-17))
            (set! f24-0 (total-distance s1-0))
            )
          (when (not (-> this active anim-looped))
            (when (>= f28-0 (the float s4-0))
              (set! (-> this result anim-wrapped) #t)
              (set! f28-0 (fmin f28-0 (the float (+ s4-0 -1))))
              )
            )
          (when arg2
            (let ((f22-0 (floor (/ f28-0 (the float s4-0)))))
              (set! (-> this result vels) (the-as (inline-array vector) #f))
              (set! (-> this result moved-no-frac quad) (the-as uint128 0))
              (when (-> s0-0 extra)
                (let* ((sv-16 (new 'static 'res-tag))
                       (v0-2 (res-lump-data (-> s0-0 extra) 'dist-covered (inline-array vector) :tag-ptr (& sv-16)))
                       )
                  (set! v1-33 (when v0-2
                                (let ((sv-112 (the-as vector v1-33)))
                                  (set! sv-112 (-> this result moved-no-frac))
                                  (let ((sv-80 (-> this result moved-no-frac))
                                        (sv-96 (-> v0-2 0))
                                        (f0-11 (floor f22-0))
                                        )
                                    (.lvf vf2 (&-> sv-96 quad))
                                    (.lvf vf1 (&-> sv-80 quad))
                                    (let ((v1-39 f0-11))
                                      (.mov vf3 v1-39)

  (format #t "~2Thud-right-ammo-counter-1: #<hud-sprite @ #x~X>~%" (-> this sprites))
  (format #t "~2Thud-right-ammo-counter-2: #<hud-sprite @ #x~X>~%" (-> this hud-right-ammo-counter-2))

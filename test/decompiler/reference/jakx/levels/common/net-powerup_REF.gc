;; definition for method 45 of type net-powerup
;; INFO: Used lq/sq
;; WARN: Return type mismatch int vs none.
(defmethod init! ((this net-powerup) (arg0 net-powerup-spawn-params))
  (stack-size-set! (-> this main-thread) 32)
  (set! (-> this prox) (new 'process 'proximity-ownership-params))
  (init! (-> this prox))
  (set! (-> this prox ownable-radius) 245760.0)
  (set! (-> this prox consider-ai-players) #t)
  (set! (-> this child-proc) (the-as handle #f))
  (set! (-> this touched-time) -1)
  (set! (-> this pos quad) (-> arg0 pos quad))
  (set! (-> this motion-info) #f)
  (when (-> arg0 motion-info)
    (set! (-> this motion-info) (new 'process 'net-powerup-motion-info))
    (mem-copy! (&-> this motion-info type) (&-> arg0 motion-info type) 48)
    )
  (when (not (-> this entity))
    (dotimes (v1-18 64)
      (when (not (handle->process (-> *dynamic-powerups* v1-18)))
        (set! (-> *dynamic-powerups* v1-18) (process->handle this))
        (goto cfg-20)
        )
      )
    )
  (label cfg-20)
  (set! (-> this event-hook) (-> (method-of-type net-powerup idle) event))
  (if (not (registered? this))
      (register this (-> arg0 initial-owner) #xffff)
      )
  0
  (none)
  )


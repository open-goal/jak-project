                                                       0
                                                       )
                                                   (if *net-world*
                                                       (-> *net-world* net-state game-start-time)
                                                       0
                                                       )
                                                   )
                                                (if *net-world*
                                                    (-> *net-world* net-state total-pause-time)
                                                    0
                                                    )
                                                )
                                             (-> arg0 lifetime)
                                             )
                                          -1
                                          )
        )
  (init! self arg0)
  (go-virtual idle)
  0
  )

;; definition for function spawn-powerup
;; WARN: Return type mismatch process vs net-powerup.
(defun spawn-powerup ((arg0 net-powerup-spawn-params))
  (let ((s5-0 (get-process *default-dead-pool* (-> arg0 tp) #x4000 1)))
    (the-as
      net-powerup
      (ppointer->process
        (when s5-0
          (let ((s4-0 (method-of-type process activate)))
            (s4-0 s5-0 *entity-pool* (symbol->string (-> arg0 tp symbol)) (the-as pointer #x70004000))
            )
          (run-now-in-process s5-0 net-powerup-init-by-other arg0)
          (-> s5-0 ppointer)
          )
        )
      )
    )
  )

;; definition for function eject-powerup
;; INFO: Used lq/sq
;; WARN: Return type mismatch basic vs net-powerup.
(defun eject-powerup ((arg0 net-powerup-spawn-params) (arg1 vector) (arg2 float) (arg3 float))
  (the-as net-powerup (cond
                        ((and (!= arg2 0.0) (!= arg3 0.0))
                         (let ((s4-0 (new 'stack-no-clear 'inline-array 'vector 3)))
                           (set! (-> s4-0 2 x) (* arg2 (cos arg3)))
                           (set! (-> s4-0 2 y) arg2)
                           (set! (-> s4-0 2 z) (* arg2 (sin arg3)))
                           (mine-compute-landing-point! (-> s4-0 0) (-> s4-0 1) arg1 #f (-> s4-0 2) 12288.0)
                           (+! (-> s4-0 0 y) 28672.0)
                           (setup-parabola! *tmp-powerup-motion-info* arg1 (-> s4-0 0) (seconds 1))
                           )
                         (set! (-> *tmp-powerup-motion-info* flight-end-time)
                               (+ (- (- 300 (if *net-world*
                                                (-> *net-world* net-state total-pause-time)
                                                0
                                                )
                                        )
                                     (if *net-world*
                                         (-> *net-world* net-state game-start-time)
                                         0
                                         )
                                     )
                                  (if *net-mgr*
                                      (-> *net-mgr* game-state time)
                                      0
                                      )
                                  )
                               )
                         (set! (-> *tmp-powerup-motion-info* motion-hook) powerup-motion-parabola)
                         (let ((v0-4 (the-as basic *tmp-powerup-motion-info*)))
                           (set! (-> arg0 motion-info) (the-as net-powerup-motion-info v0-4))
                           v0-4
                           )
                         )
                        (else
                          (set! (-> arg0 pos quad) (-> arg1 quad))
                          (set! (-> arg0 motion-info) #f)
                          (spawn-powerup arg0)
                          )
                        )
          )
  )

;; definition for function eject-test
;; INFO: Used lq/sq
;; WARN: Return type mismatch int vs object.
(defun eject-test ()
  (let ((gp-0 (new 'stack-no-clear 'net-powerup-spawn-params-vec1)))
    (set! (-> gp-0 params pos quad) (-> (the-as vector #f) quad))
    (set! (-> gp-0 params tp) eco-green)
    (set! (-> gp-0 params motion-info) #f)
    (set! (-> gp-0 params lifetime) 3000)
    (set! (-> gp-0 params initial-owner) 8)
    (set! (-> gp-0 params motion-info) #f)
    (set! (-> gp-0 vec quad) (-> (get-vehicle (-> *net-players* 0)) root trans quad))
    (+! (-> gp-0 vec y) 61440.0)
    (eject-powerup (-> gp-0 params) (-> gp-0 vec) 40960.0 0.0)
    )
  0
  )





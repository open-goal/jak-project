;; failed to figure out what this is:
(defstate idle (net-powerup)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('go-die)
       (kill-draw-proc self)
       (if (registered? self)
           (unregister self #t (the-as mem-buffer #f))
           )
       (go-virtual die)
       )
      )
    )
  :trans (behavior ()
    (when (-> self motion-info)
      ((-> self motion-info motion-hook) (-> self motion-info) self)
      (let ((a0-2 (the-as powerup-draw (handle->process (-> self child-proc)))))
        (if a0-2
            (set-pos! a0-2 (-> self pos))
            )
        )
      )
    (when (> (-> self ignore-frames) 0)
      (+! (-> self ignore-frames) -1)
      (return #f)
      )
    (set! (-> self ignore-frames) 2)
    (cond
      ((the-as powerup-draw (handle->process (-> self child-proc)))
       (if (not (visible? self))
           (kill-draw-proc self)
           )
       )
      (else
        (if (visible? self)
            (spawn-draw-proc self (-> self pos) (-> self entity))
            )
        )
      )
    (cond
      ((>= (-> self touched-time) 0)
       (set-desired-owner
         self
         (if *net-mgr*
             (-> *net-mgr* game-state local-machine-idx)
             0
             )
         #f
         )
       (set! (-> self ignore-frames) 0)
       (cond
         ((>= (- (- (- (if *net-mgr*
                           (-> *net-mgr* game-state time)
                           0
                           )
                       (if *net-world*
                           (-> *net-world* net-state game-start-time)
                           0
                           )
                       )
                    (if *net-world*
                        (-> *net-world* net-state total-pause-time)
                        0
                        )
                    )
                 (-> self touched-time)
                 )
              900
              )
          (set! (-> self touched-time) -1)
          )
         ((owner-is-local? self)
          (if (get-vehicle (-> *net-players* (-> self touched-by)))
              (on-pickup self)
              )
          )
         )
       )
      (else
        (update-proximity-ownership self (-> self pos))
        )
      )
    (when (and (> (-> self die-or-respawn-time) 0) (>= (- (- (- (if *net-mgr*
                                                                    (-> *net-mgr* game-state time)
                                                                    0
                                                                    )
                                                                (if *net-world*
                                                                    (-> *net-world* net-state game-start-time)
                                                                    0
                                                                    )
                                                                )
                                                             (if *net-world*
                                                                 (-> *net-world* net-state total-pause-time)
                                                                 0
                                                                 )
                                                             )
                                                          (-> self die-or-respawn-time)
                                                          )
                                                       0
                                                       )
               )
      (kill-draw-proc self)
      (unregister self #f (the-as mem-buffer #f))
      (go-virtual die)
      )
    )
  :code sleep-code
  )

;; failed to figure out what this is:
(defstate wait-respawn (net-powerup)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('go-die)
       (kill-draw-proc self)
       (if (registered? self)
           (unregister self #t (the-as mem-buffer #f))
           )
       (go-virtual die)
       )
      )
    )
  :enter (behavior ()
    (when (owner-is-local? self)
      (let ((a1-0 (get-vehicle (-> *net-players* (-> self touched-by)))))
        (if a1-0
            (do-pickup self a1-0)
            )
        )
      )
    (when (>= (-> self touched-by) 0)
      (let ((gp-0 (the-as powerup-draw (handle->process (-> self child-proc))))
            (a1-2 (get-vehicle (-> *net-players* (-> self touched-by))))
            )
        (when (the-as powerup-draw gp-0)
          (let ((s5-0 self))
            (set! self (the-as net-powerup gp-0))
            (get-respawn-info (the-as net-player gp-0) (the-as net-player-respawn-info a1-2))
            (set! self s5-0)
            )
          )
        )
      )
    (kill-draw-proc self)
    (if (not (-> self entity))
        (go-virtual die)
        )
    (if (= (-> self die-or-respawn-time) -1)
        (go-virtual die)
        )
    (set-desired-owner self 8 #f)
    (set! (-> self touched-by) -1)
    )
  :trans (behavior ()
    (when (>= (- (- (- (if *net-mgr*
                           (-> *net-mgr* game-state time)
                           0
                           )
                       (if *net-world*
                           (-> *net-world* net-state game-start-time)
                           0
                           )
                       )
                    (if *net-world*
                        (-> *net-world* net-state total-pause-time)
                        0
                        )
                    )
                 (-> self die-or-respawn-time)
                 )
              0
              )
      (set! (-> self die-or-respawn-time) -1)
      (set! (-> *launch-matrix* trans quad) (-> self pos quad))
      (set! (-> *part-tracker-params-default* group) (-> *part-group-id-table* 183))
      (vector-reset! (-> *part-tracker-params-default* local-offset))
      (set! (-> *part-tracker-params-default* duration) (the-as uint 900))
      (set! (-> *part-tracker-params-default* callback) #f)
      (set! (-> *part-tracker-params-default* userdata) (the-as uint #f))
      (set! (-> *part-tracker-params-default* target) #f)
      (set! (-> *part-tracker-params-default* mat-joint) *launch-matrix*)
      (set! (-> *part-tracker-params-default* local-space-param) 0)
      (set! (-> *part-tracker-params-default* local-space-callback) #f)
      (set! (-> *part-tracker-params-default* subsampler-num) 1.0)
      *part-tracker-params-default*
      (if (logtest? (-> *part-group-id-table* 183 flags) (sp-group-flag sp13))
          (process-spawn
            part-tracker-subsampler
            :init part-tracker-subsampler-init
            *part-tracker-params-default*
            :name "part-tracker-subsampler"
            :to *entity-pool*
            :unk 0
            )
          (process-spawn
            part-tracker
            :init part-tracker-init
            *part-tracker-params-default*
            :name "part-tracker"
            :to *entity-pool*
            :unk 0
            )
          )
      (go-virtual idle)
      )
    )
  :code sleep-code
  )


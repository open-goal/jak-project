;; definition for method 48 of type net-player-artifact
(defmethod handle-events ((this net-player-artifact) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (case arg2
    (('artifact-collected)
     (when (not (finish-scheduled? this))
       (+! (-> this score) (-> arg3 param 0))
       (write-score-change this)
       )
     (cond
       ((if (= (/ (-> this player-id) 2) (if *net-mgr*
                                             (-> *net-mgr* game-state local-machine-idx)
                                             0
                                             )
               )
            #t
            #f
            )
        (let ((s5-1 (the-as net-player-artifact #f)))
          (let ((f30-0 819200.0))
            (dotimes (s4-0 *active-net-player-count*)

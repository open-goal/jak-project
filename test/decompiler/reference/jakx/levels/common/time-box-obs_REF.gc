;; definition for method 53 of type time-freeze-short-draw
;; WARN: Return type mismatch int vs none.
(defmethod init! ((this time-freeze-short-draw) (arg0 net-powerup) (arg1 vector))
  (+! (-> arg1 y) 4096.0)
  (init-root! this 4.0)
  (let ((t9-1 (method-of-type powerup-draw init!)))
    (t9-1 this arg0 arg1)
    )
  (set! (-> this part) (create-launch-control (-> *part-group-id-table* 323) this))
  (art-group-get-by-name
    *level*
    (the-as
      string
      (-> (art-group-get-by-name *level* "skel-time-freeze-time-freeze-short" (the-as (pointer level) #f)) data 0)
      )
    (&-> this level)
    )
  (initialize-skeleton
    this
    (art-group-get-by-name *level* "skel-time-freeze-time-freeze-short" (the-as (pointer level) #f))
    0
    )
  (set! (-> this base-y) (-> this root trans y))
  (vector-float*! (-> this root scale) (-> this root scale) 0.7)
  (if (hflip?)
      (set! (-> this root scale x) (* -1.0 (-> this root scale x)))
      )
  0
  (none)
  )

;; definition for method 54 of type time-freeze-short-draw
;; INFO: Used lq/sq
;; WARN: Return type mismatch (pointer debris-group) vs none.
(defmethod spawn-pickup-effect ((this time-freeze-short-draw) (arg0 process-drawable))
  (when arg0
    (set! (-> *launch-matrix* trans quad) (-> this root trans quad))
    (set! (-> *part-tracker-params-default* group) (-> *part-group-id-table* 326))
    (vector-reset! (-> *part-tracker-params-default* local-offset))
    (set! (-> *part-tracker-params-default* duration) (the-as uint 300))
    (set! (-> *part-tracker-params-default* callback) #f)
    (set! (-> *part-tracker-params-default* userdata) (the-as uint #f))
    (set! (-> *part-tracker-params-default* target) arg0)
    (set! (-> *part-tracker-params-default* mat-joint) (the-as object 0))
    (set! (-> *part-tracker-params-default* local-space-param) 0)
    (set! (-> *part-tracker-params-default* local-space-callback) #f)
    (set! (-> *part-tracker-params-default* subsampler-num) 1.0)
    *part-tracker-params-default*
    (if (logtest? (-> *part-group-id-table* 326 flags) (sp-group-flag sp13))
        (process-spawn
          part-tracker-subsampler
          :init part-tracker-subsampler-init
          *part-tracker-params-default*
          :name "part-tracker-subsampler"
          :to *entity-pool*
          :unk 0
          )
        (process-spawn
          part-tracker
          :init part-tracker-init
          *part-tracker-params-default*
          :name "part-tracker"
          :to *entity-pool*
          :unk 0
          )
        )
    (let ((a1-8 (new 'stack 'debris-tuning (the-as uint 0))))
      (let ((v1-30 (vector-float*! (new 'stack-no-clear 'vector) (-> arg0 root transv) 1.3)))
        (set! (-> a1-8 scale-rand-lo) 0.5)
        (set! (-> a1-8 scale-rand-hi) 1.0)
        (set-vector! (-> a1-8 fountain-rand-transv-lo) -40960.0 40960.0 -40960.0 1.0)
        (vector+! (-> a1-8 fountain-rand-transv-lo) (-> a1-8 fountain-rand-transv-lo) v1-30)
        (set-vector! (-> a1-8 fountain-rand-transv-hi) 40960.0 122880.0 40960.0 1.0)
        (vector+! (-> a1-8 fountain-rand-transv-hi) (-> a1-8 fountain-rand-transv-hi) v1-30)
        )
      (set! (-> a1-8 fountain-rand-transv-hi w) 16384.0)
      (set! (-> a1-8 duration) (the-as uint 1200))
      (debris-spawn arg0 a1-8 *time-freeze-short-debris-params* this)
      )
    )
  (none)
  )

;; definition for method 57 of type time-freeze-short-draw
;; WARN: Return type mismatch quaternion vs object.
(defmethod tfsd ((this time-freeze-short-draw))
  (set! (-> this root trans y)
        (+ 4096.0 (* 8192.0 (sin (quaternion-y-angle (-> this root rotation)))) (-> this base-y))
        )
  (quaternion-rotate-y! (-> this root rotation) (-> this root rotation) (* 16384.0 (seconds-per-frame)))
  )

;; failed to figure out what this is:
(defstate idle (time-freeze-short-draw)
  :virtual #t
  :trans (behavior ()
    (update-draw self)
    (if (nonzero? (-> self part))
        (sparticle-launch-control-method-16 (-> self part) (-> self root trans))
        )
    (tfsd self)
    )
  :post ja-post
  )


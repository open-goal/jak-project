   (vehicle-handle  handle)
   )
  (:methods
    (tfsd (_type_) object)
    )
  )

;; definition for method 3 of type time-freeze-short-draw
(defmethod inspect ((this time-freeze-short-draw))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type powerup-draw inspect)))
    (t9-0 this)
    )
  (format #t "~2Tbase-y: ~f~%" (-> this base-y))
  (format #t "~2Tvehicle-handle: ~D~%" (-> this vehicle-handle))
  (label cfg-4)
  this
  )


(defmethod get-collision-sphere ((this time-freeze-short) (arg0 vector) (arg1 entity-actor))
  (cond
    (arg1
      (set! (-> arg0 quad) (-> arg1 trans quad))
      (set! (-> arg0 w) 32768.0)
      )
    (this
      (get-pos! this arg0)
      (set! (-> arg0 w) 32768.0)
      )
    (else
      (format 0 "ERROR: get-collision-sphere called with both self and ent #f.")
      )
    )
  (none)
  )


                          0
                          )
                        )
                      )
                )
           (set! (-> self arc-sound) (the-as sound-id v0-6))
           v0-6
           )
         )
       )
     )
    ((and (not (-> self lightning-on))
          (< (-> self lightning-time) (- (- (if *net-mgr*
                                                (-> *net-mgr* game-state time)
                                                0
                                                )
                                            (if *net-world*
                                                (-> *net-world* net-state game-start-time)
                                                0
                                                )
                                            )
                                         (if *net-world*
                                             (-> *net-world* net-state total-pause-time)
                                             0
                                             )
                                         )
             )
          )
     (let ((v1-40 (-> self l-control))
           (a0-63 1)
           )
       (let ((a1-39 (!= a0-63 (-> v1-40 state mode))))

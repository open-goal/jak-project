(in-package goal)

;; definition of type ctf-base
(deftype ctf-base (process-drawable)
  ((base-b  handle)
   (base-c  handle)
   (team    uint8)
   )
  (:state-methods
    idle
    )
  )

;; definition for method 3 of type ctf-base
(defmethod inspect ((this ctf-base))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type process-drawable inspect)))
    (t9-0 this)
    )
  (format #t "~2Tbase-b: ~D~%" (-> this base-b))
  (format #t "~2Tbase-c: ~D~%" (-> this base-c))
  (format #t "~2Tteam: ~D~%" (-> this team))
  (label cfg-4)
  this
  )


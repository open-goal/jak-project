;; definition for method 11 of type ctf-base
(defmethod init-from-entity! ((this ctf-base) (arg0 entity-actor))
  (stack-size-set! (-> this main-thread) 32)
  (let ((s4-0 (new 'process 'collide-shape this (collide-list-enum usually-hit-by-player))))
    (let ((s3-0 (new 'process 'collide-shape-prim-group s4-0 (the-as uint 1) 0)))
      (set! (-> s4-0 total-prims) (the-as uint 2))
      (set! (-> s3-0 prim-core collide-as) (collide-spec obstacle camera-blocker pusher))
      (set! (-> s3-0 prim-core collide-with) (collide-spec jak bot player-list))
      (set! (-> s3-0 prim-core action) (collide-action solid))
      (set! (-> s3-0 transform-index) 3)
      (set-vector! (-> s3-0 local-sphere) 0.0 40960.0 0.0 81920.0)
      (set! (-> s4-0 root-prim) s3-0)
      )
    (pusher-init s4-0)
    (let ((v1-13 (new 'process 'collide-shape-prim-mesh s4-0 (the-as uint 0) (the-as uint 0))))
      (set! (-> v1-13 prim-core collide-as) (collide-spec obstacle camera-blocker pusher))
      (set! (-> v1-13 prim-core collide-with) (collide-spec jak bot player-list))
      (set! (-> v1-13 prim-core action) (collide-action solid))
      (set! (-> v1-13 transform-index) 3)
      (set-vector! (-> v1-13 local-sphere) 0.0 40960.0 0.0 81920.0)
      )
    (set! (-> s4-0 nav-radius) (* 0.75 (-> s4-0 root-prim local-sphere w)))
    (let ((v1-16 (-> s4-0 root-prim)))
      (set! (-> s4-0 backup-collide-as) (-> v1-16 prim-core collide-as))
      (set! (-> s4-0 backup-collide-with) (-> v1-16 prim-core collide-with))
      )
    (set! (-> s4-0 event-self) 'touched)
    (set! (-> this root) s4-0)
    )
  (process-drawable-from-entity! this arg0)
  (set-vector! (-> this root scale) 1.5 1.5 1.5 1.0)
  (initialize-skeleton this (art-group-get-by-name *level* "skel-ctf-base" (the-as (pointer level) #f)) 0)
  (set! (-> this team) (res-lump-value (-> this entity) 'team uint :time -1000000000.0))
  (let ((v1-25 (-> this team)))
    (cond
      ((zero? v1-25)
       (set! *ctf-red-base* this)
       )
      ((= v1-25 1)
       (set! *ctf-blue-base* this)
       )
      )
    )
  (set! (-> this base-b) (process->handle (ctf-base-b-spawn this (-> this team))))
  (set! (-> this base-c) (process->handle (ctf-base-c-spawn this (-> this team))))
  (transform-post)
  (go (method-of-object this idle))
  )

;; definition for method 7 of type ctf-base
;; WARN: Return type mismatch process-drawable vs ctf-base.
(defmethod relocate ((this ctf-base) (offset int))
  (let ((v1-0 (-> this team)))
    (cond
      ((zero? v1-0)
       (if *ctf-red-base*
           (set! *ctf-red-base* (&+ *ctf-red-base* offset))
           )
       )
      ((= v1-0 1)
       (if *ctf-blue-base*
           (set! *ctf-blue-base* (&+ *ctf-blue-base* offset))
           )
       )
      )
    )
  (the-as ctf-base ((method-of-type process-drawable relocate) this offset))
  )

;; definition for method 10 of type ctf-base
(defmethod deactivate ((this ctf-base))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (let ((v1-0 (-> this team)))
    (cond
      ((zero? v1-0)
       (set! *ctf-red-base* #f)
       )
      ((= v1-0 1)
       (set! *ctf-blue-base* #f)
       )
      )
    )
  (send-event (handle->process (-> this base-b)) 'go-die)
  (send-event (handle->process (-> this base-c)) 'go-die)
  ((method-of-type process-drawable deactivate) this)
  (none)
  )

;; definition for function flag-at-base?
;; WARN: Return type mismatch object vs symbol.
(defbehavior flag-at-base? ctf-base ()
  (the-as symbol (and *ctf-flag*
                      (= (-> *ctf-flag* team) (-> self team))
                      (< (vector-vector-distance (-> *ctf-flag* root trans) (-> self root trans)) 32768.0)
                      )
          )
  )

;; failed to figure out what this is:
(defstate idle (ctf-base)
  :virtual #t
  :trans (behavior ()
    (when (and (flag-at-base?) *ctf-flag*)
      (let ((gp-0 (the-as wvehicle (handle->process (-> *ctf-flag* carrier)))))
        (when gp-0
          (let ((s5-0 (-> *net-players* (-> gp-0 player-id))))
            (when (and (or (if (= (/ (-> s5-0 player-id) 2) (if *net-mgr*
                                                                (-> *net-mgr* game-state local-machine-idx)
                                                                0
                                                                )
                                  )
                               #t
                               #f
                               )
                           (and (>= (-> s5-0 player-id) 16) (= (if *net-mgr*
                                                                   (-> *net-mgr* game-state local-machine-idx)
                                                                   0
                                                                   )
                                                               (-> *net-mgr* game-state session-master-idx)
                                                               )
                                )
                           )
                       (not (send-event *net-game-mgr* 'game-finished?))
                       )
              (send-event s5-0 'flag-captured)
              (send-event *ctf-flag* 'flag-captured gp-0)
              )
            )
          )
        )
      )
    )
  :code sleep-code
  )

;; definition of type ctf-captured-flag
(deftype ctf-captured-flag (process-drawable)
  ((pos             vector  :inline)
   (end             vector  :inline)
   (l-control       lightning-control)
   (lightning-time  int32)
   (arc-sound       sound-id)
   (lightning-on    symbol)
   (index           int8)
   )
  (:state-methods
    idle
    )
  )

;; definition for method 3 of type ctf-captured-flag
(defmethod inspect ((this ctf-captured-flag))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type process-drawable inspect)))
    (t9-0 this)
    )
  (format #t "~2Tpos: #<vector @ #x~X>~%" (-> this pos))
  (format #t "~2Tend: #<vector @ #x~X>~%" (-> this end))
  (format #t "~2Tl-control: ~A~%" (-> this l-control))
  (format #t "~2Tlightning-time: ~D~%" (-> this lightning-time))
  (format #t "~2Tarc-sound: ~D~%" (-> this arc-sound))
  (format #t "~2Tlightning-on: ~A~%" (-> this lightning-on))
  (format #t "~2Tindex: ~D~%" (-> this index))
  (label cfg-4)
  this
  )

;; failed to figure out what this is:
(set! (-> *lightning-spec-id-table* 6) (new 'static 'lightning-spec
                                         :name "lightning-fractal-ctf-captured-flag"
                                         :flags (lightning-spec-flags lsf1)
                                         :start-color (new 'static 'rgba :r #x40 :g #x80 :b #xff :a #x80)
                                         :fade-to-color (new 'static 'rgba :r #xbf :b #x8f :a #x5)
                                         :fade-start-factor 0.2
                                         :fade-time 120.0
                                         :texture (new 'static 'texture-id :index #xab :page #x4)
                                         :reduction 2.0
                                         :num-points 16
                                         :box-size 2048.0
                                         :merge-factor 0.5
                                         :merge-count 2
                                         :radius 2457.6
                                         :duration -1.0
                                         :sound #f
                                         )
      )

;; definition for function seek-default-size
;; WARN: Return type mismatch vector vs none.
(defbehavior seek-default-size ctf-captured-flag ()
  (let* ((f0-0 (-> self root scale x))
         (f0-1 (+ f0-0 (fmax (fmin (- 2.5 f0-0) (* 2.5 (seconds-per-frame))) (* -2.5 (seconds-per-frame)))))
         )
    (set-vector! (-> self root scale) f0-1 f0-1 f0-1 1.0)
    )
  (none)
  )

;; definition for function move-captured-flag
;; INFO: Used lq/sq
(defbehavior move-captured-flag ctf-captured-flag ()
  (let ((gp-0 (new 'stack-no-clear 'vector)))
    (set! (-> gp-0 quad) (-> self pos quad))
    (let* ((v1-8 (* (* (+ (- (- (if *net-mgr*
                                    (-> *net-mgr* game-state time)
                                    0
                                    )
                                (if *net-world*
                                    (-> *net-world* net-state game-start-time)
                                    0
                                    )
                                )
                             (if *net-world*
                                 (-> *net-world* net-state total-pause-time)
                                 0
                                 )
                             )
                          (* 1500 (-> self index))
                          )
                       (the int (+ 1.0 (* 0.25 (the float (logand (* 17 (-> self index)) 3)))))
                       )
                    (the int (+ 1.0 (* -2.0 (the float (logand (-> self index) 1)))))
                    )
                 )
           (f30-0 (the float (+ v1-8 (* 300 (-> self index)))))
           )
      (set! (-> gp-0 y) (+ 81920.0 (* 20480.0 (cos (* 70.0 (the float v1-8)))) (-> gp-0 y)))
      (let ((s5-0 (new 'stack-no-clear 'inline-array 'matrix 1)))
        (quaternion-axis-angle! (the-as quaternion (-> s5-0 0)) 0.0 1.0 0.0 (* 50.0 f30-0))
        (quaternion->matrix (the-as matrix (-> s5-0 0 uvec)) (the-as quaternion (-> s5-0 0)))
        (vector+float*! gp-0 gp-0 (-> s5-0 0 trans) 40960.0)
        )
      )
    (vector-seek-3d-smooth! (-> self root trans) gp-0 1228.8 0.1)
    )
  (seek-default-size)
  (cond
    ((-> self lightning-on)
     (cond
       ((< (+ (-> self lightning-time) 150) (- (- (if *net-mgr*
                                                      (-> *net-mgr* game-state time)
                                                      0
                                                      )
                                                  (if *net-world*
                                                      (-> *net-world* net-state game-start-time)
                                                      0
                                                      )
                                                  )
                                               (if *net-world*
                                                   (-> *net-world* net-state total-pause-time)
                                                   0
                                                   )
                                               )
           )
        (let ((v1-18 (-> self l-control))
              (a0-37 0)
              )
          (let ((a1-14 (!= a0-37 (-> v1-18 state mode))))
            (case a0-37
              ((3)
               (if a1-14
                   (set! (-> v1-18 state counter) 0.0)
                   )
               )
              ((1)
               (set! (-> v1-18 state start-color) (-> v1-18 spec start-color))
               (set! (-> v1-18 state end-color) (-> v1-18 spec end-color))
               )
              )
            )
          (set! (-> v1-18 state mode) (the-as uint a0-37))
          )
        (set! (-> self lightning-on) #f)
        (let ((gp-1 (- (- (if *net-mgr*
                              (-> *net-mgr* game-state time)
                              0
                              )
                          (if *net-world*
                              (-> *net-world* net-state game-start-time)
                              0
                              )
                          )
                       (if *net-world*
                           (-> *net-world* net-state total-pause-time)
                           0
                           )
                       )
                    )
              (f30-1 1500.0)
              )
          (set! (-> self lightning-time) (+ gp-1 (the int (* f30-1 (rand-float-gen)))))
          )
        (sound-stop (-> self arc-sound) #t)
        )
       (else
         (let ((a0-48 (-> self l-control))
               (v1-31 (-> self root trans))
               )
           (set! (-> a0-48 state meet data 0 quad) (-> v1-31 quad))
           )
         (let ((a0-51 (-> self l-control))
               (v1-33 (-> self end))
               )
           (set! (-> a0-51 state meet data (+ (-> a0-51 state points-to-draw) -1) quad) (-> v1-33 quad))
           )
         (let* ((v1-36 (make-sound-instance snd-arc-loop (-> self arc-sound) (the-as handle #f)))
                (v0-6 (cond
                        (v1-36
                          (set! (-> v1-36 trans quad) (-> self root trans quad))
                          (logior! (-> v1-36 flags) (sound-spec-flag no-track needs-update))
                          (-> v1-36 id)
                          )

;; definition for method 7 of type ctf-captured-flag
;; WARN: Return type mismatch process-drawable vs ctf-captured-flag.
(defmethod relocate ((this ctf-captured-flag) (offset int))
  (if (nonzero? (-> this l-control))
      (&+! (-> this l-control) offset)
      )
  (the-as ctf-captured-flag ((method-of-type process-drawable relocate) this offset))
  )

;; definition for method 10 of type ctf-captured-flag
(defmethod deactivate ((this ctf-captured-flag))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (let ((v1-0 (-> this l-control))

            (set! (-> v1-40 state start-color) (-> v1-40 spec start-color))
            (set! (-> v1-40 state end-color) (-> v1-40 spec end-color))
            )
           )
         )
       (set! (-> v1-40 state mode) (the-as uint a0-63))
       )
     (set! (-> self lightning-on) #t)
     (set! (-> *launch-matrix* trans quad) (-> *null-vector* quad))
     (set! (-> *part-tracker-params-default* group) (-> *part-group-id-table* 328))
     (vector-reset! (-> *part-tracker-params-default* local-offset))
     (set! (-> *part-tracker-params-default* duration) (the-as uint 150))
     (set! (-> *part-tracker-params-default* callback) #f)

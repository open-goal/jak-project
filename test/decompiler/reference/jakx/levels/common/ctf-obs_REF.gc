;; definition for function ctf-base-b-init-by-other
;; INFO: Used lq/sq
(defbehavior ctf-base-b-init-by-other ctf-base-b ((arg0 ctf-base) (arg1 uint))
  (stack-size-set! (-> self main-thread) 32)
  (logior! (-> self mask) (process-mask actor-pause))
  (set! (-> self root) (new 'process 'trsqv))
  (set! (-> self root trans quad) (-> arg0 root trans quad))
  (quaternion-copy! (-> self root rotation) (-> arg0 root rotation))
  (set-vector! (-> self root scale) 1.5 1.5 1.5 1.0)
  (initialize-skeleton self (art-group-get-by-name *level* "skel-ctf-base-b" (the-as (pointer level) #f)) 0)
  (cond
    ((zero? arg1)
     (setup-masks (-> self draw) 0 1)
     )
    ((= arg1 1)
     (setup-masks (-> self draw) 0 2)
     )
    )
  (ja-post)
  (go-virtual idle)
  )

;; failed to figure out what this is:
(defstate idle (ctf-base-b)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('go-die)
       (go empty-state)
       )
      )
    )
  :code sleep-code
  )

;; definition for function ctf-base-b-spawn
;; WARN: Return type mismatch process vs ctf-base-b.
(defun ctf-base-b-spawn ((arg0 ctf-base) (arg1 uint))
  (let ((gp-0 (the-as process #f)))
    (let ((v1-1 (process-spawn ctf-base-b arg0 arg1 :name "ctf-base-b" :to arg0)))
      (if v1-1
          (set! gp-0 (-> v1-1 0))
          )
      )
    (the-as ctf-base-b gp-0)
    )
  )


    (set! (-> self root trans y) (+ 12288.0 (* 4915.2 (cos (* 100.0 f30-0))) (-> self root trans y)))
    (let ((gp-0 (new 'stack-no-clear 'matrix)))
      (quaternion-axis-angle! (the-as quaternion (-> gp-0 rvec)) 0.0 1.0 0.0 (* 80.0 f30-0))
      (quaternion->matrix (the-as matrix (-> gp-0 uvec)) (the-as quaternion (-> gp-0 rvec)))
      (vector+float*! (-> self root trans) (-> self root trans) (-> gp-0 trans) 6144.0)
      (quaternion-axis-angle! (the-as quaternion (-> gp-0 rvec)) 0.0 1.0 0.0 (* 50.0 f30-0))
      (quaternion*! (-> self root rotation) (the-as quaternion (-> gp-0 rvec)) *eco-blue-base-quat*)
      )
    )
  (transform-post)
  (none)
  )

;; definition for function seek-size
(defbehavior seek-size ctf-flag ((arg0 float))
  (let* ((f0-0 (-> self root scale x))
         (f0-1 (+ f0-0 (fmax (fmin (- arg0 f0-0) (seconds-per-frame)) (* -1.0 (seconds-per-frame)))))
         (v0-0 (-> self root scale))
         )
    (set! (-> v0-0 x) f0-1)
    (set! (-> v0-0 y) f0-1)
    (set! (-> v0-0 z) f0-1)
    (set! (-> v0-0 w) 1.0)
    v0-0
    )
  )


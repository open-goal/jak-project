;;-*-Lisp-*-
(in-package goal)

;; definition for symbol V_YELLOW_GUIDED_MISSILE_STANDOFF_TIME, type int
(define V_YELLOW_GUIDED_MISSILE_STANDOFF_TIME 300)

;; definition for symbol V_WPN_SHIELD_COLOR_LEVEL_I, type vector
(define V_WPN_SHIELD_COLOR_LEVEL_I (new 'static 'vector :x 0.75 :w 1.0))

;; definition for symbol V_WPN_SHIELD_COLOR_LEVEL_II, type vector
(define V_WPN_SHIELD_COLOR_LEVEL_II (new 'static 'vector :x 0.25 :z 1.0 :w 1.0))

;; definition for symbol *v-wpn-available-yellow*, type (array uint8)
(define *v-wpn-available-yellow* (new 'static 'boxed-array :type uint8 #x2 #x3 #x4 #x5 #xf))

;; definition for symbol *v-wpn-available-red*, type (array uint8)
(define *v-wpn-available-red* (new 'static 'boxed-array :type uint8 #x8 #xb #xc #x9 #xd #xa))

;; definition for symbol *v-wpn-available-purple*, type (array uint8)
(define *v-wpn-available-purple* (new 'static 'boxed-array :type uint8 #xa))

;; definition for symbol *weapon-select-table-yellow-even*, type v-wpn-ptable
(define *weapon-select-table-yellow-even* (new 'static 'v-wpn-ptable
                                            :entries-count 4
                                            :total-chance #x4
                                            :entries-array (new 'static 'inline-array v-wpn-ptable-entry 4
                                              (new 'static 'v-wpn-ptable-entry :chance #x1 :weapon-type #x2)
                                              (new 'static 'v-wpn-ptable-entry :chance #x1 :weapon-type #x3)
                                              (new 'static 'v-wpn-ptable-entry :chance #x1 :weapon-type #x5)
                                              (new 'static 'v-wpn-ptable-entry :chance #x1 :weapon-type #x4)
                                              )
                                            )
        )


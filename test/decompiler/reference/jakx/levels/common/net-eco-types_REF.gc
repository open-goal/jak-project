(defstate running (eco-blue)
  :virtual #t
  :enter (behavior ()
    (let ((v1-2 (the-as structure (-> self entity extra perm))))
      (when (and (< 1500 (- (- (if *net-mgr*
                                   (-> *net-mgr* game-state time)
                                   0
                                   )
                               (if *net-world*
                                   (-> *net-world* net-state game-start-time)
                                   0
                                   )
                               )
                            (if *net-world*
                                (-> *net-world* net-state total-pause-time)
                                0
                                )
                            )
                    )
                 (< (- (- (- (if *net-mgr*
                                 (-> *net-mgr* game-state time)
                                 0
                                 )
                             (if *net-world*
                                 (-> *net-world* net-state game-start-time)
                                 0
                                 )
                             )
                          (if *net-world*
                              (-> *net-world* net-state total-pause-time)
                              0
                              )
                          )
                       (-> (the-as eco-perm v1-2) time)
                       )
                    150
                    )
                 )
        (let ((v1-7 (new 'stack-no-clear 'vector)))
          (set! (-> v1-7 quad) (-> self entity trans quad))
          (+! (-> v1-7 y) 24576.0)
          (set! (-> *launch-matrix* trans quad) (-> v1-7 quad))
          )
        (set! (-> *part-tracker-params-default* group) (-> *part-group-id-table* 180))
        (vector-reset! (-> *part-tracker-params-default* local-offset))
        (set! (-> *part-tracker-params-default* duration) (the-as uint 1500))
        (set! (-> *part-tracker-params-default* callback) #f)
        (set! (-> *part-tracker-params-default* userdata) (the-as uint #f))
        (set! (-> *part-tracker-params-default* target) #f)
        (set! (-> *part-tracker-params-default* mat-joint) *launch-matrix*)
        (set! (-> *part-tracker-params-default* local-space-param) 0)
        (set! (-> *part-tracker-params-default* local-space-callback) #f)
        (set! (-> *part-tracker-params-default* subsampler-num) 1.0)
        *part-tracker-params-default*
        (if (logtest? (-> *part-group-id-table* 180 flags) (sp-group-flag sp13))
            (process-spawn
              part-tracker-subsampler
              :init part-tracker-subsampler-init
              *part-tracker-params-default*
              :name "part-tracker-subsampler"
              :to *entity-pool*
              :unk 0
              )
            (process-spawn
              part-tracker
              :init part-tracker-init
              *part-tracker-params-default*
              :name "part-tracker"
              :to *entity-pool*
              :unk 0
              )
            )
        )
      )
    (let ((t9-6 (-> (method-of-type eco running) enter)))
      (if t9-6
          (t9-6)
          )
      )
    )
  :trans (behavior ()
    (set! (-> self root trans quad) (-> self entity extra trans quad))
    (+! (-> self root trans y) 24576.0)
    (let ((f30-0 (the float (+ (mod (* 3797 (-> self pid)) 900) (current-time)))))
      (+! (-> self root trans y) (* 2457.6 (cos (* 94.24777 f30-0))))
      (let ((gp-0 (new 'stack-no-clear 'inline-array 'quaternion 1)))
        (quaternion-axis-angle! (-> gp-0 0) 0.0 1.0 0.0 (* 94.24777 f30-0))
        (quaternion*! (-> self root rotation) (-> gp-0 0) *eco-blue-base-quat*)
        )
      )
    )
  :code (behavior ()
    (let ((v1-2 (the-as structure (-> self entity extra perm))))
      (when (and (< 1500 (- (- (if *net-mgr*
                                   (-> *net-mgr* game-state time)
                                   0
                                   )
                               (if *net-world*
                                   (-> *net-world* net-state game-start-time)
                                   0
                                   )
                               )
                            (if *net-world*
                                (-> *net-world* net-state total-pause-time)
                                0
                                )
                            )
                    )
                 (< (- (- (- (if *net-mgr*
                                 (-> *net-mgr* game-state time)
                                 0
                                 )
                             (if *net-world*
                                 (-> *net-world* net-state game-start-time)
                                 0
                                 )
                             )
                          (if *net-world*
                              (-> *net-world* net-state total-pause-time)
                              0
                              )
                          )
                       (-> (the-as eco-perm v1-2) time)
                       )
                    150
                    )
                 )
        (when (type? (-> self root) collide-shape)
          (let ((v1-9 (-> (the-as collide-shape (-> self root)) root-prim)))
            (set! (-> v1-9 prim-core collide-as) (collide-spec))
            (set! (-> v1-9 prim-core collide-with) (collide-spec))
            )
          0
          )
        (logior! (-> self draw status) (draw-control-status no-draw))
        (if (type? (-> self root) collide-shape)
            (transform-post)
            )
        (suspend-for (seconds 0.667)
          )
        (when (type? (-> self root) collide-shape)
          (let ((v1-23 (-> (the-as collide-shape (-> self root)) root-prim)))
            (set! (-> v1-23 prim-core collide-as) (-> (the-as collide-shape (-> self root)) backup-collide-as))
            (set! (-> v1-23 prim-core collide-with) (-> (the-as collide-shape (-> self root)) backup-collide-with))
            )
          )
        (logclear! (-> self draw status) (draw-control-status no-draw))
        (if (type? (-> self root) collide-shape)
            (transform-post)
            )
        )
      )
    (until #f
      (when (< (-> self draw cur-lod) 1)
        (dotimes (gp-1 5)
          (set! (-> self launcher gp-1 birthaccum) (-> self birth-accum gp-1))
          (launch-particles (-> self launcher gp-1) (-> self node-list data 0 bone transform) :origin-is-matrix #t)
          (set! (-> self birth-accum gp-1) (-> self launcher gp-1 birthaccum))
          )
        )
      (suspend)
      )
    #f
    )
  :post (behavior ()
    (ja-post)
    )
  )


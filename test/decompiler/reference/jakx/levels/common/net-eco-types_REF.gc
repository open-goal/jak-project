;; definition for symbol *eco-blue-debris-params*, type debris-static-params
(define *eco-blue-debris-params*
  (new 'static 'debris-static-params
    :joints (new 'static 'boxed-array :type debris-static-joint-params
      (new 'static 'debris-static-joint-params :group "skel-eco-blue-debris-a")
      (new 'static 'debris-static-joint-params :group "skel-eco-blue-debris-b")
      (new 'static 'debris-static-joint-params :group "skel-eco-blue-debris-c")
      (new 'static 'debris-static-joint-params :group "skel-eco-blue-debris-d")
      (new 'static 'debris-static-joint-params :group "skel-eco-blue-debris-a")
      (new 'static 'debris-static-joint-params :group "skel-eco-blue-debris-c")
      )
    :collide-spec (collide-spec backgnd)
    )
  )

;; definition of type eco-blue
(deftype eco-blue (eco)
  ((launcher     sparticle-launcher  5)
   (birth-accum  float               5)
   )
  )

;; definition for method 3 of type eco-blue
(defmethod inspect ((this eco-blue))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type eco inspect)))
    (t9-0 this)
    )
  (format #t "~2Tlauncher[5] @ #x~X~%" (-> this launcher))
  (format #t "~2Tbirth-accum[5] @ #x~X~%" (-> this birth-accum))
  (label cfg-4)
  this
  )

;; definition for symbol *eco-blue-base-quat*, type quaternion
(define *eco-blue-base-quat* (new 'static 'quaternion))

;; failed to figure out what this is:
(quaternion-axis-angle! *eco-blue-base-quat* 1.0 0.0 0.0 4000.0)

;; failed to figure out what this is:
(defskelgroup skel-eco-blue eco-blue eco-blue-lod0-jg eco-blue-idle-ja
              ((eco-blue-lod0-mg (meters 20)) (eco-blue-lod1-mg (meters 40)) (eco-blue-lod2-mg (meters 999999)))
              :bounds (static-spherem 0 0 0 5)
              :texture-level 18
              )

;; definition for method 52 of type eco-blue
;; WARN: Return type mismatch int vs none.
(defmethod init! ((this eco-blue))
  (initialize-skeleton this (art-group-get-by-name *level* "skel-eco-blue" (the-as (pointer level) #f)) 0)
  (set! (-> this launcher 0) (-> *part-id-table* 710))
  (set! (-> this launcher 1) (-> *part-id-table* 711))
  (set! (-> this launcher 2) (-> *part-id-table* 712))
  (set! (-> this launcher 3) (-> *part-id-table* 713))
  (set! (-> this launcher 4) (-> *part-id-table* 714))
  (dotimes (v1-13 5)
    (set! (-> this birth-accum v1-13) 0.0)
    )
  (go (method-of-object this running))
  0
  (none)
  )

;; definition for method 53 of type eco-blue
;; INFO: Used lq/sq
(defmethod on-collected ((this eco-blue) (arg0 entity-actor) (arg1 int))
  (let ((s3-0 (new 'stack-no-clear 'inline-array 'vector 1))
        (s2-0 (if (-> *net-players* arg1)
                  (get-vehicle (-> *net-players* arg1))
                  (the-as wvehicle #f)
                  )
              )
        )
    (when s2-0
      (send-event s2-0 'pickup 'blue #x3f000000)
      (when this
        (let ((v1-17 (make-sound-instance snd-pickup-burst (new 'static 'sound-id) (process->handle s2-0))))
          (if v1-17
              (-> v1-17 id)
              0
              )
          )
        (let ((v1-23 (make-sound-instance snd-pu-turbo (new 'static 'sound-id) (process->handle s2-0))))
          (if v1-23
              (-> v1-23 id)
              0
              )
          )
        (vector-float*! (-> s3-0 0) (-> s2-0 root transv) 0.9)
        (set! (-> *launch-matrix* trans quad) (-> this root trans quad))
        (set! (-> *part-tracker-params-default* group) (-> *part-group-id-table* 213))
        (vector-reset! (-> *part-tracker-params-default* local-offset))
        (set! (-> *part-tracker-params-default* duration) (the-as uint 300))
        (set! (-> *part-tracker-params-default* callback) #f)
        (set! (-> *part-tracker-params-default* userdata) (the-as uint #f))
        (set! (-> *part-tracker-params-default* target) s2-0)
        (set! (-> *part-tracker-params-default* mat-joint) (the-as object 0))
        (set! (-> *part-tracker-params-default* local-space-param) 0)
        (set! (-> *part-tracker-params-default* local-space-callback) #f)
        (set! (-> *part-tracker-params-default* subsampler-num) 1.0)
        *part-tracker-params-default*
        (if (logtest? (-> *part-group-id-table* 213 flags) (sp-group-flag sp13))
            (process-spawn
              part-tracker-subsampler
              :init part-tracker-subsampler-init
              *part-tracker-params-default*
              :name "part-tracker-subsampler"
              :to *entity-pool*
              :unk 0
              )
            (process-spawn
              part-tracker
              :init part-tracker-init
              *part-tracker-params-default*
              :name "part-tracker"
              :to *entity-pool*
              :unk 0
              )
            )
        (let ((a1-12 (new 'stack 'debris-tuning (the-as uint 0))))
          (set! (-> a1-12 scale-rand-lo) 0.35)
          (set! (-> a1-12 scale-rand-hi) 0.5)
          (set-vector! (-> a1-12 fountain-rand-transv-lo) -40960.0 40960.0 -40960.0 1.0)
          (vector+! (-> a1-12 fountain-rand-transv-lo) (-> a1-12 fountain-rand-transv-lo) (-> s3-0 0))
          (set-vector! (-> a1-12 fountain-rand-transv-hi) 40960.0 122880.0 40960.0 1.0)
          (vector+! (-> a1-12 fountain-rand-transv-hi) (-> a1-12 fountain-rand-transv-hi) (-> s3-0 0))
          (set! (-> a1-12 fountain-rand-transv-hi w) 16384.0)
          (set! (-> a1-12 duration) (the-as uint 1200))
          (debris-spawn s2-0 a1-12 *eco-blue-debris-params* this)
          )
        )
      )
    )
  ((method-of-type eco on-collected) this arg0 arg1)
  (none)
  )


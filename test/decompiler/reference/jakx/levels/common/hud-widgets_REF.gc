;; definition for method 23 of type hud-item-score
(defmethod hud-item-method-23 ((this hud-item-score) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (case arg2
    (('update-score)
     (let ((v1-8 (-> *net-players* (+ (view-get-active-index) (* (if *net-mgr*
                                                                     (-> *net-mgr* game-state local-machine-idx)
                                                                     0
                                                                     )
                                                                 2
                                                                 )
                                      )
                     )
                 )
           )
       (when (and v1-8 (= (-> v1-8 player-id) (-> this player-id)))
         (+! (-> v1-8 score) (-> arg3 param 1))
         (let ((v1-10 (make-sound-instance snd-kill-counter (new 'static 'sound-id) (the-as handle #f))))
           (if v1-10
               (-> v1-10 id)
               0
               )
           )
         )
       )
     )
    (else
      ((method-of-type hud-item-group hud-item-method-23) this arg0 arg1 arg2 arg3)
      )
    )
  )

;; definition for method 9 of type hud-item-score
(defmethod init ((this hud-item-score))
  (set! (-> this previous-score) -1)
  (set! (-> this player-id) (-> this initial-player-id))
  (set! (-> (the-as hud-item-sprite (-> this items 0)) tex-id) (-> this initial-texture-id))
  (set! (-> (the-as hud-item-sprite (-> this items 1)) tex-id) (new 'static 'texture-id :index #xd3 :page #x9))
  (cond
    ((= (-> this player-id) -2)
     (set! (-> this player-id) (* (if *net-mgr*
                                      (-> *net-mgr* game-state local-machine-idx)
                                      0
                                      )
                                  2
                                  )
           )
     )
    ((= (-> this player-id) -3)
     (set! (-> this player-id) (+ (* (if *net-mgr*
                                         (-> *net-mgr* game-state local-machine-idx)
                                         0
                                         )
                                     2
                                     )
                                  1
                                  )
           )
     )
    )
  ((method-of-type hud-item-group init) this)
  )

;; definition for method 19 of type hud-item-score
(defmethod update ((this hud-item-score))
  (cond
    ((and (!= -1 (-> this player-id)) (not (logtest? (-> *net-world* net-state flags) 4)))
     (when (-> *net-players* (-> this player-id))
       (let ((s4-0 (the-as hud-item-sprite (-> this items 0)))
             (s5-0 (the-as hud-item-sprite (-> this items 1)))
             (v1-13 (if *net-world*
                        (-> *net-world* net-state assigned-drivers-s8 (-> this player-id))
                        -1
                        )
                    )
             )
         (when (and (not (logtest? (-> *net-world* net-state flags) 4)) (!= v1-13 -1))
           (let* ((v1-16 (-> *net-drivers* v1-13))
                  (a0-14 (-> v1-16 icon-part1))
                  (s3-0 (-> v1-16 icon-part2))
                  )
             (set! (-> s4-0 tex-id) (the-as texture-id a0-14))
             (set! (-> s5-0 tex-id) (the-as texture-id s3-0))
             (set-texture! s4-0 (lookup-texture-by-id (the-as texture-id a0-14)))
             (set-texture! s5-0 (lookup-texture-by-id (the-as texture-id s3-0)))
             )
           )
         )
       (let ((s5-1 (the-as hud-item-sprite (-> this items 3)))
             (s4-2 -1)
             )
         (cond
           ((and (= (if *net-world*
                        (the-as int (-> *net-world* task-node-info net-play-mode))
                        18
                        )
                    14
                    )
                 (let ((s3-1 (view-get-active-index)))
                   (and (when (= (net-game-mgr-assassin-method-85
                                   (the-as net-game-mgr-assassin *net-game-mgr*)
                                   (+ s3-1 (* (if *net-mgr*
                                                  (-> *net-mgr* game-state local-machine-idx)
                                                  0
                                                  )

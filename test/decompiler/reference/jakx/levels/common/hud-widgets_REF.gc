  )

;; definition for method 19 of type hud-medal
(defmethod update ((this hud-medal))
  (local-vars (s5-1 int))
  (cond
    ((< 1 (-> *net-game-mgr* human-ct))
     (hide (-> this items 0))
     (hide (-> this items 1))
     (hide (-> this items 2))
     )
    (else
      (show (-> this items 0))
      (let ((s3-0 (-> *net-players*
                      (* (if *net-mgr*
                             (-> *net-mgr* game-state local-machine-idx)
                             0
                             )
                         2
                         )
                      display-score
                      )
                  )
            )
        0
        (case (if *net-world*
                  (the-as int (-> *net-world* task-node-info net-play-mode))
                  18
                  )
          ((2)
           (set! s3-0 (-> *net-players*
                          (* (if *net-mgr*
                                 (-> *net-mgr* game-state local-machine-idx)
                                 0
                                 )
                             2
                             )
                          score
                          )
                 )
           )
          )
        (let ((s5-0 (get-open-task-node-info))
              (s4-0 (if (and (= *game-mode* 'adventure) (logtest? (-> *game-info* secrets) (game-secrets hero-mode)))
                        1
                        0
                        )
                    )
              )
          (if (-> this score-as-time)
              (set! s3-0 (the int (* 0.0033333334 (the float s3-0))))
              )
          (cond
            ((logtest? (game-task-node-flag score-lower-is-better) (-> s5-0 flags))
             (cond
               ((< s3-0 (the int (-> s5-0 gold-array s4-0)))
                (set-string!
                  (the-as hud-item-string (-> this items 0))
                  (lookup-text! *common-text* (text-id text-id-1620) #f)
                  )
                (set! s5-1 (the int (-> s5-0 gold-array s4-0)))
                (set-color! (the-as hud-item-string (-> this items 0)) (font-color font-color-50))
                )
               ((< s3-0 (the int (-> s5-0 silver-array s4-0)))
                (set-string!
                  (the-as hud-item-string (-> this items 0))
                  (lookup-text! *common-text* (text-id text-id-1619) #f)
                  )
                (set! s5-1 (the int (-> s5-0 silver-array s4-0)))
                (set-color! (the-as hud-item-string (-> this items 0)) (font-color font-color-49))
                )
               (else
                 (set-string!
                   (the-as hud-item-string (-> this items 0))
                   (lookup-text! *common-text* (text-id text-id-1618) #f)
                   )
                 (set! s5-1 (the int (-> s5-0 bronze-array s4-0)))
                 (set-color! (the-as hud-item-string (-> this items 0)) (font-color font-color-48))
                 )
               )
             )
            (else
              (if (-> this score-as-time)
                  (set! s3-0 (the-as int (* 0.0033333334 (the float s3-0))))
                  )
              (cond
                ((< s3-0 (the int (-> s5-0 bronze-array s4-0)))
                 (set-string!
                   (the-as hud-item-string (-> this items 0))
                   (lookup-text! *common-text* (text-id text-id-1618) #f)
                   )
                 (set! s5-1 (the int (-> s5-0 bronze-array s4-0)))
                 (set-color! (the-as hud-item-string (-> this items 0)) (font-color font-color-48))
                 )
                ((< s3-0 (the int (-> s5-0 silver-array s4-0)))
                 (set-string!
                   (the-as hud-item-string (-> this items 0))
                   (lookup-text! *common-text* (text-id text-id-1619) #f)
                   )
                 (set! s5-1 (the int (-> s5-0 silver-array s4-0)))
                 (set-color! (the-as hud-item-string (-> this items 0)) (font-color font-color-49))
                 )
                (else
                  (set-string!
                    (the-as hud-item-string (-> this items 0))
                    (lookup-text! *common-text* (text-id text-id-1620) #f)
                    )
                  (set! s5-1 (the int (-> s5-0 gold-array s4-0)))
                  (set-color! (the-as hud-item-string (-> this items 0)) (font-color font-color-50))
                  )
                )
              )
            )
          )
        )
      (let ((s4-1 (-> this items 1))
            (s3-7 (-> this items 2))
            )
        (cond
          ((-> this score-as-time)
           (show s3-7)
           (hide s4-1)
           (set! (-> (the-as hud-clock s3-7) fixed-time-val) (* 300 s5-1))
           )
          (else
            (hide s3-7)
            (show s4-1)
            (set-int! (the-as hud-item-string s4-1) s5-1)
            )
          )
        )
      )
    )
  ((method-of-type hud-item-group update) this)
  (none)
  )


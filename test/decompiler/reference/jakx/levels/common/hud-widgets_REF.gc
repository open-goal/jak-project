;; definition for method 24 of type hud-player-icon-name
;; INFO: Used lq/sq
(defmethod set-player-id! ((this hud-player-icon-name) (arg0 int))
  (set! (-> this player-id) arg0)
  (let ((s1-0 (the-as hud-item-sprite (-> this items 1)))
        (s2-0 (the-as hud-item-sprite (-> this items 3)))
        (s3-0 (the-as hud-item-sprite (-> this items 2)))
        (s4-0 (the-as hud-item-sprite (-> this items 4)))
        (v1-7 (if *net-world*
                  (-> *net-world* net-state assigned-drivers-s8 (-> this player-id))
                  -1
                  )
              )
        )
    (when (!= v1-7 -1)
      (let* ((v1-10 (-> *net-drivers* v1-7))
             (sv-32 (-> v1-10 picture-part1))
             (s0-0 (-> v1-10 picture-part2))
             )
        (set! (-> s1-0 tex-id) (the-as texture-id sv-32))
        (set! (-> s2-0 tex-id) (the-as texture-id s0-0))
        (set! (-> s3-0 tex-id) (the-as texture-id sv-32))
        (set! (-> s4-0 tex-id) (the-as texture-id s0-0))
        (set-texture! s1-0 (lookup-texture-by-id (the-as texture-id sv-32)))
        (set-texture! s2-0 (lookup-texture-by-id (the-as texture-id s0-0)))
        (set-texture! s3-0 (lookup-texture-by-id (the-as texture-id sv-32)))
        (set-texture! s4-0 (lookup-texture-by-id (the-as texture-id s0-0)))
        )
      )
    )
  (set-string!
    (the-as hud-item-string (-> this items 0))
    (string<-charp *temp-string* (-> *net-player-names* arg0 format-name))
    )
  (none)
  )

;; definition of type hud-clock
(deftype hud-clock (hud-item-group)
  ((clock-id         int8)
   (count-up         symbol)
   (fixed-time?      symbol)
   (show-before-red  symbol)
   (red-time         int32)
   (text-id          text-id)
   (fixed-time-val   int32)
   )
  (:methods
    (set-clock-time! (_type_ int int) none)
    )
  )

;; definition for method 3 of type hud-clock
(defmethod inspect ((this hud-clock))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this (-> this type))
  (format #t "~1Talpha: ~D~%" (-> this alpha))
  (format #t "~1Treal-alpha: ~D~%" (-> this real-alpha))
  (format #t "~1Tposition-x: ~D~%" (-> this position-x))
  (format #t "~1Tposition-y: ~D~%" (-> this position-y))
  (format #t "~1Treal-position-x: ~D~%" (-> this real-position-x))
  (format #t "~1Treal-position-y: ~D~%" (-> this real-position-y))
  (format #t "~1Twidth: ~D~%" (-> this width))
  (format #t "~1Theight: ~D~%" (-> this height))
  (format #t "~1Treal-width: ~D~%" (-> this real-width))
  (format #t "~1Treal-height: ~D~%" (-> this real-height))
  (format #t "~1Tzval: ~D~%" (-> this zval))
  (format #t "~1Treal-scale: ~D~%" (-> this real-scale))
  (format #t "~1Tscale: ~D~%" (-> this scale))
  (format #t "~1Tflags: ~D~%" (-> this flags))
  (format #t "~1Teffect: ~A~%" (-> this effect))
  (format #t "~1Tparent: ~A~%" (-> this parent))
  (format #t "~1Titems: ~A~%" (-> this items))
  (format #t "~1Tclock-id: ~D~%" (-> this clock-id))
  (format #t "~1Tcount-up: ~A~%" (-> this count-up))
  (format #t "~1Tfixed-time?: ~A~%" (-> this fixed-time?))
  (format #t "~1Tshow-before-red: ~A~%" (-> this show-before-red))
  (format #t "~1Tred-time: ~D~%" (-> this red-time))
  (format #t "~1Ttext-id: ~D~%" (-> this text-id))
  (format #t "~1Tfixed-time-val: ~D~%" (-> this fixed-time-val))
  (label cfg-4)
  this
  )

;; definition for method 9 of type hud-clock
(defmethod init ((this hud-clock))
  (set! (-> (the-as hud-item-string (-> this items 0)) text-id) (-> this text-id))
  (cond
    ((zero? (-> *viewport-array* mode))
     (let ((v1-4 (-> this items 1)))
       (set! (-> (the-as hud-item-group v1-4) items 0 scale) 217)
       (set! (-> (the-as hud-item-group v1-4) items 1 scale) 166)
       (set! (-> (the-as hud-item-group v1-4) items 2 scale) 166)
       (set! (-> (the-as hud-item-group v1-4) items 3 scale) 115)
       (set! (-> (the-as hud-item-group v1-4) items 4 scale) 115)
       )
     )
    (else
      (let ((v1-8 (-> this items 1)))
        (dotimes (a1-7 5)
          (set! (-> (the-as hud-item-group v1-8) items a1-7 scale) 217)
          )
        )
      )
    )
  ((method-of-type hud-item-group init) this)
  )

;; definition for method 19 of type hud-clock
;; WARN: Return type mismatch hud-item-flag vs none.
(defmethod update ((this hud-clock))
  (with-pp
    (if (nonzero? (-> this text-id))
        (show (-> this items 0))
        (hide (-> this items 0))
        )
    (cond
      ((-> this fixed-time?)
       (set-clock-time! this (-> this fixed-time-val) (-> this fixed-time-val))
       )
      ((-> this count-up)
       (let* ((a1-1 (- (- (- (if *net-mgr*
                                 (-> *net-mgr* game-state time)
                                 0
                                 )
                             (if *net-world*
                                 (-> *net-world* net-state game-start-time)
                                 0
                                 )
                             )
                          (if *net-world*
                              (-> *net-world* net-state total-pause-time)
                              0
                              )
                          )
                       (-> *net-game-mgr* intro-end-time)
                       )
                    )
              (a2-1 (- (the-as time-frame a1-1) (- (current-time) (-> pp clock old-frame-counter))))
              )
         (set-clock-time! this a1-1 a2-1)
         )
       )
      (else
        (let* ((a1-10 (- (* #x4650 (the-as int (-> *net-world* net-state options advanced-options param1)))
                         (- (- (- (if *net-mgr*
                                      (-> *net-mgr* game-state time)
                                      0
                                      )
                                  (if *net-world*
                                      (-> *net-world* net-state game-start-time)
                                      0
                                      )
                                  )
                               (if *net-world*
                                   (-> *net-world* net-state total-pause-time)
                                   0
                                   )
                               )
                            (-> *net-game-mgr* intro-end-time)
                            )
                         )
                      )
               (a2-2 (+ a1-10 (- (current-time) (-> pp clock old-frame-counter))))
               )
          (set-clock-time! this a1-10 a2-2)
          )
        )
      )
    (let ((t9-5 (method-of-type hud-item-group update)))
      (t9-5 this)
      )
    (logior! (-> this flags) (hud-item-flag draw-dirty))
    (none)
    )
  )

;; definition for method 23 of type hud-clock
(defmethod hud-item-method-23 ((this hud-clock) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (case arg2
    (('set-clock-time)
     (when (< 1 (-> arg3 num-params))
       (if (= (-> this clock-id) (-> arg3 param 1))
           (set! (-> this fixed-time-val) (the-as int (-> arg3 param 0)))
           )
       )
     )
    (else
      (let ((t9-0 (method-of-type hud-item-group hud-item-method-23)))
        (t9-0 this arg0 arg1 arg2 arg3)
        )
      )
    )
  ((method-of-type hud-item-group hud-item-method-23) this arg0 arg1 arg2 arg3)
  )

;; definition for method 24 of type hud-clock
;; INFO: Used lq/sq
;; WARN: Stack slot offset 16 signed mismatch
;; WARN: Stack slot offset 16 signed mismatch
;; WARN: Stack slot offset 20 signed mismatch
;; WARN: Stack slot offset 20 signed mismatch
;; WARN: Stack slot offset 16 signed mismatch
;; WARN: Stack slot offset 16 signed mismatch
;; WARN: Stack slot offset 20 signed mismatch
;; WARN: Stack slot offset 20 signed mismatch
;; WARN: Stack slot offset 16 signed mismatch
;; WARN: Stack slot offset 20 signed mismatch
;; WARN: Stack slot offset 16 signed mismatch
;; WARN: Stack slot offset 16 signed mismatch
;; WARN: Stack slot offset 20 signed mismatch
;; WARN: Stack slot offset 20 signed mismatch
;; WARN: Stack slot offset 16 signed mismatch
;; WARN: Stack slot offset 16 signed mismatch
;; WARN: Stack slot offset 20 signed mismatch
;; WARN: Stack slot offset 20 signed mismatch
;; WARN: Stack slot offset 16 signed mismatch
;; WARN: Stack slot offset 20 signed mismatch
(defmethod set-clock-time! ((this hud-clock) (arg0 int) (arg1 int))
  (let ((sv-16 arg0)
        (sv-20 0)
        )
    (set! sv-20 (/ sv-16 #x4650))
    (set! sv-16 (- sv-16 (* #x4650 sv-20)))
    (let* ((v1-5 (the-as hud-item-group (-> this items 1)))
           (a0-5 (the-as hud-item-string (-> v1-5 items 0)))
           (s0-0 (the-as hud-item-string (-> v1-5 items 1)))
           (s1-0 (the-as hud-item-string (-> v1-5 items 2)))
           (s2-0 (the-as hud-item-string (-> v1-5 items 3)))
           (s3-0 (the-as hud-item-string (-> v1-5 items 4)))
           )
      (set-int! a0-5 sv-20)
      (set-string! s0-0 ":")
      (set! sv-20 (/ sv-16 300))
      (set! sv-16 (- sv-16 (* 300 sv-20)))
      (let ((s0-1 (method-of-object s1-0 set-string!)))
        (format (clear *temp-string*) "~2,'0,D" sv-20)
        (s0-1 s1-0 *temp-string*)
        )
      (set-string! s2-0 ":")
      (set! sv-20 (/ sv-16 3))
      (let ((s2-1 (method-of-object s3-0 set-string!)))
        (format (clear *temp-string*) "~2,'0,D" sv-20)
        (s2-1 s3-0 *temp-string*)
        )
      )
    )
  (let ((s3-1 (-> *net-world* net-state options)))
    (cond
      ((< arg0 (-> this red-time))
       (dotimes (s2-2 5)
         (set-color!
           (the-as hud-item-string (-> (the-as hud-item-group (-> this items 1)) items s2-2))
           (font-color red)
           )
         )
       (when (and (logtest? (-> s3-1 advanced-options flags) (game-task-advanced-options-flag time-limit))
                  (!= (/ arg1 300) (/ arg0 300))
                  )
         (let ((v0-10 (make-sound-instance snd-timer1 (new 'static 'sound-id) (the-as handle #f))))
           (if v0-10
               (-> v0-10 id)
               0
               )
           )
         )
       (cond
         ((or (-> this fixed-time?)
              (-> this count-up)
              (logtest? (-> s3-1 advanced-options flags) (game-task-advanced-options-flag time-limit))
              )
          (set! (-> this items 0 position-x) 0)
          (set! (-> this items 1 position-x) 0)
          0
          )
         (else
           (set! (-> this items 0 position-x) 512)
           (set! (-> this items 1 position-x) 512)
           )
         )
       )
      (else
        (when (and (-> this show-before-red) (!= (/ arg1 300) (/ arg0 300)))
          )
        (dotimes (s5-1 5)
          (set-color!
            (the-as hud-item-string (-> (the-as hud-item-group (-> this items 1)) items s5-1))
            (font-color white)
            )
          )
        (cond
          ((and (-> this show-before-red)
                (or (-> this fixed-time?)
                    (-> this count-up)
                    (logtest? (-> s3-1 advanced-options flags) (game-task-advanced-options-flag time-limit))
                    )
                )
           (set! (-> this items 0 position-x) 0)
           (set! (-> this items 1 position-x) 0)
           0
           )
          (else
            (set! (-> this items 0 position-x) 512)
            (set! (-> this items 1 position-x) 512)
            )
          )
        )
      )
    )
  (mark-position-dirty this)
  (none)
  )

;; definition of type hud-medal
(deftype hud-medal (hud-item-group)
  ((score-as-time  symbol)
   )
  )

;; definition for method 3 of type hud-medal
(defmethod inspect ((this hud-medal))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this (-> this type))
  (format #t "~1Talpha: ~D~%" (-> this alpha))
  (format #t "~1Treal-alpha: ~D~%" (-> this real-alpha))
  (format #t "~1Tposition-x: ~D~%" (-> this position-x))
  (format #t "~1Tposition-y: ~D~%" (-> this position-y))
  (format #t "~1Treal-position-x: ~D~%" (-> this real-position-x))
  (format #t "~1Treal-position-y: ~D~%" (-> this real-position-y))
  (format #t "~1Twidth: ~D~%" (-> this width))
  (format #t "~1Theight: ~D~%" (-> this height))

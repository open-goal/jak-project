;; definition for method 9 of type hud-lap
(defmethod init ((this hud-lap))
  (let ((v1-0 (new 'stack-no-clear 'array 'int8 1)))
    (if (-> this is-net-player-race)
        (set! (-> v1-0 0) (the-as int (-> *net-world* net-state options advanced-options param1)))
        (set! (-> v1-0 0) (-> this total-laps))
        )
    (if (>= (-> v1-0 0) 10)
        (set! (-> (the-as hud-item-group (-> this items 1)) items 2 width) 38)
        (set! (-> (the-as hud-item-group (-> this items 1)) items 2 width) 22)
        )
    )
  ((method-of-type hud-item-group init) this)
  )

;; definition for method 19 of type hud-lap
(defmethod update ((this hud-lap))
  (let ((s5-0 (new 'stack-no-clear 'array 'int8 2)))
    (cond
      ((-> this is-net-player-race)
       (set! (-> s5-0 0)
             (-> (the-as
                   net-player-race
                   (-> *net-players* (+ (view-get-active-index) (* (if *net-mgr*
                                                                       (-> *net-mgr* game-state local-machine-idx)
                                                                       0
                                                                       )
                                                                   2
                                                                   )
                                        )
                       )
                   )
                 current-lap
                 )
             )
       (set! (-> s5-0 1) (the-as int (-> *net-world* net-state options advanced-options param1)))
       )
      (else
        (set! (-> s5-0 0) (-> this current-laps))
        (set! (-> s5-0 1) (-> this total-laps))
        )
      )
    (let ((s4-0 (the-as hud-item-group (-> this items 1))))
      (set-int! (the-as hud-item-string (-> s4-0 items 0)) (max 1 (+ (-> s5-0 0) 1)))
      (cond
        ((-> this show-total-laps)
         (set-string! (the-as hud-item-string (-> s4-0 items 1)) "/")
         (set-int! (the-as hud-item-string (-> s4-0 items 2)) (-> s5-0 1))
         )
        (else
          (hide (-> s4-0 items 1))
          (hide (-> s4-0 items 2))
          )
        )
      )
    )
  ((method-of-type hud-item-group update) this)
  (none)
  )


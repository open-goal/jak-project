(in-package goal)

;; definition of type hud-player-icon
(deftype hud-player-icon (hud-item-group)
  ((player-id  int32)
   )
  (:methods
    (set-player-id! (_type_ int) none)
    )
  )

;; definition for method 3 of type hud-player-icon
(defmethod inspect ((this hud-player-icon))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this (-> this type))
  (format #t "~1Talpha: ~D~%" (-> this alpha))
  (format #t "~1Treal-alpha: ~D~%" (-> this real-alpha))
  (format #t "~1Tposition-x: ~D~%" (-> this position-x))
  (format #t "~1Tposition-y: ~D~%" (-> this position-y))
  (format #t "~1Treal-position-x: ~D~%" (-> this real-position-x))
  (format #t "~1Treal-position-y: ~D~%" (-> this real-position-y))
  (format #t "~1Twidth: ~D~%" (-> this width))
  (format #t "~1Theight: ~D~%" (-> this height))
  (format #t "~1Treal-width: ~D~%" (-> this real-width))
  (format #t "~1Treal-height: ~D~%" (-> this real-height))
  (format #t "~1Tzval: ~D~%" (-> this zval))
  (format #t "~1Treal-scale: ~D~%" (-> this real-scale))
  (format #t "~1Tscale: ~D~%" (-> this scale))
  (format #t "~1Tflags: ~D~%" (-> this flags))
  (format #t "~1Teffect: ~A~%" (-> this effect))
  (format #t "~1Tparent: ~A~%" (-> this parent))
  (format #t "~1Titems: ~A~%" (-> this items))
  (format #t "~1Tplayer-id: ~D~%" (-> this player-id))
  (label cfg-4)
  this
  )

;; definition for method 9 of type hud-player-icon
(defmethod init ((this hud-player-icon))
  (let ((a1-0 (-> this items 0))
        (v1-2 (-> this items 1))
        )
    (set! (-> (the-as hud-item-sprite a1-0) tex-id) (new 'static 'texture-id :index #x3 :page #x1))
    (set! (-> (the-as hud-item-sprite v1-2) tex-id) (new 'static 'texture-id :index #x3 :page #x1))
    )
  ((method-of-type hud-item-group init) this)
  )

;; definition for method 24 of type hud-player-icon
(defmethod set-player-id! ((this hud-player-icon) (arg0 int))
  (set! (-> this player-id) arg0)
  (let ((s5-0 (the-as hud-item-sprite (-> this items 0)))
        (gp-0 (the-as hud-item-sprite (-> this items 1)))
        (v1-5 (if *net-world*
                  (-> *net-world* net-state assigned-drivers-s8 (-> this player-id))
                  -1
                  )
              )
        )
    (when (!= v1-5 -1)
      (let* ((v1-8 (-> *net-drivers* v1-5))
             (a0-4 (-> v1-8 picture-part1))
             (s4-0 (-> v1-8 picture-part2))
             )
        (set! (-> s5-0 tex-id) (the-as texture-id a0-4))
        (set! (-> gp-0 tex-id) (the-as texture-id s4-0))
        (set-texture! s5-0 (lookup-texture-by-id (the-as texture-id a0-4)))
        (set-texture! gp-0 (lookup-texture-by-id (the-as texture-id s4-0)))
        )
      )
    )
  (none)
  )


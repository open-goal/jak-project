        (a2-0 (-> this items 3))
        (a1-0 (-> this items 2))
        (v1-4 (-> this items 4))
        )
    (set! (-> (the-as hud-item-sprite a3-0) tex-id) (new 'static 'texture-id :index #x3 :page #x1))
    (set! (-> (the-as hud-item-sprite a2-0) tex-id) (new 'static 'texture-id :index #x3 :page #x1))

      (set-real-alpha! this (fmin 1.0 (the float (+ (-> this real-alpha) (the int (* 0.5 (seconds-per-frame)))))))
      (set-real-alpha!
        this
        (fmax 0.0 (the float (- (-> this real-alpha) (the-as uint (the int (* 0.5 (seconds-per-frame)))))))
        )
      )

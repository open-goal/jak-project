;; definition for method 20 of type hud-player-icon-name
(defmethod set-real-alpha! ((this hud-player-icon-name) (arg0 float))
  (let ((v1-1 (-> this items 0))
        (s4-0 (-> this items 1))
        (s5-0 (-> this items 3))
        )
    (let ((s2-0 (-> this items 2))
          (s3-0 (-> this items 4))
          )
      (set-real-alpha! v1-1 arg0)
      (set-real-alpha! s2-0 arg0)
      (set-real-alpha! s3-0 arg0)
      )
    (set-real-alpha! s4-0 (* 0.6 arg0))
    (set-real-alpha! s5-0 (* 0.6 arg0))
    )
  (none)
  )

;; definition for method 9 of type hud-player-icon-name
(defmethod init ((this hud-player-icon-name))

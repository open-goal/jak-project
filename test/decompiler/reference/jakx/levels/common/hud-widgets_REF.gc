;; definition for method 9 of type hud-position
(defmethod init ((this hud-position))
  (let ((s5-0 (the-as hud-item-group (-> this items 0))))
    (case (get-current-language)
      (((language-enum russian))
       (set! (-> s5-0 items 1 scale) 512)
       (set! (-> s5-0 items 1 width) 25)
       )
      (((language-enum german))
       (set! (-> s5-0 items 1 scale) 256)
       (set! (-> s5-0 items 1 width) 5)
       )
      (((language-enum spanish) (language-enum italian) (language-enum portuguese))
       (set! (-> s5-0 items 1 scale) 512)
       (set! (-> s5-0 items 1 width) 10)
       )
      (((language-enum french))
       (set! (-> s5-0 items 1 scale) 256)
       (set! (-> s5-0 items 1 width) 25)
       )
      (else
        (set! (-> s5-0 items 1 scale) 256)
        (set! (-> s5-0 items 1 width) 40)
        )
      )
    )
  ((method-of-type hud-item-group init) this)
  )

;; definition for method 19 of type hud-position
(defmethod update ((this hud-position))
  (local-vars (a1-1 int))
  (let ((s5-0 (-> this race-position)))
    (if (= s5-0 -1)
        (set! s5-0 (-> *net-players*
                       (+ (view-get-active-index) (* (if *net-mgr*
                                                         (-> *net-mgr* game-state local-machine-idx)
                                                         0
                                                         )
                                                     2
                                                     )
                          )
                       rank
                       )
              )
        )
    (let* ((v1-12 (the-as hud-item-group (-> this items 0)))
           (a0-3 (the-as hud-item-string (-> v1-12 items 0)))
           (s4-0 (the-as hud-item-string (-> v1-12 items 1)))
           )
      (set-int! a0-3 (+ s5-0 1))
      0
      (cond
        ((zero? s5-0)
         (set! a1-1 2017)
         )
        ((= s5-0 1)
         (set! a1-1 2016)
         )
        ((= s5-0 2)
         (set! a1-1 2014)
         )
        (else
          (set! a1-1 2015)
          )
        )
      (set-string! s4-0 (lookup-text! *common-text* (the-as text-id a1-1) #f))
      )
    )
  ((method-of-type hud-item-group update) this)
  (none)
  )


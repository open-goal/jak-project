  (the-as
    hud-hunt-indicators-view1
    (cond
      (*hud-hunt-indicators-view1-proc*
        *hud-hunt-indicators-view1-proc*
        )
      (*net-game-mgr*
        (let ((v0-0 (ppointer->process (process-spawn
                                         hud-hunt-indicators-view1
                                         :init hud-init-by-other
                                         :name "hud-hunt-indicators-view1"
                                         :to *net-game-mgr*
                                         )
                                       )
                    )
              )
          (when v0-0
            (set! (-> (the-as hud-hunt-indicators-view1 v0-0) inited-strings-count) 0)
            0
            )

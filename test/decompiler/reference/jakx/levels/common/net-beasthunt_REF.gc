;; definition for symbol *hud-hunt-indicators-view1-proc*, type hud-hunt-indicators-view1
(define *hud-hunt-indicators-view1-proc* (the-as hud-hunt-indicators-view1 #f))

;; definition of type hud-hunt-indicators-view1
(deftype hud-hunt-indicators-view1 (in-game-hud)
  ()
  )

;; definition for method 3 of type hud-hunt-indicators-view1
(defmethod inspect ((this hud-hunt-indicators-view1))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type in-game-hud inspect)))
    (t9-0 this)
    )
  (label cfg-4)
  this
  )

;; definition for method 7 of type hud-hunt-indicators-view1
;; WARN: Return type mismatch in-game-hud vs hud-hunt-indicators-view1.
(defmethod relocate ((this hud-hunt-indicators-view1) (offset int))
  (set! *hud-hunt-indicators-view1-proc* this)
  (if (nonzero? *hud-hunt-indicators-view1-proc*)
      (set! *hud-hunt-indicators-view1-proc* (&+ *hud-hunt-indicators-view1-proc* offset))
      )
  (the-as hud-hunt-indicators-view1 ((method-of-type in-game-hud relocate) this offset))
  )

;; definition for method 26 of type hud-hunt-indicators-view1
(defmethod init-callback ((this hud-hunt-indicators-view1))
  (set! (-> this items) *hud-hunt-indicators-view1*)
  (set! (-> this manager) (new 'static 'basic-manager))
  (set! *hud-hunt-indicators-view1-proc* this)
  ((method-of-type in-game-hud init-callback) this)
  (none)
  )

;; definition for method 10 of type hud-hunt-indicators-view1

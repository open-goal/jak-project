;; definition for symbol *hud-hunt-indicators-view0-proc*, type hud-hunt-indicators-view0
(define *hud-hunt-indicators-view0-proc* (the-as hud-hunt-indicators-view0 #f))

;; definition of type hud-hunt-indicators-view0
(deftype hud-hunt-indicators-view0 (in-game-hud)
  ()
  )

;; definition for method 3 of type hud-hunt-indicators-view0
(defmethod inspect ((this hud-hunt-indicators-view0))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type in-game-hud inspect)))
    (t9-0 this)
    )
  (label cfg-4)
  this
  )

;; definition for method 7 of type hud-hunt-indicators-view0
;; WARN: Return type mismatch in-game-hud vs hud-hunt-indicators-view0.
(defmethod relocate ((this hud-hunt-indicators-view0) (offset int))
  (set! *hud-hunt-indicators-view0-proc* this)
  (if (nonzero? *hud-hunt-indicators-view0-proc*)
      (set! *hud-hunt-indicators-view0-proc* (&+ *hud-hunt-indicators-view0-proc* offset))
      )
  (the-as hud-hunt-indicators-view0 ((method-of-type in-game-hud relocate) this offset))
  )

;; definition for method 26 of type hud-hunt-indicators-view0
(defmethod init-callback ((this hud-hunt-indicators-view0))
  (set! (-> this items) *hud-hunt-indicators-view0*)
  (set! (-> this manager) (new 'static 'basic-manager))
  (set! *hud-hunt-indicators-view0-proc* this)
  ((method-of-type in-game-hud init-callback) this)
  (none)
  )

;; definition for method 10 of type hud-hunt-indicators-view0
(defmethod deactivate ((this hud-hunt-indicators-view0))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."

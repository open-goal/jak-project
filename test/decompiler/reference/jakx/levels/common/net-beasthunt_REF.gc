        )
      )
    )
  )

;; definition for function spawn-unused-hud-hunt-indicators-view
(defun spawn-unused-hud-hunt-indicators-view ()
  (cond
    ((not *hud-hunt-indicators-view0-proc*)
     (spawn-hud-hunt-indicators-view0)
     )
    ((not *hud-hunt-indicators-view1-proc*)
     (spawn-hud-hunt-indicators-view1)
     )
    (else
      (the-as in-game-hud #f)
      )
    )
  )

;; definition for method 52 of type net-game-mgr-beasthunt
;; WARN: Return type mismatch process vs net-player.
(defmethod spawn-net-player ((this net-game-mgr-beasthunt) (arg0 int))
  (the-as
    net-player
    (ppointer->process
      (process-spawn net-player-beasthunt :init net-player-init-local arg0 :name "net-player-beasthunt")
      )
    )
  )

;; definition for method 51 of type net-player-beasthunt
(defmethod init! ((this net-player-beasthunt) (arg0 int))
  (set! (-> this prev-send-score) 0)
  (set! (-> this last-score-send-time) (the-as int (+ (-> *display* real-clock frame-counter) (seconds -30))))
  (set! (-> this big-air-launch-time) -1)
  (set! (-> this in-big-air) #f)
  (call-parent-method this arg0)
  (none)
  )

;; definition for method 63 of type net-player-beasthunt
(defmethod write-score-change ((this net-player-beasthunt))
  (set! (-> this last-score-send-time) (the-as int (-> *display* real-clock frame-counter)))
  (set! (-> this prev-send-score) (-> this score))
  (call-parent-method this)
  (none)
  )

;; failed to figure out what this is:
(defstate running (net-player-beasthunt)
  :virtual #t
  :trans (behavior ()
    (call-parent-state-handler trans)
    (if (and (!= (-> self prev-send-score) (-> self score))
             (< (seconds 1) (- (-> *display* real-clock frame-counter) (the-as time-frame (-> self last-score-send-time))))
             )
        (write-score-change self)
        )
    (when (-> self in-big-air)
      (let ((v1-10 (get-vehicle self))
            (a0-14 (- (- (- (if *net-mgr*
                                (-> *net-mgr* game-state time)
                                0
                                )
                            (if *net-world*
                                (-> *net-world* net-state game-start-time)
                                0
                                )
                            )
                         (if *net-world*
                             (-> *net-world* net-state total-pause-time)
                             0
                             )
                         )
                      (-> self big-air-launch-time)
                      )
                   )
            )
        (if (< a0-14 600)
            (set! (-> self last-fly-time) (- (- (if *net-mgr*
                                                    (-> *net-mgr* game-state time)
                                                    0
                                                    )
                                                (if *net-world*
                                                    (-> *net-world* net-state game-start-time)
                                                    0
                                                    )
                                                )
                                             (if *net-world*
                                                 (-> *net-world* net-state total-pause-time)
                                                 0
                                                 )
                                             )
                  )
            )
        (if (and v1-10 (logtest? (-> v1-10 v-flags) (vehicle-flag in-air)))
            (set! (-> self last-fly-time) (- (- (if *net-mgr*
                                                    (-> *net-mgr* game-state time)
                                                    0
                                                    )
                                                (if *net-world*
                                                    (-> *net-world* net-state game-start-time)
                                                    0
                                                    )
                                                )
                                             (if *net-world*
                                                 (-> *net-world* net-state total-pause-time)
                                                 0
                                                 )
                                             )
                  )
            )
        (cond
          ((and v1-10 (logtest? (-> v1-10 v-flags) (vehicle-flag dead)))
           (set! (-> self in-big-air) #f)
           )
          ((not v1-10)
           (set! (-> self in-big-air) #f)
           )
          ((or (< 1500 a0-14) (< 150 (- (- (- (if *net-mgr*
                                                  (-> *net-mgr* game-state time)
                                                  0
                                                  )

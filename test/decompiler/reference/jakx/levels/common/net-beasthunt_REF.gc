;;-*-Lisp-*-
(in-package goal)

;; definition of type hud-hunt-indicators
(deftype hud-hunt-indicators (hud-item-group)
  ((last-position  vector  :inline)
   )
  )

;; definition for method 3 of type hud-hunt-indicators
(defmethod inspect ((this hud-hunt-indicators))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this (-> this type))
  (format #t "~1Talpha: ~D~%" (-> this alpha))
  (format #t "~1Treal-alpha: ~D~%" (-> this real-alpha))
  (format #t "~1Tposition-x: ~D~%" (-> this position-x))
  (format #t "~1Tposition-y: ~D~%" (-> this position-y))
  (format #t "~1Treal-position-x: ~D~%" (-> this real-position-x))
  (format #t "~1Treal-position-y: ~D~%" (-> this real-position-y))
  (format #t "~1Twidth: ~D~%" (-> this width))
  (format #t "~1Theight: ~D~%" (-> this height))
  (format #t "~1Treal-width: ~D~%" (-> this real-width))
  (format #t "~1Treal-height: ~D~%" (-> this real-height))
  (format #t "~1Tzval: ~D~%" (-> this zval))
  (format #t "~1Treal-scale: ~D~%" (-> this real-scale))
  (format #t "~1Tscale: ~D~%" (-> this scale))
  (format #t "~1Tflags: ~D~%" (-> this flags))
  (format #t "~1Teffect: ~A~%" (-> this effect))
  (format #t "~1Tparent: ~A~%" (-> this parent))
  (format #t "~1Titems: ~A~%" (-> this items))
  (format #t "~1Tlast-position: #<vector @ #x~X>~%" (-> this last-position))
  (label cfg-4)
  this
  )

;; definition for method 19 of type hud-hunt-indicators
;; INFO: Used lq/sq
(defmethod update ((this hud-hunt-indicators))
  (local-vars (v1-49 symbol))
  (let ((a0-2 (-> *net-players* (+ (view-get-active-index) (* (if *net-mgr*
                                                                  (-> *net-mgr* game-state local-machine-idx)
                                                                  0
                                                                  )
                                                              2
                                                              )
                                   )
                  )
              )
        )
    (when a0-2
      (let ((a0-3 (get-vehicle a0-2)))
        (if a0-3
            (set! (-> this last-position quad) (-> a0-3 root trans quad))
            )
        )
      )
    )
  (let ((s5-0 (-> this last-position)))
    (dotimes (s4-0 5)
      (let* ((s3-0 (the-as hud-indicator (-> this items s4-0)))
             (s2-0 (the-as net-enemy (handle->process (-> s3-0 target))))
             )
        (when s2-0
          (let ((s1-1 (vector-! (new 'stack-no-clear 'vector) (-> s2-0 root trans) s5-0)))
            (vector-normalize! s1-1 1.0)
            (if (< (vector-dot s1-1 (-> (camera-matrix) fvec)) 0.0)
                (set! s2-0 (the-as net-enemy #f))
                )
            )
          (if (!= (-> s2-0 killed-by) -1)
              (set! s2-0 (the-as net-enemy #f))
              )
          )
        (cond
          (s2-0
            (set! (-> s3-0 enemy-distance) (vector-vector-distance-squared (-> s2-0 root trans) s5-0))
            (if (!= (-> s3-0 id) -1)
                (+! (-> s3-0 indicator-alpha) (* 0.05 (- 1.0 (-> s3-0 indicator-alpha))))
                )
            (set! (-> s3-0 id) 0)
            0
            )
          (else
            (hud-indicator-method-24 s3-0)
            (set! (-> s3-0 enemy-distance) (square 40960000.0))
            (set! (-> s3-0 target) (the-as handle #f))
            )
          )
        )
      )
    (let ((v1-41 (the-as object (-> *net-enemy-list* head))))
      (while (the-as list-link v1-41)
        (let ((s4-1 (-> (the-as list-link v1-41) next)))
          (let* ((s3-1 (if (the-as list-link v1-41)
                           (&+ (the-as pointer v1-41) -860)
                           #f
                           )
                       )
                 (s2-2 (vector-! (new 'stack-no-clear 'vector) (-> (the-as net-enemy s3-1) root trans) s5-0))
                 )
            (vector-normalize! s2-2 1.0)
            (when (< 0.0 (vector-dot s2-2 (-> (camera-matrix) fvec)))
              (let ((f0-10 (vector-vector-distance-squared (-> (the-as net-enemy s3-1) root trans) s5-0))
                    (a0-21 -1)
                    )
                (let ((f1-3 0.0))
                  (dotimes (v1-47 5)
                    (let* ((a1-7 (the-as hud-indicator (-> this items v1-47)))
                           (f2-2 (-> a1-7 enemy-distance))
                           )
                      (let ((a1-9 (the-as net-enemy (handle->process (-> a1-7 target)))))
                        (when (and a1-9 (= a1-9 (the-as net-enemy s3-1)))
                          (set! v1-49 #t)
                          (goto cfg-52)
                          )
                        )
                      (when (and (< f0-10 f2-2) (>= f2-2 f1-3))
                        (set! a0-21 v1-47)
                        (set! f1-3 f2-2)
                        )
                      )
                    )
                  )
                (set! v1-49 #f)
                (label cfg-52)
                (if v1-49
                    (set! a0-21 -1)
                    )
                (let ((v1-56 (the-as hud-indicator (-> this items a0-21))))
                  (when (!= a0-21 -1)
                    (set! (-> v1-56 id) -1)
                    (+! (-> v1-56 indicator-alpha) (* 0.1 (- (-> v1-56 indicator-alpha))))
                    (when (or (< (-> v1-56 indicator-alpha) 0.05) (not (the-as net-enemy (handle->process (-> v1-56 target)))))
                      (set! (-> v1-56 indicator-alpha) 0.0)
                      (set! (-> v1-56 enemy-distance) f0-10)
                      (set! (-> (the-as hud-health (-> v1-56 items 1)) health) -1.0)
                      (set! (-> v1-56 target) (process->handle (the-as net-enemy s3-1)))
                      (set! (-> v1-56 id) 0)
                      0
                      )
                    )
                  )
                )
              )
            )
          (set! v1-41 s4-1)
          )
        )
      )
    )
  (dotimes (s5-1 5)
    (let* ((s4-2 (the-as hud-indicator (-> this items s5-1)))
           (s3-2 (the-as net-enemy (handle->process (-> s4-2 target))))
           )
      (when s3-2
        (hud-health-method-24 (the-as hud-health (-> s4-2 items 1)) (/ (-> s3-2 health) (-> s3-2 info max-health)) #f)
        (set! (-> s4-2 target-position quad) (-> (get-trans s3-2 0) quad))
        (set-string! (the-as hud-item-string (-> s4-2 items 0)) "")
        (hud-indicator-method-25 s4-2 (new 'static 'rgba :r #x40 :g #x40 :b #x40 :a #x80) 4)
        )
      )
    )
  ((method-of-type hud-item-group update) this)
  (none)
  )


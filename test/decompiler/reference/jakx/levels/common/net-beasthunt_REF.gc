;; definition for method 48 of type net-player-beasthunt
;; WARN: disable def twice: 155. This may happen when a cond (no else) is nested inside of another conditional, but it should be rare.
(defmethod handle-events ((this net-player-beasthunt) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (with-pp
    (case arg2
      (('you-killed-beast)
       (let ((a0-3 (get-vehicle this)))
         (if (and a0-3 (owner-is-local? a0-3))
             (add-kill this)
             )
         )
       (when (and (or (owner-is-local? this) (and (not (and (>= (-> this player-id) 0) (< (-> this player-id) 16)))
                                                  (= (if *net-mgr*
                                                         (-> *net-mgr* game-state local-machine-idx)
                                                         0
                                                         )
                                                     (-> *net-mgr* game-state session-master-idx)
                                                     )
                                                  )
                      )
                  (< (-> *net-game-mgr* scheduled-finish-time) 0)
                  )
         (cond
           ((and (> (the-as int (-> arg3 param 1)) 0)
                 (and (>= (-> this player-id) 0) (< (-> this player-id) 16))
                 (= (/ (-> this player-id) 2) (if *net-mgr*
                                                  (-> *net-mgr* game-state local-machine-idx)
                                                  0
                                                  )
                    )
                 )
            (let ((s3-0 (as-type arg0 process-drawable)))
              (when s3-0
                (let ((t9-5 view-push-context)
                      (v1-27 (-> this view))
                      )
                  (t9-5 (if v1-27
                            (-> v1-27 index)
                            -1
                            )
                        )
                  )
                (create-points-icon (the-as process-drawable s3-0) (-> arg3 param 1) #f)
                (view-pop-context)
                (format 0 "show score ~D~%" (-> arg3 param 1))
                )
              )
            )
           (else
             (+! (-> this score) (-> arg3 param 0))
             (let ((v1-32 (make-sound-instance snd-kill-counter (new 'static 'sound-id) (the-as handle #f))))
               (if v1-32
                   (-> v1-32 id)
                   0
                   )
               )
             )
           )
         (write-score-change this)
         )
       )
      (('you-hurt-beast)
       (when (and (or (owner-is-local? this) (and (not (and (>= (-> this player-id) 0) (< (-> this player-id) 16)))
                                                  (= (if *net-mgr*
                                                         (-> *net-mgr* game-state local-machine-idx)
                                                         0
                                                         )
                                                     (-> *net-mgr* game-state session-master-idx)
                                                     )
                                                  )
                      )
                  (< (-> *net-game-mgr* scheduled-finish-time) 0)
                  )
         (let ((v0-4 (the-as object (+ (-> this score) (-> arg3 param 0)))))
           (set! (-> this score) (the-as int v0-4))
           v0-4
           )
         )
       )
      (('waiting-game-start)
       (go (method-of-object this waiting))
       )
      (('begin-game)
       (let ((v1-51 (-> this vehicle)))
         (send-event (the-as wvehicle (handle->process v1-51)) 'begin-race)
         )
       (go (method-of-object this running))
       )
      (('big-air-exit)
       (send-event (get-vehicle this) 'set 'force-lod -1)
       (send-event
         (get-vehicle this)
         'set
         'camera-inside-view
         (-> *game-info* player-info (view-get-active-index) camera-inside-view)
         )
       (cam-disconnect *setting-control* (view-get-active-index) pp 'interp-time)
       (cam-disconnect *setting-control* (view-get-active-index) pp 'mode-name)
       (set! (-> this in-big-air) #f)
       #f
       )
      (('big-air-launch)
       (when (and (and (>= (-> this player-id) 0) (< (-> this player-id) 16))
                  (= (/ (-> this player-id) 2) (if *net-mgr*
                                                   (-> *net-mgr* game-state local-machine-idx)
                                                   0
                                                   )
                     )
                  )
         (send-event (get-vehicle this) 'set 'force-lod 0)
         (set! (-> this big-air-launch-time) (- (- (if *net-mgr*
                                                       (-> *net-mgr* game-state time)
                                                       0
                                                       )
                                                   (if *net-world*
                                                       (-> *net-world* net-state game-start-time)
                                                       0
                                                       )
                                                   )
                                                (if *net-world*
                                                    (-> *net-world* net-state total-pause-time)
                                                    0
                                                    )
                                                )
               )
         (set! (-> *game-info* player-info (view-get-active-index) camera-inside-view)
               (the-as symbol (send-event (get-vehicle this) 'query 'camera-inside-view))
               )
         (send-event (get-vehicle this) 'set 'camera-inside-view #f)
         (set! (-> this in-big-air) #t)
         (when (not (finish-scheduled? this))
           (cam-reconnect *setting-control* (view-get-active-index) pp 'interp-time 'abs 0 0.0)
           (cam-reconnect *setting-control* (view-get-active-index) pp 'mode-name 'cam-vehicle-crash 0 0.0)
           )
         )
       )
      (else
        ((method-of-type net-player-deathmatch handle-events) this arg0 arg1 arg2 arg3)
        )
      )
    )
  )


;;-*-Lisp-*-
(in-package goal)

;; definition of type hud-ctf-indicators
(deftype hud-ctf-indicators (hud-player-indicators)
  ()
  )

;; definition for method 3 of type hud-ctf-indicators
(defmethod inspect ((this hud-ctf-indicators))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this (-> this type))
  (format #t "~1Talpha: ~D~%" (-> this alpha))
  (format #t "~1Treal-alpha: ~D~%" (-> this real-alpha))
  (format #t "~1Tposition-x: ~D~%" (-> this position-x))
  (format #t "~1Tposition-y: ~D~%" (-> this position-y))
  (format #t "~1Treal-position-x: ~D~%" (-> this real-position-x))
  (format #t "~1Treal-position-y: ~D~%" (-> this real-position-y))
  (format #t "~1Twidth: ~D~%" (-> this width))
  (format #t "~1Theight: ~D~%" (-> this height))
  (format #t "~1Treal-width: ~D~%" (-> this real-width))
  (format #t "~1Treal-height: ~D~%" (-> this real-height))
  (format #t "~1Tzval: ~D~%" (-> this zval))
  (format #t "~1Treal-scale: ~D~%" (-> this real-scale))
  (format #t "~1Tscale: ~D~%" (-> this scale))
  (format #t "~1Tflags: ~D~%" (-> this flags))
  (format #t "~1Teffect: ~A~%" (-> this effect))
  (format #t "~1Tparent: ~A~%" (-> this parent))
  (format #t "~1Titems: ~A~%" (-> this items))
  (label cfg-4)
  this
  )

;; definition for method 24 of type hud-ctf-indicators
(defmethod show-indicator-for? ((this hud-ctf-indicators) (arg0 net-player))
  (let ((v1-1 (get-vehicle arg0)))
    (when v1-1
      (if (!= (the-as wvehicle (handle->process (-> *ctf-flag* carrier))) v1-1)
          (return (not (logtest? (-> v1-1 v-flags) (vehicle-flag dead))))
          )
      )
    )
  #f
  )

;; definition for method 19 of type hud-ctf-indicators
;; INFO: Used lq/sq
(defmethod update ((this hud-ctf-indicators))
  (let ((s2-0 (+ (view-get-active-index) (* (if *net-mgr*
                                                (-> *net-mgr* game-state local-machine-idx)
                                                0
                                                )
                                            2
                                            )
                 )
              )
        (s5-0 -1)
        )
    (let ((s4-0 *ctf-flag*))
      (when s4-0
        (let ((v1-7 (the-as wvehicle (handle->process (-> *ctf-flag* carrier)))))
          (if v1-7
              (set! s5-0 (-> v1-7 player-id))
              )
          )
        (let ((s3-0 (-> this items 5)))
          (cond
            ((!= s5-0 -1)
             (let ((a0-8 (-> *net-players* s5-0)))
               (when a0-8
                 (let ((s1-0 (get-vehicle a0-8)))
                   (when s1-0
                     (show (-> (the-as hud-indicator s3-0) items 1))
                     (hud-health-method-24 (the-as hud-health (-> (the-as hud-indicator s3-0) items 1)) (-> s1-0 health) #f)
                     )
                   )
                 )
               )
             )
            (else
              (hide (-> (the-as hud-indicator s3-0) items 1))
              (hud-health-method-24 (the-as hud-health (-> (the-as hud-indicator s3-0) items 1)) 0.0 #f)
              )
            )
          (cond
            ((!= s2-0 s5-0)
             (set! (-> (the-as hud-indicator s3-0) target) (process->handle s4-0))
             (set! (-> (the-as hud-indicator s3-0) target-position quad) (-> s4-0 root trans quad))
             (set-text-id! (the-as hud-item-string (-> (the-as hud-indicator s3-0) items 0)) (text-id text-id-3819))
             (let ((v1-36 (-> *ctf-flag* team)))
               (cond
                 ((zero? v1-36)
                  (hud-indicator-method-25 (the-as hud-indicator s3-0) (new 'static 'rgba :r #xff :a #x80) 3)
                  )
                 ((= v1-36 1)
                  (hud-indicator-method-25 (the-as hud-indicator s3-0) (new 'static 'rgba :b #xff :a #x80) 7)
                  )
                 (else
                   (hud-indicator-method-25 (the-as hud-indicator s3-0) (new 'static 'rgba :r #xff :g #xff :b #xff :a #x80) 1)
                   )
                 )
               )
             )
            (else
              (hud-indicator-method-24 (the-as hud-indicator s3-0))
              )
            )
          )
        )
      )
    (let ((s3-1 (the-as ctf-base #f))
          (s4-1 (-> this items 6))
          )
      (when (!= s5-0 -1)
        (let ((s5-1 (-> *net-players* s5-0)))
          (hide (-> (the-as hud-indicator s4-1) items 1))
          (when s5-1
            (let ((v1-55 (-> s5-1 team)))
              (cond
                ((zero? v1-55)
                 (set! s3-1 *ctf-red-base*)
                 (hud-indicator-method-25 (the-as hud-indicator s4-1) (new 'static 'rgba :r #xff :a #x80) 3)
                 )
                ((= v1-55 1)
                 (set! s3-1 *ctf-blue-base*)
                 (hud-indicator-method-25 (the-as hud-indicator s4-1) (new 'static 'rgba :b #xff :a #x80) 7)
                 )
                )
              )
            )
          )
        )
      (cond
        (s3-1
          (hud-health-method-24 (the-as hud-health (-> (the-as hud-indicator s4-1) items 1)) 0.0 #f)
          (set! (-> (the-as hud-indicator s4-1) target) (process->handle s3-1))
          (set! (-> (the-as hud-indicator s4-1) target-position quad) (-> s3-1 root trans quad))
          (set-text-id! (the-as hud-item-string (-> (the-as hud-indicator s4-1) items 0)) (text-id text-id-3820))
          )
        (else
          (hud-indicator-method-24 (the-as hud-indicator s4-1))
          )
        )
      )
    )
  ((method-of-type hud-player-indicators update) this)
  (none)
  )


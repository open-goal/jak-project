;; definition for symbol *hud-ctf-indicators-view0-proc*, type hud-ctf-indicators-view0
(define *hud-ctf-indicators-view0-proc* (the-as hud-ctf-indicators-view0 #f))

;; definition of type hud-ctf-indicators-view0
(deftype hud-ctf-indicators-view0 (in-game-hud)
  ()
  )

;; definition for method 3 of type hud-ctf-indicators-view0
(defmethod inspect ((this hud-ctf-indicators-view0))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type in-game-hud inspect)))
    (t9-0 this)
    )
  (label cfg-4)
  this
  )

;; definition for method 7 of type hud-ctf-indicators-view0
;; WARN: Return type mismatch in-game-hud vs hud-ctf-indicators-view0.
(defmethod relocate ((this hud-ctf-indicators-view0) (offset int))
  (set! *hud-ctf-indicators-view0-proc* this)
  (if (nonzero? *hud-ctf-indicators-view0-proc*)
      (set! *hud-ctf-indicators-view0-proc* (&+ *hud-ctf-indicators-view0-proc* offset))
      )
  (the-as hud-ctf-indicators-view0 ((method-of-type in-game-hud relocate) this offset))
  )

;; definition for method 26 of type hud-ctf-indicators-view0
(defmethod init-callback ((this hud-ctf-indicators-view0))
  (set! (-> this items) *hud-ctf-indicators-view0*)
  (set! (-> this manager) (new 'static 'basic-manager))
  (set! *hud-ctf-indicators-view0-proc* this)
  ((method-of-type in-game-hud init-callback) this)
  (none)
  )

;; definition for method 10 of type hud-ctf-indicators-view0
(defmethod deactivate ((this hud-ctf-indicators-view0))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (set! *hud-ctf-indicators-view0-proc* #f)
  ((method-of-type in-game-hud deactivate) this)
  (none)
  )

;; definition for method 24 of type hud-ctf-indicators-view0
(defmethod draw ((this hud-ctf-indicators-view0))
  (when *debug-hud*
    (set! (-> this real-items) *hud-ctf-indicators-view0*)
    (init-callback this)
    )
  ((method-of-type in-game-hud draw) this)
  (none)
  )

;; definition for function spawn-hud-ctf-indicators-view0
;; WARN: Return type mismatch process vs hud-ctf-indicators-view0.
(defun spawn-hud-ctf-indicators-view0 ()
  (the-as
    hud-ctf-indicators-view0
    (cond
      (*hud-ctf-indicators-view0-proc*
        *hud-ctf-indicators-view0-proc*
        )
      (*net-game-mgr*
        (let ((v0-0 (ppointer->process (process-spawn
                                         hud-ctf-indicators-view0
                                         :init hud-init-by-other
                                         :name "hud-ctf-indicators-view0"
                                         :to *net-game-mgr*
                                         )
                                       )
                    )
              )
          (when v0-0
            (set! (-> (the-as hud-ctf-indicators-view0 v0-0) inited-strings-count) 0)
            0
            )
          v0-0
          )
        )
      (else
        (the-as process #f)
        )
      )
    )
  )


;; failed to figure out what this is:
(defstate startup (net-game-mgr-ctf)
  :virtual #t
  :code (behavior ()
    (when (= (if *net-mgr*
                 (-> *net-mgr* game-state local-machine-idx)
                 0
                 )
             (-> *net-mgr* game-state session-master-idx)
             )
      (wait-for-all-net-players)
      (let ((gp-0 (alloc-msg self 'set-intro-end-time)))
        (write-int32 gp-0 (+ (- (- (if *net-mgr*
                                       (-> *net-mgr* game-state time)
                                       0
                                       )
                                   (if *net-world*
                                       (-> *net-world* net-state game-start-time)
                                       0
                                       )
                                   )
                                (if *net-world*
                                    (-> *net-world* net-state total-pause-time)
                                    0
                                    )
                                )
                             (the int (get-intro-duration self))
                             )
                     )
        (send-msg self gp-0 -1 80)
        (free-msg self gp-0)
        )
      )
    (while (or (not *ctf-flag*) (not (and (-> *ctf-flag* next-state) (= (-> *ctf-flag* next-state name) 'idle))))
      (suspend)
      )
    (until (!= (-> self intro-end-time) -1)
      (suspend)
      )
    (finish-startup self)
    (until #f
      (let ((a0-18 (-> *net-players* (* (if *net-mgr*
                                            (-> *net-mgr* game-state local-machine-idx)
                                            0
                                            )
                                        2
                                        )
                       )
                   )
            )
        (when a0-18
          (when (get-vehicle a0-18)
            #t
            (goto cfg-35)
            )
          )
        )
      (suspend)
      )
    #f
    (label cfg-35)
    (suspend-for (seconds 0.067)
      )
    (go-virtual waiting-game-start)
    )
  )


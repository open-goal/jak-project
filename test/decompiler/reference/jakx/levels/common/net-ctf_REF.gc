;; definition for method 56 of type net-player-ctf
(defmethod vehicle-update ((this net-player-ctf) (arg0 wvehicle))
  (draw-info-text this)
  (draw-flag-event this)
  (let ((v1-4 *ctf-flag*))
    (let ((a0-4 (the-as ctf-base #f)))
      (let ((a1-1 (-> this team)))
        (cond
          ((zero? a1-1)
           (set! a0-4 *ctf-red-base*)
           *ctf-blue-base*
           )
          ((= a1-1 1)
           (set! a0-4 *ctf-blue-base*)
           *ctf-red-base*
           )
          )
        )
      (cond
        (v1-4
          (let ((a2-3 (the-as wvehicle (handle->process (-> v1-4 carrier)))))
            (when arg0
              (cond
                ((not a2-3)
                 (send-event arg0 'set 'ai-target-position (-> v1-4 root trans))
                 )
                ((= (-> a2-3 player-id) (-> this player-id))
                 (send-event arg0 'set 'ai-target-position (-> a0-4 root trans))
                 )
                ((!= (-> v1-4 team) (-> this team))
                 (send-event arg0 'set 'ai-target-process a2-3)
                 )
                (else
                  (let* ((a1-17 (-> v1-4 root trans))
                         (v1-19 (pick-target this a1-17 (the-as vector #f)))
                         )
                    (send-event arg0 'set 'ai-target-process v1-19)
                    )
                  )
                )
              )
            )
          ((method-of-type net-player vehicle-update) this arg0)
          )
        (else
          ((method-of-type net-player-deathmatch vehicle-update) this arg0)
          )
        )
      )
    )
  (none)
  )

;; definition for method 53 of type net-game-mgr-ctf
;; WARN: Return type mismatch int vs none.
(defmethod spawn-hud-indicators ((this net-game-mgr-ctf) (arg0 vehicle))
  (set! (-> this hud-player-indicators (logand (get-player-id arg0) 1))
        (process->handle (hud-indicators-spawn))
        )
  (none)
  )

;; definition for method 57 of type net-game-mgr-ctf
(defmethod init-common ((this net-game-mgr-ctf))
  (set! (-> this spawner-count) 0)
  (init-spawners this)
  (if (zero? (-> this spawner-count))
      (format 0 "WARNING: !!!!!!!!!!!! No spawn-point entities found !!!!!!!!!!!!!!!! ~%")
      )
  (if (= (if *net-mgr*
             (-> *net-mgr* game-state local-machine-idx)
             0
             )
         (-> *net-mgr* game-state session-master-idx)
         )
      (ctf-flag-spawn this)
      )
  ((method-of-type net-game-mgr init-common) this)
  (none)
  )

;; definition for method 10 of type net-game-mgr-ctf
(defmethod deactivate ((this net-game-mgr-ctf))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (if *ctf-flag*
      (deactivate *ctf-flag*)
      )
  ((method-of-type net-game-mgr deactivate) this)
  (none)
  )

;; definition for method 71 of type net-game-mgr-ctf
(defmethod get-counter-texture ((this net-game-mgr-ctf))
  (get-texture hud-capturetheflag-counter-01 level-default-minimap)
  )

;; definition for method 64 of type net-game-mgr-ctf
;; WARN: Return type mismatch int vs none.
(defmethod net-game-mgr-method-64 ((this net-game-mgr-ctf))
  (local-vars (v1-18 symbol))
  (let ((gp-0 (-> *net-players* (* (if *net-mgr*
                                       (-> *net-mgr* game-state local-machine-idx)
                                       0
                                       )
                                   2
                                   )
                  )
              )
        )
    (when (and gp-0 (and (not (logtest? (-> gp-0 flags) (net-player-flag finish-speech)))
                         (= (/ (-> gp-0 player-id) 2) (if *net-mgr*
                                                          (-> *net-mgr* game-state local-machine-idx)
                                                          0
                                                          )
                            )
                         (>= (-> gp-0 player-id) 0)
                         (< (-> gp-0 player-id) 16)
                         )
               )
      (when (>= (calc-team-score (the-as int (-> gp-0 team))) (calc-team-score (if (zero? (-> gp-0 team))
                                                                                   1
                                                                                   0
                                                                                   )
                                                                               )
                )
        (set! v1-18 #t)
        (goto cfg-23)
        )
      (set! v1-18 #f)
      (label cfg-23)
      (if v1-18
          (play-win-speech gp-0)
          (play-lose-speech gp-0)
          )
      (logior! (-> gp-0 flags) (net-player-flag finish-speech))
      )
    )
  0
  (none)
  )

;; definition for method 96 of type net-player-ctf
(defmethod score-kill ((this net-player-ctf) (arg0 int))
  (if (logtest? (-> *net-world* net-state options advanced-options flags)
                (game-task-advanced-options-flag kill-plus-flag)
                )
      ((method-of-type net-player-deathmatch score-kill) this arg0)
      )
  (none)
  )

;; definition for method 48 of type net-player-ctf
(defmethod handle-events ((this net-player-ctf) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (case arg2
    (('flag-returned)
     (+! (-> this score) 5)
     (write-score-change this)
     )
    (('flag-captured)
     (+! (-> this score) 10)
     (write-score-change this)
     )
    (else
      ((method-of-type net-player-deathmatch handle-events) this arg0 arg1 arg2 arg3)
      )
    )
  )

(in-package goal)

;; definition for method 216 of type wvehicle
;; WARN: Return type mismatch int vs none.
(defmethod wvehicle-method-216 ((this wvehicle) (arg0 float))
  (let ((v1-0 (-> this info)))
    (let* ((f0-0 (-> v1-0 engine inertia))
           (f1-0 (-> this clutch-grab))
           (f2-0 (-> this clutch-inertia))
           (f3-0 (-> this gear-ratio))
           (f3-4 (square (/ 1.0 f3-0)))
           (f4-1 (-> v1-0 transmission inertia))
           (f5-0 (-> this final-drive-ratio))
           (f0-1 (+ f0-0 (* f1-0 (+ f2-0 (* f3-4 (+ f4-1 (* (square (/ 1.0 f5-0)) (-> this drive-wheel-inertia))))))))
           )
      (if (= (-> this clutch-grab) 0.0)
          (+! f0-1 (* 40.0 (-> v1-0 engine inertia)))
          )
      (let ((f1-10
              (- (* (- (fmax 0.0 (* (-> this total-gear-ratio) (-> this wheel-rev))) (-> this engine-rev)) f0-1 (/ 1.0 arg0))
                 (-> this engine-torque)
                 )
              )
            )
        (set! (-> this engine-load) (* (-> this clutch-grab) f1-10))
        (let ((f1-13 (* (+ (-> this engine-torque) (* f1-10 (-> this clutch-grab))) (/ 1.0 f0-1))))
          (+! (-> this engine-rev) (* arg0 f1-13))
          )
        )
      )
    (let* ((f0-5 (-> this engine-rev))
           (f1-15 (-> v1-0 engine max-rpm))
           (f0-6 (fmin f0-5 (* 0.10471976 f1-15)))
           (f1-18 (-> v1-0 engine min-rpm))
           )
      (set! (-> this engine-rev) (fmax f0-6 (* 0.10471976 f1-18)))
      )
    )
  0
  (none)
  )

;; definition of type wvehicle-wheel-work
(deftype wvehicle-wheel-work (structure)
  ((side-dir     vector  :inline)
   (forward-dir  vector  :inline)
   (velocity     vector  :inline)
   )
  )

;; definition for method 3 of type wvehicle-wheel-work
(defmethod inspect ((this wvehicle-wheel-work))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'wvehicle-wheel-work)
  (format #t "~1Tside-dir: #<vector @ #x~X>~%" (-> this side-dir))
  (format #t "~1Tforward-dir: #<vector @ #x~X>~%" (-> this forward-dir))
  (format #t "~1Tvelocity: #<vector @ #x~X>~%" (-> this velocity))
  (label cfg-4)
  this
  )

;; definition of type wvehicle-physics-work

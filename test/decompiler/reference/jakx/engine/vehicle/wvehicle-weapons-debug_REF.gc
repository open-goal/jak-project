;;-*-Lisp-*-
(in-package goal)

;; definition for function set-veh-weapon
(defun set-veh-weapon ((arg0 symbol) (arg1 int) (arg2 vehicle))
  (let ((s3-0 (if (= arg0 'left)
                  0
                  1
                  )
              )
        (s4-0 (as-type arg2 wvehicle))
        )
    (when (not s4-0)
      (format #t "not a valid vehicle!~%")
      (return #f)
      )
    (if (handle->process (-> (the-as wvehicle (+ (* s3-0 8) (the-as int s4-0))) wpn-left))
        (deactivate (handle->process (-> (the-as wvehicle (+ (* s3-0 8) (the-as int s4-0))) wpn-left)))
        )
    (send-event s4-0 'weapon 'equipped arg1 arg0)
    )
  )

;; definition for function dm-set-veh-weapon
;; WARN: Return type mismatch object vs none.
(defun dm-set-veh-weapon ((arg0 symbol) (arg1 int))
  (set-veh-weapon
    arg0
    arg1
    (the-as vehicle (net-player-method-49 (-> *net-players* (* (if *net-mgr*
                                                                   (-> *net-mgr* game-state local-machine-idx)
                                                                   0
                                                                   )
                                                               2
                                                               )
                                              )
                                          )
            )
    )
  (none)
  )

;; definition for function set-vehicle-light-eco
(defun set-vehicle-light-eco ((arg0 float) (arg1 vehicle))
  (let ((f0-2 (cond
                ((< 1.0 arg0)
                 1.0
                 )
                ((< arg0 0.0)
                 0.0
                 )
                (else
                  arg0
                  )
                )
              )
        )
    (set! (-> arg1 pad4 1) (the-as uint f0-2))
    f0-2
    )
  )

;; definition for function dm-set-veh-leco
;; WARN: Return type mismatch int vs none.
(defun dm-set-veh-leco ((arg0 int))
  (case arg0
    ((1)
     (set-vehicle-light-eco
       0.0
       (the-as vehicle (net-player-method-49 (-> *net-players* (* (if *net-mgr*
                                                                      (-> *net-mgr* game-state local-machine-idx)
                                                                      0
                                                                      )
                                                                  2
                                                                  )
                                                 )
                                             )
               )
       )
     )
    ((2)
     (set-vehicle-light-eco
       1.0
       (the-as vehicle (net-player-method-49 (-> *net-players* (* (if *net-mgr*
                                                                      (-> *net-mgr* game-state local-machine-idx)
                                                                      0
                                                                      )
                                                                  2
                                                                  )
                                                 )
                                             )
               )
       )
     )
    ((3)
     (set-vehicle-light-eco
       1.0
       (the-as vehicle (net-player-method-49 (-> *net-players* (* (if *net-mgr*
                                                                      (-> *net-mgr* game-state local-machine-idx)
                                                                      0
                                                                      )
                                                                  2
                                                                  )
                                                 )
                                             )
               )
       )
     )
    (else
      (set-vehicle-light-eco
        0.0
        (the-as vehicle (net-player-method-49 (-> *net-players* (* (if *net-mgr*
                                                                       (-> *net-mgr* game-state local-machine-idx)
                                                                       0
                                                                       )
                                                                   2
                                                                   )
                                                  )
                                              )
                )
        )
      )
    )
  0
  (none)
  )

;; definition for function test-vehicle-weapon
;; WARN: Return type mismatch object vs none.
(defun test-vehicle-weapon ((arg0 symbol))
  (send-event
    (handle->process
      (-> (the-as
            wvehicle
            (+ (* (if (= arg0 'left)
                      0
                      1
                      )
                  8
                  )
               (the-as int (net-player-method-49 (-> *net-players* (* (if *net-mgr*
                                                                          (-> *net-mgr* game-state local-machine-idx)
                                                                          0
                                                                          )
                                                                      2
                                                                      )
                                                     )
                                                 )
                       )
               )
            )
          wpn-left
          )
      )
    'fire
    )
  (none)
  )





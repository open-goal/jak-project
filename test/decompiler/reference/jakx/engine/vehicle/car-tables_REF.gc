(in-package goal)

;; definition for symbol *car-look-mask-array*, type (array (array uint32))
(define *car-look-mask-array*
  (the-as (array (array uint32))
    (new 'static 'boxed-array :type array
      (new 'static 'boxed-array :type uint32 #x3 #x0 #x1 #x0 #x1 #x7 #xf #x0 #x3fffff #x3f #x3f)
      (new 'static 'boxed-array :type uint32 #x0 #x1f #x1f #x0 #x0 #x1f #x1f #x1f #x3fffff #x3f #x3f)
      (new 'static 'boxed-array :type uint32 #x1f #x1f #x1f #x0 #x0 #x1f #x1f #x1f #x3fffff #x3f #x3f)
      (new 'static 'boxed-array :type uint32 #x1f #x0 #x1f #x0 #x0 #x1f #x1f #x0 #x3fffff #x3f #x3f)
      (new 'static 'boxed-array :type uint32 #x1f #x1f #x1f #x0 #x0 #x1f #x0 #x1f #x3fffff #x3f #x3f)
      (new 'static 'boxed-array :type uint32 #x1f #x1f #x1f #x1f #x0 #x1f #x0 #x0 #x3fffff #x3f #x3f)
      (new 'static 'boxed-array :type uint32 #x0 #x0 #x1f #x1f #x1f #x1f #x0 #x1f #x3fffff #x3f #x3f)
      (new 'static 'boxed-array :type uint32 #x0 #x1f #x1f #x0 #x0 #x1f #x1f #x1f #x3fffff #x3f #x3f)
      (new 'static 'boxed-array :type uint32 #x1f #x1f #x1f #x0 #x0 #x1f #x0 #x1f #x3fffff #x3f #x3f)
      (new 'static 'boxed-array :type uint32 #x0 #x0 #x1f #x1f #x1 #x1f #x0 #x1f #x3fffff #x3f #x3f)
      (new 'static 'boxed-array :type uint32 #x1f #x1f #x1f #x0 #x0 #x1f #x0 #x1f #x3fffff #x3f #x3f)
      (new 'static 'boxed-array :type uint32 #x1f #x1f #x1f #x0 #x0 #x1f #x0 #x1f #x3fffff #x3f #x3f)
      (new 'static 'boxed-array :type uint32 #x1f #x1f #x0 #x1f #x0 #x0 #x1f #x1f #x3fffff #x3f #x3f)

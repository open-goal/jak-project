  )

;; definition of type wvehicle-engine-mix-state
(deftype wvehicle-engine-mix-state (structure)
  ((loops  wvehicle-engine-loop-state  2 :inline)
   )
  )

;; definition for method 3 of type wvehicle-engine-mix-state
(defmethod inspect ((this wvehicle-engine-mix-state))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )

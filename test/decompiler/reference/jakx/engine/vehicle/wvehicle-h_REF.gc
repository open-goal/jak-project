    (wvehicle-method-238 () none)
    (wvehicle-method-239 () none)
    (wvehicle-method-240 () none)
    (wvehicle-method-241 () none)
    (wvehicle-method-242 () none)
    (wvehicle-method-243 () none)
    (wvehicle-method-244 () none)
    (wvehicle-method-245 () none)
    (wvehicle-method-246 () none)

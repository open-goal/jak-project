(defmethod inspect ((this vehicle-draw-thruster-params))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'vehicle-draw-thruster-params)
  (format #t "~1Tquat: #<quaternion @ #x~X>~%" (-> this quat))
  (format #t "~1Ttrans: #<vector @ #x~X>~%" (-> this trans))

        )
    (if (= (logand s5-0 (vehicle-flag dead)) (vehicle-flag dead))
        (format #t "dead ")
        )
    (if (= (logand (vehicle-flag wheel-fire) s5-0) (shl #x4000 32))
        (format #t "wheel-fire ")
        )
    (if (= (logand (vehicle-flag ai-off-nav-mesh) s5-0) (shl 2048 32))

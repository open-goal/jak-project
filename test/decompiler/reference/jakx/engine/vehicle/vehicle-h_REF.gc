   (trans       vector      :inline)
   (thrust-rgb  rgbaf       :inline)
   (glow-rgb    rgbaf       :inline)
   (tex-id      uint32)
   (thrust      float)
   (width       float)
   (length      float)
   (fog-fade    float)
   )
  )


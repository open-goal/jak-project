(defmethod on-impact ((this rigid-body-object))
  (logior! (-> this flags) (rigid-body-object-flag disturbed))
  (set! (-> this disturbed-time) (the-as uint (current-time)))
  (if (not (logtest? (-> this rbody flags) (rigid-body-flag enable-physics)))
      (enable-physics this)
      )
  0
  (none)
  )


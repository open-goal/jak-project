;; definition for method 82 of type rigid-body-object
;; INFO: Used lq/sq
;; WARN: Return type mismatch symbol vs object.
(defmethod attack-handler ((this rigid-body-object)
                          (arg0 process-focusable)
                          (arg1 attack-info)
                          (arg2 touching-shapes-entry)
                          (arg3 penetrate)
                          )
  (when arg2
    (let ((s5-0 (new 'stack-no-clear 'rigid-body-impact)))
      (rigid-body-object-method-84 this s5-0 arg2)
      (if (logtest? (attack-mask attacker-velocity) (-> arg1 mask))
          (set! (-> s5-0 velocity quad) (-> arg1 attacker-velocity quad))
          (vector-! (-> s5-0 velocity) (-> s5-0 point) (-> arg0 root trans))
          )
      (rigid-body-object-method-79 this s5-0 arg1)
      (on-impact this)
      (let ((s4-1 (new 'stack-no-clear 'vector)))
        (set! (-> s4-1 quad) (-> s5-0 velocity quad))
        (vector-normalize! s4-1 1.0)
        (vector-float*! s4-1 s4-1 (-> s5-0 impulse))
        (apply-impact! (-> this rbody) (-> s5-0 point) s4-1)
        (integrate-momentum! (-> this rbody) 1.0)
        (init-velocities! (-> this rbody))
        (when #f
          (add-debug-x #t (bucket-id debug-no-zbuf1) (-> s5-0 point) *color-blue*)
          (add-debug-vector #t (bucket-id debug-no-zbuf1) (-> s5-0 point) s4-1 (meters 0.00024414062) *color-blue*)
          )
        )
      (rigid-body-object-method-80 this s5-0)
      )
    (if (and (-> this next-state) (= (-> this next-state name) 'idle))
        (rigid-body-object-method-77 this)
        )
    #t
    )
  )

;; definition for method 83 of type rigid-body-object
;; INFO: Used lq/sq
;; WARN: Return type mismatch symbol vs object.
(defmethod touch-handler ((this rigid-body-object) (arg0 process-focusable) (arg1 touching-shapes-entry))
  (let ((s5-0 (new 'stack-no-clear 'inline-array 'rigid-body-impact 2)))
    (set! (-> s5-0 1 velocity x) (process-focusable-method-57 arg0))
    (rigid-body-object-method-84 this (-> s5-0 0) arg1)
    (if (logtest? (-> this rbody flags) (rigid-body-flag enable-physics))
        (get-velocity-at-point (-> this rbody) (-> s5-0 0 point) (-> s5-0 0 velocity))
        (set! (-> s5-0 0 velocity quad) (-> this root transv quad))
        )
    (let ((v1-10 (-> arg0 root)))
      (set! (-> s5-0 1 point quad) (-> v1-10 transv quad))
      (vector-! (-> s5-0 0 velocity) (-> v1-10 transv) (-> s5-0 0 velocity))
      )
    (let ((f0-2 (vector-dot (-> s5-0 0 velocity) (-> s5-0 0 normal))))
      (when (< f0-2 0.0)
        (set! (-> s5-0 0 impulse) (/ f0-2 (+ (-> s5-0 1 velocity x) (-> this info info inv-mass))))
        (vector+float*!
          (-> s5-0 1 point)
          (-> s5-0 1 point)
          (-> s5-0 0 normal)
          (* -3.1 (-> s5-0 1 velocity x) (-> s5-0 0 impulse))
          )
        (set! (-> s5-0 1 point y) (fmax (* 49152.0 (-> s5-0 1 velocity x)) (-> s5-0 1 point y)))
        (on-impact this)
        (vector-float*! (-> s5-0 1 normal) (-> s5-0 0 normal) (-> s5-0 0 impulse))
        (apply-impact! (-> this rbody) (-> s5-0 0 point) (-> s5-0 1 normal))
        (integrate-momentum! (-> this rbody) 1.0)
        (init-velocities! (-> this rbody))
        (when #f
          (add-debug-x #t (bucket-id debug-no-zbuf1) (-> s5-0 0 point) *color-blue*)
          (add-debug-vector
            #t
            (bucket-id debug-no-zbuf1)
            (-> s5-0 0 point)
            (-> s5-0 0 normal)
            (- (-> s5-0 0 impulse))
            *color-blue*
            )
          )
        (rigid-body-object-method-80 this (-> s5-0 0))
        (if (and (-> this next-state) (= (-> this next-state name) 'idle))
            (rigid-body-object-method-77 this)
            )
        )
      )
    )
  #t
  )

;; definition for method 81 of type rigid-body-object
(defmethod rigid-body-object-method-81 ((this rigid-body-object) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (case arg2
    (('impact-impulse)
     (let ((s5-1 (-> arg3 param 0)))
       (if (!= this arg0)
           (on-impact this)
           )
       (rigid-body-object-method-80 this (the-as rigid-body-impact s5-1))
       )
     (if (and (-> this next-state) (= (-> this next-state name) 'idle))
         (rigid-body-object-method-77 this)
         )
     #t
     )
    (('touched)
     (if (= this *debug-actor*)
         (format *stdcon* "rigid-body-object got touched~%")
         )
     (when (zero? (-> (the-as process-focusable arg0) rbody))
       (let ((a1-4 (as-type arg0 process-focusable)))
         (if a1-4
             (touch-handler this (the-as process-focusable a1-4) (the-as touching-shapes-entry (-> arg3 param 0)))
             )
         )
       )
     )
    (('attack)
     (let ((s3-0 (the-as object (-> arg3 param 1)))
           (t0-1 (get-penetrate-using-from-attack-event (the-as process-drawable arg0) arg3))
           )
       (when (!= (-> (the-as attack-info s3-0) id) (-> this incoming-attack-id))
         (set! (-> this incoming-attack-id) (-> (the-as attack-info s3-0) id))
         (attack-handler
           this
           (the-as process-focusable arg0)
           (the-as attack-info s3-0)
           (the-as touching-shapes-entry (-> arg3 param 0))
           t0-1
           )
         )
       )
     )
    (('enable-physics)
     (on-impact this)
     #t
     )
    )
  )

;; definition for function rigid-body-object-event-handler
(defbehavior rigid-body-object-event-handler rigid-body-object ((arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (rigid-body-object-method-81 self arg0 arg1 arg2 arg3)
  )

;; failed to figure out what this is:
(defstate idle (rigid-body-object)
  :virtual #t
  :event rigid-body-object-event-handler
  :code sleep-code
  )

;; failed to figure out what this is:
(defstate active (rigid-body-object)
  :virtual #t
  :event rigid-body-object-event-handler
  :enter (behavior ()
    (logior! (-> self rbody flags) (rigid-body-flag debug-active))
    )
  :code sleep-code
  :post (behavior ()
    (rigid-body-object-method-71 self)
    )
  )

  (none)
  )

;; definition for method 9 of type mem-buffer
;; WARN: Return type mismatch int vs none.
(defmethod check-buffer-overrun ((this mem-buffer) (arg0 int))
  (when (< (-> this limit) (the-as uint (&+ (-> this ptr) arg0)))
    (format 0 "buffer overrun!~%")
    (break!)
    0

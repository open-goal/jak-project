;; failed to figure out what this is:
(dotimes (v1-20 4)
  (set! (-> *msg-buffers* v1-20 in-use) #f)
  )

;; definition for function alloc-msg-buffer
(defun alloc-msg-buffer ()
  (dotimes (gp-0 4)
    (when (not (-> *msg-buffers* gp-0 in-use))
      (set! (-> *msg-buffers* gp-0 in-use) #t)
      (reset! (-> *msg-buffers* gp-0))
      (return (-> *msg-buffers* gp-0))
      )
    )
  (the-as mem-buffer #f)
  )

;; definition for function free-msg-buffer
;; WARN: Return type mismatch int vs none.
(defun free-msg-buffer ((arg0 mem-buffer))
  (set! (-> arg0 in-use) #f)
  0
  (none)
  )


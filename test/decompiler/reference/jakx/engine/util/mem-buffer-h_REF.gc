(in-package goal)

;; definition of type mem-buffer
(deftype mem-buffer (structure)
  ((base    pointer)
   (ptr     pointer)
   (limit   uint32)
   (in-use  symbol)
   )
  (:methods
    (check-buffer-overrun (_type_ int) none)
    (set-buffer! (_type_ pointer int) none)
    (bytes-used (_type_) int)
    (bytes-remaining (_type_) uint)
    (reset! (_type_) none)
    (write-int8 (_type_ int) none)
    (write-int16 (_type_ int) none)
    (write-int32 (_type_ int) none)
    (write-int64 (_type_ int) none)
    (write-uint8 (_type_ uint) none)
    (write-uint16 (_type_ uint) none)
    (write-uint32 (_type_ uint) none)
    (write-uint64 (_type_ uint) none)
    (write-float (_type_ float) none)
    (write-vector (_type_ vector) none)
    (write-vector-scaled (_type_ vector vector) none)
    (write-quaternion (_type_ quaternion) none)
    (write-level-pos (_type_ vector) none)
    (copy-buffer (_type_ mem-buffer) none)
    (write-symbol (_type_ symbol) none)
    (write-bool (_type_ symbol) none)
    (write-string (_type_ (pointer uint8)) none)
    (write-bytes (_type_ pointer int) none)
    (read-int8 (_type_) int)
    (read-int16 (_type_) int)
    (read-int32 (_type_) int)
    (read-int64 (_type_) int)
    (read-uint8 (_type_) uint)
    (read-uint16 (_type_) uint)
    (read-uint32 (_type_) uint)
    (read-uint64 (_type_) uint)
    (read-float (_type_) float)
    (read-vector (_type_ mem-buffer) none)
    (read-vector-scaled (_type_ vector vector) none)
    (read-quaternion (_type_ quaternion) none)
    (read-level-pos (_type_ mem-buffer) none)
    (read-symbol (_type_) symbol)
    (read-bool (_type_) symbol)
    (read-string (_type_ (pointer uint8)) none)
    (read-bytes (_type_ pointer int) none)
    (dump-mem-used (_type_) none)
    (dump-mem-all (_type_) none)
    (skip-bytes (_type_ int) none)
    )
  )

;; definition for method 3 of type mem-buffer
(defmethod inspect ((this mem-buffer))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'mem-buffer)
  (format #t "~1Tbase: #x~X~%" (-> this base))
  (format #t "~1Tptr: #x~X~%" (-> this ptr))
  (format #t "~1Tlimit: ~D~%" (-> this limit))
  (format #t "~1Tin-use: ~A~%" (-> this in-use))
  (label cfg-4)
  this
  )

;; definition for method 10 of type mem-buffer

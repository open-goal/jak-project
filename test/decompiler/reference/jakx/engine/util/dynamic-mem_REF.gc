;; definition of type mem-manager
(deftype mem-manager (structure)
  ((pool     memblock)
   (pool-sz  int32)
   )
  (:methods
    (alloc (_type_ int memblock-flavor) pointer)
    (free (_type_ memblock) object)
    (realloc (_type_ pointer int memblock-flavor) pointer)
    (init! (_type_ memblock int) none)
    (validate (_type_) none)
    (print-mem (_type_) none)
    (largest-free-size (_type_) int)
    )
  )

;; definition for method 3 of type mem-manager
(defmethod inspect ((this mem-manager))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'mem-manager)
  (format #t "~1Tpool: #<memblock @ #x~X>~%" (-> this pool))
  (format #t "~1Tpool-sz: ~D~%" (-> this pool-sz))
  (label cfg-4)
  this
  )

;; definition for method 15 of type mem-manager
(defmethod largest-free-size ((this mem-manager))
  (let ((a0-1 (-> this pool))
        (v1-0 0)
        )
    (while a0-1
      (if (= (-> a0-1 tp) (memblock-type free))
          (set! v1-0 (max v1-0 (-> a0-1 paras)))
          )
      (set! a0-1 (-> a0-1 next))
      )
    (* v1-0 16)
    )
  )

;; definition for method 13 of type mem-manager
;; WARN: Return type mismatch int vs none.
(defmethod validate ((this mem-manager))
  (let ((s5-0 (-> this pool)))
    (when (nonzero? (-> s5-0 tp))
      (print-mem this)
      (break!)
      0
      )
    (while (!= (-> s5-0 tp) (memblock-type last))
      (when (not (or (= s5-0 (-> this pool)) (= (-> s5-0 tp) (memblock-type used)) (= (-> s5-0 tp) (memblock-type free))))
        (print-mem this)
        (break!)
        0
        )
      (when (!= (-> s5-0 next) (+ (the-as uint s5-0) (* (+ (-> s5-0 paras) 1) 16)))
        (print-mem this)
        (break!)
        0
        )
      (when (!= (-> s5-0 next prev) s5-0)
        (print-mem this)
        (break!)
        0
        )
      (set! s5-0 (-> s5-0 next))
      )
    (when (-> s5-0 next)
      (print-mem this)
      (break!)
      0
      )
    )
  (none)
  )

;; definition for method 11 of type mem-manager
(defmethod realloc ((this mem-manager) (arg0 pointer) (arg1 int) (arg2 memblock-flavor))
  (if (nonzero? arg0)
      (free this (the-as memblock arg0))
      )
  (let ((s4-1 (alloc this arg1 arg2)))
    (if (and (nonzero? arg0) (nonzero? s4-1))
        (mem-copy! s4-1 arg0 arg1)
        )
    s4-1
    )
  )

;; definition for method 12 of type mem-manager
;; WARN: Return type mismatch int vs none.
(defmethod init! ((this mem-manager) (arg0 memblock) (arg1 int))
  (set! (-> this pool) arg0)
  (set! (-> this pool-sz) (/ arg1 16))
  (let ((v1-1 (-> this pool)))
    (set! (-> v1-1 tp) (memblock-type first))
    (set! (-> v1-1 paras) 0)
    (set! (-> v1-1 flavor) (memblock-flavor unknown))
    (set! (-> v1-1 prev) #f)
    (set! (-> v1-1 next) (the-as memblock (+ (the-as uint v1-1) (* (+ (-> v1-1 paras) 1) 16))))
    (let ((v1-2 (-> v1-1 next)))
      (set! (-> v1-2 tp) (memblock-type free))
      (set! (-> v1-2 paras) (+ (-> this pool-sz) -3))
      (set! (-> v1-2 flavor) (memblock-flavor unknown))
      (set! (-> v1-2 prev) (-> this pool))
      (set! (-> v1-2 next) (the-as memblock (+ (the-as uint v1-2) (* (+ (-> v1-2 paras) 1) 16))))
      (let ((v1-3 (-> v1-2 next)))
        (set! (-> v1-3 tp) (memblock-type last))
        (set! (-> v1-3 paras) 0)
        (set! (-> v1-3 flavor) (memblock-flavor unknown))
        (set! (-> v1-3 prev) (-> this pool next))
        (set! (-> v1-3 next) #f)
        )
      )
    )
  (validate this)
  0
  (none)
  )

;; definition for method 9 of type mem-manager
;; WARN: Return type mismatch object vs pointer.
(defmethod alloc ((this mem-manager) (arg0 int) (arg1 memblock-flavor))
  (let ((v1-1 (/ (+ arg0 15) 16))
        (a1-1 (-> this pool))
        (a3-0 #x98967f)
        (a0-1 (the-as memblock #f))
        )
    (while a1-1
      (when (and (= (-> a1-1 tp) (memblock-type free)) (>= (-> a1-1 paras) v1-1))
        (when (< (-> a1-1 paras) a3-0)
          (set! a3-0 (-> a1-1 paras))
          (set! a0-1 a1-1)
          )
        )
      (set! a1-1 (-> a1-1 next))
      )
    (let ((s5-0 a0-1))
      (when (not s5-0)
        (format 0 "dynamic mem-allocator ran out trying to allocate ~D paras~%" v1-1)
        (print-mem this)
        (validate this)
        (return (the-as pointer 0))
        )
      (set! (-> s5-0 tp) (memblock-type used))
      (when (< (+ v1-1 1) (-> s5-0 paras))
        (let ((a0-5 (the-as memblock (+ (the-as uint a0-1) (* (+ v1-1 1) 16)))))
          (set! (-> a0-5 next) (-> s5-0 next))
          (set! (-> a0-5 next prev) a0-5)
          (set! (-> s5-0 next) a0-5)
          (set! (-> a0-5 prev) s5-0)
          (set! (-> a0-5 tp) (memblock-type free))
          (set! (-> a0-5 paras) (+ (- -1 v1-1) (-> s5-0 paras)))
          )
        (set! (-> s5-0 paras) v1-1)
        )
      (set! (-> s5-0 flavor) arg1)
      (validate this)
      (the-as pointer (&+ s5-0 16))
      )
    )
  )

;; definition for method 10 of type mem-manager
;; WARN: Return type mismatch int vs object.
(defmethod free ((this mem-manager) (arg0 memblock))
  (let ((v1-0 (+ (the-as uint arg0) -16)))
    (when (!= (-> v1-0 tp) (memblock-type used))
      (format 0 "attempt to free a bad block!~%")
      (return (the-as object #f))
      )
    (set! (-> v1-0 tp) (memblock-type free))
    (when (= (-> v1-0 next tp) (memblock-type free))
      (set! (-> v1-0 paras) (+ (-> v1-0 next paras) 1 (-> v1-0 paras)))
      (set! (-> v1-0 next) (the-as memblock (+ (the-as uint v1-0) (* (+ (-> v1-0 paras) 1) 16))))
      (set! (-> v1-0 next prev) v1-0)
      )
    (let ((v1-1 (-> v1-0 prev)))
      (when (= (-> v1-1 tp) (memblock-type free))
        (set! (-> v1-1 paras) (+ (-> v1-1 next paras) 1 (-> v1-1 paras)))
        (set! (-> v1-1 next) (the-as memblock (+ (the-as uint v1-1) (* (+ (-> v1-1 paras) 1) 16))))
        (set! (-> v1-1 next prev) v1-1)
        )
      )
    )
  (validate this)
  0
  )

;; definition for method 14 of type mem-manager
;; WARN: Return type mismatch int vs none.
(defmethod print-mem ((this mem-manager))
  (let ((gp-0 (-> this pool)))
    (while gp-0
      (format 0 "blk@~08X : " gp-0)
      (format 0 "~8D bytes  " (* (-> gp-0 paras) 16))
      (case (-> gp-0 tp)
        (((memblock-type free))
         (format 0 "free ")
         )
        (((memblock-type used))
         (format 0 "used ")
         )
        (((memblock-type first))
         (format 0 "first ")
         )
        (((memblock-type last))
         (format 0 "last ")
         )
        (else
          (format 0 "????~%")
          (break!)
          0
          )
        )
      (when (= (-> gp-0 tp) (memblock-type used))
        (case (-> gp-0 flavor)
          (((memblock-flavor unknown))
           (format 0 "unknown ")
           )
          (((memblock-flavor lgaud))
           (format 0 "lgaud ")
           )
          (((memblock-flavor nelly))
           (format 0 "nelly ")
           )
          (((memblock-flavor scert))
           (format 0 "scert ")
           )
          (else
            (format 0 "<unknown flavor> ")
            (break!)
            0
            )
          )
        )
      (format 0 "~%")
      (set! gp-0 (-> gp-0 next))
      )
    )
  0
  (none)
  )


;;-*-Lisp-*-
(in-package goal)

;; definition of type stat-info
(deftype stat-info (structure)
  ((text-id       text-id)
   (taskname      symbol)
   (name          symbol)
   (offset        int32)
   (tp            stat-type)
   (scale         float)
   (format-scale  float)
   (flags         stat-info-flag)
   (init          int32)
   (min-div       int32)
   )
  (:methods
    (format-stat (_type_ (pointer int32) string symbol) object)
    (format-value (_type_ int string symbol) object)
    (add-to-stat! (_type_ (pointer int32) float) none)
    (set-stat-if-better! (_type_ (pointer int32) float) symbol)
    (compute-ratio-stat! (_type_ (pointer int32) stat-info stat-info) none)
    (format-name (_type_ string) none)
    )
  )

;; definition for method 3 of type stat-info
(defmethod inspect ((this stat-info))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'stat-info)
  (format #t "~1Ttext-id: ~D~%" (-> this text-id))
  (format #t "~1Ttaskname: ~A~%" (-> this taskname))
  (format #t "~1Tname: ~A~%" (-> this name))
  (format #t "~1Toffset: ~D~%" (-> this offset))
  (format #t "~1Ttp: ~D~%" (-> this tp))
  (format #t "~1Tscale: ~f~%" (-> this scale))
  (format #t "~1Tformat-scale: ~f~%" (-> this format-scale))
  (format #t "~1Tflags: ~D~%" (-> this flags))
  (format #t "~1Tinit: ~D~%" (-> this init))
  (format #t "~1Tmin-div: ~D~%" (-> this min-div))
  (label cfg-4)
  this
  )

;; definition for method 14 of type stat-info
;; WARN: Return type mismatch int vs none.
(defmethod format-name ((this stat-info) (arg0 string))
  (cond
    ((or (= (-> this tp) (stat-type lap-time)) (= (-> this tp) (stat-type time-trial)))
     (clear arg0)
     (dotimes (s4-0 (length *task-level*))
       (if (= (-> *task-level* s4-0) (-> this taskname))
           (format
             arg0
             "~S: ~S"
             (lookup-text! *common-text* (-> this text-id) #f)
             (lookup-text! *common-text* (-> *task-level-info* s4-0 text-id) #f)
             )
           )
       )
     )
    (else
      (clear arg0)
      (format arg0 "~S" (lookup-text! *common-text* (-> this text-id) #f))
      )
    )
  0
  (none)
  )

;; definition for method 9 of type stat-info
(defmethod format-stat ((this stat-info) (arg0 (pointer int32)) (arg1 string) (arg2 symbol))
  (let ((a1-1 (-> (&+ arg0 (-> this offset)) 0)))
    (format-value this a1-1 arg1 arg2)
    )
  )

;; definition for method 10 of type stat-info
;; WARN: Return type mismatch int vs object.
(defmethod format-value ((this stat-info) (arg0 int) (arg1 string) (arg2 symbol))
  (clear arg1)
  (if (< arg0 0)
      (return (the-as object #f))
      )
  (when (zero? arg0)
    (copy-string<-string arg1 "N/A")
    (return (the-as object #f))
    )
  (let ((a2-1 (+ arg0 -1)))
    (case (-> this tp)
      (((stat-type count))
       (format arg1 "~D" a2-1)
       )
      (((stat-type percent))
       (format arg1 "~D.~D%" (/ a2-1 10) (mod a2-1 10))
       )
      (((stat-type rate))
       (let* ((f0-3 (/ (* (the float a2-1) (-> this format-scale)) (-> this scale)))
              (a2-3 (the int f0-3))
              (a3-3 (mod (the int (* 1000.0 f0-3)) 1000))
              )
         (format arg1 "~D.~3,'0D" a2-3 a3-3)
         )
       )
      (((stat-type distance))
       (format arg1 "~Dm" (/ a2-1 100))
       )
      (((stat-type time))
       (print-time arg1 (the-as time-frame a2-1))
       )
      (((stat-type speed))
       (let ((s4-1 (/ a2-1 32))
             (s3-1 (logand a2-1 31))
             )
         (if arg2
             (format
               arg1
               "~D ~S (~S)"
               s4-1
               (lookup-text! *common-text* (text-id text-id-2274) #f)
               (get-vehicle-name (the-as net-vehicle-type s3-1))
               )
             (format arg1 "~D ~S" s4-1 (lookup-text! *common-text* (text-id text-id-2274) #f))
             )
         )
       )
      (((stat-type lap-time) (stat-type time-trial))
       (let ((a1-13 (/ a2-1 32))
             (s4-2 (logand a2-1 31))
             )
         (print-time arg1 (the-as time-frame a1-13))
         (if arg2
             (format arg1 " (~S)" (get-vehicle-name (the-as net-vehicle-type s4-2)))
             )
         )
       )
      (((stat-type seconds))
       (format arg1 "~D:~2,'0D:~2,'0D" (/ a2-1 3600) (mod (/ a2-1 60) 60) (mod a2-1 60))
       )
      )
    )
  0
  )

;; definition for method 11 of type stat-info
;; WARN: Return type mismatch int vs none.
;; WARN: Function (method 11 stat-info) has a return type of none, but the expression builder found a return statement.
(defmethod add-to-stat! ((this stat-info) (arg0 (pointer int32)) (arg1 float))
  (if (not *should-update-stats*)
      (return #f)
      )
  (let ((v1-5 (-> (&+ arg0 (-> this offset)) 0)))
    (if (zero? v1-5)
        (set! v1-5 1)
        )
    (case (-> this tp)
      (((stat-type count) (stat-type seconds) (stat-type distance) (stat-type time))
       (+! v1-5 (the int arg1))
       )
      (((stat-type percent) (stat-type rate))
       (+! v1-5 (the int (* arg1 (-> this scale))))
       )
      )
    (set! (-> (&+ arg0 (-> this offset)) 0) v1-5)
    )
  0
  (none)
  )

;; definition for method 12 of type stat-info
(defmethod set-stat-if-better! ((this stat-info) (arg0 (pointer int32)) (arg1 float))
  (local-vars (a2-1 int))
  (if (not *should-update-stats*)
      (return #f)
      )
  (let ((v1-5 (-> (&+ arg0 (-> this offset)) 0)))
    0
    (case (-> this tp)
      (((stat-type percent) (stat-type rate))
       (set! a2-1 (the int (* arg1 (-> this scale))))
       )
      (else
        (set! a2-1 (the int arg1))
        )
      )
    (let ((v1-6 (+ v1-5 -1)))
      (when (or (< v1-6 0)
                (and (logtest? (-> this flags) (stat-info-flag lower-is-better)) (< a2-1 v1-6))
                (and (not (logtest? (-> this flags) (stat-info-flag lower-is-better))) (< v1-6 a2-1))
                )
        (set! (-> (&+ arg0 (-> this offset)) 0) (+ a2-1 1))
        (return #t)
        )
      )
    )
  #f
  )

;; definition for method 13 of type stat-info
;; WARN: Return type mismatch int vs none.
;; WARN: Function (method 13 stat-info) has a return type of none, but the expression builder found a return statement.
(defmethod compute-ratio-stat! ((this stat-info) (arg0 (pointer int32)) (arg1 stat-info) (arg2 stat-info))
  (let ((v1-2 (-> (&+ arg0 (-> arg1 offset)) 0))
        (t0-2 (-> (&+ arg0 (-> arg2 offset)) 0))
        )
    (when (or (zero? v1-2) (< t0-2 (-> this min-div)))
      (set! (-> (&+ arg0 (-> this offset)) 0) 0)
      (return #f)
      )
    (let* ((t1-3 (+ v1-2 -1))
           (v1-5 (+ t0-2 -1))
           (f0-2 (/ (the float t1-3) (-> arg1 scale)))
           (f2-1 (/ (the float v1-5) (-> arg2 scale)))
           (f0-4 (* (-> this scale) (/ f0-2 f2-1)))
           )
      (set! (-> (&+ arg0 (-> this offset)) 0) (+ (the int (+ 0.5 f0-4)) 1))
      )
    )
  0
  (none)
  )


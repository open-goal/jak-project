;; definition for symbol *net-clan-ladder-stats-info*, type net-clan-ladder-stats-info
(define *net-clan-ladder-stats-info*
  (the-as net-clan-ladder-stats-info (-> *net-clan-ladder-stats-info-array* data))
  )

;; definition for method 9 of type net-player-ladder-stats-info
;; WARN: Return type mismatch symbol vs none.
(defmethod init-stats! ((this net-player-ladder-stats-info) (arg0 net-player-ladder-stats))
  (dotimes (v1-0 (-> *net-player-ladder-stats-info-array* length))
    (set! (-> (the-as (pointer int32) (+ (the-as uint arg0) (* v1-0 4))))
          (-> *net-player-ladder-stats-info-array* v1-0 init)
          )
    )
  (none)
  )

;; definition for method 10 of type net-player-ladder-stats-info
(defmethod update-computed-stats! ((this net-player-ladder-stats-info) (arg0 net-player-ladder-stats))
  (compute-ratio-stat!
    (-> this events-played-pct)
    (the-as (pointer int32) arg0)
    (-> this events-played)
    (-> this events-started)
    )
  (compute-ratio-stat!
    (-> this events-won-pct)
    (the-as (pointer int32) arg0)
    (-> this events-won)
    (-> this events-played)
    )
  (compute-ratio-stat!
    (-> this events-ended-or-quit-pct)
    (the-as (pointer int32) arg0)
    (-> this events-ended-or-quit)
    (-> this events-started)
    )
  (compute-ratio-stat!
    (-> this track-events-won-pct)
    (the-as (pointer int32) arg0)
    (-> this track-events-won)
    (-> this track-events-played)
    )
  (compute-ratio-stat!
    (-> this arena-events-won-pct)
    (the-as (pointer int32) arg0)
    (-> this arena-events-won)
    (-> this arena-events-played)
    )
  (compute-ratio-stat!
    (-> this track-events-top-three-pct)
    (the-as (pointer int32) arg0)
    (-> this track-events-top-three)
    (-> this track-events-played)
    )
  (compute-ratio-stat!
    (-> this arena-events-top-three-pct)
    (the-as (pointer int32) arg0)
    (-> this arena-events-top-three)
    (-> this arena-events-played)
    )
  (compute-ratio-stat!
    (-> this human-kills-per-minute)
    (the-as (pointer int32) arg0)
    (-> this human-kills)
    (-> this time-spent-playing)
    )
  (compute-ratio-stat!
    (-> this cpu-kills-per-minute)
    (the-as (pointer int32) arg0)
    (-> this cpu-kills)
    (-> this time-spent-playing)
    )
  (compute-ratio-stat!
    (-> this deaths-per-minute)
    (the-as (pointer int32) arg0)
    (-> this deaths)
    (-> this time-spent-playing)
    )
  (none)
  )

;; definition for method 9 of type net-clan-ladder-stats-info
;; WARN: Return type mismatch symbol vs none.
(defmethod init-stats! ((this net-clan-ladder-stats-info) (arg0 net-clan-ladder-stats))
  (dotimes (v1-0 (-> *net-clan-ladder-stats-info-array* length))
    (set! (-> (the-as (pointer int32) (+ (the-as uint arg0) (* v1-0 4))))
          (-> *net-clan-ladder-stats-info-array* v1-0 init)
          )
    )
  (none)
  )

;; definition for method 10 of type net-clan-ladder-stats-info
;; WARN: Return type mismatch int vs none.
(defmethod update-computed-stats! ((this net-clan-ladder-stats-info) (arg0 net-clan-ladder-stats))
  (compute-ratio-stat!
    (-> this events-won-pct)
    (the-as (pointer int32) arg0)
    (-> this events-won)
    (-> this events-played)
    )
  (compute-ratio-stat!
    (-> this events-lost-pct)
    (the-as (pointer int32) arg0)
    (-> this events-lost)
    (-> this events-played)
    )
  (compute-ratio-stat!
    (-> this events-drawn-pct)
    (the-as (pointer int32) arg0)
    (-> this events-drawn)
    (-> this events-played)
    )
  0
  (none)
  )

;; definition for function get-skill-level
;; WARN: Return type mismatch uint vs int.
(defun get-skill-level ((arg0 net-player-ladder-stats))
  (the-as int (-> arg0 events-started))

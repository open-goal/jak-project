;; definition for method 3 of type net-player-ladder-stats-info
(defmethod inspect ((this net-player-ladder-stats-info))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'net-player-ladder-stats-info)

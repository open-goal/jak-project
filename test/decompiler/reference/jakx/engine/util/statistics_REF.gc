;; definition for symbol *net-player-ladder-stats-info*, type net-player-ladder-stats-info
(define *net-player-ladder-stats-info*
  (the-as net-player-ladder-stats-info (-> *net-player-ladder-stats-info-array* data))
  )

;; definition of type net-clan-ladder-stats
(deftype net-clan-ladder-stats (structure)
  ((version           uint32)
   (overall-score     uint32)
   (events-played     uint32)
   (events-won        uint32)
   (events-won-pct    uint32)
   (events-lost       uint32)
   (events-lost-pct   uint32)
   (events-drawn      uint32)
   (events-drawn-pct  uint32)
   )
  )

;; definition for method 3 of type net-clan-ladder-stats
(defmethod inspect ((this net-clan-ladder-stats))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'net-clan-ladder-stats)
  (format #t "~1Tversion: ~D~%" (-> this version))
  (format #t "~1Toverall-score: ~D~%" (-> this overall-score))
  (format #t "~1Tevents-played: ~D~%" (-> this events-played))
  (format #t "~1Tevents-won: ~D~%" (-> this events-won))
  (format #t "~1Tevents-won-pct: ~D~%" (-> this events-won-pct))
  (format #t "~1Tevents-lost: ~D~%" (-> this events-lost))
  (format #t "~1Tevents-lost-pct: ~D~%" (-> this events-lost-pct))
  (format #t "~1Tevents-drawn: ~D~%" (-> this events-drawn))
  (format #t "~1Tevents-drawn-pct: ~D~%" (-> this events-drawn-pct))
  (label cfg-4)
  this
  )

;; definition of type net-clan-ladder-stats-info
(deftype net-clan-ladder-stats-info (structure)
  ((version           stat-info)
   (overall-score     stat-info)
   (events-played     stat-info)
   (events-won        stat-info)
   (events-won-pct    stat-info)
   (events-lost       stat-info)
   (events-lost-pct   stat-info)
   (events-drawn      stat-info)
   (events-drawn-pct  stat-info)
   )
  (:methods
    (init-stats! (_type_ net-clan-ladder-stats) none)
    (update-computed-stats! (_type_ net-clan-ladder-stats) none)
    )
  )

;; definition for method 3 of type net-clan-ladder-stats-info
(defmethod inspect ((this net-clan-ladder-stats-info))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'net-clan-ladder-stats-info)
  (format #t "~1Tversion: #<stat-info @ #x~X>~%" (-> this version))
  (format #t "~1Toverall-score: #<stat-info @ #x~X>~%" (-> this overall-score))
  (format #t "~1Tevents-played: #<stat-info @ #x~X>~%" (-> this events-played))
  (format #t "~1Tevents-won: #<stat-info @ #x~X>~%" (-> this events-won))
  (format #t "~1Tevents-won-pct: #<stat-info @ #x~X>~%" (-> this events-won-pct))
  (format #t "~1Tevents-lost: #<stat-info @ #x~X>~%" (-> this events-lost))
  (format #t "~1Tevents-lost-pct: #<stat-info @ #x~X>~%" (-> this events-lost-pct))
  (format #t "~1Tevents-drawn: #<stat-info @ #x~X>~%" (-> this events-drawn))
  (format #t "~1Tevents-drawn-pct: #<stat-info @ #x~X>~%" (-> this events-drawn-pct))
  (label cfg-4)
  this
  )


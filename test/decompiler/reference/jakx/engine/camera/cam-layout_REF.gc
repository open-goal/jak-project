        (.add.vf.xyz vf6 vf4 vf5)
        (.svf (&-> a1-2 quad) vf6)
        )
      (dotimes (s2-0 10)
        (set! (-> s5-0 quad) (-> s3-0 quad))
        (arg0 s3-0 (-> arg1 from) (-> arg1 to) (* 0.1 (+ 1.0 (the float s2-0))) (-> arg1 axis) 65536.0)
        (let ((a1-4 s3-0))
          (let ((v1-4 s3-0)
                (a0-6 (-> arg1 origin))
                )

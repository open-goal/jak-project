;; definition for method 10 of type crash-camera
;; INFO: Used lq/sq
(defmethod crash-camera-method-10 ((this crash-camera) (arg0 float) (arg1 float))
  (let ((gp-0 (new 'stack-no-clear 'collide-query)))
    (set! (-> gp-0 start-pos quad)
          (-> (cond
                ((-> *target-camera-runtime* active)
                 (let ((v1-4 (the-as process-drawable (handle->process (-> *target-camera-runtime* shot)))))

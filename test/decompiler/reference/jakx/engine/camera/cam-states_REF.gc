        (-> (cond
              ((-> *target-camera-runtime* active)
               (let ((v1-8 (the-as process-drawable (handle->process (-> *target-camera-runtime* shot)))))
                 (if v1-8
                     (-> v1-8 root trans)
                     (-> (the-as camera-master (view-get-active-camera)) tpos-curr)
                     )
                 )
               )
              (else
                (-> (the-as camera-master (view-get-active-camera)) tpos-curr)

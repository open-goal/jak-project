;; definition for function choose-victor-prefix-camera
;; INFO: Used lq/sq
(defbehavior choose-victor-prefix-camera camera-slave ()
  (when *crash-camera-force-position-valid*
    (set! *crash-camera-force-position-valid* #f)
    (set! (-> *plow-camera* (view-get-active-index) world-position quad) (-> *crash-camera-force-position* quad))
    (return (-> *plow-camera* (view-get-active-index)))
    )
  (let* ((gp-0 *victor-prefix-camera-array*)
         (s5-0 (-> gp-0 length))
         )
    0.0
    (let ((s4-0 (view-get-active-index)))
      (zero? crash-camera)
      (dotimes (s3-0 s5-0)
        (crash-camera-method-13 (-> gp-0 s3-0 s4-0) self #f (-> self tracking))
        )
      (let ((f30-0 0.0))
        (dotimes (v1-17 s5-0)
          (if (>= (-> gp-0 v1-17 s4-0 rating) f30-0)
              (set! f30-0 (-> gp-0 v1-17 s4-0 rating))
              )
          )
        (if (= 0.0 f30-0)
            (return (the-as crash-camera #f))
            )
        (let ((f28-0 0.0))
          (dotimes (v1-22 s5-0)
            (if (= (-> gp-0 v1-22 s4-0 rating) f30-0)
                (+! f28-0 (-> gp-0 v1-22 s4-0 likelyhood))
                )
            )
          (let* ((v1-26 (/ (the-as int (rand-uint31-gen *random-generator*)) 256))
                 (v1-27 (the-as number (logior #x3f800000 v1-26)))
                 (f0-8 (* (+ -1.0 (the-as float v1-27)) f28-0))
                 )
            (dotimes (v1-29 s5-0)
              (when (= (-> gp-0 v1-29 s4-0 rating) f30-0)
                (set! f0-8 (- f0-8 (-> gp-0 v1-29 s4-0 likelyhood)))
                (if (>= 0.0 f0-8)
                    (return (-> gp-0 v1-29 s4-0))
                    )
                )
              )
            )
          )
        )
      )
    )
  (the-as crash-camera #f)
  )

;; definition for method 11 of type victor-prefix-camera
(defmethod crash-camera-method-11 ((this victor-prefix-camera) (arg0 matrix))
  (let ((f30-0 (the-as number (crash-camera-method-10 this 8192.0 1.0))))
    (cond
      (arg0
        (let ((s4-0 (new 'stack-no-clear 'vector)))
          (vector-!
            (the-as vector (&-> s4-0 x))
            (cond
              ((-> *target-camera-runtime* active)
               (let ((v1-6 (the-as process-drawable (handle->process (-> *target-camera-runtime* shot)))))
                 (if v1-6
                     (-> v1-6 root trans)
                     (-> (the-as camera-master (view-get-active-camera)) tpos-curr)
                     )
                 )
               )
              (else
                (-> (the-as camera-master (view-get-active-camera)) tpos-curr)
                )
              )
            (-> this world-position)
            )
          (vector-normalize! (the-as vector (&-> s4-0 x)) 1.0)
          (let ((f28-0 (vector-dot (the-as vector (&-> s4-0 x)) (-> arg0 fvec))))
            (set! f30-0 (+ (the-as float f30-0) (/ f28-0 2)))
            (if (< (cos 16384.0) f28-0)
                (set! f30-0 (+ -0.5 (the-as float f30-0)))
                )
            )
          )
        (if (zero? (-> this camera-type))
            (set! f30-0 0.0011)
            )
        )
      (else
        (if (= (-> this camera-type) 1)
            (set! f30-0 (* 0.4 (the-as float f30-0)))
            )
        (if (zero? (-> this camera-type))
            (set! f30-0 0.0001)
            )
        )
      )
    (if (not (crash-camera-method-18 this))
        (set! f30-0 0.0)
        )
    (the-as float f30-0)
    )
  )

;; definition of type target-camera
(deftype target-camera (basic)
  ((offset-mode    symbol)
   (behind-offset  float)
   (up-offset      float)
   (perp-offset    float)
   (look-at-along  float)
   (fov            float)
   (flags          target-camera-flag)
   )
  (:methods
    (target-camera-method-9 (_type_ camera-slave process-focusable process-focusable) none)
    (target-camera-method-10 (_type_ process-focusable process-focusable vector object) float)
    )
  )

;; definition for method 3 of type target-camera
(defmethod inspect ((this target-camera))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this (-> this type))
  (format #t "~1Toffset-mode: ~A~%" (-> this offset-mode))
  (format #t "~1Tbehind-offset: ~f~%" (-> this behind-offset))
  (format #t "~1Tup-offset: ~f~%" (-> this up-offset))
  (format #t "~1Tperp-offset: ~f~%" (-> this perp-offset))
  (format #t "~1Tlook-at-along: ~f~%" (-> this look-at-along))
  (format #t "~1Tfov: ~f~%" (-> this fov))
  (format #t "~1Tflags: ~D~%" (-> this flags))
  (label cfg-4)
  this
  )

;; definition for function target-camera-active?

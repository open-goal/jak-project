(defmethod copy-crash-cam! ((this crash-camera) (arg0 crash-camera))
  (set! (-> this start-time) (the-as int (current-time)))
  (cond
    (arg0
      (set! (-> this last-car-visible-time) (-> arg0 last-car-visible-time))
      )
    (else
      (set! (-> this last-car-visible-time) 0)

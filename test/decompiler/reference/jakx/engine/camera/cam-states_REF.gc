;; failed to figure out what this is:
(defstate cam-vehicle (camera-slave)
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('teleport)
       (set! (-> self vehicle-up quad) (-> (the-as camera-master (view-get-active-camera)) tgt-rot-mat uvec quad))
       (set! (-> self vehicle-at quad) (-> (the-as camera-master (view-get-active-camera)) tgt-rot-mat fvec quad))
       (set! (-> self view-flat quad) (-> (the-as camera-master (view-get-active-camera)) tgt-rot-mat fvec quad))
       (tracking-spline-method-10
         (-> self position-spline)
         (-> (the-as camera-master (view-get-active-camera)) tpos-curr)
         )
       (let ((gp-4 (the-as object (-> self string-trans))))
         (set! (-> (the-as vector gp-4) quad) (-> (the-as camera-master (view-get-active-camera)) tpos-curr quad))
         gp-4
         )
       )
      (else
        (cam-standard-event-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (set! (-> self vehicle-up quad) (-> (the-as camera-master (view-get-active-camera)) tgt-rot-mat uvec quad))
    (set! (-> self vehicle-at quad) (-> (the-as camera-master (view-get-active-camera)) tgt-rot-mat fvec quad))
    (set! (-> self view-flat quad) (-> (the-as camera-master (view-get-active-camera)) tgt-rot-mat fvec quad))
    (let ((gp-3 (new 'stack-no-clear 'inline-array 'vector 1)))
      (set! (-> gp-3 0 quad) (-> (the-as camera-master (view-get-active-camera)) tpos-curr quad))
      (vector+*!
        (-> gp-3 0)
        (-> gp-3 0)
        (-> self view-flat)
        (- (-> (the-as camera-master (view-get-active-camera)) string-max target z))
        )
      (vector+*!
        (-> gp-3 0)
        (-> gp-3 0)
        (-> (the-as camera-master (view-get-active-camera)) tgt-rot-mat uvec)
        (-> (the-as camera-master (view-get-active-camera)) string-max target y)
        )
      (set! (-> self string-trans quad) (-> gp-3 0 quad))
      (tracking-spline-method-10 (-> self position-spline) (-> gp-3 0))
      )
    (when (not (-> self enter-has-run))
      (set! (-> self saved-pt quad) (-> self trans quad))
      (set! (-> self blend-from-type) (camera-blend-from-type unknown-1))
      (set! (-> self blend-to-type) (camera-blend-to-type unknown-0))
      0
      )
    (cam-vehicle-update)
    )
  :code (behavior ()
    (until #f
      (when (not (paused?))
        (cam-vehicle-update)
        (tracking-spline-method-9 (-> self position-spline))
        )
      (suspend)
      )
    #f
    )
  )

;; definition of type target-camera-runtime-info
(deftype target-camera-runtime-info (structure)
  ((active                 symbol)
   (shot                   handle)
   (mirror                 symbol)
   (need-new-cam           symbol)
   (prefix                 string)
   (interp                 float)
   (last-good-los          int32)
   (cur-cam-idx            int8)
   (num-camera-changes     int8)
   (cur-trans              vector      :inline)
   (cur-quat               quaternion  :inline)
   (interp-from-trans      vector      :inline)
   (interp-from-quat       quaternion  :inline)
   (vehicle-release-timer  handle)
   (state-time             time-frame)
   )
  )

;; definition for method 3 of type target-camera-runtime-info
(defmethod inspect ((this target-camera-runtime-info))
  (when (not this)

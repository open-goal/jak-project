;; definition for method 3 of type vehicle-AI-control-timer
(defmethod inspect ((this vehicle-AI-control-timer))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type process inspect)))
    (t9-0 this)
    )
  (format #t "~2Ttimeout: ~D~%" (-> this timeout))
  (format #t "~2Tveh: ~D~%" (-> this veh))
  (format #t "~2Tcam-timer: ~f~%" (-> this cam-timer))
  (label cfg-4)
  this
  )

;; definition for function vehicle-AI-control-timer-init-by-other
(defbehavior vehicle-AI-control-timer-init-by-other vehicle-AI-control-timer ((arg0 handle) (arg1 int) (arg2 float))
  (stack-size-set! (-> self main-thread) 32)
  (set! (-> self veh) arg0)
  (set! (-> self timeout) arg1)
  (set! (-> self cam-timer) arg2)
  (set-setting! 'letterbox 'abs 1.0 0)
  (go-virtual idle)
  )

;; failed to figure out what this is:
(defstate idle (vehicle-AI-control-timer)
  :virtual #t
  :enter (behavior ()
    '()
    )
  :exit (behavior ()
    (send-event (the-as vehicle (handle->process (-> self veh))) 'go 'player-control)
    )
  :trans (behavior ()
    (if (or (not (the-as vehicle (handle->process (-> self veh))))
            (< (-> self timeout) (- (- (if *net-mgr*
                                           (-> *net-mgr* game-state time)
                                           0
                                           )
                                       (if *net-world*
                                           (-> *net-world* net-state game-start-time)
                                           0
                                           )
                                       )
                                    (if *net-world*
                                        (-> *net-world* net-state total-pause-time)
                                        0
                                        )
                                    )
               )
            )
        (go empty-state)
        )
    (let ((v1-9 (- (-> self timeout) (- (- (if *net-mgr*
                                               (-> *net-mgr* game-state time)
                                               0
                                               )
                                           (if *net-world*
                                               (-> *net-world* net-state game-start-time)
                                               0
                                               )
                                           )
                                        (if *net-world*
                                            (-> *net-world* net-state total-pause-time)
                                            0
                                            )
                                        )
                   )
                )
          )
      (if (< v1-9 300)
          (set-setting! 'letterbox 'abs (* 0.0033333334 (the float v1-9)) 0)
          )
      )
    )
  :code sleep-code
  )


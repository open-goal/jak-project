;; definition for symbol *crash-camera-force-position*, type vector
(define *crash-camera-force-position* (new 'static 'vector :w 1.0))

;; definition for symbol *crash-camera-force-position-valid*, type symbol
(define *crash-camera-force-position-valid* #f)

;; definition for symbol *target-time-speed*, type float
(define *target-time-speed* 1.0)

;; definition for function target-time-go-slow
(defun target-time-go-slow ((arg0 float) (arg1 symbol))
  (when (and (zero? (-> *viewport-array* mode)) (= (-> *net-mgr* game-type) 4))
    (set! (-> *display* entity-clock clock-ratio) arg0)
    (set! (-> *display* camera-clock clock-ratio) arg0)
    (set! (-> *display* bg-clock clock-ratio) arg0)
    (set! *target-time-speed* arg0)
    (if arg1
        (spawn-hud-slowmo)
        )
    )
  )

;; definition for function target-time-go-normal
;; WARN: Return type mismatch symbol vs object.
(defun target-time-go-normal ()
  (set! (-> *display* entity-clock clock-ratio) 1.0)
  (set! (-> *display* camera-clock clock-ratio) 1.0)
  (set! (-> *display* bg-clock clock-ratio) 1.0)
  (set! *target-time-speed* 1.0)
  (kill-by-type hud-slowmo *active-pool*)
  )

;; definition for symbol *plow-camera*, type (array crash-camera)
(define *plow-camera* (new 'static 'boxed-array :type crash-camera
                        (new 'static 'crash-camera
                          :camera-type #x2
                          :offset (new 'static 'vector :w 1.0)
                          :follow 0.8
                          :percent-delta-y-move 0.3
                          :diverge-distance 40960.0
                          :zoom-factor 0.5
                          :likelyhood 0.5
                          :group 3
                          :allow-shake? #f
                          )
                        (new 'static 'crash-camera
                          :camera-type #x2
                          :offset (new 'static 'vector :w 1.0)
                          :follow 0.8
                          :percent-delta-y-move 0.3
                          :diverge-distance 40960.0
                          :zoom-factor 0.5
                          :likelyhood 0.5
                          :group 3
                          :allow-shake? #f
                          )
                        )
        )

;; definition for function choose-crash-camera
;; INFO: Used lq/sq
(defbehavior choose-crash-camera camera-slave ((arg0 crash-camera) (arg1 symbol))
  (when *crash-camera-force-position-valid*
    (set! *crash-camera-force-position-valid* #f)
    (crash-camera-method-13
      (-> *plow-camera* (view-get-active-index))
      self
      (the-as symbol arg0)
      (the-as cam-rotation-tracker #f)
      )
    (set! (-> *plow-camera* (view-get-active-index) world-position quad) (-> *crash-camera-force-position* quad))
    (return (-> *plow-camera* (view-get-active-index)))
    )
  (let ((s5-0 (-> *crash-camera-array* length)))
    0.0
    (let ((gp-0 (view-get-active-index)))
      (zero? crash-camera)
      (set! arg0 (cond
                   ((nonzero? arg0)
                    (empty)
                    arg0
                    )
                   (else
                     (the-as crash-camera #f)
                     )
                   )
            )
      (dotimes (s2-0 s5-0)
        (crash-camera-method-13
          (-> *crash-camera-array* s2-0 gp-0)
          self
          (the-as symbol arg0)
          (the-as cam-rotation-tracker #f)
          )
        )
      (let ((f30-0 0.0))
        (dotimes (v1-22 s5-0)
          (if (>= (-> *crash-camera-array* v1-22 gp-0 rating) f30-0)
              (set! f30-0 (-> *crash-camera-array* v1-22 gp-0 rating))
              )
          )
        (when (or (= 0.0 f30-0) arg1)
          (set! (-> *freeze-camera* gp-0 force-freeze) arg1)
          (set! (-> *freeze-camera* gp-0 world-position quad) (-> self trans quad))
          (set! (-> *freeze-camera* gp-0 sparks-reset-in) -1)
          (return (-> *freeze-camera* gp-0))
          )
        (let ((f28-0 0.0))
          (dotimes (v1-40 s5-0)
            (if (= (-> *crash-camera-array* v1-40 gp-0 rating) f30-0)
                (+! f28-0 (-> *crash-camera-array* v1-40 gp-0 likelyhood))
                )
            )
          (let* ((v1-44 (/ (the-as int (rand-uint31-gen *random-generator*)) 256))
                 (v1-45 (the-as number (logior #x3f800000 v1-44)))
                 (f0-8 (* (+ -1.0 (the-as float v1-45)) f28-0))
                 )
            (dotimes (v1-47 s5-0)
              (when (= (-> *crash-camera-array* v1-47 gp-0 rating) f30-0)
                (set! f0-8 (- f0-8 (-> *crash-camera-array* v1-47 gp-0 likelyhood)))
                (if (>= 0.0 f0-8)
                    (return (-> *crash-camera-array* v1-47 gp-0))
                    )
                )
              )
            )
          )
        )
      )
    )
  (the-as crash-camera #f)
  )

;; failed to figure out what this is:
(defstate cam-vehicle-crash (camera-slave)
  :enter (behavior ()
    (if (-> *setting-control* user-default crash-cam)
        (target-time-go-slow 0.25 #t)
        )
    (set! (-> self fov) 10922.667)
    (let ((a1-1 (handle->process (-> (the-as camera-master (view-get-active-camera)) focus handle))))
      (when a1-1
        (let ((gp-1 (add-process *gui-control* a1-1 (gui-channel background) (gui-action play) "crshwall" -99.0 0)))
          (sound-params-set! *gui-control* gp-1 #f -1.0 -1.0 1.0 0.5 #t)
          (set! (-> self slow-mo-sound-id) (the-as uint gp-1))
          )
        )
      )
    (set! (-> self vehicle-up quad) (-> (the-as camera-master (view-get-active-camera)) tgt-rot-mat uvec quad))
    (set! (-> self vehicle-at quad) (-> (the-as camera-master (view-get-active-camera)) tgt-rot-mat fvec quad))
    (when (not (-> self enter-has-run))
      (set! (-> self blend-from-type) (camera-blend-from-type unknown-1))
      (set! (-> self blend-to-type) (camera-blend-to-type unknown-0))
      0
      )
    (if (-> (the-as camera-master (view-get-active-camera)) focus handle)
        (send-event
          (handle->process (-> (the-as camera-master (view-get-active-camera)) focus handle))
          'set
          'force-lod
          0
          )
        )
    (if (zero? (-> *viewport-array* mode))
        (set-setting! 'letterbox 'abs 0.01 0)
        )
    )
  :exit (behavior ()
    (set! *teleport* #t)
    (remove-setting! 'letterbox)
    (target-time-go-normal)
    )
  :trans (behavior ()
    (when (= (-> *net-mgr* game-type) 4)
      (when (cpad-pressed? (view-get-active-index) x)
        (set! *target-time-speed* 1.0)
        (kill-by-type hud-slowmo *active-pool*)
        (set-action!
          *gui-control*
          (gui-action stop)
          (the-as sound-id (-> self slow-mo-sound-id))
          (gui-channel none)
          (gui-action none)
          (the-as string #f)
          (the-as (function gui-connection symbol) #f)
          (the-as process #f)
          )
        )
      (+! (-> *display* entity-clock clock-ratio)
          (* 0.1 (- *target-time-speed* (-> *display* entity-clock clock-ratio)))
          )
      (+! (-> *display* camera-clock clock-ratio)
          (* 0.1 (- *target-time-speed* (-> *display* camera-clock clock-ratio)))
          )
      (+! (-> *display* bg-clock clock-ratio) (* 0.1 (- *target-time-speed* (-> *display* bg-clock clock-ratio))))
      )
    )
  :code (behavior ()
    (let ((gp-0 (new 'stack-no-clear 'inline-array 'vector 1)))
      (set! (-> gp-0 0 quad)
            (-> (cond
                  ((-> *target-camera-runtime* active)
                   (let ((v1-4 (the-as process-drawable (handle->process (-> *target-camera-runtime* shot)))))
                     (if v1-4
                         (-> v1-4 root trans)
                         (-> (the-as camera-master (view-get-active-camera)) tpos-curr)
                         )
                     )
                   )
                  (else
                    (-> (the-as camera-master (view-get-active-camera)) tpos-curr)
                    )
                  )
                quad
                )
            )
      #t
      (let ((s5-1 (the-as crash-camera #f))
            (s4-1 (-> *setting-control* cam-settings (view-get-active-index) current crash-cam-force-freeze))
            )
        (set! *teleport* #t)
        (until #f
          (when (not (and (handle->process (-> (the-as camera-master (view-get-active-camera)) focus handle))
                          (type? (handle->process (-> (the-as camera-master (view-get-active-camera)) focus handle)) vehicle)
                          )
                     )
            (until #f
              (suspend)
              )
            #f
            )
          (let ((s3-1 (choose-crash-camera s5-1 s4-1)))
            (copy-crash-cam! s3-1 s5-1)
            (set! s5-1 s3-1)
            (suspend-for (+ (mod (the-as int (rand-uint31-gen *random-generator*)) 301) 450)
              (set! s4-1
                    (or s4-1 (-> *setting-control* cam-settings (view-get-active-index) current crash-cam-force-freeze))
                    )
              (if (and (crash-camera-method-15 s3-1) (not s4-1))
                  (goto cfg-40)
                  )
              (crash-camera-method-12 s3-1 self (-> gp-0 0))
              )
            )
          (label cfg-40)
          (suspend)
          (set! *teleport* #t)
          )
        )
      )
    #f
    )
  )

;; definition for symbol *camera-training-lifetime*, type float
(define *camera-training-lifetime* 0.0)

;; definition for function set-training-camera-lifetime
;; WARN: Return type mismatch int vs object.
(defun set-training-camera-lifetime ((arg0 float))
  (set! *camera-training-lifetime* arg0)
  0
  )

;; failed to figure out what this is:
(defstate cam-training (camera-slave)
  :enter (behavior ()
    (set! (-> self blend-from-type) (camera-blend-from-type unknown-1))
    (set! (-> self blend-to-type) (camera-blend-to-type unknown-0))
    (set! *target-time-speed* 0.001)
    )
  :exit (behavior ()
    (set! *target-time-speed* 1.0)
    )
  :code (behavior ()
    (let ((gp-0 (new 'stack-no-clear 'inline-array 'vector 5)))
      (set! (-> gp-0 0 quad) (-> (the-as camera-master (view-get-active-camera)) tpos-curr quad))
      (+! (-> gp-0 0 y) 8192.0)
      (let* ((a2-0 (the-as matrix (-> gp-0 1)))
             (a3-0 (-> self tracking))
             (v1-3 (-> a3-0 inv-mat rvec quad))
             (a0-0 (-> a3-0 inv-mat uvec quad))
             (a1-0 (-> a3-0 inv-mat fvec quad))
             (a3-1 (-> a3-0 inv-mat trans quad))
             )
        (set! (-> a2-0 rvec quad) v1-3)
        (set! (-> a2-0 uvec quad) a0-0)
        (set! (-> a2-0 fvec quad) a1-0)
        (set! (-> a2-0 trans quad) a3-1)
        )
      (let ((f30-0 (vector-vector-distance (-> gp-0 0) (-> self trans)))
            (s5-1 (current-time))
            )
        0.0
        (let* ((f28-0 32768.0)
               (f0-3 *camera-training-lifetime*)
               (f26-0 32768.0)
               (f24-0 (- (/ (* 2.0 f28-0) (square f0-3))))
               (f22-0 (- (* f24-0 f0-3)))
               )
          (until #f
            (let ((s4-0 (new 'stack-no-clear 'inline-array 'matrix 1))
                  (f20-0 (* 0.0033333334 (the float (- (current-time) s5-1))))
                  )
              (let ((f0-10 (+ (* 0.5 (square f20-0) f24-0) (* f22-0 f20-0) f26-0)))
                (+! f28-0 (* 0.1 (- f0-10 f28-0)))
                )
              (matrix-rotate-y! (-> s4-0 0) f28-0)
              (matrix*! (-> self tracking inv-mat) (the-as matrix (-> gp-0 1)) (-> s4-0 0))
              (vector+float*!
                (-> self trans)
                (-> gp-0 0)
                (-> self tracking inv-mat fvec)
                (- (lerp-scale 20480.0 f30-0 f20-0 0.0 *camera-training-lifetime*))
                )
              )
            (suspend)
            )
          )
        )
      )
    #f
    )
  )

;; definition of type victor-prefix-camera
(deftype victor-prefix-camera (crash-camera)
  ()
  )

;; definition for method 3 of type victor-prefix-camera
(defmethod inspect ((this victor-prefix-camera))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this (-> this type))
  (format #t "~1Tcamera-type: ~D~%" (-> this camera-type))
  (format #t "~1Tworld-position: #<vector @ #x~X>~%" (-> this world-position))
  (format #t "~1Tlast-target-position: #<vector @ #x~X>~%" (-> this last-target-position))
  (format #t "~1Trating: ~f~%" (-> this rating))
  (format #t "~1Tmaster-mult: ~f~%" (-> this master-mult))
  (format #t "~1Toffset: #<vector @ #x~X>~%" (-> this offset))
  (format #t "~1Tfollow: ~f~%" (-> this follow))
  (format #t "~1Tpercent-delta-y-move: ~f~%" (-> this percent-delta-y-move))
  (format #t "~1Tdiverge-distance: ~f~%" (-> this diverge-distance))
  (format #t "~1Tzoom-factor: ~f~%" (-> this zoom-factor))
  (format #t "~1Tstart-time: ~D~%" (-> this start-time))
  (format #t "~1Tsparks-reset-in: ~D~%" (-> this sparks-reset-in))
  (format #t "~1Tcamera-rotation: ~f~%" (-> this camera-rotation))
  (format #t "~1Tlikelyhood: ~f~%" (-> this likelyhood))
  (format #t "~1Tgroup: ~D~%" (-> this group))
  (format #t "~1Tcamera-valid?: ~A~%" (-> this camera-valid?))
  (format #t "~1Tallow-shake?: ~A~%" (-> this allow-shake?))
  (format #t "~1Tlast-visible-check-time: ~D~%" (-> this last-visible-check-time))
  (format #t "~1Tlast-car-visible-time: ~D~%" (-> this last-car-visible-time))
  (format #t "~1Tforce-cut: ~A~%" (-> this force-cut))
  (format #t "~1Tforce-freeze: ~A~%" (-> this force-freeze))
  (label cfg-4)
  this
  )


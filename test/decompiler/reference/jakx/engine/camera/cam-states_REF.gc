;; definition for method 15 of type crash-camera
(defmethod crash-camera-method-15 ((this crash-camera))
  (when (-> this force-cut)
    (set! (-> this force-cut) #f)
    (return #t)
    )
  (if (not (time-elapsed? (the-as time-frame (-> this start-time)) (seconds 0.5)))
      (return #f)
      )
  (not (crash-camera-method-17 this #t))
  )

;; definition for method 17 of type crash-camera
(defmethod crash-camera-method-17 ((this crash-camera) (arg0 symbol))
  (set! (-> this camera-valid?) #t)
  (when (or (< (+ -40960.0 (-> this world-position y))
               (-> (the-as camera-master (view-get-active-camera)) settings string-camera-floor)
               )
            (< (-> (the-as camera-master (view-get-active-camera)) settings string-camera-ceiling)
               (+ 40960.0 (-> this world-position y))
               )
            )
    (set! (-> this camera-valid?) #f)
    (return #f)
    )
  (when (not (crash-camera-method-18 this))
    (set! (-> this camera-valid?) #f)
    (return #f)
    )
  (when (not (crash-camera-method-16 this arg0))
    (set! (-> this camera-valid?) #f)
    (return #f)
    )
  (-> this camera-valid?)
  )

;; definition for method 16 of type crash-camera
(defmethod crash-camera-method-16 ((this crash-camera) (arg0 symbol))
  (cond
    ((!= (-> this last-visible-check-time) (current-time))
     (set! (-> this last-visible-check-time) (the-as int (current-time)))
     (if (= 1.0 (crash-camera-method-10 this 8192.0 0.98))
         (set! (-> this last-car-visible-time) (the-as int (current-time)))
         )
     )
    (arg0
      (return (= 1.0 (crash-camera-method-10 this 8192.0 0.98)))
      )
    )
  (not (time-elapsed? (the-as time-frame (-> this last-car-visible-time)) (seconds 0.25)))
  )

;; definition for method 11 of type crash-camera

                       (let* ((f0-1 (-> arg0 interp))
                              (f1-1 (square f0-1))
                              (f0-2 (* f0-1 f1-1))
                              (f30-0 (- (* 3.0 f1-1) (* 2.0 f0-2)))
                              )
                         (vector-lerp! (-> arg1 trans) (-> arg0 interp-from-trans) (-> arg0 cur-trans) f30-0)
                         (quaternion-slerp! s4-0 (-> arg0 interp-from-quat) (-> arg0 cur-quat) f30-0)
                         )
                       (quaternion->matrix (-> arg1 tracking inv-mat) s4-0)
                       )
                     )
                   )
          )
  )


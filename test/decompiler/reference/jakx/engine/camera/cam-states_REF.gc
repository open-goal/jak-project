;; INFO: Used lq/sq
;; WARN: Return type mismatch vector vs none.
(defmethod crash-camera-method-12 ((this crash-camera) (arg0 camera-slave) (arg1 vector))
  (crash-camera-method-9 this)
  (let ((s4-0 (cond
                ((-> *target-camera-runtime* active)
                 (let ((v1-6 (the-as process-drawable (handle->process (-> *target-camera-runtime* shot)))))
                   (if v1-6
                       (-> v1-6 root trans)
                       (-> (the-as camera-master (view-get-active-camera)) tpos-curr)
                       )
                   )
                 )
                (else
                  (-> (the-as camera-master (view-get-active-camera)) tpos-curr)
                  )
                )
              )
        )
    (let ((s0-0 (-> this last-target-position)))
      (when (crash-camera-method-16 this #f)
        (let ((f28-0 (vector-vector-distance (-> arg0 trans) s4-0))
              (f30-0 (vector-vector-distance arg1 s4-0))
              (s3-0 (new 'stack-no-clear 'vector))
              )
          (when (and (not (or (-> this force-freeze)
                              (-> *setting-control* cam-settings (view-get-active-index) current crash-cam-force-freeze)
                              )
                          )
                     (crash-camera-method-17 this #f)
                     )
            (let ((s1-1 (new 'stack-no-clear 'vector)))
              (vector-! s1-1 s4-0 s0-0)
              (set! (-> s1-1 y) (* (-> s1-1 y) (-> this percent-delta-y-move)))
              (let ((v1-20 (new 'stack-no-clear 'vector)))
                (vector-! v1-20 (-> arg0 trans) s4-0)
                (set! (-> v1-20 y) 0.0)
                (let* ((f0-3 (vector-length v1-20))
                       (f0-4 (lerp-scale (-> this follow) 1.0 f0-3 102400.0 40960.0))
                       )
                  (vector+float*! (-> this world-position) (-> this world-position) s1-1 f0-4)
                  )
                )
              )
            )
          (+! (-> arg0 fov)
              (* 0.05
                 (+ (- 10922.667 (-> arg0 fov)) (* (-> this zoom-factor) (lerp-scale 0.0 -4551.1113 f28-0 122880.0 409600.0)))
                 )
              )
          (vector-lerp! s3-0 arg1 s4-0 (- 1.0 (fmin 1.0 (/ (-> this diverge-distance) f30-0))))
          (let ((s2-1 (new 'stack-no-clear 'inline-array 'quaternion 2)))
            (vector-! (-> s2-1 1 vec) s3-0 (-> this world-position))
            (let ((f30-1 (vector-normalize-ret-len! (-> s2-1 1 vec) 1.0)))
              (quaternion-look-at! (-> s2-1 0) (-> s2-1 1 vec) *up-vector*)
              (if (crash-camera-method-17 this #f)
                  (quaternion-rotate-y! (-> s2-1 0) (-> s2-1 0) (* 2457600.0 (-> this camera-rotation) (seconds-per-frame)))
                  )
              (quaternion->matrix (-> arg0 tracking inv-mat) (-> s2-1 0))
              (vector+float*! (-> arg0 trans) s3-0 (-> arg0 tracking inv-mat fvec) (- f30-1))
              )
            )
          )
        (set! (-> this world-position quad) (-> arg0 trans quad))
        )
      )
    (set! (-> this last-target-position quad) (-> s4-0 quad))
    )
  (none)
  )

;; definition for method 13 of type crash-camera
;; INFO: Used lq/sq
;; WARN: Return type mismatch float vs none.
(defmethod crash-camera-method-13 ((this crash-camera) (arg0 camera-slave) (arg1 symbol) (arg2 cam-rotation-tracker))
  (set! (-> this force-cut) #f)
  (set! (-> this force-freeze) #f)
  (let ((s5-0 (new 'stack-no-clear 'inline-array 'matrix 1)))
    (let* ((v1-0 (-> s5-0 0))
           (a3-1 (if arg2
                     arg2
                     (-> arg0 tracking)
                     )
                 )
           (a0-1 (-> a3-1 inv-mat rvec quad))
           (a1-1 (-> a3-1 inv-mat uvec quad))
           (a2-1 (-> a3-1 inv-mat fvec quad))
           (a3-2 (-> a3-1 inv-mat trans quad))
           )
      (set! (-> v1-0 rvec quad) a0-1)
      (set! (-> v1-0 uvec quad) a1-1)
      (set! (-> v1-0 fvec quad) a2-1)
      (set! (-> v1-0 trans quad) a3-2)
      )
    (set! (-> s5-0 0 trans quad)
          (-> (cond
                ((-> *target-camera-runtime* active)
                 (let ((v1-5 (the-as process-drawable (handle->process (-> *target-camera-runtime* shot)))))
                   (if v1-5
                       (-> v1-5 root trans)
                       (-> (the-as camera-master (view-get-active-camera)) tpos-curr)
                       )
                   )
                 )
                (else
                  (-> (the-as camera-master (view-get-active-camera)) tpos-curr)
                  )
                )
              quad
              )
          )
    (vector-matrix*! (-> this world-position) (-> this offset) (-> s5-0 0))
    (cond
      (arg2
        (set! (-> this rating) (crash-camera-method-11 this (-> s5-0 0)))
        )
      ((not arg1)
       (set! (-> this rating) (crash-camera-method-11 this (the-as matrix #f)))
       )
      (else
        (set! (-> this rating) (crash-camera-method-11 this (-> s5-0 0)))
        )
      )
    )
  (none)
  )

;; definition for method 9 of type crash-camera
;; WARN: Return type mismatch smush-control vs none.
(defmethod crash-camera-method-9 ((this crash-camera))
  (cond
    ((zero? (view-get-active-index))
     (set-zero! *camera-smush-control*)
     (set-zero! *camera-smush-control-horizontal*)
     )
    (else
      (set-zero! *camera-smush-control-2*)
      (set-zero! *camera-smush-control-horizontal-2*)
      )
    )
  (none)
  )


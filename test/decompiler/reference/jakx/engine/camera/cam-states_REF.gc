    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'target-camera-runtime-info)
  (format #t "~1Tactive: ~A~%" (-> this active))
  (format #t "~1Tshot: ~D~%" (-> this shot))
  (format #t "~1Tmirror: ~A~%" (-> this mirror))
  (format #t "~1Tneed-new-cam: ~A~%" (-> this need-new-cam))
  (format #t "~1Tprefix: ~A~%" (-> this prefix))
  (format #t "~1Tinterp: ~f~%" (-> this interp))
  (format #t "~1Tlast-good-los: ~D~%" (-> this last-good-los))
  (format #t "~1Tcur-cam-idx: ~D~%" (-> this cur-cam-idx))
  (format #t "~1Tnum-camera-changes: ~D~%" (-> this num-camera-changes))
  (format #t "~1Tcur-trans: #<vector @ #x~X>~%" (-> this cur-trans))
  (format #t "~1Tcur-quat: #<quaternion @ #x~X>~%" (-> this cur-quat))
  (format #t "~1Tinterp-from-trans: #<vector @ #x~X>~%" (-> this interp-from-trans))
  (format #t "~1Tinterp-from-quat: #<quaternion @ #x~X>~%" (-> this interp-from-quat))
  (format #t "~1Tvehicle-release-timer: ~D~%" (-> this vehicle-release-timer))
  (format #t "~1Tstate-time: ~D~%" (-> this state-time))
  (label cfg-4)
  this
  )

;; definition for symbol *target-camera-runtime*, type target-camera-runtime-info
(define *target-camera-runtime*
  (new 'static 'target-camera-runtime-info :active #f :mirror #f :need-new-cam #f :prefix #f)
  )

;; failed to figure out what this is:
(set! (-> *target-camera-runtime* shot) (the-as handle #f))

;; failed to figure out what this is:
(set! (-> *target-camera-runtime* vehicle-release-timer) (the-as handle #f))

;; definition for function target-cam-runtime-push
;; INFO: Used lq/sq
;; WARN: Return type mismatch structure vs vector.
(defun target-cam-runtime-push ((arg0 target-camera-runtime-info) (arg1 camera-slave))
  (the-as vector (cond
                   ((>= (-> arg0 interp) 1.0)
                    (quaternion->matrix (-> arg1 tracking inv-mat) (-> arg0 cur-quat))
                    (let ((v0-1 (the-as structure (-> arg1 trans))))
                      (set! (-> (the-as vector v0-1) quad) (-> arg0 cur-trans quad))
                      v0-1
                      )
                    )

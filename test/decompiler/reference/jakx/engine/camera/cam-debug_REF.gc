;; definition for function camera-line-rel
(defun camera-line-rel ((arg0 vector) (arg1 vector) (arg2 vector4w))
  (rlet ((vf0 :class vf)
         (vf4 :class vf)
         (vf5 :class vf)
         (vf6 :class vf)
         )
    (init-vf0-vector)
    (let ((a3-1 (-> (the-as cam-dbg-scratch #x70000000) rel-vec)))
      (.lvf vf4 (&-> arg0 quad))
      (.lvf vf5 (&-> arg1 quad))
      (.mov.vf.w vf6 vf0)
      (.add.vf.xyz vf6 vf4 vf5)
      (.svf (&-> a3-1 quad) vf6)
      )
    (camera-line arg0 (the-as vector (+ 112 #x70000000)) arg2)
    (none)
    )
  )


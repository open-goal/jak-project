          (camera-cross
            (new 'static 'vector :y 1024.0)
            (new 'static 'vector :z 1024.0)
            s3-0
            (new 'static 'vector4w :x #xff :w #x80)
            (meters 0.25)
            )
          (tracking-spline-method-19 this (-> this sample-len) s3-0 s2-0 (the-as tracking-spline-sampler #f))
          (camera-cross
            (new 'static 'vector :y 1024.0)
            (new 'static 'vector :z 1024.0)
            s3-0
            (new 'static 'vector4w :x #xff :w #x80)
            (meters 0.25)
            )
          )
        )
      (while (!= s4-0 -134250495)
        (camera-line
          (-> this point s5-0 position)
          (-> this point s4-0 position)
          (new 'static 'vector4w :x #x80 :y #x80 :z #x80 :w #x80)
          )
        (set! s5-0 s4-0)
        (set! s4-0 (-> this point s4-0 next))
        )
      )
    (if (!= s5-0 -134250495)
        (camera-cross
          (new 'static 'vector :y 1024.0)
          (new 'static 'vector :z 1024.0)
          (-> this point s5-0 position)
          (new 'static 'vector4w :x #xff :w #x80)
          (meters 0.25)
          )
        )
    )
  (let ((s5-1 (new 'stack-no-clear 'vector)))
    (camera-line
      (-> this debug-out-position)
      (-> this debug-old-position)
      (new 'static 'vector4w :x #xff :y #xff :w #x80)

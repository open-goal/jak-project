  (if (= (logand (cam-slave-options WIDE_FOV) arg0) (cam-slave-options WIDE_FOV))
      (format arg1 "WIDE_FOV ")
      )
  (if (= (logand arg0 (cam-slave-options MOVE_SPHERICAL)) (cam-slave-options MOVE_SPHERICAL))
      (format arg1 "MOVE_SPHERICAL ")

    (format
      *stdcon*
      "old ~S cpu ~D old vu ~D (go to menu before comparing)~%"
      *camera-old-level*
      *camera-old-cpu*
      *camera-old-vu*
      )
    (format *stdcon* "old tfrag-mem ~D~%" (sar *camera-old-tfrag-bytes* 10))
    (format *stdcon* "~S~%" *camera-old-stat-string-tfrag-near*)
    (format *stdcon* "~S~%" *camera-old-stat-string-tfrag*)
    (format *stdcon* "~S~%" *camera-old-stat-string-total*)
    )
  (if *display-cam-collide-history*
      (cam-collision-record-draw)
      )
  (if *display-cam-master-marks*
      (debug-draw-spline (-> arg0 target-spline))
      )
  (if *display-xyz-axes*
      (master-draw-coordinates (the-as vector #f))
      )
  (cam-debug-draw-tris)
  (view-pop-context)
  0
  (none)
  )

;; definition for function debug-set-camera-pos-rot!
;; INFO: Used lq/sq
;; ERROR: Function may read a register that is not set: t1
(defun debug-set-camera-pos-rot! ((arg0 vector) (arg1 matrix))
  (local-vars (t1-0 none))
  (when (and (view-get-active-camera) (view-get-active-camera-combiner))
    (set! (-> (the-as vector (-> (view-get-active-camera-combiner) stack)) quad) (-> arg0 quad))
    (let ((a2-0 (&-> (view-get-active-camera-combiner) stack 16))
          (v1-3 (-> arg1 rvec quad))
          (a0-3 (-> arg1 uvec quad))
          (a1-1 (-> arg1 fvec quad))
          (a3-0 (-> arg1 trans quad))
          )
      (s.q! a2-0 v1-3)
      (s.q! (+ a2-0 16) a0-3)
      (s.q! (+ a2-0 32) a1-1)
      (s.q! (+ a2-0 48) a3-0)
      )
    (set-setting-by-param *setting-control* (the-as process 'mode-name) 'cam-fixed 0 0 t1-0)
    (cam-master-activate-slave #t)
    )
  arg0
  )


;; definition for function update-sound-banks
;; WARN: Return type mismatch int vs none.
;; WARN: new jak 2 until loop case, check carefully
;; WARN: Function update-sound-banks has a return type of none, but the expression builder found a return statement.
(defun update-sound-banks ((arg0 load-state) (arg1 (inline-array sound-bank-state)))
  (if (-> *setting-control* user-current mpeg-mode?)
      (return #f)
      )
  (set! (-> arg0 target-sound 0 name) (-> arg0 want-sound 0 name))
  (if (-> arg0 target-sound 0 name)
      (copy-string<-string (-> *sound-bank-string* 0) (symbol->string (-> arg0 target-sound 0 name)))
      )
  (if (zero? (-> arg0 want-sound 0 name))
      (set! (-> arg0 target-sound 0 name) #f)
      )
  (set! (-> arg0 target-sound 0 mode) (-> arg0 want-sound 0 mode))
  0
  (let ((s4-1 1)
        (s5-1 0)
        )
    (let ((s3-0 1)
          (s2-0 6)
          )
      (while (>= s2-0 s3-0)
        (set! (-> arg0 target-sound s3-0 name) #f)
        (set! (-> arg0 target-sound s3-0 high) #f)
        (clear (-> *sound-bank-string* s3-0))
        (+! s3-0 1)
        )
      )
    (let ((v1-22 1)
          (a0-5 6)
          )
      (while (>= a0-5 v1-22)
        (let ((a1-2 1))
          (when (and (nonzero? (-> arg0 want-sound v1-22 name)) (-> arg0 want-sound v1-22 name))
            (until #f
              (if (or (= a1-2 s4-1) (and (= (-> arg0 target-sound a1-2 name) (-> arg0 want-sound v1-22 name))
                                         (not (-> arg0 want-sound a1-2 high))
                                         )
                      )
                  (goto cfg-25)
                  )
              (+! a1-2 1)
              )
            #f
            (label cfg-25)
            (cond
              ((= a1-2 s4-1)
               (set! (-> arg0 target-sound s4-1 name) (-> arg0 want-sound v1-22 name))
               (when (-> arg0 want-sound v1-22 high)
                 (+! s5-1 1)
                 (set! (-> arg0 target-sound s4-1 high) #t)
                 )
               (+! s4-1 1)
               )
              (else
                (when (-> arg0 want-sound v1-22 high)
                  (+! s5-1 1)
                  (set! (-> arg0 target-sound a1-2 high) #t)
                  )
                )
              )
            )
          )
        (+! v1-22 1)
        )
      )
    (cond
      ((= s5-1 1)
       (let ((s5-2 13)
             (s4-2 1)
             (s3-1 6)
             )
         (while (>= s3-1 s4-2)
           (when (-> arg0 target-sound s4-2 name)
             (cond
               ((-> arg0 target-sound s4-2 high)
                (set! (-> arg0 target-sound s4-2 mode) (sound-bank-mode higha))
                (format (-> *sound-bank-string* s4-2) "~S~D" (-> arg0 target-sound s4-2 name) 1)
                )
               (else
                 (format (-> *sound-bank-string* s4-2) "~S~D" (-> arg0 target-sound s4-2 name) 3)
                 (set! (-> arg0 target-sound s4-2 mode) (the-as sound-bank-mode s5-2))
                 (+! s5-2 1)
                 )
               )
             )
           (+! s4-2 1)
           )
         )
       )
      ((= s5-1 2)
       (let ((s5-3 14)
             (s4-3 11)
             (s3-2 1)
             (s2-1 6)
             )
         (while (>= s2-1 s3-2)
           (when (-> arg0 target-sound s3-2 name)
             (cond
               ((-> arg0 target-sound s3-2 high)
                (set! (-> arg0 target-sound s3-2 mode) (sound-bank-mode higha))
                (format (-> *sound-bank-string* s3-2) "~S~D" (-> arg0 target-sound s3-2 name) 2)
                (set! (-> arg0 target-sound s3-2 mode) (the-as sound-bank-mode s4-3))
                (+! s4-3 1)
                )
               (else
                 (format (-> *sound-bank-string* s3-2) "~S~D" (-> arg0 target-sound s3-2 name) 3)
                 (set! (-> arg0 target-sound s3-2 mode) (the-as sound-bank-mode s5-3))
                 (+! s5-3 1)
                 )
               )
             )
           (+! s3-2 1)
           )
         )
       )
      )
    )
  (if (or (nonzero? (rpc-busy? 2))
          (not (-> *setting-control* user-current sound-bank-load))
          (-> *setting-control* user-current mpeg-mode?)
          )
      (return 0)
      )
  (dotimes (s5-4 7)
    (let ((s4-4 (-> arg0 target-sound s5-4)))
      (when (not (and (string= (-> *sound-bank-string* s5-4) (-> *level* sound-bank s5-4 str-name))
                      (= (-> s4-4 mode) (-> *level* sound-bank s5-4 mode))
                      )
                 )
        (cond
          ((nonzero? (length (-> *sound-bank-string* s5-4)))
           (cond
             ((-> *level* sound-bank s5-4 name)
              (when (nonzero? (length (-> *level* sound-bank s5-4 str-name)))
                (format
                  0
                  "Unload soundbank ~A from slot ~D   ~D~%"
                  (-> *level* sound-bank s5-4 str-name)
                  s5-4
                  (-> *level* sound-bank s5-4 mode)
                  )
                (clear (-> *level* sound-bank s5-4 str-name))
                (sound-bank-unload (the-as sound-name (-> *level* sound-bank s5-4 mode)))
                (return 0)
                )
              )
             (else
               )
             )
           )
          (else
            (when (-> *level* sound-bank s5-4 name)
              (when (nonzero? (length (-> *level* sound-bank s5-4 str-name)))
                (format
                  0
                  "---------------- Unload soundbank ~A from slot ~D   ~D~%"
                  (-> *level* sound-bank s5-4 str-name)
                  s5-4
                  (-> *level* sound-bank s5-4 mode)
                  )
                (clear (-> *level* sound-bank s5-4 str-name))
                (sound-bank-unload (the-as sound-name (-> *level* sound-bank s5-4 mode)))
                (return 0)
                )
              )
            )
          )
        )
      )
    )
  (dotimes (s5-5 7)
    (let ((s4-5 (-> arg0 target-sound s5-5)))
      (when (not (and (string= (-> *sound-bank-string* s5-5) (-> *level* sound-bank s5-5 str-name))
                      (= (-> s4-5 mode) (-> *level* sound-bank s5-5 mode))
                      )
                 )
        (cond
          ((nonzero? (length (-> *sound-bank-string* s5-5)))
           (cond
             ((-> *level* sound-bank s5-5 name)
              (set! (-> *level* sound-bank s5-5 name) #f)
              (clear (-> *level* sound-bank s5-5 str-name))
              (set! (-> *level* sound-bank s5-5 mode) (sound-bank-mode none))
              (return 0)
              )
             (else
               (format 0 "Load soundbank ~A in slot ~D~%" (-> *sound-bank-string* s5-5) s5-5)
               (sound-bank-load (string->sound-name (-> *sound-bank-string* s5-5)) (the-as int (-> s4-5 mode)) 0)
               (set! (-> *level* sound-bank s5-5 name) (-> s4-5 name))
               (set! (-> *level* sound-bank s5-5 mode) (-> s4-5 mode))
               (copy-string<-string (-> *level* sound-bank s5-5 str-name) (-> *sound-bank-string* s5-5))
               (return 0)
               )
             )
           (the-as none 0)
           )
          (else
            (when (-> *level* sound-bank s5-5 name)
              (set! (-> *level* sound-bank s5-5 name) #f)
              (clear (-> *level* sound-bank s5-5 str-name))
              (set! (-> *level* sound-bank s5-5 mode) (sound-bank-mode none))
              (return 0)
              )
            )
          )
        )
      )
    )
  0
  (none)
  )

;; definition for method 10 of type load-state
(defmethod update! ((this load-state))
  (local-vars (a0-29 symbol))
  (if (-> this update-callback)
      ((-> this update-callback) this)
      )
  (let ((v1-3 #f))
    (let ((s5-0 0))
      -1
      (countdown (s4-0 6)
        (let ((a0-3 -1))
          (countdown (a1-0 6)
            (let ((a2-3 (-> *level* level a1-0)))
              (when (and (!= (-> a2-3 status) 'inactive) (>= (-> a2-3 load-order) (the-as uint s5-0)))
                (let ((a3-5 #f))
                  (dotimes (t0-2 6)
                    (if (and (not (-> this target t0-2 force-reload)) (= (-> a2-3 name) (-> this target t0-2 name)))
                        (set! a3-5 #t)
                        )
                    )
                  (when (not a3-5)
                    (set! s5-0 (the-as int (-> a2-3 load-order)))
                    (set! a0-3 a1-0)
                    )
                  )
                )
              )
            )
          (when (>= a0-3 0)
            (let ((s3-0 (-> *level* level a0-3)))
              (format 0 "Discarding level ~A~%" (-> s3-0 name))
              (if (= (-> s3-0 name) 'krasw)
                  (format 0 "hello~%")
                  )
              (level-status-update! s3-0 'inactive)
              )
            (set! v1-3 #t)
            )
          )
        )
      )
    (let ((s5-1 6)
          (s4-1 17)
          )
      (while (>= s4-1 s5-1)
        (let ((s3-1 (-> *level* level s5-1)))
          (when (!= (-> s3-1 status) 'inactive)
            (when (or (-> this target s5-1 force-reload) (!= (-> s3-1 name) (-> this target s5-1 name)))
              (format #t "Discarding level ~A~%" (-> s3-1 name))
              (set! (-> this target s5-1 force-reload) #f)
              (set! (-> this want s5-1 force-reload) #f)
              (level-status-update! s3-1 'inactive)
              (set! v1-3 #t)
              )
            )
          )
        (+! s5-1 1)
        )
      )
    (let ((s5-2 #f))
      (countdown (a0-28 18)
        (when (!= (-> *level* level a0-28 status) 'inactive)
          (set! a0-29 #f)
          (goto cfg-39)
          )
        )
      (set! a0-29 #t)
      (label cfg-39)
      (if a0-29
          (set! s5-2 #t)
          )
      (if v1-3
          (return 0)
          )
      (let ((s4-2 (new 'static 'boxed-array :type symbol :length 0 :allocated-length 18)))
        (countdown (v1-20 18)
          (set! (-> s4-2 v1-20) #f)
          )
        (dotimes (v1-23 6)
          (when (-> this target v1-23 name)
            (set! (-> s4-2 v1-23) (-> this target v1-23 name))
            (dotimes (a0-42 6)
              (let ((a1-21 (-> *level* level a0-42)))
                (if (and (!= (-> a1-21 status) 'inactive) (= (-> a1-21 name) (-> this target v1-23 name)))
                    (set! (-> s4-2 v1-23) #f)
                    )
                )
              )
            )
          )
        (dotimes (v1-26 18)
          (let ((a1-29 (-> *level* level v1-26)))
            (when (!= (-> a1-29 status) 'inactive)
              )
            )
          )
        (cond
          ((and (or s5-2 (not (check-busy *load-dgo-rpc*))) (and (not (load-in-progress? *level*))
                                                                 (not (-> *setting-control* user-current mpeg-mode?))
                                                                 (not (dma-get-named-buffer 'title-control 0 0))
                                                                 )
                )
           (let ((s3-2 -1))
             (dotimes (v1-37 6)
               (when (-> s4-2 v1-37)
                 (set! s3-2 v1-37)
                 (goto cfg-85)
                 )
               )
             (label cfg-85)
             (when (= s3-2 -1)
               (dotimes (s2-0 12)
                 (let ((s1-0 (+ s2-0 6)))
                   (cond
                     ((and (= (-> *level* level s1-0 name) (-> this target s1-0 name))
                           (not (-> this target s1-0 force-reload))
                           (!= (-> *level* level s1-0 status) 'inactive)
                           )
                      (set! (-> this target s1-0 force-reload) #f)
                      (set! (-> this want s1-0 force-reload) #f)
                      (set! (-> s4-2 s1-0) #f)
                      )
                     ((-> this target s1-0 name)
                      (cond
                        ((not (dma-get-named-buffer 'car-load 0 0))
                         (let ((v1-65 (new 'stack-no-clear 'array 'int32 2)))
                           (cond
                             ((dma-try-alloc #x28000 #x28000 'car-load 1 (&-> v1-65 0) (&-> v1-65 1) #f)
                              #t
                              )
                             (else
                               )
                             )
                           )
                         (set! (-> s4-2 s1-0) #f)
                         )
                        ((dma-get-named-buffer 'car-load 0 4)
                         (set! (-> s4-2 s1-0) (-> this target s1-0 name))
                         (set! s3-2 s1-0)
                         (goto cfg-107)
                         )
                        (else
                          (set! (-> s4-2 s1-0) #f)
                          )
                        )

      (set! (-> s0-0 display?) #f)
      (set! (-> s0-0 force-all-visible?) #f)
      (set! (-> s0-0 force-inside?) #f)
      (set! (-> s0-0 slot) arg2)
      (level-status-update! s0-0 'loading)

                   )
                 )
               )
             (label cfg-107)
             (when (!= s3-2 -1)
               (format 0 "Adding level ~A ~D~%" (-> this target s3-2 name) s3-2)
               (let ((s4-3 (level-get-for-use *level* (-> this target s3-2 name) 'loaded (-> this target s3-2 slot))))
                 (when (and s5-2 (-> this target s3-2 display?))
                   (format 0 "Waiting for level to load~%")
                   (while (or (= (-> s4-3 status) 'loading) (= (-> s4-3 status) 'loading-bt) (= (-> s4-3 status) 'login))

                                   (= v1-0 'vinroomh)
                                   (= v1-0 'ctyprtdh)
                                   (= v1-0 'citybbh)
                                   )
                               5
                               )
                              ((or (= v1-0 'mong1)
                                   (= v1-0 'mong2)
                                   (= v1-0 'mong3)
                                   (= v1-0 'falc1)
                                   (= v1-0 'falc2)
                                   (= v1-0 'falc3)
                                   (= v1-0 'womb1)
                                   (= v1-0 'womb2)
                                   (= v1-0 'womb3)
                                   (= v1-0 'poss1)
                                   (= v1-0 'poss2)
                                   (= v1-0 'poss3)
                                   )
                               5
                               )
                              ((or (= v1-0 'bobc1)
                                   (= v1-0 'bobc2)
                                   (= v1-0 'bobc3)
                                   (= v1-0 'coug1)
                                   (= v1-0 'coug2)
                                   (= v1-0 'coug3)
                                   (= v1-0 'wolf1)
                                   (= v1-0 'wolf2)
                                   (= v1-0 'wolf3)
                                   (= v1-0 'bear1)
                                   (= v1-0 'bear2)
                                   (= v1-0 'bear3)
                                   )
                               5
                               )
                              ((or (= v1-0 'leop1)
                                   (= v1-0 'leop2)
                                   (= v1-0 'leop3)
                                   (= v1-0 'pant1)
                                   (= v1-0 'pant2)
                                   (= v1-0 'pant3)
                                   (= v1-0 'tige1)
                                   (= v1-0 'tige2)
                                   (= v1-0 'tige3)
                                   (= v1-0 'chee1)
                                   (= v1-0 'chee2)
                                   (= v1-0 'chee3)

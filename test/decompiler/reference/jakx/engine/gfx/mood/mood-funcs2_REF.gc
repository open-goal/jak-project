;; definition of type rustyh-states
(deftype rustyh-states (structure)
  ((effect  float)
   )
  )

;; definition for method 3 of type rustyh-states
(defmethod inspect ((this rustyh-states))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'rustyh-states)
  (format #t "~1Teffect: ~f~%" (-> this effect))
  (label cfg-4)
  this
  )

;; definition for function update-rustyh-lights
;; WARN: Return type mismatch int vs none.
(defun update-rustyh-lights ((arg0 mood-context))
  (let ((v1-0 (-> arg0 light-group)))
    (set-vector! (-> v1-0 0 ambi color) 0.27 0.27 0.333 1.0)
    (set! (-> v1-0 0 ambi extra x) 0.8)
    (set! (-> v1-0 0 dir0 extra x) 0.0)
    )
  (let ((v1-2 (-> arg0 light-group 1))
        (a0-1 (the-as rustyh-states (-> arg0 state)))
        )
    (let ((a1-2 (-> v1-2 dir0)))
      (set! (-> a1-2 direction x) 0.339)
      (set! (-> a1-2 direction y) 0.931)
      (set! (-> a1-2 direction z) 0.131)
      (set! (-> a1-2 direction w) 1.0)
      )
    (set-vector! (-> v1-2 dir0 color) 0.304 0.6508 1.2 1.0)
    (let ((a1-4 (-> v1-2 dir1)))
      (set! (-> a1-4 direction x) -0.821)
      (set! (-> a1-4 direction y) 0.362)
      (set! (-> a1-4 direction z) -0.439)
      (set! (-> a1-4 direction w) 1.0)
      )
    (set-vector! (-> v1-2 dir1 color) 1.0 1.0 1.0 1.0)
    (set-vector! (-> v1-2 ambi color) 0.304 0.6508 1.2 1.0)
    (set! (-> v1-2 ambi extra x) 0.15)
    (set! (-> v1-2 dir0 extra x) (+ 1.5 (-> a0-1 effect)))
    (set! (-> v1-2 dir1 extra x) (* 2.0 (-> a0-1 effect)))
    )
  0
  (none)
  )

;; definition for function update-mood-rustyh
;; WARN: Return type mismatch int vs none.
(defbehavior update-mood-rustyh time-of-day-proc ((arg0 mood-context) (arg1 float) (arg2 int))
  (update-mood-interior arg0 #f)
  (update-rustyh-lights arg0)
  (cond
    ((< (the-as uint 8) (the-as uint (-> *time-of-day-context* mode)))
     (palette-select-special arg0)
     )
    (else
      (let ((v1-2 (-> arg0 state)))
        (set! (-> arg0 times 0 w) 1.0)
        (set! (-> arg0 times 1 w) 1.0)
        (set! (-> arg0 times 2 w) (the-as float (-> v1-2 0)))
        )
      )
    )
  0
  (none)
  )

;; definition for function set-rustyh-effect-light!
;; WARN: Return type mismatch int vs none.
(defun set-rustyh-effect-light! ((arg0 float))
  (let ((v1-1 (level-get *level* 'rustyh)))
    (when v1-1
      (let ((v1-3 (-> v1-1 mood-context state)))
        (set! (-> v1-3 0) (the-as uint arg0))
        )
      )
    )
  (let ((v1-5 (level-get *level* 'rustyhfm)))
    (when v1-5
      (let ((v1-7 (-> v1-5 mood-context state)))
        (set! (-> v1-7 0) (the-as uint arg0))
        )
      )
    )
  0
  (none)
  )


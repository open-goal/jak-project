;; definition for function update-mood-hiphog
;; WARN: Return type mismatch int vs none.
(defbehavior update-mood-hiphog time-of-day-proc ((arg0 mood-context) (arg1 float) (arg2 int))
  (update-mood-interior arg0 #t)
  (set! (-> arg0 light-group 0 dir0 extra x) 0.0)
  (cond
    ((< (the-as uint 8) (the-as uint (-> *time-of-day-context* mode)))
     (palette-select-special arg0)
     )
    (else
      (set! (-> arg0 times 1 w) 1.0)
      (-> arg0 state)
      )
    )
  0
  (none)
  )

;; definition of type garage-states
(deftype garage-states (structure)
  ((switched  float)
   )
  )

;; definition for method 3 of type garage-states
(defmethod inspect ((this garage-states))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'garage-states)
  (format #t "~1Tswitched: ~f~%" (-> this switched))
  (label cfg-4)
  this
  )

;; definition for function update-garage-brdroom-lights
;; WARN: Return type mismatch int vs none.
(defun update-garage-brdroom-lights ((arg0 mood-context))
  (let ((v1-0 (-> arg0 light-group)))
    (let ((f0-0 (-> (the-as garage-states (-> arg0 state)) switched)))
      (set-vector! (-> v1-0 0 ambi color) 0.27 0.27 0.333 1.0)
      (set! (-> v1-0 0 ambi extra x) (* 0.8 (- 1.0 f0-0)))
      )
    (set! (-> v1-0 0 dir0 extra x) 0.0)
    )
  (let ((v1-2 (-> arg0 light-group 1))
        (a0-1 (the-as garage-states (-> arg0 state)))
        )
    (let ((a1-4 (-> v1-2 dir0)))
      (set! (-> a1-4 direction x) 0.339)
      (set! (-> a1-4 direction y) 0.931)
      (set! (-> a1-4 direction z) 0.131)
      (set! (-> a1-4 direction w) 1.0)
      )
    (set-vector! (-> v1-2 dir0 color) 0.304 0.6508 1.2 1.0)
    (let ((a1-6 (-> v1-2 dir1)))
      (set! (-> a1-6 direction x) -0.821)
      (set! (-> a1-6 direction y) 0.362)
      (set! (-> a1-6 direction z) -0.439)
      (set! (-> a1-6 direction w) 1.0)
      )
    (set-vector! (-> v1-2 dir1 color) 1.0 1.0 1.0 1.0)
    (set-vector! (-> v1-2 ambi color) 0.304 0.6508 1.2 1.0)
    (set! (-> v1-2 ambi extra x) 0.15)
    (set! (-> v1-2 dir0 extra x) (+ 1.5 (-> a0-1 switched)))
    (set! (-> v1-2 dir1 extra x) (* 2.0 (-> a0-1 switched)))
    )
  0
  (none)
  )

;; definition for function update-mood-garage-brdroom
;; WARN: Return type mismatch int vs none.
(defbehavior update-mood-garage-brdroom time-of-day-proc ((arg0 mood-context) (arg1 float) (arg2 int))
  (copy-mood-exterior-ambi arg0 #f)
  (update-mood-interior arg0 #t)
  (update-garage-brdroom-lights arg0)
  (let ((v1-0 (-> arg0 current-fog)))
    (set! (-> v1-0 fog-color x) 160.0)
    (set! (-> v1-0 fog-color y) 150.0)
    (set! (-> v1-0 fog-color z) 200.0)
    (set! (-> v1-0 fog-color w) 128.0)
    )
  (set-vector! (-> arg0 current-fog fog-dists) 131072.0 6826667.0 255.0 162.0)
  (when (and (= (-> *level* level arg2 status) 'active)
             (< (the-as uint (-> *time-of-day-context* mode)) (the-as uint 9))
             )
    (let ((s5-1 (the-as garage-states (-> arg0 state))))
      (cond
        ((movie?)
         (set! (-> arg0 times 0 w) 1.0)
         (set! (-> arg0 times 1 w) 1.0)
         (set! (-> arg0 times 2 w) 1.0)
         (set! (-> arg0 times 5 w) 0.0)
         (set! (-> arg0 times 6 w) 0.0)
         (set! (-> arg0 times 7 w) 1.0)
         )
        ((level-get *level* 'credits)
         (set! (-> arg0 times 0 w) 1.0)
         (set! (-> arg0 times 1 w) 1.0)
         (set! (-> arg0 times 2 w) 1.0)
         (set! (-> arg0 times 5 w) 1.0)
         (set! (-> arg0 times 6 w) 1.0)
         (set! (-> arg0 times 7 w) 1.0)
         )
        (else
          (let ((f0-20 (-> s5-1 switched)))
            (set! (-> arg0 times 0 w) (- 1.0 f0-20))
            (set! (-> arg0 times 1 w) (- 1.0 f0-20))
            (set! (-> arg0 times 2 w) (- 1.0 (* 0.3 f0-20)))
            (set! (-> arg0 times 5 w) (fmax 0.6 f0-20))
            )
          (set! (-> arg0 times 6 w) 1.0)
          (set! (-> arg0 times 7 w) 0.0)
          )
        )
      )
    )
  0
  (none)
  )

;; definition for function set-garage-switched!
;; WARN: Return type mismatch int vs none.
(defun set-garage-switched! ((arg0 float))
  (let ((v1-1 (level-get *level* 'menu2)))
    (when v1-1
      (let ((v1-3 (-> v1-1 mood-context state)))
        (set! (-> v1-3 0) (the-as uint arg0))
        )
      )
    )
  0
  (none)
  )





(in-package goal)

;; definition for function init-mood-fog-default
;; WARN: Return type mismatch vector vs none.
(defun init-mood-fog-default ()
  (let ((v1-1 (-> *time-of-day-context* fog-override)))
    (set-vector! (-> v1-1 fog-color) 150.0 165.0 220.0 128.0)
    (set-vector! (-> v1-1 fog-dists) 2048000.0 12288000.0 255.0 150.0)
    (set-vector! (-> v1-1 erase-color) 0.0 0.0 0.0 128.0)
    )
  (none)
  )


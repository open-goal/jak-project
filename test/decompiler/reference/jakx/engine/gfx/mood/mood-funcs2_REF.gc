      (set! (-> a0-22 direction z) 0.0)
      (set! (-> a0-22 direction w) 1.0)
      )
    (set! (-> a2-0 dir0 extra x) 1.0)
    (set! (-> a2-0 dir1 extra x) 1.0)
    (set! (-> a2-0 dir2 extra x) 1.0)
    (set! (-> a2-0 ambi extra x) 1.0)

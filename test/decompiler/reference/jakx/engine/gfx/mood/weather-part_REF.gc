        (set! (-> *part-id-table* 29 init-specs 22 initial-valuef) (- 16384.0 (vector-x-angle (-> gp-0 uvec))))
        (set! (-> *part-id-table* 29 init-specs 16 initial-valuef) f30-0)
        )

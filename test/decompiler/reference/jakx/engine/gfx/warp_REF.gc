(defun fx-copy-init ((arg0 dma-buffer) (arg1 viewport))
  (dma-buffer-add-gs-set arg0
                         (frame-1 (-> arg1 copy-frame))
                         (zbuf-1 (-> arg1 zbuf-off))
                         (tex0-1 (-> arg1 tex0-24))
                         (test-1 (new 'static 'gs-test :ate #x1 :atst (gs-atest always) :zte #x1 :ztst (gs-ztest always)))
                         (alpha-1 (new 'static 'gs-alpha))
                         (prim (new 'static 'gs-prim :prim (gs-prim-type sprite) :tme #x1 :abe #x1 :fst #x1))
                         (rgbaq (new 'static 'gs-rgbaq :r #x80 :g #x80 :b #x80 :a #x80 :q 1.0))
                         (tex1-1 (new 'static 'gs-tex1))
                         (miptbp1-1 (new 'static 'gs-miptbp))
                         (clamp-1 (-> arg1 clamp))
                         (texflush 0)
                         )
  (let ((v1-3 (-> arg0 base)))
    (let* ((a2-6 arg0)
           (a3-22 (the-as object (-> a2-6 base)))
           )
      (set! (-> (the-as dma-packet a3-22) dma) (new 'static 'dma-tag :id (dma-tag-id cnt)))
      (set! (-> (the-as dma-packet a3-22) vif0) (new 'static 'vif-tag))
      (set! (-> (the-as dma-packet a3-22) vif1) (new 'static 'vif-tag :cmd (vif-cmd direct) :msk #x1))
      (set! (-> a2-6 base) (&+ (the-as pointer a3-22) 16))
      )
    (let* ((t0-2 (-> arg1 screen-sx))
           (a2-7 (-> arg1 screen-sy))
           (a3-24 (-> arg1 screen-maxy))
           (t0-3 (/ t0-2 32))
           )
      (let* ((t1-0 arg0)
             (t2-0 (the-as object (-> t1-0 base)))
             )
        (set! (-> (the-as gs-gif-tag t2-0) tag)
              (new 'static 'gif-tag64 :eop #x1 :flg (gif-flag reg-list) :nreg #x4 :nloop t0-3)
              )
        (set! (-> (the-as gs-gif-tag t2-0) regs)
              (new 'static 'gif-tag-regs
                :regs0 (gif-reg-id uv)
                :regs1 (gif-reg-id xyz2)
                :regs2 (gif-reg-id uv)
                :regs3 (gif-reg-id xyz2)
                )
              )
        (set! (-> t1-0 base) (&+ (the-as pointer t2-0) 16))
        )
      (let ((t1-1 0))
        (dotimes (t2-2 t0-3)
          (let* ((t3-3 arg0)
                 (t4-2 (-> t3-3 base))
                 )
            (set! (-> (the-as (pointer gs-uv) t4-2) 0) (new 'static 'gs-uv :u (* t1-1 16)))
            (set! (-> (the-as (pointer gs-xyz) t4-2) 1) (new 'static 'gs-xyz :y #x7300 :x (* (+ t1-1 1792) 16)))
            (set! (-> (the-as (pointer gs-uv) t4-2) 2) (new 'static 'gs-uv :u (* (+ t1-1 32) 16) :v (* a2-7 16)))
            (set! (-> (the-as (pointer gs-xyz) t4-2) 3) (new 'static 'gs-xyz :y (* a3-24 16) :x (* (+ t1-1 1824) 16)))
            (set! (-> t3-3 base) (&+ t4-2 32))
            )
          (+! t1-1 32)
          )
        )
      )
    (let ((a3-28 (/ (the-as int (+ (- -16 (the-as int v1-3)) (the-as int (-> arg0 base)))) 16)))
      (cond
        ((nonzero? a3-28)
         (logior! (-> (the-as (pointer uint64) v1-3) 0) (shr (shl a3-28 48) 48))
         (logior! (-> (the-as (pointer uint64) v1-3) 1) (shl (shr (shl a3-28 48) 48) 32))
         )
        (else
          (set! (-> arg0 base) v1-3)
          )
        )
      )
    )
  (dma-buffer-add-gs-set arg0
                         (frame-1 (-> arg1 frame))
                         (test-1 (new 'static 'gs-test :ate #x1 :atst (gs-atest equal) :zte #x1 :ztst (gs-ztest always)))
                         (rgbaq (new 'static 'gs-rgbaq :r #xc0 :g #xc0 :b #xc0 :a #x80 :q 1.0))
                         (texflush 0)
                         )
  0
  (none)
  )


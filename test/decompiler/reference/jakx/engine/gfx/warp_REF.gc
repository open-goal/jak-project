         (a3-0 (-> arg1 copy-dma))
         (a0-1 (the-as object (-> v1-0 base)))
         )
    (set! (-> (the-as dma-packet a0-1) dma)
          (new 'static 'dma-tag :id (dma-tag-id call) :addr (the-as int (-> a3-0 data)))
          )
    (set! (-> (the-as dma-packet a0-1) vif0) (new 'static 'vif-tag))
    (set! (-> (the-as dma-packet a0-1) vif1) (new 'static 'vif-tag :cmd (vif-cmd flusha) :msk #x1))
    (set! (-> v1-0 base) (&+ (the-as pointer a0-1) 16))
    )
  (set-dirty-mask!
    (-> *level* level-default)
    5
    (* (* (-> arg1 screen-sy) (-> arg1 screen-sx)) 4)
    (the-as int (shl (-> arg1 copy-frame fbp) 13))
    )

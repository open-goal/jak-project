      )
    (set! (-> gp-0 next-tmpl dma) (new 'static 'dma-tag :id (dma-tag-id next)))
    (set! (-> gp-0 next-tmpl vif0) (new 'static 'vif-tag :imm #x404 :cmd (vif-cmd stcycl)))
    (set! (-> gp-0 next-tmpl vif1) (new 'static 'vif-tag :imm #x404 :cmd (vif-cmd stcycl)))
    (let ((v1-6 *level*))
      (dotimes (a0-9 19)
        (set! (-> gp-0 draw-index-map a0-9) (-> v1-6 draw-index-map a0-9))
        )
      )
    (let* ((v1-9 *viewport-array*)
           (s5-1 (-> v1-9 data (-> v1-9 current-viewport-index)))
           )
      (let ((s4-0 (-> s5-1 index)))
        (dotimes (s3-0 19)
          (let ((s2-0 (-> gp-0 grid level-buckets s3-0)))
            (dotimes (s1-0 10)
              (let ((sv-16 (-> s2-0 data s1-0)))
                (set! (-> sv-16 merc first) (the-as dma-packet 0))
                (set! (-> sv-16 merc patch) (the-as dma-packet 0))
                (set! (-> sv-16 merc vu1-bucket) (the-as bucket-id (vu1-bucket-map s3-0 s1-0 s4-0 (merc-mode merc))))
                (set! (-> sv-16 emerc first) (the-as dma-packet 0))
                (set! (-> sv-16 emerc patch) (the-as dma-packet 0))
                (set! (-> sv-16 emerc vu1-bucket) (the-as bucket-id (vu1-bucket-map s3-0 s1-0 s4-0 (merc-mode emerc))))

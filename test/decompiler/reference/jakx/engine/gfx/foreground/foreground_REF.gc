             (a0-6 (-> v1-2 base))
             )
        (set! (-> (the-as (pointer uint64) a0-6) 0) (the-as uint #x70000000))
        (set! (-> (the-as (pointer uint64) a0-6) 1) (the-as uint 0))
        (set! (-> v1-2 base) (&+ a0-6 16))
        )
      (.sync.l)

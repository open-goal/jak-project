(defun emerc-vu1-init-buffers ()
  (when (logtest? (-> *display* vu1-enable-user) (vu1-renderer-mask generic))
    (let ((gp-0 *viewport-array*))
      (dotimes (s5-0 19)
        (dotimes (s4-0 2)
          (view-push-context s4-0)
          (let ((v1-4 gp-0)
                (a0-1 s4-0)

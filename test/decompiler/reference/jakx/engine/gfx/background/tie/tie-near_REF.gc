;; definition for function tie-scissor-make-perspective-matrix
;; WARN: Return type mismatch matrix vs none.
(defun tie-scissor-make-perspective-matrix ((arg0 matrix) (arg1 matrix))
  (column-scale-matrix! arg0 (-> (view-get-active-math-camera) hmge-scale) arg1)
  (none)
  )


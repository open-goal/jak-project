  (let ((f0-1 (/ 1.0 (-> (view-get-active-math-camera) pfog0))))
    (set! (-> arg0 rvec w) (* (-> arg0 rvec w) f0-1))
    (set! (-> arg0 uvec w) (* (-> arg0 uvec w) f0-1))
    (set! (-> arg0 fvec w) (* (-> arg0 fvec w) f0-1))
    (set! (-> arg0 trans w) (* (-> arg0 trans w) f0-1))
    )
  (+! (-> arg0 rvec x) (* (-> arg0 rvec w) (-> (view-get-active-math-camera) hvdf-off x)))
  (+! (-> arg0 uvec x) (* (-> arg0 uvec w) (-> (view-get-active-math-camera) hvdf-off x)))
  (+! (-> arg0 fvec x) (* (-> arg0 fvec w) (-> (view-get-active-math-camera) hvdf-off x)))
  (+! (-> arg0 trans x) (* (-> arg0 trans w) (-> (view-get-active-math-camera) hvdf-off x)))
  (+! (-> arg0 rvec y) (* (-> arg0 rvec w) (-> (view-get-active-math-camera) hvdf-off y)))
  (+! (-> arg0 uvec y) (* (-> arg0 uvec w) (-> (view-get-active-math-camera) hvdf-off y)))
  (+! (-> arg0 fvec y) (* (-> arg0 fvec w) (-> (view-get-active-math-camera) hvdf-off y)))
  (+! (-> arg0 trans y) (* (-> arg0 trans w) (-> (view-get-active-math-camera) hvdf-off y)))
  (+! (-> arg0 rvec z) (* (-> arg0 rvec w) (-> (view-get-active-math-camera) hvdf-off z)))
  (+! (-> arg0 uvec z) (* (-> arg0 uvec w) (-> (view-get-active-math-camera) hvdf-off z)))
  (+! (-> arg0 fvec z) (* (-> arg0 fvec w) (-> (view-get-active-math-camera) hvdf-off z)))
  (+! (-> arg0 trans z) (* (-> arg0 trans w) (-> (view-get-active-math-camera) hvdf-off z)))

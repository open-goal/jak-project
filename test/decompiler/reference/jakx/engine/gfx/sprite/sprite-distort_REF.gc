;; definition for function sprite-distorter-generate-tables
;; WARN: Return type mismatch int vs none.
(defun sprite-distorter-generate-tables ((arg0 math-camera) (arg1 viewport))
  (let ((gp-0 *sprite-distorter-sine-tables*)
        (s3-0 0)
        (s5-0 0)
        (s4-0 3)
        (f28-0 (- (-> arg0 perspective rvec x)))
        (f30-0 (- (-> arg0 perspective uvec y)))
        )
    (when (or (!= f28-0 (-> gp-0 aspx)) (!= f30-0 (-> gp-0 aspy)))
      (let ((f24-0 (/ 1.0 (* 512.0 (-> arg1 ratio-x))))
            (f26-0 (/ 1.0 (* 512.0 (-> arg1 ratio-y))))
            )
        (set! (-> gp-0 aspx) f28-0)
        (set! (-> gp-0 aspy) f30-0)
        (while (< s4-0 12)
          (set! (-> gp-0 ientry s5-0 vector4w x) (+ s3-0 352))
          (+! s5-0 1)
          (dotimes (s2-0 s4-0)
            (let ((f22-0 (* 65536.0 (/ (the float s2-0) (the float s4-0)))))
              (set-vector! (-> gp-0 entry s3-0) (* (sin f22-0) f28-0) (* (cos f22-0) f30-0) 0.0 0.0)
              (let ((s3-1 (+ s3-0 1)))
                (set-vector! (-> gp-0 entry s3-1) (* (sin f22-0) f28-0 f24-0) (* (cos f22-0) f30-0 f26-0) 0.0 0.0)
                (set! s3-0 (+ s3-1 1))
                )
              )
            )
          (+! s4-0 1)
          )
        (set-vector! (-> gp-0 entry s3-0) 0.0 f30-0 0.0 0.0)
        (set-vector! (-> gp-0 entry (+ s3-0 1)) 0.0 (* f30-0 f26-0) 0.0 0.0)
        )
      (set! (-> gp-0 giftag tag) (new 'static 'gif-tag64
                                   :nloop #x1
                                   :eop #x1
                                   :pre #x1
                                   :prim (new 'static 'gs-prim :prim (gs-prim-type tri-strip) :tme #x1)
                                   :nreg #xf
                                   )
            )
      (set! (-> gp-0 giftag regs) (new 'static 'gif-tag-regs
                                    :regs0 (gif-reg-id st)
                                    :regs1 (gif-reg-id rgbaq)
                                    :regs2 (gif-reg-id xyzf2)
                                    :regs3 (gif-reg-id st)
                                    :regs4 (gif-reg-id rgbaq)
                                    :regs5 (gif-reg-id xyzf2)
                                    :regs6 (gif-reg-id st)
                                    :regs7 (gif-reg-id rgbaq)
                                    :regs8 (gif-reg-id xyzf2)
                                    :regs9 (gif-reg-id st)
                                    :regs10 (gif-reg-id rgbaq)
                                    :regs11 (gif-reg-id xyzf2)
                                    :regs12 (gif-reg-id st)
                                    :regs13 (gif-reg-id rgbaq)
                                    :regs14 (gif-reg-id xyzf2)
                                    )
            )
      (set! (-> gp-0 color vector4w x) 128)
      (set! (-> gp-0 color vector4w y) 128)
      (set! (-> gp-0 color vector4w z) 128)
      (set! (-> gp-0 color vector4w w) 128)
      )
    )
  0
  (none)
  )

;; definition for symbol sprite-distort-vu1-block, type vu-function
(define sprite-distort-vu1-block (new 'static 'vu-function :length 63 :qlength 32))

;; definition for function sprite-init-distorter
;; WARN: Return type mismatch int vs none.
(defun sprite-init-distorter ((arg0 dma-buffer) (arg1 viewport))
  (dma-buffer-add-gs-set arg0
                         (zbuf-1 (-> arg1 zbuf-off))
                         (tex0-1 (-> arg1 tex0))
                         (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1))
                         (miptbp1-1 (new 'static 'gs-miptbp))
                         (clamp-1 (-> arg1 clamp))
                         (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1))
                         )
  (let* ((v1-3 arg0)
         (a1-6 (the-as object (-> v1-3 base)))
         )
    (set! (-> (the-as dma-packet a1-6) dma)
          (new 'static 'dma-tag
            :qwc #x8b
            :id (dma-tag-id ref)
            :addr (the-as int (-> *sprite-distorter-sine-tables* entry))
            )
          )
    (set! (-> (the-as dma-packet a1-6) vif0) (new 'static 'vif-tag :imm #x404 :cmd (vif-cmd stcycl)))
    (set! (-> (the-as dma-packet a1-6) vif1)
          (new 'static 'vif-tag :imm #x160 :num #x8b :cmd (vif-cmd unpack-v4-32))
          )
    (set! (-> v1-3 base) (the-as pointer (&+ (the-as dma-packet a1-6) 16)))
    )
  (dma-buffer-add-vu-function arg0 sprite-distort-vu1-block 1)
  0
  (none)
  )


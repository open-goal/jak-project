              (set! (-> (the-as (pointer gs-xyz) t2-2) 1) (new 'static 'gs-xyz :x (* a3-26 16)))
              (set! (-> (the-as (pointer gs-uv) t2-2) 2) (new 'static 'gs-uv :u (* (+ a3-26 32) 16) :v (* a2-7 16)))
              (set! (-> (the-as (pointer gs-xyz) t2-2) 3) (new 'static 'gs-xyz :y (* a2-7 16) :x (* (+ a3-26 32) 16)))
              (set! (-> t1-3 base) (&+ t2-2 32))

;;-*-Lisp-*-
(in-package goal)

;; definition for method 11 of type viewport
;; WARN: Return type mismatch int vs none.
(defmethod viewport-method-11 ((this viewport))
  (set! (-> this screen-hx) (/ (-> this screen-sx) 2))
  (set! (-> this screen-hy) (/ (-> this screen-sy) 2))
  (set! (-> this screen-qx) (/ (-> this screen-hx) 2))
  (set! (-> this screen-qy) (/ (-> this screen-hy) 2))
  (set! (-> this screen-maxx) (+ (-> this screen-sx) 1792))
  (set! (-> this screen-maxy) (+ (-> this screen-sy) 1840))
  (set! (-> this screen-cx) (+ (-> this screen-hx) 1792))
  (set! (-> this screen-cy) (+ (-> this screen-hy) 1840))
  (set! (-> this blur-hx) (/ (-> this blur-sx) 2))
  (set! (-> this blur-hy) (/ (-> this blur-sy) 2))
  (set! (-> this blur-cx) (+ (-> this blur-hx) 1792))
  (set! (-> this blur-cy) (+ (-> this blur-hy) 1840))
  (set! (-> this blur-scale) 0.0)
  (set! (-> this scissor)
        (new 'static 'gs-scissor :scax1 (+ (-> this screen-sx) -1) :scay1 (+ (-> this screen-sy) -1))
        )
  (set! (-> this scissor-on-screen)
        (new 'static 'gs-scissor
          :scax0 (-> this minx-on-screen)
          :scay0 (-> this miny-on-screen)
          :scax1 (+ (-> this screen-sx) -1 (-> this minx-on-screen))
          :scay1 (+ (-> this screen-sy) -1 (-> this miny-on-screen))
          )
        )
  (set-vector!
    (-> this shadow-texoffset)
    (+ 0.5 (* 0.5 (the float (-> this screen-sx))))
    (+ 0.5 (* 0.5 (the float (-> this screen-sy))))
    0.0
    1.0
    )
  (when (!= (-> this index) 2)
    (let ((v1-41 (-> *viewport-array* default)))
      (math-camera-method-9
        (-> this math-camera)
        (the float (-> v1-41 screen-sx))
        (the float (-> v1-41 screen-sy))
        (the float (-> this screen-sx))
        (the float (-> this screen-sy))
        )
      )
    (blit-displays-work-method-24 *blit-displays-work* (-> this blur-forward-dma) this 1)
    (blit-displays-work-method-24 *blit-displays-work* (-> this blur-reverse-dma) this -1)
    (blit-displays-work-method-25 *blit-displays-work* (-> this blur-finish-dma))
    )
  0
  (none)
  )

;; definition for method 12 of type viewport
;; WARN: Return type mismatch int vs none.
(defmethod init-gs-regs ((this viewport))
  (set! (-> this screen-sx) 512)
  (set! (-> this screen-sy) 416)
  (set! (-> this ratio-x) 1.0)
  (set! (-> this ratio-y) 1.0)
  (set! (-> this frame) (new 'static 'gs-frame :fbp #x196 :fbw #x8))
  (set! (-> this frame-a) (new 'static 'gs-frame :fbp #x196 :fbw #x8 :fbmsk #xffffff))
  (set! (-> this zbuf-on) (new 'static 'gs-zbuf :zbp #x12e :psm (gs-psm ct24)))
  (set! (-> this zbuf-off) (new 'static 'gs-zbuf :zbp #x12e :psm (gs-psm ct24) :zmsk #x1))
  (set! (-> this tex0) (new 'static 'gs-tex0 :tbp0 #x32c0 :tbw #x8 :tw #x9 :th #x9 :tcc #x1))
  (set! (-> this tex0-24) (new 'static 'gs-tex0 :tbp0 #x32c0 :tbw #x8 :tw #x9 :th #x9))
  (set! (-> this clamp)
        (new 'static 'gs-clamp
          :wms (gs-tex-wrap-mode region-clamp)
          :wmt (gs-tex-wrap-mode region-clamp)
          :maxu #x1ff
          :maxv #x19f
          )
        )
  (set! (-> this copy-frame) (new 'static 'gs-frame :fbp #x22 :fbw #x8))
  (set! (-> this copy-tex0) (new 'static 'gs-tex0 :tbp0 #x440 :tbw #x8 :tw #x9 :th #x9 :tcc #x1))
  (set! (-> this glow-frame-1) (new 'static 'gs-frame :fbp #x196 :fbw #x8 :fbmsk #xffffff))
  (set! (-> this glow-tex0-1) (new 'static 'gs-tex0 :tbp0 #x11c0 :tbw #x1 :tw #x5 :th #x5 :tcc #x1 :tfx #x1))
  (set! (-> this glow-frame-2) (new 'static 'gs-frame :fbp #x8e :fbw #x1 :fbmsk #xffffff))
  (set! (-> this glow-tex0-2) (new 'static 'gs-tex0 :tbp0 #x32c0 :tbw #x8 :tw #x9 :th #x9 :tcc #x1 :tfx #x1))
  (set! (-> this shadow-invert-frame) (new 'static 'gs-frame :fbp #x12e :fbw #x8 :fbmsk #xff000000))
  (set! (-> this shadow-dma-frame) (new 'static 'gs-frame :fbp #x196 :fbw #x8 :fbmsk #xffffff))
  (set! (-> this shadow-dma-tex0)
        (new 'static 'gs-tex0 :tbp0 #x32c0 :tbw #x8 :tw #x9 :th #x9 :tcc #x1 :tfx #x3)
        )
  (set-vector! (-> this shadow-texscale) 0.001953125 0.001953125 0.0 1.0)
  (set! (-> this blur-sx) 256)
  (set! (-> this blur-sy) 256)
  (set! (-> this blur-frame-0) (new 'static 'gs-frame :fbp #x4e :fbw #x4))
  (set! (-> this blur-frame-1) (new 'static 'gs-frame :fbp #x6e :fbw #x4))
  (set! (-> this blur-frame-a) (new 'static 'gs-frame :fbp #x4e :fbw #x4 :fbmsk #xffffff))
  (set! (-> this blur-tex0-0) (new 'static 'gs-tex0 :tbp0 #x9c0 :tbw #x4 :tw #x8 :th #x8))
  (set! (-> this blur-tex0-1) (new 'static 'gs-tex0 :tbp0 #xdc0 :tbw #x4 :tw #x8 :th #x8))
  (set! (-> this blur-tex0-a) (new 'static 'gs-tex0 :tbp0 #x9c0 :tbw #x4 :tw #x8 :th #x8 :tcc #x1))
  (set! (-> this blur-clamp) (new 'static 'gs-clamp
                               :wms (gs-tex-wrap-mode region-clamp)
                               :wmt (gs-tex-wrap-mode region-clamp)
                               :maxu #xff
                               :maxv #xff
                               )
        )
  (set! (-> this blur-scissor) (new 'static 'gs-scissor :scax1 #xff :scay1 #xff))
  (set! (-> this minx-on-screen) 0)
  (set! (-> this miny-on-screen) 0)
  (viewport-method-11 this)
  0
  (none)
  )


;; definition of type car-texture-anim-array-work
(deftype car-texture-anim-array-work (structure)
  ((sprite-tmpl  dma-gif-packet  :inline)
   )
  )

;; definition for method 3 of type car-texture-anim-array-work
(defmethod inspect ((this car-texture-anim-array-work))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'car-texture-anim-array-work)
  (format #t "~1Tsprite-tmpl: #<dma-gif-packet @ #x~X>~%" (-> this sprite-tmpl))
  (label cfg-4)
  this
  )

;; definition for symbol *car-texture-anim-array-work*, type car-texture-anim-array-work
(define *car-texture-anim-array-work* (new 'static 'car-texture-anim-array-work
                                        :sprite-tmpl (new 'static 'dma-gif-packet
                                          :dma-vif (new 'static 'dma-packet
                                            :dma (new 'static 'dma-tag :qwc #x41 :id (dma-tag-id cnt))
                                            :vif1 (new 'static 'vif-tag :imm #x41 :cmd (vif-cmd direct) :msk #x1)
                                            )
                                          :gif (new 'static 'array uint64 2 #x40ab400000008010 #x5353)
                                          )
                                        )
        )

;; definition for function car-texture-anim-layer-func
;; INFO: Used lq/sq
;; WARN: Return type mismatch int vs none.
(defun car-texture-anim-layer-func ((arg0 dma-buffer))
  (when (= (-> *viewport-array* num-viewports) 1)
    (let ((a1-2 (-> *viewport-array* data))
          (v1-3 *car-texture-anim-array-work*)
          )
      (dma-buffer-add-gs-set arg0
                             (tex0-1 (-> a1-2 0 tex0))
                             (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1))
                             (test-1 (new 'static 'gs-test :ate #x1 :afail #x3 :zte #x1 :ztst (gs-ztest always)))
                             (alpha-1 (new 'static 'gs-alpha))
                             (rgbaq (new 'static 'gs-rgbaq :r #x40 :g #x40 :b #x40 :a #x80 :q 1.0))
                             )
      (let ((a1-14 (the-as object (-> arg0 base))))
        (set! (-> (the-as (pointer uint128) a1-14)) (-> v1-3 sprite-tmpl dma-vif quad))
        (set! (-> (the-as (inline-array vector) a1-14) 1 quad) (-> v1-3 sprite-tmpl quad 1))
        )
      )
    (&+! (-> arg0 base) 32)
    (let ((v1-7 #x8000)
          (a1-15 #x8800)
          )
      (dotimes (a2-4 16)
        (let* ((a3-5 (-> arg0 base))
               (t2-0 (* a2-4 512))
               (t0-7 (+ t2-0 512))
               (t3-1 (+ #x8000 (* a2-4 128)))
               (t1-1 (+ t3-1 128))
               )
          (let ((t4-0 (the-as (pointer int32) (&+ a3-5 0))))
            (set! (-> t4-0 0) t2-0)
            (set! (-> t4-0 1) 6656)
            (set! (-> t4-0 2) 0)
            (set! (-> t4-0 3) 0)
            )
          (let ((t2-2 (the-as (pointer int32) (&+ a3-5 16))))
            (set! (-> t2-2 0) t3-1)
            (set! (-> t2-2 1) v1-7)
            (set! (-> t2-2 2) 0)
            (set! (-> t2-2 3) 0)
            )
          (let ((t2-3 (the-as (pointer int32) (&+ a3-5 32))))
            (set! (-> t2-3 0) t0-7)
            (set! (-> t2-3 1) 0)
            (set! (-> t2-3 2) 0)
            (set! (-> t2-3 3) 0)
            )
          (let ((a3-6 (the-as (pointer int32) (&+ a3-5 48))))
            (set! (-> a3-6 0) t1-1)
            (set! (-> a3-6 1) a1-15)
            (set! (-> a3-6 2) 0)
            (set! (-> a3-6 3) #x10000)
            )
          )
        (&+! (-> arg0 base) 64)
        )
      )
    )
  0
  (none)
  )


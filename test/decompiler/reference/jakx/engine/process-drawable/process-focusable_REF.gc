;;-*-Lisp-*-
(in-package goal)

;; definition of type process-focusable
(deftype process-focusable (process-drawable)
  ((self          process-focusable           :override)
   (ppointer      (pointer process-focusable) :override)
   (root          collide-shape               :override)
   (focus-status  focus-status)
   )
  (:methods
    (get-search-info-flag (_type_) search-info-flag)
    (get-trans (_type_ int) vector)
    (get-quat (_type_ int) quaternion)
    (get-vel (_type_) vector)
    (process-focusable-method-54 (_type_) object)
    (get-water-height (_type_) meters)
    (get-notice-time (_type_) time-frame)
    (process-focusable-method-57 (_type_) float)
    (process-focusable-method-58 (_type_) float)
    )
  )

;; definition for method 3 of type process-focusable
(defmethod inspect ((this process-focusable))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type process-drawable inspect)))
    (t9-0 this)
    )
  (format #t "~2Tfocus-status: ~D~%" (-> this focus-status))
  (label cfg-4)
  this
  )

;; definition for method 50 of type process-focusable
;; WARN: Return type mismatch int vs search-info-flag.
(defmethod get-search-info-flag ((this process-focusable))
  (let ((v0-0 0))
    (let ((v1-0 (-> this mask)))
      (if (logtest? (process-mask crate) v1-0)
          (set! v0-0 (logior v0-0 2))
          )
      (if (logtest? (process-mask enemy) v1-0)
          (set! v0-0 (logior v0-0 16))
          )
      )
    (the-as search-info-flag v0-0)
    )
  )

;; definition for method 51 of type process-focusable
;; WARN: Return type mismatch structure vs vector.
(defmethod get-trans ((this process-focusable) (arg0 int))
  "Get the `trans` for this process."
  (let ((gp-0 (-> this root)))
    (the-as vector (cond
                     ((zero? arg0)
                      (-> gp-0 trans)
                      )
                     ((and (= arg0 1) (type? gp-0 collide-shape-moving))
                      (-> (the-as collide-shape-moving gp-0) gspot-pos)
                      )
                     ((and (or (= arg0 2) (= arg0 3) (= arg0 10)) (type? gp-0 collide-shape))
                      (-> gp-0 root-prim prim-core)
                      )
                     (else
                       (-> gp-0 trans)
                       )
                     )
            )
    )
  )

;; definition for method 53 of type process-focusable
(defmethod get-vel ((this process-focusable))
  (-> this root transv)
  )

;; definition for method 52 of type process-focusable
(defmethod get-quat ((this process-focusable) (arg0 int))
  "Get the quaternion for this process."
  (-> this root rotation)
  )

;; definition for method 54 of type process-focusable
;; WARN: Return type mismatch int vs object.
(defmethod process-focusable-method-54 ((this process-focusable))
  0
  )

;; definition for method 55 of type process-focusable
;; WARN: Return type mismatch int vs meters.
(defmethod get-water-height ((this process-focusable))
  "Get the height of the water that we're in."
  (the-as meters 0)
  )

;; definition for method 57 of type process-focusable
(defmethod process-focusable-method-57 ((this process-focusable))
  0.0
  )

;; definition for method 56 of type process-focusable
;; WARN: Return type mismatch int vs time-frame.
(defmethod get-notice-time ((this process-focusable))
  (the-as time-frame 0)
  )

;; definition for method 58 of type process-focusable
(defmethod process-focusable-method-58 ((this process-focusable))
  -1.0
  )





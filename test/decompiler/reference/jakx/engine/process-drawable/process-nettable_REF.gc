;; definition for method 21 of type process-nettable
;; WARN: Return type mismatch int vs none.
(defmethod update-desired-owner ((this process-nettable))
  (when (!= (-> this desired-owner-idx) -1)
    (if (or (and (owner-is-local? this) (!= (-> this desired-owner-idx) (if *net-mgr*
                                                                            (-> *net-mgr* game-state local-machine-idx)
                                                                            0
                                                                            )
                                            )
                 )
            (and (unowned? this) (= (-> this desired-owner-idx) (if *net-mgr*
                                                                    (-> *net-mgr* game-state local-machine-idx)
                                                                    0
                                                                    )
                                    )
                 )
            (and (= (if *net-mgr*
                        (-> *net-mgr* game-state local-machine-idx)
                        0
                        )
                    (-> *net-mgr* game-state session-master-idx)
                    )
                 (and (has-owner? this)
                      (= (-> *net-process-mgr* machines (-> this owner-idx) state) (net-process-mgr-machine-state left))
                      )
                 )
            )
        (request-ownership *net-process-mgr* this (-> this desired-owner-idx))
        )
    )
  0
  (none)
  )


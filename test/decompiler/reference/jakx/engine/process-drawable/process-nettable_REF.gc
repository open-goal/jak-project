    (cond
      ((< v1-2 255)
       (&+! (-> arg0 base) 2)
       (set! (-> (the-as (pointer int8) (-> arg0 base))) v1-2)
       (send-process-msg *net-process-mgr* this arg0 arg1 arg2)
       (&+! (-> arg0 base) -2)
       )
      (else
        (let ((s2-0 (+ v1-2 2)))
          (format 0 "sending jumbo msg~%")
          (set! (-> (the-as (pointer int8) (-> arg0 base))) 255)
          (set! (-> (the-as (pointer int8) (-> arg0 base)) 1) (logand s2-0 255))
          (set! (-> (the-as (pointer int8) (-> arg0 base)) 2) (/ s2-0 256))
          )

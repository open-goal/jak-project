;; definition for method 31 of type process-nettable
;; WARN: Return type mismatch int vs none.
;; WARN: Function (method 31 process-nettable) has a return type of none, but the expression builder found a return statement.
(defmethod update-proximity-ownership ((this process-nettable) (arg0 vector))
  (if (not arg0)
      (set! arg0 (-> (the-as process-drawable this) root trans))
      )
  (if (zero? (-> this prox))
      (return #f)
      )
  (let ((s5-0 (-> *net-mgr* game-state time)))
    (if (< (- s5-0 (-> this prox last-ownership-req-time)) (-> this prox min-ownership-req-delay))
        (return #f)
        )
    (let ((s3-0 8))
      (let ((f30-0 (square (-> this prox ownable-radius))))
        0.0
        (dotimes (s2-0 *active-net-player-count*)
          (let ((s1-0 (get-vehicle (-> *active-net-players* s2-0))))
            (when s1-0
              (when (or (and (>= (-> *active-net-players* s2-0 player-id) 0) (< (-> *active-net-players* s2-0 player-id) 16))
                        (and (-> this prox consider-ai-players) (has-owner? s1-0))
                        )
                (let ((f0-3 (vector-vector-distance-squared arg0 (-> s1-0 root trans))))
                  (when (< f0-3 f30-0)
                    (set! f30-0 f0-3)
                    (set! s3-0 (-> s1-0 owner-idx))
                    )
                  )
                )
              )
            )
          )
        )
      (when (!= (-> this desired-owner-idx) s3-0)
        (set-desired-owner this s3-0 #f)
        (set! (-> this prox last-ownership-req-time) s5-0)
        )
      )
    )
  0
  (none)
  )


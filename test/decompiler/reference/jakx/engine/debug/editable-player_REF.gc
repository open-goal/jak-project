                    (let ((v1-15 (make-sound-instance (-> *sound-info* 314) 0 (the-as handle #f))))
                      (cond
                        (v1-15
                          (set! (-> v1-15 fo-power) 0.0)
                          (logior! (-> v1-15 flags) 328)
                          (-> v1-15 id)
                          )
                        (else
                          0
                          )
                        )
                      )
                    (format #t "EDITABLE: saved camera sample point for level ~A~%" arg0)
                    )
                   (else
                     (format 0 "ERROR: sql: insert error ~A~%" a2-2)
                     )
                   )
                 )
               )
             )
            (else
              (format 0 "ERROR: sql: select error ~A~%" s5-1)
              )
            )
          )
        )
      )
    (else
      (format 0 "ERROR: EDITABLE: no current level~%")
      )
    )
  0
  )

;; definition for symbol *debug-hook*, type pair
(define *debug-hook*
  (cons
    (lambda () (when (and *debug-segment* *manual-sample-point*)
                 (when (cpad-pressed? 1 select)
                   (cond
                     (*editable*
                       #f
                       )
                     (else
                       (dotimes (gp-0 6)
                         (let ((v1-10 (-> *level* level gp-0)))
                           (when (or (= (-> v1-10 status) 'active) (= (-> v1-10 status) 'reserved))
                             (if (not (logtest? *fix-visible-level-mask* (ash 1 (-> v1-10 index))))
                                 (insert-sample-camera (-> v1-10 name))
                                 )
                             )
                           )
                         )
                       #f
                       )
                     )
                   )
                 )
            )
    *debug-hook*
    )
  )





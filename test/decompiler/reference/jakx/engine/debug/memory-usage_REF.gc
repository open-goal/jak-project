  )

;; definition for method 11 of type memory-usage-block
;; INFO: Used lq/sq
(defmethod print-mem-usage ((this memory-usage-block) (arg0 level) (arg1 object))
  (let ((s3-0 (&- (-> arg0 heap current) (the-as uint (-> arg0 heap base)))))
    (let ((v1-2 (+ (-> this data 61 total) (-> this data 62 total))))
      (< #x10000 v1-2)
      )
    (let* ((v1-4 (-> arg0 info memory-mode))
           (v1-5 (cond
                   ((= v1-4 (level-memory-mode borrow0))
                    #xbd0000
                    )
                   ((= v1-4 (level-memory-mode micro))
                    #x9d8000
                    )
                   ((= v1-4 (level-memory-mode tiny))
                    #x4ec000
                    )
                   ((= v1-4 (level-memory-mode tiny-edge))
                    #x2f4000
                    )
                   ((= v1-4 (level-memory-mode tiny-center))
                    #x1f8000
                    )
                   ((= v1-4 (level-memory-mode small-edge))
                    #x600000
                    )
                   ((or (= v1-4 (level-memory-mode small-center))
                        (= v1-4 (level-memory-mode city-center))
                        (= v1-4 (level-memory-mode medium))
                        (= v1-4 (level-memory-mode large))
                        )
                    (+ (- #xc000 (the-as int (-> arg0 heap base))) (the-as int (-> arg0 heap top-base)))
                    )
                   ((= v1-4 (level-memory-mode alias))
                    #x8c000
                    )
                   ((= v1-4 (level-memory-mode borrow))
                    #x2f800
                    )
                   (else
                     #x9d8000
                     )
                   )
                 )
           (a0-19 (-> arg0 info memory-mode))
           (v1-8 (- (the-as int v1-5)
                    (the-as uint (if (or (= a0-19 (level-memory-mode alias)) (= a0-19 (level-memory-mode borrow)))
                                     0
                                     #xc000
                                     )
                            )
                    )
                 )
           (a0-22 0)
           )
      (when (-> arg0 info borrow)
        (dotimes (a1-10 3)
          (+! a0-22 (-> arg0 info borrow borrow-size a1-10))
          )
        )
      (let ((s2-0 (- v1-8 (shl a0-22 10)))
            (s1-0 (* (dma-buffer-length (-> *display* frames (-> *display* last-screen) global-buf)) 16))
            )
        (set! *max-dma* (max s1-0 *max-dma*))
        (if (< s2-0 s3-0)
            (format arg1 "~3L")
            )
        (let* ((s0-0 format)
               (sv-16 arg1)
               (sv-32 "~0K~10,'-S--~5,'-DK-of-~5,'-DK--~5,'-DK-of-~5,'-DK--")
               (s4-1 (-> arg0 name))
               (s3-1 (sar s3-0 10))
               (s2-1 (sar s2-0 10))
               (sv-48 (sar (memory-used *nk-dead-pool*) 10))
               (t2-0 (sar (memory-total *nk-dead-pool*) 10))
               (t0-0 s2-1)
               (t1-0 sv-48)
               )
          (s0-0 sv-16 sv-32 s4-1 s3-1 t0-0 t1-0 t2-0)
          (format arg1 "~5,'-DK/~5,'-DK--~%" (shr s1-0 10) (sar *max-dma* 10))
          (when (not *stats-memory-short*)
            (set! (-> *dma-mem-usage* data 87 total)
                  (* (dma-buffer-length (-> *display* frames (-> *display* last-screen) debug-buf)) 16)
                  )
            (let ((t9-7 format)
                  (a0-35 arg1)
                  (a1-16 "  bsp ~192H~5DK ~280Hdebug~456H~5DK~%")
                  (a2-9 (sar (+ (-> this data 58 total) (-> this data 59 total) (-> this data 60 total)) 10))
                  (a3-4 (sar (-> *dma-mem-usage* data 87 total) 10))
                  )
              (t9-7 a0-35 a1-16 a2-9 a3-4 (the-as none t0-0) (the-as none t1-0) (the-as none t2-0))
              (format
                arg1
                "  bsp-leaf-vis ~192H~5DK~%"
                (sar (+ (-> this data 61 total) (-> this data 62 total)) 10)
                (the-as none a3-4)
                )
              (format arg1 "  level-code ~192H~5DK~%" (sar (-> this data 65 total) 10) (the-as none a3-4))
              )
            (format
              arg1
              "  tfrag ~192H~5DK ~280Htfragment~456H~5DK~%"
              (sar
                (+ (-> this data 1 total)
                   (-> this data 2 total)
                   (-> this data 3 total)
                   (-> this data 4 total)
                   (-> this data 5 total)
                   (-> this data 6 total)
                   (-> this data 7 total)
                   (-> this data 8 total)
                   )
                10
                )
              (sar (-> *dma-mem-usage* data 1 total) 10)
              (the-as none t0-0)
              (the-as none t1-0)
              (the-as none t2-0)
              )
            (format
              arg1
              "  tie-proto ~192H~5DK ~280Hsky~456H~5DK~%"
              (sar
                (+ (-> this data 9 total)

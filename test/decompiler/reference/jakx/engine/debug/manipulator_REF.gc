           ((or (= (-> this action) (manipulator-action manip-action1))
                (= (-> this action) (manipulator-action manip-action2))
                (= (-> this action) (manipulator-action manip-action3))
                )
            (cond
              ((= (-> this action) (manipulator-action manip-action1))
               (cond
                 ((< (fabs (vector-dot s5-1 (-> this mat uvec))) (fabs (vector-dot s5-1 (-> this mat fvec))))
                  (set! (-> s2-0 quad) (-> this mat fvec quad))
                  (set! (-> s1-0 quad) (-> this mat uvec quad))
                  )

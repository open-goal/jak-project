                (.add.x.vf.w vf6 vf0 vf0)
                (.mul.x.vf.xyz acc vf5 vf7)
                (.add.mul.w.vf.xyz vf6 vf4 vf0 acc)
                (.svf (&-> sv-288 quad) vf6)
                (sv-176 sv-192 (the-as bucket-id sv-208) sv-224 sv-256 sv-288 (the-as int arg4))
                )
              )
            )

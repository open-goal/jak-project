                  (.lvf vf5 (&-> v1-22 quad))
                  )
                (.lvf vf4 (&-> sv-240 quad))
                )
              (.add.x.vf.w vf6 vf0 vf0)
              (.mul.x.vf.xyz acc vf5 vf7)
              (.add.mul.w.vf.xyz vf6 vf4 vf0 acc)
              (.svf (&-> sv-256 quad) vf6)
              (let ((sv-288 (new 'stack-no-clear 'vector)))
                (let ((sv-272 s0-1))
                  (let* ((a2-7 (quaternion-vector-angle!
                                 (new 'stack-no-clear 'quaternion)

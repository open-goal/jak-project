             ,(lambda ((arg0 int) (arg1 debug-menu-msg) (arg2 float)) (auto-save-command 'save 0 0 *default-pool* #f #f))
             )
           (function
             "Load Game"
             #f
             ,(lambda ((arg0 int) (arg1 debug-menu-msg) (arg2 float))
                (auto-save-command 'restore 0 0 *default-pool* #f #f)
                )
             )
           (function
             "Manager Complete"
             #f
             ,(lambda ((arg0 int) (arg1 debug-menu-msg)) (script-eval '(send-event *task-manager* 'complete)))
             )
           (flag "Target" #f ,(lambda ((arg0 int) (arg1 debug-menu-msg))
                                (when (= arg1 (debug-menu-msg press))
                                  (if (view-get-active-target)
                                      (stop 'debug 0)
                                      (start 'debug (the-as continue-point #f) 0)
                                      )
                                  )
                                (view-get-active-target)
                                )
                 )
           (flag "Game Mode" play dm-game-mode-pick-func)
           (flag "Debug Mode" debug dm-game-mode-pick-func)
           (menu
             "Player 1 Controls"
             (flag "Evan" 1 dm-setting-player1-controls)
             (flag "Yasuhara" 2 dm-setting-player1-controls)
             (flag "l1-r1-l2-r2-JFTR" 4 dm-setting-player1-controls)
             (flag "l1-r1-l2-r2-FJRT" 8 dm-setting-player1-controls)
             (flag "swap-JT" 16 dm-setting-player1-controls)
             )
           (menu
             "Player 2 Controls"
             (flag "Evan" 1 dm-setting-player2-controls)
             (flag "Yasuhara" 2 dm-setting-player2-controls)
             (flag "l1-r1-l2-r2-JFTR" 4 dm-setting-player2-controls)
             (flag "l1-r1-l2-r2-FJRT" 8 dm-setting-player2-controls)
             (flag "swap-JT" 16 dm-setting-player2-controls)
             )
           (menu
             "Vehicle tuning"
             (int-var "engine" 0 dm-setting-vehicle-tuning-engine 2 1 #t 0 10)
             (int-var "gearbox" 0 dm-setting-vehicle-tuning-gearbox 2 1 #t 0 10)
             (int-var "armor" 0 dm-setting-vehicle-tuning-armor 2 1 #t 0 10)
             (int-var "turbo" 0 dm-setting-vehicle-tuning-turbo 2 1 #t 0 10)
             )
           (function
             "Stop Watch Start"
             #f
             ,(lambda ((arg0 int) (arg1 debug-menu-msg))
                (remove-by-param0 *debug-engine* stop-watch-display)
                (add-connection *debug-engine* *dproc* stop-watch-display *dproc* *stdcon0* #f)
                (set! (-> *game-info* stop-watch-start) (-> *display* base-clock frame-counter))
                (set! (-> *game-info* stop-watch-stop) 0)
                (format #t "Stop watch started!~%")
                )
             )
           (function
             "Stop Watch Stop"
             #f
             ,(lambda ((arg0 int) (arg1 debug-menu-msg))
                (remove-by-param0 *debug-engine* stop-watch-display)
                (set! (-> *game-info* stop-watch-stop) (-> *display* base-clock frame-counter))
                (let ((v1-7 (- (-> *game-info* stop-watch-stop) (-> *game-info* stop-watch-start))))
                  (format
                    #t
                    "Stop watch elasped time was ~D:~D:~D~%"
                    (/ v1-7 #x4650)
                    (/ (mod v1-7 #x4650) 300)
                    (/ (* 100 (mod v1-7 300)) 300)
                    )
                  )
                )
             )
           (function
             "Continue Start"
             #f
             ,(lambda ((arg0 int) (arg1 debug-menu-msg))
                (start 'play (-> *game-info* player-info (view-get-active-index) current-continue) 0)
                )
             )
           (function "Disable HUD" #f ,(lambda () (let ((v0-0 (not *debug-hud-disable*)))
                                                    (set! *debug-hud-disable* v0-0)
                                                    v0-0
                                                    )
                                               )
                     )
           (function "Kiosk Reset" #f ,(lambda () (auto-save-command 'restore 0 0 *default-pool* #f #f)))
           (function "Get All Vehicles" #f ,(lambda ()
                                              (dotimes (v1-0 15)
                                                (let ((a0-2 (-> *game-info* car-info data v1-0)))
                                                  (logior! (-> a0-2 flags) (car-info-flag cif0))
                                                  )
                                                )
                                              #f
                                              )
                     )
           (function "Get All Vehicles Parts" #f ,(lambda ()
                                                    (dotimes (v1-0 (-> *car-part-info-arrays* length))
                                                      (dotimes (a0-0 (-> *car-part-info-arrays* v1-0 length))
                                                        (logior! (-> *car-part-info-arrays* v1-0 a0-0 flags) 6)
                                                        )
                                                      )
                                                    #f
                                                    )
                     )
           (function "Get All Tasks" #f ,(lambda ()
                                           (let ((v1-1 (-> *game-info* sub-task-list)))
                                             (dotimes (a0-0 (-> v1-1 length))
                                               (when (nonzero? a0-0)
                                                 (let ((a1-3 (-> v1-1 a0-0)))
                                                   (set! (-> a1-3 play-count) (the-as uint 1))
                                                   (set! (-> a1-3 medals 0) (game-task-medal gold))
                                                   (set! (-> a1-3 unlocked) (the-as uint 1))
                                                   )
                                                 )
                                               )
                                             )
                                           (dotimes (v1-4 (-> *task-level-info* length))
                                             (let ((a0-3 (-> *task-level-info* v1-4)))
                                               (logior! (-> a0-3 flags) (task-level-info-flag tli0))
                                               )
                                             )
                                           (set! (-> *game-info* grand-prix 0 trophy) (the-as uint 3))
                                           (set! (-> *game-info* grand-prix 1 trophy) (the-as uint 3))
                                           (set! (-> *game-info* grand-prix 2 trophy) (the-as uint 3))
                                           (let ((v0-0 3))
                                             (set! (-> *game-info* grand-prix 3 trophy) (the-as uint v0-0))
                                             v0-0
                                             )
                                           )
                     )
           (function "Get All Venues" #f ,(lambda ()
                                            (let* ((v1-1 (-> *task-level-info* length))
                                                   (a0-0 0)
                                                   (a1-2 (-> *task-level-info* a0-0))
                                                   )
                                              (while (< a0-0 v1-1)
                                                (logior! (-> a1-2 flags) (task-level-info-flag tli0))
                                                (+! a0-0 1)
                                                (set! a1-2 (-> *task-level-info* a0-0))
                                                )
                                              )
                                            #f
                                            )
                     )
           (function "Get All Drivers" #f ,(lambda () (let ((v0-0 -1))
                                                        (set! (-> *game-info* driver-unlock) (the-as uint v0-0))
                                                        v0-0
                                                        )
                                                   )
                     )
           (function
             "C.R.E.A.M. - Mad Cash"
             #f
             ,(lambda ()
                (set! (-> *game-info* player-info 0 cash) 1000000.0)
                (set! (-> *game-info* player-info 1 cash) 1000000.0)
                )
             )
           (function
             "Trick Out Vehicles"
             #f
             ,(lambda ((arg0 int) (arg1 debug-menu-msg) (arg2 float))
                (dotimes (v1-0 15)
                  (let ((a0-3 (-> *game-info* car-info data v1-0))
                        (a1-4 (-> *car-upgrade-info* data v1-0))
                        )
                    (set! (-> a0-3 tuning) (logior (logand (-> a0-3 tuning) -256) (shr (shl (-> a1-4 data 0 max) 56) 56)))
                    (set! (-> a0-3 tuning) (logior (logand (-> a0-3 tuning) -65281) (shr (shl (-> a1-4 data 1 max) 56) 48)))
                    (set! (-> a0-3 tuning) (logior (logand (-> a0-3 tuning) -16711681) (shr (shl (-> a1-4 data 2 max) 56) 40)))
                    (set! (-> a0-3 tuning)
                          (logior (logand (-> a0-3 tuning) (the-as uint #xffffffff00ffffff)) (shr (shl (-> a1-4 data 3 max) 56) 32))
                          )
                    )
                  )
                #f
                )
             )
           (menu

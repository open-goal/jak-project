;; definition for function debug-create-cam-restore
;; WARN: Return type mismatch object vs none.
(defun debug-create-cam-restore ()
  (cond
    ((view-get-active-math-camera)
     (format #t "(defun-debug cam-restore ()~%")
     (format #t " ;;this function is a hack, don't use it as an example~%")
     (format #t " (let ((pos (new 'stack 'vector))~%")
     (format #t "       (rot (new 'stack 'matrix)))~%")
     (format #t "  (set! (-> pos x) ~12F)~%" (-> (view-get-active-math-camera) trans x))
     (format #t "  (set! (-> pos y) ~12F)~%" (-> (view-get-active-math-camera) trans y))
     (format #t "  (set! (-> pos z) ~12F)~%" (-> (view-get-active-math-camera) trans z))
     (format #t "  (set! (-> pos w) 1.0)~%")
     (format #t "  (set! (-> rot data  0) ~12F)~%" (-> (view-get-active-math-camera) inv-camera-rot rvec x))
     (format #t "  (set! (-> rot data  1) ~12F)~%" (-> (view-get-active-math-camera) inv-camera-rot rvec y))
     (format #t "  (set! (-> rot data  2) ~12F)~%" (-> (view-get-active-math-camera) inv-camera-rot rvec z))
     (format #t "  (set! (-> rot data  3) ~12F)~%" (-> (view-get-active-math-camera) inv-camera-rot rvec w))
     (format #t "  (set! (-> rot data  4) ~12F)~%" (-> (view-get-active-math-camera) inv-camera-rot uvec x))
     (format #t "  (set! (-> rot data  5) ~12F)~%" (-> (view-get-active-math-camera) inv-camera-rot uvec y))
     (format #t "  (set! (-> rot data  6) ~12F)~%" (-> (view-get-active-math-camera) inv-camera-rot uvec z))
     (format #t "  (set! (-> rot data  7) ~12F)~%" (-> (view-get-active-math-camera) inv-camera-rot uvec w))
     (format #t "  (set! (-> rot data  8) ~12F)~%" (-> (view-get-active-math-camera) inv-camera-rot fvec x))
     (format #t "  (set! (-> rot data  9) ~12F)~%" (-> (view-get-active-math-camera) inv-camera-rot fvec y))
     (format #t "  (set! (-> rot data 10) ~12F)~%" (-> (view-get-active-math-camera) inv-camera-rot fvec z))
     (format #t "  (set! (-> rot data 11) ~12F)~%" (-> (view-get-active-math-camera) inv-camera-rot fvec w))
     (format #t "  (set! (-> rot data 12) ~12F)~%" 0)
     (format #t "  (set! (-> rot data 13) ~12F)~%" 0)
     (format #t "  (set! (-> rot data 14) ~12F)~%" 0)
     (format #t "  (set! (-> rot data 15) ~12F)~%" #x3f800000)
     (let ((gp-15 (new 'stack-no-clear 'euler-angles)))
       (matrix->eul gp-15 (-> (view-get-active-math-camera) inv-camera-rot) 21)
       (format #t "  ;; euler angles (xyz order degrees) x ~R y ~R z ~R~%" (-> gp-15 x) (-> gp-15 y) (-> gp-15 z))
       (format
         #t
         "  ;; MAYA euler angles (xyz order degrees) x ~R y ~R z ~R~%"
         (-> gp-15 x)
         (- 32768.0 (-> gp-15 y))
         (-> gp-15 z)
         )
       )
     (format #t "  (debug-set-camera-pos-rot! pos rot)~%")
     (format
       #t
       "  (send-event *camera* 'set-fov (deg ~f))~%"
       (* 0.005493164 (-> (view-get-active-math-camera) fov))
       )
     (format #t "  (clear *camera-old-level*)~%")
     (format #t "  (format *camera-old-level* \"~A\")~%" (-> *level* level0 name))
     (let ((t9-49 format)
           (a0-31 #t)
           (a1-31 "  (set! *camera-old-cpu* ~D)~%")
           (a2-25 (-> *display* frames (-> *display* last-screen) profile-array data 0))
           )
       (t9-49 a0-31 a1-31 (- (-> a2-25 data 0 end-time) (-> a2-25 data 0 start-time)))
       )
     (let ((t9-50 format)
           (a0-32 #t)
           (a1-32 "  (set! *camera-old-vu*  ~D)~%")
           (a2-29 (-> *display* frames (-> *display* on-screen) profile-array data 1))
           )
       (t9-50 a0-32 a1-32 (- (-> a2-29 data 0 end-time) (-> a2-29 data 0 start-time)))
       )
     (compute-memory-usage! (-> *level* level) #f)
     (format #t "   (set! *camera-old-tfrag-bytes* ~D)~%" (+ (-> *level* level0 mem-usage-block data 1 total)
                                                             (-> *level* level0 mem-usage-block data 2 total)
                                                             (-> *level* level0 mem-usage-block data 3 total)
                                                             (-> *level* level0 mem-usage-block data 4 total)
                                                             (-> *level* level0 mem-usage-block data 5 total)
                                                             (-> *level* level0 mem-usage-block data 6 total)
                                                             (-> *level* level0 mem-usage-block data 7 total)
                                                             (-> *level* level0 mem-usage-block data 8 total)
                                                             )
             )
     (format #t "   (clear *camera-old-stat-string-tfrag*)~%")
     (format #t "   (clear *camera-old-stat-string-tfrag-near*)~%")
     (format #t "   (clear *camera-old-stat-string-total*)~%")
     (when *stats-poly*
       (format #t "   (format *camera-old-stat-string-tfrag*      \"~S\")~%" *stat-string-tfrag*)
       (format #t "   (format *camera-old-stat-string-tfrag-near* \"~S\")~%" *stat-string-tfrag-scissor*)
       (format #t "   (format *camera-old-stat-string-total*      \"~S\")~%" *stat-string-total*)
       )
     (format #t "   (set! *display-camera-old-stats* #t)~%")
     (format #t "  )~%")
     (format #t " )~%")
     )
    (else
      (format #t "camera save failed~%")
      )
    )
  (none)
  )


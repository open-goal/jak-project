    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'huf-dictionary-node)
  (format #t "~1Tzero: ~D~%" (-> this zero))
  (format #t "~1Tone: ~D~%" (-> this one))
  (label cfg-4)
  this
  )


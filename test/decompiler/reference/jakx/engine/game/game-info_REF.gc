;; definition for method 9 of type game-info
;; INFO: Used lq/sq
(defmethod reset ((this game-info) (arg0 symbol) (arg1 game-save) (arg2 continue-point) (arg3 symbol))
  (format 0 "(game-info::reset) ~S~%" arg0)
  (when (or (and (= arg0 'game) (= *lobby-reset-mode* #f)) (and (= arg0 'game) (demo?)))
    (when (demo?)
      (jukebox-onoff #f)
      (send-event *lobby-menu-manager* 'die-fast)
      )
    (send-event *net-mgr* 'leave-game)
    )
  (let ((s2-0 (view-get-active-index)))
    (when (and arg2 (= (-> arg2 type) string))
      (let ((s0-0 (get-continue-by-name this (the-as string arg2))))
        (when (not s0-0)
          (format 0 "ERROR: attempting to reset to continue ~A when it doesn't exist~%" arg2)
          (break!)
          0
          )
        (set! arg2 s0-0)
        )
      )
    (kill-current-talker '() '() 'die)
    (case arg0
      (('game 'boot 'new-game)
       (+! (-> this task-counter) 1)
       (reset! (-> *display* total-game-clock))
       (set! (-> this features) (game-feature gun))
       (set! (-> this debug-features) (game-feature))
       (set! (-> this old-features) (game-feature))
       (set! (-> this items) (the-as uint 0))
       (set! (-> this debug-items) (the-as uint 0))
       (set! (-> this old-items) (the-as uint 0))
       (set! (-> this vehicles) (game-vehicles))
       (set! (-> this debug-vehicles) (game-vehicles))
       (set! (-> this old-vehicles) (game-vehicles))
       (set! (-> this secrets) (game-secrets))
       (set! (-> this purchase-secrets) (game-secrets))
       (set! (-> this current-vehicle) (the-as uint 0))
       (let* ((s0-1 this)
              (sv-112 (method-of-object s0-1 set-continue!))
              )
         (sv-112
           s0-1
           (cond
             (arg2
               arg2
               )
             ((demo?)
              "fmv-intro"
              )
             ((kiosk?)
              "fmv-intro"
              )
             ((= arg0 'game)
              "menu2-start"
              )
             ((and *debug-segment* (= arg0 'boot))
              "menu2-start"
              )
             (else
               "fmv-intro"
               )
             )
           s2-0
           #f
           )
         )
       (set! (-> this auto-save-count) 0)
       (if (not arg1)
           (set! (-> *setting-control* user-default auto-save) #f)
           )
       (set! (-> this perm-list length) 0)
       (dotimes (v1-38 (-> this talker-state allocated-length))
         (set! (-> this talker-state v1-38) (the-as uint 0))
         )
       (set! (-> this death-movie-tick) (rand-vu-int-count 10))
       (set! (-> this goal) 0.0)
       (set! (-> this miss) 0.0)
       (set! (-> this miss-max) 0.0)
       (set! (-> this attack-id) (the-as uint 2))
       (set! (-> this total-trys) 0)
       (set! (-> this total-deaths) 0)
       (set! (-> this continue-deaths) 0)
       (set! (-> this task-deaths) 0)
       (set! (-> this game-start-time) (-> *display* game-clock frame-counter))
       (set! (-> this task-pickup-time) (-> *display* game-clock frame-counter))
       (set! (-> this continue-time) (-> *display* game-clock frame-counter))
       (set! (-> this death-time) (-> *display* game-clock frame-counter))
       (set! (-> this hit-time) (-> *display* game-clock frame-counter))
       (dotimes (v1-57 32)
         (set! (-> this level-opened v1-57) (the-as uint 0))
         (nop!)
         )
       (let ((v1-61 (-> *game-info* sub-task-list)))
         (dotimes (a0-24 (-> v1-61 length))
           (when (nonzero? a0-24)
             (let ((a1-14 (-> v1-61 a0-24)))
               (set! (-> a1-14 close-time) (the-as uint 0))
               (set! (-> a1-14 play-count) (the-as uint 0))
               (set! (-> a1-14 medals 0) (game-task-medal none))
               (set! (-> a1-14 unlocked) (the-as uint 0))
               (set! (-> a1-14 user-advanced-options lword) (-> a1-14 default-advanced-options lword))
               (when (nonzero? (-> a1-14 high-scores))
                 (dotimes (a2-8 5)
                   (set! (-> a1-14 high-scores a2-8) (-> a1-14 high-scores-default a2-8))
                   )
                 )
               )
             )
           )
         )
       (set! (-> this playing-grand-prix?) #f)
       (dotimes (v1-64 (-> this grand-prix length))
         (set! (-> this grand-prix v1-64 trophy) (the-as uint 0))
         (set! (-> this grand-prix v1-64 play-count) (the-as uint 0))
         )
       (dotimes (v1-67 (-> this game-movie length))
         (logand! (-> this game-movie v1-67 flags) -2)
         )
       (set! *lobby-adv-selected-task* 0)
       (if arg3
           (logior! (-> *game-info* secrets) (game-secrets hero-mode))
           )
       (when (not arg3)
         (dotimes (v1-75 2)
           (let ((a0-40 (-> this player-info v1-75)))
             (set! (-> a0-40 vehicle) (the-as handle #f))
             (set! (-> a0-40 cash) 0.0)
             (set! (-> a0-40 last-selected-vehicle) (the-as uint 1))
             )
           )
         (dotimes (s1-1 15)
           (let ((s0-2 (-> this car-info data s1-1)))
             (set! (-> s0-2 car-type) s1-1)
             (set! (-> s0-2 base-color quad) (-> *car-default-base-color* s1-1 quad))
             (set! (-> s0-2 stripe-color quad) (-> *car-default-stripe-color* s1-1 quad))
             (set! (-> s0-2 flags) (car-info-flag))
             (if (or (= s1-1 1) (= s1-1 3))
                 (logior! (-> s0-2 flags) (car-info-flag cif0))
                 )
             (let ((sv-128 0))
               (while (< sv-128 11)
                 (let ((v1-94 1))
                   (case sv-128
                     ((6)
                      (if (zero? s1-1)
                          (set! v1-94 2)
                          )
                      )
                     ((8)
                      (let ((a0-48 s1-1))
                        (cond
                          ((zero? a0-48)
                           (set! v1-94 (+ (log2 2048) 1))
                           )
                          ((= a0-48 13)
                           (set! v1-94 (+ (log2 #x8000) 1))
                           )
                          ((= a0-48 14)
                           (set! v1-94 (+ (log2 128) 1))
                           )
                          )
                        )
                      )
                     ((9 10)
                      (set! v1-94 0)
                      )
                     )
                   (set! (-> s0-2 current-parts sv-128) v1-94)
                   )
                 (+! sv-128 1)
                 )
               )
             (let ((v1-102 (-> *car-upgrade-info* data s1-1)))
               (set! (-> s0-2 tuning) (logior (logand (-> s0-2 tuning) -256) (shr (shl (-> v1-102 data 0 base) 56) 56)))
               (set! (-> s0-2 tuning) (logior (logand (-> s0-2 tuning) -65281) (shr (shl (-> v1-102 data 1 base) 56) 48)))
               (set! (-> s0-2 tuning) (logior (logand (-> s0-2 tuning) -16711681) (shr (shl (-> v1-102 data 2 base) 56) 40)))
               (set! (-> s0-2 tuning)
                     (logior (logand (-> s0-2 tuning) (the-as uint #xffffffff00ffffff)) (shr (shl (-> v1-102 data 3 base) 56) 32))
                     )
               )
             )
           )
         (dotimes (v1-109 (-> *car-part-info-arrays* length))
           (dotimes (a0-73 (-> *car-part-info-arrays* v1-109 length))
             (logand! (-> *car-part-info-arrays* v1-109 a0-73 flags) -3)
             (if (logtest? (-> *car-part-info-arrays* v1-109 a0-73 flags) 1)
                 (logior! (-> *car-part-info-arrays* v1-109 a0-73 flags) 6)
                 )
             )
           )
         (dotimes (v1-112 (-> *m2v-info* length))
           (set! (-> *m2v-info* v1-112 idx) 0)
           )
         (set! (-> *m2v-info* 0 idx) 1)
         (let ((s1-2 (new 'stack 'scf-time)))
           (scf-get-time s1-2)
           (set! (-> *game-info* byte0) (the-as int (-> s1-2 minute)))
           )
         (set! (-> this driver-unlock) (the-as uint 0))
         (logior! (-> this driver-unlock) 1)
         (logior! (-> this driver-unlock) 2)
         (logior! (-> this driver-unlock) 512)
         (logior! (-> this driver-unlock) 32)
         (logior! (-> this driver-unlock) 64)
         (logior! (-> this driver-unlock) 128)
         (set! (-> this driver-award) (-> this driver-unlock))
         (dotimes (v1-131 (-> *task-level-info* length))
           (logclear! (-> *task-level-info* v1-131 flags) (task-level-info-flag tli0))
           )
         (logior! (-> *task-level-info* 2 flags) (task-level-info-flag tli0))
         (logior! (-> *task-level-info* 19 flags) (task-level-info-flag tli0))
         (logior! (-> *task-level-info* 4 flags) (task-level-info-flag tli0))
         (logior! (-> *task-level-info* 3 flags) (task-level-info-flag tli0))

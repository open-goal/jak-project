    (dotimes (s4-0 (-> s5-0 length))
      (when (nonzero? s4-0)
        (let ((v1-4 (-> s5-0 s4-0)))
          (if (string= arg0 (-> v1-4 name))
              (return s4-0)
              )
          )
        )
      )
    )
  0
  )

;; definition for symbol *default-continue*, type continue-point
(define *default-continue* (new 'static 'continue-point
                             :name "default"
                             :level #f
                             :flags (continue-flags change-continue)
                             :trans (new 'static 'vector :w 1.0)
                             :camera-trans (new 'static 'vector :w 1.0)
                             :quat (new 'static 'vector4h :data (new 'static 'array int16 4 0 0 0 #x7fff))
                             :on-goto #f
                             :vis-nick #f
                             :vehicle-type #x14
                             :want-count 10
                             :want (new 'static 'inline-array level-buffer-state-small 10
                               (new 'static 'level-buffer-state-small :name 'dummy :display? #f)
                               (new 'static 'level-buffer-state-small :name 'dummy :display? #f)
                               (new 'static 'level-buffer-state-small :name 'dummy :display? #f)
                               (new 'static 'level-buffer-state-small :name 'dummy :display? #f)
                               (new 'static 'level-buffer-state-small :name 'dummy :display? #f)
                               (new 'static 'level-buffer-state-small :name 'dummy :display? #f)
                               (new 'static 'level-buffer-state-small :name 'dummy :display? #f)
                               (new 'static 'level-buffer-state-small :name 'dummy :display? #f)
                               (new 'static 'level-buffer-state-small :name 'dummy :display? #f)
                               (new 'static 'level-buffer-state-small :name 'dummy :display? #f)
                               )
                             :want-sound (new 'static 'array symbol 1 #f)
                             )
        )

;; definition for method 10 of type continue-point
;; INFO: Used lq/sq
;; WARN: Return type mismatch continue-point vs none.
(defmethod continue-point-method-10 ((this continue-point) (arg0 load-state))
  (let ((v1-0 (lookup-level-info (-> this vis-nick))))
    (set! (-> this vis-nick) (if v1-0
                                 (-> v1-0 name)
                                 )
          )
    )
  (dotimes (v1-1 (-> this want-count))
    (set! (-> this want v1-1 name) (-> arg0 want v1-1 name))
    (set! (-> this want v1-1 display?) (-> arg0 want v1-1 display?))
    )
  (dotimes (v1-4 1)
    (set! (-> this want-sound v1-4) (-> arg0 want-sound v1-4 name))
    )
  (set! (-> this camera-trans quad) (-> (the-as camera-combiner (view-get-active-camera-combiner)) trans quad))
  (when (view-get-active-camera-combiner)
    (let ((a0-13 (-> (the-as camera-combiner (view-get-active-camera-combiner)) inv-camera-rot))
          (v1-10 (-> this camera-rot))
          )
      (set! (-> v1-10 0) (the int (* 32767.0 (-> a0-13 rvec x))))
      (set! (-> v1-10 1) (the int (* 32767.0 (-> a0-13 rvec y))))
      (set! (-> v1-10 2) (the int (* 32767.0 (-> a0-13 rvec z))))
      (set! (-> v1-10 3) (the int (* 32767.0 (-> a0-13 uvec x))))
      (set! (-> v1-10 4) (the int (* 32767.0 (-> a0-13 uvec y))))
      (set! (-> v1-10 5) (the int (* 32767.0 (-> a0-13 uvec z))))
      (set! (-> v1-10 6) (the int (* 32767.0 (-> a0-13 fvec x))))
      (set! (-> v1-10 7) (the int (* 32767.0 (-> a0-13 fvec y))))
      (set! (-> v1-10 8) (the int (* 32767.0 (-> a0-13 fvec z))))
      )
    )
  (load-state-method-22 arg0)
  (none)
  )

;; definition for method 11 of type continue-point
;; INFO: Used lq/sq
(defmethod continue-point-method-11 ((this continue-point))
  (set! (-> (the-as camera-combiner (view-get-active-camera-combiner)) trans quad) (-> this camera-trans quad))
  (let ((gp-0 (-> (the-as camera-combiner (view-get-active-camera-combiner)) inv-camera-rot))
        (s5-1 (-> this camera-rot))
        )
    (matrix-identity! gp-0)
    (set! (-> gp-0 rvec x) (* 0.00003051851 (the float (-> s5-1 0))))
    (set! (-> gp-0 rvec y) (* 0.00003051851 (the float (-> s5-1 1))))
    (set! (-> gp-0 rvec z) (* 0.00003051851 (the float (-> s5-1 2))))
    (set! (-> gp-0 uvec x) (* 0.00003051851 (the float (-> s5-1 3))))
    (set! (-> gp-0 uvec y) (* 0.00003051851 (the float (-> s5-1 4))))
    (set! (-> gp-0 uvec z) (* 0.00003051851 (the float (-> s5-1 5))))
    (set! (-> gp-0 fvec x) (* 0.00003051851 (the float (-> s5-1 6))))
    (set! (-> gp-0 fvec y) (* 0.00003051851 (the float (-> s5-1 7))))
    (set! (-> gp-0 fvec z) (* 0.00003051851 (the float (-> s5-1 8))))
    )
  (send-event (view-get-active-camera) 'change-target (view-get-active-target))
  (cam-master-activate-slave #t)
  0
  )

;; definition for method 17 of type game-info
(defmethod get-current-continue-forced ((this game-info) (arg0 int))
  (cond
    ((-> this player-info arg0 current-continue)
     (-> this player-info arg0 current-continue)
     )
    (else
      (let ((gp-0 *default-continue*))
        (position-in-front-of-camera! (-> gp-0 trans) 40960.0 4096.0)
        (set-vector! (-> gp-0 quat) 0 0 0 #x7fff)
        (continue-point-method-10 gp-0 *load-state*)
        gp-0
        )
      )
    )
  )

;; definition for method 18 of type game-info
;; WARN: Return type mismatch object vs continue-point.
(defmethod get-continue-by-name ((this game-info) (arg0 string))
  (if (not arg0)
      (return (the-as continue-point #f))
      )
  (let ((s5-0 (the-as object *level-load-list*)))
    (while (not (null? s5-0))
      (let ((s4-0
              (the-as object (-> (the-as level-load-info (-> (the-as symbol (-> (the-as pair s5-0) car)) value)) continues))
              )
            )
        (while (not (null? s4-0))
          (let ((s3-0 (-> (the-as pair s4-0) car)))
            (if (string= arg0 (-> (the-as continue-point s3-0) name))
                (return (the-as continue-point s3-0))
                )
            )
          (set! s4-0 (-> (the-as pair s4-0) cdr))
          )
        )
      (set! s5-0 (-> (the-as pair s5-0) cdr))
      )
    )
  (the-as continue-point #f)
  )

;; definition for method 19 of type game-info
;; WARN: Return type mismatch object vs continue-point.
(defmethod get-continue-by-name-active-lvl ((this game-info) (arg0 string))
  (if (not arg0)
      (return (the-as continue-point #f))
      )
  (dotimes (s5-0 19)
    (when (and (nonzero? (-> *level* level s5-0)) (-> *level* level s5-0))
      (let ((s4-0 (the-as object (-> *level* level s5-0 info continues))))
        (while (not (null? s4-0))
          (let ((s3-0 (-> (the-as pair s4-0) car)))
            (if (string= arg0 (-> (the-as continue-point s3-0) name))
                (return (the-as continue-point s3-0))
                )
            )
          (set! s4-0 (-> (the-as pair s4-0) cdr))
          )
        )
      )
    )
  (the-as continue-point #f)
  )

;; definition for method 20 of type game-info
(defmethod set-continue! ((this game-info) (arg0 basic) (arg1 int) (arg2 symbol))
  (let ((s4-0 (-> this player-info arg1 current-continue)))
    (if (null? arg0)
        (set! arg0 (the-as basic #f))
        )
    (case (rtype-of arg0)
      ((string)
       (let ((v1-9 (get-continue-by-name this (the-as string arg0))))
         (if v1-9
             (set! (-> this player-info arg1 current-continue) v1-9)
             )
         )
       )
      ((continue-point)
       (set! (-> this player-info arg1 current-continue) (the-as continue-point arg0))
       )
      (else
        (let ((s2-3 *default-continue*))
          (position-in-front-of-camera! (-> s2-3 trans) 40960.0 4096.0)
          (set-vector! (-> s2-3 quat) 0 0 0 #x7fff)
          (let ((v1-14 (lookup-level-info (-> *load-state* vis-nick))))
            (set! (-> s2-3 vis-nick) (if v1-14
                                         (-> v1-14 name)
                                         )
                  )
            )
          (dotimes (v1-15 (-> s2-3 want-count))
            (set! (-> s2-3 want v1-15 name) (-> *load-state* want v1-15 name))
            (set! (-> s2-3 want v1-15 display?) (-> *load-state* want v1-15 display?))
            )
          (dotimes (v1-18 1)
            (set! (-> s2-3 want-sound v1-18) (-> *load-state* want-sound v1-18 name))
            )
          (set! (-> this player-info arg1 current-continue) s2-3)
          )
        )
      )
    (if (and (logtest? (-> this player-info arg1 current-continue flags) (continue-flags change-continue))
             (and (!= (-> this player-info arg1 current-continue) *default-continue*) (not arg2))
             )
        (set! (-> this player-info arg1 current-continue) s4-0)
        )
    (when (!= s4-0 (-> this player-info arg1 current-continue))
      (set! (-> this continue-deaths) 0)
      (set! (-> this continue-time) (-> *display* game-clock frame-counter))
      )
    )
  (-> this player-info arg1 current-continue)
  )

;; definition for method 28 of type game-info
(defmethod calculate-percentage ((this game-info))
  (let ((v1-0 0)
        (a0-1 0)
        )
    0.0
    (let ((a1-1 (-> *game-info* sub-task-list)))
      (dotimes (a2-0 (-> a1-1 length))
        (when (nonzero? a2-0)
          (let ((a3-3 (-> a1-1 a2-0)))
            (when (and (-> *game-info* play-list (-> a3-3 task) play-continue)
                       (-> *game-info* play-list (-> a3-3 task) single-player)
                       (>= (-> a3-3 adv-score) 0)
                       )
              (+! v1-0 3)
              (+! a0-1 (the-as int (-> a3-3 medals 0)))
              )
            )
          )
        )
      )
    (dotimes (a1-4 4)
      (+! v1-0 3)
      (+! a0-1 (-> *game-info* grand-prix a1-4 trophy))
      )
    (/ (* 100.0 (the float a0-1)) (the float v1-0))
    )
  )

;; definition for function task-level->string

                           sog23
                           sog24
                           sog25
                           sog26
                           sog27
                           sog28
                           sog29
                           sog30
                           sog31
                           )
                         )
      (add-setting! 'process-mask 'set 0.0 (process-mask freeze pause menu))
      )
    )
  :exit (behavior ()
    (sound-group-continue (sound-group
                            sfx
                            music
                            dialog
                            sog3
                            ambient
                            dialog2
                            special
                            sog7
                            sog8
                            sog9
                            sog10
                            sog11
                            sog12
                            sog13
                            sog14
                            sog15
                            sog16
                            sog17
                            sog18
                            sog19
                            sog20
                            sog21
                            sog22
                            sog23
                            sog24
                            sog25
                            sog26
                            sog27
                            sog28
                            sog29
                            sog30
                            sog31
                            )
                          )
    )
  :trans (behavior ()
    (buzz-stop! 0)
    (buzz-stop! 1)
    )
  :code (behavior ()
    (set-time! (-> self state-time))
    (while (not (is-cd-in?))
      (suspend)
      )
    )
  )


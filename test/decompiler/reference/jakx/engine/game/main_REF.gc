;; definition of type disc-error-proc
(deftype disc-error-proc (process-drawable)
  ((error  basic)
   (bmask  uint32)
   )
  (:states
    disc-idle
    )
  )

;; definition for method 3 of type disc-error-proc
(defmethod inspect ((this disc-error-proc))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type process-drawable inspect)))
    (t9-0 this)
    )
  (format #t "~2Terror: ~A~%" (-> this error))
  (format #t "~2Tbmask: ~D~%" (-> this bmask))
  (label cfg-4)
  this
  )

;; failed to figure out what this is:
(defstate disc-idle (disc-error-proc)
  :enter (behavior ()
    (set! (-> self bmask) (the-as uint (-> *setting-control* user-default process-mask)))
    (when (not (and *net-mgr* (or (nonzero? (-> *net-mgr* lobby-state connect-handle))
                                  (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'hosting-game))
                                  (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'connecting-to-game))
                                  (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'joining-game))
                                  (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'playing-game))
                                  (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'leaving-game))
                                  )
                    )
               )
      (sound-group-pause (sound-group
                           sfx
                           music
                           dialog
                           sog3
                           ambient
                           dialog2
                           special
                           sog7
                           sog8
                           sog9
                           sog10
                           sog11
                           sog12

            :time-of-day 6
            :task-sound-description #f
            :ipu #f
            :gold-array (new 'static 'array uint32 2 #x42700000 #x40400000)
            :silver-array (new 'static 'array uint32 2 #x42480000 #x40000000)
            :bronze-array (new 'static 'array uint32 2 #x42200000 #x3f800000)
            :adv-score -1
            :ai-tuning-indices '(0)
            :sound-bank 'spargb1
            :ai-difficulty #x7f
            :ai-easier-after #x1
            :ai-difficulty-step #x3f
            :adventure-drivers '*driver-list-cup1*
            )
          (new 'static 'game-task-node-info
            :level 'city
            :task #xb3
            :net-play-mode #x13
            :name "city-win-task"
            :max-humans 6
            :max-cpu 5
            :min-players 1
            :when-open #f
            :flags (game-task-node-flag closed cup1)
            :borrow '()
            :intro-scene #f
            :outro-scene #f
            :time-of-day -1
            :task-sound-description #f
            :ipu #f
            :gold-array (new 'static 'array uint32 2 #x40400000 #x40400000)
            :silver-array (new 'static 'array uint32 2 #x40000000 #x40000000)
            :bronze-array (new 'static 'array uint32 2 #x3f800000 #x3f800000)
            :adv-score -1
            :ai-tuning-indices '(0)
            :sound-bank #f
            :ai-difficulty #xff
            :ai-difficulty-step #x19
            :adventure-drivers '*driver-list-cup1*
            )
          (new 'static 'game-task-node-info
            :level 'artist
            :task #xb4
            :net-play-mode #x12
            :name "artist-artist-task"
            :max-humans 6
            :max-cpu 5
            :min-players 1
            :when-open #f
            :flags (game-task-node-flag closed set-task-mask cup1)
            :task-mask (task-mask task0)
            :borrow '()
            :intro-scene #f
            :outro-scene #f
            :time-of-day -1
            :task-sound-description #f
            :ipu #f
            :gold-array (new 'static 'array uint32 2 #x40400000 #x40400000)
            :silver-array (new 'static 'array uint32 2 #x40000000 #x40000000)
            :bronze-array (new 'static 'array uint32 2 #x3f800000 #x3f800000)
            :adv-score -1
            :ai-tuning-indices '(0)
            :sound-bank #f
            :ai-difficulty #xff
            :ai-difficulty-step #x19
            :adventure-drivers '*driver-list-cup1*
            )
          )
        )
  (set! (-> gp-0 mission-list) (new 'global 'boxed-array game-task-node-info 178))
  (set! (-> gp-0 task-node-commands)
        (the-as (array game-task-node-command) (new 'static 'boxed-array :type uint8 #x48 #x20 #x1f #x1))
        )
  (set! (-> gp-0 game-movie) *game-movie*)
  (set! (-> gp-0 grand-prix) *grand-prix*)
  )

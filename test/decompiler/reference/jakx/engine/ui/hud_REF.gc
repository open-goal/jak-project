;; definition for symbol *debug-hud-disable*, type symbol
(define *debug-hud-disable* #f)

;; definition for method 25 of type hud
(defmethod should-show? ((this hud))
  (not (or (and (hide-during-letterbox? this) (!= (-> *setting-control* user-current letterbox) 0.0))
           (and (hide-during-in-game-menu? this) (in-game-menu-on?))
           (and (hide-during-finish-mode? this) (current-finish-mode))
           (and (hide-during-end-game-menu? this) (or *debug-hud-disable* (end-game-menu-on?)))
           (and (hide-during-grand-prix-totals? this) (grand-prix-totals-on?))
           (and (hide-during-cash-stats? this) (cash-stats-on?))
           (and (hide-during-high-scores? this) (high-scores-on?))
           )
       )
  )


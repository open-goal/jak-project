;; definition for function hud-create-icon
;; WARN: Return type mismatch (pointer process) vs (pointer manipy).
(defun hud-create-icon ((arg0 hud) (arg1 int) (arg2 int))
  (let ((s4-0
          (process-spawn
            manipy
            :init manipy-init
            (new 'static 'vector :w 1.0)
            #f
            arg2
            #f
            0
            :name "manipy"
            :to arg0
            :stack-size #x20000
            )
          )
        )
    (the-as
      (pointer manipy)
      (when (and s4-0 (nonzero? (-> (the-as process-drawable (-> s4-0 0)) draw)))
        (set! (-> (the-as process-drawable (-> s4-0 0)) draw dma-add-func)
              (the-as (function process-drawable draw-control symbol object none) dma-add-process-drawable-hud)
              )
        (logior! (-> s4-0 0 mask) (process-mask freeze pause))
        (logclear! (-> s4-0 0 mask) (process-mask menu progress))
        (send-event (ppointer->process s4-0) 'draw #f)
        (set! (-> arg0 icons arg1 icon) (the-as (pointer manipy) s4-0))
        s4-0
        )
      )
    )
  )

;; definition for method 29 of type hud
;; WARN: Return type mismatch int vs none.
(defmethod alloc-string-if-needed ((this hud) (arg0 int) (arg1 int))
  (when (not (-> this strings arg0 text))
    (set! (-> this strings arg0 text) (new 'process 'string arg1 (the-as string #f)))
    (set! (-> this strings arg0 width) 100.0)
    (set! (-> this strings arg0 height) 100.0)
    )
  0
  (none)
  )

;; definition for function hud-post
;; WARN: Return type mismatch int vs none.
(defbehavior hud-post hud ()
  (-> *perf-stats* data 55)
  0
  (if (not (and (nonzero? *screen-shot-work*)
                (!= (-> *screen-shot-work* count) -1)
                (not (-> *screen-shot-work* hud-enable))
                )
           )
      (draw self)
      )
  (-> *perf-stats* data 55)
  0
  (none)
  )

;; definition for function hud-handler
;; WARN: Return type mismatch int vs object.
(defbehavior hud-handler hud ((arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (-> *perf-stats* data 55)
  0
  (case arg2
    (('hide-and-die)
     (go empty-state)
     )
    (else
      (hud-event-handler self arg0 arg1 arg2 arg3)
      )
    )
  (-> *perf-stats* data 55)
  0
  )

;; failed to figure out what this is:
(defstate hud-hidden (hud)
  :virtual #t
  :event hud-handler
  :trans (behavior ()
    (if (should-show? self)
        (go-virtual hud-in)
        )
    )
  :code sleep-code
  )

;; failed to figure out what this is:
(defstate hud-in (hud)
  :virtual #t
  :event hud-handler
  :enter (behavior ()
    '()
    )
  :exit (behavior ()
    '()
    )
  :trans (behavior ()
    (if (not (should-show? self))
        (go-virtual hud-hidden)
        )
    )
  :code sleep-code
  :post hud-post
  )

;; definition for function hud-init-by-other
(defbehavior hud-init-by-other hud ()
  (add-connection *hud-engine* self #f self (-> self type symbol) #f)
  (set! (-> self mask) (process-mask menu))
  (+! (-> self clock ref-count) -1)
  (+! (-> *display* real-clock ref-count) 1)
  (set! (-> self clock) (-> *display* real-clock))
  (set! (-> self flags) (hud-flags))
  (set-time! (-> self last-hide-time))
  (set! (-> self offset) 1.0)
  (dotimes (v1-16 45)
    (set! (-> self strings v1-16 text) #f)
    (set! (-> self strings v1-16 scale) 0.0)
    (set! (-> self strings v1-16 color) (font-color white))
    (set! (-> self strings v1-16 alpha) 1.0)
    (set! (-> self strings v1-16 flags) (hud-string-flag shadow kerning large))
    (set! (-> self strings v1-16 pos x) 0)
    (set! (-> self strings v1-16 pos z) #xfffffff)
    (set! (-> self strings v1-16 pos w) 0)
    (set! (-> self strings v1-16 time) 0.0)
    (set! (-> self strings v1-16 effect) (the-as uint 0))
    )
  (dotimes (v1-19 50)
    (set-vector! (-> self sprites v1-19 color) 128 128 128 128)
    (set! (-> self sprites v1-19 pos z) #xffffff)
    (set! (-> self sprites v1-19 pos w) 0)
    (set! (-> self sprites v1-19 scale-x) 0.0)
    (set! (-> self sprites v1-19 scale-y) 0.0)
    (set! (-> self sprites v1-19 angle) 0.0)
    (set! (-> self sprites v1-19 flags) (hud-sprite-flags))
    (set! (-> self sprites v1-19 tex) #f)
    )
  (dotimes (v1-22 2)
    (set! (-> self icons v1-22 icon) (the-as (pointer manipy) #f))
    (set! (-> self icons v1-22 pos z) 1024)
    (set! (-> self icons v1-22 scale-x) 1.0)
    (set! (-> self icons v1-22 scale-y) 1.0)
    )
  (init-callback self)
  (set! (-> self event-hook) (-> (method-of-type hud hud-in) event))
  (go-virtual hud-in)
  )


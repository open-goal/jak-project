;;-*-Lisp-*-
(in-package goal)

;; definition of type hud-string-record
(deftype hud-string-record (structure)
  ((str   hud-string)
   (next  hud-string-record)
   )
  :pack-me
  )

;; definition for method 3 of type hud-string-record
(defmethod inspect ((this hud-string-record))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'hud-string-record)
  (format #t "~1Tstr: #<hud-string @ #x~X>~%" (-> this str))
  (format #t "~1Tnext: #<hud-string-record @ #x~X>~%" (-> this next))
  (label cfg-4)
  this
  )

;; definition for symbol *hud-string-array*, type (inline-array hud-string-record)
(define *hud-string-array* (the-as (inline-array hud-string-record) (malloc 'global 768)))

;; definition for symbol *hud-string-used-list*, type (pointer (pointer hud-string-record))
(define *hud-string-used-list* (the-as (pointer (pointer hud-string-record)) (malloc 'global 8)))

;; definition for symbol *hud-string-free-list*, type hud-string-record
(define *hud-string-free-list* (the-as hud-string-record #f))

;; definition for symbol *font-hud-context*, type font-context
(define *font-hud-context* (new
                             'global
                             'font-context
                             *font-default-matrix*
                             0
                             0
                             8396850.0
                             (font-color default)
                             (font-flags shadow kerning)
                             )
        )

;; failed to figure out what this is:
(set! (-> *hud-string-used-list* 0) (the-as (pointer hud-string-record) (malloc 'global 12)))

;; failed to figure out what this is:
(set! (-> *hud-string-used-list* 1) (the-as (pointer hud-string-record) (malloc 'global 12)))

;; definition for function hud-string-init
;; WARN: Return type mismatch int vs none.
(defun hud-string-init ()
  (set! *hud-string-free-list* #f)
  (dotimes (v1-0 2)
    (dotimes (a0-0 3)
      (set! (-> *hud-string-used-list* v1-0 a0-0) #f)
      )
    )
  (dotimes (v1-3 96)
    (set! (-> *hud-string-array* v1-3 next) *hud-string-free-list*)
    (set! *hud-string-free-list* (-> *hud-string-array* v1-3))
    )
  0
  (none)
  )

;; definition for function hud-string-add
(defun hud-string-add ((arg0 hud-string))
  (let ((gp-0 (the-as object *hud-string-free-list*)))
    (cond
      ((the-as hud-string-record gp-0)
       (let ((s5-0 (cond
                     ((logtest? (-> arg0 flags) (hud-string-flag draw-3d))
                      0
                      )
                     ((zero? (-> arg0 effect))
                      2
                      )
                     (else
                       1
                       )
                     )
                   )
             )
         (set! *hud-string-free-list* (-> (the-as hud-string-record gp-0) next))
         (set! (-> (the-as hud-string-record gp-0) str) arg0)
         (set! (-> (the-as hud-string-record gp-0) str text-length) (length (-> arg0 text)))
         (set! (-> (the-as hud-string-record gp-0) next) (-> *hud-string-used-list* (view-get-active-index) s5-0))
         (set! (-> *hud-string-used-list* (view-get-active-index) s5-0) (the-as hud-string-record gp-0))
         )
       gp-0
       )
      (else
        (format *stdebug* "Out of hud-string-records!!!!~%")
        )
      )
    )
  )

;; definition for method 9 of type hud-string
;; WARN: Return type mismatch int vs none.
(defmethod setup-font-context! ((this hud-string) (arg0 font-context))
  (set-vector!
    (-> arg0 origin)
    (the float (-> this pos x))
    (the float (-> this pos y))
    (the float (-> this pos z))
    1.0
    )
  (let ((v1-1 arg0))
    (set! (-> v1-1 width) (-> this width))
    )
  (let ((v1-2 arg0))
    (set! (-> v1-2 height) (-> this height))
    )
  (set! (-> arg0 scale) (-> this scale))
  (set! (-> arg0 flags) (the-as font-flags (-> this flags)))
  (set! (-> arg0 color) (-> this color))
  (set! (-> arg0 alpha) (-> this alpha))
  (set! (-> arg0 effect) (-> this effect))
  (let ((v1-6 arg0))
    (set! (-> v1-6 effect-time) (-> this time))
    )
  (let ((v1-7 arg0))
    (set! (-> v1-7 effect-color) (the-as font-color (-> this effect-color)))
    )
  (logior! (-> arg0 flags) (font-flags ff8))
  0
  (none)
  )

;; definition for function hud-string-draw-all
;; WARN: Return type mismatch int vs none.
(defun hud-string-draw-all ()
  (local-vars (sp-0 int))
  (-> *perf-stats* data 57)
  0
  (set! *scratch-top* (the-as pointer #x70000000))
  (the-as none sp-0)
  (set! sp-0 #x70002000)
  (let ((sv-16 (new
                 'scratch
                 'font-context
                 *font-default-matrix*
                 0
                 0
                 8396850.0
                 (font-color default)
                 (font-flags shadow kerning)
                 )
               )
        (sv-20 *font-char-effect*)
        )
    (let ((sv-24 (malloc 'scratch 6144))
          (sv-28 *viewport-array*)
          )
      (set! *font-char-effect* (the-as font-char-effect sv-24))
      (with-dma-buffer-add-bucket ((s4-0 (-> *display* frames (-> *display* on-screen) global-buf))
                                   (bucket-id bucket791)
                                   )
        (dotimes (s3-0 2)
          (let ((s2-0 (-> *hud-string-used-list* s3-0 0))
                (a0-5 (-> sv-28 data s3-0))
                (v1-19 s4-0)
                )
            (let* ((a1-2 v1-19)
                   (a2-1 (the-as object (-> a1-2 base)))
                   )
              (set! (-> (the-as dma-packet a2-1) dma) (new 'static 'dma-tag :qwc #x2 :id (dma-tag-id cnt)))
              (set! (-> (the-as dma-packet a2-1) vif0) (new 'static 'vif-tag))
              (set! (-> (the-as dma-packet a2-1) vif1) (new 'static 'vif-tag :imm #x2 :cmd (vif-cmd direct) :msk #x1))
              (set! (-> a1-2 base) (&+ (the-as pointer a2-1) 16))
              )
            (let* ((a1-3 v1-19)
                   (a2-3 (the-as object (-> a1-3 base)))
                   )
              (set! (-> (the-as gs-gif-tag a2-3) tag) (new 'static 'gif-tag64 :nloop #x1 :eop #x1 :nreg #x1))
              (set! (-> (the-as gs-gif-tag a2-3) regs) GIF_REGS_ALL_AD)
              (set! (-> a1-3 base) (&+ (the-as pointer a2-3) 16))
              )
            (let ((a1-4 (-> v1-19 base)))
              (set! (-> (the-as (pointer gs-scissor) a1-4) 0) (-> a0-5 scissor-on-screen))
              (let ((a2-6 (the-as object 64)))
                (set! (-> (the-as (pointer gs-reg64) a1-4) 1) (the-as gs-reg64 a2-6))
                (set! (-> v1-19 base) (&+ a1-4 16))
                (while s2-0
                  (let ((s1-0 (-> s2-0 str text)))
                    (if (< (the-as uint (dma-buffer-free s4-0)) (the-as uint (* 13 (-> s2-0 str text-length))))
                        (goto cfg-29)
                        )
                    (setup-font-context! (-> s2-0 str) sv-16)
                    (setup-3d! sv-16 (the-as int s1-0) (the-as int a2-6))
                    (set! a2-6 sv-16)
                    (draw-string3d-asm s1-0 s4-0 (the-as font-context a2-6))
                    )
                  (set! s2-0 (-> s2-0 next))
                  )
                )
              )
            )
          )
        (dotimes (s3-1 2)
          (let ((s2-1 (-> *hud-string-used-list* s3-1 1)))
            (let ((a0-14 (-> sv-28 data s3-1))
                  (v1-40 s4-0)
                  )
              (let* ((a1-9 v1-40)
                     (a2-7 (the-as object (-> a1-9 base)))
                     )
                (set! (-> (the-as dma-packet a2-7) dma) (new 'static 'dma-tag :qwc #x2 :id (dma-tag-id cnt)))
                (set! (-> (the-as dma-packet a2-7) vif0) (new 'static 'vif-tag))
                (set! (-> (the-as dma-packet a2-7) vif1) (new 'static 'vif-tag :imm #x2 :cmd (vif-cmd direct) :msk #x1))
                (set! (-> a1-9 base) (&+ (the-as pointer a2-7) 16))
                )
              (let* ((a1-10 v1-40)
                     (a2-9 (the-as object (-> a1-10 base)))
                     )
                (set! (-> (the-as gs-gif-tag a2-9) tag) (new 'static 'gif-tag64 :nloop #x1 :eop #x1 :nreg #x1))
                (set! (-> (the-as gs-gif-tag a2-9) regs) GIF_REGS_ALL_AD)
                (set! (-> a1-10 base) (&+ (the-as pointer a2-9) 16))
                )
              (let ((a1-11 (-> v1-40 base)))
                (set! (-> (the-as (pointer gs-scissor) a1-11) 0) (-> a0-14 scissor-on-screen))
                (set! (-> (the-as (pointer gs-reg64) a1-11) 1) (gs-reg64 scissor-1))
                (set! (-> v1-40 base) (&+ a1-11 16))
                )
              )
            (while s2-1
              (let ((s1-1 (-> s2-1 str text)))
                (if (< (the-as uint (dma-buffer-free s4-0)) (the-as uint (* 13 (-> s2-1 str text-length))))
                    (goto cfg-29)
                    )
                (setup-font-context! (-> s2-1 str) sv-16)
                (setup-2d! sv-16 s1-1)
                (draw-string-init-justify s1-1 s4-0 sv-16)
                (char-effect-compute-colors *font-char-effect* (-> s2-1 str text-length) (-> sv-16 effect-color) sv-16)
                (draw-effect-string s1-1 s4-0 sv-16)
                )
              (set! s2-1 (-> s2-1 next))
              )
            )
          )
        (dotimes (s3-2 2)
          (let ((s2-2 (-> *hud-string-used-list* s3-2 2)))
            (let ((a0-25 (-> sv-28 data s3-2))
                  (v1-63 s4-0)
                  )
              (let* ((a1-18 v1-63)
                     (a2-16 (the-as object (-> a1-18 base)))
                     )
                (set! (-> (the-as dma-packet a2-16) dma) (new 'static 'dma-tag :qwc #x2 :id (dma-tag-id cnt)))
                (set! (-> (the-as dma-packet a2-16) vif0) (new 'static 'vif-tag))
                (set! (-> (the-as dma-packet a2-16) vif1) (new 'static 'vif-tag :imm #x2 :cmd (vif-cmd direct) :msk #x1))
                (set! (-> a1-18 base) (&+ (the-as pointer a2-16) 16))
                )
              (let* ((a1-19 v1-63)
                     (a2-18 (the-as object (-> a1-19 base)))
                     )
                (set! (-> (the-as gs-gif-tag a2-18) tag) (new 'static 'gif-tag64 :nloop #x1 :eop #x1 :nreg #x1))
                (set! (-> (the-as gs-gif-tag a2-18) regs) GIF_REGS_ALL_AD)
                (set! (-> a1-19 base) (&+ (the-as pointer a2-18) 16))
                )
              (let ((a1-20 (-> v1-63 base)))
                (set! (-> (the-as (pointer gs-scissor) a1-20) 0) (-> a0-25 scissor-on-screen))
                (set! (-> (the-as (pointer gs-reg64) a1-20) 1) (gs-reg64 scissor-1))
                (set! (-> v1-63 base) (&+ a1-20 16))
                )
              )
            (while s2-2
              (let ((s1-2 (-> s2-2 str text)))
                (if (< (the-as uint (dma-buffer-free s4-0)) (the-as uint (* 13 (-> s2-2 str text-length))))
                    (goto cfg-29)
                    )
                (setup-font-context! (-> s2-2 str) sv-16)
                (setup-2d! sv-16 s1-2)
                (draw-string-asm-packed s1-2 s4-0 sv-16)
                )
              (set! s2-2 (-> s2-2 next))
              )
            )
          )
        )
      )
    (label cfg-29)
    (set! *font-char-effect* sv-20)
    )
  (hud-string-init)
  (-> *perf-stats* data 57)
  0
  0
  (none)
  )

;; definition of type hud-sprite-work
(deftype hud-sprite-work (structure)
  ((adgif-tmpl          dma-gif-packet  :inline)
   (draw-tmpl           dma-gif-packet  :inline)
   (draw-no-tex-tmpl    dma-gif-packet  :inline)
   (sprite-tmpl         dma-gif-packet  :inline)
   (sprite-no-tex-tmpl  dma-gif-packet  :inline)
   (box-tmpl            dma-gif-packet  :inline)
   (box2-tmpl           dma-gif-packet  :inline)
   (mask-tmpl           dma-gif-packet  :inline)
   (line-tmpl           dma-gif-packet  :inline)
   (scan-tmpl           dma-gif-packet  :inline)
   (line-color          gs-rgbaq)
   (scan-colors         vector4w        32 :inline)
   (scanline            uint32)
   )
  )

;; definition for method 3 of type hud-sprite-work
(defmethod inspect ((this hud-sprite-work))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'hud-sprite-work)
  (format #t "~1Tadgif-tmpl: #<dma-gif-packet @ #x~X>~%" (-> this adgif-tmpl))
  (format #t "~1Tdraw-tmpl: #<dma-gif-packet @ #x~X>~%" (-> this draw-tmpl))
  (format #t "~1Tdraw-no-tex-tmpl: #<dma-gif-packet @ #x~X>~%" (-> this draw-no-tex-tmpl))
  (format #t "~1Tsprite-tmpl: #<dma-gif-packet @ #x~X>~%" (-> this sprite-tmpl))
  (format #t "~1Tsprite-no-tex-tmpl: #<dma-gif-packet @ #x~X>~%" (-> this sprite-no-tex-tmpl))
  (format #t "~1Tbox-tmpl: #<dma-gif-packet @ #x~X>~%" (-> this box-tmpl))
  (format #t "~1Tbox2-tmpl: #<dma-gif-packet @ #x~X>~%" (-> this box2-tmpl))
  (format #t "~1Tmask-tmpl: #<dma-gif-packet @ #x~X>~%" (-> this mask-tmpl))
  (format #t "~1Tline-tmpl: #<dma-gif-packet @ #x~X>~%" (-> this line-tmpl))
  (format #t "~1Tscan-tmpl: #<dma-gif-packet @ #x~X>~%" (-> this scan-tmpl))
  (format #t "~1Tline-color: ~D~%" (-> this line-color))
  (format #t "~1Tscan-colors[32] @ #x~X~%" (-> this scan-colors))
  (format #t "~1Tscanline: ~D~%" (-> this scanline))
  (label cfg-4)
  this
  )


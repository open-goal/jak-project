                       (set! (-> (the-as dma-packet a3-0) vif1) (new 'static 'vif-tag :imm #x4 :cmd (vif-cmd direct) :msk #x1))
                       (set! (-> a2-0 base) (the-as pointer (&+ (the-as dma-packet a3-0) 16)))

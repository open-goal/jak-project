;; definition for function get-net-driver-idx-by-type
(defun get-net-driver-idx-by-type ((arg0 driver-type))
  (dotimes (v1-0 (-> *net-drivers* length))
    (if (= (-> *net-drivers* v1-0 dt) arg0)
        (return v1-0)
        )
    )
  (the-as int #f)
  )

;; definition for function get-net-driver-by-type
(defun get-net-driver-by-type ((arg0 driver-type))
  (let ((v1-0 (get-net-driver-idx-by-type arg0)))
    (if v1-0
        (-> *net-drivers* v1-0)
        (the-as net-driver #f)
        )
    )
  )

;; definition for function get-driver-flavor-text
;; WARN: Return type mismatch int vs text-id.
(defun get-driver-flavor-text ((arg0 driver-type))
  (let ((v1-0 arg0))
    (the-as text-id (cond
                      ((= v1-0 (driver-type d-jak))
                       (the-as text-id (text-id text-id-3294))
                       )
                      ((= v1-0 (driver-type d-ur-86))
                       (the-as text-id (text-id text-id-3295))
                       )
                      ((= v1-0 (driver-type d-ashelin))
                       (the-as text-id (text-id text-id-3297))
                       )
                      ((= v1-0 (driver-type d-razer))
                       (the-as text-id (text-id text-id-3298))
                       )
                      ((= v1-0 (driver-type d-klever))
                       (the-as text-id (text-id text-id-3299))
                       )
                      ((= v1-0 (driver-type d-kiera))

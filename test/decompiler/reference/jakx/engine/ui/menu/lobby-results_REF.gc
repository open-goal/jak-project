;; failed to figure out what this is:
(defstate lobby-results-new-body-parts-screen (lobby-menu-manager)
  :virtual #t
  :event lobby-menu-manager-default-handler
  :enter (behavior ()
    (lobby-awards-handle-body-part-awarding)
    (let ((s5-0 (lobby-results-awarded-car-parts))
          (gp-0 (clear *temp-string*))
          )
      (when (not s5-0)
        (case *lobby-body-parts-return-state-name*
          (('ready-room-state)
           (set! *lobby-body-parts-return-state-name* #f)
           (if (= (if *net-mgr*
                      (-> *net-mgr* game-state local-machine-idx)
                      0
                      )
                  (-> *net-mgr* game-state session-master-idx)
                  )
               (create-menu self *ready-room-host* 2)
               (create-menu self *ready-room* 2)
               )
           (go-virtual ready-room-state)
           )
          (('choose-event-menu)
           (set! *lobby-body-parts-return-state-name* #f)
           (go-virtual choose-event-menu)
           )
          (else
            (go-virtual lobby-results-new-driver-screen)
            )
          )
        )
      (let ((v1-17 (-> s5-0 part-id)))
        (cond
          ((zero? v1-17)
           (let ((v1-18 (rand-vu-int-count 4)))
             (cond
               ((zero? v1-18)
                (talker-spawn-func (-> *talker-speech* 178) *entity-pool* (target-pos 0) (the-as region #f))

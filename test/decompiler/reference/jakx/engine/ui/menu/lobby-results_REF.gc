;; failed to figure out what this is:
(defstate lobby-results-new-qualifier-screen (lobby-menu-manager)
  :virtual #t
  :event lobby-menu-manager-default-handler
  :enter (behavior ()
    '()
    )
  :code (behavior ()
    (remove-setting! 'bg-a)
    (let ((gp-0 (lobby-awards-test-qualifier)))
      (cond
        ((not gp-0)
         (load-state-method-25 *load-state* #f)
         (cond
           (*lobby-results-no-adventure-mode*
             (remove-setting! 'bg-a)
             (kill-menu self #t #f)
             (create-menu self *base-menu-info* 0)
             (go-virtual game-type-menu)
             )
           (else
             (remove-setting! 'bg-a)
             (set! *adv-coming-back-from-game* #t)
             (go-virtual adventure-save)
             )
           )
         )
        (else
          (set-task-node *net-world* (get-new-qualifier))
          (create-menu self *lobby-results-new-qualifier-screen* 0)
          (let ((s4-1 (-> *task-level-info* (-> *game-info* play-list (-> gp-0 task) task-level) text-id))
                (s5-1 (-> *net-play-mode-text-ids* (-> gp-0 net-play-mode)))
                )
            (let ((s3-0 (clear *temp-string*)))
              (format s3-0 "~s" (lookup-text! *common-text* s4-1 #f))
              (charp<-string (-> *lobby-results-new-events-levname-text* 0 text) s3-0)
              )
            (let ((s4-2 (clear *temp-string*)))
              (format s4-2 "~s" (lookup-text! *common-text* s5-1 #f))
              (charp<-string (-> *lobby-results-new-events-levmode-text* 0 text) s4-2)
              )
            )
          (format (clear *icon-texture-string*) "~s" (-> *net-play-mode-icon-string* (-> gp-0 net-play-mode)))
          (format
            (clear *map-texture-string*)
            "~s-map"
            (-> *task-level-info* (-> *game-info* play-list (-> gp-0 task) task-level) tex-name)
            )
          (kill-by-type fmv-player *active-pool*)
          (if (-> gp-0 ipu)
              (fmv-player-run-texture (-> gp-0 ipu) *default-pool*)
              )
          (set-action!
            *gui-control*
            (gui-action stop)
            (the-as sound-id 1)
            (gui-channel citizen)
            (gui-action none)
            (the-as string #f)
            (the-as (function gui-connection symbol) #f)
            (the-as process #f)
            )
          (when (-> gp-0 task-sound-description)
            (remove-setting! 'music-volume)
            (add-setting! 'music-volume 'rel 0.25 0)
            (set! (-> *lobby-menu-manager* voice-id)
                  (add-process
                    *gui-control*
                    *lobby-menu-manager*
                    (gui-channel citizen)
                    (gui-action play)
                    (-> gp-0 task-sound-description)
                    -99.0
                    0
                    )
                  )
            (sound-params-set!
              *gui-control*
              (-> *lobby-menu-manager* voice-id)
              #f
              -1.0
              -1.0
              1.0
              (-> *setting-control* user-current talker-volume)
              #t
              )
            )
          (if (not (handle->process (-> self vehicle-handle)))
              (set! (-> self vehicle-selected)
                    (-> *game-info* player-info (-> self current-local-player) last-selected-vehicle)
                    )
              )
          (set! *lobby-adv-selected-task* 0)
          (set! (-> *adventure-task-info-array* *lobby-adv-selected-task* extra-int) 1)
          (let ((v1-79 (the-as string-menu (find-menu self 'awarded-level-desc)))
                (a0-44 (-> gp-0 task))
                )
            (set! (-> v1-79 info-ptr strings-info 0 id) (cond
                                                          ((= a0-44 14)
                                                           (text-id text-id-3847)
                                                           )
                                                          ((= a0-44 23)
                                                           (text-id text-id-3846)
                                                           )
                                                          ((= a0-44 30)
                                                           (text-id text-id-3845)
                                                           )
                                                          ((= a0-44 42)
                                                           (text-id text-id-3844)
                                                           )
                                                          ((= a0-44 57)
                                                           (text-id text-id-3843)
                                                           )
                                                          ((= a0-44 64)
                                                           (text-id text-id-3879)
                                                           )
                                                          ((= a0-44 73)
                                                           (text-id text-id-3880)
                                                           )
                                                          ((= a0-44 82)
                                                           (text-id text-id-3881)
                                                           )
                                                          (else
                                                            (the-as text-id (the-as int #f))
                                                            )
                                                          )
                  )
            )
          (let ((v1-84 (the-as string-menu (find-menu self 'qualifier-cup-name)))
                (a0-47 (-> gp-0 task))
                )
            (set! (-> v1-84 info-ptr strings-info 0 id) (cond
                                                          ((or (= a0-47 23) (= a0-47 14))
                                                           (text-id text-id-3895)
                                                           )
                                                          ((or (= a0-47 30) (= a0-47 42))
                                                           (text-id text-id-3896)
                                                           )
                                                          ((or (= a0-47 57) (= a0-47 64))
                                                           (text-id text-id-3893)
                                                           )
                                                          ((or (= a0-47 73) (= a0-47 82))
                                                           (text-id text-id-3894)
                                                           )
                                                          (else
                                                            (the-as text-id (the-as int #f))
                                                            )
                                                          )
                  )
            )
          (until #f
            (when (cpad-or-kbd-pressed-var? (the-as uint 0) (pad-buttons x))
              (logclear! (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons x))
              (logclear! (-> *cpad-list* cpads 0 button0-rel 0) (pad-buttons x))
              (cpad-or-kbd-clear-func! (the-as uint 0) (pad-buttons x))
              (if (kill-menu self #f #f)
                  (goto cfg-60)
                  )
              )
            (suspend)
            )
          #f
          (label cfg-60)
          (suspend-for (seconds 0.5)
            )
          (kill-menu self #t #f)
          )
        )
      )
    (set! *adv-coming-back-from-game* #t)
    (if (-> *setting-control* user-current auto-save)
        (auto-save-command 'auto-save 0 *profile-slot* self #f #f)
        )
    (go-virtual adventure-vehicle-select)
    )
  :post lobby-default-post
  )


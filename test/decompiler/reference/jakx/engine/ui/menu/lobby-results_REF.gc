              (s2-0 (the-as string-menu (find-menu self 'awarded-driver-name-other)))
              (s3-0 (the-as string-menu (find-menu self 'awarded-driver-flavor)))
              )
          (set! (-> s1-0 info-ptr strings-info 0 id) (-> s4-0 id))
          (set! (-> s2-0 info-ptr strings-info 0 id) (-> s4-0 id))
          (set! (-> s3-0 info-ptr strings-info 0 id) (get-driver-flavor-text gp-0))
          )
        (set-driver-license-info s5-0)

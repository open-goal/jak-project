;;-*-Lisp-*-
(in-package goal)

;; definition for symbol *lobby-results-enabled*, type symbol
(define *lobby-results-enabled* #f)

;; definition for symbol *lobby-results-no-adventure-mode*, type symbol
(define *lobby-results-no-adventure-mode* #f)

;; definition for function wait-and-play-award
;; WARN: Return type mismatch int vs object.
(defbehavior wait-and-play-award lobby-menu-manager ()
  0
  (set! (-> self voice-id)
        (add-process *gui-control* self (gui-channel alert) (gui-action queue) "award1" -99.0 0)
        )
  (sound-params-set! *gui-control* (-> self voice-id) #f -1.0 -1.0 1.0 1.0 #f)
  (while (!= (get-status *gui-control* (-> self voice-id)) (gui-status ready))
    (suspend)
    )
  (set-action!
    *gui-control*
    (gui-action play)
    (-> self voice-id)
    (gui-channel none)
    (gui-action none)
    (the-as string #f)
    (the-as (function gui-connection symbol) #f)
    (the-as process #f)
    )
  )

;; definition for function lobby-results-awarded-vehicle
(defun lobby-results-awarded-vehicle ()
  *lobby-awards-new-vehicle*
  )

;; definition for function lobby-results-first-awarded-vehicle
(defun lobby-results-first-awarded-vehicle ((arg0 symbol))
  (cond
    (arg0
      (set! *lobby-awards-first-new-vehicle* #f)
      #f
      )
    (else
      *lobby-awards-first-new-vehicle*
      )
    )
  )

;; definition for function lobby-results-awarded-event
(defun lobby-results-awarded-event ()
  *lobby-awards-new-event*
  )

;; definition for function lobby-results-awarded-car-parts
(defun lobby-results-awarded-car-parts ()
  *lobby-awards-new-body-part*
  )

;; definition for function lobby-awards-test-qualifier
(defun lobby-awards-test-qualifier ()
  (let ((v1-0 (get-new-qualifier)))
    (if (and (= *game-mode* 'adventure) (nonzero? v1-0))
        (-> *game-info* sub-task-list v1-0)
        (the-as game-task-node-info #f)
        )
    )
  )

;; definition for symbol *gtb-speech-last-venue*, type int
(define *gtb-speech-last-venue* 0)

;; definition for function lobby-speech-gtb-new-venue
(defun lobby-speech-gtb-new-venue ()
  (while (and (zero? *gtb-speech-last-venue*) (not (pecker-can-speak?)))
    (set! *gtb-speech-last-venue* (mod (+ *gtb-speech-last-venue* 1) 3))
    )
  (let ((v1-6 *gtb-speech-last-venue*))
    (cond
      ((zero? v1-6)
       (talker-spawn-func (-> *talker-speech* 214) *entity-pool* (target-pos 0) (the-as region #f))
       )
      ((= v1-6 1)
       (talker-spawn-func (-> *talker-speech* 215) *entity-pool* (target-pos 0) (the-as region #f))
       )
      (else
        (talker-spawn-func (-> *talker-speech* 216) *entity-pool* (target-pos 0) (the-as region #f))
        )
      )
    )
  (let ((v0-7 (+ *gtb-speech-last-venue* 1)))
    (set! v0-7 (cond
                 ((< 2 v0-7)
                  0
                  )
                 (else
                   (empty)
                   v0-7
                   )
                 )
          )
    (set! *gtb-speech-last-venue* v0-7)
    v0-7
    )
  )


;; failed to figure out what this is:
(defstate lobby-results-new-events-screen (lobby-menu-manager)
  :virtual #t
  :event lobby-menu-manager-default-handler
  :enter (behavior ()
    (lobby-awards-handle-event-awarding)
    (if (not (lobby-results-awarded-event))
        (go-virtual lobby-results-new-qualifier-screen)
        )
    )
  :exit (behavior ()
    0
    )
  :code (behavior ()
    (remove-setting! 'bg-a)
    (create-menu self *lobby-results-new-events-screen-back* 0)
    (let ((gp-0 (lobby-results-awarded-event)))
      (let ((s5-0 (-> *task-level-info* (-> *game-info* play-list (-> gp-0 task) task-level) text-id)))
        (-> *net-play-mode-text-ids* (-> gp-0 net-play-mode))
        (let ((s4-0 (clear *temp-string*)))
          (format s4-0 "~s" (lookup-text! *common-text* s5-0 #f))
          (charp<-string (-> *lobby-results-new-events-levname-text* 0 text) s4-0)
          )
        )
      (format
        (clear *map-texture-string*)
        "~s-map"
        (-> *task-level-info* (-> *game-info* play-list (-> gp-0 task) task-level) tex-name)
        )
      (kill-by-type fmv-player *active-pool*)
      (if (-> gp-0 ipu)
          (fmv-player-run-texture (-> gp-0 ipu) *default-pool*)
          )
      (create-menu self *lobby-results-new-events-screen-front* 0)
      (let ((v1-33 (find-menu self 'awarded-level-desc)))
        (set! (-> (the-as string-menu-info (-> v1-33 info-ptr)) strings-info 0 id)
              (-> *task-level-info* (-> *game-info* play-list (-> gp-0 task) task-level) venue-text-id)
              )
        )
      )
    (suspend)
    (lobby-speech-gtb-new-venue)
    (until #f
      (when (cpad-or-kbd-pressed-var? (the-as uint 0) (pad-buttons x))
        (logclear! (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons x))
        (logclear! (-> *cpad-list* cpads 0 button0-rel 0) (pad-buttons x))
        (cpad-or-kbd-clear-func! (the-as uint 0) (pad-buttons x))
        (set-action!
          *gui-control*
          (gui-action stop)
          (-> self voice-id)
          (gui-channel none)
          (gui-action none)
          (the-as string #f)
          (the-as (function gui-connection symbol) #f)
          (the-as process #f)
          )
        (if (kill-menu self #f #f)
            (goto cfg-8)
            )
        )
      (suspend)
      )
    #f
    (label cfg-8)
    (suspend-for (seconds 0.5)
      )
    (kill-menu self #t #f)
    (go-virtual lobby-results-new-events-screen)
    )
  :post lobby-default-post
  )


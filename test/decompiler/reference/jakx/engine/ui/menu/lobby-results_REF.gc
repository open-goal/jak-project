;; failed to figure out what this is:
(defstate lobby-results-new-vehicle-screen (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('elan-cycle)
       (go-virtual lobby-results-new-vehicle-screen)
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (when (not (lobby-results-awarded-vehicle))
      (jukebox-onoff #t)
      (go-virtual lobby-results-new-body-parts-screen)
      )
    (let ((gp-0 (lobby-results-awarded-vehicle)))
      (let ((s5-0 (vehicle-type-from-car-type (the-as car-type gp-0))))
        (find-vehicle-info (the-as symbol s5-0))
        (cond
          ((= s5-0 (vehicle-type possum))
           (talker-spawn-func (-> *talker-speech* 101) *entity-pool* (target-pos 0) (the-as region #f))
           )
          ((= s5-0 (vehicle-type falcon))
           )
          (else
            (let ((v0-8 (rand-vu-int-count 8)))
              (cond
                ((zero? v0-8)
                 (talker-spawn-func (-> *talker-speech* 170) *entity-pool* (target-pos 0) (the-as region #f))
                 )
                ((= v0-8 1)
                 (talker-spawn-func (-> *talker-speech* 171) *entity-pool* (target-pos 0) (the-as region #f))
                 )
                ((= v0-8 2)
                 (talker-spawn-func (-> *talker-speech* 172) *entity-pool* (target-pos 0) (the-as region #f))
                 )
                ((= v0-8 3)
                 (talker-spawn-func (-> *talker-speech* 173) *entity-pool* (target-pos 0) (the-as region #f))
                 )
                ((= v0-8 4)
                 (talker-spawn-func (-> *talker-speech* 174) *entity-pool* (target-pos 0) (the-as region #f))
                 )
                ((= v0-8 5)
                 (talker-spawn-func (-> *talker-speech* 175) *entity-pool* (target-pos 0) (the-as region #f))
                 )
                ((= v0-8 6)
                 (talker-spawn-func (-> *talker-speech* 176) *entity-pool* (target-pos 0) (the-as region #f))
                 )
                ((= v0-8 7)
                 (talker-spawn-func (-> *talker-speech* 177) *entity-pool* (target-pos 0) (the-as region #f))
                 )
                )
              )
            )
          )
        (let ((s4-9 (clear *temp-string*)))
          (format s4-9 "~s" (lookup-text! *common-text* (text-id-for-vehicle-type s5-0 #t) #f))
          (charp<-string (-> *lobby-results-new-vehicle-screen-text* 0 text) s4-9)
          )
        (let ((s4-10 (clear *temp-string*)))
          (format s4-10 "~s" (lookup-text! *common-text* (text-id-class-for-vehicle-type s5-0) #f))
          (charp<-string (-> *lobby-results-new-vehicle-class-text* 0 text) s4-10)
          )
        )
      (let ((a1-16 (-> *game-info* car-info data gp-0 tuning)))
        (lobby-menu-update-performance-globals (the-as car-type gp-0) (the-as symbol a1-16))
        )
      )
    (copy-string<-string (-> self cam-string) "camera-18")
    )
  :exit (behavior ()
    (if *garage-cinema*
        (deactivate *garage-cinema*)
        )
    (copy-string<-string (-> self cam-string) "camera-6")
    )
  :code (behavior ()
    (local-vars (v1-2 symbol))
    (dotimes (v1-0 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-0))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-0))) info-ptr)
                    *lobby-results-new-vehicle-screen*
                    )
                 )
        (set! v1-2 #t)
        (goto cfg-20)
        )
      )
    (set! v1-2 #f)
    (label cfg-20)
    (if v1-2
        (goto cfg-24)
        )
    (kill-menu self #t #f)
    (create-menu self *lobby-results-new-vehicle-screen* 0)
    #t
    (label cfg-24)
    (remove-setting! 'bg-a)
    (sleep-code)
    )
  :post (behavior ()
    (when (cpad-or-kbd-pressed-var? (the-as uint 0) (pad-buttons x))
      (logclear! (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons x))
      (logclear! (-> *cpad-list* cpads 0 button0-rel 0) (pad-buttons x))
      (cpad-or-kbd-clear-func! (the-as uint 0) (pad-buttons x))
      (when (kill-menu self #f #f)
        (set! *lobby-awards-new-vehicle* (the-as int #f))
        (lobby-awards-handle-vehicle-awarding)
        (cond
          ((lobby-results-awarded-vehicle)
           (set! (-> self vehicle-selected)
                 (the-as uint (vehicle-type-from-car-type (the-as car-type (lobby-results-awarded-vehicle))))
                 )
           (go-virtual lobby-results-new-vehicle-screen)
           )
          (else
            (when (lobby-results-first-awarded-vehicle #f)
              (set! (-> *game-info* player-info (-> self current-local-player) last-selected-vehicle)
                    (the-as uint (vehicle-type-from-car-type (the-as car-type (lobby-results-first-awarded-vehicle #f))))
                    )
              (lobby-results-first-awarded-vehicle #t)
              )
            (go-virtual lobby-results-new-body-parts-screen)
            )
          )
        )
      )
    (lobby-default-post)
    )
  )


  :virtual #t
  :event lobby-menu-manager-default-handler
  :code (behavior ()
    (let* ((gp-0 (-> *game-info* game-movie length))
           (s5-0 0)
           (s4-0 (-> *game-info* game-movie s5-0))
           )
      (while (< s5-0 gp-0)
        (when (and (>= (get-task-cup-score (the-as int (-> s4-0 cup))) (the-as int (-> s4-0 score)))
                   (not (logtest? (-> s4-0 flags) 1))
                   )
          (logior! (-> s4-0 flags) 1)
          (jukebox-onoff #f)
          (level-get *level* 'fmvlev)
          (let ((f0-1 (* 128.0 (-> *setting-control* user-current bg-a)))
                (s3-0 (new-stack-vector0))
                )
            (set! (-> s3-0 w) f0-1)
            (lobby-level-set! 1 'fmvlev #f)
            (setup
              *screen-filter*
              s3-0
              (new 'static 'vector :w 128.0)
              (* 2.0 (seconds-per-frame))
              (bucket-id debug)
              #x3fffff
              #x33001
              (the-as symbol 0)
              )
            )
          (until (= (-> *screen-filter* color w) 128.0)
            (suspend)
            )
          (until #f
            (let ((v1-23 (level-get *level* 'fmvlev)))
              (if (and v1-23 (= (-> v1-23 status) 'loaded))
                  (goto cfg-15)
                  )
              )
            (suspend)
            )
          #f
          (label cfg-15)
          (fmv-player-run (the-as string (-> s4-0 name)) *target-pool* #f)
          (while *fmv-player*
            (suspend)
            )
          (suspend-for (seconds 1)
            )
          (dma-release 'fmv-player)
          (until #f
            (let ((v1-37 (new 'stack-no-clear 'array 'int32 2)))
              (when (dma-try-alloc #x80040 #x80040 'fmv-player 0 (&-> v1-37 0) (&-> v1-37 1) #f)
                (suspend)
                (suspend)
                (goto cfg-25)
                )
              )
            (suspend)
            0
            )
          #f
          (label cfg-25)
          (disable *screen-filter*)
          (suspend)
          0
          )
        (+! s5-0 1)
        (set! s4-0 (-> *game-info* game-movie s5-0))
        )
      )
    (lobby-level-set! 1 'menumap #f)
    (go-virtual lobby-results-new-vehicle-animation)
    (until #f
      (suspend)
      )
    #f
    )
  )


      (charp<-string (-> *lobby-results-new-body-part-screen-text* 0 text) gp-0)
      (let* ((v1-111 (get-open-task-node-info))
             (s4-38 (if v1-111
                        (the-as int (-> v1-111 medals 0))
                        3
                        )
                    )
             )
        (let* ((s3-38 format)
               (s2-38 (clear gp-0))
               (s1-0 "~s")
               (a0-159 *common-text*)
               (t9-96 (method-of-object a0-159 lookup-text!))
               (v1-113 s4-38)
               )
          (s3-38 s2-38 s1-0 (t9-96
                              a0-159
                              (cond
                                ((= v1-113 3)
                                 (text-id text-id-1733)
                                 )
                                ((= v1-113 2)
                                 (text-id text-id-1734)
                                 )
                                (else
                                  (text-id text-id-1735)
                                  )
                                )
                              #f
                              )
                 )
          )
        (charp<-string (-> *lobby-results-new-body-part-screen-text* 1 text) gp-0)
        (when (!= *game-mode* 'adventure)
          (set! (-> *lobby-results-new-body-part-screen-text* 1 text 0) (the-as uint 0))
          0
          )
        (set! (-> (the-as string-menu-info (-> *lobby-results-new-body-part-screen* children 1)) strings-info 1 font-color)
              (cond
                ((= s4-38 3)
                 (font-color font-color-50)
                 )
                ((= s4-38 2)
                 (font-color font-color-49)
                 )
                ((= s4-38 1)
                 (font-color font-color-48)
                 )
                (else
                  (font-color font-color-53)
                  )
                )
              )
        )
      (let* ((v1-125 (get-open-task-node-info))
             (a0-168 (if v1-125
                         (the-as int (-> v1-125 task))
                         0
                         )
                     )
             )
        (set! a0-168 (cond
                       ((nonzero? a0-168)
                        (empty)
                        a0-168
                        )
                       (else
                         32
                         )
                       )
              )
        (let ((s4-39 (-> *task-level-info* (-> *game-info* play-list a0-168 task-level) text-id))
              (s0-0 (-> *net-play-mode-text-ids*
                        (-> *game-info* sub-task-list (-> *game-info* play-list a0-168 play-node) net-play-mode)
                        )
                    )
              )
          (format (clear gp-0) "~s ~s" (lookup-text! *common-text* s4-39 #f) (lookup-text! *common-text* s0-0 #f))
          )
        )
      (charp<-string (-> *lobby-results-new-body-part-screen-text* 2 text) gp-0)
      (format (clear gp-0) "~s" (lookup-text! *common-text* (text-id text-id-3110) #f))
      (charp<-string (-> *lobby-results-new-body-part-screen-text* 3 text) gp-0)
      (let ((s4-42 (-> s5-0 name-id))
            (s5-1 (-> s5-0 short-name-id))
            )
        (format (clear gp-0) "~s" (lookup-text! *common-text* (the-as text-id s4-42) #f))
        (charp<-string (-> *lobby-results-new-body-part-tab-text-ii* 0 text) gp-0)
        (format (clear gp-0) "~s" (lookup-text! *common-text* (the-as text-id s5-1) #f))
        )
      (charp<-string (-> *lobby-results-new-body-part-tab-text* 0 text) gp-0)
      )
    )
  :code (behavior ()
    (local-vars (v1-4 symbol))
    (remove-setting! 'bg-a)
    (dotimes (v1-2 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-2))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-2))) info-ptr)
                    *lobby-results-new-body-part-screen*
                    )
                 )
        (set! v1-4 #t)
        (goto cfg-20)
        )
      )
    (set! v1-4 #f)
    (label cfg-20)
    (if v1-4
        (goto cfg-24)
        )
    (kill-menu self #t #f)
    (create-menu self *lobby-results-new-body-part-screen* 0)
    #t
    (label cfg-24)
    (sleep-code)
    )
  :post (behavior ()
    (when (cpad-or-kbd-pressed-var? (the-as uint 0) (pad-buttons x))
      (logclear! (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons x))
      (logclear! (-> *cpad-list* cpads 0 button0-rel 0) (pad-buttons x))
      (cpad-or-kbd-clear-func! (the-as uint 0) (pad-buttons x))
      (set-action!
        *gui-control*
        (gui-action stop)
        (-> self voice-id)
        (gui-channel none)
        (gui-action none)
        (the-as string #f)
        (the-as (function gui-connection symbol) #f)
        (the-as process #f)
        )
      (if (kill-menu self #f #f)
          (go-virtual lobby-results-new-body-parts-screen)
          )
      )
    (lobby-default-post)
    )
  )

;; failed to figure out what this is:
(defstate lobby-results-new-vehicle-animation (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('garage-cinema)
       (go-virtual lobby-results-new-vehicle-screen)
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (cond
      ((nonzero? (get-next-training-task))
       (load-state-method-25 *load-state* #f)
       (cond
         (*lobby-results-no-adventure-mode*
           (remove-setting! 'bg-a)
           (kill-menu self #t #f)
           (create-menu self *base-menu-info* 0)
           (go-virtual game-type-menu)
           )
         (else
           (remove-setting! 'bg-a)
           (set! *adv-coming-back-from-game* #t)
           (go-virtual adventure-save)
           )
         )
       )
      (else
        (lobby-awards-handle-vehicle-awarding)
        (if (not (lobby-results-awarded-vehicle))
            (go-virtual lobby-results-new-vehicle-screen)
            )
        (set! (-> self vehicle-selected)
              (the-as uint (vehicle-type-from-car-type (the-as car-type (lobby-results-awarded-vehicle))))
              )
        (kill-menu self #f #f)
        (send-event (the-as base-menu (handle->process (-> *lobby-menu-manager* menu-handle-background))) 'die)
        )
      )
    )
  :exit (behavior ()
    (set! (-> *lobby-menu-manager* override-fov) #f)
    (let ((a0-1 (search-process-tree *active-pool* (lambda ((arg0 process)) (= (-> arg0 type) garage-turntable)))))
      (send-event a0-1 'speed 1.0)
      )
    (lmm-make-background-menu self)
    (if *garage-cinema*
        (deactivate *garage-cinema*)
        )
    (send-event
      (search-process-tree *active-pool* (lambda ((arg0 process)) (= (-> arg0 type) garage-sliding-door)))
      'hide
      )
    )
  :code (behavior ()
    (while (not (handle->process (-> self vehicle-handle)))
      (suspend)
      )
    (remove-setting! 'bg-a)
    (set-setting! 'music 'awardcar 0.0 0)
    (let ((gp-0 (search-process-tree *active-pool* (lambda ((arg0 process)) (= (-> arg0 type) garage-turntable)))))
      (send-event gp-0 'speed 1.1)
      (send-event gp-0 'go-down)
      )
    (suspend-for (seconds 1)
      )
    (if (= (-> self vehicle-selected) 1)
        (talker-spawn-func (-> *talker-speech* 100) *entity-pool* (target-pos 0) (the-as region #f))
        )
    (send-event
      (search-process-tree *active-pool* (lambda ((arg0 process)) (= (-> arg0 type) garage-sliding-door)))
      'show
      )
    (let ((f30-0 camera-seek-time))
      (set! (-> *lobby-menu-manager* override-fov) (the-as basic #t))
      (set-lobby-camera-seek-time! 0.0000001)
      (copy-string<-string (-> self cam-string) "camera-63")
      (let ((gp-4 (search-process-tree *active-pool* (lambda ((arg0 process)) (= (-> arg0 type) garage-turntable)))))
        (send-event gp-4 'speed 0.099)
        (send-event gp-4 'go-up)
        )
      (suspend-for (seconds 1.25)
        )
      (suspend)
      (copy-string<-string (-> self cam-string) "camera-64")
      (suspend)
      (set-lobby-camera-seek-time! 0.11)
      (copy-string<-string (-> self cam-string) "camera-65")
      (suspend-for (seconds 2.5)
        )
      (set-lobby-camera-seek-time! 0.000000001)
      (set! (-> *lobby-menu-manager* override-fov) #f)
      (copy-string<-string (-> self cam-string) "camera-66")
      (suspend)
      (when #t
        (let ((a0-25 *garage-cinema*))
          (if a0-25
              (deactivate a0-25)
              )
          )
        (process-spawn
          garage-cinema
          (new 'static 'vector :w 1.0)
          (entity-by-name "garage-turntable-3")
          :name "garage-cinema"
          :to self
          )
        )
      (set-lobby-camera-seek-time! f30-0)
      )
    (sleep-code)
    )
  :post (behavior ()
    (when (cpad-or-kbd-pressed-var? (the-as uint 0) (pad-buttons x))
      (logclear! (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons x))
      (logclear! (-> *cpad-list* cpads 0 button0-rel 0) (pad-buttons x))
      (cpad-or-kbd-clear-func! (the-as uint 0) (pad-buttons x))
      (go-virtual lobby-results-new-vehicle-screen)
      )
    (lobby-default-post)
    )
  )


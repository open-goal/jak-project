;; failed to figure out what this is:
(defstate player-info-screen (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (local-vars (v0-0 object))
    (case message
      (('async-clan-update)
       (when (not (and *pending-op*
                       *lobby-menu-manager*
                       (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                          (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                          )
                       )
                  )
         (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
         (set! v0-0
               (lambda :behavior lobby-menu-manager
                 ()
                 (local-vars (v1-7 object))
                 (cond
                   (*net-mgr-pending-behavior-valid*
                     #f
                     )
                   (else
                     (until v1-7
                       (suspend)
                       (set! v1-7 (or (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'lobby-idle))
                                      (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'playing-game))
                                      )
                             )
                       )
                     (set! *net-mgr-pending-behavior-result* 'undefined)
                     (send-event *net-mgr* 'do-behavior 'retrieve-my-clan-data)
                     (while (= *net-mgr-pending-behavior-result* 'undefined)
                       (suspend)
                       )
                     (suspend)
                     *net-mgr-pending-behavior-result*
                     )
                   )
                 )
               )
         (set! *pending-op* (the-as (function object object object object object object object object object)
                              (the-as (function object :behavior lobby-menu-manager) v0-0)
                              )
               )
         v0-0
         )
       )
      (('menu-selection-event)
       (if (and *pending-op*
                *lobby-menu-manager*
                (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                   (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                   )
                )
           (return #f)
           )
       (case (-> block param 0)
         (('buttons-changed)
          (let ((v1-19 (lookup-player *player-info-player*)))
            (if v1-19
                (send-event
                  (find-menu self 'player-stats)
                  'set-stats-array
                  (-> v1-19 ladder-stats)
                  *net-player-ladder-stats-info-array*
                  (-> v1-19 stats)
                  )
                )
            )
          )
         (('accept)
          (when (and (nonzero? (-> *net-mgr* game-state connect-handle))
                     (!= (-> block param 1) 'add-buddy)
                     (!= (-> block param 1) 'send-message)
                     (!= (-> block param 1) 'kick-player)
                     (!= (-> block param 1) 'kick-ignore-player)
                     (!= (-> block param 1) 'send-game-invite)
                     (!= (-> block param 1) 'invite-to-clan)
                     (!= (-> block param 1) 'mute-player)
                     (!= (-> block param 1) 'unmute-player)
                     )
            (let ((v1-35 (make-sound-instance snd-illegal1 (new 'static 'sound-id) (the-as handle #f))))
              (cond
                (v1-35
                  (logior! (-> v1-35 flags) (sound-spec-flag needs-update non-positional))
                  (-> v1-35 id)
                  )
                (else
                  0
                  )
                )
              )
            (return #f)
            )
          (case (-> block param 1)
            (('mute-player)
             (move-to-front! *medius-mute-list* (the-as medius-cache (get-id *player-info-player*)))
             )
            (('unmute-player)
             (remove! *medius-mute-list* (get-id *player-info-player*))
             )
            (('kick-player)
             (when (= (if *net-mgr*
                          (-> *net-mgr* game-state local-machine-idx)
                          0
                          )
                      (-> *net-mgr* game-state session-master-idx)
                      )
               (when (not (and *pending-op*
                               *lobby-menu-manager*
                               (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                                  (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                                  )
                               )
                          )
                 (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
                 (set! v0-0
                       (lambda :behavior lobby-menu-manager
                         ()
                         (when (and *net-process-mgr* *net-world* *net-mgr*)
                           (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-3032))
                           (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1712))
                           (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1926))
                           (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-4273))
                           (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
                           (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
                           (go-virtual
                             lobby-generic-error-menu
                             *lobby-generic-confirmation*
                             (lambda :behavior lobby-menu-manager
                               ()
                               (dotimes (gp-0 8)
                                 (let ((s5-0 (-> *net-process-mgr* machines gp-0)))
                                   (if (= (-> s5-0 acct-id) (get-id *player-info-player*))
                                       (kick-machines (ash 1 gp-0) 'booted)
                                       )
                                   )
                                 )
                               (go-virtual player-info-screen)
                               )
                             (the-as (function symbol object) (lambda :behavior lobby-menu-manager () (go-virtual player-info-screen)))
                             #f
                             #f
                             #f
                             )
                           )
                         )
                       )
                 (set! *pending-op* (the-as (function object object object object object object object object object)
                                      (the-as (function object :behavior lobby-menu-manager) v0-0)
                                      )
                       )
                 v0-0
                 )
               )
             )
            (('kick-ignore-player)
             (when (= (if *net-mgr*
                          (-> *net-mgr* game-state local-machine-idx)
                          0
                          )
                      (-> *net-mgr* game-state session-master-idx)
                      )
               (when (not (and *pending-op*
                               *lobby-menu-manager*
                               (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                                  (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                                  )
                               )
                          )
                 (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
                 (set! v0-0
                       (lambda :behavior lobby-menu-manager
                         ()
                         (when (and *net-process-mgr* *net-world* *net-mgr*)
                           (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-3032))

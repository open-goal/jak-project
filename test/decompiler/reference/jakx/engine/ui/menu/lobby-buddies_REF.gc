;;-*-Lisp-*-
(in-package goal)

;; definition for symbol *remove-buddy-id*, type int
(define *remove-buddy-id* -1)

;; definition for symbol *buddy-list-type*, type symbol
(define *buddy-list-type* 'buddy)

;; definition for function construct-buddy-confirmation-string
;; WARN: Return type mismatch int vs object.
(defun construct-buddy-confirmation-string ((arg0 symbol) (arg1 (pointer uint8)))
  (expand-text-to-charp! *common-text* (-> *medius-policy-string2* data) arg1)
  (format
    (clear *medius-policy-string*)
    (lookup-text!
      *common-text*
      (cond
        ((= arg0 'remove-buddy)
         (text-id text-id-3333)
         )
        ((= arg0 'remove-ignore)
         (text-id text-id-3336)
         )
        ((= arg0 'ignore-buddy)
         (text-id text-id-3337)
         )
        ((= arg0 'add-ignore)
         (text-id text-id-3338)
         )
        (else
          (text-id text-id-0)
          )
        )
      #f
      )
    *medius-policy-string2*
    )
  0
  )

;; definition for function player-in-game
(defun player-in-game ((arg0 medius-player))
  (if (not *net-process-mgr*)
      (return #f)
      )
  (dotimes (v1-3 8)
    (if (= (-> *net-process-mgr* machines v1-3 acct-id) arg0)
        (return #t)
        )
    )
  #f
  )

;; definition of type player-info-menu
(deftype player-info-menu (string-menu)
  ((player  medius-player)
   )
  (:methods
    (set-player! (_type_ medius-player) none)
    )
  )

;; definition for method 3 of type player-info-menu
(defmethod inspect ((this player-info-menu))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type string-menu inspect)))
    (t9-0 this)
    )
  (format #t "~2Tplayer: #<medius-player @ #x~X>~%" (-> this player))
  (label cfg-4)
  this
  )

;; definition for method 69 of type player-info-menu
;; WARN: Return type mismatch int vs none.
(defmethod set-player! ((this player-info-menu) (arg0 medius-player))
  (set! (-> this player) arg0)
  0
  (none)
  )

;; definition for method 67 of type player-info-menu
;; WARN: Return type mismatch int vs none.
;; WARN: Function (method 67 player-info-menu) has a return type of none, but the expression builder found a return statement.
(defmethod update-strings ((this player-info-menu))
  (local-vars (v1-50 medius-player-status))
  (let ((s5-0 (-> this player))
        (gp-0 (-> this strings))
        (s4-0 0)
        )
    (dotimes (s2-0 (-> this strings length))
      (clear (-> this strings data s2-0 text))
      )
    (if (not s5-0)
        (return #f)
        )
    (expand-text-to-charp! *common-text* (-> gp-0 data 0 text data) (get-player-name-and-clan s5-0))
    (let ((s4-1 (+ s4-0 1))
          (s3-2 (lookup-player s5-0))
          )
      (if (not s3-2)
          (return #f)
          )
      (copy-charp<-charp
        (-> gp-0 data s4-1 text data)
        (-> (lookup-text! *common-text* (text-id text-id-1771) #f) data)
        )
      (if (and (nonzero? (-> *net-mgr* game-state connect-handle))
               (= (-> s3-2 online-state connect-status) (medius-player-status medius-player-in-game-world))
               (= (-> s3-2 online-state medius-game-world-id) (-> *net-active-game* medius-world-id))
               (not (player-in-game (the-as medius-player (get-id *player-info-player*))))
               )
          (set! (-> s3-2 online-state connect-status) (medius-player-status medius-player-in-chat-world))
          )
      (cond
        ((player-in-game (the-as medius-player (get-id *player-info-player*)))
         (copy-charp<-charp
           (-> gp-0 data (+ s4-1 1) text data)
           (-> (lookup-text! *common-text* (text-id text-id-1773) #f) data)
           )
         (copy-charp<-charp
           (-> gp-0 data (+ s4-1 2) text data)
           (-> (lookup-text! *common-text* (text-id text-id-1772) #f) data)
           )
         (copy-charp<-charp
           (-> gp-0 data (+ s4-1 3) text data)
           (-> (lookup-text! *common-text* (text-id text-id-3383) #f) data)
           )
         )
        ((begin
           (set! v1-50 (-> s3-2 online-state connect-status))
           (= v1-50 (medius-player-status medius-player-in-other-universe))
           )
         (copy-charp<-charp
           (-> gp-0 data (+ s4-1 1) text data)
           (-> (lookup-text! *common-text* (text-id text-id-1773) #f) data)
           )
         (copy-charp<-charp
           (-> gp-0 data (+ s4-1 2) text data)
           (-> (lookup-text! *common-text* (text-id text-id-1772) #f) data)
           )
         (copy-charp<-charp (-> gp-0 data (+ s4-1 3) text data) (-> s3-2 online-state game-name))
         (+! s4-1 4)
         )
        ((= v1-50 (medius-player-status medius-player-in-chat-world))
         (copy-charp<-charp
           (-> gp-0 data (+ s4-1 1) text data)
           (-> (lookup-text! *common-text* (text-id text-id-1773) #f) data)
           )
         (copy-charp<-charp
           (-> gp-0 data (+ s4-1 2) text data)
           (-> (lookup-text! *common-text* (text-id text-id-1772) #f) data)
           )
         (copy-charp<-charp
           (-> gp-0 data (+ s4-1 3) text data)
           (-> (lookup-text! *common-text* (text-id text-id-1774) #f) data)
           )
         (+! s4-1 4)
         )
        ((= v1-50 (medius-player-status medius-player-in-game-world))
         (copy-charp<-charp
           (-> gp-0 data (+ s4-1 1) text data)
           (-> (lookup-text! *common-text* (text-id text-id-1773) #f) data)
           )
         (copy-charp<-charp
           (-> gp-0 data (+ s4-1 2) text data)
           (-> (lookup-text! *common-text* (text-id text-id-1772) #f) data)
           )
         (let ((v1-100 (get-game-status s5-0)))
           (cond
             ((= v1-100 1)
              (copy-charp<-charp
                (-> gp-0 data (+ s4-1 3) text data)
                (-> (lookup-text! *common-text* (text-id text-id-1775) #f) data)
                )
              )
             ((= v1-100 2)
              (copy-charp<-charp
                (-> gp-0 data (+ s4-1 3) text data)
                (-> (lookup-text! *common-text* (text-id text-id-1776) #f) data)
                )
              )
             ((zero? v1-100)
              (copy-charp<-charp
                (-> gp-0 data (+ s4-1 3) text data)
                (-> (lookup-text! *common-text* (text-id text-id-1774) #f) data)
                )
              )
             )
           )
         (+! s4-1 4)
         )
        (else
          (copy-charp<-charp
            (-> gp-0 data (+ s4-1 1) text data)
            (-> (lookup-text! *common-text* (text-id text-id-1777) #f) data)
            )
          (+! s4-1 2)
          )
        )
      (if (!= (-> s3-2 stats stats-version) 11)
          (return #f)
          )
      (when (> (-> s3-2 stats current-clan) 0)
        (let ((s3-3 (the-as medius-cached-info-clan (lookup *medius-clan-cache* (-> s3-2 stats current-clan) 9000 #f #f))))
          (when (!= s3-3 'error)
            (when (and s3-3 (contains? (-> s3-3 members) (-> s5-0 id)))
              (copy-charp<-charp
                (-> gp-0 data s4-1 text data)
                (-> (lookup-text! *common-text* (text-id text-id-1836) #f) data)
                )
              (expand-text-to-charp! *common-text* (-> gp-0 data (+ s4-1 1) text data) (-> s3-3 name))
              (+ s4-1 2)
              )
            )
          )
        )
      )
    )
  0
  (none)
  )

;; definition for method 61 of type player-info-menu
(defmethod default-event-handler ((this player-info-menu) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (case arg2
    (('update-strings)
     (set-player! this (the-as medius-player (-> arg3 param 0)))
     )
    (else
      (call-parent-method this arg0 arg1 arg2 arg3)
      )
    )
  )


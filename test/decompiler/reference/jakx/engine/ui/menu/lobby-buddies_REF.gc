  :enter (behavior ()
    (set! *lobby-handling-db-error* #f)
    )
  :code (behavior ()
    (local-vars (v1-2 symbol) (v1-19 object) (v1-44 symbol) (v1-57 symbol) (v1-78 object) (v1-114 object))
    (dotimes (v1-0 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-0))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-0))) info-ptr) *lobby-main-screen*)
                 )
        (set! v1-2 #t)
        (goto cfg-20)
        )
      )
    (set! v1-2 #f)
    (label cfg-20)
    (if (not v1-2)
        (kill-menu self #t #f)
        )
    (set! (-> self garage-lights-target) 0.0)
    (copy-string<-string (-> self cam-string) "camera-6")
    (when (-> *net-mgr* lobby-state in-special-channel)
      (format 0 "getting out of clan room~%")
      (let ((v1-12
              (cond
                (*net-mgr-pending-behavior-valid*
                  #f
                  )
                (else
                  (until v1-19
                    (suspend)
                    (set! v1-19 (or (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'lobby-idle))
                                    (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'playing-game))
                                    )
                          )
                    )
                  (set! *net-mgr-pending-behavior-result* 'undefined)
                  (send-event *net-mgr* 'do-behavior 'join-room (-> *net-mgr* lobby-state last-normal-channel-id))
                  (while (= *net-mgr-pending-behavior-result* 'undefined)
                    (suspend)
                    )
                  (suspend)
                  *net-mgr-pending-behavior-result*
                  )
                )
              )
            )
        (if (!= v1-12 'success)
            (go-virtual chat-room-select)
            )
        )
      )
    (set! *player-menu-array-to-use* *medius-buddies-online*)
    (cond
      ((!= (-> *medius-my-clan* medius-id) -1)
       (dotimes (v1-42 (+ (-> self in-focus-index) 1))
         (when (and (handle->process (-> self menu-handles v1-42))
                    (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-42))) info-ptr) *lobby-main-screen*)
                    )
           (set! v1-44 #t)
           (goto cfg-63)
           )
         )
       (set! v1-44 #f)
       (label cfg-63)
       (if v1-44
           (goto cfg-67)
           )
       (kill-menu self #t #f)
       (create-menu self *lobby-main-screen* 0)
       #t
       (label cfg-67)
       )
      (else
        (dotimes (v1-55 (+ (-> self in-focus-index) 1))
          (when (and (handle->process (-> self menu-handles v1-55))
                     (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-55))) info-ptr)
                        *lobby-main-screen-no-clan*
                        )
                     )
            (set! v1-57 #t)
            (goto cfg-88)
            )
          )
        (set! v1-57 #f)
        (label cfg-88)
        (if v1-57
            (goto cfg-92)
            )
        (kill-menu self #t #f)
        (create-menu self *lobby-main-screen-no-clan* 0)
        #t
        )
      )
    (label cfg-92)
    (suspend)
    (let ((v1-69 (as-type (find-menu self 'clan-list) scrolling-menu-player)))
      (if v1-69
          (set! (-> v1-69 players) *medius-clan-members-online*)
          )
      )
    (restore-selection-index)
    (until #f
      (cond
        (*net-mgr-pending-behavior-valid*
          )
        (else
          (until v1-78
            (suspend)
            (set! v1-78 (or (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'lobby-idle))
                            (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'playing-game))
                            )
                  )
            )
          (set! *net-mgr-pending-behavior-result* 'undefined)
          (send-event *net-mgr* 'do-behavior 'buddies-refreshing)
          (while (= *net-mgr-pending-behavior-result* 'undefined)
            (suspend)
            )
          (suspend)
          *net-mgr-pending-behavior-result*
          )
        )
      (let ((gp-1 (find-menu self 'buddy-list)))
        (when gp-1
          (send-event gp-1 'filter-offline #t)
          (send-event gp-1 'update)
          )
        )
      (when (!= (-> *medius-my-clan* medius-id) -1)
        (cond
          (*net-mgr-pending-behavior-valid*
            )
          (else
            (until v1-114
              (suspend)
              (set! v1-114
                    (or (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'lobby-idle))
                        (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'playing-game))
                        )
                    )
              )
            (set! *net-mgr-pending-behavior-result* 'undefined)
            (send-event
              *net-mgr*
              'do-behavior
              'get-clan-member-list
              (-> *medius-my-clan* medius-id)
              (-> *medius-my-clan* members)
              )
            (while (= *net-mgr-pending-behavior-result* 'undefined)
              (suspend)
              )
            (suspend)
            *net-mgr-pending-behavior-result*
            )
          )
        (let ((gp-2 (find-menu self 'clan-list)))
          (when gp-2
            (send-event gp-2 'filter-offline #t)
            (send-event gp-2 'update)
            )
          )
        )
      (suspend-for (seconds 30)
        (do-pending-operation)
        (if (not (and *net-mgr* (nonzero? (-> *net-mgr* lobby-state connect-handle))))
            (send-event self 'lobby-unexpected-error)
            )
        )
      )
    #f
    )
  :post lobby-default-post
  )


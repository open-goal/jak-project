;; failed to figure out what this is:
(defstate inviting-buddies (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (local-vars (v0-0 object))
    (case message
      (('menu-selection-event)
       (if (and *pending-op*
                *lobby-menu-manager*
                (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                   (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                   )
                )
           (return #f)
           )
       (case (-> block param 0)
         (('accept)
          (case (-> block param 1)
            (('player-list)
             (mem-copy!
               (the-as pointer *player-info-player*)
               (the-as pointer (-> *player-menu-array-to-use* data (-> block param 2)))
               4
               )
             (when (not (and *pending-op*
                             *lobby-menu-manager*
                             (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                                (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                                )
                             )
                        )
               (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
               (set! v0-0 (lambda :behavior lobby-menu-manager () (go-virtual player-info-screen)))
               (set! *pending-op* (the-as (function object object object object object object object object object)
                                    (the-as (function object :behavior lobby-menu-manager) v0-0)
                                    )
                     )
               v0-0
               )
             )
            )
          )
         (('cancel)
          (-> block param 1)
          (when (not (and *pending-op*
                          *lobby-menu-manager*
                          (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                             (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                             )
                          )
                     )
            (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
            (set! v0-0 (lambda :behavior lobby-menu-manager () (go-virtual going-to-ready-room)))
            (set! *pending-op* (the-as (function object object object object object object object object object)
                                 (the-as (function object :behavior lobby-menu-manager) v0-0)
                                 )
                  )
            v0-0
            )
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :exit (behavior ()
    (let ((a0-1 (handle->process (-> *keyboard-proc* handle))))
      (if a0-1
          (deactivate a0-1)
          )
      )
    )
  :code (behavior ((arg0 int))
    (local-vars (v1-8 object) (v1-47 symbol))
    (cond
      (*net-mgr-pending-behavior-valid*
        )
      (else
        (until v1-8
          (suspend)
          (set! v1-8 (or (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'lobby-idle))
                         (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'playing-game))
                         )
                )
          )
        (set! *net-mgr-pending-behavior-result* 'undefined)
        (send-event *net-mgr* 'do-behavior 'buddies-refreshing)
        (while (= *net-mgr-pending-behavior-result* 'undefined)
          (suspend)
          )
        (suspend)
        *net-mgr-pending-behavior-result*
        )
      )
    (when (zero? (-> *medius-buddies-online* ct))
      (cond
        ((or (= (-> self prev-state name) 'ready-room-state) (= (-> self prev-state name) 'ready-room-options))
         (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-3339))
         (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
         (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
         (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
         (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
         (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
         (go-virtual
           lobby-generic-error-menu
           *lobby-generic-confirmation*
           (lambda :behavior lobby-menu-manager () (go-virtual going-to-ready-room))
           (the-as (function symbol object) #f)
           #t
           #f
           #f
           )
         )
        (else
          (go-virtual going-to-ready-room)
          )
        )
      )
    (set! *player-menu-array-to-use* *medius-buddies-online*)
    (format #t "pad: ~D~%" arg0)
    (dotimes (v1-45 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-45))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-45))) info-ptr) *inviting-buddies*)
                 )
        (set! v1-47 #t)
        (goto cfg-44)
        )
      )
    (set! v1-47 #f)
    (label cfg-44)
    (if v1-47
        (goto cfg-48)
        )
    (kill-menu self #t #f)
    (create-menu self *inviting-buddies* arg0)
    #t
    (label cfg-48)
    (suspend)
    (send-event (find-menu self 'player-list) 'update)
    (until #f
      (do-pending-operation)
      (suspend)
      )
    #f
    )
  )

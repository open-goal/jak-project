;; failed to figure out what this is:
(defstate lobby-main-screen (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (local-vars (v0-0 object))
    (case message
      (('menu-selection-event)
       (if (and *pending-op*
                *lobby-menu-manager*
                (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                   (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                   )
                )
           (return #f)
           )
       (case (-> block param 0)
         (('cancel)
          (when (not (and *pending-op*
                          *lobby-menu-manager*
                          (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                             (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                             )
                          )
                     )
            (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
            (set! v0-0 (lambda :behavior lobby-menu-manager
                         ()
                         (when (no-menus-dying? self)
                           (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-1667))
                           (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1712))
                           (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-3884))
                           (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-3883))
                           (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
                           (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
                           (go-virtual
                             lobby-generic-error-menu
                             *lobby-generic-confirmation*
                             (lambda :behavior lobby-menu-manager
                               ()
                               (kill-menu self #t #t)
                               (send-event *net-mgr* 'leave-lobby)
                               (go-virtual pre-game-type-menu)
                               )
                             (the-as (function symbol object) (lambda :behavior lobby-menu-manager
                                                                ()
                                                                (send-event (get-in-focus-menu self) 'unhide)
                                                                (go-virtual lobby-main-screen)
                                                                )
                                     )
                             #f
                             #f
                             #f
                             )
                           )
                         )
                  )
            (set! *pending-op* (the-as (function object object object object object object object object object)
                                 (the-as (function object :behavior lobby-menu-manager) v0-0)
                                 )
                  )
            v0-0
            )
          )
         (('accept)
          (case (-> block param 1)
            (('create-game)
             (set! *game-launched-from-room* #f)
             (when (and (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'lobby-idle)) (kill-menu self #f #f))
               (when (not (and *pending-op*
                               *lobby-menu-manager*
                               (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                                  (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                                  )
                               )
                          )
                 (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
                 (set! v0-0 (lambda :behavior lobby-menu-manager () (go-virtual set-game-name)))
                 (set! *pending-op* (the-as (function object object object object object object object object object)
                                      (the-as (function object :behavior lobby-menu-manager) v0-0)
                                      )
                       )
                 v0-0
                 )
               )
             )
            (('quickplay)
             (when (not (and *pending-op*
                             *lobby-menu-manager*
                             (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                                (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                                )
                             )
                        )
               (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
               (set! v0-0 (lambda :behavior lobby-menu-manager () (go-virtual do-quickplay)))
               (set! *pending-op* (the-as (function object object object object object object object object object)
                                    (the-as (function object :behavior lobby-menu-manager) v0-0)
                                    )
                     )
               v0-0
               )
             )
            (('find-game)
             (when (not (and *pending-op*
                             *lobby-menu-manager*
                             (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                                (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                                )
                             )
                        )
               (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
               (set! v0-0 (lambda :behavior lobby-menu-manager () (go-virtual game-search-screen)))
               (set! *pending-op* (the-as (function object object object object object object object object object)
                                    (the-as (function object :behavior lobby-menu-manager) v0-0)

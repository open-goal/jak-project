;; definition for function setup-player-info-buttons
;; WARN: Return type mismatch int vs object.
(defun setup-player-info-buttons ((arg0 base-menu-info))
  (let ((s4-0 (get-id *player-info-player*))
        (s5-0 1)
        (s3-0 (lookup-player *player-info-player*))
        (gp-1 (the-as (array dropdown-item-info) (-> arg0 children)))
        )
    (let ((v1-3 (nonzero? (-> *net-mgr* game-state connect-handle))))
      (set! (-> gp-1 length) 0)
      (if (not s3-0)
          (return (the-as object #f))
          )
      (cond
        (v1-3
          (when (or (= (-> s3-0 online-state connect-status) (medius-player-status medius-player-in-chat-world))
                    (= (-> s3-0 online-state connect-status) (medius-player-status medius-player-in-game-world))
                    (= (-> s3-0 online-state connect-status) (medius-player-status medius-player-in-other-universe))
                    )
            (set! (-> gp-1 s5-0 strings-info 0 id) (text-id text-id-1783))
            (set! (-> gp-1 s5-0 name-symbol) 'send-message)
            (set! (-> gp-1 s5-0 selection-type) (-> gp-1 s5-0 name-symbol))
            (+! s5-0 1)
            )
          (when (!= s4-0 (-> *net-mgr* lobby-state my-account-id))
            (cond
              ((player-in-game (the-as medius-player s4-0))
               (when (= (if *net-mgr*
                            (-> *net-mgr* game-state local-machine-idx)
                            0
                            )
                        (-> *net-mgr* game-state session-master-idx)
                        )
                 (set! (-> gp-1 s5-0 strings-info 0 id) (text-id text-id-3382))
                 (set! (-> gp-1 s5-0 name-symbol) 'kick-player)
                 (set! (-> gp-1 s5-0 selection-type) (-> gp-1 s5-0 name-symbol))
                 (let ((v1-30 (+ s5-0 1)))
                   (set! (-> gp-1 v1-30 strings-info 0 id) (text-id text-id-3650))
                   (set! (-> gp-1 v1-30 name-symbol) 'kick-ignore-player)
                   (set! (-> gp-1 v1-30 selection-type) (-> gp-1 v1-30 name-symbol))
                   (set! s5-0 (+ v1-30 1))
                   )
                 )
               (cond
                 ((contains? *medius-mute-list* s4-0)
                  (set! (-> gp-1 s5-0 strings-info 0 id) (text-id text-id-3486))
                  (set! (-> gp-1 s5-0 name-symbol) 'unmute-player)
                  (set! (-> gp-1 s5-0 selection-type) (-> gp-1 s5-0 name-symbol))
                  (+! s5-0 1)
                  )
                 (else
                   (set! (-> gp-1 s5-0 strings-info 0 id) (text-id text-id-3485))
                   (set! (-> gp-1 s5-0 name-symbol) 'mute-player)
                   (set! (-> gp-1 s5-0 selection-type) (-> gp-1 s5-0 name-symbol))
                   (+! s5-0 1)
                   )
                 )
               )
              (else
                (when (or (= (-> s3-0 online-state connect-status) (medius-player-status medius-player-in-chat-world))
                          (= (-> s3-0 online-state connect-status) (medius-player-status medius-player-in-game-world))
                          (= (-> s3-0 online-state connect-status) (medius-player-status medius-player-in-other-universe))
                          )
                  (set! (-> gp-1 s5-0 strings-info 0 id) (text-id text-id-3363))
                  (set! (-> gp-1 s5-0 name-symbol) 'send-game-invite)
                  (set! (-> gp-1 s5-0 selection-type) (-> gp-1 s5-0 name-symbol))
                  (+! s5-0 1)
                  )
                )
              )
            (when (not (contains? *medius-buddies* s4-0))
              (set! (-> gp-1 s5-0 strings-info 0 id) (text-id text-id-1784))
              (set! (-> gp-1 s5-0 name-symbol) 'add-buddy)
              (set! (-> gp-1 s5-0 selection-type) (-> gp-1 s5-0 name-symbol))
              (+! s5-0 1)
              )
            )
          )
        (else
          (when (or (= (-> s3-0 online-state connect-status) (medius-player-status medius-player-in-chat-world))
                    (= (-> s3-0 online-state connect-status) (medius-player-status medius-player-in-game-world))
                    (= (-> s3-0 online-state connect-status) (medius-player-status medius-player-in-other-universe))
                    )
            (set! (-> gp-1 s5-0 strings-info 0 id) (text-id text-id-1783))
            (set! (-> gp-1 s5-0 name-symbol) 'send-message)
            (set! (-> gp-1 s5-0 selection-type) (-> gp-1 s5-0 name-symbol))
            (+! s5-0 1)
            (when (and (!= (get-id *player-info-player*) (-> *net-mgr* lobby-state my-account-id))
                       (!= (-> s3-0 online-state connect-status) 4)
                       )
              (set! (-> gp-1 s5-0 strings-info 0 id) (text-id text-id-1782))
              (set! (-> gp-1 s5-0 name-symbol) 'join-player)
              (set! (-> gp-1 s5-0 selection-type) (-> gp-1 s5-0 name-symbol))
              (+! s5-0 1)
              )
            )
          (cond
            ((contains? *medius-buddies* s4-0)
             (set! (-> gp-1 s5-0 strings-info 0 id) (text-id text-id-1824))
             (set! (-> gp-1 s5-0 name-symbol) 'remove-buddy)
             (set! (-> gp-1 s5-0 selection-type) (-> gp-1 s5-0 name-symbol))
             (+! s5-0 1)
             )
            ((contains? *medius-ignores* s4-0)
             (set! (-> gp-1 s5-0 strings-info 0 id) (text-id text-id-1831))
             (set! (-> gp-1 s5-0 name-symbol) 'remove-ignore)
             (set! (-> gp-1 s5-0 selection-type) (-> gp-1 s5-0 name-symbol))
             (+! s5-0 1)
             )
            ((= (-> *net-mgr* lobby-state my-account-id) s4-0)
             )
            (else
              (set! (-> gp-1 s5-0 strings-info 0 id) (text-id text-id-1784))
              (set! (-> gp-1 s5-0 name-symbol) 'add-buddy)
              (set! (-> gp-1 s5-0 selection-type) (-> gp-1 s5-0 name-symbol))
              (let ((v1-124 (+ s5-0 1)))
                (set! (-> gp-1 v1-124 strings-info 0 id) (text-id text-id-1785))
                (set! (-> gp-1 v1-124 name-symbol) 'add-ignore)
                (set! (-> gp-1 v1-124 selection-type) (-> gp-1 v1-124 name-symbol))
                (set! s5-0 (+ v1-124 1))
                )
              )
            )
          (when (and (and (!= (-> *medius-my-clan* medius-id) -1)
                          (= (-> *medius-my-clan* leader-acct-id) (-> *net-mgr* lobby-state my-account-id))
                          )
                     (!= (get-id *player-info-player*) (-> *net-mgr* lobby-state my-account-id))
                     )
            (cond
              ((contains? (-> *medius-my-clan* members) s4-0)
               (set! (-> gp-1 s5-0 strings-info 0 id) (text-id text-id-1988))
               (set! (-> gp-1 s5-0 name-symbol) 'remove-from-clan)
               (set! (-> gp-1 s5-0 selection-type) (-> gp-1 s5-0 name-symbol))
               (let ((v1-145 (+ s5-0 1)))
                 (set! (-> gp-1 v1-145 strings-info 0 id) (text-id text-id-1987))
                 (set! (-> gp-1 v1-145 name-symbol) 'transfer-clan-leadership)
                 (set! (-> gp-1 v1-145 selection-type) (-> gp-1 v1-145 name-symbol))
                 (set! s5-0 (+ v1-145 1))
                 )
               )
              ((contains? *medius-outstanding-clan-invites* s4-0)
               (set! (-> gp-1 s5-0 strings-info 0 id) (text-id text-id-1986))
               (set! (-> gp-1 s5-0 name-symbol) 'revoke-clan-invite)
               (set! (-> gp-1 s5-0 selection-type) (-> gp-1 s5-0 name-symbol))
               (+! s5-0 1)
               )
              (else
                (set! (-> gp-1 s5-0 strings-info 0 id) (text-id text-id-1985))
                (set! (-> gp-1 s5-0 name-symbol) 'invite-to-clan)
                (set! (-> gp-1 s5-0 selection-type) (-> gp-1 s5-0 name-symbol))
                (+! s5-0 1)
                )
              )
            )
          (when (> (-> s3-0 stats current-clan) 0)
            (let ((v1-165 (the-as medius-cached-info-clan (lookup *medius-clan-cache* (-> s3-0 stats current-clan) 9000 #f #f)))
                  )
              (when (!= v1-165 'error)
                (when (or (not v1-165) (contains? (-> v1-165 members) (get-id *player-info-player*)))
                  (set! (-> gp-1 s5-0 strings-info 0 id) (text-id text-id-2344))
                  (set! (-> gp-1 s5-0 name-symbol) 'clan-information)
                  (set! (-> gp-1 s5-0 selection-type) (-> gp-1 s5-0 name-symbol))
                  (+! s5-0 1)
                  )
                )
              )
            )
          )
        )
      )
    (set! (-> gp-1 length) s5-0)
    (dotimes (v1-175 (-> gp-1 length))
      (when (> v1-175 0)
        (if (= v1-175 1)
            (set! (-> gp-1 v1-175 up-index-modifier) -2)
            )
        (set! (-> gp-1 v1-175 down-index-modifier) 1)
        (if (= v1-175 (+ (-> gp-1 length) -1))
            (set! (-> gp-1 v1-175 down-index-modifier) 2)
            )
        (set! (-> gp-1 v1-175 right-index-modifier) 81)
        )
      )
    (until (= s5-0 (-> gp-1 allocated-length))
      (set! (-> gp-1 s5-0 strings-info 0 id) (text-id text-id-0))
      (set! (-> gp-1 s5-0 name-symbol) #f)
      (set! (-> gp-1 s5-0 selection-type) (-> gp-1 s5-0 name-symbol))
      (+! s5-0 1)
      )
    )
  0
  )

;; definition for function player-info-screen-check-buttons
(defun player-info-screen-check-buttons ()
  (lobby-check-buttons
    setup-player-info-buttons
    (-> *player-info-button-manager* 0)
    (-> *player-info-button-manager* 1)
    'manager
    'root
    )
  )


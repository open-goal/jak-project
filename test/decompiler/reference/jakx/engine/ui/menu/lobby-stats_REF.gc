;; failed to figure out what this is:
(defstate test-screen (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (lobby-menu-manager-default-handler proc argc message block)
    )
  :code (behavior ()
    (set! *dnas-error-code* -402)
    (go-virtual patch-downloading)
    (go-virtual dnas-error-screen)
    (go-virtual dnas-running-screen)
    (go-virtual my-stats-screen)
    (kill-menu self #f #f)
    (create-menu self *test-screen* 0)
    (until #f
      (do-pending-operation)
      (suspend)
      )
    #f
    )
  )

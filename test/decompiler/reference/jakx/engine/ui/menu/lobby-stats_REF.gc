;; definition for method 78 of type scrolling-menu-ladder
(defmethod get-room-id ((this scrolling-menu-ladder) (arg0 int))
  (if (or (< arg0 0) (>= arg0 *ladder-results-ct*))
      -1
      (-> *ladder-results* arg0 account-id)
      )
  )

;; definition for method 61 of type scrolling-item-ladder
(defmethod default-event-handler ((this scrolling-item-ladder) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (case arg2
    (('set-index)
     (dotimes (s4-1 (-> this strings length))
       (clear (-> this strings data s4-1 text))
       )
     (let ((s5-1 (-> arg3 param 0)))
       (when (and (>= (the-as int s5-1) 0) (< (the-as int s5-1) *ladder-results-ct*))
         (format (clear (-> this strings data 0 text)) "~D" (-> *ladder-results* s5-1 ladder-position))
         (expand-text-to-charp!
           *common-text*
           (-> this strings data 1 text data)
           (-> *ladder-results* s5-1 account-name)
           )
         (format-value
           *ladder-results-stat-info*
           (-> *ladder-results* s5-1 ladder-stat)
           (-> this strings data 2 text)
           #t
           )
         )
       )
     )
    (else
      (call-parent-method this arg0 arg1 arg2 arg3)
      )
    )
  )

;; definition for method 61 of type scrolling-menu-ladder

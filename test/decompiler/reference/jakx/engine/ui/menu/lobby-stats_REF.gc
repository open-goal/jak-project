    (set! (-> gp-0 clan-id) arg0)
    (set! (-> gp-0 clan-ladder-stat-index) arg1)
    (set! (-> gp-0 sort-order) (if (logtest? (-> arg2 flags) (stat-info-flag lower-is-better))

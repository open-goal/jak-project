     (set! (-> this physical-item-ct) *ladder-results-ct*)
     (scrolling-menu-medius-method-77 this)
     )
    (else
      ((method-of-type scrolling-menu default-event-handler) this arg0 arg1 arg2 arg3)
      )
    )
  )

;; definition for function ladder-list-callback
;; INFO: Called from C
;; WARN: Return type mismatch int vs object.
(defun ladder-list-callback ((arg0 medius-ladder-list-extra-info-response))
  (mem-copy! (the-as pointer *medius-last-response*) (the-as pointer arg0) 1024)
  (cond
    ((= (-> arg0 status-code) (medius-status-code medius-no-result))
     (set! (-> *net-mgr* lobby-state callback-occurred) #t)
     )
    ((= (-> arg0 status-code) (medius-status-code medius-success))
     (when (< *ladder-results-ct* 5)
       (mem-copy! (the-as pointer (-> *ladder-results* *ladder-results-ct*)) (the-as pointer arg0) 469)
       (set! *ladder-results-ct* (+ *ladder-results-ct* 1))
       )
     )
    (else
      (set! (-> *net-mgr* lobby-state got-error) #t)
      )
    )
  (if (= (-> arg0 end-of-list) 1)
      (set! (-> *net-mgr* lobby-state callback-occurred) #t)
      )
  0
  )

;; definition for function clan-ladder-list-callback
;; INFO: Called from C
;; WARN: Return type mismatch int vs object.
(defun clan-ladder-list-callback ((arg0 medius-clan-ladder-list-response))
  (mem-copy! (the-as pointer *medius-last-response*) (the-as pointer arg0) 1024)
  (cond
    ((= (-> arg0 status-code) (medius-status-code medius-no-result))
     (set! (-> *net-mgr* lobby-state callback-occurred) #t)
     )
    ((= (-> arg0 status-code) (medius-status-code medius-success))
     (when (< *ladder-results-ct* 5)
       (let ((s5-0 (-> *ladder-results* *ladder-results-ct*)))
         (mem-clear! (the-as pointer s5-0) 469)
         (set! (-> s5-0 ladder-position) (-> arg0 ladder-position))
         (set! (-> s5-0 account-id) (-> arg0 clan-id))
         (mem-copy! (-> s5-0 account-name) (-> arg0 clan-name) 32)
         (set! (-> s5-0 ladder-stat) -2)
         )
       (set! *ladder-results-ct* (+ *ladder-results-ct* 1))
       )
     )
    (else
      (set! (-> *net-mgr* lobby-state got-error) #t)
      )
    )
  (if (= (-> arg0 end-of-list) 1)
      (set! (-> *net-mgr* lobby-state callback-occurred) #t)
      )
  0
  )

;; definition for function get-player-ladder-pos
;; WARN: Return type mismatch uint vs object.
(defbehavior get-player-ladder-pos net-mgr ((arg0 int) (arg1 int) (arg2 stat-info))
  (let ((gp-0 (new 'stack 'medius-ladder-position-extra-info-request)))
    (set! *async-request-ct* (+ *async-request-ct* 1))
    (itoa *async-request-ct* (-> gp-0 message-id))
    (set! (-> gp-0 account-id) arg0)
    (set! (-> gp-0 ladder-stat-index) arg1)
    (set! (-> gp-0 sort-order) (if (logtest? (-> arg2 flags) (stat-info-flag lower-is-better))
                                   (medius-sort-order medius-ascending)
                                   (medius-sort-order medius-descending)
                                   )
          )
    (reset-lobby-state! self)
    (set! *scert-function-id* (scert-function medius-ladder-position-extra-info))
    (let ((gp-1 (knet-scert-function-3-args gp-0 medius-simple-request-callback #f)))
      (when (nonzero? gp-1)
        (format 0 "initial function call returned ~D~%" gp-1)
        (set! (-> self lobby-state got-error) #t)
        (set! (-> self lobby-state last-medius-error) gp-1)
        )
      )
    )
  (net-async-wait (seconds 15) #t)
  (cond
    ((or (-> self lobby-state got-error)
         (-> self lobby-state timeout)
         (nonzero? (-> self lobby-state last-medius-error))
         (nonzero? (-> self lobby-state last-mgcl-error))
         (nonzero? (-> self lobby-state last-dme-error))
         (nonzero? (-> self lobby-state callback-status))
         )
     *medius-last-response*
     (let ((v1-20 #f))
       (set! *net-mgr-pending-behavior-result-extra* '())
       (return (the-as object v1-20))
       )
     )
    (else
      (let ((v1-23 (-> (the-as medius-ladder-position-extra-info-response *medius-last-response*) ladder-position)))
        (set! *net-mgr-pending-behavior-result-extra* '())
        (return (the-as object v1-23))
        )
      )
    )
  (the-as none 0)
  (the-as uint #f)
  )

;; definition for function get-clan-ladder-pos

   (info-array     (array stat-info))
   (show-vehicles  symbol)
   )
  (:methods
    (scrolling-menu-stats-method-79 (_type_ net-player-ladder-stats (array stat-info) net-player-stats) none)
    )
  )

;; definition for method 3 of type scrolling-menu-stats
(defmethod inspect ((this scrolling-menu-stats))

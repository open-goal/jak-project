;; failed to figure out what this is:
(defstate my-stats-screen (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (local-vars (v0-0 object))
    (case message
      (('menu-selection-event)
       (if (and *pending-op*
                *lobby-menu-manager*
                (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                   (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                   )
                )
           (return #f)
           )
       (case (-> block param 0)
         (('accept)
          (case (-> block param 1)
            (('player-stats)
             (set! *ladder-stat-idx-current* (the-as int (-> block param 2)))
             (set! *ladder-stat-idx-of-interest* *ladder-stat-idx-current*)
             (when (not (and *pending-op*
                             *lobby-menu-manager*
                             (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                                (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                                )
                             )
                        )
               (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
               (set! v0-0
                     (lambda :behavior lobby-menu-manager () (go-virtual player-ladder-stats (-> *medius-my-player* medius-id)))
                     )
               (set! *pending-op* (the-as (function object object object object object object object object object)
                                    (the-as (function object :behavior lobby-menu-manager) v0-0)
                                    )
                     )
               v0-0
               )
             )
            )
          )
         (('square)
          (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-2341))
          (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1712))
          (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
          (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
          (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1926))
          (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-3899))
          (go-virtual
            lobby-generic-error-menu
            *lobby-generic-confirmation*
            (lambda :behavior lobby-menu-manager
              ()
              (kill-menu self #f #f)
              (let ((gp-0 (-> *medius-my-player* ladder-stats)))
                (set! *should-update-stats* #t)
                (init-stats! *net-player-ladder-stats-info* gp-0)
                (update-computed-stats! *net-player-ladder-stats-info* gp-0)
                )
              (medius-start-account-stats-update #t #t)
              (set! *should-update-stats* #f)
              (go-virtual my-stats-screen)
              )
            (the-as (function symbol object) (lambda :behavior lobby-menu-manager () (go-virtual my-stats-screen)))
            #f
            #f
            (the-as symbol (lambda :behavior lobby-menu-manager () (if (and (cpad-hold? 0 l1) (cpad-hold? 0 r1))
                                                                       #t
                                                                       #f
                                                                       )
                                                                )
                    )
            )
          )
         (('cancel)
          (when (not (and *pending-op*
                          *lobby-menu-manager*
                          (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                             (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                             )
                          )
                     )
            (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
            (set! v0-0 (lambda :behavior lobby-menu-manager () (go-virtual lobby-main-screen)))
            (set! *pending-op* (the-as (function object object object object object object object object object)
                                 (the-as (function object :behavior lobby-menu-manager) v0-0)
                                 )
                  )
            v0-0
            )
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (local-vars (v1-5 symbol))
    (copy-charp<-charp *stats-title* (-> (lookup-text! *common-text* (text-id text-id-3900) #f) data))
    (set! (-> *clear-stats-text-ids* 0) (text-id text-id-2340))
    (dotimes (v1-3 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-3))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-3))) info-ptr) *my-stats-screen*)
                 )
        (set! v1-5 #t)
        (goto cfg-20)
        )
      )
    (set! v1-5 #f)
    (label cfg-20)
    (if v1-5
        (goto cfg-24)
        )
    (kill-menu self #t #f)
    (create-menu self *my-stats-screen* 0)
    #t
    (label cfg-24)
    (suspend)
    (send-event
      (find-menu self 'player-stats)
      'set-stats-array
      (-> *medius-my-player* ladder-stats)
      *net-player-ladder-stats-info-array*
      (-> *medius-my-player* stats)
      )
    )
  :code (behavior ()
    (until #f
      (do-pending-operation)
      (suspend)
      )
    #f
    )
  )

;; failed to figure out what this is:
(defstate single-clan-stats (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (local-vars (v0-0 object))
    (case message
      (('menu-selection-event)
       (if (and *pending-op*
                *lobby-menu-manager*
                (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                   (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                   )
                )
           (return #f)
           )
       (case (-> block param 0)
         (('accept)
          (case (-> block param 1)
            (('player-stats)
             (set! *ladder-stat-idx-current* (the-as int (-> block param 2)))
             (set! *ladder-stat-idx-of-interest* *ladder-stat-idx-current*)
             (when (not (and *pending-op*
                             *lobby-menu-manager*
                             (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                                (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                                )
                             )
                        )
               (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
               (set! v0-0 (lambda :behavior lobby-menu-manager () (go-virtual clan-ladder-stats *clan-info-id*)))
               (set! *pending-op* (the-as (function object object object object object object object object object)
                                    (the-as (function object :behavior lobby-menu-manager) v0-0)
                                    )
                     )
               v0-0
               )
             )
            )
          )
         (('cancel)
          (let ((v1-19 *prev-create-menu-state-name*))
            (set! *prev-create-menu-state-name* #f)
            (set! *this-create-menu-state-name* #f)
            (cond
              ((= v1-19 'clan-info-screen)
               (go-virtual clan-info-screen)
               )
              ((= v1-19 'clan-ladder-stats)
               (go-virtual clan-ladder-stats *clan-info-id*)
               )
              (else
                (when (not (and *pending-op*
                                *lobby-menu-manager*
                                (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                                   (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                                   )
                                )
                           )
                  (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
                  (set! v0-0 (lambda :behavior lobby-menu-manager () (go-virtual lobby-main-screen)))
                  (set! *pending-op* (the-as (function object object object object object object object object object)
                                       (the-as (function object :behavior lobby-menu-manager) v0-0)
                                       )
                        )
                  v0-0
                  )
                )
              )
            )
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :code (behavior ()
    (local-vars (v1-7 symbol))
    (set! (-> *clear-stats-text-ids* 0) (text-id text-id-0))
    (until #f
      (let ((gp-0 (the-as medius-cached-info-clan (lookup *medius-clan-cache* *clan-info-id* 9000 #t #f))))
        (cond
          (gp-0
            (copy-charp<-charp *stats-title* (-> (lookup-text! *common-text* (text-id text-id-3902) #f) data))
            (copy-charp<-charp (&+ *stats-title* (strlen *stats-title*)) (-> ": " data))
            (copy-charp<-charp (&+ *stats-title* (strlen *stats-title*)) (-> gp-0 name))
            (dotimes (v1-5 (+ (-> self in-focus-index) 1))
              (when (and (handle->process (-> self menu-handles v1-5))
                         (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-5))) info-ptr) *my-stats-screen*)
                         )
                (set! v1-7 #t)
                (goto cfg-22)
                )
              )
            (set! v1-7 #f)
            (label cfg-22)
            (if v1-7
                (goto cfg-26)
                )
            (kill-menu self #t #f)
            (create-menu self *my-stats-screen* 0)
            #t
            (label cfg-26)
            (suspend)
            (send-event
              (find-menu self 'player-stats)
              'set-stats-array
              (-> gp-0 ladder-stats)
              *net-clan-ladder-stats-info-array*
              #f
              )
            (goto cfg-32)
            )
          (else
            (suspend)
            0
            )
          )
        )
      )
    #f
    (until #f
      (label cfg-32)
      (do-pending-operation)
      (suspend)
      )
    #f
    )
  )


  )

;; definition for function get-ladder-total-rankings
;; WARN: Return type mismatch symbol vs object.
(defbehavior get-ladder-total-rankings net-mgr ((arg0 int) (arg1 symbol))
  (local-vars (v0-6 symbol))
  (let ((gp-0 (new 'stack 'medius-get-total-rankings-request)))
    (set! *async-request-ct* (+ *async-request-ct* 1))
    (itoa *async-request-ct* (-> gp-0 message-id))

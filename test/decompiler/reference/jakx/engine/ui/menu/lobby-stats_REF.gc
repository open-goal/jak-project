;; definition for method 79 of type scrolling-menu-stats
;; WARN: Return type mismatch int vs none.
(defmethod scrolling-menu-stats-method-79 ((this scrolling-menu-stats) (arg0 net-player-ladder-stats) (arg1 (array stat-info)) (arg2 net-player-stats))
  (set! (-> this stats) arg0)
  (set! (-> this info-array) arg1)
  (cond
    ((or (not (-> this stats)) (!= (-> arg0 version) 12) (and arg2 (!= (-> arg2 stats-version) 11)))
     (set! (-> this physical-item-ct) 0)
     (set! (-> this cur-idx) 0)
     (set! (-> this stats) #f)
     )
    (else
      (set! (-> this physical-item-ct) (+ (length arg1) -1))
      )
    )
  (scrolling-menu-medius-method-77 this)
  (scrolling-menu-method-74 this)
  0
  (none)
  )

;; definition for method 61 of type scrolling-item-stats
(defmethod default-event-handler ((this scrolling-item-stats) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (case arg2
    (('set-index)
     (let ((v0-0 (the-as object (-> arg3 param 0))))
       (set! (-> this idx) (the-as int v0-0))
       v0-0
       )
     )
    (else
      ((method-of-type scrolling-item default-event-handler) this arg0 arg1 arg2 arg3)
      )
    )
  )

;; definition for method 67 of type scrolling-item-stats
;; WARN: Return type mismatch int vs none.
(defmethod update-strings ((this scrolling-item-stats))
  (let* ((v1-0 (-> this parent))
         (s5-0 (if v1-0
                   (the-as scrolling-menu-stats (-> v1-0 0 self))
                   )
               )
         )
    (dotimes (s4-0 (-> this strings length))
      (clear (-> this strings data s4-0 text))
      )
    (when (and (-> s5-0 stats)
               (and (-> s5-0 info-array) (>= (-> this idx) 0) (< (-> this idx) (-> s5-0 info-array length)))
               )
      (let ((s4-1 (-> s5-0 info-array (+ (-> this idx) 1))))
        (-> (&+ (the-as (pointer int32) (-> s5-0 stats)) (-> s4-1 offset)) 0)
        (format-name s4-1 (-> this strings data 0 text))
        (format-stat
          s4-1
          (the-as (pointer int32) (-> s5-0 stats))
          (-> this strings data 1 text)
          (-> s5-0 show-vehicles)
          )
        )
      )
    )
  (call-parent-method this)
  0
  (none)
  )

;; definition for method 59 of type scrolling-menu-stats
(defmethod init-menu! ((this scrolling-menu-stats))
  (set! (-> this show-vehicles) #t)
  (scrolling-menu-stats-method-79
    this
    (the-as net-player-ladder-stats #f)
    (the-as (array stat-info) #f)
    (the-as net-player-stats #f)
    )
  (call-parent-method this)
  (set! (-> this physical-item-ct) 0)
  (set! (-> this cur-idx) 0)
  (set! (-> this top-idx) (-> this cur-idx))
  (scrolling-menu-method-74 this)
  (scrolling-menu-method-73 this (-> this cur-idx) #f)
  (none)
  )

;; definition for method 61 of type scrolling-menu-stats
(defmethod default-event-handler ((this scrolling-menu-stats) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (case arg2
    (('set-stats-array)
     (scrolling-menu-stats-method-79

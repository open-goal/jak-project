       (the-as (array stat-info) (-> arg3 param 1))
       (the-as net-player-stats (-> arg3 param 2))
       )
     )
    (('set-show-vehicles)
     (let ((v0-0 (the-as object (-> arg3 param 0))))
       (set! (-> this show-vehicles) (the-as symbol v0-0))
       v0-0
       )
     )
    (else
      (call-parent-method this arg0 arg1 arg2 arg3)
      )
    )
  )


(defbehavior get-clan-ladder-pos net-mgr ((arg0 int) (arg1 int) (arg2 stat-info))
  (let ((gp-0 (new 'stack 'medius-clan-ladder-position-request)))
    (set! *async-request-ct* (+ *async-request-ct* 1))

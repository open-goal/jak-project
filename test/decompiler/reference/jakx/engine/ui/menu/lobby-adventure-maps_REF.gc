;; definition for symbol *world-map-shadow-control*, type shadow-control
(define *world-map-shadow-control*
  (new 'static 'shadow-control :settings (new 'static 'shadow-settings
                                           :center (new 'static 'vector :w (the-as float #x182))
                                           :shadow-dir (new 'static 'vector :y -1.0 :w 409600.0)
                                           :bot-plane (new 'static 'plane :y 1.0 :w 204800.0)
                                           :top-plane (new 'static 'plane :y 1.0 :w 4096.0)
                                           :fade-dist 409600.0
                                           )
                               )
  )

;; definition of type interface-world-map
(deftype interface-world-map (process-drawable)
  ((root             collide-shape :override)
   (u                float)
   (curve            curve-control  :offset 256)
   (path-u           float)
   (draw?            symbol)
   (particle-matrix  matrix         :inline)
   )
  (:state-methods
    idle
    leave
    )
  (:methods
    (init! (_type_) draw-control-status)
    )
  )

;; definition for method 3 of type interface-world-map
(defmethod inspect ((this interface-world-map))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type process-drawable inspect)))
    (t9-0 this)
    )
  (format #t "~2Tu: ~f~%" (-> this u))
  (format #t "~2Tstate-time: ~D~%" (-> this state-time))
  (format #t "~2Tcurve: ~A~%" (-> this curve))
  (format #t "~2Tpath-u: ~f~%" (-> this path-u))
  (format #t "~2Tdraw?: ~A~%" (-> this draw?))
  (format #t "~2Tparticle-matrix: #<matrix @ #x~X>~%" (-> this particle-matrix))
  (label cfg-4)
  this
  )

;; definition for function align-to-interface-world-map
(defbehavior align-to-interface-world-map interface-world-map ()
  (let ((f30-0 (lerp 0.0 12288.0 (-> self u))))
    (when (-> self draw?)
      (set! (-> self root trans y) (+ (-> self entity trans y) f30-0))
      (set! (-> self draw force-fade) (the-as uint (the int (* 128.0 (square (-> self u))))))
      )
    (when (and (-> self curve) (nonzero? (-> self curve)) (> (-> self curve curve num-cverts) 0))
      (let ((s5-0 (new 'stack-no-clear 'matrix))
            (gp-0 (-> self particle-matrix))
            )
        (set! (-> self path-u)
              (path-control-method-26 (-> self curve) (-> self path-u) (* 40960.0 (seconds-per-frame)))
              )
        (if (>= (-> self path-u) 1.0)
            (set! (-> self path-u) 0.0)
            )
        (path-control-method-16 (-> self curve) (-> s5-0 uvec) (-> self path-u))
        (quaternion-look-at! (the-as quaternion (-> s5-0 rvec)) (-> s5-0 uvec) *up-vector*)
        (quaternion->matrix gp-0 (the-as quaternion (-> s5-0 rvec)))
        (path-control-method-14 (-> self curve) (-> gp-0 trans) (-> self path-u) 'interp)
        (cond
          ((-> self draw?)
           (+! (-> gp-0 trans y) f30-0)
           )
          (else
            (when (type? (-> self root) collide-shape)
              (let ((v1-28 (-> self root root-prim)))
                (set! (-> v1-28 prim-core collide-as) (collide-spec))
                (set! (-> v1-28 prim-core collide-with) (collide-spec))
                )
              0
              )
            (logior! (-> self draw status) (draw-control-status no-draw))
            (if (type? (-> self root) collide-shape)
                (transform-post)
                )
            )
          )
        (set! (-> *part-id-table* 1028 init-specs 8 initial-valuef) (* 64.0 (square (-> self u))))
        (set! (-> *part-id-table* 1029 init-specs 7 initial-valuef) (* 64.0 (square (-> self u))))
        (spawn-from-mat (-> self part) gp-0)
        )
      )
    )
  (let ((f0-21 (- 1.0 (* 0.35 (square (-> self u))))))
    (if (< 0.99 f0-21)
        (logior! (-> self draw status) (draw-control-status disable-shadow))
        (logclear! (-> self draw status) (draw-control-status disable-shadow))
        )
    (cond
      ((and (!= (-> *time-of-day-context* shadow-override) 0.0)
            (-> self draw shadow)
            (not (logtest? (draw-control-status disable-shadow) (-> self draw status)))
            )
       (set! (-> *time-of-day-context* shadow-override) (fmin f0-21 (-> *time-of-day-context* shadow-override)))
       )
      ((and (-> self draw shadow) (not (logtest? (draw-control-status disable-shadow) (-> self draw status))))
       (set! (-> *time-of-day-context* shadow-override) f0-21)
       f0-21
       )
      )
    )
  )

;; failed to figure out what this is:
(defstate hidden (interface-world-map)
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('appear)
       (go-virtual idle)
       )
      )
    )
  :enter (behavior ()
    (when (type? (-> self root) collide-shape)
      (let ((v1-2 (-> self root root-prim)))
        (set! (-> v1-2 prim-core collide-as) (collide-spec))
        (set! (-> v1-2 prim-core collide-with) (collide-spec))
        )
      0
      )
    (logior! (-> self draw status) (draw-control-status no-draw))
    (if (type? (-> self root) collide-shape)
        (transform-post)
        )
    )
  :exit (behavior ()
    (when (type? (-> self root) collide-shape)
      (let ((v1-2 (-> self root root-prim)))
        (set! (-> v1-2 prim-core collide-as) (-> self root backup-collide-as))
        (set! (-> v1-2 prim-core collide-with) (-> self root backup-collide-with))
        )
      )
    (logclear! (-> self draw status) (draw-control-status no-draw))
    (if (type? (-> self root) collide-shape)
        (transform-post)
        )
    )
  :code sleep-code
  )

;; failed to figure out what this is:
(defstate idle (interface-world-map)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('leave)
       (go-virtual leave)
       )
      )
    )
  :code (behavior ()
    (set-time! (-> self state-time))
    (until #f
      (ja-no-eval :group! (ja-group) :num! (seek!) :frame-num 0.0)
      (until (ja-done? 0)
        (suspend)
        (ja :num! (seek!))
        )
      )
    #f
    )
  :post (behavior ()
    (let ((f0-0 (-> self u)))
      (if (time-elapsed? (-> self state-time) (seconds 1))
          (+! (-> self u) (* 0.05 (- 1.0 (-> self u))))
          )
      (if (-> self draw?)
          (set! *lobby-maps-y-delta* (* 12288.0 (- (-> self u) f0-0)))
          (set! *lobby-maps-y-delta* 0.0)
          )
      )
    (align-to-interface-world-map)
    (ja-post)
    )
  )

;; definition for method 10 of type interface-world-map
(defmethod deactivate ((this interface-world-map))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  ((method-of-type process-drawable deactivate) this)
  (none)
  )

;; definition for method 7 of type interface-world-map
;; WARN: Return type mismatch process-drawable vs interface-world-map.
(defmethod relocate ((this interface-world-map) (offset int))
  (if (nonzero? (-> this curve))
      (&+! (-> this curve) offset)
      )
  (the-as interface-world-map ((method-of-type process-drawable relocate) this offset))
  )

;; definition for method 52 of type interface-world-map
;; WARN: Return type mismatch int vs draw-control-status.
(defmethod init! ((this interface-world-map))
  (break!)
  (the-as draw-control-status 0)
  )

;; definition for function interface-world-map-local-space
;; INFO: Used lq/sq
;; WARN: Return type mismatch int vs object.
(defun interface-world-map-local-space ((arg0 particle-local-space-info))
  (let ((a1-0 (handle->process (-> arg0 hand))))
    (when a1-0
      (let ((s4-0 (-> (the-as interface-world-map a1-0) particle-matrix))
            (gp-0 (-> arg0 mat-new))
            )
        (when (not (paused?))
          (logior! (-> arg0 flags) (part-local-space-flags pls2))
          (cond
            ((logtest? (-> arg0 flags) (part-local-space-flags pls0))
             (matrix-identity! gp-0)
             (set! (-> gp-0 trans quad) (-> s4-0 trans quad))
             )
            ((logtest? (-> arg0 flags) (part-local-space-flags pls1))
             (matrix-copy! gp-0 s4-0)
             (set! (-> gp-0 rvec y) 0.0)
             (set! (-> gp-0 fvec y) 0.0)
             (vector-normalize! (-> gp-0 rvec) 1.0)
             (vector-normalize! (-> gp-0 fvec) 1.0)
             (vector-cross! (-> gp-0 uvec) (-> gp-0 fvec) (-> gp-0 rvec))
             )
            (else
              (matrix-copy! gp-0 s4-0)
              )
            )
          )
        )
      )
    )
  0
  )

;; definition for method 11 of type interface-world-map
(defmethod init-from-entity! ((this interface-world-map) (arg0 entity-actor))
  (set! (-> this level) (level-get *level* 'menumap))
  (set! (-> this root) (the-as collide-shape (new 'process 'trsqv)))
  (process-drawable-from-entity! this arg0)
  (set! (-> this u) 0.0)
  (quaternion-identity! (-> this root rotation))
  (init! this)
  (logior! (-> this draw status) (draw-control-status force-fade))
  (set! (-> this path) (new 'process 'path-control this 'path 0.0 (the-as entity #f) #f))
  (set! (-> this curve) (new 'process 'curve-control this 'path (the-as res-lump #f) #f -1000000000.0))
  (set! (-> this part) (create-launch-control (-> *part-group-id-table* 283) this))
  (set! (-> this path-u) 0.0)
  (process-entity-status! this (entity-perm-status no-kill) #t)
  (go hidden)
  )

;; failed to figure out what this is:
(defstate leave (interface-world-map)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('appear)
       (go-virtual idle)
       )
      )
    )
  :enter (behavior ()
    (sparticle-launch-control-method-21 (-> self part))
    )
  :trans (behavior ()
    (if (>= 0.01 (-> self u))
        (go hidden)
        )
    )
  :code (behavior ()
    (until #f
      (ja-no-eval :group! (ja-group) :num! (seek!) :frame-num 0.0)
      (until (ja-done? 0)
        (suspend)
        (ja :num! (seek!))
        )
      )
    #f
    )
  :post (behavior ()
    (+! (-> self u) (* 0.05 (- (-> self u))))
    (align-to-interface-world-map)
    (ja-post)
    )
  )


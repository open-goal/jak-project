;; definition of type wm-fireworks-ship
(deftype wm-fireworks-ship (process-drawable)
  ((curve      curve-control)
   (location   float)
   (fireworks  handle)
   )
  (:state-methods
    idle
    )
  )

;; definition for method 3 of type wm-fireworks-ship
(defmethod inspect ((this wm-fireworks-ship))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type process-drawable inspect)))
    (t9-0 this)
    )
  (format #t "~2Tcurve: ~A~%" (-> this curve))
  (format #t "~2Tlocation: ~f~%" (-> this location))
  (format #t "~2Tfireworks: ~D~%" (-> this fireworks))
  (label cfg-4)
  this
  )

;; failed to figure out what this is:
(defskelgroup skel-wm-fireworks-ship wm-fireworks-ship wm-fireworks-ship-lod0-jg wm-fireworks-ship-idle-ja
              ((wm-fireworks-ship-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 0 0 60)
              :origin-joint-index 3
              )

;; definition for method 11 of type wm-fireworks-ship
(defmethod init-from-entity! ((this wm-fireworks-ship) (arg0 entity-actor))
  (stack-size-set! (-> this main-thread) 32)
  (set! (-> this root) (new 'process 'trsqv))
  (set! (-> this curve) (new 'process 'curve-control this 'path (the-as res-lump #f) #f -1000000000.0))
  (process-drawable-from-entity! this arg0)
  (process-drawable-method-42
    this
    (art-group-get-by-name *level* "skel-wm-fireworks-ship" (the-as (pointer level) #f))
    0
    )
  (set! (-> this part) (create-launch-control (-> *part-group-id-table* 293) this))
  (go (method-of-object this idle))
  )

;; definition for method 7 of type wm-fireworks-ship
;; WARN: Return type mismatch process-drawable vs wm-fireworks-ship.
(defmethod relocate ((this wm-fireworks-ship) (offset int))
  (if (nonzero? (-> this curve))
      (&+! (-> this curve) offset)
      )
  (the-as wm-fireworks-ship ((method-of-type process-drawable relocate) this offset))
  )

;; failed to figure out what this is:
(defstate idle (wm-fireworks-ship)
  :virtual #t
  :enter (behavior ()
    (set! (-> self location) 0.0)
    (set! (-> *launch-matrix* trans quad) (-> *null-vector* quad))
    (set! (-> *part-tracker-params-default* group) (-> *part-group-id-table* 293))
    (vector-reset! (-> *part-tracker-params-default* local-offset))
    (set! (-> *part-tracker-params-default* duration) (the-as uint -1))
    (set! (-> *part-tracker-params-default* callback) #f)
    (set! (-> *part-tracker-params-default* userdata) (the-as uint #f))
    (set! (-> *part-tracker-params-default* target) self)
    (set! (-> *part-tracker-params-default* mat-joint) (the-as object 0))
    (set! (-> *part-tracker-params-default* local-space-param) 0)
    (set! (-> *part-tracker-params-default* local-space-callback) #f)
    (set! (-> *part-tracker-params-default* subsampler-num) 1.0)
    *part-tracker-params-default*
    (set! (-> self fireworks)
          (ppointer->handle (if (logtest? (-> *part-group-id-table* 293 flags) (sp-group-flag sp13))
                                (process-spawn
                                  part-tracker-subsampler
                                  :init part-tracker-subsampler-init
                                  *part-tracker-params-default*
                                  :name "part-tracker-subsampler"
                                  :to *entity-pool*
                                  :unk 0
                                  )
                                (process-spawn
                                  part-tracker
                                  :init part-tracker-init
                                  *part-tracker-params-default*
                                  :name "part-tracker"
                                  :to *entity-pool*
                                  :unk 0
                                  )
                                )
                            )
          )
    )
  :exit (behavior ()
    (send-event (handle->process (-> self fireworks)) 'die)
    )
  :code sleep-code
  :post (behavior ()
    (let ((f0-1 (* 0.000027777778 (the float (mod
                                               (- (- (if *net-mgr*
                                                         (-> *net-mgr* game-state time)
                                                         0
                                                         )
                                                     (if *net-world*
                                                         (-> *net-world* net-state game-start-time)
                                                         0
                                                         )
                                                     )
                                                  (if *net-world*
                                                      (-> *net-world* net-state total-pause-time)
                                                      0
                                                      )
                                                  )
                                               #x8ca0
                                               )
                                       )
                   )
                )
          )
      (set! (-> self location) (- f0-1 (the float (the int f0-1))))
      )
    (when (-> self curve)
      (path-control-method-14 (-> self curve) (-> self root trans) (-> self location) 'interp)
      (let ((gp-0 (new 'stack-no-clear 'inline-array 'vector 1)))
        (path-control-method-16 (-> self curve) (-> gp-0 0) (-> self location))
        (quaternion-look-at! (the-as quaternion (-> self root rot)) (-> gp-0 0) *up-vector*)
        )
      )
    (ja-post)
    )
  )





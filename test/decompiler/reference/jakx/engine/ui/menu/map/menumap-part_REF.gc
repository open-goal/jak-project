;; definition for symbol *menumap-firework-vec*, type vector
(define *menumap-firework-vec* (new 'static 'vector))

;; definition for symbol *menumap-firework-origin?*, type symbol
(define *menumap-firework-origin?* #f)

;; definition for function birth-func-menumap-firework
;; WARN: Return type mismatch int vs none.
(defun birth-func-menumap-firework ((arg0 sparticle-system) (arg1 sparticle-cpuinfo) (arg2 sparticle-launchinfo))
  (let* ((v1-3 (abs (+ (-> *display* game-clock frame-counter) (the-as time-frame arg0))))
         (v1-4 (logand v1-3 7))
         )
    (set! (-> arg2 rotate-x) (the float (-> *menumap-firework-colors* v1-4 r)))
    (set! (-> arg2 rotate-y) (the float (-> *menumap-firework-colors* v1-4 g)))
    (set! (-> arg2 rotate-z) (the float (-> *menumap-firework-colors* v1-4 b)))
    )
  (cond
    ((not *menumap-firework-origin?*)
     (quaternion-copy! (the-as quaternion *menumap-firework-vec*) (-> arg1 rotvel3d))
     (set! *menumap-firework-origin?* #t)
     )
    (else
      (quaternion-copy! (-> arg1 rotvel3d) (the-as quaternion *menumap-firework-vec*))
      (set! *menumap-firework-origin?* #f)
      )
    )
  0
  (none)
  )


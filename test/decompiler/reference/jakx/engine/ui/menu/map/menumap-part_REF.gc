(defun spt-func-menumap-birth-on-die1 ((arg0 sparticle-system) (arg1 sparticle-cpuinfo) (arg2 sparticle-launchinfo))
  (when (zero? (-> arg1 timer))
    (let ((v1-2 (-> *launch-matrix* trans))
          (a0-1 (new 'stack-no-clear 'vector))
          )
      (set! (-> a0-1 x) (-> arg2 launchrot x))
      (set! (-> a0-1 y) (-> arg2 launchrot y))
      (set! (-> a0-1 z) (-> arg2 launchrot z))

;;-*-Lisp-*-
(in-package goal)

;; definition of type scrolling-task-item
(deftype scrolling-task-item (scrolling-item)
  ()
  )

;; definition for method 3 of type scrolling-task-item
(defmethod inspect ((this scrolling-task-item))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type scrolling-item inspect)))
    (t9-0 this)
    )
  (label cfg-4)
  this
  )

;; definition for method 61 of type scrolling-task-item
(defmethod default-event-handler ((this scrolling-task-item) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (case arg2
    (('set-index)
     (send-event
       (ppointer->process (-> this parent))
       'get-text-0
       (clear (-> this strings data 0 text))
       (-> arg3 param 0)
       )
     (send-event
       (ppointer->process (-> this parent))
       'get-text-1
       (clear (-> this strings data 1 text))
       (-> arg3 param 0)
       )
     (if (-> this info-ptr sprites-info)
         (send-event (ppointer->process (-> this parent)) 'get-icon (-> arg3 param 0))
         )
     )
    (('set-icon)
     (let ((v0-4 (the-as object (-> arg3 param 0))))
       (set! (-> this p-client-array 0 strip tex-id) (the-as texture-id v0-4))
       v0-4
       )
     )
    (else
      ((method-of-type scrolling-item default-event-handler) this arg0 arg1 arg2 arg3)
      )
    )
  )

;; definition for method 67 of type scrolling-task-item
;; WARN: Return type mismatch int vs none.
(defmethod update-strings ((this scrolling-task-item))
  (cond
    ((-> this selected)
     (set! (-> this strings data 0 color) (-> this info-ptr strings-info 0 font-color-2))
     (set! (-> this strings data 0 scale) 0.6)
     (set! (-> this strings data 1 color) (-> this info-ptr strings-info 1 font-color-2))
     (set! (-> this strings data 1 scale) 0.5)
     (when (nonzero? (-> this colors))
       (dotimes (v1-15 (-> this colors length))
         (set! (-> this colors v1-15 r) 40)
         (set! (-> this colors v1-15 g) 130)
         (set! (-> this colors v1-15 b) 40)
         )
       )
     )
    (else
      (set! (-> this strings data 0 color) (-> this info-ptr strings-info 0 font-color))
      (set! (-> this strings data 0 scale) 0.5)
      (set! (-> this strings data 1 color) (-> this info-ptr strings-info 1 font-color))
      (set! (-> this strings data 1 scale) 0.4)
      (when (nonzero? (-> this colors))
        (dotimes (v1-32 (-> this colors length))
          (set! (-> this colors v1-32 r) 128)
          (set! (-> this colors v1-32 g) 128)
          (set! (-> this colors v1-32 b) 128)
          )
        )
      )
    )
  0
  (none)
  )

;; definition of type scrolling-task-menu
(deftype scrolling-task-menu (scrolling-menu)
  ((task-ct   int32)
   (task-ids  game-task  32)
   )
  )

;; definition for method 3 of type scrolling-task-menu
(defmethod inspect ((this scrolling-task-menu))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type scrolling-menu inspect)))
    (t9-0 this)
    )
  (format #t "~2Ttask-ct: ~D~%" (-> this task-ct))
  (format #t "~2Ttask-ids[32] @ #x~X~%" (-> this task-ids))
  (label cfg-4)
  this
  )

;; definition for method 59 of type scrolling-task-menu
;; WARN: Return type mismatch int vs none.
(defmethod init-menu! ((this scrolling-task-menu))
  (set! (-> this task-ct) 0)
  (set! (-> this task-ids (-> this task-ct)) (game-task jungle-race))
  (+! (-> this task-ct) 1)
  (set! (-> this task-ids (-> this task-ct)) (game-task cliffs-deathmatch))
  (+! (-> this task-ct) 1)
  (set! (-> this task-ids (-> this task-ct)) (game-task jungle-deathrace))
  (+! (-> this task-ct) 1)
  (set! (-> this task-ids (-> this task-ct)) (game-task cliffs-artifact))
  (+! (-> this task-ct) 1)
  (let ((t9-0 (method-of-type scrolling-menu init-menu!)))
    (t9-0 this)
    )
  (set! (-> this physical-item-ct) (-> this task-ct))
  (set! (-> this cur-idx) (max 0 (min *lobby-last-selected-task-index* (+ (-> this task-ct) -1))))
  (set! (-> this top-idx) (+ (-> this cur-idx) -2))
  (set! (-> this top-idx)
        (max 0 (min (-> this top-idx) (- (-> this physical-item-ct) (+ (-> this total-item-ct) -2))))
        )
  (scrolling-menu-method-74 this)
  (send-event
    (ppointer->process (-> this parent 0 parent))
    'menu-selection-event
    'event
    (-> this task-ids (-> this cur-idx))
    )
  0
  (none)
  )

;; definition for method 73 of type scrolling-task-menu
;; WARN: Return type mismatch int vs none.
(defmethod scrolling-menu-method-73 ((this scrolling-task-menu) (arg0 int) (arg1 symbol))
  (send-event
    (ppointer->process (-> this parent))
    'menu-selection-event
    'event
    (-> this task-ids (-> this cur-idx))
    )
  (if arg1
      (set! *lobby-last-selected-task-index* (-> this cur-idx))
      )
  0
  (none)
  )

;; definition for method 61 of type scrolling-task-menu
(defmethod default-event-handler ((this scrolling-task-menu) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (case arg2
    (('get-text-0)
     (let ((gp-1 (-> arg3 param 0))
           (v1-1 (-> arg3 param 1))
           )
       (when (and (>= (the-as int v1-1) 0) (< (the-as int v1-1) (-> this task-ct)))
         (let ((v1-6 (-> *game-info* play-list (-> this task-ids v1-1))))
           (when (-> v1-6 kiosk-play-continue)
             (let ((v1-7 (get-continue-by-name *game-info* (the-as string (-> v1-6 kiosk-play-continue)))))
               (when v1-7
                 (let ((v1-8 (lookup-level-info (-> v1-7 level))))
                   (format gp-1 "~S" (lookup-text! *common-text* (-> *task-level-info* (-> v1-8 task-level) text-id) #f))
                   )
                 )
               )
             )
           )
         )
       )
     )
    (('get-text-1)
     (let ((gp-2 (-> arg3 param 0))
           (v1-13 (-> arg3 param 1))
           )
       (when (and (>= (the-as int v1-13) 0) (< (the-as int v1-13) (-> this task-ct)))
         (let ((a1-13 (-> *game-info* sub-task-list (-> *game-info* play-list (-> this task-ids v1-13) play-node))))
           (format gp-2 "~S" (lookup-text! *common-text* (-> *net-play-mode-text-ids* (-> a1-13 net-play-mode)) #f))
           )
         )
       )
     )
    (('get-icon)
     (let ((v1-25 (-> arg3 param 1)))
       (when (and (>= (the-as int v1-25) 0) (< (the-as int v1-25) (-> this task-ct)))
         (let ((v1-34 (-> *game-info* sub-task-list (-> *game-info* play-list (-> this task-ids v1-25) play-node))))
           (send-event
             arg0
             'set-icon
             (lookup-texture-id-by-name (-> *net-play-mode-icon-string* (-> v1-34 net-play-mode)) (the-as string #f))
             )
           )
         )
       )
     )
    (else
      ((method-of-type scrolling-menu default-event-handler) this arg0 arg1 arg2 arg3)
      )
    )
  )


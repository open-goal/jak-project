;; definition for method 59 of type scrolling-net-task-menu
;; WARN: Return type mismatch int vs none.
(defmethod init-menu! ((this scrolling-net-task-menu))
  (set! (-> this task-ct) 0)
  (dotimes (v1-0 (-> *game-info* play-list length))
    (when (-> *game-info* play-list v1-0 kiosk-online-play-continue)
      (if (>= (-> this task-ct) 32)
          (goto cfg-9)
          )
      (set! (-> this task-ids (-> this task-ct)) (the-as game-task v1-0))
      (+! (-> this task-ct) 1)
      )
    )
  (label cfg-9)
  (let ((t9-0 (method-of-type scrolling-menu init-menu!)))
    (t9-0 this)
    )
  (set! (-> this physical-item-ct) (-> this task-ct))
  (set! (-> this cur-idx) (max 0 (min *lobby-last-selected-task-index* (+ (-> this task-ct) -1))))
  (set! (-> this top-idx) (+ (-> this cur-idx) -2))
  (set! (-> this top-idx)
        (max 0 (min (-> this top-idx) (- (-> this physical-item-ct) (+ (-> this total-item-ct) -2))))
        )
  (scrolling-menu-method-74 this)
  (send-event
    (ppointer->process (-> this parent 0 parent))
    'menu-selection-event
    'event
    (-> this task-ids (-> this cur-idx))
    )
  0
  (none)
  )


;; failed to figure out what this is:
(defstate choose-your-adventure (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('menu-selection-event)
       (case (-> block param 0)
         (('event)
          (let ((gp-0 (-> *game-info* play-list (-> block param 1))))
            (let ((s5-0 (-> gp-0 text-id-long)))
              (dotimes (s4-0 8)
                (send-event (handle->process (-> self menu-handles s4-0)) 'to-all-children 'update-task-text-id s5-0)
                )
              )
            (if (= (-> self local-players) 2)
                (set! *last-selected-human-ct* 2)
                (set! *last-selected-human-ct* 1)
                )
            (set! *last-selected-ai-ct* (-> *ai-num-players-info* current-num))
            (set! *last-selected-buddy-ct* 0)
            (set! *last-selected-clan-ct* 0)
            (when *net-world*
              (set-task-node *net-world* (-> gp-0 play-node))
              (let ((gp-1 (get-open-task-node-info)))
                (kill-by-type fmv-player *active-pool*)
                (if (-> gp-1 ipu)
                    (fmv-player-run-texture (-> gp-1 ipu) *default-pool*)
                    )
                (set-action!
                  *gui-control*
                  (gui-action stop)
                  (the-as sound-id 1)
                  (gui-channel citizen)
                  (gui-action none)
                  (the-as string #f)
                  (the-as (function gui-connection symbol) #f)
                  (the-as process #f)
                  )
                (when (-> gp-1 task-sound-description)
                  (add-setting! 'music-volume 'rel 0.25 0)
                  (set! (-> self voice-id)
                        (add-process
                          *gui-control*
                          self
                          (gui-channel citizen)
                          (gui-action play)
                          (-> gp-1 task-sound-description)
                          -99.0
                          0
                          )
                        )
                  (sound-params-set!
                    *gui-control*
                    (-> self voice-id)
                    #f
                    -1.0
                    -1.0
                    1.0
                    (-> *setting-control* user-current dialog-volume)
                    #t
                    )
                  )
                )
              )
            )
          )
         (('cancel)
          (if (kill-menu self #f #f)
              (go-virtual num-local-players-demo)
              )
          )
         (('accept)
          (format 0 "------------------------------------------------------------- accept!~%")
          (lock-game *net-world*)
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (kill-menu self #t #f)
    (set-player-name
      *net-world*
      (* (if *net-mgr*
             (-> *net-mgr* game-state local-machine-idx)
             0
             )
         2
         )
      (-> (lookup-text! *common-text* (-> *net-drivers* 0 id) #f) data)
      )
    (set-player-name
      *net-world*
      (+ (* (if *net-mgr*
                (-> *net-mgr* game-state local-machine-idx)
                0
                )
            2
            )
         1
         )
      (-> (lookup-text! *common-text* (-> *net-drivers* 1 id) #f) data)
      )
    (set-player-load-parts
      *net-world*
      *default-vehicle-load-parts*
      (* (if *net-mgr*
             (-> *net-mgr* game-state local-machine-idx)
             0
             )
         2
         )
      )
    (set-player-colors
      *net-world*
      (the-as int (car-rgb-color-method-10 (-> *car-default-base-color* 0)))
      (the-as int (car-rgb-color-method-10 (-> *car-default-stripe-color* 0)))
      (* (if *net-mgr*
             (-> *net-mgr* game-state local-machine-idx)
             0
             )
         2
         )
      )
    (set-player-vehicle
      *net-world*
      0
      (* (if *net-mgr*
             (-> *net-mgr* game-state local-machine-idx)
             0
             )
         2
         )
      (new 'static 'vehicle-load-parts)
      (new 'static 'tuning-info)
      )
    (set-player-desired-driver *net-world* 0 (* (if *net-mgr*
                                                    (-> *net-mgr* game-state local-machine-idx)
                                                    0
                                                    )
                                                2
                                                )
                               )
    (let ((a1-9 (logand (logand (logand (logand 0 -256) -65281) -16711681) (the-as uint #xffffffff00ffffff))))
      (set-player-tuning *net-world* a1-9 (* (if *net-mgr*
                                                 (-> *net-mgr* game-state local-machine-idx)
                                                 0
                                                 )
                                             2
                                             )
                         )
      )
    (cond
      ((= (-> self local-players) 2)
       (set-player-load-parts
         *net-world*
         *default-vehicle-load-parts*
         (+ (* (if *net-mgr*
                   (-> *net-mgr* game-state local-machine-idx)
                   0
                   )
               2
               )
            1
            )
         )
       (set-player-colors
         *net-world*
         (the-as int (-> *net-drivers* 1 base-color))
         (the-as int (-> *net-drivers* 1 stripe-color))
         (+ (* (if *net-mgr*
                   (-> *net-mgr* game-state local-machine-idx)
                   0
                   )
               2
               )
            1
            )
         )
       (set-player-vehicle
         *net-world*
         9
         (+ (* (if *net-mgr*
                   (-> *net-mgr* game-state local-machine-idx)
                   0
                   )
               2
               )
            1
            )
         (new 'static 'vehicle-load-parts)
         (new 'static 'tuning-info)
         )
       (set-player-desired-driver *net-world* 1 (+ (* (if *net-mgr*
                                                          (-> *net-mgr* game-state local-machine-idx)
                                                          0
                                                          )
                                                      2
                                                      )
                                                   1
                                                   )
                                  )
       (let ((a1-14 (logand (logand (logand (logand 0 -256) -65281) -16711681) (the-as uint #xffffffff00ffffff))))
         (set-player-tuning *net-world* a1-14 (+ (* (if *net-mgr*
                                                        (-> *net-mgr* game-state local-machine-idx)
                                                        0
                                                        )
                                                    2
                                                    )
                                                 1
                                                 )
                            )
         )
       )
      (else
        (set-player-vehicle
          *net-world*
          -1
          (+ (* (if *net-mgr*
                    (-> *net-mgr* game-state local-machine-idx)
                    0
                    )
                2
                )
             1
             )
          (new 'static 'vehicle-load-parts)
          (new 'static 'tuning-info)
          )
        )
      )
    (set! (-> *cpad-list* cpads 0 real-change-time) (the-as uint (get-real-current-time)))
    )
  :exit (behavior ()
    (set-action!
      *gui-control*
      (gui-action stop)
      (the-as sound-id 1)
      (gui-channel citizen)
      (gui-action none)
      (the-as string #f)
      (the-as (function gui-connection symbol) #f)
      (the-as process #f)
      )
    (kill-by-type fmv-player *active-pool*)
    )
  :trans (behavior ()
    (when *net-world*
      (format (clear *level-texture-string*) (-> *task-level-info* (-> *net-world* task-info task-level) tex-name))
      (format (clear *map-texture-string*) (-> *task-level-info* (-> *net-world* task-info task-level) tex-name))
      (format *map-texture-string* "-map")
      )
    )
  :code (behavior ()
    (suspend)
    (suspend)
    (create-menu self *choose-your-adventure* 0)
    (until #f
      (suspend)
      )
    #f
    )
  :post lobby-default-post
  )

;; failed to figure out what this is:
(defstate demo-press-start (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('menu-selection-event)
       #f
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (kill-menu self #t #f)
    (lmm-make-logo-menu self)
    (if (not (handle->process (-> self vehicle-handle)))
        (set! (-> self vehicle-selected)
              (-> *game-info* player-info (-> self current-local-player) last-selected-vehicle)
              )
        )
    (if (demo?)
        (set! (-> *setting-control* user-default allow-timeout) #t)
        )
    )
  :exit (behavior ()
    (send-event (the-as base-menu (handle->process (-> self menu-handle-logo-main))) 'die)
    (send-event (the-as base-menu (handle->process (-> self menu-handle-logo-subtitle))) 'die)
    )
  :trans (behavior ()
    (let ((gp-0 (new
                  'stack
                  'font-context
                  *font-default-matrix*
                  0
                  0
                  8396850.0
                  (font-color default)
                  (font-flags shadow kerning)
                  )
                )
          )
      (set-origin! gp-0 0 320)
      (set-width! gp-0 512)
      (set-height! gp-0 30)
      (set! (-> gp-0 flags) (font-flags kerning middle large ff12))
      (let ((a0-4 gp-0))
        (set! (-> a0-4 effect) (the-as uint 8))
        )
      (set-scale! gp-0 0.6)
      (let ((a0-6 gp-0))
        (set! (-> a0-6 color) (font-color font-color-52))
        )
      (if (< (mod (current-time) 300) 150)
          (print-game-text
            (lookup-text! *common-text* (text-id text-id-51) #f)
            gp-0
            #f
            44
            (bucket-id hud-draw-hud-alpha)
            (the-as string #f)
            (the-as dma-buffer #f)
            )
          )
      )
    (when (cpad-or-kbd-pressed-var? (the-as uint 0) (pad-buttons start))
      (logclear! (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons start))
      (logclear! (-> *cpad-list* cpads 0 button0-rel 0) (pad-buttons start))
      (cpad-or-kbd-clear-func! (the-as uint 0) (pad-buttons start))
      (go-virtual num-local-players-demo)
      )
    )
  :code sleep-code
  :post lobby-default-post
  )

;; failed to figure out what this is:
(defstate num-local-players-demo (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('menu-selection-event)
       (case (-> block param 0)
         (('cancel)
          (if (kill-menu self #f #f)
              (go-virtual demo-press-start)
              )
          )
         (('accept)
          (case (-> block param 1)
            (('1p)
             (when (kill-menu self #t #f)
               (set! (-> self local-players) 1)
               (set! *lobby-local-players* (-> self local-players))
               (go-virtual choose-your-adventure)
               )
             )
            (('2p)
             (cond
               ((zero? (-> *cpad-list* cpads 1 state))
                (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-2610))
                (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1712))
                (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1926))
                (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-4273))
                (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
                (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
                (go-virtual
                  lobby-generic-error-menu
                  *lobby-generic-confirmation*
                  (lambda :behavior lobby-menu-manager () (go-virtual num-local-players-demo))
                  (the-as (function symbol object) (lambda :behavior lobby-menu-manager () (go-virtual num-local-players-demo)))
                  #f
                  #f
                  #f
                  )
                )
               (else
                 (when (kill-menu self #t #f)
                   (set! (-> self local-players) 2)
                   (set! *lobby-local-players* (-> self local-players))
                   (go-virtual choose-your-adventure)
                   )
                 )
               )
             (set! (-> *num-players-info* min) 2)
             (let ((v0-1 (the-as object 2)))
               (set! (-> *num-players-info* max) (the-as int v0-1))
               v0-1
               )
             )
            )
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (local-vars (v1-2 symbol))
    (dotimes (v1-0 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-0))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-0))) info-ptr) *num-local-players-menu*)
                 )
        (set! v1-2 #t)
        (goto cfg-20)
        )
      )
    (set! v1-2 #f)
    (label cfg-20)
    (if v1-2
        (goto cfg-24)
        )
    (kill-menu self #t #f)
    (create-menu self *num-local-players-menu* 0)
    #t
    (label cfg-24)
    (fmv-player-run-texture "split" *default-pool*)
    )
  :exit (behavior ()
    (kill-by-type fmv-player *active-pool*)
    )
  :trans (behavior ()
    (cond
      ((zero? (-> (the-as selection-menu-manager (find-menu self 'split-screen-selection)) selection-index))
       (set! (-> *menu-split-selection-string* 0) (the-as uint 1635))
       (set! (-> *split-screen-sprite-list* 0) 0)
       (set! (-> *split-screen-sprite-list* 1) 1)
       )
      (else
        (set! (-> *menu-split-selection-string* 0) (the-as uint 1636))
        (set! (-> *split-screen-sprite-list* 0) 2)
        (set! (-> *split-screen-sprite-list* 1) 3)
        )
      )
    )
  :code sleep-code
  :post lobby-default-post
  )

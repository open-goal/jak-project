;; failed to figure out what this is:
(defstate dnas-running-screen (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (lobby-menu-manager-default-handler proc argc message block)
    )
  :exit (behavior ()
    (set! *dnas-is-running* #f)
    )
  :trans (behavior ()
    (if (cpad-or-kbd-pressed-var? (the-as uint 0) (pad-buttons triangle))
        (set! *dnas-abort* #t)
        )
    )
  :code (behavior ()
    (local-vars (v1-52 symbol))
    (kill-by-type fmv-player *active-pool*)
    (if (and *lobby-menu-manager* (= (-> *lobby-menu-manager* game-connection-type) 1))
        (*dnas-on-success*)
        )
    (kill-menu self #f #f)
    (set! *dnas-abort* #f)
    (set! (-> self vehicle-selected) (the-as uint -1))
    (while (handle->process (-> self vehicle-handle))
      (update-vehicle self)
      (suspend)
      )
    (until #f
      (suspend)
      (dotimes (gp-0 6)
        (load-state-method-23 *load-state* gp-0 #f #f)
        )
      (dotimes (v1-19 6)
        (when (!= (-> *level* level (+ v1-19 6) status) 'inactive)
          (b! #t cfg-25 :delay (nop!))
          (set! v1-19 (the-as int 0))
          )
        )
      (goto cfg-26)
      (label cfg-25)
      )
    #f
    (label cfg-26)
    (format 0 "loading DNAS...~%")
    (until #f
      (let ((gp-1 (dnas-load)))
        (when (< gp-1 0)
          (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-2601))
          (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
          (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
          (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
          (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
          (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
          (go-virtual
            lobby-generic-error-menu
            *lobby-generic-confirmation*
            (lambda :behavior lobby-menu-manager () (go-virtual pre-game-type-menu))
            (the-as (function symbol object) #f)
            #t
            #f
            #f
            )
          )
        (if (zero? gp-1)
            (goto cfg-36)
            )
        (when (= gp-1 #x3039)
          (knet-eenet-get-mac *dnas-unique-id*)
          (goto cfg-104)
          )
        )
      (suspend)
      0
      )
    #f
    (label cfg-36)
    (set! *dnas-is-loaded* #t)
    (until (no-menus-dying? self)
      (suspend)
      )
    (set! *dnas-is-running* #t)
    (dotimes (v1-50 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-50))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-50))) info-ptr) *dnas-running-screen*)
                 )
        (set! v1-52 #t)
        (goto cfg-58)
        )
      )
    (set! v1-52 #f)
    (label cfg-58)
    (if v1-52
        (goto cfg-62)
        )
    (kill-menu self #t #f)
    (create-menu self *dnas-running-screen* 0)
    #t
    (until (all-running? (get-in-focus-menu self))
      (label cfg-62)
      (suspend)
      )
    (format 0 "initting DNAS...~%")
    (set! *dnas-error-code* (dnas-init))
    (if (< *dnas-error-code* 0)
        (go-virtual dnas-error-screen)
        )
    (set! *dnas-is-started* #t)
    (format 0 "doing DNAS auth...~%")
    (case *dnas-mode*
      ((1)
       (mem-clear! (the-as pointer *dnas-unique-id-req*) 16)
       (set! (-> *dnas-unique-id-req* category) (the-as uint #x3c3360b2))
       (set! (-> *dnas-unique-id-req* data) *dnas-unique-id*)
       (set! *dnas-unique-id-size* 32)
       (set! (-> *dnas-unique-id-req* size) (the-as (pointer int32) (&-> '*dnas-unique-id-size* value)))
       (set! *dnas-error-code* (dnas-auth-get-unique-id *dnas-unique-id-req*))
       )
      ((2)
       (set! *dnas-error-code* (dnas-auth-install))
       )
      (else
        (set! *dnas-error-code* (dnas-auth-net-start))
        )
      )
    (if (< *dnas-error-code* 0)
        (go-virtual dnas-error-screen)
        )
    (until #f
      (suspend)
      (mem-clear! (the-as pointer *dnas-status*) 16)
      (set! *dnas-error-code* (dnas-get-status *dnas-status*))
      (if (< *dnas-error-code* 0)
          (go-virtual dnas-error-screen)
          )
      (case (-> *dnas-status* code)
        ((5)
         (goto cfg-101)
         )
        ((6 7)
         (set! *dnas-error-code* (-> *dnas-status* sub-code))
         (go-virtual dnas-error-screen)
         )
        )
      (when *dnas-abort*
        (format 0 "doing abort...~%")
        (kill-menu self #t #f)
        (until (no-menus-dying? self)
          (suspend)
          )
        (set! *dnas-error-code* (dnas-abort))
        (if (< *dnas-error-code* 0)
            (go-virtual dnas-error-screen)
            )
        (until #f
          (suspend)
          (mem-clear! (the-as pointer *dnas-status*) 16)
          (set! *dnas-error-code* (dnas-get-status *dnas-status*))
          (if (< *dnas-error-code* 0)
              (go-virtual dnas-error-screen)
              )
          (case (-> *dnas-status* code)
            ((2)
             (dnas-do-shutdown #f)
             (go-virtual pre-game-type-menu)
             )
            ((5)
             (goto cfg-101)
             )
            ((6 7)
             (set! *dnas-error-code* (-> *dnas-status* sub-code))
             (go-virtual dnas-error-screen)
             )
            )
          )
        #f
        )
      )
    #f
    (label cfg-101)
    (kill-menu self #t #f)
    (until (no-menus-dying? self)
      (suspend)
      )
    (set! *dnas-is-running* #f)
    (format 0 "DNAS completed ok~%")
    (label cfg-104)
    (kill-menu self #t #f)
    (*dnas-on-success*)
    )
  )

;; definition for function medius-post-dnas-signature
;; WARN: Return type mismatch int vs object.
(defun medius-post-dnas-signature ()
  (format 0 "posting dnas...~%")
  (let ((gp-0 (new 'stack-no-clear 'medius-dnas-signature-post)))
    (mem-clear! (-> gp-0 message-id) 77)
    (mem-copy! (-> gp-0 session-key) *medius-session-key* 17)
    (set! (-> gp-0 dnas-signature-type) (medius-dnas-type dnas-console-id))
    (set! (-> gp-0 dnas-signature-length) 32)
    (mem-copy! (-> gp-0 dnas-signature) *dnas-unique-id* 32)
    (set! *scert-function-id* (scert-function medius-dnas-signature-post))
    (knet-scert-function-1-args (-> gp-0 message-id))
    )
  0
  )


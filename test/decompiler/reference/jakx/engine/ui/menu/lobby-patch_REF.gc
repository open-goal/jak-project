(defstate patch-downloading (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('menu-selection-event)
       #f
       )
      (('http-download-cancelled)
       #f
       )
      (('http-download-failed)
       (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-2608))
       (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
       (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
       (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
       (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
       (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
       (go-virtual
         lobby-generic-error-menu
         *lobby-generic-confirmation*
         (lambda :behavior lobby-menu-manager () (go-virtual net-connection-error))
         (the-as (function symbol object) #f)
         #t
         #f
         #f
         )
       )
      (('http-download-complete)
       (set! *patch-recv-bytes* (the-as int (-> block param 0)))
       (send-event (find-menu self 'indicator) 'complete)
       (when (not (and *pending-op*
                       *lobby-menu-manager*
                       (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                          (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                          )
                       )
                  )
         (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
         (let ((v0-0 (the-as object (lambda :behavior lobby-menu-manager
                                      ()
                                      (suspend-for (seconds 1)
                                        )
                                      (go-virtual patch-authorizing)
                                      )
                             )
                     )
               )
           (set! *pending-op* (the-as (function object object object object object object object object object)
                                (the-as (function object :behavior lobby-menu-manager) v0-0)
                                )
                 )
           v0-0
           )
         )
       )
      (('http-download-data-start)
       (set! *patch-total-bytes* (the-as int (-> block param 0)))
       (set! *patch-recv-bytes* 0)
       (send-event (find-menu self 'indicator) 'set-text-id 2605)
       (when (< #x7fff0 *patch-total-bytes*)
         (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-2608))
         (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
         (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
         (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
         (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
         (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
         (go-virtual
           lobby-generic-error-menu
           *lobby-generic-confirmation*
           (lambda :behavior lobby-menu-manager () (go-virtual net-connection-error))
           (the-as (function symbol object) #f)
           #t
           #f
           #f
           )
         )
       )
      (('http-download-data)
       (let ((s5-2 (-> block param 1)))
         (when (< #x7fff0 (+ *patch-recv-bytes* s5-2))
           (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-2608))
           (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
           (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
           (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
           (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
           (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
           (go-virtual
             lobby-generic-error-menu
             *lobby-generic-confirmation*
             (lambda :behavior lobby-menu-manager () (go-virtual net-connection-error))
             (the-as (function symbol object) #f)
             #t
             #f
             #f
             )
           )
         (mem-copy! (&+ *patch-buffer* *patch-recv-bytes*) (the-as pointer (-> block param 0)) (the-as int s5-2))
         (set! *patch-recv-bytes* (+ *patch-recv-bytes* s5-2))
         )
       (send-event (find-menu self 'indicator) 'update *patch-recv-bytes* *patch-total-bytes*)
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :exit (behavior ()
    (send-event (handle->process (-> *http-downloader* handle)) 'cancel)
    )
  :code (behavior ()
    (local-vars (v1-11 symbol))
    (set! *mc-patch-data*
          (the-as mc-patch-data (get-clean-driver-heap (the-as (pointer int32) (&-> '*patch-buffer-size* value))))
          )
    (when (not *mc-patch-data*)
      (break!)
      0
      )
    (mem-clear! (the-as pointer *mc-patch-data*) #x80000)
    (set! *patch-buffer-size* (+ *patch-buffer-size* -16))
    (set! *patch-buffer* (-> *mc-patch-data* data))
    (set! *patch-buffer-size* (min #x7fff0 *patch-buffer-size*))
    (set! *patch-total-bytes* 0)
    (set! *patch-recv-bytes* 0)
    (dotimes (v1-9 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-9))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-9))) info-ptr) *patch-downloading*)
                 )
        (set! v1-11 #t)
        (goto cfg-22)
        )
      )
    (set! v1-11 #f)
    (label cfg-22)
    (if v1-11
        (goto cfg-26)
        )
    (kill-menu self #t #f)
    (create-menu self *patch-downloading* 0)
    #t
    (label cfg-26)
    (suspend)
    (send-event (find-menu self 'indicator) 'init)
    (send-event (find-menu self 'indicator) 'set-text-id 2604)
    (suspend-for (seconds 1)
      )
    (http-start-fetch *net-patch-url*)
    (until #f
      (do-pending-operation)
      (when (cpad-or-kbd-pressed-var? (the-as uint 0) (pad-buttons triangle))
        (logclear! (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons triangle))
        (logclear! (-> *cpad-list* cpads 0 button0-rel 0) (pad-buttons triangle))
        (cpad-or-kbd-clear-func! (the-as uint 0) (pad-buttons triangle))
        (send-event (handle->process (-> *http-downloader* handle)) 'cancel)
        (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-2607))
        (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
        (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
        (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
        (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
        (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
        (go-virtual
          lobby-generic-error-menu
          *lobby-generic-confirmation*
          (lambda :behavior lobby-menu-manager () (go-virtual net-connection-error))
          (the-as (function symbol object) #f)
          #t
          #f
          #f
          )
        )
      (suspend)
      )
    #f
    )
  )

;; definition for function encrypt-patch
(defun encrypt-patch ()
  (let ((v1-0 (dnas-inst-init-mc)))
    (when (!= v1-0 #x3039)
      (when (nonzero? v1-0)
        (dnas-inst-shutdown-mc)
        (return #f)
        )
      (let ((gp-0 (dnas-inst-personalize-data-length-mc
                    *patch-total-bytes*
                    (-> *mc-patch-data* data)
                    (&-> '*patch-encrypted-size* value)
                    )
                  )
            )
        (format 0 "personalize-data-length returned ~D : ~D bytes~%" gp-0 *patch-encrypted-size*)
        (when (or (nonzero? gp-0) (< #x7fff0 *patch-encrypted-size*))
          (dnas-inst-shutdown-mc)
          (return #f)
          )
        )
      (let ((gp-1 (dnas-inst-personalize-data-mc *patch-total-bytes* *patch-encrypted-size* (-> *mc-patch-data* data))))
        (format 0 "personalize-data returned ~D~%" gp-1)
        (when (< gp-1 0)
          (dnas-inst-shutdown-mc)
          (return #f)
          )
        )
      (dnas-inst-shutdown-mc)
      )
    )
  #t
  )

;; failed to figure out what this is:
(defstate patch-authorizing (lobby-menu-manager)
  :virtual #t
  :code (behavior ()
    (set! *dnas-mode* 2)
    (set! *dnas-on-success* (lambda :behavior lobby-menu-manager
                              ()
                              (dnas-do-shutdown #t)
                              (let ((gp-0 (encrypt-patch)))
                                (dnas-do-shutdown #f)
                                (when (not gp-0)
                                  (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-2902))
                                  (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
                                  (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
                                  (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
                                  (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
                                  (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
                                  (go-virtual
                                    lobby-generic-error-menu
                                    *lobby-generic-confirmation*
                                    (lambda :behavior lobby-menu-manager () (go-virtual net-connection-error))
                                    (the-as (function symbol object) #f)
                                    #t
                                    #f
                                    #f
                                    )
                                  )
                                )
                              (go-virtual patch-installing)
                              )
          )
    (set! *dnas-on-failure* (lambda :behavior lobby-menu-manager
                              ()
                              (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-2902))
                              (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
                              (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
                              (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
                              (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
                              (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
                              (go-virtual
                                lobby-generic-error-menu
                                *lobby-generic-confirmation*
                                (lambda :behavior lobby-menu-manager () (go-virtual net-connection-error))
                                (the-as (function symbol object) #f)
                                #t
                                #f
                                #f
                                )
                              )
          )
    (go-virtual dnas-running-screen)
    )
  )

;; failed to figure out what this is:
(defstate patch-installing (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('notify)
       (case (-> block param 0)
         (('done)
          (case (-> block param 1)
            ((1)
             (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-2625))
             (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1712))
             (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
             (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
             (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
             (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
             (go-virtual
               lobby-generic-error-menu
               *lobby-generic-confirmation*
               (the-as (function object) #f)
               (the-as (function symbol object) #f)
               #t
               #f
               #f
               )
             )
            (else
              (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-2626))
              (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1712))
              (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1926))
              (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-3891))
              (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
              (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
              (go-virtual
                lobby-generic-error-menu
                *lobby-generic-confirmation*
                (lambda :behavior lobby-menu-manager () (go-virtual patch-installing))
                (the-as (function symbol object) (lambda :behavior lobby-menu-manager () (go-virtual net-connection-error)))
                #f
                #f
                #f
                )
              )
            )
          )
         (('error)
          (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-2626))
          (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1712))
          (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1926))
          (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-4273))
          (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
          (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
          (go-virtual
            lobby-generic-error-menu
            *lobby-generic-confirmation*
            (lambda :behavior lobby-menu-manager () (go-virtual patch-installing))
            (the-as (function symbol object) (lambda :behavior lobby-menu-manager () (go-virtual net-connection-error)))
            #f
            #f
            #f
            )
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :code (behavior ()
    (set! (-> *mc-patch-data* version) (the-as uint 1))
    (set! (-> *mc-patch-data* size) (the-as uint *patch-encrypted-size*))
    (auto-save-command 'save-patch 0 0 self #f #f)
    (sleep-code)
    )
  )

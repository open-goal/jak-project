;; definition for function get-dnas-error
(defun get-dnas-error ((arg0 int))
  (let* ((v1-0 (scf-get-territory))
         (gp-0 (if (= v1-0 1)
                   *dnas-errors-eur*
                   *dnas-errors-usa*
                   )
               )
         )
    (let ((s5-1 (- arg0)))
      (dotimes (s4-0 (length gp-0))
        (let ((v1-3 (-> gp-0 s4-0)))
          (if (and (>= s5-1 (-> v1-3 min)) (>= (-> v1-3 max) s5-1))
              (return v1-3)
              )
          )
        )
      )
    (-> gp-0 (+ (length gp-0) -1))
    )
  )

;; definition for function get-clean-driver-heap
;; WARN: new jak 2 until loop case, check carefully
(defun get-clean-driver-heap ((arg0 (pointer int32)))
  (until #f
    (suspend)
    (dotimes (s5-0 6)
      (load-state-method-24 *load-state* s5-0 #f)
      )
    (dotimes (v1-4 6)
      (if (!= (-> *level* level (+ v1-4 12) status) 'inactive)
          (goto cfg-14)
          )
      )
    (if arg0
        (set! (-> arg0 0) (&- (-> *level* driver-heap top) (the-as uint (-> *level* driver-heap base))))
        )
    (return (-> *level* driver-heap base))
    (label cfg-14)
    )
  #f
  (the-as pointer #f)
  )


;; definition for function dnas-do-shutdown
;; WARN: Return type mismatch int vs object.
(defun dnas-do-shutdown ((arg0 symbol))
  (when *dnas-is-started*
    (format 0 "doing shutdown...~%")
    (let ((a2-0 (dnas-shutdown)))
      (format 0 "dnas shutdown returned ~D~%" a2-0)
      )
    (set! *dnas-is-started* #f)
    )
  (when (not arg0)
    (while *dnas-is-loaded*
      (suspend)
      (if (<= (dnas-unload) 0)
          (set! *dnas-is-loaded* #f)
          )
      )
    )
  0
  )

;; failed to figure out what this is:
(defstate dnas-error-screen (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (lobby-menu-manager-default-handler proc argc message block)
    )
  :trans (behavior ()
    (cond
      ((cpad-or-kbd-pressed-var? (the-as uint 0) (pad-buttons x))
       (kill-menu self #t #f)
       (go-virtual dnas-running-screen)
       )
      ((cpad-or-kbd-pressed-var? (the-as uint 0) (pad-buttons triangle))
       (kill-menu self #t #f)
       (*dnas-on-failure*)
       )
      )
    )
  :code (behavior ()
    (local-vars (v1-12 symbol))
    (kill-menu self #f #f)
    (dnas-do-shutdown #f)
    (until (no-menus-dying? self)
      (suspend)
      )
    (let ((gp-0 (get-dnas-error *dnas-error-code*)))
      (set! (-> *dnas-error-text-ids* 0) (-> gp-0 main-text-id))
      (set! (-> *dnas-error-text-ids* 1) (-> gp-0 footer-text-id))
      (format
        (clear *medius-policy-string*)
        (lookup-text! *common-text* (-> gp-0 errtype-text-id) #f)
        *dnas-error-code*
        )
      )
    (copy-charp<-charp *dnas-error-code-string* (-> *medius-policy-string* data))
    (dotimes (v1-10 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-10))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-10))) info-ptr) *dnas-error-screen*)
                 )
        (set! v1-12 #t)
        (goto cfg-22)
        )
      )
    (set! v1-12 #f)
    (label cfg-22)
    (if v1-12
        (goto cfg-26)
        )
    (kill-menu self #t #f)
    (create-menu self *dnas-error-screen* 0)
    #t
    (label cfg-26)
    (sleep-code)
    )
  )


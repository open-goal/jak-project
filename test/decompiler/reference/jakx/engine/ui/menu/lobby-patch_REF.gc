;;-*-Lisp-*-
(in-package goal)

;; definition of type dnas-error
(deftype dnas-error (structure)
  ((min              int32)
   (max              int32)
   (main-text-id     text-id)
   (footer-text-id   text-id)
   (errtype-text-id  text-id)
   )
  )

;; definition for method 3 of type dnas-error
(defmethod inspect ((this dnas-error))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'dnas-error)
  (format #t "~1Tmin: ~D~%" (-> this min))
  (format #t "~1Tmax: ~D~%" (-> this max))
  (format #t "~1Tmain-text-id: ~D~%" (-> this main-text-id))
  (format #t "~1Tfooter-text-id: ~D~%" (-> this footer-text-id))
  (format #t "~1Terrtype-text-id: ~D~%" (-> this errtype-text-id))
  (label cfg-4)
  this
  )


;;-*-Lisp-*-
(in-package goal)

;; definition of type lobby-awards-score->car-type-row
(deftype lobby-awards-score->car-type-row (structure)
  ((score      uint16)
   (ctype      int8)
   (cup-index  uint8)
   (cup        uint32)
   )
  )

;; definition for method 3 of type lobby-awards-score->car-type-row
(defmethod inspect ((this lobby-awards-score->car-type-row))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'lobby-awards-score->car-type-row)
  (format #t "~1Tscore: ~D~%" (-> this score))
  (format #t "~1Tctype: ~D~%" (-> this ctype))
  (format #t "~1Tcup-index: ~D~%" (-> this cup-index))
  (format #t "~1Tcup: ~D~%" (-> this cup))
  (label cfg-4)
  this
  )

;; definition of type lobby-awards-score->driver-type-row
(deftype lobby-awards-score->driver-type-row (structure)
  ((movie-index  uint16)
   (driver       uint8)
   )
  )

;; definition for method 3 of type lobby-awards-score->driver-type-row
(defmethod inspect ((this lobby-awards-score->driver-type-row))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'lobby-awards-score->driver-type-row)
  (format #t "~1Tmovie-index: ~D~%" (-> this movie-index))
  (format #t "~1Tdriver: ~D~%" (-> this driver))
  (label cfg-4)
  this
  )

;; definition for symbol lobby-awards-table-adv-score->car-type, type (array lobby-awards-score->car-type-row)
(define lobby-awards-table-adv-score->car-type
  (new 'static 'boxed-array :type lobby-awards-score->car-type-row
    (new 'static 'lobby-awards-score->car-type-row :ctype 1 :cup #x80)
    (new 'static 'lobby-awards-score->car-type-row :ctype 3 :cup #x80)
    (new 'static 'lobby-awards-score->car-type-row :score #x11 :ctype 4 :cup #x80)
    (new 'static 'lobby-awards-score->car-type-row :score #x21 :ctype 5 :cup #x80)
    (new 'static 'lobby-awards-score->car-type-row :ctype 2 :cup-index #x1 :cup #x100)
    (new 'static 'lobby-awards-score->car-type-row :ctype 8 :cup-index #x1 :cup #x100)
    (new 'static 'lobby-awards-score->car-type-row :score #x10 :ctype 6 :cup-index #x1 :cup #x100)
    (new 'static 'lobby-awards-score->car-type-row :score #x22 :ctype 9 :cup-index #x1 :cup #x100)
    (new 'static 'lobby-awards-score->car-type-row :ctype 10 :cup-index #x2 :cup #x200)
    (new 'static 'lobby-awards-score->car-type-row :ctype 7 :cup-index #x2 :cup #x200)
    (new 'static 'lobby-awards-score->car-type-row :score #xf :ctype 12 :cup-index #x2 :cup #x200)
    (new 'static 'lobby-awards-score->car-type-row :score #x1e :ctype 11 :cup-index #x2 :cup #x200)
    )
  )

;; definition for symbol lobby-awards-table-adv-score->driver-type, type (array lobby-awards-score->driver-type-row)
(define lobby-awards-table-adv-score->driver-type
  (new 'static 'boxed-array :type lobby-awards-score->driver-type-row
    (new 'static 'lobby-awards-score->driver-type-row :movie-index #x9 :driver #xb)
    (new 'static 'lobby-awards-score->driver-type-row :movie-index #xa :driver #xa)
    (new 'static 'lobby-awards-score->driver-type-row :movie-index #xf :driver #x3)
    (new 'static 'lobby-awards-score->driver-type-row :movie-index #x1a :driver #x2)
    (new 'static 'lobby-awards-score->driver-type-row :movie-index #x1d :driver #xd)
    (new 'static 'lobby-awards-score->driver-type-row :movie-index #x22 :driver #x4)
    (new 'static 'lobby-awards-score->driver-type-row :movie-index #x22 :driver #x13)
    )
  )

;; definition for symbol *lobby-awards-first-new-vehicle*, type symbol
(define *lobby-awards-first-new-vehicle* #f)

;; definition for symbol *lobby-awards-new-vehicle*, type int
(define *lobby-awards-new-vehicle* 0)

;; definition for symbol *lobby-awards-new-event*, type game-task-node-info
(define *lobby-awards-new-event* (the-as game-task-node-info #f))

;; definition for symbol *lobby-awards-new-body-part*, type car-part-info
(define *lobby-awards-new-body-part* (the-as car-part-info #f))

;; definition for symbol *lobby-awards-new-driver*, type driver-type
(define *lobby-awards-new-driver* (driver-type none))

;; definition for function lobby-awards-handle-vehicle-awarding
(defun lobby-awards-handle-vehicle-awarding ()
  (if (= *lobby-awards-new-vehicle* 14)
      (return *lobby-awards-new-vehicle*)
      )
  (when (= *game-mode* 'adventure)
    (let* ((gp-0 (-> lobby-awards-table-adv-score->car-type length))
           (s5-0 0)
           (s4-0 (-> lobby-awards-table-adv-score->car-type s5-0))
           )
      (while (< s5-0 gp-0)
        (if (and (>= (get-task-cup-score (the-as int (-> s4-0 cup))) (the-as int (-> s4-0 score)))
                 (not (logtest? (-> *game-info* car-info data (-> s4-0 ctype) flags) (car-info-flag cif0)))
                 (or (zero? (-> s4-0 cup-index)) (= 3 (-> *game-info* grand-prix (+ (-> s4-0 cup-index) -1) trophy)))
                 )
            (logior! (-> *game-info* car-info data (-> s4-0 ctype) flags) (car-info-flag cif0))
            )
        (+! s5-0 1)
        (set! s4-0 (-> lobby-awards-table-adv-score->car-type s5-0))
        )
      )
    (let* ((s2-0 #f)
           (s5-1 0)
           (s4-1 (-> lobby-awards-table-adv-score->car-type length))
           (s3-0 0)
           (gp-1 (-> lobby-awards-table-adv-score->car-type s3-0))
           )
      (while (< s3-0 s4-1)
        (let ((v1-29 (get-task-cup-score (the-as int (-> gp-1 cup)))))
          (cond
            (s2-0
              (if (and (>= v1-29 (the-as int (-> gp-1 score)))
                       (logtest? (-> *game-info* car-info data (-> gp-1 ctype) flags) (car-info-flag cif0))
                       (not (logtest? (-> *game-info* car-info data (-> gp-1 ctype) flags) (car-info-flag cif1)))
                       (or (zero? (-> gp-1 cup-index)) (= 3 (-> *game-info* grand-prix (+ (-> gp-1 cup-index) -1) trophy)))
                       )
                  (load-state-method-25
                    *load-state*
                    (level-name-from-vehicle-type (vehicle-type-from-car-type (the-as car-type (-> gp-1 ctype))))
                    )
                  )
              (return *lobby-awards-new-vehicle*)
              )
            ((and (>= v1-29 (the-as int (-> gp-1 score)))
                  (logtest? (-> *game-info* car-info data (-> gp-1 ctype) flags) (car-info-flag cif0))
                  (not (logtest? (-> *game-info* car-info data (-> gp-1 ctype) flags) (car-info-flag cif1)))
                  (or (zero? (-> gp-1 cup-index)) (= 3 (-> *game-info* grand-prix (+ (-> gp-1 cup-index) -1) trophy)))
                  )
             (set! *lobby-awards-new-vehicle* (-> gp-1 ctype))
             (logior! (-> *game-info* car-info data (-> gp-1 ctype) flags) (car-info-flag cif0))
             (logior! (-> *game-info* car-info data (-> gp-1 ctype) flags) (car-info-flag cif1))
             (set! s2-0 (cond
                          ((= s5-1 (+ (-> lobby-awards-table-adv-score->car-type length) -1))
                           (return *lobby-awards-new-vehicle*)
                           s2-0
                           )
                          (else
                            #t
                            )
                          )
                   )
             (if (not *lobby-awards-first-new-vehicle*)
                 (set! *lobby-awards-first-new-vehicle* (the-as symbol *lobby-awards-new-vehicle*))
                 )
             )
            )
          )
        (+! s5-1 1)
        (+! s3-0 1)
        (set! gp-1 (-> lobby-awards-table-adv-score->car-type s3-0))
        )
      )
    )
  (set! *lobby-awards-new-vehicle* (the-as int #f))
  (the-as int #f)
  )

;; definition for function lobby-awards-handle-body-part-awarding
;; WARN: Return type mismatch car-part-info vs symbol.
(defun lobby-awards-handle-body-part-awarding ()
  (local-vars (v0-0 car-part-info))
  (set! *lobby-awards-new-body-part* #f)
  (dotimes (gp-0 (-> *car-part-info-arrays* length))
    (dotimes (s5-0 (-> *car-part-info-arrays* gp-0 length))
      (when (and (not (logtest? (-> *car-part-info-arrays* gp-0 s5-0 flags) 2))
                 (nonzero? (-> *car-part-info-arrays* gp-0 s5-0 task))
                 )
        (when (and (= *game-mode* 'adventure)
                   (>= (the-as uint (-> *game-info* sub-task-list (-> *car-part-info-arrays* gp-0 s5-0 task) medals 0))
                       (-> *car-part-info-arrays* gp-0 s5-0 medal)
                       )
                   )
          (logior! (-> *car-part-info-arrays* gp-0 s5-0 flags) 2)
          (set! *lobby-awards-new-body-part* (-> *car-part-info-arrays* gp-0 s5-0))
          (return (the-as symbol *lobby-awards-new-body-part*))
          )
        (when (and (!= *game-mode* 'adventure)
                   (= (-> *game-info* sub-task-list (-> *car-part-info-arrays* gp-0 s5-0 task)) (get-open-task-node-info))
                   *eligible-for-body-part-award*
                   )
          (logior! (-> *car-part-info-arrays* gp-0 s5-0 flags) 2)
          (set! *lobby-awards-new-body-part* (-> *car-part-info-arrays* gp-0 s5-0))
          (return (the-as symbol *lobby-awards-new-body-part*))
          )
        )
      )
    )
  (return (the-as symbol *lobby-awards-new-body-part*))
  (the-as symbol v0-0)
  )

;; definition for function lobby-awards-handle-driver-awarding
(defun lobby-awards-handle-driver-awarding ()
  (local-vars (v0-0 driver-type))
  (set! *lobby-awards-new-driver* (driver-type none))
  (dotimes (v1-1 24)
    (when (and (logtest? (-> *game-info* driver-unlock) (ash 1 v1-1))
               (not (logtest? (-> *game-info* driver-award) (ash 1 v1-1)))
               )
      (logior! (-> *game-info* driver-award) (ash 1 v1-1))
      (set! *lobby-awards-new-driver* (the-as driver-type v1-1))
      (return *lobby-awards-new-driver*)
      )
    )
  (return *lobby-awards-new-driver*)
  v0-0
  )

;; definition for function lobby-awards-handle-event-awarding
;; WARN: Return type mismatch game-task-node-info vs symbol.
(defun lobby-awards-handle-event-awarding ()
  (local-vars (v0-1 game-task-node-info))
  (set! *lobby-awards-new-event* #f)
  (when (and (!= -1 *lobby-adv-cup*) (= *game-mode* 'adventure))
    (dotimes (gp-0 4)
      (let* ((s5-0 *lobby-adv-cup*)
             (v1-4 (get-task-cup-score (the-as int s5-0)))
             (a0-5 (-> *game-info* sub-task-list))
             )
        (dotimes (a1-0 (-> a0-5 length))
          (when (nonzero? a1-0)
            (let ((a2-3 (-> a0-5 a1-0)))
              (when (and (-> *game-info* play-list (-> a2-3 task) play-continue)
                         (-> *game-info* play-list (-> a2-3 task) single-player)
                         (logtest? (-> a2-3 flags) s5-0)
                         (>= (-> a2-3 adv-score) 0)
                         (>= v1-4 (-> a2-3 adv-score))
                         (zero? (-> a2-3 unlocked))
                         (not (logtest? (-> *task-level-info* (-> *game-info* play-list (-> a2-3 task) task-level) flags)
                                        (task-level-info-flag tli0)
                                        )
                              )
                         )
                (logior!
                  (-> *task-level-info* (-> *game-info* play-list (-> a2-3 task) task-level) flags)
                  (task-level-info-flag tli0)
                  )
                (set! (-> a2-3 unlocked) (the-as uint 1))
                (when (not (logtest? (game-task-node-flag qualifier) (-> a2-3 flags)))
                  (set! *lobby-awards-new-event* a2-3)
                  (return (the-as symbol *lobby-awards-new-event*))
                  )
                )
              )
            )
          )
        )
      )
    )
  (return (the-as symbol *lobby-awards-new-event*))
  (the-as symbol v0-1)
  )

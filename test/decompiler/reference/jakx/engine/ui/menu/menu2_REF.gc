;; definition for function default-base-menu-post
;; INFO: Used lq/sq
;; WARN: Return type mismatch object vs none.
(defbehavior default-base-menu-post base-menu ()
  (let ((f30-0 (/ (-> self info-ptr scale-x) 10))
        (f28-0 (/ (-> self info-ptr scale-y) 10))
        (f26-0 0.1)
        )
    (cond

;; failed to figure out what this is:
(defstate running (dropdown-item)
  :virtual #t
  :exit (behavior ()
    (menu-clear-strip (-> self p-client-selection strip))
    )
  :trans (behavior ()
    (when (and (-> self focused?) (-> self selected))
      (cond
        ((or (zero? (-> self pad)) (= (-> self pad) 1))
         (handle-input self (-> self pad))
         )
        ((= (-> self pad) 2)
         (handle-input self 0)
         (handle-input self 1)
         )
        )
      )
    (call-parent-state-handler trans)
    )
  :post (behavior ()
    (menu-clear-strip (-> self p-client-selection strip))
    (if (logtest? (-> self info-ptr flags) (base-menu-info-flag disabled))
        (set! (-> self enabled) #f)
        )
    (default-base-menu-post)
    (if (and (-> self enabled) (and (-> self focused?) (-> self selected) (not *hide-menus*)))
        (draw-highlight self)
        )
    )
  )

;; definition for method 61 of type dropdown-item
(defmethod default-event-handler ((this dropdown-item) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (case arg2
    (('selected)
     (cond
       ((-> this enabled)
        (send-event
          (ppointer->process (-> this parent))
          'menu-selection-event
          'changed
          (-> this info-ptr selection-type)
          )
        (set! (-> this selected) #t)
        (set! (-> this prev-selection) (the-as int (-> arg3 param 0)))
        (if (= (-> *lobby-menu-manager* state name) *last-lobby-state*)
            (insert-selection-cache (-> *lobby-menu-manager* state name) (-> this info-ptr selection-type))
            )
        (let ((v0-2 (the-as object (-> *lobby-menu-manager* state name))))
          (set! *last-lobby-state* (the-as symbol v0-2))
          v0-2
          )
        )
       (else
         #f
         )
       )
     )
    (('deselected)
     (set! (-> this selected) #f)
     #f
     )
    (('enabled)
     (set! (-> this enabled) #t)
     (send-event this 'to-all-children 'set-strings-enabled)
     )
    (('disabled)
     (set! (-> this enabled) #f)
     (if (-> this selected)
         (send-event (ppointer->process (-> this parent)) 'next 0)
         )
     (send-event this 'to-all-children 'set-strings-disabled)
     )
    (('sym?)
     (= (-> arg3 param 0) (-> this info-ptr selection-type))
     )
    (else
      (call-parent-method this arg0 arg1 arg2 arg3)
      )
    )
  )


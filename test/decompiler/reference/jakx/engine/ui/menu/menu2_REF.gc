               (set! (-> a1-3 message) message)
               (set! (-> a1-3 param 0) (-> block param 0))
               (set! (-> a1-3 param 1) (-> block param 1))
               (set! (-> a1-3 param 2) (-> block param 2))
               (set! (-> a1-3 param 3) (-> block param 3))
               (set! (-> a1-3 param 4) (-> block param 4))
               (set! (-> a1-3 param 5) (-> block param 5))
               (send-event-function (handle->process (-> self child-handles s2-0)) a1-3)
               )
             )
           )
         )
       (set! (-> self hidden?) #f)

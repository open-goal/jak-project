;; definition for symbol *customize-menu-text-ids*, type (array text-id)
(define *customize-menu-text-ids* (the-as (array text-id) (new 'static 'boxed-array :type uint32 #x5f1)))

;; definition for symbol *tune-performance-text-ids*, type (array text-id)
(define *tune-performance-text-ids*

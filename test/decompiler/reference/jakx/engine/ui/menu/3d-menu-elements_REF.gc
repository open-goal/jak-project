;; definition for function garage-cinema-init-by-other
;; INFO: Used lq/sq
;; WARN: Return type mismatch object vs none.
(defbehavior garage-cinema-init-by-other garage-cinema ((arg0 object) (arg1 entity))
  (process-entity-set! self arg1)
  (set! (-> self level) (level-get *level* 'menu2))
  (set! (-> self root) (new 'process 'trsqv))
  (set! (-> self root trans quad) (-> arg1 trans quad))
  (process-drawable-method-42
    self
    (art-group-get-by-name *level* "skel-garage-cinema" (the-as (pointer level) #f))
    0
    )
  (set! *garage-cinema* self)
  (go-virtual idle)
  (none)
  )

;; failed to figure out what this is:
(defstate idle (garage-cinema)
  :virtual #t
  :trans (behavior ()
    0
    )
  :code (behavior ()
    (ja-no-eval :group! garage-cinema-idle-ja :num! (seek! max 1.1) :frame-num 60.0)
    (until (ja-done? 0)
      (suspend)
      (ja :num! (seek! max 1.1))
      )
    (send-event *lobby-menu-manager* 'garage-cinema)
    (sleep-code)
    )
  :post (behavior ()
    (ja-post)
    )
  )


;; definition for method 7 of type garage-cinema
(defmethod relocate ((this garage-cinema) (offset int))
  (set! *garage-cinema* this)
  (if *garage-cinema*
      (set! *garage-cinema* (&+ *garage-cinema* offset))
      )
  (call-parent-method this offset)

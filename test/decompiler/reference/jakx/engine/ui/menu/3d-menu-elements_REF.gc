;;-*-Lisp-*-
(in-package goal)

;; definition of type interface-cam
(deftype interface-cam (process-drawable)
  ()
  (:state-methods
    idle
    enter
    exit
    )
  (:methods
    (interface-cam-method-53 (_type_) none)
    (interface-cam-method-54 (_type_) none)
    )
  )

;; definition for method 3 of type interface-cam
(defmethod inspect ((this interface-cam))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type process-drawable inspect)))
    (t9-0 this)
    )
  (label cfg-4)
  this
  )

;; definition for symbol *interface-cam*, type interface-cam
(define *interface-cam* (the-as interface-cam #f))

;; failed to figure out what this is:
(defskelgroup skel-interface-cam interface-cam interface-cam-lod0-jg interface-cam-idle-ja
              ((interface-cam-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 0 0 4000)
              )

;; failed to figure out what this is:
(defstate enter (interface-cam)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('die)
       (go-virtual exit)
       )
      )
    )
  :enter (behavior ()
    (format #t "3d-object entered enter state~%")
    )
  :trans (behavior ()
    (interface-cam-method-53 self)
    )
  :code (behavior ()
    (go-virtual idle)
    )
  :post ja-post
  )

;; failed to figure out what this is:
(defstate idle (interface-cam)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('die)
       (go-virtual exit)
       )
      )
    )
  :trans (behavior ()
    (interface-cam-method-53 self)
    )
  :code (behavior ()
    (until #f
      (suspend)
      )
    #f
    )
  :post ja-post
  )

;; failed to figure out what this is:
(defstate exit (interface-cam)
  :virtual #t
  :enter (behavior ()
    (format #t "3d-object dying~%")
    )
  :trans (behavior ()
    (interface-cam-method-53 self)
    )
  :code (behavior ()
    '()
    )
  :post ja-post
  )

;; definition for method 53 of type interface-cam
;; INFO: Used lq/sq
;; WARN: Return type mismatch int vs none.
(defmethod interface-cam-method-53 ((this interface-cam))
  (let ((a0-2 (entity-by-name "hanginglamp-part-9")))
    (when a0-2
      (let ((v1-2 (-> a0-2 trans quad)))
        (set! (-> this root trans quad) v1-2)
        )
      )
    )
  0
  (none)
  )

;; definition for method 54 of type interface-cam
;; WARN: Return type mismatch int vs none.
(defmethod interface-cam-method-54 ((this interface-cam))
  (process-drawable-method-42
    this
    (art-group-get-by-name *level* "skel-interface-cam" (the-as (pointer level) #f))
    0
    )
  (set! *interface-cam* this)
  0
  (none)
  )

;; definition for function interface-cam-init-by-other
;; INFO: Used lq/sq
;; WARN: Return type mismatch object vs none.
(defbehavior interface-cam-init-by-other interface-cam ((arg0 vector) (arg1 entity))
  (process-entity-set! self arg1)
  (set! (-> self level) (level-get *level* 'menu2))
  (set! (-> self root) (new 'process 'trsqv))
  (set! (-> self root trans quad) (-> arg0 quad))
  (interface-cam-method-54 self)
  (go-virtual enter)
  (none)
  )

;; definition for function activate-bar
(defun activate-bar ()
  (new 'static 'vector :z 40960.0 :w 1.0)
  (let ((gp-0 (new 'stack-no-clear 'vector)))
    (process-spawn interface-cam gp-0 #f :name "interface-cam" :to *entity-pool*)
    )
  )

;; definition for method 10 of type interface-cam
(defmethod deactivate ((this interface-cam))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (set! *interface-cam* #f)
  (call-parent-method this)
  (none)
  )

;; definition for method 7 of type interface-cam
(defmethod relocate ((this interface-cam) (offset int))
  (set! *interface-cam* this)
  (if *interface-cam*
      (set! *interface-cam* (&+ *interface-cam* offset))
      )
  (call-parent-method this offset)
  )


;; definition for function get-extra-player-string
(defun get-extra-player-string ((arg0 int))
  (let ((v1-0 arg0))
    (cond
      ((zero? v1-0)
       *player-1-extra*
       )
      ((= v1-0 1)
       *player-2-extra*
       )
      ((= v1-0 2)
       *player-3-extra*
       )
      ((= v1-0 3)
       *player-4-extra*
       )
      ((= v1-0 4)
       *player-5-extra*
       )
      (else
        *player-6-extra*
        )
      )
    )
  )

;; definition for function set-index
(defun set-index ((arg0 menu-selection-struct) (arg1 symbol))
  (local-vars (v0-0 symbol))
  (dotimes (s4-0 (length (-> arg0 array-ptr)))
    (when (= (-> arg0 array-ptr s4-0 sym) arg1)
      (set! (-> arg0 selection-index) s4-0)
      (return #t)
      )
    )
  (return #f)
  v0-0
  )

;; definition of type selection-cache
(deftype selection-cache (structure)
  ((state           symbol)
   (selection-type  symbol)
   )
  )

;; definition for method 3 of type selection-cache
(defmethod inspect ((this selection-cache))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'selection-cache)
  (format #t "~1Tstate: ~A~%" (-> this state))
  (format #t "~1Tselection-type: ~A~%" (-> this selection-type))
  (label cfg-4)
  this
  )

;; definition for symbol *selection-cache-array*, type (inline-array selection-cache)
(define *selection-cache-array* (new 'static 'inline-array selection-cache 3
                                  (new 'static 'selection-cache)
                                  (new 'static 'selection-cache)
                                  (new 'static 'selection-cache)
                                  )
        )

;; definition for symbol *selection-cache-index*, type int
(define *selection-cache-index* 1)

;; definition for symbol *last-lobby-state*, type symbol
(define *last-lobby-state* #f)

;; failed to figure out what this is:
(set! (-> *selection-cache-array* 0 state) 'game-type)

;; failed to figure out what this is:
(set! (-> *selection-cache-array* 0 selection-type) 'adventure)

;; definition for function insert-selection-cache
(defun insert-selection-cache ((arg0 symbol) (arg1 symbol))
  (mod (+ *selection-cache-index* -1) 3)
  (dotimes (v1-3 3)
    (let ((a2-4 (mod (+ (- -1 v1-3) *selection-cache-index*) 3)))
      (if (< a2-4 0)
          (+! a2-4 3)
          )
      (when (= (-> *selection-cache-array* a2-4 state) (-> *lobby-menu-manager* state name))
        (set! (-> *selection-cache-array* a2-4 state) arg0)
        (set! (-> *selection-cache-array* a2-4 selection-type) arg1)
        (return (the-as int #f))
        )
      )
    )
  (set! (-> *selection-cache-array* *selection-cache-index* state) arg0)
  (set! (-> *selection-cache-array* *selection-cache-index* selection-type) arg1)
  (let ((v0-0 (mod (+ *selection-cache-index* 1) 3)))
    (set! *selection-cache-index* v0-0)
    v0-0
    )
  )

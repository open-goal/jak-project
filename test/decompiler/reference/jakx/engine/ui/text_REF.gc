                               0.0
                               (-> gp-0 context origin y)
                               )
            )
      (set! (-> gp-0 y-spacing-scaled) (* (-> gp-0 context y-spacing) (-> gp-0 context scale)))
      (set! (-> gp-0 space-size) (-> (get-string-length " " (-> gp-0 context)) length))
      (set! (-> gp-0 hyphen-size) (-> (get-string-length "-" (-> gp-0 context)) length))
      (set! (-> gp-0 xpos) 0.0)
      (let ((s2-1 (-> arg0 data (-> gp-0 string-count))))
        (set! (-> gp-0 copy-test)
              (or (-> gp-0 dry-run)
                  (or (logtest? (-> gp-0 context flags) (font-flags ff9))
                      (and (< 0.0 (+ (-> gp-0 ypos) (* 2.0 (-> gp-0 y-spacing-scaled)))) (< (-> gp-0 ypos) 416.0))
                      )
                  )
              )
        (while (and (nonzero? s2-1) (or (-> gp-0 dry-run) (< (-> gp-0 ypos) 416.0)))
          (+! (-> gp-0 string-count) 1)
          (when (-> gp-0 copy-test)
            (set! (-> (the-as string arg5) data (-> gp-0 dest-count)) s2-1)
            (+! (-> gp-0 dest-count) 1)
            )
          (cond
            ((and (nonzero? s2-1) (!= s2-1 32) (!= s2-1 92))
             (set! (-> *game-text-word* data (-> gp-0 word-count)) s2-1)
             (+! (-> gp-0 word-count) 1)
             )
            (else
              (set! (-> *game-text-word* data (-> gp-0 word-count)) (the-as uint 0))

  (format #t "~1Tdry-run: ~A~%" (-> this dry-run))
  (format #t "~1Tstring-count: ~D~%" (-> this string-count))
  (format #t "~1Tdest-count: ~D~%" (-> this dest-count))
  (format #t "~1Tlast-space-count: ~D~%" (-> this last-space-count))
  (format #t "~1Tline-count: ~f~%" (-> this line-count))
  (format #t "~1Tword-count: ~D~%" (-> this word-count))
  (format #t "~1Tline-word-count: ~D~%" (-> this line-word-count))
  (format #t "~1Tret: ~f~%" (-> this ret))

                )
              (if (-> gp-0 copy-test)
                  (set! (-> gp-0 last-space-count) (+ (-> gp-0 dest-count) -1))
                  )
              (set! (-> gp-0 word-count) 0)
              (when (= s2-1 92)
                (cond
                  ((-> gp-0 copy-test)

;; definition for function print-game-text
(defun print-game-text ((arg0 string) (arg1 font-context) (arg2 symbol) (arg3 int) (arg4 bucket-id) (arg5 symbol) (arg6 dma-buffer))
  (let ((gp-0 *print-game-text-work*))

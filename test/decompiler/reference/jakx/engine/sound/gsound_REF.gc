    (cond
      (v1-0
        (set! (-> v1-0 volume) -4)
        (set! (-> v1-0 auto-time) 120)
        (set! (-> v1-0 auto-from) 2)
        (logior! (-> v1-0 flags) 128)
        (logior! (-> v1-0 mask) 4)
        (-> v1-0 id)
        )
      (else
        0
        )
      )
    )
  0
  (none)
  )


;; definition for method 10 of type ambient-sound
(defmethod change-sound! ((this ambient-sound) (arg0 sound-name))
  (let ((s5-0 (sound-info-by-name (the-as string arg0))))
    (when s5-0
      (when (!= (-> this spec info) s5-0)
        (stop! this)
        (set! (-> this playing-id) (new-sound-id))
        (set! (-> this spec info) s5-0)
        )
      )
    )
  0
  )

;; definition for function show-iop-info
(defun show-iop-info ((arg0 dma-buffer))
  (dotimes (s5-0 24)
    (draw-string-xy
      (if (zero? (-> *sound-iop-info* chinfo s5-0))
          "."
          "X"
          )
      arg0
      (+ (* s5-0 16) 16)
      48
      (font-color default)
      (font-flags shadow)
      )
    )
  (dotimes (s5-1 24)
    (draw-string-xy
      (if (zero? (-> *sound-iop-info* chinfo (+ s5-1 24)))
          "."
          "X"
          )
      arg0
      (+ (* s5-1 16) 16)
      64
      (font-color default)
      (font-flags shadow)
      )
    )
  (let ((s5-2 draw-string-xy))
    (format
      (clear *temp-string*)
      "banks: ~15S ~15S ~15S"
      (-> *level* sound-bank 0 name)
      (-> *level* sound-bank 2 name)
      (-> *level* sound-bank 4 name)
      )
    (s5-2 *temp-string* arg0 16 88 (font-color default) (font-flags shadow))
    )
  (let ((s5-3 draw-string-xy))
    (format
      (clear *temp-string*)
      "       ~15S ~15S ~15S"
      (-> *level* sound-bank 1 name)
      (-> *level* sound-bank 3 name)
      (-> *level* sound-bank 5 name)
      )
    (s5-3 *temp-string* arg0 16 104 (font-color default) (font-flags shadow))
    )
  (let ((s5-4 draw-string-xy))
    (format
      (clear *temp-string*)
      "music: ~15S ~10S"
      (-> *setting-control* user-current music)
      (-> *setting-control* user-current mode-sound-bank)
      )
    (s5-4 *temp-string* arg0 16 118 (font-color default) (font-flags shadow))
    )
  0
  )

;; definition for function show-iop-memory
(defun show-iop-memory ((arg0 dma-buffer))
  (let ((s5-0 draw-string-xy))
    (format (clear *temp-string*) "total: ~8D bytes" (-> *sound-iop-info* freemem2))
    (s5-0 *temp-string* arg0 32 144 (font-color default) (font-flags shadow))
    )
  (let ((s5-1 draw-string-xy))
    (format (clear *temp-string*) "max: ~8D bytes" (-> *sound-iop-info* freemem))
    (s5-1 *temp-string* arg0 32 160 (font-color default) (font-flags shadow))
    )
  0
  )

;; definition for function ear-trans
(defun ear-trans ((arg0 int) (arg1 int))
  (cond
    ((= arg0 1)
     (get-player-pos arg1)
     )
    ((or (movie?) *external-cam-mode*)
     (math-camera-pos)
     )
    (else
      (-> (view-get-math-camera arg1) trans)
      )
    )
  )


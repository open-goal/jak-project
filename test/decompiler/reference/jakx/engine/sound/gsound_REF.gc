;; definition for method 9 of type ambient-sound
(defmethod update! ((this ambient-sound))
  (with-pp
    (let ((v1-0 #f))
      (when (and (> (-> this time-base) 0) (>= (current-time) (-> this play-time)))
        (set! (-> this play-time)
              (+ (current-time) (-> this time-base) (rand-vu-int-count (the-as int (-> this time-random))))
              )
        (set! (-> this playing-id) (new-sound-id))
        (set! v1-0 #t)
        )
      (set! v1-0 (or (< (-> this time-base) 0) v1-0))
      (when v1-0
        (let ((s5-1 (-> this spec)))
          (when (and *debug-effect-control* (>= (-> this time-base) 0))
            (format #t "(~5D) effect sound ~A ~G " (current-time) (-> pp name) (&-> s5-1 info name))
            (format
              #t
              "volume: ~f  pitch-mod: ~f~%"
              (* 0.09765625 (the float (-> s5-1 volume)))
              (* 0.000656168 (the float (-> s5-1 pitch-mod)))
              )
            )
          (when (-> s5-1 info)
            (let ((s4-0 (make-sound-instance
                          (-> *sound-info* (-> s5-1 info index))
                          (the-as int (-> this playing-id))
                          (the-as handle #f)
                          )
                        )
                  )
              (set! (-> this playing-id) (the-as sound-id (cond
                                                            (s4-0
                                                              (quad-copy! (the-as pointer s4-0) (the-as pointer s5-1) 4)
                                                              (logior! (-> s4-0 flags) 64)
                                                              (the-as int (-> s4-0 id))
                                                              )
                                                            (else
                                                              0
                                                              )
                                                            )
                                                 )
                    )
              )
            )
          )
        )
      )
    0
    )
  )


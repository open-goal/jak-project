         (set! (-> gp-0 music-pitch-mod) -15240)
         (set! *slow-mo-last-frame?* #t)
         )
        (*slow-mo-last-frame?*
          (remove-setting! 'music-volume)
          (set! *slow-mo-last-frame?* #f)
          )
        )
      )
    )
  0
  (none)
  )


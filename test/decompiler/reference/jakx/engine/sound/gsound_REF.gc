;; definition for symbol *jukebox-onoff*, type symbol
(define *jukebox-onoff* #f)

;; definition for symbol *last-music-position*, type int
(define *last-music-position* 0)

;; definition for function jukebox-onoff
;; WARN: Return type mismatch int vs none.
(defun jukebox-onoff ((arg0 symbol))
  (when (not arg0)
    (set! *last-music-position* -1)
    (set-setting *setting-control* *dproc* 'music #f 0 0)
    )
  (if arg0
      (set! *jukebox-time* (the-as int (-> *display* game-clock frame-counter)))
      )
  (set! *jukebox-onoff* arg0)
  0
  (none)
  )

;; definition for function update-jukebox-music
;; WARN: Return type mismatch int vs none.
(defun update-jukebox-music ()
  (cond
    ((and *jukebox-onoff* (not (-> *setting-control* user-current mpeg-mode?)))
     (when (< *jukebox-time* (-> *display* game-clock frame-counter))
       (set! *jukebox-time* (the-as int (+ (-> *display* game-clock frame-counter) (seconds 5))))
       (cond
         ((or (zero? (-> *sound-iop-info* music-name))
              (and (not (paused?))
                   (not *music-lock*)
                   (or (= (-> *sound-iop-info* music-position) *last-music-position*)
                       (>= (* 0.0009765625 (the float (- (-> *sound-iop-info* music-position) (the-as uint *last-music-position*))))
                           20.0
                           )
                       )
                   )
              )
          (let ((v1-23 (mod (-> *game-info* music-data-bytes 0) (the-as uint 21))))
            (cond
              ((zero? v1-23)
               (set-setting! 'music 'angle 0.0 0)
               )
              ((= v1-23 1)
               (set-setting! 'music 'ass 0.0 0)
               )
              ((= v1-23 2)
               (set-setting! 'music 'bird 0.0 0)
               )
              ((= v1-23 3)
               (set-setting! 'music 'boris 0.0 0)
               )
              ((= v1-23 4)
               (set-setting! 'music 'crisis 0.0 0)
               )
              ((= v1-23 5)
               (set-setting! 'music 'fracture 0.0 0)
               )
              ((= v1-23 6)
               (set-setting! 'music 'frozen 0.0 0)
               )
              ((= v1-23 7)
               (set-setting! 'music 'bondo 0.0 0)
               )
              ((= v1-23 8)
               (set-setting! 'music 'harsh 0.0 0)
               )
              ((= v1-23 9)
               (set-setting! 'music 'heli 0.0 0)
               )
              ((= v1-23 10)
               (set-setting! 'music 'run 0.0 0)
               )
              ((= v1-23 11)
               (set-setting! 'music 'secondi 0.0 0)
               )
              ((= v1-23 12)
               (set-setting! 'music 'silver 0.0 0)
               )
              ((= v1-23 13)
               (set-setting! 'music 'tempest 0.0 0)
               )
              ((= v1-23 14)
               (set-setting! 'music 'theater 0.0 0)
               )
              ((= v1-23 15)
               (set-setting! 'music 'touch 0.0 0)
               )
              ((= v1-23 16)
               (set-setting! 'music 'trintite 0.0 0)
               )
              ((= v1-23 17)
               (set-setting! 'music 'bondo 0.0 0)
               )
              ((= v1-23 18)
               (set-setting! 'music 'aftertch 0.0 0)
               )
              ((= v1-23 19)
               (set-setting! 'music 'flat 0.0 0)
               )
              ((= v1-23 20)
               (set-setting! 'music 'reborn 0.0 0)
               )
              )
            )
          (set! (-> *game-info* byte0) (the-as int (+ (-> *game-info* music-data-bytes 0) 1)))
          (set! *last-music-position* -1)
          )
         (else
           (set! *last-music-position* (the-as int (-> *sound-iop-info* music-position)))
           )
         )
       )
     )
    (else
      )
    )
  0
  (none)
  )





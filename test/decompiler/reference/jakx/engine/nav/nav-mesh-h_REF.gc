  (format #t "~1Tcorner-poly: #<nav-poly @ #x~X>~%" (-> this corner-poly))
  (format #t "~1Tstart-pos: #<vector @ #x~X>~%" (-> this start-pos))
  (format #t "~1Ttarget-pos: #<vector @ #x~X>~%" (-> this target-pos))

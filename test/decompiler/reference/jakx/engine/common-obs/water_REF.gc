                (if (= (-> a0-6 name) 'water)
                    (collect-regions
                      a0-6
                      (the-as sphere (-> (the-as region-prim-area #x70000000) pos))
                      0
                      (-> (the-as region-prim-area #x70000000) region-prim-list)
                      )
                    )
                (+! s3-0 1)
                (set! a0-6 (-> s5-0 s3-0))
                )

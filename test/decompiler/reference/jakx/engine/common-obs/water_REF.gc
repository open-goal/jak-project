;; definition for function water-info<-region
;; INFO: Used lq/sq
(defun water-info<-region ((arg0 water-info) (arg1 drawable-region-prim) (arg2 (inline-array sphere)) (arg3 int))
  (when (and (-> arg0 prim) (= (-> arg0 prim region) (-> arg1 region)))
    (set! arg0 arg0)
    (goto cfg-58)
    )
  (set! (-> arg0 flags) (water-flag))
  (set! (-> arg0 handle) (the-as handle #f))
  (set! (-> arg0 depth) 0.0)
  (let ((s2-0 (the-as object (-> arg1 region on-inside))))
    (set! s2-0 (cond
                 ((= (-> (the-as pair s2-0) car) 'water)
                  (empty)
                  s2-0
                  )
                 (else
                   (script-eval (the-as pair s2-0))
                   )
                 )
          )
    (when s2-0
      (set! (-> arg0 trans quad) (-> arg2 (+ arg3 -1) quad))
      (set-vector! (-> arg0 normal) 0.0 1.0 0.0 1.0)
      (case (-> (the-as pair (-> (the-as pair s2-0) cdr)) car)
        (('height)
         (set! (-> arg0 flags) (water-flag bouncing))
         (set! (-> arg0 trans y)
               (* 4096.0 (command-get-float (-> (the-as pair (-> (the-as pair (-> (the-as pair s2-0) cdr)) cdr)) car) 0.0))
               )
         (set! (-> arg0 base-height) (-> arg0 trans y))
         )
        (('ocean)
         (set! (-> arg0 flags) (water-flag can-ground bouncing))
         (set! (-> arg0 trans y) (get-height *ocean* (-> arg0 trans) #f))
         (set! (-> arg0 base-height) (get-base-height *ocean-map*))
         (when (= (-> arg0 trans y) 4095996000.0)
           (set! (-> arg0 flags) (water-flag))
           0
           )
         )
        (('water-flow)
         (let ((s1-0 (command-get-process
                       (-> (the-as pair (-> (the-as pair (-> (the-as pair s2-0) cdr)) cdr)) car)
                       (the-as process #f)
                       )
                     )
               )
           (cond
             (s1-0
               (set! (-> arg0 flags) (water-flag mud bouncing))
               (cond
                 ((send-event s1-0 'water-info arg0)
                  (set! (-> arg0 handle) (process->handle s1-0))
                  (set! (-> arg0 base-height) (-> arg0 trans y))
                  )
                 (else
                   (set! (-> arg0 flags) (water-flag))
                   0
                   )
                 )
               )
             (else
               (set! (-> arg0 flags) (water-flag))
               0
               )
             )
           )
         )
        (else
          (set! (-> arg0 flags) (water-flag))
          0
          )
        )
      (when (logtest? (water-flag bouncing) (-> arg0 flags))
        (let* ((v1-49 (-> (the-as pair (-> (the-as pair (-> (the-as pair (-> (the-as pair s2-0) cdr)) cdr)) cdr)) car))
               (a0-24 (-> (the-as pair v1-49) car))
               )
          (while (not (null? v1-49))
            (cond
              ((= a0-24 'puddle)
               (logior! (-> arg0 flags) (water-flag active))
               )
              ((= a0-24 'mud)
               (logior! (-> arg0 flags) (water-flag can-swim))
               )
              ((= a0-24 'lava)
               (logior! (-> arg0 flags) (water-flag swim-ground))
               )
              ((= a0-24 'tar)
               (logior! (-> arg0 flags) (water-flag use-ocean))
               )
              ((= a0-24 'darkeco)
               (logior! (-> arg0 flags) (water-flag deadly))
               )
              )
            (set! v1-49 (-> (the-as pair v1-49) cdr))
            (set! a0-24 (-> (the-as pair v1-49) car))
            )
          )
        (dotimes (s2-1 arg3)
          (let ((s1-1 (-> arg2 s2-1)))
            (set! (-> (the-as region-prim-area #x70000000) pos quad) (-> s1-1 quad))
            (when (and (within-area? arg1 (the-as region-prim-area (-> (the-as region-prim-area #x70000000) region-prim-list)))
                       (begin
                         (logior! (-> arg0 flags) (water-flag head-under-water))
                         (>= (-> arg0 trans y) (- (-> s1-1 y) (-> s1-1 r)))
                         )
                       )
              (set! (-> arg0 prim) arg1)
              (logior! (-> arg0 flags) (water-flag dark-eco))
              )
            )
          )
        )
      )
    )
  (label cfg-58)
  arg0
  )


;; definition for function find-water-2
(defun find-water-2 ((arg0 (inline-array sphere)) (arg1 int) (arg2 water-info) (arg3 water-info) (arg4 process-drawable))
  (set! (-> arg2 prim) #f)
  (set! (-> arg3 prim) #f)
  (countdown (s2-0 (-> (the-as region-prim-area #x70000000) region-prim-list num-items))
    (water-info<-region arg3 (-> (the-as region-prim-area #x70000000) region-prim-list items s2-0) arg0 arg1)
    (when (and (logtest? (water-flag bouncing) (-> arg3 flags)) (logtest? (-> arg3 flags) (water-flag dark-eco)))
      (mem-copy! (the-as pointer arg2) (the-as pointer arg3) 60)
      (send-event (handle->process (-> arg2 handle)) 'touch-water)
      (return arg2)
      )
    (when (and (logtest? (water-flag bouncing) (-> arg3 flags))
               (logtest? (water-flag dark-eco head-under-water) (-> arg3 flags))
               )
      (mem-copy! (the-as pointer arg2) (the-as pointer arg3) 60)
      (if (logtest? (-> arg2 flags) (water-flag dark-eco))
          (send-event (handle->process (-> arg2 handle)) 'touch-water)
          )
      )
    )
  (the-as water-info #f)
  )


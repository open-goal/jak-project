;;-*-Lisp-*-
(in-package goal)

;; definition of type driver-ximon
(deftype driver-ximon (driver)
  ()
  )

;; definition for method 3 of type driver-ximon
(defmethod inspect ((this driver-ximon))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type driver inspect)))
    (t9-0 this)
    )
  (label cfg-4)
  this
  )

;; failed to figure out what this is:
(defskelgroup skel-driver-ximon ximon 1 4
              ((2 (meters 20)) (3 (meters 999999)))
              :bounds (static-spherem 0 0 0 4)
              )

;; definition for method 62 of type driver-ximon
;; WARN: Return type mismatch int vs none.
(defmethod driver-method-62 ((this driver-ximon))
  (set! (-> this info skel) (art-group-get-by-name *level* "skel-driver-ximon" (the-as (pointer level) #f)))
  (set! (-> this info turn-back-anim) 6)
  (set! (-> this info turn-front-anim) 5)
  (set! (-> this info up-down-anim) 7)
  (set! (-> this stack 119) (the-as uint 8))
  (set! (-> this stack 120) (the-as uint 9))
  (set! (-> this stack 121) (the-as uint 10))
  (set! (-> this stack 122) (the-as uint -1))
  (set! (-> this info head-node) 7)
  (set! (-> this info arm0-node) 9)
  (set! (-> this info arm1-node) 12)
  (set! (-> this info arm0-dist) 2867.2)
  (set! (-> this info arm1-dist) 2867.2)
  0
  (none)
  )





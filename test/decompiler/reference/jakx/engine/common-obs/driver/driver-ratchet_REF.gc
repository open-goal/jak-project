;;-*-Lisp-*-
(in-package goal)

;; definition of type driver-ratchet
(deftype driver-ratchet (driver)
  ()
  )

;; definition for method 3 of type driver-ratchet
(defmethod inspect ((this driver-ratchet))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type driver inspect)))
    (t9-0 this)
    )
  (label cfg-4)
  this
  )

;; failed to figure out what this is:
(defskelgroup skel-driver-ratchet ratchet 1 4
              ((2 (meters 20)) (3 (meters 999999)))
              :bounds (static-spherem 0 0 0 4)
              )

;; definition for method 62 of type driver-ratchet
;; WARN: Return type mismatch int vs none.
(defmethod driver-method-62 ((this driver-ratchet))
  (set! (-> this info skel) (art-group-get-by-name *level* "skel-driver-ratchet" (the-as (pointer level) #f)))
  (set! (-> this info turn-back-anim) 6)
  (set! (-> this info turn-front-anim) 5)
  (set! (-> this info up-down-anim) 7)
  (set! (-> this info intro-anim0) 8)
  (set! (-> this info intro-anim1) 9)
  (set! (-> this info intro-anim2) 10)
  (set! (-> this info intro-anim3) -1)
  (set! (-> this info head-node) 7)
  (set! (-> this info arm0-node) 9)
  (set! (-> this info arm1-node) 17)
  (set! (-> this info arm0-dist) 2048.0)
  (set! (-> this info arm1-dist) 2048.0)
  0
  (none)
  )

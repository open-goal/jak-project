;; definition for function driver-head
;; WARN: Return type mismatch none vs object.
;; WARN: rewrite_to_get_var got a none typed variable. Is there unreachable code? [OP: 113]
(defbehavior driver-head driver ()
  (when (and (nonzero? (-> self jmod-head))
             (if *net-game-mgr*
                 (< (+ (-> *net-game-mgr* intro-end-time) 1500) (- (- (if *net-mgr*
                                                                          (-> *net-mgr* game-state time)
                                                                          0
                                                                          )
                                                                      (if *net-world*
                                                                          (-> *net-world* net-state game-start-time)
                                                                          0
                                                                          )
                                                                      )
                                                                   (if *net-world*
                                                                       (-> *net-world* net-state total-pause-time)
                                                                       0
                                                                       )
                                                                   )
                    )
                 )
             )
    (when (< (-> self looking-at-timeout) (- (- (if *net-mgr*
                                                    (-> *net-mgr* game-state time)
                                                    0
                                                    )
                                                (if *net-world*
                                                    (-> *net-world* net-state game-start-time)
                                                    0
                                                    )
                                                )
                                             (if *net-world*
                                                 (-> *net-world* net-state total-pause-time)
                                                 0
                                                 )
                                             )
             )
      (let ((gp-0 (find-nearest-enemy-vehicle self)))
        (cond
          (gp-0
            (mode-set! (-> self jmod-head) (joint-mod-mode look-at))
            (set! (-> self looking-at) (process->handle gp-0))
            )
          (else
            (set! (-> self looking-at) (the-as handle #f))
            )
          )
        )
      (+! (-> self looking-at-timeout) 300)
      )
    (let ((a0-19 (as-type (the-as process-focusable (handle->process (-> self looking-at))) process-focusable)))
      (cond
        (a0-19
          (let ((a1-16 (get-trans a0-19 2)))
            (target-set! (-> self jmod-head) a1-16)
            )
          )
        (else
          (set! (-> self jmod-head shutting-down?) #t)
          (set! (-> self looking-at) (the-as handle #f))
          #f
          )
        )
      )
    )
  )

;; definition for function driver-anim

;; definition of type helmet
(deftype helmet (structure)
  ((node-list   cspace-array)
   (draw        draw-control)
   (node-index  int8)
   (scale       float)
   )
  :pack-me
  (:methods
    (init! (_type_ process-drawable skeleton-group int) none)
    (copy-lights-and-scale (_type_ process-drawable float) none)
    (helmet-method-11 (_type_ process-drawable) none)
    )
  )

;; definition for method 3 of type helmet
(defmethod inspect ((this helmet))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'helmet)
  (format #t "~1Tnode-list: ~A~%" (-> this node-list))
  (format #t "~1Tdraw: ~A~%" (-> this draw))
  (format #t "~1Tnode-index: ~D~%" (-> this node-index))
  (format #t "~1Tscale: ~f~%" (-> this scale))
  (label cfg-4)
  this
  )


          (set! (-> self draw lod-set lod 1 dist) 122880.0)
          )
        (logior! (-> self skel status) (joint-control-status eye-anim))
        (logclear! (-> self mask) (process-mask actor-pause))
        (set-time! (-> self speech-time))
        (set! (-> self vehicle) (process->handle gp-0))
        (cond
          ((> (-> s5-0 head-node) 0)
           (set! (-> self jmod-head) (new 'process 'joint-mod-head (joint-mod-mode flex-blend) self (-> s5-0 head-node)))
           (set-vector! (-> self jmod-head twist-max) 12743.111 12743.111 0.0 1.0)
           (set! (-> self jmod-head up) (the-as uint 1))
           (set! (-> self jmod-head nose) (the-as uint 2))
           (set! (-> self jmod-head ear) (the-as uint 0))
           (set! (-> self jmod-head twist-speed-x) 0.2)
           (set! (-> self jmod-head twist-speed-y) 0.2)
           (set! (-> self jmod-head max-dist) 389120.0)
           (set! (-> self jmod-head ignore-angle) 32768.0)
           (let ((a2-2 (the-as art-group #f)))
             (case (-> *car-level-array* data (+ (-> gp-0 level slot) -6) current-parts 10)
               ((1)
                (set! a2-2 (art-group-get-by-name *level* "skel-helmet-a" (the-as (pointer level) #f)))
                )
               ((2)
                (set! a2-2 (art-group-get-by-name *level* "skel-helmet-b" (the-as (pointer level) #f)))
                )
               ((3)
                (set! a2-2 (art-group-get-by-name *level* "skel-helmet-c" (the-as (pointer level) #f)))
                )
               ((4)
                (set! a2-2 (art-group-get-by-name *level* "skel-helmet-d" (the-as (pointer level) #f)))
                )
               ((5)
                (set! a2-2 (art-group-get-by-name *level* "skel-helmet-e" (the-as (pointer level) #f)))
                )
               ((6)
                (set! a2-2 (art-group-get-by-name *level* "skel-helmet-f" (the-as (pointer level) #f)))
                )
               )
             (when a2-2
               (let ((a0-42 (-> self helmet))
                     (t9-12 (method-of-type helmet init!))
                     (a1-10 self)
                     (a3-1 (-> s5-0 head-node))
                     )
                 (-> gp-0 level)
                 (t9-12 a0-42 a1-10 (the-as skeleton-group a2-2) a3-1)
                 )
               (copy-lights-and-scale (-> self helmet) self (-> *net-drivers* (-> arg0 driver-type) helmet-scale))
               (mode-set! (-> self jmod-head) (joint-mod-mode reset))

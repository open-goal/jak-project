;; failed to figure out what this is:
(defstate idle (driver)
  :virtual #t
  :event driver-event-handler
  :trans (behavior ()
    (driver-trans)
    (driver-head)
    )
  :code (behavior ()
    (ja-channel-push! 3 (seconds 0.5))
    (ja :group! (-> self draw art-group data (-> self turn-back-anim)))
    (ja :chan 1 :group! (-> self draw art-group data (-> self turn-front-anim)))
    (ja :chan 2 :group! (-> self draw art-group data (-> self up-down-anim)))
    (until #f
      (driver-anim)
      (suspend)
      )
    #f
    )
  :post driver-post
  )

;; failed to figure out what this is:
(defstate intro (driver)
  :virtual #t
  :event driver-event-handler
  :enter (behavior ()
    (if (nonzero? (-> self info arm0-node))
        (enable-set! (-> self arm-ik 0) #f)
        )
    (if (nonzero? (-> self info arm1-node))
        (enable-set! (-> self arm-ik 1) #f)
        )
    )
  :exit (behavior ()
    (if (nonzero? (-> self info arm0-node))
        (enable-set! (-> self arm-ik 0) #t)
        )
    (if (nonzero? (-> self info arm1-node))
        (enable-set! (-> self arm-ik 1) #t)
        )
    )
  :code (behavior ()
    (ja-channel-push! 1 (seconds 0.2))
    (let ((gp-0 -1))
      (while (or (= -1 gp-0) (= -1 (-> self intro-anim gp-0)))
        (set! gp-0 (the-as int (logand (rand-uint31-gen *random-generator*) 3)))
        )
      (cond
        ((type? self driver-razer)
         (ja-no-eval :group! (-> self draw art-group data (-> self intro-anim gp-0)) :num! (seek!) :frame-num 0.0)
         (until (ja-done? 0)
           (suspend)
           (ja :num! (seek!))
           )
         )
        (else
          (ja-no-eval :group! (-> self draw art-group data (-> self intro-anim gp-0))
                      :num! (seek! max 0.25)
                      :frame-num 0.0
                      )
          (until (ja-done? 0)
            (suspend)
            (ja :num! (seek! max 0.25))
            )
          )
        )
      )
    (go-virtual idle)
    )
  :post driver-post
  )

;; failed to figure out what this is:
(defstate die (driver)
  :virtual #t
  :code (behavior ()
    '()
    )
  )


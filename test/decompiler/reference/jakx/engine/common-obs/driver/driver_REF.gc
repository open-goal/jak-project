        (set! (-> self arm-ik 1 elbow-rotation-axis) 0)
        (logior! (-> self arm-ik 1 flags) (joint-mod-ik-flags elbow-rot-neg))
        )
      self
      (vehicle-method-106 gp-0 0)
      )
    )
  (logior! (-> self focus-status) (focus-status pilot-riding))
  (driver-method-64 self)
  (go-virtual idle)
  )


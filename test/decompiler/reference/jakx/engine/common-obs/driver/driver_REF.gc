    )
  (format #t "[~8x] ~A~%" this (-> this type))
  (format #t "~1Tmode: ~D~%" (-> this mode))
  (format #t "~1Tprocess: ~A~%" (-> this process))
  (format #t "~1Tjoint: #<cspace @ #x~X>~%" (-> this joint))
  (format #t "~1Ttarget: ~`vector`P~%" (-> this target))
  (format #t "~1Ttwist: ~`vector`P~%" (-> this twist))
  (format #t "~1Ttwist-max: ~`vector`P~%" (-> this twist-max))
  (format #t "~1Textra-twist: (deg ~r)~%" (-> this twist z))
  (format #t "~1Ttrack-mode: #x~X : (track-mode " (-> this track-mode))
  (let ((s5-0 (-> this track-mode)))
    (if (= (logand s5-0 (track-mode track-on)) (track-mode track-on))
        (format #t "track-on ")
        )
    (if (= (logand s5-0 (track-mode no-rotate)) (track-mode no-rotate))
        (format #t "no-rotate ")
        )
    (if (= (logand s5-0 (track-mode lock-on)) (track-mode lock-on))
        (format #t "lock-on ")
        )
    (if (= (logand s5-0 (track-mode no-scale)) (track-mode no-scale))
        (format #t "no-scale ")
        )
    (if (= (logand s5-0 (track-mode track-x)) (track-mode track-x))
        (format #t "track-x ")
        )
    (if (= (logand s5-0 (track-mode track-y)) (track-mode track-y))
        (format #t "track-y ")
        )
    (if (= (logand s5-0 (track-mode no-trans)) (track-mode no-trans))
        (format #t "no-trans ")
        )
    )
  (format #t ")~%")
  (format #t "~1Tlook-at-count: ~D~%" (-> this look-at-count))
  (format #t "~1Ttwist-range-x: (meters ~m)~%" (-> this twist-max z))
  (format #t "~1Ttwist-range-y: (meters ~m)~%" (-> this twist-max w))
  (format #t "~1Ttwist-speed-x: ~f~%" (-> this twist-speed-x))
  (format #t "~1Ttwist-speed-y: ~f~%" (-> this twist-speed-y))
  (format #t "~1Ttrans: ~`vector`P~%" (-> this trans))
  (format #t "~1Tsmushy-old: ~f~%" (-> this trans x))
  (format #t "~1Tsmushy-off: ~f~%" (-> this trans y))
  (format #t "~1Tsmushyv: ~f~%" (-> this trans z))
  (format #t "~1Tquat: ~`quaternion`P~%" (-> this quat))
  (format #t "~1Tscale: ~`vector`P~%" (-> this scale))
  (format #t "~1Tnotice-time: ~D~%" (-> this notice-time))
  (format #t "~1Tflex-blend: ~f~%" (-> this flex-blend))
  (format #t "~1Tblend: ~f~%" (-> this blend))
  (format #t "~1Told-blend: ~f~%" (-> this old-blend))
  (format #t "~1Tmax-dist: (meters ~m)~%" (-> this max-dist))
  (format #t "~1Tignore-angle: (deg ~r)~%" (-> this ignore-angle))
  (format #t "~1Tup: ~D~%" (-> this up))
  (format #t "~1Tnose: ~D~%" (-> this nose))
  (format #t "~1Tear: ~D~%" (-> this ear))
  (format #t "~1Tbase-joint: ~D~%" (-> this base-joint))
  (format #t "~1Tbase-nose: ~D~%" (-> this base-nose))
  (format #t "~1Tshutting-down?: ~A~%" (-> this shutting-down?))
  (format #t "~1Tparented-scale?: ~A~%" (-> this parented-scale?))
  (label cfg-18)
  this
  )

;; definition of type driver
(deftype driver (process-focusable)
  ((info                driver-info   :inline)
   (vehicle             handle)
   (speech-time         time-frame)
   (anim-vel            vector        :inline)
   (anim-pos            vector        :inline)
   (turn-back-anim      int8)
   (turn-front-anim     int8)
   (up-down-anim        int8)
   (intro-anim          int8          4)
   (jmod-head           joint-mod-head)
   (arm-ik              joint-mod-ik  2)
   (looking-at          handle)
   (looking-at-timeout  int32)
   (helmet              helmet        :inline)
   )
  (:state-methods
    idle
    intro
    die
    )
  (:methods
    (driver-method-62 (_type_) none)
    (init-collision (_type_) none)
    (driver-method-64 (_type_) none)
    (driver-method-65 (_type_ int int) none)
    (find-nearest-enemy-vehicle (_type_) process-focusable)
    )
  )

;; definition for method 3 of type driver
(defmethod inspect ((this driver))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type process-focusable inspect)))
    (t9-0 this)
    )
  (format #t "~2Tinfo: #<driver-info @ #x~X>~%" (-> this info))
  (format #t "~2Tvehicle: ~D~%" (-> this vehicle))
  (format #t "~2Tspeech-time: ~D~%" (-> this speech-time))
  (format #t "~2Tanim-vel: #<vector @ #x~X>~%" (-> this anim-vel))
  (format #t "~2Tanim-pos: #<vector @ #x~X>~%" (-> this anim-pos))
  (format #t "~2Tturn-back-anim: ~D~%" (-> this turn-back-anim))
  (format #t "~2Tturn-front-anim: ~D~%" (-> this turn-front-anim))
  (format #t "~2Tup-down-anim: ~D~%" (-> this up-down-anim))
  (format #t "~2Tintro-anim[4] @ #x~X~%" (-> this intro-anim))
  (format #t "~2Tjmod-head: ~A~%" (-> this jmod-head))
  (format #t "~2Tarm-ik[2] @ #x~X~%" (-> this arm-ik))
  (format #t "~2Tlooking-at: ~D~%" (-> this looking-at))
  (format #t "~2Tlooking-at-timeout: ~D~%" (-> this looking-at-timeout))
  (format #t "~2Thelmet: #<helmet @ #x~X>~%" (-> this helmet))
  (label cfg-4)
  this
  )

;; definition for method 7 of type driver
(defmethod relocate ((this driver) (offset int))
  (when (nonzero? (-> this arm-ik 0))
    (relocate (-> this arm-ik 0) offset)
    (if (nonzero? (-> this arm-ik 0))
        (&+! (-> this arm-ik 0) offset)
        )
    )
  (when (nonzero? (-> this arm-ik 1))
    (relocate (-> this arm-ik 1) offset)
    (if (nonzero? (-> this arm-ik 1))
        (&+! (-> this arm-ik 1) offset)
        )
    )
  (when (nonzero? (-> this jmod-head))
    (if (nonzero? (-> this jmod-head))
        (&+! (-> this jmod-head) offset)
        )
    )
  (relocate (-> this helmet) offset)
  (call-parent-method this offset)
  )

;; definition for method 65 of type driver
;; WARN: Return type mismatch int vs none.
(defmethod driver-method-65 ((this driver) (arg0 int) (arg1 int))
  (set! (-> this draw status) (logclear (logior (-> this draw status) arg0) arg1))
  (let ((v1-4 (-> this helmet draw)))
    (if (nonzero? v1-4)
        (set! (-> v1-4 status) (logclear (logior (-> v1-4 status) arg0) arg1))
        )
    )
  0
  (none)
  )

;; definition for function joint-mod-head-handler
(defun joint-mod-head-handler ((arg0 cspace) (arg1 transformq))
  (let ((gp-0 (the-as joint-mod-head (-> arg0 param1))))
    (case (-> gp-0 mode)
      (((joint-mod-mode look-at))
       (joint-mod-look-at-handler arg0 arg1)
       )
      (else
        (cspace<-parented-transformq-joint! arg0 arg1)
        )
      )
    (let ((a1-1 (the-as driver (-> gp-0 process))))
      (helmet-method-11 (-> a1-1 helmet) a1-1)
      )
    )
  (none)
  )

;; definition for method 9 of type joint-mod-head
(defmethod mode-set! ((this joint-mod-head) (arg0 joint-mod-mode))
  "Set the type of joint-mod and install the right callback."
  (cond
    ((nonzero? (-> (the-as driver (-> this process)) helmet draw))
     (let ((a0-1 (-> this joint)))
       (set! (-> a0-1 param0) joint-mod-head-handler)
       (set! (-> a0-1 param1) this)
       )
     )
    (else
      (call-parent-method this arg0)
      )
    )
  this
  )


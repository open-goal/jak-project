             (!= -1 (-> self intro-anim 1))
             (!= -1 (-> self intro-anim 2))
             (!= -1 (-> self intro-anim 3))
             )
         (go-virtual intro)
         )
     )
    (('attack-invinc)
     (go-virtual die)
     )
    (('vehicle-crash)
     (go-virtual die)
     )
    (('set)
     (case (-> arg3 param 0)
       (('force-lod)
        (set! v0-0 (-> arg3 param 1))
        (set! (-> self draw lod-set lod 1 dist) (if (zero? (the-as uint v0-0))
                                                    819200.0
                                                    122880.0
                                                    )
              )
        (set! (-> self draw force-lod) (the-as int v0-0))
        v0-0
        )
       )
     )

;; definition for function driver-trans
;; INFO: Used lq/sq
(defbehavior driver-trans driver ()
  (rlet ((vf0 :class vf))
    (init-vf0-vector)
    (let ((gp-0 (new 'stack-no-clear 'inline-array 'matrix 3))
          (s5-0 (the-as vehicle (handle->process (-> self vehicle))))

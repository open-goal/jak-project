         (set! (-> gp-0 1 fvec quad) (-> (the-as vehicle s5-0) lin-acceleration quad))
         (set! (-> gp-0 1 uvec x) (/ (-> (the-as vehicle s5-0) controls steering) 2))
         (set! (-> gp-0 1 uvec y) 0.0)
         (set! (-> gp-0 1 uvec z) (/ (-> (the-as vehicle s5-0) controls lean-z) 2))
         (matrix-copy! (-> gp-0 0) (-> (the-as vehicle s5-0) rbody matrix))
         (matrix-transpose! (-> gp-0 0) (-> gp-0 0))
         (.svf (&-> (-> gp-0 1) rvec quad) vf0)
         (vector-! (-> gp-0 1 trans) (-> gp-0 1 uvec) (-> self anim-pos))
         (vector-float*! (-> gp-0 1 rvec) (-> gp-0 1 trans) 64.0)
         (vector+float*! (-> gp-0 1 rvec) (-> gp-0 1 rvec) (-> self anim-vel) -6.0)
         (vector-rotate*! (-> gp-0 1 trans) (-> gp-0 1 fvec) (-> gp-0 0))
         (set! (-> gp-0 1 trans y) (* 0.4 (-> gp-0 1 trans y)))
         (set! (-> gp-0 1 trans x) (/ (-> gp-0 1 trans x) 4))
         (vector+float*! (-> gp-0 1 rvec) (-> gp-0 1 rvec) (-> gp-0 1 trans) -0.00024414062)
         (set! (-> gp-0 2 fvec y) (seconds-per-frame))
         (vector+float*! (-> self anim-vel) (-> self anim-vel) (-> gp-0 1 rvec) (-> gp-0 2 fvec y))
         (vector+float*! (-> self anim-pos) (-> self anim-pos) (-> self anim-vel) (-> gp-0 2 fvec y))
         (dotimes (v1-24 3)
           (when (< (-> self anim-pos data v1-24) -1.0)
             (set! (-> self anim-pos data v1-24) -1.0)
             (set! (-> self anim-vel data v1-24) 0.0)
             )

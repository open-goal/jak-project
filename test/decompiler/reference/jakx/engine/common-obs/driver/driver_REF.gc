             (set! (-> self anim-pos data v1-24) 1.0)
             (set! (-> self anim-vel data v1-24) 0.0)
             )
           )
         (dotimes (s4-0 2)
           (when (nonzero? (-> self arm-ik s4-0))
             (vehicle-method-149 (the-as vehicle s5-0) (-> gp-0 2 rvec) s4-0)
             (enable-set! (-> self arm-ik s4-0) #t)
             (set-ik-target! (-> self arm-ik s4-0) (-> gp-0 2 rvec))
             )
           )
         0
         )
        (else

;;-*-Lisp-*-
(in-package goal)

;; definition for symbol *ghost-info-ptr*, type pointer
(define *ghost-info-ptr* (the-as pointer #f))

;; definition for function net-play-mode-race?
(defun net-play-mode-race? ((arg0 net-play-mode))
  (or (= arg0 (net-play-mode race))
      (= arg0 (net-play-mode deathrace))
      (= arg0 (net-play-mode timebox))
      (= arg0 (net-play-mode timetrial))
      (= arg0 (net-play-mode football))
      (= arg0 (net-play-mode rushhour))
      (= arg0 (net-play-mode boss-battle))
      )
  )

;; definition for function get-task-node-id-from-location-and-event
(defun get-task-node-id-from-location-and-event ((arg0 task-level) (arg1 net-play-mode))
  (dotimes (s4-0 (length (-> *game-info* sub-task-list)))
    (let ((v1-2 (-> *game-info* sub-task-list s4-0)))
      (if (and (= (-> *game-info* play-list (-> v1-2 task) task-level) arg0) (= (-> v1-2 net-play-mode) arg1))
          (return s4-0)
          )
      )
    )
  -1
  )

;; definition of type vehicle-load-parts
(deftype vehicle-load-parts (uint64)
  ((bit0 uint8 :offset   0 :size   3)
   (bit1 uint8 :offset   3 :size   3)
   (bit2 uint8 :offset   6 :size   3)
   (bit3 uint8 :offset   9 :size   3)
   (bit4 uint8 :offset  12 :size   3)
   (bit5 uint8 :offset  15 :size   3)
   (bit6 uint8 :offset  18 :size   3)
   (bit7 uint8 :offset  21 :size   3)
   (bit8 uint8 :offset  24 :size   5)
   )
  )

;; definition for symbol *default-vehicle-load-parts*, type int
(define *default-vehicle-load-parts* #x1249249)

;; definition for method 3 of type vehicle-load-parts
;; WARN: Return type mismatch object vs vehicle-load-parts.
(defmethod inspect ((this vehicle-load-parts))
  (format #t "~d ~d ~d ~d ~d " (-> this bit0) (-> this bit1) (-> this bit2) (-> this bit3) (-> this bit4))
  (the-as
    vehicle-load-parts
    (format #t "~d ~d ~d ~d~%" (-> this bit5) (-> this bit6) (-> this bit7) (-> this bit8))
    )
  )

;; definition of type net-world-game-options
(deftype net-world-game-options (structure)
  ((advanced-options  game-task-advanced-options  :inline)
   )
  )

;; definition for method 3 of type net-world-game-options
(defmethod inspect ((this net-world-game-options))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'net-world-game-options)
  (format #t "~1Tadvanced-options: #<game-task-advanced-options @ #x~X>~%" (-> this advanced-options))
  (label cfg-4)
  this
  )


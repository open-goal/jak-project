;; definition of type net-vehicle
(deftype net-vehicle (structure)
  ((id          uint32)
   (name        symbol)
   (levname     symbol)
   (vt          vehicle-type-u8)
   (ct          car-type)
   (tex-name    string)
   (sound-bank  symbol)
   (index       net-vehicle-type)
   (cup-mask    uint32)
   (id-variant  uint32)
   (ai-levels   (array prebuilt-ai-vehicle))
   )
  )

;; definition for method 3 of type net-vehicle
(defmethod inspect ((this net-vehicle))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'net-vehicle)
  (format #t "~1Tid: ~D~%" (-> this id))
  (format #t "~1Tname: ~A~%" (-> this name))
  (format #t "~1Tlevname: ~A~%" (-> this levname))
  (format #t "~1Tvt: ~D~%" (-> this vt))
  (format #t "~1Tct: ~D~%" (-> this ct))
  (format #t "~1Ttex-name: ~A~%" (-> this tex-name))
  (format #t "~1Tsound-bank: ~A~%" (-> this sound-bank))
  (format #t "~1Tindex: ~D~%" (-> this index))
  (format #t "~1Tcup-mask: ~D~%" (-> this cup-mask))
  (format #t "~1Tid-variant: ~D~%" (-> this id-variant))
  (format #t "~1Tai-levels: ~A~%" (-> this ai-levels))
  (label cfg-4)
  this
  )


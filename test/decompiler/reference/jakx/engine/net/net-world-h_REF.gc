;; definition for function find-vehicle-info
(defun find-vehicle-info ((arg0 symbol))
  (let* ((v1-1 (-> *net-vehicles* length))
         (a1-0 0)
         (a2-2 (-> *net-vehicles* a1-0))
         )
    (while (< a1-0 v1-1)
      (if (= (-> a2-2 vt) arg0)
          (return a2-2)
          )
      (+! a1-0 1)
      (set! a2-2 (-> *net-vehicles* a1-0))
      )
    )
  (the-as net-vehicle #f)
  )

;; definition for function find-prebuilt-ai-vehicle
(defun find-prebuilt-ai-vehicle ((arg0 symbol))
  (let* ((v1-1 (-> *prebuilt-ai-vehicles* length))
         (a1-0 0)
         (a2-2 (-> *prebuilt-ai-vehicles* a1-0))
         )
    (while (< a1-0 v1-1)
      (if (= (-> a2-2 levname) arg0)
          (return a2-2)
          )
      (+! a1-0 1)
      (set! a2-2 (-> *prebuilt-ai-vehicles* a1-0))
      )
    )
  (the-as prebuilt-ai-vehicle #f)
  )

;; failed to figure out what this is:
(let* ((v1-27 (-> *net-vehicles* length))
       (a0-25 0)
       (a1-24 (-> *net-vehicles* a0-25))
       )
  (while (< a0-25 v1-27)
    (set! (-> a1-24 ai-levels length) 0)
    (+! a0-25 1)
    (set! a1-24 (-> *net-vehicles* a0-25))
    )
  )

;; failed to figure out what this is:
(let* ((gp-0 (-> *prebuilt-ai-vehicles* length))
       (s5-0 0)
       (s3-0 (-> *prebuilt-ai-vehicles* s5-0))
       )
  (while (< s5-0 gp-0)
    (let ((s4-0 (find-vehicle-info (the-as symbol (-> s3-0 v-type)))))
      (when (not s4-0)
        (break!)
        0
        )
      (set! (-> s4-0 ai-levels (length (-> s4-0 ai-levels))) (the-as prebuilt-ai-vehicle (-> s3-0 levname)))
      (+! (-> s4-0 ai-levels length) 1)
      )
    (+! s5-0 1)
    (set! s3-0 (-> *prebuilt-ai-vehicles* s5-0))
    )
  )

;; definition of type net-driver
(deftype net-driver (structure)
  ((id             uint32)
   (levname        symbol)
   (dt             driver-type)
   (tex-name       string)
   (picture-part1  uint32)
   (picture-part2  uint32)
   (icon-part1     uint32)
   (icon-part2     uint32)
   (base-color     uint32)
   (stripe-color   uint32)
   (ai-car-levels  (array symbol))
   (driver-name    string)
   (sex            int8)
   (height         int8)
   (weight         int16)
   (eyes           basic)
   (age            int8)
   (helmet-scale   float)
   (no-ai          symbol)
   )
  )

;; definition for method 3 of type net-driver
(defmethod inspect ((this net-driver))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'net-driver)
  (format #t "~1Tid: ~D~%" (-> this id))
  (format #t "~1Tlevname: ~A~%" (-> this levname))
  (format #t "~1Tdt: ~D~%" (-> this dt))
  (format #t "~1Ttex-name: ~A~%" (-> this tex-name))
  (format #t "~1Tpicture-part1: ~D~%" (-> this picture-part1))
  (format #t "~1Tpicture-part2: ~D~%" (-> this picture-part2))
  (format #t "~1Ticon-part1: ~D~%" (-> this icon-part1))
  (format #t "~1Ticon-part2: ~D~%" (-> this icon-part2))
  (format #t "~1Tbase-color: ~D~%" (-> this base-color))
  (format #t "~1Tstripe-color: ~D~%" (-> this stripe-color))
  (format #t "~1Tai-car-levels: ~A~%" (-> this ai-car-levels))
  (format #t "~1Tdriver-name: ~A~%" (-> this driver-name))
  (format #t "~1Tsex: ~D~%" (-> this sex))
  (format #t "~1Theight: ~D~%" (-> this height))
  (format #t "~1Tweight: ~D~%" (-> this weight))
  (format #t "~1Teyes: ~A~%" (-> this eyes))
  (format #t "~1Tage: ~D~%" (-> this age))
  (format #t "~1Thelmet-scale: ~f~%" (-> this helmet-scale))
  (format #t "~1Tno-ai: ~A~%" (-> this no-ai))
  (label cfg-4)
  this
  )


;; definition for function encode-green-room-stats
;; WARN: Return type mismatch none vs object.
(defun encode-green-room-stats ((arg0 green-room-stats) (arg1 mem-buffer))
  (write-int32 arg1 (-> arg0 intro-end-time))
  (write-int32 arg1 (-> arg0 scheduled-finish-time))
  (write-bytes arg1 (-> arg0 scores) 12)
  (write-bytes arg1 (-> arg0 laps) 6)
  )

;; definition for function decode-green-room-stats
;; WARN: Return type mismatch none vs object.
(defun decode-green-room-stats ((arg0 green-room-stats) (arg1 mem-buffer))
  (set! (-> arg0 intro-end-time) (read-int32 arg1))
  (set! (-> arg0 scheduled-finish-time) (read-int32 arg1))
  (read-bytes arg1 (-> arg0 scores) 12)
  (read-bytes arg1 (-> arg0 laps) 6)
  )

;; definition of type net-world-state
(deftype net-world-state (structure)
  ((players             net-world-staging-player  24 :inline)
   (assigned-drivers    uint8                     24)
   (game-creator-ip     uint32)
   (game-creation-time  uint32)
   (game-start-time     int32)
   (total-pause-time    int32)
   (task-node-name      uint8                     32)
   (player-ready-flags  uint8)
   (flags               int8)
   (max-humans          int8)
   (buddy-slots         int8)
   (clan-slots          int8)
   (ai-slots            int8)
   (vehicle-class       int8)
   (options             net-world-game-options    :inline)
   (clan-ids            uint32                    2)
   (green-room-stats    green-room-stats          :inline)
   (time-of-day         int8)
   )
  )

;; definition for method 3 of type net-world-state
(defmethod inspect ((this net-world-state))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'net-world-state)
  (format #t "~1Tplayers[24] @ #x~X~%" (-> this players))
  (format #t "~1Tassigned-drivers[24] @ #x~X~%" (-> this assigned-drivers))
  (format #t "~1Tgame-creator-ip: ~D~%" (-> this game-creator-ip))
  (format #t "~1Tgame-creation-time: ~D~%" (-> this game-creation-time))
  (format #t "~1Tgame-start-time: ~D~%" (-> this game-start-time))
  (format #t "~1Ttotal-pause-time: ~D~%" (-> this total-pause-time))
  (format #t "~1Ttask-node-name[32] @ #x~X~%" (-> this task-node-name))
  (format #t "~1Tplayer-ready-flags: ~D~%" (-> this player-ready-flags))
  (format #t "~1Tflags: ~D~%" (-> this flags))
  (format #t "~1Tmax-humans: ~D~%" (-> this max-humans))
  (format #t "~1Tbuddy-slots: ~D~%" (-> this buddy-slots))
  (format #t "~1Tclan-slots: ~D~%" (-> this clan-slots))
  (format #t "~1Tai-slots: ~D~%" (-> this ai-slots))
  (format #t "~1Tvehicle-class: ~D~%" (-> this vehicle-class))
  (format #t "~1Toptions: #<net-world-game-options @ #x~X>~%" (-> this options))
  (format #t "~1Tclan-ids[2] @ #x~X~%" (-> this clan-ids))
  (format #t "~1Tgreen-room-stats: #<green-room-stats @ #x~X>~%" (-> this green-room-stats))
  (format #t "~1Ttime-of-day: ~D~%" (-> this time-of-day))
  (label cfg-4)
  this
  )

;; definition for function encode-net-world-state
;; WARN: Return type mismatch none vs object.
(defun encode-net-world-state ((arg0 net-world-state) (arg1 mem-buffer))
  (write-bytes arg1 (-> arg0 assigned-drivers) 24)
  (write-uint32 arg1 (-> arg0 game-creator-ip))
  (write-uint32 arg1 (-> arg0 game-creation-time))
  (write-int32 arg1 (-> arg0 game-start-time))
  (write-int32 arg1 (-> arg0 total-pause-time))
  (write-bytes arg1 (-> arg0 task-node-name) 32)
  (write-uint8 arg1 (-> arg0 player-ready-flags))
  (write-int8 arg1 (-> arg0 flags))
  (write-int8 arg1 (-> arg0 max-humans))
  (write-int8 arg1 (-> arg0 buddy-slots))
  (write-int8 arg1 (-> arg0 clan-slots))
  (write-int8 arg1 (-> arg0 ai-slots))
  (write-int8 arg1 (-> arg0 vehicle-class))
  (write-bytes arg1 (the-as pointer (-> arg0 options)) 8)
  (write-bytes arg1 (-> arg0 clan-ids) 8)
  (write-bytes arg1 (the-as pointer (-> arg0 green-room-stats)) 26)
  (write-int8 arg1 (-> arg0 time-of-day))
  )

;; definition for function decode-net-world-state
;; WARN: Return type mismatch int vs object.
(defun decode-net-world-state ((arg0 net-world-state) (arg1 mem-buffer))
  (read-bytes arg1 (-> arg0 assigned-drivers) 24)
  (set! (-> arg0 game-creator-ip) (read-uint32 arg1))
  (set! (-> arg0 game-creation-time) (read-uint32 arg1))
  (set! (-> arg0 game-start-time) (read-int32 arg1))
  (set! (-> arg0 total-pause-time) (read-int32 arg1))
  (read-bytes arg1 (-> arg0 task-node-name) 32)
  (set! (-> arg0 player-ready-flags) (read-uint8 arg1))
  (set! (-> arg0 flags) (read-int8 arg1))
  (set! (-> arg0 max-humans) (read-int8 arg1))
  (set! (-> arg0 buddy-slots) (read-int8 arg1))
  (set! (-> arg0 clan-slots) (read-int8 arg1))
  (set! (-> arg0 ai-slots) (read-int8 arg1))
  (set! (-> arg0 vehicle-class) (read-int8 arg1))
  (read-bytes arg1 (the-as pointer (-> arg0 options)) 8)
  (read-bytes arg1 (-> arg0 clan-ids) 8)
  (read-bytes arg1 (the-as pointer (-> arg0 green-room-stats)) 26)
  (let ((v0-16 (read-int8 arg1)))
    (set! (-> arg0 time-of-day) v0-16)
    v0-16
    )
  )


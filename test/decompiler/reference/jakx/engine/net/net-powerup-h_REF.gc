;;-*-Lisp-*-
(in-package goal)

;; definition for symbol *powerup-static-hash*, type spatial-hash
(define *powerup-static-hash* (new 'global 'spatial-hash 8192 512))

;; definition for symbol *powerup-dynamic-hash*, type spatial-hash
(define *powerup-dynamic-hash* (new 'global 'spatial-hash 4096 64))

;; definition of type net-powerup-motion-info
(deftype net-powerup-motion-info (basic)
  ((motion-hook      (function net-powerup-motion-info net-powerup object))
   (flight-end-time  int32)
   (vel              vector  :inline)
   (rest-pos         vector  :inline)
   )
  (:methods
    (setup-parabola! (_type_ vector vector time-frame) none)
    (eval-position (_type_ int vector) none)
    (write-to-buffer (_type_ mem-buffer) none)
    (read-from-buffer (_type_ mem-buffer) none)
    )
  )

;; definition for method 3 of type net-powerup-motion-info
(defmethod inspect ((this net-powerup-motion-info))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this (-> this type))
  (format #t "~1Tmotion-hook: ~A~%" (-> this motion-hook))
  (format #t "~1Tflight-end-time: ~D~%" (-> this flight-end-time))
  (format #t "~1Tvel: #<vector @ #x~X>~%" (-> this vel))
  (format #t "~1Trest-pos: #<vector @ #x~X>~%" (-> this rest-pos))
  (label cfg-4)
  this
  )

;; definition of type net-powerup-spawn-params
(deftype net-powerup-spawn-params (structure)
  ((tp             type)
   (pos            vector  :inline)
   (lifetime       int32)
   (initial-owner  int8)
   (motion-info    net-powerup-motion-info)
   )
  )

;; definition for method 3 of type net-powerup-spawn-params
(defmethod inspect ((this net-powerup-spawn-params))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'net-powerup-spawn-params)
  (format #t "~1Ttp: ~A~%" (-> this tp))
  (format #t "~1Tpos: #<vector @ #x~X>~%" (-> this pos))
  (format #t "~1Tlifetime: ~D~%" (-> this lifetime))
  (format #t "~1Tinitial-owner: ~D~%" (-> this initial-owner))
  (format #t "~1Tmotion-info: ~A~%" (-> this motion-info))
  (label cfg-4)
  this
  )

;; definition of type net-powerup
(deftype net-powerup (process-nettable)
  ((child-proc           handle)
   (die-or-respawn-time  int32)
   (touched-time         int32)
   (touched-by           int8)
   (ignore-frames        int8)
   (hash-id              int16)
   (pos                  vector  :inline)
   (motion-info          net-powerup-motion-info)
   )
  (:state-methods
    idle
    wait-respawn
    die
    )
  (:methods
    (init! (_type_ net-powerup-spawn-params) none)
    (spawn-draw-proc (_type_ vector entity) none)
    (kill-draw-proc (_type_) none)
    (on-touched (_type_ process) none)
    (get-pos! (_type_ vector) none)
    (get-collision-sphere (_type_ vector entity-actor) none)
    (visible? (_type_) symbol)
    (do-pickup (_type_ process) none)
    (can-pick-up? (_type_) symbol)
    (on-pickup (_type_) none)
    (get-respawn-time (_type_ time-frame) time-frame)
    )
  )

;; definition for method 3 of type net-powerup
(defmethod inspect ((this net-powerup))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type process-nettable inspect)))
    (t9-0 this)
    )
  (format #t "~2Tchild-proc: ~D~%" (-> this child-proc))
  (format #t "~2Tdie-or-respawn-time: ~D~%" (-> this die-or-respawn-time))
  (format #t "~2Ttouched-time: ~D~%" (-> this touched-time))
  (format #t "~2Ttouched-by: ~D~%" (-> this touched-by))
  (format #t "~2Tignore-frames: ~D~%" (-> this ignore-frames))
  (format #t "~2Thash-id: ~D~%" (-> this hash-id))
  (format #t "~2Tpos: #<vector @ #x~X>~%" (-> this pos))
  (format #t "~2Tmotion-info: ~A~%" (-> this motion-info))
  (label cfg-4)
  this
  )

;; definition for function net-powerup-init-remote
;; WARN: Return type mismatch int vs object.
(defbehavior net-powerup-init-remote net-powerup ((arg0 mem-buffer))
  (register self -1 #xffff)
  (init-remote self arg0)
  (post-init-remote self)
  0
  )

;; definition for method 41 of type net-powerup
(defmethod spawn-remote ((this net-powerup) (arg0 mem-buffer))
  (ppointer->process (process-spawn net-powerup :init net-powerup-init-remote arg0 :name "net-powerup"))
  )

;; definition for method 37 of type net-powerup
;; WARN: Return type mismatch int vs none.
(defmethod write-msg-map ((this net-powerup) (arg0 net-process-class-info))
  (set! (-> arg0 msg-map (-> arg0 msg-count)) 'picked-up)
  (+! (-> arg0 msg-count) 1)
  0
  (none)
  )

;; definition for symbol *msg-map-net-powerup*, type (array symbol)
(define *msg-map-net-powerup* (new 'static 'boxed-array :type symbol :length 0 :allocated-length 64))

;; definition for symbol *net-process-class-info-net-powerup*, type net-process-class-info
(define *net-process-class-info-net-powerup* (new 'static 'net-process-class-info))

;; failed to figure out what this is:
(set! (-> *net-process-class-info-net-powerup* msg-map) *msg-map-net-powerup*)

;; failed to figure out what this is:
(write-msg-map-rec net-powerup *net-process-class-info-net-powerup*)

;; failed to figure out what this is:
(set! (-> *net-process-class-info-net-powerup* owner-type) net-powerup)

;; failed to figure out what this is:
(net-process-class-register *net-process-class-info-net-powerup*)

;; definition for method 40 of type net-powerup
(defmethod get-class-info ((this net-powerup))
  *net-process-class-info-net-powerup*
  )

;; definition of type powerup-draw
(deftype powerup-draw (process-drawable)
  ((parent-proc  handle)
   (glow-sound   ambient-sound)
   (part-time    int32)
   )
  (:state-methods
    idle
    die
    )
  (:methods
    (init-root! (_type_ float) none)
    (init! (_type_ net-powerup vector) none)
    (spawn-pickup-effect (_type_ process-drawable) none)
    (update-draw (_type_) none)
    (set-pos! (_type_ vector) none)
    )
  )

;; definition for method 3 of type powerup-draw
(defmethod inspect ((this powerup-draw))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type process-drawable inspect)))
    (t9-0 this)
    )
  (format #t "~2Tparent-proc: ~D~%" (-> this parent-proc))
  (format #t "~2Tglow-sound: ~A~%" (-> this glow-sound))
  (format #t "~2Tpart-time: ~D~%" (-> this part-time))
  (label cfg-4)
  this
  )

;; definition for function powerup-draw-init-by-other
;; INFO: Used lq/sq
(defbehavior powerup-draw-init-by-other powerup-draw ((arg0 process) (arg1 vector) (arg2 entity))
  (let ((s5-0 (new 'stack-no-clear 'vector)))
    (if arg2
        (set! (-> self level) (-> arg2 extra level))
        (art-group-get-by-name *level* (-> arg0 name) (&-> self level))
        )
    (set! (-> s5-0 quad) (-> arg1 quad))
    (set! (-> self parent-proc) (process->handle arg0))
    (stack-size-set! (-> self main-thread) 32)
    (init! self (the-as net-powerup arg0) s5-0)
    )
  (go-virtual idle)
  )


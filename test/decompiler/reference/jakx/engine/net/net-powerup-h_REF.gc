;; definition for function powerup-draw-init-by-other
;; INFO: Used lq/sq
;; WARN: Return type mismatch object vs none.
(defbehavior powerup-draw-init-by-other powerup-draw ((arg0 process) (arg1 vector) (arg2 process))
  (let ((s5-0 (new 'stack-no-clear 'vector)))
    (if arg2
        (set! (-> self level) (the-as level (-> arg2 brother 4)))
        (art-group-get-by-name *level* (-> arg0 name) (&-> self level))
        )
    (set! (-> s5-0 quad) (-> arg1 quad))
    )
  (set! (-> self parent-proc) (the-as uint (process->handle arg0)))
  (stack-size-set! (-> self main-thread) 32)
  ((method-of-object self powerup-draw-method-53))
  (go-virtual TODO)
  (none)
  )


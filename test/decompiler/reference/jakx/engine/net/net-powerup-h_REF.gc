  this
  )

;; definition for function net-powerup-init-remote
;; WARN: Return type mismatch int vs none.
(defbehavior net-powerup-init-remote net-powerup ((arg0 process))
  (process-nettable-method-34 self -1 (new 'static 'rgba :r #xff :g #xff))
  (process-nettable-method-35 self (the-as int arg0))
  (process-nettable-method-36 self)
  0
  (none)
  )

;; definition for method 41 of type net-powerup
(defmethod process-nettable-method-41 ((this net-powerup) (arg0 int))
  (ppointer->process (process-spawn net-powerup :init net-powerup-init-remote arg0 :name "net-powerup"))
  )


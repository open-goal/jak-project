;; definition of type net-powerup-motion-info
(deftype net-powerup-motion-info (basic)
  ((motion-hook      basic)
   (flight-end-time  int32)
   (vel              vector  :inline)
   (rest-pos         vector  :inline)
   )
  (:methods
    (net-powerup-motion-info-method-9 () none)
    (net-powerup-motion-info-method-10 () none)
    (net-powerup-motion-info-method-11 () none)
    (net-powerup-motion-info-method-12 () none)
    )
  )

;; definition for method 3 of type net-powerup-motion-info
(defmethod inspect ((this net-powerup-motion-info))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this (-> this type))
  (format #t "~1Tmotion-hook: ~A~%" (-> this motion-hook))
  (format #t "~1Tflight-end-time: ~D~%" (-> this flight-end-time))
  (format #t "~1Tvel: #<vector @ #x~X>~%" (-> this vel))
  (format #t "~1Trest-pos: #<vector @ #x~X>~%" (-> this rest-pos))
  (label cfg-4)
  this
  )


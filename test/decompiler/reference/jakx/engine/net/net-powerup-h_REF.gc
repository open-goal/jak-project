;; definition for method 3 of type net-powerup
(defmethod inspect ((this net-powerup))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type process-nettable inspect)))
    (t9-0 this)
    )
  (format #t "~2Tchild-proc: ~D~%" (-> this child-proc))
  (format #t "~2Tdie-or-respawn-time: ~D~%" (-> this die-or-respawn-time))

;;-*-Lisp-*-
(in-package goal)

;; definition of type net-player-race
(deftype net-player-race (net-player)
  ((last-on-track-pos        vector      :inline)
   (last-on-track-rot        quaternion  :inline)
   (wrong-way-bot            uint64)
   (finish-time              int32)
   (last-lap-update-time     int32)
   (last-on-track-time       int32)
   (last-slice               int32)
   (last-slice-change-time   int32)
   (last-valid-vehicle-time  uint64)
   (rstate                   racer-state)
   (current-lap              int8)
   (racer-idx                int8)
   (current-lap-start-time   int32)
   (best-lap-time            int32)
   (speed-factor             float)
   (max-lap-reached          int32)
   )
  (:methods
    (net-player-race-method-98 () none)
    (net-player-race-method-99 () none)
    (net-player-race-method-100 () none)
    (net-player-race-method-101 () none)
    (net-player-race-method-102 () none)
    (net-player-race-method-103 () none)
    (net-player-race-method-104 () none)
    (net-player-race-method-105 () none)
    (net-player-race-method-106 () none)
    (net-player-race-method-107 () none)
    )
  )

;; definition for method 3 of type net-player-race
(defmethod inspect ((this net-player-race))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type net-player inspect)))
    (t9-0 this)
    )
  (format #t "~2Tlast-on-track-pos: #<vector @ #x~X>~%" (-> this last-on-track-pos))
  (format #t "~2Tlast-on-track-rot: #<quaternion @ #x~X>~%" (-> this last-on-track-rot))
  (format #t "~2Twrong-way-bot: ~D~%" (-> this wrong-way-bot))
  (format #t "~2Tfinish-time: ~D~%" (-> this finish-time))
  (format #t "~2Tlast-lap-update-time: ~D~%" (-> this last-lap-update-time))
  (format #t "~2Tlast-on-track-time: ~D~%" (-> this last-on-track-time))
  (format #t "~2Tlast-slice: ~D~%" (-> this last-slice))
  (format #t "~2Tlast-slice-change-time: ~D~%" (-> this last-slice-change-time))
  (format #t "~2Tlast-valid-vehicle-time: ~D~%" (-> this last-valid-vehicle-time))
  (format #t "~2Trstate: #<racer-state @ #x~X>~%" (-> this rstate))
  (format #t "~2Tcurrent-lap: ~D~%" (-> this current-lap))
  (format #t "~2Tracer-idx: ~D~%" (-> this racer-idx))
  (format #t "~2Tcurrent-lap-start-time: ~D~%" (-> this current-lap-start-time))
  (format #t "~2Tbest-lap-time: ~D~%" (-> this best-lap-time))
  (format #t "~2Tspeed-factor: ~f~%" (-> this speed-factor))
  (format #t "~2Tmax-lap-reached: ~D~%" (-> this max-lap-reached))
  (label cfg-4)
  this
  )

;; definition for function net-player-race-init-remote
;; WARN: Return type mismatch int vs none.
(defbehavior net-player-race-init-remote net-player-race ((arg0 int))
  (process-nettable-method-34 self -1 (new 'static 'rgba :r #xff :g #xff))
  (process-nettable-method-35 self arg0)
  (process-nettable-method-36 self)
  0
  (none)
  )

;; definition for method 41 of type net-player-race
(defmethod process-nettable-method-41 ((this net-player-race) (arg0 int))
  (ppointer->process
    (process-spawn net-player-race :init net-player-race-init-remote arg0 :name "net-player-race")
    )
  )

;; definition for method 37 of type net-player-race
;; WARN: Return type mismatch int vs none.
(defmethod process-nettable-method-37 ((this net-player-race) (arg0 net-process-class-info))
  (set! (-> arg0 msg-map (-> arg0 msg-count)) 'lap-changed)
  (+! (-> arg0 msg-count) 1)
  (set! (-> arg0 msg-map (-> arg0 msg-count)) 'player-finished)
  (+! (-> arg0 msg-count) 1)
  0
  (none)
  )


;; definition for symbol *room-clan-id*, type int
(define *room-clan-id* -1)

;; definition for symbol *room-clan-id-2*, type int
(define *room-clan-id-2* -1)

;; definition of type medius-room
(deftype medius-room (structure)
  ((id             int32)
   (name           uint8  32)
   (player-ct      int32)
   (max-players    int32)
   (game-world-ct  int32)
   )
  :pack-me
  )

;; definition for method 3 of type medius-room
(defmethod inspect ((this medius-room))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'medius-room)
  (format #t "~1Tid: ~D~%" (-> this id))
  (format #t "~1Tname[32] @ #x~X~%" (-> this name))
  (format #t "~1Tplayer-ct: ~D~%" (-> this player-ct))
  (format #t "~1Tmax-players: ~D~%" (-> this max-players))
  (format #t "~1Tgame-world-ct: ~D~%" (-> this game-world-ct))
  (label cfg-4)
  this
  )

;; definition of type medius-room-array
(deftype medius-room-array (structure)
  ((total-ct     int32)
   (base-page    int32)
   (total-pages  int32)
   (ct           int32)
   (data         medius-room  5 :inline)
   )
  (:methods
    (contains? (_type_ int) symbol)
    (medius-room-array-method-10 (_type_) none)
    )
  )

;; definition for method 3 of type medius-room-array
(defmethod inspect ((this medius-room-array))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'medius-room-array)
  (format #t "~1Ttotal-ct: ~D~%" (-> this total-ct))
  (format #t "~1Tbase-page: ~D~%" (-> this base-page))
  (format #t "~1Ttotal-pages: ~D~%" (-> this total-pages))
  (format #t "~1Tct: ~D~%" (-> this ct))
  (format #t "~1Tdata[5] @ #x~X~%" (-> this data))
  (label cfg-4)
  this
  )

;; definition for symbol *medius-rooms*, type medius-room-array
(define *medius-rooms* (new 'static 'medius-room-array))

;; definition for symbol *last-normal-room*, type int
(define *last-normal-room* -1)

;; definition for method 9 of type medius-room-array
(defmethod contains? ((this medius-room-array) (arg0 int))
  (dotimes (v1-0 (-> this ct))
    (if (= (-> this data v1-0 id) arg0)
        (return #t)
        )
    )
  #f
  )

;; definition for function refresh-rooms-callback
;; INFO: Called from C
;; WARN: Return type mismatch int vs object.
(defun refresh-rooms-callback ((arg0 medius-channel-list-extra-info-response))
  (mem-copy! (the-as pointer *medius-last-response*) (the-as pointer arg0) 1024)
  (cond
    ((= (-> arg0 status-code) (medius-status-code medius-no-result))
     (set! (-> *net-mgr* lobby-state callback-occurred) #t)
     )
    ((= (-> arg0 status-code) (medius-status-code medius-success))
     (when (and (< (-> *medius-rooms* ct) 5) (not (contains? *medius-rooms* (-> arg0 medius-world-id))))
       (let ((s5-0 (-> *medius-rooms* data (-> *medius-rooms* ct))))
         (mem-copy! (-> s5-0 name) (-> arg0 lobby-name) 32)
         (set! (-> s5-0 id) (-> arg0 medius-world-id))
         (set! (-> s5-0 player-ct) (the-as int (-> arg0 player-count)))
         (set! (-> s5-0 max-players) (the-as int (-> arg0 max-players)))
         (set! (-> s5-0 game-world-ct) (the-as int (-> arg0 game-world-count)))
         )
       (+! (-> *medius-rooms* ct) 1)
       )
     )
    )
  (if (= (-> arg0 end-of-list) 1)
      (set! (-> *net-mgr* lobby-state callback-occurred) #t)
      )
  0
  )

;; definition for function refresh-rooms

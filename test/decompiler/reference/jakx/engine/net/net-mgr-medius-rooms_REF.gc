;; WARN: Swapped fp-relative label and field offsets for "StaticLobby"
;; WARN: Return type mismatch symbol vs object.
(defbehavior ensure-room-is-good net-mgr ()
  (if (not (strstr *current-room-name* (-> "StaticLobby" data)))
      (return (the-as object #f))
      )
  (format 0 ">>>>>>>>>>> moving rooms~%")

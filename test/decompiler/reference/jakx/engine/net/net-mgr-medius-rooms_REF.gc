  (dotimes (gp-0 (-> *medius-rooms* ct))
    (case (join-room (-> *medius-rooms* data gp-0 id))
      (('success)
       (goto cfg-10)
       )
      )
    )
  (lobby-fatal-error 'lobby-connect-failed)
  (label cfg-10)
  'success
  )


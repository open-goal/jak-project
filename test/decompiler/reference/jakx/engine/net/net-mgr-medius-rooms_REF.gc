      (set! (-> s0-0 filter-mask2) (the-as uint arg2))
      (set! (-> s0-0 filter-mask3) (the-as uint arg3))
      (set! (-> s0-0 filter-mask4) (the-as uint arg4))
      (set! (-> s0-0 lobby-filter-type) (the-as medius-lobby-filter-type s1-0))
      (set! (-> s0-0 filter-mask-level) (medius-lobby-filter-mask-level-type medius-lobby-filter-mask-level1))
      (reset-lobby-state! self)
      (set! *scert-function-id* (scert-function medius-set-lobby-world-filter))
      (let ((s5-1 (knet-scert-function-3-args s0-0 medius-simple-request-callback #f)))
        (when (nonzero? s5-1)
          (format 0 "initial function call returned ~D~%" s5-1)
          (set! (-> self lobby-state got-error) #t)
          (set! (-> self lobby-state last-medius-error) s5-1)
          )
        )
      )
    )
  (net-async-wait (seconds 15) #t)
  (cond
    ((or (-> self lobby-state got-error)
         (-> self lobby-state timeout)
         (nonzero? (-> self lobby-state last-medius-error))
         (nonzero? (-> self lobby-state last-mgcl-error))
         (nonzero? (-> self lobby-state last-dme-error))
         (nonzero? (-> self lobby-state callback-status))
         )
     *medius-last-response*
     (lobby-fatal-error 'lobby-connect-failed)
     )
    (else
      *medius-last-response*
      0
      )
    )
  (set! (-> *medius-rooms* total-ct) 0)
  (set! (-> *medius-rooms* ct) 0)
  (let ((s5-2 (new 'stack 'medius-get-total-channels-request)))
    (set! *async-request-ct* (+ *async-request-ct* 1))
    (itoa *async-request-ct* (-> s5-2 message-id))
    (mem-copy! (-> s5-2 session-key) *medius-session-key* 17)
    (set! *scert-function-id* (scert-function get-application-id))
    (set! (-> s5-2 application-id) (knet-scert-function-0-args))
    (reset-lobby-state! self)
    (set! *scert-function-id* (scert-function medius-get-total-channels))
    (let ((s5-3 (knet-scert-function-3-args s5-2 medius-simple-request-callback #f)))
      (when (nonzero? s5-3)
        (format 0 "initial function call returned ~D~%" s5-3)
        (set! (-> self lobby-state got-error) #t)
        (set! (-> self lobby-state last-medius-error) s5-3)
        )
      )
    )
  (net-async-wait (seconds 15) #t)
  (cond
    ((or (-> self lobby-state got-error)
         (-> self lobby-state timeout)
         (nonzero? (-> self lobby-state last-medius-error))
         (nonzero? (-> self lobby-state last-mgcl-error))
         (nonzero? (-> self lobby-state last-dme-error))
         (nonzero? (-> self lobby-state callback-status))
         )
     *medius-last-response*
     0
     )
    (else
      *medius-last-response*
      0
      )
    )
  (let ((s5-4 (the-as medius-get-total-channels-response *medius-last-response*)))
    (inspect s5-4)
    (when (nonzero? (-> s5-4 status-code))
      (let ((v1-54 #f))
        (set! *net-mgr-pending-behavior-result-extra* (the-as object #f))
        (return (the-as object v1-54))

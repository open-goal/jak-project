           )
          (else
            (send-event
              gp-0
              'set
              'camera-inside-view
              (-> *game-info* player-info (view-get-active-index) camera-inside-view)
              )
            )
          )
        )
      )
    (when (and (= (/ (-> self player-id) 2) (if *net-mgr*
                                                (-> *net-mgr* game-state local-machine-idx)
                                                0
                                                )
                  )
               (and (>= (-> self player-id) 0) (< (-> self player-id) 16))
               )
      (let ((gp-1 (-> self view index)))
        (set! (-> *level* prev-camera-pos gp-1 quad) (-> (camera-pos) quad))
        (set! (-> *level* curr-camera-pos gp-1 quad) (-> (camera-pos) quad))
        )
      )
    (set! (-> self dead-camera-pos-valid) #f)
    )
  :trans (behavior ()
    (let ((v1-1 (get-vehicle self)))
      (when v1-1
        (when (not (logtest? (-> v1-1 v-flags) (vehicle-flag in-air)))
          (let ((f0-0 (vector-length (-> v1-1 root transv))))
            (if (< (-> self top-speed) f0-0)
                (set! (-> self top-speed) f0-0)
                )
            )
          )
        )
      )
    (when (and (logtest? (-> self flags) (net-player-flag endlessfall))
               (time-elapsed? (-> self state-time) (seconds 1))
               )
      (send-event (the-as wvehicle (handle->process (-> self vehicle))) 'go 'die)
      (logclear! (-> self flags) (net-player-flag endlessfall))
      )
    (if (can-spawn-vehicle? self)
        (respawn self)
        )
    )
  :code sleep-code
  :post (behavior ()
    (when (and (= (/ (-> self player-id) 2) (if *net-mgr*
                                                (-> *net-mgr* game-state local-machine-idx)
                                                0
                                                )
                  )
               (and (>= (-> self player-id) 0) (< (-> self player-id) 16))
               )
      (let ((gp-0 (-> self view index)))
        (set! (-> *level* prev-camera-pos gp-0 quad) (-> *level* curr-camera-pos gp-0 quad))
        (set! (-> *level* curr-camera-pos gp-0 quad) (-> (camera-pos) quad))
        (if (and *execute-regions* (-> *setting-control* user-current region-mode) (not (paused?)))
            (region-tree-execute 'camera (-> *level* prev-camera-pos gp-0) (-> *level* curr-camera-pos gp-0))
            )
        )
      )
    (let ((a1-3 (get-vehicle self)))
      (if a1-3
          (vehicle-update self a1-3)
          )
      )
    (when (and (logtest? (-> self flags) (net-player-flag show-results)) (not (target-camera-active?)))
      (setup
        (-> *screen-filter-array* (logand (-> self player-id) 1))
        (new 'static 'vector :x 255.0 :y 255.0 :z 255.0 :w 160.0)
        (new 'static 'vector :x 255.0 :y 255.0 :z 255.0)
        0.01
        (bucket-id tex-hud-hud-alpha)
        #xfffffe
        #x33001
        (the-as symbol 0)
        )
      (let ((v1-38 (make-sound-instance snd-win-flash (new 'static 'sound-id) (the-as handle #f))))
        (cond
          (v1-38
            (logior! (-> v1-38 flags) (sound-spec-flag needs-update non-positional))
            (-> v1-38 id)
            )
          (else
            0
            )
          )
        )
      (spawn-hud-results)
      (cam-disconnect *setting-control* (view-get-active-index) self 'interp-time)
      (cam-disconnect *setting-control* (view-get-active-index) self 'mode-name)
      (logclear! (-> self flags) (net-player-flag show-results))
      (if (and (= (/ (-> self player-id) 2) (if *net-mgr*
                                                (-> *net-mgr* game-state local-machine-idx)
                                                0
                                                )
                  )
               (and (>= (-> self player-id) 0) (< (-> self player-id) 16))
               )
          (end-of-race-start-preload)
          )
      )
    )
  )


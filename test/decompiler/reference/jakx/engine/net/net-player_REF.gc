         (set! v0-0
               (+ (-> *setting-control* cam-settings (view-get-active-index) current interp-time) 30 (current-time))
               )
         (set! *target-cam-off-time* (the-as int (the-as uint v0-0)))
         v0-0
         )
       )
      )
    )
  )


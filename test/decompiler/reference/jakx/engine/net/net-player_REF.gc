  (set! (-> this wait-period) (the-as uint 600))
  (let ((s5-0 (new 'stack-no-clear 'array 'uint32 1)))
    (set! (-> s5-0 0) (the-as uint (current-time)))
    (when (>= (-> s5-0 0) (-> this state-time))
      (cond
        ((= (-> this throttle) 0.0)
         (set! (-> this throttle) 1.0)
         (set! (-> this state-time) (+ (-> s5-0 0) (-> this on-period) (rand-vu-int-count 30)))
         (if (zero? (-> this i-pulse))
             (set! (-> this state-time) (+ (-> s5-0 0) (-> this long-period) (rand-vu-int-count 90)))
             )
         )
        (else
          (set! (-> this throttle) 0.0)
          (set! (-> this state-time) (+ (-> s5-0 0) (-> this off-period) (rand-vu-int-count 30)))
          (+! (-> this i-pulse) 1)
          (when (>= (-> this i-pulse) (-> this pulse-count))
            (set! (-> this i-pulse) 0)
            (set! (-> this pulse-count) (rand-vu-int-range 2 4))
            (set! (-> this state-time) (+ (-> s5-0 0) (the int (* 300.0 (rand-vu-float-range 1.5 3.0)))))
            )
          )
        )
      (send-event (the-as vehicle (handle->process (-> this vehicle))) 'set 'throttle (-> this throttle))
      )
    )
  0
  0
  (none)
  )

;; failed to figure out what this is:
(defstate idle (vehicle-rev-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('die)
       (deactivate self)
       )
      )
    )
  :enter (behavior ()
    (send-event (the-as vehicle (handle->process (-> self vehicle))) 'set 'throttle (-> self throttle))
    )
  :trans (behavior ()
    (vehicle-rev-manager-method-16 self)
    )
  :code sleep-code
  )

;; definition for function vehicle-rev-manager-init-by-other
(defbehavior vehicle-rev-manager-init-by-other vehicle-rev-manager ((arg0 process) (arg1 time-frame))
  (stack-size-set! (-> self main-thread) 128)
  (set! (-> self vehicle) (process->handle arg0))
  (set! (-> self throttle) 0.0)
  (set! (-> self i-pulse) 0)
  (set! (-> self pulse-count) 3)
  (set! (-> self state-time) (the-as uint (+ (current-time) arg1)))
  (go-virtual idle)
  )

;; definition for function vehicle-rev-manager-spawn
;; WARN: Return type mismatch process vs vehicle-rev-manager.
(defun vehicle-rev-manager-spawn ((arg0 process) (arg1 time-frame))
  (let ((gp-0 (the-as process #f)))
    (let ((v1-1 (process-spawn vehicle-rev-manager arg0 arg1 :name "vehicle-rev-manager" :to arg0)))
      (if v1-1
          (set! gp-0 (-> v1-1 0))
          )
      )
    (the-as vehicle-rev-manager gp-0)
    )
  )

;; definition for method 74 of type net-player
(defmethod generate-random-stats ((this net-player))
  (when (and (= 0.0 (-> this best-power-slide))
             (= 0.0 (the float (-> this best-hang-time)))
             (not (and (>= (-> this player-id) 0) (< (-> this player-id) 16)))
             )
    (let ((f30-0 (the float (- (- (- (if *net-mgr*
                                         (-> *net-mgr* game-state time)
                                         0
                                         )
                                     (if *net-world*
                                         (-> *net-world* net-state game-start-time)
                                         0
                                         )
                                     )
                                  (if *net-world*
                                      (-> *net-world* net-state total-pause-time)
                                      0
                                      )
                                  )
                               (-> *net-game-mgr* intro-end-time)
                               )
                      )
                 )
          )
      (let ((f28-0 (lerp-scale 0.0 200.0 f30-0 4500.0 72000.0)))
        (set! (-> this best-power-slide)
              (+ f28-0 (* (rand-float-gen)
                          (- (lerp-scale 0.0 800.0 f30-0 4500.0 72000.0) (lerp-scale 0.0 200.0 f30-0 4500.0 72000.0))
                          )
                 )
              )
        )
      (let ((f28-1 (lerp-scale 0.0 450.0 f30-0 4500.0 72000.0)))
        (set! (-> this best-hang-time)
              (the int
                   (+ f28-1 (* (rand-float-gen)
                               (- (lerp-scale 0.0 1050.0 f30-0 4500.0 72000.0) (lerp-scale 0.0 450.0 f30-0 4500.0 72000.0))
                               )
                      )
                   )
              )
        )
      )
    (write-stats-change this)
    )
  (none)

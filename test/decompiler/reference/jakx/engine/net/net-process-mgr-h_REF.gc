;;-*-Lisp-*-
(in-package goal)

;; definition of type net-process-mgr-machine
(deftype net-process-mgr-machine (structure)
  ((state            uint8)
   (delay            int32)
   (acct-id          int32)
   (overall-score    int32)
   (clan-id          int32)
   (local-player-ct  int32)
   (cookie           int32)
   (reported-ping    int32)
   )
  :pack-me
  )

;; definition for method 3 of type net-process-mgr-machine
(defmethod inspect ((this net-process-mgr-machine))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'net-process-mgr-machine)
  (format #t "~1Tstate: ~D~%" (-> this state))
  (format #t "~1Tdelay: ~D~%" (-> this delay))
  (format #t "~1Tacct-id: ~D~%" (-> this acct-id))
  (format #t "~1Toverall-score: ~D~%" (-> this overall-score))
  (format #t "~1Tclan-id: ~D~%" (-> this clan-id))
  (format #t "~1Tlocal-player-ct: ~D~%" (-> this local-player-ct))
  (format #t "~1Tcookie: ~D~%" (-> this cookie))
  (format #t "~1Treported-ping: ~D~%" (-> this reported-ping))
  (label cfg-4)
  this
  )

;; definition of type net-process-mgr
(deftype net-process-mgr (process)
  ((local-machine-idx                 int32)
   (session-master-idx                int32)
   (machines                          net-process-mgr-machine  8 :inline)
   (last-allocated-local-id           int32)
   (last-allocated-global-id          int32)
   (have-send-pending-objects         symbol)
   (snap-time-of-day                  symbol)
   (owner-lists                       linked-list              10 :inline)
   (active-list                       linked-list              :inline)
   (cur-proc-valid                    symbol)
   (cur-proc-id                       uint16)
   (cur-proc-owner-idx                int8)
   (cur-proc-type                     type)
   (cur-proc-entity                   entity-links)
   (entity-creation-messages-enabled  symbol)
   )
  (:methods
    (net-process-mgr-method-9 () none)
    (net-process-mgr-method-10 () none)
    (net-process-mgr-method-11 () none)
    (net-process-mgr-method-12 () none)
    (net-process-mgr-method-13 () none)
    (net-process-mgr-method-14 () none)
    (net-process-mgr-method-15 () none)
    (net-process-mgr-method-16 () none)
    (net-process-mgr-method-17 () none)
    (net-process-mgr-method-18 () none)
    (net-process-mgr-method-19 () none)
    (net-process-mgr-method-20 () none)
    (net-process-mgr-method-21 () none)
    (net-process-mgr-method-22 () none)
    (net-process-mgr-method-23 () none)
    (net-process-mgr-method-24 () none)
    (net-process-mgr-method-25 () none)
    (net-process-mgr-method-26 () none)
    (net-process-mgr-method-27 () none)
    (net-process-mgr-method-28 () none)
    (net-process-mgr-method-29 () none)
    (net-process-mgr-method-30 () none)
    (net-process-mgr-method-31 () none)
    (net-process-mgr-method-32 () none)
    (net-process-mgr-method-33 () none)
    (net-process-mgr-method-34 () none)
    (net-process-mgr-method-35 () none)
    (net-process-mgr-method-36 () none)
    (net-process-mgr-method-37 () none)
    (net-process-mgr-method-38 () none)
    (net-process-mgr-method-39 () none)
    (net-process-mgr-method-40 (_type_ int) process-nettable)
    (net-process-mgr-method-41 () none)
    (net-process-mgr-method-42 () none)
    (net-process-mgr-method-43 () none)
    (net-process-mgr-method-44 () none)
    (net-process-mgr-method-45 () none)
    (net-process-mgr-method-46 (_type_ int) none)
    (net-process-mgr-method-47 () none)
    (net-process-mgr-method-48 () none)
    (net-process-mgr-method-49 () none)
    (net-process-mgr-method-50 () none)
    (net-process-mgr-method-51 () none)
    (net-process-mgr-method-52 () none)
    )
  )

;; definition for method 3 of type net-process-mgr
(defmethod inspect ((this net-process-mgr))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type process inspect)))
    (t9-0 this)
    )
  (format #t "~2Tlocal-machine-idx: ~D~%" (-> this local-machine-idx))
  (format #t "~2Tsession-master-idx: ~D~%" (-> this session-master-idx))
  (format #t "~2Tmachines[8] @ #x~X~%" (-> this machines))
  (format #t "~2Tlast-allocated-local-id: ~D~%" (-> this last-allocated-local-id))
  (format #t "~2Tlast-allocated-global-id: ~D~%" (-> this last-allocated-global-id))
  (format #t "~2Thave-send-pending-objects: ~A~%" (-> this have-send-pending-objects))
  (format #t "~2Tsnap-time-of-day: ~A~%" (-> this snap-time-of-day))
  (format #t "~2Towner-lists[10] @ #x~X~%" (-> this owner-lists))
  (format #t "~2Tactive-list: #<linked-list @ #x~X>~%" (-> this active-list))
  (format #t "~2Tcur-proc-valid: ~A~%" (-> this cur-proc-valid))
  (format #t "~2Tcur-proc-id: ~D~%" (-> this cur-proc-id))
  (format #t "~2Tcur-proc-owner-idx: ~D~%" (-> this cur-proc-owner-idx))
  (format #t "~2Tcur-proc-type: ~A~%" (-> this cur-proc-type))
  (format #t "~2Tcur-proc-entity: #<entity-links @ #x~X>~%" (-> this cur-proc-entity))
  (format #t "~2Tentity-creation-messages-enabled: ~A~%" (-> this entity-creation-messages-enabled))
  (label cfg-4)
  this
  )

;; definition for symbol *net-process-mgr*, type net-process-mgr
(define *net-process-mgr* (the-as net-process-mgr #f))

;; definition for function get-event-level
(defun get-event-level ()
  (let ((v1-1 (level-group-method-32 *level*)))
    (if (not v1-1)
        (return (the-as level #f))
        )
    (case *lobby-local-players*
      ((1)
       (-> v1-1 borrow-level 0)
       )
      (else
        (-> v1-1 borrow-level 2)
        )
      )
    )
  )

;; definition for function get-shared-level
(defun get-shared-level ()
  (let ((v1-1 (level-group-method-32 *level*)))
    (if (not v1-1)
        (return (the-as level #f))
        )
    (-> v1-1 borrow-level 1)
    )
  )

;; definition for function nos
;; WARN: Return type mismatch int vs none.
(defun nos ()
  (when *net-process-mgr*
    (format #t "~%~%")
    (dotimes (gp-0 10)
      (cond
        ((= gp-0 (if *net-mgr*
                     (-> *net-mgr* game-state local-machine-idx)
                     0
                     )
            )
         (format #t ">>>[~D] :~%" gp-0)
         )
        ((= gp-0 8)
         (format #t "  world :~%")
         )
        ((= gp-0 9)
         (format #t "release :~%")
         )
        (else
          (format #t "   [~D] :~%" gp-0)
          )
        )
      (let ((v1-13 (the-as object (-> *net-process-mgr* owner-lists gp-0 head))))
        (while (the-as list-link v1-13)
          (let ((s5-0 (-> (the-as list-link v1-13) next)))
            (let ((s4-0 (if (the-as list-link v1-13)
                            (the-as process-nettable (&+ (the-as pointer v1-13) -168))
                            (the-as process-nettable #f)
                            )
                        )
                  )
              (format #t "   [~4,'0X] " (-> s4-0 net-id))
              (print s4-0)
              )
            (format #t "~%")
            (set! v1-13 s5-0)
            )
          )
        )
      )
    )
  (format #t "~%~%")
  0
  (none)
  )

;; definition for function write-process-as-handle
(defun write-process-as-handle ((arg0 mem-buffer) (arg1 process-nettable))
  (if arg1
      (mem-buffer-method-19 arg0 (the-as int (-> arg1 net-id)))
      (mem-buffer-method-19 arg0 #xffff)
      )
  (none)
  )

;; definition for function write-handle
(defun write-handle ((arg0 mem-buffer) (arg1 handle))
  (let ((a1-3 (as-type (handle->process arg1) process-nettable)))
    (write-process-as-handle arg0 (the-as process-nettable a1-3))
    )
  (none)
  )

;; definition for function read-handle
;; WARN: Return type mismatch int vs none.
(defun read-handle ((arg0 mem-buffer))
  (let* ((a1-0 (mem-buffer-method-37 arg0))
         (a0-2 (net-process-mgr-method-40 *net-process-mgr* a1-0))
         )
    (cond
      (a0-2
        (process->handle a0-2)
        )
      (else
        )
      )
    )
  (none)
  )

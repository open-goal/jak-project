;;-*-Lisp-*-
(in-package goal)

;; definition of type medius-cached-info-game-status
(deftype medius-cached-info-game-status (medius-cached-info)
  ((game-status  int32)
   )
  )

;; definition for method 3 of type medius-cached-info-game-status
(defmethod inspect ((this medius-cached-info-game-status))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this (-> this type))
  (format #t "~1Tmedius-id: ~D~%" (-> this medius-id))
  (format #t "~1Taccessed-time: ~D~%" (-> this accessed-time))
  (format #t "~1Tfetched-time: ~D~%" (-> this fetched-time))
  (format #t "~1Tstatus: ~D~%" (-> this status))
  (format #t "~1Tgame-status: ~D~%" (-> this game-status))
  (label cfg-4)
  this
  )

;; definition for symbol *medius-game-status-cache*, type medius-cache
(define *medius-game-status-cache*
  (new 'static 'medius-cache :objects (new 'static 'boxed-array :type medius-cached-info
                                        (new 'static 'medius-cached-info-game-status)
                                        (new 'static 'medius-cached-info-game-status)
                                        (new 'static 'medius-cached-info-game-status)
                                        (new 'static 'medius-cached-info-game-status)
                                        (new 'static 'medius-cached-info-game-status)
                                        (new 'static 'medius-cached-info-game-status)
                                        (new 'static 'medius-cached-info-game-status)
                                        (new 'static 'medius-cached-info-game-status)
                                        )
                             )
  )

;; failed to figure out what this is:
(clear-objects! *medius-game-status-cache*)

;; definition of type medius-game-array
(deftype medius-game-array (structure)
  ((ct    int32)
   (data  medius-game-world-player-list-response  64 :inline)
   )
  (:methods
    (medius-game-array-method-9 () none)
    (medius-game-array-method-10 () none)
    )
  )

;; definition for method 3 of type medius-game-array
(defmethod inspect ((this medius-game-array))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'medius-game-array)
  (format #t "~1Tct: ~D~%" (-> this ct))
  (format #t "~1Tdata[64] @ #x~X~%" (-> this data))
  (label cfg-4)
  this
  )

;; definition of type medius-game-filter-settings
(deftype medius-game-filter-settings (structure)
  ((burn-version-and-flags  int32)
   (event                   int8)
   (location                int8)
   (world                   int32)
   (max-players             int8)
   (class-type              int8)
   )
  )

;; definition for method 3 of type medius-game-filter-settings
(defmethod inspect ((this medius-game-filter-settings))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'medius-game-filter-settings)
  (format #t "~1Tburn-version-and-flags: ~D~%" (-> this burn-version-and-flags))
  (format #t "~1Tevent: ~D~%" (-> this event))
  (format #t "~1Tlocation: ~D~%" (-> this location))
  (format #t "~1Tworld: ~D~%" (-> this world))
  (format #t "~1Tmax-players: ~D~%" (-> this max-players))
  (format #t "~1Tclass-type: ~D~%" (-> this class-type))
  (label cfg-4)
  this
  )

;; definition for symbol *medius-games*, type medius-game-array
(define *medius-games* (new 'static 'medius-game-array))


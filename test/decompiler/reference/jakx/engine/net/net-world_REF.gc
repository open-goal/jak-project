;; definition for symbol *in-end-of-race-preload*, type symbol
(define *in-end-of-race-preload* #f)

;; definition for function end-of-race-start-preload
;; INFO: Used lq/sq
;; WARN: Return type mismatch int vs object.
(defbehavior end-of-race-start-preload process ()
  (if *in-end-of-race-preload*
      (return (the-as object #f))
      )
  (if (not (type? *net-game-mgr* net-game-mgr-race))
      (return (the-as object #f))
      )
  (set! *race-end-camera-pos-valid* #f)
  (if (!= *view-count* 1)
      (return (the-as object #f))
      )
  (let ((gp-0 (the-as entity-actor #f)))
    (let ((f30-0 0.0))
      (dotimes (s5-0 (-> *level* length))
        (let ((v1-11 (-> *level* level s5-0)))
          (when (= (-> v1-11 status) 'active)
            (let* ((s4-0 (-> v1-11 entity))
                   (s3-0 (-> s4-0 length))
                   )
              (dotimes (s2-0 s3-0)
                (let ((s1-0 (as-type (-> s4-0 data s2-0 entity) entity-actor)))
                  (when s1-0
                    (when (= (-> (the-as entity-actor s1-0) etype symbol) 'race-end-cam)
                      (let ((f0-0 (vector-vector-distance-squared (-> (view-get-active-math-camera) trans) (-> s1-0 trans))))
                        (when (or (not gp-0) (< f0-0 f30-0))
                          (set! gp-0 (the-as entity-actor s1-0))
                          (set! f30-0 f0-0)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    (send-event
      (get-vehicle (-> *net-players* (* (if *net-mgr*
                                            (-> *net-mgr* game-state local-machine-idx)
                                            0
                                            )
                                        2
                                        )
                       )
                   )
      'set
      'camera
      #f
      )
    (when (not gp-0)
      (cam-reconnect *setting-control* (view-get-active-index) self 'interp-time 'abs 0 0.0)
      (cam-reconnect *setting-control* (view-get-active-index) self 'mode-name 'cam-race-end 0 0.0)
      (return (the-as object #f))
      )
    (set! (-> *race-end-camera-pos* quad) (-> gp-0 trans quad))
    (set! *race-end-camera-pos-valid* #t)
    (let ((s5-4 self))
      (set! self *net-game-mgr*)
      (view-push-context 0)
      (cam-reconnect *setting-control* (view-get-active-index) (the-as net-game-mgr self) 'interp-time 'abs 0 0.0)
      (cam-reconnect
        *setting-control*
        (view-get-active-index)
        (the-as net-game-mgr self)
        'mode-name
        'cam-race-end
        0
        0.0
        )
      (view-pop-context)
      (set! self s5-4)
      )
    (set-continue-point-from-task *net-world*)
    (lobby-level-set! 0 'menu2 #f)
    (lobby-level-set! 1 (-> gp-0 extra level name) 'display)
    )
  (update-load-levels *net-world* #t)
  (let ((gp-3 self))
    (set! self *net-world*)
    (check-start-load)
    (set! self gp-3)
    )
  (set! *in-end-of-race-preload* #t)
  (lobby-level-set! 1 #f #f)
  0
  )

      (set! (-> arg0 cont) (get-continue-by-name *game-info* (the-as string (-> arg0 task-info split-continue))))
      (set! (-> arg0 cont) (get-continue-by-name *game-info* (the-as string (-> arg0 task-info play-continue))))
      )
  (when (not (-> arg0 cont))
    (format 0 "can't find continue pt~%")
    (break!)
    0
    )
  0
  )


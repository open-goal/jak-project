      )
    (check-start-load)
    (until #f
      (let ((v1-13 (level-get *level* 'fmvlev)))
        (if (and v1-13 (= (-> v1-13 status) 'loaded))
            (goto cfg-10)
            )
        )
      (suspend)
      )
    #f
    (label cfg-10)
    (fmv-player-run "166-outro-b" *target-pool* #f)
    (while *fmv-player*
      (suspend)
      )
    (fmv-player-run "166-outro-c" *target-pool* #f)
    (while *fmv-player*
      (suspend)
      )
    (until #f
      (let ((v1-24 (new 'stack-no-clear 'array 'int32 2)))
        (when (dma-try-alloc #x80040 #x80040 'fmv-player 0 (&-> v1-24 0) (&-> v1-24 1) #f)
          (suspend)
          (suspend)
          (goto cfg-21)
          )
        )
      (suspend)
      0
      )
    #f
    (label cfg-21)
    (dma-release 'fmv-player)
    (disable *screen-filter*)
    (set-blackout-frames (seconds 3.335))
    (start 'play (get-continue-by-name *game-info* "menu2-start") 0)
    (go-virtual running #f)
    )
  )


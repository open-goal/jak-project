        (set! (-> arg0 task-node) (the-as uint s5-0))
        )
    )
  (if (= (-> arg0 task-node) -1)
      (format 0 "THAT'S NOT RIGHT!~%")
      )
  (set! (-> arg0 task-node-info) (-> *game-info* sub-task-list (-> arg0 task-node)))
  (set! (-> arg0 task) (-> arg0 task-node-info task))
  (set! (-> arg0 task-info) (-> *game-info* play-list (-> arg0 task)))
  (if (and (player-idx-vehicle-selected? arg0 (+ (* (if *net-mgr*
                                                        (-> *net-mgr* game-state local-machine-idx)
                                                        0
                                                        )
                                                    2

  (stack-size-set! (-> this main-thread) 1600)
  (set! *net-world* this)
  (if *net-log-write*
      (net-log-world-ident)
      )
  (do-decode-net-world-state (-> this net-state) arg0)
  (format 0 "i am on team ~D~%" (-> this
                                    net-state
                                    players
                                    (* (if *net-mgr*
                                           (-> *net-mgr* game-state local-machine-idx)
                                           0
                                           )
                                       2
                                       )
                                    team-id
                                    )
          )
  (apply-task this)
  (dotimes (s5-1 24)
    (net-player-name-method-9 (-> *net-player-names* s5-1))
    )
  (set! (-> this is-late-join) #f)
  (if (logtest? (-> this net-state flags) 1)
      (set! (-> this is-late-join) #t)
      )
  (dotimes (v1-24 6)
    (set! (-> this vehicle-slot-to-player-map v1-24) (the-as uint -1))
    )
  (dotimes (v1-27 24)
    (set! (-> this player-to-vehicle-slot-map v1-27) (the-as uint -1))
    )
  (set! (-> this current-garage-player) -1)
  (set! (-> this current-garage-spare-slot) -1)
  (go (method-of-object this running) #f)
  0
  (none)
  )


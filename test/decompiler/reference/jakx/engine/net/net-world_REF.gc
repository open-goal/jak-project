;; definition for function wait-for-levels
(defbehavior wait-for-levels net-world ((arg0 symbol))
  (until (and (levels-loaded? self) (ocean-levels-loaded? self))
    (check-start-load)
    (if arg0
        (do-loading-text)
        )
    (suspend)
    )
  #f
  )


;; definition for method 17 of type net-world
;; WARN: Return type mismatch int vs none.
(defmethod handle-net-msg ((this net-world) (arg0 symbol) (arg1 mem-buffer) (arg2 int))
  (let ((a0-2 (-> *net-process-mgr* machines arg2 acct-id)))
    (if (> a0-2 0)
        (add-recent-opponent a0-2)
        )
    )
  (let* ((a1-1 (-> *net-process-mgr* machines arg2 clan-id))
         (a0-4 (the-as object (> a1-1 0)))
         )
    (when (and (the-as symbol a0-4) (!= a1-1 (-> *medius-my-clan* medius-id)))
      (set! a0-4 *medius-recent-clans*)
      (move-to-front! (the-as medius-clan-index-array a0-4) (the-as medius-cache a1-1))
      )
    (let ((s5-0 #f))
      (cond
        ((= arg0 'state)
         (when (not (logtest? (-> this net-state flags) 1))
           (do-decode-net-world-state (-> this net-state) arg1)
           (apply-task this)
           )
         )
        ((= arg0 'assigned-drivers)
         (read-bytes arg1 (-> this net-state assigned-drivers) 24)
         )
        ((= arg0 'set-task)
         (when (not (logtest? (-> this net-state flags) 1))
           (read-bytes arg1 (-> this net-state task-node-name) 32)
           (set! (-> this net-state player-ready-flags) (the-as uint 0))
           (apply-task this)
           (update-load-levels this #f)
           )
         (set! s5-0 'task)
         )
        ((= arg0 'set-options)
         (if (not (logtest? (-> this net-state flags) 1))
             (read-bytes arg1 (the-as pointer (-> this net-state options)) 8)
             )
         )
        ((= arg0 'green-room-stats)
         (decode-green-room-stats (-> this net-state green-room-stats) arg1)
         )
        ((= arg0 'green-room-player-stats)

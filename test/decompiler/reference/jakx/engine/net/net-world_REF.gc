          (dotimes (s3-0 16)
            (when (player-idx-vehicle-selected? this s3-0)
              (cond
                ((or (< (the-as uint 1) (-> this net-state players s3-0 team-id))
                     (< (-> this net-state players s3-0 team-id) 0)

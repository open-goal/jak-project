;;-*-Lisp-*-
(in-package goal)

;; definition for function verify-drivers
;; WARN: Return type mismatch int vs object.
(defun verify-drivers ()
  (dotimes (gp-0 (length *net-drivers*))
    (dotimes (s5-0 (length (-> *net-drivers* gp-0 ai-car-levels)))
      (let ((s4-0 (-> *net-drivers* gp-0 ai-car-levels s5-0)))
        (if (not (find-prebuilt-ai-vehicle s4-0))
            (format 0 "can't find vehicle ~A~%" s4-0)
            )
        )
      )
    )
  0
  )

;; definition for symbol *net-world-load-levels*, type (array symbol)
(define *net-world-load-levels* (new 'static 'boxed-array :type symbol :length 0 :allocated-length 18))

;; definition for symbol *net-world-display-levels*, type (array symbol)
(define *net-world-display-levels* (new 'static 'boxed-array :type symbol :length 0 :allocated-length 18))

;; definition for symbol *net-world-load-levels2*, type (array symbol)
(define *net-world-load-levels2* (new 'static 'boxed-array :type symbol :length 0 :allocated-length 18))

;; definition for symbol *net-task-mask*, type task-mask
(define *net-task-mask* (task-mask))

;; definition for symbol *waiting-for-lock*, type symbol
(define *waiting-for-lock* #f)

;; definition for symbol *net-world-entity-hash*, type int
(define *net-world-entity-hash* 0)

;; definition for function set-net-task-mask
;; WARN: Return type mismatch int vs object.
(defun set-net-task-mask ((arg0 task-mask))
  (set! *net-task-mask*
        (logior (-> *game-info* sub-task-list (-> *net-world* task-node) task-mask) (task-mask never))
        )
  0
  )

;; definition for function convert-load-parts-to-car-info
;; WARN: Return type mismatch int vs none.
(defun convert-load-parts-to-car-info ((arg0 vehicle-load-parts) (arg1 car-info-full))
  (set! (-> arg1 current-parts 0) (the-as int (-> arg0 f-fender)))
  (set! (-> arg1 current-parts 1) (the-as int (-> arg0 r-fender)))
  (set! (-> arg1 current-parts 2) (the-as int (-> arg0 door)))
  (set! (-> arg1 current-parts 3) (the-as int (-> arg0 f-bumper)))
  (set! (-> arg1 current-parts 4) (the-as int (-> arg0 r-bumper)))
  (set! (-> arg1 current-parts 5) (the-as int (-> arg0 hood)))
  (set! (-> arg1 current-parts 6) (the-as int (-> arg0 trunk)))
  (set! (-> arg1 current-parts 7) (the-as int (-> arg0 roof)))
  (set! (-> arg1 current-parts 8) (the-as int (-> arg0 wheel)))
  (set! (-> arg1 current-parts 9) (the-as int (-> arg0 antenna)))
  (set! (-> arg1 current-parts 10) (the-as int (-> arg0 helmet)))
  0
  (none)
  )

;; definition for function convert-car-info-to-load-parts
(defun convert-car-info-to-load-parts ((arg0 car-info-full))
  (copy-and-set-field
    (the-as
      vehicle-load-parts
      (copy-and-set-field
        (the-as
          vehicle-load-parts
          (copy-and-set-field
            (the-as
              vehicle-load-parts
              (copy-and-set-field
                (the-as
                  vehicle-load-parts
                  (copy-and-set-field
                    (the-as
                      vehicle-load-parts
                      (copy-and-set-field
                        (the-as
                          vehicle-load-parts
                          (copy-and-set-field
                            (the-as
                              vehicle-load-parts
                              (copy-and-set-field
                                (the-as
                                  vehicle-load-parts
                                  (copy-and-set-field
                                    (the-as
                                      vehicle-load-parts
                                      (copy-and-set-field
                                        (the-as
                                          vehicle-load-parts
                                          (copy-and-set-field (new 'static 'vehicle-load-parts) f-fender (-> arg0 current-parts 0))
                                          )
                                        r-fender
                                        (-> arg0 current-parts 1)
                                        )
                                      )
                                    door
                                    (-> arg0 current-parts 2)
                                    )
                                  )
                                f-bumper
                                (-> arg0 current-parts 3)
                                )
                              )
                            r-bumper
                            (-> arg0 current-parts 4)
                            )
                          )
                        hood
                        (-> arg0 current-parts 5)
                        )
                      )
                    trunk
                    (-> arg0 current-parts 6)
                    )
                  )
                roof
                (-> arg0 current-parts 7)
                )
              )
            wheel
            (-> arg0 current-parts 8)
            )
          )
        antenna
        (-> arg0 current-parts 9)
        )
      )
    helmet
    (-> arg0 current-parts 10)
    )
  )

;; definition for function cleanup-at-game-end
;; WARN: Return type mismatch int vs object.
(defun cleanup-at-game-end ((arg0 net-world))
  (when (and (= *game-mode* 'adventure) (not (-> *game-info* playing-grand-prix?)))
    (let ((v1-5 (get-open-task-node-info)))
      (when v1-5
        (+! (-> *game-info* total-trys) 1)
        (+! (-> v1-5 play-count) 1)
        )
      )
    )
  (kill-by-type explosion *active-pool*)
  (kill-by-type oil-slick *active-pool*)
  (kill-by-type slip-object *active-pool*)
  (kill-by-type smoke-system *active-pool*)
  (kill-by-type slip-object *active-pool*)
  (kill-by-type lightning-sphere *active-pool*)
  (kill-by-type oil-trail *active-pool*)
  (when *in-game-menu-process*
    (deactivate (-> *in-game-menu-process* 0))
    (set! *in-game-menu-process* (the-as (pointer hud) #f))
    )
  (set-action!
    *gui-control*
    (gui-action stop)
    (the-as sound-id 1)
    (gui-channel speech)
    (gui-action none)
    (the-as string #f)
    (the-as (function gui-connection symbol) #f)
    (the-as process #f)
    )
  (sound-group-pause (sound-group sfx))
  (set-master-mode 'game)
  (sound-group-pause (sound-group sfx))
  (set! (-> *game-info* turbo-disabled) -1)
  (set! (-> *game-info* turbo-last-disabled) 0)
  (disable (-> *screen-filter-array* 0))
  (disable (-> *screen-filter-array* 1))
  (disable (-> *screen-filter-array* 2))
  (check-particles)
  0
  )

;; definition for method 7 of type net-world
;; WARN: Return type mismatch process-nettable vs net-world.
(defmethod relocate ((this net-world) (offset int))
  (set! *net-world* this)
  (if *net-world*
      (set! *net-world* (&+ *net-world* offset))
      )
  (the-as net-world ((method-of-type process-nettable relocate) this offset))
  )

;; definition for method 10 of type net-world
(defmethod deactivate ((this net-world))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (set! *net-world* #f)
  (dma-release 'title-control)
  ((method-of-type process-nettable deactivate) this)
  (none)
  )

;; definition for function check-start-load
;; WARN: Return type mismatch int vs object.
(defbehavior check-start-load net-world ()
  (when (-> self need-start-load)
    (want-levels *load-state* (-> *net-world-load-levels* data))
    (dotimes (gp-0 6)
      (if (-> *net-world-load-levels2* gp-0)
          (want-display-level *load-state* (-> *net-world-load-levels2* gp-0) (-> *net-world-display-levels* gp-0))
          )
      )
    (set! (-> self need-start-load) #f)
    )
  0
  )

;; definition for symbol *font-context-loading*, type font-context
(define *font-context-loading* (new
                                 'global
                                 'font-context
                                 *font-default-matrix*
                                 0
                                 0
                                 8396850.0
                                 (font-color default)
                                 (font-flags shadow kerning)
                                 )
        )

;; definition for function do-loading-text
;; WARN: Return type mismatch int vs object.
(defbehavior do-loading-text net-world ()
  (let ((gp-0 *font-context-loading*))
    (set-origin! gp-0 0 200)
    (set-scale! gp-0 1.0)
    (set-width! gp-0 512)
    (set-height! gp-0 100)
    (let ((a0-4 gp-0))
      (set! (-> a0-4 effect) (the-as uint 19))
      )
    (let ((v1-5 gp-0)
          (f0-10 (* 0.0033333334 (the float (current-time))))
          )
      (set! (-> v1-5 effect-time) (- f0-10 (* (the float (the int (/ f0-10 14400.0))) 14400.0)))
      )
    (set! (-> gp-0 flags) (font-flags kerning middle large ff12))
    (let ((a0-10 gp-0))
      (set! (-> a0-10 color) (font-color font-color-62))
      )
    (let ((a0-12 (lookup-text! *common-text* (text-id text-id-2632) #f)))
      (print-game-text a0-12 gp-0 #f 44 (bucket-id hud-draw-hud-alpha) (the-as string #f) (the-as dma-buffer #f))
      )
    )
  0
  )

;; definition for symbol *movie-string*, type string
(define *movie-string* (the-as string 0))

;; definition for function do-movie
;; WARN: Return type mismatch int vs object.
;; WARN: new jak 2 until loop case, check carefully
(defbehavior do-movie net-world ((arg0 string))
  (set! *movie-string* arg0)
  (lobby-level-set! 1 'fmvlev #f)
  (check-start-load)
  (until #f
    (let ((v1-2 (level-get *level* 'fmvlev)))
      (if (and v1-2 (= (-> v1-2 status) 'loaded))
          (goto cfg-8)
          )
      )
    (suspend)
    )
  #f
  (label cfg-8)
  (let ((a0-4 *movie-string*))
    (fmv-player-run a0-4 *target-pool* #f)
    )
  (while *fmv-player*
    (suspend)
    )
  (suspend)
  (lobby-level-set! 1 #f #f)
  (if (not (demo?))
      (check-start-load)
      )
  0
  )

;; definition for function wait-target-load
;; WARN: Return type mismatch int vs object.
;; WARN: new jak 2 until loop case, check carefully
(defun wait-target-load ()
  (format 0 "waiting for loading to cease~%")
  (while (and (view-get-active-target)
              (-> (view-get-active-target) next-state)
              (= (-> (view-get-active-target) next-state name) 'target-continue)
              )
    (suspend)
    )
  (until #f
    (let ((v1-5 #f))
      (dotimes (a0-2 6)
        (when (-> *level* level a0-2 name)
          (if (not (or (= (-> *level* level a0-2 status) 'loaded)
                       (= (-> *level* level a0-2 status) 'alive)
                       (= (-> *level* level a0-2 status) 'active)
                       (= (-> *level* level a0-2 status) 'inactive)
                       )
                   )
              (set! v1-5 #t)
              )
          )
        )
      (if (not v1-5)
          (goto cfg-26)
          )
      )
    (suspend)
    )
  #f
  (label cfg-26)
  (format 0 "waiting for loading to cease - done~%")
  0
  )

;; definition for function load-sound-banks
;; WARN: Return type mismatch symbol vs none.
(defbehavior load-sound-banks net-world ()
  (let ((v1-0 (get-open-task-node-info)))
    (dotimes (a0-0 1)
      (set! (-> *load-state* want-sound a0-0 name) (-> self cont want-sound a0-0))
      (set! (-> *load-state* want-sound a0-0 mode) (sound-bank-mode full))
      )
    (if (and v1-0 (and (-> v1-0 sound-bank) (!= (if *net-world*
                                                    (the-as int (-> *net-world* task-node-info net-play-mode))
                                                    18
                                                    )
                                                18
                                                )
                       )
             )
        (set! (-> *load-state* want-sound 0 name) (-> v1-0 sound-bank))
        )
    )
  (none)
  )

;; definition for function do-late-join
(defbehavior do-late-join net-world ()
  (set! (-> *net-process-mgr*
            machines
            (if *net-mgr*
                (-> *net-mgr* game-state local-machine-idx)
                0
                )
            state
            )
        (net-process-mgr-machine-state staging)
        )
  (format 0 "we are a late joiner...~%")
  (while (logtest? (-> self net-state flags) 1)
    (check-start-load)
    (suspend)
    )
  (set! (-> self is-late-join) #f)
  (format 0 "we're not anymore...~%")
  (set! (-> *net-mgr* game-state sm-eligible) (not (-> self is-late-join)))
  (send-event *lobby-menu-manager* 'green-room-game-start)
  (go-virtual running #f)
  )

;; definition for symbol *tmp-reset-string*, type string
(define *tmp-reset-string* (new 'global 'string 128 (the-as string #f)))

;; definition for symbol *last-flash*, type symbol
(define *last-flash* #f)

;; definition for function check-host-timeout
;; WARN: Return type mismatch int vs object.
(defun check-host-timeout ()
  (when (and *lobby-menu-manager*
             (= (if *net-mgr*
                    (-> *net-mgr* game-state local-machine-idx)
                    0
                    )
                (-> *net-mgr* game-state session-master-idx)
                )
             (= *ready-room-host-id* (if *net-mgr*
                                         (-> *net-mgr* game-state local-machine-idx)
                                         0
                                         )
                )
             (nonzero? (-> *net-mgr* lobby-state connect-handle))
             )
    (let ((s5-0 (- (-> *display* real-clock frame-counter) (the-as int (-> *cpad-list* cpads 0 real-change-time)))))
      (when (< (seconds 180) s5-0)
        (let ((v1-14 (make-sound-instance snd-mine-explode (new 'static 'sound-id) (the-as handle #f))))
          (cond
            (v1-14
              (set! (-> v1-14 volume) 3072)
              (logior! (-> v1-14 flags) (sound-spec-flag needs-update non-positional))
              (-> v1-14 id)
              )
            (else
              0
              )
            )
          )
        (send-event *net-mgr* 'leave-game)
        (send-event *lobby-menu-manager* 'lobby-host-activity-timeout)
        (kick-machines
          (logclear
            (-> *net-mgr* game-state connected-bitfield)
            (ash 1 (if *net-mgr*
                       (-> *net-mgr* game-state local-machine-idx)
                       0
                       )
                 )
            )
          'host-activity-timeout
          )
        )
      (when (< (seconds 150) s5-0)
        (let ((gp-0 (- (seconds 180) s5-0)))
          (cond
            ((when (and (< 50 (mod s5-0 300)) (< (mod s5-0 300) 250))
               (when (not *last-flash*)
                 (let ((v1-37 (make-sound-instance snd-chooser (new 'static 'sound-id) (the-as handle #f))))
                   (cond
                     (v1-37
                       (set! (-> v1-37 volume) 3072)
                       (logior! (-> v1-37 flags) (sound-spec-flag needs-update non-positional))
                       (-> v1-37 id)
                       )
                     (else
                       0
                       )
                     )
                   )
                 )
               (set! *last-flash* #t)
               (let ((s5-1 (new
                             'stack
                             'font-context
                             *font-default-matrix*
                             0
                             0
                             8396850.0
                             (font-color default)
                             (font-flags shadow kerning)
                             )
                           )
                     )
                 (set-width! s5-1 384)
                 (set-height! s5-1 416)
                 (set! (-> s5-1 scale) 1.0)
                 (set! (-> s5-1 flags) (font-flags kerning middle middle-vert large ff12))
                 (set! (-> s5-1 color) (if (< gp-0 (seconds 11))
                                           (font-color red)
                                           (font-color font-color-60)
                                           )
                       )
                 (set! (-> s5-1 effect) (the-as uint 8))
                 (let ((v1-48 s5-1))
                   (set! (-> v1-48 effect-time) 0.0)
                   )
                 (logior! (-> s5-1 flags) (font-flags ff8))
                 (set! (-> s5-1 alpha) 1.0)
                 (set-vector! (-> s5-1 origin) 64.0 0.0 65535.0 1.0)
                 (format *stdcon* " ")
                 (with-dma-buffer-add-bucket ((s3-0 (-> *display* frames (-> *display* on-screen) global-buf))
                                              (bucket-id debug-menu)
                                              )
                   (format
                     (clear *tmp-reset-string*)
                     (lookup-text! *common-text* (text-id text-id-3483) #f)
                     (the int (* 0.0033333334 (the float gp-0)))
                     )
                   (print-game-text *tmp-reset-string* s5-1 #f 44 (bucket-id hud-draw-hud-alpha) (the-as string #f) s3-0)
                   )
                 )
               )
             )
            (else
              (set! *last-flash* #f)
              )
            )
          )
        )
      )
    )
  0
  )

;; definition for function do-encode-net-world-state
;; WARN: Return type mismatch int vs object.
(defun do-encode-net-world-state ((arg0 net-world-state) (arg1 mem-buffer))
  (let ((s4-0 0))
    (encode-net-world-state arg0 arg1)
    (dotimes (s3-0 24)
      (when (and (< s4-0 6) (player-connected? s3-0))
        (write-int8 arg1 s3-0)
        (write-bytes arg1 (the-as pointer (-> arg0 players s3-0)) 32)
        (write-int8 arg1 (-> arg0 assigned-drivers-s8 s3-0))
        (write-string arg1 (-> *net-player-names* s3-0 name))
        (+! s4-0 1)
        )
      )
    )
  (write-int8 arg1 -1)
  0
  0
  )

;; definition for function wait-for-lock
;; WARN: Return type mismatch int vs object.
(defbehavior wait-for-lock net-world ()
  (set! *waiting-for-lock* #t)
  (let ((gp-0 (-> *display* real-clock frame-counter)))
    (until (logtest? (-> self net-state flags) 1)
      (check-start-load)
      (suspend)
      (check-host-timeout)
      (when (and (and *net-mgr*
                      *net-world*
                      (nonzero? (-> *net-mgr* lobby-state connect-handle))
                      (= (if *net-world*
                             (the-as int (-> *net-world* task-node-info net-play-mode))
                             18
                             )
                         3
                         )
                      *ghosts-enabled*
                      )
                 (not *ghost-info-ptr*)
                 )
        (set! *ghost-info-ptr* (the-as pointer (get-best-ghost-info (the-as int (-> self task-info task-level)))))
        (if (not *ghost-info-ptr*)
            (set! *ghost-info-ptr* (the-as pointer 'error))
            )
        (update-ai-players self)
        )
      (when (and (< (seconds 5) (- (-> *display* real-clock frame-counter) gp-0))
                 (= (if *net-mgr*
                        (-> *net-mgr* game-state local-machine-idx)
                        0
                        )
                    (-> *net-mgr* game-state session-master-idx)
                    )
                 )
        (set! gp-0 (-> *display* real-clock frame-counter))
        (format 0 "sending state~%")
        (let ((s5-0 (alloc-msg self 'state)))
          (do-encode-net-world-state (-> self net-state) s5-0)
          (send-msg self s5-0 -2 80)
          (free-msg self s5-0)
          )
        )
      (when (nonzero? (-> *net-mgr* lobby-state connect-handle))
        (dotimes (s5-1 8)
          (let ((v1-40 (-> *net-process-mgr* machines s5-1)))
            (if (and (nonzero? (-> v1-40 state)) (> (-> v1-40 acct-id) 0))
                (lookup *medius-player-cache* (-> v1-40 acct-id) #x4650 #f #f)
                )
            )
          )
        )
      )
    )
  (set! *waiting-for-lock* #f)
  (set! *ghost-info-ptr* (the-as pointer #f))
  0
  )

;; definition for function wait-for-ghost-download
;; WARN: Return type mismatch int vs object.
(defbehavior wait-for-ghost-download net-world ()
  (format 0 "waiting for any ghost downloads to finish~%")
  (while (handle->process (-> *ghost-download-proc* handle))
    (suspend)
    )
  (format 0 "done...~%")
  (when *ghosts-enabled*
    (logand! (-> self net-state flags) -2)
    (update-ai-players self)
    (let ((gp-0 -1))
      (dotimes (s5-0 24)
        (set! (-> self net-state players s5-0 player-num) (cond
                                                            ((player-idx-vehicle-selected? self s5-0)
                                                             (+! gp-0 1)
                                                             gp-0
                                                             )
                                                            (else
                                                              -1
                                                              )
                                                            )
              )
        )
      )
    (logior! (-> self net-state flags) 1)
    )
  0
  )

;; definition for function save-vehicle-camera-inside-state
;; WARN: Return type mismatch symbol vs object.
(defun save-vehicle-camera-inside-state ()
  (dotimes (gp-0 *active-net-player-count*)
    (let ((s5-0 (-> *active-net-players* gp-0)))
      (when s5-0
        (when (if (= (/ (-> s5-0 player-id) 2) (if *net-mgr*
                                                   (-> *net-mgr* game-state local-machine-idx)
                                                   0
                                                   )
                     )
                  #t
                  #f
                  )
          (let ((a0-4 (get-vehicle s5-0)))
            (if a0-4
                (set! (-> *game-info* player-info (-> s5-0 view index) camera-inside-view)
                      (the-as symbol (send-event a0-4 'query 'camera-inside-view))
                      )
                )
            )
          )
        )
      )
    )
  #f
  )

;; definition for function set-net-world-time-of-day
;; WARN: Return type mismatch int vs object.
(defun set-net-world-time-of-day ((arg0 net-world))
  (cond
    ((and (!= *game-mode* 'adventure) (!= (-> *net-world* net-state time-of-day) -1))
     (send-event (ppointer->process *time-of-day*) 'change 'ratio 0.0)
     (send-event (ppointer->process *time-of-day*) 'change 'hour (-> *net-world* net-state time-of-day))
     (send-event (ppointer->process *time-of-day*) 'change 'minutes 0)
     (send-event (ppointer->process *time-of-day*) 'change 'seconds 0)
     (send-event (ppointer->process *time-of-day*) 'change 'frames 0)
     )
    (else
      (when (and arg0 (!= (-> arg0 pid) -1))
        (send-event (ppointer->process *time-of-day*) 'change 'ratio 0.0)
        (send-event (ppointer->process *time-of-day*) 'change 'hour (-> arg0 pid))
        (send-event (ppointer->process *time-of-day*) 'change 'minutes 0)
        (send-event (ppointer->process *time-of-day*) 'change 'seconds 0)
        (send-event (ppointer->process *time-of-day*) 'change 'frames 0)
        )
      )
    )
  0
  )

;; definition for function wait-for-lobby-to-die
;; WARN: Return type mismatch int vs object.
(defun wait-for-lobby-to-die ()
  (while (!= (-> *setting-control* user-current bg-a) 1.0)
    (set-setting! 'bg-a 'abs 1.0 0)
    (apply-settings! *setting-control*)
    (suspend)
    )
  (while *lobby-menu-manager*
    (suspend)
    )
  (lobby-level-set! 0 (-> *lobby-levels* 0) #f)
  (want-display-level *load-state* 'menu2 #f)
  (suspend)
  0
  )

;; definition for function check-grand-prix-restart
;; WARN: Return type mismatch int vs object.
(defbehavior check-grand-prix-restart net-world ()
  (when (= *net-mgr-finish-mode* 'restart)
    (let ((v1-2 (-> *game-info* playing-grand-prix?)))
      (when v1-2
        (when (< (-> *game-info* grand-prix-index) (the-as uint 3))
          (dotimes (a0-3 23)

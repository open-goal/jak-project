;; definition for function player-connected?
(defun player-connected? ((arg0 int))
  (if (not (and *net-process-mgr* *net-world*))
      (return #f)
      )
  (if (>= arg0 16)
      (return (player-idx-vehicle-selected? *net-world* arg0))
      )
  (if (player-idx-vehicle-selected? *net-world* arg0)
      (return #t)
      )
  (let ((v1-16 (-> *net-process-mgr* machines (/ arg0 2))))
    (if (= (-> v1-16 state) (net-process-mgr-machine-state none))
        (return #f)
        )
    (if (or (not (logtest? arg0 1)) (< 1 (-> v1-16 local-player-ct)))
        (return #t)
        )
    )
  #f
  )

;; definition for method 35 of type net-world
;; WARN: Return type mismatch int vs none.
(defmethod init-remote ((this net-world) (arg0 mem-buffer))

           (= (if *net-world*
                  (the-as int (-> *net-world* task-node-info net-play-mode))
                  18
                  )
              14
              )
           )
       )
      ((or (is-clan-challenge)
           (= (if *net-world*
                  (the-as int (-> *net-world* task-node-info net-play-mode))
                  18
                  )
              7
              )
           (= (if *net-world*
                  (the-as int (-> *net-world* task-node-info net-play-mode))
                  18
                  )
              9
              )

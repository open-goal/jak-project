;; definition for function allow-machine-to-join
(defun allow-machine-to-join ((arg0 int) (arg1 int) (arg2 int))
  (set! *place-player-ct* 0)
  (dotimes (v1-0 8)
    (let ((a3-2 (-> *net-process-mgr* machines v1-0)))
      (dotimes (t0-1 (-> a3-2 local-player-ct))
        (set! (-> *place-players* *place-player-ct*) a3-2)
        (set! *place-player-ct* (+ *place-player-ct* 1))
        )

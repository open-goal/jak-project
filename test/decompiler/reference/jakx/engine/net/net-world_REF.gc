                    )
                   (else
                     (set! (-> this net-state players s3-0 team-id) (the-as uint 1))
                     (+! s4-0 1)
                     )
                   )
                 )
                ((zero? (-> this net-state players s3-0 team-id))
                 (+! s5-1 1)
                 )
                (else
                  (+! s4-0 1)
                  )
                )
              )
            )
          (dotimes (s3-1 8)
            (when (player-idx-vehicle-selected? this (+ s3-1 16))

      (set! (-> a1-1 2) #f)
      (set! (-> a1-1 1) #f)
      (set! (-> a1-1 0) 'menu2)
      (want-levels *load-state* a1-1)
      )
    (until #f
      (let ((v1-5 (new 'stack-no-clear 'array 'int32 2)))
        (when (dma-try-alloc #xd2800 #xd2800 'title-control 0 (&-> v1-5 0) (&-> v1-5 1) #f)
          (suspend)
          (suspend)
          (goto cfg-5)
          )
        )
      (suspend)
      0
      )
    #f
    (label cfg-5)
    (title-control-spawn #t)
    (suspend-for (seconds 10)
      )
    (when (not (-> *setting-control* user-current render))
      (set-setting! 'bg-a 'abs 1.0 0)
      (apply-settings! *setting-control*)
      (while (!= (-> *setting-control* user-current bg-a) 1.0)
        (suspend)
        )
      (kill-persister *setting-control* 'title-control-scene 'render)
      (remove-setting! 'render)
      (apply-settings! *setting-control*)
      (set-blackout-frames (seconds 100000))
      )
    (set-blackout-frames (seconds 100000))
    (remove-setting! 'bg-a)
    (dma-release 'title-control)
    (set-blackout-frames (seconds 3.335))
    (start 'play (get-continue-by-name *game-info* "menu2-start") 0)
    (go-virtual running #f)
    )
  )

;; failed to figure out what this is:
(defstate play-movie (net-world)

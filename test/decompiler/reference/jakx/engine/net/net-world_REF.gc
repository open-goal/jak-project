      (setup
        *screen-filter*
        gp-0
        (new 'static 'vector :w 128.0)
        (* 2.0 (seconds-per-frame))
        (bucket-id debug)
        #x3fffff
        #x33001
        (the-as symbol 0)
        )
      )
    (until (= (-> *screen-filter* color w) 128.0)

                 (set! (-> this net-state players (+ s3-1 16) team-id) (the-as uint 2))
                 )
                ((>= s4-0 s5-1)
                 (set! (-> this net-state players (+ s3-1 16) team-id) (the-as uint 0))
                 (+! s5-1 1)
                 )
                (else
                  (set! (-> this net-state players (+ s3-1 16) team-id) (the-as uint 1))
                  (+! s4-0 1)
                  )
                )
              )
            )
          )
        )
      (else
        (let ((s5-2 0))
          (dotimes (s4-1 24)
            (when (player-idx-vehicle-selected? this s4-1)
              (set! (-> this net-state players s4-1 team-id) (the-as uint s5-2))
              (+! s5-2 1)
              )
            )
          )
        )
      )
    )
  0
  (none)
  )


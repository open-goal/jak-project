;; definition for function allow-machine-to-join-rec
(defun allow-machine-to-join-rec ((arg0 int) (arg1 int) (arg2 int) (arg3 int))
  (if (= arg0 *place-player-ct*)
      (return #t)
      )
  (let ((s2-0 (-> *place-players* arg0)))
    (when (nonzero? (-> *net-mgr* lobby-state connect-handle))
      (if (and (> arg2 0)
               (contains? *medius-buddies* (-> s2-0 acct-id))
               (allow-machine-to-join-rec (+ arg0 1) arg1 (+ arg2 -1) arg3)
               )
          (return #t)
          )
      (if (and (> arg1 0)
               (!= (-> s2-0 acct-id) (-> *net-process-mgr*
                                         machines
                                         (if *net-mgr*
                                             (-> *net-mgr* game-state local-machine-idx)
                                             0
                                             )
                                         acct-id
                                         )
                   )
               (= (-> s2-0 clan-id) (-> *net-process-mgr*
                                        machines
                                        (if *net-mgr*
                                            (-> *net-mgr* game-state local-machine-idx)
                                            0
                                            )
                                        clan-id
                                        )
                  )
               (contains? (-> *medius-my-clan* members) (-> s2-0 acct-id))
               (allow-machine-to-join-rec (+ arg0 1) (+ arg1 -1) arg2 arg3)
               )
          (return #t)
          )
      )
    )
  (if (and (> arg3 0) (allow-machine-to-join-rec (+ arg0 1) arg1 arg2 (+ arg3 -1)))
      (return #t)
      )
  #f
  )

;; definition for method 82 of type net-world

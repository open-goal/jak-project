          )
      (read-bytes arg1 (the-as pointer (-> arg0 players s4-1)) 32)
      (set! (-> arg0 assigned-drivers s4-1) (the-as uint (read-int8 arg1)))
      (read-string arg1 (-> *net-player-names* s4-1 name))

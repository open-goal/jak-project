       (set! s5-0 #t)
       )
      ((= (if *net-world*
              (the-as int (-> *net-world* task-node-info net-play-mode))
              18
              )
          1
          )
       )
      ((logtest? (-> this net-state options advanced-options flags) (game-task-advanced-options-flag team-game))
       (set! s5-0 #t)
       )
      )
    (if s5-0
        (logior! (-> this net-state flags) 4)
        (logand! (-> this net-state flags) -5)

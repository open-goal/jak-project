;; definition for function net-world-init-local
;; WARN: Return type mismatch int vs object.
(defbehavior net-world-init-local net-world ()
  (logclear! (-> self mask) (process-mask pause menu))
  (stack-size-set! (-> self main-thread) 1600)
  (set! *net-world* self)
  (set! (-> self is-late-join) #f)
  (dotimes (v1-4 24)
    (set! (-> self player-to-vehicle-slot-map v1-4) (the-as uint -1))
    (set! (-> self net-state players v1-4 vehicle-selection) -1)
    (set! (-> self net-state players v1-4 desired-driver-selection) -1)
    (set! (-> self net-state players v1-4 player-num) -1)
    (set! (-> self net-state assigned-drivers v1-4) (the-as uint -1))
    (set! (-> self net-state players v1-4 team-id) (the-as uint -1))
    )
  (set! (-> self net-state clan-ids 0) (the-as uint -1))
  (set! (-> self net-state clan-ids 1) (the-as uint -1))
  (when (and *net-mgr* (nonzero? (-> *net-mgr* lobby-state connect-handle)))
    (let ((gp-0 (new 'stack-no-clear 'inline-array 'mem-buffer 1)))
      (set-buffer! (-> gp-0 0) (-> *medius-joined-game-info* game-stats) 256)
      (read-int32 (-> gp-0 0))
      (set! (-> self net-state clan-ids 0) (the-as uint (read-int32 (-> gp-0 0))))
      (set! (-> self net-state clan-ids 1) (the-as uint (read-int32 (-> gp-0 0))))
      )
    )
  (dotimes (v1-22 6)
    (set! (-> self vehicle-slot-to-player-map v1-22) (the-as uint -1))
    )
  (set! (-> self current-garage-player) -1)
  (set! (-> self current-garage-spare-slot) -1)
  (let ((gp-1 (new 'stack-no-clear 'inline-array 'sce-cd-clock 1)))
    (knet-get-local-rtc (-> gp-1 0))
    (set! (-> self net-state game-creator-ip) (net-get-local-ip))
    (set! (-> self net-state game-creation-time) (the-as uint (rtclock-to-secs (-> gp-1 0))))
    )
  (copy-charp<-charp
    (-> self net-state task-node-name)
    (-> *game-info* sub-task-list (game-task-node kras-race-task) name data)
    )
  (if (not (beta?))
      (copy-charp<-charp
        (-> self net-state task-node-name)
        (-> *game-info* sub-task-list (game-task-node snow-race-task) name data)
        )
      )
  (apply-task self)
  (set! (-> self net-state player-ready-flags) (the-as uint 0))
  (set! (-> self net-state flags) 0)
  (set! (-> self net-state ai-slots) -1)
  (set! (-> self net-state max-humans) 6)
  (register self 8 998)
  (if *net-log-write*
      (net-log-world-ident)
      )
  (go-virtual running #f)
  0
  )


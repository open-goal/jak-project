;; definition for symbol *medius-muis-hostname*, type string
(define *medius-muis-hostname* (the-as string #f))

;; definition for symbol *medius-muis-port*, type int
(define *medius-muis-port* #x2757)

;; definition for symbol *medius-muis-id*, type int
(define *medius-muis-id* 1)

;; definition for function set-muis-hostname
;; WARN: Return type mismatch int vs none.
(defun set-muis-hostname ()
  (set! *medius-muis-port* #x2757)
  (set! *medius-muis-id* 1)
  (set! *scert-function-id* (scert-function get-application-id))
  (let ((gp-0 (knet-scert-function-0-args)))
    (format 0 "appid is ~D~%" gp-0)
    (set! *medius-muis-hostname* (cond
                                   ((= gp-0 #x2aee)
                                    "blob125.scea.com"
                                    )
                                   ((= gp-0 #x2aef)
                                    "jakx-pubeta.muis.pdonline.scea.com"
                                    )
                                   ((= gp-0 #x2af0)
                                    "jakx-qa.muis.pdonline.scea.com"
                                    )
                                   ((= gp-0 #x2af2)
                                    "jakx-prod.muis.pdonline.scea.com"
                                    )
                                   ((= gp-0 #x2bc3)
                                    (set! *medius-muis-port* #x2760)
                                    "jakx-palpbtrials.muis.online.scee.com"
                                    )
                                   ((= gp-0 #x2bc0)
                                    (set! *medius-muis-port* #x2760)
                                    "jakx-paldev.muis.online.scee.com"
                                    )
                                   ((= gp-0 #x2bc4)
                                    (set! *medius-muis-port* #x2760)
                                    "jakx-palpreprod1.muis.online.scee.com"
                                    )
                                   (else
                                     ""
                                     )
                                   )
          )
    )
  (when (zero? (-> *medius-muis-hostname* data 0))
    (format 0 "bad appid?~%")
    (break!)
    0
    )
  0
  (none)
  )

;; definition for function construct-patch-file-name
;; WARN: Swapped fp-relative label and field offsets for "jakx.pat"
;; WARN: Swapped fp-relative label and field offsets for "VMODE"
;; WARN: Return type mismatch int vs object.
(defun construct-patch-file-name ()
  (mem-copy! *jakx-patch-tmp* (knet-get-scus) 128)
  (set! (-> *jakx-patch-tmp* 127) (the-as uint 0))
  (copy-charp<-charp (-> *jakx-patch-file* data) (-> "jakx.pat" data))
  (let ((v1-4 (strstr *jakx-patch-tmp* (-> "VMODE" data))))
    (if (not v1-4)
        (return (the-as object #f))
        )
    (set! (-> (the-as (pointer int8) v1-4)) 0)
    )
  (format
    (clear *jakx-patch-file*)
    "~8X.jak"
    (logand (the-as uint #xffffffff) (knet-crc *jakx-patch-tmp* (strlen *jakx-patch-tmp*)))
    )
  0
  )

;; definition for function muis-connect-callback
;; INFO: Called from C
;; WARN: Return type mismatch int vs object.
(defun muis-connect-callback ((arg0 pointer))
  (format 0 "muis-connect-callback: ~X~%" arg0)
  (when *net-mgr*
    (set! (-> *net-mgr* lobby-state connect-handle-muis) arg0)
    (set! (-> *net-mgr* lobby-state callback-occurred) #t)
    (if (zero? arg0)
        (set! (-> *net-mgr* lobby-state got-error) #t)
        )
    )
  0
  )

;; definition for function muis-news-callback
;; INFO: Called from C
;; WARN: Return type mismatch int vs object.
(defun muis-news-callback ((arg0 medius-universe-news-response))
  (format 0 "muis-news-callback~%")
  (inspect arg0)
  (when (nonzero? (-> arg0 status-code))
    (set! (-> *net-mgr* lobby-state callback-status) (the-as int (-> arg0 status-code)))
    (set! (-> *net-mgr* lobby-state got-error) #t)
    (return (the-as object #f))
    )
  (format #t "news : ~G~%" (-> arg0 news))
  0
  )

;; definition for function muis-info-callback
;; WARN: Swapped fp-relative label and field offsets for "$~NGS"
;; INFO: Called from C
;; WARN: Return type mismatch int vs object.
(defun muis-info-callback ((arg0 medius-universe-variable-information-response))
  (format 0 "muis-info-callback~%")
  (inspect arg0)
  (when (nonzero? (-> arg0 status-code))
    (set! (-> *net-mgr* lobby-state callback-status) (the-as int (-> arg0 status-code)))
    (set! (-> *net-mgr* lobby-state got-error) #t)
    (return (the-as object #f))
    )
  (format #t "name : ~G~%" (-> arg0 universe-name))
  (format #t "desc : ~G~%" (-> arg0 universe-description))
  (format #t "dns  : ~G~%" (-> arg0 dns))
  (set! *net-universe-is-ngs* #f)
  (when (strstr (-> arg0 universe-name) (-> "$~NGS" data))
    (set! *net-universe-is-ngs* #t)
    (format 0 "NGS universe~%")
    )
  (when (= (-> arg0 universe-id) *medius-muis-id*)
    (copy-charp<-charp (-> *medius-mas-hostname* data) (-> arg0 dns))
    (set! *medius-mas-port* (-> arg0 port))
    (mem-copy! *net-patch-url* (-> arg0 extended-info) 128)
    )
  (if (nonzero? (-> arg0 end-of-list))
      (set! (-> *net-mgr* lobby-state callback-occurred) #t)
      )
  0
  )

;; failed to figure out what this is:
(defstate getting-universe-information (net-mgr)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('leave-lobby)
       (go-virtual leaving-lobby)
       )
      (else
        (net-mgr-default-handler proc argc message block)
        )
      )
    )
  :code (behavior ()
    (set! (-> *net-patch-url* 0) (the-as uint 0))
    (set-muis-hostname)
    (let ((gp-0 (get-host-by-name (-> *medius-muis-hostname* data) (seconds 10))))
      (if (zero? gp-0)
          (lobby-fatal-error 'dns-lookup-failed)
          )
      (format-ip (the-as uint gp-0) *tmp-hostname*)
      )
    (mem-clear! (the-as pointer *medius-connect-in-params*) 284)
    (mem-clear! (the-as pointer *medius-connect-out-params*) 8)
    (set! *scert-function-id* (scert-function medius-connect-in-params-defaults))
    (knet-scert-function-5-args *medius-connect-in-params* 0 (-> *tmp-hostname* data) *medius-muis-port* 1)
    (set! (-> *medius-connect-in-params* my-connect-callback) muis-connect-callback)
    (set! *scert-function-id* (scert-function get-server-public-key))
    (knet-scert-function-1-args *medius-public-key*)
    (mem-copy!
      (the-as pointer (-> *medius-connect-in-params* connect-info server-key))
      (the-as pointer *medius-public-key*)
      64
      )
    (format
      0
      "MUIS: connecting to ~G:~D~%"
      (-> *medius-connect-in-params* connect-info address-list a-address-list 0 address)
      (-> *medius-connect-in-params* connect-info address-list a-address-list 0 port)
      )
    (reset-lobby-state! self)
    (set! *scert-function-id* (scert-function medius-connect))
    (let ((gp-1 (knet-scert-function-3-args *medius-connect-in-params* *medius-connect-out-params* #f)))
      (when (nonzero? gp-1)
        (format 0 "initial function call returned ~D~%" gp-1)
        (set! (-> self lobby-state got-error) #t)
        (set! (-> self lobby-state last-medius-error) gp-1)
        )
      )
    (net-async-wait (seconds 20) #t)
    (cond
      ((or (-> self lobby-state got-error)
           (-> self lobby-state timeout)
           (nonzero? (-> self lobby-state last-medius-error))
           (nonzero? (-> self lobby-state last-mgcl-error))
           (nonzero? (-> self lobby-state last-dme-error))
           (nonzero? (-> self lobby-state callback-status))
           )
       (lobby-fatal-error 'lobby-connect-failed)
       )
      (else
        )
      )
    (format 0 "connected~%")
    (set! (-> *medius-mas-hostname* data 0) (the-as uint 0))
    (set! *medius-mas-port* 0)
    (format 0 "getting info...~%")
    (let ((gp-2 (new 'stack-no-clear 'medius-server-world-status-response)))
      (mem-clear! (-> gp-2 message-id) 36)
      (set! (-> gp-2 application-id) 382)
      (set! (-> gp-2 max-clients) 2)
      (set! (-> gp-2 active-clients) 1)
      (reset-lobby-state! self)
      (set! *scert-function-id* (scert-function medius-get-universe-information))
      (let ((gp-3 (knet-scert-function-5-args (-> gp-2 message-id) muis-news-callback muis-info-callback 0 0)))
        (when (nonzero? gp-3)
          (format 0 "initial function call returned ~D~%" gp-3)
          (set! (-> self lobby-state got-error) #t)
          (set! (-> self lobby-state last-medius-error) gp-3)
          )
        )
      )
    (net-async-wait (seconds 20) #t)
    (cond
      ((or (-> self lobby-state got-error)
           (-> self lobby-state timeout)
           (nonzero? (-> self lobby-state last-medius-error))
           (nonzero? (-> self lobby-state last-mgcl-error))
           (nonzero? (-> self lobby-state last-dme-error))
           (nonzero? (-> self lobby-state callback-status))
           )
       (lobby-fatal-error 'lobby-connect-failed)
       )
      (else
        )
      )
    (format 0 "got info~%")
    (do-disconnect #f #f #t)
    (set! (-> self lobby-state connect-handle-muis) (the-as pointer 0))
    (if (zero? *medius-mas-port*)
        (lobby-fatal-error 'no-universe)
        )
    (when *debug-segment*
      (set! (-> *net-patch-url* 0) (the-as uint 0))
      0
      )
    (let ((gp-4 (strstr *net-patch-url* (-> " " data))))
      (when gp-4
        (set! (-> (the-as (pointer int8) gp-4)) 0)
        (construct-patch-file-name)
        (copy-charp<-charp *net-patch-version* *net-patch-url*)
        (copy-charp<-charp *net-patch-url* (the-as (pointer uint8) (&+ gp-4 1)))
        (copy-charp<-charp (&+ *net-patch-url* (strlen *net-patch-url*)) (-> *jakx-patch-file* data))
        (let ((a1-22 (knet-get-kernel-version-string)))
          (when (not (strncmp *net-patch-version* a1-22 -1))
            (send-event *lobby-menu-manager* 'lobby-patch-required)
            (go-virtual idle)
            )
          )
        )
      )
    (let ((gp-6 (get-host-by-name (-> *medius-mas-hostname* data) (seconds 20))))
      (if (zero? gp-6)
          (lobby-fatal-error 'dns-lookup-failed)
          )
      (format-ip (the-as uint gp-6) *medius-mas-hostname*)
      )
    (go-virtual connecting-to-mas)
    )
  )

;; failed to figure out what this is:
(defstate dns-lookup (net-mgr)
  :virtual #t
  :code (behavior ((arg0 string))
    (let ((a3-0 (get-host-by-name (-> arg0 data) (seconds 20))))
      (format 0 "lookup ~A: ~X~%" arg0 a3-0)
      )
    (go-virtual idle)
    )
  )

(defun can-start-clan-challenge ()
  (dotimes (v1-0 8)
    (when (logtest? (-> *net-mgr* game-state connected-bitfield) (ash 1 v1-0))
      (if (!= (-> *net-process-mgr* machines v1-0 clan-id) (-> *medius-my-clan* medius-id))
          (return (the-as object #t))
          )
      )
    )
  #f
  )


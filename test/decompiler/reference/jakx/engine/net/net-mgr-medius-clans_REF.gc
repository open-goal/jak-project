;; definition for function get-my-clans-callback
;; INFO: Called from C
;; WARN: Return type mismatch int vs object.
(defun get-my-clans-callback ((arg0 medius-get-my-clans-response))
  (mem-copy! (the-as pointer *medius-last-response*) (the-as pointer arg0) 1024)
  (cond
    ((= (-> arg0 status-code) (medius-status-code medius-no-result))
     (set! (-> *net-mgr* lobby-state callback-occurred) #t)
     )
    ((= (-> arg0 status-code) (medius-status-code medius-success))
     (when (not *in-clan*)
       (set! (-> *medius-my-clan* medius-id) (-> arg0 clan-id))
       (mem-copy! (-> *medius-my-clan* name) (-> arg0 clan-name) 32)
       (set! (-> *medius-my-clan* leader-acct-id) (-> arg0 leader-account-id))
       (mem-copy! (-> *medius-my-clan* leader-name) (-> arg0 leader-account-name) 32)
       (mem-copy! (-> *medius-my-clan* stats) (-> arg0 stats) 256)
       (set! *in-clan* #t)
       (remove! *medius-recent-clans* (-> arg0 clan-id))
       )
     )
    (else
      (set! (-> *net-mgr* lobby-state got-error) #t)
      )
    )
  (if (= (-> arg0 end-of-list) 1)
      (set! (-> *net-mgr* lobby-state callback-occurred) #t)
      )
  0
  )


;; definition for function retrieve-my-clan-data
;; WARN: Return type mismatch int vs object.
(defbehavior retrieve-my-clan-data net-mgr ()
  (get-my-clans)
  (when (!= (-> *medius-my-player* stats current-clan) (-> *medius-my-clan* medius-id))
    (set! (-> *medius-my-player* stats current-clan) (-> *medius-my-clan* medius-id))
    (medius-start-account-stats-update #t #t)
    )
  (when (!= (-> *medius-my-clan* medius-id) -1)
    (medius-clan-info-retrieve-behavior *medius-my-clan*)
    (get-clan-msg)
    )
  (set! (-> *medius-outstanding-clan-invites* ct) 0)
  (when (and (!= (-> *medius-my-clan* medius-id) -1)
             (= (-> *medius-my-clan* leader-acct-id) (-> *net-mgr* lobby-state my-account-id))
             )
    (let ((gp-0 (new 'stack 'medius-get-clan-invitations-sent-request)))
      (set! *async-request-ct* (+ *async-request-ct* 1))
      (itoa *async-request-ct* (-> gp-0 message-id))
      (mem-copy! (-> gp-0 session-key) *medius-session-key* 17)
      (set! (-> gp-0 page-size) 64)
      (set! (-> gp-0 start) 1)
      (reset-lobby-state! self)
      (set! *scert-function-id* (scert-function medius-get-clan-invitations-sent))
      (let ((gp-1 (knet-scert-function-3-args gp-0 clan-invitations-sent-callback *medius-outstanding-clan-invites*)))
        (when (nonzero? gp-1)
          (format 0 "initial function call returned ~D~%" gp-1)
          (set! (-> self lobby-state got-error) #t)
          (set! (-> self lobby-state last-medius-error) gp-1)
          )
        )
      )
    (net-async-wait (seconds 15) #t)
    (cond
      ((or (-> self lobby-state got-error)
           (-> self lobby-state timeout)
           (nonzero? (-> self lobby-state last-medius-error))
           (nonzero? (-> self lobby-state last-mgcl-error))
           (nonzero? (-> self lobby-state last-dme-error))
           (nonzero? (-> self lobby-state callback-status))
           )
       *medius-last-response*
       (return (the-as object #f))
       )
      (else
        *medius-last-response*
        0
        )
      )
    )
  (check-my-clan-invitations)
  (when (and (!= (-> *medius-my-clan* medius-id) -1)
             (= (-> *medius-my-clan* leader-acct-id) (-> *net-mgr* lobby-state my-account-id))
             )
    (get-clan-challenges)
    (tidy-clan-challenges)
    (when (!= (-> *medius-my-clan* ladder-stats version) 12)
      (init-stats! *net-clan-ladder-stats-info* (-> *medius-my-clan* ladder-stats))
      (update-computed-stats! *net-clan-ladder-stats-info* (-> *medius-my-clan* ladder-stats))
      (medius-start-clan-stats-update)
      )
    )
  0
  )


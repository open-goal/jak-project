(defmethod medius-clan-method-11 ((this medius-clan))
  (let ((v0-1 (lookup *medius-clan-cache* (get-id this) 9000 #f #f)))
    (if (= v0-1 'error)
        (set! v0-1 #f)
        )
    (the-as medius-cached-info-clan v0-1)
    )
  )

;; definition for symbol *last-medius-clan*, type int

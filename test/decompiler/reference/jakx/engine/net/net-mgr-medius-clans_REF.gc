      (return 3)
      )
    (when (and s5-0 (zero? (-> s5-0 status)))
      (set! (-> arg2 0) (-> s5-0 challenge-id))
      (return 0)
      )
    (when (and v1-0 (zero? (-> v1-0 status)))
      (set! (-> arg2 0) (-> v1-0 challenge-id))
      (return 1)
      )
    (when (and s5-0 (= (-> s5-0 status) 3))
      (set! (-> arg2 0) (-> s5-0 challenge-id))
      (return 2)
      )
    (if (and v1-0 (= (-> v1-0 status) 3))
        (return (the-as int #f))

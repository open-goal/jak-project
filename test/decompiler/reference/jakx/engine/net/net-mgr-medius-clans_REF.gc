      )
  0
  )

;; definition for function get-clan-msg
;; WARN: Return type mismatch symbol vs object.
(defbehavior get-clan-msg net-mgr ()
  (mem-clear! *clan-msg-text* 200)
  (set! *clan-msg-id* -1)
  (cond
    ((and (!= (-> *medius-my-clan* medius-id) -1)
          (= (-> *medius-my-clan* leader-acct-id) (-> *net-mgr* lobby-state my-account-id))
          )
     (let ((gp-0 (new 'stack 'medius-get-all-clan-messages-request)))
       (set! *async-request-ct* (+ *async-request-ct* 1))
       (itoa *async-request-ct* (-> gp-0 message-id))
       (mem-copy! (-> gp-0 session-key) *medius-session-key* 17)
       (set! (-> gp-0 start) 0)
       (set! (-> gp-0 page-size) 100)
       (reset-lobby-state! self)
       (set! *scert-function-id* (scert-function medius-get-all-clan-messages))
       (let ((gp-1 (knet-scert-function-3-args gp-0 clan-msg-callback-all #f)))
         (when (nonzero? gp-1)
           (format 0 "initial function call returned ~D~%" gp-1)
           (set! (-> self lobby-state got-error) #t)
           (set! (-> self lobby-state last-medius-error) gp-1)
           )
         )
       )
     (net-async-wait (seconds 15) #t)
     (cond
       ((or (-> self lobby-state got-error)
            (-> self lobby-state timeout)
            (nonzero? (-> self lobby-state last-medius-error))
            (nonzero? (-> self lobby-state last-mgcl-error))
            (nonzero? (-> self lobby-state last-dme-error))
            (nonzero? (-> self lobby-state callback-status))
            )
        *medius-last-response*
        (let ((v1-25 #f))
          (set! *net-mgr-pending-behavior-result-extra* '())
          (return (the-as object v1-25))
          )
        )
       (else
         *medius-last-response*
         0
         )
       )
     )
    ((begin
       (let ((gp-2 (new 'stack 'medius-get-my-clan-messages-request)))
         (set! *async-request-ct* (+ *async-request-ct* 1))
         (itoa *async-request-ct* (-> gp-2 message-id))
         (mem-copy! (-> gp-2 session-key) *medius-session-key* 17)
         (set! (-> gp-2 clan-id) (-> *medius-my-clan* medius-id))
         (set! (-> gp-2 start) 0)
         (set! (-> gp-2 page-size) 100)
         (reset-lobby-state! self)
         (set! *scert-function-id* (scert-function medius-get-my-clan-messages))
         (let ((gp-3 (knet-scert-function-3-args gp-2 clan-msg-callback-my #f)))
           (when (nonzero? gp-3)
             (format 0 "initial function call returned ~D~%" gp-3)
             (set! (-> self lobby-state got-error) #t)
             (set! (-> self lobby-state last-medius-error) gp-3)
             )
           )
         )
       (net-async-wait (seconds 15) #t)
       (or (-> self lobby-state got-error)
           (-> self lobby-state timeout)
           (nonzero? (-> self lobby-state last-medius-error))
           (nonzero? (-> self lobby-state last-mgcl-error))
           (nonzero? (-> self lobby-state last-dme-error))
           (nonzero? (-> self lobby-state callback-status))
           )
       )
     *medius-last-response*
     (let ((v1-49 #f))
       (set! *net-mgr-pending-behavior-result-extra* '())
       (return (the-as object v1-49))
       )
     )
    (else
      *medius-last-response*
      0
      )
    )
  'success
  )


    (if (not (and (< -1 (-> *medius-my-clan* medius-id)) (or (= (-> *medius-my-clan* medius-id) (-> arg0 info clan-1))
                                                             (= (-> *medius-my-clan* medius-id) (-> arg0 info clan-2))
                                                             )
                  )
             )
        (return #f)
        )
    )
  #t
  )


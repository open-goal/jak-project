      0
      )
    )
  (retrieve-my-clan-data)
  (init-stats! *net-clan-ladder-stats-info* (-> *medius-my-clan* ladder-stats))
  (update-computed-stats! *net-clan-ladder-stats-info* (-> *medius-my-clan* ladder-stats))
  (let ((gp-2 (new 'stack 'medius-update-ladder-stats-wide-request)))
    (set! *async-request-ct* (+ *async-request-ct* 1))
    (itoa *async-request-ct* (-> gp-2 message-id))
    (set! (-> gp-2 ladder-type) (medius-ladder-type medius-ladder-type-clan))
    (mem-copy! (-> gp-2 stats) (the-as pointer (-> *medius-my-clan* ladder-stats)) 36)
    (reset-lobby-state! self)
    (set! *scert-function-id* (scert-function medius-update-ladder-stats-wide))
    (let ((gp-3 (knet-scert-function-3-args gp-2 medius-simple-request-callback #f)))

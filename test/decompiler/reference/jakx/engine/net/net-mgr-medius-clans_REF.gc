;; definition for function is-clan-challenge
;; WARN: Return type mismatch object vs symbol.
(defun is-clan-challenge ()
  (the-as symbol (and *net-mgr*
                      *net-process-mgr*
                      *net-world*
                      (!= (-> *medius-my-clan* medius-id) -1)
                      (nonzero? (-> *net-mgr* lobby-state connect-handle))
                      (>= (-> *net-world* net-state clan-ids-s32 0) 0)
                      (>= (-> *net-world* net-state clan-ids-s32 1) 0)
                      (!= (if *net-world*
                              (the-as int (-> *net-world* task-node-info net-play-mode))
                              18
                              )
                          3
                          )
                      (or (= (-> *net-world* net-state clan-ids-s32 0) (-> *medius-my-clan* medius-id))
                          (= (-> *net-world* net-state clan-ids-s32 1) (-> *medius-my-clan* medius-id))
                          )
                      )
          )
  )


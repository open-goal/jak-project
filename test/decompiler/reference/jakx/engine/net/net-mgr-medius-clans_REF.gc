(define *clan-update-busy* #f)

;; definition for symbol *this-game-penalty*, type int
(define *this-game-penalty* 0)

;; definition for function should-i-update-clan-stats
(defun should-i-update-clan-stats ()
  (if (not (is-clan-challenge))
      (return #f)
      )
  (dotimes (gp-0 8)
    (-> *net-process-mgr* machines gp-0)
    (if (and (player-connected? (* gp-0 2))
             (= (-> *net-process-mgr* machines gp-0 clan-id) (-> *medius-my-clan* medius-id))
             )
        (return (= gp-0 (if *net-mgr*
                            (-> *net-mgr* game-state local-machine-idx)
                            0
                            )
                   )
                )
        )
    )
  #f
  )

;; definition for function get-all-clan-stats
;; WARN: Return type mismatch int vs object.
(defbehavior get-all-clan-stats net-world ()
  (let ((gp-0 *clan-get-stats-request*))
    (mem-clear! (the-as pointer gp-0) 32)
    (set! (-> gp-0 account-id-or-clan-id) *medius-enemy-clan-id*)
    (set! (-> gp-0 ladder-type) (medius-ladder-type medius-ladder-type-clan))
    (set! *clan-update-busy* #t)
    (set! *scert-function-id* (scert-function medius-get-ladder-stats-wide))
    (if (nonzero? (knet-scert-function-3-args
                    gp-0
                    (lambda ((arg0 medius-get-ladder-stats-wide-response))
                      (inspect arg0)
                      (set! *clan-update-busy* #f)
                      (if (= (-> arg0 status-code) (medius-status-code medius-success))
                          (mem-copy! (the-as pointer *enemy-clan-current-stats*) (-> arg0 stats) 36)
                          )
                      )
                    0
                    )
                  )
        (return (the-as object #f))
        )
    )
  (while *clan-update-busy*
    (suspend)
    )
  (let ((gp-1 *clan-get-stats-request*))
    (mem-clear! (the-as pointer gp-1) 32)
    (set! (-> gp-1 account-id-or-clan-id) (-> *medius-my-clan* medius-id))
    (set! (-> gp-1 ladder-type) (medius-ladder-type medius-ladder-type-clan))
    (mem-copy! (the-as pointer *clan-current-stats*) (the-as pointer (-> *medius-my-clan* ladder-stats)) 36)
    (set! *clan-update-busy* #t)
    (set! *scert-function-id* (scert-function medius-get-ladder-stats-wide))
    (if (nonzero? (knet-scert-function-3-args
                    gp-1
                    (lambda ((arg0 medius-get-ladder-stats-wide-response))
                      (inspect arg0)
                      (set! *clan-update-busy* #f)
                      (if (= (-> arg0 status-code) (medius-status-code medius-success))
                          (mem-copy! (the-as pointer *clan-current-stats*) (-> arg0 stats) 36)
                          )
                      )
                    0
                    )
                  )
        (return (the-as object #f))
        )
    )
  (while *clan-update-busy*
    (suspend)
    )
  0
  )

;; definition for function make-new-score
(defun make-new-score ((arg0 int) (arg1 int) (arg2 symbol) (arg3 symbol))
  (format 0 "making new score... win=~A lost=~A~%" arg2 arg3)
  (let ((s5-2 (cond
                (arg2
                  (max 1 (min 25 (/ (+ arg1 19) 20)))
                  )
                (arg3
                  (- (max 1 (min 25 (/ (+ arg0 19) 20))))
                  )
                (else
                  0
                  )
                )
              )
        (s4-1 arg0)
        )
    (format 0 "deltas is ~D~%" s5-2)
    (- (max 1 (min 10000 (+ arg0 s5-2))) s4-1)
    )
  )

;; definition for function post-game-clan-stats-adjust
;; WARN: Return type mismatch int vs object.
(defun post-game-clan-stats-adjust ((arg0 symbol))
  (set! *clan-pending-deltas-valid* #f)
  (if (not (should-i-update-clan-stats))
      (return (the-as object #f))
      )
  (mem-clear! (the-as pointer *clan-pending-deltas*) 36)
  (set! *clan-pending-deltas-valid* #t)
  (when (= arg0 'finish)
    (let ((gp-1 (-> *net-players*
                    (* (if *net-mgr*
                           (-> *net-mgr* game-state local-machine-idx)
                           0
                           )
                       2
                       )
                    team
                    )
                )
          )
      (cond
        ((zero? (if *net-world*
                    (the-as int (-> *net-world* task-node-info net-play-mode))
                    18
                    )
                )
         (set! (-> *clan-pending-deltas* events-played) (the-as uint 1))
         (let ((a0-5 (-> *net-players* (-> *net-game-mgr* sorted-ids-s8 0))))
           (when a0-5
             (if (= (-> a0-5 team) gp-1)
                 (set! (-> *clan-pending-deltas* events-won) (the-as uint 1))
                 (set! (-> *clan-pending-deltas* events-lost) (the-as uint 1))
                 )
             )
           )
         )
        (else
          (let ((s5-0 (calc-team-score (the-as int gp-1)))
                (v1-26 (calc-team-score (the-as int (- 1 (the-as int gp-1)))))
                )
            (if (< v1-26 s5-0)
                (set! (-> *clan-pending-deltas* events-won) (the-as uint 1))
                )
            (if (< s5-0 v1-26)
                (set! (-> *clan-pending-deltas* events-lost) (the-as uint 1))
                )
            (if (= s5-0 v1-26)
                (set! (-> *clan-pending-deltas* events-drawn) (the-as uint 1))
                )
            )
          (set! (-> *clan-pending-deltas* events-played) (the-as uint 1))
          )
        )
      )
    (set! (-> *clan-pending-deltas* overall-score)
          (the-as uint (make-new-score
                         (the-as int (-> *clan-current-stats* overall-score))
                         (the-as int (-> *enemy-clan-current-stats* overall-score))
                         (= (-> *clan-pending-deltas* events-won) 1)
                         (= (-> *clan-pending-deltas* events-lost) 1)
                         )
                  )
          )
    )
  (+! (-> *clan-pending-deltas* overall-score) *this-game-penalty*)
  0
  )

;; definition for function apply-clan-deltas
;; WARN: Return type mismatch int vs object.
(defun apply-clan-deltas ()
  (if (not *clan-pending-deltas-valid*)
      (return (the-as object #f))
      )
  (set! *clan-pending-deltas-valid* #f)
  (mem-copy! (the-as pointer (-> *medius-my-clan* ladder-stats)) (the-as pointer *clan-current-stats*) 36)
  (let ((v1-5 (the-as (pointer int32) (-> *medius-my-clan* ladder-stats)))
        (a0-1 (the-as (pointer int32) *clan-pending-deltas*))
        )
    (dotimes (a1-1 9)
      (+! (-> v1-5 0) (-> a0-1 0))
      (set! (-> v1-5 0) (max (-> *net-clan-ladder-stats-info-array* a1-1 init) (-> v1-5 0)))
      (set! v1-5 (&-> v1-5 1))
      (set! a0-1 (&-> a0-1 1))
      )
    )
  (mem-clear! (the-as pointer *clan-update-stats-request*) 428)
  (update-computed-stats! *net-clan-ladder-stats-info* (-> *medius-my-clan* ladder-stats))
  (let ((v1-12 (the-as (pointer int32) (-> *medius-my-clan* ladder-stats)))
        (a0-4 (the-as (pointer int32) *clan-current-stats*))
        (a1-5 (-> *clan-update-stats-request* stats))
        )
    (dotimes (a2-9 9)
      (set! (-> a1-5 0) (the-as uint (- (-> v1-12 0) (-> a0-4 0))))
      (set! v1-12 (&-> v1-12 1))
      (set! a0-4 (&-> a0-4 1))
      (set! a1-5 (&-> a1-5 1))
      )
    )
  (let ((gp-0 *clan-update-stats-request*))
    (set! (-> gp-0 clan-id) (-> *medius-my-clan* medius-id))
    (set! *clan-update-busy* #t)
    (inspect gp-0)
    (set! *scert-function-id* (scert-function medius-update-clan-ladder-stats-wide-delta))
    (if (nonzero? (knet-scert-function-3-args
                    gp-0
                    (lambda ((arg0 medius-status-response)) (inspect arg0) (set! *clan-update-busy* #f) #f)
                    0
                    )
                  )
        (return (the-as object #f))
        )
    )
  (while *clan-update-busy*
    (suspend)
    )
  0
  )

;; definition for function pre-game-clan-stats-adjust
;; WARN: Return type mismatch int vs object.
(defbehavior pre-game-clan-stats-adjust net-world ((arg0 symbol))
  (if (not (is-clan-challenge))
      (return (the-as object #f))
      )
  (set! *medius-enemy-clan-id*
        (if (= (-> *net-world* net-state clan-ids-s32 0) (-> *medius-my-clan* medius-id))
            (-> *net-world* net-state clan-ids-s32 1)
            (-> *net-world* net-state clan-ids-s32 0)
            )
        )
  (get-all-clan-stats)
  (set! *this-game-penalty* (min 5 (the-as int (+ (-> *clan-current-stats* overall-score) -1))))
  (set! *clan-pending-deltas-valid* #f)
  (if (not (should-i-update-clan-stats))
      (return (the-as object #f))
      )
  (let ((gp-0 (-> *net-players*
                  (* (if *net-mgr*
                         (-> *net-mgr* game-state local-machine-idx)
                         0
                         )
                     2
                     )
                  team
                  )
              )
        )
    (calc-team-score (the-as int gp-0))
    (calc-team-score (the-as int (- 1 (the-as int gp-0))))
    )
  (mem-clear! (the-as pointer *clan-pending-deltas*) 36)
  (set! (-> *clan-pending-deltas* overall-score) (the-as uint (- *this-game-penalty*)))
  (set! *clan-pending-deltas-valid* #t)
  (apply-clan-deltas)
  0
  )

;; definition for function get-clans-in-challenge-info
;; WARN: Return type mismatch int vs object.
;; WARN: new jak 2 until loop case, check carefully
(defbehavior get-clans-in-challenge-info net-mgr ((arg0 net-available-game))
  (if (not (and (> (-> arg0 info clan-1) 0) (> (-> arg0 info clan-2) 0)))
      (return (the-as object #f))
      )
  (cond
    ((= (-> arg0 info clan-1) (-> *medius-my-clan* medius-id))
     (set! (-> *medius-enemy-clan* medius-id) (-> arg0 info clan-2))
     (set! (-> *challenge-clans* 0) *medius-my-clan*)
     (set! (-> *challenge-clans* 1) *medius-enemy-clan*)
     )
    (else
      (set! (-> *medius-enemy-clan* medius-id) (-> arg0 info clan-1))
      (set! (-> *challenge-clans* 0) *medius-enemy-clan*)
      (set! (-> *challenge-clans* 1) *medius-my-clan*)
      )
    )
  (until #f
    (let ((a1-3 (lookup *medius-clan-cache* (-> *medius-enemy-clan* medius-id) 9000 #f #f)))
      (when (and a1-3 (!= a1-3 'error))
        (medius-cached-info-clan-method-12 *medius-enemy-clan* (the-as medius-cached-info-clan a1-3))
        (return (the-as object #f))
        )
      )
    (medius-cache-tick *medius-clan-cache*)
    (suspend)
    0
    )
  #f
  0
  )

;;-*-Lisp-*-
(in-package goal)

;; definition for symbol *medius-player-account-id*, type int
(define *medius-player-account-id* 0)

;; definition for function buddies-refreshing-callback
;; INFO: Called from C
;; WARN: Return type mismatch int vs object.
(defun buddies-refreshing-callback ((arg0 medius-get-buddy-list-extra-info-response))
  (mem-copy! (the-as pointer *medius-last-response*) (the-as pointer arg0) 1024)
  (cond
    ((= (-> arg0 status-code) (medius-status-code medius-no-result))
     (set! (-> *net-mgr* lobby-state callback-occurred) #t)
     )
    ((= (-> arg0 status-code) (medius-status-code medius-success))
     (add! *medius-buddies* (-> arg0 account-id))
     (if (or (= (-> arg0 online-state connect-status) (medius-player-status medius-player-in-chat-world))
             (= (-> arg0 online-state connect-status) (medius-player-status medius-player-in-game-world))
             (= (-> arg0 online-state connect-status) (medius-player-status medius-player-in-other-universe))
             )
         (add! *medius-buddies-online* (-> arg0 account-id))
         )
     )
    (else
      (set! (-> *net-mgr* lobby-state got-error) #t)
      )
    )
  (if (= (-> arg0 end-of-list) 1)
      (set! (-> *net-mgr* lobby-state callback-occurred) #t)
      )
  0
  )

;; definition for function buddies-refreshing
;; WARN: Return type mismatch symbol vs object.
(defbehavior buddies-refreshing net-mgr ()
  (local-vars (v0-6 symbol))
  (set! (-> *medius-buddies* ct) 0)
  (set! (-> *medius-buddies-online* ct) 0)

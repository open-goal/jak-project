    (set! *async-request-ct* (+ *async-request-ct* 1))
    (itoa *async-request-ct* (-> gp-0 message-id))
    (reset-lobby-state! self)
    (set! *scert-function-id* (scert-function medius-get-buddy-list-extra-info))
    (let ((gp-1 (knet-scert-function-3-args gp-0 buddies-refreshing-callback #f)))
      (when (nonzero? gp-1)
        (format 0 "initial function call returned ~D~%" gp-1)
        (set! (-> self lobby-state got-error) #t)
        (set! (-> self lobby-state last-medius-error) gp-1)
        )
      )
    )
  (net-async-wait (seconds 15) #t)
  (cond
    ((or (-> self lobby-state got-error)
         (-> self lobby-state timeout)
         (nonzero? (-> self lobby-state last-medius-error))
         (nonzero? (-> self lobby-state last-mgcl-error))
         (nonzero? (-> self lobby-state last-dme-error))
         (nonzero? (-> self lobby-state callback-status))
         )
     *medius-last-response*
     (let ((v1-19 #f))
       (set! *net-mgr-pending-behavior-result-extra* '())
       (return (the-as object v1-19))
       )
     )
    (else
      *medius-last-response*
      0
      )
    )
  (format 0 "net-mgr-notify: ~A~%" 'buddy-list-ready)
  (let ((a0-9 (-> *net-mgr* notify alive-list next0)))
    (-> *net-mgr* notify)
    (let ((gp-2 (-> a0-9 next0)))
      (while (!= a0-9 (-> *net-mgr* notify alive-list-end))
        (if (logtest? (the-as int (-> (the-as connection a0-9) param1)) 10)
            (send-event
              ((method-of-type connection get-process) (the-as connection a0-9))
              'buddy-list-ready
              :from *net-mgr*
              )
            )
        (set! a0-9 gp-2)
        (-> *net-mgr* notify)
        (set! gp-2 (-> gp-2 next0))
        )
      )
    )
  (let ((v1-43 'success))
    (set! *net-mgr-pending-behavior-result-extra* '())
    (return (the-as object v1-43))
    )
  v0-6
  )


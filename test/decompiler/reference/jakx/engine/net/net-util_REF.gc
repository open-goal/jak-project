;; definition for symbol *tmp-buf-len*, type int
(define *tmp-buf-len* 0)

;; definition for function read-sound-line
;; WARN: Return type mismatch symbol vs object.
(defun read-sound-line ((arg0 file-stream))
  (when (< *tmp-buf-len* 128)
    (let ((gp-0 (- 1024 *tmp-buf-len*)))
      (when (> gp-0 0)
        (let ((v1-5 (file-stream-read arg0 (&+ *tmp-buf* *tmp-buf-len*) gp-0)))
          (if (and (zero? v1-5) (= gp-0 1024))
              (return (the-as object #f))
              )
          (set! *tmp-buf-len* (+ *tmp-buf-len* v1-5))
          )
        )
      )
    )
  (let ((v1-7 0)
        (gp-1 0)
        )
    (dotimes (a0-4 *tmp-buf-len*)
      (case (-> (the-as (pointer int8) (&+ *tmp-buf* a0-4)))
        ((10)
         (set! gp-1 (+ a0-4 1))
         (set! (-> *tmp-line* v1-7) (the-as uint 0))
         (goto cfg-19)
         )
        ((13)
         )
        (else
          (set! (-> *tmp-line* v1-7) (the-as uint (-> (the-as (pointer int8) (&+ *tmp-buf* a0-4)))))
          (+! v1-7 1)
          )
        )
      )
    (label cfg-19)
    (mem-copy! *tmp-buf* (&+ *tmp-buf* gp-1) (- 1024 gp-1))
    (set! *tmp-buf-len* (- *tmp-buf-len* gp-1))
    )
  #t
  )

;; definition for function crappy-atof
(defun crappy-atof ((arg0 (pointer int8)))
  (let ((f28-0 0.0)
        (f26-0 1.0)
        (f30-0 1.0)
        )
    (when (= (-> arg0 0) 45)
      (set! f30-0 -1.0)
      (set! arg0 (&-> arg0 1))
      )
    (dotimes (s5-0 (strlen arg0))
      (let ((v1-7 (-> arg0 s5-0)))
        (cond
          ((= v1-7 46)
           (set! f26-0 0.1)
           )
          ((= f26-0 1.0)
           (set! f28-0 (+ (* 10.0 f28-0) (the float (+ v1-7 -48))))
           )
          (else
            (+! f28-0 (* f26-0 (the float (+ v1-7 -48))))
            (set! f26-0 (/ f26-0 10))
            )
          )
        )
      )
    (* f28-0 f30-0)
    )
  )

;; definition for function tweak-sound
;; WARN: Return type mismatch int vs object.
(defun tweak-sound ((arg0 sound-info) (arg1 symbol) (arg2 (pointer int8)))
  (let ((f0-0 (crappy-atof arg2)))
    (when (!= arg1 'flags)
      )
    (cond
      ((= arg1 'volume)
       (set! (-> arg0 volume) f0-0)
       )
      ((= arg1 'fo-min)
       (set! (-> arg0 fo-min) (* 4096.0 f0-0))
       )
      ((= arg1 'fo-max)
       (set! (-> arg0 fo-max) (* 4096.0 f0-0))
       )
      ((= arg1 'fo-power)
       (set! (-> arg0 fo-power) f0-0)
       )
      ((= arg1 'pan)
       (set! (-> arg0 pan) (* 182.04445 f0-0))
       )
      ((= arg1 'priority)
       (set! (-> arg0 priority) (the int f0-0))
       )
      ((= arg1 'duck-amount)
       (set! (-> arg0 duck-amount) f0-0)
       )
      ((= arg1 'duck-music?)
       (logior! (-> arg0 flags) (sound-info-flag duck-music))
       )
      ((= arg1 'duck-only-for-player?)
       (logior! (-> arg0 flags) (sound-info-flag duck-only-for-player))
       )
      )
    )
  0
  )


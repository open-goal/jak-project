;; definition for symbol *user-ct*, type int
(define *user-ct* 0)

;; definition for function broadcast-message
(defbehavior broadcast-message net-mgr ((arg0 object))
  (local-vars (v0-13 symbol))
  (let ((s5-0 (new 'stack 'medius-set-lobby-world-filter-request)))
    (set! *async-request-ct* (+ *async-request-ct* 1))
    (itoa *async-request-ct* (-> s5-0 message-id))
    (reset-lobby-state! self)
    (set! *scert-function-id* (scert-function medius-set-lobby-world-filter))
    (let ((s5-1 (knet-scert-function-3-args s5-0 medius-simple-request-callback #f)))
      (when (nonzero? s5-1)
        (format 0 "initial function call returned ~D~%" s5-1)
        (set! (-> self lobby-state got-error) #t)
        (set! (-> self lobby-state last-medius-error) s5-1)
        )
      )
    )
  (net-async-wait (seconds 15) #t)
  (cond
    ((or (-> self lobby-state got-error)
         (-> self lobby-state timeout)
         (nonzero? (-> self lobby-state last-medius-error))
         (nonzero? (-> self lobby-state last-mgcl-error))
         (nonzero? (-> self lobby-state last-dme-error))
         (nonzero? (-> self lobby-state callback-status))
         )
     *medius-last-response*
     (lobby-fatal-error 'lobby-connect-failed)
     )
    (else
      *medius-last-response*
      0
      )
    )
  (set! *channel-id-ct* 0)
  (let ((s5-2 (new 'stack 'medius-channel-list-extra-info-request)))
    (set! *async-request-ct* (+ *async-request-ct* 1))
    (itoa *async-request-ct* (-> s5-2 message-id))
    (set! (-> s5-2 page-size) (the-as uint 1000))
    (set! (-> s5-2 page-id) (the-as uint 1))
    (reset-lobby-state! self)
    (set! *scert-function-id* (scert-function medius-channel-list-extra-info))
    (let ((s5-3 (knet-scert-function-3-args
                  s5-2
                  (lambda ((arg0 medius-channel-list-extra-info-response))
                    (set! (-> *channel-ids* *channel-id-ct*) (-> arg0 medius-world-id))
                    (set! *channel-id-ct* (+ *channel-id-ct* 1))
                    (if (nonzero? (-> arg0 end-of-list))
                        (set! (-> *net-mgr* lobby-state callback-occurred) #t)
                        )
                    0
                    (none)
                    )
                  #f
                  )
                )
          )
      (when (nonzero? s5-3)
        (format 0 "initial function call returned ~D~%" s5-3)
        (set! (-> self lobby-state got-error) #t)
        (set! (-> self lobby-state last-medius-error) s5-3)
        )
      )
    )
  (net-async-wait (seconds 15) #t)
  (cond
    ((or (-> self lobby-state got-error)
         (-> self lobby-state timeout)
         (nonzero? (-> self lobby-state last-medius-error))
         (nonzero? (-> self lobby-state last-mgcl-error))
         (nonzero? (-> self lobby-state last-dme-error))
         (nonzero? (-> self lobby-state callback-status))
         )
     *medius-last-response*
     (let ((v1-39 #f))
       (set! *net-mgr-pending-behavior-result-extra* (the-as object #f))
       (return v1-39)
       )
     )
    (else
      *medius-last-response*
      0
      )
    )
  (set! *user-ct* 0)
  (dotimes (s5-4 *channel-id-ct*)
    (let ((s4-0 (new 'stack 'medius-get-lobby-player-names-request)))
      (set! *async-request-ct* (+ *async-request-ct* 1))
      (itoa *async-request-ct* (-> s4-0 message-id))
      (set! (-> s4-0 medius-world-id) (-> *channel-ids* s5-4))
      (reset-lobby-state! self)
      (set! *scert-function-id* (scert-function medius-get-lobby-player-names))
      (let ((s4-1 (knet-scert-function-3-args
                    s4-0
                    (lambda ((arg0 medius-get-lobby-player-names-response) (arg1 int))
                      (when (= (-> arg0 status-code) (medius-status-code medius-success))
                        (format #t "~G~%" (-> arg0 account-name))
                        (set! *user-ct* (+ *user-ct* 1))
                        (if arg1
                            (send-chat-msg *net-mgr* (the-as string arg1) (-> arg0 account-id) #f)
                            )
                        )
                      (if (nonzero? (-> arg0 end-of-list))
                          (set! (-> *net-mgr* lobby-state callback-occurred) #t)
                          )
                      (none)
                      )
                    arg0
                    )
                  )
            )
        (when (nonzero? s4-1)
          (format 0 "initial function call returned ~D~%" s4-1)
          (set! (-> self lobby-state got-error) #t)
          (set! (-> self lobby-state last-medius-error) s4-1)
          )
        )
      )
    (net-async-wait (seconds 15) #t)
    (cond
      ((or (-> self lobby-state got-error)
           (-> self lobby-state timeout)
           (nonzero? (-> self lobby-state last-medius-error))
           (nonzero? (-> self lobby-state last-mgcl-error))
           (nonzero? (-> self lobby-state last-dme-error))
           (nonzero? (-> self lobby-state callback-status))
           )
       *medius-last-response*
       (let ((v1-63 #f))
         (set! *net-mgr-pending-behavior-result-extra* '())
         (return v1-63)
         )
       )
      (else
        *medius-last-response*
        0
        )
      )
    )
  (format 0 "user-ct: ~D~%" *user-ct*)
  (let ((v1-70 #f))
    (set! *net-mgr-pending-behavior-result-extra* (the-as object #f))
    (return v1-70)
    )
  v0-13
  )

;; definition of type auto-test-levels
(deftype auto-test-levels (process)
  ((cur-task  int32)
   )
  (:state-methods
    running
    )
  )

;; definition for method 3 of type auto-test-levels
(defmethod inspect ((this auto-test-levels))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type process inspect)))
    (t9-0 this)
    )
  (format #t "~2Tcur-task: ~D~%" (-> this cur-task))
  (label cfg-4)
  this
  )

;; definition for symbol *auto-test-break*, type symbol
(define *auto-test-break* #f)

;; definition for function check-entities
;; WARN: Return type mismatch int vs object.
;; WARN: disable def twice: 44. This may happen when a cond (no else) is nested inside of another conditional, but it should be rare.
(defun check-entities ()
  (dotimes (gp-0 (-> *level* length))
    (let ((s5-0 (-> *level* level gp-0)))
      (when (= (-> s5-0 status) 'active)
        (when (not (or (= s5-0 (get-shared-level)) (= s5-0 (get-event-level))))
          (let* ((s4-0 (-> s5-0 entity))
                 (s3-0 (-> s4-0 length))
                 )
            (dotimes (s2-0 s3-0)
              (let ((s1-0 (as-type (-> s4-0 data s2-0 entity) entity-actor)))
                (when s1-0
                  (let* ((v1-11 (as-type s1-0 entity-actor))
                         (v1-12 (cond
                                  (v1-11
                                    (let ((s0-2 (-> (the-as entity-actor v1-11) etype)))
                                      (and (nonzero? s0-2)
                                           (= (-> s0-2 type symbol) 'type)
                                           (type-type? s0-2 process-nettable)
                                           (nonzero? (-> s0-2 method-table 40))
                                           )
                                      )
                                    )
                                  (else
                                    #f
                                    )
                                  )
                                )
                         )
                    (if (or v1-12 (and (-> (the-as entity-actor s1-0) etype) (type-type? (-> (the-as entity-actor s1-0) etype) eco)))
                        (format 0 "!!!!!!!!!!!!!!!! net-entity [~S] is in level ~A~%" (-> s1-0 name) (-> s5-0 name))
                        )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  0
  )

;; definition for function auto-test-node
;; WARN: Return type mismatch int vs object.
(defbehavior auto-test-node auto-test-levels ((arg0 object))
  (local-vars (v1-28 symbol))
  (set-task-node *net-world* (the-as game-task-node arg0))
  (suspend-for (seconds 0.5)
    )
  (suspend-for (seconds 0.5)
    )
  (set! (-> *net-world* net-state options advanced-options param1) (the-as uint 1))
  (lock-game *net-world*)
  (until *net-game-mgr*
    (suspend)
    )
  (suspend)
  (check-entities)
  (suspend)
  (until (> (-> *net-game-mgr* intro-end-time) 0)
    (suspend)
    )
  (suspend-for (seconds 1)
    )
  (until v1-28
    (suspend)
    (set! v1-28
          (and (!= (-> *net-game-mgr* intro-end-time) -1) (>= (- (- (- (if *net-mgr*
                                                                           (-> *net-mgr* game-state time)
                                                                           0
                                                                           )
                                                                       (if *net-world*
                                                                           (-> *net-world* net-state game-start-time)
                                                                           0
                                                                           )
                                                                       )
                                                                    (if *net-world*
                                                                        (-> *net-world* net-state total-pause-time)
                                                                        0
                                                                        )
                                                                    )
                                                                 (-> *net-game-mgr* intro-end-time)
                                                                 )
                                                              0
                                                              )
               )
          )
    )
  (until (or (!= -1 (-> *net-game-mgr* scheduled-finish-time))
             *auto-test-break*
             (>= (+ (- (- -300 (if *net-world*
                                   (-> *net-world* net-state total-pause-time)
                                   0
                                   )
                          )
                       (if *net-world*
                           (-> *net-world* net-state game-start-time)
                           0
                           )
                       )
                    (if *net-mgr*
                        (-> *net-mgr* game-state time)
                        0
                        )
                    )
                 0
                 )
             )
    (suspend-for (seconds 0.5)
      )
    (if (and (-> *net-players* 0) (get-vehicle (-> *net-players* 0)))
        (net-player-method-90 (-> *net-players* 0))
        )
    (when (= (-> *setting-control* cam-settings 0 current mode-name) 'cam-vehicle-crash)
      (set! *target-time-speed* 1.0)
      (kill-by-type hud-slowmo *active-pool*)
      )
    )
  (set! *auto-test-break* #f)
  (suspend-for (seconds 45)
    (suspend)
    )
  (format 0 "ending game...~%")
  (send-event *net-game-mgr* 'set-finish-time 0)
  0
  )

;; failed to figure out what this is:
(defstate running (auto-test-levels)
  :virtual #t
  :code (behavior ()
    (local-vars (v1-10 object))
    (when (not (and *lobby-menu-manager*
                    (-> *lobby-menu-manager* next-state)
                    (= (-> *lobby-menu-manager* next-state name) 'choose-event-menu)
                    )
               )
      (format 0 "wrong inintial state!~%")
      (return #f)
      )
    (let ((gp-0 0))
      (until #f
        (format 0 "... considering ~D~%" gp-0)
        (until v1-10
          (suspend)
          (set! v1-10
                (and *lobby-menu-manager*
                     *net-world*
                     (or (and (-> *lobby-menu-manager* next-state) (= (-> *lobby-menu-manager* next-state name) 'choose-event-menu))
                         (and (-> *lobby-menu-manager* next-state) (= (-> *lobby-menu-manager* next-state name) 'choose-event-menu))
                         )
                     )
                )
          )
        (let* ((s5-0 (-> *game-info* sub-task-list gp-0))
               (s4-0 (-> *game-info* play-list (-> s5-0 task)))
               (v1-29 *lobby-local-players*)
               (a1-2 (if (= v1-29 1)
                         (-> s4-0 play-continue)
                         (-> s4-0 split-continue)
                         )
                     )
               )
          (when (and a1-2 (and (nonzero? a1-2)
                               (get-continue-by-name *game-info* (the-as string a1-2))
                               (!= (-> s5-0 net-play-mode) 15)
                               (!= (-> s5-0 net-play-mode) 16)
                               (!= (-> s5-0 net-play-mode) 18)
                               (!= (-> s5-0 net-play-mode) 3)
                               (!= (-> s5-0 net-play-mode) 20)
                               (!= (-> s5-0 net-play-mode) 12)
                               (!= (-> s5-0 net-play-mode) 19)
                               )
                     )
            (when #t
              (suspend-for (seconds 1)
                )
              (auto-test-node gp-0)
              )
            )
          )
        (set! gp-0 (mod (+ gp-0 1) (length (-> *game-info* sub-task-list))))
        )
      )
    #f
    )
  )

;; definition for function auto-test-levels-init-by-other
(defbehavior auto-test-levels-init-by-other auto-test-levels ((arg0 int))
  (set! (-> self cur-task) arg0)
  (go-virtual running)
  )

;; definition for function auto-test-levels-start
;; WARN: Return type mismatch int vs object.
(defun auto-test-levels-start ((arg0 int))
  (process-spawn-function auto-test-levels auto-test-levels-init-by-other arg0)
  0
  )

;; definition for function check-levels
;; WARN: Return type mismatch int vs object.
(defun check-levels ()
  (dotimes (gp-0 (length (-> *game-info* play-list)))
    (when (= (-> *game-info* sub-task-list (-> *game-info* play-list gp-0 play-node) net-play-mode)
             (net-play-mode race)
             )
      (let ((a1-0 (-> *game-info* play-list gp-0 play-continue)))
        (when a1-0
          (let ((s5-0 (get-continue-by-name *game-info* (the-as string a1-0)))
                (s4-0 #f)
                )
            (when s5-0
              (dotimes (s3-0 (-> s5-0 want-count))
                (let ((v1-16 (-> s5-0 want s3-0)))
                  (when (-> v1-16 name)
                    (cond
                      ((= (-> v1-16 display?) #f)
                       (set! s4-0 #t)
                       )
                      (else
                        (when s4-0
                          (format 0 "----> ~S~%" (-> s5-0 name))
                          (dotimes (s2-0 (-> s5-0 want-count))
                            (format 0 "   (~A ~A)" (-> s5-0 want s2-0 name) (-> s5-0 want s2-0 display?))
                            )
                          (format 0 "~%~%")
                          )
                        )
                      )
                    )
                  )
                )
              (if (not s4-0)
                  (format 0 " -  no display=#f level in ~S~%" (-> s5-0 name))
                  )
              )
            )
          )
        )
      )
    )
  0
  )


;; definition for function search-for-code
;; WARN: Return type mismatch int vs object.
(defun search-for-code ()
  (let ((gp-0 #x100000))
    (while (< gp-0 #x1f00000)
      (let ((v1-0 (the-as (pointer uint32) gp-0)))
        (if (and (= (-> v1-0 4) (shl #x8de6 16))
                 (= (-> v1-0 3) #x25f4fffc)
                 (= (-> v1-0 2) #x40202d)
                 (= (-> v1-0 1) #x40982d)
                 (= (-> v1-0 0) (the-as uint #x8e2f0060))
                 )
            (format 0 "found it at #x~x~%" gp-0)
            )
        )
      (+! gp-0 4)
      )
    )
  0
  )


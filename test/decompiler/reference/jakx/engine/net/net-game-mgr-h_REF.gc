    (net-game-mgr-method-53 () none)
    (net-game-mgr-method-54 () none)
    (net-game-mgr-method-55 () none)
    (net-game-mgr-method-56 () none)
    (net-game-mgr-method-57 () none)
    (net-game-mgr-method-58 () none)
    (net-game-mgr-method-59 () none)
    (net-game-mgr-method-60 () none)
    (net-game-mgr-method-61 () none)
    (net-game-mgr-method-62 () none)
    (net-game-mgr-method-63 () none)
    (net-game-mgr-method-64 () none)

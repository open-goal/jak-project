    (net-game-mgr-method-67 () none)
    (net-game-mgr-method-68 () none)
    (net-game-mgr-method-69 () none)
    (net-game-mgr-method-70 () none)
    (net-game-mgr-method-71 () none)
    (net-game-mgr-method-72 () none)
    (net-game-mgr-method-73 () none)
    (net-game-mgr-method-74 () none)
    (net-game-mgr-method-75 () none)
    (net-game-mgr-method-76 () none)

;;-*-Lisp-*-
(in-package goal)

;; definition of type net-game-mgr-vehicle-info
(deftype net-game-mgr-vehicle-info (structure)
  ((all-vehicles          wvehicle  6)
   (local-vehicles        wvehicle  6)
   (ai-vehicles           wvehicle  6)
   (player-vehicles       wvehicle  6)
   (all-vehicle-count     int8)
   (local-vehicle-count   int8)
   (ai-vehicle-count      int8)
   (player-vehicle-count  int8)
   )
  )

;; definition for method 3 of type net-game-mgr-vehicle-info
(defmethod inspect ((this net-game-mgr-vehicle-info))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'net-game-mgr-vehicle-info)
  (format #t "~1Tall-vehicles[6] @ #x~X~%" (-> this all-vehicles))
  (format #t "~1Tlocal-vehicles[6] @ #x~X~%" (-> this local-vehicles))
  (format #t "~1Tai-vehicles[6] @ #x~X~%" (-> this ai-vehicles))
  (format #t "~1Tplayer-vehicles[6] @ #x~X~%" (-> this player-vehicles))
  (format #t "~1Tall-vehicle-count: ~D~%" (-> this all-vehicle-count))
  (format #t "~1Tlocal-vehicle-count: ~D~%" (-> this local-vehicle-count))
  (format #t "~1Tai-vehicle-count: ~D~%" (-> this ai-vehicle-count))
  (format #t "~1Tplayer-vehicle-count: ~D~%" (-> this player-vehicle-count))
  (label cfg-4)
  this
  )

;; definition of type net-game-mgr
(deftype net-game-mgr (process-nettable)
  ((scheduled-finish-time  int32)
   (scheduled-finish-mode  symbol)
   (sorted-ct              int8)
   (human-ct               int8)
   (sorted-ids             uint8   24)
   (sorted-ids-s8          int8    24 :overlay-at (-> sorted-ids 0))
   (intro-end-time         int32)
   (hud-player-indicators  handle  2)
   (net-players            (array net-player))
   (stats-hud              handle  2)
   (intro-handle           handle  2)
   (cheats                 uint16  4)
   (cheats-s8              int8    8  :overlay-at (-> cheats 0))
   (state-time             time-frame)
   )
  (:state-methods
    startup
    running
    waiting-to-die
    )
  (:methods
    (sort-players (_type_ symbol) none)
    (generate-random-player-stats (_type_) none)
    (spawn-hud-map (_type_) none)
    (net-game-mgr-method-48 (_type_) symbol)
    (running-post (_type_) none)
    (net-game-mgr-method-50 (_type_) symbol)
    (net-game-mgr-method-51 (_type_) symbol)
    (spawn-net-player (_type_ int) net-player)
    (spawn-hud-indicators (_type_ vehicle) none)
    (game-mgr-event-handler (_type_ process int symbol event-message-block) object)
    (get-intro-duration (_type_) float)
    (init-local (_type_) none)
    (init-common (_type_) none)
    (spawn-huds (_type_) none)
    (get-finish-delay (_type_) int)
    (spawn-local-players (_type_) none)
    (finish-game (_type_ symbol) none)
    (include-in-ranking? (_type_ net-player) symbol)
    (init-settings (_type_) none)
    (net-game-mgr-method-64 (_type_) none)
    (net-game-mgr-method-65 (_type_ int) string)
    (set-ai-player-name (_type_ int) none)
    (update-vehicles (_type_ net-game-mgr-vehicle-info) none)
    (update-vehicle-info (_type_) none)
    (set-vehicle-force-lod (_type_ int) none)
    (check-cheat-code (_type_) none)
    (get-counter-texture (_type_) texture)
    (net-game-mgr-method-72 (_type_ vector int) symbol)
    (end-intro (_type_) none)
    (show-intro-text (_type_ int) none)
    (set-intro-camera (_type_) none)
    (stats-begin-event (_type_) none)
    (stats-end-event (_type_ symbol) none)
    (finish-startup (_type_) none)
    (setup-viewports (_type_) none)
    )
  )

;; definition for method 3 of type net-game-mgr
(defmethod inspect ((this net-game-mgr))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type process-nettable inspect)))
    (t9-0 this)
    )
  (format #t "~2Tscheduled-finish-time: ~D~%" (-> this scheduled-finish-time))
  (format #t "~2Tscheduled-finish-mode: ~A~%" (-> this scheduled-finish-mode))
  (format #t "~2Tsorted-ct: ~D~%" (-> this sorted-ct))
  (format #t "~2Thuman-ct: ~D~%" (-> this human-ct))
  (format #t "~2Tsorted-ids[24] @ #x~X~%" (-> this sorted-ids))
  (format #t "~2Tintro-end-time: ~D~%" (-> this intro-end-time))
  (format #t "~2Thud-player-indicators[2] @ #x~X~%" (-> this hud-player-indicators))
  (format #t "~2Tnet-players: ~A~%" (-> this net-players))
  (format #t "~2Tstats-hud[2] @ #x~X~%" (-> this stats-hud))
  (format #t "~2Tintro-handle[2] @ #x~X~%" (-> this intro-handle))
  (format #t "~2Tcheats[4] @ #x~X~%" (-> this cheats))
  (format #t "~2Tstate-time: ~D~%" (-> this state-time))
  (label cfg-4)
  this
  )

;; definition for function net-game-mgr-init-remote
;; WARN: Return type mismatch int vs object.
(defbehavior net-game-mgr-init-remote net-game-mgr ((arg0 mem-buffer))
  (register self -1 #xffff)
  (init-remote self arg0)
  (post-init-remote self)
  0
  )

;; definition for method 41 of type net-game-mgr
(defmethod spawn-remote ((this net-game-mgr) (arg0 mem-buffer))
  (ppointer->process (process-spawn net-game-mgr :init net-game-mgr-init-remote arg0 :name "net-game-mgr"))
  )

;; definition for method 37 of type net-game-mgr
;; WARN: Return type mismatch int vs none.
(defmethod write-msg-map ((this net-game-mgr) (arg0 net-process-class-info))
  (set! (-> arg0 msg-map (-> arg0 msg-count)) 'game-finished)
  (+! (-> arg0 msg-count) 1)
  (set! (-> arg0 msg-map (-> arg0 msg-count)) 'disable-turbos)
  (+! (-> arg0 msg-count) 1)
  (set! (-> arg0 msg-map (-> arg0 msg-count)) 'set-intro-end-time)
  (+! (-> arg0 msg-count) 1)
  (set! (-> arg0 msg-map (-> arg0 msg-count)) 'game-aborted)
  (+! (-> arg0 msg-count) 1)
  (set! (-> arg0 msg-map (-> arg0 msg-count)) 'set-finish-time)
  (+! (-> arg0 msg-count) 1)
  (set! (-> arg0 msg-map (-> arg0 msg-count)) 'cheat)
  (+! (-> arg0 msg-count) 1)
  0
  (none)
  )

;; definition for symbol *msg-map-net-game-mgr*, type (array symbol)
(define *msg-map-net-game-mgr* (new 'static 'boxed-array :type symbol :length 0 :allocated-length 64))

;; definition for symbol *net-process-class-info-net-game-mgr*, type net-process-class-info
(define *net-process-class-info-net-game-mgr* (new 'static 'net-process-class-info))

;; failed to figure out what this is:
(set! (-> *net-process-class-info-net-game-mgr* msg-map) *msg-map-net-game-mgr*)

;; failed to figure out what this is:
(write-msg-map-rec net-game-mgr *net-process-class-info-net-game-mgr*)

;; failed to figure out what this is:
(set! (-> *net-process-class-info-net-game-mgr* owner-type) net-game-mgr)

;; failed to figure out what this is:
(net-process-class-register *net-process-class-info-net-game-mgr*)

;; definition for method 40 of type net-game-mgr
(defmethod get-class-info ((this net-game-mgr))
  *net-process-class-info-net-game-mgr*
  )

;; definition for symbol *net-game-mgr*, type net-game-mgr
(define *net-game-mgr* (the-as net-game-mgr #f))

;; definition for symbol *should-update-stats*, type symbol
(define *should-update-stats* #f)

;; definition for symbol *stats-adjusted*, type symbol
(define *stats-adjusted* #f)

;; definition for function current-finish-mode
;; WARN: Return type mismatch object vs symbol.
(defun current-finish-mode ()
  (let ((v1-0 (view-get-active-index)))
    (the-as
      symbol
      (and *net-game-mgr* (or (-> *net-game-mgr* scheduled-finish-mode)
                              (and (= (if *net-world*
                                          (the-as int (-> *net-world* task-node-info net-play-mode))
                                          18
                                          )
                                      0
                                      )
                                   (or (and (zero? v1-0) *hud-results-medal-proc*)
                                       (and (zero? v1-0) *hud-results-view-0-proc*)
                                       (and (= 1 v1-0) *hud-results-view-1-proc*)
                                       (and (zero? v1-0) *hud-results-team-view-0-proc*)
                                       (and (= 1 v1-0) *hud-results-team-view-1-proc*)
                                       )
                                   )
                              )
           )
      )
    )
  )


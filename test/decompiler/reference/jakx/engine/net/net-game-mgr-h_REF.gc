;;-*-Lisp-*-
(in-package goal)

;; definition of type net-game-mgr-vehicle-info
(deftype net-game-mgr-vehicle-info (structure)
  ((all-vehicles          uint32  6)
   (local-vehicles        uint32  6)
   (ai-vehicles           uint32  6)
   (player-vehicles       uint32  6)
   (all-vehicle-count     int8)
   (local-vehicle-count   int8)
   (ai-vehicle-count      int8)
   (player-vehicle-count  int8)
   )
  )

;; definition for method 3 of type net-game-mgr-vehicle-info
(defmethod inspect ((this net-game-mgr-vehicle-info))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'net-game-mgr-vehicle-info)
  (format #t "~1Tall-vehicles[6] @ #x~X~%" (-> this all-vehicles))
  (format #t "~1Tlocal-vehicles[6] @ #x~X~%" (-> this local-vehicles))
  (format #t "~1Tai-vehicles[6] @ #x~X~%" (-> this ai-vehicles))
  (format #t "~1Tplayer-vehicles[6] @ #x~X~%" (-> this player-vehicles))
  (format #t "~1Tall-vehicle-count: ~D~%" (-> this all-vehicle-count))
  (format #t "~1Tlocal-vehicle-count: ~D~%" (-> this local-vehicle-count))
  (format #t "~1Tai-vehicle-count: ~D~%" (-> this ai-vehicle-count))
  (format #t "~1Tplayer-vehicle-count: ~D~%" (-> this player-vehicle-count))
  (label cfg-4)
  this
  )

;; definition of type net-game-mgr
(deftype net-game-mgr (process-nettable)
  ((scheduled-finish-time  int32)
   (scheduled-finish-mode  basic)
   (sorted-ct              int8)
   (human-ct               int8)
   (sorted-ids             uint8   24)
   (intro-end-time         int32)
   (hud-player-indicators  handle  2)
   (net-players            basic)
   (stats-hud              handle  2)
   (intro-handle           handle  2)
   (cheats                 uint16  4)
   (state-time             uint64)
   )
  (:methods
    (net-game-mgr-method-42 () none)
    (net-game-mgr-method-43 () none)
    (net-game-mgr-method-44 () none)
    (net-game-mgr-method-45 () none)

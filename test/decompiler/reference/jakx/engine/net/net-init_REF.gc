;; definition of type patch-hdr
(deftype patch-hdr (structure)
  ((magic          uint32)
   (this-len       uint32)
   (uncomp-len     uint32)
   (src-file-len   uint32)
   (dest-file-len  uint32)
   (src-hash       uint32)
   (dest-hash      uint32)
   )
  )

;; definition for method 3 of type patch-hdr
(defmethod inspect ((this patch-hdr))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'patch-hdr)
  (format #t "~1Tmagic: ~D~%" (-> this magic))
  (format #t "~1Tthis-len: ~D~%" (-> this this-len))
  (format #t "~1Tuncomp-len: ~D~%" (-> this uncomp-len))
  (format #t "~1Tsrc-file-len: ~D~%" (-> this src-file-len))
  (format #t "~1Tdest-file-len: ~D~%" (-> this dest-file-len))
  (format #t "~1Tsrc-hash: ~D~%" (-> this src-hash))
  (format #t "~1Tdest-hash: ~D~%" (-> this dest-hash))
  (label cfg-4)
  this
  )

;; definition of type patch-group-entry
(deftype patch-group-entry (structure)
  ((name-hash  uint32)
   (offset     uint32)
   )
  :pack-me
  )

;; definition for method 3 of type patch-group-entry
(defmethod inspect ((this patch-group-entry))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'patch-group-entry)
  (format #t "~1Tname-hash: ~D~%" (-> this name-hash))
  (format #t "~1Toffset: ~D~%" (-> this offset))
  (label cfg-4)
  this
  )

;; definition of type patch-group
(deftype patch-group (structure)
  ((patch-ct  uint32)
   (data      patch-group-entry  :inline :dynamic)
   )
  )

;; definition for method 3 of type patch-group
(defmethod inspect ((this patch-group))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'patch-group)
  (format #t "~1Tpatch-ct: ~D~%" (-> this patch-ct))
  (format #t "~1Tdata[0] @ #x~X~%" (-> this data))
  (label cfg-4)
  this
  )


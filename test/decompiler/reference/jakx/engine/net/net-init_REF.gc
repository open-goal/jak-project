;; definition of type sce-stat
(deftype sce-stat (structure)
  ((mode     uint32)
   (attr     int32)
   (size     int32)
   (ctime    uint8   8)
   (atime    uint8   8)
   (mtime    uint8   8)
   (hisize   int32)
   (private  uint32  6)
   )
  )

;; definition for method 3 of type sce-stat
(defmethod inspect ((this sce-stat))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'sce-stat)
  (format #t "~1Tmode: ~D~%" (-> this mode))
  (format #t "~1Tattr: ~D~%" (-> this attr))
  (format #t "~1Tsize: ~D~%" (-> this size))
  (format #t "~1Tctime[8] @ #x~X~%" (-> this ctime))
  (format #t "~1Tatime[8] @ #x~X~%" (-> this atime))
  (format #t "~1Tmtime[8] @ #x~X~%" (-> this mtime))
  (format #t "~1Thisize: ~D~%" (-> this hisize))
  (format #t "~1Tprivate[6] @ #x~X~%" (-> this private))
  (label cfg-4)
  this
  )

;; definition of type sce-dirent
(deftype sce-dirent (structure)
  ((stat     sce-stat  :inline)
   (name     uint8     256)
   (private  pointer)
   )
  )

;; definition for method 3 of type sce-dirent
(defmethod inspect ((this sce-dirent))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'sce-dirent)
  (format #t "~1Tstat: #<sce-stat @ #x~X>~%" (-> this stat))
  (format #t "~1Tname[256] @ #x~X~%" (-> this name))
  (format #t "~1Tprivate: ~A~%" (-> this private))
  (label cfg-4)
  this
  )


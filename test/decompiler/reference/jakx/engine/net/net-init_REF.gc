;; definition for function simple-dir-test
;; WARN: Swapped fp-relative label and field offsets for "host0:"
;; WARN: Return type mismatch int vs object.
(defun simple-dir-test ()
  (let ((gp-0 (new 'stack-no-clear 'sce-dirent))
        (s5-0 (knet-dopen (-> "host0:" data)))
        )
    (when (>= s5-0 0)
      (let ((v1-2 (knet-dread s5-0 (the-as pointer (-> gp-0 stat)))))
        (while (> v1-2 0)
          (format 0 "~G~%" (-> gp-0 name))
          (set! v1-2 (knet-dread s5-0 (the-as pointer (-> gp-0 stat))))
          )
        )
      (knet-dclose s5-0)
      )
    )
  0
  )

;; definition of type eznet-combination
(deftype eznet-combination (structure)
  ((status    int32)
   (iftype    int32)
   (name      uint8  64)
   (ifc-name  uint8  64)
   (dev-name  uint8  64)
   )
  :pack-me
  )

;; definition for method 3 of type eznet-combination
(defmethod inspect ((this eznet-combination))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'eznet-combination)
  (format #t "~1Tstatus: ~D~%" (-> this status))
  (format #t "~1Tiftype: ~D~%" (-> this iftype))
  (format #t "~1Tname[64] @ #x~X~%" (-> this name))
  (format #t "~1Tifc-name[64] @ #x~X~%" (-> this ifc-name))
  (format #t "~1Tdev-name[64] @ #x~X~%" (-> this dev-name))
  (label cfg-4)
  this
  )

;; definition of type eznet-combination-list
(deftype eznet-combination-list (structure)
  ((length       int32)
   (default      int32)
   (netdb-order  uint32             10)
   (list         eznet-combination  10 :inline)
   )
  )

;; definition for method 3 of type eznet-combination-list
(defmethod inspect ((this eznet-combination-list))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'eznet-combination-list)
  (format #t "~1Tlength: ~D~%" (-> this length))
  (format #t "~1Tdefault: ~D~%" (-> this default))
  (format #t "~1Tnetdb-order[10] @ #x~X~%" (-> this netdb-order))
  (format #t "~1Tlist[10] @ #x~X~%" (-> this list))
  (label cfg-4)
  this
  )

;; definition of type sce-dnas2-unique-id

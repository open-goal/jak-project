  (format #t "~1Tsizep: #x~X~%" (-> this sizep))
  (format #t "~1Tresult: ~D~%" (-> this result))
  (label cfg-4)
  this
  )

;; definition of type sce-dnas2-status
(deftype sce-dnas2-status (structure)
  ((code      int32)
   (sub-code  int32)
   (progress  int32)
   (optional  uint32)
   )
  )

;; definition for method 3 of type sce-dnas2-status
(defmethod inspect ((this sce-dnas2-status))

(in-package goal)

;; definition of type deathmatch-spawner
(deftype deathmatch-spawner (structure)
  ((entity           entity)
   (next-spawn-time  time-frame)
   )
  )

;; definition for method 3 of type deathmatch-spawner
(defmethod inspect ((this deathmatch-spawner))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'deathmatch-spawner)
  (format #t "~1Tentity: ~A~%" (-> this entity))
  (format #t "~1Tnext-spawn-time: ~D~%" (-> this next-spawn-time))
  (label cfg-4)
  this
  )

;; definition of type deathmatch-spawner-array
(deftype deathmatch-spawner-array (inline-array-class)
  ((data  deathmatch-spawner  :inline :dynamic)
   )
  )

;; definition for method 3 of type deathmatch-spawner-array
(defmethod inspect ((this deathmatch-spawner-array))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this (-> this type))
  (format #t "~1Tlength: ~D~%" (-> this length))
  (format #t "~1Tallocated-length: ~D~%" (-> this allocated-length))
  (format #t "~1Tdata[0] @ #x~X~%" (-> this data))
  (label cfg-4)
  this
  )


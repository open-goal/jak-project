;; definition for symbol *udp-layer*, type udp-layer
(define *udp-layer* (new 'static 'udp-layer))

;; definition for symbol *nat-addr*, type net-address
(define *nat-addr* (the-as net-address 0))

;; definition for method 9 of type udp-layer
;; WARN: Return type mismatch int vs none.
;; WARN: Function (method 9 udp-layer) has a return type of none, but the expression builder found a return statement.
(defmethod init! ((this udp-layer))
  (dotimes (s5-0 8)
    (reset! (-> this machines s5-0) s5-0)
    )
  (set! (-> this data-cb) #f)
  (set! (-> this socket) -1)
  (let ((v1-7 (knet-udp-socket-open #x2b5c)))
    (if (> v1-7 0)
        (set! (-> this socket) v1-7)
        )
    )
  (when (< (-> this socket) 0)
    (format 0 "unable to obtain UDP socket~%")
    (set! (-> this
              machines
              (if *net-mgr*
                  (-> *net-mgr* game-state local-machine-idx)
                  0
                  )
              state
              )
          (udp-machine-state lost)
          )
    (return #f)
    )
  (set! (-> this
            machines
            (if *net-mgr*
                (-> *net-mgr* game-state local-machine-idx)
                0
                )
            state
            )
        (udp-machine-state unknown)
        )
  (set! (-> this nat-discovery-tries) 0)
  (set! (-> this nat-discovery-time) (the-as int (+ (-> *display* real-clock frame-counter) (seconds -5))))
  (when (and (or *aux-voice-mgr* (or (= (-> *net-mgr* game-type) 1) (= (-> *net-mgr* game-type) 3)))
             (zero? (knet-scert-net-get-nat-service (&-> '*nat-addr* value)))
             )
    (set! (-> this nat-discovery-ip) (parse-ip (the-as (pointer uint8) (-> *nat-addr* address))))
    (set! (-> this nat-discovery-port) (the-as int (-> *nat-addr* port)))
    (set! (-> this nat-discovery-tries) 5)
    )
  0
  (none)
  )

;; definition for method 10 of type udp-layer
;; WARN: Return type mismatch int vs none.
(defmethod close! ((this udp-layer))
  (if (> (-> this socket) 0)
      (knet-udp-socket-close (-> this socket))
      )
  0
  (none)
  )

;; definition for method 18 of type udp-layer
;; INFO: Used lq/sq
;; WARN: Return type mismatch int vs none.
;; WARN: Function (method 18 udp-layer) has a return type of none, but the expression builder found a return statement.
(defmethod handle-packet ((this udp-layer) (arg0 uint) (arg1 int) (arg2 pointer) (arg3 int))

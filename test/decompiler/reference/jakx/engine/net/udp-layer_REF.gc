;;-*-Lisp-*-
(in-package goal)

;; definition of type udp-layer-machine
(deftype udp-layer-machine (structure)
  ((idx               int8)
   (state             udp-machine-state)
   (state-enter-time  int32)
   (last-time         int32)
   (last-reply-time   int32)
   (reachable-ip      uint32)
   (reachable-port    int32)
   (scert-ip          uint32)
   )
  (:methods
    (reset! (_type_ int) none)
    (update (_type_) none)
    (state-change! (_type_ udp-machine-state) none)
    )
  )

;; definition for method 3 of type udp-layer-machine
(defmethod inspect ((this udp-layer-machine))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'udp-layer-machine)
  (format #t "~1Tidx: ~D~%" (-> this idx))
  (format #t "~1Tstate: ~D~%" (-> this state))
  (format #t "~1Tstate-enter-time: ~D~%" (-> this state-enter-time))
  (format #t "~1Tlast-time: ~D~%" (-> this last-time))
  (format #t "~1Tlast-reply-time: ~D~%" (-> this last-reply-time))
  (format #t "~1Treachable-ip: ~D~%" (-> this reachable-ip))
  (format #t "~1Treachable-port: ~D~%" (-> this reachable-port))
  (format #t "~1Tscert-ip: ~D~%" (-> this scert-ip))
  (label cfg-4)
  this
  )

;; definition of type udp-layer
(deftype udp-layer (structure)
  ((machines             udp-layer-machine  8 :inline)
   (socket               int32)
   (data-cb              (function pointer int int int))
   (nat-discovery-time   int32)
   (nat-discovery-tries  int32)
   (nat-discovery-ip     uint32)
   (nat-discovery-port   int32)
   )
  (:methods
    (init! (_type_) none)
    (close! (_type_) none)
    (client-joined (_type_ int) none)
    (client-left (_type_ int) none)
    (update (_type_) none)
    (send-ping (_type_ udp-message int int) none)
    (send-data (_type_ udp-message (pointer uint8) int) none)
    (udp-layer-method-16 (_type_) int)
    (set-callback (_type_ (function pointer int int int)) none)
    (handle-packet (_type_ uint int pointer int) none)
    (announce-address (_type_ int) none)
    )
  )

;; definition for method 3 of type udp-layer
(defmethod inspect ((this udp-layer))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'udp-layer)
  (format #t "~1Tmachines[8] @ #x~X~%" (-> this machines))
  (format #t "~1Tsocket: ~D~%" (-> this socket))
  (format #t "~1Tdata-cb: ~A~%" (-> this data-cb))
  (format #t "~1Tnat-discovery-time: ~D~%" (-> this nat-discovery-time))
  (format #t "~1Tnat-discovery-tries: ~D~%" (-> this nat-discovery-tries))
  (format #t "~1Tnat-discovery-ip: ~D~%" (-> this nat-discovery-ip))
  (format #t "~1Tnat-discovery-port: ~D~%" (-> this nat-discovery-port))
  (label cfg-4)
  this
  )


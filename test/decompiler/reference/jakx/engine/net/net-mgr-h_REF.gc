;; definition of type net-aux-msg-handler
(deftype net-aux-msg-handler (structure)
  ((handler-func  function)
   )
  )

;; definition for method 3 of type net-aux-msg-handler
(defmethod inspect ((this net-aux-msg-handler))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'net-aux-msg-handler)
  (format #t "~1Thandler-func: ~A~%" (-> this handler-func))
  (label cfg-4)
  this
  )

;; definition for symbol *net-aux-msg-handlers*, type (inline-array net-aux-msg-handler)

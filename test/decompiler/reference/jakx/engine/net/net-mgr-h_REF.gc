;; definition of type net-mgr-game-state
(deftype net-mgr-game-state (structure)
  ((connect-handle      basic)
   (local-machine-idx   int32)
   (session-master-idx  int32)
   (host-idx            int32)
   (connected-bitfield  int32)
   (time                int32)
   (first-time-host     basic)
   (locked              basic)
   (kicked              basic)
   (sm-eligible         basic)
   )
  :pack-me
  )

;; definition for method 3 of type net-mgr-game-state
(defmethod inspect ((this net-mgr-game-state))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'net-mgr-game-state)
  (format #t "~1Tconnect-handle: ~A~%" (-> this connect-handle))
  (format #t "~1Tlocal-machine-idx: ~D~%" (-> this local-machine-idx))
  (format #t "~1Tsession-master-idx: ~D~%" (-> this session-master-idx))
  (format #t "~1Thost-idx: ~D~%" (-> this host-idx))
  (format #t "~1Tconnected-bitfield: ~D~%" (-> this connected-bitfield))
  (format #t "~1Ttime: ~D~%" (-> this time))
  (format #t "~1Tfirst-time-host: ~A~%" (-> this first-time-host))
  (format #t "~1Tlocked: ~A~%" (-> this locked))
  (format #t "~1Tkicked: ~A~%" (-> this kicked))
  (format #t "~1Tsm-eligible: ~A~%" (-> this sm-eligible))
  (label cfg-4)
  this
  )

;; definition of type net-mgr-lobby-state
(deftype net-mgr-lobby-state (structure)
  ((connect-handle          basic)
   (connect-handle-mgcl     basic)
   (connect-handle-muis     basic)
   (my-account-id           int32)
   (channel-id              int32)
   (in-special-channel      basic)
   (last-normal-channel-id  int32)
   (created-game-id         int32)
   (joined-game-id          int32)
   (channel-list-valid      basic)
   (last-medius-error       int32)
   (last-mgcl-error         int32)
   (last-dme-error          int32)
   (callback-occurred       basic)
   (callback-status         int32)
   (callback-userdata       basic)
   (timeout                 basic)
   (got-error               basic)
   (last-report-time        int32)
   (game-on-me              uint64)
   (game-on-me-error-delay  int32)
   )
  :pack-me
  )

;; definition for method 3 of type net-mgr-lobby-state
(defmethod inspect ((this net-mgr-lobby-state))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'net-mgr-lobby-state)
  (format #t "~1Tconnect-handle: ~A~%" (-> this connect-handle))
  (format #t "~1Tconnect-handle-mgcl: ~A~%" (-> this connect-handle-mgcl))
  (format #t "~1Tconnect-handle-muis: ~A~%" (-> this connect-handle-muis))
  (format #t "~1Tmy-account-id: ~D~%" (-> this my-account-id))
  (format #t "~1Tchannel-id: ~D~%" (-> this channel-id))
  (format #t "~1Tin-special-channel: ~A~%" (-> this in-special-channel))
  (format #t "~1Tlast-normal-channel-id: ~D~%" (-> this last-normal-channel-id))
  (format #t "~1Tcreated-game-id: ~D~%" (-> this created-game-id))
  (format #t "~1Tjoined-game-id: ~D~%" (-> this joined-game-id))
  (format #t "~1Tchannel-list-valid: ~A~%" (-> this channel-list-valid))
  (format #t "~1Tlast-medius-error: ~D~%" (-> this last-medius-error))
  (format #t "~1Tlast-mgcl-error: ~D~%" (-> this last-mgcl-error))
  (format #t "~1Tlast-dme-error: ~D~%" (-> this last-dme-error))
  (format #t "~1Tcallback-occurred: ~A~%" (-> this callback-occurred))
  (format #t "~1Tcallback-status: ~D~%" (-> this callback-status))
  (format #t "~1Tcallback-userdata: ~A~%" (-> this callback-userdata))
  (format #t "~1Ttimeout: ~A~%" (-> this timeout))
  (format #t "~1Tgot-error: ~A~%" (-> this got-error))
  (format #t "~1Tlast-report-time: ~D~%" (-> this last-report-time))
  (format #t "~1Tgame-on-me: ~D~%" (-> this game-on-me))
  (format #t "~1Tgame-on-me-error-delay: ~D~%" (-> this game-on-me-error-delay))
  (label cfg-4)
  this
  )

;; definition of type net-mgr
(deftype net-mgr (process)
  ((game-type       uint8)
   (last-game-type  uint8)
   (notify          engine)
   (game-state      net-mgr-game-state   :inline)
   (lobby-state     net-mgr-lobby-state  :inline)
   (scert-initted   symbol)
   (auto-register   symbol)
   (skip-policy     symbol)
   )
  (:methods
    (net-mgr-method-15 () none)
    (net-mgr-method-16 () none)
    (net-mgr-method-17 () none)
    (net-mgr-method-18 () none)
    (net-mgr-method-19 () none)
    (net-mgr-method-20 () none)
    (net-mgr-method-21 () none)
    (net-mgr-method-22 () none)
    (net-mgr-method-23 () none)
    (net-mgr-method-24 () none)
    (net-mgr-method-25 () none)
    (net-mgr-method-26 () none)
    (net-mgr-method-27 () none)
    (net-mgr-method-28 () none)
    (net-mgr-method-29 () none)
    (net-mgr-method-30 () none)
    (net-mgr-method-31 () none)
    (net-mgr-method-32 () none)
    (net-mgr-method-33 () none)
    (net-mgr-method-34 () none)
    (net-mgr-method-35 () none)
    (net-mgr-method-36 () none)
    (net-mgr-method-37 () none)
    (net-mgr-method-38 () none)
    (net-mgr-method-39 () none)
    (net-mgr-method-40 () none)
    (net-mgr-method-41 () none)
    (net-mgr-method-42 () none)
    (net-mgr-method-43 () none)
    (net-mgr-method-44 () none)
    (net-mgr-method-45 () none)
    (net-mgr-method-46 (_type_) symbol)
    (net-mgr-method-47 () none)
    (net-mgr-method-48 () none)
    (net-mgr-method-49 () none)
    (net-mgr-method-50 () none)
    (net-mgr-method-51 () none)
    (net-mgr-method-52 () none)
    (net-mgr-method-53 () none)
    (net-mgr-method-54 () none)
    (net-mgr-method-55 () none)
    (net-mgr-method-56 () none)
    (net-mgr-method-57 () none)
    (net-mgr-method-58 () none)
    (net-mgr-method-59 () none)
    )
  )

;; definition for method 3 of type net-mgr
(defmethod inspect ((this net-mgr))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type process inspect)))
    (t9-0 this)
    )
  (format #t "~2Tgame-type: ~D~%" (-> this game-type))
  (format #t "~2Tlast-game-type: ~D~%" (-> this last-game-type))
  (format #t "~2Tnotify: ~A~%" (-> this notify))
  (format #t "~2Tgame-state: #<net-mgr-game-state @ #x~X>~%" (-> this game-state))
  (format #t "~2Tlobby-state: #<net-mgr-lobby-state @ #x~X>~%" (-> this lobby-state))
  (format #t "~2Tscert-initted: ~A~%" (-> this scert-initted))
  (format #t "~2Tauto-register: ~A~%" (-> this auto-register))
  (format #t "~2Tskip-policy: ~A~%" (-> this skip-policy))
  (label cfg-4)
  this
  )

;; definition for symbol *net-mgr-startup-status*, type symbol
(define *net-mgr-startup-status* #f)

;; definition for symbol *net-mgr*, type net-mgr
(define *net-mgr* (the-as net-mgr #f))

;; definition for symbol *net-error*, type int
(define *net-error* 0)

;; definition for symbol *medius-world-status*, type int
(define *medius-world-status* 0)

;; definition for symbol *dme-initted*, type symbol
(define *dme-initted* #f)

;; definition for symbol *medius-initted*, type symbol
(define *medius-initted* #f)

;; definition for symbol *mgcl-initted*, type symbol
(define *mgcl-initted* #f)

;; definition of type net-available-game-info
(deftype net-available-game-info (structure)
  ((game-name     uint8   64)
   (player-count  uint8)
   (min-players   uint8)
   (max-players   uint8)
   (in-staging    basic)
   (event         uint8)
   (location      uint8)
   (task-node     uint8)
   (generic-1     int32)
   (generic-2     int32)
   (generic-3     int32)
   (burn-version  uint32  :overlay-at generic-1)
   (lobby-world   int32   :overlay-at generic-2)
   (class-type    int32   :overlay-at generic-3)
   (clan-1        int32)
   (clan-2        int32)
   (skill-level   int32)
   (avg-ping      int32)
   )
  )

;; definition for method 3 of type net-available-game-info
(defmethod inspect ((this net-available-game-info))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'net-available-game-info)
  (format #t "~1Tgame-name[64] @ #x~X~%" (-> this game-name))
  (format #t "~1Tplayer-count: ~D~%" (-> this player-count))
  (format #t "~1Tmin-players: ~D~%" (-> this min-players))
  (format #t "~1Tmax-players: ~D~%" (-> this max-players))
  (format #t "~1Tin-staging: ~A~%" (-> this in-staging))
  (format #t "~1Tevent: ~D~%" (-> this event))
  (format #t "~1Tlocation: ~D~%" (-> this location))
  (format #t "~1Ttask-node: ~D~%" (-> this task-node))
  (format #t "~1Tgeneric-1: ~D~%" (-> this generic-1))
  (format #t "~1Tgeneric-2: ~D~%" (-> this generic-2))
  (format #t "~1Tgeneric-3: ~D~%" (-> this generic-3))
  (format #t "~1Tburn-version: ~D~%" (-> this burn-version))
  (format #t "~1Tlobby-world: ~D~%" (-> this generic-2))
  (format #t "~1Tclass-type: ~D~%" (-> this generic-3))
  (format #t "~1Tclan-1: ~D~%" (-> this clan-1))
  (format #t "~1Tclan-2: ~D~%" (-> this clan-2))
  (format #t "~1Tskill-level: ~D~%" (-> this skill-level))
  (format #t "~1Tavg-ping: ~D~%" (-> this avg-ping))
  (label cfg-4)
  this
  )

;; definition for function encode-net-available-game-info
(defun encode-net-available-game-info ((arg0 net-available-game-info) (arg1 mem-buffer))
  (mem-buffer-method-31 arg1 (-> arg0 game-name) 64)
  (mem-buffer-method-18 arg1 (the-as int (-> arg0 player-count)))
  (mem-buffer-method-18 arg1 (the-as int (-> arg0 min-players)))
  (mem-buffer-method-18 arg1 (the-as int (-> arg0 max-players)))
  (mem-buffer-method-29 arg1 (the-as symbol (-> arg0 in-staging)))
  (mem-buffer-method-14 arg1 (the-as int (-> arg0 event)))
  (mem-buffer-method-14 arg1 (the-as int (-> arg0 location)))
  (mem-buffer-method-18 arg1 (the-as int (-> arg0 task-node)))
  (mem-buffer-method-16 arg1 (-> arg0 generic-1))
  (mem-buffer-method-20 arg1 (the-as int (-> arg0 burn-version)))
  (mem-buffer-method-16 arg1 (-> arg0 generic-2))
  (mem-buffer-method-16 arg1 (-> arg0 generic-2))
  (mem-buffer-method-16 arg1 (-> arg0 generic-3))
  (mem-buffer-method-16 arg1 (-> arg0 generic-3))
  (mem-buffer-method-16 arg1 (-> arg0 clan-1))
  (mem-buffer-method-16 arg1 (-> arg0 clan-2))
  (mem-buffer-method-16 arg1 (-> arg0 skill-level))
  (mem-buffer-method-16 arg1 (-> arg0 avg-ping))
  (none)
  )

;; definition for function decode-net-available-game-info
;; WARN: Return type mismatch int vs none.
(defun decode-net-available-game-info ((arg0 net-available-game-info) (arg1 mem-buffer))
  (mem-buffer-method-48 arg1 (-> arg0 game-name) 64)
  (set! (-> arg0 player-count) (the-as uint (mem-buffer-method-36 arg1)))
  (set! (-> arg0 min-players) (the-as uint (mem-buffer-method-36 arg1)))
  (set! (-> arg0 max-players) (the-as uint (mem-buffer-method-36 arg1)))
  (set! (-> arg0 in-staging) (the-as basic (mem-buffer-method-46 arg1)))
  (set! (-> arg0 event) (the-as uint (mem-buffer-method-32 arg1)))
  (set! (-> arg0 location) (the-as uint (mem-buffer-method-32 arg1)))
  (set! (-> arg0 task-node) (the-as uint (mem-buffer-method-36 arg1)))
  (set! (-> arg0 generic-1) (mem-buffer-method-34 arg1))
  (set! (-> arg0 generic-1) (the-as int (mem-buffer-method-38 arg1)))
  (set! (-> arg0 generic-2) (mem-buffer-method-34 arg1))
  (set! (-> arg0 generic-2) (mem-buffer-method-34 arg1))
  (set! (-> arg0 generic-3) (mem-buffer-method-34 arg1))
  (set! (-> arg0 generic-3) (mem-buffer-method-34 arg1))
  (set! (-> arg0 clan-1) (mem-buffer-method-34 arg1))
  (set! (-> arg0 clan-2) (mem-buffer-method-34 arg1))
  (set! (-> arg0 skill-level) (mem-buffer-method-34 arg1))
  (set! (-> arg0 avg-ping) (mem-buffer-method-34 arg1))
  (none)
  )

;; definition of type net-available-game
(deftype net-available-game (structure)
  ((info              net-available-game-info  :inline)
   (connect-info      net-connection-info      :inline)
   (medius-world-id   int32)
   (format-game-name  uint8                    64)
   )
  (:methods
    (net-available-game-method-9 () none)
    (net-available-game-method-10 () none)
    (net-available-game-method-11 () none)
    (net-available-game-method-12 () none)
    (net-available-game-method-13 () none)
    (net-available-game-method-14 () none)
    )
  )

;; definition for method 3 of type net-available-game
(defmethod inspect ((this net-available-game))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'net-available-game)
  (format #t "~1Tinfo: #<net-available-game-info @ #x~X>~%" (-> this info))
  (format #t "~1Tconnect-info: #<net-connection-info @ #x~X>~%" (-> this connect-info))
  (format #t "~1Tmedius-world-id: ~D~%" (-> this medius-world-id))
  (format #t "~1Tformat-game-name[64] @ #x~X~%" (-> this format-game-name))
  (label cfg-4)
  this
  )


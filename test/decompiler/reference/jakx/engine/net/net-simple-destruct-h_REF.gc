;; definition for function net-simple-destruct-mgr-init-remote
;; WARN: Return type mismatch int vs none.
(defbehavior net-simple-destruct-mgr-init-remote net-simple-destruct-mgr ((arg0 int))
  (process-nettable-method-34 self -1 (new 'static 'rgba :r #xff :g #xff))
  (process-nettable-method-35 self arg0)
  (process-nettable-method-36 self)
  0
  (none)
  )

;; definition for method 41 of type net-simple-destruct-mgr
(defmethod process-nettable-method-41 ((this net-simple-destruct-mgr) (arg0 int))
  (ppointer->process (process-spawn
                       net-simple-destruct-mgr
                       :init net-simple-destruct-mgr-init-remote
                       arg0
                       :name "net-simple-destruct-mgr"
                       )
                     )
  )

;; definition for method 37 of type net-simple-destruct-mgr
;; WARN: Return type mismatch int vs none.
(defmethod process-nettable-method-37 ((this net-simple-destruct-mgr) (arg0 net-process-class-info))
  (set! (-> arg0 msg-map (-> arg0 msg-count)) 'object-destroyed)
  (+! (-> arg0 msg-count) 1)
  (set! (-> arg0 msg-map (-> arg0 msg-count)) 'object-respawn)
  (+! (-> arg0 msg-count) 1)
  0
  (none)
  )


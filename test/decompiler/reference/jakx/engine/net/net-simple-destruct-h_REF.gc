(in-package goal)

;; definition of type net-simple-destruct
(deftype net-simple-destruct (process-focusable)
  ((hit-points          float)
   (incoming-attack-id  int32)
   (impact-velocity     vector  :inline)
   )
  (:methods
    (net-simple-destruct-method-59 () none)
    (net-simple-destruct-method-60 () none)
    (net-simple-destruct-method-61 () none)
    (net-simple-destruct-method-62 () none)
    (net-simple-destruct-method-63 () none)
    (net-simple-destruct-method-64 () none)
    (net-simple-destruct-method-65 () none)
    (net-simple-destruct-method-66 () none)
    (net-simple-destruct-method-67 () none)
    (net-simple-destruct-method-68 () none)
    (net-simple-destruct-method-69 () none)
    )
  )

;; definition for method 3 of type net-simple-destruct
(defmethod inspect ((this net-simple-destruct))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (let ((t9-0 (method-of-type process-focusable inspect)))
    (t9-0 this)
    )
  (format #t "~2Thit-points: ~f~%" (-> this hit-points))
  (format #t "~2Tincoming-attack-id: ~D~%" (-> this incoming-attack-id))
  (format #t "~2Timpact-velocity: #<vector @ #x~X>~%" (-> this impact-velocity))
  (label cfg-4)
  this
  )


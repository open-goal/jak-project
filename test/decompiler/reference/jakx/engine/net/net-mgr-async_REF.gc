;; definition for function do-disconnect
;; WARN: Return type mismatch int vs object.
(defun do-disconnect ((arg0 symbol) (arg1 symbol) (arg2 symbol))
  (if arg0
      (dme-disconnect)
      )
  (if arg1
      (mgcl-disconnect #t)
      )
  (if arg2
      (medius-disconnect #t)
      )
  0
  )

;; failed to figure out what this is:
(defstate disconnecting (net-mgr)
  :virtual #t
  :code (behavior ((arg0 symbol) (arg1 symbol) (arg2 symbol) (arg3 symbol))
    (do-disconnect arg0 arg1 arg2)
    (cond
      ((= arg3 'idle)
       (go-virtual idle)
       )
      ((= arg3 'lobby-idle)
       (go-virtual lobby-idle)
       )
      )
    )
  )


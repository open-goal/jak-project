;;-*-Lisp-*-
(in-package goal)

;; definition of type medius-simple-response
(deftype medius-simple-response (structure)
  ((message-id   uint8  21)
   (status-code  medius-status-code)
   )
  )

;; definition for method 3 of type medius-simple-response
(defmethod inspect ((this medius-simple-response))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'medius-simple-response)
  (format #t "~1Tmessage-id[21] @ #x~X~%" (-> this message-id))
  (format #t "~1Tstatus-code: ~D~%" (-> this status-code))
  (label cfg-4)
  this
  )

;; definition of type mgcl-simple-response
(deftype mgcl-simple-response (structure)
  ((message-id    uint8  21)
   (confirmation  int8)
   )
  )

;; definition for method 3 of type mgcl-simple-response
(defmethod inspect ((this mgcl-simple-response))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'mgcl-simple-response)
  (format #t "~1Tmessage-id[21] @ #x~X~%" (-> this message-id))
  (format #t "~1Tconfirmation: ~D~%" (-> this confirmation))
  (label cfg-4)
  this
  )


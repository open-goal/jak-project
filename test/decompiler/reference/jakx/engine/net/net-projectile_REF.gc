(in-package goal)

;; definition for method 72 of type net-projectile
;; INFO: Used lq/sq
(defmethod net-projectile-method-72 ((this net-projectile)
                                    (arg0 vector)
                                    (arg1 vector)
                                    (arg2 vector)
                                    (arg3 vector)
                                    (arg4 time-frame)
                                    (arg5 time-frame)
                                    )
  (when (not arg2)
    (set! arg2 (new 'stack-no-clear 'vector))
    (set! (-> arg2 quad) (-> this starting-pos quad))
    )
  (when (not arg3)
    (set! arg3 (new 'stack-no-clear 'vector))
    (set! (-> arg3 quad) (-> this root transv quad))
    )
  (if (not arg4)
      (-> this spawn-time)
      )
  (format #t "ERROR: You must override extrapolate-position-from-create in ~A~%" (-> this type))
  (set! (-> arg0 quad) (-> arg2 quad))
  (set! (-> arg1 quad) (-> arg3 quad))
  arg1
  )

;; definition for method 15 of type net-projectile
(defmethod write-create-data ((this net-projectile) (arg0 mem-buffer))
  (write-vector arg0 (-> this starting-pos))
  (write-vector arg0 (-> this root transv))
  (let* ((s4-0 arg0)
         (s3-0 (method-of-type mem-buffer write-uint16))
         (s2-0 (handle->process (-> this desired-target)))
         (v1-9 (if s2-0
                   (as-type s2-0 process-nettable)
                   )
               )
         )
    (s3-0 s4-0 (the-as uint (if v1-9
                                (the-as int (-> (the-as process-nettable v1-9) net-id))
                                #xffff
                                )
                       )
          )
    )
  (let* ((s4-1 arg0)
         (s3-1 (method-of-type mem-buffer write-uint16))
         (s2-1 (handle->process (-> this owner-handle)))
         (v1-15 (if s2-1
                    (as-type s2-1 process-nettable)
                    )
                )
         )
    (s3-1 s4-1 (the-as uint (if v1-15
                                (the-as int (-> (the-as process-nettable v1-15) net-id))
                                #xffff
                                )
                       )
          )
    )
  (write-uint32 arg0 (-> this attack-id))
  (write-uint64 arg0 (the-as uint (-> this options)))
  (let ((v1-26 (- (the-as time-frame (- (- (if *net-mgr*
                                               (-> *net-mgr* game-state time)
                                               0
                                               )
                                           (if *net-world*
                                               (-> *net-world* net-state game-start-time)
                                               0
                                               )
                                           )
                                        (if *net-world*
                                            (-> *net-world* net-state total-pause-time)
                                            0
                                            )
                                        )
                          )
                  (current-time)
                  )
               )
        )
    (write-int32 arg0 (the-as int (+ (-> this spawn-time) v1-26)))
    )
  (write-float arg0 (-> this damage))
  (write-float arg0 (-> this vehicle-damage-factor))
  (write-float arg0 (-> this vehicle-impulse-factor))
  (write-uint8 arg0 (-> this wpn-type))
  (none)
  )

;; definition for method 17 of type net-projectile
;; WARN: Return type mismatch object vs none.
(defmethod handle-net-msg ((this net-projectile) (arg0 symbol) (arg1 mem-buffer) (arg2 int))
  (case arg0
    (('force-position)
     (read-vector arg1 (-> this root trans))
     (read-quaternion arg1 (-> this root rotation))
     )
    (('force-retarget)
     (set! (-> this desired-target) (the-as handle (read-handle arg1)))
     )
    )
  (none)
  )

;; definition for function net-projectile-init-by-other
;; INFO: Used lq/sq
;; WARN: Return type mismatch none vs object.
(defbehavior net-projectile-init-by-other net-projectile ((arg0 projectile-init-by-other-params) (arg1 int))
  (let ((a1-1 (get-stack-size self)))
    (stack-size-set! (-> self main-thread) a1-1)
    )
  (logclear! (-> self mask) (process-mask actor-pause))
  (logior! (-> self mask) (process-mask pause menu progress))
  (process-entity-set! self (-> arg0 ent))
  (set! (-> self charge-level) (-> arg0 charge))
  (set! (-> self options) (-> arg0 options))
  (set! (-> self notify-handle) (-> arg0 notify-handle))
  (set! (-> self owner-handle) (-> arg0 owner-handle))
  (set! (-> self ignore-handle) (-> arg0 ignore-handle))
  (set! (-> self attack-id) (-> arg0 attack-id))
  (set! (-> self damage) (-> arg0 damage))
  (set! (-> self vehicle-damage-factor) (-> arg0 vehicle-damage-factor))
  (set! (-> self vehicle-impulse-factor) (-> arg0 vehicle-impulse-factor))
  (set! (-> self attack-mode) #f)
  (set! (-> self max-speed) 40960.0)
  (set! (-> self tween) 1.0)
  (set! (-> self last-target) (the-as handle #f))
  (set! (-> self timeout) (-> arg0 timeout))
  (set! (-> self max-hits) 1)
  (set! (-> self spawn-time)
        (the-as time-frame (- arg1 (- (the-as time-frame (- (- (if *net-mgr*
                                                                   (-> *net-mgr* game-state time)
                                                                   0
                                                                   )
                                                               (if *net-world*
                                                                   (-> *net-world* net-state game-start-time)
                                                                   0
                                                                   )
                                                               )
                                                            (if *net-world*
                                                                (-> *net-world* net-state total-pause-time)
                                                                0
                                                                )
                                                            )
                                              )
                                      (current-time)
                                      )
                              )
                )
        )
  (set! (-> self update-velocity) #f)
  (set! (-> self move) projectile-move-fill-line-sphere)
  (set! (-> self pick-target) #f)
  (set! (-> self stop-speed) 204.8)
  (set! (-> self desired-target) (-> arg0 target-handle))
  (set! (-> self wpn-type) (-> arg0 wpn-type))
  (set! (-> self desired-target-pos quad) (-> arg0 target-pos quad))
  (countdown (v1-28 16)
    (set! (-> self old-dist v1-28) 4095996000.0)
    )
  (logior! (-> self options) (projectile-options po4))
  (projectile-method-60 self)
  (let ((s5-1 (-> self root)))
    (when (type? s5-1 collide-shape-moving)
      (set! (-> self root dynam gravity y) 1228800.0)
      (set! (-> self root dynam gravity-length) 1228800.0)
      (set! (-> self root dynam gravity-max) 1228800.0)
      )
    (logior! (-> self mask) (process-mask projectile))
    (logclear! (-> self mask) (process-mask enemy))
    (quaternion-identity! (-> s5-1 rotation))
    (vector-identity! (-> s5-1 scale))
    (set! (-> self starting-pos quad) (-> arg0 pos quad))
    (vector-normalize-copy! (-> self starting-dir) (-> arg0 vel) 1.0)
    (net-projectile-method-72
      self
      (-> s5-1 trans)
      (-> s5-1 transv)
      (-> arg0 pos)
      (-> arg0 vel)
      (-> self spawn-time)
      (current-time)
      )
    (set! (-> self pre-move-transv quad) (-> s5-1 transv quad))
    (vector+float*! (-> self base-target-pos) (-> s5-1 trans) (-> self starting-dir) 2048000.0)
    )
  (set! (-> self target-pos quad) (-> self base-target-pos quad))
  (set! (-> self event-hook) projectile-event-handler)
  (projectile-method-61 self)
  (update-transforms (-> self root))
  (projectile-method-54 self)
  (projectile-method-58 self 0)
  (when (logtest? (-> self options) (projectile-options po15))
    (if (projectile-method-69 self)
        (go-virtual impact)
        )
    )
  (if (not (registered? self))
      (register
        self
        (if *net-mgr*
            (-> *net-mgr* game-state local-machine-idx)
            0
            )
        #xffff
        )
      )
  (projectile-method-62 self)
  )

;; definition for method 35 of type net-projectile
;; INFO: Used lq/sq
;; WARN: Return type mismatch object vs none.
(defmethod init-remote ((this net-projectile) (arg0 mem-buffer))
  (local-vars (a0-5 process-nettable))
  (let ((gp-0 (new 'stack-no-clear 'net-projectile-stack)))
    (read-vector arg0 (-> gp-0 pos))
    (read-vector arg0 (-> gp-0 vel))
    (let ((a1-3 (read-uint16 arg0)))
      (set! (-> gp-0 target-handle)
            (cond
              ((= a1-3 #xffff)
               (the-as handle #f)
               )
              ((begin (set! a0-5 (get-process-by-net-id *net-process-mgr* (the-as int a1-3))) a0-5)
               (process->handle a0-5)
               )
              (else
                (the-as handle #f)
                )
              )
            )
      )
    (let ((a1-4 (read-uint16 arg0)))
      (set! (-> gp-0 owner-handle)
            (the-as handle (cond
                             ((= a1-4 #xffff)
                              (the-as int #f)
                              )
                             (else
                               (let ((a0-11 (get-process-by-net-id *net-process-mgr* (the-as int a1-4))))
                                 (if a0-11
                                     (process->handle a0-11)
                                     (the-as int #f)
                                     )
                                 )
                               )
                             )
                    )
            )
      )
    (set! (-> gp-0 attack-id) (read-uint32 arg0))
    (set! (-> gp-0 options) (the-as projectile-options (read-uint64 arg0)))
    (set! (-> gp-0 spawn-time) (read-int32 arg0))
    (set! (-> gp-0 damage) (read-float arg0))
    (set! (-> gp-0 vehicle-damage-factor) (read-float arg0))
    (set! (-> gp-0 vehicle-impulse-factor) (read-float arg0))
    (set! (-> gp-0 wpn-type) (read-uint8 arg0))
    (net-projectile-method-73 this arg0)
    (set! (-> gp-0 params ent) (-> this entity))
    (set! (-> gp-0 params charge) 1.0)
    (set! (-> gp-0 params options) (-> gp-0 options))
    (set! (-> gp-0 params pos quad) (-> gp-0 pos quad))
    (set! (-> gp-0 params vel quad) (-> gp-0 vel quad))
    (set! (-> gp-0 params notify-handle) (the-as handle #f))
    (set! (-> gp-0 params owner-handle) (ppointer->handle (-> gp-0 owner-handle process)))
    (set! (-> gp-0 params target-handle) (ppointer->handle (-> gp-0 target-handle process)))
    (set! (-> gp-0 params target-pos quad) (the-as uint128 0))
    (set! (-> gp-0 params ignore-handle) (ppointer->handle (-> gp-0 owner-handle process)))
    (set! (-> gp-0 params attack-id) (-> gp-0 attack-id))
    (set! (-> gp-0 params timeout) (seconds 4))
    (set! (-> gp-0 params wpn-type) (-> gp-0 wpn-type))
    (set! (-> gp-0 params damage) (-> gp-0 damage))
    (set! (-> gp-0 params vehicle-damage-factor) (-> gp-0 vehicle-damage-factor))
    (set! (-> gp-0 params vehicle-impulse-factor) (-> gp-0 vehicle-impulse-factor))
    (net-projectile-init-by-other (-> gp-0 params) (-> gp-0 spawn-time))
    )
  (none)
  )

;; definition for method 73 of type net-projectile

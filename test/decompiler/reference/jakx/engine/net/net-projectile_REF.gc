;; definition for method 74 of type net-projectile
(defmethod send-force-position ((this net-projectile))
  (let ((s5-0 (alloc-msg this 'force-position)))
    (write-vector s5-0 (-> this root trans))
    (write-quaternion s5-0 (-> this root rotation))
    (send-msg this s5-0 -2 208)
    (free-msg this s5-0)
    )
  (none)
  )

;; failed to figure out what this is:
(defstate die (net-projectile)
  :virtual #t
  :code (behavior ()
    (let ((v1-0 (-> self notify-handle)))
      (send-event (handle->process v1-0) 'notify 'die)
      )
    (if (registered? self)
        (unregister self #t (the-as mem-buffer #f))
        )
    (while (-> self child)
      (suspend)
      )
    (process-drawable-method-44 self)
    )
  )

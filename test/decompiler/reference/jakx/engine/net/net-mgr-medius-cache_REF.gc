          (((medius-cached-info-status error))
           (if (< (seconds 10) (- (-> *display* real-clock frame-counter) (the-as time-frame (-> a0-13 fetched-time))))
               (set! (-> this objects v1-0 status) (medius-cached-info-status requested))
               )

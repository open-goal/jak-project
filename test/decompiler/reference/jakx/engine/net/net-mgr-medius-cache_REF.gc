          (((medius-cached-info-status valid))
           (if (and (> arg1 0)
                    (< arg1 (- (-> *display* real-clock frame-counter) (the-as time-frame (-> a0-13 fetched-time))))
                    (not arg3)
                    )
               (set! (-> this objects v1-0 status) (medius-cached-info-status stale))
               )
           (return a0-13)

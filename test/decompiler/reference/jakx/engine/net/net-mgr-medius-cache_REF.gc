          (if (or (not gp-0) (< (-> gp-0 accessed-time) (-> a1-2 accessed-time)))
              (set! gp-0 a1-2)
              )
          )
        )
      )
    (when (not gp-0)
      (dotimes (v1-4 (-> arg0 objects length))
        (let ((a1-7 (-> arg0 objects v1-4)))
          (when (= (-> a1-7 status) (medius-cached-info-status stale))
            (if (or (not gp-0) (< (-> gp-0 accessed-time) (-> a1-7 accessed-time)))
                (set! gp-0 a1-7)

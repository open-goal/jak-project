;; definition for function medius-cache-tick
;; WARN: Return type mismatch int vs object.
(defun medius-cache-tick ((arg0 medius-cache))
  (let ((gp-0 (the-as medius-cached-info #f)))
    (dotimes (v1-0 (-> arg0 objects length))
      (let ((a1-2 (-> arg0 objects v1-0)))
        (if (= (-> a1-2 status) (medius-cached-info-status busy))

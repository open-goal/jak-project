;;-*-Lisp-*-
(in-package goal)

;; definition for function task-level-to-idx
(defun task-level-to-idx ((arg0 task-level))
  (let ((s5-0 0))
    (dotimes (s4-0 (length (-> *game-info* sub-task-list)))
      (let* ((v1-2 (-> *game-info* sub-task-list s4-0))
             (a0-6 (-> *game-info* play-list (-> v1-2 task)))
             )
        (when (= (-> v1-2 net-play-mode) (net-play-mode timetrial))
          (if (= (-> a0-6 task-level) arg0)
              (return s5-0)
              )
          (+! s5-0 1)
          (if (>= s5-0 24)
              (return (the-as int #f))
              )
          )
        )
      )
    )
  (the-as int #f)
  )

;; definition for function ghost-crc-ok
(defun ghost-crc-ok ((arg0 timetrial-recording))
  (set! (-> arg0 cur-snap-time) 0)
  (set! (-> arg0 cur-idx) 0)
  (let ((a1-0 (get-mem-size arg0)))
    (when (or (<= (the-as int a1-0) 0) (< #x2c00 (the-as int a1-0)))
      (format 0 "bad mem size~%")
      (return #f)
      )
    (let ((s4-0 (-> arg0 crc)))
      (set! (-> arg0 crc) (the-as uint 0))
      (let ((s5-0 (knet-crc (the-as pointer arg0) (the-as int a1-0))))
        (set! (-> arg0 crc) s4-0)
        (format 0 "crc: ~X ~X~%" s4-0 s5-0)
        (when (!= (logand (the-as uint #xffffffff) s5-0) (logand (the-as uint #xffffffff) s4-0))
          (format 0 "bad crc~%")
          (return #f)
          )
        )
      )
    )
  #t
  )

;; definition for symbol *ghost-tmp-string*, type string
(define *ghost-tmp-string* "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx")

;; definition of type ghost-file
(deftype ghost-file (structure)
  ((name               uint8  128)
   (name-s8            int8   128 :overlay-at (-> name 0))
   (time               int32)
   (len                int32)
   (acct-id            int32)
   (vehicle-selection  int32)
   (driver-selection   int32)
   (load-parts         vehicle-load-parts)
   )
  (:methods
    (init! (_type_) object)
    )
  )

;; definition for method 3 of type ghost-file
(defmethod inspect ((this ghost-file))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'ghost-file)
  (format #t "~1Tname[128] @ #x~X~%" (-> this name))
  (format #t "~1Ttime: ~D~%" (-> this time))
  (format #t "~1Tlen: ~D~%" (-> this len))
  (format #t "~1Tacct-id: ~D~%" (-> this acct-id))
  (format #t "~1Tvehicle-selection: ~D~%" (-> this vehicle-selection))
  (format #t "~1Tdriver-selection: ~D~%" (-> this driver-selection))
  (format #t "~1Tload-parts: ~D~%" (-> this load-parts))
  (label cfg-4)
  this
  )


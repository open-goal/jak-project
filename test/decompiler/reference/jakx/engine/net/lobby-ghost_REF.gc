;; definition for method 9 of type ghost-file
;; WARN: Return type mismatch int vs object.
(defmethod init! ((this ghost-file))
  (set! (-> this time) -1)
  (set! (-> this acct-id) -1)
  (dotimes (s5-0 (strlen (-> this name)))
    (if (= (-> this name-s8 s5-0) (-> "/" data 0))
        (copy-charp<-charp *ghost-tmp-buf* (&-> this name (+ s5-0 1)))
        )
    )
  (dotimes (s5-1 (strlen *ghost-tmp-buf*))
    (if (= (-> (the-as (pointer int8) (&+ *ghost-tmp-buf* s5-1))) (-> "-" data 0))
        (set! (-> *ghost-tmp-buf* s5-1) (the-as uint 32))
        )
    )
  (do-split-chat-msg *ghost-tmp-buf*)
  (if (< *chat-msg-string-ct* 5)
      (return (the-as object #f))
      )
  (set! (-> this acct-id) (atoi-better (the-as pointer (-> *chat-msg-strings* 0))))
  (set! (-> this time) (atoi-better (the-as pointer (-> *chat-msg-strings* 1))))
  (set! (-> this vehicle-selection) (atoi-better (the-as pointer (-> *chat-msg-strings* 2))))
  (set! (-> this driver-selection) (atoi-better (the-as pointer (-> *chat-msg-strings* 3))))
  (set! (-> this load-parts) (the-as vehicle-load-parts (x8toi (the-as pointer (-> *chat-msg-strings* 4)))))
  0
  )

;; definition for symbol *ghost-async-status*, type object
(define *ghost-async-status* (the-as object #f))

;; definition for symbol *ghost-req-id*, type int
(define *ghost-req-id* 0)

;; definition for function send-ghost-file
(defbehavior send-ghost-file process ((arg0 timetrial-recording) (arg1 symbol))
  (format 0 "setting stack size~%")
  (if (not arg1)
      (stack-size-set! (-> self main-thread) 1600)
      )
  (format 0 "getting time~%")
  (-> *display* real-clock frame-counter)
  (let* ((v1-13 (-> *game-info* play-list (-> *game-info* sub-task-list (-> arg0 task-node) task)))
         (s5-1 (symbol->string (-> *task-level* (-> v1-13 task-level))))
         )
    (format 0 "making string~%")
    (format (clear *ghost-tmp-string*) "ghosts-~D/~S/~D-*" 2 s5-1 (-> arg0 acct-id))
    (format 0 "listing files...~%")
    (let ((s4-1 (new 'stack-no-clear 'medius-file-list-request)))
      (mem-clear! (-> s4-1 filename-begins-with) 173)
      (let ((t9-9 itoa)
            (a0-15 (+ *ghost-req-id* 1))
            )
        (set! *ghost-req-id* a0-15)
        (t9-9 a0-15 (-> s4-1 message-id))
        )
      (copy-charp<-charp (-> s4-1 filename-begins-with) (-> *ghost-tmp-string* data))
      (set! (-> s4-1 filesize-less-than) (the-as uint #x2c00))
      (set! (-> s4-1 filesize-greater-than) (the-as uint 0))
      (set! (-> s4-1 owned-by-id) (the-as uint -1))
      (set! (-> s4-1 starting-entry-number) (the-as uint 0))
      (set! (-> s4-1 page-size) (the-as uint 32))
      (set! *ghost-async-status* (the-as object #f))
      (set! *ghost-file-ct* 0)
      (format 0 "making request~%")
      (set! *scert-function-id* (scert-function medius-file-list))
      (if (nonzero? (knet-scert-function-3-args
                      (-> s4-1 filename-begins-with)
                      (lambda ((arg0 medius-file-list-response) (arg1 object))
                        (if (!= (atoi (-> arg0 message-id)) *ghost-req-id*)
                            (return #f)
                            )
                        (cond
                          ((= (-> arg0 status-code) (medius-status-code medius-no-result))
                           (set! *ghost-async-status* (the-as object 0))
                           0
                           )
                          ((= (-> arg0 status-code) (medius-status-code medius-success))
                           (when (< *ghost-file-ct* 32)
                             (copy-charp<-charp (-> *ghost-files* *ghost-file-ct* name) (-> arg0 medius-file-info filename))
                             (set! (-> *ghost-files* *ghost-file-ct* len) (the-as int (-> arg0 medius-file-info file-size)))
                             (set! *ghost-file-ct* (+ *ghost-file-ct* 1))
                             (if (nonzero? (-> arg0 end-of-list))
                                 (set! *ghost-async-status* (-> arg0 status-code))
                                 )
                             )
                           )
                          (else
                            (set! *ghost-async-status* (-> arg0 status-code))
                            )
                          )
                        (none)
                        )
                      0
                      )
                    )
          (return #f)
          )
      )
    (format 0 "waiting~%")
    (suspend-for (seconds 10)
      (if *ghost-async-status*
          (goto cfg-11)
          )
      )
    (label cfg-11)
    (format 0 "checking error~%")
    (if (nonzero? *ghost-async-status*)
        (return #f)
        )
    (format 0 "deleting files...~%")
    (dotimes (s4-3 *ghost-file-ct*)
      (let ((s3-0 (new 'stack-no-clear 'medius-file-delete-request)))
        (mem-clear! (the-as pointer (-> s3-0 medius-file-info)) 193)
        (let ((t9-17 itoa)
              (a0-23 (+ *ghost-req-id* 1))
              )
          (set! *ghost-req-id* a0-23)
          (t9-17 a0-23 (-> s3-0 message-id))
          )
        (copy-charp<-charp (-> s3-0 medius-file-info filename) (-> *ghost-files* s4-3 name))
        (set! *ghost-async-status* (the-as object #f))
        (set! *scert-function-id* (scert-function medius-file-delete))
        (if (zero? (knet-scert-function-3-args
                     (-> s3-0 medius-file-info)
                     (lambda ((arg0 medius-file-delete-response) (arg1 object))
                       (if (!= (atoi (-> arg0 message-id)) *ghost-req-id*)
                           (return #f)
                           )
                       (set! *ghost-async-status* (-> arg0 status-code))
                       (none)
                       )
                     0
                     )
                   )
            (suspend-for (seconds 10)
              (if *ghost-async-status*
                  (goto cfg-22)
                  )
              )
            )
        )
      (label cfg-22)
      (format 0 "delete file: ~G returned ~D~%" (-> *ghost-files* s4-3) *ghost-async-status*)
      )
    (format (clear *ghost-tmp-string*) "ghosts-~D/" 2)
    (format
      *ghost-tmp-string*
      "~S/~D-~D-~D-~D-~8X"
      s5-1
      (-> arg0 acct-id)
      (-> arg0 total-time)
      (-> arg0 player-info vehicle-selection)
      (-> arg0 player-info desired-driver-selection)
      (-> arg0 player-info vehicle-load-parts)
      )
    )
  (format 0 "creating file...~%")
  (let ((s5-2 (new 'stack-no-clear 'medius-file-checksum)))
    (mem-clear! (&-> s5-2 puc-data) 24)
    (set! (-> s5-2 puc-data) (the-as pointer arg0))
    (set! (-> s5-2 ui-size) (get-mem-size arg0))
    (set! *scert-function-id* (scert-function medius-file-generate-checksum))
    (knet-scert-function-1-args (&-> s5-2 puc-data))
    (let ((s4-5 (new 'stack-no-clear 'medius-file-create-request)))
      (mem-clear! (the-as pointer (-> s4-5 medius-file-to-create)) 469)
      (let ((t9-29 itoa)
            (a0-35 (+ *ghost-req-id* 1))
            )
        (set! *ghost-req-id* a0-35)
        (t9-29 a0-35 (-> s4-5 message-id))
        )
      (copy-charp<-charp (-> s4-5 medius-file-to-create filename) (-> *ghost-tmp-string* data))
      (set! (-> s4-5 medius-file-to-create owner-permission-rwx) (the-as uint 7))
      (set! (-> s4-5 medius-file-to-create group-permission-rwx) (the-as uint 7))
      (set! (-> s4-5 medius-file-to-create global-permission-rwx) (the-as uint 7))
      (set! (-> s4-5 medius-file-to-create owner-id) (the-as uint -1))
      (set! (-> s4-5 medius-file-to-create file-size) (get-mem-size arg0))
      (set! *ghost-async-status* (the-as object #f))
      (set! *scert-function-id* (scert-function medius-file-create))
      (knet-scert-function-3-args
        (-> s4-5 medius-file-to-create)
        (lambda ((arg0 medius-file-list-response) (arg1 object))
          (inspect arg0)
          (if (!= (atoi (-> arg0 message-id)) *ghost-req-id*)
              (return #f)
              )
          (mem-copy! (the-as pointer *ghost-file-info*) (the-as pointer (-> arg0 medius-file-info)) 172)
          (set! *ghost-async-status* (-> arg0 status-code))
          (none)
          )
        0
        )
      )
    (suspend-for (seconds 10)
      (if *ghost-async-status*
          (goto cfg-30)
          )
      )
    (label cfg-30)
    (if (nonzero? *ghost-async-status*)
        (return #f)
        )
    (format 0 "uploading file...~%")
    (let ((s4-7 (new 'stack-no-clear 'medius-file-upload-request)))
      (mem-clear! (the-as pointer (-> s4-7 medius-file-info)) 201)
      (let ((t9-35 itoa)
            (a0-41 (+ *ghost-req-id* 1))
            )
        (set! *ghost-req-id* a0-41)
        (t9-35 a0-41 (-> s4-7 message-id))
        )
      (set! (-> s4-7 puc-data-start) (the-as uint arg0))
      (set! (-> s4-7 ui-data-size) (get-mem-size arg0))
      (mem-copy! (the-as pointer (-> s4-7 medius-file-info)) (the-as pointer *ghost-file-info*) 172)
      (mem-copy! (-> s4-7 medius-file-info server-checksum) (-> s5-2 checksum) 16)
      (set! *ghost-async-status* (the-as object #f))
      (set! *scert-function-id* (scert-function medius-file-upload))
      (knet-scert-function-3-args
        (-> s4-7 medius-file-info)
        (lambda ((arg0 medius-file-upload-response) (arg1 object))
          (inspect arg0)
          (if (!= (atoi (-> arg0 message-id)) *ghost-req-id*)
              (return #f)
              )
          (cond
            ((or (< (the-as int (-> arg0 status-code)) 0) (zero? (-> arg0 i-xfer-status)))
             (set! *ghost-async-status* -1)
             )
            ((= (-> arg0 i-xfer-status) 3)
             (set! *ghost-async-status* (the-as object 0))
             0
             )
            )
          (none)
          )
        0
        )
      )
    (suspend-for (seconds 60)
      (if *ghost-async-status*
          (goto cfg-39)
          )
      )
    (label cfg-39)
    (if (nonzero? *ghost-async-status*)
        (return #f)
        )
    (format 0 "closing file...~%")
    (let ((gp-2 (new 'stack-no-clear 'medius-file-close-request)))
      (mem-clear! (the-as pointer (-> gp-2 medius-file-info)) 193)
      (let ((t9-42 itoa)
            (a0-48 (+ *ghost-req-id* 1))
            )
        (set! *ghost-req-id* a0-48)
        (t9-42 a0-48 (-> gp-2 message-id))
        )
      (mem-copy! (the-as pointer (-> gp-2 medius-file-info)) (the-as pointer *ghost-file-info*) 172)
      (mem-copy! (-> gp-2 medius-file-info server-checksum) (-> s5-2 checksum) 16)
      (set! *ghost-async-status* (the-as object #f))
      (set! *scert-function-id* (scert-function medius-file-close))
      (knet-scert-function-3-args
        (-> gp-2 medius-file-info)
        (lambda ((arg0 medius-file-close-response) (arg1 object))
          (if (!= (atoi (-> arg0 message-id)) *ghost-req-id*)
              (return #f)
              )
          (set! *ghost-async-status* (-> arg0 status-code))
          (none)
          )
        0
        )
      )
    )
  (suspend-for (seconds 60)
    (if *ghost-async-status*
        (goto cfg-48)
        )
    )
  (label cfg-48)
  (if (nonzero? *ghost-async-status*)
      (return #f)
      )
  (format 0 "ok?~%")
  #t
  )

;; definition for function restore-ghost-from-memcard
(defbehavior restore-ghost-from-memcard process ((arg0 task-level))
  (when (not (-> *setting-control* user-current auto-save))
    (mem-clear! (the-as pointer *ghost-rec*) 100)
    (return #f)
    )
  (let ((a0-2 (task-level-to-idx arg0)))
    (if (not a0-2)
        (return #f)
        )
    (set! *mc-ghost-idx* a0-2)
    )
  (when (and *net-world* (= (-> *ghost-rec* task-node) (-> *net-world* task-node)) (ghost-crc-ok *ghost-rec*))
    (format 0 "using previous ghost info~%")
    (return #t)
    )
  (set! *mc-ghost-ptr* (the-as pointer *ghost-rec*))
  (let ((gp-0 (process->handle (ppointer->process (auto-save-command 'restore-ghost 0 0 self #f #f)))))
    (while (handle->process (the-as handle gp-0))
      (suspend)
      )
    )
  (format 0 "memcard finished: ~D~%" *mc-last-result*)
  (when (!= *mc-last-result* (mc-status-code ok))
    (mem-clear! (the-as pointer *ghost-rec*) 100)
    (return #f)
    )
  (when (not (ghost-crc-ok *ghost-rec*))
    (mem-clear! (the-as pointer *ghost-rec*) 100)
    (return #f)
    )
  #t
  )

;; definition for function do-get-best-ghost
;; WARN: Return type mismatch symbol vs object.
(defbehavior do-get-best-ghost process ((arg0 task-level) (arg1 int))
  (stack-size-set! (-> self main-thread) 1600)
  (let ((s5-1 (symbol->string (-> *task-level* arg0))))
    (format 0 "lev: ~S~%" s5-1)
    (if (= arg1 -1)
        (format (clear *ghost-tmp-string*) "ghosts-~D/~S/*" 2 s5-1)
        (format (clear *ghost-tmp-string*) "ghosts-~D/~S/~8X-*" 2 s5-1 arg1)
        )
    )
  (format 0 "listing files... ~S~%" *ghost-tmp-string*)
  (let ((gp-2 (new 'stack-no-clear 'medius-file-list-request)))
    (mem-clear! (-> gp-2 filename-begins-with) 173)
    (let ((t9-9 itoa)
          (a0-11 (+ *ghost-req-id* 1))
          )
      (set! *ghost-req-id* a0-11)
      (t9-9 a0-11 (-> gp-2 message-id))
      )
    (copy-charp<-charp (-> gp-2 filename-begins-with) (-> *ghost-tmp-string* data))
    (set! (-> gp-2 filesize-less-than) (the-as uint #x2c00))
    (set! (-> gp-2 filesize-greater-than) (the-as uint 0))
    (set! (-> gp-2 owned-by-id) (the-as uint -1))
    (set! (-> gp-2 starting-entry-number) (the-as uint 0))
    (set! (-> gp-2 page-size) (the-as uint 1024))
    (set! *ghost-async-status* (the-as object #f))
    (set! *ghost-file-ct* 0)

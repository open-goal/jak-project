;; definition for function restore-selection-index
;; WARN: Return type mismatch symbol vs object.
(defun restore-selection-index ()
  (let ((a0-1 (the-as selection-menu-manager (find-menu *lobby-menu-manager* 'manager))))
    (when a0-1
      (dotimes (v1-1 3)
        (let ((a1-4 (mod (+ (- -1 v1-1) *selection-cache-index*) 3)))
          (if (< a1-4 0)
              (+! a1-4 3)
              )
          (when (= (-> *selection-cache-array* a1-4 state) (-> *lobby-menu-manager* state name))
            (select-by-sym a0-1 (-> *selection-cache-array* a1-4 selection-type))
            (return (the-as object #t))
            )
          )
        )
      #f
      )
    )
  )


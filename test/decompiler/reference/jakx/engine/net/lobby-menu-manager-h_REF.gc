;; definition for function teams-valid-to-start-game?
(defun teams-valid-to-start-game? ()
  (let ((s5-0 0)
        (gp-0 0)
        )
    (cond
      ((logtest? (-> *net-world* net-state options advanced-options flags)
                 (game-task-advanced-options-flag team-game)
                 )
       (dotimes (s4-0 24)
         (when (player-idx-vehicle-selected? *net-world* s4-0)
           (format #t "valid player: ~D~%" s4-0)
           (if (zero? (-> *net-world* net-state players s4-0 team-id))
               (+! s5-0 1)
               (+! gp-0 1)
               )
           )
         )
       )
      (else
        (return #t)
        )
      )
    (if (or (zero? s5-0) (zero? gp-0))
        (return #f)
        (return #t)
        )
    )
  (the-as symbol 0)
  )

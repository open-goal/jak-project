;; definition for symbol *ghost-upload-proc*, type handle-wrapper
(define *ghost-upload-proc* (new 'static 'handle-wrapper))

;; failed to figure out what this is:
(set! (-> *ghost-upload-proc* handle) (the-as uint #f))

;; definition for symbol *ghost-download-proc*, type handle-wrapper
(define *ghost-download-proc* (new 'static 'handle-wrapper))

;; failed to figure out what this is:
(set! (-> *ghost-download-proc* handle) (the-as uint #f))

;; definition for method 12 of type timetrial-recording
;; WARN: Return type mismatch int vs uint.
(defmethod timetrial-recording-method-12 ((this timetrial-recording))
  (the-as uint (+ (* (the-as uint 12) (-> this total-snaps)) 100))
  )

;;-*-Lisp-*-
(in-package goal)

;; definition for symbol *ghosts-enabled*, type symbol
(define *ghosts-enabled* #t)

;; definition of type timetrial-snapshot
(deftype timetrial-snapshot (structure)
  ((pos-x-lo   uint16)
   (pos-y      uint16)
   (pos-z-lo   uint16)
   (pos-xz-hi  uint8)
   (rot        uint8  3)
   (flags      uint8)
   (skip       uint8)
   )
  :pack-me
  (:methods
    (timetrial-snapshot-method-9 () none)
    (timetrial-snapshot-method-10 () none)
    (timetrial-snapshot-method-11 () none)
    (timetrial-snapshot-method-12 () none)
    )
  )

;; definition for method 3 of type timetrial-snapshot
(defmethod inspect ((this timetrial-snapshot))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'timetrial-snapshot)
  (format #t "~1Tpos-x-lo: ~D~%" (-> this pos-x-lo))
  (format #t "~1Tpos-y: ~D~%" (-> this pos-y))
  (format #t "~1Tpos-z-lo: ~D~%" (-> this pos-z-lo))
  (format #t "~1Tpos-xz-hi: ~D~%" (-> this pos-xz-hi))
  (format #t "~1Trot[3] @ #x~X~%" (-> this rot))
  (format #t "~1Tflags: ~D~%" (-> this flags))
  (format #t "~1Tskip: ~D~%" (-> this skip))
  (label cfg-4)
  this
  )

;; definition of type timetrial-recording
(deftype timetrial-recording (structure)
  ((crc            uint32)
   (total-snaps    uint32)
   (total-time     uint32)
   (task-node      uint32)
   (acct-id        uint32)
   (player-info    net-world-staging-player  :inline)
   (player-name    uint8                     32)
   (cur-idx        int32)
   (start-pos      int32)
   (cur-snap-time  int32)
   (data           timetrial-snapshot        :dynamic)
   )
  (:methods
    (timetrial-recording-method-9 () none)
    (timetrial-recording-method-10 () none)
    (timetrial-recording-method-11 () none)
    (timetrial-recording-method-12 (_type_) uint)
    (timetrial-recording-method-13 () none)
    )
  )

;; definition for method 3 of type timetrial-recording
(defmethod inspect ((this timetrial-recording))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'timetrial-recording)
  (format #t "~1Tcrc: ~D~%" (-> this crc))
  (format #t "~1Ttotal-snaps: ~D~%" (-> this total-snaps))
  (format #t "~1Ttotal-time: ~D~%" (-> this total-time))
  (format #t "~1Ttask-node: ~D~%" (-> this task-node))
  (format #t "~1Tacct-id: ~D~%" (-> this acct-id))
  (format #t "~1Tplayer-info: #<net-world-staging-player @ #x~X>~%" (-> this player-info))
  (format #t "~1Tplayer-name[32] @ #x~X~%" (-> this player-name))
  (format #t "~1Tcur-idx: ~D~%" (-> this cur-idx))
  (format #t "~1Tstart-pos: ~D~%" (-> this start-pos))
  (format #t "~1Tcur-snap-time: ~D~%" (-> this cur-snap-time))
  (format #t "~1Tdata[0] @ #x~X~%" (-> this data))
  (label cfg-4)
  this
  )

;; definition for symbol *ghost-rec*, type (inline-array timetrial-snapshot)
(define *ghost-rec* (new 'static 'inline-array timetrial-snapshot 938

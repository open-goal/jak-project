;; definition for symbol *playback-buf*, type mem-buffer
(define *playback-buf* (new 'static 'mem-buffer))

;; definition for symbol *playback-next-event-time*, type int
(define *playback-next-event-time* 0)

;; definition for symbol *playback-time*, type int
(define *playback-time* 0)

;; definition for symbol *playback-bytes-left*, type int
(define *playback-bytes-left* 0)

;; definition for symbol *playback-machine*, type int
(define *playback-machine* 0)

;; definition for symbol *playback-delay*, type int
(define *playback-delay* 0)

;; definition for symbol *playback-event-header*, type net-log-event-header
(define *playback-event-header* (new 'static 'net-log-event-header))

;; definition for function read-event-header
;; WARN: Return type mismatch int vs none.
(defun read-event-header ()
  (file-stream-read *playback-stream* (the-as pointer *playback-event-header*) 12)
  (let ((gp-0 (+ (-> *playback-event-header* length) -12)))
    (file-stream-read *playback-stream* *playback-buf-mem* (the-as int gp-0))
    (add-to-buffer *playback-buf* (&-> *playback-buf-mem* 0) (the-as int gp-0))
    )
  (set! *playback-bytes-left* (- *playback-bytes-left* (the-as int (-> *playback-event-header* length))))
  0
  (none)
  )

;; failed to figure out what this is:
(defstate starting-playback-game (net-mgr)
  :virtual #t
  :code (behavior ()
    (set! (-> *playback-name* data 0) (the-as uint 0))
    (format *playback-name* "~G" (-> *net-log-name* data))
    (file-stream-open *playback-stream* *playback-name* 'read)
    (read-event-header)
    (set! *playback-start-time* (the-as int (current-time)))
    (set! *playback-log-start-time* (-> *playback-event-header* time))
    (set! *playback-bytes-left* (file-stream-length *playback-stream*))
    (go-virtual playing-playback-game)
    )
  )

;; failed to figure out what this is:
(defstate playing-playback-game (net-mgr)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('leave-game)
       (file-stream-close *playback-stream*)
       (net-process-mgr-stop)
       (format 0 "net-mgr-notify: ~A~%" 'game-disconnected)
       (let ((a0-4 (-> *net-mgr* notify alive-list next0)))
         (-> *net-mgr* notify)
         (let ((gp-0 (-> a0-4 next0)))
           (while (!= a0-4 (-> *net-mgr* notify alive-list-end))
             (if (logtest? (the-as int (-> (the-as connection a0-4) param1)) 4)
                 (send-event
                   ((method-of-type connection get-process) (the-as connection a0-4))
                   'game-disconnected
                   :from *net-mgr*
                   )
                 )
             (set! a0-4 gp-0)
             (-> *net-mgr* notify)
             (set! gp-0 (-> gp-0 next0))
             )
           )
         )
       (go-virtual net-mgr-state-1)
       )
      )
    )
  :code (behavior ()
    (loop
      (while (let ((v1-5 (+ (- (current-time) (the-as time-frame *playback-start-time*)) *playback-log-start-time*)))
               (set! *playback-time* (the-as int v1-5))
               (< v1-5 (-> *playback-event-header* time))
               )
        (set! (-> self game-state time) (+ *playback-time* *playback-delay*))
        (suspend)
        )
      (let ((v1-8 (-> *playback-event-header* type)))
        (cond
          ((zero? v1-8)
           (format 0 "game-start~%")
           (let ((gp-0 (mem-buffer-method-32 *playback-buf*))
                 (s5-0 (mem-buffer-method-32 *playback-buf*))
                 )
             (mem-buffer-method-34 *playback-buf*)
             (format 0 "me=~D, sm=~D~%" gp-0 s5-0)
             (format 0 "we are playing back player ~D's game~%" gp-0)
             (set! *playback-machine* gp-0)
             (set! (-> self game-state connect-handle) (the-as basic 0))
             (set! (-> self game-state local-machine-idx) 8)
             (set! (-> self game-state session-master-idx) s5-0)
             )
           (logior! (-> self game-state connected-bitfield) (ash 1 (-> self game-state local-machine-idx)))
           (format 0 "net-mgr-notify: ~A~%" 'game-connect-complete)
           (let ((a0-14 (-> *net-mgr* notify alive-list next0)))
             (-> *net-mgr* notify)
             (let ((gp-1 (-> a0-14 next0)))
               (while (!= a0-14 (-> *net-mgr* notify alive-list-end))
                 (if (logtest? (the-as int (-> (the-as connection a0-14) param1)) 4)
                     (send-event
                       ((method-of-type connection get-process) (the-as connection a0-14))
                       'game-connect-complete
                       :from *net-mgr*
                       )
                     )
                 (set! a0-14 gp-1)
                 (-> *net-mgr* notify)
                 (set! gp-1 (-> gp-1 next0))
                 )
               )
             )
           (net-process-mgr-start)
           )
          ((= v1-8 1)
           (let ((gp-3 (mem-buffer-method-32 *playback-buf*)))
             (format 0 "client-join ~D~%" gp-3)
             (logior! (-> *net-mgr* game-state connected-bitfield) (ash 1 gp-3))
             (format 0 "net-mgr-notify: ~A~%" 'client-joined)
             (let ((a0-23 (-> *net-mgr* notify alive-list next0)))
               (-> *net-mgr* notify)
               (let ((s5-2 (-> a0-23 next0)))
                 (while (!= a0-23 (-> *net-mgr* notify alive-list-end))
                   (if (logtest? (the-as int (-> (the-as connection a0-23) param1)) 8)
                       (send-event
                         ((method-of-type connection get-process) (the-as connection a0-23))
                         'client-joined
                         :from *net-mgr*
                         gp-3
                         )
                       )
                   (set! a0-23 s5-2)
                   (-> *net-mgr* notify)
                   (set! s5-2 (-> s5-2 next0))
                   )
                 )
               )
             )
           )
          ((= v1-8 2)
           (let ((gp-5 (mem-buffer-method-32 *playback-buf*)))
             (format 0 "client-leave ~D~%" gp-5)
             (logand!
               (-> *net-mgr* game-state connected-bitfield)
               (logxor (the-as uint #xffffffff) (the-as uint (ash 1 gp-5)))
               )
             (format 0 "net-mgr-notify: ~A~%" 'client-left)
             (let ((a0-32 (-> *net-mgr* notify alive-list next0)))
               (-> *net-mgr* notify)
               (let ((s5-3 (-> a0-32 next0)))
                 (while (!= a0-32 (-> *net-mgr* notify alive-list-end))
                   (if (logtest? (the-as int (-> (the-as connection a0-32) param1)) 8)
                       (send-event
                         ((method-of-type connection get-process) (the-as connection a0-32))
                         'client-left
                         :from *net-mgr*
                         gp-5
                         )
                       )
                   (set! a0-32 s5-3)
                   (-> *net-mgr* notify)
                   (set! s5-3 (-> s5-3 next0))
                   )
                 )
               )
             )
           )
          ((= v1-8 3)
           (format 0 "sm-change~%")
           (let ((gp-7 (mem-buffer-method-32 *playback-buf*)))
             (format 0 "net-mgr-notify: ~A~%" 'session-master-change)
             (let ((a0-38 (-> *net-mgr* notify alive-list next0)))
               (-> *net-mgr* notify)
               (let ((s5-4 (-> a0-38 next0)))
                 (while (!= a0-38 (-> *net-mgr* notify alive-list-end))
                   (if (logtest? (the-as int (-> (the-as connection a0-38) param1)) 8)
                       (send-event
                         ((method-of-type connection get-process) (the-as connection a0-38))
                         'session-master-change
                         :from *net-mgr*
                         gp-7
                         )
                       )
                   (set! a0-38 s5-4)
                   (-> *net-mgr* notify)
                   (set! s5-4 (-> s5-4 next0))
                   )
                 )
               )
             (set! (-> *net-mgr* game-state session-master-idx) gp-7)
             )
           )
          ((= v1-8 4)
           (let ((s5-5 (new 'stack-no-clear 'mem-buffer))
                 (s4-4 (mem-buffer-method-32 *playback-buf*))
                 (gp-8 (mem-buffer-method-34 *playback-buf*))
                 )
             (mem-buffer-method-32 *playback-buf*)
             (if (not (and (= s4-4 *playback-machine*) (not (logtest? gp-8 #x8000))))
                 ((method-of-type mem-buffer add-to-buffer)
                  (the-as mem-buffer (&-> s5-5 base))
                  (-> *playback-buf* ptr)
                  (the-as int (-> (the-as (pointer uint8) (-> *playback-buf* ptr))))
                  )
                 )
             )
           )
          ((= v1-8 5)
           (format 0 "log comment: ~G~%" *playback-buf-mem*)
           )
          (else
            (format 0 "doh!~%")
            )
          )
        )
      (read-event-header)
      (when (<= *playback-bytes-left* 0)
        (file-stream-close *playback-stream*)
        (loop
          (suspend)
          )
        )
      )
    )
  )





;;-*-Lisp-*-
(in-package goal)

;; this file is debug only
(declare-file (debug))

;; definition for method 9 of type collide-cache
;; WARN: Return type mismatch int vs none.
(defmethod debug-draw ((this collide-cache))
  (debug-reset-prim-buffer)
  (let ((s5-0 (the-as object (-> this tris vertex))))
    (countdown (s4-0 (-> this num-tris))
      (let ((t1-0 (copy-and-set-field (-> *pat-mode-info* (-> (the-as collide-cache-tri s5-0) pat mode) color) a 64)))
        (add-debug-flat-triangle
          #t
          (bucket-id bucket785)
          (-> (the-as collide-cache-tri s5-0) vertex 0)
          (-> (the-as collide-cache-tri s5-0) vertex 1)
          (-> (the-as collide-cache-tri s5-0) vertex 2)
          t1-0
          )
        )
      (set! s5-0 (&+ (the-as collide-cache-tri s5-0) 64))
      )
    )
  (let ((s5-1 (the-as structure (-> this prims 0 prim-core))))
    (countdown (s4-1 (-> this num-prims))
      (when (= (-> (the-as collide-cache-prim s5-1) prim-core prim-type) -1)
        (let ((t0-1
                (copy-and-set-field
                  (-> *pat-mode-info*
                      (-> (the-as collide-shape-prim-sphere (-> (the-as collide-shape-prim s5-1) prim-core action)) pat mode)
                      color
                      )
                  a
                  64
                  )
                )
              )
          (add-debug-sphere
            #t
            (bucket-id bucket785)
            (-> (the-as collide-cache-prim s5-1) prim-core world-sphere)
            (-> (the-as collide-cache-prim s5-1) prim-core world-sphere w)
            t0-1
            )
          )
        )
      (set! s5-1 (&+ (the-as collide-cache-prim s5-1) 48))
      )
    )
  (print-collide-cache-tri-count this)
  0
  (none)
  )

;; definition of type col-rend-filter
(deftype col-rend-filter (structure)
  ((show-pat       uint32)
   (show-pat-mask  uint32)
   )
  )

;; definition for method 3 of type col-rend-filter
(defmethod inspect ((this col-rend-filter))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'col-rend-filter)
  (format #t "~1Tshow-pat: ~D~%" (-> this show-pat))
  (format #t "~1Tshow-pat-mask: ~D~%" (-> this show-pat-mask))
  (label cfg-4)
  this
  )

;; definition for function col-rend-draw
;; INFO: Used lq/sq
;; WARN: Return type mismatch symbol vs none.
(defun col-rend-draw ((arg0 col-rend) (arg1 col-rend-filter))
  (rlet ((vf0 :class vf)
         (vf4 :class vf)
         (vf5 :class vf)
         (vf6 :class vf)
         )
    (init-vf0-vector)
    (let ((s4-0 (new 'stack-no-clear 'matrix)))
      (set! (-> s4-0 rvec quad) (-> (math-camera-matrix) fvec quad))
      (vector-normalize! (-> s4-0 rvec) 1.0)
      (debug-reset-prim-buffer)
      (let ((s3-1 (the-as collide-cache-tri (-> *collide-cache* tris vertex))))
        (countdown (s2-0 (-> *collide-cache* num-tris))
          (vector-3pt-cross! (-> s4-0 uvec) (-> s3-1 vertex 0) (-> s3-1 vertex 1) (-> s3-1 vertex 2))
          (vector-normalize! (-> s4-0 uvec) 1.0)
          (when (or (-> arg0 show-back-faces?) (>= 0.0 (vector-dot (-> s4-0 rvec) (-> s4-0 uvec))))
            (let ((v1-10 (-> s3-1 pat)))
              (cond
                ((= (-> arg1 show-pat) (logand v1-10 (-> arg1 show-pat-mask)))
                 (let ((t1-0 (copy-and-set-field (-> *pat-mode-info* (-> v1-10 mode) color) a 64)))
                   (add-debug-flat-triangle
                     #t
                     (bucket-id bucket785)
                     (-> s3-1 vertex 0)
                     (-> s3-1 vertex 1)
                     (-> s3-1 vertex 2)
                     t1-0
                     )
                   )
                 (if (-> arg0 outline?)
                     (add-debug-outline-triangle
                       #t
                       (bucket-id bucket785)
                       (-> s3-1 vertex 0)
                       (-> s3-1 vertex 1)
                       (-> s3-1 vertex 2)
                       (new 'static 'rgba :r #x10 :g #x10 :b #x10 :a #x80)
                       )
                     )
                 (when (-> arg0 show-normals?)
                   (let ((a1-7 (-> s4-0 fvec)))
                     (let ((v1-23 (-> s3-1 vertex))
                           (a0-13 (-> s3-1 vertex 1))
                           )
                       (.lvf vf4 (&-> v1-23 0 quad))
                       (.lvf vf5 (&-> a0-13 quad))
                       )
                     (.mov.vf.w vf6 vf0)
                     (.add.vf.xyz vf6 vf4 vf5)
                     (.svf (&-> a1-7 quad) vf6)
                     )
                   (let ((a1-8 (-> s4-0 fvec)))
                     (let ((v1-24 (-> s4-0 fvec))
                           (a0-14 (-> s3-1 vertex 2))
                           )
                       (.lvf vf4 (&-> v1-24 quad))
                       (.lvf vf5 (&-> a0-14 quad))
                       )
                     (.mov.vf.w vf6 vf0)
                     (.add.vf.xyz vf6 vf4 vf5)
                     (.svf (&-> a1-8 quad) vf6)
                     )
                   (vector-float/! (-> s4-0 fvec) (-> s4-0 fvec) 3.0)
                   (add-debug-vector
                     #t
                     (bucket-id bucket785)
                     (-> s4-0 fvec)
                     (-> s4-0 uvec)
                     (meters 0.75)
                     (new 'static 'rgba :r #x80 :g #x80 :b #x80 :a #x80)
                     )
                   )
                 )
                ((-> arg0 ghost-hidden?)
                 (add-debug-flat-triangle
                   #t
                   (bucket-id bucket785)
                   (-> s3-1 vertex 0)
                   (-> s3-1 vertex 1)
                   (-> s3-1 vertex 2)
                   (new 'static 'rgba :r #x20 :g #x20 :b #x20 :a #x20)
                   )
                 (if (-> arg0 outline?)
                     (add-debug-outline-triangle
                       #t
                       (bucket-id bucket785)
                       (-> s3-1 vertex 0)
                       (-> s3-1 vertex 1)
                       (-> s3-1 vertex 2)
                       (new 'static 'rgba :r #x10 :g #x10 :b #x10 :a #x10)
                       )
                     )
                 )
                )
              )
            )
          (&+! s3-1 64)
          )
        )
      )
    (let ((s5-1 (the-as structure (-> *collide-cache* prims 0 prim-core))))
      (countdown (s4-1 (-> *collide-cache* num-prims))
        (when (= (-> (the-as collide-cache-prim s5-1) prim-core prim-type) -1)
          (let ((v1-39 (-> (the-as collide-shape-prim-sphere (-> (the-as collide-cache-prim s5-1) prim)) pat)))
            (when (= (-> arg1 show-pat) (logand v1-39 (-> arg1 show-pat-mask)))
              (let ((t0-5 (copy-and-set-field (-> *pat-mode-info* (-> v1-39 mode) color) a 64)))
                (add-debug-sphere
                  #t
                  (bucket-id bucket785)
                  (the-as vector (&+ s5-1 0))
                  (-> (the-as collide-cache-prim s5-1) prim-core world-sphere w)
                  t0-5
                  )
                )
              )
            )
          )
        (set! s5-1 (&+ (the-as collide-cache-prim s5-1) 48))
        )
      )
    (none)
    )
  )

;; definition for method 9 of type col-rend
;; INFO: Used lq/sq
(defmethod draw ((this col-rend))
  (let ((s5-0 (new 'stack-no-clear 'collide-query)))
    (let ((f30-0 (-> this bbox-radius)))
      (let ((v1-0 (-> this track)))
        (cond
          ((zero? v1-0)
           (set! (-> this bbox-center quad) (-> (target-pos 0) quad))
           (+! (-> this bbox-center y) (* 0.7 f30-0))
           )
          ((= v1-0 1)
           (position-in-front-of-camera!
             (-> this bbox-center)
             (+ (-> this camera-to-bbox-dist) (-> this bbox-radius))
             0.0
             )
           )
          )
        )
      (set! (-> s5-0 bbox min quad) (-> this bbox-center quad))
      (set! (-> s5-0 bbox min x) (- (-> s5-0 bbox min x) f30-0))
      (set! (-> s5-0 bbox min y) (- (-> s5-0 bbox min y) f30-0))
      (set! (-> s5-0 bbox min z) (- (-> s5-0 bbox min z) f30-0))
      (set! (-> s5-0 bbox max quad) (-> this bbox-center quad))
      (+! (-> s5-0 bbox max x) f30-0)
      (+! (-> s5-0 bbox max y) f30-0)
      (+! (-> s5-0 bbox max z) f30-0)
      )
    (let ((v1-9 -1))
      (let ((a0-9 (-> this cspec)))
        (if (not (logtest? a0-9 (collide-spec crate)))
            (set! v1-9 (logxor v1-9 1))
            )
        (if (not (logtest? a0-9 (collide-spec civilian)))
            (set! v1-9 (logxor v1-9 64))
            )
        (if (not (logtest? a0-9 (collide-spec enemy)))
            (set! v1-9 (logxor #x100000 v1-9))
            )
        (if (not (logtest? a0-9 (collide-spec obstacle)))
            (set! v1-9 (logxor v1-9 2))
            )
        (if (not (logtest? a0-9 (collide-spec vehicle-sphere)))
            (set! v1-9 (logand #x100e43 v1-9))
            )
        )
      (set! (-> s5-0 collide-with) (the-as collide-spec v1-9))
      )
    (set! (-> s5-0 ignore-pat) (new 'static 'pat-surface))
    (set! (-> s5-0 ignore-process0) #f)
    (set! (-> s5-0 ignore-process1) #f)
    (set! (-> s5-0 nav-mesh) #f)
    (add-debug-box
      #t
      (bucket-id bucket793)
      (-> s5-0 bbox min)
      (-> s5-0 bbox max)
      (if (logtest? (current-time) 128)
          (new 'static 'rgba :r #x80 :g #x80 :b #x80 :a #x20)
          (new 'static 'rgba :a #x20)
          )
      )
    (OK-fill-using-bounding-box *collide-cache* s5-0)
    )
  (let ((a1-17 (new 'stack 'col-rend-filter)))
    (set! (-> a1-17 show-pat) (-> this show-only))
    (set! (-> a1-17 show-pat-mask) (-> this show-only-mask))
    (col-rend-draw this a1-17)
    )
  (none)
  )





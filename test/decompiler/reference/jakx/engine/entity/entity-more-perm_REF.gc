;;-*-Lisp-*-
(in-package goal)

;; definition of type entity-more-perm
(deftype entity-more-perm (structure)
  ((aid          actor-id)
   (ent          entity)
   (user-object  object  2)
   (user-uint64  uint64    :overlay-at (-> user-object 0))
   (user-float   float   2 :overlay-at (-> user-object 0))
   (user-int32   int32   2 :overlay-at (-> user-object 0))
   (user-uint32  uint32  2 :overlay-at (-> user-object 0))
   (user-int16   int16   4 :overlay-at (-> user-object 0))
   (user-uint16  uint16  4 :overlay-at (-> user-object 0))
   (user-int8    int8    8 :overlay-at (-> user-object 0))
   (user-uint8   uint8   8 :overlay-at (-> user-object 0))
   )
  (:methods
    (entity-more-perm-method-9 (_type_) none)
    )
  )

;; definition for method 3 of type entity-more-perm
(defmethod inspect ((this entity-more-perm))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'entity-more-perm)
  (format #t "~1Taid: ~D~%" (-> this aid))
  (format #t "~1Tent: ~A~%" (-> this ent))
  (format #t "~1Tuser-object[2] @ #x~X~%" (-> this user-object))
  (format #t "~1Tuser-uint64: ~D~%" (-> this user-uint64))
  (format #t "~1Tuser-float[2] @ #x~X~%" (-> this user-object))
  (format #t "~1Tuser-int32[2] @ #x~X~%" (-> this user-object))
  (format #t "~1Tuser-uint32[2] @ #x~X~%" (-> this user-object))
  (format #t "~1Tuser-int16[4] @ #x~X~%" (-> this user-object))
  (format #t "~1Tuser-uint16[4] @ #x~X~%" (-> this user-object))
  (format #t "~1Tuser-int8[8] @ #x~X~%" (-> this user-object))
  (format #t "~1Tuser-uint8[8] @ #x~X~%" (-> this user-object))
  (label cfg-4)
  this
  )

;; definition of type entity-more-perm-hash
(deftype entity-more-perm-hash (structure)
  ((data                 entity-more-perm  512 :inline)
   (entity-more-perm-ct  int32)
   (entity-indices       int16             1024)
   )
  (:methods
    (entity-more-perm-hash-method-9 (_type_) none)
    (entity-more-perm-hash-method-10 (_type_ uint) uint)
    (entity-more-perm-hash-method-11 (_type_ actor-id) entity-more-perm)
    (entity-more-perm-hash-method-12 (_type_ actor-id (pointer symbol)) entity-more-perm)
    (entity-more-perm-hash-method-13 (_type_ level) symbol)
    (entity-more-perm-hash-method-14 (_type_ level) symbol)
    )
  )

;; definition for method 3 of type entity-more-perm-hash
(defmethod inspect ((this entity-more-perm-hash))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'entity-more-perm-hash)
  (format #t "~1Tdata[512] @ #x~X~%" (-> this data))
  (format #t "~1Tentity-more-perm-ct: ~D~%" (-> this entity-more-perm-ct))
  (format #t "~1Tentity-indices[1024] @ #x~X~%" (-> this entity-indices))
  (label cfg-4)
  this
  )

;; definition for symbol *entity-more-perm*, type entity-more-perm-hash
(define *entity-more-perm* (new 'static 'entity-more-perm-hash))

;; definition for method 9 of type entity-more-perm-hash
;; WARN: Return type mismatch int vs none.
(defmethod entity-more-perm-hash-method-9 ((this entity-more-perm-hash))
  (dotimes (v1-0 1024)
    (set! (-> this entity-indices v1-0) -1)
    )
  (set! (-> this entity-more-perm-ct) 0)
  0
  (none)
  )

;; definition for method 10 of type entity-more-perm-hash
;; WARN: new jak 2 until loop case, check carefully
(defmethod entity-more-perm-hash-method-10 ((this entity-more-perm-hash) (arg0 uint))
  (let ((v0-0 (logand arg0 1023)))
    (let ((v1-1 (logior (shr arg0 10) 1)))
      (until #f
        (let ((a2-2 (-> this entity-indices v0-0)))
          (if (= a2-2 -1)
              (return v0-0)
              )
          (if (= (-> this data a2-2 aid) arg0)
              (return v0-0)
              )
          )
        (set! v0-0 (logand (+ v0-0 v1-1) 1023))
        )
      )
    #f
    v0-0
    )
  )

;; definition for method 11 of type entity-more-perm-hash
(defmethod entity-more-perm-hash-method-11 ((this entity-more-perm-hash) (arg0 actor-id))
  (let ((v1-1 (entity-more-perm-hash-method-10 this (the-as uint arg0))))
    (if (= (-> this entity-indices v1-1) -1)
        (the-as entity-more-perm #f)
        (-> this data (-> this entity-indices v1-1))
        )
    )
  )

;; definition for method 12 of type entity-more-perm-hash
(defmethod entity-more-perm-hash-method-12 ((this entity-more-perm-hash) (arg0 actor-id) (arg1 (pointer symbol)))
  (local-vars (s3-0 entity-more-perm))
  (if arg1
      (set! (-> arg1 0) #f)
      )
  (let ((v1-3 (entity-more-perm-hash-method-10 this (the-as uint arg0))))
    (when (!= (-> this entity-indices v1-3) -1)
      (set! s3-0 (-> this data (-> this entity-indices v1-3)))
      (goto cfg-9)
      )
    (when (>= (-> this entity-more-perm-ct) 512)
      (break!)
      0
      )
    (set! s3-0 (-> this data (-> this entity-more-perm-ct)))
    (set! (-> this entity-indices v1-3) (-> this entity-more-perm-ct))
    )
  (+! (-> this entity-more-perm-ct) 1)
  (mem-clear! (the-as pointer s3-0) 16)
  (set! (-> s3-0 aid) arg0)
  (set! (-> s3-0 ent) (entity-by-aid (the-as uint arg0)))
  (if arg1
      (set! (-> arg1 0) #t)
      )
  (label cfg-9)
  s3-0
  )

;; definition for method 9 of type entity-more-perm
;; WARN: Return type mismatch int vs none.
(defmethod entity-more-perm-method-9 ((this entity-more-perm))
  (/ (&- (the-as pointer this) (the-as uint (the-as pointer (-> *entity-more-perm* data)))) 16)
  (none)
  )

;; definition for method 13 of type entity-more-perm-hash
;; WARN: Return type mismatch int vs symbol.
(defmethod entity-more-perm-hash-method-13 ((this entity-more-perm-hash) (arg0 level))
  (if (not (-> arg0 name))
      (return (the-as symbol #f))
      )
  (if (not (and (nonzero? (-> arg0 entity)) (-> arg0 entity)))
      (return (the-as symbol #f))
      )
  (dotimes (s5-0 (-> arg0 entity length))
    (let ((s4-0 (-> arg0 entity data s5-0)))
      (when (type? (-> s4-0 entity) entity-actor)
        (let ((s4-1 (-> s4-0 entity)))
          (if (type-type? (-> (the-as entity-actor s4-1) etype) process-nettable)
              ((the-as (function process-nettable entity-actor) (-> (the-as entity-actor s4-1) etype method-table 32))
               (the-as process-nettable #f)
               )
              )
          )
        )
      )
    )
  (the-as symbol 0)
  )

;; definition for method 14 of type entity-more-perm-hash
;; WARN: Return type mismatch int vs symbol.
(defmethod entity-more-perm-hash-method-14 ((this entity-more-perm-hash) (arg0 level))
  (if (not (-> arg0 name))
      (return (the-as symbol #f))
      )
  (if (not (and (nonzero? (-> arg0 entity)) (-> arg0 entity)))
      (return (the-as symbol #f))
      )
  (dotimes (s5-0 (-> arg0 entity length))
    (let ((s4-0 (-> arg0 entity data s5-0)))
      (when (type? (-> s4-0 entity) entity-actor)
        (let ((s4-1 (-> s4-0 entity)))
          (if (type-type? (-> (the-as entity-actor s4-1) etype) process-nettable)
              ((the-as (function process-nettable entity-actor none) (-> (the-as entity-actor s4-1) etype method-table 33))
               (the-as process-nettable #f)
               (the-as entity-actor s4-1)
               )
              )
          )
        )
      )
    )
  (the-as symbol 0)
  )


             (set-movie-fog! (new 'static 'vector :y 47.25 :z 62.4375 :w 1.0) 0.0 2000.0 0.0 255.0)
             (set-movie-color!
               (new 'static 'vector :x 0.1 :y 0.575 :z 0.4 :w 1.0)
               (new 'static 'vector :x 0.1505 :y 0.2133 :z 0.2509 :w 1.0)
               )
             (set-rustyh-effect-light! 0.0)

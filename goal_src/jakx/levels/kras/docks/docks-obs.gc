;;-*-Lisp-*-
(in-package goal)

;; name: docks-obs.gc
;; name in dgo: docks-obs
;; dgos: DKKX, DKX, DOCKKRAW, DOCKSW, DRDX, DROMEW, DROMEX, DRX, KRATOURW

;; DECOMP BEGINS

(deftype wind-rotor (process-drawable)
  ()
  (:state-methods
    idle
    )
  )


(defskelgroup skel-wind-rotor wind-rotor wind-rotor-lod0-jg wind-rotor-spin-ja
              ((wind-rotor-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 0 0 40)
              :origin-joint-index 3
              )

(defmethod init-from-entity! ((this wind-rotor) (arg0 entity-actor))
  (logior! (-> this mask) (process-mask actor-pause))
  (stack-size-set! (-> this main-thread) 32)
  (set! (-> this root) (new 'process 'trsqv))
  (process-drawable-from-entity! this arg0)
  (initialize-skeleton this (art-group-get-by-name *level* "skel-wind-rotor" (the-as (pointer level) #f)) 0)
  (go (method-of-object this idle))
  )

(defstate idle (wind-rotor)
  :virtual #t
  :code (behavior ()
    (let* ((f30-0 65536.0)
           (f0-3 (* f30-0 (rand-float-gen)))
           )
      (quaternion-rotate-z! (-> self root rotation) (-> self root rotation) f0-3)
      )
    (until #f
      (quaternion-rotate-z! (-> self root rotation) (-> self root rotation) (* 16384.0 (seconds-per-frame)))
      (suspend)
      )
    #f
    )
  :post ja-post
  )

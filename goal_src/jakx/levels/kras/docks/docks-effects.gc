;;-*-Lisp-*-
(in-package goal)

;; name: docks-effects.gc
;; name in dgo: docks-effects
;; dgos: DKKX, DKX, DOCKKRAW, DOCKSW, DRDX, DROMDOCW, KRATOURW

;; DECOMP BEGINS

(deftype docks-states (structure)
  ((light  light-state   :inline)
   (flame  flames-state  :inline)
   )
  )


(defbehavior update-mood-docks time-of-day-proc ((arg0 mood-context) (arg1 float) (arg2 int))
  (copy-mood-exterior arg0)
  (when (and (= (-> *level* level arg2 status) 'active)
             (< (the-as uint (-> *time-of-day-context* mode)) (the-as uint 9))
             )
    (-> arg0 state)
    (update-mood-light arg0 5 0 -1.0 0.0 arg1 0.0 2.0)
    (let* ((v1-10 (-> *display* part-clock frame-counter))
           (f0-1 (* 0.2 (the float (mod v1-10 300))))
           )
      (set! (-> arg0 times 6 w) (+ 0.85 (* 0.5 (sin (* 182.04445 (* 6.0 f0-1))))))
      )
    (set! (-> arg0 times 7 w) 1.0)
    )
  0
  (none)
  )

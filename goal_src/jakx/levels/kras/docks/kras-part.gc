(define *firework-colors* (new 'static 'array rgba 8
                            (new 'static 'rgba :r #x1e :g #x64 :b #xff)
                            (new 'static 'rgba :r #x14 :g #x28 :b #xff)
                            (new 'static 'rgba :r #xff :g #x1e :b #x14)
                            (new 'static 'rgba :r #xff :g #x1e :b #xff)
                            (new 'static 'rgba :r #xff :g #x14 :b #x46)
                            (new 'static 'rgba :r #x32 :g #xff :b #x14)
                            (new 'static 'rgba :r #x14 :g #x14 :b #xff)
                            (new 'static 'rgba :r #xff :g #x50 :b #x14)
                            )
        )

(define *firework-vec* (new 'static 'vector))

(define *firework-origin?* #f)

(defun birth-func-firework ((arg0 sparticle-system) (arg1 sparticle-cpuinfo) (arg2 sparticle-launchinfo))
  (let* ((v1-3 (abs (+ (-> *display* game-clock frame-counter) (the-as time-frame arg0))))
         (v1-4 (logand v1-3 7))
         )
    (set! (-> arg2 rotate-x) (the float (-> *firework-colors* v1-4 r)))
    (set! (-> arg2 rotate-y) (the float (-> *firework-colors* v1-4 g)))
    (set! (-> arg2 rotate-z) (the float (-> *firework-colors* v1-4 b)))
    )
  (cond
    ((not *firework-origin?*)
     (quaternion-copy! (the-as quaternion *firework-vec*) (-> arg1 rotvel3d))
     (set! *firework-origin?* #t)
     )
    (else
      (quaternion-copy! (-> arg1 rotvel3d) (the-as quaternion *firework-vec*))
      (set! *firework-origin?* #f)
      )
    )
  0
  (none)
  )


;;-*-Lisp-*-
(in-package goal)

;; name: kras-part.gc
;; name in dgo: kras-part
;; dgos: DKKX, DOCKKRAW, KRASW, KRATOURW, KRX

;; DECOMP BEGINS

(defun spt-func-birth-on-die1 ((arg0 sparticle-system) (arg1 sparticle-cpuinfo) (arg2 sparticle-launchinfo))
  (when (zero? (-> arg1 timer))
    (let ((v1-2 (-> *launch-matrix* trans))
          (a0-1 (new 'stack-no-clear 'vector))
          )
      (set! (-> a0-1 x) (-> arg2 launchrot x))
      (set! (-> a0-1 y) (-> arg2 launchrot y))
      (set! (-> a0-1 z) (-> arg2 launchrot z))
      (set! (-> a0-1 w) 1.0)
      (set! (-> v1-2 quad) (-> a0-1 quad))
      )
    (set! (-> *part-tracker-params-default* group) (-> *part-group-id-table* 389))
    (vector-reset! (-> *part-tracker-params-default* local-offset))
    (set! (-> *part-tracker-params-default* duration) (the-as uint 0))
    (set! (-> *part-tracker-params-default* callback) #f)
    (set! (-> *part-tracker-params-default* userdata) (the-as uint #f))
    (set! (-> *part-tracker-params-default* target) #f)
    (set! (-> *part-tracker-params-default* mat-joint) *launch-matrix*)
    (set! (-> *part-tracker-params-default* local-space-param) 0)
    (set! (-> *part-tracker-params-default* local-space-callback) #f)
    (set! (-> *part-tracker-params-default* subsampler-num) 1.0)
    *part-tracker-params-default*
    (if (logtest? (-> *part-group-id-table* 389 flags) (sp-group-flag sp13))
        (process-spawn
          part-tracker-subsampler
          :init part-tracker-subsampler-init
          *part-tracker-params-default*
          :name "part-tracker-subsampler"
          :to *entity-pool*
          :unk 0
          )
        (process-spawn
          part-tracker
          :init part-tracker-init
          *part-tracker-params-default*
          :name "part-tracker"
          :to *entity-pool*
          :unk 0
          )
        )
    (let ((v1-30 (make-sound-instance (-> *sound-info* 607) 0 (the-as handle #f))))
      (cond
        (v1-30
          (let ((a0-12 (-> v1-30 trans))
                (a1-9 (new 'stack-no-clear 'vector))
                )
            (set! (-> a1-9 x) (-> arg2 launchrot x))
            (set! (-> a1-9 y) (-> arg2 launchrot y))
            (set! (-> a1-9 z) (-> arg2 launchrot z))
            (set! (-> a1-9 w) 1.0)
            (set! (-> a0-12 quad) (-> a1-9 quad))
            )
          (logior! (-> v1-30 flags) 96)
          (-> v1-30 id)
          )
        (else
          0
          )
        )
      )
    )
  (none)
  )


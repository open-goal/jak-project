(defun spt-func-rocket ((arg0 sparticle-system) (arg1 sparticle-cpuinfo) (arg2 sparticle-launchinfo))
  (let ((v1-1 (make-sound-instance (-> *sound-info* 610) 0 (the-as handle #f))))
    (cond
      (v1-1
        (let ((a0-2 (-> v1-1 trans))
              (a1-2 (new 'stack-no-clear 'vector))
              )
          (set! (-> a1-2 x) (-> arg2 launchrot x))
          (set! (-> a1-2 y) (-> arg2 launchrot y))
          (set! (-> a1-2 z) (-> arg2 launchrot z))
          (set! (-> a1-2 w) 1.0)
          (set! (-> a0-2 quad) (-> a1-2 quad))
          )
        (logior! (-> v1-1 flags) 96)
        (-> v1-1 id)
        )
      (else
        0
        )
      )
    )
  (none)
  )


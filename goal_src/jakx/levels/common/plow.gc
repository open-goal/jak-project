(defmethod relocate ((this plow) (offset int))
  (if (nonzero? (-> this thruster-left))
      (&+! (-> this thruster-left) offset)
      )
  (if (nonzero? (-> this thruster-right))
      (&+! (-> this thruster-right) offset)
      )
  (if (nonzero? (-> this thruster-left-small))
      (&+! (-> this thruster-left-small) offset)
      )
  (if (nonzero? (-> this thruster-right-small))
      (&+! (-> this thruster-right-small) offset)
      )
  (if (nonzero? (-> this thruster-main))
      (&+! (-> this thruster-main) offset)
      )
  (if (nonzero? (-> this eye-left))
      (&+! (-> this eye-left) offset)
      )
  (if (nonzero? (-> this eye-right))
      (&+! (-> this eye-right) offset)
      )
  (if (nonzero? (-> this eye-left-small))
      (&+! (-> this eye-left-small) offset)
      )
  (if (nonzero? (-> this eye-right-small))
      (&+! (-> this eye-right-small) offset)
      )
  (if (nonzero? (-> this smoke))
      (&+! (-> this smoke) offset)
      )
  (if (nonzero? (-> this smoke2))
      (&+! (-> this smoke2) offset)
      )
  (call-parent-method this offset)
  )

(defmethod deactivate ((this plow))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (sparticle-launch-control-method-19 (-> this thruster-left))
  (sparticle-launch-control-method-19 (-> this thruster-right))
  (sparticle-launch-control-method-19 (-> this thruster-left-small))
  (sparticle-launch-control-method-19 (-> this thruster-right-small))
  (sparticle-launch-control-method-19 (-> this thruster-main))
  (sparticle-launch-control-method-19 (-> this eye-left))
  (sparticle-launch-control-method-19 (-> this eye-right))
  (sparticle-launch-control-method-19 (-> this eye-left-small))
  (sparticle-launch-control-method-19 (-> this eye-right-small))
  (sparticle-launch-control-method-19 (-> this smoke))
  (sparticle-launch-control-method-19 (-> this smoke2))
  (call-parent-method this)
  (none)
  )

(defmethod init-collision! ((this plow))
  (let ((s5-0 (new 'process 'collide-shape-moving this (collide-list-enum usually-hit-by-player))))
    (set! (-> s5-0 dynam) (copy *standard-dynamics* 'process))
    (set! (-> s5-0 reaction) cshape-reaction-default)
    (set! (-> s5-0 no-reaction)
          (the-as (function collide-shape-moving collide-query vector vector object) nothing)
          )
    (set! (-> s5-0 penetrated-by) (penetrate))
    (let ((s4-0 (new 'process 'collide-shape-prim-group s5-0 (the-as uint 2) 0)))
      (set! (-> s5-0 total-prims) (the-as uint 3))
      (set! (-> s4-0 prim-core collide-as) (collide-spec enemy obstacle camera-blocker))
      (set! (-> s4-0 prim-core collide-with)
            (collide-spec backgnd jak crate civilian enemy obstacle vehicle-sphere hit-by-others-list player-list pusher)
            )
      (set! (-> s4-0 prim-core action) (collide-action solid deadly no-standon))
      (set-vector! (-> s4-0 local-sphere) 0.0 22528.0 0.0 72089.6)
      (set! (-> s5-0 root-prim) s4-0)
      )
    (let ((v1-12 (new 'process 'collide-shape-prim-sphere s5-0 (the-as uint 1))))
      (set! (-> v1-12 prim-core collide-as) (collide-spec camera-blocker))
      (set! (-> v1-12 prim-core collide-with) (collide-spec player-list))
      (set! (-> v1-12 prim-core action) (collide-action solid))
      (set-vector! (-> v1-12 local-sphere) 0.0 32768.0 0.0 61440.0)
      )
    (let ((v1-14 (new 'process 'collide-shape-prim-sphere s5-0 (the-as uint 0))))
      (set! (-> v1-14 prim-core collide-as) (collide-spec enemy))
      (set! (-> v1-14 prim-core collide-with)
            (collide-spec backgnd jak crate civilian enemy obstacle vehicle-sphere hit-by-others-list player-list pusher)
            )
      (set! (-> v1-14 prim-core action) (collide-action solid))
      (set-vector! (-> v1-14 local-sphere) 0.0 12288.0 0.0 61440.0)
      )
    (set! (-> s5-0 nav-radius) 8192.0)
    (let ((v1-16 (-> s5-0 root-prim)))
      (set! (-> s5-0 backup-collide-as) (-> v1-16 prim-core collide-as))
      (set! (-> s5-0 backup-collide-with) (-> v1-16 prim-core collide-with))
      )
    (set! (-> s5-0 max-iteration-count) (the-as uint 3))
    (set! (-> s5-0 event-self) 'touched)
    (set! (-> this root) s5-0)
    )
  0
  (none)
  )

(defmethod init-skeleton! ((this plow))
  (vector-float*! (-> this root scale) (-> this root scale) 4.0)
  (initialize-skeleton this (art-group-get-by-name *level* "skel-plow" (the-as (pointer level) #f)) 0)
  (set! (-> this thruster-left) (create-launch-control (-> *part-group-id-table* 315) this))
  (set! (-> this thruster-right) (create-launch-control (-> *part-group-id-table* 315) this))
  (set! (-> this thruster-left-small) (create-launch-control (-> *part-group-id-table* 316) this))
  (set! (-> this thruster-right-small) (create-launch-control (-> *part-group-id-table* 316) this))
  (set! (-> this thruster-main) (create-launch-control (-> *part-group-id-table* 317) this))
  (set! (-> this eye-left) (create-launch-control (-> *part-group-id-table* 318) this))
  (set! (-> this eye-right) (create-launch-control (-> *part-group-id-table* 318) this))
  (set! (-> this eye-left-small) (create-launch-control (-> *part-group-id-table* 319) this))
  (set! (-> this eye-right-small) (create-launch-control (-> *part-group-id-table* 319) this))
  (set! (-> this smoke) (create-launch-control (-> *part-group-id-table* 321) this))
  (set! (-> this smoke2) (create-launch-control (-> *part-group-id-table* 322) this))
  0
  (none)
  )

(defmethod init-paths! ((this plow))
  (set! (-> this paths) (new 'process 'boxed-array curve-control 2))
  (set! (-> this paths 0) (new 'process 'curve-control this 'path (-> this entity) #f -1000000000.0))
  (set! (-> this paths 1) (new 'process 'curve-control this 'intro (-> this entity) #f -1000000000.0))
  (if (zero? (-> this paths 1 curve num-cverts))
      (set! (-> this paths 1) (-> this paths 0))
      )
  (when (zero? (-> this paths 0 curve knots))
    (format 0 "----> WARNING! CHANGING CURVE TO PATH ~A~%" this)
    (set! (-> this paths 0 type) path-control)
    )
  (when (zero? (-> this paths 1 curve knots))
    (format 0 "----> WARNING! CHANGING CURVE TO PATH ~A~%" this)
    (set! (-> this paths 1 type) path-control)
    )
  0
  (none)
  )

(defmethod init-info! ((this plow))
  (set! (-> this info) *plow-enemy-info*)
  (set! (-> this prox) (new 'process 'proximity-ownership-params))
  (init! (-> this prox))
  (set! (-> this prox ownable-radius) 409600.0)
  (set! (-> this prox consider-ai-players) #t)
  (set! (-> this tracking-player) (the-as handle #f))
  (set! (-> this do-flip-anim) #f)
  (set! (-> this been-hit) #f)
  (set! (-> this engine-sound-id) (new 'static 'sound-id))
  0
  (none)
  )

(defmethod do-transition ((this plow) (arg0 mem-buffer) (arg1 int) (arg2 symbol))
  (case arg2
    (('go-intro-path)
     (go (method-of-object this intro-path))
     )
    (('go-following-path)
     (go (method-of-object this following-path))
     )
    (('go-reverse)
     (decode-net-anim-state (-> this net-anim) arg0)
     (update!
       (-> this net-anim)
       this
       (- (- (if *net-mgr*
                 (-> *net-mgr* game-state time)
                 0
                 )
             (if *net-world*
                 (-> *net-world* net-state game-start-time)
                 0
                 )
             )
          (if *net-world*
              (-> *net-world* net-state total-pause-time)
              0
              )
          )
       #t
       )
     (go (method-of-object this reverse))
     )
    (else
      (format 0 "trans -> parent ~A~%" arg2)
      ((method-of-type net-enemy do-transition) this arg0 arg1 arg2)
      )
    )
  0
  (none)
  )

(defmethod on-attack ((this plow) (arg0 attack-info))
  (let ((v1-1 (make-sound-instance snd-bullet-impacts (new 'static 'sound-id) (the-as handle #f))))
    (if v1-1
        (-> v1-1 id)
        0
        )
    )
  (when (!= (-> arg0 id) (-> this last-attack-id))
    (set! (-> *launch-matrix* trans quad) (-> arg0 trans quad))
    (set! (-> *part-tracker-params-default* group) (-> *part-group-id-table* 313))
    (vector-reset! (-> *part-tracker-params-default* local-offset))
    (set! (-> *part-tracker-params-default* duration) (the-as uint 300))
    (set! (-> *part-tracker-params-default* callback) #f)
    (set! (-> *part-tracker-params-default* userdata) (the-as uint #f))
    (set! (-> *part-tracker-params-default* target) this)
    (set! (-> *part-tracker-params-default* mat-joint) (the-as object 0))
    (set! (-> *part-tracker-params-default* local-space-param) 0)
    (set! (-> *part-tracker-params-default* local-space-callback) #f)
    (set! (-> *part-tracker-params-default* subsampler-num) 1.0)
    *part-tracker-params-default*
    (if (logtest? (-> *part-group-id-table* 313 flags) (sp-group-flag sp13))
        (process-spawn
          part-tracker-subsampler
          :init part-tracker-subsampler-init
          *part-tracker-params-default*
          :name "part-tracker-subsampler"
          :to *entity-pool*
          :unk 0
          )
        (process-spawn
          part-tracker
          :init part-tracker-init
          *part-tracker-params-default*
          :name "part-tracker"
          :to *entity-pool*
          :unk 0
          )
        )
    )
  ((method-of-type net-enemy on-attack) this arg0)
  (none)
  )

(defmethod on-impact ((this plow) (arg0 rigid-body-impact))
  ((method-of-type net-enemy on-impact) this arg0)
  (none)
  )

(defmethod on-fatal-impact ((this plow) (arg0 rigid-body-impact) (arg1 int))
  0
  (none)
  )

;; WARN: Return type mismatch object vs none.
(defmethod on-fatal-attack ((this plow) (arg0 int) (arg1 int))
  (format 0 "handle fatal attack~%")
  (let ((a1-3 (new 'stack 'debris-tuning (the-as uint 0))))
    (set! (-> a1-3 scale-rand-lo) 0.8)
    (set! (-> a1-3 scale-rand-hi) 1.0)
    (set-vector! (-> a1-3 fountain-rand-transv-lo) -40960.0 40960.0 -40960.0 1.0)
    (set-vector! (-> a1-3 fountain-rand-transv-hi) 40960.0 122880.0 40960.0 1.0)
    (set! (-> a1-3 fountain-rand-transv-hi w) 16384.0)

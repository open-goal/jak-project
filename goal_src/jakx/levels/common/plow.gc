            (set! (-> s2-0 y) 0.0)
            (vector-normalize! (the-as vector (&-> s2-0 x)) 1.0)
            (quaternion-look-at! arg1 (the-as vector (&-> s2-0 x)) *up-vector*)
            )
          )
        )
      )
    (when (and (not (-> this do-flip-anim)) (and s3-0 (< *closest-player-dist-sq* 12079596000.0)))
      (let ((v1-19 (get-vehicle s3-0)))
        (when v1-19
          (when (or (logtest? (vehicle-flag ignore-damage) (-> v1-19 v-flags)) (handle->process (-> v1-19 wpn-shield)))
            (set! (-> this do-flip-anim) #t)
            (launch-nearby-players)
            )
          )
        )
      )
    )
  (call-parent-method this arg0 arg1)
  (none)
  )

(define *flip-speed* 0.5)

(define *flip-blend* 0.000000000000000000000000000000000000000000126)

;; WARN: Return type mismatch int vs object.
(defbehavior plow-trans plow ()
  (when (nonzero? (-> self engine-sound-id))
    (let ((v1-3 (make-sound-instance snd-plow-engine (-> self engine-sound-id) (the-as handle #f))))
      (if v1-3
          (-> v1-3 id)
          0
          )
      )
    )
  (play-anim-along-path #f #f #t)
  (do-bob self)
  (check-collision-with-other-plows self)
  (when (logtest? (-> self draw status) (draw-control-status on-screen))
    (spawn-from-cspace (-> self thruster-left) (joint-node plow-lod0-jg exhaust_l))
    (spawn-from-cspace (-> self thruster-right) (joint-node plow-lod0-jg exhaust_r))
    (spawn-from-cspace (-> self eye-left) (joint-node plow-lod0-jg l_eye_big))
    (spawn-from-cspace (-> self eye-right) (joint-node plow-lod0-jg r_eye_big))
    (if (>= (* 0.7 (-> self info max-health)) (-> self health))
        (spawn-from-cspace (-> self smoke) (joint-node plow-lod0-jg main))
        )
    (if (>= (* 0.3 (-> self info max-health)) (-> self health))
        (spawn-from-cspace (-> self smoke2) (joint-node plow-lod0-jg main))
        )
    )
  (when (-> self been-hit)
    (set! (-> self been-hit) #f)
    (launch-nearby-players)
    )
  0
  )

(defstate following-path (plow)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('impact-impulse)
       (let ((v0-0 (the-as object #t)))
         (set! (-> self been-hit) (the-as symbol v0-0))
         v0-0
         )
       )
      (else
        (net-enemy-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (when (type? (-> self root) collide-shape)
      (let ((v1-2 (-> self root root-prim)))
        (set! (-> v1-2 prim-core collide-as) (-> self root backup-collide-as))
        (set! (-> v1-2 prim-core collide-with) (-> self root backup-collide-with))
        )
      )
    (logclear! (-> self draw status) (draw-control-status no-draw))
    (if (type? (-> self root) collide-shape)
        (transform-post)
        )
    (set! (-> self flags) (net-enemy-flag keep-ground-offset attackable check-overlaps))
    (set-anim!
      (-> self net-anim)
      (- (- (if *net-mgr*
                (-> *net-mgr* game-state time)
                0
                )
            (if *net-world*
                (-> *net-world* net-state game-start-time)
                0
                )
            )
         (if *net-world*
             (-> *net-world* net-state total-pause-time)
             0
             )
         )
      (-> self info anim-info 0 anim-idx)
      0.0
      (-> self net-anim active anim-rate)
      #t
      (-> self info anim-info 0 forward-vel)
      )
    )
  :trans (behavior ()
    (plow-trans)
    )
  :code (behavior ()
    (ja-channel-push! 1 0)
    (ja :group! (-> self draw art-group data (-> self net-anim active anim-idx)))
    (until #f
      (until (-> self do-flip-anim)
        (let ((a0-5 (-> self skel root-channel 0)))
          (set! (-> a0-5 param 0) (-> self net-anim result cur-frame))
          (joint-control-channel-group-eval! a0-5 (the-as art-joint-anim #f) num-func-loop-set!)
          )
        (suspend)
        )
      (let ((v1-9 (make-sound-instance snd-plow-lift-car (new 'static 'sound-id) (the-as handle #f))))
        (if v1-9
            (-> v1-9 id)
            0
            )
        )
      (ja-channel-push! 1 (the-as time-frame *flip-blend*))
      (ja :group! plow-flip-ja)
      (ja-no-eval :group! (ja-group) :num! (seek! max *flip-speed*) :frame-num 0.0)
      (until (ja-done? 0)
        (suspend)
        (ja :num! (seek! max *flip-speed*))
        )
      (set! (-> self do-flip-anim) #f)
      (set! (-> self tracking-player) (the-as handle #f))
      (ja-channel-push! 1 (seconds 0.2))
      (ja :group! (-> self draw art-group data (-> self net-anim active anim-idx)))
      )
    #f
    )
  :post (behavior ()
    (common-post self)
    )
  )

(defstate reverse (plow)
  :virtual #t
  :event net-enemy-default-handler
  :enter (behavior ()
    (when (type? (-> self root) collide-shape)
      (let ((v1-2 (-> self root root-prim)))
        (set! (-> v1-2 prim-core collide-as) (-> self root backup-collide-as))
        (set! (-> v1-2 prim-core collide-with) (-> self root backup-collide-with))
        )
      )
    (logclear! (-> self draw status) (draw-control-status no-draw))
    (if (type? (-> self root) collide-shape)
        (transform-post)
        )
    (set! (-> self flags) (net-enemy-flag snap-to-ground attackable impactable check-overlaps))
    (set-anim!
      (-> self net-anim)
      (- (- (if *net-mgr*
                (-> *net-mgr* game-state time)
                0
                )
            (if *net-world*
                (-> *net-world* net-state game-start-time)
                0
                )
            )
         (if *net-world*
             (-> *net-world* net-state total-pause-time)
             0
             )
         )
      (-> self info anim-info 0 anim-idx)
      0.0
      (-> self net-anim active anim-rate)
      #f
      (the-as vector #f)
      )
    (set! (-> self net-anim result anim-wrapped) #f)
    (ja-channel-push! 1 0)
    (ja :group! (-> self draw art-group data (-> self net-anim active anim-idx)))
    )
  :trans (behavior ()
    (play-anim-along-path #f #f #f)
    (when (-> self net-anim result anim-wrapped)
      (set! (-> self net-anim active path-info reversed)
            (- 1 (the-as int (-> self net-anim active path-info reversed)))
            )
      (logior! (-> self snap-flags) (net-enemy-snap-flag snap-quat))
      (go-virtual following-path)
      )
    )
  :code sleep-code
  :post (behavior ()
    (common-post self)
    )
  )

;; WARN: Return type mismatch object vs none.
(defmethod handle-net-msg ((this plow) (arg0 symbol) (arg1 mem-buffer) (arg2 int))
  (case arg0
    (('do-flip-anim-msg)
     (set! (-> this do-flip-anim) #t)
     )
    (else
      (call-parent-method this arg0 arg1 arg2)
      )
    )
  (none)
  )

(defstate waiting-respawn (plow)
  :virtual #t
  :enter (behavior ()
    (when (nonzero? (-> self engine-sound-id))
      (sound-stop (-> self engine-sound-id) #t)
      (set! (-> self engine-sound-id) (new 'static 'sound-id))
      0
      )
    (call-parent-state-handler enter)
    )
  )

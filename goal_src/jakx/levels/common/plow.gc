(define *plow-enemy-info*
  (new 'static 'net-enemy-info
    :inverse-mass 0.2
    :ragdoll-info #f
    :max-health 40.0
    :damage-scale 1.0
    :respawn-delay #x258
    :smooth-root-trans 0.15
    :smooth-root-quat 0.08
    :fatal-impact-impulse 40960000000.0
    :min-fatal-impact-enemy-vel 40960000000.0
    :time-before-evaporate #x384
    :time-before-respawn #xbb8
    :anim-info (new 'static 'boxed-array :type net-enemy-anim-info (new 'static 'net-enemy-anim-info
                                                          :name 'idle
                                                          :anim-idx 3
                                                          :forward-vel (new 'static 'vector :z 90112.0 :w 1.0)
                                                          )
                                                        )
    :kill-score 1
    :allow-vehicle-penetrate #t
    :min-ground-offset 8192.0
    :ground-probe-lod-dist 1228800.0
    :show-kill-score 1
    )
  )

(set! (-> *plow-enemy-info* ragdoll-info) #f)

(deftype plow (net-enemy)
  ((root                  collide-shape-moving :override)
   (tracking-player       handle)
   (do-flip-anim          symbol)
   (been-hit              symbol)
   (thruster-left         sparticle-launch-control)
   (thruster-right        sparticle-launch-control)
   (thruster-left-small   sparticle-launch-control)
   (thruster-right-small  sparticle-launch-control)
   (thruster-main         sparticle-launch-control)
   (eye-left              sparticle-launch-control)
   (eye-right             sparticle-launch-control)
   (eye-left-small        sparticle-launch-control)
   (eye-right-small       sparticle-launch-control)
   (smoke                 sparticle-launch-control)
   (smoke2                sparticle-launch-control)
   (engine-sound-id       sound-id)
   )
  (:state-methods
    intro-path
    following-path
    reverse
    )
  )


;; WARN: Return type mismatch int vs object.
(defbehavior plow-init-remote plow ((arg0 mem-buffer))
  (register self -1 #xffff)
  (init-remote self arg0)
  (post-init-remote self)
  0
  )

(defmethod spawn-remote ((this plow) (arg0 mem-buffer))
  (ppointer->process (process-spawn plow :init plow-init-remote arg0 :name "plow"))
  )

(defmethod write-msg-map ((this plow) (arg0 net-process-class-info))
  (set! (-> arg0 msg-map (-> arg0 msg-count)) 'do-flip-anim-msg)
  (+! (-> arg0 msg-count) 1)
  0
  (none)
  )

(define *msg-map-plow* (new 'static 'boxed-array :type symbol :length 0 :allocated-length 64))

(define *net-process-class-info-plow* (new 'static 'net-process-class-info))

(set! (-> *net-process-class-info-plow* msg-map) *msg-map-plow*)

(write-msg-map-rec plow *net-process-class-info-plow*)

(set! (-> *net-process-class-info-plow* owner-type) plow)

(net-process-class-register *net-process-class-info-plow*)

(defmethod get-class-info ((this plow))
  *net-process-class-info-plow*
  )


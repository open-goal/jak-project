(define *hud-deathmatch-score-drop-view-20-proc* (the-as hud-deathmatch-score-drop-view-20 #f))

(deftype hud-deathmatch-score-drop-view-20 (in-game-hud)
  ()
  )


;; WARN: Return type mismatch in-game-hud vs hud-deathmatch-score-drop-view-20.
(defmethod relocate ((this hud-deathmatch-score-drop-view-20) (offset int))
  (set! *hud-deathmatch-score-drop-view-20-proc* this)
  (if (nonzero? *hud-deathmatch-score-drop-view-20-proc*)
      (set! *hud-deathmatch-score-drop-view-20-proc* (&+ *hud-deathmatch-score-drop-view-20-proc* offset))
      )
  (the-as hud-deathmatch-score-drop-view-20 ((method-of-type in-game-hud relocate) this offset))
  )

(defmethod init-callback ((this hud-deathmatch-score-drop-view-20))
  (set! (-> this items) *hud-deathmatch-score-drop-view-20*)
  (set! (-> this manager) (new 'static 'basic-manager))
  (set! *hud-deathmatch-score-drop-view-20-proc* this)
  ((method-of-type in-game-hud init-callback) this)
  (none)
  )

(defmethod deactivate ((this hud-deathmatch-score-drop-view-20))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (set! *hud-deathmatch-score-drop-view-20-proc* #f)
  ((method-of-type in-game-hud deactivate) this)
  (none)
  )

(defmethod draw ((this hud-deathmatch-score-drop-view-20))
  (when *debug-hud*
    (set! (-> this real-items) *hud-deathmatch-score-drop-view-20*)
    (init-callback this)
    )
  ((method-of-type in-game-hud draw) this)
  (none)
  )

;; WARN: Return type mismatch process vs hud-deathmatch-score-drop-view-20.
(defun spawn-hud-deathmatch-score-drop-view-20 ()
  (the-as
    hud-deathmatch-score-drop-view-20
    (cond
      (*hud-deathmatch-score-drop-view-20-proc*
        *hud-deathmatch-score-drop-view-20-proc*
        )
      (*net-game-mgr*
        (let ((v0-0 (ppointer->process (process-spawn
                                         hud-deathmatch-score-drop-view-20
                                         :init hud-init-by-other
                                         :name "hud-deathmatch-score-drop-view-20"
                                         :to *net-game-mgr*
                                         )
                                       )
                    )
              )
          (when v0-0
            (set! (-> (the-as hud-deathmatch-score-drop-view-20 v0-0) inited-strings-count) 0)
            0
            )
          v0-0
          )
        )
      (else
        (the-as process #f)
        )
      )
    )
  )


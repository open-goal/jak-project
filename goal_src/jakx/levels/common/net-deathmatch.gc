(define *hud-deathmatch-score-drop-view-11-proc* (the-as hud-deathmatch-score-drop-view-11 #f))

(deftype hud-deathmatch-score-drop-view-11 (in-game-hud)
  ()
  )


;; WARN: Return type mismatch in-game-hud vs hud-deathmatch-score-drop-view-11.
(defmethod relocate ((this hud-deathmatch-score-drop-view-11) (offset int))
  (set! *hud-deathmatch-score-drop-view-11-proc* this)
  (if (nonzero? *hud-deathmatch-score-drop-view-11-proc*)
      (set! *hud-deathmatch-score-drop-view-11-proc* (&+ *hud-deathmatch-score-drop-view-11-proc* offset))
      )
  (the-as hud-deathmatch-score-drop-view-11 ((method-of-type in-game-hud relocate) this offset))
  )

(defmethod init-callback ((this hud-deathmatch-score-drop-view-11))
  (set! (-> this items) *hud-deathmatch-score-drop-view-11*)
  (set! (-> this manager) (new 'static 'basic-manager))
  (set! *hud-deathmatch-score-drop-view-11-proc* this)
  ((method-of-type in-game-hud init-callback) this)
  (none)
  )

(defmethod deactivate ((this hud-deathmatch-score-drop-view-11))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (set! *hud-deathmatch-score-drop-view-11-proc* #f)
  ((method-of-type in-game-hud deactivate) this)
  (none)
  )

(defmethod draw ((this hud-deathmatch-score-drop-view-11))
  (when *debug-hud*
    (set! (-> this real-items) *hud-deathmatch-score-drop-view-11*)
    (init-callback this)
    )
  ((method-of-type in-game-hud draw) this)
  (none)
  )

;; WARN: Return type mismatch process vs hud-deathmatch-score-drop-view-11.
(defun spawn-hud-deathmatch-score-drop-view-11 ()
  (the-as
    hud-deathmatch-score-drop-view-11
    (cond
      (*hud-deathmatch-score-drop-view-11-proc*
        *hud-deathmatch-score-drop-view-11-proc*
        )
      (*net-game-mgr*
        (let ((v0-0 (ppointer->process (process-spawn
                                         hud-deathmatch-score-drop-view-11
                                         :init hud-init-by-other
                                         :name "hud-deathmatch-score-drop-view-11"
                                         :to *net-game-mgr*
                                         )
                                       )
                    )
              )
          (when v0-0
            (set! (-> (the-as hud-deathmatch-score-drop-view-11 v0-0) inited-strings-count) 0)
            0
            )
          v0-0
          )
        )
      (else
        (the-as process #f)
        )
      )
    )
  )

(defun spawn-unused-hud-deathmatch-score-drop-view-1 ()
  (cond
    ((not *hud-deathmatch-score-drop-view-10-proc*)
     (spawn-hud-deathmatch-score-drop-view-10)
     )
    ((not *hud-deathmatch-score-drop-view-11-proc*)
     (spawn-hud-deathmatch-score-drop-view-11)
     )
    (else
      (the-as in-game-hud #f)
      )
    )
  )


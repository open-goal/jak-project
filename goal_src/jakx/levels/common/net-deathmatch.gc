(define *hud-deathmatch-score-drop-view-10-proc* (the-as hud-deathmatch-score-drop-view-10 #f))

(deftype hud-deathmatch-score-drop-view-10 (in-game-hud)
  ()
  )


;; WARN: Return type mismatch in-game-hud vs hud-deathmatch-score-drop-view-10.
(defmethod relocate ((this hud-deathmatch-score-drop-view-10) (offset int))
  (set! *hud-deathmatch-score-drop-view-10-proc* this)
  (if (nonzero? *hud-deathmatch-score-drop-view-10-proc*)
      (set! *hud-deathmatch-score-drop-view-10-proc* (&+ *hud-deathmatch-score-drop-view-10-proc* offset))
      )
  (the-as hud-deathmatch-score-drop-view-10 ((method-of-type in-game-hud relocate) this offset))
  )

(defmethod init-callback ((this hud-deathmatch-score-drop-view-10))
  (set! (-> this items) *hud-deathmatch-score-drop-view-10*)
  (set! (-> this manager) (new 'static 'basic-manager))
  (set! *hud-deathmatch-score-drop-view-10-proc* this)
  ((method-of-type in-game-hud init-callback) this)
  (none)
  )

(defmethod deactivate ((this hud-deathmatch-score-drop-view-10))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (set! *hud-deathmatch-score-drop-view-10-proc* #f)
  ((method-of-type in-game-hud deactivate) this)
  (none)
  )

(defmethod draw ((this hud-deathmatch-score-drop-view-10))
  (when *debug-hud*
    (set! (-> this real-items) *hud-deathmatch-score-drop-view-10*)
    (init-callback this)
    )
  ((method-of-type in-game-hud draw) this)
  (none)
  )


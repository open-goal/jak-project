(define *hud-deathmatch-single-proc* (the-as hud-deathmatch-single #f))

(deftype hud-deathmatch-single (in-game-hud)
  ()
  )


;; WARN: Return type mismatch in-game-hud vs hud-deathmatch-single.
(defmethod relocate ((this hud-deathmatch-single) (offset int))
  (set! *hud-deathmatch-single-proc* this)
  (if (nonzero? *hud-deathmatch-single-proc*)
      (set! *hud-deathmatch-single-proc* (&+ *hud-deathmatch-single-proc* offset))
      )
  (the-as hud-deathmatch-single ((method-of-type in-game-hud relocate) this offset))
  )

(defmethod init-callback ((this hud-deathmatch-single))
  (set! (-> this items) *hud-deathmatch-single*)
  (set! (-> this manager) (new 'static 'basic-manager))
  (set! *hud-deathmatch-single-proc* this)
  ((method-of-type in-game-hud init-callback) this)
  (none)
  )

(defmethod deactivate ((this hud-deathmatch-single))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (set! *hud-deathmatch-single-proc* #f)
  ((method-of-type in-game-hud deactivate) this)
  (none)
  )

(defmethod draw ((this hud-deathmatch-single))
  (when *debug-hud*
    (set! (-> this real-items) *hud-deathmatch-single*)
    (init-callback this)
    )
  ((method-of-type in-game-hud draw) this)
  (none)
  )

;; WARN: Return type mismatch process vs hud-deathmatch-single.
(defun spawn-hud-deathmatch-single ()
  (the-as
    hud-deathmatch-single
    (cond
      (*hud-deathmatch-single-proc*
        *hud-deathmatch-single-proc*
        )
      (*net-game-mgr*
        (let ((v0-0
                (ppointer->process
                  (process-spawn hud-deathmatch-single :init hud-init-by-other :name "hud-deathmatch-single" :to *net-game-mgr*)
                  )
                )
              )
          (when v0-0
            (set! (-> (the-as hud-deathmatch-single v0-0) inited-strings-count) 0)
            0
            )
          v0-0
          )
        )
      (else
        (the-as process #f)
        )
      )
    )
  )


;;-*-Lisp-*-
(in-package goal)

;; name: net-deathmatch.gc
;; name in dgo: net-deathmatch
;; dgos: COMMON, GAME

;; DECOMP BEGINS

(deftype spawn-point (process)
  ()
  )


(defmethod set-intro-camera ((this net-game-mgr-deathmatch))
  (with-pp
    (cam-reconnect *setting-control* (view-get-active-index) pp 'interp-time 'abs 0 0.0)
    (cam-reconnect *setting-control* (view-get-active-index) pp 'mode-name 'cam-battle-intro 0 0.0)
    (none)
    )
  )

(defmethod net-game-mgr-method-65 ((this net-game-mgr-deathmatch) (arg0 int))
  (let ((v1-0 arg0))
    (cond
      ((zero? v1-0)
       (cond
         ((logtest? (-> *net-world* net-state options advanced-options flags)
                    (game-task-advanced-options-flag score-limit)
                    )
          (format
            (clear *temp-string*)
            "~s:  ~d"
            (lookup-text! *common-text* (text-id text-id-2533) #f)
            (-> *net-world* net-state options advanced-options param2)
            )
          *temp-string*
          )
         (else
           (format (clear *temp-string*) "")
           *temp-string*
           )
         )
       )
      ((= v1-0 2)
       (cond
         ((logtest? (-> *net-world* net-state flags) 4)
          (format
            (clear *temp-string*)
            "~s:  ~s"
            (lookup-text! *common-text* (text-id text-id-3778) #f)
            (if (logtest? (-> *net-world* net-state options advanced-options flags)
                          (game-task-advanced-options-flag friendly-fire)
                          )
                (lookup-text! *common-text* (text-id text-id-37) #f)
                (lookup-text! *common-text* (text-id text-id-38) #f)
                )
            )
          *temp-string*
          )
         (else
           (format (clear *temp-string*) "")
           *temp-string*
           )
         )
       )
      ((= v1-0 1)
       (cond
         ((and (logtest? (-> *net-world* net-state options advanced-options flags)
                         (game-task-advanced-options-flag time-limit)
                         )
               (logtest? (-> *net-world* net-state flags) 4)
               )
          (let ((s4-2 (-> *net-world* net-state options advanced-options param1)))
            (format
              (clear *temp-string*)
              "~s:  ~d ~s"
              (lookup-text! *common-text* (text-id text-id-2491) #f)
              s4-2
              (if (= s4-2 1)
                  (lookup-text! *common-text* (text-id text-id-4915) #f)
                  (lookup-text! *common-text* (text-id text-id-3889) #f)
                  )
              )
            )
          *temp-string*
          )
         (else
           (format (clear *temp-string*) "")
           *temp-string*
           )
         )
       )
      ((= v1-0 3)
       (cond
         ((and (logtest? (-> *net-world* net-state options advanced-options flags)
                         (game-task-advanced-options-flag time-limit)
                         )
               (not (logtest? (-> *net-world* net-state flags) 4))
               )
          (let ((s4-3 (-> *net-world* net-state options advanced-options param1)))
            (format
              (clear *temp-string*)
              "~s:  ~d ~s"
              (lookup-text! *common-text* (text-id text-id-2491) #f)
              s4-3
              (if (= s4-3 1)
                  (lookup-text! *common-text* (text-id text-id-4915) #f)
                  (lookup-text! *common-text* (text-id text-id-3889) #f)
                  )
              )
            )
          *temp-string*
          )
         (else
           (format (clear *temp-string*) "")
           *temp-string*
           )
         )
       )
      (else
        (format (clear *temp-string*) "")
        *temp-string*
        )
      )
    )
  )

(defstate startup (net-game-mgr-deathmatch)
  :virtual #t
  :code (behavior ()
    (when (= (if *net-mgr*
                 (-> *net-mgr* game-state local-machine-idx)
                 0
                 )
             (-> *net-mgr* game-state session-master-idx)
             )
      (wait-for-all-net-players)
      (let ((gp-0 (alloc-msg self 'set-intro-end-time)))
        (write-int32 gp-0 (+ (- (- (if *net-mgr*
                                       (-> *net-mgr* game-state time)
                                       0
                                       )
                                   (if *net-world*
                                       (-> *net-world* net-state game-start-time)
                                       0
                                       )
                                   )
                                (if *net-world*
                                    (-> *net-world* net-state total-pause-time)
                                    0
                                    )
                                )
                             (the int (get-intro-duration self))
                             )
                     )
        (send-msg self gp-0 -1 80)
        (free-msg self gp-0)
        )
      )
    (until (!= (-> self intro-end-time) -1)
      (suspend)
      )
    (finish-startup self)
    (until #f
      (let ((a0-17 (-> *net-players* (* (if *net-mgr*
                                            (-> *net-mgr* game-state local-machine-idx)
                                            0
                                            )
                                        2
                                        )
                       )
                   )
            )
        (when a0-17
          (when (get-vehicle a0-17)
            #t
            (goto cfg-24)
            )
          )
        )
      (suspend)
      )
    #f
    (label cfg-24)
    (suspend-for (seconds 0.067)
      )
    (go-virtual waiting-game-start)
    )
  )

(defstate waiting-game-start (net-game-mgr-deathmatch)
  :virtual #t
  :event net-game-mgr-default-handler
  :enter (behavior ()
    (cond
      ((= (-> *viewport-array* mode) 1)
       (spawn-hud-top-split-bar)
       )
      ((= (-> *viewport-array* mode) 2)
       (spawn-hud-side-split-bar)
       )
      )
    (dotimes (gp-0 *view-count*)
      (view-push-context gp-0)
      (cam-reconnect *setting-control* (view-get-active-index) self 'interp-time 'abs 0 0.0)
      (set-intro-camera self)
      (view-pop-context)
      )
    )
  :exit (behavior ()
    '()
    )
  :trans (behavior ()
    (when (= (-> *net-mgr* game-type) 4)
      (when (and (not (paused?))
                 (not (and (nonzero? (+ (-> self intro-end-time) -600 1))
                           (>= (- (- (- (if *net-mgr*
                                            (-> *net-mgr* game-state time)
                                            0
                                            )
                                        (if *net-world*
                                            (-> *net-world* net-state game-start-time)
                                            0
                                            )
                                        )
                                     (if *net-world*
                                         (-> *net-world* net-state total-pause-time)
                                         0
                                         )
                                     )
                                  (+ (-> self intro-end-time) -600)
                                  )
                               0
                               )
                           )
                      )
                 (cpad-pressed? (view-get-active-index) x)
                 )
        (set-blackout-frames 0)
        (dotimes (gp-2 *view-count*)
          (view-push-context gp-2)
          (set! *teleport* #t)
          (cam-connect-pers
            *setting-control*
            (view-get-active-index)
            'interp-time
            (seconds 0.1)
            'interp-time
            'abs
            0.0
            0
            )
          (cam-disconnect *setting-control* (view-get-active-index) self 'interp-time)
          (cam-disconnect *setting-control* (view-get-active-index) self 'mode-name)
          (view-pop-context)
          )
        (set! (-> self intro-end-time) (+ (- (- 75 (if *net-world*
                                                       (-> *net-world* net-state total-pause-time)
                                                       0
                                                       )
                                                )
                                             (if *net-world*
                                                 (-> *net-world* net-state game-start-time)
                                                 0
                                                 )
                                             )
                                          (if *net-mgr*
                                              (-> *net-mgr* game-state time)
                                              0
                                              )
                                          )
              )
        (kill-current-talker '() '() 'exit)
        )
      )
    (when (and (!= (-> self intro-end-time) -1) (>= (- (- (- (if *net-mgr*
                                                                 (-> *net-mgr* game-state time)
                                                                 0
                                                                 )
                                                             (if *net-world*
                                                                 (-> *net-world* net-state game-start-time)
                                                                 0
                                                                 )
                                                             )
                                                          (if *net-world*
                                                              (-> *net-world* net-state total-pause-time)
                                                              0
                                                              )
                                                          )
                                                       (-> self intro-end-time)
                                                       )
                                                    0
                                                    )
               )
      (dotimes (gp-3 *view-count*)
        (view-push-context gp-3)
        (cam-connect-pers
          *setting-control*
          (view-get-active-index)
          'interp-time
          (seconds 2)
          'interp-time
          'abs
          570.0
          0
          )
        (cam-disconnect *setting-control* (view-get-active-index) self 'interp-time)
        (cam-disconnect *setting-control* (view-get-active-index) self 'mode-name)
        (view-pop-context)
        )
      (go-virtual running)
      )
    (if (and (!= (-> self scheduled-finish-time) -1) (>= (- (- (- (if *net-mgr*
                                                                      (-> *net-mgr* game-state time)
                                                                      0
                                                                      )
                                                                  (if *net-world*
                                                                      (-> *net-world* net-state game-start-time)
                                                                      0
                                                                      )
                                                                  )
                                                               (if *net-world*
                                                                   (-> *net-world* net-state total-pause-time)
                                                                   0
                                                                   )
                                                               )
                                                            (-> self scheduled-finish-time)
                                                            )
                                                         0
                                                         )
             )
        (reset-game-now)
        )
    )
  :code (behavior ()
    (while (or (< (-> *display* base-clock frame-counter) (-> *game-info* blackout-time))
               (!= (-> *setting-control* user-current bg-a) 0.0)
               (!= (-> *setting-control* user-current bg-a-force) 0.0)
               )
      (suspend)
      )
    (suspend-for (seconds 1.5)
      )
    (when (not (or (= (if *net-world*
                          (the-as int (-> *net-world* task-node-info net-play-mode))
                          18
                          )
                      15
                      )
                   (= (if *net-world*
                          (the-as int (-> *net-world* task-node-info net-play-mode))
                          18
                          )
                      16
                      )
                   )
               )
      (dotimes (gp-1 *active-net-player-count*)
        (let ((s5-0 (-> *active-net-players* gp-1)))
          (if (and (not (logtest? (-> s5-0 flags) (net-player-flag start-speech)))
                   (and (>= (-> s5-0 player-id) 0) (< (-> s5-0 player-id) 16))
                   (= (/ (-> s5-0 player-id) 2) (if *net-mgr*
                                                    (-> *net-mgr* game-state local-machine-idx)
                                                    0
                                                    )
                      )
                   )
              (speak-start s5-0)
              )
          (logior! (-> s5-0 flags) (net-player-flag start-speech))
          )
        )
      )
    (sleep-code)
    )
  :post (behavior ()
    (update-vehicle-info self)
    )
  )

(defstate running (net-game-mgr-deathmatch)
  :virtual #t
  :enter (behavior ()
    (let ((t9-0 (-> (method-of-type net-game-mgr running) enter)))
      (if t9-0
          (t9-0)
          )
      )
    (dotimes (gp-0 *active-net-player-count*)
      (send-event (-> *active-net-players* gp-0) 'begin-game)
      )
    )
  :trans (behavior ()
    (call-parent-state-handler trans)
    (sort-players self #f)
    (if (send-event *net-game-mgr* 'game-finished?)
        (net-game-mgr-method-64 self)
        )
    )
  :post (behavior ()
    (when #f
      (dotimes (gp-0 (-> self spawner-count))
        (let ((s5-0 add-debug-text-sphere)
              (s4-0 #t)
              (s3-0 785)
              (s2-0 (-> self spawner-array data gp-0 entity extra trans))
              (s1-0 #x47200000)
              )
          (format (clear *temp-string*) "~d" gp-0)
          (s5-0 s4-0 (the-as bucket-id s3-0) s2-0 (the-as meters s1-0) *temp-string* *color-green*)
          )
        (add-debug-x #t (bucket-id debug-no-zbuf1) (-> self spawner-array data gp-0 entity extra trans) *color-green*)
        )
      )
    (let ((t9-4 (-> (method-of-type net-game-mgr running) post)))
      (if t9-4
          ((the-as (function none) t9-4))
          )
      )
    )
  )


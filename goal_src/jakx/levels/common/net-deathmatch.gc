(defmethod vehicle-update ((this net-player-deathmatch) (arg0 wvehicle))
  (when (and (owner-is-local? arg0)
             (not (focus-test? arg0 dead))
             (not (and (>= (-> this player-id) 0) (< (-> this player-id) 16)))
             )
    )
  (when (and (owner-is-local? arg0)
             (not (focus-test? arg0 dead))
             (and (or (not (and (>= (-> this player-id) 0) (< (-> this player-id) 16)))
                      (or (>= (-> this mgr scheduled-finish-time) 0) (-> *target-camera-runtime* active))
                      )
                  (-> this last-known-pos-valid)
                  )
             )
    (let ((s3-0 (the-as entity-actor #f)))
      (-> arg0 ai flags)
      (let ((s4-0 (pick-target this (-> arg0 root trans) (-> arg0 rbody matrix fvec))))
        (cond
          ((and (or (and (< (-> arg0 health) 0.5) (>= (+ (current-time) (seconds -0.5)) (-> this last-attack-time)))
                    (not s4-0)
                    )
                (begin (set! s3-0 (get-best-defensive-powerup arg0 (-> arg0 root trans) 8192000.0 (-> arg0 health))) s3-0)
                )
           (set! (-> this target-vehicle) (the-as handle #f))
           (send-event arg0 'set 'ai-target-position (-> s3-0 extra trans))
           )
          (s4-0
            (set! (-> this target-vehicle) (process->handle s4-0))
            (send-event arg0 'set 'ai-target-process s4-0)
            )
          (else
            (set! (-> this target-vehicle) (the-as handle #f))
            )
          )
        )
      )
    (set! (-> arg0 ai desired-speed) 491520.0)
    )
  ((method-of-type net-player vehicle-update) this arg0)
  (none)
  )


;; WARN: Return type mismatch process-drawable vs wrong-way-linebot.
(defmethod relocate ((this wrong-way-linebot) (offset int))
  (dotimes (v1-0 3)
    (if (nonzero? (-> this l-control v1-0))
        (&+! (-> this l-control v1-0) offset)
        )
    )
  (the-as wrong-way-linebot ((method-of-type process-drawable relocate) this offset))
  )

(defstate idle (wrong-way-linebot)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('die)
       (sound-stop (-> self hover-sound) #t)
       (go empty-state)
       )
      (('kill-player)
       (set! (-> self my-vehicle) (process->handle (the-as process (-> block param 0))))
       (go-virtual shoot (the-as symbol (-> block param 1)))
       )
      )
    )
  :enter (behavior ()
    (let ((v1-1 (make-sound-instance snd-wrong-way (new 'static 'sound-id) (the-as handle #f))))
      (set! (-> self hover-sound) (the-as sound-id (if v1-1
                                                       (the-as int (-> v1-1 id))
                                                       0
                                                       )
                                          )
            )
      )
    )
  :exit (behavior ()
    (sound-stop (-> self hover-sound) #t)
    )
  :code (behavior ()
    (until #f
      (when (nonzero? (-> self part))
        (let ((gp-0 (new 'stack-no-clear 'inline-array 'matrix 1)))
          (quaternion->matrix (-> gp-0 0) (-> self root rotation))
          (set! (-> gp-0 0 trans quad) (-> self root trans quad))
          (spawn-from-mat (-> self part) (-> gp-0 0))
          )
        )
      (while (< (-> *display* entity-clock clock-ratio) 0.1)
        (suspend)
        )
      (suspend)
      )
    #f
    )
  :post (behavior ()
    (wrong-way-linebot-method-52 self)
    (ja-post)
    )
  )

(defstate shoot (wrong-way-linebot)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('kill-player)
       (send-event (handle->process (-> self my-vehicle)) 'go 'explode)
       )
      )
    )
  :enter (behavior ((arg0 symbol))
    (dotimes (v1-0 3)
      (set! (-> self l-control v1-0 state points-to-draw) 9)
      )
    (set! (-> *launch-matrix* trans quad) (-> *null-vector* quad))
    (set! (-> *part-tracker-params-default* group) (-> *part-group-id-table* 186))
    (vector-reset! (-> *part-tracker-params-default* local-offset))
    (set! (-> *part-tracker-params-default* duration) (the-as uint 1500))
    (set! (-> *part-tracker-params-default* callback) #f)
    (set! (-> *part-tracker-params-default* userdata) (the-as uint #f))
    (set! (-> *part-tracker-params-default* target) self)
    (set! (-> *part-tracker-params-default* mat-joint) (the-as object 0))
    (set! (-> *part-tracker-params-default* local-space-param) 0)
    (set! (-> *part-tracker-params-default* local-space-callback) #f)
    (set! (-> *part-tracker-params-default* subsampler-num) 1.0)
    *part-tracker-params-default*
    (set! (-> self spawn-part)
          (ppointer->handle (if (logtest? (-> *part-group-id-table* 186 flags) (sp-group-flag sp13))
                                (process-spawn
                                  part-tracker-subsampler
                                  :init part-tracker-subsampler-init
                                  *part-tracker-params-default*
                                  :name "part-tracker-subsampler"
                                  :to *entity-pool*
                                  :unk 0
                                  )
                                (process-spawn
                                  part-tracker
                                  :init part-tracker-init
                                  *part-tracker-params-default*
                                  :name "part-tracker"
                                  :to *entity-pool*
                                  :unk 0
                                  )
                                )
                            )
          )
    (let ((v1-31 (handle->process (-> self my-vehicle))))
      (when v1-31
        (set! (-> *launch-matrix* trans quad) (-> *null-vector* quad))
        (set! (-> *part-tracker-params-default* group) (-> *part-group-id-table* 187))
        (vector-reset! (-> *part-tracker-params-default* local-offset))
        (set! (-> *part-tracker-params-default* duration) (the-as uint 1500))
        (set! (-> *part-tracker-params-default* callback) #f)
        (set! (-> *part-tracker-params-default* userdata) (the-as uint #f))
        (set! (-> *part-tracker-params-default* target) (the-as process-drawable v1-31))
        (set! (-> *part-tracker-params-default* mat-joint) (the-as object 0))
        (set! (-> *part-tracker-params-default* local-space-param) 0)
        (set! (-> *part-tracker-params-default* local-space-callback) #f)
        (set! (-> *part-tracker-params-default* subsampler-num) 1.0)
        *part-tracker-params-default*
        (set! (-> self vehicle-part)
              (ppointer->handle (if (logtest? (-> *part-group-id-table* 187 flags) (sp-group-flag sp13))
                                    (process-spawn
                                      part-tracker-subsampler
                                      :init part-tracker-subsampler-init
                                      *part-tracker-params-default*
                                      :name "part-tracker-subsampler"
                                      :to *entity-pool*
                                      :unk 0
                                      )
                                    (process-spawn
                                      part-tracker
                                      :init part-tracker-init
                                      *part-tracker-params-default*
                                      :name "part-tracker"
                                      :to *entity-pool*
                                      :unk 0
                                      )
                                    )
                                )
              )
        )
      )
    )
  :code (behavior ((arg0 symbol))
    (set! (-> self sound-id) (new 'static 'sound-id))
    (dotimes (v1-0 3)
      (let ((a1-2 (-> self l-control v1-0))
            (a2-0 1)
            )
        (let ((a3-1 (!= a2-0 (-> a1-2 state mode))))
          (case a2-0
            ((3)
             (if a3-1
                 (set! (-> a1-2 state counter) 0.0)
                 )
             )
            ((1)
             (set! (-> a1-2 state start-color) (-> a1-2 spec start-color))
             (set! (-> a1-2 state end-color) (-> a1-2 spec end-color))
             )
            )
          )
        (set! (-> a1-2 state mode) (the-as uint a2-0))
        )
      )
    (let ((gp-0 (+ (current-time) (the int (* 300.0 (if arg0
                                                        0.1
                                                        1.0
                                                        )
                                              )
                                       )
                   )
                )
          (s5-0 #f)
          )
      (while (not s5-0)
        (let ((v1-6 (make-sound-instance snd-zap-loop (-> self sound-id) (the-as handle #f))))
          (set! (-> self sound-id)
                (the-as sound-id (cond
                                   (v1-6
                                     (set! (-> v1-6 trans quad) (-> self root trans quad))
                                     (logior! (-> v1-6 flags) (sound-spec-flag no-track needs-update))
                                     (the-as int (-> v1-6 id))
                                     )
                                   (else
                                     0
                                     )
                                   )
                        )
                )
          )
        (let ((s4-0 (handle->process (-> self my-vehicle))))
          (when s4-0
            (let ((s3-0 (new 'stack-no-clear 'inline-array 'matrix 1)))
              (quaternion->matrix (-> s3-0 0) (-> self root rotation))
              (set! (-> s3-0 0 trans quad) (-> self root trans quad))
              (vector-matrix*! (-> s3-0 0 trans) (new 'static 'vector :z 8192.0 :w 1.0) (-> s3-0 0))
              (dotimes (v1-14 3)
                (let ((a1-11 (-> self l-control v1-14))
                      (a0-17 (-> s3-0 0 trans))
                      )
                  (set! (-> a1-11 state meet data 0 quad) (-> a0-17 quad))
                  )
                )
              )
            (dotimes (v1-17 3)
              (let ((a1-14 (-> self l-control v1-17))
                    (a0-22 (-> (the-as process-drawable s4-0) root trans))
                    )
                (set! (-> a1-14 state meet data (+ (-> a1-14 state points-to-draw) -1) quad) (-> a0-22 quad))
                )
              )
            (when (< gp-0 (current-time))
              (dotimes (v1-23 3)
                (let ((a0-26 (-> self l-control v1-23))
                      (a1-17 3)
                      )
                  (let ((a2-8 (!= a1-17 (-> a0-26 state mode))))
                    (case a1-17
                      ((3)
                       (if a2-8
                           (set! (-> a0-26 state counter) 0.0)
                           )
                       )
                      ((1)
                       (set! (-> a0-26 state start-color) (-> a0-26 spec start-color))
                       (set! (-> a0-26 state end-color) (-> a0-26 spec end-color))
                       )
                      )
                    )
                  (set! (-> a0-26 state mode) (the-as uint a1-17))
                  )
                )
              (set! s5-0 #t)
              (send-event s4-0 'go 'explode)
              (send-event (ppointer->process (-> self parent)) 'stop-sound)
              (sound-stop (-> self hover-sound) #t)
              )
            )
          )
        (suspend)
        )
      )
    (send-event (ppointer->process (-> self parent)) 'go 'explode)
    (send-event (handle->process (-> self spawn-part)) 'die)
    (send-event (handle->process (-> self vehicle-part)) 'die)
    (dotimes (v1-57 3)
      (let ((a0-41 (-> self l-control v1-57))
            (a1-24 0)
            )
        (let ((a2-20 (!= a1-24 (-> a0-41 state mode))))
          (case a1-24
            ((3)
             (if a2-20
                 (set! (-> a0-41 state counter) 0.0)
                 )
             )
            ((1)
             (set! (-> a0-41 state start-color) (-> a0-41 spec start-color))
             (set! (-> a0-41 state end-color) (-> a0-41 spec end-color))
             )
            )
          )
        (set! (-> a0-41 state mode) (the-as uint a1-24))
        )
      )
    (sound-stop (-> self sound-id) #t)
    (send-event (ppointer->process (-> self parent)) 'exit)
    (until #f
      (suspend)
      )
    #f
    )
  :post (behavior ()
    (wrong-way-linebot-method-52 self)
    (ja-post)
    )
  )

(defmethod deactivate ((this wrong-way-linebot))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (if (nonzero? (-> this sound-id))
      (sound-stop (-> this sound-id) #t)
      )
  (if (nonzero? (-> this hover-sound))
      (sound-stop (-> this hover-sound) #t)
      )
  ((method-of-type process-drawable deactivate) this)
  (none)
  )

(defskelgroup skel-starting-linebot starting-linebot starting-linebot-lod0-jg starting-linebot-idle-ja
              ((starting-linebot-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 0 0 40)
              :texture-level 18
              :origin-joint-index 3
              )

(defmethod wrong-way-linebot-method-52 ((this wrong-way-linebot))
  (let* ((f1-2 (* 0.0033333334 (the float (+ (* 4095 (-> this pid)) (current-time)))))
         (f0-2 (* 0.58823526 f1-2))
         (f0-4 (- f0-2 (the float (the int f0-2))))
         (f2-5 (/ f1-2 4))
         (f30-0 (- f2-5 (the float (the int f2-5))))
         (f2-8 (/ f1-2 3))
         (f28-0 (- f2-8 (the float (the int f2-8))))
         (f1-3 (* 0.37037036 f1-2))
         (f22-0 (- f1-3 (the float (the int f1-3))))
         (f24-0 (cos-rad (* 6.283185 (+ -0.5 f0-4))))
         (f26-0 (cos-rad (* 6.283185 (+ -0.5 f30-0))))
         (f30-1 (cos-rad (* 6.283185 (+ -0.5 f28-0))))
         )
    (let ((f28-1 (cos-rad (* 6.283185 (+ -0.5 f22-0)))))
      (let ((s5-0 (new 'stack-no-clear 'inline-array 'matrix 1)))
        (quaternion->matrix (-> s5-0 0) (-> this initial-quat))
        (vector+float*! (-> this root trans) (-> this initial-pos) (-> s5-0 0 rvec) (* 4096.0 f24-0))
        (vector+float*! (-> this root trans) (-> this root trans) (-> s5-0 0 fvec) (* 4096.0 f30-1))
        (set! (-> this root trans y) (+ (-> this initial-pos y) (* 4096.0 (* 1.2 f26-0))))
        (let ((s4-0 (new 'stack-no-clear 'inline-array 'vector 1)))
          (vector-! (-> s4-0 0) (-> this initial-pos) (-> this root trans))
          (vector+float*! (-> s4-0 0) (-> s4-0 0) (-> s5-0 0 fvec) 40960.0)
          (vector-normalize! (-> s4-0 0) 1.0)
          (let ((v1-36 (new 'static 'vector :y 1.0 :w 1.0)))
            (set! (-> s5-0 0 fvec quad) (-> s4-0 0 quad))
            (vector+float*! (-> s5-0 0 uvec) v1-36 (-> s4-0 0) (- (-> s4-0 0 y)))
            )
          (vector-normalize! (-> s5-0 0 uvec) 1.0)
          (vector-cross! (-> s5-0 0 rvec) (-> s5-0 0 uvec) (-> s4-0 0))
          )
        (quaternion-normalize! (matrix->quaternion (-> this root rotation) (-> s5-0 0)))
        )
      (quaternion-rotate-z! (-> this root rotation) (-> this root rotation) (* 182.04445 (* 20.0 f28-1)))
      )
    (let ((v1-44 (find-sound-instance (-> this hover-sound) #t)))
      (cond
        (v1-44
          (set! (-> v1-44 pitch-mod) (the int (* 1524.0 (* 0.05 (+ -0.5 f30-1)))))
          (set! (-> v1-44 trans quad) (-> this root trans quad))
          (logior! (-> v1-44 flags) (sound-spec-flag no-track needs-update))
          (logior! (-> v1-44 mask) 1)
          (-> v1-44 id)
          )
        (else
          0
          )
        )
      )
    )
  (none)
  )

(defbehavior wrong-way-linebot-init-by-other wrong-way-linebot ()
  (set! (-> self root) (new 'process 'trsqv))
  (set! (-> self part) (create-launch-control (-> *part-group-id-table* 189) self))
  (set! (-> self l-control 0) (new 'process 'lightning-control (-> *lightning-spec-id-table* 1) self 0.0))
  (set! (-> self l-control 1) (new 'process 'lightning-control (-> *lightning-spec-id-table* 2) self 0.0))
  (set! (-> self l-control 2) (new 'process 'lightning-control (-> *lightning-spec-id-table* 3) self 0.0))
  (dotimes (v1-10 3)
    (set! (-> self l-control v1-10 state points-to-draw) 0)
    )
  (logior! (-> self mask) (process-mask actor-pause))
  (set-vector! (-> self root scale) 2.5 2.5 2.5 1.0)
  (initialize-skeleton
    self
    (art-group-get-by-name *level* "skel-starting-linebot" (the-as (pointer level) #f))
    0
    )
  (go-virtual idle)
  )

;; WARN: Return type mismatch process vs wrong-way-linebot.
(defun wrong-way-linebot-spawn ((arg0 process-tree))
  (let ((gp-0 (the-as process #f)))
    (let ((v1-1 (process-spawn wrong-way-linebot :name "wrong-way-linebot" :to arg0)))
      (if v1-1
          (set! gp-0 (-> v1-1 0))
          )
      )
    (the-as wrong-way-linebot gp-0)
    )
  )

(deftype wrong-way (process-drawable)
  ((base-y             float)
   (height-offset      float)
   (start-position     vector  :inline)
   (bot                handle)
   (alarm-sound        sound-id)
   (friendly           symbol)
   (kill-player-quick  symbol)
   )
  (:state-methods
    idle
    exit
    enter
    )
  (:methods
    (wrong-way-method-53 (_type_) none)
    (set-light (_type_ symbol) none)
    )
  )


(defskelgroup skel-wrong-way wrong-way wrong-way-lod0-jg wrong-way-idle-ja
              ((wrong-way-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 0 0 40)
              :texture-level 18
              :origin-joint-index 3
              )


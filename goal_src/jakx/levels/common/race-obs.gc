        (set! (-> a0-3 y) 0.31)
        (set! (-> a0-3 z) 0.0)
        (set! (-> v1-9 x) 0.5)
        (set! (-> v1-9 y) 0.31)
        (set! (-> v1-9 z) 0.0)

;; WARN: Return type mismatch (pointer process) vs race-banner.
(defun race-banner-spawn ((arg0 process-tree))
  (the-as race-banner (process-spawn race-banner :name "race-banner" :to arg0))
  )

(deftype finish-banner (race-banner)

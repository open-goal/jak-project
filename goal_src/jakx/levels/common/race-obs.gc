;; WARN: Return type mismatch int vs object.
(defbehavior set-position-and-orientation wrong-way ()
  (let ((gp-0 (new 'stack-no-clear 'inline-array 'matrix 1)))
    (let ((a0-1 (as-type (ppointer->process (-> self parent)) vehicle)))
      (matrix-copy! (-> gp-0 0) (-> (the-as vehicle a0-1) node-list data 0 bone transform))
      )
    (matrix->quaternion (-> self root rotation) (-> gp-0 0))
    (vector-matrix*! (-> self root trans) (new 'static 'vector :y 24576.0 :z 57344.0 :w 1.0) (-> gp-0 0))
    )
  (+! (-> self root trans y) (-> self height-offset))
  (wrong-way-method-53 self)
  (let ((v1-9 (find-sound-instance (-> self alarm-sound) #t)))
    (cond
      (v1-9
        (set! (-> v1-9 trans quad) (-> self root trans quad))
        (logior! (-> v1-9 flags) (sound-spec-flag no-track needs-update))
        (the-as int (-> v1-9 id))
        )
      (else
        0
        )
      )
    )
  )

;; WARN: Return type mismatch quaternion vs object.
(defbehavior set-children-position-and-orientation wrong-way ()
  (let ((gp-0 (-> self child)))
    (while gp-0
      (let ((s5-0 (ppointer->process gp-0)))
        (quaternion-copy! (-> (the-as wrong-way-linebot s5-0) initial-quat) (-> self root rotation))
        (quaternion-rotate-y!
          (-> (the-as wrong-way-linebot s5-0) initial-quat)
          (-> (the-as wrong-way-linebot s5-0) initial-quat)
          32768.0

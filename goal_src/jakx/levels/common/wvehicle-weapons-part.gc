            (when (time-elapsed? (-> pp clock old-frame-counter) s1-0)
              (if (type? s2-0 vehicle)
                  (set! (-> s2-0 stack 4452) (the-as uint (+ (-> (the-as wvehicle s2-0) dark-suck-sound-pending) 1)))
                  )
              )
            (set! (-> arg1 timer) s1-0)
            (if (zero? s1-0)
                (return (the-as float #f))
                )
            )
          (vector+float*! s4-1 s4-1 (-> s2-0 root transv) 0.0033333334)
          (let ((f30-0 (-> arg1 vel-sxvel w)))
            (let ((s2-1 (new 'stack-no-clear 'vector)))
              (let ((s1-1 (new 'stack-no-clear 'quaternion)))
                (let ((f28-0 (-> arg1 acc x)))
                  (vector-normalize-copy! (the-as vector (&-> s1-1 x)) s3-1 f28-0)

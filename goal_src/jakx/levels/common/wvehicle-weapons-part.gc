;; WARN: Return type mismatch vector vs none.
(defun birth-func-explosion-adopt-velocity ((arg0 sparticle-system)
                                   (arg1 sparticle-cpuinfo)
                                   (arg2 sprite-vec-data-3d)
                                   (arg3 sparticle-launcher)
                                   (arg4 sparticle-launch-state)
                                   )
  (let ((a0-1 (-> arg4 control proc)))
    (when a0-1
      (let ((v1-1 (new 'stack-no-clear 'vector)))
        (set! (-> v1-1 x) (-> arg1 vel-sxvel x))
        (set! (-> v1-1 y) (-> arg1 vel-sxvel y))
        (set! (-> v1-1 z) (-> arg1 vel-sxvel z))
        (set! (-> v1-1 w) 1.0)
        (vector+float*! v1-1 v1-1 (-> a0-1 root transv) 0.0033333334)
        (set! (-> arg1 vel-sxvel x) (-> v1-1 x))
        (set! (-> arg1 vel-sxvel y) (-> v1-1 y))
        (set! (-> arg1 vel-sxvel z) (-> v1-1 z))
        )
      (-> arg1 vel-sxvel)
      )
    )
  (none)
  )

;; WARN: Return type mismatch vector vs none.
(defun birth-func-explosion-aligned-velocity ((arg0 sparticle-system)
                                     (arg1 sparticle-cpuinfo)
                                     (arg2 sprite-vec-data-3d)
                                     (arg3 sparticle-launcher)
                                     (arg4 sparticle-launch-state)
                                     )
  (let ((a0-1 (-> arg4 control proc)))
    (when a0-1
      (let ((v0-1 (-> arg1 vel-sxvel))
            (v1-1 (-> arg1 vel-sxvel))
            (f0-1 (* 0.0033333334 (vector-length (-> a0-1 root transv))))
            )
        "mult vectors3 by float"
        (set! (-> v0-1 x) (* (-> v1-1 x) f0-1))
        (set! (-> v0-1 y) (* (-> v1-1 y) f0-1))
        (set! (-> v0-1 z) (* (-> v1-1 z) f0-1))
        )
      )
    )
  (none)
  )

;; WARN: Return type mismatch vector vs none.
(defun birth-func-vws-adopt-velocity ((arg0 sparticle-system)
                             (arg1 sparticle-cpuinfo)
                             (arg2 sprite-vec-data-3d)
                             (arg3 sparticle-launcher)
                             (arg4 sparticle-launch-state)
                             )
  (let ((a0-2 (handle->process (-> (the-as vehicle-weapon-slot (-> arg4 control proc)) owning-vehicle))))
    (when a0-2
      (let ((v1-5 (new 'stack-no-clear 'vector)))
        (set! (-> v1-5 x) (-> arg1 vel-sxvel x))
        (set! (-> v1-5 y) (-> arg1 vel-sxvel y))
        (set! (-> v1-5 z) (-> arg1 vel-sxvel z))
        (set! (-> v1-5 w) 1.0)
        (vector+float*! v1-5 v1-5 (-> (the-as process-drawable a0-2) root transv) 0.0033333334)
        (set! (-> arg1 vel-sxvel x) (-> v1-5 x))
        (set! (-> arg1 vel-sxvel y) (-> v1-5 y))
        (set! (-> arg1 vel-sxvel z) (-> v1-5 z))
        )
      (-> arg1 vel-sxvel)
      )
    )
  (none)
  )


;; WARN: Return type mismatch vector vs none.
(defun shield-flash-part-callback ((arg0 part-tracker))
  (set! (-> arg0 target) (the-as handle #f))
  (let ((v1-1 (handle->process (-> arg0 userdata))))
    (if (the-as process v1-1)
        (vector-local-to-world!
          (-> arg0 root trans)
          (-> arg0 offset)
          (-> (the-as process-drawable v1-1) root trans)
          (the-as quaternion (-> (the-as process-drawable v1-1) root rot))
          )
        )
    )
  (none)
  )


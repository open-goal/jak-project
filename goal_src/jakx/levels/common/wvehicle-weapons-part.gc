(define *wasted-missile-colors* (new 'static 'array rgba 8
                                  (new 'static 'rgba :r #x1e :g #x64 :b #xff)
                                  (new 'static 'rgba :r #x14 :g #x28 :b #xff)
                                  (new 'static 'rgba :r #xff :g #x1e :b #x14)
                                  (new 'static 'rgba :r #xff :g #x1e :b #xff)
                                  (new 'static 'rgba :r #xff :g #x14 :b #x46)
                                  (new 'static 'rgba :r #x32 :g #xff :b #x14)
                                  (new 'static 'rgba :r #x14 :g #x14 :b #xff)
                                  (new 'static 'rgba :r #xff :g #x50 :b #x14)
                                  )
        )

(define *wasted-missile-vec* (new 'static 'vector))

(define *wasted-missile-origin?* #f)

(defun birth-func-wasted-missile ((arg0 sparticle-system)
                         (arg1 sparticle-cpuinfo)
                         (arg2 sprite-vec-data-3d)
                         (arg3 sparticle-launcher)
                         (arg4 sparticle-launch-state)
                         )
  (let* ((v1-3 (abs (+ (-> *display* game-clock frame-counter) (the-as time-frame arg0))))
         (v1-4 (logand v1-3 7))
         )
    (set! (-> arg2 r-g-b-a x) (the float (-> *wasted-missile-colors* v1-4 r)))
    (set! (-> arg2 r-g-b-a y) (the float (-> *wasted-missile-colors* v1-4 g)))
    (set! (-> arg2 r-g-b-a z) (the float (-> *wasted-missile-colors* v1-4 b)))
    )
  (cond
    ((not *wasted-missile-origin?*)
     (quaternion-copy! (the-as quaternion *wasted-missile-vec*) (-> arg1 rotvel3d))
     (set! *wasted-missile-origin?* #t)
     )
    (else
      (quaternion-copy! (-> arg1 rotvel3d) (the-as quaternion *wasted-missile-vec*))
      (set! *wasted-missile-origin?* #f)
      )
    )
  0
  (none)
  )


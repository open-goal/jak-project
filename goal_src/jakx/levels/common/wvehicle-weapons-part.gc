        (.mul.vf vf1 vf1 vf1)
        (.mul.x.vf.x acc vf2 vf1)
        (.add.mul.y.vf.x acc vf2 vf1 acc)
        (.add.mul.z.vf.x vf1 vf2 vf1 acc)
        (.mov v1-6 vf1)
        (let ((f0-0 v1-6)
              (s4-1 (vector-float*! (new 'stack-no-clear 'vector) s3-1 (/ 1.0 (* 0.8 (the float (-> arg1 timer))))))
              )

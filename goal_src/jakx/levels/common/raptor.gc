(define *raptor-enemy-info*
  (new 'static 'net-enemy-info
    :inverse-mass 0.2
    :ragdoll-info #f
    :max-health 20.0
    :damage-scale 1.0
    :respawn-delay #x5dc
    :smooth-root-trans 0.15
    :smooth-root-quat 0.15
    :fatal-impact-impulse 4096.0
    :min-fatal-impact-enemy-vel 40960.0
    :time-before-evaporate #x384
    :time-before-respawn #xbb8
    :anim-info (new 'static 'boxed-array :type net-enemy-anim-info
      (new 'static 'net-enemy-anim-info :name 'idle :anim-idx 4 :forward-vel (new 'static 'vector :w 1.0))
      (new 'static 'net-enemy-anim-info
        :name 'run
        :anim-idx 5
        :forward-vel (new 'static 'vector :z 307200.0 :w 1.0)
        )
      (new 'static 'net-enemy-anim-info :name 'turn180 :anim-idx 6 :forward-vel (new 'static 'vector :w 1.0))
      )
    :kill-score 1
    :allow-vehicle-penetrate #t
    :ground-probe-lod-dist 40959590.0
    :show-kill-score 1
    )
  )

(set! (-> *raptor-enemy-info* ragdoll-info) *raptor-ragdoll-info*)

(deftype raptor (net-enemy)
  ()
  (:state-methods
    following-path
    idle-wait
    reverse
    chase
    )
  )


;; WARN: Return type mismatch float vs none.
(defun spt-birth-func-brightness-raptor-blood ((arg0 sparticle-system) (arg1 sparticle-cpuinfo) (arg2 sparticle-launchinfo))
  (let ((s5-0 (+ (mod (the-as int (rand-uint31-gen *random-generator*)) 51) 90))
        (s3-0 (+ (mod (the-as int (rand-uint31-gen *random-generator*)) 6) 40))
        (s4-0 (+ (logand 0 (rand-uint31-gen *random-generator*)) 140))
        (v1-7 (+ (mod (the-as int (rand-uint31-gen *random-generator*)) 6) 20))
        )
    (set! (-> arg2 rotate-x) (the float (- s5-0 s3-0)))
    (set! (-> arg2 rotate-y) (the float (- s5-0 (the-as int s4-0))))
    (set! (-> arg2 rotate-z) (the float (- s5-0 v1-7)))
    )
  (none)
  )

(defpartgroup group-raptor-damage
  :id 312
  :flags (sp0 sp4)
  :bounds (static-bspherem 0 0 0 10)
  :parts ((sp-item 1115 :flags (sp6) :period (seconds 10) :length (seconds 0.1)))
  )

(defpart 1115
  :init-specs ((:texture (water-drops level-default-sprite))
    (:birth-func 'spt-birth-func-brightness-raptor-blood)
    (:num 4.0 4.0)
    (:y (meters 4))
    (:scale-x (meters 0.5))
    (:rot-z (degrees 0) (degrees 360))
    (:scale-y :copy scale-x)
    (:r 128.0)
    (:g 128.0)
    (:b 128.0)
    (:a 64.0 64.0)
    (:omega (degrees -90))
    (:vel-y (meters 0.033333335) (meters 0.06666667))
    (:scalevel-x (meters 0.01))
    (:scalevel-y :copy scalevel-x)
    (:accel-y (meters -0.0033333334))
    (:friction 0.99)
    (:timer (seconds 2))
    (:flags (glow left-multiply-quat))
    (:func 'spt-func-on-omega-height-die)
    (:conerot-x (degrees 0) (degrees 30))
    (:rotate-y (degrees 0) (degrees 3600))
    )
  )

(defmethod init-collision! ((this raptor))
  (let ((s5-0 (new 'process 'collide-shape-moving this (collide-list-enum usually-hit-by-player))))
    (set! (-> s5-0 dynam) (copy *standard-dynamics* 'process))
    (set! (-> s5-0 reaction) cshape-reaction-default)
    (set! (-> s5-0 no-reaction)
          (the-as (function collide-shape-moving collide-query vector vector object) nothing)
          )
    (set! (-> s5-0 penetrated-by) (penetrate))
    (let ((s4-0 (new 'process 'collide-shape-prim-group s5-0 (the-as uint 1) 0)))
      (set! (-> s5-0 total-prims) (the-as uint 2))
      (set! (-> s4-0 prim-core collide-as) (collide-spec enemy obstacle))
      (set! (-> s4-0 prim-core collide-with)
            (collide-spec backgnd jak crate civilian enemy obstacle vehicle-sphere hit-by-others-list player-list pusher)
            )
      (set! (-> s4-0 prim-core action) (collide-action solid deadly no-standon))
      (set-vector! (-> s4-0 local-sphere) 0.0 16384.0 0.0 61440.0)
      (set! (-> s5-0 root-prim) s4-0)
      )
    (let ((v1-12 (new 'process 'collide-shape-prim-sphere s5-0 (the-as uint 0))))
      (set! (-> v1-12 prim-core collide-as) (collide-spec enemy))
      (set! (-> v1-12 prim-core collide-with)
            (collide-spec backgnd jak crate civilian enemy obstacle vehicle-sphere hit-by-others-list player-list pusher)
            )
      (set! (-> v1-12 prim-core action) (collide-action solid))
      (set-vector! (-> v1-12 local-sphere) 0.0 12288.0 0.0 24576.0)
      )
    (set! (-> s5-0 nav-radius) 8192.0)
    (let ((v1-14 (-> s5-0 root-prim)))
      (set! (-> s5-0 backup-collide-as) (-> v1-14 prim-core collide-as))
      (set! (-> s5-0 backup-collide-with) (-> v1-14 prim-core collide-with))
      )
    (set! (-> s5-0 max-iteration-count) (the-as uint 3))
    (set! (-> s5-0 event-self) 'touched)
    (set! (-> this root) s5-0)
    )
  0
  (none)
  )

(defmethod init-skeleton! ((this raptor))
  (vector-float*! (-> this root scale) (-> this root scale) 1.4)
  (initialize-skeleton this (art-group-get-by-name *level* "skel-raptor" (the-as (pointer level) #f)) 0)
  0
  (none)
  )

(defmethod init-paths! ((this raptor))
  (set! (-> this paths) (new 'process 'boxed-array path-control 2))
  (set! (-> this paths 0) (new 'process 'path-control this 'path 0.0 (-> this entity) #f))
  (set! (-> this paths 1) (new 'process 'path-control this 'intro 0.0 (-> this entity) #f))
  (if (zero? (-> this paths 1 curve num-cverts))
      (set! (-> this paths 1) (-> this paths 0))
      )
  0
  (none)
  )

(defmethod init-info! ((this raptor))
  (set! (-> this info) *raptor-enemy-info*)
  (set! (-> this prox) (new 'process 'proximity-ownership-params))
  (init! (-> this prox))
  (set! (-> this prox ownable-radius) 409600.0)
  (set! (-> this prox consider-ai-players) #t)
  0
  (none)
  )

;; WARN: Function (method 70 raptor) has a return type of none, but the expression builder found a return statement.
(defmethod do-transition ((this raptor) (arg0 mem-buffer) (arg1 int) (arg2 symbol))
  (when (and (-> this next-state) (= (-> this next-state name) 'in-ragdoll))
    (format 0 "we are in ragdoll~%")
    (return #f)
    )
  (case arg2
    (('go-looping)
     (go (method-of-object this following-path))
     )
    (('go-idle)
     (go (method-of-object this idle-wait))
     )
    (('reverse)
     (decode-net-anim-state (-> this net-anim) arg0)
     (update!
       (-> this net-anim)
       this
       (- (- (if *net-mgr*
                 (-> *net-mgr* game-state time)
                 0
                 )
             (if *net-world*
                 (-> *net-world* net-state game-start-time)
                 0
                 )
             )
          (if *net-world*
              (-> *net-world* net-state total-pause-time)
              0
              )
          )
       #t
       )
     (go (method-of-object this reverse))
     )
    (else
      ((method-of-type net-enemy do-transition) this arg0 arg1 arg2)
      )
    )
  0
  (none)
  )

(defmethod on-attack ((this raptor) (arg0 attack-info))
  (when (!= (-> arg0 id) (-> this last-attack-id))
    (let ((v1-3 (make-sound-instance snd-blood-spurt (new 'static 'sound-id) (the-as handle #f))))
      (if v1-3
          (-> v1-3 id)
          0
          )
      )
    (set! (-> *launch-matrix* trans quad) (-> arg0 trans quad))
    (set! (-> *part-tracker-params-default* group) (-> *part-group-id-table* 312))
    (vector-reset! (-> *part-tracker-params-default* local-offset))
    (set! (-> *part-tracker-params-default* duration) (the-as uint 300))
    (set! (-> *part-tracker-params-default* callback) #f)
    (set! (-> *part-tracker-params-default* userdata) (the-as uint #f))
    (set! (-> *part-tracker-params-default* target) this)
    (set! (-> *part-tracker-params-default* mat-joint) (the-as object 0))
    (set! (-> *part-tracker-params-default* local-space-param) 0)
    (set! (-> *part-tracker-params-default* local-space-callback) #f)
    (set! (-> *part-tracker-params-default* subsampler-num) 1.0)
    *part-tracker-params-default*
    (if (logtest? (-> *part-group-id-table* 312 flags) (sp-group-flag sp13))
        (process-spawn
          part-tracker-subsampler
          :init part-tracker-subsampler-init
          *part-tracker-params-default*
          :name "part-tracker-subsampler"
          :to *entity-pool*
          :unk 0
          )
        (process-spawn
          part-tracker
          :init part-tracker-init
          *part-tracker-params-default*
          :name "part-tracker"
          :to *entity-pool*
          :unk 0
          )
        )
    )
  ((method-of-type net-enemy on-attack) this arg0)
  (none)
  )

(defmethod on-impact ((this raptor) (arg0 rigid-body-impact))
  (let ((v1-1 (make-sound-instance snd-flesh-impacts (new 'static 'sound-id) (the-as handle #f))))
    (if v1-1
        (-> v1-1 id)
        0
        )
    )
  ((method-of-type net-enemy on-impact) this arg0)
  (none)
  )

;; WARN: Return type mismatch object vs none.
(defmethod on-fatal-impact ((this raptor) (arg0 rigid-body-impact) (arg1 int))
  (let ((v1-1 (make-sound-instance snd-raptor-death (new 'static 'sound-id) (the-as handle #f))))
    (if v1-1
        (-> v1-1 id)
        0
        )
    )
  (let ((t9-1 (method-of-type net-enemy on-fatal-impact)))
    (t9-1 this arg0 arg1)
    )
  (go (method-of-object this in-ragdoll))
  (none)
  )

;; WARN: Return type mismatch object vs none.
(defmethod on-fatal-attack ((this raptor) (arg0 int) (arg1 int))
  (let ((v1-1 (make-sound-instance snd-raptor-death (new 'static 'sound-id) (the-as handle #f))))
    (if v1-1
        (-> v1-1 id)
        0
        )
    )
  (let ((t9-1 (method-of-type net-enemy on-fatal-attack)))
    (t9-1 this arg0 arg1)
    )
  (go (method-of-object this in-ragdoll))
  (none)
  )

(defstate startup (raptor)
  :virtual #t
  :enter (behavior ()
    (when (type? (-> self root) collide-shape)
      (let ((v1-2 (-> self root root-prim)))
        (set! (-> v1-2 prim-core collide-as) (collide-spec))
        (set! (-> v1-2 prim-core collide-with) (collide-spec))
        )
      0
      )
    (logior! (-> self draw status) (draw-control-status no-draw))
    (if (type? (-> self root) collide-shape)
        (transform-post)
        )
    (set! (-> self net-anim active timestamp) (-> self last-transition-time))

    (let ((v1-12 (new 'process 'collide-shape-prim-sphere s5-0 (the-as uint 0))))
      (set! (-> v1-12 prim-core action) (collide-action solid))
      (set-vector! (-> v1-12 local-sphere) 0.0 0.0 0.0 0.0)
      (set! (-> s5-0 total-prims) (the-as uint 1))
      (set! (-> s5-0 root-prim) v1-12)
      )
    (set! (-> s5-0 nav-radius) (* 0.75 (-> s5-0 root-prim local-sphere w)))
    (let ((v1-15 (-> s5-0 root-prim)))
      (set! (-> s5-0 backup-collide-as) (-> v1-15 prim-core collide-as))
      (set! (-> s5-0 backup-collide-with) (-> v1-15 prim-core collide-with))
      )
    (set! (-> self root) s5-0)
    )
  (set! (-> self root event-self) 'touched)
  (set! (-> self root trans quad) (-> arg0 spawn-point quad))
  (quaternion-copy! (-> self root rotation) (-> arg0 spawn-quat))
  (vector-identity! (-> self root scale))
  (vector-float*! (-> self root scale) (-> self root scale) (-> arg0 scale))
  (set! (-> self root transv quad) (-> arg0 velocity quad))
  (matrix<-transformq! (-> self mat) (the-as transformq (-> self root trans)))
  (let ((v1-29 (-> self root root-prim)))
    (set! (-> v1-29 local-sphere w) (-> arg0 radius))
    (set! (-> v1-29 prim-core world-sphere w) (-> arg0 radius))
    (set! (-> v1-29 prim-core collide-with) (-> arg0 collide-with))
    )
  (let* ((v1-30 *game-info*)
         (a0-26 (+ (-> v1-30 attack-id) 1))
         )
    (set! (-> v1-30 attack-id) a0-26)
    (set! (-> self attack-id) a0-26)
    )
  (let ((a0-27 (-> arg0 group)))
    (when a0-27
      (set! (-> self duration) (-> a0-27 duration))
      (set! (-> self linger-duration) (-> a0-27 linger-duration))
      (set! (-> self part) (create-launch-control a0-27 self))
      )
    )
  (set! (-> self killed-someone?) #f)
  (explosion-method-52 self)
  (go-virtual explode)
  )

(defun explosion-spawn-legacy-version ((arg0 process-drawable) (arg1 type) (arg2 explosion-init-params))
  (let ((s4-0 (get-process *default-dead-pool* arg1 #x4000 1)))
    (when s4-0
      (let ((t9-1 (method-of-type process activate))
            (a0-2 s4-0)
            (a2-2 "explosion")
            (a3-1 #x70004000)
            )
        (t9-1 a0-2 arg0 a2-2 (the-as pointer a3-1))
        (run-now-in-process s4-0 explosion-init-by-other arg2 (the-as none a3-1))
        )
      (-> s4-0 ppointer)
      )
    )
  )

;; WARN: Return type mismatch process vs explosion.
(defun explosion-spawn ((arg0 explosion-init-params) (arg1 process-drawable))
  (with-pp
    (let ((gp-0 (the-as process #f)))
      (let ((v1-1 (process-spawn explosion arg0 pp :name "explosion" :to arg1)))
        (if v1-1
            (set! gp-0 (-> v1-1 0))
            )
        )
      (the-as explosion gp-0)
      )
    )
  )

(defun find-closest-solid-sphere-prim ((arg0 collide-shape) (arg1 vector) (arg2 collide-spec))
  (let ((gp-0 (the-as collide-shape-prim #f)))
    (let ((s3-0 (new 'stack-no-clear 'vector)))
      (set! (-> s3-0 x) (the-as float #x7f800000))

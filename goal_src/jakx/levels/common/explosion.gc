(in-package goal)

;; name: explosion.gc
;; name in dgo: explosion
;; dgos: COMMON, GAME

;; +++explosion-cquery-stack
(deftype explosion-cquery-stack (structure)
  "(event explode explosion)"
  ((cquery          collide-query :inline)
   (explosion-trans vector        :inline)
   (proc-trans      vector        :inline)
   (probe           float)
   (dist            float)
   )
  )
;; ---explosion-cquery-stack



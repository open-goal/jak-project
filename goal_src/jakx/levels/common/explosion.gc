                                                                 wpn-type
                                                                 )
                                                         )
                               )
                         )
                     (set! (-> s1-9 id) (-> gp-1 attack-id))
                     (set! (-> s1-9 damage) (-> s2-3 1 z))
                     (set! (-> s1-9 vehicle-damage-factor) (-> gp-1 params vehicle-damage-factor))
                     (set! (-> s1-9 vehicle-impulse-factor) (-> gp-1 params vehicle-impulse-factor))
                     (set! (-> s1-9 mode) 'explode)
                     (set! (-> s1-9 attacker-velocity quad) (-> (the-as (pointer uint128) (-> s2-3 0))))
                     (set! (-> s1-9 attacker) (-> gp-1 params attacker))
                     (set! (-> s1-9 count) (the-as uint (-> gp-1 params wpn-type)))
                     (set! (-> s1-9 intersection quad) (-> (vector-normalize-copy!
                                                             (new 'stack-no-clear 'vector)
                                                             (-> s2-3 0)
                                                             (- (-> (the-as collide-prim-core s3-2) world-sphere w))
                                                             )
                                                           quad
                                                           )
                           )
                     (send-event s5-1 'attack (-> s4-2 param 0) s1-9)
                     (if (nonzero? (-> s1-9 attacker))
                         (send-event (handle->process (-> s1-9 attacker)) 'you-attacked 'attack s5-1 s1-9)
                         )
                     )
                   )
                 )
               )
             (when (!= (-> gp-1 params group) (-> gp-1 params group-on-kill))
               (let ((v1-107 (as-type s5-1 vehicle)))
                 (when v1-107
                   (if (>= 0.0 (-> (the-as vehicle v1-107) health))
                       (set! (-> gp-1 killed-someone?) #t)
                       )
                   )
                 )
               (let ((v1-108 (as-type s5-1 net-enemy)))
                 (when v1-108
                   (when (>= 0.0 (the-as float (-> (the-as vehicle v1-108) disturbed-time)))
                     (set! v0-0 #t)
                     (set! (-> gp-1 killed-someone?) v0-0)
                     v0-0
                     )
                   )
                 )
               )
             )
           )
         )
       )
      )
    )
  :enter (behavior ()
    (set-time! (-> self start-time))
    (when (nonzero? (-> self params collide-with))
      (update-transforms (-> self root))
      (let ((a1-0 (new 'stack-no-clear 'overlaps-others-params)))
        (set! (-> a1-0 options) (overlaps-others-options))
        (set! (-> a1-0 collide-with-filter) (the-as collide-spec -1))
        (set! (-> a1-0 tlist) *touching-list*)
        (find-overlapping-shapes (-> self root) a1-0)
        )
      )
    (let ((v1-11 (-> self root root-prim)))
      (set! (-> v1-11 prim-core collide-as) (collide-spec))
      (set! (-> v1-11 prim-core collide-with) (collide-spec))
      )
    0
    )
  :trans (behavior ()
    (when (!= (-> self params velocity w) 0.0)
      (let ((gp-0 (-> self root)))
        (integrate-and-collide! gp-0 (-> gp-0 transv))
        (let* ((s4-0 (-> self mat))
               (s5-0 (vector-normalize-copy! (new 'stack-no-clear 'vector) (-> gp-0 transv) 1.0))
               (s2-0 (new 'stack-no-clear 'vector))
               (a0-4 (vector-get-closest-perpendicular! s2-0 s5-0 (vector-get-unique! (new 'stack-no-clear 'vector) s5-0)))
               (v1-3 s4-0)
               )
          (set! (-> v1-3 fvec quad) (-> s5-0 quad))
          (set! (-> v1-3 uvec quad) (-> a0-4 quad))
          (vector-cross! (-> v1-3 rvec) (-> v1-3 uvec) s5-0)
          )
        (set! (-> self mat trans quad) (-> gp-0 trans quad))
        )
      )
    (cond
      ((time-elapsed? (-> self start-time) (the-as time-frame (-> self duration)))
       (if (time-elapsed? (-> self start-time) (the-as time-frame (+ (-> self duration) (-> self linger-duration))))
           (deactivate self)
           )
       )
      ((or (= (-> self params group) (-> self params group-on-kill)) (not (-> self killed-someone?)))
       (if (not *explosion-effect-suppress*)
           (spawn-from-mat (-> self part) (-> self mat))
           )
       )
      )
    )
  :code sleep-code
  :post (behavior ()
    (if (!= (-> self params velocity w) 0.0)
        (transform-post)
        )
    )
  )

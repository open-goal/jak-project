;;-*-Lisp-*-
(in-package goal)

;; name: net-hud.gc
;; name in dgo: net-hud
;; dgos: COMMON, GAME

;; +++hud-item-flag
(defenum hud-item-flag
  :type int32
  :bitfield #t
  (visible 0)
  (fullscreen 1)
  (right-of-prev 2)
  (left-of-prev 3)
  (above-prev 4)
  (below-prev 5)
  (at-prev 6)
  (center-x 7)
  (bit8 8)
  (align-right 9)
  (bit10 10)
  (align-bottom 11)
  (center-y 12)
  (position-dirty 13)
  (size-dirty 14)
  (draw-dirty 15)
  (bit16 16)
  (bit17 17)
  (bit18 18)
  )
;; ---hud-item-flag

;; DECOMP BEGINS

(define *debug-hud* #f)

(define *display-boxes* #f)

(deftype in-game-hud (hud)
  ((real-items            basic)
   (items                 (array hud-item))
   (manager               basic-manager)
   (inited-strings-count  int32)
   )
  (:methods
    (in-game-hud-method-30 (_type_) none)
    (in-game-hud-method-31 (_type_) none)
    (in-game-hud-method-32 (_type_ hud-item vector) none)
    )
  )


(define *current-hud* (the-as in-game-hud #f))

(deftype hud-item (basic)
  ((alpha            uint8)
   (real-alpha       uint8)
   (position-x       int16)
   (position-y       int16)
   (real-position-x  int16)
   (real-position-y  int16)
   (width            int16)
   (height           int16)
   (real-width       int16)
   (real-height      int16)
   (zval             uint16)
   (real-scale       int16)
   (scale            int16)
   (flags            hud-item-flag)
   (effect           hud-effect)
   (parent           hud-item)
   )
  (:methods
    (init (_type_) symbol)
    (set-fullscreen (_type_) none)
    (cleanup (_type_) none)
    (mark-position-dirty (_type_) none)
    (mark-draw-dirty (_type_) none)
    (mark-size-dirty (_type_) none)
    (set-parent! (_type_ object) none)
    (hud-item-method-16 (_type_) none)
    (update-size (_type_ float) none)
    (update-position (_type_ hud-item vector float) symbol)
    (update (_type_) none)
    (set-real-alpha! (_type_ float) none)
    (hide (_type_) none)
    (show (_type_) none)
    (hud-item-method-23 (_type_ process int symbol event-message-block) object)
    )
  )


(deftype hud-effect (basic)
  ((message       symbol)
   (active        symbol)
   (pending       symbol)
   (delay         int32)
   (receive-time  int32)
   (item          hud-item)
   )
  (:methods
    (apply-size (_type_) none)
    (apply-position (_type_) none)
    (update (_type_) none)
    (init (_type_ hud-item) none)
    (hud-effect-event-handler (_type_ process int symbol event-message-block) object)
    (trigger (_type_) none)
    )
  )


(defmethod apply-size ((this hud-effect))
  0
  (none)
  )

(defmethod apply-position ((this hud-effect))
  0
  (none)
  )

(defmethod update ((this hud-effect))
  (let ((s5-0 (- (- (if *net-mgr*
                        (-> *net-mgr* game-state time)
                        0
                        )
                    (if *net-world*
                        (-> *net-world* net-state game-start-time)
                        0
                        )
                    )
                 (if *net-world*
                     (-> *net-world* net-state total-pause-time)
                     0
                     )
                 )
              )
        )
    (when (and (not (-> this active)) (!= -1 (-> this receive-time)))
      (if (-> this pending)
          (mark-draw-dirty (-> this item))
          )
      (when (>= s5-0 (+ (-> this receive-time) (-> this delay)))
        (set! (-> this active) #t)
        (set! (-> this receive-time) -1)
        (trigger this)
        )
      )
    )
  0
  (none)
  )

;; WARN: Return type mismatch hud-item vs none.
(defmethod init ((this hud-effect) (arg0 hud-item))
  (set! (-> this active) #f)
  (set! (-> this pending) #f)
  (set! (-> this receive-time) -1)
  (set! (-> this item) arg0)
  (none)
  )

(defmethod set-fullscreen ((this hud-item))
  (logior! (-> this flags) (hud-item-flag fullscreen))
  0
  (none)
  )

;; WARN: Return type mismatch symbol vs none.
(defmethod trigger ((this hud-effect))
  (let ((s5-0 (-> this item)))
    (mark-position-dirty s5-0)
    (mark-size-dirty s5-0)
    (mark-draw-dirty s5-0)
    )
  (set! (-> this pending) #f)
  (none)
  )

;; WARN: Return type mismatch none vs object.
(defmethod hud-effect-event-handler ((this hud-effect) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (when (and (not (-> this active)) (= arg2 (-> this message)))
    (set! (-> this receive-time) (- (- (if *net-mgr*
                                           (-> *net-mgr* game-state time)
                                           0
                                           )
                                       (if *net-world*
                                           (-> *net-world* net-state game-start-time)
                                           0
                                           )
                                       )
                                    (if *net-world*
                                        (-> *net-world* net-state total-pause-time)
                                        0
                                        )
                                    )
          )
    (set! (-> this active) #f)
    (set! (-> this pending) #t)
    (mark-draw-dirty (-> this item))
    )
  )

(deftype hud-manager (basic)
  ()
  (:methods
    (init (_type_) none)
    (update (_type_) none)
    (hud-mgr-event-handler (_type_ process int symbol event-message-block) object)
    )
  )


(defmethod init ((this hud-manager))
  0
  (none)
  )

(defmethod update ((this hud-manager))
  0
  (none)
  )

;; WARN: Return type mismatch symbol vs object.
(defmethod hud-mgr-event-handler ((this hud-manager) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  #t
  )

(deftype basic-manager (hud-manager)
  ((exit-start-time  int32)
   (exit-time        int32)
   (previous-time    int32)
   )
  )


;; WARN: Return type mismatch object vs none.
(defmethod init ((this basic-manager))
  (set! (-> this exit-start-time) -1)
  (let ((a1-0 *current-hud*))
    (hud-event-handler a1-0 a1-0 0 'enter (the-as event-message-block #f))
    )
  (none)
  )

(defmethod update ((this basic-manager))
  (when (!= (-> this exit-start-time) -1)
    (let ((s5-0 (+ (-> this exit-start-time) (-> this exit-time))))
      (if (and (>= (- (- (if *net-mgr*
                             (-> *net-mgr* game-state time)
                             0
                             )
                         (if *net-world*
                             (-> *net-world* net-state game-start-time)
                             0
                             )
                         )
                      (if *net-world*
                          (-> *net-world* net-state total-pause-time)
                          0
                          )
                      )
                   s5-0
                   )
               (>= s5-0 (-> this previous-time))
               )
          (send-event *current-hud* 'exit)
          )
      (let ((v1-14 (+ s5-0 600)))
        (if (>= (- (- (if *net-mgr*
                          (-> *net-mgr* game-state time)
                          0
                          )
                      (if *net-world*
                          (-> *net-world* net-state game-start-time)
                          0
                          )
                      )
                   (if *net-world*
                       (-> *net-world* net-state total-pause-time)
                       0
                       )
                   )
                v1-14
                )
            (send-event *current-hud* 'hide-and-die)
            )
        )
      )
    (set! (-> this previous-time) (- (- (if *net-mgr*
                                            (-> *net-mgr* game-state time)
                                            0
                                            )
                                        (if *net-world*
                                            (-> *net-world* net-state game-start-time)
                                            0
                                            )
                                        )
                                     (if *net-world*
                                         (-> *net-world* net-state total-pause-time)
                                         0
                                         )
                                     )
          )
    )
  0
  (none)
  )

(defmethod hud-mgr-event-handler ((this basic-manager) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (case arg2
    (('kill-hud)
     (cond
       ((= (-> this exit-start-time) -1)
        (set! (-> this exit-start-time) (- (- (if *net-mgr*
                                                  (-> *net-mgr* game-state time)
                                                  0
                                                  )
                                              (if *net-world*
                                                  (-> *net-world* net-state game-start-time)
                                                  0
                                                  )
                                              )
                                           (if *net-world*
                                               (-> *net-world* net-state total-pause-time)
                                               0
                                               )
                                           )
              )
        (set! (-> this exit-time) (the-as int (-> arg3 param 0)))
        (set! (-> this previous-time) (- (- (if *net-mgr*
                                                (-> *net-mgr* game-state time)
                                                0
                                                )
                                            (if *net-world*
                                                (-> *net-world* net-state game-start-time)
                                                0
                                                )
                                            )
                                         (if *net-world*
                                             (-> *net-world* net-state total-pause-time)
                                             0
                                             )
                                         )
              )
        )
       (else
         (set! (-> this exit-time) (min (-> this exit-time) (the-as int (-> arg3 param 0))))
         )
       )
     #t
     )
    (('kill-hud-instant)
     (set! (-> this exit-start-time) (+ (- (- -3000 (if *net-world*
                                                        (-> *net-world* net-state total-pause-time)
                                                        0
                                                        )
                                              )
                                           (if *net-world*
                                               (-> *net-world* net-state game-start-time)
                                               0
                                               )
                                           )
                                        (if *net-mgr*
                                            (-> *net-mgr* game-state time)
                                            0
                                            )
                                        )
           )
     (set! (-> this exit-time) 0)
     (set! (-> this previous-time) (-> this exit-start-time))
     (deactivate *current-hud*)
     (send-event *current-hud* 'hide-and-die)
     )
    (('revive-hud)
     (cond
       ((and (!= -1 (-> this exit-start-time))
             (< (+ (-> this exit-start-time) (-> this exit-time)) (- (- (if *net-mgr*
                                                                            (-> *net-mgr* game-state time)
                                                                            0
                                                                            )
                                                                        (if *net-world*
                                                                            (-> *net-world* net-state game-start-time)
                                                                            0
                                                                            )
                                                                        )
                                                                     (if *net-world*
                                                                         (-> *net-world* net-state total-pause-time)
                                                                         0
                                                                         )
                                                                     )
                )
             )
        #f
        )
       ((!= (-> this exit-start-time) -1)
        (set! (-> this exit-start-time) -1)
        #t
        )
       (else
         #t
         )
       )
     )
    )
  )


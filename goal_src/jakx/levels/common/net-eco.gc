(defstate running (eco-mgr)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('go-die)
       (go-virtual die)
       )
      )
    )
  :trans (behavior ()
    (update self)
    )
  :code sleep-code
  )

(defstate die (eco-mgr)
  :virtual #t
  :code (behavior ()
    '()
    )
  )


(defmethod reset-owners ((this eco-mgr))
  (dotimes (v1-0 *eco-ct*)
    (let ((a0-3 (-> *eco-array* v1-0)))
      (-> a0-3 extra process)
      (let ((a0-5 (the-as eco-perm (-> a0-3 extra perm))))
        (set! (-> a0-5 owner) 8)
        (set! (-> a0-5 hit-by-local) -1)
        (logclear! (-> a0-5 flags) (eco-perm-flag owner-requested))
        )
      )
    )
  0
  (none)
  )

(defstate running (eco)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('go-die)
       (go-virtual die)
       )
      )
    )
  :code sleep-code
  )

(defstate die (eco)
  :virtual #t
  :code (behavior ()
    '()
    )
  )

;; WARN: Return type mismatch object vs none.
(defmethod init! ((this eco))
  (go (method-of-object this running))
  (none)
  )

;; WARN: Return type mismatch int vs object.
(defmethod init-from-entity! ((this eco) (arg0 entity-actor))
  (stack-size-set! (-> this main-thread) 32)
  (set! (-> this entity) arg0)
  (set! (-> this root) (new 'process 'trsqv))
  (process-drawable-from-entity! this (-> this entity))
  (init! this)
  0
  )

(defmethod get-collide-sphere! ((this eco) (arg0 vector) (arg1 entity-actor))
  (set! (-> arg0 quad) (-> arg1 trans quad))
  (set! (-> arg0 w) 16384.0)
  0
  (none)
  )

(defmethod on-collected ((this eco) (arg0 entity-actor) (arg1 int))
  (if this
      (send-event this 'go-die)
      )
  0
  (none)
  )

;; WARN: Return type mismatch int vs time-frame.
(defmethod get-respawn-delay ((this eco))
  (let ((v1-3 (if *net-world*
                  (the-as int (-> *net-world* task-node-info net-play-mode))
                  18
                  )
              )
        )
    (the-as time-frame (if (or (zero? v1-3) (or (= v1-3 1) (= v1-3 10) (= v1-3 13)))
                           1200
                           3000
                           )
            )
    )
  )

  ((method-of-type hud-effect update) this)
  (none)
  )

(deftype hud-effect-offscreen (hud-effect)
  ((offscreen-type  uint64)
   )
  )


(defmethod apply-position ((this hud-effect-offscreen))
  (let ((v1-0 (-> this item))
        (a1-0 (-> this offscreen-type))
        )
    (cond
      ((zero? a1-0)
       (when (not (-> this active))
         (+! (-> v1-0 real-position-x) 542)
         (set! (-> v1-0 real-scale) 0)
         0
         )
       )
      ((= a1-0 1)
       (when (-> this active)
         (+! (-> v1-0 real-position-x) 542)
         (set! (-> v1-0 real-scale) 0)
         0
         )
       )
      )
    )
  (none)
  )

      )
    (let ((v1-2 (-> this jmod-steering-wheel)))
      (quaternion-copy! (-> v1-2 rotation) (the-as quaternion (&-> s5-0 x)))
      )
    )
  0
  (let ((s5-1 (new 'stack-no-clear 'inline-array 'quaternion 2)))
    (set-vector! (-> s5-1 1) -2457.6 -2457.6 -3072.0 -3072.0)
    (dotimes (s4-1 4)
      (let* ((s2-1 (-> this wheel s4-1))
             (s3-1 (-> s2-1 info))
             )
        (quaternion-axis-angle! (-> s5-1 0) 0.0 (-> s2-1 x-scale) 0.0 (-> s2-1 steer-angle))
        (let ((v1-11 (-> this jmod-axles s4-1)))
          (set! (-> v1-11 trans y) (+ (-> (&-> s5-1 0 vec data s4-1) 4) (* (- 1.0 (-> s2-1 pos2)) (-> s3-1 travel))))
          (quaternion-copy! (-> v1-11 rot) (-> s5-1 0))
          )
        )
      0
      )
    )
  0
  (none)
  )


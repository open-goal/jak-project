;;-*-Lisp-*-
(in-package goal)

;; name: net-enemy-h.gc
;; name in dgo: net-enemy-h
;; dgos: COMMON, GAME

;; +++net-enemy-info-flag
(defenum net-enemy-info-flag
  :type uint64
  :bitfield #t
  (use-nav 0)
  )
;; ---net-enemy-info-flag

;; +++net-enemy-snap-flag
(defenum net-enemy-snap-flag
  :type uint64
  :bitfield #t
  (snap-quat 0)
  (snap-trans 1)
  )
;; ---net-enemy-snap-flag

;; +++net-enemy-flag
(defenum net-enemy-flag
  :type uint64
  :bitfield #t
  (bit0 0)
  (proximity-ownership 1)
  (snap-to-ground 2)
  (keep-ground-offset 3)
  (attackable 4)
  (impactable 5)
  (check-overlaps 6)
  )
;; ---net-enemy-flag

;; DECOMP BEGINS

(deftype net-enemy-transition (structure)
  ((timestamp  int32)
   (name       symbol)
   (preempt    symbol)
   (data-len   int32)
   (buf-data   uint8  64)
   )
  )


(define *tmp-construct-transition* (new 'static 'net-enemy-transition))

(deftype net-enemy-anim-info (structure)
  ((name         symbol)
   (anim-idx     int32)
   (forward-vel  vector)
   )
  )


(deftype net-enemy-info (structure)
  ((flags                       net-enemy-info-flag)
   (inverse-mass                float)
   (ragdoll-info                ragdoll-setup)
   (max-health                  float)
   (damage-scale                float)
   (respawn-delay               int32)
   (smooth-root-trans           float)
   (smooth-root-quat            float)
   (fatal-impact-impulse        float)
   (min-fatal-impact-enemy-vel  float)
   (time-before-evaporate       int32)
   (time-before-respawn         int32)
   (anim-info                   (array net-enemy-anim-info))
   (kill-score                  int32)
   (wound-score-scale           float)
   (allow-vehicle-penetrate     symbol)
   (min-ground-offset           float)
   (ground-probe-lod-dist       float)
   (show-kill-score             int32)
   )
  )


(deftype net-enemy (process-focusable)
  ((flags                   net-enemy-flag)
   (info                    net-enemy-info)
   (ragdoll-proc            handle)
   (health                  float)
   (local-damage            float)
   (killed-by               int8)
   (last-health-send-time   int32)
   (net-anim                net-anim-control      :inline)
   (minimap                 connection-minimap)
   (transitions             net-enemy-transition  3 :inline)
   (transition-ct           int32)
   (last-attack-time        int32)
   (vehicle-penetrate-time  int32)
   (paths                   (array path-control))
   (pending-impulse-valid   symbol)
   (pending-impulse         rigid-body-impact     :inline)
   (last-transition-time    int32)
   (last-attack-id          int32)
   (vel-for-ragdoll         vector                :inline)
   (nav-poly                nav-poly)
   (snap-flags              net-enemy-snap-flag)
   (prev-pos                vector                :inline)
   (forward-path-vector     vector                :inline)
   (enemy-link              linked-list           :inline)
   )
  (:state-methods
    startup
    in-ragdoll
    waiting-respawn
    )
  (:methods
    (init! (_type_) none)
    (net-enemy-method-63 (_type_) none)
    (send-local-damage (_type_) none)
    (on-attack (_type_ attack-info) none)
    (on-fatal-attack (_type_ int int) none)
    (on-impact (_type_ rigid-body-impact) none)
    (on-fatal-impact (_type_ rigid-body-impact int) none)
    (update-transitions (_type_) none)
    (do-transition (_type_ mem-buffer int symbol) none)
    (transition-pending? (_type_) symbol)
    (queue-transition (_type_ net-enemy-transition) none)
    (clear-transitions (_type_) none)
    (update-trans (_type_ vector quaternion) none)
    (init-collision! (_type_) none)
    (init-skeleton! (_type_) none)
    (init-paths! (_type_) none)
    (init-info! (_type_) none)
    (impulse->attack-velocity (_type_ vector vector float) vector)
    (send-impact-attack (_type_ process-focusable rigid-body-impact) none)
    (common-post (_type_) none)
    (reset! (_type_) none)
    (init-nav! (_type_) none)
    (face-nav-heading (_type_ nav-control) none)
    (integrate-nav-vel (_type_ nav-control) none)
    (get-anim-end-time (_type_ int int) int)
    )
  )


;; WARN: Return type mismatch int vs object.
(defbehavior net-enemy-init-remote process-focusable ((arg0 mem-buffer))
  (register self -1 #xffff)
  (init-remote self arg0)
  (post-init-remote self)
  0
  )

(defmethod spawn-remote ((this net-enemy) (arg0 mem-buffer))
  (ppointer->process (process-spawn net-enemy :init net-enemy-init-remote arg0 :name "net-enemy"))
  )

(defmethod write-msg-map ((this net-enemy) (arg0 net-process-class-info))
  (set! (-> arg0 msg-map (-> arg0 msg-count)) 'transition)
  (+! (-> arg0 msg-count) 1)
  (set! (-> arg0 msg-map (-> arg0 msg-count)) 'damage)
  (+! (-> arg0 msg-count) 1)
  0
  (none)
  )

(define *msg-map-net-enemy* (new 'static 'boxed-array :type symbol :length 0 :allocated-length 64))

(define *net-process-class-info-net-enemy* (new 'static 'net-process-class-info))

(set! (-> *net-process-class-info-net-enemy* msg-map) *msg-map-net-enemy*)

(write-msg-map-rec net-enemy *net-process-class-info-net-enemy*)

(set! (-> *net-process-class-info-net-enemy* owner-type) net-enemy)

(net-process-class-register *net-process-class-info-net-enemy*)

(defmethod get-class-info ((this net-enemy))
  *net-process-class-info-net-enemy*
  )

(define *net-enemy-list* (new 'static 'linked-list))

(clear! *net-enemy-list*)

;; DECOMP BEGINS

(deftype train-object (rigid-body-object)
  ((target-position  vector  :inline)
   )
  )


(define *train-constants* (new 'static 'rigid-body-object-constants
                            :info (new 'static 'rigid-body-info
                              :max-time-step 0.033333335
                              :mass 10000.0
                              :inv-mass 0.0001
                              :cm-offset-joint (new 'static 'vector :w 1.0)
                              :inertial-tensor-box (new 'static 'array meters 3 (meters 20) (meters 20) (meters 20))
                              :gravity 163840.0
                              )
                            :name '*train-constants*
                            )
        )

(define *train-headlight-glow-template* (new 'static 'sprite-glow-data
                                          :position (new 'static 'vector :w 8192.0)
                                          :size-probe 163.84
                                          :z-offset 819.2
                                          :size-y 8192.0
                                          :color (new 'static 'rgbaf :x 255.0 :y 192.0 :z 128.0 :w 16.0)
                                          :fade-a -0.0000122044
                                          :fade-b 8.997864
                                          :tex-id (new 'static 'texture-id :index #x15 :page #x4)
                                          )
        )

(defmethod rigid-body-object-method-71 ((this train-object))
  (let ((f30-0 (seconds-per-frame)))
    (let ((v1-1 (new 'stack-no-clear 'inline-array 'vector 1)))
      (vector-! (-> v1-1 0) (-> this target-position) (-> this root trans))
      (vector-float*! (-> this rbody lin-velocity) (-> v1-1 0) (/ 1.0 f30-0))
      )
    (vector-float*! (-> this rbody lin-momentum) (-> this rbody lin-velocity) (-> this rbody info info mass))
    (vector-reset! (-> this rbody ang-momentum))
    (let ((v1-8 (new 'stack-no-clear 'inline-array 'collide-query 1)))
      (set! (-> v1-8 0 start-pos quad) (-> this root root-prim prim-core world-sphere quad))
      (vector-float*! (-> v1-8 0 move-dist) (-> this rbody lin-velocity) (seconds-per-frame))
      (let ((a0-10 (-> v1-8 0)))
        (set! (-> a0-10 radius) (+ 122880.0 (-> this root root-prim local-sphere w)))
        (set! (-> a0-10 collide-with) (collide-spec vehicle-sphere hit-by-others-list))
        (set! (-> a0-10 ignore-process0) #f)
        (set! (-> a0-10 ignore-process1) #f)
        (set! (-> a0-10 ignore-pat)
              (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noendlessfall #x1 :board #x1)
              )
        (set! (-> a0-10 action-mask) (collide-action solid))
        (set! (-> a0-10 nav-mesh) #f)
        )
      (fill-using-line-sphere *collide-cache* (-> v1-8 0))
      )
    (init-velocities! (-> this rbody))
    (rbody-collision (-> this root) (-> this rbody) f30-0)
    )
  (rigid-body-object-method-70 this)
  (update-rbody-transform! (-> this rbody) (-> this root))
  (rigid-body-object-method-61 this)
  (update-transforms (-> this root))
  0
  (none)
  )

(defmethod rigid-body-object-method-77 ((this train-object))
  0
  (none)
  )

(defmethod rigid-body-object-method-66 ((this train-object))
  (process-entity-status! this (entity-perm-status no-kill) #t)
  (rigid-body-object-method-64 this *train-constants*)
  (logior! (-> this rbody flags) (rigid-body-flag enable-physics enable-penetrate-mode debug-active))
  (set! (-> this root max-iteration-count) (the-as uint 8))
  0
  (none)
  )

(deftype train-car (train-object)
  ()
  )


(defstate idle (train-car)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('die)
       (go empty-state)
       )
      (else
        (let ((t9-2 (the-as function (-> (find-parent-state) event))))
          (if (the-as (function process int symbol event-message-block object) t9-2)
              ((the-as (function none) t9-2))
              )
          )
        )
      )
    )
  :post (behavior ()
    (rigid-body-object-method-71 self)
    )
  )

(defmethod rigid-body-object-method-66 ((this train-car))
  (set-vector! (-> this root scale) 1.0 1.0 1.0 1.0)
  ((method-of-type train-object rigid-body-object-method-66) this)
  (none)
  )

;; WARN: Return type mismatch int vs object.
(defbehavior train-car-init-by-other train-car ((arg0 object) (arg1 art-group))
  (init-collision! self)
  (initialize-skeleton self arg1 0)
  (rigid-body-object-method-66 self)
  (rigid-body-object-method-67 self)
  (set! (-> self draw light-index) (the-as uint 10))
  0
  )

(defmethod init-collision! ((this train-car))
  (let ((s5-0 (new 'process 'collide-shape-moving this (collide-list-enum usually-hit-by-player))))
    (set! (-> s5-0 dynam) (copy *standard-dynamics* 'process))
    (set! (-> s5-0 reaction) cshape-reaction-default)
    (set! (-> s5-0 no-reaction)
          (the-as (function collide-shape-moving collide-query vector vector object) nothing)
          )
    (let ((s4-0 (new 'process 'collide-shape-prim-group s5-0 (the-as uint 2) 0)))
      (set! (-> s5-0 total-prims) (the-as uint 3))
      (set! (-> s4-0 prim-core collide-as) (collide-spec obstacle camera-blocker))
      (set! (-> s4-0 prim-core collide-with) (collide-spec vehicle-sphere hit-by-others-list))
      (set! (-> s4-0 prim-core action) (collide-action solid))
      (set! (-> s4-0 transform-index) 3)
      (set-vector! (-> s4-0 local-sphere) 0.0 0.0 -28672.0 122880.0)
      (set! (-> s5-0 root-prim) s4-0)
      )
    (let ((v1-13 (new 'process 'collide-shape-prim-sphere s5-0 (the-as uint 0))))
      (set! (-> v1-13 prim-core collide-as) (collide-spec obstacle camera-blocker pusher))
      (set! (-> v1-13 prim-core collide-with) (collide-spec vehicle-sphere hit-by-others-list))
      (set! (-> v1-13 prim-core action) (collide-action solid))
      (set! (-> v1-13 transform-index) 0)
      (set-vector! (-> v1-13 local-sphere) 0.0 32768.0 -40960.0 61440.0)
      )
    (let ((v1-15 (new 'process 'collide-shape-prim-sphere s5-0 (the-as uint 0))))
      (set! (-> v1-15 prim-core collide-as) (collide-spec obstacle camera-blocker pusher))
      (set! (-> v1-15 prim-core collide-with) (collide-spec vehicle-sphere hit-by-others-list))
      (set! (-> v1-15 prim-core action) (collide-action solid))
      (set! (-> v1-15 transform-index) 0)
      (set-vector! (-> v1-15 local-sphere) 0.0 32768.0 -122880.0 61440.0)
      )
    (set! (-> s5-0 nav-radius) (* 0.75 (-> s5-0 root-prim local-sphere w)))
    (let ((v1-18 (-> s5-0 root-prim)))
      (set! (-> s5-0 backup-collide-as) (-> v1-18 prim-core collide-as))
      (set! (-> s5-0 backup-collide-with) (-> v1-18 prim-core collide-with))
      )
    (set! (-> this root) s5-0)
    )
  0
  (none)
  )

;; WARN: Return type mismatch process vs train-car.
(defun train-car-spawn ((arg0 process-tree) (arg1 art-group))
  (let ((gp-0 (the-as process #f)))
    (let ((v1-1 (process-spawn train-car arg0 arg1 :name "train-car" :to arg0)))
      (if v1-1
          (set! gp-0 (-> v1-1 0))
          )
      )
    (the-as train-car gp-0)
    )
  )

(define *desired-number-of-cars* 3)

(deftype train (train-object)
  ((curve           curve-control)
   (head-car        int32)
   (number-of-cars  int32)
   (cars            handle  10)
   (length          float)
   (train-sound-id  sound-id)
   (horn-id         sound-id)
   (next-horn-time  int32)
   (start           vector  :inline)
   (end             vector  :inline)
   (offset-time     float)
   )
  (:states
    training-mine
    )
  )


(defskelgroup skel-train train train-loco-lod0-jg train-loco-idle-ja
              ((train-loco-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 0 7 30)
              :origin-joint-index 3
              )

;; WARN: Return type mismatch quaternion vs object.
(defbehavior position-train-car train ((arg0 train) (arg1 float) (arg2 float) (arg3 symbol))
  (let ((s5-0 (-> self curve)))
    (let ((s1-0 (new 'stack-no-clear 'inline-array 'vector 1)))
      (path-control-method-14 s5-0 (-> s1-0 0) arg1 'interp)
      (when (< 81920.0 (vector-vector-distance (-> arg0 root trans) (-> s1-0 0)))
        (set! (-> arg0 rbody position quad) (-> s1-0 0 quad))
        (set! (-> self root trans quad) (-> s1-0 0 quad))
        )
      (vector-lerp! (-> arg0 target-position) (-> arg0 root trans) (-> s1-0 0) 0.08)
      )
    (let ((s1-1 (new 'stack-no-clear 'inline-array 'vector 1)))
      (if arg3
          (path-control-method-14 s5-0 (-> s1-1 0) (path-control-method-26 s5-0 arg1 (- arg2)) 'interp)
          (path-control-method-14 s5-0 (-> s1-1 0) (path-control-method-26 s5-0 arg1 arg2) 'interp)
          )
      (if arg3
          (vector-! (-> s1-1 0) (-> arg0 target-position) (-> s1-1 0))
          (vector-! (-> s1-1 0) (-> s1-1 0) (-> arg0 target-position))
          )
      (if (< (vector-normalize-ret-len! (-> s1-1 0) 1.0) 122880.0)
          (path-control-method-16 s5-0 (-> s1-1 0) arg1)
          )
      (let ((s5-1 (new 'stack-no-clear 'inline-array 'quaternion 1)))
        (quaternion-look-at! (-> s5-1 0) (-> s1-1 0) *up-vector*)
        (if (< (quaternion-dot (the-as quaternion (-> arg0 rbody rot)) (-> s5-1 0)) 0.9)
            (quaternion-copy! (the-as quaternion (-> arg0 rbody rot)) (-> s5-1 0))
            (quaternion-slerp!
              (the-as quaternion (-> arg0 rbody rot))
              (the-as quaternion (-> arg0 rbody rot))
              (-> s5-1 0)
              0.05
              )
            )
        )
      )
    )
  )

(defbehavior train-move train ()
  (let* ((f0-0 (-> self length))
         (f1-2 (/ (* 409.6 (the float (+ (- (- (if *net-mgr*
                                                   (-> *net-mgr* game-state time)
                                                   0
                                                   )
                                               (if *net-world*
                                                   (-> *net-world* net-state game-start-time)
                                                   0
                                                   )
                                               )
                                            (if *net-world*
                                                (-> *net-world* net-state total-pause-time)
                                                0
                                                )
                                            )
                                         (the int (* 300.0 (-> self offset-time)))
                                         )
                                )
                     )
                  f0-0
                  )
               )
         (f30-0 (* f0-0 (- f1-2 (the float (the int f1-2)))))
         )
    (position-train-car self (path-control-method-26 (-> self curve) 0.0 (+ 12288.0 f30-0)) 184320.0 #f)
    (dotimes (gp-1 (-> self number-of-cars))
      (let ((s5-1 (handle->process (-> self cars gp-1))))
        (if s5-1
            (position-train-car
              (the-as train s5-1)
              (path-control-method-26 (-> self curve) 0.0 (- f30-0 (* 196608.0 (the float (max 0 gp-1)))))
              184320.0
              #t
              )
            )
        )
      )
    )
  (when (nonzero? (-> self cars (/ (-> self number-of-cars) 2)))
    (let ((v1-35
            (make-sound-instance snd-train-engine (-> self train-sound-id) (-> self cars (/ (-> self number-of-cars) 2)))
            )
          )
      (set! (-> self train-sound-id) (the-as sound-id (if v1-35
                                                          (the-as int (-> v1-35 id))
                                                          0
                                                          )
                                             )
            )
      )
    )
  (none)
  )

(defskelgroup skel-train-car train train-car-lod0-jg train-car-idle-ja
              ((train-car-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 0 -7 30)
              :origin-joint-index 3
              )

(defskelgroup skel-train-car-b train train-car-b-lod0-jg train-car-b-idle-ja
              ((train-car-b-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 0 -7 30)
              :origin-joint-index 3
              )

(defskelgroup skel-train-car-c train train-car-c-lod0-jg train-car-c-idle-ja
              ((train-car-c-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 0 -7 30)
              :origin-joint-index 3
              )

(defbehavior cars-spawn train ()
  (when (get-open-task-node-info)
    (while (< (-> self number-of-cars) *desired-number-of-cars*)
      (case (-> (get-open-task-node-info) level)
        (('docks 'dockkra)
         (let ((v1-2 (-> self number-of-cars)))
           (cond
             ((zero? v1-2)
              (set! (-> self cars (-> self number-of-cars))
                    (process->handle
                      (train-car-spawn self (art-group-get-by-name *level* "skel-train-car-b" (the-as (pointer level) #f)))
                      )
                    )
              )
             ((= v1-2 1)
              (set! (-> self cars (-> self number-of-cars))
                    (process->handle
                      (train-car-spawn self (art-group-get-by-name *level* "skel-train-car-c" (the-as (pointer level) #f)))
                      )
                    )
              )
             (else
               (set! (-> self cars (-> self number-of-cars))
                     (process->handle
                       (train-car-spawn self (art-group-get-by-name *level* "skel-train-car-b" (the-as (pointer level) #f)))
                       )
                     )
               )
             )
           )
         )
        (else
          (set! (-> self cars (-> self number-of-cars))
                (process->handle
                  (train-car-spawn self (art-group-get-by-name *level* "skel-train-car" (the-as (pointer level) #f)))
                  )
                )
          )
        )
      (+! (-> self number-of-cars) 1)
      )
    (while (< *desired-number-of-cars* (-> self number-of-cars))
      (send-event (handle->process (-> self cars (+ (-> self number-of-cars) -1))) 'die)
      (+! (-> self number-of-cars) -1)
      )
    #f
    )
  )

(defmethod deactivate ((this train))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (while (> (-> this number-of-cars) 0)
    (send-event (handle->process (-> this cars (+ (-> this number-of-cars) -1))) 'die)
    (+! (-> this number-of-cars) -1)
    )
  ((method-of-type rigid-body-object deactivate) this)
  (none)
  )

;; WARN: Return type mismatch gui-connection vs none.
;; WARN: Function play-horn has a return type of none, but the expression builder found a return statement.
(defbehavior play-horn train ()
  (local-vars (v1-23 symbol))
  (sound-params-set! *gui-control* (-> self horn-id) #t 204800.0 614400.0 1.0 0.3 #t)
  (if (and (!= -1 (-> self next-horn-time))
           (not (and (!= (-> self next-horn-time) -1) (>= (- (- (- (if *net-mgr*
                                                                       (-> *net-mgr* game-state time)
                                                                       0
                                                                       )
                                                                   (if *net-world*
                                                                       (-> *net-world* net-state game-start-time)
                                                                       0
                                                                       )
                                                                   )
                                                                (if *net-world*
                                                                    (-> *net-world* net-state total-pause-time)
                                                                    0
                                                                    )
                                                                )
                                                             (-> self next-horn-time)
                                                             )
                                                          0
                                                          )
                     )
                )
           )
      (return #f)
      )
  (dotimes (gp-0 *active-net-player-count*)
    (let ((a0-12 (-> *active-net-players* gp-0)))
      (when a0-12
        (let ((v1-18 (get-vehicle a0-12)))
          (when v1-18
            (when (< (vector-vector-distance (-> v1-18 root trans) (-> self root trans)) 409600.0)
              (set! v1-23 #t)
              (goto cfg-28)
              )
            )
          )
        )
      )
    )
  (set! v1-23 #f)
  (label cfg-28)
  (when v1-23
    (set! (-> self next-horn-time) (+ (- (- 3000 (if *net-world*
                                                     (-> *net-world* net-state total-pause-time)
                                                     0
                                                     )
                                            )
                                         (if *net-world*
                                             (-> *net-world* net-state game-start-time)
                                             0
                                             )
                                         )
                                      (if *net-mgr*
                                          (-> *net-mgr* game-state time)
                                          0
                                          )
                                      )
          )
    0
    (let ((f30-0 0.5))
      (if (< f30-0 (rand-float-gen))
          (set! (-> self horn-id)
                (add-process *gui-control* self (gui-channel daxter) (gui-action play) "train1" -99.0 0)
                )
          (set! (-> self horn-id)
                (add-process *gui-control* self (gui-channel daxter) (gui-action play) "train2" -99.0 0)
                )
          )
      )
    (sound-params-set! *gui-control* (-> self horn-id) #t 204800.0 614400.0 1.0 0.3 #t)
    )
  (none)
  )

(defstate idle (train)
  :virtual #t
  :post (behavior ()
    (cars-spawn)
    (train-move)
    (play-horn)
    (rigid-body-object-method-71 self)
    )
  )


  (initialize-skeleton this (art-group-get-by-name *level* "skel-train" (the-as (pointer level) #f)) 0)
  (let ((t9-4 (method-of-type train-object rigid-body-object-method-66)))
    (t9-4 this)
    )
  (set! (-> this train-sound-id) (new-sound-id))
  (set! (-> this horn-id) (new-sound-id))
  (set! (-> this next-horn-time) -1)
  (set! (-> this length) (+ (total-distance (-> this curve)) (* 196608.0 (the float *desired-number-of-cars*))))
  (path-control-method-14 (-> this curve) (-> this start) 0.0 'interp)
  (path-control-method-14 (-> this curve) (-> this end) 1.0 'interp)
  (set! (-> this draw light-index) (the-as uint 10))
  0
  (none)
  )

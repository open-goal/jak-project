                                             (= (if *net-mgr*
                                                    (-> *net-mgr* game-state local-machine-idx)
                                                    0
                                                    )
                                                (-> *net-mgr* game-state session-master-idx)
                                                )
                                             )
                 )
             (= arg0 (net-game-mgr-assassin-method-85 (-> this mgr) (-> this player-id)))
             )
    (let ((t9-2 (method-of-type net-player-deathmatch score-kill)))
      (t9-2 this arg0)
      )
    (send-event (-> this mgr) 'mark-killed (-> this player-id) arg0)
    )
  (none)
  )


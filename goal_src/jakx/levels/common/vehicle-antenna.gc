;;-*-Lisp-*-
(in-package goal)

;; name: vehicle-antenna.gc
;; name in dgo: vehicle-antenna
;; dgos: COMMON, GAME

;; +++vehicle-antenna-sim-stack
(deftype vehicle-antenna-sim-stack (structure)
  "vehicle-antenna::52"
  ((vehicle-vel     vector     :inline)
   (tip-pos         vector     :inline)
   (attach-pos      vector     :inline)
   (accel           vector     :inline)
   (tail-dir        vector     :inline :offset 80)
   (tip-rot         quaternion :inline)
   (inv-tip-rot     quaternion :inline)
   (inv-root-mat    matrix     :inline)
   (dt              float)
   (spring-k        float)
   (damping         float)
   (tail-dist       float)
   (rot             quaternion :inline)
   (rot2            quaternion :inline)
   (bend-axis       vector     :inline :offset 304)
   (max-bend        float)
   )
  )
;; ---vehicle-antenna-sim-stack

;; DECOMP BEGINS

(deftype joint-mod-set-rot-local (joint-mod-base)
  ((rotation  quaternion  :inline)
   )
  )


(defmethod init ((this joint-mod-set-rot-local) (arg0 process-drawable) (arg1 uint) (arg2 joint-mod-base-flags))
  "Set up this joint-mod to modify the given joint of the given process. Will attach automatically if attached flag is set."
  (set! (-> this callback)
        (lambda ((arg0 cspace) (arg1 transformq))
          (let ((v1-0 (-> arg0 param1)))
            (quaternion-copy! (the-as quaternion (-> arg1 rot)) (the-as quaternion (+ (the-as uint v1-0) 16)))
            )
          (cspace<-parented-transformq-joint! arg0 arg1)
          (none)
          )
        )
  (quaternion-identity! (-> this rotation))
  ((method-of-type joint-mod-base init) this arg0 arg1 arg2)
  (none)
  )

(deftype vehicle-antenna-state (structure)
  ((data  vector  6 :inline)
   )
  )


(deftype vehicle-antenna (process-drawable)
  ((vehicle           handle)
   (attach-local-pos  vector                   :inline)
   (attach-rot        quaternion               :inline)
   (jmod-antenna      joint-mod-set-rot-local  4 :inline)
   (jmod-tail         joint-mod-set-rot-local  :inline)
   (sim-state         vehicle-antenna-state    :inline)
   (ant-tip-pos       vector                   :inline :overlay-at (-> sim-state data 0))
   (ant-tip-vel       vector                   :inline :overlay-at (-> sim-state data 1))
   (spring-pos        vector                   :inline :overlay-at (-> sim-state data 2))
   (spring-vel        vector                   :inline :overlay-at (-> sim-state data 3))
   (tail-pos          vector                   :inline :overlay-at (-> sim-state data 4))
   (tail-vel          vector                   :inline :overlay-at (-> sim-state data 5))
   (i-tip-node        int8)
   (use-tail?         symbol)
   )
  (:state-methods
    idle
    die
    )
  (:methods
    (update-sim (_type_) none)
    (snap-to-vehicle (_type_) none)
    (modify-draw-status (_type_ draw-control-status draw-control-status) none)
    )
  )


(defmethod modify-draw-status ((this vehicle-antenna) (arg0 draw-control-status) (arg1 draw-control-status))
  (set! (-> this draw status) (logclear (logior (-> this draw status) arg0) arg1))
  0
  (none)
  )

(define *vehicle-antenna-state* (new 'static 'vehicle-antenna-state))

(defstate idle (vehicle-antenna)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('modify-draw-status)
       (let ((a1-1 (-> block param 0))
             (a2-1 (-> block param 1))
             )
         (modify-draw-status self (the-as draw-control-status a1-1) (the-as draw-control-status a2-1))
         )
       )
      (('explode)
       (let ((v1-3 (-> self draw color-mult)))
         (vector-float*! (the-as vector v1-3) (the-as vector v1-3) 0.25)
         )
       )
      (('die)
       (go-virtual die)
       )
      (('set-position)
       (let ((v1-6 (the-as object (-> block param 0)))
             (v0-0 (the-as object (-> self attach-local-pos)))
             )
         (set! (-> (the-as vector v0-0) quad) (-> (the-as vector v1-6) quad))
         v0-0
         )
       )
      (('save-state)
       (format 0 "vehicle-antenna::idle event-handler: save-state~%")
       (mem-copy! (the-as pointer *vehicle-antenna-state*) (the-as pointer (-> self sim-state)) 96)
       )
      )
    )
  :enter (behavior ()
    '()
    )
  :exit (behavior ()
    0
    )
  :trans #f
  :code sleep-code
  :post (behavior ()
    (set! (-> self sim-state data 0 quad) (-> self node-list data (-> self i-tip-node) bone transform trans quad))
    (update-sim self)
    )
  )

(defstate die (vehicle-antenna)
  :virtual #t
  :code (behavior ()
    '()
    )
  )

(defmethod update-sim ((this vehicle-antenna))
  (rlet ((vf0 :class vf))
    (init-vf0-vector)
    (let ((s5-0 (new 'stack-no-clear 'vehicle-antenna-sim-stack)))
      (set! (-> s5-0 dt) (seconds-per-frame))
      (set! (-> s5-0 tip-pos quad) (-> this sim-state data 0 quad))
      (let ((s4-0 (the-as vehicle (handle->process (-> this vehicle)))))
        (cond
          (s4-0
            (set! (-> this draw global-effect) (-> s4-0 draw global-effect))
            (let ((s3-0 (-> s4-0 rbody)))
              (get-velocity-at-point s3-0 (-> s5-0 tip-pos) (-> s5-0 vehicle-vel))
              (vector-matrix*! (-> s5-0 attach-pos) (-> this attach-local-pos) (-> s3-0 matrix))
              )
            (set! (-> this root trans quad) (-> s5-0 attach-pos quad))
            (quaternion*! (-> this root rotation) (-> s4-0 root rotation) (-> this attach-rot))
            )
          (else
            (deactivate this)
            )
          )
        )
      (quaternion-conjugate! (-> s5-0 rot) (-> this root rotation))
      (quaternion->matrix (-> s5-0 inv-root-mat) (-> s5-0 rot))
      (vector-! (-> s5-0 accel) (-> this ant-tip-vel) (-> s5-0 vehicle-vel))
      (set! (-> this ant-tip-vel quad) (-> s5-0 vehicle-vel quad))
      (vector-float*! (-> s5-0 accel) (-> s5-0 accel) (/ 1.0 (-> s5-0 dt)))
      (vector+float*! (-> s5-0 accel) (-> s5-0 accel) (-> s5-0 vehicle-vel) -1.0)
      (+! (-> s5-0 accel y) -245760.0)
      (vector-rotate*! (-> s5-0 accel) (-> s5-0 accel) (-> s5-0 inv-root-mat))
      (vector+float*! (-> this spring-vel) (-> this spring-vel) (-> s5-0 accel) (/ (-> s5-0 dt) METER_LENGTH))
      (set! (-> s5-0 spring-k) 500.0)
      (set! (-> s5-0 damping) 5.0)
      (vector+float*!
        (-> this spring-vel)
        (-> this spring-vel)
        (-> this spring-pos)
        (* -1.0 (-> s5-0 dt) (-> s5-0 spring-k))
        )
      (vector-float*!
        (-> this spring-vel)
        (-> this spring-vel)
        (fmax 0.0 (+ 1.0 (* -1.0 (-> s5-0 damping) (-> s5-0 dt))))
        )
      (vector+float*! (-> this spring-pos) (-> this spring-pos) (-> this spring-vel) (-> s5-0 dt))
      (set! (-> this spring-pos y) 0.0)
      (let ((f0-17 (vector-length-squared (-> this spring-pos))))
        (when (< 1.0 f0-17)
          (vector-float*! (-> this spring-pos) (-> this spring-pos) (/ 1.0 (sqrtf f0-17)))
          (vector-reset! (-> this spring-vel))
          )
        )
      (set! (-> s5-0 max-bend) 0.3826)
      (vector-rotate90-around-y! (-> s5-0 bend-axis) (-> this spring-pos))
      (vector-float*! (-> s5-0 bend-axis) (-> s5-0 bend-axis) (* -1.0 (-> s5-0 max-bend)))
      (set! (-> s5-0 rot x) (-> s5-0 bend-axis x))
      (set! (-> s5-0 rot y) (-> s5-0 bend-axis y))
      (set! (-> s5-0 rot z) (-> s5-0 bend-axis z))
      (set! (-> s5-0 rot w) (sqrtf (- 1.0 (vector-length-squared (-> s5-0 bend-axis)))))
      (quaternion-copy! (-> this jmod-antenna 0 rotation) (-> s5-0 rot))
      (quaternion-copy! (-> this jmod-antenna 1 rotation) (-> s5-0 rot))
      (quaternion-copy! (-> this jmod-antenna 2 rotation) (-> s5-0 rot))
      (quaternion*! (-> s5-0 rot2) (-> s5-0 rot) (-> s5-0 rot))
      (quaternion*! (-> s5-0 tip-rot) (-> this root rotation) (-> s5-0 rot))
      (quaternion*! (-> s5-0 tip-rot) (-> s5-0 tip-rot) (-> s5-0 rot2))
      (quaternion-conjugate! (-> s5-0 inv-tip-rot) (-> s5-0 tip-rot))
      (vector-float*! (-> s5-0 accel) (-> s5-0 vehicle-vel) -1.0)
      (vector-reset! (-> s5-0 accel))
      (+! (-> s5-0 accel y) -40960.0)
      (vector+float*! (-> this tail-vel) (-> this tail-vel) (-> s5-0 accel) (-> s5-0 dt))
      (vector-float*! (-> this tail-vel) (-> this tail-vel) (fmax 0.0 (+ 1.0 (/ (-> s5-0 dt) -4))))
      (vector+float*! (-> this tail-pos) (-> this tail-pos) (-> this tail-vel) (-> s5-0 dt))
      (vector-! (-> s5-0 tail-dir) (-> this tail-pos) (-> s5-0 tip-pos))
      (set! (-> s5-0 tail-dist) (vector-normalize-ret-len! (-> s5-0 tail-dir) 1.0))
      (when (< 4096.0 (-> s5-0 tail-dist))
        (vector+float*!
          (-> this tail-vel)
          (-> this tail-vel)
          (-> s5-0 tail-dir)
          (- (vector-dot (-> s5-0 tail-dir) (-> s5-0 vehicle-vel)) (vector-dot (-> s5-0 tail-dir) (-> this tail-vel)))
          )
        (vector+float*! (-> this tail-pos) (-> s5-0 tip-pos) (-> s5-0 tail-dir) 4096.0)
        )
      (let ((s4-1 (new 'stack-no-clear 'inline-array 'matrix 1)))
        (set! (-> s4-1 0 uvec quad) (-> s5-0 tail-dir quad))
        (.svf (&-> (-> s4-1 0) rvec quad) vf0)
        (if #t
            (set! (-> s4-1 0 rvec x) 1.0)
            (set! (-> s4-1 0 rvec z) 1.0)
            )
        (vector-cross! (-> s4-1 0 fvec) (-> s4-1 0 rvec) (-> s4-1 0 uvec))
        (vector-normalize! (-> s4-1 0 fvec) 1.0)
        (vector-cross! (-> s4-1 0 rvec) (-> s4-1 0 uvec) (-> s4-1 0 fvec))
        (matrix->quaternion (-> s5-0 rot) (-> s4-1 0))
        )
      (quaternion*! (-> this jmod-tail rotation) (-> s5-0 inv-tip-rot) (-> s5-0 rot))
      )
    (ja-post)
    0
    (none)
    )
  )

(defmethod snap-to-vehicle ((this vehicle-antenna))
  (let ((s5-0 (the-as vehicle (handle->process (-> this vehicle)))))
    (when s5-0
      (let ((v1-4 (-> s5-0 rbody))
            (s4-0 (new 'stack-no-clear 'inline-array 'vector 1))
            )
        (vector-matrix*! (-> s4-0 0) (-> this attach-local-pos) (-> v1-4 matrix))
        (set! (-> this root trans quad) (-> s4-0 0 quad))
        )
      (quaternion*! (-> this root rotation) (-> s5-0 root rotation) (-> this attach-rot))
      0
      )
    )
  0
  (none)
  )

(defbehavior vehicle-antenna-init-by-other vehicle-antenna ((arg0 vehicle-antenna-init-params))
  (stack-size-set! (-> self main-thread) 16)
  (set! (-> self root) (new 'process 'trsqv))
  (set-vector! (-> self root scale) 1.0 1.0 1.0 1.0)
  (set! (-> self level) (-> *level* level-default))
  (set! (-> self attach-local-pos quad) (-> arg0 pos quad))
  (quaternion-axis-angle! (-> self attach-rot) 1.0 0.0 0.0 (-> arg0 tilt))
  (when (-> arg0 vehicle)
    (set! (-> self vehicle) (process->handle (-> arg0 vehicle)))
    (snap-to-vehicle self)
    (let ((v1-19 (-> *car-level-array* data (+ (-> arg0 level slot) -6)))
          (s5-0 0)
          )
      (set! (-> self use-tail?) #f)
      (case (-> v1-19 current-parts 9)
        ((1)
         (set! s5-0 3)
         (set! (-> self use-tail?) #t)
         )
        ((2)
         (set! s5-0 5)
         )
        ((3)
         (set! s5-0 9)
         )
        ((4)
         (set! s5-0 17)
         )
        ((5)
         (set! s5-0 33)
         )
        ((6)
         (set! s5-0 65)
         (set! (-> self use-tail?) #t)
         )
        )
      (when (nonzero? s5-0)
        (initialize-skeleton self (art-group-get-by-name *level* "skel-antenna-all" (the-as (pointer level) #f)) 0)
        (when (nonzero? (-> self draw))
          (setup-masks (-> self draw) 0 -1)
          (setup-masks (-> self draw) s5-0 0)
          )
        )
      )
    (when (nonzero? (-> self draw))
      (set! (-> self draw lights) (-> arg0 vehicle draw lights))
      ((method-of-type joint-mod-set-rot-local init)
       (-> self jmod-antenna 0)
       self
       (the-as uint 3)
       (joint-mod-base-flags attached)
       )
      (init (-> self jmod-antenna 1) self (the-as uint 4) (joint-mod-base-flags attached))
      (init (-> self jmod-antenna 2) self (the-as uint 5) (joint-mod-base-flags attached))
      (if (-> self use-tail?)
          (init (-> self jmod-tail) self (the-as uint 6) (joint-mod-base-flags attached))
          )
      (set! (-> self i-tip-node) 6)
      (mem-copy! (the-as pointer (-> self sim-state)) (the-as pointer *vehicle-antenna-state*) 96)
      (update-sim self)
      (go-virtual idle)
      )
    )
  )

;; WARN: Return type mismatch process vs vehicle-antenna.
(defun vehicle-antenna-spawn ((arg0 vehicle-antenna-init-params))
  (let ((gp-0 (the-as process #f)))
    (let* ((s4-0 (get-process *default-dead-pool* vehicle-antenna #x4000 1))
           (v1-1 (when s4-0
                   (let ((t9-1 (method-of-type process activate)))
                     (t9-1 s4-0 *rigid-body-queue-manager* "vehicle-antenna" (the-as pointer #x70004000))
                     )
                   (run-now-in-process s4-0 vehicle-antenna-init-by-other arg0)
                   (-> s4-0 ppointer)
                   )
                 )
           )
      (if v1-1
          (set! gp-0 (-> v1-1 0))
          )
      )
    (the-as vehicle-antenna gp-0)
    )
  )

(load-scene
  (new 'static 'scene
    :name "intro-missile-03"
    :extra #f
    :info #f
    :scene-flags (scene-flags scf1 scf2 scf3 scf4 scf7)
    :mask-to-clear (process-mask movie projectile)
    :entity "scene-stage-11"
    :art-group "scenecamera"
    :anim "intro-missile-03"
    :parts 4
    :command-list '((0
        (apply
          ,(lambda :behavior scene-player
             ()
             (set-movie-time! 19 0 (time-of-day-palette-id unk0 unk2))
             (set-movie-fog! (new 'static 'vector :x 43.5937 :y 36.7639 :z 123.5156 :w 1.0) 16.0 1000.0 16.0 255.0)
             (set-movie-color!
               (new 'static 'vector :x 0.05 :y 0.149 :z 0.375 :w 1.0)
               (new 'static 'vector :x 0.35 :y 0.451 :z 0.625 :w 1.0)
               )
             (none)
             )
          )
        (kill "this-way-178")

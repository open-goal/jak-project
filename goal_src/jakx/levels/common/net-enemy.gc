          )
      (forward-up->quaternion (the-as quaternion (-> gp-1 2)) (-> gp-1 0) (new 'static 'vector :y 1.0 :w 1.0))
      (update-trans self (-> gp-1 1) (the-as quaternion (-> gp-1 2)))

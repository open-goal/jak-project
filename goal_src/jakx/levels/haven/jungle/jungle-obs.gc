(deftype flaming-arrow (process-drawable)
  ((flame-sound  ambient-sound)
   )
  (:state-methods
    idle
    )
  )


(defskelgroup skel-jungle-flaming-arrow jungle-flaming-arrow jungle-flaming-arrow-lod0-jg jungle-flaming-arrow-idle-ja
              ((jungle-flaming-arrow-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 0 0 20)
              :origin-joint-index 3
              )

(defmethod init-from-entity! ((this flaming-arrow) (arg0 entity-actor))
  (stack-size-set! (-> this main-thread) 32)
  (set! (-> this root) (new 'process 'trsqv))
  (set! (-> this level) (level-group-method-32 *level*))
  (process-drawable-from-entity! this arg0)
  (process-drawable-method-42
    this
    (art-group-get-by-name *level* "skel-jungle-flaming-arrow" (the-as (pointer level) #f))
    0
    )
  (set! (-> this flame-sound) (new 'process 'ambient-sound "flaming-arrow" (-> this root trans) 0.0))
  (set-falloff-far! (-> this flame-sound) 1228800.0)
  (set! (-> this part) (create-launch-control (-> *part-group-id-table* 356) this))
  (set! (-> this draw light-index) (the-as uint 10))
  (go (method-of-object this idle))
  )

(defbehavior spawn-flame flaming-arrow ()
  (when (nonzero? (-> self part))
    (let ((gp-0 (new 'stack-no-clear 'jungle-obs-stack-var0)))
      (quaternion-rotate-x! (-> gp-0 quat) (the-as quaternion (-> self root rot)) 40049.777)
      (quaternion->matrix (-> gp-0 mat) (-> gp-0 quat))
      (vector-matrix*!
        (-> gp-0 mat trans)
        (new 'static 'vector :data (new 'static 'array float 4 0.0 65536.0 12288.0 1.0))
        (-> self node-list data 0 bone transform)
        )
      (spawn-from-mat (-> self part) (-> gp-0 mat))
      )
    )
  (none)
  )

(defmethod deactivate ((this flaming-arrow))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (if (nonzero? (-> this flame-sound))
      ((method-of-object (-> this flame-sound) ambient-sound-method-16))
      )
  ((method-of-type process-drawable deactivate) this)
  (none)
  )

;; WARN: Return type mismatch process-drawable vs flaming-arrow.
(defmethod relocate ((this flaming-arrow) (offset int))
  (if (nonzero? (-> this flame-sound))
      (&+! (-> this flame-sound) offset)
      )
  (the-as flaming-arrow ((method-of-type process-drawable relocate) this offset))
  )

(defstate idle (flaming-arrow)
  :virtual #t
  :enter (behavior ()
    (ja-post)

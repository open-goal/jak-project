;;-*-Lisp-*-
(in-package goal)

;; name: sewer-effects.gc
;; name in dgo: sewer-effects
;; dgos: HAVSEWW, HAVTOURW, HSX, SEWERW, SWX

;; DECOMP BEGINS

(deftype sewer-states (structure)
  ((rot  float)
   )
  )


(defbehavior update-mood-sewer time-of-day-proc ((arg0 mood-context) (arg1 float) (arg2 int))
  (update-mood-interior arg0 #f)
  (cond
    ((< (the-as uint 8) (the-as uint (-> *time-of-day-context* mode)))
     (palette-select-special arg0)
     )
    (else
      (let ((s5-0 (the-as (pointer number) (-> arg0 state))))
        (set! (-> arg0 times 0 w) 1.0)
        (set! (-> arg0 times 1 w) 1.0)
        (update-mood-caustics arg0 2 (-> (the-as (pointer float) s5-0) 0) 0.0 0.66 0.4)
        (update-mood-caustics arg0 3 (-> (the-as (pointer float) s5-0) 0) 21845.334 0.66 0.4)
        (update-mood-caustics arg0 4 (-> (the-as (pointer float) s5-0) 0) 43690.668 0.66 0.4)
        )
      (let* ((v1-6 (-> *display* part-clock frame-counter))
             (f0-6 (* 0.2 (the float (mod v1-6 300))))
             )
        (set! (-> arg0 times 5 w) (+ 0.95 (* 0.45 (sin (* 182.04445 (* 18.0 (+ 54.0 f0-6)))))))
        )
      (set! (-> arg0 times 6 w) 0.0)
      (set! (-> arg0 times 7 w) 0.0)
      )
    )
  0
  (none)
  )

(deftype sewerx-states (structure)
  ()
  )


(defbehavior update-mood-sewerx time-of-day-proc ((arg0 mood-context) (arg1 float) (arg2 int))
  (update-mood-interior arg0 #f)
  (cond
    ((< (the-as uint 8) (the-as uint (-> *time-of-day-context* mode)))
     (palette-select-special arg0)
     )
    (else
      (-> arg0 state)
      (set! (-> arg0 times 0 w) 1.0)
      (set! (-> arg0 times 1 w) 1.0)
      (let* ((v1-7 (-> *display* part-clock frame-counter))
             (f0-3 (* 0.2 (the float (mod v1-7 300))))
             )
        (set! (-> arg0 times 5 w) (+ 0.95 (* 0.45 (sin (* 182.04445 (* 18.0 (+ 54.0 f0-3)))))))
        )
      )
    )
  0
  (none)
  )


       (set! (-> this has-hit-ground) #f)
       )
      ((not (-> this has-hit-ground))
       (set! (-> this has-hit-ground) (the-as basic #t))
       (let ((v1-18 (make-sound-instance (-> *sound-info* 577) 0 (the-as handle #f))))
         (cond
           (v1-18
             (set! (-> v1-18 volume) (the int (* 1024.0 f30-0)))
             (logior! (-> v1-18 flags) 64)
             (-> v1-18 id)
             )
           (else
             0
             )
           )
         )
       )
      (else
        (let ((v1-22 (make-sound-instance (-> *sound-info* 578) 0 (the-as handle #f))))
          (cond
            (v1-22
              (set! (-> v1-22 volume) (the int (* 1024.0 f30-0)))
              (logior! (-> v1-22 flags) 64)
              (-> v1-22 id)
              )
            (else
              0
              )
            )

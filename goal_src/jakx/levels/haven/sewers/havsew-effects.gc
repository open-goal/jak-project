;;-*-Lisp-*-
(in-package goal)

;; name: havsew-effects.gc
;; name in dgo: havsew-effects
;; dgos: HAVSEWW, HSX

;; DECOMP BEGINS

(deftype havsewx-states (structure)
  ()
  )


(defbehavior update-mood-havsewx time-of-day-proc ((arg0 mood-context) (arg1 float) (arg2 int))
  (update-mood-interior arg0 #f)
  (cond
    ((< (the-as uint 8) (the-as uint (-> *time-of-day-context* mode)))
     (palette-select-special arg0)
     )
    (else
      (-> arg0 state)
      (set! (-> arg0 times 0 w) 1.0)
      (set! (-> arg0 times 1 w) 1.0)
      (let* ((v1-7 (-> *display* part-clock frame-counter))
             (f0-3 (* 0.2 (the float (mod v1-7 300))))
             )
        (set! (-> arg0 times 5 w) (+ 0.95 (* 0.45 (sin (* 182.04445 (* 6.0 f0-3))))))
        )
      )
    )
  0
  (none)
  )

(define *havsewx-water-texture-anim-array*
  (new 'static 'texture-anim-array :type texture-anim
    (new 'static 'texture-anim
      :num-layers #x3

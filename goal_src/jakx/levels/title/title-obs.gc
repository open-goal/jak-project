;; WARN: Return type mismatch pointer vs none.
(defun draw-language-select ((arg0 title-control))
  (with-dma-buffer-add-bucket ((s5-0 (-> *display* frames (-> *display* on-screen) global-buf))
                               (bucket-id bucket795)
                               )
    (let ((v1-6 (-> *viewport-array* default))
          (s4-0 *font-context*)
          )
      (dma-buffer-add-gs-set s5-0
                             (test-1 (new 'static 'gs-test :ate #x1 :afail #x3 :zte #x1 :ztst (gs-ztest always)))
                             (frame-1 (-> v1-6 frame))
                             (zbuf-1 (-> v1-6 zbuf-on))
                             (scissor-1 (-> v1-6 scissor))
                             )
      (set-width! s4-0 384)
      (set-scale! s4-0 0.4)
      (set! (-> s4-0 flags) (font-flags kerning middle middle-vert large ff12))
      (let ((a0-7 s4-0))
        (set! (-> a0-7 effect) (the-as uint 0))
        )
      (let ((a0-8 s4-0))
        (set! (-> a0-8 color) (font-color white))
        )
      (let ((t1-0 #x60604020))
        (draw-sprite2d-xy s5-0 64 163 384 90 (the-as rgba t1-0) #x3fffff)
        )
      (set-origin! s4-0 64 163)
      (set-height! s4-0 30)
      (print-game-text
        (lookup-text! *common-text* (text-id text-id-11) #f)
        *font-context*
        #f
        44
        (bucket-id bucket787)
        #f
        s5-0
        )
      (set-origin! s4-0 64 193)
      (set-height! s4-0 30)
      (print-game-text
        (lookup-text!
          *common-text*
          (cond
            ((zero? arg0)
             (text-id text-id-521)
             )
            ((= arg0 1)
             (text-id text-id-19)
             )
            ((= arg0 2)
             (text-id text-id-20)
             )
            ((= arg0 3)
             (text-id text-id-21)
             )
            ((= arg0 4)
             (text-id text-id-22)
             )
            ((= arg0 5)
             (text-id text-id-4269)
             )
            ((= arg0 6)
             (text-id text-id-4270)
             )
            (else
              (text-id text-id-18)
              )
            )
          #f
          )
        *font-context*
        #f
        44
        (bucket-id bucket787)
        #f
        s5-0
        )
      (set-origin! s4-0 0 223)
      (set-height! s4-0 30)
      (print-game-text
        (lookup-text! *common-text* (text-id text-id-1925) #f)
        *font-context*
        #f
        44
        (bucket-id bucket787)
        #f
        s5-0
        )
      (set-origin! s4-0 128 223)
      (set! (-> s4-0 height) (the float 30))
      )
    (print-game-text
      (lookup-text! *common-text* (text-id text-id-1934) #f)
      *font-context*
      #f
      44
      (bucket-id bucket787)
      #f
      s5-0
      )
    )
  (none)
  )

;; WARN: Found some very strange gotos. Check result carefully, this is not well tested.
;; WARN: new jak 2 until loop case, check carefully
(defun check-language ()
  (label cfg-0)
  (let ((gp-0 (new 'stack-no-clear 'mc-slot-info)))
    (mc-get-slot-info 0 gp-0)
    (when (zero? (-> gp-0 known))
      (set-blackout-frames (seconds 0.05))
      (suspend)
      (goto cfg-0)
      )
    (set! (-> *setting-control* user-default bg-a) 0.0)
    (when (and (= (scf-get-territory) 1) (zero? (scf-get-language)))
      (cond
        ((or (zero? (-> gp-0 handle)) (zero? (-> gp-0 formatted)) (zero? (-> gp-0 inited)) (< (-> gp-0 last-file) 0))
         (set-blackout-frames 0)
         (let ((s5-2 0)
               (gp-1 11)
               )
           (until #f
             (when (cpad-pressed? 0 left)
               (+! s5-2 -1)
               (if (< s5-2 0)
                   (set! s5-2 6)
                   )
               )
             (when (cpad-pressed? 0 right)
               (+! s5-2 1)
               (if (< 6 s5-2)
                   (set! s5-2 0)
                   )
               )
             (if (cpad-pressed? 0 x)
                 (goto cfg-25)
                 )
             (draw-language-select (the-as title-control s5-2))
             (suspend)
             )
           #f
           (label cfg-25)
           (cond
             ((zero? s5-2)
              (set! gp-1 0)
              )
             ((= s5-2 1)
              (set! gp-1 1)
              )
             ((= s5-2 2)
              (set! gp-1 2)
              )
             ((= s5-2 3)
              (set! gp-1 3)
              )
             ((= s5-2 4)
              (set! gp-1 4)
              )
             ((= s5-2 5)
              (set! gp-1 8)
              )
             ((= s5-2 6)
              (set! gp-1 9)
              )
             )
           (set! (-> *setting-control* user-default language) (the-as language-enum gp-1))
           (set! (-> *setting-control* user-default subtitle-language) (the-as uint gp-1))
           (if (< (the-as uint gp-1) (the-as uint 5))
               (set! (-> *setting-control* user-default audio-language) (the-as uint gp-1))
               )
           )
         )
        (else
          (let ((v1-58 (-> gp-0 file (-> gp-0 last-file) language)))
            (when (and (>= v1-58 0) (< v1-58 (the-as uint 11)))
              (set! (-> *setting-control* user-default language) (the-as language-enum v1-58))
              (set! (-> *setting-control* user-default subtitle-language) v1-58)
              (if (< v1-58 (the-as uint 5))
                  (set! (-> *setting-control* user-default audio-language) v1-58)
                  )
              )
            )
          )
        )
      )
    )
  (none)
  )

(defstate target-title (target)
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('change-mode)
       (case (-> block param 0)
         (('grab)
          (if (not (-> block param 1))
              #t
              (go target-float)
              )
          )
         )
       )
      (else
        (target-generic-event-handler proc argc message block)
        )
      )
    )
  :enter (behavior ((arg0 symbol))
    (let ((a0-1 (-> *hud-engine* alive-list next0)))
      *hud-engine*
      (let ((s5-0 (-> a0-1 next0)))
        (while (!= a0-1 (-> *hud-engine* alive-list-end))
          (deactivate ((method-of-type connection get-process) (the-as connection a0-1)))
          (set! a0-1 s5-0)
          *hud-engine*
          (set! s5-0 (-> s5-0 next0))
          )
        )
      )
    (when arg0
      (let ((v1-13 (-> self mask))
            (a0-4 (-> *game-info* mode))
            )
        (set! (-> *game-info* mode) 'movie)
        (logior! (-> self mask) (process-mask no-kill))
        (set! (-> self mask) v1-13)
        (set! (-> *game-info* mode) a0-4)
        )
      (send-event (ppointer->process (-> *setting-control* user-current movie)) 'abort)
      )
    (lobby-start)
    )
  :exit (behavior ()
    '()
    )
  :code (the-as (function symbol object) sleep-code)
  :post post-memcard
  )

(defstate target-intro (target)
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (target-generic-event-handler proc argc message block)
    )
  :enter (behavior ()
    (let ((a0-0 (-> *hud-engine* alive-list next0)))
      *hud-engine*
      (let ((gp-0 (-> a0-0 next0)))
        (while (!= a0-0 (-> *hud-engine* alive-list-end))
          (deactivate ((method-of-type connection get-process) (the-as connection a0-0)))
          (set! a0-0 gp-0)
          *hud-engine*
          (set! gp-0 (-> gp-0 next0))
          )
        )
      )
    )
  :exit (behavior ()
    '()
    )
  :code (behavior ()
    (check-language)
    (until #f
      (let ((v1-0 (new 'stack-no-clear 'vector)))
        (when (dma-try-alloc #xd2800 #xd2800 'title-control 0 (the-as int (-> v1-0 data)) (the-as int (&-> v1-0 y)) #f)
          (suspend)
          (suspend)
          (goto cfg-5)
          )
        )
      (suspend)
      0
      )
    #f
    (label cfg-5)
    (suspend)
    (suspend)
    (title-control-spawn 'thx-dolby)
    (while (search-process-tree *active-pool* (lambda ((arg0 process-tree)) (= (-> arg0 type) title-control)))
      (suspend)
      )
    (dma-release 'title-control)
    (fmv-player-run "thx" *target-pool* #f)
    (while *fmv-player*
      (suspend)
      )
    (fmv-player-run "intro" *target-pool* #f)
    (while *fmv-player*
      (mc-get-slot-info 0 *progress-save-info*)
      (suspend)
      )
    (cond
      ((kiosk?)
       (cond
         ((= *game-mode* 'adventure)
          (set! *game-mode* #f)
          (let ((t9-9 auto-save-command)
                (a0-8 'restore)
                (a1-5 0)
                (a2-3 *profile-slot*)
                (t0-1 #f)
                )
            (t9-9 a0-8 a1-5 a2-3 self t0-1)
            )
          )
         ((= *game-mode* 'online)
          (set! *game-mode* #f)
          (let ((t9-10 auto-save-command)
                (a0-10 'restore)
                (a1-6 0)
                (a2-4 *profile-slot*)
                (t0-2 #f)
                )
            (t9-10 a0-10 a1-6 a2-4 self t0-2)
            )
          )
         (else
           (let ((v1-16 (game-info-method-18 *game-info* "menu2-start-button")))
             (send-event self 'continue v1-16)
             )
           )
         )
       )
      (else
        (let ((v1-19 (game-info-method-18 *game-info* "menu2-start")))
          (send-event self 'continue v1-19)
          )
        )
      )
    (until #f
      (suspend)
      )
    #f
    )
  :post target-no-move-post
  )

(defstate target-introb (target)
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))

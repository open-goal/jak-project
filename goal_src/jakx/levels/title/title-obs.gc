  )

(define *end-credits-proc* (the-as (pointer handle) L226))

(set! (-> *end-credits-proc* 0) (the-as handle #f))

(defun end-end-credits ()
  (send-event (handle->process (-> *end-credits-proc* 0)) 'go-die)
  0
  (none)
  )

(defun start-end-credits ()
  (send-event *lobby-menu-manager* 'start-credits)
  0
  (none)
  )

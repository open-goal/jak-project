(defstate scrap-book (title-control)
  :virtual #t
  :event (-> (method-of-type title-control startup) event)
  :enter (-> (method-of-type title-control startup) enter)
  :exit (-> (method-of-type title-control startup) exit)
  :code (behavior ((arg0 int))
    (set-blackout-frames (seconds 1000))
    (let ((gp-1 (cond
                  ((= arg0 3)
                   *scrap-book-3*
                   )
                  ((= arg0 2)
                   *scrap-book-2*
                   )
                  (else
                    *scrap-book-1*
                    )
                  )
                )
          (s3-0 0)
          )
      0
      (let ((s5-0 (length gp-1))
            (s4-0 s3-0)
            )
        (+ s3-0 1)
        (let ((v1-5 #f))
          (while (not (or (>= s4-0 s5-0) (= v1-5 'abort)))
            (title-screen-change "scrap-book" (-> gp-1 s4-0) "scrap-book" -1 #t #f)
            (set! v1-5 (direction-press (seconds 1) (seconds 5) #t))
            (case v1-5
              (('back)
               (set! s4-0 (max 0 (+ s4-0 -1)))
               )
              (else
                (+! s4-0 1)
                )
              )
            (+ s4-0 1)
            )
          )
        )
      )
    (title-screen-change (the-as string #f) -1 (the-as string #f) -1 #f #f)
    (set-blackout-frames (seconds 0.2))
    (set! (-> *game-info* demo-state) (the-as uint 1))
    )
  :post (-> (method-of-type title-control startup) post)
  )

(defstate control-spec (title-control)
  :virtual #t
  :event (-> (method-of-type title-control startup) event)
  :enter (-> (method-of-type title-control startup) enter)
  :exit (-> (method-of-type title-control startup) exit)
  :code (behavior ((arg0 int))
    (let ((gp-0 (the-as int (-> *setting-control* user-current language))))
      0
      (if (and (= (the-as language-enum gp-0) (language-enum english)) (= (scf-get-territory) 1))
          (set! gp-0 11)
          )
      (let ((gp-1 (* (cond
                       ((zero? gp-0)
                        0
                        )
                       ((= gp-0 1)
                        1
                        )
                       ((= gp-0 2)
                        2
                        )
                       ((= gp-0 3)
                        3
                        )
                       ((= gp-0 4)
                        4
                        )
                       ((= gp-0 11)
                        5
                        )
                       (else
                         0
                         )
                       )
                     2
                     )
                  )
            )
        (if (= (get-aspect-ratio) 'aspect16x9)
            (+! gp-1 1)
            )
        (title-screen-change "demo-screen" gp-1 (the-as string #f) -1 #t #f)
        )
      )
    (suspend-for (seconds 0.6)
      )
    (setting-control-method-14 *setting-control* 'title-control-scene #x11e1a300 'render #f 0.0 0)
    )
  :post (-> (method-of-type title-control startup) post)
  )


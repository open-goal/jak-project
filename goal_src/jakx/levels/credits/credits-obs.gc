(deftype hirez-viewer (process-drawable)
  ((char     credits-char)
   (id       sound-id)
   (credits  symbol)
   )
  (:state-methods
    idle
    )
  )


(defstate idle (hirez-viewer)
  :virtual #t
  :trans (behavior ()
    (logclear! (-> self draw status) (draw-control-status no-draw-temp uninited))
    )
  :code (behavior ()
    (cond
      ((nonzero? (-> self skel))
       (until #f
         (ja-channel-set! 1)
         (let ((gp-0 (+ (-> (the-as art-joint-anim (-> self draw art-group data (-> self char anim))) frames num-frames) -1))
               )
           (ja-no-eval :group! (-> self draw art-group data (-> self char anim)) :num! (seek!) :frame-num 0.0)
           (until (ja-done? 0)
             (ja-post)
             (let ((f30-0 (ja-frame-num 0)))
               (ja-rate 0)
               (if (< (the float (+ gp-0 -15)) f30-0)
                   (send-event (ppointer->process (-> self parent)) 'anim-ending)
                   )
               )
             (suspend)
             (ja :num! (seek!))
             )
           )
         )
       #f
       )
      (else
        (until #f
          (format *stdcon* "no skel~%")
          (suspend)
          )
        #f
        )
      )
    )
  )

(defbehavior hirez-viewer-init-by-other hirez-viewer ((arg0 credits-char) (arg1 symbol))
  (set! (-> self credits) arg1)
  (set! (-> self char) arg0)
  (set! (-> self root) (new 'process 'trsqv))
  (set-vector! (-> self root scale) 1.0 1.0 1.0 1.0)
  (quaternion-copy! (the-as quaternion (-> self root rot)) *unity-quaternion*)
  (set! (-> self root trans quad) (the-as uint128 0))
  (set! (-> self level) (level-get *level* 'jakcred))
  (let ((gp-1 (art-group-get-by-name *level* (-> arg0 skel) (&-> self level))))
    (when gp-1
      (when (art-group-get-by-name *level* (the-as string (-> gp-1 data 0)) (&-> self level))
        (process-drawable-method-42 self gp-1 0)
        (logior! (-> self skel status) (joint-control-status blend-shape eye-anim))
        )
      )
    )
  (logclear! (-> self draw status) (draw-control-status no-draw))
  (set! (-> self draw light-index) (the-as uint 10))
  (ja-post)
  (go-virtual idle)
  )

;; WARN: Return type mismatch int vs handle.
(defun spawn-hirez-viewer ((arg0 credits-char) (arg1 symbol) (arg2 process-tree))
  (the-as
    handle
    (ppointer->handle (process-spawn hirez-viewer arg0 arg1 :name "hirez-viewer" :to arg2 :stack-size #x20000))
    )
  )

(defun draw-end-credits ((arg0 level) (arg1 float))
  (* 1.4 arg1)
  0
  (let ((s5-0 (new
                'stack
                'font-context
                *font-default-matrix*
                20
                0
                8396850.0
                (font-color font-color-51)
                (font-flags shadow kerning)
                )
              )
        )
    0.0
    0
    (let ((f0-4 (* 0.15 arg1)))
      (if (and (< 2600.0 f0-4) (cpad-pressed? 0 triangle circle x))
          (return #t)
          )
      (let ((v1-12 s5-0))
        (set! (-> v1-12 width) 275.0)
        )
      (set-height! s5-0 416)
      (set-scale! s5-0 0.55)
      (set! (-> s5-0 flags) (font-flags kerning middle large ff12))
      (let ((s4-1 (- 416 (the int f0-4))))
        (dotimes (s3-0 (length *credits-ids*))
          (let ((s2-0 (lookup-text arg0 (-> *credits-ids* s3-0) #f)))
            (set! (-> s5-0 origin y) (the float s4-1))
            (let* ((f0-8 (print-game-text s2-0 s5-0 #t 44 (bucket-id bucket787) #f (the-as dma-buffer #f)))
                   (f30-0 (+ 3.0 f0-8))
                   )
              (if (and (< s4-1 416) (> (+ s4-1 (the int f30-0)) 0))
                  (print-game-text s2-0 s5-0 #f 44 (bucket-id bucket787) #f (the-as dma-buffer #f))
                  )
              (if (and (= s3-0 (+ (length *credits-ids*) -1)) (< s4-1 -10))
                  (return #t)
                  )
              (+! s4-1 (the int f30-0))
              )
            )
          )
        )
      )
    )
  #f
  )

(deftype end-credits-proc (process)
  ((char-viewer  handle)
   )
  (:state-methods
    running
    die
    )
  )


(deftype end-credits-character-viewer (process)
  ((hirez-viewer      handle)
   (vehicle           handle)
   (turntable-handle  handle)
   (last-up-time      int32)
   (finish            basic)
   (anim-ending       basic)
   (current-char      credits-char)
   )
  (:state-methods
    running
    die
    )
  )


(defbehavior end-credits-character-viewer-init-by-other end-credits-character-viewer ()
  (stack-size-set! (-> self main-thread) 512)
  (set! (-> self mask) (process-mask menu))
  (set! (-> self hirez-viewer) (the-as handle #f))
  (set! (-> self finish) #f)
  (set! (-> self anim-ending) #f)
  (go-virtual running)
  )

(defstate running (end-credits-proc)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('go-die)
       (go-virtual die)
       )
      )
    )
  :code (behavior ()
    (local-vars (a0-2 symbol))
    (lobby-level-set! 1 'credits 'special)
    (until a0-2
      (suspend)
      (let ((v1-1 (level-get *level* 'credits)))
        (set! a0-2 (and v1-1 (= (-> v1-1 status) (the-as symbol 'active))))
        )
      )
    (set! (-> self char-viewer)
          (process->handle
            (ppointer->process (process-spawn end-credits-character-viewer :name "end-credits-character-viewer" :to self))
            )
          )
    (let ((gp-1 (current-time))
          (s5-0 (level-get *level* 'credits))
          )
      (until #f
        (suspend)
        (if (draw-end-credits s5-0 (the float (- (current-time) gp-1)))
            (goto cfg-19)
            )
        )
      )
    #f
    (label cfg-19)
    (suspend)
    (send-event (handle->process (-> self char-viewer)) 'finish)
    (while (handle->process (-> self char-viewer))
      (suspend)
      )
    (suspend)
    (suspend)
    (go-virtual die)
    )
  )

(defbehavior update-stuff end-credits-character-viewer ()
  (let ((v1-1 (handle->process (-> self hirez-viewer)))
        (gp-0 (handle->process (-> self turntable-handle)))
        )
    (when (and v1-1 gp-0)
      (set! (-> v1-1 root trans quad) (-> gp-0 root trans quad))
      (quaternion-copy! (the-as quaternion (-> v1-1 root rot)) (the-as quaternion (-> gp-0 root rot)))
      (let ((f0-1 (the float (- (current-time) (the-as time-frame (-> self last-up-time)))))
            (s5-0 (new 'stack-no-clear 'quaternion))
            )
        (let* ((f0-3 (* 2.5 f0-1 (-> self current-char rotvel)))
               (f0-5 (+ -20000.0 f0-3 (* 182.04445 (-> self current-char rotoff))))
               )
          (quaternion-axis-angle! (the-as quaternion (&-> s5-0 x)) 0.0 1.0 0.0 f0-5)
          )
        (quaternion-copy! (the-as quaternion (-> gp-0 root rot)) (the-as quaternion (&-> s5-0 x)))
        )
      )
    )
  0
  )

(defstate running (end-credits-character-viewer)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (local-vars (v0-0 object))
    (case message
      (('anim-ending)
       (set! v0-0 #t)
       (set! (-> self anim-ending) (the-as basic v0-0))
       v0-0
       )
      (('go-die)
       (go-virtual die)
       )
      (('finish)
       (set! v0-0 #t)
       (set! (-> self finish) (the-as basic v0-0))
       v0-0
       )
      )
    )
  :code (behavior ()
    (local-vars
      (a0-14 process)
      (a0-67 process)
      (a0-80 process)
      (a1-3 event-message-block)
      (a1-29 event-message-block)
      (a1-32 event-message-block)
      (s3-1 int)
      (t9-3 (function process-tree event-message-block object))
      (t9-28 (function process-tree event-message-block object))
      (t9-32 (function process-tree event-message-block object))
      )
    (set! (-> self turntable-handle)
          (process->handle
            (search-process-tree *active-pool* (lambda ((arg0 process)) (= (-> arg0 type) garage-turntable)))
            )
          )
    (until #f
      (suspend)
      (send-event (handle->process (-> self turntable-handle)) 'go-down)
      (send-event (handle->process (-> self turntable-handle)) 'no-pad #t)
      (until (t9-3 a0-14 a1-3)
        (suspend)
        (set! a1-3 (new 'stack-no-clear 'event-message-block))
        (set! (-> a1-3 from) (process->ppointer self))
        (set! (-> a1-3 num-params) 0)
        (set! (-> a1-3 message) 'down?)
        (set! t9-3 send-event-function)
        (set! a0-14 (handle->process (-> self turntable-handle)))
        )
      (kill-by-type-inherited vehicle *active-pool*)
      (dotimes (gp-0 6)
        (load-state-method-23 *load-state* gp-0 #f #f)
        )
      (copy-string<-string (the-as string (-> *lobby-menu-manager* cam-string)) "camera-71")
      (let* ((gp-1 (-> *credits-chars* length))
             (s5-0 0)
             (s4-0 (-> *credits-chars* s5-0))
             )
        (while (< s5-0 gp-1)
          (if (-> self finish)
              (goto cfg-126)
              )
          (let ((a1-7 (new 'stack-no-clear 'array 'symbol 18)))
            (dotimes (v1-36 18)
              (set! (-> a1-7 v1-36) #f)
              )
            (set! (-> a1-7 0) 'menu2)
            (set! (-> a1-7 1) 'credits)
            (set! (-> a1-7 2) (-> s4-0 levname))
            (want-levels *load-state* a1-7)
            )
          (want-display-level *load-state* (-> s4-0 levname) 'display)
          (until #f
            (suspend)
            (let ((v1-47 (level-get *level* (-> s4-0 levname))))
              (when v1-47
                (if (= (-> v1-47 status) 'active)
                    (goto cfg-45)
                    )
                )
              )
            )
          #f
          (label cfg-45)
          (let ((s3-0 (the-as structure #f)))
            (let* ((v1-53 (-> *net-drivers* length))
                   (a0-29 0)
                   (a1-12 (-> *net-drivers* a0-29))
                   )
              (while (< a0-29 v1-53)
                (if (= (-> a1-12 dt) (-> s4-0 dt))
                    (set! s3-0 a1-12)
                    )
                (+! a0-29 1)

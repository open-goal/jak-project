                  )
                )
              )
            )
          #f
          (label cfg-62)
          (let ((s2-1 (new 'stack-no-clear 'vehicle-spawn-params)))
            (mem-clear! (&-> s2-1 behavior) 104)
            (set! (-> s2-1 behavior) (the-as uint 0))
            (set! (-> s2-1 nav-mesh) #f)

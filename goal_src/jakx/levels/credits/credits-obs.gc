                          )
                    (set! s3-1 (the-as int (-> s0-0 car-type)))
                    (convert-load-parts-to-car-info (the-as uint *default-vehicle-load-parts*) s0-0)
                    )
                  )
                )
              (load-state-method-23 *load-state* 5 (the-as symbol s2-0) #f)
              (until #f
                (suspend)
                (let ((v1-71 (level-get *level* (the-as symbol s2-0))))
                  (when v1-71
                    (if (= (-> v1-71 status) 'active)

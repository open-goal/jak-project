    idle
    )
  (:methods
    (garage-car-arm-method-51 (_type_) none)
    )
  )


(defskelgroup skel-garage-car-arm garage-car-arm garage-car-arm-lod0-jg garage-car-arm-idle-ja
              ((garage-car-arm-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 -6.5 0 8.5)
              )

;; WARN: Return type mismatch uint128 vs none.
(defun set-mult ((arg0 process-drawable))
  (let ((v0-0 (-> (new 'static 'vector :data (new 'static 'array float 4 0.4 0.4 0.4 1.0)) quad)))
    (set! (-> arg0 draw color-mult quad) v0-0)
    )
  (none)
  )

(defstate idle (garage-car-arm)
  :virtual #t
  :enter (behavior ()
    (let ((v0-0 (-> (new 'static 'vector :data (new 'static 'array float 4 0.4 0.4 0.4 1.0)) quad)))
      (set! (-> self draw color-mult quad) v0-0)
      )
    )
  :trans (behavior ()
    (garage-car-arm-method-51 self)
    )
  :code (behavior ()
    (ja :group! (ja-group) :num! min)
    (sleep-code)
    )
  :post ja-post
  )

(defmethod garage-car-arm-method-51 ((this garage-car-arm))
  (quaternion-identity! (-> this arm-rot rotation))
  (let* ((f0-2 (sin (* 100.0 (the float (current-time)))))
         (f0-3 (lerp-scale -2.0 2.0 f0-2 -1.0 1.0))
         )
    (quaternion-rotate-x! (-> this arm-rot rotation) (-> this arm-rot rotation) (* 182.04445 f0-3))
    )
  0
  (none)
  )

(defmethod init-from-entity! ((this garage-car-arm) (arg0 entity-actor))
  (set! (-> this root) (new 'process 'trsqv))
  (process-drawable-from-entity! this arg0)
  (process-drawable-method-42
    this
    (art-group-get-by-name *level* "skel-garage-car-arm" (the-as (pointer level) #f))
    0
    )
  (+! (-> this root trans y) 8192.0)
  (quaternion-rotate-local-y!
    (the-as quaternion (-> this root rot))
    (the-as quaternion (-> this root rot))
    5461.3335
    )
  (init (-> this arm-rot) this (the-as uint 8) (joint-mod-base-flags attached))
  (go (method-of-object this idle))
  )

(deftype garage-sliding-door (process-drawable)
  ()
  (:state-methods
    idle
    )
  )


(defskelgroup skel-garage-sliding-door garage-sliding-door garage-sliding-door-lod0-jg garage-sliding-door-idle-ja
              ((garage-sliding-door-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 0 0 30)
              )

(defstate idle (garage-sliding-door)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (local-vars (v0-0 draw-control-status))
    (case message
      (('hide)
       (when (nonzero? (-> self draw))
         (set! v0-0 (logior (-> self draw status) (draw-control-status no-draw)))
         (set! (-> self draw status) v0-0)
         v0-0
         )
       )
      (('show)
       (when (nonzero? (-> self draw))
         (set! v0-0 (logclear (-> self draw status) (draw-control-status no-draw)))
         (set! (-> self draw status) v0-0)
         v0-0
         )
       )
      )
    )
  :code (behavior ()
    (until #f
      (ja-no-eval :group! (ja-group) :num! (seek!) :frame-num 0.0)
      (until (ja-done? 0)
        (suspend)
        (ja :num! (seek!))
        )
      )
    #f
    )
  :post ja-post
  )

(defmethod init-from-entity! ((this garage-sliding-door) (arg0 entity-actor))
  (set! (-> this root) (new 'process 'trsqv))
  (process-drawable-from-entity! this arg0)
  (process-drawable-method-42
    this
    (art-group-get-by-name *level* "skel-garage-sliding-door" (the-as (pointer level) #f))
    0
    )
  (if (nonzero? (-> this draw))
      (logior! (-> this draw status) (draw-control-status no-draw))
      )
  (go (method-of-object this idle))
  )

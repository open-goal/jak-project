            (set! (-> a1-1 scale-rand-hi) (* 2.0 (-> a1-1 scale-rand-lo)))
            (set! (-> a1-1 rot-speed) 1000.0)
            (let ((v1-21 (-> a1-1 fountain-rand-transv-lo)))
              (let ((a0-5 (-> self root transv))
                    (a3-0 (new 'static 'vector :data (new 'static 'array float 4 -81920.0 61440.0 -81920.0 1.0)))

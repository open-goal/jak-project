    (logior! (-> self focus-status) (focus-status disable inactive))
    (dotimes (gp-1 12)
      (let ((a0-15 (-> self vehicle-sections gp-1)))
        (set! (-> a0-15 damage) 1.0)
        (vehicle-section-method-11 a0-15 self)
        )
      )
    (rigid-body-object-method-73 self)
    (rigid-body-object-method-75 self)
    )
  :code sleep-code
  :post (behavior ()
    (rlet ((vf0 :class vf)
           (vf4 :class vf)
           (vf5 :class vf)

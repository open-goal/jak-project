      'string-camera-floor
      'abs
      (the-as vector (+ 12288.0 (-> self water-height)))
      0
      )
    (let ((v1-4 (-> self draw color-mult)))
      (let ((f0-3 (fmax 0.0 (- 1.0 (* 0.0033333334 (the float (- (current-time) (-> self state-time))))))))
        (set-vector! v1-4 f0-3 f0-3 f0-3 1.0)
        )
      (dotimes (a0-7 4)
        (let ((a1-7 (handle->process (-> self wheel a0-7 handle))))
          (if a1-7
              (set! (-> (the-as process-drawable a1-7) draw color-mult quad) (-> v1-4 quad))
              )
          )
        )
      )
    (vehicle-method-156 self)
    )
  )

(defstate race-waiting (wvehicle)
  :virtual #t
  :event vehicle-event-handler
  :enter (behavior ()
    (set-time! (-> self state-time))
    (wvehicle-method-260 self)
    (vehicle-method-172 self)
    (logior! (-> self v-flags) (vehicle-flag on-ground player-grabbed ignition))
    (wvehicle-method-267 self)
    )
  :code sleep-code
  :post (behavior ()
    (vector-reset! (-> self target-acceleration))
    (let ((v1-1 (-> self rbody)))
      (set! (-> v1-1 force quad) (the-as uint128 0))
      (set! (-> v1-1 torque quad) (the-as uint128 0))
      )
    0
    (rigid-body-control-method-17 (-> self rbody))
    (let ((f30-0 (seconds-per-frame)))
      (wvehicle-method-214 self f30-0)
      (wvehicle-method-215 self)
      (wvehicle-method-216 self f30-0)
      )
    (rigid-body-object-method-61 self)
    )
  )

(defstate race-racing (wvehicle)
  :virtual #t
  :event vehicle-event-handler
  :enter (behavior ()
    (set-time! (-> self state-time))
    (logior! (-> self v-flags) (vehicle-flag riding ai-driving ignition))
    (logclear! (-> self v-flags) (vehicle-flag player-grabbed player-driving))
    (set! (-> self controls throttle) 0.0)
    (set! (-> self controls brake) 0.0)
    (set! (-> self controls steering) 0.0)
    (set! (-> self control-hook)
          (the-as (function vehicle vehicle-controls) (method-of-object self wvehicle-method-234))
          )
    (vehicle-method-172 self)
    (wvehicle-method-267 self)
    )
  :exit (behavior ()
    '()
    )
  :code sleep-code
  :post (behavior ()
    (cond
      ((-> self nav)
       (wvehicle-method-237 self)
       )
      (else
        (wvehicle-method-267 self)
        (rigid-body-object-method-61 self)
        )
      )
    )
  )

(defstate race-finished (wvehicle)
  :virtual #t
  :event vehicle-event-handler
  :enter (behavior ()
    (set-time! (-> self state-time))
    (logior! (-> self v-flags) (vehicle-flag riding nav-spheres))
    (set! (-> self controls throttle) 0.0)
    (set! (-> self controls brake) 0.0)
    (set! (-> self controls steering) 0.0)
    )
  :trans #f
  :code sleep-code
  :post (behavior ()
    (wvehicle-method-240 self)
    )
  )

(defstate die (wvehicle)
  :virtual #t
  :code (behavior ()
    (if (nonzero? (-> self power-slide-hud))
        (send-event (handle->process (-> self power-slide-hud)) 'kill-hud-instant)
        )
    (if (nonzero? (-> self hang-time-hud))
        (send-event (handle->process (-> self hang-time-hud)) 'kill-hud-instant)
        )
    (process-drawable-method-44 self)
    )
  )

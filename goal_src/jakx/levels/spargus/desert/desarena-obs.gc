      (set! (-> v1-0 y) 150.0)
      (set! (-> v1-0 z) 10.0)
      (vector+float*!
        (-> this spring-vel)
        (-> this spring-vel)
        (-> this spring-pos)
        (* -1.0 (-> v1-0 x) (-> v1-0 y))
        )
      (vector-float*! (-> this spring-vel) (-> this spring-vel) (fmax 0.0 (+ 1.0 (* -1.0 (-> v1-0 z) (-> v1-0 x)))))
      (vector+float*! (-> this spring-pos) (-> this spring-pos) (-> this spring-vel) (-> v1-0 x))
      )
    (set! (-> this spring-pos y) 0.0)
    (.lvf vf1 (&-> (-> this spring-pos) quad))
    (.add.w.vf.x vf2 vf0 vf0)
    (.mul.vf vf1 vf1 vf1)
    (.mul.x.vf.x acc vf2 vf1)
    (.add.mul.y.vf.x acc vf2 vf1 acc)
    (.add.mul.z.vf.x vf1 vf2 vf1 acc)
    (.mov v1-2 vf1)
    (let ((f0-10 v1-2))
      (when (< 1.0 f0-10)
        (vector-float*! (-> this spring-pos) (-> this spring-pos) (/ 1.0 (sqrtf f0-10)))
        (vector-reset! (-> this spring-vel))
        )
      )
    (let ((s5-0 (new 'stack-no-clear 'desarena-obs-stackvar0)))
      (quaternion-conjugate! (the-as quaternion (-> s5-0 mat)) (the-as quaternion (-> this root rot)))
      (quaternion->matrix (the-as matrix (-> s5-0 mat uvec)) (the-as quaternion (-> s5-0 mat)))
      (set! (-> s5-0 vec3 x) 2730.6667)
      (set! (-> s5-0 vec3 z) (sin (/ (-> s5-0 vec3 x) 2)))
      (set! (-> s5-0 vec3 y) (cos (/ (-> s5-0 vec3 x) 2)))
      (vector-rotate90-around-y! (-> s5-0 vec2) (-> this spring-pos))
      (vector-float*! (-> s5-0 vec2) (-> s5-0 vec2) (* -1.0 (-> s5-0 vec3 z)))
      (vector-rotate*! (-> s5-0 vec2) (-> s5-0 vec2) (the-as matrix (-> s5-0 mat uvec)))
      (set! (-> s5-0 quat x) (-> s5-0 vec2 x))
      (set! (-> s5-0 quat y) (-> s5-0 vec2 y))
      (set! (-> s5-0 quat z) (-> s5-0 vec2 z))
      (let ((f0-25 1.0))
        (.lvf vf1 (&-> (-> s5-0 vec2) quad))
        (.add.w.vf.x vf2 vf0 vf0)
        (.mul.vf vf1 vf1 vf1)
        (.mul.x.vf.x acc vf2 vf1)
        (.add.mul.y.vf.x acc vf2 vf1 acc)
        (.add.mul.z.vf.x vf1 vf2 vf1 acc)
        (.mov v1-16 vf1)
        (set! (-> s5-0 quat w) (sqrtf (- f0-25 v1-16)))
        )
      (quaternion-copy! (the-as quaternion (&-> this stack 176)) (-> s5-0 quat))
      (vector-float*! (-> s5-0 vec2) (-> s5-0 vec2) 1.0)
      (set! (-> s5-0 quat x) (-> s5-0 vec2 x))
      (set! (-> s5-0 quat y) (-> s5-0 vec2 y))
      (set! (-> s5-0 quat z) (-> s5-0 vec2 z))
      (let ((f0-32 1.0))
        (.lvf vf1 (&-> (-> s5-0 vec2) quad))
        (.add.w.vf.x vf2 vf0 vf0)
        (.mul.vf vf1 vf1 vf1)
        (.mul.x.vf.x acc vf2 vf1)
        (.add.mul.y.vf.x acc vf2 vf1 acc)
        (.add.mul.z.vf.x vf1 vf2 vf1 acc)
        (.mov v1-21 vf1)
        (set! (-> s5-0 quat w) (sqrtf (- f0-32 v1-21)))

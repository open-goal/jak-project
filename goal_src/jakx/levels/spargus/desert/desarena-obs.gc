;;-*-Lisp-*-
(in-package goal)

;; name: desarena-obs.gc
;; name in dgo: desarena-obs
;; dgos: DSR, DSRX

;; DECOMP BEGINS

;; WARN: Return type mismatch object vs none.
(defun desarena-activate ()
  (send-event (ppointer->process *time-of-day*) 'change 'ratio 0.0)
  (send-event (ppointer->process *time-of-day*) 'change 'hour 7)
  (none)
  )

;; WARN: Return type mismatch object vs none.
(defun desarena-deactivate ()
  (send-event (ppointer->process *time-of-day*) 'change 'ratio 1.0)
  (none)
  )

(deftype palm-tree (process-drawable)
  ((root               collide-shape          :override)
   (attack-vel         vector                  :inline)
   (spring-pos         vector                  :inline)
   (spring-vel         vector                  :inline)
   (jmods              joint-mod-rotate-local  5 :inline)
   (last-impulse-time  int32)
   )
  (:state-methods
    idle
    vibrate
    )
  (:methods
    (palm-tree-method-52 (_type_) none)
    (palm-tree-method-53 (_type_) none)
    (palm-tree-method-54 (_type_ vector) none)
    (palm-tree-method-55 (_type_ matrix) none)
    )
  )


(defskelgroup skel-palm-tree-debris-a palm-tree-debris palm-tree-debris-a-lod0-jg -1
              ((palm-tree-debris-a-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 0 0 5)
              )

(defskelgroup skel-palm-tree-debris-b palm-tree-debris palm-tree-debris-b-lod0-jg -1
              ((palm-tree-debris-b-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 0 0 5)
              )

(defstate idle (palm-tree)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('attack)
       (let ((a1-1 (-> block param 1))
             (v1-1 (new 'stack-no-clear 'vector))
             )
         (vector-float*! (the-as vector (-> v1-1 data)) (the-as vector (+ a1-1 32)) 0.001)
         (palm-tree-method-54 self (the-as vector (-> v1-1 data)))
         )
       )
      (('impact-impulse)
       (let ((a1-5 (-> block param 0)))
         (palm-tree-method-55 self (the-as matrix a1-5))
         )
       )
      )
    )
  :enter (behavior ()
    '()
    )
  :trans (behavior ()
    (if (or (>= (vector-length (-> self spring-vel)) 1.0) (>= (vector-length (-> self spring-pos)) 1.0))
        (go-virtual vibrate)
        )
    )
  :code sleep-code
  :post ja-post
  )

(defstate vibrate (palm-tree)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('attack)
       (let ((a1-1 (-> block param 1))
             (v1-1 (new 'stack-no-clear 'vector))
             )
         (vector-float*! (the-as vector (-> v1-1 data)) (the-as vector (+ a1-1 32)) 0.001)
         (palm-tree-method-54 self (the-as vector (-> v1-1 data)))
         )
       )
      (('impact-impulse)
       (let ((a1-5 (-> block param 0)))
         (palm-tree-method-55 self (the-as matrix a1-5))
         )
       )
      )
    )
  :trans (behavior ()
    (if (and (>= 0.01 (vector-length (-> self spring-vel))) (>= 0.01 (vector-length (-> self spring-pos))))
        (go-virtual idle)
        )
    )
  :code sleep-code
  :post (behavior ()
    (palm-tree-method-52 self)
    )
  )

(defmethod init-from-entity! ((this palm-tree) (arg0 entity-actor))
  (stack-size-set! (-> this main-thread) 32)
  (logior! (-> this mask) (process-mask actor-pause))
  (palm-tree-method-53 this)
  (set! (-> this last-impulse-time) (the-as int (current-time)))
  (process-drawable-from-entity! this arg0)
  (update-transforms (-> this root))
  (go (method-of-object this idle))
  )

(defmethod palm-tree-method-53 ((this palm-tree))
  0
  (none)
  )

(defmethod palm-tree-method-55 ((this palm-tree) (arg0 matrix))
  (let ((v1-0 (new 'stack-no-clear 'vector)))
    (vector-float*! v1-0 (-> arg0 uvec) (/ (-> arg0 trans x) 10))
    (palm-tree-method-54 this v1-0)
    )
  (none)
  )

(defmethod palm-tree-method-54 ((this palm-tree) (arg0 vector))
  (set! (-> this last-impulse-time) (the-as int (current-time)))
  (set! (-> this attack-vel quad) (-> arg0 quad))
  (if (< 81920.0 (vector-length (-> this attack-vel)))
      (vector-normalize! (-> this attack-vel) 81920.0)
      )
  (vector+float*! (-> this spring-vel) (-> this spring-vel) (-> this attack-vel) 0.00024414062)
  0
  (none)
  )

(defmethod palm-tree-method-52 ((this palm-tree))

(defmethod palm-tree-method-54 ((this palm-tree-a) (arg0 vector))
  (when (and (< 8192.0 (vector-length arg0)) (< (+ (-> this last-impulse-time) 150) (current-time)))
    (let ((a1-2 (new 'stack 'debris-tuning (the-as uint 0))))
      (set-vector! (-> a1-2 fountain-rand-transv-lo) -40960.0 0.0 -40960.0 1.0)
      (set-vector! (-> a1-2 fountain-rand-transv-hi) 40960.0 40960.0 40960.0 1.0)
      (set! (-> a1-2 fountain-rand-transv-hi w) 16384.0)
      (set! (-> a1-2 gravity) -61440.0)
      (set! (-> a1-2 hit-y-reaction) 0.0)
      (set! (-> a1-2 duration) (the-as uint 510))
      (set! (-> a1-2 scale-rand-lo) 0.6)
      (set! (-> a1-2 scale-rand-hi) 1.5)
      (debris-spawn this a1-2 *palm-tree-a-debris-params* (the-as process-drawable #f))

;;-*-Lisp-*-
(in-package goal)

;; name: canyon-obs.gc
;; name in dgo: canyon-obs
;; dgos: CANYONW, CYX, SPATOURW

;; DECOMP BEGINS

(deftype can-leaves-floor (process-drawable)
  ((root                   collide-shape :override)
   (cam-leaves-floor-unk1  can-leaves-floor-unk-nested)
   (cam-leaves-floor-unk2  can-leaves-floor-unk-nested)
   )
  (:state-methods
    idle
    )
  )


(defstate idle (can-leaves-floor)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('touched)
       (let ((gp-0 (as-type proc vehicle)))
         (when gp-0
           (let ((f30-0 (vector-length (-> (the-as vehicle gp-0) root transv))))
             (format *stdebug* "speed = ~M~%" f30-0)
             (when (< 163840.0 f30-0)
               (set! (-> self cam-leaves-floor-unk1 f2) (lerp-scale 0.05 10.0 f30-0 81920.0 614400.0))
               (set! (-> self cam-leaves-floor-unk2 f2) (* 13.653334 (/ f30-0 (meters 0.5))))
               (let ((v1-9 (new 'stack-no-clear 'inline-array 'matrix 1)))
                 (matrix-copy! (-> v1-9 0) (-> (the-as vehicle gp-0) node-list data 0 bone transform))
                 (set! (-> v1-9 0 trans quad) (-> self root trans quad))
                 (spawn-from-mat (-> self part) (-> v1-9 0))
                 )
               )
             )
           )
         )
       )
      )
    )
  :code sleep-code
  )

;; WARN: Return type mismatch int vs object.
(defmethod init-from-entity! ((this can-leaves-floor) (arg0 entity-actor))
  (stack-size-set! (-> this main-thread) 16)
  (logior! (-> this mask) (process-mask actor-pause))
  (set! (-> this cam-leaves-floor-unk1)
        (the-as can-leaves-floor-unk-nested (-> *part-id-table* 1450 init-specs 2))
        )
  (set! (-> this cam-leaves-floor-unk2)
        (the-as can-leaves-floor-unk-nested (-> *part-id-table* 1450 init-specs 13))
        )
  (let ((s4-0 (new 'process 'collide-shape this (collide-list-enum usually-hit-by-player))))
    (let ((v1-14 (new 'process 'collide-shape-prim-sphere s4-0 (the-as uint 0))))
      (set! (-> v1-14 prim-core collide-as) (collide-spec obstacle))
      (set! (-> v1-14 prim-core collide-with) (collide-spec jak bot player-list))
      (set! (-> v1-14 prim-core action) (collide-action dont-push-away))
      (set-vector! (-> v1-14 local-sphere) 0.0 0.0 0.0 32768.0)
      (set! (-> s4-0 total-prims) (the-as uint 1))
      (set! (-> s4-0 root-prim) v1-14)
      )
    (set! (-> s4-0 nav-radius) (* 0.75 (-> s4-0 root-prim local-sphere w)))
    (let ((v1-17 (-> s4-0 root-prim)))
      (set! (-> s4-0 backup-collide-as) (-> v1-17 prim-core collide-as))
      (set! (-> s4-0 backup-collide-with) (-> v1-17 prim-core collide-with))
      )
    (set! (-> s4-0 event-self) 'touched)
    (set! (-> this root) s4-0)
    )
  (set! (-> this part) (create-launch-control (-> *part-group-id-table* 438) this))
  (process-drawable-from-entity! this arg0)
  (update-transforms (-> this root))
  (go (method-of-object this idle))
  0
  )

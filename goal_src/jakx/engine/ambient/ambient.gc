        (if (or (= v1-36 (gui-channel notice)) (= v1-36 (gui-channel notice-low)) (= v1-36 (gui-channel subtitle)))
            (the-as bucket-id (bucket-id bucket790))
            (the-as bucket-id (bucket-id bucket787))

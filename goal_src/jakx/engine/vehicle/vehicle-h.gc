   (right-gun           int8      :overlay-at (-> nodes 1))
   (mine-launcher       int8      :overlay-at (-> nodes 2))
   (trunk               int8      :overlay-at (-> nodes 3))
   (super-turbo-attach  int8    3 :overlay-at (-> nodes 4))
   (shield-anim         int16)
   )
  :pack-me
  )



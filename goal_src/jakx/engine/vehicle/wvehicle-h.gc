;; WARN: Return type mismatch float vs degrees.
(defun rpm->radians-per-sec ((arg0 float))
  (the-as degrees (* 0.10471976 arg0))
  )

(defun radians-per-sec->rpm ((arg0 degrees))
  (* 9.549297 arg0)
  )

(deftype vehicle-antenna-init-params (structure)
  ((pos      vector  :inline)
   (tilt     float)
   (vehicle  basic)
   (skel     basic)
   (level    basic)
   )
  )


(defskelgroup skel-vehicle-explosion vehicle-explosion vehicle-explosion-lod0-jg vehicle-explosion-idle-ja
              ((vehicle-explosion-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 0 0 50)
              :texture-level 18
              )

;; WARN: Return type mismatch object vs symbol.
(defun vehicle-shielded? ((arg0 wvehicle))
  (the-as
    symbol
    (or (logtest? (vehicle-flag ignore-damage) (-> arg0 v-flags)) (handle->process (-> arg0 wpn-shield)))
    )
  )

   (next-gaze-time     uint64)
   (last-gaze-time     uint64)
   (pitch-bend         float)
   (sweep-loop         uint32)
   (muzzle-flashes     uint64      4)
   (next-target-poll   uint64)
   (firecontrol        basic)
   (blam               uint32)
   )
  (:methods
    (vehicle-weapon-drone-method-59 () none)
    (vehicle-weapon-drone-method-60 () none)
    (vehicle-weapon-drone-method-61 () none)
    (vehicle-weapon-drone-method-62 () none)

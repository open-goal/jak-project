    (vehicle-weapon-drone-method-64 () none)
    (vehicle-weapon-drone-method-65 () none)
    (vehicle-weapon-drone-method-66 () none)
    )
  )


(deftype v-wpn-ptable-entry (structure)
  ((chance       uint16)
   (weapon-type  uint8)
   (pad1         uint8)
   )
  :pack-me
  )


(deftype v-wpn-ptable (structure)
  ((entries-count  int8)
   (total-chance   uint16)
   (entries-array  (inline-array v-wpn-ptable-entry))
   )
  )


(deftype v-wpn-ptable-quad (structure)
  ((base              v-wpn-ptable)
   (last-lap          v-wpn-ptable)
   (base-behind       v-wpn-ptable)
   (last-lap-behind   v-wpn-ptable)
   (behind-threshold  float)
   )
  )



(deftype vehicle-weapon-slot (process-drawable)
  ((owning-vehicle  handle)
   (ammunition      int8)
   (flags           uint8)
   (in-slot         uint8)
   (powerup-level   uint8)
   (my-type         uint8)
   )
  (:state-methods
    idle
    )
  (:methods
    (vehicle-weapon-slot-method-51 () none)
    (vehicle-weapon-slot-method-52 () none)
    (vehicle-weapon-slot-method-53 () none)
    (vehicle-weapon-slot-method-54 () none)
    (vehicle-weapon-slot-method-55 () none)
    (vehicle-weapon-slot-method-56 () none)
    (vehicle-weapon-slot-method-57 () none)
    (vehicle-weapon-slot-method-58 () none)
    (vehicle-weapon-slot-method-59 () none)
    )
  )

(deftype gunmount-drawable (process-drawable)
  ((mounted-on  uint64)
   (hardpoint   int8)
   )
  (:methods
    (gunmount-drawable-method-50 () none)
    (gunmount-drawable-method-51 () none)
    (gunmount-drawable-method-52 () none)
    (gunmount-drawable-method-53 () none)
    )
  )


(deftype gunmount-generic-drawable (gunmount-drawable)
  ((config           uint8)
   (flash            uint64)
   (changeover-anim  int32)
   (powerup-level    int8)
   )
  (:methods
    (gunmount-generic-drawable-method-54 () none)
    (gunmount-generic-drawable-method-55 () none)
    )
  )


(deftype warning-hud-icon (basic)
  ((hsprite  hud-sprite  :inline)
   )
  (:methods
    (new (symbol type) _type_)
    )
  )


(defmethod new warning-hud-icon ((allocation symbol) (type-to-make type))
  (let ((gp-0 (object-new allocation type-to-make (the-as int (-> type-to-make size)))))
    (set-vector! (-> gp-0 hsprite color) 255 16 16 255)
    (set! (-> gp-0 hsprite pos z) #xffffff0)
    (set! (-> gp-0 hsprite pos w) 0)
    (set! (-> gp-0 hsprite scale-x) 1.0)
    (set! (-> gp-0 hsprite scale-y) 1.0)
    (set! (-> gp-0 hsprite angle) 0.0)
    (set! (-> gp-0 hsprite flags) (hud-sprite-flags hsf3))
    (set! (-> gp-0 hsprite tex) (get-texture car-reticle-07 level-default-minimap))
    gp-0
    )
  )

(deftype rapid-fire-params (structure)
  ((rof                     uint16)
   (shot-radius             float)
   (shot-range              float)
   (beam-effect             uint16)
   (impact-callback         basic)
   (impact-callback-params  basic)
   (shot-sound              uint16)
   (hit-sound               uint16)
   (wpn-type                uint8)
   (wpn-powerup-level       int8)
   )
  )


(deftype rapid-fire-control (basic)
  ((owner           handle)
   (params          rapid-fire-params)
   (shot-clock      uint16)
   (next-shot-from  int8)
   (hit-spang-part  basic)
   (old-origin      vector      :inline)
   (old-rot         quaternion  :inline)
   (emitters        basic)
   )
  (:methods
    (rapid-fire-control-method-9 () none)
    (rapid-fire-control-method-10 () none)
    (rapid-fire-control-method-11 () none)
    (rapid-fire-control-method-12 () none)
    )
  )


(deftype rapid-fire-callback-gun-hitspang-params (structure)
  ((bits-part-id   uint32)
   (dust-part-id   uint32)
   (group-part-id  uint32)
   )
  )



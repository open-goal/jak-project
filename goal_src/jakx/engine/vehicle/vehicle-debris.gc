(defmethod rigid-body-object-method-88 ((this vehicle-debris))
  (local-vars (v1-8 float))
  (rlet ((acc :class vf)
         (vf0 :class vf)
         (vf1 :class vf)
         (vf2 :class vf)
         )
    (init-vf0-vector)
    (set! (-> this camera-dist) (find-nearest-camera-distance (-> this rbody position)))
    (if (< 901120.0 (-> this camera-dist))
        (go (method-of-object this die))
        )
    (.lvf vf1 (&-> (-> this rbody ang-velocity) quad))
    (.add.w.vf.x vf2 vf0 vf0)
    (.mul.vf vf1 vf1 vf1)
    (.mul.x.vf.x acc vf2 vf1)
    (.add.mul.y.vf.x acc vf2 vf1 acc)
    (.add.mul.z.vf.x vf1 vf2 vf1 acc)
    (.mov v1-8 vf1)
    (let ((f0-2 v1-8))
      (if (< (square 24.0) f0-2)
          (vector-float*! (-> this rbody ang-momentum) (-> this rbody ang-momentum) (/ 24.0 (sqrtf f0-2)))
          )
      )
    (rigid-body-object-method-70 this)
    (rigid-body-control-method-11 (-> this rbody) (the-as vector (-> this root)))
    (rigid-body-object-method-61 this)
    0
    (none)
    )
  )

(defmethod rigid-body-object-method-71 ((this vehicle-debris))
  0
  (none)
  )

(defstate explode (vehicle-debris)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('impact-impulse)
       (let ((a1-1 (-> block param 0)))
         (rigid-body-object-method-80 self (the-as rigid-body-impact a1-1))
         )
       )
      )
    )
  :enter (behavior ()
    (set-time! (-> self state-time))
    (logior! (-> self rbody flags) (rigid-body-flag enable-physics enable-penetrate-mode))
    (let ((v1-5 (-> self rbody)))
      (set! (-> v1-5 linear-damping) 0.005)
      (set! (-> v1-5 angular-damping) 0.01)
      (set! (-> v1-5 bounce-factor) 0.2)
      (set! (-> v1-5 friction-factor) 0.1)
      )
    )
  :trans #f
  :code sleep-code
  :post (behavior ()
    (rigid-body-object-method-71 self)
    (if (nonzero? (-> self part))
        (spawn-from-mat (-> self part) (-> self rbody matrix))
        )
    (if (time-elapsed? (-> self state-time) (seconds 4))
        (go-virtual fade-out)
        )
    )
  )

(defstate fade-out (vehicle-debris)
  :virtual #t
  :enter (behavior ()
    (set-time! (-> self state-time))
    (logior! (-> self draw status) (draw-control-status force-fade))
    )
  :code sleep-code
  :post (behavior ()
    (set! (-> self draw force-fade)
          (the-as
            uint
            (the int (fmax 0.0 (- 128.0 (* 0.42666668 (the float (- (current-time) (-> self state-time)))))))
            )
          )
    (if (< (-> self draw force-fade) (the-as uint 2))
        (go-virtual die)
        )
    (rigid-body-object-method-71 self)
    )
  )

(defstate die (vehicle-debris)
  :virtual #t
  :code (behavior ()
    (process-drawable-method-44 self)
    )
  )

;; WARN: Return type mismatch object vs none.
(defbehavior vehicle-debris-init-by-other vehicle-debris ((arg0 vehicle-debris-init-params))
  (logior! (-> self mask) (process-mask vehicle))
  (rigid-body-object-method-65 self arg0)
  (matrix->transformq (the-as transformq (-> self root trans)) (-> arg0 mat))
  (if (and (-> arg0 has-particles) (let* ((f30-0 0.5)
                                          (v1-9 (/ (the-as int (rand-uint31-gen *random-generator*)) 256))
                                          (v1-10 (the-as number (logior #x3f800000 v1-9)))
                                          )
                                     (< f30-0 (+ -1.0 (the-as float v1-10)))
                                     )
           )
      (set! (-> self part) (create-launch-control (-> *part-group-id-table* 43) self))
      )
  (set! (-> self level) (-> arg0 level))
  (process-drawable-method-42 self (-> arg0 skel) 0)
  (set! (-> self draw color-mult quad) (-> arg0 color quad))
  (set! (-> self draw lod-set lod 0 dist) 819200.0)
  (let ((f0-6 (fmax
                (fmax (vector-length (-> arg0 mat rvec)) (vector-length (-> arg0 mat uvec)))
                (vector-length (-> arg0 mat fvec))
                )
              )
        )
    (set! (-> self draw bounds w) (* (-> arg0 skel bounds w) f0-6))
    (set! (-> self draw longest-edge) (* (-> arg0 skel longest-edge) f0-6))
    )
  (set! (-> self impact-sound) (-> arg0 impact-sound))
  (rigid-body-object-method-64 self (-> arg0 info))
  (rigid-body-object-method-66 self)
  (rigid-body-queue-method-11 *rigid-body-queue* self)
  (let ((s5-0 (-> self rbody)))
    (rigid-body-control-method-31 s5-0 (-> arg0 velocity))
    (rigid-body-control-method-32 s5-0 (-> arg0 ang-velocity))
    )
  (go-virtual explode)
  (none)
  )

;; WARN: Return type mismatch process vs vehicle-debris.
(defun vehicle-debris-spawn ((arg0 process-tree) (arg1 vehicle-spawn-params))
  (let ((gp-0 (the-as process #f)))
    (let* ((s3-0 (get-process *default-dead-pool* vehicle-debris #x4000 1))
           (v1-1 (when s3-0
                   (let ((t9-1 (method-of-type process activate)))
                     (t9-1 s3-0 arg0 "vehicle-debris" (the-as pointer #x70004000))
                     )
                   (run-now-in-process s3-0 vehicle-debris-init-by-other arg1)
                   (-> s3-0 ppointer)
                   )
                 )
           )
      (if v1-1
          (set! gp-0 (-> v1-1 0))
          )
      )
    (the-as vehicle-debris gp-0)
    )
  )

;;-*-Lisp-*-
(in-package goal)

;; name: vehicle-debris.gc
;; name in dgo: vehicle-debris
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

(deftype vehicle-debris-init-params (structure)
  ((mat            matrix  :inline)
   (velocity       vector  :inline)
   (ang-velocity   vector  :inline)
   (color          rgbaf   :inline)
   (radius         float)
   (skel           skeleton-group)
   (info           rigid-body-object-constants)
   (level          level)
   (impact-sound   uint16)
   (has-particles  symbol)
   )
  )


(define *vehicle-debris-constants*
  (new 'static 'rigid-body-object-constants
    :info (new 'static 'rigid-body-info
      :max-time-step 0.033333335
      :mass 1.0
      :inv-mass 1.0
      :linear-damping 0.005
      :angular-damping 0.005
      :bounce-factor 0.5
      :friction-factor 0.5
      :bounce-mult-factor 1.22
      :cm-offset-joint (new 'static 'vector :data (new 'static 'array float 4 0.0 0.0 0.0 1.0))
      :inertial-tensor-box (new 'static 'array meters 3 (meters 2) (meters 3) (meters 3))
      :gravity 204800.0
      )
    :name '*vehicle-debris-constants*
    )
  )

(deftype vehicle-debris (rigid-body-object)
  ((impact-sound  uint16)
   (camera-dist   float)
   )
  (:state-methods
    explode
    fade-out
    die
    )
  (:methods
    (rigid-body-object-method-65 (_type_ vehicle-debris-init-params) none :replace)
    )
  )



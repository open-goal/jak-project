       (set! (-> s5-0 antenna-attach z) (* 0.5 (- (-> s5-0 antenna-attach y) (-> s5-0 antenna-attach x))))
       (let ((v1-47 (-> this root root-prim)))
         (dotimes (a0-38 (the-as int (-> v1-47 specific 0)))
           (let ((a1-14 (-> (the-as collide-shape-prim-group v1-47) child a0-38 local-sphere)))

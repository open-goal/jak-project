;; WARN: disable def twice: 36. This may happen when a cond (no else) is nested inside of another conditional, but it should be rare.
;; WARN: disable def twice: 49. This may happen when a cond (no else) is nested inside of another conditional, but it should be rare.
(defun char-allowed ((arg0 int) (arg1 uint))
  (if (or (< arg1 (the-as uint 32)) (< (the-as uint 127) arg1))
      (return #f)
      )
  (if (not (or (logtest? arg0 8) (logtest? arg0 16)))
      (return #t)
      )
  (if (= arg1 32)
      (return #t)
      )
  (cond
    ((logtest? arg0 32)
     (if (logtest? arg0 8)
         (or (and (>= arg1 (the-as uint 97)) (>= (the-as uint 122) arg1))
             (and (>= arg1 (the-as uint 65)) (>= (the-as uint 90) arg1))
             )
         (or (and (>= arg1 (the-as uint 97)) (>= (the-as uint 122) arg1))
             (and (>= arg1 (the-as uint 65)) (>= (the-as uint 90) arg1))
             (and (>= arg1 (the-as uint 48)) (>= (the-as uint 57) arg1))
             )
         )
     )
    (else
      (or (and (>= arg1 (the-as uint 97)) (>= (the-as uint 122) arg1))
          (and (>= arg1 (the-as uint 65)) (>= (the-as uint 90) arg1))
          (and (>= arg1 (the-as uint 48)) (>= (the-as uint 57) arg1))
          (or (= arg1 45) (= arg1 46) (= arg1 95))
          )
      )
    )
  )

(deftype keyboard-control (process-drawable)
  ((selected       int32)
   (pos-x          int32)
   (pos-y          int32)
   (up             basic)
   (down           basic)
   (left           basic)
   (right          basic)
   (up-count       int32)
   (down-count     int32)
   (left-count     int32)
   (right-count    int32)
   (layout-select  int32)
   (pad            uint32)
   (screen-pos-x   int32)
   (screen-pos-y   int32)
   (max-chars      int32)
   (flags          keyboard-control-flag)
   (alpha          float)
   (j-mod          joint-mod-set-world  :inline)
   )
  (:state-methods
    idle
    done
    cancel
    )
  (:methods
    (keyboard-control-method-53 (_type_) int)
    (keyboard-control-method-54 (_type_) int)
    )
  )


(defmethod keyboard-control-method-53 ((this keyboard-control))
  (when (and (logtest? (-> this flags) (keyboard-control-flag allow-space))
             (< (length (-> this name)) (-> this max-chars))
             )
    (when (or (logtest? (-> this flags) (keyboard-control-flag allow-leading-space)) (> (length (-> this name)) 0))
      (when (or (logtest? (-> this flags) (keyboard-control-flag allow-multiple-spaces))
                (zero? (length (-> this name)))
                (!= (-> this name data (+ (length (-> this name)) -1)) 32)
                )
        (let ((v1-24 (make-sound-instance snd-key-click (new 'static 'sound-id) (the-as handle #f))))
          (cond
            (v1-24
              (logior! (-> v1-24 flags) (sound-spec-flag needs-update non-positional))
              (-> v1-24 id)
              )
            (else
              0
              )
            )
          )
        (format (-> this name) " ")
        )
      )
    )
  (when (and (= (length (-> this name)) 1) (= (-> this layout-select) 1))
    (set! (-> this layout-select) 0)
    0
    )
  )

(defstate done (keyboard-control)
  :virtual #t
  :enter (behavior ()
    (send-event (ppointer->process (-> self parent)) 'notify 'done (-> self name))
    (set! *keyboard-init-state* #f)
    )
  :code (behavior ()
    (service-keybd)
    (suspend)
    (suspend)
    0
    )
  )

(defstate cancel (keyboard-control)
  :virtual #t
  :enter (behavior ()
    (charp<-string (the-as (pointer uint8) *keyboard-string-buf*) (-> self name))
    (set! *keyboard-init-state* (-> *lobby-menu-manager* state name))
    )
  :code (behavior ()
    (dotimes (gp-0 5)
      (set! (-> self alpha) (lerp 0.0 1.0 (* 0.2 (the float gp-0))))
      (suspend)
      )
    (ja-no-eval :group! (-> self draw art-group data 4) :num! (seek! max 20.0) :frame-num 0.0)
    (until (ja-done? 0)
      (suspend)
      (ja :num! (seek! max 20.0))
      )
    (format #t "finished-animation~%")
    (send-event (ppointer->process (-> self parent)) 'notify 'cancel)
    )
  :post ja-post
  )

(defun set-keyboard-jmod ((arg0 keyboard-control))
  (let ((s5-0 (new 'stack-no-clear 'vector)))
    (set! (-> s5-0 x) 245.76)
    (set! (-> s5-0 y) -1064.96)
    (set! (-> s5-0 z) 0.0)
    (set! (-> s5-0 w) 1.0)
    (vector-matrix*! s5-0 s5-0 (math-camera-matrix))
    (set! (-> arg0 j-mod transform trans quad) (-> s5-0 quad))
    )
  (set! (-> arg0 j-mod transform scale x) 0.08)
  (set! (-> arg0 j-mod transform scale y) 0.08)
  (set! (-> arg0 j-mod transform scale z) 0.08)
  )

(defbehavior render-entered-text keyboard-control ((arg0 keyboard-control) (arg1 font-context))
  (let ((a0-1 arg1))
    (set! (-> a0-1 color) (font-color pad-x))
    )
  (set-width! arg1 9999)
  (let ((v1-3 (the int (-> (get-string-length (-> arg0 name) arg1) length))))
    0
    (let* ((a0-6 (min 0 (- 335 v1-3)))
           (v1-5 arg1)
           (a1-4 (+ (-> arg0 screen-pos-x) a0-6))
           (a0-7 (-> arg0 screen-pos-y))
           )
      (set! (-> v1-5 origin x) (the float a1-4))
      (set! (-> v1-5 origin y) (the float a0-7))
      )
    )
  (set! (-> arg1 flags) (font-flags kerning large))
  (let ((a0-8 arg1))
    (set! (-> a0-8 color) (font-color pad-x))
    )
  (set! (-> arg1 alpha) (-> arg0 alpha))
  (with-dma-buffer-add-bucket ((s3-0 (-> *display* frames (-> *display* on-screen) global-buf))
                               (bucket-id debug)
                               )
    (draw-sprite2d-xy-absolute
      s3-0
      (-> arg0 screen-pos-x)
      (the int (-> arg1 origin y))
      (the int (* 335.0 (-> *video-params* relative-x-scale)))
      (the int (-> arg1 height))
      (new 'static 'rgba :r #x20 :g #x40 :b #x60 :a (the int (* 128.0 (-> arg0 alpha))))
      #x3fffff
      )
    (dma-buffer-add-gs-set s3-0
                           (scissor-1
                             (new 'static 'gs-scissor
                               :scax0 (-> arg0 screen-pos-x)
                               :scay0 (the int (-> arg1 origin y))
                               :scax1 (the int (+ (* 335.0 (-> *video-params* relative-x-scale)) (the float (-> arg0 screen-pos-x))))
                               :scay1 (the int (+ (-> arg1 height) (-> arg1 origin y)))
                               )
                             )
                           )
    (when (nonzero? (length (-> arg0 name)))
      (format (clear *temp-string*) "~S" (-> arg0 name))
      (let* ((s5-1 print-game-text)
             (a0-20 *common-text*)
             (t9-5 (method-of-object a0-20 expand-text))
             (a1-19 *temp-string*)
             )
        (s5-1 (t9-5 a0-20 a1-19) arg1 #f 44 (bucket-id hud-draw-hud-alpha) (the-as string #f) s3-0)
        )
      )
    (dma-buffer-add-gs-set s3-0 (scissor-1 (-> *viewport-array* default scissor)))
    )
  0
  )

(defmethod keyboard-control-method-54 ((this keyboard-control))
  (when (cpad-pressed? 0 l2)
    (let ((v1-5 (-> this layout-select)))
      (cond
        ((zero? v1-5)
         (set! (-> this layout-select) 1)
         (let ((v1-8 (make-sound-instance snd-case-toggle (new 'static 'sound-id) (the-as handle #f))))
           (cond
             (v1-8
               (logior! (-> v1-8 flags) (sound-spec-flag needs-update non-positional))
               (-> v1-8 id)
               )
             (else
               0
               )
             )
           )
         )
        ((= v1-5 1)
         (set! (-> this layout-select) 0)
         (let ((v1-12 (make-sound-instance snd-case-toggle (new 'static 'sound-id) (the-as handle #f))))
           (cond
             (v1-12
               (logior! (-> v1-12 flags) (sound-spec-flag needs-update non-positional))
               (-> v1-12 id)
               )
             (else
               0
               )
             )
           )
         )
        ((= v1-5 2)
         (set! (-> this layout-select) 1)
         (let ((v1-18 (make-sound-instance snd-case-toggle (new 'static 'sound-id) (the-as handle #f))))
           (cond
             (v1-18
               (logior! (-> v1-18 flags) (sound-spec-flag needs-update non-positional))
               (-> v1-18 id)
               )
             (else
               0
               )
             )
           )
         )
        )
      )
    )
  (when (cpad-pressed? 0 r2)
    (let ((v1-26 (-> this layout-select)))
      (cond
        ((zero? v1-26)
         (set! (-> this layout-select) 2)
         (let ((v1-29 (make-sound-instance snd-case-toggle (new 'static 'sound-id) (the-as handle #f))))
           (cond
             (v1-29
               (logior! (-> v1-29 flags) (sound-spec-flag needs-update non-positional))
               (-> v1-29 id)
               )
             (else
               0
               )
             )
           )
         )
        ((= v1-26 1)
         (set! (-> this layout-select) 2)
         (let ((v1-34 (make-sound-instance snd-case-toggle (new 'static 'sound-id) (the-as handle #f))))
           (cond
             (v1-34
               (logior! (-> v1-34 flags) (sound-spec-flag needs-update non-positional))
               (-> v1-34 id)
               )
             (else
               0
               )
             )
           )
         )
        ((= v1-26 2)
         (set! (-> this layout-select) 0)
         (let ((v1-39 (make-sound-instance snd-case-toggle (new 'static 'sound-id) (the-as handle #f))))
           (cond
             (v1-39
               (logior! (-> v1-39 flags) (sound-spec-flag needs-update non-positional))
               (-> v1-39 id)
               )
             (else
               0
               )
             )
           )
         )
        )
      )
    )
  (cond
    ((cpad-hold? 0 down)
     (+! (-> this down-count) 1)
     )
    (else
      (set! (-> this down-count) 0)
      0
      )
    )
  (cond
    ((cpad-hold? 0 up)
     (+! (-> this up-count) 1)
     )
    (else
      (set! (-> this up-count) 0)
      0
      )
    )
  (cond
    ((cpad-hold? 0 left)
     (+! (-> this left-count) 1)
     )
    (else
      (set! (-> this left-count) 0)
      0
      )
    )
  (cond
    ((cpad-hold? 0 right)
     (+! (-> this right-count) 1)
     )
    (else
      (set! (-> this right-count) 0)
      0
      )
    )
  (set! (-> this up) #f)
  (set! (-> this down) #f)
  (set! (-> this left) #f)
  (set! (-> this right) #f)
  (if (= (-> this down-count) 1)
      (set! (-> this down) (the-as basic #t))
      )
  (when (= (-> this down-count) 10)
    (set! (-> this down-count) 5)
    (set! (-> this down) (the-as basic #t))
    )
  (if (= (-> this up-count) 1)
      (set! (-> this up) (the-as basic #t))
      )
  (when (= (-> this up-count) 10)
    (set! (-> this up-count) 5)
    (set! (-> this up) (the-as basic #t))
    )
  (if (= (-> this right-count) 1)

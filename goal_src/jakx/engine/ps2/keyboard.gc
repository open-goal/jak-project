;; WARN: Return type mismatch process-drawable vs keyboard-control.
(defmethod relocate ((this keyboard-control) (offset int))
  (if (-> this name)
      (&+! (-> this name) offset)
      )
  (the-as keyboard-control ((method-of-type process-drawable relocate) this offset))
  )

(defbehavior keyboard-control-init-by-other keyboard-control ((arg0 int) (arg1 keyboard-control-flag) (arg2 (pointer uint8)))
  (set! (-> self screen-pos-x) (- 256 (the int (* 180.0 (-> *video-params* relative-x-scale)))))
  (set! (-> self screen-pos-y) 200)
  (set! (-> self max-chars) arg0)
  (set! (-> self flags) arg1)
  (set! (-> self pos-x) 0)
  (set! (-> self pos-y) 0)
  (set! (-> self selected) 0)
  (set! (-> self name) (new 'process 'string 64 ""))
  (set! (-> self alpha) 0.0)
  (set! (-> self level) (level-get *level* 'menu2))
  (set! (-> self root) (new 'process 'trsqv))
  (initialize-skeleton self (art-group-get-by-name *level* "skel-keyboard" (the-as (pointer level) #f)) 0)
  (logior! (-> self skel status) (joint-control-status sync-math))
  (logior! (-> self draw status) (draw-control-status force-vu1))
  (init (-> self j-mod) self (the-as uint 3) (joint-mod-base-flags attached))
  (matrix->transformq (-> self j-mod transform) (math-camera-matrix))
  (if (and *lobby-menu-manager*
           (not (logtest? arg1 (keyboard-control-flag no-restore)))
           (= *keyboard-init-state* (-> *lobby-menu-manager* state name))
           )
      (copy-charp<-charp (-> self name data) (the-as (pointer uint8) *keyboard-string-buf*))
      )
  (when arg2
    (copy-charp<-charp (-> self name data) arg2)
    (set! (-> self pos-x) 8)
    (set! (-> self pos-y) 4)
    (set! (-> self selected) 40)
    )
  (go-virtual idle)
  )

;; WARN: Return type mismatch int vs handle.
(defun keyboard-control-spawn ((arg0 int) (arg1 process) (arg2 keyboard-control-flag) (arg3 (pointer uint8)))
  (kill-by-type keyboard-control *active-pool*)
  (let ((v0-4 (ppointer->handle (process-spawn keyboard-control arg0 arg2 arg3 :name "keyboard-control" :to arg1))))
    (set! (-> *keyboard-proc* handle) (the-as handle v0-4))
    (the-as handle v0-4)
    )
  )

(defun kill-keyboard-control ()
  (kill-by-type keyboard-control *active-pool*)
  )

(defun get-keyboard-control ()
  (handle->process (-> *keyboard-proc* handle))
  )

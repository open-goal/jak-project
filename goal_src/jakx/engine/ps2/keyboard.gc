;;-*-Lisp-*-
(in-package goal)

;; name: keyboard.gc
;; name in dgo: keyboard
;; dgos: ENGINE, GAME

;; +++keyboard-control-flag
(defenum keyboard-control-flag
  :type uint64
  :bitfield #t
  (allow-space 0)
  (allow-multiple-spaces 1)
  (allow-leading-space 2)
  (restrict-chars 3)
  (restrict-chars-alt 4)
  (no-symbols 5)
  (no-restore 6)
  (bit7 7)
  (bit8 8)
  (bit9 9)
  )
;; ---keyboard-control-flag


(define-extern service-keybd (function keybd-info))
(define-extern keybd-read-ascii (function int))

(define-extern *keybd-ungetc* uint)

;; DECOMP BEGINS

(defun cpad-or-kbd-pressed-var? ((arg0 uint) (arg1 pad-buttons))
  (or (logtest? (-> *cpad-list* cpads arg0 button0-rel 0) arg1) (case arg1
                                                                  (((pad-buttons up))
                                                                   (= (-> *keybd* keys 82) 1)
                                                                   )
                                                                  (((pad-buttons down))
                                                                   (= (-> *keybd* keys 81) 1)
                                                                   )
                                                                  (((pad-buttons left))
                                                                   (= (-> *keybd* keys 80) 1)
                                                                   )
                                                                  (((pad-buttons right))
                                                                   (= (-> *keybd* keys 79) 1)
                                                                   )
                                                                  (((pad-buttons x))
                                                                   (= (-> *keybd* keys 40) 1)
                                                                   )
                                                                  (((pad-buttons triangle))
                                                                   (= (-> *keybd* keys 41) 1)
                                                                   )
                                                                  (else
                                                                    #f
                                                                    )
                                                                  )
      )
  )

(defun kbd-clear! ((arg0 int))
  (if (!= (-> *keybd* keys arg0) 1)
      (return (the-as int #f))
      )
  (set! (-> *keybd* keys arg0) (the-as uint 3))
  0
  )

(defun cpad-or-kbd-clear-func! ((arg0 uint) (arg1 pad-buttons))
  (if (logtest? arg1 (pad-buttons up))
      (kbd-clear! 82)
      )
  (if (logtest? arg1 (pad-buttons down))
      (kbd-clear! 81)
      )
  (if (logtest? arg1 (pad-buttons left))
      (kbd-clear! 80)
      )
  (if (logtest? arg1 (pad-buttons right))
      (kbd-clear! 79)
      )
  (if (logtest? arg1 (pad-buttons x))
      (kbd-clear! 40)
      )
  (if (logtest? arg1 (pad-buttons triangle))
      (kbd-clear! 41)
      )
  )

(defskelgroup skel-keyboard keyboard keyboard-lod0-jg keyboard-idle-ja
              ((keyboard-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 0 0 4000)
              :global-effects 4
              )

(define *keyboard-proc* (new 'static 'handle-wrapper))


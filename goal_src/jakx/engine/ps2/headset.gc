(define *decoder-queue-buffers* (new 'static 'boxed-array :type object :length 0 :allocated-length 4))

(set! (-> *decoder-queue-buffers* 3) *decoder-queue-3-buf*)

(set! (-> *decoder-queue-buffers* 2) *decoder-queue-2-buf*)

(set! (-> *decoder-queue-buffers* 1) *decoder-queue-1-buf*)

(set! (-> *decoder-queue-buffers* 0) *decoder-queue-0-buf*)

;; WARN: Return type mismatch process vs headset.
(defmethod relocate ((this headset) (offset int))
  (set! *headset* this)
  (if *headset*
      (set! *headset* (&+ *headset* offset))
      )
  (the-as headset ((method-of-type process relocate) this offset))
  )

(defmethod deactivate ((this headset))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (set! *headset* #f)
  ((method-of-type process deactivate) this)
  (none)
  )

(defbehavior headset-init-by-other headset ()
  (logclear! (-> self mask) (process-mask pause menu))
  (setup! self)
  (go-virtual active)
  )

;; WARN: Return type mismatch int vs object.
(defun headset-activate ()
  (if (not *headset*)
      (set! *headset*
            (the-as headset (ppointer->process (process-spawn headset :name "headset" :stack *kernel-dram-stack*)))
            )
      )
  0
  )

;; WARN: Return type mismatch int vs object.
(defun headset-deactivate ()
  (send-event *headset* 'go-die)
  0
  )

;; WARN: Return type mismatch int vs object.
(defun headset-audio-msg-callback ((arg0 mem-buffer) (arg1 int))
  (if (not (and *headset* (logtest? (-> *headset* flags) (headset-flag connected))))
      (return (the-as object #f))
      )
  (read-int8 arg0)
  (read-int8 arg0)
  (let ((s3-0 (read-int8 arg0)))
    (get-voice *headset* (-> arg0 ptr) (the-as int (bytes-remaining arg0)) arg1 s3-0)
    )
  0
  )

(set! (-> *net-aux-msg-handlers* 4 handler-func) headset-audio-msg-callback)

(defun headset-udp-callback ((arg0 pointer) (arg1 int) (arg2 int))
  (if *headset*
      (get-voice *headset* arg0 arg1 arg2 0)
      )
  0
  )

(defmethod setup! ((this headset))
  (with-pp
    (stack-size-set! (-> this main-thread) 512)
    (set! (-> this flags) (headset-flag))
    (logior! (-> this flags) (headset-flag hf1))
    (init this)
    (init! *udp-layer*)
    (set-callback *udp-layer* headset-udp-callback)
    (remove-from-process (-> *net-mgr* notify) pp)
    (net-mgr-notify-connect this 8)
    0
    (none)
    )
  )

(defmethod update-status ((this headset))
  (knet-lg-tick)
  (let ((s5-0 (= (knet-lg-got-headset) 1)))
    (when (!= s5-0 (logtest? (-> this flags) (headset-flag connected)))
      (format 0 "headset status change!~%")
      (cond
        (s5-0
          (format 0 "new headset~%")
          (logior! (-> this flags) (headset-flag connected))
          (init this)
          0
          )
        (else
          (logclear! (-> this flags) (headset-flag connected))
          0
          )
        )

    (let ((s2-1 (min s3-1 (- (-> this size) (-> this read-offset)))))
      (mem-copy! arg0 (&+ (-> this data) (-> this read-offset)) s2-1)
      (set! (-> this read-offset) (mod (+ (-> this read-offset) s2-1) (-> this size)))
      (let ((a0-4 (&+ arg0 s2-1))
            (s4-1 (- s3-1 s2-1))
            )
        (when (> s4-1 0)
          (mem-copy! a0-4 (&+ (-> this data) (-> this read-offset)) s4-1)
          (+! (-> this read-offset) s4-1)
          )
        )
      )
    (set! (-> this bytes) (- (-> this bytes) s5-0))
    s5-0
    )
  )

(defmethod reset! ((this headset-queue))

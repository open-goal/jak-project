(defmethod init! ((this headset-queue) (arg0 (pointer uint8)) (arg1 int))
  (set! (-> this data) arg0)
  (set! (-> this size) arg1)
  (reset! this)
  0
  (none)
  )

(defmethod headset-queue-method-10 ((this headset-queue) (arg0 (pointer uint8)) (arg1 int))
  (let ((v1-1 (- (-> this size) (-> this bytes))))
    0
    (let* ((s3-1 (min arg1 v1-1))
           (s5-0 s3-1)
           )
      (let ((s2-1 (min s3-1 (- (-> this size) (-> this write-offset)))))
        (mem-copy! (&+ (-> this data) (-> this write-offset)) arg0 s2-1)
        (set! (-> this write-offset) (mod (+ (-> this write-offset) s2-1) (-> this size)))
        (let ((a1-2 (&+ arg0 s2-1))
              (s4-1 (- s3-1 s2-1))
              )
          (when (> s4-1 0)
            (mem-copy! (&+ (-> this data) (-> this write-offset)) a1-2 s4-1)
            (+! (-> this write-offset) s4-1)
            )
          )
        )
      (+! (-> this bytes) s5-0)
      s5-0
      )
    )
  )

(defmethod headset-queue-method-11 ((this headset-queue) (arg0 (pointer uint8)) (arg1 int))
  0
  (let* ((s3-1 (min arg1 (-> this bytes)))
         (s5-0 s3-1)

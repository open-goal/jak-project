(define *headset-decoder-ids* (new 'static 'array int8 4 0 0 0 0))

(define *headset-decoder-ptrs*
  (new 'static 'boxed-array :type nci-codec-io-block :length 0 :allocated-length 4)
  )

(deftype headset-decoder (structure)
  ((client-idx  int8)
   (last-time   int32)
   (cmp-queue   headset-queue       :inline)
   (io          nci-codec-io-block  :inline)
   (scratch     uint8               16)
   (id          int8)
   )
  :allow-misaligned
  )


(deftype headset (process)
  ((flags                    headset-flag)
   (decoders                 headset-decoder     4 :inline)
   (client-to-decoder        uint8               16)
   (client-to-decoder-s8     int8                16 :overlay-at (-> client-to-decoder 0))
   (encoder-io               nci-codec-io-block  :inline)
   (last-speech-time         int32)
   (prev-operation           symbol)
   (bytes-in-playback-queue  int32)
   (first-send               symbol)
   (frame-ct                 int32)
   (client-talking           uint8               16)
   (client-talking-s8        int8                16 :overlay-at (-> client-talking 0))
   )
  (:state-methods
    active
    die
    )
  (:methods
    (headset-method-17 (_type_) none)
    (init (_type_) none)
    (headset-method-19 (_type_) none)
    (headset-method-20 (_type_) none)
    (headset-method-21 (_type_) none)
    (headset-method-22 (_type_) none)
    (headset-method-23 (_type_) none)
    (headset-method-24 (_type_) none)
    (headset-method-25 (_type_ int) none)
    (headset-method-26 (_type_ object object int int int) none)
    (headset-method-27 (_type_) none)
    (headset-method-28 (_type_) none)
    (headset-method-29 (_type_ (pointer uint16)) none)
    (headset-method-30 (_type_) none)
    (headset-method-31 (_type_) none)
    (headset-method-32 (_type_) none)
    )
  )


(define *headset* (the-as headset #f))

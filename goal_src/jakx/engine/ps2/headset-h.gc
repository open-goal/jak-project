;;-*-Lisp-*-
(in-package goal)

;; name: headset-h.gc
;; name in dgo: headset-h
;; dgos: ENGINE, GAME

;; +++headset-flag
(defenum headset-flag
  :type uint32
  :bitfield #t
  (connected 0)
  (hf1 1)
  (hf2 2)
  (playback 3)
  (recording 4)
  (talking 5)
  )
;; ---headset-flag


(define-extern headset-activate (function object))
(define-extern headset-deactivate (function object))

;; DECOMP BEGINS

(deftype headset-queue (structure)
  ((write-offset  int32)
   (read-offset   int32)
   (bytes         int32)
   (size          int32)
   (data          (pointer uint8))
   )
  :pack-me
  (:methods
    (init! (_type_ (pointer uint8) int) none)
    (headset-queue-method-10 (_type_ (pointer uint8) int) int)
    (headset-queue-method-11 (_type_ (pointer uint8) int) int)
    (reset! (_type_) none)
    )
  )


(deftype nci-codec-io-block (structure)
  ((pcm-buffer                      (pointer int16))
   (samples-in-pcm-buffer           int16)
   (nelly-buffer                    (pointer uint8))
   (nelly-buffer-size               uint16)
   (nelly-buffer-read-byte-offset   uint16)
   (nelly-buffer-read-bit-offset    uint8)
   (nelly-buffer-write-byte-offset  uint16)
   (nelly-buffer-write-bit-offset   uint8)
   )
  :pack-me
  )


(define *headset-input-buffer* (new 'static 'array int16 1024

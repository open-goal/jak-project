(define *headset-decoder-ids* (new 'static 'array int32 4 0 0 0 0))

(define *headset-decoder-ptrs*
  (new 'static 'boxed-array :type nci-codec-io-block :length 0 :allocated-length 4)
  )

(deftype headset-decoder (structure)
  ((client-idx  int8)
   (last-time   int32)
   (cmp-queue   headset-queue       :inline)
   (io          nci-codec-io-block  :inline)
   (scratch     uint8               16)
   (id          int8)
   )
  :allow-misaligned
  )


(deftype headset (process)
  ((flags                    headset-flag)
   (decoders                 headset-decoder     4 :inline)
   (client-to-decoder        uint8               16)
   (client-to-decoder-s8     int8                16 :overlay-at (-> client-to-decoder 0))
   (encoder-io               nci-codec-io-block  :inline)
   (last-speech-time         int32)
   (prev-operation           symbol)
   (bytes-in-playback-queue  int32)
   (first-send               symbol)
   (frame-ct                 int32)
   (client-talking           uint8               16)
   (client-talking-s8        int8                16 :overlay-at (-> client-talking 0))
   )
  (:state-methods
    active
    die
    )
  (:methods
    (setup! (_type_) none)
    (init (_type_) none)
    (update-status (_type_) none)
    (update (_type_) none)
    (process-recorded (_type_) none)
    (process-playback (_type_) none)
    (start-record (_type_) none)
    (start-playback (_type_) none)
    (send-voice (_type_ int) none)
    (get-voice (_type_ pointer int int int) none)
    (decode-frame (_type_ int object object) int)
    (decode-frames (_type_ (pointer nci-codec-io-block) (pointer int32) (pointer int16) symbol (function (pointer nci-codec-io-block) (pointer int32) none)) int)
    (decode-output-frame (_type_ (pointer uint16)) symbol)
    (headset-method-30 () none)
    (headset-method-31 (_type_ (pointer int16) (pointer int16) int) none)
    (headset-method-32 (_type_) none)
    )
  )


(define *headset* (the-as headset #f))

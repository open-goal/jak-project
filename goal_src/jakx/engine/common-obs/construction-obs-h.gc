      (set! (-> a0-16 collide-with) (collide-spec backgnd obstacle hit-by-player-list hit-by-others-list))
      (set! (-> a0-16 ignore-process0) this)
      (set! (-> a0-16 ignore-process1) #f)
      (set! (-> a0-16 ignore-pat)
            (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noendlessfall #x1 :board #x1)
            )
      (set! (-> a0-16 action-mask) (collide-action solid))
      (set! (-> a0-16 nav-mesh) #f)
      )
    (collide-cache-method-13 *collide-cache* (-> v1-28 cquery))
    )
  ((method-of-type rigid-body-object rigid-body-object-method-71) this)

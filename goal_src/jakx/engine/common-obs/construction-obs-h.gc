  (none)
  )

(defmethod rigid-body-object-method-82 ((this construction-object) (arg0 object) (arg1 rigid-body-object-constants))
  (set! (-> arg1 info inertial-tensor fvec x) (/ (-> arg1 info inertial-tensor fvec x) 1000))

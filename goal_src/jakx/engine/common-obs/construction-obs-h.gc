   (pad               uint32)
   (blink-start-time  int32)
   (hit-time          int32)
   )
  (:methods
    (construction-object-method-90 (_type_) none)
    (construction-object-method-91 (_type_) none)
    (construction-object-method-92 (_type_ object) none)
    (construction-object-method-93 (_type_) none)
    )
  )


(define *construction-glow-template*
  (new 'static 'sprite-glow-data
    :position (new 'static 'vector :data (new 'static 'array float 4 0.0 0.0 0.0 2867.2))
    :size-probe 163.84
    :z-offset 4096.0
    :size-y 2867.2
    :color (new 'static 'rgbaf :data (new 'static 'array float 4 128.0 100.0 0.0 35.0))
    :fade-a -0.0000122044
    :fade-b 8.997864
    :tex-id (new 'static 'texture-id :index #x15 :page #x4)
    )
  )

(defstate idle (construction-object)
  :virtual #t
  :event rigid-body-object-event-handler
  :enter (behavior ()
    (ja-post)
    (set! (-> self splash) #f)
    (let* ((gp-0 (current-time))
           (f30-0 150.0)
           (v1-3 (/ (the-as int (rand-uint31-gen *random-generator*)) 256))
           (v1-4 (the-as number (logior #x3f800000 v1-3)))
           )
      (set! (-> self blink-start-time) (the-as int (+ gp-0 (the int (* f30-0 (+ -1.0 (the-as float v1-4)))))))
      )
    (logclear! (-> self root penetrated-by) (penetrate vehicle))
    )
  :exit (behavior ()
    (set! (-> self disturbed-time) (the-as uint (current-time)))
    )
  :code sleep-code
  )

(defstate active (construction-object)
  :virtual #t
  :enter (behavior ()
    (call-parent-state-handler enter)
    (set! (-> self rbody max-ang-momentum) (* 500000000.0 (-> self info info mass)))
    )
  :trans (behavior ()
    (construction-object-method-90 self)
    )
  )

(defmethod construction-object-method-93 ((this construction-object))
  (let ((gp-0 (new 'stack-no-clear 'sprite-glow-data)))
    (quad-copy! (the-as pointer (-> gp-0 position)) (the-as pointer *construction-glow-template*) 4)
    (vector-matrix*!
      (-> (&+ gp-0 64) position)
      (new 'static 'vector :data (new 'static 'array float 4 0.0 20480.0 0.0 1.0))
      (-> this node-list data 0 bone transform)
      )
    (let* ((v1-2 (-> gp-0 position))
           (a1-2 (&+ gp-0 64))
           (f0-0 (-> v1-2 w))
           )
      (set! (-> (the-as vector (-> v1-2 data)) quad) (-> a1-2 position quad))
      (set! (-> v1-2 w) f0-0)
      )
    0
    (set! (-> gp-0 rot-angle) (* 182.04445 (rand-vu-float-range -17.0 -13.0)))
    (set! (-> gp-0 position w) (rand-vu-float-range 10240.0 12288.0))
    (set! (-> gp-0 size-y) (-> gp-0 position w))
    (add! *simple-sprite-system* (the-as sprite-glow-data (-> gp-0 position)))
    )
  (none)
  )

;; WARN: Return type mismatch object vs none.
(defmethod rigid-body-object-method-80 ((this construction-object) (arg0 rigid-body-impact))
  (cond
    ((and (-> arg0 process) (logtest? (process-mask vehicle) (-> arg0 process mask)))
     (let* ((s4-0 (new 'stack-no-clear 'vector))
            (v1-3 (-> arg0 process))
            (f30-0 (fmin 286720.0 (vector-length (-> (the-as process-drawable v1-3) root transv))))
            )
       (set! (-> s4-0 quad) (-> arg0 normal quad))
       (vector-normalize! s4-0 (* 0.0012 f30-0))
       (+! (-> s4-0 y) (/ f30-0 1000))
       )
     (set! (-> arg0 point quad) (-> (the-as process-drawable (-> arg0 process)) root trans quad))
     (+! (-> arg0 point y) -20.48)
     (rigid-body-control-method-18 (-> this rbody) (-> arg0 point))
     (rigid-body-control-method-12 (-> this rbody) 1.0)
     ((method-of-object (-> this rbody) rigid-body-control-method-13))
     (logior! (-> this root penetrated-by) (penetrate vehicle))
     (set! (-> this hit-time) (the-as int (+ (current-time) (seconds 0.1))))
     )
    (else

(defstate jump (daxter)
  :virtual #t
  :trans (behavior ()
    (let ((v1-1 (the-as vehicle (handle->process (-> self veh)))))
      (when v1-1
        (if (and (logtest? (-> v1-1 v-flags) (vehicle-flag in-air)) (< (-> v1-1 root transv y) 81920.0))
            (go-virtual fall)
            )
        )
      )
    )
  :code (behavior ()
    (ja-channel-push! 1 (seconds 0.2))
    (ja-no-eval :group! daxter-falcon-jump-ja :num! (seek!) :frame-num 0.0)
    (until (ja-done? 0)
      (suspend)
      (ja :num! (seek!))
      )
    (set! (-> self lean) 0.0)
    (go-virtual idle)
    )
  :post daxter-post
  )

            )
        (if (nonzero? v1-10)
            (set! v0-0 (ash 1 (+ v1-10 -1)))
            )
        v0-0
        )
      )
    )
  )

(defmethod daxter-method-58 ((this daxter))
  (let ((gp-0 (the-as vehicle (handle->process (-> this veh)))))
    (when gp-0
      (let ((v1-5 (daxter-method-60 this 6))
            (a0-2 (-> gp-0 info daxter))
            )
        (dotimes (a1-4 (-> gp-0 info daxter trunk-seat-count))
          (if (logtest? (-> a0-2 trunk-seats a1-4 mask) v1-5)

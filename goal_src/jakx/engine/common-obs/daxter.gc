  )

(defmethod daxter-method-64 ((this daxter) (arg0 vehicle-seat-info))
  (let ((s5-0 (the-as vehicle (handle->process (-> this veh)))))
    (when s5-0
      (let ((s3-0 (new 'stack-no-clear 'inline-array 'vector 1)))
        (quaternion-copy! (-> this root rotation) (-> s5-0 root rotation))
        (let ((f30-0 (* 182.04445 (* 0.005493164 (the float (-> arg0 angle))))))
          (when (!= f30-0 (-> this target-seat-angle))
            (go (method-of-object this jump))
            (set! (-> this target-seat-angle) f30-0)
            )
          )
        (quaternion-rotate-x! (-> this root rotation) (-> this root rotation) (-> this seat-angle))
        (quaternion->matrix (the-as matrix (-> s3-0 0)) (-> this root rotation))
        (vector-matrix*! (-> this root trans) *animation-adjust* (the-as matrix (-> s3-0 0)))
        )
      (let ((s3-1 (new 'stack-no-clear 'vector)))
        (set-vector! s3-1 (-> arg0 pos-x) (-> arg0 pos-y) (-> arg0 pos-z) 1.0)
        (when (or (!= (-> s3-1 x) (-> this target-seat-offset x))
                  (!= (-> s3-1 y) (-> this target-seat-offset y))
                  (!= (-> s3-1 z) (-> this target-seat-offset z))
                  )
          (go (method-of-object this jump))
          (set! (-> this target-seat-offset quad) (-> s3-1 quad))
          )
        (vector-matrix*! s3-1 (-> this seat-offset) (-> s5-0 node-list data 0 bone transform))
        (vector+! (-> this root trans) (-> this root trans) s3-1)
        )
      )
    )
  )

(defmethod seat-available? ((this daxter))
  (let ((v1-1 (the-as vehicle (handle->process (-> this veh)))))
    (when v1-1
      (let* ((v1-4 (-> v1-1 info daxter))
             (a1-5 (-> v1-4 chassis-seats 0))
             )
        (when (> (-> v1-4 chassis-seat-count) 0)
          (daxter-method-64 this a1-5)
          (return #t)
          )
        )
      )
    )
  #f
  )

(defmethod daxter-method-65 ((this daxter) (arg0 int))
  (let ((a2-0 (the-as vehicle (handle->process (-> this veh)))))
    (if (and a2-0 (not (logtest? (-> a2-0 sections arg0 flags) 2)))
        (return #f)
        )
    )
  #t
  )

(defmethod daxter-method-63 ((this daxter) (arg0 int))
  (let ((v1-1 (the-as vehicle (handle->process (-> this veh)))))
    (when v1-1
      (let ((a2-6 (-> v1-1 info daxter)))
        (dotimes (a3-1 (-> v1-1 info daxter roof-seat-count))
          (let ((t0-1 (-> a2-6 roof-seats a3-1)))
            (when (logtest? (-> t0-1 mask) arg0)
              (new 'stack-no-clear 'vector)
              (daxter-method-64 this t0-1)
              (return #t)
              )
            )
          )
        )
      )
    )
  #f
  )

(defmethod daxter-method-62 ((this daxter) (arg0 int))
  (let ((v1-1 (the-as vehicle (handle->process (-> this veh)))))
    (when v1-1
      (let ((a2-6 (-> v1-1 info daxter)))
        (dotimes (a3-1 (-> v1-1 info daxter trunk-seat-count))
          (let ((t0-1 (-> a2-6 trunk-seats a3-1)))
            (when (logtest? (-> t0-1 mask) arg0)
              (new 'stack-no-clear 'vector)
              (daxter-method-64 this t0-1)
              (return #t)
              )
            )
          )
        )
      )
    )
  #f
  )

(defmethod daxter-method-60 ((this daxter) (arg0 int))
  (local-vars (v1-5 int))
  (let ((v1-1 (the-as vehicle (handle->process (-> this veh)))))
    (when v1-1
      0
      (if *net-game-mgr*
          (set! v1-5 (-> *net-world* player-to-vehicle-slot-map-s8 (-> v1-1 player-id)))
          (set! v1-5 (-> *lobby-menu-manager* current-local-player))
          )
      (let ((v1-10 (-> *car-level-array* data v1-5 current-parts arg0))

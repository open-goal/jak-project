          (format *stdebug* "~%")
          (format *stdebug* "DAXTER POSITIONING~%-----------------------------~%")
          (if *daxter-position-tweak*
              (format *stdebug* "EDIT MODE~%")
              )
          (format *stdebug* "Current Trunk = ~C Daxter trunk seat = ~s~%" (+ s3-0 96) (if (daxter-method-58 this)
                                                                                          "defined"

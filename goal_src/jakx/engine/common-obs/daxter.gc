;; WARN: Return type mismatch object vs none.
(defmethod daxter-method-57 ((this daxter))
  (local-vars (v1-7 int))
  (let ((s5-0 (the-as vehicle (handle->process (-> this veh)))))
    (when s5-0
      0
      (if *net-game-mgr*
          (set! v1-7 (-> *net-world* player-to-vehicle-slot-map-s8 (-> s5-0 player-id)))
          (set! v1-7 (-> *lobby-menu-manager* current-local-player))
          )
      (let ((s4-0 (-> *car-level-array* data v1-7 current-parts 7)))

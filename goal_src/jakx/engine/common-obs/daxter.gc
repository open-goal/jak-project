  )

(defbehavior daxter-post daxter ()
  (let ((gp-0 (the-as vehicle (handle->process (-> self veh)))))
    (when (not gp-0)
      (when (not *net-game-mgr*)
        (let ((v1-5 (as-type (find-vehicle 0) vehicle)))
          (when v1-5
            (set! (-> self veh) (process->handle v1-5))
            (set! gp-0 v1-5)
            )
          )
        )
      )
    (if (or (not gp-0) (logtest? (-> gp-0 v-flags) (vehicle-flag dead)))
        (go empty-state)
        )
    (when gp-0
      (if (not *net-game-mgr*)
          (daxter-method-57 self)
          )
      (cond
        (*daxter-position-tweak*
          (let ((s5-1 (new 'stack-no-clear 'inline-array 'matrix 1)))
            (quaternion-copy! (-> self root rotation) (-> gp-0 root rotation))
            (quaternion-rotate-x! (-> self root rotation) (-> self root rotation) *daxter-rotate*)
            (quaternion->matrix (-> s5-1 0) (-> self root rotation))
            (vector-matrix*! (-> self root trans) *animation-adjust* (-> s5-1 0))
            )
          (let ((s5-2 (new 'stack-no-clear 'vector)))
            (vector-matrix*! s5-2 *seat-offset* (-> gp-0 node-list data 0 bone transform))
            (vector+! (-> self root trans) (-> self root trans) s5-2)
            )
          )
        (else
          (let ((gp-1 (daxter-method-60 self 6)))
            (when (or (zero? gp-1) (daxter-method-65 self 9) (not (daxter-method-62 self gp-1)))
              (let ((gp-2 (daxter-method-60 self 7)))
                (when (or (zero? gp-2) (daxter-method-65 self 10) (not (daxter-method-63 self gp-2)))
                  (if (not (seat-available? self))
                      (format *stdebug* "DAXTER SEAT ERROR: No seat available!!~%")
                      )
                  )
                )
              )
            )
          (vector-lerp! (-> self seat-offset) (-> self seat-offset) (-> self target-seat-offset) 0.1)
          (+! (-> self seat-angle) (* 0.1 (- (-> self target-seat-angle) (-> self seat-angle))))
          )
        )
      )
    )
  (ja-post)
  (none)
  )

;; WARN: Return type mismatch vector vs none.
(defbehavior hide-appear-post daxter ()
  (let ((s5-0 (the-as vehicle (handle->process (-> self veh)))))
    (when s5-0
      (let ((gp-0 (new 'stack-no-clear 'matrix)))
        (set-vector! (-> gp-0 rvec) 0.0 -4096.0 0.0 1.0)
        (vector-matrix*! (-> gp-0 rvec) (-> gp-0 rvec) (-> s5-0 node-list data 0 bone transform))
        (quaternion-look-at!
          (the-as quaternion (-> gp-0 uvec))
          (-> s5-0 node-list data 0 bone transform fvec)
          *up-vector*
          )
        (quaternion-slerp!
          (-> self root rotation)
          (-> self root rotation)
          (the-as quaternion (-> gp-0 uvec))
          (-> self hide-t)
          )
        (vector-lerp! (-> self root trans) (-> self root trans) (-> gp-0 rvec) (-> self hide-t))
        )
      )
    )
  (none)
  )

(defstate hide (daxter)
  :virtual #t
  :trans (behavior ()
    (let ((gp-0 (the-as vehicle (handle->process (-> self veh)))))
      (if (not gp-0)
          (go empty-state)
          )
      (when gp-0
        (if (and (not *test-hide*)
                 (-> self transition-allowed)
                 (>= 6.0 (fabs (-> gp-0 rbody ang-velocity z)))
                 (>= (-> gp-0 node-list data 0 bone transform uvec y) 0.7)
                 )
            (go-virtual appear)
            )
        )
      )
    )
  :code (behavior ()
    (set! (-> self hide-t) 0.0)
    (set! (-> self transition-allowed) #f)
    (ja-channel-push! 1 (seconds 0.5))
    (ja-no-eval :group! daxter-falcon-jump-ja :num! (seek!) :frame-num 0.0)
    (until (ja-done? 0)
      (seek! (-> self hide-t) 1.0 (* 1.3 (seconds-per-frame)))
      (suspend)
      (ja :num! (seek!))
      )
    (set! (-> self transition-allowed) #t)
    (until #f
      (suspend)
      )
    #f
    )
  :post (behavior ()
    (when (< 0.9 (-> self hide-t))
      (when (type? (-> self root) collide-shape)
        (let ((v1-4 (-> self root root-prim)))
          (set! (-> v1-4 prim-core collide-as) (collide-spec))
          (set! (-> v1-4 prim-core collide-with) (collide-spec))
          )
        0
        )
      (logior! (-> self draw status) (draw-control-status no-draw))
      (if (type? (-> self root) collide-shape)
          (transform-post)
          )
      )
    (daxter-post)
    (hide-appear-post)
    )
  )

(defstate appear (daxter)
  :virtual #t
  :code (behavior ()
    (set! (-> self hide-t) 1.0)
    (ja-channel-push! 1 (seconds 0.5))
    (ja-no-eval :group! daxter-falcon-jump-ja :num! (seek!) :frame-num 0.0)
    (until (ja-done? 0)
      (seek! (-> self hide-t) 0.0 (* 1.3 (seconds-per-frame)))
      (suspend)
      (ja :num! (seek!))
      )
    (go-virtual idle)
    )
  :post (behavior ()
    (when (< (-> self hide-t) 0.9)
      (when (type? (-> self root) collide-shape)
        (let ((v1-4 (-> self root root-prim)))
          (set! (-> v1-4 prim-core collide-as) (-> self root backup-collide-as))
          (set! (-> v1-4 prim-core collide-with) (-> self root backup-collide-with))
          )
        )
      (logclear! (-> self draw status) (draw-control-status no-draw))
      (if (type? (-> self root) collide-shape)
          (transform-post)
          )
      )
    (daxter-post)
    (hide-appear-post)
    )
  )

(defbehavior check-hide daxter ()
  (let ((v1-1 (the-as vehicle (handle->process (-> self veh)))))
    (when v1-1
      (if (or *test-hide*
              (< 6.0 (fabs (-> v1-1 rbody ang-velocity z)))
              (< (-> v1-1 node-list data 0 bone transform uvec y) 0.7)
              )
          (go-virtual hide)
          )
      )
    )
  )

(defbehavior check-standard-trans daxter ()
  (let ((gp-0 (the-as vehicle (handle->process (-> self veh)))))
    (if (not gp-0)
        (go empty-state)
        )
    (when gp-0
      (check-hide)
      (if (and (logtest? (-> gp-0 v-flags) (vehicle-flag in-air)) (< (-> gp-0 root transv y) 81920.0))
          (go-virtual fall)
          )
      )
    )
  )

(defstate fall (daxter)
  :virtual #t
  :trans (behavior ()
    (let ((gp-0 (the-as vehicle (handle->process (-> self veh)))))
      (if (not gp-0)
          (go empty-state)
          )
      (when gp-0
        (if (not (logtest? (-> gp-0 v-flags) (vehicle-flag in-air)))
            (go-virtual jump)
            )
        )
      )
    )
  :code (behavior ()
    (ja-channel-push! 2 (seconds 0.2))
    (let ((v1-2 (-> self skel root-channel 0)))
      (let ((f0-0 1.0))
        (set! (-> v1-2 frame-interp 1) f0-0)
        (set! (-> v1-2 frame-interp 0) f0-0)
        )
      (set! (-> v1-2 frame-group) daxter-falcon-center-ja)
      )
    (until #f
      (let ((v1-4 (the-as vehicle (handle->process (-> self veh)))))
        (when v1-4
          (let ((f0-2 (fmax 0.0 (fmin 1.0 (* -0.000008138021 (+ 40960.0 (-> v1-4 root transv y)))))))
            (ja-no-eval :chan 1
                        :group! daxter-falcon-up-ja
                        :num! (chan 0)
                        :frame-interp0 f0-2
                        :frame-interp1 f0-2
                        :frame-num (-> self skel root-channel 0 frame-num)
                        )
            )
          (ja :num! (loop! 3.0))
          )
        )
      (suspend)
      0
      )
    #f
    )
  :post daxter-post
  )

(defstate idle (daxter)
  :virtual #t
  :trans (behavior ()
    (let ((gp-0 (the-as vehicle (handle->process (-> self veh)))))
      (when gp-0
        (let ((s5-0 (new 'stack-no-clear 'vector)))
          (set! (-> s5-0 quad) (-> gp-0 root transv quad))
          (vector-normalize! s5-0 1.0)
          (let ((f0-1 (vector-dot s5-0 (-> gp-0 node-list data 0 bone transform fvec))))
            (let ((f1-1 (vector-dot (-> gp-0 node-list data 0 bone transform rvec) (-> gp-0 lin-acceleration))))
              (fmax -1.05 (fmin 1.05 (/ f1-1 (meters 75))))
              )
            (when (and (< 327680.0 (vector-length (-> gp-0 root transv))) (< f0-1 0.9))
              (cond
                ((>= (-> self lean) 1.0)
                 (go-virtual big-lean-right)
                 )
                ((>= -1.0 (-> self lean))
                 (go-virtual big-lean-left)
                 )
                )
              )
            )
          )
        (check-standard-trans)
        )
      )
    )
  :code (behavior ()
    (ja-channel-push! 2 (seconds 0.2))
    (until #f
      (let ((gp-0 (the-as vehicle (handle->process (-> self veh)))))
        (when gp-0
          (let* ((f0-0 (vector-length (-> gp-0 root transv)))
                 (f30-0 (lerp-scale 0.5 2.0 f0-0 0.0 409600.0))
                 )
            (let ((f0-2 (vector-dot (-> gp-0 node-list data 0 bone transform rvec) (-> gp-0 lin-acceleration))))
              (seek! (-> self lean) (fmax -1.05 (fmin 1.05 (/ f0-2 (meters 75)))) (* 3.0 (seconds-per-frame)))
              )
            (cond
              ((< (-> self lean) 0.0)
               (let ((a0-7 (-> self skel root-channel 0)))
                 (let ((f0-10 1.0))
                   (set! (-> a0-7 frame-interp 1) f0-10)
                   (set! (-> a0-7 frame-interp 0) f0-10)
                   )
                 (set! (-> a0-7 frame-group) daxter-falcon-center-ja)
                 (set! (-> a0-7 param 0) 0.0)
                 (set! (-> a0-7 frame-num) (-> self skel root-channel 0 frame-num))
                 (joint-control-channel-group! a0-7 daxter-falcon-center-ja num-func-chan)
                 )
               (let ((a0-8 (-> self skel root-channel 1)))
                 (let ((f0-14 (fmin 1.0 (* 2.0 (fabs (-> self lean))))))
                   (set! (-> a0-8 frame-interp 1) f0-14)
                   (set! (-> a0-8 frame-interp 0) f0-14)
                   )
                 (set! (-> a0-8 frame-group) daxter-falcon-left-ja)
                 (set! (-> a0-8 param 0) 0.0)
                 (set! (-> a0-8 frame-num) (-> self skel root-channel 0 frame-num))
                 (joint-control-channel-group! a0-8 daxter-falcon-left-ja num-func-chan)
                 )
               )
              (else
                (let ((a0-9 (-> self skel root-channel 0)))
                  (let ((f0-17 1.0))
                    (set! (-> a0-9 frame-interp 1) f0-17)
                    (set! (-> a0-9 frame-interp 0) f0-17)
                    )
                  (set! (-> a0-9 frame-group) daxter-falcon-center-ja)
                  (set! (-> a0-9 param 0) 0.0)
                  (set! (-> a0-9 frame-num) (-> self skel root-channel 0 frame-num))
                  (joint-control-channel-group! a0-9 daxter-falcon-center-ja num-func-chan)
                  )
                (let ((a0-10 (-> self skel root-channel 1)))
                  (let ((f0-21 (fmin 1.0 (* 2.0 (fabs (-> self lean))))))
                    (set! (-> a0-10 frame-interp 1) f0-21)
                    (set! (-> a0-10 frame-interp 0) f0-21)
                    )
                  (set! (-> a0-10 frame-group) daxter-falcon-right-ja)
                  (set! (-> a0-10 param 0) 0.0)
                  (set! (-> a0-10 frame-num) (-> self skel root-channel 0 frame-num))
                  (joint-control-channel-group! a0-10 daxter-falcon-right-ja num-func-chan)
                  )
                )
              )
            (ja :num! (loop! f30-0))
            )
          )
        )
      (suspend)
      )
    #f
    )
  :post daxter-post
  )

(defbehavior big-lean-trans daxter ()
  (let ((gp-0 (the-as vehicle (handle->process (-> self veh)))))
    (check-standard-trans)
    (when gp-0
      (when (-> self transition-allowed)
        (let ((s5-0 (new 'stack-no-clear 'vector)))
          (set! (-> s5-0 quad) (-> gp-0 root transv quad))
          (vector-normalize! s5-0 1.0)
          (let ((f0-1 (vector-dot s5-0 (-> gp-0 node-list data 0 bone transform fvec))))
            (let ((f1-1 (vector-dot (-> gp-0 node-list data 0 bone transform rvec) (-> gp-0 lin-acceleration))))
              (fmax -1.05 (fmin 1.05 (/ f1-1 (meters 75))))
              )
            (if (or (< (vector-length (-> gp-0 root transv)) 327680.0) (< 0.9 f0-1))
                (go-virtual idle)
                )
            )
          )
        )
      )
    )
  )

(defstate big-lean-left (daxter)
  :virtual #t
  :enter (behavior ()
    (set! (-> self transition-allowed) #f)
    )
  :trans big-lean-trans
  :code (behavior ()
    (let ((f30-0 0.0))
      (suspend-for (seconds 1)
        (let ((s5-0 (the-as vehicle (handle->process (-> self veh)))))
          (when s5-0
            (let ((a0-3 (-> self skel root-channel 0)))
              (let ((f0-0 1.0))
                (set! (-> a0-3 frame-interp 1) f0-0)
                (set! (-> a0-3 frame-interp 0) f0-0)
                )
              (set! (-> a0-3 frame-group) daxter-falcon-left-ja)
              (set! (-> a0-3 param 0) 0.0)
              (set! (-> a0-3 frame-num) (-> self skel root-channel 0 frame-num))
              (joint-control-channel-group! a0-3 daxter-falcon-left-ja num-func-chan)
              )
            (ja-no-eval :chan 1
                        :group! daxter-falcon-left-big-ja
                        :num! (chan 0)
                        :frame-interp0 f30-0
                        :frame-interp1 f30-0
                        :frame-num (-> self skel root-channel 0 frame-num)
                        )
            (set! f30-0 (seek f30-0 1.0 (* 5.0 (seconds-per-frame))))
            (let* ((f0-7 (vector-length (-> s5-0 root transv)))
                   (f0-8 (lerp-scale 0.5 2.0 f0-7 0.0 409600.0))
                   )
              (ja :num! (loop! f0-8))
              )
            )
          )
        )
      )
    (ja-channel-push! 1 (seconds 0.2))
    (ja-no-eval :group! daxter-falcon-left-return-ja :num! (seek!) :frame-num 0.0)
    (until (ja-done? 0)
      (suspend)
      (ja :num! (seek!))
      )
    (set! (-> self lean) -1.0)
    (ja-channel-push! 1 (seconds 0.2))
    (ja :group! daxter-falcon-left-ja)
    (set! (-> self transition-allowed) #t)
    (suspend)
    (until #f
      (let ((v1-68 (the-as vehicle (handle->process (-> self veh)))))
        (when v1-68
          (let* ((f0-17 (vector-length (-> v1-68 root transv)))
                 (f0-18 (lerp-scale 0.5 2.0 f0-17 0.0 409600.0))
                 )
            (ja :num! (loop! f0-18))
            )
          (suspend)
          0
          )
        )
      )
    #f
    )
  :post daxter-post
  )

(defstate big-lean-right (daxter)
  :virtual #t
  :enter (behavior ()
    (set! (-> self transition-allowed) #f)

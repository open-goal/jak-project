;;-*-Lisp-*-
(in-package goal)

;; name: daxter.gc
;; name in dgo: daxter
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

(define *seat-offset* (new 'static 'vector :x -2048.0 :y 6062.08 :z -16588.8 :w 1.0))

(define *daxter-rotate* 0.0)

(deftype daxter (process-drawable)
  ((root                collide-shape :override)
   (veh                 handle)
   (lean                float)
   (transition-allowed  symbol)
   (hide-t              float)
   (target-seat-offset  vector         :inline)
   (target-seat-angle   float)
   (seat-offset         vector         :inline)
   (seat-angle          float)
   )
  (:state-methods
    idle
    appear
    hide
    jump
    big-lean-right
    big-lean-left
    fall
    )
  (:methods
    (daxter-method-57 (_type_) none)
    (daxter-method-58 (_type_) symbol)
    (daxter-method-59 (_type_) symbol)
    (daxter-method-60 (_type_ int) int)
    (seat-available? (_type_) symbol)
    (daxter-method-62 (_type_ int) symbol)
    (daxter-method-63 (_type_ int) symbol)
    (daxter-method-64 (_type_ vehicle-seat-info) vector)
    (daxter-method-65 (_type_ int) symbol)
    )
  )


(defskelgroup skel-daxter daxter daxter-lod0-jg daxter-falcon-center-ja
              ((daxter-lod0-mg (meters 999999)))
              :bounds (static-spherem 0 0 0 5)
              :texture-level 18
              :origin-joint-index 3
              )

(defbehavior daxter-init-by-other daxter ((arg0 process))
  (stack-size-set! (-> self main-thread) 512)
  (set! (-> self root) (the-as collide-shape (new 'process 'trsqv)))
  (set-vector! (-> self root scale) 1.0 1.0 1.0 1.0)
  (set! (-> self veh) (process->handle arg0))
  (set! (-> self lean) 0.0)
  (set! (-> self seat-offset quad) (the-as uint128 0))
  (set! (-> self seat-angle) 0.0)
  (process-drawable-method-42 self (art-group-get-by-name *level* "skel-daxter" (the-as (pointer level) #f)) 0)
  (set! (-> self draw light-index) (the-as uint 10))
  (logior! (-> self skel status) (joint-control-status eye-anim))
  (set! (-> self draw default-texture-page) (the-as uint 1))
  (ja-post)
  (go-virtual appear)
  )

;; WARN: Return type mismatch process vs daxter.
(defun daxter-spawn ((arg0 process))
  (let ((gp-0 (the-as process #f)))
    (let ((v1-1 (process-spawn daxter arg0 :name "daxter" :to *rigid-body-queue-manager*)))
      (if v1-1
          (set! gp-0 (-> v1-1 0))
          )
      )
    (the-as daxter gp-0)
    )
  )

(define *animation-adjust* (new 'static 'vector :y -11878.4 :w 1.0))

(define *test-hide* #f)

(define *daxter-position-tweak* #f)

;; WARN: Return type mismatch symbol vs none.
(defun edit-daxter ()
  (set! *daxter-position-tweak* #t)
  (none)
  )

;; WARN: Return type mismatch symbol vs none.
(defun view-daxter ()
  (set! *daxter-position-tweak* #f)
  (none)
  )

;; WARN: Return type mismatch daxter vs symbol.
(defbehavior enable-daxter daxter ()
  (kill-by-type daxter *active-pool*)
  (the-as symbol (daxter-spawn (find-vehicle 0)))
  )

;; WARN: Return type mismatch int vs object.
(defun make-chassis-entry ()
  (format
    0
    "((~,,2M ~,,2M ~,,2M) :angle ~,,2f)~%"
    (-> *seat-offset* x)
    (-> *seat-offset* y)
    (-> *seat-offset* z)
    (* 0.005493164 *daxter-rotate*)
    )
  0
  )

;; WARN: Return type mismatch int vs object.
(defun make-roof-entry ()
  (local-vars (v1-8 int))
  (format
    0
    "((~,,2M ~,,2M ~,,2M) :angle ~,,2f"
    (-> *seat-offset* x)
    (-> *seat-offset* y)
    (-> *seat-offset* z)
    (* 0.005493164 *daxter-rotate*)
    )
  (let ((v1-5 (find-vehicle 0)))
    (when v1-5
      0
      (if *net-game-mgr*
          (set! v1-8 (-> *net-world* player-to-vehicle-slot-map-s8 (-> v1-5 player-id)))
          (set! v1-8 (-> *lobby-menu-manager* current-local-player))
          )
      (let ((v1-12 (-> *car-level-array* data v1-8 current-parts 7)))
        (format 0 " :mask (~C))~%" (+ v1-12 96))
        )
      )
    )
  0
  )

;; WARN: Return type mismatch int vs object.
(defun make-trunk-entry ()
  (local-vars (v1-8 int))
  (format
    0
    "((~,,2M ~,,2M ~,,2M) :angle ~,,2f"
    (-> *seat-offset* x)
    (-> *seat-offset* y)
    (-> *seat-offset* z)
    (* 0.005493164 *daxter-rotate*)
    )
  (let ((v1-5 (find-vehicle 0)))
    (when v1-5
      0
      (if *net-game-mgr*
          (set! v1-8 (-> *net-world* player-to-vehicle-slot-map-s8 (-> v1-5 player-id)))
          (set! v1-8 (-> *lobby-menu-manager* current-local-player))
          )
      (let ((v1-12 (-> *car-level-array* data v1-8 current-parts 6)))
        (format 0 " :mask (~C))~%" (+ v1-12 96))
        )
      )
    )

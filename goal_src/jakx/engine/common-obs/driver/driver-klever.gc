;;-*-Lisp-*-
(in-package goal)

;; name: driver-klever.gc
;; name in dgo: driver-klever
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

(deftype driver-klever (driver)
  ()
  )


(defskelgroup skel-driver-klever klever 1 4
              ((2 (meters 20)) (3 (meters 999999)))
              :bounds (static-spherem 0 0 0 4)
              )

(defmethod driver-method-62 ((this driver-klever))
  (set! (-> this info skel) (art-group-get-by-name *level* "skel-driver-klever" (the-as (pointer level) #f)))
  (set! (-> this info turn-back-anim) 6)
  (set! (-> this info turn-front-anim) 5)
  (set! (-> this info up-down-anim) 7)
  (set! (-> this stack 119) (the-as uint 8))
  (set! (-> this stack 120) (the-as uint 9))
  (set! (-> this stack 121) (the-as uint 10))
  (set! (-> this stack 122) (the-as uint -1))
  (set! (-> this info head-node) 6)
  (set! (-> this info arm0-node) 8)
  (set! (-> this info arm1-node) 11)
  (set! (-> this info arm0-dist) 3072.0)
  (set! (-> this info arm1-dist) 3072.0)
  0
  (none)
  )

;;-*-Lisp-*-
(in-package goal)

;; name: driver-ur-86.gc
;; name in dgo: driver-ur-86
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

(deftype driver-ur-86 (driver)
  ()
  )


(defskelgroup skel-driver-ur-86 ur-86-low 1 4
              ((2 (meters 20)) (3 (meters 999999)))
              :bounds (static-spherem 0 0 0 4)
              )

(defmethod driver-method-62 ((this driver-ur-86))
  (set! (-> this info skel) (art-group-get-by-name *level* "skel-driver-ur-86" (the-as (pointer level) #f)))
  (set! (-> this info turn-back-anim) 6)
  (set! (-> this info turn-front-anim) 5)
  (set! (-> this info up-down-anim) 7)
  (set! (-> this info intro-anim0) 8)
  (set! (-> this info intro-anim1) 9)
  (set! (-> this info intro-anim2) -1)
  (set! (-> this info intro-anim3) -1)
  (set! (-> this info head-node) 7)
  (set! (-> this info arm0-node) 0)
  (set! (-> this info arm1-node) 0)
  (set! (-> this info arm0-dist) 0.0)
  (set! (-> this info arm1-dist) 0.0)
  0
  (none)
  )

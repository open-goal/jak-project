;;-*-Lisp-*-
(in-package goal)

;; name: driver-daxter.gc
;; name in dgo: driver-daxter
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

(deftype driver-daxter (driver)
  ()
  )


(defskelgroup skel-driver-daxter dax-driver 1 4
              ((2 (meters 20)) (3 (meters 999999)))
              :bounds (static-spherem 0 0 0 4)
              )

(defmethod driver-method-62 ((this driver-daxter))
  (set! (-> this info skel) (art-group-get-by-name *level* "skel-driver-daxter" (the-as (pointer level) #f)))
  (set! (-> this info turn-back-anim) 6)
  (set! (-> this info turn-front-anim) 5)
  (set! (-> this info up-down-anim) 7)
  (set! (-> this info intro-anim0) 8)
  (set! (-> this info intro-anim1) 9)
  (set! (-> this info intro-anim2) 10)
  (set! (-> this info intro-anim3) -1)
  (set! (-> this info head-node) 9)
  (set! (-> this info arm0-node) 11)
  (set! (-> this info arm1-node) 14)
  (set! (-> this info arm0-dist) 1310.72)
  (set! (-> this info arm1-dist) 1310.72)
  0
  (none)
  )

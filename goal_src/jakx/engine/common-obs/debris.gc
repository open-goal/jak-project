(defstate idle (debris-group)
  :virtual #t
  :enter (behavior ()
    (set! (-> self state-time) (the-as uint (current-time)))
    (set! (-> self next-play) (the-as int (current-time)))
    (set! (-> self had-first-hit) #f)
    )
  :trans (behavior ()
    (rlet ((vf0 :class vf)
           (vf4 :class vf)
           (vf5 :class vf)
           (vf6 :class vf)
           )
      (init-vf0-vector)
      (set! (-> self dead-debris-num) (-> self debris-num))

          (&+! (-> this debris v1-0 draw) offset)
          )
      (if (nonzero? (-> this debris v1-0))
          (&+! (-> this debris v1-0) offset)
          )
      )
    )
  (if (nonzero? (-> this debris))
      (&+! (-> this debris) offset)

                   (.add.x.vf.w vf6 vf0 vf0)
                   (.mul.vf.xyz vf6 vf4 vf5)
                   (.svf (&-> sv-64 quad) vf6)
                   )
                 (case (-> arg0 explosion)
                   ((1)
                    (vector-! (-> s1-0 transv) (-> s1-0 root trans) (-> arg0 fountain-rand-transv-lo))
                    (vector-normalize!
                      (-> s1-0 transv)
                      (rand-vu-float-range (-> arg0 fountain-rand-transv-hi x) (-> arg0 fountain-rand-transv-hi y))
                      )
                    (+! (-> s1-0 transv y)
                        (rand-vu-float-range (-> arg0 fountain-rand-transv-hi z) (-> arg0 fountain-rand-transv-hi w))
                        )
                    (set! (-> s1-0 transv w) 1.0)
                    )
                   (else
                     (let ((sv-96 (-> arg0 fountain-rand-transv-lo))
                           (sv-112 (-> arg0 fountain-rand-transv-hi))
                           )
                       (set-vector!
                         (-> s1-0 transv)
                         (rand-vu-float-range (-> sv-96 x) (-> sv-112 x))
                         (rand-vu-float-range (-> sv-96 y) (-> sv-112 y))
                         (rand-vu-float-range (-> sv-96 z) (-> sv-112 z))
                         1.0
                         )
                       )
                     )
                   )
                 (let ((s0-5 (new 'stack-no-clear 'vector)))
                   (rand-vu-sphere-point-uniform! s0-5 1.0)
                   (vector-normalize! s0-5 1.0)
                   (set! (-> s1-0 rot-axis quad) (-> s0-5 quad))
                   )
                 (set! (-> s1-0 rot-angle) (* 182.04445 (-> arg0 rot-speed)))
                 (set! (-> s1-0 duration) (the float (-> arg0 duration)))
                 (set! (-> s1-0 hit-xz-reaction) (-> arg0 hit-xz-reaction))
                 (set! (-> s1-0 hit-y-reaction) (-> arg0 hit-y-reaction))
                 (set! (-> s1-0 gravity) (-> arg0 gravity))
                 (set! (-> s1-0 time-fade-out) (the-as uint 0))
                 (let ((v0-19 (skeleton-group->draw-control
                                (the-as process-drawable self)
                                (the-as skeleton-group s2-0)
                                (&-> s1-0 node-list)
                                )
                              )
                       )
                   (set! (-> s1-0 draw) v0-19)
                   (if (nonzero? (-> arg1 joints s3-0 color-tint))
                       (set! (-> s1-0 draw color-mult quad) (-> arg1 joints s3-0 color-tint quad))
                       )
                   (set! (-> v0-19 skeleton bones 0 transform trans quad) (-> *null-vector* quad))
                   )
                 )
               )
              (else
                )
              )
            )
          )
        )
      )
    (set! (-> self max-probe-width) (-> arg0 max-probe-width))
    (set! (-> self num-boxes) (the-as uint 1))
    (set! (-> self boxes 0 start) (the-as uint 0))
    (set! (-> self boxes 0 num) (the-as uint (-> self debris-num)))
    (go-virtual idle)
    )
  )

;; WARN: Return type mismatch (pointer process) vs (pointer debris-group).
(defun debris-spawn ((arg0 process-drawable) (arg1 debris-tuning) (arg2 debris-static-params) (arg3 process-drawable))
  (if (not arg3)
      (set! arg3 arg0)
      )
  (process-spawn debris-group arg1 arg2 arg3 :name "debris-group" :to arg0 :stack-size #x8000)
  )

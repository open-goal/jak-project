        (let ((s5-0 (-> self debris gp-0))
              (s4-0 (-> self debris gp-0 draw))
              )
          (matrix<-transformq+trans!
            (-> s4-0 skeleton bones 3 transform)
            (-> s5-0 root)
            (-> s4-0 skeleton bones 0 transform trans)
            )
          (logclear! (-> s4-0 status) (draw-control-status no-draw-temp uninited))
          (let ((v1-11 (-> s4-0 origin)))
            (let ((a0-5 (-> s4-0 skeleton bones 3 transform trans))
                  (a1-1 (-> s4-0 bounds))
                  )
              (.lvf vf4 (&-> a0-5 quad))
              (.lvf vf5 (&-> a1-1 quad))
              )
            (.mov.vf.w vf6 vf0)
            (.add.vf.xyz vf6 vf4 vf5)
            (.svf (&-> v1-11 quad) vf6)
            )
          (set! (-> s4-0 origin w) (-> s4-0 bounds w))
          (cond
            ((zero? (-> s5-0 time-fade-out))
             (if (or (< (vector-length (-> s5-0 transv)) 4096.0)
                     (time-elapsed? (the-as int (-> self state-time)) (the int (-> s5-0 duration)))
                     )
                 (set! (-> s5-0 time-fade-out) (the-as uint (current-time)))
                 )
             )
            ((time-elapsed? (the-as int (-> s5-0 time-fade-out)) (seconds 0.5))
             (logior! (-> s4-0 status) (draw-control-status no-draw))
             (+! (-> self dead-debris-num) -1)
             )
            (else
              (logior! (-> s4-0 status) (draw-control-status force-fade))
              (set! (-> s4-0 force-fade)
                    (the-as
                      uint
                      (the int (- 128.0 (* 0.85333335 (the float (- (current-time) (the-as int (-> s5-0 time-fade-out)))))))
                      )
                    )
              )
            )
          )
        )
      (if (zero? (-> self dead-debris-num))
          (deactivate self)
          )
      (dotimes (gp-1 (the-as int (-> self num-boxes)))
        (let* ((s5-1 (-> self boxes gp-1))
               (s3-0 (-> s5-1 num))
               (s4-1 (-> s5-1 start))
               (s1-0 (-> s5-1 bbox))
               (s2-0 0)
               )
          (update-box! self gp-1)
          (if (< (- (-> s1-0 max data s2-0) (-> s1-0 min data s2-0)) (- (-> s1-0 max y) (-> s1-0 min y)))
              (set! s2-0 1)
              )
          (if (< (- (-> s1-0 max data s2-0) (-> s1-0 min data s2-0)) (- (-> s1-0 max z) (-> s1-0 min z)))
              (set! s2-0 2)
              )
          (when (and (< (-> self max-probe-width) (- (-> s5-1 bbox max data s2-0) (-> s1-0 min data s2-0)))
                     (< (-> self num-boxes) (the-as uint 15))
                     )
            0.0
            (let ((a1-3 (new 'static 'boxed-array :type debris :length 0 :allocated-length 32))
                  (a0-12 0)
                  (v1-71 0)
                  (a2-4 (-> self boxes (-> self num-boxes)))
                  )
              (let ((f0-14 (* 0.5 (+ (-> s5-1 bbox min data s2-0) (-> s5-1 bbox max data s2-0)))))
                (dotimes (a3-6 (the-as int s3-0))
                  (let ((t0-4 (-> self debris (+ a3-6 (-> s5-1 start)))))
                    (cond
                      ((< (-> t0-4 root trans data s2-0) f0-14)
                       (set! (-> self debris (+ a0-12 s4-1)) (-> self debris (+ a3-6 s4-1)))
                       (+! a0-12 1)
                       )
                      (else
                        (set! (-> a1-3 v1-71) (-> self debris (+ a3-6 s4-1)))
                        (+! v1-71 1)
                        )
                      )
                    )
                  )
                )
              (dotimes (a3-9 v1-71)
                (set! (-> self debris (+ a0-12 s4-1 a3-9)) (-> a1-3 a3-9))
                )
              (set! (-> s5-1 num) (the-as uint a0-12))
              (set! (-> a2-4 start) (+ s4-1 a0-12))
              (set! (-> a2-4 num) (the-as uint v1-71))

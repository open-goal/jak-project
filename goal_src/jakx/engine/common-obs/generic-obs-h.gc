(in-package goal)

;; name: generic-obs-h.gc
;; name in dgo: generic-obs-h
;; dgos: ENGINE, GAME

;; +++manipy-options
(defenum manipy-options
  :bitfield #t
  :type uint32
  (mo0 0)
  (mo1 1)
  (mo2 2)
  (mo3 3)
  (mo4 4)
  )
;; ---manipy-options

;; +++task-arrow-flags
(defenum task-arrow-flags
  :type uint32
  :bitfield #t
  (taf0 0)
  (taf1 1)
  (taf2 2)
  (taf3 3)
  (taf4 4)
  (taf5 5)
  (taf6 6)
  (taf7 7)
  (taf8 8)
  )
;; ---task-arrow-flags


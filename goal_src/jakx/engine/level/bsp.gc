         )
    (init-vf0-vector)
    (set! v1-0 (the-as none (+ a0-0 a2-0)))
    (.lvf vf3 (&-> a0-0 bsp-scale quad))
    (.sll a2-1 a2-0 1)
    (set! a3-0 (the-as none (-> a0-0 nodes)))
    (set! a2-2 (the-as none (+ a0-0 a2-1)))
    (.lvf vf1 (&-> a1-0 quad))
    (.lvf vf2 (&-> a0-0 bsp-offset quad))
    (.sub.vf.xyz vf1 vf1 vf2)
    (.div.vf Q vf0 vf3 :fsf #b11 :ftf #b0)
    (.wait.vf)
    (.mul.vf.x vf1 vf1 Q)
    (.div.vf Q vf0 vf3 :fsf #b11 :ftf #b1)
    (.wait.vf)
    (.mul.vf.y vf1 vf1 Q)
    (.div.vf Q vf0 vf3 :fsf #b11 :ftf #b10)
    (.wait.vf)
    (.mul.vf.z vf1 vf1 Q)
    (set! a0-1 (the-as none #xffffff))
    (set! a1-1 (the-as none 0))
    (vftoi15.xyzw vf1 vf1)
    (.mov t0-0 vf1)
    (.pw.sra t0-1 t0-0 15)
    (.ppach t0-2 (the-as uint128 0) t0-1)
    (.ppacb t0-3 (the-as uint128 0) t0-2)
    (set! t0-4 (the-as uint128 (logand t0-3 a0-1)))
    (label cfg-1)
    (set! t1-0 (the-as none (sll a1-1 4)))
    (set! t2-0 (the-as none (sll a1-1 2)))
    (set! t1-1 (the-as none (+ t1-0 t2-0)))
    (set! t2-1 (the-as none (+ a3-0 t1-1)))
    (nop!)
    (set! t4-0 (the-as uint128 (l.w (+ t2-1 4))))
    (.pcgtb t7-0 t4-0 t0-4)
    (set! t1-2 (the-as uint128 (l.w (+ t2-1 8))))
    (.pcgtb t5-0 t1-2 t0-4)
    (set! t3-0 (the-as uint128 (l.w (+ t2-1 12))))
    (.pcgtb t8-0 t3-0 t0-4)
    (set! t1-3 (the-as uint128 (l.w (+ t2-1 16))))
    (.pcgtb t6-0 t1-3 t0-4)
    (set! t1-4 (the-as none (l.h t2-1)))
    (set! t7-1 (the-as none (lognot t7-0)))
    (set! t8-1 (the-as none (lognot t8-0)))
    (set! t5-1 (the-as none (logand t7-1 t5-0)))
    (set! t6-1 (the-as none (logand t8-1 t6-0)))
    (set! t5-2 (the-as none (logand t5-1 a0-1)))
    (set! t6-2 (the-as none (logand t6-1 a0-1)))
    (.srl t4-1 t4-0 24)
    (set! t2-2 (the-as none (l.h (+ t2-1 2))))
    ((b! (= t5-2 a0-1) L55 (.srl t3-1 t3-0 24)) (.srl t3-1 t3-0 24))
    ((b! (= t6-2 a0-1) L56 (set! t1-5 1)) (set! t1-5 (the-as none 1)))
    ((b! #t L58 (s.b! (+ v1-0 336) t1-5)) (s.b! (+ v1-0 336) t1-5))
    (label cfg-4)
    ((bl! (zero? t4-1) L54) (set! a1-1 (the-as none t1-4)))

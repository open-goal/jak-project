;;-*-Lisp-*-
(in-package goal)

;; name: level-info.gc
;; name in dgo: level-info
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

(define *default-mood-range* (new 'static 'mood-range :max-cloud 0.5 :max-fog 0.5))

(define *mood-range-1* (new 'static 'mood-range :max-cloud 0.25 :max-fog 0.5))

(define *mood-range-snow* (new 'static 'mood-range :min-cloud 0.25 :max-cloud 0.25 :min-fog 0.5 :max-fog 0.5))

(define default-level (new 'static 'level-load-info
                        :name 'default-level
                        :visname 'default-level-vis
                        :nickname 'default-level
                        :taskname 'default
                        :index 1
                        :level-flags (level-flags sky display-wait)
                        :packages '()
                        :mood-func 'update-mood-default
                        :special-mood #f
                        :ocean #f
                        :draw-priority 10.0
                        :continues '()
                        :callback-list '()
                        :borrow #f
                        :bottom-height (meters -20)
                        :mood-range '*default-mood-range*
                        )
        )

(set! (-> default-level name) #f)

(define intro (new 'static 'level-load-info
                :name 'intro
                :visname 'intro-vis
                :nickname 'int
                :taskname 'default
                :index 2
                :packages '("intro")
                :memory-mode (level-memory-mode tiny)
                :mood-func 'update-mood-default
                :special-mood #f
                :ocean #f
                :draw-priority 10.0
                :continues '()
                :callback-list '()
                :borrow #f
                :bottom-height (meters -10000000)
                :mood-range '*default-mood-range*
                )
        )

(define title (new 'static 'level-load-info
                :name 'title
                :visname 'title-vis
                :nickname 'title
                :taskname 'default
                :index 3
                :level-flags (level-flags title)
                :packages '("dust-stormp" "title")
                :memory-mode (level-memory-mode tiny)
                :mood-func 'update-mood-default
                :special-mood #f
                :ocean #f
                :draw-priority 10.0
                :continues '((new 'static 'continue-point
                    :name "title-start"
                    :level 'title
                    :flags (continue-flags title)
                    :trans (new 'static 'vector :data (new 'static 'array float 4 4014080.0 348160.0 1417216.0 1.0))
                    :camera-trans (new 'static 'vector :data (new 'static 'array float 4 76871.68 55061.707 -938752.0 1.0))
                    :quat (new 'static 'vector4h :data (new 'static 'array int16 4 0 0 0 #x7fff))
                    :camera-rot (new 'static 'array int16 9 #x6fe8 0 #x3e1a -6936 #x7328 #x30d7 -14302 -14299 #x64ae)
                    :on-goto '(apply ,(lambda () (set! (-> *game-info* demo-state) (the-as uint 0)) 0))
                    :vis-nick 'title
                    :vehicle-type #x14
                    :want-count 2
                    :want (new 'static 'inline-array level-buffer-state-small 2
                      (new 'static 'level-buffer-state-small :name 'title :display? 'display)
                      (new 'static 'level-buffer-state-small :name 'wasintro :display? #f)
                      )
                    :want-sound (new 'static 'array symbol 1 #f)
                    )
                  (new 'static 'continue-point
                    :name "title-restart"
                    :level 'title
                    :flags (continue-flags title)
                    :trans (new 'static 'vector :data (new 'static 'array float 4 4014080.0 348160.0 1417216.0 1.0))
                    :camera-trans (new 'static 'vector :data (new 'static 'array float 4 76871.68 55061.707 -938752.0 1.0))
                    :quat (new 'static 'vector4h :data (new 'static 'array int16 4 0 0 0 #x7fff))
                    :camera-rot (new 'static 'array int16 9 #x6fe8 0 #x3e1a -6936 #x7328 #x30d7 -14302 -14299 #x64ae)
                    :on-goto '(begin
                       (want-continue "title-start")
                       (apply ,(lambda () (let ((v0-0 1))
                                            (set! (-> *game-info* demo-state) (the-as uint v0-0))
                                            v0-0
                                            )
                                       )
                              )
                       )
                    :vis-nick 'title
                    :vehicle-type #x14
                    :want-count 2
                    :want (new 'static 'inline-array level-buffer-state-small 2
                      (new 'static 'level-buffer-state-small :name 'title :display? 'display)
                      (new 'static 'level-buffer-state-small :name 'wasintro :display? 'display)
                      )
                    :want-sound (new 'static 'array symbol 1 #f)
                    )
                  (new 'static 'continue-point
                    :name "title-from-intro"
                    :level 'title
                    :flags (continue-flags title vehicle)
                    :trans (new 'static 'vector :data (new 'static 'array float 4 4014080.0 348160.0 1417216.0 1.0))
                    :camera-trans (new 'static 'vector :data (new 'static 'array float 4 76871.68 55061.707 -938752.0 1.0))
                    :quat (new 'static 'vector4h :data (new 'static 'array int16 4 0 0 0 #x7fff))
                    :camera-rot (new 'static 'array int16 9 #x6fe8 0 #x3e1a -6936 #x7328 #x30d7 -14302 -14299 #x64ae)
                    :on-goto '(begin
                       (want-continue "title-start")
                       (apply ,(lambda () (let ((v0-0 3))
                                            (set! (-> *game-info* demo-state) (the-as uint v0-0))
                                            v0-0
                                            )
                                       )
                              )
                       )
                    :vis-nick 'title
                    :vehicle-type #x14
                    :want-count 2
                    :want (new 'static 'inline-array level-buffer-state-small 2
                      (new 'static 'level-buffer-state-small :name 'title :display? 'display)
                      (new 'static 'level-buffer-state-small :name 'wasintro :display? 'display)
                      )
                    :want-sound (new 'static 'array symbol 1 #f)
                    )
                  )
                :callback-list '((35 . desert-deactivate) (34 . desert-activate))
                :borrow #f
                :bottom-height (meters -10000000)
                :mood-range '*default-mood-range*
                )
        )


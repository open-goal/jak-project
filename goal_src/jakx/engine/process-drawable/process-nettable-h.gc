;;-*-Lisp-*-
(in-package goal)

;; name: process-nettable-h.gc
;; name in dgo: process-nettable-h
;; dgos: ENGINE, GAME

;; +++net-flag
(defenum net-flag
  :type uint64
  :bitfield #t
  (registered 0)
  (updated 1)
  )
;; ---net-flag

(declare-type net-process-class-info structure)

(define-extern write-msg-map-rec (function type net-process-class-info none))

;; DECOMP BEGINS

(deftype net-process-class-info (structure)
  ((msg-map            (array symbol))
   (msg-count          int32)
   (send-packet-count  int32)
   (recv-packet-count  int32)
   (send-byte-count    int32)
   (recv-byte-count    int32)
   (owner-type         type)
   )
  )


(define *net-process-class-count* 0)

(define *net-process-class-array*
  (new 'static 'boxed-array :type net-process-class-info :length 0 :allocated-length 96)
  )


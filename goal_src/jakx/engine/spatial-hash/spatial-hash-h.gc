;;-*-Lisp-*-
(in-package goal)

;; name: spatial-hash-h.gc
;; name in dgo: spatial-hash-h
;; dgos: ENGINE, GAME

(declare-type grid-hash-work structure)

;; DECOMP BEGINS

(deftype grid-hash-word (uint8)
  ()
  )

(deftype grid-hash-box (structure)
  "Integer coordinate box for the spatial hash grid."
  ((min  int8  3)
   (max  int8  3)
   )
  :pack-me
  )


(deftype grid-hash (basic)
  ((work                 grid-hash-work)
   (search-box           grid-hash-box  :inline)
   (bucket-size          int16)
   (axis-scale           float          3)
   (dimension-array      int8           3)
   (vertical-cell-count  int8)
   (bucket-array         (pointer grid-hash-word))
   (box-min              float          3)
   (box-max              float          3)
   (object-count         int16)
   (bucket-count         int16)
   (min-cell-size        float)
   (bucket-memory-size   int32)
   (mem-bucket-array     (pointer grid-hash-word))
   (spr-bucket-array     (pointer grid-hash-word))
   (debug-draw           symbol)
   (use-scratch-ram      symbol)
   )
  (:methods
    (new (symbol type int) _type_)
    (grid-hash-method-9 (_type_) none)
    (grid-hash-method-10 (_type_) none)
    (grid-hash-method-11 (_type_) none)
    (grid-hash-method-12 (_type_) none)
    (grid-hash-method-13 (_type_) none)
    (grid-hash-method-14 (_type_) none)
    (grid-hash-method-15 (_type_) none)
    (grid-hash-method-16 (_type_) none)
    (grid-hash-method-17 (_type_) none)
    (grid-hash-method-18 (_type_) none)
    (grid-hash-method-19 (_type_) none)
    (grid-hash-method-20 (_type_) none)
    (grid-hash-method-21 (_type_ grid-hash-box int) none)
    (grid-hash-method-22 (_type_) none)
    (grid-hash-method-23 (_type_) none)
    (grid-hash-method-24 (_type_) none)
    (grid-hash-method-25 (_type_) none)
    (grid-hash-method-26 (_type_) none)
    )
  )


(deftype find-nav-sphere-ids-params (structure)
  ((bsphere      sphere  :inline)
   (y-threshold  float)
   (len          int16)
   (max-len      int16)
   (mask         uint8)
   (array        (pointer uint8))
   )
  )


(deftype sphere-hash (grid-hash)
  "An extension of grid hash that holds spheres inside of the grid."
  ((sphere-array      (inline-array sphere))
   (max-object-count  int16)
   (pad               int16)
   (mem-sphere-array  uint32)
   (spr-sphere-array  uint32)
   )
  (:methods
    (new (symbol type) _type_)
    (sphere-hash-method-27 (_type_) none)
    (sphere-hash-method-28 (_type_) none)
    (sphere-hash-method-29 (_type_ sphere int) none)
    (sphere-hash-method-30 (_type_) none)
    (sphere-hash-method-31 (_type_) none)
    (sphere-hash-method-32 (_type_ sphere int uint) symbol)
    (sphere-hash-method-33 (_type_ object object object int) symbol)
    (sphere-hash-method-34 (_type_ object object object vector int int) int)
    (sphere-hash-method-35 (_type_) none)
    )
  )


(deftype hash-object-info (structure)
  ((object  basic)
   )
  )


(deftype spatial-hash (sphere-hash)
  "An extension of sphere-hash that associates an object with each sphere."
  ((object-array      (inline-array hash-object-info))
   (mem-object-array  (inline-array hash-object-info))
   (spr-object-array  (inline-array hash-object-info))
   )
  (:methods
    (new (symbol type int int) _type_)
    (spatial-hash-method-36 (_type_ vector vector) none)
    (spatial-hash-method-37 (_type_) none)
    (spatial-hash-method-38 (_type_ collide-prim-core (pointer collide-shape) int) int)
    (spatial-hash-method-39 (_type_ vector (pointer collide-shape) int) none)
    (spatial-hash-method-40 (_type_) none)
    (spatial-hash-method-41 (_type_) none)
    )
  )

;; og:preserve-this
(define-extern *actor-hash* spatial-hash)
;; WARN: Return type mismatch int vs object.
(defun update-high-scores ((arg0 float))
  (let ((a0-1 (get-open-task-node-info)))
    (when a0-1
      (when (nonzero? (-> a0-1 high-scores))
        (let ((v1-1 (-> a0-1 high-scores)))
          (cond
            ((logtest? (game-task-node-flag score-lower-is-better) (-> a0-1 flags))
             (dotimes (a0-4 5)
               (when (or (= (-> v1-1 a0-4) 0.0) (< arg0 (fabs (-> v1-1 a0-4))))
                 (let ((a1-8 4))
                   (while (< a0-4 a1-8)
                     (set! (-> v1-1 a1-8) (-> v1-1 (+ a1-8 -1)))
                     (+! a1-8 -1)
                     )
                   )
                 (set! (-> v1-1 a0-4) (- arg0))
                 (return (the-as object a0-4))
                 )
               )
             (the-as int #f)
             )
            (else
              (dotimes (a0-5 5)
                (when (< (fabs (-> v1-1 a0-5)) arg0)
                  (let ((a1-15 4))
                    (while (< a0-5 a1-15)
                      (set! (-> v1-1 a1-15) (-> v1-1 (+ a1-15 -1)))
                      (+! a1-15 -1)
                      )
                    )
                  (set! (-> v1-1 a0-5) (- arg0))
                  (return (the-as object a0-5))
                  )
                )
              (the-as int #f)
              )
            )
          )
        )
      )
    )
  )

(define *last-medal* 0)

(defun report-score ((arg0 float))
  (local-vars (v0-3 int))
  (let ((s5-0 (get-open-task-node-info))
        (s4-0 0)
        )
    (let ((gp-0 (-> s5-0 medals 0)))
      (let ((s2-0 (if (and (= *game-mode* 'adventure) (logtest? (-> *game-info* secrets) (game-secrets hero-mode)))
                      1
                      0

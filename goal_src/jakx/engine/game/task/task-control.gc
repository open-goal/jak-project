                           (else
                             (set! *last-medal* 0)
                             0
                             )
                           )
                         (return 1)
                         )
                        )
                      )
                     (else
                       (cond
                         ((>= arg0 (-> s5-0 gold-array s2-0))
                          (let ((v1-40 3))
                            (if (and (< (the-as uint (-> s5-0 medals 0)) (the-as uint v1-40)) (not (-> *game-info* playing-grand-prix?)))
                                (set! (-> s5-0 medals 0) (the-as game-task-medal v1-40))
                                )
                            )
                          (cond
                            ((>= (the-as uint 3) (the-as uint gp-0))
                             (set! *last-medal* 3)
                             )
                            (else
                              (set! *last-medal* 0)
                              0
                              )
                            )
                          (return 3)
                          )
                         ((>= arg0 (-> s5-0 silver-array s2-0))
                          (let ((v1-48 2))
                            (if (and (< (the-as uint (-> s5-0 medals 0)) (the-as uint v1-48)) (not (-> *game-info* playing-grand-prix?)))
                                (set! (-> s5-0 medals 0) (the-as game-task-medal v1-48))
                                )
                            )
                          (cond
                            ((>= (the-as uint 2) (the-as uint gp-0))
                             (set! *last-medal* 2)

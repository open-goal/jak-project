                         ((>= arg0 (-> s5-0 bronze-array s2-0))
                          (let ((v1-56 1))
                            (if (and (< (the-as uint (-> s5-0 medals 0)) (the-as uint v1-56)) (not (-> *game-info* playing-grand-prix?)))
                                (set! (-> s5-0 medals 0) (the-as game-task-medal v1-56))

                        ((>= (-> s5-0 bronze-array s2-0) arg0)
                         (let ((v1-32 1))
                           (if (and (< (the-as uint (-> s5-0 medals 0)) (the-as uint v1-32)) (not (-> *game-info* playing-grand-prix?)))
                               (set! (-> s5-0 medals 0) (the-as game-task-medal v1-32))
                               )
                           )
                         (cond
                           ((>= (the-as uint 1) (the-as uint gp-0))
                            (set! *last-medal* 1)

        (when s5-0
          (if (or (= *game-mode* 'adventure)
                  (= (-> s5-0 user-advanced-options lword) (-> s5-0 default-advanced-options lword))
                  )
              (update-high-scores arg0)
              )
          (set! s4-0
                (cond
                  ((and (not (demo?)) (= *game-mode* 'adventure))
                   (cond
                     ((logtest? (game-task-node-flag score-lower-is-better) (-> s5-0 flags))
                      (cond
                        ((>= (-> s5-0 gold-array s2-0) arg0)

       )
      )
    (let ((v1-10 (-> self buffer)))
      (set! (-> v1-10 current) (-> v1-10 base))
      )
    (label cfg-5)
    (set! (-> self result) (mc-load-ghost (-> self card) *mc-ghost-idx* (-> self buffer base)))
    (format #t "mc-load-ghost returned ~D~%" (-> self result))
    (when (!= (-> self result) (mc-status-code ok))
      (suspend)
      (goto cfg-5)
      )
    (let ((gp-0 0))
      (until #f
        (set! (-> self result) (mc-check-result))
        (format #t "mc-check-result returned ~D~%" (-> self result))
        (case (-> self result)
          (((mc-status-code busy))
           )
          (((mc-status-code ok))
           (goto cfg-22)
           )
          (((mc-status-code read-error))
           (+! gp-0 (- (-> *display* real-clock frame-counter) (-> *display* real-clock old-frame-counter)))
           (set! s5-0 (cond
                        ((< gp-0 300)
                         (suspend)
                         s5-0
                         )
                        (else
                          (go-virtual error (-> self result))
                          )
                        )
                 )
           )
          (((mc-status-code new-game))
           (go-virtual error (mc-status-code no-save))
           )
          (else
            (go-virtual error (-> self result))
            )
          )
        (suspend)
        )
      )
    #f
    (label cfg-22)
    (format #t "rc=~D~%" (-> self result))
    (mem-copy! *mc-ghost-ptr* (-> self buffer base) #x2800)
    (format #t "done~%")
    (go-virtual done)
    )
  :post auto-save-post
  )

(deftype auto-save-error-proc (process-drawable)
  ((error  symbol)
   (bmask  process-mask)
   )
  )


(defstate auto-idle (auto-save-error-proc)
  :enter (behavior ()
    (set! (-> self bmask) (-> *setting-control* user-default process-mask))
    (when (not (and *net-mgr* (or (nonzero? (-> *net-mgr* lobby-state connect-handle))
                                  (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'hosting-game))
                                  (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'connecting-to-game))
                                  (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'joining-game))
                                  (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'playing-game))
                                  (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'leaving-game))
                                  )
                    )
               )
      (sound-group-pause (the-as sound-group #xffffffff))
      (add-setting! 'process-mask 'set 0.0 (process-mask pause))
      )
    )
  :exit (behavior ()
    (sound-group-continue (the-as sound-group #xffffffff))
    )
  :trans (behavior ()
    (buzz-stop! 0)
    (buzz-stop! 1)
    (when (or (not *fmv-player*) (!= (-> *fmv-player* state name) 'idle))
      (with-dma-buffer-add-bucket ((s5-0 (-> *display* frames (-> *display* on-screen) global-buf))
                                   (bucket-id bucket795)
                                   )
        (let ((v1-11 (-> *viewport-array* default))
              (s4-0 *font-context*)
              )
          (dma-buffer-add-gs-set s5-0
                                 (test-1 (new 'static 'gs-test :ate #x1 :afail #x3 :zte #x1 :ztst (gs-ztest always)))
                                 (frame-1 (-> v1-11 frame))
                                 (zbuf-1 (-> v1-11 zbuf-on))
                                 (scissor-1 (-> v1-11 scissor))
                                 )
          (set-width! s4-0 384)
          (set-scale! s4-0 0.4)
          (set! (-> s4-0 flags) (font-flags kerning middle middle-vert large ff12))
          (let ((a0-9 s4-0))
            (set! (-> a0-9 effect) (the-as uint 0))
            )
          (let ((a0-10 s4-0))
            (set! (-> a0-10 color) (font-color white))
            )
          (let ((t1-0 #x28000000))
            (draw-sprite2d-xy s5-0 0 0 512 416 (the-as rgba t1-0) #x3fffff)
            )
          (cond
            ((= (-> self error) 'card-removed)
             (let ((t1-1 #x60604020))
               (draw-sprite2d-xy s5-0 64 148 384 120 (the-as rgba t1-1) #x3fffff)
               )
             (set-origin! s4-0 64 148)
             (set-height! s4-0 30)
             (print-game-text
               (lookup-text! *common-text* (text-id text-id-177) #f)
               *font-context*
               #f
               44
               (bucket-id bucket787)
               #f
               s5-0
               )
             (set-origin! s4-0 64 168)
             (set-height! s4-0 60)
             (print-game-text
               (lookup-text! *common-text* (text-id text-id-178) #f)
               *font-context*
               #f
               44
               (bucket-id bucket787)
               #f
               s5-0
               )
             (set-origin! s4-0 64 228)
             (set! (-> s4-0 height) (the float 30))
             (print-game-text
               (lookup-text! *common-text* (text-id text-id-124) #f)
               *font-context*
               #f
               44
               (bucket-id bucket787)
               #f
               s5-0
               )
             )
            (else
              (let ((t1-5 #x60604020))
                (draw-sprite2d-xy s5-0 64 108 384 200 (the-as rgba t1-5) #x3fffff)
                )
              (set-origin! s4-0 64 108)
              (set-height! s4-0 30)
              (print-game-text
                (lookup-text! *common-text* (text-id text-id-171) #f)
                *font-context*
                #f
                44
                (bucket-id bucket787)
                #f
                s5-0
                )
              (set-origin! s4-0 64 138)
              (set-height! s4-0 40)
              (let ((s3-3 print-game-text))
                (format (clear *temp-string*) (lookup-text! *common-text* (text-id text-id-174) #f) 1)
                (s3-3 *temp-string* *font-context* #f 44 (bucket-id bucket787) #f s5-0)
                )
              (set-origin! s4-0 64 178)
              (set-height! s4-0 30)
              (print-game-text
                (lookup-text! *common-text* (text-id text-id-177) #f)
                *font-context*
                #f
                44
                (bucket-id bucket787)
                #f
                s5-0
                )
              (set-origin! s4-0 64 208)
              (set-height! s4-0 70)
              (print-game-text
                (lookup-text! *common-text* (text-id text-id-178) #f)
                *font-context*
                #f
                44
                (bucket-id bucket787)
                #f
                s5-0
                )
              (set-origin! s4-0 64 278)
              (set-height! s4-0 30)
              (print-game-text
                (lookup-text! *common-text* (text-id text-id-124) #f)
                *font-context*
                #f
                44
                (bucket-id bucket787)
                #f
                s5-0
                )
              )
            )
          )
        )
      )
    )
  :code (behavior ()
    (set-time! (-> self state-time))
    (until #f
      (when (cpad-pressed? 0 x)
        (logclear! (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons x))
        (logclear! (-> *cpad-list* cpads 0 button0-rel 0) (pad-buttons x))
        (return #f)
        )
      (suspend)
      )
    #f
    )
  )

(defbehavior auto-save-error-proc-init-by-other auto-save-error-proc ((arg0 symbol))
  (set! (-> self error) arg0)
  (logclear! (-> self mask) (process-mask pause))
  (go auto-idle)
  )

(defun progress-allowed? ()
  (not (or (-> *setting-control* user-current talking)
           (handle->process (-> *game-info* pov-camera-handle))
           (handle->process (-> *game-info* other-camera-handle))
           (< (-> *display* base-clock frame-counter) (-> *game-info* letterbox-time))
           (< (-> *display* base-clock frame-counter) (-> *game-info* blackout-time))
           (!= (-> *setting-control* user-current bg-a) 0.0)
           (or (!= (-> *setting-control* user-current bg-a-force) 0.0)
               (-> *setting-control* user-current mpeg-mode?)
               (= *cheat-mode* 'camera)
               (= *master-mode* 'freeze)
               *master-exit*
               (not *common-text*)
               *dnas-is-running*
               (< (memory-free *nk-dead-pool*) #x8000)
               )
           )
       )
  )

(defstate error (auto-save)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('progress-allowed?)
       #t
       )
      (('die)
       (deactivate self)
       )
      )
    )
  :code (behavior ((arg0 mc-status-code))
    (format #t "error~%")
    (if (-> self buffer)
        (reserve-free *art-control* (-> self buffer))
        )
    (set! (-> self result) arg0)
    (let ((s5-0 *auto-save-info*))
      (mem-copy! (the-as pointer s5-0) (the-as pointer (-> self info)) 428)
      (set! *mc-last-result* (-> self result))
      (send-event (handle->process (-> self notify)) 'notify 'error (-> self result) s5-0)
      )
    (let ((t9-4 format)
          (a0-9 #t)
          (a1-4 "SAVE ERROR: ~A~%")
          (v1-14 (-> self result))
          )
      (t9-4 a0-9 a1-4 (cond
                        ((= v1-14 (mc-status-code bad-version))
                         "bad-version"
                         )
                        ((= v1-14 (mc-status-code no-save))
                         "no-save"
                         )
                        ((= v1-14 (mc-status-code no-last))
                         "no-last"
                         )
                        ((= v1-14 (mc-status-code no-space))
                         "no-space"
                         )
                        ((= v1-14 (mc-status-code internal-error))
                         "internal-error"
                         )
                        ((= v1-14 (mc-status-code no-memory))
                         "no-memory"
                         )
                        ((= v1-14 (mc-status-code bad-handle))
                         "bad-handle"
                         )
                        ((= v1-14 (mc-status-code busy))
                         "busy"
                         )
                        ((= v1-14 (mc-status-code write-error))
                         "write-error"
                         )
                        ((= v1-14 (mc-status-code read-error))
                         "read-error"
                         )
                        ((= v1-14 (mc-status-code no-card))
                         "no-card"
                         )
                        ((= v1-14 (mc-status-code no-format))
                         "no-format"
                         )
                        ((= v1-14 (mc-status-code ok))
                         "ok"
                         )
                        ((= v1-14 (mc-status-code no-process))
                         "no-process"
                         )
                        ((= v1-14 (mc-status-code no-auto-save))
                         "no-auto-save"
                         )
                        ((= v1-14 (mc-status-code no-file))
                         "no-file"
                         )
                        ((= v1-14 (mc-status-code format-failed))
                         "format-failed"
                         )
                        ((= v1-14 (mc-status-code new-game))
                         "new-game"
                         )
                        (else
                          "*unknown*"
                          )
                        )
            )
      )
    (if (= (-> self result) (mc-status-code no-auto-save))
        (return #f)
        )
    (case (-> self mode)
      (('auto-save 'error 'save-ghost 'restore-ghost)
       (set! (-> self state-time) (-> *display* real-clock frame-counter))
       (set! (-> *game-info* auto-save-status) arg0)
       (while (< (- (-> *display* real-clock frame-counter) (-> self state-time)) (seconds 0.2))
         (if (not (progress-allowed?))
             (set! (-> self state-time) (-> *display* real-clock frame-counter))
             )
         (suspend)
         )
       (if (= arg0 (mc-status-code no-card))
           (process-spawn auto-save-error-proc 'card-removed :name "auto-save-error-proc" :from *nk-dead-pool*)
           (process-spawn auto-save-error-proc 'error-auto-saving :name "auto-save-error-proc" :from *nk-dead-pool*)
           )
       )
      )
    )
  :post auto-save-post
  )

(defstate done (auto-save)
  :virtual #t
  :code (behavior ()
    (if (and (-> self buffer)
             (or (-> *art-control* reserve-buffer) (nonzero? (-> *art-control* dma-reserve-buffer-count)))
             )
        (reserve-free *art-control* (-> self buffer))
        )
    (set! (-> *game-info* auto-save-status) (mc-status-code ok))
    (case (-> self mode)
      (('save 'save-last 'auto-save 'restore)
       (b! (not #t) cfg-17 :delay (empty-form))
       (set! (-> *setting-control* user-default auto-save) #t)
       (set! (-> *game-info* auto-save-card) (-> self card))
       (set! (-> *game-info* auto-save-which) (-> self which))
       (b! #t cfg-26 :delay (nop!))
       (label cfg-17)
       (if (and (-> self starting-auto-save-status)
                (not (and (= (-> *game-info* auto-save-card) (-> self card)) (= (-> *game-info* auto-save-which) (-> self which)))
                     )
                )
           (set! (-> *setting-control* user-default auto-save) #t)
           )
       )
      )
    (label cfg-26)
    (case (-> self mode)
      (('auto-save 'restore-common 'save-common)
       )
      (else
        (set! (-> *game-info* auto-save-proc) (the-as handle #f))
        )
      )
    (let ((gp-0 *auto-save-info*))
      (mem-copy! (the-as pointer gp-0) (the-as pointer (-> self info)) 428)
      (set! *mc-last-result* (mc-status-code ok))
      (send-event (handle->process (-> self notify)) 'notify 'done (mc-status-code ok) gp-0)
      )
    )
  :post auto-save-post
  )

;; WARN: Return type mismatch (pointer process) vs (pointer auto-save).
(defun auto-save-command ((arg0 symbol) (arg1 int) (arg2 int) (arg3 process-tree) (arg4 symbol) (arg5 symbol))
  (the-as (pointer auto-save) (when (not (handle->process (-> *game-info* auto-save-proc)))
                                (format #t "AUTO SAVE COMMAND ~S~%" arg0)
                                (process-spawn
                                  auto-save
                                  arg0
                                  arg3
                                  arg1
                                  arg2
                                  arg4
                                  arg5
                                  :name "auto-save"
                                  :to *target-pool*
                                  :stack *kernel-dram-stack*
                                  )
                                )
          )
  )

(defun auto-save-check ()
  (when (and (-> *setting-control* user-current auto-save) (not (handle->process (-> *game-info* auto-save-proc))))
    (mc-get-slot-info 0 *auto-save-info*)
    (if (and (nonzero? (-> *auto-save-info* known))
             (or (zero? (-> *auto-save-info* handle)) (!= (-> *auto-save-info* handle) (-> *game-info* auto-save-card)))
             )
        (auto-save-command 'error 0 0 *default-pool* #f #f)
        )
    )
  0
  )

(defun auto-save-user ()
  (cond
    ((and *scene-player*
          (not (and (-> *scene-player* 0 next-state) (= (-> *scene-player* 0 next-state name) 'release)))
          )
     (the-as (pointer auto-save) #f)
     )
    (else
      (case *kernel-boot-message*
        (('play 'preview)
         (auto-save-command 'auto-save 0 0 *default-pool* #f #f)
         )
        )
      )
    )
  )

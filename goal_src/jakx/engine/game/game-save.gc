(defmethod save-to-file ((this game-save) (arg0 string))
  (let ((s5-0 (new 'stack 'file-stream arg0 'write)))
    (file-stream-write s5-0 (&-> this type) (+ (-> this type size) (-> this length)))
    (file-stream-close s5-0)
    )
  this
  )

(defmethod load-from-file ((this game-save) (arg0 string))
  (let ((s5-0 (new 'stack 'file-stream arg0 'read)))
    (let ((s3-0 (file-stream-length s5-0))
          (s4-0 (-> this allocated-length))
          )
      (cond
        ((>= (asize-of this) s3-0)
         (cond
           ((= (file-stream-read s5-0 (&-> this type) s3-0) s3-0)
            (set! (-> this type) game-save)
            )
           (else
             (format 0 "ERROR: SAVEGAME: save file ~A did not read correctly.~%" s5-0)
             (set! (-> this length) 0)
             0
             )
           )
         )
        (else
          (format 0 "ERROR: SAVEGAME: save file ~A is too big~%" s5-0)
          )
        )
      (set! (-> this allocated-length) s4-0)
      )
    (when (!= (-> this version) 5)
      (format
        0
        "ERROR: SAVEGAME: save file ~A was version ~d, but only ~d is supported.~%"
        s5-0
        (-> this version)
        5
        )
      (set! (-> this length) 0)
      0
      )
    (file-stream-close s5-0)
    )
  this
  )

(define *auto-save-info* (new 'global 'mc-slot-info))

(deftype auto-save (process)
  ((card                       int32)
   (slot                       int32)
   (which                      int32)
   (buffer                     kheap)
   (mode                       symbol)
   (starting-auto-save-status  symbol)
   (result                     mc-status-code)
   (save                       game-save)
   (info                       mc-slot-info  :inline)
   (notify                     handle)
   (force                      symbol)
   (state-time                 time-frame)
   (icon                       hud-sprite    :inline)
   (icon-gui-id                sound-id)
   (message-gui-id             sound-id)
   (game-name                  uint8         16)
   )
  (:state-methods
    get-heap
    get-card
    format-card
    unformat-card
    create-file
    save
    restore
    save-common
    restore-common
    save-ghost
    restore-ghost
    save-patch
    (error mc-status-code)
    done
    )
  )


(defmethod deactivate ((this auto-save))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (dma-release 'game-save)
  (set! *mc-last-result* (-> this result))
  (call-parent-method this)
  (none)
  )

(defbehavior auto-save-post auto-save ()
  (when (and (= *cheat-mode* 'debug) (cpad-hold? 0 l3))
    (let ((gp-0 (new
                  'stack
                  'font-context
                  *font-default-matrix*
                  32
                  320
                  8396850.0
                  (font-color default)
                  (font-flags shadow kerning)
                  )
                )
          )
      (set-width! gp-0 440)
      (set-height! gp-0 80)
      (set! (-> gp-0 flags) (font-flags shadow kerning))
      (format (clear *temp-string*) "~S / ~S ~D~%" (-> self mode) (-> self state name) (-> self which))
      (print-game-text *temp-string* gp-0 #f 44 (bucket-id bucket787) #f (the-as dma-buffer #f))
      )
    )
  (when (and (or (= (-> self mode) 'auto-save)
                 (= (-> self mode) 'save-common)
                 (= (-> self mode) 'save-patch)
                 (= (-> self mode) 'save-ghost)
                 )
             (not (and (-> self next-state) (= (-> self next-state name) 'done)))
             )
    (let ((gp-1 (new
                  'stack
                  'font-context
                  *font-default-matrix*
                  20
                  80
                  8396850.0
                  (font-color default)
                  (font-flags shadow kerning)
                  )
                )
          )
      (set-scale! gp-1 0.8)
      (set-width! gp-1 432)
      (set-height! gp-1 20)
      (set! (-> gp-1 flags) (font-flags shadow kerning middle middle-vert large))
      (when (and (>= 1 (-> *game-info* auto-save-count))
                 (and (-> self next-state) (= (-> self next-state name) 'save))
                 (begin
                   (if (zero? (-> self message-gui-id))
                       (set! (-> self message-gui-id) (add-process
                                                        *gui-control*
                                                        self
                                                        (gui-channel hud-auto-save-message)
                                                        (gui-action play)
                                                        (-> self name)
                                                        81920.0
                                                        0
                                                        )
                             )
                       )
                   (= (get-status *gui-control* (-> self message-gui-id)) (gui-status active))
                   )
                 )
        (set! (-> gp-1 origin x) 20.0)
        (set! (-> gp-1 origin y) 130.0)
        (set-scale! gp-1 0.7)
        (set! (-> gp-1 height) (the float 200))
        )
      )
    (when (and (< (mod (-> *display* real-clock frame-counter) 300) 270)
               (= (get-status *gui-control* (-> self icon-gui-id)) (gui-status active))
               )
      (with-dma-buffer-add-bucket ((s5-1 (-> *display* frames (-> *display* on-screen) global-buf))
                                   (bucket-id bucket787)
                                   )
        (-> self icon)
        (let ((t9-8 (method-of-type hud-sprite hud-sprite-method-9)))
          (-> self level)
          (t9-8)
          )
        )
      )
    )
  )

(defbehavior auto-save-init-by-other auto-save ((arg0 symbol) (arg1 process) (arg2 int) (arg3 int) (arg4 symbol) (arg5 string))
  (when (handle->process (-> *game-info* auto-save-proc))
    (set! *mc-last-result* (mc-status-code no-process))
    (send-event arg1 'notify 'error (mc-status-code no-process))
    (return #f)
    )

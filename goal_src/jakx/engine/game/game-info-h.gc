                                         (new 'static 'level-buffer-state-small)
                                         (new 'static 'level-buffer-state-small)
                                         (new 'static 'level-buffer-state-small)
                                         (new 'static 'level-buffer-state-small)
                                         )
                                 )
    (new 'static 'continue-point :want (new 'static 'inline-array level-buffer-state-small 16
                                         (new 'static 'level-buffer-state-small)
                                         (new 'static 'level-buffer-state-small)
                                         (new 'static 'level-buffer-state-small)
                                         (new 'static 'level-buffer-state-small)
                                         (new 'static 'level-buffer-state-small)
                                         (new 'static 'level-buffer-state-small)

(defmethod update! ((this setting-control))
  (run-pending-updates! (-> this engine-pers) (-> *display* base-clock frame-counter))
  (if (not (paused?))
      (speech-control-method-10 *speech-control*)
      )
  (apply-settings! this)
  (let ((s3-0 (-> this user-default))
        (s5-0 (-> this user-current))
        )
    (let ((s4-0 (-> this user-target)))
      (seek!
        (-> s5-0 dynamic-ambient-volume)
        (-> s4-0 dynamic-ambient-volume)
        (-> *display* real-clock seconds-per-frame)
        )
      (when *sound-player-enable*
        (when (or *debug-segment* (!= (-> s5-0 sfx-volume) (-> s4-0 sfx-volume)))
          (seek! (-> s5-0 sfx-volume) (-> s4-0 sfx-volume) (-> *display* real-clock seconds-per-frame))
          (sound-set-volume (sound-group sfx) (* (-> s5-0 sfx-volume) *settings-sfx-volume*))
          )
        (when (or *debug-segment* (!= (-> s5-0 music-volume) (-> s4-0 music-volume)))
          (seek!
            (-> s5-0 music-volume)
            (-> s4-0 music-volume)
            (* *settings-music-seek-speed* (-> *display* real-clock seconds-per-frame))
            )
          (sound-set-volume (sound-group music) (* (-> s5-0 music-volume) *settings-music-volume*))
          )
        (when (or *debug-segment* (!= (-> s5-0 dialog-volume) (-> s4-0 dialog-volume)))
          (seek! (-> s5-0 dialog-volume) (-> s4-0 dialog-volume) (-> *display* real-clock seconds-per-frame))
          (sound-set-volume (sound-group dialog dialog2) (* (-> s5-0 dialog-volume) *settings-dialog-volume*))
          )
        (when (!= (-> s5-0 ambient-volume) (-> s4-0 ambient-volume))
          (seek! (-> s5-0 ambient-volume) (-> s4-0 ambient-volume) (-> *display* real-clock seconds-per-frame))
          (sound-set-volume (sound-group ambient) (-> s5-0 ambient-volume))
          )
        (when (!= (-> s5-0 special-volume) (-> s4-0 special-volume))
          (seek! (-> s5-0 special-volume) (-> s4-0 special-volume) (-> *display* real-clock seconds-per-frame))
          (sound-set-volume (sound-group special) (-> s5-0 special-volume))
          )
        (when (!= (-> s5-0 unknown-volume) (-> s4-0 unknown-volume))
          (seek! (-> s5-0 unknown-volume) (-> s4-0 unknown-volume) (-> *display* real-clock seconds-per-frame))
          (sound-set-volume (sound-group sog7) (-> s5-0 unknown-volume))
          )
        )
      (when (!= (-> s5-0 language) (-> s4-0 language))
        (kset-language (-> s4-0 language))
        (set! (-> s5-0 language) (-> s4-0 language))
        )
      (when (and (!= (-> s5-0 audio-language) (-> s4-0 audio-language)) (zero? (rpc-busy? 2)))
        (set! (-> s5-0 audio-language) (-> s4-0 audio-language))
        (case (-> s5-0 audio-language)
          (((language-enum uk-english)
            (language-enum korean)
            (language-enum russian)
            (language-enum dutch)
            (language-enum portuguese)
            )
           (set-language (language-enum english))
           )
          (else
            (set-language (-> s5-0 audio-language))
            )
          )
        )
      (set! (-> s5-0 subtitle-language) (-> s4-0 subtitle-language))
      (when (!= (-> s5-0 stereo-mode) (-> s4-0 stereo-mode))
        (set! (-> s5-0 stereo-mode) (-> s4-0 stereo-mode))
        (sound-set-stereo-mode (-> s5-0 stereo-mode))
        )
      (if (!= (-> s5-0 sound-reverb-mode) (-> s4-0 sound-reverb-mode))
          (set! (-> s5-0 sound-reverb-mode) (-> s4-0 sound-reverb-mode))
          )
      (when (!= (-> s5-0 sound-reverb-seek-speed) (-> s4-0 sound-reverb-seek-speed))
        (cond
          ((= (-> s4-0 sound-reverb) 0.0)
           (set! (-> s5-0 sound-reverb-seek-speed) (* (-> s3-0 sound-reverb-seek-speed) (-> s5-0 sound-reverb)))
           )
          (else
            (let ((f0-48 0.0))
              (let ((v1-69 (handle->process (-> *game-info* player-info 0 vehicle))))
                (if v1-69
                    (set! f0-48
                          (lerp-scale 0.0 2.0 (vector-length (-> (the-as process-drawable v1-69) root transv)) 0.0 409600.0)
                          )
                    )
                )
              (set! (-> s5-0 sound-reverb-seek-speed)
                    (* (+ (-> s4-0 sound-reverb-seek-speed) f0-48) (-> s4-0 sound-reverb))
                    )
              )
            )
          )
        )
      (when (and (!= (-> s4-0 music) (-> s5-0 music))
                 (zero? (rpc-busy? 2))
                 (or (not (-> s4-0 music)) (and (< 0.0 (-> s5-0 music-volume)) (not (-> s5-0 movie))))
                 (not *master-exit*)
                 )
        (cond
          ((-> s4-0 music)
           (format 0 "Load music ~A~%" (-> s4-0 music))
           (sound-music-load (string->sound-name (symbol->string (-> s4-0 music))))
           )
          (else
            (format 0 "Unload music~%")
            (sound-music-unload)
            )
          )
        (set! (-> s5-0 music) (-> s4-0 music))
        )
      (when *sound-player-enable*
        (when (!= (-> s5-0 sound-reverb) (-> s4-0 sound-reverb))
          (seek!
            (-> s5-0 sound-reverb)
            (-> s4-0 sound-reverb)
            (* (-> s5-0 sound-reverb-seek-speed) (-> *display* real-clock seconds-per-frame))
            )
          (sound-set-reverb (-> s4-0 sound-reverb-mode) (-> s5-0 sound-reverb) (-> s5-0 sound-reverb) (the-as uint 3))
          )
        )
      (seek! (-> s5-0 scanlines) (-> s4-0 scanlines) (* 2.0 (-> *display* real-clock seconds-per-frame)))
      (set! (-> s5-0 fog-special-interp-rate) (-> s4-0 fog-special-interp-rate))
      (set! (-> s5-0 fog-special-interp-targ) (fmax 0.0 (fmin 2.0 (-> s4-0 fog-special-interp-targ))))
      (set! (-> s5-0 dust-storm-fog-scalar) (-> s4-0 dust-storm-fog-scalar))
      (set! (-> s5-0 city-heap-load) (-> s4-0 city-heap-load))
      (seek!
        (-> s5-0 dust-storm-sound-scalar)
        (-> s4-0 dust-storm-sound-scalar)
        (/ (-> *display* real-clock seconds-per-frame) 2)
        )
      (set! (-> s5-0 ambient-wind-scalar) (-> s4-0 ambient-wind-scalar))
      (set! (-> s5-0 halfpipe-jump-mult) (-> s4-0 halfpipe-jump-mult))
      (set! (-> s5-0 board-max-speed) (-> s4-0 board-max-speed))
      (set! (-> s5-0 sound-ear-scale) (-> s4-0 sound-ear-scale))
      (if (!= (-> s5-0 aspect-ratio) (-> s4-0 aspect-ratio))
          (set! (-> s5-0 aspect-ratio) (-> s4-0 aspect-ratio))
          )
      (when (!= (-> s5-0 smode2) (-> s4-0 smode2))
        (set! (-> s5-0 smode2) (-> s4-0 smode2))
        (set! (-> *video-params* set-video-mode) #t)
        )
      (if (!= (-> s5-0 crash-cam) (-> s4-0 crash-cam))
          (set! (-> s5-0 crash-cam) (-> s4-0 crash-cam))
          )
      (when (!= (-> s5-0 video-mode) (-> s4-0 video-mode))
        (set! (-> s5-0 video-mode) (-> s4-0 video-mode))
        (set-video-mode (-> s5-0 video-mode))
        )
      (when (!= (-> s5-0 screenx) (-> s4-0 screenx))
        (set! (-> s5-0 screenx) (-> s4-0 screenx))
        (set! (-> *video-params* display-dx) (/ (-> s4-0 screenx) 2))
        )
      (when (!= (-> s5-0 screeny) (-> s4-0 screeny))
        (set! (-> s5-0 screeny) (-> s4-0 screeny))
        (set! (-> *video-params* display-dy) (* (/ (-> s4-0 screeny) 2) 2))
        )
      (set-horizontal-flip-flag
        *blit-displays-work*
        (logtest? (-> *game-info* secrets) (game-secrets hflip-screen))
        )
      (set! (-> s5-0 letterbox-speed) (-> s4-0 letterbox-speed))
      (seek!
        (-> s5-0 letterbox)
        (-> s4-0 letterbox)
        (* (-> s4-0 letterbox-speed) (-> *display* real-clock seconds-per-frame))
        )
      (set! (-> s5-0 allow-blackout) (-> s4-0 allow-blackout))
      (set! (-> s5-0 bg-a-speed) (-> s4-0 bg-a-speed))
      (set! (-> s5-0 bg-a-force) (-> s4-0 bg-a-force))
      (set! (-> s5-0 bg-r) (-> s4-0 bg-r))
      (set! (-> s5-0 bg-g) (-> s4-0 bg-g))
      (set! (-> s5-0 bg-b) (-> s4-0 bg-b))
      (seek! (-> s5-0 bg-a) (-> s4-0 bg-a) (* (-> s4-0 bg-a-speed) (-> *display* real-clock seconds-per-frame)))
      (let ((s3-2 *display*))
        (let ((f0-95 (-> s5-0 bg-a)))
          (if (!= (-> s5-0 bg-a-force) 0.0)
              (set! f0-95 (-> s5-0 bg-a-force))
              )
          (if (not (-> s5-0 allow-blackout))
              (set! f0-95 0.0)
              )
          (cond
            ((< 1.1 f0-95)
             (let ((v1-141 *display*))
               (set! (-> v1-141 bgcolor r) 0)
               (set! (-> v1-141 bgcolor g) 0)
               (set! (-> v1-141 bgcolor b) 0)
               (set! (-> v1-141 pmode alp) 0)
               )
             )
            (else
              (let ((v1-142 *display*))
                (set! (-> v1-142 bgcolor r) 0)
                (set! (-> v1-142 bgcolor g) 0)
                (set! (-> v1-142 bgcolor b) 0)
                (set! (-> v1-142 pmode alp) 255)
                )
              (when (and (>= (+ -300000 (-> *display* real-clock frame-counter)) (seconds 0.1))
                         (not (-> *setting-control* user-current mpeg-mode?))
                         )
                (let* ((v1-150 (the int (* 255.0 f0-95)))
                       (s1-0 (-> *display* frames (-> *display* on-screen) global-buf))
                       (s2-3 (-> s1-0 base))
                       )
                  (let* ((a1-39 0)
                         (a0-96 0)
                         (t0-1 (logior (logand a1-39 (the-as uint #xffffffff00ffffff)) (shr (shl v1-150 56) 32)))
                         )
                    (logior (logand a0-96 (the-as uint #xffffffff00ffffff)) (shr
                                                                              (shl
                                                                                (if (< v1-150 128)
                                                                                    0
                                                                                    (* (+ v1-150 -128) 2)
                                                                                    )
                                                                                56
                                                                                )
                                                                              32
                                                                              )
                            )
                    (screen-gradient s1-0 (the-as rgba t0-1) (the-as rgba t0-1) (the-as rgba t0-1) (the-as rgba t0-1))
                    )
                  (let ((a3-3 (-> s1-0 base)))
                    (when (!= s2-3 a3-3)
                      (let ((v1-158 (the-as object (-> s1-0 base))))
                        (set! (-> (the-as dma-packet v1-158) dma) (new 'static 'dma-tag :id (dma-tag-id next)))
                        (set! (-> (the-as dma-packet v1-158) vif0) (new 'static 'vif-tag))
                        (set! (-> (the-as dma-packet v1-158) vif1) (new 'static 'vif-tag))
                        (set! (-> s1-0 base) (&+ (the-as pointer v1-158) 16))
                        )
                      (dma-bucket-insert-tag
                        (-> *display* frames (-> *display* on-screen) bucket-group)
                        (bucket-id bucket794)
                        s2-3
                        (the-as (pointer dma-tag) a3-3)
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        (set! (-> s3-2 run-half-speed) (-> s5-0 half-speed))
        )
      (set! (-> s5-0 blur-a-speed) (-> s4-0 blur-a-speed))
      (set! (-> s5-0 fog-speed) (-> s4-0 fog-speed))
      (seek!
        (-> s5-0 fog-mult)
        (-> s4-0 fog-mult)
        (* (-> s5-0 fog-speed) (-> *display* real-clock seconds-per-frame))
        )
      (set! (-> s5-0 spotlight-color) (-> s4-0 spotlight-color))
      (set! (-> s5-0 highlight-color) (-> s4-0 highlight-color))
      (set! (-> s5-0 minimap-level) (-> s4-0 minimap-level))
      (set! (-> s5-0 timer-warn-seconds) (-> s4-0 timer-warn-seconds))
      (set! (-> s5-0 gem-pool-index) (-> s4-0 gem-pool-index))
      (set! (-> s5-0 override-capture-mode?) (-> s4-0 override-capture-mode?))
      (set! (-> s5-0 mpeg-mode?) (-> s4-0 mpeg-mode?))
      (set! (-> s5-0 blur-enabled?) (-> s4-0 blur-enabled?))
      (set! (-> s5-0 event-finished?) (-> s4-0 event-finished?))
      (set! (-> *texture-pool* common-page-mask) (-> s5-0 common-page))
      (set! (-> *cpad-list* cpads 0 buzz) (-> s5-0 vibration))
      (set! (-> *cpad-list* cpads 1 buzz) (-> s5-0 vibration))
      (set! (-> s5-0 fog-override) (-> s4-0 fog-override))
      (set! (-> s5-0 rotate-arena-minimap) (-> s4-0 rotate-arena-minimap))
      )
    (set! (-> *mouse* active) (-> s5-0 mouse))
    (set! (-> *mouse* cursor) (and (-> s5-0 mouse) (-> s5-0 cursor)))
    (set! (-> *keybd* active) (-> s5-0 keybd))
    )
  (dotimes (s5-1 2)
    (let ((s4-1 (-> this cam-settings s5-1)))
      (let ((s3-3 (the-as cam-setting-state (-> this cam-settings s5-1 target))))
        (run-pending-updates! (-> this cam-engines s5-1 engine-pers) (-> *display* base-clock frame-counter))
        (set! (-> s4-1 current entity-or-mode-changed) #f)

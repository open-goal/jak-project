        (the-as float (-> s3-0 param 2))
        (the-as uint (-> s3-0 param 3))
        )
      (set! s3-0 (-> s3-0 next))
      )
    )
  (let ((s3-1 (-> arg0 alive-list-end))
        (s2-0 (-> arg0 alive-list-end prev0))
        )
    (while (!= s3-1 (-> arg0 alive-list))
      (let ((s1-0 (-> (the-as connection s3-1) param0)))
        (case s1-0

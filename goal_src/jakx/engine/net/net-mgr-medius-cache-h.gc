;;-*-Lisp-*-
(in-package goal)

;; name: net-mgr-medius-cache-h.gc
;; name in dgo: net-mgr-medius-cache-h
;; dgos: ENGINE, GAME

;; +++medius-cached-info-status
(defenum medius-cached-info-status
  :type uint64
  (free 0)
  (requested 1)
  (busy 2)
  (valid 3)
  (stale 4)
  (error 5)
  )
;; ---medius-cached-info-status


(declare-type medius-cache basic)

(define-extern medius-cache-tick (function medius-cache object))

;; DECOMP BEGINS

(deftype medius-cached-info (basic)
  ((medius-id      int32)
   (accessed-time  int32)
   (fetched-time   int32)
   (status         medius-cached-info-status)
   )
  (:methods
    (get-retrieve-behavior (_type_) (function medius-cached-info object :behavior net-mgr))
    (evict-before? (_type_ medius-cached-info) symbol)
    (has-data? (_type_) symbol)
    )
  )


(deftype medius-cache (basic)
  ((objects  (array medius-cached-info))
   )
  (:methods
    (remove! (_type_ int) none)
    (mark-stale! (_type_ int) none)
    (lookup (_type_ int int symbol symbol) object)
    (clear-objects! (_type_) none)
    (busy? (_type_) symbol)
    (medius-cache-method-14 (_type_) none)
    )
  )


(deftype medius-cache-index (structure)
  ((id  int32)
   )
  :pack-me
  (:methods
    (medius-cache-index-method-9 (_type_) none)
    (get-id (_type_) int)
    )
  )


(deftype medius-cache-index-array (structure)
  ((ct      int32)
   (max-ct  int32)
   (data    medius-cache-index  :inline :dynamic)
   )
  (:methods
    (contains? (_type_ int) symbol)
    (add! (_type_ int) none)
    (remove! (_type_ int) none)
    (move-to-front! (_type_ medius-cache) int)
    )
  )


(defmethod clear-objects! ((this medius-cache))
  (dotimes (v1-0 (-> this objects length))
    (set! (-> this objects v1-0 medius-id) -1)
    (set! (-> this objects v1-0 status) (medius-cached-info-status free))
    )
  0
  (none)
  )

;;-*-Lisp-*-
(in-package goal)

;; name: net-player-h.gc
;; name in dgo: net-player-h
;; dgos: ENGINE, GAME

;; +++net-player-flag
(defenum net-player-flag
  :type uint8
  :bitfield #t
  (endlessfall 0)
  (start-speech 1)
  (finish-speech 2)
  (show-results 3)
  (superhero 4)
  )
;; ---net-player-flag


(declare-type net-game-mgr process)

(define-extern kill-vehicle-hud (function none))
(define-extern spawn-vehicle-hud (function process))
(define-extern spawn-hud-results (function object))
(define-extern clear-local-players (function object))
(define-extern target-camera-active? (function symbol))
(define-extern camera-go-target (function handle object))
(define-extern display-nice-shot-to-view (function int object))
(define-extern spawn-unused-death-indicator-single (function process))
(define-extern spawn-unused-death-indicator-view-1 (function process))
(define-extern spawn-unused-death-indicator-view-2 (function process))

(define-extern *text-display-nice-shot-proc* process)

;; DECOMP BEGINS

(deftype net-player-respawn-info (structure)
  ((position    vector      :inline)
   (quat        quaternion  :inline)
   (velocity    vector      :inline)
   (want-count  int8)
   (want        (inline-array level-buffer-state-small))
   )
  (:methods
    (continue-point<-respawn-info! (_type_ continue-point) none)
    (continue-copy! (_type_ continue-point) none)
    )
  )


(deftype net-player (process-nettable)
  ((last-known-pos           vector  :inline)
   (last-known-pos-valid     symbol)
   (mgr                      net-game-mgr)
   (vehicle                  handle)
   (rev-mgr                  handle)
   (map                      connection-minimap)
   (score                    int32)
   (player-num               int8)
   (team                     uint8)
   (color                    rgba)
   (font-color               uint8)
   (multiplier               int8)
   (death-indicator-1        handle)
   (death-indicator-2        handle)
   (wpn-left-type            uint8)
   (wpn-right-type           uint8)
   (wpn-left-ammo            uint8)
   (wpn-right-ammo           uint8)
   (turbo-qty                uint8)
   (dark-eco                 uint8)
   (health                   uint8)
   (last-weapon-provision    float)
   (top-speed                float)
   (player-id                int8)
   (flags                    net-player-flag)
   (rank                     int8)
   (human-rank               int8)
   (next-spawn-time          time-frame)
   (state-time               time-frame)
   (vehicle-impact-callback  function)
   (spawn-count              int32)
   (speech-id                uint8)
   (last-speech-time         time-frame)
   (best-power-slide         float)
   (best-hang-time           int32)
   (display-score            int32)
   (kills                    int32)
   (deaths                   int32)
   (last-spawn-time          time-frame)
   (dead-camera-pos-valid    symbol)
   (dead-camera-pos          vector  :inline)
   )
  (:state-methods
    waiting
    running
    die
    )
  (:methods
    (net-player-method-45 (_type_ int int int int) object)
    (net-player-method-46 (_type_ mem-buffer) none)
    (net-player-method-47 (_type_ mem-buffer) none)
    (handle-events (_type_ process int symbol event-message-block) object)
    (get-vehicle (_type_) wvehicle)
    (get-last-known-pos (_type_ vector) symbol)
    (init! (_type_ int) none)
    (can-spawn-vehicle? (_type_) symbol)
    (respawn (_type_) symbol)
    (get-respawn-info (_type_ net-player-respawn-info) symbol)
    (net-player-method-55 (_type_) none)
    (vehicle-update (_type_ wvehicle) none)
    (find-nav-mesh-pos (_type_ vector vector float float) nav-mesh)
    (adjust-spawn-position (_type_ vector vector vector vector vector) symbol)
    (init-spawn-params (_type_ vehicle-spawn-params) none)
    (on-vehicle-spawn (_type_ wvehicle) none)
    (player-score-higher? (_type_ net-player) symbol)
    (total-grand-prix-score-higher? (_type_ net-player) symbol)
    (write-score-change (_type_) none)
    (write-stats-change (_type_) none)
    (update-best-hang-time (_type_ int) none)
    (update-best-power-slide (_type_ float) none)
    (add-death (_type_) none)
    (add-kill (_type_) none)
    (net-player-method-69 (_type_) none)
    (finish-scheduled? (_type_) symbol)
    (net-player-method-71 (_type_) int)
    (speak-start (_type_) none)
    (play-win-speech (_type_) none)
    (generate-random-stats (_type_) none)
    (play-lose-speech (_type_) none)
    (play-crash-speech (_type_) none)
    (net-player-method-77 (_type_ net-player-respawn-info vehicle-spawn-params) none)
    (net-player-method-78 (_type_ object) symbol)
    (net-player-method-79 (_type_ vehicle) none)
    (player-score-same? (_type_ net-player) symbol)
    (total-grand-prix-score-same? (_type_ net-player) symbol)
    (net-player-method-82 (_type_) none)
    (net-player-method-83 (_type_) none)
    (net-player-method-84 (_type_) none)
    (net-player-method-85 (_type_) none)
    (net-player-method-86 (_type_) none)
    (net-player-method-87 (_type_) none)
    (net-player-method-88 (_type_) none)
    (relocate-mgr (_type_ int) none)
    (net-player-method-90 (_type_) none)
    (use-target-cam? (_type_ wvehicle) object)
    (get-minimap-class (_type_) minimap-class)
    (net-player-method-93 (_type_) none)
    (setup-car-colors (_type_) none)
    (net-player-method-95 (_type_ process event-message-block) none)
    (score-kill (_type_ int) none)
    (net-player-method-97 (_type_ object) none)
    )
  )


;; WARN: Return type mismatch int vs object.
(defbehavior net-player-init-remote net-player ((arg0 mem-buffer))
  (register self -1 #xffff)
  (init-remote self arg0)
  (post-init-remote self)
  0
  )

(defmethod spawn-remote ((this net-player) (arg0 mem-buffer))
  (ppointer->process (process-spawn net-player :init net-player-init-remote arg0 :name "net-player"))
  )

(defmethod write-msg-map ((this net-player) (arg0 net-process-class-info))
  (set! (-> arg0 msg-map (-> arg0 msg-count)) 'score-changed)
  (+! (-> arg0 msg-count) 1)
  (set! (-> arg0 msg-map (-> arg0 msg-count)) 'stats-changed)
  (+! (-> arg0 msg-count) 1)
  0
  (none)
  )

(define *msg-map-net-player* (new 'static 'boxed-array :type symbol :length 0 :allocated-length 64))

(define *net-process-class-info-net-player* (new 'static 'net-process-class-info))

(set! (-> *net-process-class-info-net-player* msg-map) *msg-map-net-player*)

(write-msg-map-rec net-player *net-process-class-info-net-player*)

(set! (-> *net-process-class-info-net-player* owner-type) net-player)

(net-process-class-register *net-process-class-info-net-player*)

(defmethod get-class-info ((this net-player))
  *net-process-class-info-net-player*
  )

(define *net-players* (new 'static 'boxed-array :type net-player :length 0 :allocated-length 24))

(define *active-net-player-count* 0)

(define *active-net-players* (new 'static 'boxed-array :type net-player :length 0 :allocated-length 24))

(define *active-net-non-spectator-count* 0)

(define *active-net-non-spectators*
  (new 'static 'boxed-array :type net-player :length 0 :allocated-length 24)
  )

(define *team-colors* (the-as (pointer uint8) (new 'static 'array rgba 8
                                                (new 'static 'rgba :r #xff :a #x80)
                                                (new 'static 'rgba :b #xff :a #x80)
                                                (new 'static 'rgba :g #xff :a #x80)
                                                (new 'static 'rgba :g #xde :b #xde :a #x80)
                                                (new 'static 'rgba :r #xff :g #xff :b #xff :a #x80)
                                                (new 'static 'rgba :r #x80 :g #x80 :a #x80)
                                                (new 'static 'rgba)
                                                (new 'static 'rgba)
                                                )
                                              )
        )

(define *team-font-colors*
  (the-as (pointer font-color)
    (new 'static 'array uint8 16 #x3 #x7 #x6 #x49 #x1 #x4 #x0 #x0 #x0 #x0 #x0 #x0 #x0 #x0 #x0 #x0)
    )
  )

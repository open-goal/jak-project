;;-*-Lisp-*-
(in-package goal)

;; name: net-mgr-medius.gc
;; name in dgo: net-mgr-medius
;; dgos: ENGINE, GAME

(define-extern get-current-room-name-and-info (function object))
(define-extern ensure-room-is-good (function object :behavior net-mgr))

(define-extern *room-clan-id* int)
(define-extern *room-clan-id-2* int)
(define-extern *medius-policy-buffer* (pointer uint8))

;; DECOMP BEGINS

(define *medius-mas-default-hostname* "160.33.36.175")

(define *medius-mas-hostname* "160.33.36.175              ")

(define *medius-mas-port* #x275b)

(define *medius-init-in-params* (new 'static 'medius-initialize-bare-in-params))

(define *medius-init-out-params* (new 'static 'medius-initialize-bare-out-params))

(define *medius-connect-in-params* (new 'static 'medius-connect-in-params))

(define *medius-connect-out-params* (new 'static 'medius-connect-out-params))

(define *medius-public-key* (new 'static 'rsa-key))

(define *medius-connect-info* (new 'static 'net-connection-info))

(define *medius-world-report* (new 'static 'medius-world-report))

(define *medius-player-report* (new 'static 'medius-player-report))

(define *medius-chat-message* (new 'static 'medius-chat-message))

(define *medius-auth-request* (new 'static 'medius-server-authentication-request))

(define *medius-player-ladder-stats* (new 'static 'medius-get-ladder-stats-request))

(define *medius-account-name* (new 'global 'string 64 ""))

(define *medius-account-password* (new 'global 'string 64 ""))

(define *medius-register-if-not-exist* #t)

(define *medius-channel-ct* 0)

(define *medius-user-ct* 0)

(define *medius-total-game-ct* 0)

(define *net-mgr-pending-behavior* (new 'static 'event-message-block))

(define *net-mgr-pending-behavior-valid* #f)

;; WARN: Return type mismatch int vs object.
(defun medius-error-msg-callback ((arg0 medius-error-message))
  (format #t "medius-error-msg-callback: ~D ~G~%" (-> arg0 error-code) (-> arg0 error-message))
  0
  )

(define *chat-tmp-string* (new 'global 'string 65 (the-as string #f)))

;; WARN: Return type mismatch int vs object.
(defun medius-chat-callback ((arg0 medius-chat-fwd-message))
  (format 0 "chat msg: ~G~%" (-> arg0 message))
  (mem-copy! (-> *chat-tmp-string* data) (-> arg0 message) 5)
  (set! (-> *chat-tmp-string* data 5) (the-as uint 0))
  (handle-chat-msg arg0 #f)
  0
  )

;; WARN: Return type mismatch int vs object.
(defun medius-reassign-world-id-callback ((arg0 medius-reassign-game-medius-world-id))
  (format 0 "reassigned world id ~D -> ~D~%" (-> arg0 old-medius-world-id) (-> arg0 new-medius-world-id))
  (when (= (-> arg0 old-medius-world-id) (-> *net-mgr* lobby-state joined-game-id))
    (format 0 "(this corresponds to our game)~%")
    (set! (-> *net-mgr* lobby-state joined-game-id) (-> arg0 new-medius-world-id))
    )
  0
  )

(defmethod init-medius ((this net-mgr))
  (mem-clear! (the-as pointer *medius-init-in-params*) 44)
  (mem-clear! (the-as pointer *medius-init-out-params*) 4)
  (set! (-> *medius-init-in-params* my-error-message-callback) (the-as pointer medius-error-msg-callback))
  (set! (-> *medius-init-in-params* my-chat-fwd-message-callback) (the-as pointer medius-chat-callback))
  (set! (-> *medius-init-in-params* my-reassign-game-medius-world-idcallback)
        (the-as pointer medius-reassign-world-id-callback)
        )
  (set! *scert-function-id* (scert-function medius-initialize-bare))
  (let ((a2-0 (knet-scert-function-2-args *medius-init-in-params* *medius-init-out-params*)))
    (when (nonzero? a2-0)
      (format 0 "medius startup error ~D~%" a2-0)
      (return #f)
      )
    )
  (set! *medius-initted* #t)
  #t
  )

;; WARN: Return type mismatch int vs object.
(defbehavior lobby-non-fatal-error net-mgr ((arg0 symbol))
  (format 0 "lobby-non-fatal-error... disconnecting dme/mgcl...~%")
  (format 0 "net-mgr-notify: ~A~%" arg0)
  (let ((a0-3 (-> *net-mgr* notify alive-list next0)))
    (-> *net-mgr* notify)
    (let ((s5-0 (-> a0-3 next0)))
      (while (!= a0-3 (-> *net-mgr* notify alive-list-end))
        (if (logtest? (the-as int (-> (the-as connection a0-3) param1)) 1)
            (send-event ((method-of-type connection get-process) (the-as connection a0-3)) arg0 :from *net-mgr*)
            )
        (set! a0-3 s5-0)
        (-> *net-mgr* notify)
        (set! s5-0 (-> s5-0 next0))
        )
      )
    )
  (set! *net-mgr-pending-behavior-result* (the-as object #f))
  (set! *net-mgr-pending-behavior-result-extra* arg0)
  (if (nonzero? (-> self lobby-state connect-handle))
      (go-virtual disconnecting #t #t #f 'lobby-idle)
      (go-virtual disconnecting #t #t #f 'idle)
      )
  0
  )

;; WARN: Return type mismatch int vs object.
(defun mas-connect-callback ((arg0 pointer))
  (format 0 "mas-connect-callback: ~X~%" arg0)
  (when *net-mgr*
    (set! (-> *net-mgr* lobby-state connect-handle) arg0)
    (set! (-> *net-mgr* lobby-state callback-occurred) #t)
    (if (zero? arg0)
        (set! (-> *net-mgr* lobby-state got-error) #t)
        )
    )
  0
  )

(defstate connecting-to-mas (net-mgr)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('leave-lobby)
       (go-virtual leaving-lobby)
       )
      (else
        (net-mgr-default-handler proc argc message block)
        )
      )
    )
  :code (behavior ()
    (set! *net-mgr-pending-behavior-valid* #f)
    (mem-clear! (the-as pointer *medius-connect-in-params*) 284)
    (mem-clear! (the-as pointer *medius-connect-out-params*) 8)
    (set! *scert-function-id* (scert-function medius-connect-in-params-defaults))
    (knet-scert-function-5-args *medius-connect-in-params* 0 (-> *medius-mas-hostname* data) *medius-mas-port* 1)
    (set! (-> *medius-connect-in-params* my-connect-callback) mas-connect-callback)
    (set! *scert-function-id* (scert-function get-server-public-key))
    (knet-scert-function-1-args *medius-public-key*)
    (mem-copy!
      (the-as pointer (-> *medius-connect-in-params* connect-info server-key))
      (the-as pointer *medius-public-key*)
      64
      )
    (format
      0
      "connecting to ~G:~D~%"
      (-> *medius-connect-in-params* connect-info address-list a-address-list 0 address)
      (-> *medius-connect-in-params* connect-info address-list a-address-list 0 port)
      )
    (reset-lobby-state! self)
    (set! *scert-function-id* (scert-function medius-connect))
    (let ((gp-0 (knet-scert-function-3-args *medius-connect-in-params* *medius-connect-out-params* #f)))
      (when (nonzero? gp-0)
        (format 0 "initial function call returned ~D~%" gp-0)
        (set! (-> self lobby-state got-error) #t)
        (set! (-> self lobby-state last-medius-error) gp-0)
        )
      )
    (net-async-wait (seconds 20) #t)
    (cond
      ((or (-> self lobby-state got-error)
           (-> self lobby-state timeout)
           (nonzero? (-> self lobby-state last-medius-error))
           (nonzero? (-> self lobby-state last-mgcl-error))
           (nonzero? (-> self lobby-state last-dme-error))
           (nonzero? (-> self lobby-state callback-status))
           )
       (lobby-fatal-error 'lobby-connect-failed)
       )
      (else
        )
      )
    (go-virtual beginning-session)
    )
  )

(defstate beginning-session (net-mgr)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('leave-lobby)
       (go-virtual leaving-lobby)
       )
      (else
        (net-mgr-default-handler proc argc message block)
        )
      )
    )
  :code (behavior ()
    (let ((gp-0 (new 'stack 'medius-session-begin-request)))
      (set! *async-request-ct* (+ *async-request-ct* 1))
      (itoa *async-request-ct* (-> gp-0 message-id))
      (set! (-> gp-0 connection-class) (medius-connection-type ethernet))
      (reset-lobby-state! self)
      (set! *scert-function-id* (scert-function medius-session-begin))
      (let ((gp-1 (knet-scert-function-3-args gp-0 medius-simple-request-callback #f)))
        (when (nonzero? gp-1)
          (format 0 "initial function call returned ~D~%" gp-1)
          (set! (-> self lobby-state got-error) #t)
          (set! (-> self lobby-state last-medius-error) gp-1)
          )
        )
      )
    (net-async-wait (seconds 15) #t)
    (cond
      ((or (-> self lobby-state got-error)
           (-> self lobby-state timeout)
           (nonzero? (-> self lobby-state last-medius-error))
           (nonzero? (-> self lobby-state last-mgcl-error))
           (nonzero? (-> self lobby-state last-dme-error))
           (nonzero? (-> self lobby-state callback-status))
           )
       *medius-last-response*
       (lobby-fatal-error 'lobby-connect-failed)
       )
      (else
        *medius-last-response*
        0
        )
      )
    (reset-lobby-state! self)
    (set! *scert-function-id* (scert-function medius-get-my-session-key))
    (let ((gp-2 (knet-scert-function-1-args *medius-session-key*)))
      (when (nonzero? gp-2)
        (format 0 "initial function call returned ~D~%" gp-2)
        (set! (-> self lobby-state got-error) #t)
        (set! (-> self lobby-state last-medius-error) gp-2)
        )
      )
    (if (-> self lobby-state got-error)
        (lobby-fatal-error 'lobby-connect-failed)
        )
    (set! *medius-session-key-valid* #t)
    (medius-post-dnas-signature)
    (cond
      ((-> self skip-policy)
       (set! (-> self skip-policy) #f)
       (go-virtual logging-in)
       )
      (else
        (go-virtual getting-policy-1)
        )
      )
    )
  )

(defstate logging-in (net-mgr)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('leave-lobby)
       (go-virtual leaving-lobby)
       )
      (else
        (net-mgr-default-handler proc argc message block)
        )
      )
    )
  :code (behavior ()
    (let ((gp-0 (new 'stack 'medius-account-login-request)))
      (set! *async-request-ct* (+ *async-request-ct* 1))
      (itoa *async-request-ct* (-> gp-0 message-id))
      (mem-copy! (-> gp-0 session-key) *medius-session-key* 17)
      (copy-charp<-charp (-> gp-0 account-name) (-> *medius-account-name* data))
      (copy-charp<-charp (-> gp-0 password) (-> *medius-account-password* data))
      (reset-lobby-state! self)
      (set! *scert-function-id* (scert-function medius-account-login))
      (let ((gp-1 (knet-scert-function-3-args gp-0 medius-simple-request-callback #f)))
        (when (nonzero? gp-1)
          (format 0 "initial function call returned ~D~%" gp-1)
          (set! (-> self lobby-state got-error) #t)
          (set! (-> self lobby-state last-medius-error) gp-1)
          )
        )
      )
    (net-async-wait (seconds 15) #t)
    (cond
      ((or (-> self lobby-state got-error)
           (-> self lobby-state timeout)
           (nonzero? (-> self lobby-state last-medius-error))
           (nonzero? (-> self lobby-state last-mgcl-error))
           (nonzero? (-> self lobby-state last-dme-error))
           (nonzero? (-> self lobby-state callback-status))
           )
       *medius-last-response*
       (cond
         ((and (-> self auto-register) (= (-> self lobby-state callback-status) -998))
          (go-virtual registering-account)
          )
         (else
           (format 0 "  LOGIN FAILED::: ~A~%" *lobby-menu-manager*)
           (format 0 "net-mgr-notify: ~A~%" 'lobby-login-failed)
           (let ((a0-13 (-> *net-mgr* notify alive-list next0)))
             (-> *net-mgr* notify)
             (let ((gp-2 (-> a0-13 next0)))
               (while (!= a0-13 (-> *net-mgr* notify alive-list-end))
                 (if (logtest? (the-as int (-> (the-as connection a0-13) param1)) 1)
                     (send-event
                       ((method-of-type connection get-process) (the-as connection a0-13))
                       'lobby-login-failed
                       :from *net-mgr*
                       (-> self lobby-state callback-status)
                       )
                     )
                 (set! a0-13 gp-2)
                 (-> *net-mgr* notify)
                 (set! gp-2 (-> gp-2 next0))
                 )
               )
             )
           (go-virtual disconnecting #t #t #t 'idle)
           )
         )
       )
      (else
        *medius-last-response*
        0
        )
      )
    (let ((gp-3 (the-as medius-account-login-response *medius-last-response*)))
      (mem-copy! (the-as pointer *medius-connect-info*) (the-as pointer (-> gp-3 connect-info)) 154)
      (set! (-> self lobby-state channel-id) (-> gp-3 medius-world-id))
      (set! (-> self lobby-state last-normal-channel-id) (-> gp-3 medius-world-id))
      (set! (-> self lobby-state in-special-channel) #f)
      (set! (-> self lobby-state my-account-id) (-> gp-3 account-id))
      )
    (go-virtual connecting-to-lobby #t)
    )
  )

;; WARN: Return type mismatch int vs object.
(defun medius-text-filter-request-callback ((arg0 medius-text-filter-response) (arg1 pointer))
  (let ((a2-0 (atoi (-> arg0 message-id))))
    (cond
      ((= a2-0 *async-request-ct*)
       (set! (-> *net-mgr* lobby-state callback-occurred) #t)
       (set! (-> *net-mgr* lobby-state callback-status) (the-as int (-> arg0 status-code)))
       (set! (-> *net-mgr* lobby-state callback-userdata) arg1)
       (mem-copy! (the-as pointer *medius-last-response*) (the-as pointer arg0) 1024)
       (if (nonzero? (-> arg0 status-code))
           (set! (-> *net-mgr* lobby-state got-error) #t)
           )
       )
      (else
        (format 0 "discarding unexpected message-id ~D~%" a2-0)
        )
      )
    )
  0
  )

(defbehavior net-filter-text net-mgr ((arg0 (pointer uint8)) (arg1 symbol))
  (local-vars (v0-8 symbol))
  (let ((s5-0 (new 'stack 'medius-text-filter-request)))
    (set! *async-request-ct* (+ *async-request-ct* 1))
    (itoa *async-request-ct* (-> s5-0 message-id))
    (mem-copy! (-> s5-0 session-key) *medius-session-key* 17)
    (copy-charp<-charp (-> s5-0 text) arg0)
    (set! (-> s5-0 text-filter-type) (if arg1
                                         (medius-text-filter-type medius-text-filter-replace)
                                         (medius-text-filter-type medius-text-filter-pass-fail)
                                         )
          )
    (reset-lobby-state! self)
    (set! *scert-function-id* (scert-function medius-text-filter))
    (let ((s5-1 (knet-scert-function-3-args s5-0 medius-text-filter-request-callback #f)))
      (when (nonzero? s5-1)
        (format 0 "initial function call returned ~D~%" s5-1)
        (set! (-> self lobby-state got-error) #t)
        (set! (-> self lobby-state last-medius-error) s5-1)
        )
      )
    )
  (net-async-wait (seconds 15) #t)
  (cond
    ((or (-> self lobby-state got-error)
         (-> self lobby-state timeout)
         (nonzero? (-> self lobby-state last-medius-error))
         (nonzero? (-> self lobby-state last-mgcl-error))
         (nonzero? (-> self lobby-state last-dme-error))
         (nonzero? (-> self lobby-state callback-status))
         )
     *medius-last-response*
     0
     )
    (else
      *medius-last-response*
      0
      )
    )
  (let ((v1-21 (the-as medius-text-filter-response *medius-last-response*)))
    (case (-> v1-21 status-code)
      (((medius-status-code medius-fail))
       (return #f)
       v0-8
       )
      (((medius-status-code medius-filter-failed))
       (return #f)
       v0-8
       )
      (((medius-status-code medius-pass))
       (return #t)
       v0-8
       )
      (((medius-status-code medius-success))
       (copy-charp<-charp arg0 (-> v1-21 text))
       #t
       )
      (else
        #f
        )
      )
    )
  )

(defstate registering-account (net-mgr)
  :virtual #t
  :event net-mgr-default-handler
  :code (behavior ()
    (if (not (net-filter-text (-> *medius-account-name* data) #f))
        (lobby-fatal-error 'lobby-registration-failed-vulgarity)
        )
    (let ((gp-0 (new 'stack 'medius-account-registration-request)))
      (set! *async-request-ct* (+ *async-request-ct* 1))
      (itoa *async-request-ct* (-> gp-0 message-id))
      (mem-copy! (-> gp-0 session-key) *medius-session-key* 17)
      (copy-charp<-charp (-> gp-0 account-name) (-> *medius-account-name* data))
      (copy-charp<-charp (-> gp-0 password) (-> *medius-account-password* data))
      (set! (-> gp-0 account-type) (medius-account-type medius-master-account))
      (reset-lobby-state! self)
      (set! *scert-function-id* (scert-function medius-account-registration))
      (let ((gp-1 (knet-scert-function-3-args gp-0 medius-simple-request-callback #f)))
        (when (nonzero? gp-1)
          (format 0 "initial function call returned ~D~%" gp-1)
          (set! (-> self lobby-state got-error) #t)
          (set! (-> self lobby-state last-medius-error) gp-1)
          )
        )
      )
    (net-async-wait (seconds 15) #t)
    (cond
      ((or (-> self lobby-state got-error)
           (-> self lobby-state timeout)
           (nonzero? (-> self lobby-state last-medius-error))
           (nonzero? (-> self lobby-state last-mgcl-error))
           (nonzero? (-> self lobby-state last-dme-error))
           (nonzero? (-> self lobby-state callback-status))
           )
       *medius-last-response*
       (format 0 "net-mgr-notify: ~A~%" 'lobby-registration-failed)
       (let ((a0-13 (-> *net-mgr* notify alive-list next0)))
         (-> *net-mgr* notify)
         (let ((gp-2 (-> a0-13 next0)))
           (while (!= a0-13 (-> *net-mgr* notify alive-list-end))
             (if (logtest? (the-as int (-> (the-as connection a0-13) param1)) 1)
                 (send-event
                   ((method-of-type connection get-process) (the-as connection a0-13))
                   'lobby-registration-failed
                   :from *net-mgr*
                   )
                 )
             (set! a0-13 gp-2)
             (-> *net-mgr* notify)
             (set! gp-2 (-> gp-2 next0))
             )
           )
         )
       (lobby-fatal-error 'lobby-registration-failed)
       )
      (else
        *medius-last-response*
        0
        )
      )
    (mem-clear! (&-> *medius-my-player* type) 684)
    (go-virtual logging-in)
    )
  )

(defstate connecting-to-lobby (net-mgr)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('leave-lobby)
       (go-virtual leaving-lobby)
       )
      (else
        (net-mgr-default-handler proc argc message block)
        )
      )
    )
  :code (behavior ((arg0 symbol))
    (medius-disconnect #f)
    (mem-clear! (the-as pointer *medius-connect-in-params*) 284)
    (mem-clear! (the-as pointer *medius-connect-out-params*) 8)
    (mem-copy!
      (the-as pointer (-> *medius-connect-in-params* connect-info))
      (the-as pointer *medius-connect-info*)
      154
      )
    (set! (-> *medius-connect-in-params* max-clients-per-connection) (the-as uint 256))
    (set! (-> *medius-connect-in-params* my-connect-callback) mas-connect-callback)
    (format
      0
      "connecting to ~G:~D~%"
      (-> *medius-connect-in-params* connect-info address-list a-address-list 0 address)
      (-> *medius-connect-in-params* connect-info address-list a-address-list 0 port)
      )
    (reset-lobby-state! self)
    (set! *scert-function-id* (scert-function medius-connect))
    (let ((s5-0 (knet-scert-function-3-args *medius-connect-in-params* *medius-connect-out-params* #f)))
      (when (nonzero? s5-0)
        (format 0 "initial function call returned ~D~%" s5-0)
        (set! (-> self lobby-state got-error) #t)
        (set! (-> self lobby-state last-medius-error) s5-0)
        )
      )
    (net-async-wait (seconds 15) #t)
    (cond
      ((or (-> self lobby-state got-error)
           (-> self lobby-state timeout)
           (nonzero? (-> self lobby-state last-medius-error))
           (nonzero? (-> self lobby-state last-mgcl-error))
           (nonzero? (-> self lobby-state last-dme-error))
           (nonzero? (-> self lobby-state callback-status))
           )
       (lobby-fatal-error 'lobby-connect-failed)
       )
      (else
        )
      )
    (when arg0
      (set! *net-mgr-pending-behavior-valid* #f)
      (mem-clear! (the-as pointer *ghost-rec*) 100)
      (set! (-> *medius-my-player* medius-id) (-> self lobby-state my-account-id))
      (medius-player-info-retrieve-behavior *medius-my-player*)
      (let ((v1-22 #f))
        (when (!= (-> *medius-my-player* stats stats-version) 11)
          (mem-clear! (the-as pointer (-> *medius-my-player* stats)) 12)
          (set! (-> *medius-my-player* stats stats-version) 11)
          (set! v1-22 #t)
          )
        (when (!= (-> *medius-my-player* ladder-stats version) 12)
          (init-stats! *net-player-ladder-stats-info* (-> *medius-my-player* ladder-stats))
          (update-computed-stats! *net-player-ladder-stats-info* (-> *medius-my-player* ladder-stats))
          (set! v1-22 #t)
          )
        (if v1-22
            (medius-start-account-stats-update #t #t)
            )
        )
      (init-player-lists)
      )
    (clear-game-list-filters)
    (update-client-state (medius-user-action joined-chat-world) (-> self lobby-state channel-id) #f)
    (get-current-room-name-and-info)
    (ensure-room-is-good)
    (format 0 "net-mgr-notify: ~A~%" 'lobby-connect-complete)
    (let ((a0-30 (-> *net-mgr* notify alive-list next0)))
      (-> *net-mgr* notify)
      (let ((gp-1 (-> a0-30 next0)))
        (while (!= a0-30 (-> *net-mgr* notify alive-list-end))
          (if (logtest? (the-as int (-> (the-as connection a0-30) param1)) 1)
              (send-event
                ((method-of-type connection get-process) (the-as connection a0-30))
                'lobby-connect-complete
                :from *net-mgr*
                )
              )
          (set! a0-30 gp-1)
          (-> *net-mgr* notify)
          (set! gp-1 (-> gp-1 next0))
          )
        )
      )
    (go-virtual lobby-idle)
    )
  )

(defun net-mgr-process-pending-behavior ()
  (if (not *net-mgr-pending-behavior-valid*)
      (return #f)
      )
  (let ((v0-0 ((the-as
                 (function uint uint uint uint uint uint uint object)
                 (-> (the-as symbol (-> *net-mgr-pending-behavior* param 0)) value)
                 )
               (-> *net-mgr-pending-behavior* param 1)
               (-> *net-mgr-pending-behavior* param 2)
               (-> *net-mgr-pending-behavior* param 3)
               (-> *net-mgr-pending-behavior* param 4)
               (-> *net-mgr-pending-behavior* param 5)
               (-> (the-as (pointer uint64) *net-mgr-pending-behavior*) 8)
               (-> (the-as (pointer uint64) *net-mgr-pending-behavior*) 9)
               )
              )
        )
    (set! *net-mgr-pending-behavior-valid* #f)
    (set! *net-mgr-pending-behavior-result* v0-0)
    v0-0
    )
  )

(defstate lobby-idle (net-mgr)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('leave-lobby)
       (go-virtual leaving-lobby)
       )
      (('do-behavior)
       (mem-copy! (the-as pointer *net-mgr-pending-behavior*) (the-as pointer block) 72)
       (let ((v0-0 (the-as object #t)))
         (set! *net-mgr-pending-behavior-valid* (the-as symbol v0-0))
         v0-0
         )
       )
      (('refresh-games)
       (go-virtual refreshing-games (the-as int (-> block param 0)))
       )
      (('create-game)
       (go-virtual creating-game-world)
       )
      (('host-p2p-game)
       (set! (-> self game-type) (the-as uint 3))
       (go-virtual hosting-game)
       )
      (('join-game)
       (go-virtual joining-game-world (the-as int (-> block param 0)) #f)
       )
      (else
        (net-mgr-default-handler proc argc message block)
        )
      )
    )
  :code (behavior ()
    (do-disconnect #t #t #f)
    (set! (-> self game-type) (the-as uint 0))
    (loop
      (net-mgr-process-pending-behavior)
      (medius-cache-tick *medius-player-cache*)
      (medius-cache-tick *medius-game-status-cache*)
      (medius-cache-tick *medius-clan-cache*)
      (reset-lobby-state! self)
      (set! *scert-function-id* (scert-function medius-update))
      (let ((gp-0 (knet-scert-function-0-args)))
        (when (nonzero? gp-0)
          (format 0 "initial function call returned ~D~%" gp-0)
          (set! (-> self lobby-state got-error) #t)
          (set! (-> self lobby-state last-medius-error) gp-0)
          )
        )
      (check-net-errors self)
      (if (-> self lobby-state got-error)
          (lobby-fatal-error 'lobby-unexpected-error)
          )
      (when (and *aux-voice-enabled*
                 (not *aux-voice-mgr*)
                 (< (seconds 3) (- (-> *display* real-clock frame-counter) *aux-voice-last-startup*))
                 )
        (set! *aux-voice-last-startup* (-> *display* real-clock frame-counter))
        (aux-voice-mgr-activate)
        )
      (if (and (not *aux-voice-enabled*) *aux-voice-mgr*)
          (aux-voice-mgr-deactivate)
          )
      (suspend)
      )
    )
  )

(defstate leaving-lobby (net-mgr)
  :virtual #t
  :code (behavior ()
    (while *aux-voice-mgr*
      (aux-voice-mgr-deactivate)
      (suspend)
      )
    (dotimes (gp-0 (-> *medius-buddies-online* ct))
      (send-chat-msg *net-mgr* "@Offline" (get-id (-> *medius-buddies-online* data gp-0)) #t)
      )
    (do-disconnect #t #t #t)
    (format 0 "net-mgr-notify: ~A~%" 'lobby-disconnected)
    (let ((a0-5 (-> *net-mgr* notify alive-list next0)))
      (-> *net-mgr* notify)
      (let ((gp-1 (-> a0-5 next0)))
        (while (!= a0-5 (-> *net-mgr* notify alive-list-end))
          (if (logtest? (the-as int (-> (the-as connection a0-5) param1)) 1)
              (send-event
                ((method-of-type connection get-process) (the-as connection a0-5))
                'lobby-disconnected
                :from *net-mgr*
                )
              )
          (set! a0-5 gp-1)
          (-> *net-mgr* notify)
          (set! gp-1 (-> gp-1 next0))
          )
        )
      )
    (go-virtual idle)
    )
  )

;; WARN: Return type mismatch int vs object.
(defun refreshing-games-callback ((arg0 medius-game-list-extra-info-response))
  (format
    0
    "got game ~D : ~D/~D (ver=~D)~%"
    (-> arg0 medius-world-id)
    (-> arg0 player-count)
    (-> arg0 max-players)
    (-> arg0 generic-field1)
    )
  (when (and (< *net-available-game-ct* 16) (nonzero? (-> arg0 world-status)))
    (let ((s5-0 (-> *net-available-games* *net-available-game-ct*)))
      (mem-clear! (the-as pointer s5-0) 328)
      (init-from-game-list-extra-info! s5-0 arg0)
      (if (valid-game? s5-0)
          (set! *net-available-game-ct* (+ *net-available-game-ct* 1))
          )
      )
    )
  (if (nonzero? (-> arg0 end-of-list))
      (set! (-> *net-mgr* lobby-state callback-occurred) #t)
      )
  0
  )

(defmethod init-from-game-list-extra-info! ((this net-available-game) (arg0 medius-game-list-extra-info-response))
  (set! (-> this medius-world-id) (-> arg0 medius-world-id))
  (mem-copy! (the-as pointer (-> this info)) (-> arg0 game-name) 64)
  (set! (-> this info player-count) (-> arg0 player-count))
  (set! (-> this info min-players) (-> arg0 min-players))
  (set! (-> this info max-players) (-> arg0 max-players))
  (set! (-> this info location) (the-as uint (-> arg0 game-level)))
  (set! (-> this info event) (the-as uint (-> arg0 rules-set)))
  (set! (-> this info task-node) (the-as uint (get-task-node-id-from-location-and-event
                                                (the-as task-level (-> this info location))
                                                (the-as net-play-mode (-> this info event))
                                                )
                                         )
        )
  (set! (-> this info in-staging) (= (-> arg0 world-status) (medius-world-status world-staging)))
  (set! (-> this info generic-1) (-> arg0 generic-field1))
  (set! (-> this info generic-2) (-> arg0 generic-field2))
  (set! (-> this info generic-3) (-> arg0 generic-field3))
  (let ((s4-0 (new 'stack-no-clear 'inline-array 'mem-buffer 1)))
    (set-buffer! (-> s4-0 0) (-> arg0 game-stats) 256)
    (set! (-> this info player-count) (the-as uint (read-int32 (-> s4-0 0))))
    (set! (-> this info clan-1) (read-int32 (-> s4-0 0)))
    (set! (-> this info clan-2) (read-int32 (-> s4-0 0)))
    (set! (-> this info skill-level) (read-int32 (-> s4-0 0)))
    (set! (-> this info avg-ping) (read-int32 (-> s4-0 0)))
    )
  (format-game-name! this)
  0
  (none)
  )

(defmethod init-from-game-info! ((this net-available-game) (arg0 medius-game-info-response))

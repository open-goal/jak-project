       )
      (else
        )
      )
    (let ((s5-2 (new 'stack-no-clear 'medius-game-list-extra-info-request)))
      (mem-clear! (-> s5-2 message-id) 26)
      (set! *net-available-game-ct* 0)
      (dotimes (s4-0 1)
        (let ((s3-0 (+ arg0 s4-0)))
          (format 0 "considering page ~D~%" (+ s3-0 1))
          (when (>= (/ *medius-total-game-ct* 16) s3-0)
            (format 0 "requesting page ~D~%" (+ s3-0 1))
            (set! (-> s5-2 page-id) (the-as uint (+ s3-0 1)))
            (set! (-> s5-2 page-size) (the-as uint 16))
            (reset-lobby-state! self)
            (set! *scert-function-id* (scert-function medius-game-list-extra-info))
            (let ((s3-1 (knet-scert-function-3-args (-> s5-2 message-id) refreshing-games-callback 0)))
              (when (nonzero? s3-1)
                (format 0 "initial function call returned ~D~%" s3-1)
                (set! (-> self lobby-state got-error) #t)
                (set! (-> self lobby-state last-medius-error) s3-1)
                )
              )
            (net-async-wait (seconds 3600) #t)
            (cond
              ((or (-> self lobby-state got-error)
                   (-> self lobby-state timeout)
                   (nonzero? (-> self lobby-state last-medius-error))
                   (nonzero? (-> self lobby-state last-mgcl-error))
                   (nonzero? (-> self lobby-state last-dme-error))
                   (nonzero? (-> self lobby-state callback-status))
                   )
               (lobby-fatal-error 'lobby-unexpected-error)
               )
              (else
                )
              )
            )
          )
        )
      )
    (go-virtual lobby-idle)
    )
  )

(define *tmp-game-name* (new 'global 'string 64 (the-as string #f)))

(defstate creating-game-world (net-mgr)
  :virtual #t
  :event net-mgr-default-handler
  :code (behavior ()
    (when *aux-voice-mgr*
      (aux-voice-mgr-deactivate)
      (while *aux-voice-mgr*
        (suspend)
        )
      )
    (dotimes (gp-0 1)
      (format 0 "blah [~S]~%" *tmp-game-name*)
      (when (not (net-filter-text (-> *tmp-game-name* data) #f))
        (format 0 "net-mgr-notify: ~A~%" 'lobby-create-game-failed-vulgarity)
        (let ((a0-3 (-> *net-mgr* notify alive-list next0)))
          (-> *net-mgr* notify)
          (let ((s5-0 (-> a0-3 next0)))
            (while (!= a0-3 (-> *net-mgr* notify alive-list-end))
              (if (logtest? (the-as int (-> (the-as connection a0-3) param1)) 1)
                  (send-event
                    ((method-of-type connection get-process) (the-as connection a0-3))
                    'lobby-create-game-failed-vulgarity
                    :from *net-mgr*
                    )
                  )
              (set! a0-3 s5-0)
              (-> *net-mgr* notify)
              (set! s5-0 (-> s5-0 next0))
              )
            )
          )
        (go-virtual lobby-idle)
        )
      (format 0 "blah2 [~S]~%" *tmp-game-name*)
      (set! (-> self lobby-state created-game-id) -1)
      (let ((s5-1 (new 'stack 'medius-create-game-request)))
        (set! *async-request-ct* (+ *async-request-ct* 1))
        (itoa *async-request-ct* (-> s5-1 message-id))
        (mem-copy! (-> s5-1 session-key) *medius-session-key* 17)
        (set! *scert-function-id* (scert-function get-application-id))
        (set! (-> s5-1 application-id) (knet-scert-function-0-args))
        (set! (-> s5-1 min-players) 1)
        (set! (-> s5-1 max-players) 6)
        (set! (-> s5-1 game-level) 3)
        (set! (-> s5-1 rules-set) 0)
        (set! (-> s5-1 game-host-type) (medius-game-host-type medius-game-host-client-server-aux-udp))
        (set! (-> s5-1 attributes) (medius-world-attributes-type game-world-none))
        (copy-charp<-charp (-> s5-1 game-name) (-> *tmp-game-name* data))
        (set! (-> s5-1 generic-field1)
              (the-as int (logior (the-as uint #x8000000f) (if (-> self lobby-state in-special-channel)
                                                               #x20000000
                                                               0
                                                               )
                                  )
                      )
              )
        (set! (-> s5-1 generic-field2) (-> *net-mgr* lobby-state channel-id))
        (format 0 "creating ~G~%" (-> s5-1 game-name))
        (reset-lobby-state! self)
        (set! *scert-function-id* (scert-function medius-create-game))
        (let ((s5-2 (knet-scert-function-3-args s5-1 medius-simple-request-callback #f)))
          (when (nonzero? s5-2)
            (format 0 "initial function call returned ~D~%" s5-2)
            (set! (-> self lobby-state got-error) #t)
            (set! (-> self lobby-state last-medius-error) s5-2)
            )
          )
        )
      (net-async-wait (seconds 15) #t)
      (cond
        ((or (-> self lobby-state got-error)
             (-> self lobby-state timeout)
             (nonzero? (-> self lobby-state last-medius-error))
             (nonzero? (-> self lobby-state last-mgcl-error))
             (nonzero? (-> self lobby-state last-dme-error))
             (nonzero? (-> self lobby-state callback-status))
             )
         *medius-last-response*
         0
         )
        (else
          *medius-last-response*
          0
          )
        )
      (let ((a0-18 (the-as medius-create-game-response *medius-last-response*)))
        (case (-> a0-18 status-code)
          (((medius-status-code medius-success))
           (set! (-> self lobby-state created-game-id) (-> a0-18 medius-world-id))
           (goto cfg-64)
           )
          (((medius-status-code medius-game-name-exists))
           (format 0 "net-mgr-notify: ~A~%" 'lobby-create-game-failed-name-exists)
           (let ((a0-21 (-> *net-mgr* notify alive-list next0)))
             (-> *net-mgr* notify)
             (let ((s5-3 (-> a0-21 next0)))
               (while (!= a0-21 (-> *net-mgr* notify alive-list-end))
                 (if (logtest? (the-as int (-> (the-as connection a0-21) param1)) 1)
                     (send-event
                       ((method-of-type connection get-process) (the-as connection a0-21))
                       'lobby-create-game-failed-name-exists
                       :from *net-mgr*
                       )
                     )
                 (set! a0-21 s5-3)
                 (-> *net-mgr* notify)
                 (set! s5-3 (-> s5-3 next0))
                 )
               )
             )
           (go-virtual lobby-idle)
           )
          (else
            (format 0 "net-mgr-notify: ~A~%" 'lobby-create-game-failed)
            (let ((a0-24 (-> *net-mgr* notify alive-list next0)))
              (-> *net-mgr* notify)
              (let ((s5-4 (-> a0-24 next0)))
                (while (!= a0-24 (-> *net-mgr* notify alive-list-end))
                  (if (logtest? (the-as int (-> (the-as connection a0-24) param1)) 1)
                      (send-event
                        ((method-of-type connection get-process) (the-as connection a0-24))
                        'lobby-create-game-failed
                        :from *net-mgr*
                        )
                      )
                  (set! a0-24 s5-4)
                  (-> *net-mgr* notify)
                  (set! s5-4 (-> s5-4 next0))
                  )
                )
              )
            (go-virtual lobby-idle)
            )
          )
        )
      )
    (format 0 "net-mgr-notify: ~A~%" 'lobby-create-game-failed)
    (let ((a0-27 (-> *net-mgr* notify alive-list next0)))
      (-> *net-mgr* notify)
      (let ((gp-1 (-> a0-27 next0)))
        (while (!= a0-27 (-> *net-mgr* notify alive-list-end))
          (if (logtest? (the-as int (-> (the-as connection a0-27) param1)) 1)
              (send-event
                ((method-of-type connection get-process) (the-as connection a0-27))
                'lobby-create-game-failed
                :from *net-mgr*
                )
              )
          (set! a0-27 gp-1)
          (-> *net-mgr* notify)
          (set! gp-1 (-> gp-1 next0))
          )
        )
      )
    (go-virtual lobby-idle)
    (label cfg-64)
    (format 0 "created game ok ~%")
    (mem-clear! (the-as pointer (-> *net-available-games* 0)) 328)
    (set! (-> *net-available-games* 0 medius-world-id) (-> self lobby-state created-game-id))
    (go-virtual joining-game-world 0 #t)
    )
  )

(define *medius-join-game-response* (new 'static 'medius-simple-response))

(defstate joining-game-world (net-mgr)

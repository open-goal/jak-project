                                     )
          )
    (set! (-> gp-1 target-account-id) arg1)
    (mem-copy! (-> gp-1 message) (-> arg0 data) 64)
    (set! (-> gp-1 message 63) (the-as uint 0))
    (when (and (= (-> gp-1 message-s8 0) 64) (not arg2))
      (countdown (v1-9 64)
        (set! (-> gp-1 message v1-9) (the-as uint (-> gp-1 message-s8 (+ v1-9 -1))))
        )
      (set! (-> gp-1 message 0) (the-as uint 32))
      (set! (-> gp-1 message 63) (the-as uint 0))
      0
      )
    (set! *scert-function-id* (scert-function medius-chat-message))
    (if (nonzero? (knet-scert-function-1-args (-> gp-1 message-id)))
        (return #f)
        )
    )
  #t
  )

(defmethod net-mgr-method-57 ((this net-mgr) (arg0 string) (arg1 int))
  (if (= arg1 -1)
      (set! arg1 (-> *net-mgr* game-state connected-bitfield))

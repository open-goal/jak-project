    (dotimes (s3-0 8)
      (when (and (logtest? (-> *net-mgr* game-state connected-bitfield) (ash 1 s3-0))
                 (logtest? (ash 1 s3-0) arg1)
                 (and (> (-> *net-process-mgr* machines s3-0 acct-id) 0)
                      (!= (-> *net-process-mgr* machines s3-0 acct-id) (-> this lobby-state my-account-id))
                      )
                 )
        (send-chat-msg this arg0 (-> *net-process-mgr* machines s3-0 acct-id) #f)
        (set! arg1 (logclear arg1 (ash 1 s3-0)))
        )
      )
    )
  (let ((s4-1 (alloc-msg-buffer)))
    (write-int8 s4-1 0)
    (write-int8 s4-1 0)
    (write-int8 s4-1 11)
    (write-string s4-1 (-> arg0 data))
    (set! (-> (the-as (pointer int8) (-> s4-1 base)) 1) (+ (bytes-used s4-1) -1))
    (net-send-msg 64 s4-1 arg1)
    (free-msg-buffer s4-1)
    )
  #t
  )


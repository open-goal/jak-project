    (set! *scert-function-id* (scert-function medius-update-user-state))
    (knet-scert-function-1-args (-> gp-0 session-key))
    )
  0
  )

;; WARN: Return type mismatch object vs medius-cached-info-player.
(defmethod lookup-player ((this medius-player))
  (the-as medius-cached-info-player (lookup *medius-player-cache* (get-id this) 9000 #t #f))
  )

;; WARN: Return type mismatch int vs object.
(defun init-player-lists ()
  (clear-objects! *medius-player-cache*)
  (retrieve-player-lists)
  (retrieve-my-clan-data)
  (dotimes (v1-2 32)
    (set! (-> *medius-recent-opponents* v1-2) -1)
    )
  0
  )

(define *tmp-player-name* (new 'global 'string 128 (the-as string #f)))

;; WARN: Swapped fp-relative label and field offsets for "---"
(defmethod get-player-name-and-clan ((this medius-player))
  (local-vars (v0-3 (pointer uint8)))
  (let ((s5-1 (lookup *medius-player-cache* (get-id this) -1 #f #f)))
    (if (= s5-1 'error)
        (set! s5-1 #f)
        )
    (cond
      (s5-1
        (cond
          (#f
            (let ((s4-1
                    (lookup *medius-clan-cache* (-> (the-as medius-cached-info-player s5-1) stats current-clan) #xd2f0 #f #f)
                    )
                  )
              (if (= s4-1 'error)
                  (return (-> (the-as medius-cached-info-player s5-1) name))
                  )
              (when (and s4-1 (contains? (-> (the-as medius-cached-info-clan s4-1) members) (get-id this)))
                (format
                  (clear *tmp-player-name*)
                  "~G [~G]"
                  (-> (the-as medius-cached-info-player s5-1) name)
                  (-> (the-as medius-cached-info-clan s4-1) name)
                  )
                (return (-> *tmp-player-name* data))
                v0-3
                )
              )
            )
          (else
            (return (-> (the-as medius-cached-info-player s5-1) name))
            v0-3
            )
          )
        )
      (else
        (return (-> "---" data))
        v0-3
        )
      )
    )
  )

(defmethod get-game-status ((this medius-player))
  (let ((v1-2 (the-as medius-cached-info-player (lookup *medius-player-cache* (get-id this) -1 #f #f))))
    (if (not (and v1-2
                  (!= v1-2 'error)
                  (= (-> v1-2 online-state connect-status) (medius-player-status medius-player-in-game-world))
                  (> (-> v1-2 online-state medius-game-world-id) 0)
                  )
             )
        (return 0)
        )
    (get-game-status-cached (-> v1-2 online-state medius-game-world-id))
    )
  )

;; WARN: Return type mismatch int vs object.
(defun get-player-amplitude ((arg0 (pointer uint8)))
  (local-vars (a0-7 int))
  (if (not (and *aux-voice-mgr*
                (and (-> *aux-voice-mgr* next-state) (= (-> *aux-voice-mgr* next-state name) 'active))
                *headset*
                (!= (-> *medius-my-clan* medius-id) -1)
                )
           )
      (return (the-as object 0))
      )
  (dotimes (s5-0 (length (-> *medius-player-cache* objects)))
    (let ((s4-0 (-> *medius-player-cache* objects s5-0)))
      (when (and (has-data? s4-0) (strncmp (-> (the-as medius-cached-info-player s4-0) format-name) arg0 -1))
        (set! a0-7 (-> s4-0 medius-id))
        (goto cfg-23)
        )
      )
    )
  (set! a0-7 -1)
  (label cfg-23)
  (dotimes (v1-26 16)
    (if (and (= (-> *aux-voice-acct-ids* v1-26) a0-7) (logtest? (ash 1 v1-26) (-> *aux-voice-mgr* bitfield)))
        (return (the-as object (-> *headset* client-talking-s8 v1-26)))
        )
    )
  0
  )

    (net-game-mgr-deathmatch-method-80 () none) ;; 80
    (net-game-mgr-deathmatch-method-81 () none) ;; 81
    (net-game-mgr-deathmatch-method-82 () none) ;; 82
    (net-game-mgr-deathmatch-method-83 () none) ;; 83
    )
  )


;;-*-Lisp-*-
(in-package goal)

;; name: net-simple-destruct-h.gc
;; name in dgo: net-simple-destruct-h
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

(deftype net-simple-destruct (process-focusable)
  ((hit-points          float)
   (incoming-attack-id  int32)
   (impact-velocity     vector  :inline)
   )
  (:state-methods
    idle
    )
  (:methods
    (net-simple-destruct-method-60 (_type_ object vector object) none)
    (net-simple-destruct-method-61 () none)
    (net-simple-destruct-method-62 (_type_ object attack-info object object) none)
    (net-simple-destruct-method-63 () none)
    (net-simple-destruct-method-64 () none)
    (net-simple-destruct-method-65 (_type_ matrix) symbol)
    (net-simple-destruct-method-66 (_type_) none)
    (net-simple-destruct-method-67 (_type_ symbol) none)
    (net-simple-destruct-method-68 (_type_ symbol) none)
    (net-simple-destruct-method-69 (_type_) none)
    )
  )


(deftype net-simple-destruct-mgr (process-nettable)
  ()
  (:methods
    (net-simple-destruct-mgr-method-42 () none)
    (net-simple-destruct-mgr-method-43 () none)
    (net-simple-destruct-mgr-method-44 () none)
    (net-simple-destruct-mgr-method-45 () none)
    (net-simple-destruct-mgr-method-46 () none)
    (net-simple-destruct-mgr-method-47 () none)
    )
  )


(defbehavior net-simple-destruct-mgr-init-remote net-simple-destruct-mgr ((arg0 mem-buffer))
  (process-nettable-method-34 self -1 (new 'static 'rgba :r #xff :g #xff))
  (process-nettable-method-35 self arg0)
  (process-nettable-method-36 self)
  0
  (none)
  )

(defmethod process-nettable-method-41 ((this net-simple-destruct-mgr) (arg0 mem-buffer))
  (ppointer->process (process-spawn
                       net-simple-destruct-mgr
                       :init net-simple-destruct-mgr-init-remote
                       arg0
                       :name "net-simple-destruct-mgr"
                       )
                     )
  )

(defmethod process-nettable-method-37 ((this net-simple-destruct-mgr) (arg0 net-process-class-info))
  (set! (-> arg0 msg-map (-> arg0 msg-count)) 'object-destroyed)
  (+! (-> arg0 msg-count) 1)
  (set! (-> arg0 msg-map (-> arg0 msg-count)) 'object-respawn)
  (+! (-> arg0 msg-count) 1)
  0
  (none)
  )

(define *msg-map-net-simple-destruct-mgr*
  (new 'static 'boxed-array :type symbol :length 0 :allocated-length 64)
  )

(define *net-process-class-info-net-simple-destruct-mgr* (new 'static 'net-process-class-info))

(set! (-> *net-process-class-info-net-simple-destruct-mgr* msg-map) *msg-map-net-simple-destruct-mgr*)

(write-msg-map-rec net-simple-destruct-mgr *net-process-class-info-net-simple-destruct-mgr*)

(set! (-> *net-process-class-info-net-simple-destruct-mgr* owner-type) net-simple-destruct-mgr)

(net-process-class-register *net-process-class-info-net-simple-destruct-mgr*)

(defmethod process-nettable-method-40 ((this net-simple-destruct-mgr))
  *net-process-class-info-net-simple-destruct-mgr*
  )

(define *net-simple-destruct-mgr* (the-as net-simple-destruct-mgr #f))

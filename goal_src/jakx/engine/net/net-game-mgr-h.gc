                                       (new 'static 'level-buffer-state-small)
                                       (new 'static 'level-buffer-state-small)
                                       (new 'static 'level-buffer-state-small)
                                       (new 'static 'level-buffer-state-small)
                                       (new 'static 'level-buffer-state-small)
                                       (new 'static 'level-buffer-state-small)
                                       (new 'static 'level-buffer-state-small)
                                       (new 'static 'level-buffer-state-small)
                                       )
                               )
  )

(define *overall-score-penalty* 0)

(define *total-pts-at-stake* 0)

(define *user-pts-at-stake* 0)

(define *place-suffix* (new 'static 'boxed-array :type string "st" "nd" "rd" "th" "th" "th"))

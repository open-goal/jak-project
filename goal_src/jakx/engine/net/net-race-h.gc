;;-*-Lisp-*-
(in-package goal)

;; name: net-race-h.gc
;; name in dgo: net-race-h
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

(deftype net-player-race (net-player)
  ((last-on-track-pos        vector      :inline)
   (last-on-track-rot        quaternion  :inline)
   (wrong-way-bot            uint64)
   (finish-time              int32)
   (last-lap-update-time     int32)
   (last-on-track-time       int32)
   (last-slice               int32)
   (last-slice-change-time   int32)
   (last-valid-vehicle-time  uint64)
   (rstate                   racer-state)
   (current-lap              int8)
   (racer-idx                int8)
   (current-lap-start-time   int32)
   (best-lap-time            int32)
   (speed-factor             float)
   (max-lap-reached          int32)
   )
  (:methods
    (net-player-race-method-98 () none)
    (net-player-race-method-99 () none)
    (net-player-race-method-100 () none)
    (net-player-race-method-101 () none)
    (net-player-race-method-102 () none)
    (net-player-race-method-103 () none)
    (net-player-race-method-104 () none)
    (net-player-race-method-105 () none)
    (net-player-race-method-106 () none)
    (net-player-race-method-107 () none)
    )
  )


(defbehavior net-player-race-init-remote net-player-race ((arg0 int))
  (process-nettable-method-34 self -1 (new 'static 'rgba :r #xff :g #xff))
  (process-nettable-method-35 self arg0)
  (process-nettable-method-36 self)
  0
  (none)
  )

(defmethod process-nettable-method-41 ((this net-player-race) (arg0 int))
  (ppointer->process
    (process-spawn net-player-race :init net-player-race-init-remote arg0 :name "net-player-race")
    )
  )

(defmethod process-nettable-method-37 ((this net-player-race) (arg0 net-process-class-info))
  (set! (-> arg0 msg-map (-> arg0 msg-count)) 'lap-changed)
  (+! (-> arg0 msg-count) 1)
  (set! (-> arg0 msg-map (-> arg0 msg-count)) 'player-finished)
  (+! (-> arg0 msg-count) 1)
  0
  (none)
  )

(define *msg-map-net-player-race* (new 'static 'boxed-array :type symbol :length 0 :allocated-length 64))

(define *net-process-class-info-net-player-race* (new 'static 'net-process-class-info))

(set! (-> *net-process-class-info-net-player-race* msg-map) *msg-map-net-player-race*)

(write-msg-map-rec net-player-race *net-process-class-info-net-player-race*)

(set! (-> *net-process-class-info-net-player-race* owner-type) net-player-race)

(net-process-class-register *net-process-class-info-net-player-race*)

(defmethod process-nettable-method-40 ((this net-player-race))
  *net-process-class-info-net-player-race*
  )

(deftype net-game-mgr-race (net-game-mgr)
  ((lap-count         int8)
   (racer-ct          int8)
   (racer-ids         int8  24)
   (race-count-down   int8)
   (unknown-uint32-1  uint32)
   (unknown-uint32-2  uint32)
   (unknown-uint32-3  uint32)
   (banner            uint64)
   (hud-clock         uint64)
   (auto-end-time     int32)
   )
  (:methods
    (net-game-mgr-race-method-80 () none)
    (net-game-mgr-race-method-81 () none)
    (net-game-mgr-race-method-82 () none)
    (net-game-mgr-race-method-83 () none)
    (net-game-mgr-race-method-84 () none)
    (net-game-mgr-race-method-85 () none)
    (net-game-mgr-race-method-86 () none)
    (net-game-mgr-race-method-87 () none)
    )
  )


(defbehavior net-game-mgr-race-init-remote net-game-mgr-race ((arg0 int))
  (process-nettable-method-34 self -1 (new 'static 'rgba :r #xff :g #xff))
  (process-nettable-method-35 self arg0)
  (process-nettable-method-36 self)
  0
  (none)
  )

(defmethod process-nettable-method-41 ((this net-game-mgr-race) (arg0 int))
  (ppointer->process
    (process-spawn net-game-mgr-race :init net-game-mgr-race-init-remote arg0 :name "net-game-mgr-race")
    )
  )

(defmethod process-nettable-method-37 ((this net-game-mgr-race) (arg0 net-process-class-info))
  0
  (none)
  )

(define *msg-map-net-game-mgr-race* (new 'static 'boxed-array :type symbol :length 0 :allocated-length 64))

(define *net-process-class-info-net-game-mgr-race* (new 'static 'net-process-class-info))

(set! (-> *net-process-class-info-net-game-mgr-race* msg-map) *msg-map-net-game-mgr-race*)

(write-msg-map-rec net-game-mgr-race *net-process-class-info-net-game-mgr-race*)

(set! (-> *net-process-class-info-net-game-mgr-race* owner-type) net-game-mgr-race)

(net-process-class-register *net-process-class-info-net-game-mgr-race*)

(defmethod process-nettable-method-40 ((this net-game-mgr-race))
  *net-process-class-info-net-game-mgr-race*
  )

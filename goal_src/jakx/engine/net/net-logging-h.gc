;;-*-Lisp-*-
(in-package goal)

;; name: net-logging-h.gc
;; name in dgo: net-logging-h
;; dgos: ENGINE, GAME

;; +++net-log-event-type
(defenum net-log-event-type
  :type uint8
  (start 0)
  (client-join 1)
  (client-leave 2)
  (session-master-change 3)
  (msg 4)
  (comment 5)
  (ident 6)
  )
;; ---net-log-event-type

;; DECOMP BEGINS

(deftype net-log-event-header (structure)
  ((length  uint16)
   (type    net-log-event-type)
   (pad     int8)
   (time    int32)
   (id      int32)
   )
  )


(define *net-log-tmp-header* (new 'static 'net-log-event-header))

(define *comment-string* (new 'global 'string 200 ""))

;;-*-Lisp-*-
(in-package goal)

;; name: scert-5-h.gc
;; name in dgo: scert-5-h
;; dgos: ENGINE, GAME

;; +++medius-application-type
(defenum medius-application-type
  :type int32
  (game 0)
  (lobby-chat-channel 1)
  (extra-medius-application-type #xffffff)
  )
;; ---medius-application-type

;; +++medius-world-security-level-type
(defenum medius-world-security-level-type
  :type int32
  (world-security-none 0)
  (world-security-player-password 1)
  (world-security-closed 2)
  (world-security-spectator-password 4)
  (world-security-extra #xffffff)
  )
;; ---medius-world-security-level-type

;; +++medius-world-generic-field-level-type
(defenum medius-world-generic-field-level-type
  :type int32
  (medius-world-generic-field-level0 0)
  (medius-world-generic-field-level1 1)
  (medius-world-generic-field-level2 2)
  (medius-world-generic-field-level3 4)
  (medius-world-generic-field-level4 8)
  (medius-world-generic-field-level12 16)
  (medius-world-generic-field-level123 32)
  (medius-world-generic-field-level1234 64)
  (medius-world-generic-field-level23 128)
  (medius-world-generic-field-level234 256)
  (medius-world-generic-field-level34 512)
  (extra-medius-world-generic-field-level-type #xffffff)
  )
;; ---medius-world-generic-field-level-type

;; +++medius-chat-message-type
(defenum medius-chat-message-type
  :type int32
  (broadcast 0)
  (whisper 1)
  (broadcast-across-entire-universe 2)
  (extra-medius-chat-message-type #xffffff)
  )
;; ---medius-chat-message-type

;; +++medius-binary-message-type
(defenum medius-binary-message-type
  :type int32
  (broadcast-binary-msg 0)
  (target-binary-msg 1)
  (broadcast-binary-msg-across-entire-universe 2)
  (extra-medius-binary-message-type #xffffff)
  )
;; ---medius-binary-message-type

;; +++medius-chat-toggle
(defenum medius-chat-toggle
  :type int32
  (medius-chat-enable 0)
  (medius-chat-disable 1)
  (extra-medius-chat-toggle #xffffff)
  )
;; ---medius-chat-toggle

;; +++medius-clan-invitations-response-status
(defenum medius-clan-invitations-response-status
  :type int32
  (clan-invitation-undecided 0)
  (clan-invitation-accept 1)
  (clan-invitation-decline 2)
  (clan-invitation-revoked 3)
  (extra-medius-clan-invitations-response-status #xffffff)
  )
;; ---medius-clan-invitations-response-status

;; +++medius-sort-order
(defenum medius-sort-order
  :type int32
  (medius-ascending 0)
  (medius-descending 1)
  (extra-medius-sort-order #xffffff)
  )
;; ---medius-sort-order

;; +++medius-game-list-filter-field
(defenum medius-game-list-filter-field
  :type int32
  (medius-filter-player-count 1)
  (medius-filter-min-players 2)
  (medius-filter-max-players 3)
  (medius-filter-game-level 4)
  (medius-filter-player-skill-level 5)
  (medius-filter-rules-set 6)
  (medius-filter-generic-field-1 7)
  (medius-filter-generic-field-2 8)
  (medius-filter-generic-field-3 9)
  (medius-filter-lobby-worldid 10)
  (extra-medius-game-list-filter-field #xffffff)
  )
;; ---medius-game-list-filter-field

;; +++medius-device-type
(defenum medius-device-type
  :type int32
  (medius-memcard 0)
  (medius-hdd 1)
  (medius-host0 2)
  (extra-medius-device-type #xffffff)
  )
;; ---medius-device-type

;; +++medius-stored-confirmation-type
(defenum medius-stored-confirmation-type
  :type int32
  (medius-stored-item-already-exists -4)
  (medius-stored-directory-not-found -3)
  (medius-stored-device-not-found -2)
  (medius-stored-file-not-found -1)
  (medius-stored-success 0)
  (extra-medius-stored-confirmation-type #xffffff)
  )
;; ---medius-stored-confirmation-type

;; +++medius-game-host-type
(defenum medius-game-host-type
  :type int32
  (medius-game-host-client-server 0)
  (medius-game-host-integrated-server 1)
  (medius-game-host-peer-to-peer 2)
  (medius-game-host-lanplay 3)
  (medius-game-host-client-server-aux-udp 4)
  (extra-medius-game-host #xffffff)
  )
;; ---medius-game-host-type

;; DECOMP BEGINS

(deftype medius-add-to-buddy-list-confirmation-response (structure)
  ((message-id           uint8  21)
   (status-code          medius-status-code)
   (target-account-id    int32)
   (target-account-name  uint8  32)
   )
  )


(deftype medius-add-to-buddy-list-fwd-confirmation-request0 (structure)
  ((message-id               uint8  21)
   (originator-account-id    int32)
   (originator-account-name  uint8  32)
   )
  )



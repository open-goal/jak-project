(deftype medius-chat-fwd-message (structure)
  ((message-id                  uint8  21)
   (originator-account-id       int32)
   (originator-account-name     uint8  32)
   (originator-account-name-s8  int8   32 :overlay-at (-> originator-account-name 0))
   (message-type                medius-chat-message-type)
   (message                     uint8  64)
   (message-s8                  int8   64 :overlay-at (-> message 0))
   )
  )


(deftype medius-chat-message (structure)
  ((message-id         uint8  21)
   (session-key        uint8  17)
   (message-type       medius-chat-message-type)
   (target-account-id  int32)
   (message            uint8  64)
   (message-s8         int8   64 :overlay-at (-> message 0))
   )
  )


(deftype medius-binary-fwd-message (structure)
  ((message-id             uint8  21)
   (originator-account-id  int32)
   (message-type           medius-binary-message-type)
   (message                uint8  400)
   )
  )


(deftype medius-binary-message (structure)
  ((message-id         uint8  21)
   (session-key        uint8  17)
   (message-type       medius-binary-message-type)
   (target-account-id  int32)
   (message            uint8  400)
   )
  )



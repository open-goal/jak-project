(define *sent-end-of-game-report* #f)

(defstate playing-game (net-mgr)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('player-in-ready-room)
       (set! *player-entered-ready-room* #t)
       (when (logtest? (shl #x8000 16) (-> *medius-joined-game-info* generic-field1))
         (set! (-> *medius-joined-game-info* generic-field1)
               (the-as int (logand (the-as uint #xffffffff7fffffff) (-> *medius-joined-game-info* generic-field1)))
               )
         (set! (-> self lobby-state last-report-time)
               (the-as int (+ (-> *display* real-clock frame-counter) (seconds -60)))
               )
         (send-game-update)
         (update-lan-find self)
         (when (and (= (if *net-mgr*
                           (-> *net-mgr* game-state local-machine-idx)
                           0
                           )
                       (-> *net-mgr* game-state session-master-idx)
                       )
                    (is-clan-challenge)
                    )
           (dotimes (gp-0 (-> *medius-my-clan* members ct))
             (let ((a1-1 (get-id (-> *medius-my-clan* members data gp-0))))
               (if (!= a1-1 (-> self lobby-state my-account-id))
                   (send-chat-with-game-id "@ClanGameCreated" a1-1 #t)
                   )
               )
             )
           (let ((gp-1 (the-as medius-cached-info-clan (lookup *medius-clan-cache* *medius-enemy-clan-id* 9000 #f #f))))
             (when gp-1
               (when (!= gp-1 'error)
                 (dotimes (s5-0 (-> gp-1 members ct))
                   (let ((a1-3 (get-id (-> gp-1 members data s5-0))))
                     (send-chat-with-game-id "@ClanGameCreated" a1-3 #t)
                     )
                   )
                 #f
                 )
               )
             )
           )
         )
       )
      (('do-behavior)
       (mem-copy! (the-as pointer *net-mgr-pending-behavior*) (the-as pointer block) 72)
       (let ((v0-0 (the-as object #t)))
         (set! *net-mgr-pending-behavior-valid* (the-as symbol v0-0))
         v0-0
         )
       )
      (('quit-game)
       (go-virtual leaving-game 'local-quit)
       )
      (('net-error)
       (go-virtual leaving-game 'net-error)
       )
      (('anti-cheat)
       (go-virtual leaving-game 'lobby-anti-cheat)
       )
      (('leave-game)
       (when *lobby-menu-manager*
         (when (= (if *net-mgr*
                      (-> *net-mgr* game-state local-machine-idx)
                      0
                      )
                  (-> *net-mgr* game-state session-master-idx)
                  )
           (kick-machines -2 'game-disbanded)
           (set! *sent-end-of-game-report* #t)
           (send-end-of-game-report)
           )
         )
       (go-virtual leaving-game 'local-disband)
       )
      (else
        (net-mgr-default-handler proc argc message block)
        )
      )
    )
  :exit (behavior ()
    (headset-deactivate)
    )
  :code (behavior ()
    (set! *sent-end-of-game-report* #f)
    (set! (-> self last-game-type) (-> self game-type))
    (update-lan-find self)
    (net-packet-recv-time-reset-all)
    (update self)
    (if *net-log-write*
        (net-log-start (-> self game-state local-machine-idx) (-> self game-state session-master-idx))
        )
    (until #f
      (when (nonzero? (-> self lobby-state connect-handle))
        (net-mgr-method-55 self)
        (set! *scert-function-id* (scert-function medius-update))
        (knet-scert-function-0-args)
        (net-mgr-process-pending-behavior)
        (when *lobby-menu-manager*
          (medius-cache-tick *medius-player-cache*)
          (medius-cache-tick *medius-game-status-cache*)
          )
        )
      (when (nonzero? (-> self lobby-state connect-handle-mgcl))
        (set! *scert-function-id* (scert-function mgcl-update))
        (knet-scert-function-0-args)
        (check-game-on-me)
        )
      (set! *net-error* 0)
      (update self)
      (when (nonzero? *net-error*)
        (format 0 "dme net-error ~D - leaving game~%" *net-error*)
        (go-virtual leaving-game 'net-error)
        )
      (if (-> self game-state kicked)
          (go-virtual leaving-game (-> self game-state kicked))
          )
      (when (= (-> self lobby-state last-dme-error) 2)
        (format 0 "connection lost - leaving game~%")
        (go-virtual leaving-game 'net-error)
        )
      (if (nonzero? (-> self lobby-state connect-handle))
          (net-mgr-process-pending-behavior)
          )
      (if (not (is-cd-in?))
          (go-virtual leaving-game 'lobby-no-cd)
          )
      (if (nonzero? (-> *sound-iop-info* dirtycd))
          (go-virtual leaving-game 'lobby-dirty-cd)
          )
      (suspend)
      )
    #f
    )
  )

(defstate leaving-game (net-mgr)
  :virtual #t
  :code (behavior ((arg0 symbol))
    (format 0 "leaving game, reason: ~A~%" arg0)
    (when *lobby-menu-manager*
      (case arg0
        (('local-disband)
         )
        (('game-disbanded)
         (send-event *lobby-menu-manager* 'lobby-game-disbanded)
         )
        (('host-activity-timeout)
         (send-event *lobby-menu-manager* 'lobby-host-activity-timeout)
         )
        (('game-timeout)
         (send-event *lobby-menu-manager* 'lobby-game-timeout)
         )
        (('game-unavailable)
         (send-event *lobby-menu-manager* 'lobby-game-unavailable)
         )
        (('anti-cheat)
         (send-event *lobby-menu-manager* 'lobby-anti-cheat)
         )
        (('lobby-dirty-cd 'lobby-no-cd)
         (send-event *lobby-menu-manager* arg0)
         )
        (('booted)
         (send-event *lobby-menu-manager* 'booted)
         )
        (else
          (send-event *lobby-menu-manager* 'lobby-unexpected-error)
          )
        )
      )
    (let ((v1-27 #f))
      (if (and (= (if *net-mgr*
                      (-> *net-mgr* game-state local-machine-idx)
                      0
                      )
                  (-> *net-mgr* game-state session-master-idx)
                  )
               (= arg0 'local-disband)
               )
          (set! v1-27 #t)
          )
      (when (and (not *lobby-menu-manager*) *net-game-mgr*)
        (dotimes (a0-38 *active-net-non-spectator-count*)
          (if (and (and (>= (-> *active-net-non-spectators* a0-38 player-id) 0)
                        (< (-> *active-net-non-spectators* a0-38 player-id) 16)
                        )
                   (!= (/ (-> *active-net-non-spectators* a0-38 player-id) 2) (if *net-mgr*
                                                                                  (-> *net-mgr* game-state local-machine-idx)
                                                                                  0
                                                                                  )
                       )
                   )
              (goto cfg-65)
              )
          )
        (set! v1-27 #t)
        )
      (label cfg-65)
      (if (or (= arg0 'entity-panic) (= arg0 'lobby-dirty-cd) (= arg0 'lobby-no-cd))
          (set! v1-27 #f)
          )
      (if *sent-end-of-game-report*
          (set! v1-27 #f)
          )
      (when v1-27
        (format 0 "sending end-of-game...~%")
        (send-end-of-game-report)
        (send-game-update)
        )
      )
    (if *net-world*
        (cleanup-at-game-end *net-world*)
        )
    (if *net-log-write*
        (net-log-stop)
        )
    (net-process-mgr-stop)
    (do-disconnect #t #t #f)
    (dotimes (s5-0 180)
      (set! *scert-function-id* (scert-function net-update))
      (knet-scert-function-0-args)
      )
    (format 0 "net-mgr-notify: ~A~%" 'game-disconnected)
    (let ((a0-54 (-> *net-mgr* notify alive-list next0)))
      (-> *net-mgr* notify)
      (let ((s5-1 (-> a0-54 next0)))
        (while (!= a0-54 (-> *net-mgr* notify alive-list-end))
          (if (logtest? (the-as int (-> (the-as connection a0-54) param1)) 4)
              (send-event
                ((method-of-type connection get-process) (the-as connection a0-54))
                'game-disconnected
                :from *net-mgr*
                )
              )
          (set! a0-54 s5-1)
          (-> *net-mgr* notify)
          (set! s5-1 (-> s5-1 next0))
          )
        )
      )
    (update-lan-find self)
    (if (nonzero? (-> self lobby-state connect-handle))
        (update-client-state (medius-user-action left-game-world) (-> self lobby-state channel-id) #f)
        )
    (cond
      (*lobby-menu-manager*
        (if (or (= arg0 'game-disbanded)
                (= arg0 'game-timeout)
                (= arg0 'game-unavailable)
                (= arg0 'local-disband)
                (= arg0 'booted)
                (= arg0 'host-activity-timeout)
                )
            (lobby-non-fatal-error #f)
            (lobby-fatal-error #f)
            )
        )
      (else
        (stop 'play 0)
        (reset-actors-by-game-type 'game)
        (let ((v1-76 arg0))
          (set! *lobby-reset-mode* (cond
                                     ((or (= v1-76 'local-disband) (= v1-76 'local-quit) (= v1-76 'entity-panic))
                                      'quit
                                      )
                                     ((= v1-76 'anti-cheat)
                                      'lobby-anti-cheat
                                      )
                                     ((or (= v1-76 'lobby-dirty-cd)
                                          (= v1-76 'lobby-no-cd)
                                          (= v1-76 'booted)
                                          (= v1-76 'game-disbanded)
                                          (= v1-76 'game-timeout)
                                          (= v1-76 'host-activity-timeout)
                                          (= v1-76 'mc-ghost-error)
                                          )
                                      arg0
                                      )
                                     (else
                                       'net-game-disconnected
                                       )
                                     )
                )
          )
        (start 'play (get-continue-by-name *game-info* "menu2-start") 0)
        (if (nonzero? (-> self lobby-state connect-handle))
            (go-virtual lobby-idle)
            (go-virtual idle)
            )
        )
      )
    (format 0 "shouldn't get here, dude!~%")
    (break!)
    0
    )
  )

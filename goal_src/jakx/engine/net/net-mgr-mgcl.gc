(defmethod init-mgcl ((this net-mgr))
  (mem-clear! (the-as pointer *mgcl-init-in-params*) 68)
  (mem-clear! (the-as pointer *mgcl-init-out-params*) 4)
  (set! (-> *mgcl-init-in-params* p-local-key-pair) *net-local-rsa-keypair*)
  (set! (-> *mgcl-init-in-params* status) (dme-init-status dmeinitialized))
  (set! (-> *mgcl-init-in-params* my-server-join-game-callback) mgcl-join-game-callback)
  (set! (-> *mgcl-init-in-params* my-server-end-game-callback) mgcl-end-game-callback)
  (set! (-> *mgcl-init-in-params* my-server-world-status-callback) mgcl-world-status-callback)
  (set! (-> *mgcl-init-in-params* my-server-connect-games-callback) mgcl-connect-games-callback)
  (set! (-> *mgcl-init-in-params* max-clients-per-connection) 256)
  (set! *scert-function-id* (scert-function get-application-id))
  (set! (-> *mgcl-init-in-params* application-id) (knet-scert-function-0-args))
  (set! (-> *mgcl-init-in-params* p-application-key-pair) *net-app-rsa-keypair*)
  (set! *scert-function-id* (scert-function mgcl-initialize))
  (let ((a2-0 (knet-scert-function-2-args *mgcl-init-in-params* *mgcl-init-out-params*)))
    (when (nonzero? a2-0)
      (format 0 "mgcl startup error ~D~%" a2-0)
      (return #f)
      )
    )
  (format 0 "mgcl initted ok~%")
  (set! *mgcl-initted* #t)
  #t
  )

;; WARN: Return type mismatch int vs object.
(defun send-game-update ()
  (if (and *lobby-menu-manager*
           *net-mgr*
           (nonzero? (-> *net-mgr* lobby-state connect-handle))
           (= (if *net-mgr*
                  (-> *net-mgr* game-state local-machine-idx)
                  0
                  )
              (-> *net-mgr* game-state session-master-idx)
              )
           )
      (send-chat-msg *net-mgr* "@Game" -1 #t)
      )
  0
  )

;; WARN: Return type mismatch int vs object.
(defun connect-callback-mgcl ((arg0 pointer) (arg1 int))
  (format 0 "connect-callback-mgcl: ~X~%" arg0)
  (when *net-mgr*
    (set! (-> *net-mgr* lobby-state connect-handle-mgcl) arg0)
    (set! (-> *net-mgr* lobby-state callback-occurred) #t)
    (if (not (and (nonzero? arg0) (zero? arg1)))
        (set! (-> *net-mgr* lobby-state got-error) #t)
        )
    )
  0
  )

;; WARN: Return type mismatch symbol vs object.
(defbehavior get-mgcl-connection net-mgr ()
  (set! *mgcl-session-key-valid* #f)
  (set! (-> self lobby-state connect-handle-mgcl) (the-as pointer 0))
  (format 0 "connecting to MAS (MGCL)~%")
  (mem-clear! (the-as pointer *mgcl-connect-in-params*) 160)
  (mem-clear! (the-as pointer *mgcl-connect-out-params*) 4)
  (set! *scert-function-id* (scert-function mgcl-connect-in-params-defaults))
  (knet-scert-function-1-args *mgcl-connect-in-params*)
  (set! *scert-function-id* (scert-function mgcl-connect-in-params-setup))
  (knet-scert-function-5-args
    *mgcl-connect-in-params*
    (-> *medius-mas-hostname* data)
    *medius-mas-port*
    1
    connect-callback-mgcl
    )
  (set! *scert-function-id* (scert-function get-server-public-key))
  (knet-scert-function-1-args *medius-public-key*)
  (mem-copy!
    (the-as pointer (-> *mgcl-connect-in-params* connection-info server-key))
    (the-as pointer *medius-public-key*)
    64
    )
  (format
    0
    "mgcl-connecting to ~G:~D~%"
    (-> *mgcl-connect-in-params* connection-info address-list a-address-list 0 address)
    (-> *mgcl-connect-in-params* connection-info address-list a-address-list 0 port)
    )
  (reset-lobby-state! self)
  (set! *scert-function-id* (scert-function mgcl-connect))
  (let ((gp-0 (knet-scert-function-3-args *mgcl-connect-in-params* *mgcl-connect-out-params* #f)))
    (when (nonzero? gp-0)
      (format 0 "initial function call returned ~D~%" gp-0)
      (set! (-> self lobby-state got-error) #t)
      (set! (-> self lobby-state last-mgcl-error) gp-0)
      )
    )
  (net-async-wait (seconds 3600) #t)
  (cond
    ((or (-> self lobby-state got-error)
         (-> self lobby-state timeout)
         (nonzero? (-> self lobby-state last-medius-error))
         (nonzero? (-> self lobby-state last-mgcl-error))
         (nonzero? (-> self lobby-state last-dme-error))
         (nonzero? (-> self lobby-state callback-status))
         )
     (mgcl-disconnect #t)
     (return (the-as object #f))
     )
    (else
      )
    )
  (format 0 "begin session (MGCL)~%")
  (let ((gp-1 (new 'stack 'medius-server-session-begin-request)))
    (set! *async-request-ct* (+ *async-request-ct* 1))
    (itoa *async-request-ct* (-> gp-1 message-id))
    (set! *scert-function-id* (scert-function get-application-id))
    (set! (-> gp-1 application-id) (knet-scert-function-0-args))
    (set! (-> gp-1 server-type) (mgcl-game-host-type mgclgame-host-peer-to-peer))
    (set! *mgcl-confirmation-offset* 21)
    (reset-lobby-state! self)
    (set! *scert-function-id* (scert-function mgcl-session-begin))
    (let ((gp-2 (knet-scert-function-3-args gp-1 mgcl-simple-request-callback #f)))
      (when (nonzero? gp-2)
        (format 0 "initial function call returned ~D~%" gp-2)
        (set! (-> self lobby-state got-error) #t)
        (set! (-> self lobby-state last-mgcl-error) gp-2)
        )
      )
    )
  (net-async-wait (seconds 36000) #t)
  (cond
    ((or (-> self lobby-state got-error)
         (-> self lobby-state timeout)
         (nonzero? (-> self lobby-state last-medius-error))
         (nonzero? (-> self lobby-state last-mgcl-error))
         (nonzero? (-> self lobby-state last-dme-error))
         (nonzero? (-> self lobby-state callback-status))
         )
     *mgcl-last-response*
     (mgcl-disconnect #t)
     (return (the-as object #f))
     )
    (else
      (let ((v1-42 (the-as medius-server-session-begin-response *mgcl-last-response*)))
        (mem-copy! *mgcl-session-key* (-> v1-42 connect-info a-session-key) 17)
        )
      (set! *mgcl-session-key-valid* #t)
      )
    )
  (format 0 "auth-send (MGCL)~%")
  (let ((gp-3 (new 'stack 'medius-server-authentication-request)))
    (set! *async-request-ct* (+ *async-request-ct* 1))
    (itoa *async-request-ct* (-> gp-3 message-id))
    (set! (-> gp-3 trust-level) (mgcl-trust-level mgcl-not-trusted))
    (set! *mgcl-confirmation-offset* 21)
    (reset-lobby-state! self)
    (set! *scert-function-id* (scert-function mgcl-authenticate))
    (let ((gp-4 (knet-scert-function-3-args gp-3 mgcl-simple-request-callback #f)))
      (when (nonzero? gp-4)
        (format 0 "initial function call returned ~D~%" gp-4)
        (set! (-> self lobby-state got-error) #t)
        (set! (-> self lobby-state last-mgcl-error) gp-4)
        )
      )
    )
  (net-async-wait (seconds 36000) #t)
  (cond
    ((or (-> self lobby-state got-error)
         (-> self lobby-state timeout)
         (nonzero? (-> self lobby-state last-medius-error))
         (nonzero? (-> self lobby-state last-mgcl-error))
         (nonzero? (-> self lobby-state last-dme-error))
         (nonzero? (-> self lobby-state callback-status))
         )
     *mgcl-last-response*
     (mgcl-disconnect #t)
     (return (the-as object #f))
     )
    (else
      (let ((gp-5 (the-as medius-server-authentication-response *mgcl-last-response*)))
        (mem-copy! (the-as pointer *mgcl-connect-info*) (the-as pointer (-> gp-5 connect-info)) 154)
        (mem-copy! *mgcl-access-key* (-> gp-5 connect-info a-access-key) 17)
        )
      )
    )
  (format 0 "disconnect~%")
  (mgcl-disconnect #f)
  (format 0 "connect to MLS (MGCL)~%")
  (mem-clear! (the-as pointer *mgcl-connect-in-params*) 160)
  (mem-clear! (the-as pointer *mgcl-connect-out-params*) 4)
  (mem-copy!
    (the-as pointer (-> *mgcl-connect-in-params* connection-info))
    (the-as pointer *mgcl-connect-info*)
    154
    )
  (set! (-> *mgcl-connect-in-params* pf-connect-callback) connect-callback-mgcl)
  (format
    0
    "mgcl-(mls)-connecting to ~G:~D~%"
    (-> *mgcl-connect-in-params* connection-info address-list a-address-list 0 address)
    (-> *mgcl-connect-in-params* connection-info address-list a-address-list 0 port)
    )
  (reset-lobby-state! self)
  (set! *scert-function-id* (scert-function mgcl-connect))
  (let ((gp-6 (knet-scert-function-3-args *mgcl-connect-in-params* *mgcl-connect-out-params* #f)))
    (when (nonzero? gp-6)
      (format 0 "initial function call returned ~D~%" gp-6)
      (set! (-> self lobby-state got-error) #t)
      (set! (-> self lobby-state last-mgcl-error) gp-6)
      )
    )
  (net-async-wait (seconds 3600) #t)
  (cond
    ((or (-> self lobby-state got-error)
         (-> self lobby-state timeout)
         (nonzero? (-> self lobby-state last-medius-error))
         (nonzero? (-> self lobby-state last-mgcl-error))
         (nonzero? (-> self lobby-state last-dme-error))
         (nonzero? (-> self lobby-state callback-status))
         )
     (mgcl-disconnect #t)
     (return (the-as object #f))
     )
    (else
      )
    )
  (format 0 "ok ... MGCL connected ok...~%")
  #t
  )

;; WARN: Return type mismatch int vs object.
(defbehavior end-game-on-me net-mgr ((arg0 int))
  (let ((gp-0 (new 'stack 'medius-server-end-game-on-me-request)))
    (set! *async-request-ct* (+ *async-request-ct* 1))
    (itoa *async-request-ct* (-> gp-0 message-id))
    (set! (-> gp-0 medius-world-id) arg0)
    (set! *mgcl-confirmation-offset* 21)
    (reset-lobby-state! self)
    (set! *scert-function-id* (scert-function mgcl-server-end-game-on-me))
    (let ((gp-1 (knet-scert-function-3-args gp-0 mgcl-simple-request-callback #f)))
      (when (nonzero? gp-1)
        (format 0 "initial function call returned ~D~%" gp-1)
        (set! (-> self lobby-state got-error) #t)
        (set! (-> self lobby-state last-mgcl-error) gp-1)
        )
      )
    )
  (net-async-wait (seconds 36000) #t)
  (cond
    ((or (-> self lobby-state got-error)
         (-> self lobby-state timeout)
         (nonzero? (-> self lobby-state last-medius-error))
         (nonzero? (-> self lobby-state last-mgcl-error))
         (nonzero? (-> self lobby-state last-dme-error))
         (nonzero? (-> self lobby-state callback-status))
         )
     *mgcl-last-response*
     0
     )
    (else
      *mgcl-last-response*
      0
      )
    )
  0
  )

;; WARN: Swapped fp-relative label and field offsets for "fish"
;; WARN: Return type mismatch symbol vs object.
(defbehavior create-game-on-me net-mgr ()
  (format 0 "create-game-on-me~%")
  (dotimes (gp-0 2)
    (let ((s5-0 (new 'stack 'medius-server-create-game-on-me-request)))
      (set! *async-request-ct* (+ *async-request-ct* 1))
      (itoa *async-request-ct* (-> s5-0 message-id))
      (copy-charp<-charp (-> s5-0 game-name) (-> "fish" data))
      (set! *scert-function-id* (scert-function get-application-id))
      (set! (-> s5-0 application-id) (knet-scert-function-0-args))
      (set! (-> s5-0 min-clients) 0)
      (set! (-> s5-0 max-clients) 8)
      (set! (-> s5-0 world-id) 1)
      (set! (-> s5-0 account-id) (-> self lobby-state my-account-id))
      (copy-charp<-charp (-> *medius-joined-game-info* game-name) (-> s5-0 game-name))
      (set! (-> *medius-joined-game-info* min-players) 1)
      (set! (-> *medius-joined-game-info* max-players) 8)
      (set! *mgcl-confirmation-offset* 21)
      (reset-lobby-state! self)
      (set! *scert-function-id* (scert-function mgcl-server-create-game-on-me))
      (let ((s5-1 (knet-scert-function-3-args s5-0 mgcl-simple-request-callback #f)))
        (when (nonzero? s5-1)
          (format 0 "initial function call returned ~D~%" s5-1)
          (set! (-> self lobby-state got-error) #t)
          (set! (-> self lobby-state last-mgcl-error) s5-1)
          )
        )
      )
    (net-async-wait (seconds 36000) #t)
    (cond
      ((or (-> self lobby-state got-error)
           (-> self lobby-state timeout)
           (nonzero? (-> self lobby-state last-medius-error))
           (nonzero? (-> self lobby-state last-mgcl-error))
           (nonzero? (-> self lobby-state last-dme-error))
           (nonzero? (-> self lobby-state callback-status))
           )
       (let ((v1-25 (the-as medius-server-create-game-on-me-response *mgcl-last-response*)))
         (case (-> v1-25 confirmation)
           ((-16)
            (end-game-on-me (-> v1-25 medius-world-id))
            )
           (else
             (return (the-as object #f))
             )
           )
         )
       )
      (else
        (let ((v1-28 (the-as medius-server-create-game-on-me-response *mgcl-last-response*)))
          (set! (-> self lobby-state created-game-id) (-> v1-28 medius-world-id))
          (set! (-> self lobby-state joined-game-id)
                (the-as int (the-as medius-server-create-game-on-me-response (-> v1-28 medius-world-id)))
                )
          )
        (set! (-> self lobby-state game-on-me) (the-as uint 3))
        (return (the-as object #t))
        )
      )
    )
  #f
  )

;; WARN: Return type mismatch int vs object.
(defbehavior send-end-of-game-report net-mgr ()
  (let ((gp-0 (new 'stack-no-clear 'medius-end-game-report)))
    (mem-clear! (-> gp-0 session-key) 124)
    (mem-copy! (-> gp-0 session-key) *medius-session-key* 17)
    (set! (-> gp-0 medius-world-id) (-> self lobby-state joined-game-id))
    (set! *scert-function-id* (scert-function medius-end-game-report))
    (knet-scert-function-1-args (-> gp-0 session-key))
    )
  0
  )

;; WARN: Return type mismatch int vs object.
(defmethod net-mgr-method-55 ((this net-mgr))
  (if (< (- (-> *display* real-clock frame-counter) (the-as time-frame (-> this lobby-state last-report-time)))
         (seconds 25)
         )
      (return (the-as object #f))
      )
  (set! (-> this lobby-state last-report-time) (the-as int (-> *display* real-clock frame-counter)))
  (when (and (-> this next-state) (= (-> this next-state name) 'playing-game))
    (let ((s5-0 (alloc-msg-buffer)))
      (write-int8 s5-0 0)
      (write-int8 s5-0 0)
      (write-int8 s5-0 7)
      (set! (-> (the-as (pointer int8) (-> s5-0 base)) 1) (+ (bytes-used s5-0) -1))
      (net-send-msg 64 s5-0 -2)
      (net-send-msg 0 s5-0 -2)
      (free-msg-buffer s5-0)
      )
    )
  (when (= (if *net-mgr*
               (-> *net-mgr* game-state local-machine-idx)
               0
               )
           (-> *net-mgr* game-state session-master-idx)
           )
    (mem-clear! (the-as pointer *medius-world-report*) 384)
    (set! (-> *medius-joined-game-info* max-players) (-> *net-world* net-state max-humans))
    (set! (-> *medius-world-report* game-level) (if *net-world*
                                                    (the-as int (-> *net-world* task-node))
                                                    29
                                                    )
          )
    (if (beta?)
        (set! (-> *medius-world-report* game-level) (if *net-world*
                                                        (the-as int (-> *net-world* task-node))
                                                        20
                                                        )
              )
        )
    (when *net-world*
      (let ((v1-41 (-> *game-info* sub-task-list (-> *net-world* task-node))))
        (set! (-> *medius-world-report* game-level)
              (the-as int (-> *game-info* play-list (-> v1-41 task) task-level))
              )
        (set! (-> *medius-world-report* rules-set) (the-as int (-> v1-41 net-play-mode)))
        )
      )
    (set! (-> *medius-joined-game-info* generic-field3) (-> *net-world* net-state vehicle-class))
    (mem-copy! (-> *medius-world-report* session-key) *medius-session-key* 17)
    (set! (-> *medius-world-report* medius-world-id) (-> this lobby-state joined-game-id))
    (set! (-> *medius-world-report* player-count) 0)
    (when *net-process-mgr*
      (dotimes (v1-50 8)
        (+! (-> *medius-world-report* player-count) (-> *net-process-mgr* machines v1-50 local-player-ct))
        )
      )
    (mem-copy! (-> *medius-world-report* game-name) (-> *medius-joined-game-info* game-name) 64)
    (set! (-> *medius-world-report* min-players) (-> *medius-joined-game-info* min-players))
    (set! (-> *medius-world-report* max-players) (-> *medius-joined-game-info* max-players))
    (set! (-> *medius-world-report* generic-field1) (-> *medius-joined-game-info* generic-field1))
    (set! (-> *medius-world-report* generic-field2) (-> *medius-joined-game-info* generic-field2))
    (set! (-> *medius-world-report* generic-field3) (-> *medius-joined-game-info* generic-field3))
    (set! (-> *medius-world-report* world-status) (the-as medius-world-status *medius-world-status*))
    (let ((s5-1 (new 'stack-no-clear 'inline-array 'mem-buffer 1)))
      (set-buffer! (-> s5-1 0) (-> *medius-joined-game-info* game-stats) 256)
      (write-int32 (-> s5-1 0) (get-total-humans))
      (skip-bytes (-> s5-1 0) 4)
      (skip-bytes (-> s5-1 0) 4)
      (write-int32 (-> s5-1 0) (get-total-skill-level))
      (write-int32 (-> s5-1 0) *avg-ping*)
      )
    (mem-copy! (-> *medius-world-report* game-stats) (-> *medius-joined-game-info* game-stats) 256)
    (if (!= *medius-world-status* 1)
        (logior! (-> *medius-world-report* generic-field1) #x40000000)
        )
    (set! *scert-function-id* (scert-function medius-world-report))
    (knet-scert-function-1-args *medius-world-report*)
    )
  (when (nonzero? (-> this lobby-state connect-handle-mgcl))
    (mem-clear! (the-as pointer *mgcl-server-report*) 32)
    (mem-copy! (-> *mgcl-server-report* session-key) *mgcl-session-key* 17)
    (set! (-> *mgcl-server-report* max-worlds) 1)
    (set! (-> *mgcl-server-report* max-players-per-world) 24)
    (set! (-> *mgcl-server-report* active-world-count) 1)
    (set! *scert-function-id* (scert-function net-get-num-clients))
    (knet-scert-function-2-args
      (&-> *mgcl-server-report* total-active-players)
      (-> this game-state connect-handle)
      )
    (set! (-> *mgcl-server-report* alert-level) (mgcl-alert-level mgcl-alert-none))
    (set! *scert-function-id* (scert-function mgcl-server-report))
    (knet-scert-function-1-args *mgcl-server-report*)
    )
  (mem-clear! (the-as pointer *medius-player-report*) 280)
  (mem-copy! (-> *medius-player-report* session-key) *medius-session-key* 17)
  (set! (-> *medius-player-report* medius-world-id) (-> this lobby-state joined-game-id))

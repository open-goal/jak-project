;; DECOMP BEGINS

(define *medius-server-session-begin-request* (new 'static 'medius-server-session-begin-request))

(define *mgcl-init-in-params* (new 'static 'mgclinitialize-in-params))

(define *mgcl-init-out-params* (new 'static 'mgclinitialize-out-params))

(define *mgcl-connect-in-params* (new 'static 'mgclconnect-in-params))

(define *mgcl-connect-out-params* (new 'static 'mgclconnect-out-params))

(define *mgcl-connect-info* (new 'static 'net-connection-info))

(define *mgcl-server-report* (new 'static 'medius-server-report-type))

(define *mgcl-access-key*
  (new 'static 'array uint8 17 #x0 #x0 #x0 #x0 #x0 #x0 #x0 #x0 #x0 #x0 #x0 #x0 #x0 #x0 #x0 #x0 #x0)
  )

(define *player-entered-ready-room* #f)

(define *medius-server-join-game-response* (new 'static 'medius-server-join-game-response))

;; WARN: Swapped fp-relative label and field offsets for "hello"
;; WARN: Return type mismatch int vs object.
(defun mgcl-join-game-callback ((arg0 medius-server-join-game-request))
  (format 0 ">>>mgcl-join-game-callback~%")
  (let ((gp-0 *medius-server-join-game-response*))
    (mem-clear! (the-as pointer gp-0) 104)
    (mem-copy! (-> gp-0 message-id) (-> arg0 message-id) 21)
    (cond
      ((-> *net-mgr* game-state locked)
       (set! (-> gp-0 confirmation) -1)
       )
      (else
        (set! (-> gp-0 confirmation) 0)
        (mem-copy! (the-as pointer (-> gp-0 pub-key)) (the-as pointer (-> *net-local-rsa-keypair* public-key)) 64)
        (copy-charp<-charp (-> gp-0 access-key) (-> "hello" data))
        (set! *scert-function-id* (scert-function mgcl-send-join-game-response))
        (let ((a2-2 (knet-scert-function-1-args gp-0)))
          (format 0 ">>> MGCLJoinGameResponse returned ~D~%" a2-2)
          )
        )
      )
    )
  0
  )


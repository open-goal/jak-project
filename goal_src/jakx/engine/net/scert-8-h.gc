(deftype medius-join-game-request0 (structure)
  ((message-id       uint8             21)
   (session-key      uint8             17)
   (medius-world-id  int32)
   (game-password    uint8             32)
   (game-host-type   int32)
   (address-list     net-address-list  :inline)
   )
  )


(deftype medius-join-game-request (structure)
  ((message-id       uint8             21)
   (session-key      uint8             17)
   (medius-world-id  int32)
   (join-type        int32)
   (game-password    uint8             32)
   (game-host-type   int32)
   (pub-key          rsa-key           :inline)
   (address-list     net-address-list  :inline)
   )
  )


(deftype medius-join-game-response (structure)
  ((message-id      uint8                21)
   (status-code     medius-status-code)
   (game-host-type  int32)
   (connect-info    net-connection-info  :inline)
   )
  )



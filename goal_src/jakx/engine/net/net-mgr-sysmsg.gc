(defun handle-sys-msg ((arg0 net-type-system-message-data))
  (with-pp
    (case (-> arg0 severity)
      ((200)
       (let* ((v1-1 (-> arg0 n-message-length))
              (a2-1 (min 1023 (the-as int v1-1)))
              )
         (mem-copy! *sys-msg-cheat* (the-as pointer (-> arg0 p-message)) a2-1)
         )
       (let ((gp-1 pp))
         (set! pp *net-mgr*)
         (if *lobby-menu-manager*
             (send-event *lobby-menu-manager* 'lobby-anti-cheat :from *net-mgr*)
             (send-event *net-mgr* 'anti-cheat :from *net-mgr*)
             )
         (set! pp gp-1)
         )
       )
      ((201)
       (let ((s5-0 (new 'stack-no-clear 'medius-chat-fwd-message)))
         (mem-clear! (-> s5-0 message-id) 128)
         (let ((s4-1 (min 64 (strlen (the-as pointer (-> arg0 p-message))))))
           (mem-copy! (-> s5-0 message) (the-as pointer (-> arg0 p-message)) s4-1)
           (set! (-> s5-0 message s4-1) (the-as uint 0))
           )
         0
         (set! (-> s5-0 message-type) 1)
         (handle-chat-msg (-> s5-0 message-id) #f)
         )
       )
      )
    0
    (none)
    )
  )

  #f
  )

;; WARN: Swapped fp-relative label and field offsets for "@CLAN_CHAT"
;; WARN: Return type mismatch int vs object.
(defbehavior medius-game-status-info-retrieve-behavior net-mgr ((arg0 medius-cached-info-game-status))
  (if (<= (-> arg0 medius-id) 0)
      (return (the-as object #f))
      )
  (let ((s5-0 (new 'stack 'medius-game-info-request)))
    (set! *async-request-ct* (+ *async-request-ct* 1))
    (itoa *async-request-ct* (-> s5-0 message-id))
    (mem-copy! (-> s5-0 session-key) *medius-session-key* 17)
    (set! (-> s5-0 medius-world-id) (-> arg0 medius-id))
    (reset-lobby-state! self)
    (set! *scert-function-id* (scert-function medius-game-info))
    (let ((s5-1 (knet-scert-function-3-args s5-0 medius-simple-request-callback #f)))
      (when (nonzero? s5-1)
        (format 0 "initial function call returned ~D~%" s5-1)
        (set! (-> self lobby-state got-error) #t)
        (set! (-> self lobby-state last-medius-error) s5-1)
        )
      )
    )
  (net-async-wait (seconds 15) #t)
  (cond
    ((or (-> self lobby-state got-error)
         (-> self lobby-state timeout)
         (nonzero? (-> self lobby-state last-medius-error))
         (nonzero? (-> self lobby-state last-mgcl-error))
         (nonzero? (-> self lobby-state last-dme-error))
         (nonzero? (-> self lobby-state callback-status))
         )
     *medius-last-response*
     (return (the-as object #f))
     )
    (else
      *medius-last-response*
      0
      )
    )
  (let ((v1-24 (the-as medius-game-info-response *medius-last-response*)))
    (set! (-> arg0 game-status) (the-as medius-clan-challenge-status (-> v1-24 world-status)))
    (when (strncmp (-> v1-24 game-name) (-> "@CLAN_CHAT" data) 10)
      (set! (-> arg0 game-status) (medius-clan-challenge-status clan-challenge-request))
      0
      )
    )
  (set! (-> arg0 status) (medius-cached-info-status valid))
  0
  )

;; WARN: Return type mismatch (function medius-cached-info-game-status object :behavior net-mgr) vs (function medius-cached-info object).
(defmethod get-retrieve-behavior ((this medius-cached-info-game-status))
  (the-as (function medius-cached-info object) medius-game-status-info-retrieve-behavior)
  )

(defun get-game-status-cached ((arg0 int))
  (let ((v1-1 (the-as medius-cached-info-game-status (lookup *medius-game-status-cache* arg0 3000 #f #f))))
    (if (or (not v1-1) (= v1-1 'error))
        (return 0)
        )
    (the-as int (-> v1-1 game-status))
    )
  )

;; WARN: Return type mismatch int vs object.
(defun in-game-players-refreshing-callback ((arg0 medius-game-world-player-list-response))
  (mem-copy! (the-as pointer *medius-last-response*) (the-as pointer arg0) 1024)
  (cond
    ((= (-> arg0 status-code) (medius-status-code medius-no-result))
     (set! (-> *net-mgr* lobby-state callback-occurred) #t)
     )
    ((= (-> arg0 status-code) (medius-status-code medius-success))
     (add! *medius-in-game-players* (-> arg0 account-id))
     )
    (else
      (set! (-> *net-mgr* lobby-state got-error) #t)
      )
    )
  (if (= (-> arg0 end-of-list) 1)
      (set! (-> *net-mgr* lobby-state callback-occurred) #t)
      )
  0
  )


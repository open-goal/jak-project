(defun filter-game ((arg0 net-available-game))
  (if (!= (logand (-> arg0 info burn-version) #xffff) 15)
      (return #f)
      )
  (if (logtest? (shl #x8000 16) (-> arg0 info burn-version))
      (return #f)
      )
  (if (= (-> arg0 info event) 3)
      (return #f)
      )
  (dotimes (v1-11 6)
    (let ((t0-0 (-> *medius-filters* v1-11)))
      (when (!= (-> t0-0 field) -1)
        (let* ((a1-7 (the-as medius-game-list-filter-field (-> t0-0 field)))
               (a3-0 (cond
                       ((= a1-7 (medius-game-list-filter-field medius-filter-max-players))
                        (the-as int (-> arg0 info max-players))
                        )
                       ((= a1-7 (medius-game-list-filter-field medius-filter-game-level))
                        (the-as int (-> arg0 info location))
                        )
                       ((= a1-7 (medius-game-list-filter-field medius-filter-rules-set))
                        (the-as int (-> arg0 info event))
                        )
                       ((= a1-7 (medius-game-list-filter-field medius-filter-generic-field-1))
                        (-> arg0 info generic-1)
                        )
                       ((= a1-7 (medius-game-list-filter-field medius-filter-generic-field-3))
                        (-> arg0 info generic-3)
                        )
                       ((= a1-7 (medius-game-list-filter-field medius-filter-lobby-worldid))
                        (-> arg0 info generic-2)
                        )
                       (else
                         -1
                         )
                       )
                     )
               (a1-8 (the-as medius-comparison-operator (-> t0-0 comp-op)))
               (a1-10 (cond
                        ((= a1-8 (medius-comparison-operator less-than))
                         (< a3-0 (-> t0-0 base-val))
                         )
                        ((= a1-8 (medius-comparison-operator less-than-or-equal-to))
                         (>= (-> t0-0 base-val) a3-0)
                         )
                        ((= a1-8 (medius-comparison-operator equal-to))
                         (= a3-0 (-> t0-0 base-val))
                         )
                        ((= a1-8 (medius-comparison-operator greater-than))
                         (< (-> t0-0 base-val) a3-0)
                         )
                        ((= a1-8 (medius-comparison-operator greater-than-or-equal-to))
                         (>= a3-0 (-> t0-0 base-val))
                         )
                        ((= a1-8 (medius-comparison-operator not-equals))
                         (!= a3-0 (-> t0-0 base-val))
                         )
                        )
                      )
               )
          (when (not a1-10)
            (format 0 "rejecting game: ~D ~D ~D~%" (-> t0-0 field) a3-0 (-> t0-0 base-val))
            (return #f)
            )
          )
        )
      )
    )
  #t
  )

(define *unfiltered-game-ct* 0)

(define *game-end-idx* 0)

;; WARN: Return type mismatch int vs object.
(defun get-game-list-callback ((arg0 medius-game-list-extra-info-response) (arg1 medius-game-array))
  (mem-copy! (the-as pointer *medius-last-response*) (the-as pointer arg0) 1024)
  (cond
    ((= (-> arg0 status-code) (medius-status-code medius-no-result))
     (set! (-> *net-mgr* lobby-state callback-occurred) #t)
     )
    ((= (-> arg0 status-code) (medius-status-code medius-success))
     (set! *unfiltered-game-ct* (+ *unfiltered-game-ct* 1))
     (when (and (< (-> arg1 ct) 64) (not (medius-game-array-method-9 arg1 (-> arg0 medius-world-id))))
       (let ((s4-0 (-> arg1 data (-> arg1 ct))))
         (init-from-game-list-extra-info! s4-0 arg0)
         (when (and (filter-game s4-0) (= (logand (-> s4-0 info burn-version) #xffff) 15))
           (cond
             ((logtest? #x40000000 (-> s4-0 info burn-version))
              (when (< (-> arg1 ct) (+ *game-end-idx* -1))
                (set! *game-end-idx* (+ *game-end-idx* -1))
                (mem-copy! (the-as pointer (-> arg1 data *game-end-idx*)) (the-as pointer s4-0) 328)
                )
              )
             (else
               (+! (-> arg1 ct) 1)
               )
             )
           )
         )
       )
     )
    (else
      (set! (-> *net-mgr* lobby-state got-error) #t)
      )
    )
  (if (= (-> arg0 end-of-list) 1)
      (set! (-> *net-mgr* lobby-state callback-occurred) #t)
      )
  0
  )


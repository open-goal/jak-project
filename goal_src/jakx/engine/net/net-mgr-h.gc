(deftype net-available-game-info (structure)
  ((game-name     uint8   64)
   (player-count  uint8)
   (min-players   uint8)
   (max-players   uint8)
   (in-staging    basic)
   (event         uint8)
   (location      uint8)
   (task-node     uint8)
   (generic-1     int32)
   (generic-2     int32)
   (generic-3     int32)
   (burn-version  uint32  :overlay-at generic-1)
   (lobby-world   int32   :overlay-at generic-2)
   (class-type    int32   :overlay-at generic-3)
   (clan-1        int32)
   (clan-2        int32)
   (skill-level   int32)
   (avg-ping      int32)
   )
  )


(defun encode-net-available-game-info ((arg0 net-available-game-info) (arg1 mem-buffer))
  (mem-buffer-method-31 arg1 (-> arg0 game-name) 64)
  (mem-buffer-method-18 arg1 (the-as int (-> arg0 player-count)))
  (mem-buffer-method-18 arg1 (the-as int (-> arg0 min-players)))
  (mem-buffer-method-18 arg1 (the-as int (-> arg0 max-players)))
  (mem-buffer-method-29 arg1 (the-as symbol (-> arg0 in-staging)))
  (mem-buffer-method-14 arg1 (the-as int (-> arg0 event)))
  (mem-buffer-method-14 arg1 (the-as int (-> arg0 location)))
  (mem-buffer-method-18 arg1 (the-as int (-> arg0 task-node)))
  (mem-buffer-method-16 arg1 (-> arg0 generic-1))
  (mem-buffer-method-20 arg1 (the-as int (-> arg0 burn-version)))
  (mem-buffer-method-16 arg1 (-> arg0 generic-2))
  (mem-buffer-method-16 arg1 (-> arg0 generic-2))
  (mem-buffer-method-16 arg1 (-> arg0 generic-3))
  (mem-buffer-method-16 arg1 (-> arg0 generic-3))
  (mem-buffer-method-16 arg1 (-> arg0 clan-1))
  (mem-buffer-method-16 arg1 (-> arg0 clan-2))
  (mem-buffer-method-16 arg1 (-> arg0 skill-level))
  (mem-buffer-method-16 arg1 (-> arg0 avg-ping))
  (none)
  )

(defun decode-net-available-game-info ((arg0 net-available-game-info) (arg1 mem-buffer))
  (mem-buffer-method-48 arg1 (-> arg0 game-name) 64)
  (set! (-> arg0 player-count) (the-as uint (mem-buffer-method-36 arg1)))
  (set! (-> arg0 min-players) (the-as uint (mem-buffer-method-36 arg1)))
  (set! (-> arg0 max-players) (the-as uint (mem-buffer-method-36 arg1)))
  (set! (-> arg0 in-staging) (the-as basic (mem-buffer-method-46 arg1)))
  (set! (-> arg0 event) (the-as uint (mem-buffer-method-32 arg1)))
  (set! (-> arg0 location) (the-as uint (mem-buffer-method-32 arg1)))
  (set! (-> arg0 task-node) (the-as uint (mem-buffer-method-36 arg1)))
  (set! (-> arg0 generic-1) (mem-buffer-method-34 arg1))
  (set! (-> arg0 generic-1) (the-as int (mem-buffer-method-38 arg1)))
  (set! (-> arg0 generic-2) (mem-buffer-method-34 arg1))
  (set! (-> arg0 generic-2) (mem-buffer-method-34 arg1))
  (set! (-> arg0 generic-3) (mem-buffer-method-34 arg1))
  (set! (-> arg0 generic-3) (mem-buffer-method-34 arg1))
  (set! (-> arg0 clan-1) (mem-buffer-method-34 arg1))
  (set! (-> arg0 clan-2) (mem-buffer-method-34 arg1))
  (set! (-> arg0 skill-level) (mem-buffer-method-34 arg1))
  (set! (-> arg0 avg-ping) (mem-buffer-method-34 arg1))
  (none)
  )

(deftype net-available-game (structure)
  ((info              net-available-game-info  :inline)
   (connect-info      net-connection-info      :inline)
   (medius-world-id   int32)
   (format-game-name  uint8                    64)
   )
  (:methods
    (net-available-game-method-9 () none)
    (net-available-game-method-10 () none)
    (net-available-game-method-11 () none)
    (net-available-game-method-12 () none)
    (net-available-game-method-13 () none)
    (net-available-game-method-14 () none)
    )
  )



(deftype net-mgr-game-state (structure)
  ((connect-handle      basic)
   (local-machine-idx   int32)
   (session-master-idx  int32)
   (host-idx            int32)
   (connected-bitfield  int32)
   (time                int32)
   (first-time-host     basic)
   (locked              basic)
   (kicked              basic)
   (sm-eligible         basic)
   )
  :pack-me
  )


(deftype net-mgr-lobby-state (structure)
  ((connect-handle          basic)
   (connect-handle-mgcl     basic)
   (connect-handle-muis     basic)
   (my-account-id           int32)
   (channel-id              int32)
   (in-special-channel      basic)
   (last-normal-channel-id  int32)
   (created-game-id         int32)
   (joined-game-id          int32)
   (channel-list-valid      basic)
   (last-medius-error       int32)
   (last-mgcl-error         int32)
   (last-dme-error          int32)
   (callback-occurred       basic)
   (callback-status         int32)
   (callback-userdata       basic)
   (timeout                 basic)
   (got-error               basic)
   (last-report-time        int32)
   (game-on-me              uint64)
   (game-on-me-error-delay  int32)
   )
  :pack-me
  )


(deftype net-mgr (process)
  ((game-type       uint8)
   (last-game-type  uint8)
   (notify          engine)
   (game-state      net-mgr-game-state   :inline)
   (lobby-state     net-mgr-lobby-state  :inline)
   (scert-initted   symbol)
   (auto-register   symbol)
   (skip-policy     symbol)
   )
  (:methods
    (net-mgr-method-15 () none)
    (net-mgr-method-16 () none)
    (net-mgr-method-17 () none)
    (net-mgr-method-18 () none)
    (net-mgr-method-19 () none)
    (net-mgr-method-20 () none)

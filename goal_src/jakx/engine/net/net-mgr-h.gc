(define *net-available-game-ct* 0)

(define *net-available-games* *net-mgr-scratch*)

(define *net-active-game* (new 'static 'net-available-game))

(defbehavior net-mgr-notify-connect net-mgr ((arg0 process) (arg1 int))
  (if (not *net-mgr*)
      (return #t)
      )
  (let ((s4-0 (-> *net-mgr* notify alive-list next0)))
    (-> *net-mgr* notify)
    (let ((s3-0 (-> s4-0 next0)))
      (while (!= s4-0 (-> *net-mgr* notify alive-list-end))
        (when (= ((method-of-type connection get-process) (the-as connection s4-0)) arg0)
          (set! (-> (the-as connection s4-0) param2) arg1)
          (return #t)
          )
        (set! s4-0 s3-0)
        (-> *net-mgr* notify)
        (set! s3-0 (-> s3-0 next0))
        )
      )
    )
  (add-connection (-> *net-mgr* notify) arg0 #f arg1 0 0)
  )

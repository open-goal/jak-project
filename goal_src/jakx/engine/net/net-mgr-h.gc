(define-extern *net-log-write* symbol)
(define-extern *net-keypair-valid* symbol)
(define-extern *net-local-rsa-keypair* rsa-keypair)
(define-extern *net-app-rsa-keypair* rsa-keypair)
(define-extern *net-app-msg-id* int)
(define-extern *aux-voice-msg-id* int)

(define-extern net-log-msg (function pointer int int int int object))
(define-extern get-player-name (function int string))
(define-extern pause-check (function int))

;; DECOMP BEGINS

(deftype net-aux-msg-handler (structure)
  ((handler-func  (function mem-buffer int object))
   )
  )


(define *net-aux-msg-handlers* (new 'static 'inline-array net-aux-msg-handler 12
                                 (new 'static 'net-aux-msg-handler)
                                 (new 'static 'net-aux-msg-handler)
                                 (new 'static 'net-aux-msg-handler)
                                 (new 'static 'net-aux-msg-handler)
                                 (new 'static 'net-aux-msg-handler)
                                 (new 'static 'net-aux-msg-handler)
                                 (new 'static 'net-aux-msg-handler)
                                 (new 'static 'net-aux-msg-handler)
                                 (new 'static 'net-aux-msg-handler)
                                 (new 'static 'net-aux-msg-handler)
                                 (new 'static 'net-aux-msg-handler)
                                 (new 'static 'net-aux-msg-handler)
                                 )
        )

(deftype net-mgr-game-state (structure)
  ((connect-handle      pointer)
   (local-machine-idx   int32)
   (session-master-idx  int32)
   (host-idx            int32)
   (connected-bitfield  int32)
   (time                int32)
   (first-time-host     symbol)
   (locked              symbol)
   (kicked              symbol)
   (sm-eligible         symbol)
   )
  :pack-me
  )


(deftype net-mgr-lobby-state (structure)
  ((connect-handle          basic)
   (connect-handle-mgcl     basic)
   (connect-handle-muis     basic)
   (my-account-id           int32)
   (channel-id              int32)
   (in-special-channel      basic)
   (last-normal-channel-id  int32)
   (created-game-id         int32)
   (joined-game-id          int32)
   (channel-list-valid      basic)
   (last-medius-error       int32)
   (last-mgcl-error         int32)
   (last-dme-error          int32)
   (callback-occurred       basic)
   (callback-status         int32)
   (callback-userdata       basic)
   (timeout                 symbol)
   (got-error               symbol)
   (last-report-time        int32)
   (game-on-me              uint64)
   (game-on-me-error-delay  int32)
   )
  :pack-me
  )


(deftype net-mgr (process)
  ((game-type       uint8)
   (last-game-type  uint8)
   (notify          engine)
   (game-state      net-mgr-game-state   :inline)
   (lobby-state     net-mgr-lobby-state  :inline)
   (scert-initted   symbol)
   (auto-register   symbol)
   (skip-policy     symbol)
   )
  (:state-methods
    idle
    die
    getting-universe-information
    (dns-lookup string)
    connecting-to-mas
    beginning-session
    getting-policy-1
    getting-policy-2
    logging-in
    registering-account
    (connecting-to-lobby symbol)
    __empty__
    lobby-idle
    leaving-lobby
    (refreshing-games int)
    creating-game-world
    refreshing-lan-games
    (verifying-lan-game net-connection-info)
    (joining-game-world int symbol)
    starting-sp-game
    playing-sp-game
    starting-playback-game
    playing-playback-game
    hosting-game
    (connecting-to-game net-connection-info)
    joining-game
    playing-game
    (leaving-game symbol)
    (disconnecting symbol symbol symbol symbol)
    )
  (:methods
    (net-mgr-method-44 () none)
    (init-dme (_type_) symbol)
    (net-mgr-method-46 (_type_) symbol)
    (net-mgr-method-47 () none)
    (net-mgr-method-48 () none)
    (net-mgr-method-49 () none)
    (net-mgr-method-50 () none)
    (net-mgr-method-51 () none)
    (update (_type_) none)
    (net-mgr-method-53 () none)
    (net-mgr-method-54 () none)
    (net-mgr-method-55 () none)
    (net-mgr-method-56 () none)
    (net-mgr-method-57 (_type_ string) none)
    (update-lan-find (_type_) none)
    (net-mgr-method-59 () none)
    )
  )


(define *net-mgr-startup-status* #f)

(define *net-mgr* (the-as net-mgr #f))

(define *net-error* 0)

(define *medius-world-status* 0)

(define *dme-initted* #f)

(define *medius-initted* #f)

(define *mgcl-initted* #f)

(deftype net-available-game-info (structure)
  ((game-name     uint8   64)
   (player-count  uint8)
   (min-players   uint8)
   (max-players   uint8)
   (in-staging    symbol)
   (event         uint8)
   (location      uint8)
   (task-node     uint8)
   (generic-1     int32)
   (generic-2     int32)
   (generic-3     int32)
   (burn-version  uint32  :overlay-at generic-1)
   (lobby-world   int32   :overlay-at generic-2)
   (class-type    int32   :overlay-at generic-3)
   (clan-1        int32)
   (clan-2        int32)
   (skill-level   int32)
   (avg-ping      int32)
   )
  )


(defun encode-net-available-game-info ((arg0 net-available-game-info) (arg1 mem-buffer))
  (write-bytes arg1 (-> arg0 game-name) 64)
  (write-uint8 arg1 (-> arg0 player-count))
  (write-uint8 arg1 (-> arg0 min-players))
  (write-uint8 arg1 (-> arg0 max-players))
  (write-bool arg1 (-> arg0 in-staging))
  (write-int8 arg1 (the-as int (-> arg0 event)))
  (write-int8 arg1 (the-as int (-> arg0 location)))
  (write-uint8 arg1 (-> arg0 task-node))
  (write-int32 arg1 (-> arg0 generic-1))
  (write-uint32 arg1 (-> arg0 burn-version))
  (write-int32 arg1 (-> arg0 generic-2))
  (write-int32 arg1 (-> arg0 generic-2))
  (write-int32 arg1 (-> arg0 generic-3))
  (write-int32 arg1 (-> arg0 generic-3))
  (write-int32 arg1 (-> arg0 clan-1))
  (write-int32 arg1 (-> arg0 clan-2))
  (write-int32 arg1 (-> arg0 skill-level))
  (write-int32 arg1 (-> arg0 avg-ping))
  (none)
  )

(defun decode-net-available-game-info ((arg0 net-available-game-info) (arg1 mem-buffer))
  (read-bytes arg1 (-> arg0 game-name) 64)
  (set! (-> arg0 player-count) (read-uint8 arg1))
  (set! (-> arg0 min-players) (read-uint8 arg1))
  (set! (-> arg0 max-players) (read-uint8 arg1))
  (set! (-> arg0 in-staging) (read-bool arg1))
  (set! (-> arg0 event) (the-as uint (read-int8 arg1)))
  (set! (-> arg0 location) (the-as uint (read-int8 arg1)))
  (set! (-> arg0 task-node) (read-uint8 arg1))
  (set! (-> arg0 generic-1) (read-int32 arg1))
  (set! (-> arg0 generic-1) (the-as int (read-uint32 arg1)))
  (set! (-> arg0 generic-2) (read-int32 arg1))
  (set! (-> arg0 generic-2) (read-int32 arg1))
  (set! (-> arg0 generic-3) (read-int32 arg1))
  (set! (-> arg0 generic-3) (read-int32 arg1))
  (set! (-> arg0 clan-1) (read-int32 arg1))
  (set! (-> arg0 clan-2) (read-int32 arg1))
  (set! (-> arg0 skill-level) (read-int32 arg1))
  (set! (-> arg0 avg-ping) (read-int32 arg1))
  (none)
  )

(deftype net-available-game (structure)
  ((info              net-available-game-info  :inline)
   (connect-info      net-connection-info      :inline)
   (medius-world-id   int32)
   (format-game-name  uint8                    64)
   )
  (:methods
    (net-available-game-method-9 () none)
    (net-available-game-method-10 () none)
    (init-from-lanfind! (_type_ net-lanfind-callback-data-args) none)
    (init-from-local-game! (_type_) none)
    (format-game-name! (_type_) none)
    (valid? (_type_) symbol)
    )
  )



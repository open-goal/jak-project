;;-*-Lisp-*-
(in-package goal)

;; name: net-powerup-h.gc
;; name in dgo: net-powerup-h
;; dgos: ENGINE, GAME

(declare-type net-powerup process-nettable)
(declare-type eco-green eco)

(define-extern powerup-build-static-hash (function object))
(define-extern powerup-build-dynamic-hash (function object))

;; DECOMP BEGINS

(define *powerup-static-hash* (new 'global 'spatial-hash 8192 512))

(define *powerup-dynamic-hash* (new 'global 'spatial-hash 4096 64))

(deftype net-powerup-motion-info (basic)
  ((motion-hook      (function net-powerup-motion-info net-powerup object))
   (flight-end-time  int32)
   (vel              vector  :inline)
   (rest-pos         vector  :inline)
   )
  (:methods
    (setup-parabola! (_type_ vector vector time-frame) none)
    (eval-position (_type_ int vector) none)
    (write-to-buffer (_type_ mem-buffer) none)
    (read-from-buffer (_type_ mem-buffer) none)
    )
  )


(deftype net-powerup-spawn-params (structure)
  ((tp             type)
   (pos            vector  :inline)
   (lifetime       int32)
   (initial-owner  int8)
   (motion-info    net-powerup-motion-info)
   )
  )


(deftype net-powerup (process-nettable)
  ((child-proc           handle)
   (die-or-respawn-time  int32)
   (touched-time         int32)
   (touched-by           int8)
   (ignore-frames        int8)
   (hash-id              int16)
   (pos                  vector  :inline)
   (motion-info          net-powerup-motion-info)
   )
  (:state-methods
    idle
    wait-respawn
    die
    )
  (:methods
    (init! (_type_ net-powerup-spawn-params) none)
    (spawn-draw-proc (_type_ vector entity) none)
    (kill-draw-proc (_type_) none)
    (on-touched (_type_ process) none)
    (get-pos! (_type_ vector) none)
    (get-collision-sphere (_type_ vector entity-actor) none)
    (visible? (_type_) symbol)
    (do-pickup (_type_ process) none)
    (can-pick-up? (_type_) symbol)
    (on-pickup (_type_) none)
    (get-respawn-time (_type_ time-frame) time-frame)
    )
  )


;; WARN: Return type mismatch int vs object.
(defbehavior net-powerup-init-remote net-powerup ((arg0 mem-buffer))
  (register self -1 #xffff)
  (init-remote self arg0)
  (post-init-remote self)
  0
  )

(defmethod spawn-remote ((this net-powerup) (arg0 mem-buffer))
  (ppointer->process (process-spawn net-powerup :init net-powerup-init-remote arg0 :name "net-powerup"))
  )

(defmethod write-msg-map ((this net-powerup) (arg0 net-process-class-info))
  (set! (-> arg0 msg-map (-> arg0 msg-count)) 'picked-up)
  (+! (-> arg0 msg-count) 1)
  0
  (none)
  )

(define *msg-map-net-powerup* (new 'static 'boxed-array :type symbol :length 0 :allocated-length 64))

(define *net-process-class-info-net-powerup* (new 'static 'net-process-class-info))

(set! (-> *net-process-class-info-net-powerup* msg-map) *msg-map-net-powerup*)

(write-msg-map-rec net-powerup *net-process-class-info-net-powerup*)

(set! (-> *net-process-class-info-net-powerup* owner-type) net-powerup)

(net-process-class-register *net-process-class-info-net-powerup*)

(defmethod get-class-info ((this net-powerup))
  *net-process-class-info-net-powerup*
  )

(deftype powerup-draw (process-drawable)
  ((parent-proc  handle)
   (glow-sound   ambient-sound)
   (part-time    int32)
   )
  (:state-methods
    idle
    die
    )
  (:methods
    (init-root! (_type_ float) none)
    (init! (_type_ net-powerup vector) none)
    (spawn-pickup-effect (_type_ process-drawable) none)
    (update-draw (_type_) none)
    (set-pos! (_type_ vector) none)
    )
  )


(defbehavior powerup-draw-init-by-other powerup-draw ((arg0 process) (arg1 vector) (arg2 entity))
  (let ((s5-0 (new 'stack-no-clear 'vector)))
    (if arg2
        (set! (-> self level) (-> arg2 extra level))
        (art-group-get-by-name *level* (-> arg0 name) (&-> self level))
        )
    (set! (-> s5-0 quad) (-> arg1 quad))
    (set! (-> self parent-proc) (process->handle arg0))
    (stack-size-set! (-> self main-thread) 32)
    (init! self (the-as net-powerup arg0) s5-0)
    )
  (go-virtual idle)
  )

    (net-process-mgr-method-50 () none)
    (net-process-mgr-method-51 () none)
    (net-process-mgr-method-52 () none)
    )
  )


(define *net-process-mgr* (the-as net-process-mgr #f))

(defun get-event-level ()
  (let ((v1-1 (level-group-method-32 *level*)))
    (if (not v1-1)
        (return (the-as level #f))
        )
    (case *lobby-local-players*
      ((1)
       (-> v1-1 borrow-level 0)
       )
      (else
        (-> v1-1 borrow-level 2)
        )
      )
    )
  )

(defun get-shared-level ()
  (let ((v1-1 (level-group-method-32 *level*)))
    (if (not v1-1)
        (return (the-as level #f))
        )
    (-> v1-1 borrow-level 1)
    )
  )

(defun nos ()
  (when *net-process-mgr*
    (format #t "~%~%")
    (dotimes (gp-0 10)
      (cond
        ((= gp-0 (if *net-mgr*
                     (-> *net-mgr* game-state local-machine-idx)
                     0
                     )
            )
         (format #t ">>>[~D] :~%" gp-0)
         )
        ((= gp-0 8)
         (format #t "  world :~%")
         )
        ((= gp-0 9)
         (format #t "release :~%")
         )
        (else
          (format #t "   [~D] :~%" gp-0)
          )
        )
      (let ((v1-13 (the-as object (-> *net-process-mgr* owner-lists gp-0 head))))
        (while (the-as list-link v1-13)
          (let ((s5-0 (-> (the-as list-link v1-13) next)))
            (let ((s4-0 (if (the-as list-link v1-13)
                            (the-as process-nettable (&+ (the-as pointer v1-13) -168))
                            (the-as process-nettable #f)
                            )
                        )
                  )
              (format #t "   [~4,'0X] " (-> s4-0 net-id))
              (print s4-0)
              )
            (format #t "~%")
            (set! v1-13 s5-0)
            )
          )
        )
      )
    )
  (format #t "~%~%")
  0
  (none)
  )

(defun write-process-as-handle ((arg0 mem-buffer) (arg1 process-nettable))
  (if arg1
      (mem-buffer-method-19 arg0 (the-as int (-> arg1 net-id)))
      (mem-buffer-method-19 arg0 #xffff)
      )
  (none)
  )

(defun write-handle ((arg0 mem-buffer) (arg1 handle))
  (let ((a1-3 (as-type (handle->process arg1) process-nettable)))
    (write-process-as-handle arg0 (the-as process-nettable a1-3))
    )
  (none)
  )

(defun read-handle ((arg0 mem-buffer))
  (let* ((a1-0 (mem-buffer-method-37 arg0))
         (a0-2 (net-process-mgr-method-40 *net-process-mgr* a1-0))
         )
    (cond
      (a0-2
        (process->handle a0-2)
        )
      (else
        )
      )
    )
  (none)
  )

;;-*-Lisp-*-
(in-package goal)

;; name: net-process-mgr-h.gc
;; name in dgo: net-process-mgr-h
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

(deftype net-process-mgr-machine (structure)
  ((state            uint8)
   (delay            int32)
   (acct-id          int32)
   (overall-score    int32)
   (clan-id          int32)
   (local-player-ct  int32)
   (cookie           int32)
   (reported-ping    int32)
   )
  :pack-me
  )


(deftype net-process-mgr (process)
  ((local-machine-idx                 int32)
   (session-master-idx                int32)
   (machines                          net-process-mgr-machine  8 :inline)
   (last-allocated-local-id           int32)
   (last-allocated-global-id          int32)
   (have-send-pending-objects         symbol)
   (snap-time-of-day                  symbol)
   (owner-lists                       linked-list              10 :inline)
   (active-list                       linked-list              :inline)
   (cur-proc-valid                    symbol)
   (cur-proc-id                       uint16)
   (cur-proc-owner-idx                int8)
   (cur-proc-type                     type)
   (cur-proc-entity                   entity-links)
   (entity-creation-messages-enabled  symbol)
   )
  (:methods
    (net-process-mgr-method-9 () none)
    (net-process-mgr-method-10 () none)
    (net-process-mgr-method-11 () none)
    (net-process-mgr-method-12 () none)
    (net-process-mgr-method-13 () none)
    (net-process-mgr-method-14 () none)
    (net-process-mgr-method-15 () none)
    (net-process-mgr-method-16 () none)
    (net-process-mgr-method-17 () none)
    (net-process-mgr-method-18 () none)
    (net-process-mgr-method-19 () none)
    (net-process-mgr-method-20 () none)
    (net-process-mgr-method-21 () none)
    (net-process-mgr-method-22 () none)
    (net-process-mgr-method-23 () none)
    (net-process-mgr-method-24 () none)
    (net-process-mgr-method-25 () none)
    (net-process-mgr-method-26 () none)
    (net-process-mgr-method-27 () none)
    (net-process-mgr-method-28 () none)
    (net-process-mgr-method-29 () none)
    (net-process-mgr-method-30 () none)
    (net-process-mgr-method-31 () none)
    (net-process-mgr-method-32 () none)
    (net-process-mgr-method-33 () none)
    (net-process-mgr-method-34 () none)
    (net-process-mgr-method-35 () none)
    (net-process-mgr-method-36 () none)
    (net-process-mgr-method-37 () none)
    (net-process-mgr-method-38 () none)
    (net-process-mgr-method-39 () none)
    (net-process-mgr-method-40 (_type_ int) process-nettable)
    (net-process-mgr-method-41 () none)
    (net-process-mgr-method-42 () none)
    (net-process-mgr-method-43 () none)
    (net-process-mgr-method-44 () none)
    (net-process-mgr-method-45 () none)
    (net-process-mgr-method-46 (_type_ int) none)
    (net-process-mgr-method-47 () none)
    (net-process-mgr-method-48 () none)

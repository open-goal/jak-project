;;-*-Lisp-*-
(in-package goal)

;; name: net-mgr-medius-players-h.gc
;; name in dgo: net-mgr-medius-players-h
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

(deftype net-player-stats (structure)
  ((stats-version    int8)
   (current-clan     int32)
   (last-channel-id  int32)
   )
  :pack-me
  )


(deftype medius-cached-info-player (medius-cached-info)
  ((name          uint8                       32)
   (format-name   uint8                       160)
   (online-state  medius-player-online-state  :inline)
   (stats         net-player-stats            :inline)
   (ladder-stats  net-player-ladder-stats     :inline)
   )
  )


(define *medius-player-cache*
  (new 'static 'medius-cache :objects (new 'static 'boxed-array :type medius-cached-info
                                        (new 'static 'medius-cached-info-player)
                                        (new 'static 'medius-cached-info-player)
                                        (new 'static 'medius-cached-info-player)
                                        (new 'static 'medius-cached-info-player)
                                        (new 'static 'medius-cached-info-player)
                                        (new 'static 'medius-cached-info-player)
                                        (new 'static 'medius-cached-info-player)
                                        (new 'static 'medius-cached-info-player)
                                        (new 'static 'medius-cached-info-player)
                                        (new 'static 'medius-cached-info-player)
                                        (new 'static 'medius-cached-info-player)
                                        (new 'static 'medius-cached-info-player)
                                        (new 'static 'medius-cached-info-player)
                                        (new 'static 'medius-cached-info-player)
                                        (new 'static 'medius-cached-info-player)
                                        (new 'static 'medius-cached-info-player)
                                        (new 'static 'medius-cached-info-player)
                                        (new 'static 'medius-cached-info-player)
                                        (new 'static 'medius-cached-info-player)
                                        (new 'static 'medius-cached-info-player)
                                        (new 'static 'medius-cached-info-player)
                                        (new 'static 'medius-cached-info-player)
                                        (new 'static 'medius-cached-info-player)
                                        (new 'static 'medius-cached-info-player)
                                        (new 'static 'medius-cached-info-player)
                                        (new 'static 'medius-cached-info-player)
                                        (new 'static 'medius-cached-info-player)
                                        (new 'static 'medius-cached-info-player)
                                        (new 'static 'medius-cached-info-player)
                                        (new 'static 'medius-cached-info-player)
                                        (new 'static 'medius-cached-info-player)
                                        (new 'static 'medius-cached-info-player)
                                        )
                             )
  )

(clear-objects! *medius-player-cache*)

(deftype medius-player (medius-cache-index)
  ()
  (:methods
    (medius-player-method-11 () none)
    (medius-player-method-12 () none)
    (medius-player-method-13 () none)
    )
  )


(deftype medius-player-index-array (medius-cache-index-array)
  ()
  )


(define *medius-buddies* (new 'static 'medius-player-index-array :data (new 'static 'array medius-cache 113)))

(set! (-> *medius-buddies* max-ct) 100)

(define *medius-buddies-online*
  (new 'static 'medius-player-index-array :data (new 'static 'array medius-cache 113))
  )

(set! (-> *medius-buddies-online* max-ct) 100)

(define *medius-ignores* (new 'static 'medius-player-index-array :data (new 'static 'array medius-cache 45)))

(set! (-> *medius-ignores* max-ct) 32)

(define *medius-room-players*
  (new 'static 'medius-player-index-array :data (new 'static 'array medius-cache 269))
  )

(set! (-> *medius-room-players* max-ct) 256)

(define *medius-recent-players*
  (new 'static 'medius-player-index-array :data (new 'static 'array medius-cache 45))
  )

(set! (-> *medius-recent-players* max-ct) 32)

(define *medius-in-game-players*
  (new 'static 'medius-player-index-array :data (new 'static 'array medius-cache 21))
  )

(set! (-> *medius-in-game-players* max-ct) 8)

(define *medius-local-game-players*
  (new 'static 'medius-player-index-array :data (new 'static 'array medius-cache 21))
  )

(set! (-> *medius-local-game-players* max-ct) 8)

(define *medius-outstanding-clan-invites*
  (new 'static 'medius-player-index-array :data (new 'static 'array medius-cache 77))
  )

(set! (-> *medius-outstanding-clan-invites* max-ct) 64)

(define *medius-mute-list*
  (new 'static 'medius-player-index-array :data (new 'static 'array medius-cache 37))
  )

(set! (-> *medius-mute-list* max-ct) 24)

(define *medius-clan-members-online*
  (new 'static 'medius-player-index-array :data (new 'static 'array medius-cache 77))
  )

(set! (-> *medius-clan-members-online* max-ct) 64)

(define *medius-my-player* (new 'static 'medius-cached-info-player))

(define *medius-recent-opponents*
  (new 'static 'medius-player-index-array :data (new 'static 'array medius-cache 29))
  )

                                        (new 'static 'medius-cached-info-player)
                                        (new 'static 'medius-cached-info-player)
                                        (new 'static 'medius-cached-info-player)
                                        )
                             )
  )

(clear-objects! *medius-player-cache*)

(deftype medius-player (medius-cache-index)
  ()
  :pack-me
  (:methods
    (lookup-player (_type_) medius-cached-info-player)
    (get-player-name-and-clan (_type_) (pointer uint8))
    (get-game-status (_type_) int)
    )
  )


(deftype medius-player-index-array (medius-cache-index-array)
  ((data  medius-player :dynamic :inline :override)
   )
  )



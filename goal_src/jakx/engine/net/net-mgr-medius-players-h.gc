;;-*-Lisp-*-
(in-package goal)

;; name: net-mgr-medius-players-h.gc
;; name in dgo: net-mgr-medius-players-h
;; dgos: ENGINE, GAME

(declare-type medius-cached-info-player medius-cached-info)

(define-extern medius-post-dnas-signature (function object))
(define-extern update-client-state (function medius-user-action object symbol object))
(define-extern medius-player-info-retrieve-behavior (function medius-cached-info-player object :behavior net-mgr))
(define-extern init-player-lists (function object))

;; DECOMP BEGINS

(deftype net-player-stats (structure)
  ((stats-version    int8)
   (current-clan     int32)
   (last-channel-id  int32)
   )
  :pack-me
  )


(deftype medius-cached-info-player (medius-cached-info)
  ((name          uint8                       32)
   (format-name   uint8                       160)
   (online-state  medius-player-online-state  :inline)
   (stats         net-player-stats            :inline)
   (ladder-stats  net-player-ladder-stats     :inline)
   )
  )


(define *medius-player-cache*
  (new 'static 'medius-cache :objects (new 'static 'boxed-array :type medius-cached-info
                                        (new 'static 'medius-cached-info-player)
                                        (new 'static 'medius-cached-info-player)
                                        (new 'static 'medius-cached-info-player)
                                        (new 'static 'medius-cached-info-player)

   )
  )


(deftype medius-server-session-end-response (structure)
  ((message-id    uint8  21)
   (confirmation  int8)
   )
  )


(deftype medius-server-world-report-on-me (structure)
  ((message-id          uint8  21)
   (game-name           uint8  64)
   (game-stats          uint8  256)
   (game-password       uint8  32)
   (application-id      int32)
   (max-clients         int32)
   (min-clients         int32)
   (player-count        int32)
   (game-level          int32)
   (player-skill-level  int32)
   (rules-set           int32)
   (generic-field1      int32)
   (generic-field2      int32)
   (generic-field3      int32)
   (medius-world-id     int32)
   (world-status        int32)
   )
  )



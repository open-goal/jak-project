  ((message-id       uint8  21)
   (confirmation     int8)
   (medius-world-id  int32)
   )
  )


(deftype medius-server-report-type (structure)
  ((session-key            uint8  17)
   (max-worlds             int16)
   (max-players-per-world  int16)
   (active-world-count     int16)
   (total-active-players   int16)
   (alert-level            int32)
   )
  )



   (medius-world-id  int32)
   )
  )


(deftype medius-server-end-game-on-me-response (structure)
  ((message-id    uint8  21)
   (confirmation  int8)
   )
  )


(deftype medius-server-end-game-request (structure)
  ((message-id   uint8  21)
   (world-id     int32)

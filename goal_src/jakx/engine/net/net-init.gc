(deftype sce-stat (structure)
  ((mode     uint32)
   (attr     int32)
   (size     int32)
   (ctime    uint8   8)
   (atime    uint8   8)
   (mtime    uint8   8)
   (hisize   int32)
   (private  uint32  6)
   )
  )


(deftype sce-dirent (structure)
  ((stat     sce-stat  :inline)
   (name     uint8     256)
   (private  pointer)
   )
  )


'knet-dopen

'knet-dclose

'knet-dread

'knet-mkdir

;; WARN: Swapped fp-relative label and field offsets for "host0:"
;; WARN: Return type mismatch int vs object.
(defun simple-dir-test ()
  (let ((gp-0 (new 'stack-no-clear 'sce-dirent))
        (s5-0 (knet-dopen (-> "host0:" data)))
        )
    (when (>= s5-0 0)
      (let ((v1-2 (knet-dread s5-0 (the-as pointer (-> gp-0 stat)))))
        (while (> v1-2 0)
          (format 0 "~G~%" (-> gp-0 name))
          (set! v1-2 (knet-dread s5-0 (the-as pointer (-> gp-0 stat))))
          )
        )
      (knet-dclose s5-0)
      )
    )
  0
  )

(deftype eznet-combination (structure)
  ((status    int32)
   (iftype    int32)
   (name      uint8  64)
   (ifc-name  uint8  64)
   (dev-name  uint8  64)
   )
  :pack-me
  )


(deftype eznet-combination-list (structure)
  ((length       int32)
   (default      int32)
   (netdb-order  uint32             10)
   (list         eznet-combination  10 :inline)
   )
  )


(deftype sce-dnas2-unique-id (structure)
  ((category  uint32)
   (ptr       uint32)
   (sizep     uint32)
   (result    int32)
   )
  )


(deftype sce-dnas2-status (structure)
  ((code      int32)
   (sub-code  int32)
   (progress  int32)
   (optional  uint32)
   )
  )



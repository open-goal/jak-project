;;-*-Lisp-*-
(in-package goal)

;; name: net-eco-h.gc
;; name in dgo: net-eco-h
;; dgos: ENGINE, GAME

(declare-type eco-mgr process-nettable)

(define-extern *eco-mgr* eco-mgr)

;; +++eco-perm-flag
(defenum eco-perm-flag
  :type uint64
  :bitfield #t
  (owner-requested 0)
  (nearby 1)
  (dead 2)
  (no-respawn 3)
  )
;; ---eco-perm-flag

;; DECOMP BEGINS

(deftype eco-perm (structure)
  ((time          int32)
   (owner         int8)
   (hit-by-local  int8)
   (flags         eco-perm-flag)
   )
  )


(deftype eco (process-drawable)
  ()
  (:state-methods
    running
    die
    )
  (:methods
    (init! (_type_) none)
    (on-collected (_type_ entity-actor int) none)
    (get-collide-sphere! (_type_ vector entity-actor) none)
    (get-respawn-delay (_type_) time-frame)
    )
  )


(deftype eco-mgr (process-nettable)
  ()
  (:state-methods
    running
    die
    )
  (:methods
    (find-nearby-eco (_type_) none)
    (update-release-and-respawn (_type_) none)
    (init! (_type_) none)
    (update (_type_) none)
    (collect-eco (_type_ uint int time-frame) none)
    (release-owner (_type_ int) none)
    (reset-owners (_type_) none)
    )
  )


(defbehavior eco-mgr-init-remote eco-mgr ((arg0 mem-buffer))
  (register self -1 #xffff)
  (init-remote self arg0)
  (post-init-remote self)
  0
  (none)
  )

(defmethod spawn-remote ((this eco-mgr) (arg0 mem-buffer))
  (ppointer->process (process-spawn eco-mgr :init eco-mgr-init-remote arg0 :name "eco-mgr"))
  )

(defmethod write-msg-map ((this eco-mgr) (arg0 net-process-class-info))
  (set! (-> arg0 msg-map (-> arg0 msg-count)) 'req-owner)
  (+! (-> arg0 msg-count) 1)
  (set! (-> arg0 msg-map (-> arg0 msg-count)) 'set-owner)
  (+! (-> arg0 msg-count) 1)
  (set! (-> arg0 msg-map (-> arg0 msg-count)) 'collected)
  (+! (-> arg0 msg-count) 1)
  (set! (-> arg0 msg-map (-> arg0 msg-count)) 'respawn)
  (+! (-> arg0 msg-count) 1)
  0
  (none)
  )

(define *msg-map-eco-mgr* (new 'static 'boxed-array :type symbol :length 0 :allocated-length 64))

(define *net-process-class-info-eco-mgr* (new 'static 'net-process-class-info))

(set! (-> *net-process-class-info-eco-mgr* msg-map) *msg-map-eco-mgr*)

(write-msg-map-rec eco-mgr *net-process-class-info-eco-mgr*)

(set! (-> *net-process-class-info-eco-mgr* owner-type) eco-mgr)

(net-process-class-register *net-process-class-info-eco-mgr*)

(defmethod get-class-info ((this eco-mgr))
  *net-process-class-info-eco-mgr*
  )

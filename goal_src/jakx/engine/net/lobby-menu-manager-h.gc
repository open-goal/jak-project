;;-*-Lisp-*-
(in-package goal)

;; name: lobby-menu-manager-h.gc
;; name in dgo: lobby-menu-manager-h
;; dgos: ENGINE, GAME

(define-extern *lobby-reset-mode* symbol)
(define-extern *last-selected-human-ct* int)

(define-extern get-selected-local-player-count (function int))

;; +++lobby-vehicle-flag
(defenum lobby-vehicle-flag
  :type uint64
  :bitfield #t
  (reload 0)
  (destroy 1)
  (spawn-when-ready 2)
  (load-when-offscreen 3)
  (no-turntable 4)
  (no-vehicle-selection 5)
  (fade-part 6)
  )
;; ---lobby-vehicle-flag


;; DECOMP BEGINS

(defun-debug lobby-vehicle-flag->string ((arg0 lobby-vehicle-flag))
  (if (= (logand arg0 (lobby-vehicle-flag destroy)) (lobby-vehicle-flag destroy))
      (format #t "destroy ")
      )
  (if (= (logand arg0 (lobby-vehicle-flag reload)) (lobby-vehicle-flag reload))
      (format #t "reload ")
      )
  (if (= (logand arg0 (lobby-vehicle-flag load-when-offscreen)) (lobby-vehicle-flag load-when-offscreen))
      (format #t "load-when-offscreen ")
      )
  (if (= (logand arg0 (lobby-vehicle-flag no-turntable)) (lobby-vehicle-flag no-turntable))
      (format #t "no-turntable ")
      )
  (if (= (logand arg0 (lobby-vehicle-flag no-vehicle-selection)) (lobby-vehicle-flag no-vehicle-selection))
      (format #t "no-vehicle-selection ")
      )
  (if (= (logand arg0 (lobby-vehicle-flag fade-part)) (lobby-vehicle-flag fade-part))
      (format #t "fade-part ")
      )
  (if (= (logand arg0 (lobby-vehicle-flag spawn-when-ready)) (lobby-vehicle-flag spawn-when-ready))
      (format #t "spawn-when-ready ")
      )
  )

(deftype lobby-menu-manager (process)
  ((game-type                   uint32)
   (menu-handles                handle  8)
   (in-focus-index              int8)
   (menu-handle-1               handle  :overlay-at (-> menu-handles 0))
   (menu-handle-2               handle  :overlay-at (-> menu-handles 1))
   (menu-handle-popup           handle  :overlay-at (-> menu-handles 2))
   (menu-handle-background      handle  :offset 224)
   (menu-handle-logo-main       handle  :offset 232)
   (menu-handle-logo-subtitle   handle  :offset 240)
   (local-players               int32)
   (refresh-time                uint32)
   (game-connection-type        uint8)
   (vehicle-handle              handle)
   (vehicle-selected            uint8)
   (vehicle-flags               lobby-vehicle-flag)
   (vehicle-paint-mode          uint64)
   (tuning-type-selected        uint64)
   (all-ready?                  symbol)
   (map-proc                    uint64)
   (venue-map                   uint64)
   (current-local-player        int8)
   (spawn-another?              symbol)
   (state-time                  uint64)
   (has-driver?                 symbol  2)
   (car-part-type-selected      uint8)
   (cam-string                  basic)
   (driver-was-taken?           symbol)
   (interpolate-camera?         symbol)
   (last-selected-human-count   int8)
   (last-selected-cpu-count     int8)
   (game-visible?               symbol)
   (psp-mode-run?               symbol)
   (garage-lights               float)
   (garage-lights-target        float)
   (memcard-status              uint32)
   (time-limit?                 symbol)
   (profile-save-mode           basic)
   (machine-id-to-kick          int8)
   (cookie-id-to-kick           int8)
   (override-fov                basic)
   (profile-new-save            basic)
   (voice-id                    uint32)
   (split-selection-prev-state  basic)
   (vehicle-part-fade           uint8)
   (vehicle-loaded-time         time-frame)
   )

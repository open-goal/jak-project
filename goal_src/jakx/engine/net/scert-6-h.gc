(deftype medius-get-clan-member-list-extra-info-request (structure)
  ((message-id         uint8  21)
   (clan-id            int32)
   (ladder-stat-index  int32)
   (sort-order         medius-sort-order)
   )
  )


(deftype medius-get-clan-member-list-extra-info-response (structure)
  ((message-id       uint8                       21)
   (status-code      medius-status-code)
   (account-id       int32)
   (account-name     uint8                       32)
   (stats            uint8                       256)
   (online-state     medius-player-online-state  :inline)
   (ladder-stat      int32)
   (ladder-position  uint32)
   (total-rankings   uint32)
   (end-of-list      int8)
   )
  )

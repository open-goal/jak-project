;;-*-Lisp-*-
(in-package goal)

;; name: scert-6-h.gc
;; name in dgo: scert-6-h
;; dgos: ENGINE, GAME

;; +++medius-world-attributes-type
(defenum medius-world-attributes-type
  :type int32
  (game-world-none 0)
  (game-world-allow-rebroadcast 1)
  (game-world-allow-spectator 2)
  (game-world-internal 4)
  (game-world-extra #xffffff)
  )
;; ---medius-world-attributes-type

;; +++medius-dnas-type
(defenum medius-dnas-type
  :type int32
  (dnas-console-id 0)
  (dnas-title-id 1)
  (dnas-disk-id 2)
  (extra-medius-dnas-type #xffffff)
  )
;; ---medius-dnas-type

;; +++medius-player-search-type
(defenum medius-player-search-type
  :type int32
  (player-account-id 0)
  (player-account-name 1)
  (extra-medius-player-search-type #xffffff)
  )
;; ---medius-player-search-type

;; +++medius-find-world-type
(defenum medius-find-world-type
  :type int32
  (find-game-world 0)
  (find-lobby-world 1)
  (find-all-worlds 2)
  (extra-medius-find-world-type #xffffff)
  )
;; ---medius-find-world-type

;; +++medius-world-status
(defenum medius-world-status
  :type int32
  (world-inactive 0)
  (world-staging 1)
  (world-active 2)
  (world-closed 3)
  (world-pending-creation 4)
  (world-pending-connect-to-game 5)
  (extra-medius-world-status #xffffff)
  )
;; ---medius-world-status

;; +++medius-connection-type
(defenum medius-connection-type
  :type int32
  (modem 0)
  (ethernet 1)
  (wireless 2)
  (extra-medius-connection-type #xffffff)
  )
;; ---medius-connection-type

;; +++medius-clan-message-status
(defenum medius-clan-message-status
  :type int32
  (clan-message-unread 0)
  (clan-message-modified 1)
  (clan-message-deleted 2)
  (clan-message-read 3)
  (extra-medius-clan-message-status #xffffff)
  )
;; ---medius-clan-message-status

;; +++medius-clan-status
(defenum medius-clan-status
  :type int32
  (clan-disbanded -1)
  (clan-active 0)
  (extra-medius-clan-status #xffffff)
  )
;; ---medius-clan-status

;; DECOMP BEGINS

(deftype medius-create-game-request0 (structure)
  ((message-id          uint8  21)
   (session-key         uint8  17)
   (application-id      int32)
   (min-players         int32)
   (max-players         int32)
   (game-level          int32)
   (game-name           uint8  64)
   (game-password       uint8  32)
   (player-skill-level  int32)
   (rules-set           int32)
   (generic-field1      int32)
   (generic-field2      int32)
   (generic-field3      int32)
   (game-host-type      medius-game-host-type)
   )
  )


(deftype medius-create-game-request (structure)
  ((message-id          uint8  21)
   (session-key         uint8  17)
   (application-id      int32)
   (min-players         int32)
   (max-players         int32)
   (game-level          int32)
   (game-name           uint8  64)
   (game-password       uint8  32)
   (spectator-password  uint8  32)
   (player-skill-level  int32)
   (rules-set           int32)
   (generic-field1      int32)
   (generic-field2      int32)
   (generic-field3      int32)
   (game-host-type      medius-game-host-type)
   (attributes          medius-world-attributes-type)
   )
  )


(deftype medius-create-game-response (structure)
  ((message-id       uint8  21)
   (status-code      medius-status-code)
   (medius-world-id  int32)
   )
  )


(deftype medius-delete-clan-message-request (structure)
  ((message-id       uint8  21)
   (session-key      uint8  17)
   (clan-message-id  int32)
   )
  )


(deftype medius-delete-clan-message-response (structure)
  ((message-id   uint8  21)
   (status-code  medius-status-code)
   )
  )


(deftype medius-disband-clan-request (structure)
  ((message-id   uint8  21)
   (session-key  uint8  17)
   (clan-id      int32)
   )
  )


(deftype medius-disband-clan-response (structure)
  ((message-id   uint8  21)
   (status-code  medius-status-code)
   )
  )


(deftype medius-dnas-signature-post (structure)
  ((message-id             uint8  21)
   (session-key            uint8  17)
   (dnas-signature-type    medius-dnas-type)
   (dnas-signature-length  int8)
   (dnas-signature         uint8  32)
   )
  )


(deftype medius-end-game-report (structure)
  ((session-key      uint8  17)
   (medius-world-id  int32)
   (winning-team     uint8  64)
   (winning-player   uint8  32)
   (final-score      int32)
   )
  )


(deftype medius-error-message (structure)
  ((error-code     int32)
   (error-message  uint8  256)
   )
  )


(deftype medius-find-player-request (structure)
  ((message-id   uint8  21)
   (session-key  uint8  17)
   (search-type  medius-player-search-type)
   (id           int32)
   (name         uint8  32)
   )
  )


(deftype medius-find-player-response (structure)
  ((message-id        uint8  21)
   (status-code       medius-status-code)
   (application-id    int32)
   (application-name  uint8  32)
   (application-type  medius-application-type)
   (medius-world-id   int32)
   (account-id        int32)
   (account-name      uint8  32)
   (end-of-list       int8)
   )
  )


(deftype medius-find-world-by-name-request (structure)
  ((message-id   uint8  21)
   (session-key  uint8  17)
   (name         uint8  64)
   (world-type   medius-find-world-type)
   )
  )


(deftype medius-find-world-by-name-response (structure)
  ((message-id        uint8  21)
   (status-code       medius-status-code)
   (application-id    int32)
   (application-name  uint8  32)
   (application-type  medius-application-type)
   (medius-world-id   int32)
   (world-name        uint8  64)
   (world-status      medius-world-status)
   (end-of-list       int8)
   )
  )


(deftype medius-game-info-request (structure)
  ((message-id       uint8  21)
   (session-key      uint8  17)
   (medius-world-id  int32)
   )
  )


(deftype medius-game-info-response (structure)
  ((message-id          uint8  21)
   (status-code         medius-status-code)
   (application-id      int32)
   (min-players         int32)
   (max-players         int32)
   (game-level          int32)
   (player-skill-level  int32)
   (player-count        int32)
   (game-stats          uint8  256)
   (game-name           uint8  64)
   (rules-set           int32)
   (generic-field1      int32)
   (generic-field2      int32)
   (generic-field3      int32)
   (world-status        medius-world-status)
   (game-host-type      medius-game-host-type)
   )
  )


(deftype medius-game-list-extra-info-request (structure)
  ((message-id  uint8  21)
   (page-id     uint16)
   (page-size   uint16)
   )
  )


(deftype medius-game-list-extra-info-response (structure)
  ((message-id          uint8  21)
   (status-code         medius-status-code)
   (medius-world-id     int32)
   (player-count        uint16)
   (min-players         uint16)
   (max-players         uint16)
   (game-level          int32)
   (player-skill-level  int32)
   (rules-set           int32)
   (generic-field1      int32)
   (generic-field2      int32)
   (generic-field3      int32)
   (security-level      medius-world-security-level-type)
   (world-status        medius-world-status)
   (game-host-type      medius-game-host-type)
   (game-name           uint8  64)
   (game-stats          uint8  256)
   (end-of-list         int8)
   )
  )


(deftype medius-game-list-request (structure)
  ((message-id      uint8  21)
   (session-key     uint8  17)
   (application-id  int32)
   (page-id         int16)
   (page-size       int16)
   )
  )


(deftype medius-game-list-response (structure)
  ((message-id       uint8  21)
   (status-code      medius-status-code)
   (medius-world-id  int32)
   (game-name        uint8  64)
   (world-status     medius-world-status)
   (game-host-type   medius-game-host-type)
   (player-count     int32)
   (end-of-list      int8)
   )
  )


(deftype medius-game-world-player-list-request (structure)
  ((message-id       uint8  21)
   (session-key      uint8  17)
   (medius-world-id  int32)
   )
  )


(deftype medius-game-world-player-list-response (structure)
  ((message-id        uint8  21)
   (status-code       medius-status-code)
   (account-id        int32)
   (account-name      uint8  32)
   (stats             uint8  256)
   (connection-class  medius-connection-type)
   (end-of-list       int8)
   )
  :allow-misaligned
  )



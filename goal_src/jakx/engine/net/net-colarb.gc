;; WARN: Return type mismatch int vs object.
(defun net-colarb-clear ()
  (dotimes (v1-0 64)
    (let ((a0-1 (-> *net-colarb-last-reqs* v1-0)))
      (set! (-> a0-1 req-by) -1)
      (set! (-> a0-1 req-time) -1)
      )
    )
  0
  )

;; WARN: Return type mismatch int vs object.
(defun colarb-request-msg-callback ((arg0 mem-buffer))
  (read-int8 arg0)
  (read-int8 arg0)
  (let* ((s4-0 (read-int8 arg0))
         (gp-0 (read-int8 arg0))
         (v1-7 (read-int32 arg0))
         (a0-7 (-> *net-colarb-last-reqs* s4-0))
         )
    (when (>= (- (- (- (if *net-mgr*
                           (-> *net-mgr* game-state time)
                           0
                           )
                       (if *net-world*
                           (-> *net-world* net-state game-start-time)
                           0
                           )
                       )
                    (if *net-world*
                        (-> *net-world* net-state total-pause-time)
                        0
                        )
                    )
                 (-> a0-7 req-time)
                 )
              4500
              )
      (set! (-> a0-7 req-by) -1)
      (set! (-> a0-7 req-time) -1)
      )
    (when (or (= (-> a0-7 req-by) -1) (< gp-0 (-> a0-7 req-by)))
      (set! (-> a0-7 req-by) gp-0)
      (set! (-> a0-7 req-time) v1-7)
      )
    )
  0
  )

(set! (-> *net-aux-msg-handlers* 9 handler-func)
      (the-as (function mem-buffer int object) colarb-request-msg-callback)
      )

(defun net-colarb-request-id ((arg0 int))
  (let ((gp-0 (-> *net-colarb-last-reqs* arg0)))
    (when (>= (- (- (- (if *net-mgr*
                           (-> *net-mgr* game-state time)
                           0
                           )
                       (if *net-world*
                           (-> *net-world* net-state game-start-time)
                           0
                           )
                       )
                    (if *net-world*
                        (-> *net-world* net-state total-pause-time)
                        0
                        )
                    )
                 (-> gp-0 req-time)
                 )
              4500
              )
      (set! (-> gp-0 req-by) -1)
      (set! (-> gp-0 req-time) -1)
      )
    (cond
      ((= (-> gp-0 req-by) (if *net-mgr*
                               (-> *net-mgr* game-state local-machine-idx)
                               0
                               )
          )
       (if (>= (- (- (- (if *net-mgr*
                            (-> *net-mgr* game-state time)
                            0
                            )
                        (if *net-world*
                            (-> *net-world* net-state game-start-time)
                            0
                            )
                        )
                     (if *net-world*
                         (-> *net-world* net-state total-pause-time)
                         0
                         )
                     )
                  (-> gp-0 req-time)
                  )
               225
               )
           0
           2
           )
       )
      ((= (-> gp-0 req-by) -1)
       (let ((s4-0 (alloc-msg-buffer)))
         (write-int8 s4-0 0)
         (write-int8 s4-0 0)
         (write-int8 s4-0 9)
         (write-int8 s4-0 arg0)
         (write-int8 s4-0 (if *net-mgr*
                              (-> *net-mgr* game-state local-machine-idx)
                              0
                              )
                     )
         (write-int32 s4-0 (- (- (if *net-mgr*
                                     (-> *net-mgr* game-state time)
                                     0
                                     )
                                 (if *net-world*
                                     (-> *net-world* net-state game-start-time)
                                     0
                                     )
                                 )
                              (if *net-world*
                                  (-> *net-world* net-state total-pause-time)
                                  0
                                  )
                              )
                      )
         (set! (-> (the-as (pointer int8) (-> s4-0 base)) 1) (+ (bytes-used s4-0) -1))
         (net-send-msg 128 s4-0 -2)
         (free-msg-buffer s4-0)
         )
       (set! (-> gp-0 req-by) (if *net-mgr*
                                  (-> *net-mgr* game-state local-machine-idx)
                                  0
                                  )
             )
       (set! (-> gp-0 req-time) (- (- (if *net-mgr*
                                          (-> *net-mgr* game-state time)
                                          0
                                          )
                                      (if *net-world*
                                          (-> *net-world* net-state game-start-time)
                                          0
                                          )
                                      )
                                   (if *net-world*
                                       (-> *net-world* net-state total-pause-time)
                                       0
                                       )
                                   )
             )
       2
       )
      (else
        1
        )
      )
    )
  )

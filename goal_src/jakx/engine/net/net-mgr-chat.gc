;; WARN: Swapped fp-relative label and field offsets for "@Game"
;; WARN: Swapped fp-relative label and field offsets for ""
;; WARN: Return type mismatch int vs object.
(defun handle-chat-msg ((arg0 medius-chat-fwd-message) (arg1 symbol))
  (with-pp
    (inspect arg0)
    (when (!= (-> arg0 message-type) (medius-chat-message-type whisper))
      (cond
        ((= (-> arg0 message-s8 0) 64)
         (when (strncmp (-> arg0 message) (-> "@Game" data) 5)
           (let ((gp-1 pp))
             (set! pp *lobby-menu-manager*)
             (send-event *lobby-menu-manager* 'chat-refresh-games :from *lobby-menu-manager*)
             (set! pp gp-1)
             )
           )
         )
        (else
          (lobby-chat-window-method-11
            *lobby-chat-window*
            (the-as int (-> arg0 originator-account-name))
            (the-as int (-> arg0 message))
            )
          (let ((s5-0 pp))
            (set! pp *lobby-menu-manager*)
            (send-event
              *lobby-menu-manager*
              'chat-msg
              :from *lobby-menu-manager*
              (-> arg0 originator-account-name)
              (-> arg0 message)
              )
            (set! pp s5-0)
            )
          )
        )
      (return (the-as object #f))
      )
    (if (> (-> arg0 originator-account-id) 0)
        (add-recent-opponent (-> arg0 originator-account-id))
        )
    (when (= (-> arg0 message-s8 0) 64)
      (set! (-> *chat-msg-strings* 0) (-> "" data))
      (set! (-> *chat-msg-strings* 1) (-> "" data))
      (set! (-> *chat-msg-strings* 2) (-> "" data))
      (mem-copy! *chat-msg-buffer* (-> arg0 message) 64)
      (do-split-chat-msg *chat-msg-buffer*)
      (when (> *chat-msg-string-ct* 0)
        (let* ((s5-1 (-> *magic-chat* length))
               (s4-0 0)
               (s3-0 (-> *magic-chat* s4-0))
               )
          (while (< s4-0 s5-1)
            (when (strncmp (-> s3-0 prefix data) (the-as pointer (-> *chat-msg-strings* 0)) -1)
              (when (-> s3-0 buddies-only)
                (if (not (contains? *medius-buddies* (-> arg0 originator-account-id)))
                    (return (the-as object #f))
                    )
                )
              (cond
                ((-> s3-0 has-player-name)
                 (expand-text-to-charp! *common-text* (-> *chat-msg-player* data) (-> arg0 originator-account-name))
                 (format
                   (clear *chat-msg-string*)
                   (lookup-text! *common-text* (-> s3-0 popup-text-id) #f)
                   *chat-msg-player*
                   (-> *chat-msg-strings* 1)
                   )
                 )
                (else
                  (format
                    (clear *chat-msg-string*)
                    (lookup-text! *common-text* (-> s3-0 popup-text-id) #f)
                    (-> *chat-msg-strings* 1)
                    (-> *chat-msg-strings* 2)
                    )
                  )
                )
              (when (-> s3-0 add-clan-id)
                (let ((a1-13 (x8toi (the-as pointer (-> *chat-msg-strings* 1)))))
                  (if (!= a1-13 (-> *medius-my-clan* medius-id))
                      (move-to-front! *medius-recent-clans* (the-as medius-cache a1-13))
                      )
                  )
                )
              (let ((a1-14 -1))
                (if (-> s3-0 resp-type)
                    (set! a1-14 (x8toi (the-as pointer (-> *chat-msg-strings* 1))))
                    )
                (add-raw-popup-msg (-> *chat-msg-string* data) a1-14 (-> s3-0 resp-type))
                )
              (when (-> s3-0 send-lobby-event)
                (let ((s2-2 pp))
                  (set! pp *net-mgr*)
                  (send-event *lobby-menu-manager* (-> s3-0 send-lobby-event) :from *lobby-menu-manager*)
                  (set! pp s2-2)
                  )
                )
              (when (-> s3-0 stale-player)
                (format 0 "stale player... ~D~%" (-> arg0 originator-account-id))
                (process-spawn-function
                  process
                  (lambda :behavior process
                    ((arg0 int))
                    (suspend-for (seconds 1)
                      )
                    (mark-stale! *medius-player-cache* arg0)
                    )
                  (-> arg0 originator-account-id)
                  )
                )
              )
            (+! s4-0 1)
            (set! s3-0 (-> *magic-chat* s4-0))
            )
          )
        )
      (return (the-as object #f))
      )
    (clear *chat-msg-string*)
    (when (nonzero? (-> arg0 originator-account-name-s8 0))
      (expand-text-to-charp! *common-text* (-> *chat-msg-string2* data) (-> arg0 originator-account-name))
      (format *chat-msg-string* "~S: " *chat-msg-string2*)
      )
    (expand-text-to-charp! *common-text* (-> *chat-msg-string2* data) (-> arg0 message))
    (copy-charp<-charp
      (&-> *chat-msg-string* data (strlen (-> *chat-msg-string* data)))
      (-> *chat-msg-string2* data)
      )
    (add-raw-popup-msg (-> *chat-msg-string* data) -1 #f)
    0
    )
  )

;; WARN: Swapped fp-relative label and field offsets for "WWWWWWWWWWWWWW"
;; WARN: Swapped fp-relative label and field offsets for "@GameInvite"
;; WARN: Swapped fp-relative label and field offsets for " 00000141"
;; WARN: Return type mismatch int vs object.
(defun fake-chat-msg ()
  (let ((gp-0 (new 'stack-no-clear 'inline-array 'medius-chat-fwd-message 1)))
    (mem-clear! (the-as pointer (-> gp-0 0)) 128)
    (set! (-> gp-0 0 message-type) (medius-chat-message-type whisper))
    (set! (-> gp-0 0 originator-account-id) 1001)
    (copy-charp<-charp (-> gp-0 0 originator-account-name) (-> "WWWWWWWWWWWWWW" data))
    (copy-charp<-charp (-> gp-0 0 message) (-> "@GameInvite" data))
    (copy-charp<-charp (&-> gp-0 0 message (strlen (-> gp-0 0 message))) (-> " 00000141" data))
    (handle-chat-msg (-> gp-0 0) #f)
    )
  0
  )

;; WARN: Return type mismatch int vs object.
(defun send-chat-with-clan-id ((arg0 string) (arg1 int) (arg2 symbol))
  (when *net-mgr*
    (format (clear *chat-msg-string*) "~S ~8X" arg0 (-> *medius-my-clan* medius-id))
    (send-chat-msg *net-mgr* *chat-msg-string* arg1 arg2)
    )
  0
  )

;; WARN: Return type mismatch int vs object.
(defun send-chat-with-game-id ((arg0 string) (arg1 int) (arg2 symbol))
  (when *net-mgr*
    (format (clear *chat-msg-string*) "~S ~8X" arg0 (-> *net-active-game* medius-world-id))
    (send-chat-msg *net-mgr* *chat-msg-string* arg1 arg2)
    )
  0
  )


(define *chat-msg-string-ct* 0)

(define *chat-msg-strings* (new 'static 'boxed-array :type object :length 0 :allocated-length 16))

(defun is-whitespace ((arg0 int))
  (or (= arg0 32) (= arg0 13) (= arg0 10) (= arg0 9))
  )

;; WARN: Return type mismatch int vs object.
;; WARN: new jak 2 until loop case, check carefully
;; WARN: new jak 2 until loop case, check carefully
;; WARN: new jak 2 until loop case, check carefully
(defun split-chat-msg ((arg0 (pointer int8)))
  (set! *chat-msg-string-ct* 0)
  (let ((gp-0 arg0))
    (until #f
      (until #f
        (if (not (is-whitespace (-> gp-0 0)))
            (goto cfg-5)
            )
        (set! gp-0 (&-> gp-0 1))
        )
      #f
      (label cfg-5)
      (if (zero? (-> gp-0 0))
          (return (the-as object #f))
          )
      (let ((s5-0 gp-0))
        (until #f
          (if (or (is-whitespace (-> gp-0 0)) (zero? (-> gp-0 0)))
              (goto cfg-16)
              )
          (set! gp-0 (&-> gp-0 1))
          )
        #f
        (label cfg-16)
        (set! (-> *chat-msg-strings* *chat-msg-string-ct*) s5-0)
        )
      (set! *chat-msg-string-ct* (+ *chat-msg-string-ct* 1))
      (if (zero? (-> gp-0 0))
          (return (the-as object #f))
          )
      (set! (-> gp-0 0) 0)
      (if (= *chat-msg-string-ct* 16)
          (return (the-as object #f))
          )
      (set! gp-0 (&-> gp-0 1))
      )
    )
  #f
  0
  )

;; WARN: Return type mismatch int vs object.
(defun do-split-chat-msg ((arg0 (pointer uint8)))
  (split-chat-msg (the-as (pointer int8) arg0))
  (dotimes (gp-0 *chat-msg-string-ct*)
    (format #t "[~G]~%" (-> *chat-msg-strings* gp-0))
    )
  0
  )

(deftype received-chat-msg (structure)
  ((text       uint8  600)
   (disp-time  int32)
   (id         int32)
   (resp-type  symbol)
   )
  )


(define *received-chat-msg-ct* 0)

(define *received-chat-msgs* (new 'static 'inline-array received-chat-msg 8
                               (new 'static 'received-chat-msg)

;; WARN: Return type mismatch int vs object.
(defun purge-top-chat-msg ()
  (if (<= *received-chat-msg-ct* 0)
      (return (the-as object #f))
      )
  (set! *received-chat-msg-ct* (+ *received-chat-msg-ct* -1))
  (mem-copy! (the-as pointer *received-chat-msgs*) (the-as pointer (-> *received-chat-msgs* 1)) 4284)
  0
  )

;; WARN: Return type mismatch int vs object.
(defun purge-all-chat-msgs ()
  (set! *received-chat-msg-ct* 0)
  0
  )

(defun get-top-chat-msg ()
  (if (> *received-chat-msg-ct* 0)
      (-> *received-chat-msgs* 0)
      (the-as received-chat-msg #f)
      )
  )

;; WARN: Return type mismatch int vs object.
(defun add-raw-popup-msg ((arg0 (pointer uint8)) (arg1 int) (arg2 symbol))
  (if (>= *received-chat-msg-ct* 8)
      (return (the-as object #f))
      )
  (let ((s3-0 (-> *received-chat-msgs* *received-chat-msg-ct*)))
    (mem-clear! (the-as pointer s3-0) 612)
    (let ((s2-1 (min 600 (strlen arg0))))
      (mem-copy! (-> s3-0 text) arg0 s2-1)
      (set! (-> s3-0 text s2-1) (the-as uint 0))
      )
    0
    (set! (-> s3-0 id) arg1)
    (set! (-> s3-0 resp-type) arg2)
    )
  (set! *received-chat-msg-ct* (+ *received-chat-msg-ct* 1))
  0
  )


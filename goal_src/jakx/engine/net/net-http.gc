;;-*-Lisp-*-
(in-package goal)

;; name: net-http.gc
;; name in dgo: net-http
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

(define *http-downloader* (new 'static 'handle-wrapper))

(set! (-> *http-downloader* handle) (the-as handle #f))

(define *http-request-string* (new 'global 'string 160 (the-as string #f)))

(deftype http-downloader (process)
  ((socket       int32)
   (buffer       uint8  1024)
   (buffer-s8    int8   1024 :overlay-at (-> buffer 0))
   (hostname     uint8  128)
   (url          uint8  128)
   (ip           int32)
   (port         int32)
   (http-rc      int32)
   (content-len  int32)
   (quench       symbol)
   )
  (:state-methods
    resolving
    connecting
    fetching-headers
    fetching-data
    die
    )
  (:methods
    (event-handler (_type_ process int symbol event-message-block) object)
    (construct-url (_type_ (pointer uint8)) symbol)
    (handle-download (_type_) symbol)
    )
  )


(defbehavior http-downloader-init-by-other http-downloader ((arg0 (pointer uint8)))
  (stack-size-set! (-> self main-thread) 1024)
  (logclear! (-> self mask) (process-mask pause menu))
  (set! (-> self socket) -1)
  (set! (-> self quench) #f)
  (if (not (construct-url self arg0))
      (return #f)
      )
  (format 0 "go resolve~%")
  (go-virtual resolving)
  )

;; WARN: Return type mismatch process vs http-downloader.
(defbehavior http-start-fetch process ((arg0 (pointer uint8)))
  (set! (-> *http-downloader* handle)
        (process->handle (ppointer->process (process-spawn http-downloader arg0 :name "http-downloader" :to self)))
        )
  (the-as http-downloader (handle->process (-> *http-downloader* handle)))
  )

(defbehavior http-downloader-default-handler http-downloader ((arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (event-handler self arg0 arg1 arg2 arg3)
  )

;; WARN: Return type mismatch symbol vs object.
(defmethod event-handler ((this http-downloader) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (case arg2
    (('cancel)
     (format 0 "CANCELLED!!!~%")
     (send-event (ppointer->process (-> this parent)) 'http-download-cancelled)
     (go (method-of-object this die))
     )
    (('pause)
     (set! (-> this quench) #t)
     )
    (('resume)
     (set! (-> this quench) #f)
     )
    )
  #f
  )

;; WARN: Swapped fp-relative label and field offsets for "://"
;; WARN: Swapped fp-relative label and field offsets for "/"
;; WARN: Swapped fp-relative label and field offsets for ":"
(defmethod construct-url ((this http-downloader) (arg0 (pointer uint8)))
  (let ((v1-1 (strstr arg0 (-> "://" data))))
    (if (not v1-1)
        (return #f)
        )
    (let* ((s5-0 (&+ v1-1 3))
           (s4-0 (strstr s5-0 (-> "/" data)))
           )
      (if (not s4-0)
          (return #f)
          )
      (mem-clear! (-> this hostname) 128)
      (mem-copy! (-> this hostname) s5-0 (&- s4-0 (the-as uint s5-0)))
      (mem-clear! (-> this url) 128)
      (copy-charp<-charp (-> this url) (the-as (pointer uint8) s4-0))
      )
    )
  (set! (-> this port) 80)
  (let ((v1-8 (strstr (-> this hostname) (-> ":" data))))
    (when v1-8
      (set! (-> (the-as (pointer int8) v1-8)) 0)
      (let ((a0-10 (&+ v1-8 1)))
        (set! (-> this port) (atoi a0-10))
        )
      )
    )
  (format 0 "hostname : [~G]~%" (-> this hostname))
  (format 0 "port     : [~D]~%" (-> this port))
  (format 0 "url      : [~G]~%" (-> this url))
  (format 0 "GET ~G HTTP/1.0~%" (-> this url))
  #t
  )

;; WARN: Swapped fp-relative label and field offsets for "HTTP/"
;; WARN: Swapped fp-relative label and field offsets for " "
;; WARN: Swapped fp-relative label and field offsets for "Content-Length"
;; WARN: Swapped fp-relative label and field offsets for ":"
(defmethod handle-download ((this http-downloader))
  (format 0 "process header line: [~G]~%" (-> this buffer))
  (cond
    ((= (-> this http-rc) -1)
     (let ((v1-3 (strstr (-> this buffer) (-> "HTTP/" data))))
       (when (!= v1-3 (-> this buffer))
         (format 0 "http-failed: ~A~%" 'bad-response)
         (send-event (ppointer->process (-> this parent)) 'http-download-failed 'bad-response)
         (go (method-of-object this die))
         )
       )
     (let ((s5-0 (strstr (-> this buffer) (-> " " data))))
       (when (not s5-0)
         (format 0 "http-failed: ~A~%" 'bad-response)
         (send-event (ppointer->process (-> this parent)) 'http-download-failed 'bad-response)
         (go (method-of-object this die))
         )
       (let ((s5-1 (&+ s5-0 1)))
         (let ((s4-0 (strstr s5-1 (-> " " data))))
           (when (not s4-0)
             (format 0 "http-failed: ~A~%" 'bad-response)
             (send-event (ppointer->process (-> this parent)) 'http-download-failed 'bad-response)
             (go (method-of-object this die))
             )
           (set! (-> (the-as (pointer int8) s4-0)) 0)
           )
         0
         (set! (-> this http-rc) (atoi-better s5-1))
         )
       )
     )
    ((strstr (-> this buffer) (-> "Content-Length" data))
     (let ((s5-2 (strstr (-> this buffer) (-> ":" data))))
       (when (not s5-2)
         (format 0 "http-failed: ~A~%" 'bad-response)
         (send-event (ppointer->process (-> this parent)) 'http-download-failed 'bad-response)
         (go (method-of-object this die))
         )
       (let ((a0-22 (&+ s5-2 1)))
         (set! (-> this content-len) (atoi-better a0-22))
         )
       )
     (format 0 "content-len : ~D~%" (-> this content-len))
     )
    ((zero? (strlen (-> this buffer)))
     (return #t)
     )
    )
  #f
  )

(defstate resolving (http-downloader)
  :virtual #t
  :event http-downloader-default-handler
  :code (behavior ()
    (let ((gp-0 (get-host-by-name (-> self hostname) (seconds 20))))
      (when (zero? gp-0)
        (format 0 "http-failed: ~A~%" 'dns-failed)
        (send-event (ppointer->process (-> self parent)) 'http-download-failed 'dns-failed)
        (go-virtual die)
        )
      (set! (-> self ip) gp-0)
      (format 0 "ip is ~X~%" gp-0)
      )
    (go-virtual connecting)
    )
  )

(define *socket-blocking* (the-as symbol 0))

(defstate connecting (http-downloader)
  :virtual #t
  :event http-downloader-default-handler
  :code (behavior ()
    (set! (-> self socket) (knet-tcp-socket-open -1))
    (when (< (-> self socket) 0)
      (format 0 "http-failed: ~A~%" 'socket-error)
      (send-event (ppointer->process (-> self parent)) 'http-download-failed 'socket-error)
      (go-virtual die)
      )
    (set! *socket-blocking* (the-as symbol 1))
    (when (nonzero? (knet-tcp-set-sockopt (-> self socket) #xffff 4105 (&-> '*socket-blocking* value) 4))
      (format 0 "http-failed: ~A~%" 'socket-error)
      (send-event (ppointer->process (-> self parent)) 'http-download-failed 'socket-error)
      (go-virtual die)
      )
    (when (nonzero? (knet-tcp-socket-connect (-> self socket) (-> self ip) (-> self port)))
      (let ((v1-27 (knet-tcp-errno)))
        (when (!= v1-27 119)
          (format 0 "http-failed: ~A~%" 'connect-error)
          (send-event (ppointer->process (-> self parent)) 'http-download-failed 'connect-error)
          (go-virtual die)
          )
        )
      )
    (format 0 "waiting for connect~%")
    (suspend-for (seconds 10)
      (let ((s5-0 (knet-tcp-socket-poll (-> self socket) 4)))
        (if (> s5-0 0)
            (go-virtual fetching-headers)
            )
        (when (< s5-0 0)
          (format 0 "http-failed: ~A~%" 'connect-failed)
          (send-event (ppointer->process (-> self parent)) 'http-download-failed 'connect-failed)
          (go-virtual die)
          )
        )
      )
    (set! *socket-blocking* (the-as symbol 0))
    (when (nonzero? (knet-tcp-set-sockopt (-> self socket) #xffff 4105 (&-> '*socket-blocking* value) 4))
      (format 0 "http-failed: ~A~%" 'socket-error)
      (send-event (ppointer->process (-> self parent)) 'http-download-failed 'socket-error)
      (go-virtual die)
      )
    (format 0 "http-failed: ~A~%" 'connect-timeout)
    (send-event (ppointer->process (-> self parent)) 'http-download-failed 'connect-timeout)
    (go-virtual die)
    )
  )

(defstate fetching-headers (http-downloader)
  :virtual #t
  :event http-downloader-default-handler
  :code (behavior ()
    (format 0 "fetching-headers...~%")
    (set! (-> self http-rc) -1)
    (set! (-> self content-len) -1)
    (copy-charp<-charp (-> self buffer) (-> "GET " data))
    (copy-charp<-charp (&-> self buffer (strlen (-> self buffer))) (-> self url))
    (copy-charp<-charp (&-> self buffer (strlen (-> self buffer))) (-> " HTTP/1.0" data))
    (let ((v1-7 (&-> self buffer (strlen (-> self buffer)))))
      (set! (-> v1-7 0) (the-as uint 13))
      (set! (-> v1-7 1) (the-as uint 10))
      (set! (-> v1-7 2) (the-as uint 0))
      )
    0
    (copy-charp<-charp (&-> self buffer (strlen (-> self buffer))) (-> "Host: " data))
    (copy-charp<-charp (&-> self buffer (strlen (-> self buffer))) (-> self hostname))
    (let ((v1-13 (&-> self buffer (strlen (-> self buffer)))))
      (set! (-> v1-13 0) (the-as uint 13))
      (set! (-> v1-13 1) (the-as uint 10))
      (set! (-> v1-13 2) (the-as uint 13))
      (set! (-> v1-13 3) (the-as uint 10))
      (set! (-> v1-13 4) (the-as uint 0))
      )
    0
    (let ((gp-5 (knet-tcp-socket-send (-> self socket) (-> self buffer) (strlen (-> self buffer)))))
      (when (!= gp-5 (strlen (-> self buffer)))
        (format 0 "http-failed: ~A~%" 'short-send)
        (send-event (ppointer->process (-> self parent)) 'http-download-failed 'short-send)
        (go-virtual die)
        )
      )
    (format 0 "sent request... waiting for content...~%")
    (let ((gp-6 0))
      0
      (until #f
        (when (>= gp-6 1024)
          (format 0 "http-failed: ~A~%" 'bad-response)
          (send-event (ppointer->process (-> self parent)) 'http-download-failed 'bad-response)
          (go-virtual die)
          )
        (let ((v1-39 (knet-tcp-socket-recv (-> self socket) (&+ (-> self buffer) gp-6) 1)))
          (cond
            ((zero? v1-39)
             (format 0 "http-failed: ~A~%" 'server-close)
             (send-event (ppointer->process (-> self parent)) 'http-download-failed 'server-close)
             (go-virtual die)
             )
            ((< v1-39 0)
             (let ((v1-50 (knet-tcp-errno)))
               (when (!= v1-50 11)
                 (format 0 "http-failed: ~A~%" 'data-error)
                 (send-event (ppointer->process (-> self parent)) 'http-download-failed 'data-error)
                 (go-virtual die)
                 )
               )
             (suspend)
             0
             )
            ((= (-> self buffer-s8 gp-6) 10)
             (set! (-> self buffer gp-6) (the-as uint 0))
             (if (handle-download self)
                 (goto cfg-36)
                 )
             (set! gp-6 0)
             )
            ((= (-> self buffer-s8 gp-6) 13)
             )
            (else
              (+! gp-6 1)
              )
            )
          )
        )
      )
    #f
    (label cfg-36)
    (when (!= (-> self http-rc) 200)
      (format 0 "http-failed: ~A~%" 'bad-return-code)
      (send-event (ppointer->process (-> self parent)) 'http-download-failed 'bad-return-code (-> self http-rc))
      (go-virtual die)
      )
    (when (= (-> self content-len) -1)
      (format 0 "http-failed: ~A~%" 'bad-content-len)
      (send-event (ppointer->process (-> self parent)) 'http-download-failed 'bad-content-len)
      (go-virtual die)
      )
    (go-virtual fetching-data)
    )
  )

(defstate fetching-data (http-downloader)
  :virtual #t
  :event http-downloader-default-handler
  :code (behavior ()
    (send-event (ppointer->process (-> self parent)) 'http-download-data-start (-> self content-len))
    (let ((gp-0 0))
      0
      (while (< gp-0 (-> self content-len))
        (while (-> self quench)
          (suspend)
          )
        (let ((s5-0 (knet-tcp-socket-recv (-> self socket) (-> self buffer) 1024)))
          (cond
            ((zero? s5-0)
             (format 0 "http-failed: ~A~%" 'server-close)
             (send-event (ppointer->process (-> self parent)) 'http-download-failed 'server-close)
             (go-virtual die)
             )
            ((< s5-0 0)
             (let ((v1-20 (knet-tcp-errno)))
               (when (!= v1-20 11)
                 (format 0 "http-failed: ~A~%" 'data-error)
                 (send-event (ppointer->process (-> self parent)) 'http-download-failed 'data-error)
                 (go-virtual die)
                 )
               )
             (suspend)
             0
             )
            (else
              (+! gp-0 s5-0)
              (send-event (ppointer->process (-> self parent)) 'http-download-data (-> self buffer) s5-0)
              (format *stdebug* "received ~D bytes : ~D/~D~%" s5-0 gp-0 (-> self content-len))
              )
            )
          )
        )
      )
    (send-event (ppointer->process (-> self parent)) 'http-download-complete (-> self content-len))
    (go-virtual die)
    )
  )

(defstate die (http-downloader)
  :virtual #t
  :code (behavior ()
    '()
    )
  )

(defmethod deactivate ((this http-downloader))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (if (>= (-> this socket) 0)
      (knet-tcp-socket-close (-> this socket))
      )
  (call-parent-method this)
  (none)
  )

(define *clan-pending-deltas-valid* #f)

(define *clan-pending-deltas* (new 'static 'array uint32 9 #x0 #x0 #x0 #x0 #x0 #x0 #x0 #x0 #x0))

(deftype medius-cached-info-clan (medius-cached-info)
  ((name            uint8                  32)
   (leader-acct-id  int32)
   (leader-name     uint8                  32)
   (stats           uint8                  256)
   (members         medius-player-index-array)
   (ladder-stats    net-clan-ladder-stats  :inline)
   )
  (:methods
    (medius-cached-info-clan-method-12 (_type_ medius-cached-info-clan) none)
    )
  )


(deftype medius-clan (medius-cache-index)
  ()
  (:methods
    (medius-clan-method-11 (_type_) none)
    )
  )


(deftype medius-clan-index-array (medius-cache-index-array)
  ()
  )


(deftype medius-incoming-clan-invite (structure)
  ((clan-id    int32)
   (invite-id  int32)
   (clan-name  uint8  32)
   )
  )


(deftype medius-clan-challenge (structure)
  ((send-clan-id  int32)
   (recv-clan-id  int32)
   (challenge-id  int32)
   (status        int32)
   )
  )



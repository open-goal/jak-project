          (let* ((s5-0 (-> v1-14 entity))
                 (s4-0 (-> s5-0 length))
                 )
            (dotimes (s3-0 s4-0)
              (let* ((s2-0 (-> s5-0 data s3-0))
                     (v1-19 (and (logtest? (-> s2-0 kill-mask) (task-mask network))
                                 (let ((v1-20 (as-type (-> s2-0 entity) entity-actor)))
                                   (cond

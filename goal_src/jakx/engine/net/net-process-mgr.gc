      (((net-process-msg-handler-opcode process-create))
       (handle-msg-process-create *net-process-mgr* arg0 arg1 (the-as int a3-0))
       )
      (((net-process-msg-handler-opcode process-kill))
       (handle-msg-process-kill *net-process-mgr* arg0 arg1 (the-as int a3-0))
       )
      (((net-process-msg-handler-opcode process-destroy))
       (handle-msg-process-destroy *net-process-mgr* arg0 arg1 (the-as int a3-0))

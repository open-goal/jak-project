    (when (not (logtest? (-> *net-world* net-state flags) 1))
      (format 0 "not spawning entities because world is not yet locked~%")
      (return (the-as object #f))
      )
    (set-entity-creation-messages-enabled *net-process-mgr* #f)
    (let ((gp-1 (logclear arg0 (task-mask network never))))
      (let ((v1-14 (get-shared-level)))

(in-package goal)

;; name: net-process-mgr.gc
;; name in dgo: net-process-mgr
;; dgos: ENGINE, GAME

;; +++net-process-msg-handler-opcode
(defenum net-process-msg-handler-opcode
  (process-create 0)
  (process-kill 1)
  (process-destroy 2)
  (ownership-request 3)
  (ownership-grant 4)
  (ownership-deny 5)
  (object-request 6)
  )
;; ---net-process-msg-handler-opcode

;; DECOMP BEGINS

;; WARN: Return type mismatch process vs net-process-mgr.
(defmethod relocate ((this net-process-mgr) (offset int))
  (set! *net-process-mgr* this)
  (if *net-process-mgr*
      (set! *net-process-mgr* (&+ *net-process-mgr* offset))
      )
  (the-as net-process-mgr ((method-of-type process relocate) this offset))
  )

(defmethod deactivate ((this net-process-mgr))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (set! *net-process-mgr* #f)
  ((method-of-type process deactivate) this)
  (none)
  )

(defbehavior net-process-mgr-init-by-other net-process-mgr ()
  (logclear! (-> self mask) (process-mask pause menu))
  (reset! self)
  (go-virtual startup)
  )

;; WARN: Return type mismatch int vs object.
(defun spawn-net-entity ((arg0 entity-links))
  (birth! (-> arg0 entity))
  (if (-> arg0 process)
      (logior! (-> arg0 process mask) (process-mask no-kill))
      )
  0
  )

(define *net-process-table*
  (new 'static 'boxed-array :type process-nettable :length 0 :allocated-length 1024)
  )

(deftype owner-and-flags (int8)
  ((owner-idx int8 :offset   0 :size   7)
   (entity    int8 :offset   7 :size   1)
   )
  )

(deftype nospawn (process)
  ()
  )


(defun net-process-mgr-start ()
  (when (not *net-process-mgr*)
    (let ((gp-0 (get-process *default-dead-pool* net-process-mgr #x4000 1)))
      (set! *net-process-mgr*
            (the-as net-process-mgr
              (-> (when gp-0
                    (let ((t9-1 (method-of-type net-process-mgr activate)))
                      (t9-1 (the-as net-process-mgr gp-0) *default-pool* "net-process-mgr" (the-as pointer #x70004000))
                      )
                    (run-now-in-process gp-0 net-process-mgr-init-by-other)
                    (-> gp-0 ppointer)
                    )
                  0
                  )
              )
            )
      )
    )
  0
  (none)
  )

(defun net-process-mgr-stop ()
  (when *net-process-mgr*
    (format 0 "net-process-mgr: destroying all net-processes~%")
    (destroy-all-processes *net-process-mgr* #f)
    (send-event *net-process-mgr* 'go-die)
    )
  0
  (none)
  )


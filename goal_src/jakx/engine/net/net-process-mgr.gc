                     )
                (when v1-19
                  (cond
                    ((not (logtest? (-> s2-0 kill-mask) gp-1))
                     (if (not (-> s2-0 process))
                         (spawn-net-entity s2-0)
                         )
                     )
                    (else
                      (let ((s2-1 (-> s2-0 process)))
                        (when s2-1
                          (let ((s1-2 (alloc-msg (the-as process-nettable s2-1) 'destroy-silent)))
                            (send-msg (the-as process-nettable s2-1) s1-2 -2 80)
                            (free-msg (the-as process-nettable s2-1) s1-2)
                            )
                          (let ((s1-3 pp))
                            (set! pp s2-1)
                            (on-destroy-silent (the-as process-nettable s2-1))
                            (set! pp s1-3)
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      (let ((v1-39 (get-event-level)))

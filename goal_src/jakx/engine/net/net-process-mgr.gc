(defmethod reset! ((this net-process-mgr))
  (update! *level-bounding-box*)
  (set! (-> this local-machine-idx) -1)
  (set! (-> this session-master-idx) -1)
  (set! (-> this last-allocated-local-id) -1)
  (set! (-> this last-allocated-global-id) -1)
  (set! (-> this cur-proc-valid) #f)
  (set! *net-start-view-ct* 1)
  (dotimes (v1-7 8)
    (set! (-> this machines v1-7 state) (net-process-mgr-machine-state none))
    (set! (-> this machines v1-7 acct-id) 0)
    (set! (-> this machines v1-7 clan-id) 0)
    (set! (-> this machines v1-7 local-player-ct) 0)
    (set! (-> this machines v1-7 reported-ping) -1)
    )
  (clear! (-> this active-list))
  (dotimes (s5-0 10)
    (clear! (-> this owner-lists s5-0))
    )
  (dotimes (v1-18 1024)
    (set! (-> *net-process-table* v1-18) #f)
    )
  (let ((s5-1 (-> this machines (if *net-mgr*
                                    (-> *net-mgr* game-state local-machine-idx)
                                    0
                                    )
                  )
              )
        )
    (set! (-> s5-1 acct-id) (if (nonzero? (-> *net-mgr* lobby-state connect-handle))
                                (-> *net-mgr* lobby-state my-account-id)
                                0
                                )
          )
    (set! (-> s5-1 clan-id) (if (nonzero? (-> *net-mgr* lobby-state connect-handle))
                                (-> *medius-my-clan* medius-id)
                                0
                                )
          )
    (set! (-> s5-1 local-player-ct) (get-selected-local-player-count))
    )
  (update-tod this)
  0
  (none)
  )

(defbehavior net-process-mgr-default-handler net-process-mgr ((arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (case arg2
    (('go-die)
     (format 0 "net-process-mgr: received go-die~%")
     (go-virtual die)
     )
    (('session-master-change)
     (session-master-change self (the-as int (-> arg3 param 0)))
     )
    (('client-joined)
     (client-joined
       self
       (the-as int (-> arg3 param 0))
       (the-as int (-> arg3 param 1))
       (the-as int (-> arg3 param 2))
       (the-as int (-> arg3 param 3))
       )
     )
    (('client-left)
     (client-left self (the-as int (-> arg3 param 0)))
     )
    )
  )

(defstate startup (net-process-mgr)
  :virtual #t
  :code (behavior ()
    (set! (-> self snap-time-of-day) #t)
    (remove-from-process (-> *net-mgr* notify) self)
    (net-mgr-notify-connect self 12)
    (set! (-> self local-machine-idx) (if *net-mgr*
                                          (-> *net-mgr* game-state local-machine-idx)
                                          0
                                          )
          )
    (let ((gp-0 (new 'stack-no-clear 'array 'int32 1)))
      (set! (-> gp-0 0) (-> *net-mgr* game-state session-master-idx))
      (format 0 "setting initial SM=~D~%" (-> gp-0 0))
      (session-master-change self (-> gp-0 0))
      )
    (set! (-> self
              machines
              (if *net-mgr*
                  (-> *net-mgr* game-state local-machine-idx)
                  0
                  )
              state
              )
          (net-process-mgr-machine-state staging)
          )
    (format 0 "go staging~%")
    (go-virtual staging)
    )
  )

;; WARN: Return type mismatch int vs object.
(defbehavior go-running net-process-mgr ()
  (set! *should-update-stats* #f)
  (when (or (= (-> *net-mgr* game-type) 1) (= (-> *net-mgr* game-type) 3))
    (set! *should-update-stats* #t)
    (set! *stats-adjusted* #f)
    )
  (format 0 "marking staging players as running...~%")
  (dotimes (v1-9 8)
    (if (= (-> self machines v1-9 state) (net-process-mgr-machine-state staging))
        (set! (-> self machines v1-9 state) (net-process-mgr-machine-state running))
        )
    )
  (if (-> *net-world* is-late-join)
      (late-join-spawn-players)
      )
  (when (nonzero? (-> *net-mgr* lobby-state connect-handle))
    (dotimes (gp-0 8)
      (set! (-> self machines gp-0 overall-score) 0)
      (when (nonzero? (-> self machines gp-0 state))
        (let ((a0-7 (lookup *medius-player-cache* (-> self machines gp-0 acct-id) -1 #f #f)))
          (when a0-7
            (if (!= a0-7 'error)
                (set! (-> self machines gp-0 overall-score)
                      (the-as int (-> (the-as medius-cached-info-player a0-7) ladder-stats overall-score))
                      )
                )
            )
          )
        )
      )
    (set! (-> *net-process-mgr*
              machines
              (if *net-mgr*
                  (-> *net-mgr* game-state local-machine-idx)
                  0
                  )
              overall-score
              )
          (the-as int (-> *medius-my-player* ladder-stats overall-score))
          )
    )
  (go-virtual running)
  0
  )

(defstate staging (net-process-mgr)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('start-game)
       (format
         0
         "start-game!!! game-time=~D (real=~D)~%"
         (- (- (if *net-mgr*
                   (-> *net-mgr* game-state time)
                   0
                   )
               (if *net-world*
                   (-> *net-world* net-state game-start-time)
                   0
                   )
               )
            (if *net-world*
                (-> *net-world* net-state total-pause-time)
                0
                )
            )
         (-> *net-mgr* game-state time)
         )
       (set! (-> self snap-time-of-day) #t)
       (go-running)
       )
      (('go-recv-objects)
       (go-virtual recv-objects)
       )
      (else
        (net-process-mgr-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (set! (-> self last-allocated-local-id) -1)
    (set! (-> self last-allocated-global-id) -1)
    (if (and (= (if *net-mgr*
                    (-> *net-mgr* game-state local-machine-idx)
                    0
                    )
                (-> *net-mgr* game-state session-master-idx)
                )
             (not *net-world*)
             )
        (init-local-world)
        )
    )
  :trans (behavior ()
    (update-tod self)
    )
  :code sleep-code
  )

(defstate recv-objects (net-process-mgr)
  :virtual #t
  :event net-process-mgr-default-handler
  :trans (behavior ()
    (tweak-local-net-entities)
    (update-tod self)
    )
  :code sleep-code
  )

(defstate running (net-process-mgr)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('go-staging)
       (go-virtual staging)
       )
      (else
        (net-process-mgr-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (powerup-build-static-hash)
    (powerup-build-dynamic-hash)
    (net-colarb-clear)
    (spawn-game-mgr #f)
    )
  :trans (behavior ()
    (update-tod self)
    (powerup-build-dynamic-hash)
    (when (= (if *net-mgr*
                 (-> *net-mgr* game-state local-machine-idx)
                 0
                 )
             (-> *net-mgr* game-state session-master-idx)
             )
      (dotimes (gp-0 1)
        (send-pending-objects self)
        )
      )
    )
  :code sleep-code
  )

(defstate die (net-process-mgr)
  :virtual #t
  :code (behavior ()
    '()
    )
  )

(define *prev-time-of-day-time* 0)

;; WARN: Function (method 38 net-process-mgr) has a return type of none, but the expression builder found a return statement.
(defmethod update-tod ((this net-process-mgr))

      (return #f)
      )
  (let ((s5-0 (- (- (if *net-mgr*
                        (-> *net-mgr* game-state time)
                        0
                        )
                    (if *net-world*
                        (-> *net-world* net-state game-start-time)
                        0
                        )
                    )
                 (if *net-world*
                     (-> *net-world* net-state total-pause-time)
                     0
                     )
                 )
              )
        (s4-0 0)
        )
    (when (or (-> this snap-time-of-day) (!= (/ s5-0 9000) (/ *prev-time-of-day-time* 9000)))
      (cond
        ((!= (-> *net-world* net-state time-of-day) -1)
         (let ((v1-14 (-> *net-world* net-state time-of-day)))
           (set! s4-0 (* #x107ac0 v1-14))
           )
         )
        (else
          (let ((v1-16 (get-open-task-node-info)))
            (if v1-16
                (set! s4-0 (* #x107ac0 (-> v1-16 time-of-day)))
                )
            )
          )
        )
      (set! *prev-time-of-day-time* s5-0)
      (when (not *record-fma*)
        (send-event (ppointer->process *time-of-day*) 'change 'hours (* 0.0000009259259 (the float (+ s4-0 s5-0))))
        (send-event (ppointer->process *time-of-day*) 'change 'ratio 1.0)
        )
      (set! (-> this snap-time-of-day) #f)
      )
    )
  0
  (none)
  )


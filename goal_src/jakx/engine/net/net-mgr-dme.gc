(define *net-last-packet-recv-times* (new 'static 'array int32 8 0 0 0 0 0 0 0 0))

(defun net-packet-recv-time-reset-client ((arg0 int))
  (set! (-> *net-last-packet-recv-times* arg0) (-> *net-mgr* game-state time))
  0
  )

(defun net-packet-recv-time-reset-all ()
  (let ((v1-1 (-> *net-mgr* game-state time)))
    (dotimes (a0-0 8)
      (set! (-> *net-last-packet-recv-times* a0-0) v1-1)
      )
    )
  0
  )

(defun net-packet-recv-time-trouble ()
  (let ((v0-0 #f))
    (let ((v1-1 (-> *net-mgr* game-state time)))
      (dotimes (a0-0 8)
        (if (and (logtest? (-> *net-mgr* game-state connected-bitfield) (ash 1 a0-0))
                 (and (!= a0-0 (if *net-mgr*
                                   (-> *net-mgr* game-state local-machine-idx)
                                   0
                                   )
                          )
                      (< 3000 (- v1-1 (-> *net-last-packet-recv-times* a0-0)))
                      )
                 )
            (set! v0-0 #t)
            )
        )
      )
    v0-0
    )
  )


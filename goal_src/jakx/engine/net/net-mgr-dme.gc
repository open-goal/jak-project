  (format 0 "net-mgr-notify: ~A~%" 'session-master-change)
  (let ((a0-5 (-> *net-mgr* notify alive-list next0)))
    (-> *net-mgr* notify)
    (let ((s5-0 (-> a0-5 next0)))
      (while (!= a0-5 (-> *net-mgr* notify alive-list-end))
        (if (logtest? (the-as int (-> (the-as connection a0-5) param1)) 8)
            (send-event
              ((method-of-type connection get-process) (the-as connection a0-5))
              'session-master-change
              :from *net-mgr*
              (-> arg0 smclient-index)
              )
            )
        (set! a0-5 s5-0)
        (-> *net-mgr* notify)
        (set! s5-0 (-> s5-0 next0))

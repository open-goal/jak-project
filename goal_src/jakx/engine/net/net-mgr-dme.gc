  0
  )

(define *last-ping-latency* -1)

(define *last-ping-time* 0)

(define *avg-ping* -1)

(defun ping-report-msg-handler ((arg0 mem-buffer) (arg1 int))
  (when *net-process-mgr*
    (read-int8 arg0)
    (read-int8 arg0)
    (set! (-> *net-process-mgr* machines arg1 reported-ping) (read-int32 arg0))
    (set! *avg-ping* 0)
    (let ((v1-8 0))
      (dotimes (a0-6 8)
        (when (>= (-> *net-process-mgr* machines a0-6 reported-ping) 0)
          (set! *avg-ping* (+ *avg-ping* (-> *net-process-mgr* machines a0-6 reported-ping)))
          (+! v1-8 1)
          )
        )
      (if (> v1-8 0)
          (set! *avg-ping* (/ *avg-ping* v1-8))
          (set! *avg-ping* -1)
          )
      )
    )
  0
  )

(set! (-> *net-aux-msg-handlers* 10 handler-func) ping-report-msg-handler)

(defun cb-server-ping ((arg0 int) (arg1 int) (arg2 int))
  (if (zero? arg0)
      (set! *last-ping-latency* arg2)
      )
  0
  )

(defbehavior consider-server-ping net-mgr ()
  (when (and (and (-> self next-state) (= (-> self next-state name) 'playing-game))
             (nonzero? (-> self lobby-state connect-handle))
             )
    (let ((gp-0 (- (-> *display* real-clock frame-counter) (the-as time-frame *last-ping-time*))))
      (when (or (< gp-0 0) (< (seconds 15) gp-0))
        (set! *last-ping-time* (the-as int (-> *display* real-clock frame-counter)))
        (set! *scert-function-id* (scert-function net-ping-client))
        (knet-scert-function-3-args (-> self game-state connect-handle) #xffff cb-server-ping)
        (when (and (>= *last-ping-latency* 0)
                   (>= gp-0 0)
                   (-> *net-mgr* next-state)
                   (= (-> *net-mgr* next-state name) 'playing-game)
                   )
          (let ((gp-1 (alloc-msg-buffer)))
            (write-int8 gp-1 0)
            (write-int8 gp-1 0)
            (write-int8 gp-1 10)
            (write-int32 gp-1 *last-ping-latency*)
            (set! (-> (the-as (pointer int8) (-> gp-1 base)) 1) (+ (bytes-used gp-1) -1))
            (net-send-msg 0 gp-1 -1)
            (free-msg-buffer gp-1)
            )
          )
        )
      )
    )
  0
  )


  (update-lan-find *net-mgr*)
  0
  )

(defun dme-token-callback ((arg0 net-token-ownership-notify-data))
  (let ((s5-0 (-> arg0 token-id))
        (gp-0 (-> arg0 owner-client-index))
        )
    (format 0 "token ~D ownership changed to ~D~%" s5-0 gp-0)
    (when (zero? s5-0)
      (cond
        ((= gp-0 #xffff)
         )
        (else
          (format 0 "SM is now ~D~%" gp-0)
          (let ((v1-3 (new 'stack-no-clear 'net-smchange-data)))
            (set! (-> v1-3 smclient-index) gp-0)
            (session-master-change-callback (the-as net-smchange-data (&-> v1-3 connection-handle)))
            )
          )
        )

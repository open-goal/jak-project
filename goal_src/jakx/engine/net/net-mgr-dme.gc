(defun remote-client-event-callback ((arg0 net-remote-client-event-data))
  (let ((v1-0 (-> arg0 event-type)))
    (cond
      ((zero? v1-0)
       (format 0 "*** client join: ~D~%" (-> arg0 client-index))
       0
       )
      ((= v1-0 1)
       (format 0 "*** client leave: ~D~%" (-> arg0 client-index))
       0
       )
      )
    )
  )

;; WARN: Return type mismatch int vs object.
(defun init-complete-msg-handler ((arg0 mem-buffer) (arg1 int))
  (read-int8 arg0)
  (read-int8 arg0)
  (let ((s5-0 (read-int32 arg0))
        (s4-0 (read-int32 arg0))
        (s3-1 (read-int8 arg0))
        )
    (format 0 "---> got init-complete from ~D: acct=~D~%" arg1 s5-0)
    (logior! (-> *net-mgr* game-state connected-bitfield) (ash 1 arg1))
    (if *net-log-write*
        (net-log-client (net-log-event-type client-join) arg1)
        )
    (net-packet-recv-time-reset-client arg1)
    (when #f
      (when (-> *net-mgr* game-state locked)
        (kick-machines (ash 1 arg1) 'game-unavailable)
        (return (the-as object #f))
        )
      )
    (format 0 "net-mgr-notify: ~A~%" 'client-joined)
    (let ((a0-15 (-> *net-mgr* notify alive-list next0)))
      (-> *net-mgr* notify)
      (let ((s2-0 (-> a0-15 next0)))
        (while (!= a0-15 (-> *net-mgr* notify alive-list-end))
          (if (logtest? (the-as int (-> (the-as connection a0-15) param1)) 8)
              (send-event
                ((method-of-type connection get-process) (the-as connection a0-15))
                'client-joined
                :from *net-mgr*
                arg1
                s5-0
                s4-0
                s3-1
                )
              )
          (set! a0-15 s2-0)
          (-> *net-mgr* notify)
          (set! s2-0 (-> s2-0 next0))
          )
        )
      )
    )
  0
  )

(set! (-> *net-aux-msg-handlers* 0 handler-func) init-complete-msg-handler)

(defun chat-msg-handler ((arg0 mem-buffer) (arg1 int))
  (read-int8 arg0)
  (read-int8 arg0)
  (let ((gp-0 (new 'stack-no-clear 'medius-chat-fwd-message)))
    (mem-clear! (-> gp-0 message-id) 128)
    (let ((s3-1 (min 64 (strlen (-> arg0 ptr)))))
      (mem-copy! (-> gp-0 message) (-> arg0 ptr) s3-1)
      (set! (-> gp-0 message s3-1) (the-as uint 0))
      )
    0
    (let ((s4-2 (min 32 (strlen (the-as pointer (-> *net-player-names* (* arg1 2)))))))
      (mem-copy! (-> gp-0 originator-account-name) (the-as pointer (-> *net-player-names* (* arg1 2))) s4-2)
      (set! (-> gp-0 originator-account-name s4-2) (the-as uint 0))
      )
    0
    (set! (-> gp-0 message-type) 1)
    (handle-chat-msg (the-as medius-chat-fwd-message (-> gp-0 message-id)) #f)
    )
  0
  )

(set! (-> *net-aux-msg-handlers* 11 handler-func) chat-msg-handler)

(defun session-master-change-callback ((arg0 net-smchange-data))
  (format 0 "session-master-change-callback: ~D~%" (-> arg0 smclient-index))
  (if *net-log-write*
      (net-log-client (net-log-event-type session-master-change) (-> arg0 smclient-index))
      )

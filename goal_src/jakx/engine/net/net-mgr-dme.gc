(define *in-msg-callback* #f)

(define *cb-buf* (new 'static 'mem-buffer))

(defun do-net-app-msg-callback ((arg0 int) (arg1 int) (arg2 int) (arg3 (pointer uint8)))
  (with-pp
    (when *in-msg-callback*
      (format 0 "doh! net-app-msg-callback re-entered... we probably did a go!~%")
      0
      )
    (set! *in-msg-callback* #t)
    (let ((s4-0 (the-as int (-> arg3 0))))
      (let ((s5-0 pp))
        (set! pp *net-mgr*)
        (net-packet-recv-time-reset-client arg2)
        (set-buffer! *cb-buf* arg3 (the-as int (-> arg3 0)))
        (cond
          ((zero? (the-as uint s4-0))
           (set! s4-0 (the-as int (+ (-> arg3 1) 1)))
           (if *net-log-write*
               (net-log-msg arg3 s4-0 arg2 0 1)
               )
           (let ((s3-1 (&-> arg3 1)))
             (set-buffer! *cb-buf* s3-1 (the-as int (-> s3-1 0)))
             (let* ((a0-6 (-> s3-1 1))
                    (v1-13 (-> *net-aux-msg-handlers* a0-6))
                    )
               (if (nonzero? (-> v1-13 handler-func))
                   ((the-as (function mem-buffer int object) (-> v1-13 handler-func)) *cb-buf* arg2)
                   )
               )
             )
           )
          (else
            (case (read-uint8 *cb-buf*)
              ((255)
               (format 0 "processing jumbo msg~%")
               (set! s4-0 (read-int16 *cb-buf*))
               (if *net-log-write*
                   (net-log-msg arg3 s4-0 arg2 0 1)
                   )
               (set-buffer! *cb-buf* (&-> arg3 3) (+ s4-0 -3))
               (net-process-msg-handler *cb-buf* arg2)
               )
              (else
                (if *net-log-write*
                    (net-log-msg arg3 s4-0 arg2 0 1)
                    )
                (net-process-msg-handler *cb-buf* arg2)
                )
              )
            )
          )
        (set! pp s5-0)
        )
      (set! *in-msg-callback* #f)
      s4-0
      )
    )
  )

(defun net-app-msg-callback ((arg0 int) (arg1 int) (arg2 int) (arg3 (pointer uint8)))
  (do-net-app-msg-callback arg0 arg1 arg2 arg3)
  )

(defun lan-game-find-callback ((arg0 net-lanfind-callback-data-args))
  (format 0 "game-find callback~%")
  (when (< *net-available-game-ct* 16)
    (let ((s5-0 (&+ *net-available-games* (* 336 *net-available-game-ct*))))
      (mem-clear! s5-0 328)
      ((method-of-type net-available-game init-from-lanfind!) (the-as net-available-game s5-0) arg0)
      (if ((method-of-type net-available-game valid?) (the-as net-available-game s5-0))
          (set! *net-available-game-ct* (+ *net-available-game-ct* 1))
          )
      )
    )
  0
  )

(defmethod init-from-lanfind! ((this net-available-game) (arg0 net-lanfind-callback-data-args))
  (mem-copy!
    (the-as pointer (-> this connect-info address-list))
    (the-as pointer (-> arg0 peer-desc peer-address))
    24
    )
  (set! (-> this connect-info world-id) -1)
  (set! (-> this connect-info e-type) 2)
  (let ((s4-0 (new 'stack-no-clear 'mem-buffer)))
    ((method-of-type mem-buffer set-buffer!)
     (the-as mem-buffer (&-> s4-0 base))
     (the-as pointer (-> arg0 details p-data))
     (-> arg0 details n-size)
     )
    (decode-net-available-game-info (-> this info) (the-as mem-buffer (&-> s4-0 base)))
    )
  (format-game-name! this)
  0
  (none)
  )

(defmethod update-lan-find ((this net-mgr))
  (cond
    ((and (= (if *net-mgr*
                 (-> *net-mgr* game-state local-machine-idx)
                 0
                 )
             (-> *net-mgr* game-state session-master-idx)
             )
          (and (-> this next-state) (= (-> this next-state name) 'playing-game))
          (and (nonzero? (-> this game-state connect-handle))
               (not (logtest? (shl #x8000 16) (-> *medius-joined-game-info* generic-field1)))
               (zero? (-> this lobby-state connect-handle))
               )
          )
     (format 0 "ENABLING LAN FIND~%")
     (set! *scert-function-id* (scert-function net-lanfind-set-exchange-callback))
     (knet-scert-function-3-args 1 net-lanfind-exchange-callback #f)
     )
    (else
      (format 0 "DISABLING LAN FIND~%")
      (set! *scert-function-id* (scert-function net-lanfind-set-exchange-callback))
      (knet-scert-function-3-args 0 0 #f)
      )
    )
  0
  (none)
  )

(defun net-sys-msg-callback ((arg0 net-type-system-message-data))
  (format 0 "SYSMSG!!~%")
  (inspect arg0)
  (format 0 "~G~%" (-> arg0 p-message))
  (handle-sys-msg arg0)
  0
  )

(defbehavior kick-machines net-mgr ((arg0 int) (arg1 symbol))
  (format 0 "   kicking: ~A~%" arg1)
  (let ((gp-0 self))
    (set! self *net-mgr*)
    (let ((s5-0 (alloc-msg-buffer)))
      (write-int8 s5-0 0)
      (write-int8 s5-0 0)
      (write-int8 s5-0 5)
      (write-symbol s5-0 arg1)
      (set! (-> (the-as (pointer int8) (-> s5-0 base)) 1) (+ (bytes-used s5-0) -1))
      (net-send-msg 192 s5-0 arg0)
      (free-msg-buffer s5-0)
      )
    (set! self gp-0)
    )
  0
  )

(defun write-init-complete-msg ((arg0 mem-buffer))
  (cond
    ((nonzero? (-> *net-mgr* lobby-state connect-handle))
     (write-int32 arg0 (-> *net-mgr* lobby-state my-account-id))
     (write-int32 arg0 (-> *medius-my-clan* medius-id))
     (write-int8 arg0 (get-selected-local-player-count))
     )
    (else
      (write-int32 arg0 0)
      (write-int32 arg0 0)
      (write-int8 arg0 (get-selected-local-player-count))
      )
    )
  (none)
  )

;; WARN: Return type mismatch int vs object.
(defun handle-machine-connect ((arg0 int))
  (format 0 "handle-machine-connect [~D]~%" arg0)
  (when (-> *net-mgr* game-state locked)
    (kick-machines (ash 1 arg0) 'game-unavailable)
    (return (the-as object #f))
    )
  (when (and *net-mgr* (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'playing-game))
    (let ((s5-0 (alloc-msg-buffer)))
      (write-int8 s5-0 0)
      (write-int8 s5-0 0)
      (write-int8 s5-0 0)
      (write-init-complete-msg s5-0)
      (set! (-> (the-as (pointer int8) (-> s5-0 base)) 1) (+ (bytes-used s5-0) -1))
      (net-send-msg 192 s5-0 (ash 1 arg0))
      (free-msg-buffer s5-0)
      )
    )
  0
  )

(defun handle-machine-disconnect ((arg0 int))
  (let* ((a0-1 (* arg0 2))
         (v1-1 (-> *net-player-names* a0-1))
         )
    (when (nonzero? (-> v1-1 name 0))
      (when (and *net-world* (logtest? (-> *net-world* net-state flags) 1))
        (expand-text-to-charp! *common-text* (-> *chat-msg-string2* data) (-> v1-1 name))
        (format (clear *chat-msg-string*) (lookup-text! *common-text* (text-id text-id-3161) #f) *chat-msg-string2*)
        (add-raw-popup-msg (-> *chat-msg-string* data) -1 #f)
        )
      )
    )
  (format 0 "handle-machine-disconnect [~D]~%" arg0)
  (logand!
    (-> *net-mgr* game-state connected-bitfield)
    (logxor (the-as uint #xffffffff) (the-as uint (ash 1 arg0)))
    )
  (if *net-log-write*
      (net-log-client (net-log-event-type client-leave) arg0)
      )
  (format 0 "net-mgr-notify: ~A~%" 'client-left)
  (let ((a0-21 (-> *net-mgr* notify alive-list next0)))
    (-> *net-mgr* notify)
    (let ((s5-1 (-> a0-21 next0)))
      (while (!= a0-21 (-> *net-mgr* notify alive-list-end))
        (if (logtest? (the-as int (-> (the-as connection a0-21) param1)) 8)
            (send-event
              ((method-of-type connection get-process) (the-as connection a0-21))
              'client-left
              :from *net-mgr*
              arg0
              )
            )
        (set! a0-21 s5-1)
        (-> *net-mgr* notify)
        (set! s5-1 (-> s5-1 next0))
        )
      )
    )
  (when (and *net-mgr*
             (and *lobby-menu-manager*
                  (not (and (-> *lobby-menu-manager* next-state) (= (-> *lobby-menu-manager* next-state name) 'die)))
                  )
             )
    (when (= arg0 (-> *net-mgr* game-state session-master-idx))
      (let ((gp-1 #t))
        (when (and *net-world* (-> *net-world* is-late-join))
          (dotimes (s5-2 16)
            (if (and (!= (/ s5-2 2) (if *net-mgr*
                                        (-> *net-mgr* game-state local-machine-idx)
                                        0
                                        )
                         )
                     ((method-of-object *net-world* net-world-method-64))
                     )
                (set! gp-1 #f)
                )
            )
          )
        (when gp-1
          (format 0 "we're in the lobby and the session-master just left - quitting out~%")
          (if (not (-> *net-mgr* game-state kicked))
              (set! (-> *net-mgr* game-state kicked) 'game-disbanded)
              )
          )
        )
      )
    )
  0
  )

(defun remote-client-connect-callback ((arg0 net-type-client-connect-callback-data))
  (format 0 "remote-client-connect: ~D~%" (-> arg0 client-index))
  (handle-machine-connect (-> arg0 client-index))
  )

(defun remote-client-disconnect-callback ((arg0 net-type-client-connect-callback-data))
  (format 0 "remote-client-disconnect: ~D~%" (-> arg0 client-index))

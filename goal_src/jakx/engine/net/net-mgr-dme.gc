(define *lanfind-scratch-buf* (new 'static 'mem-buffer))

;; WARN: Return type mismatch int vs object.
(defun net-lanfind-exchange-callback ((arg0 net-lanfind-exchange-callback-in-args) (arg1 net-lanfind-exchange-callback-out-args))
  (format 0 "net-game-find-exchange-callback~%")
  (set! *scert-function-id* (scert-function get-application-id))
  (when (!= (-> arg0 peer-desc application-id) (knet-scert-function-0-args))
    (set! (-> arg1 b-respond-to-sender) 0)
    (return (the-as object #f))
    )
  (when (-> *net-mgr* game-state locked)
    (set! (-> arg1 b-respond-to-sender) 0)
    (return (the-as object #f))
    )
  (if (not *net-mgr*)
      (return (the-as object 0))
      )
  (if (!= (-> *net-mgr* game-type) 2)
      (return (the-as object 0))
      )
  (if (not *net-world*)
      (return (the-as object 0))
      )
  (init-from-local-game! *net-active-game*)
  (set-buffer! *lanfind-scratch-buf* *lanfind-scratch* 256)
  (encode-net-available-game-info (-> *net-active-game* info) *lanfind-scratch-buf*)
  (format 0 "size of user data is : ~D~%" (bytes-used *lanfind-scratch-buf*))
  (set! (-> arg1 b-respond-to-sender) 1)
  (set! (-> arg1 details n-size) (bytes-used *lanfind-scratch-buf*))
  (set! (-> arg1 details p-data) (the-as basic (-> *lanfind-scratch-buf* base)))
  0
  )

(defmethod init-from-local-game! ((this net-available-game))
  (mem-clear! (the-as pointer this) 328)
  (let ((s5-0 (-> this info)))
    (copy-charp<-charp (-> s5-0 game-name) (-> (get-player-name 0) data))
    (set! (-> s5-0 player-count) (the-as uint (get-total-humans)))
    (when *net-world*
      (set! (-> s5-0 task-node) (-> *net-world* task-node))
      (let ((v1-8 (-> *game-info* sub-task-list (-> *net-world* task-node))))
        (set! (-> s5-0 location) (the-as uint (-> *game-info* play-list (-> v1-8 task) task-level)))
        (set! (-> s5-0 event) (the-as uint (-> v1-8 net-play-mode)))
        )
      )
    (set! (-> s5-0 min-players) (the-as uint 1))
    (set! (-> s5-0 max-players) (the-as uint *last-selected-human-ct*))
    (set! (-> s5-0 in-staging) (= *medius-world-status* 1))
    (set! (-> s5-0 generic-1) 15)
    (set! (-> s5-0 skill-level) (get-total-skill-level))
    (set! (-> s5-0 avg-ping) *avg-ping*)
    )
  (format-game-name! this)
  0
  (none)
  )

(defun kick-msg-handler ((arg0 mem-buffer) (arg1 int))
  (when *net-mgr*
    (read-int8 arg0)
    (read-int8 arg0)
    (set! (-> *net-mgr* game-state kicked) (read-symbol arg0))
    (format 0 "received kick msg: ~A~%" (-> *net-mgr* game-state kicked))
    )
  0
  )

(set! (-> *net-aux-msg-handlers* 5 handler-func) kick-msg-handler)


(defmethod init-dme ((this net-mgr))
  (format 0 "init-dme~%")
  (mem-clear! (the-as pointer *dme-init-in*) 120)
  (mem-clear! (the-as pointer *dme-init-out*) 24)
  (set! *scert-function-id* (scert-function net-initialize-in-params-defaults))
  (knet-scert-function-1-args *dme-init-in*)
  (set! *scert-function-id* (scert-function get-application-id))
  (set! (-> *dme-init-in* application-id) (knet-scert-function-0-args))
  (copy-charp<-charp (-> *dme-init-in* application-name) (-> *net-app-name* data))
  (when (not *net-keypair-valid*)
    (set! *scert-function-id* (scert-function get-app-rsa-keypair))
    (knet-scert-function-2-args (-> *net-app-rsa-keypair* public-key) (-> *net-app-rsa-keypair* private-key))
    (format 0 "generate RSA keypair~%")
    (set! *scert-function-id* (scert-function generate-rsa-keypair))
    (knet-scert-function-2-args (-> *net-local-rsa-keypair* public-key) (-> *net-local-rsa-keypair* private-key))
    (set! *net-keypair-valid* #t)
    )
  (set! (-> *dme-init-in* p-application-key-pair) *net-app-rsa-keypair*)
  (set! (-> *dme-init-in* p-local-key-pair) *net-local-rsa-keypair*)
  (set! (-> *dme-init-in* pf-system-message-callback) net-sys-msg-callback)
  (set! (-> *dme-init-in* connectivity-type) 2)
  (set! (-> *dme-init-in* b-enable-lanbroadcast-comms) 1)
  (format 0 "calling net-initialize...~%")
  (set! *scert-function-id* (scert-function net-initialize))
  (set! *net-error* (knet-scert-function-2-args *dme-init-in* *dme-init-out*))
  (when (nonzero? *net-error*)
    (format 0 "net-initialize returned ~D~%" *net-error*)
    (return #f)
    )
  (format 0 "done net-initialize...~%")
  (set! *dme-initted* #t)
  (set! *scert-function-id* (scert-function net-register-message-callback))
  (knet-scert-function-2-args (&-> '*net-app-msg-id* value) net-app-msg-callback)
  (set! *scert-function-id* (scert-function net-register-message-callback))
  (knet-scert-function-2-args (&-> '*aux-voice-msg-id* value) aux-voice-msg-callback)
  (net-log-remove-lock)
  #t
  )

(define *headset-buffers-received* 0)

(define *headset-buffers-played* 0)

(define *headset-buffers-decoded* 0)

(define *iop-mem-stats* (new 'global 'mc-slot-info))

(define *real-sm* 0)

(define bw-metrics (new 'static 'net-bandwidth-info))

(defmethod update ((this net-mgr))
  (with-pp
    (consider-server-ping)
    (when *debug-segment*
      'net-mgr-tick
      (let ((s5-0 (-> *display* frames (-> *display* on-screen) profile-array data 0))
            (v1-8 'net-mgr-tick)
            (s4-0 (the-as uint #x8030ffff))
            )
        (when (and *dproc* *debug-segment*)
          (let ((s3-0 (-> s5-0 data (-> s5-0 count))))
            (let ((s2-0 (-> s5-0 base-time)))
              (set! (-> s3-0 name) v1-8)
              (set! (-> s3-0 start-time) (the-as int (- (timer-count (the-as timer-bank #x10000800)) (the-as uint s2-0))))
              )
            (set! (-> s3-0 depth) (the-as uint (-> s5-0 depth)))
            (set! (-> s3-0 color) (the-as rgba s4-0))
            (set! (-> s5-0 segment (-> s5-0 depth)) s3-0)
            )
          (set! (-> s5-0 count) (min 2099 (+ (-> s5-0 count) 1)))
          (+! (-> s5-0 depth) 1)
          (set! (-> s5-0 max-depth) (max (-> s5-0 max-depth) (-> s5-0 depth)))
          )
        )
      0
      )
    (knet-yield 1)
    (pause-check)
    (cond
      ((and (-> this next-state) (= (-> this next-state name) 'playing-sp-game))
       (set! (-> this game-state time) (the-as int (-> *display* entity-clock frame-counter)))
       )
      (else
        (set! *scert-function-id* (scert-function net-get-time))
        (knet-scert-function-2-args (-> this game-state connect-handle) (&-> this game-state time))
        (set! (-> this game-state time) (/ (* 3 (-> this game-state time)) 10))
        )
      )
    (let ((s5-1 *fake-msg-count*))
      0
      (dotimes (s4-1 s5-1)
        (let ((v1-35 (logand (+ *fake-msg-read* s4-1) 31))
              (s3-1 pp)
              )
          (set! pp *net-mgr*)
          (net-app-msg-callback 0 0 (-> *net-mgr* game-state local-machine-idx) (-> *fake-msgs* v1-35 data))
          (set! pp s3-1)
          )
        )
      (set! *fake-msg-read* (logand (+ *fake-msg-read* s5-1) 31))
      (set! *fake-msg-count* (- *fake-msg-count* s5-1))
      )
    (when (-> this scert-initted)
      (set! *scert-function-id* (scert-function net-update))
      (let ((s5-2 (knet-scert-function-0-args)))
        (when (nonzero? s5-2)
          (format 0 "net-update returned ~D~%" s5-2)
          (when (= s5-2 12)
            (format 0 "ignoring...~%")
            (set! s5-2 0)
            )
          (set! *net-error* s5-2)
          (set! (-> this lobby-state last-dme-error) s5-2)
          )
        )
      )
    (set! *real-sm* -1)
    (when (-> this scert-initted)
      (let ((s5-3 (new 'stack-no-clear 'array 'int32 4)))
        (set! *scert-function-id* (scert-function net-tokens-ready))
        (set! (-> s5-3 2) (knet-scert-function-2-args (-> this game-state connect-handle) (&-> s5-3 0)))
        (when (and (zero? (-> s5-3 2)) (nonzero? (-> s5-3 0)))
          (set! *scert-function-id* (scert-function net-get-token-owner))
          (set! (-> s5-3 2) (knet-scert-function-3-args (-> this game-state connect-handle) 0 (&-> s5-3 1)))
          (when (zero? (-> s5-3 2))
            (set! *real-sm* (-> s5-3 1))
            (when (= (-> s5-3 1) #xffff)
              (when (-> this game-state sm-eligible)
                (set! *scert-function-id* (scert-function net-request-token))
                (knet-scert-function-2-args (-> this game-state connect-handle) 0)
                )
              )
            )
          )
        )
      )
    (when *debug-segment*
      (let ((gp-1 (-> *display* frames (-> *display* on-screen) profile-array data 0)))
        (when (and *dproc* *debug-segment*)
          (let* ((v1-83 (+ (-> gp-1 depth) -1))
                 (s5-4 (-> gp-1 segment v1-83))
                 (s4-2 (-> gp-1 base-time))
                 )
            (when (>= v1-83 0)
              (set! (-> s5-4 end-time) (the-as int (- (timer-count (the-as timer-bank #x10000800)) (the-as uint s4-2))))
              (+! (-> gp-1 depth) -1)
              )
            )
          )
        )
      0
      )
    0
    (none)
    )
  )

(defstate refreshing-lan-games (net-mgr)
  :virtual #t
  :code (behavior ()
    (refresh-lan-games)
    (format 0 "net-mgr-notify: ~A~%" 'game-list-ready)
    (let ((a0-1 (-> *net-mgr* notify alive-list next0)))
      (-> *net-mgr* notify)
      (let ((gp-0 (-> a0-1 next0)))
        (while (!= a0-1 (-> *net-mgr* notify alive-list-end))
          (if (logtest? (the-as int (-> (the-as connection a0-1) param1)) 2)
              (send-event
                ((method-of-type connection get-process) (the-as connection a0-1))
                'game-list-ready
                :from *net-mgr*
                )
              )
          (set! a0-1 gp-0)
          (-> *net-mgr* notify)
          (set! gp-0 (-> gp-0 next0))
          )
        )
      )
    (go-virtual idle)
    )
  )

(define *tmp-addr* (new 'static 'net-address))

(define *tmp-game* (new 'static 'net-available-game))

(define *lan-game-verified* #f)

(defun memeq ((arg0 pointer) (arg1 pointer) (arg2 int))
  (dotimes (v1-0 arg2)
    (if (!= (-> (the-as (pointer int8) arg0)) (-> (the-as (pointer int8) arg1)))
        (return #f)
        )
    (&+! arg0 1)
    (&+! arg1 1)
    )
  #t
  )

(defun lan-game-verify-callback ((arg0 net-lanfind-callback-data-args))
  (when (memeq (the-as pointer (-> arg0 peer-desc peer-address)) (the-as pointer *tmp-addr*) 24)
    (mem-clear! (the-as pointer *tmp-game*) 328)
    (init-from-lanfind! *tmp-game* arg0)
    (if (-> *tmp-game* info in-staging)
        (set! *lan-game-verified* #t)
        )
    )
  0
  )

(defstate verifying-lan-game (net-mgr)
  :virtual #t
  :code (behavior ((arg0 net-connection-info))
    (go-virtual connecting-to-game arg0)
    (format 0 "verifying game...~%")
    (set! *lan-game-verified* #f)
    (mem-copy! (the-as pointer *tmp-addr*) (the-as pointer (-> arg0 address-list)) 24)
    (set! *scert-function-id* (scert-function net-lanfind-in-params-defaults))
    (knet-scert-function-1-args *net-lan-find-in-params*)
    (set! (-> *net-lan-find-in-params* pfn-lanfind-callback) lan-game-verify-callback)
    (set! *scert-function-id* (scert-function net-lanfind))
    (knet-scert-function-1-args *net-lan-find-in-params*)
    (dotimes (s5-0 60)
      (set! *scert-function-id* (scert-function net-update))
      (knet-scert-function-0-args)
      (when *lan-game-verified*
        (format 0 "game verified ok~%")
        (go-virtual connecting-to-game arg0)
        )
      (suspend)
      )
    (game-connect-failed)
    )
  )

(define *net-msg-pending* #f)

(defun send-fake-msg ((arg0 int) (arg1 mem-buffer))
  (cond
    ((>= *fake-msg-count* 32)
     (format 0 "<WARNING!!!> DROPPING MESSAGE TO SELF!!!!~%")
     )
    (else
      (mem-copy!
        (the-as pointer (-> *fake-msgs* (logand (+ *fake-msg-read* *fake-msg-count*) 31)))
        (-> arg1 base)
        (bytes-used arg1)
        )
      (set! *fake-msg-count* (+ *fake-msg-count* 1))
      )
    )
  0
  )

(defun verify-msg ((arg0 mem-buffer))
  (let ((s5-0 (-> (the-as (pointer uint8) (-> arg0 base)) 0))
        (v1-2 (bytes-used arg0))
        )
    (cond
      ((zero? s5-0)
       (let ((a0-3 (-> (the-as (pointer uint8) (-> arg0 base)) 1)))
         (-> (the-as (pointer uint8) (-> arg0 base)) 2)
         (when (!= (+ a0-3 1) v1-2)
           (break!)
           0
           )
         )
       )
      ((= s5-0 255)
       (when (!= (+ (-> (the-as (pointer uint8) (-> arg0 base)) 1) (* (-> (the-as (pointer uint8) (-> arg0 base)) 2) 256))
                 v1-2
                 )
         (break!)
         0
         )
       )
      (else
        (when (!= s5-0 v1-2)
          (break!)
          0
          )
        )
      )
    )
  0
  )

;; WARN: Return type mismatch int vs object.
(defun net-send-msg ((arg0 int) (arg1 mem-buffer) (arg2 int))
  (when (not (and *net-mgr*
                  (-> *net-mgr* next-state)
                  (let ((v1-6 (-> *net-mgr* next-state name)))
                    (or (= v1-6 'playing-game) (= v1-6 'playing-sp-game) (= v1-6 'joining-game) (= v1-6 'leaving-game))
                    )
                  )
             )
    (format 0 ">>>> not sending msg due to wrong state~%")
    (return (the-as object #f))
    )
  (if *net-log-write*
      (net-log-msg
        (-> arg1 base)
        (bytes-used arg1)
        (if *net-mgr*
            (-> *net-mgr* game-state local-machine-idx)
            0
            )
        arg2
        arg0
        )
      )
  (verify-msg arg1)
  (let ((s5-1 (new 'stack-no-clear 'net-send-message-params)))
    (set! (-> s5-1 in connection-handle) (-> *net-mgr* game-state connect-handle))
    (set! (-> s5-1 in transport-flags) arg0)
    (set! (-> s5-1 in message-type) *net-app-msg-id*)
    (set! (-> s5-1 in message-length) (bytes-used arg1))
    (set! (-> s5-1 in message-data) (the-as uint (-> arg1 base)))
    (case arg2
      ((-1)
       (send-fake-msg arg0 arg1)
       (set! (-> s5-1 in dest-client target-client) -1)
       )
      ((-2)
       (set! (-> s5-1 in dest-client target-client) -1)
       )
      (else
        (when (logtest? (ash 1 (if *net-mgr*
                                   (-> *net-mgr* game-state local-machine-idx)
                                   0
                                   )
                             )
                        arg2
                        )
          (send-fake-msg arg0 arg1)
          (set! arg2 (logclear arg2 (ash 1 (if *net-mgr*
                                               (-> *net-mgr* game-state local-machine-idx)
                                               0
                                               )
                                         )
                               )
                )
          )
        (set! (-> s5-1 in dest-client target-client) 256)
        (set! (-> s5-1 in dest-client client-mask base-id) 0)
        (set! (-> s5-1 in dest-client client-mask bitmask 0) (the-as uint arg2))
        (dotimes (v1-33 8)
          (if (logtest? arg2 (ash 1 v1-33))
              (set! (-> s5-1 in dest-client client-mask max-id) v1-33)

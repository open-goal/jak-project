;;-*-Lisp-*-
(in-package goal)

;; name: scert-7-h.gc
;; name in dgo: scert-7-h
;; dgos: ENGINE, GAME

;; +++medius-clan-challenge-status
(defenum medius-clan-challenge-status
  :type int32
  (clan-challenge-request 0)
  (clan-challenge-accepted 1)
  (clan-challenge-revoked 2)
  (clan-challenge-refused 3)
  (clan-challenge-confirmed 4)
  (extra-medius-clan-challenge-status #xffffff)
  )
;; ---medius-clan-challenge-status

;; +++medius-comparison-operator
(defenum medius-comparison-operator
  :type int32
  (less-than 0)
  (less-than-or-equal-to 1)
  (equal-to 2)
  (greater-than-or-equal-to 3)
  (greater-than 4)
  (not-equals 5)
  (extra-medius-comparison-operator #xffffff)
  )
;; ---medius-comparison-operator

;; +++medius-ladder-type
(defenum medius-ladder-type
  :type int32
  (medius-ladder-type-player 0)
  (medius-ladder-type-clan 1)
  (extra-medius-ladder-type #xffffff)
  )
;; ---medius-ladder-type

;; +++medius-policy-type
(defenum medius-policy-type
  :type int32
  (usage 0)
  (privacy 1)
  (extra-medius-policy-type #xffffff)
  )
;; ---medius-policy-type

;; +++sce-territory-type
(defenum sce-territory-type
  :type int32
  (scea 0)
  (scee 1)
  (scei 2)
  (scea-thirdparty 3)
  (scee-thirdparty 4)
  (scei-thirdparty 5)
  (extra-sceterritory-type #xffffff)
  )
;; ---sce-territory-type

;; DECOMP BEGINS

(deftype medius-get-clan-member-list-request (structure)
  ((message-id   uint8  21)
   (session-key  uint8  17)
   (clan-id      int32)
   )
  )


(deftype medius-get-clan-member-list-response (structure)
  ((message-id    uint8  21)
   (account-id    int32)
   (account-name  uint8  32)
   (status-code   medius-status-code)
   (end-of-list   int8)
   )
  )


(deftype medius-get-clan-team-challenge-history-request (structure)
  ((message-id               uint8  21)
   (session-key              uint8  17)
   (clan-id                  int32)
   (this-clan-is-challenger  int32)
   (start                    int32)
   (page-size                int32)
   )
  )


(deftype medius-get-clan-team-challenge-history-response (structure)
  ((message-id       uint8  21)
   (status-code      medius-status-code)
   (against-clan-id  int32)
   (status           medius-clan-challenge-status)
   (end-of-list      int8)
   )
  )


(deftype medius-get-clan-team-challenges-request (structure)
  ((message-id       uint8  21)
   (session-key      uint8  17)
   (clan-id          int32)
   (start            int32)
   (page-size        int32)
   (status           medius-clan-challenge-status)
   (challenged-only  int32)
   )
  )


(deftype medius-get-clan-team-challenges-response (structure)
  ((message-id          uint8  21)
   (status-code         medius-status-code)
   (challenger-clan-id  int32)
   (against-clan-id     int32)
   (status              medius-clan-challenge-status)
   (response-time       int32)
   (challenge-msg       uint8  200)
   (response-msg        uint8  200)
   (end-of-list         int8)
   (clan-challenge-id   int32)
   )
  )


(deftype medius-get-game-list-filter-request (structure)
  ((message-id   uint8  21)
   (session-key  uint8  17)
   )
  )


(deftype medius-get-game-list-filter-response (structure)
  ((message-id           uint8  21)
   (status-code          medius-status-code)
   (filter-field         medius-game-list-filter-field)
   (comparison-operator  medius-comparison-operator)
   (baseline-value       int32)
   (end-of-list          int8)
   )
  )



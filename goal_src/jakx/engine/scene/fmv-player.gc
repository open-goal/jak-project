(defun movie-texture-anim-init ((arg0 texture-anim))
  (texture-anim-override-size-init arg0)
  (set! (-> *fmv-work* dma-addr) (the-as uint 0))
  0
  (none)
  )

;; WARN: Return type mismatch object vs none.
(defun movie-texture-anim-func ((arg0 fmv-buffer) (arg1 texture-anim-array))
  (let ((v1-1 (-> *fmv-work* dma-addr)))
    (cond
      ((nonzero? v1-1)
       (when (= arg1 *movie-texture-anim-array*)
         (set! (-> arg1 length) 0)
         0
         )
       (let ((a1-2 (the-as dma-packet (-> arg0 start-u))))
         (set! (-> a1-2 dma) (new 'static 'dma-tag :id (dma-tag-id call) :addr v1-1))
         (set! (-> a1-2 vif0) (new 'static 'vif-tag))
         (set! (-> a1-2 vif1) (new 'static 'vif-tag))
         (set! (-> arg0 start) (the-as int (&+ a1-2 16)))
         )
       )
      (else
        (if (= arg1 *movie-texture-anim-array*)
            (set! (-> arg1 length) 2)
            )
        )
      )
    )
  (none)
  )

(defun fmv-file-init ((arg0 string))
  (if (zero? arg0)
      (set! (-> *fmv-work* finished) #f)
      )
  (when (nonzero? arg0)
    (set! (-> *fmv-work* own-rpc) #f)
    (set! (-> *fmv-work* cursor) (the-as uint 0))
    (set! (-> *fmv-work* current-buffer) (the-as uint 0))
    (set! (-> *fmv-work* buffers 0 start) -1)
    (set! (-> *fmv-work* buffers 1 start) -1)
    )
  (none)
  )

(defun fmv-get-time ()
  (cond
    ((and *fmv-player* (nonzero? (-> *fmv-player* gui-id)))
     (dotimes (v1-3 4)
       (when (= (-> *fmv-player* gui-id) (-> *sound-iop-info* stream-id v1-3))
         (cond
           ((logtest? (-> *sound-iop-info* stream-status v1-3) (stream-status ss6))
            (return -2)
            )
           ((logtest? (-> *sound-iop-info* stream-status v1-3) (stream-status ss9))
            (return -2)
            )
           ((logtest? (-> *sound-iop-info* stream-status v1-3) (stream-status ss1))
            (return (the-as int (-> *sound-iop-info* stream-position v1-3)))
            )
           (else
             (return 0)
             )
           )
         (set! v1-3 (the-as int 0))
         )
       )
     -1
     (return -2)
     )
    (else
      (return 0)
      )
    )
  (the-as int 0)
  )

;; og:preserve-this just defer to ultimate-memcpy on pc
(defun fmv-memcpy ((arg0 pointer) (arg1 pointer) (arg2 uint))
 ;; src/dest are swapped in this one for whatever reason
 (ultimate-memcpy arg1 arg0 (logand (+ arg2 15) -16))
 0
 )

(defun fmv-file-read ((arg0 pointer) (arg1 int) (arg2 int) (arg3 int))
  (local-vars (v0-1 int))
  (let ((gp-0 (-> *fmv-work* buffers (-> *fmv-work* current-buffer)))
        (s4-0 (-> *fmv-work* buffers (- 1 (the-as int (-> *fmv-work* current-buffer)))))
        (s5-0 0)
        )
    (when (!= (-> s4-0 start) -1)
      (when (= (-> *fmv-work* cursor) 8)
        (set! (-> *fmv-work* data-size) (the-as uint (+ (-> (the-as (pointer int32) (-> s4-0 buff)) 1) 8)))
        (set! (-> *fmv-work* num-frames) (the-as uint (-> (the-as (pointer int32) (-> s4-0 buff)) 3)))
        (set! (-> *fmv-work* copied-size) (the-as uint 0))
        0
        )
      (cond
        ((not (-> *fmv-work* finished))
         (set! s5-0 (min arg1 (the-as int (- (-> *fmv-work* buffer-size) (the-as uint (-> s4-0 start))))))
         (+! (-> *fmv-work* copied-size) s5-0)
         (fmv-memcpy arg0 (the-as pointer (+ (-> s4-0 buff) (-> s4-0 start))) (the-as uint s5-0))
         (+! (-> s4-0 start) s5-0)
         (if (= (-> s4-0 start) (-> *fmv-work* buffer-size))
             (set! (-> s4-0 start) -1)
             )
         )
        (else
          (return arg1)
          )
        )
      )
    (cond
      ((not (-> *fmv-work* own-rpc))
       (if (and (= (-> s4-0 start) -1) (zero? (-> gp-0 start)))
           (set! (-> *fmv-work* current-buffer) (- 1 (the-as int (-> *fmv-work* current-buffer))))
           )
       (when (= (-> gp-0 start) -1)
         (when (str-load
                 (-> *fmv-work* name)
                 (the-as int (+ #x40000000 (-> *fmv-work* cursor)))
                 (the-as pointer (-> gp-0 buff))
                 (the-as int (-> *fmv-work* buffer-size))
                 )
           (set! (-> gp-0 start) 0)
           (set! (-> *fmv-work* own-rpc) #t)
           (+! (-> *fmv-work* cursor) (shr (-> *fmv-work* buffer-size) 15))
           )
         )
       )
      (else
        (case (str-load-status (&-> *fmv-work* len-read))
          (('busy)
           )
          (else
            (set! (-> *fmv-work* own-rpc) #f)
            (str-load-cancel)
            )
          )
        )
      )
    (return s5-0)
    )
  v0-1
  )

(defmethod init! ((this fmv-player-params) (arg0 m2v-info))
  (cond
    ((demo?)
     (let ((v1-0 (scf-get-territory)))
       (set! (-> this display-mode display-mode) (if (= v1-0 1)
                                                     0
                                                     1
                                                     )
             )
       )
     )
    (else
      (set! (-> this display-mode display-mode) (cond
                                                  ((= (-> *setting-control* user-current smode2) #t)
                                                   2
                                                   )
                                                  ((= (-> *setting-control* user-current video-mode) 'pal)
                                                   (if (logtest? (-> arg0 flags) 2)
                                                       3
                                                       0
                                                       )
                                                   )
                                                  (else
                                                    1
                                                    )
                                                  )
            )
      )
    )
  (set! (-> this display-mode frame-base-pointer) (the-as uint 167))
  (set! (-> this display-mode texture-base-page) (the-as uint 0))
  (set! (-> this display-mode texture-width) (the-as uint 10))
  (set! (-> this display-mode display-width) (the-as uint 640))
  (set! (-> this display-mode display-height) (the-as uint (* (-> *video-params* display-sy) 2)))
  (set! (-> this display-mode display-dx) (-> *video-params* display-dx))
  (set! (-> this display-mode display-dy) (-> *video-params* display-dy))
  (set! (-> this display-mode contrast) (-> *setting-control* user-default contrast))
  (set! (-> this display-mode brightness) (-> *setting-control* user-default brightness))
  (set! (-> this display-mode fast-z-clear) 0)
  (set! (-> this display-mode frame-buffer-mask) (the-as uint (shl #xff00 16)))
  (set! (-> this file-init) fmv-file-init)
  (set! (-> this file-read) fmv-file-read)
  (set! (-> this get-time) fmv-get-time)
  (set! (-> this video-type) 2)
  (set! (-> this zoom-mode)
        (cond
          ((= (-> *setting-control* user-default aspect-ratio) 'aspect16x9)
           (if (and (= (-> *setting-control* user-current video-mode) 'pal) (logtest? (-> arg0 flags) 2))
               5
               0
               )
           )
          ((and (= (-> *setting-control* user-current video-mode) 'pal) (logtest? (-> arg0 flags) 2))
           9
           )
          (else
            4
            )
          )
        )
  (if (and (logtest? (-> *game-info* secrets) (game-secrets hflip-screen))
           (and (not (logtest? (-> arg0 flags) 8)) (!= (-> *fmv-player* fmv-mode) 2))
           )
      (+! (-> this zoom-mode) 10)
      )
  (set! (-> this upper-field-first) 0)
  (set! (-> this buffer-mode) 1)
  0
  (none)
  )

(defbehavior fmv-fade-out fmv-player ()
  (when (not (-> *setting-control* user-current render))
    (set-setting! 'bg-a 'abs 1.0 0)
    (apply-settings! *setting-control*)
    (suspend-for (seconds 0.5)
      )
    (while (!= (-> *setting-control* user-current bg-a) 1.0)
      (suspend)
      )
    (set-blackout-frames (seconds 0.1))
    (kill-persister *setting-control* 'title-control-scene 'render)
    (apply-settings! *setting-control*)
    (remove-setting! 'bg-a)
    )
  (none)
  )

(defmethod fmv-player-method-18 ((this fmv-player) (arg0 dma-buffer) (arg1 text-id) (arg2 m2v-info))
  (let ((s2-0 76)

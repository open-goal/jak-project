;;-*-Lisp-*-
(in-package goal)

;; name: fmv-player.gc
;; name in dgo: fmv-player
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

(define *subtitles-text* (the-as game-text-info #f))

(define *fmv-m2v-name* (new 'global 'string 32 (the-as string #f)))

(define *fmv-snd-name* (new 'global 'string 32 (the-as string #f)))

(define *fmv-old-hflip* #f)

(deftype fmv-buffer (structure)
  ((buff     uint32)
   (start    int32)
   (start-u  uint32  :overlay-at start)
   )
  :allow-misaligned
  )


(deftype fmv-work (structure)
  ((current-buffer  uint32)
   (buffers         fmv-buffer      2 :inline)
   (buffer-size     uint32)
   (cursor          uint32)
   (name            string)
   (dma-addr        uint32)
   (data-size       uint32)
   (num-frames      uint32)
   (copied-size     uint32)
   (count-frame     uint32)
   (own-rpc         symbol)
   (len-read        int32)
   (finished        symbol)
   (current-frame   int32)
   (page            texture-page)
   (tex             texture)
   (corner          vector          4 :inline)
   (pos             vector          4 :inline)
   (uv              vector          4 :inline)
   (col             vector4w        :inline)
   (draw-tmpl       dma-gif-packet  :inline)
   )
  )


(define *fmv-work* (new 'static 'fmv-work
                     :corner (new 'static 'inline-array vector 4
                       (new 'static 'vector :w 1.0)
                       (new 'static 'vector :x 512.0 :w 1.0)
                       (new 'static 'vector :y 64.0 :w 1.0)
                       (new 'static 'vector :x 512.0 :y 64.0 :w 1.0)
                       )
                     :uv (new 'static 'inline-array vector 4
                       (new 'static 'vector)
                       (new 'static 'vector :x (the-as float #x2000))
                       (new 'static 'vector :y (the-as float #x400))
                       (new 'static 'vector :x (the-as float #x2000) :y (the-as float #x400))
                       )
                     :col (new 'static 'vector4w :x #x80 :y #x80 :z #x80 :w #x80)
                     :draw-tmpl (new 'static 'dma-gif-packet
                       :dma-vif (new 'static 'dma-packet
                         :dma (new 'static 'dma-tag :qwc #xf :id (dma-tag-id cnt))
                         :vif1 (new 'static 'vif-tag :imm #xf :cmd (vif-cmd direct) :msk #x1)
                         )
                       :gif (new 'static 'array uint64 2 #xe0aa400000008001 #x535353531eeeee)
                       )
                     )
        )

(set! (-> *fmv-work* dma-addr) (the-as uint 0))


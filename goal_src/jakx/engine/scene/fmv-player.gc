                (set! (-> gp-0 upper-field-first) 0)
                (set! (-> gp-0 buffer-mode) 2)
                (set! (-> gp-0 work-mem) (the-as uint (-> s4-0 current)))
                (set! (-> gp-0 work-mem-size) (the-as uint #x80000))
                (let ((v1-28 s2-1)
                      (a0-19 (+ #x40000 s2-1))
                      (s4-1 0)
                      )
                  0
                  0
                  (set! (-> *fmv-work* buffers 0 buff) (the-as uint v1-28))
                  (set! (-> *fmv-work* buffers 1 buff) (the-as uint a0-19))
                  (set! (-> *fmv-work* buffer-size) (the-as uint s5-0))
                  (set! (-> *fmv-work* own-rpc) #f)
                  (set! (-> *fmv-work* cursor) (the-as uint 0))
                  (set! (-> *fmv-work* current-buffer) (the-as uint 0))
                  (set! (-> *fmv-work* finished) #f)
                  (let ((gp-1 (fmv-player-init (the-as pointer gp-0))))
                    (format 0 "fmv-player-init returned ~D~%" gp-1)
                    (if (!= gp-1 1)
                        (return #f)
                        )
                    )
                  (fmv-file-init (the-as string 1))
                  (fmv-file-read (the-as pointer 0) 0 0 a3-0)
                  (while (>= (the-as uint 8) (-> *fmv-work* cursor))
                    (suspend)
                    (fmv-file-read (the-as pointer 0) 0 0 a3-0)
                    )
                  (let ((gp-2 (fmv-player-start s4-1 0)))
                    (format 0 "fmv-player-start returned ~D~%" gp-2)
                    (if (!= gp-2 1)
                        (return #f)
                        )
                    )
                  )
                )
              )
            )
          (until #f
            (let ((gp-3 0))
              (while (< (-> *fmv-work* copied-size) (-> *fmv-work* data-size))
                (fmv-player-idle)
                (set! (-> *fmv-work* dma-addr) (the-as uint (fmv-player-get-texture)))
                (suspend)
                (suspend)
                (+! gp-3 1)
                )
              (set! (-> *fmv-work* finished) #t)
              (let ((s5-1 (-> *fmv-work* num-frames)))
                (str-load-cancel)
                (fmv-file-init (the-as string 1))
                (while (< gp-3 (the-as int s5-1))
                  (set! (-> *fmv-work* dma-addr) (the-as uint (fmv-player-get-texture)))
                  (fmv-file-read (the-as pointer 0) 0 0 a3-0)
                  (suspend)
                  (fmv-file-read (the-as pointer 0) 0 0 a3-0)
                  (suspend)
                  (+! gp-3 1)
                  )
                )
              )
            (fmv-player-rewind)
            )
          )
        )
      )
    #f
    (fmv-player-stop 1)
    (fmv-player-terminate)
    )
  :post (behavior ()
    '()
    )
  )

(defstate idle-texture-fma (fmv-player)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('next-frame)
       (set! (-> *fmv-work* dma-addr) (the-as uint (fmv-player-get-texture)))
       (let ((v0-1 (the-as object (+ (-> *fmv-work* count-frame) 1))))
         (set! (-> *fmv-work* count-frame) (the-as uint v0-1))
         v0-1
         )
       )
      (('ready?)
       (< (the-as uint 8) (-> *fmv-work* cursor))
       )
      )
    )
  :enter (behavior ()
    '()
    )
  :code (behavior ()
    (suspend)
    (let ((s4-0 (new 'stack 'kheap))
          (s3-0 (new 'stack 'kheap))
          (s5-0 #x40000)
          )
      (let ((gp-0 (new 'stack 'fmv-player-params)))
        0
        (let ((v1-6 (level-get *level* 'menu2)))
          (cond
            (v1-6
              )
            ((begin (set! v1-6 (level-get *level* 'garageb)) v1-6)
             )
            ((begin (set! v1-6 (level-get *level* 'tsk2a)) v1-6)
             )
            ((begin (set! v1-6 (level-get *level* 'tsk2c)) v1-6)
             )
            ((begin (set! v1-6 (level-get *level* 'tsk5a)) v1-6)
             )
            ((begin (set! v1-6 (level-get *level* 'tsk80a)) v1-6)
             )
            ((begin (set! v1-6 (level-get *level* 'tsk130b)) v1-6)
             )
            ((begin (set! v1-6 (level-get *level* 'rustyh)) v1-6)
             )
            ((begin (set! v1-6 (level-get *level* 'havena)) v1-6)
             )
            ((begin (set! v1-6 (level-get *level* 'hiphog)) v1-6)
             )
            )
          (when v1-6
            (let ((a0-33 s4-0))
              (set! (-> a0-33 base) (-> v1-6 heap current))
              (set! (-> a0-33 current) (-> a0-33 base))
              (set! (-> a0-33 top-base) (&+ (-> a0-33 base) #x96000))
              (set! (-> a0-33 top) (-> a0-33 top-base))
              )
            (let ((s2-0 (fmv-get-mem-requirements 256 128 0 2)))
              (format 0 "~D required~%" (sar s2-0 10))
              (let ((v1-21 s3-0))
                (set! (-> v1-21 base) (-> s4-0 top))
                (set! (-> v1-21 current) (-> v1-21 base))
                (set! (-> v1-21 top-base) (&+ (-> v1-21 base) s2-0))
                (set! (-> v1-21 top) (-> v1-21 top-base))
                )
              (set! (-> gp-0 display-mode display-mode) 255)
              (set! (-> gp-0 display-mode texture-base-page) (-> self texture-base-page))
              (set! (-> gp-0 display-mode texture-width) (-> self texture-width))
              (set! (-> gp-0 file-init) fmv-file-init)
              (set! (-> gp-0 file-read) fmv-file-read)
              (set! (-> gp-0 get-time) (the-as basic 0))
              (set! (-> gp-0 video-type) 0)
              (set! (-> gp-0 zoom-mode) 0)
              (set! (-> gp-0 upper-field-first) 0)
              (set! (-> gp-0 buffer-mode) 2)
              (set! (-> gp-0 work-mem) (the-as uint (-> s3-0 current)))
              (set! (-> gp-0 work-mem-size) (the-as uint s2-0))
              )
            (let* ((s3-1 (kmalloc s4-0 s5-0 (kmalloc-flags align-64 top) "fmv-buf-2"))
                   (t9-16 kmalloc)
                   (a1-17 s5-0)
                   (a2-3 8256)
                   (a3-2 "fmv-buf-1")
                   (v1-29 (t9-16 s4-0 a1-17 (the-as kmalloc-flags a2-3) a3-2))
                   (s4-1 0)
                   )
              0
              (set! (-> *fmv-work* buffers 0 buff) (the-as uint v1-29))
              (set! (-> *fmv-work* buffers 1 buff) (the-as uint s3-1))
              (set! (-> *fmv-work* buffer-size) (the-as uint s5-0))
              (set! (-> *fmv-work* own-rpc) #f)
              (set! (-> *fmv-work* cursor) (the-as uint 0))
              (set! (-> *fmv-work* current-buffer) (the-as uint 0))
              (set! (-> *fmv-work* finished) #f)
              (fmv-player-init (the-as pointer gp-0))
              (fmv-file-init (the-as string 1))
              (fmv-file-read (the-as pointer 0) 0 0 (the-as int a3-2))
              (while (>= (the-as uint 8) (-> *fmv-work* cursor))
                (suspend)
                (fmv-file-read (the-as pointer 0) 0 0 (the-as int a3-2))
                )
              (fmv-player-start s4-1 0)
              )
            (set! (-> *fmv-work* count-frame) (the-as uint 0))
            (while (< (-> *fmv-work* copied-size) (-> *fmv-work* data-size))
              (fmv-player-idle)
              (suspend)
              )
            (let ((gp-1 (-> *fmv-work* num-frames)))
              (while (< (-> *fmv-work* count-frame) gp-1)
                (suspend)
                )
              )
            (set! (-> *fmv-work* dma-addr) (the-as uint 0))
            (str-load-cancel)
            (fmv-player-stop 1)
            (fmv-player-terminate)
            )
          )
        )
      )
    )
  :post (behavior ()
    '()
    )
  )

;; WARN: Return type mismatch process vs fmv-player.
(defmethod relocate ((this fmv-player) (offset int))
  (set! *fmv-player* this)
  (if *fmv-player*
      (set! *fmv-player* (&+ *fmv-player* offset))
      )
  (the-as fmv-player ((method-of-type process relocate) this offset))
  )

(defmethod deactivate ((this fmv-player))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (str-load-cancel)
  (fmv-player-terminate)
  (set! (-> *fmv-work* dma-addr) (the-as uint 0))
  (set! *fmv-player* #f)
  ((method-of-type process deactivate) this)
  (none)
  )

(defbehavior fmv-player-init-by-other fmv-player ((arg0 symbol) (arg1 process) (arg2 int) (arg3 int))
  (set! (-> self fmv-mode) (the-as uint arg3))
  (set! (-> self gui-id) (new 'static 'sound-id))
  (stack-size-set! (-> self main-thread) 512)
  (set! (-> self clock) (-> *display* real-frame-clock))
  (logclear! (-> self mask) (process-mask pause))
  (set! (-> self texture-base-page) (the-as uint arg1))
  (set! (-> self texture-width) (the-as uint arg2))
  (set! *fmv-player* self)
  (cond
    (arg0
      (go-virtual idle)
      )
    (*scene-player*
      (go-virtual idle-texture-fma)
      )
    (else
      (go-virtual idle-texture)
      )
    )
  )

(defun fmv-player-run ((arg0 string) (arg1 process-tree) (arg2 symbol))
  (rlet ((vf1 :class vf)
         (vf2 :class vf)
         (vf3 :class vf)
         (vf4 :class vf)
         )
    (kill-by-type fmv-player *active-pool*)
    (let ((v1-1 (level-get *level* 'fmvlev))
          (s3-0 *fmv-work*)
          )
      (cond
        (v1-1
          (set! (-> s3-0 page) (-> v1-1 texture-page-dir 8 page))
          (when (-> s3-0 page)
            (set! (-> s3-0 tex)
                  (lookup-texture-by-name "combatracing" (the-as string #f) (the-as (pointer texture-page) #f))
                  )
            (let ((sv-160 (new 'stack-no-clear 'matrix)))
              (set! (-> sv-160 rvec quad) (the-as uint128 0))
              (set! (-> sv-160 uvec quad) (the-as uint128 0))
              (set! (-> sv-160 fvec quad) (the-as uint128 0))
              (set! (-> sv-160 trans quad) (the-as uint128 0))
              (let ((s2-0 (new 'stack-no-clear 'vector))
                    (s1-0 (new 'stack-no-clear 'vector))
                    (s0-0 (new 'stack-no-clear 'vector))
                    (sv-144 (new 'stack-no-clear 'vector))
                    )
                (case (get-aspect-ratio)
                  (('aspect4x3)
                   (format 0 "aspect4x3~%")
                   (matrix-rotate-z! sv-160 -2366.578)
                   (scale-matrix! sv-160 (new 'static 'vector :x 0.65 :y 0.65 :z 0.65 :w 1.0) sv-160)
                   (set-vector! (-> sv-160 trans) 1972.0 2153.0 0.0 1.0)
                   )
                  (else
                    (format 0 "aspect16x9~%")
                    (matrix-rotate-z! sv-160 -3094.7556)
                    (scale-matrix! sv-160 (new 'static 'vector :x 0.65 :y 0.65 :z 0.65 :w 1.0) sv-160)
                    (set-vector! (-> sv-160 trans) 1979.0 2185.0 0.0 1.0)
                    )
                  )
                (vector-matrix*! s2-0 (-> s3-0 corner 0) sv-160)
                (vector-matrix*! s1-0 (-> s3-0 corner 1) sv-160)
                (vector-matrix*! s0-0 (-> s3-0 corner 2) sv-160)
                (vector-matrix*! sv-144 (-> s3-0 corner 3) sv-160)
                (.lvf vf1 (&-> s2-0 quad))
                (.lvf vf2 (&-> s1-0 quad))
                (.lvf vf3 (&-> s0-0 quad))
                (.lvf vf4 (&-> sv-144 quad))
                )
              )
            (vftoi4.xyzw vf1 vf1)
            (vftoi4.xyzw vf2 vf2)
            (vftoi4.xyzw vf3 vf3)
            (vftoi4.xyzw vf4 vf4)
            (.svf (&-> s3-0 pos 0 quad) vf1)
            (.svf (&-> s3-0 pos 1 quad) vf2)
            (.svf (&-> s3-0 pos 2 quad) vf3)
            (.svf (&-> s3-0 pos 3 quad) vf4)
            (set! (-> s3-0 pos 0 z) 0.000000000000000000000000000000000000023509886)
            (set! (-> s3-0 pos 1 z) 0.000000000000000000000000000000000000023509886)
            (set! (-> s3-0 pos 2 z) 0.000000000000000000000000000000000000023509886)
            (set! (-> s3-0 pos 3 z) 0.000000000000000000000000000000000000023509886)
            )
          )
        (else
          (set! (-> s3-0 page) #f)
          )
        )
      )
    (cond
      (*fmv-player*
        (change-parent *fmv-player* arg1)
        )
      (else
        (dotimes (s3-1 (-> *m2v-info* length))
          (when (or (nocase-string= arg0 (-> *m2v-info* s3-1 sound)) (nocase-string= arg0 (-> *m2v-info* s3-1 name)))
            (cond
              ((demo?)
               (let ((v0-18 (scf-get-territory)))
                 (if (= v0-18 1)
                     (format (clear *fmv-m2v-name*) "~S.pal" (-> *m2v-info* s3-1 name))
                     (format (clear *fmv-m2v-name*) "~S.m2v" (-> *m2v-info* s3-1 name))
                     )
                 )
               )
              (else
                (format
                  (clear *fmv-m2v-name*)
                  (cond
                    ((= (-> *setting-control* user-current smode2) #t)
                     "~S.m2v"
                     )
                    ((and (not (logtest? (-> *m2v-info* s3-1 flags) 2)) (= (-> *setting-control* user-current video-mode) 'pal))
                     "~S.pal"
                     )
                    (else
                      "~S.m2v"
                      )
                    )
                  (-> *m2v-info* s3-1 name)
                  )
                )
              )
            (cond
              (arg2
                (format (clear *fmv-snd-name*) "~S" (-> *m2v-info* s3-1 commentary-sound))
                (process-spawn fmv-player #t 0 10 2 :name "fmv-player" :to arg1 :stack *kernel-dram-stack*)
                )
              (else
                (format (clear *fmv-snd-name*) "~S" (-> *m2v-info* s3-1 sound))
                (process-spawn fmv-player #t 0 10 1 :name "fmv-player" :to arg1 :stack *kernel-dram-stack*)
                )
              )
            )
          )
        )
      )
    0
    (none)
    )
  )

(defun fmv-player-run-texture ((arg0 string) (arg1 process-tree))
  (kill-by-type fmv-player *active-pool*)
  (let ((a0-3 (lookup-texture-by-name "iscreen-video-dest" (the-as string #f) (the-as (pointer texture-page) #f))))
    (when a0-3
      (let ((gp-0 (-> a0-3 dest 0))
            (s4-0 (-> a0-3 width 0))
            )
        (cond
          (*fmv-player*
            (change-parent *fmv-player* arg1)
            )
          (else
            (cond
              (*scene-player*
                (if *record-fma-pal*
                    (format (clear *fmv-m2v-name*) "~S.ppu" arg0)
                    (format (clear *fmv-m2v-name*) "~S.ipu" arg0)
                    )
                )
              (else
                (format (clear *fmv-m2v-name*) "~S.ipu" arg0)
                )
              )
            (format 0 "play ~S~%" *fmv-m2v-name*)
            (set! (-> *fmv-work* name) *fmv-m2v-name*)
            (process-spawn fmv-player #f gp-0 s4-0 0 :name "fmv-player" :to arg1)
            )
          )
        )
      )
    )
  0
  (none)
  )

;;-*-Lisp-*-
(in-package goal)

;; name: movie-path.gc
;; name in dgo: movie-path
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

(deftype movie-path (process)
  ((root        basic          :offset-assert 144)
   (path        basic          :offset-assert 148)
   (path-pos    float          :offset-assert 152)
   (path-speed  float          :offset-assert 156)
   (rot         vector :inline :offset-assert 160)
   (enabled?    symbol          :offset-assert 176)
   (movie-frame uint32         :offset-assert 180)
   )
  :method-count-assert 17
  :size-assert         #xb8
  :flag-assert         #x11003000b8
  (:state-methods
    active ;; 15
    )
  (:methods
    (movie-path-method-16 (_type_) none) ;; 16
    )
  )

(define-extern *movie-path-dir* string)
(define-extern *movie-path-filename* string)
(define-extern *movie-path* string)
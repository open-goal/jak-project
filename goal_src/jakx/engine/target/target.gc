;;-*-Lisp-*-
(in-package goal)

;; name: target.gc
;; name in dgo: target
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

(defbehavior target-nearest-dist target ()
  0.0
  )

(defun target-get-any-pos ()
  (let ((gp-0 (the-as target #f)))
    (dotimes (s5-0 *view-count*)
      (if (view-get-target s5-0)
          (set! gp-0 (the-as target (view-get-target s5-0)))
          )
      )
    (cond
      ((and gp-0 (-> gp-0 root trans))
       (-> gp-0 root trans)
       )
      (else
        (view-push-context 0)
        (let ((gp-1 (camera-pos)))
          (view-pop-context)
          gp-1
          )
        )
      )
    )
  )

(defstate target-float (target)
  :event target-generic-event-handler
  :enter (behavior ()
    (rlet ((vf0 :class vf)
           (vf4 :class vf)
           (vf5 :class vf)
           (vf6 :class vf)
           )
      (init-vf0-vector)
      (let ((v1-1 (make-sound-instance (-> *sound-info* 314) 0 #f)))
        (cond
          (v1-1
            (set! (-> v1-1 fo-power) 0.0)
            (logior! (-> v1-1 flags) 328)
            (-> v1-1 id)
            )
          (else
            0
            )
          )
        )
      (let ((v1-4 (new-stack-vector0)))
        (let ((f0-2 (vector-dot (-> self root dynam gravity-normal) (-> self root transv))))
          0.0
          (vector-! v1-4 (-> self root transv) (vector-float*! v1-4 (-> self root dynam gravity-normal) f0-2))
          )
        (let* ((f0-3 (vector-length v1-4))
               (f1-1 f0-3)
               (f2-0 0.0)
               (a0-13 (-> self root transv))
               )
          (let ((a1-6 (vector-float*! (-> self root transv) (-> self root dynam gravity-normal) f2-0))
                (a2-7 (vector-float*! v1-4 v1-4 (/ f0-3 f1-1)))
                )
            (.lvf vf4 (&-> a1-6 quad))
            (.lvf vf5 (&-> a2-7 quad))
            )
          (.mov.vf.w vf6 vf0)
          (.add.vf.xyz vf6 vf4 vf5)
          (.svf (&-> a0-13 quad) vf6)
          )
        )
      (set! (-> self root dynam gravity-max) 0.0)
      (set! (-> self root dynam gravity-length) 0.0)
      )
    )
  :exit (behavior ()
    (let ((v1-1 (make-sound-instance (-> *sound-info* 314) 0 #f)))
      (cond
        (v1-1
          (set! (-> v1-1 fo-power) 0.0)
          (logior! (-> v1-1 flags) 328)
          (-> v1-1 id)
          )
        (else
          0
          )
        )
      )
    (target-exit)
    )
  :trans (behavior ()
    (rlet ((vf0 :class vf)
           (vf4 :class vf)
           (vf5 :class vf)
           (vf6 :class vf)
           )
      (init-vf0-vector)
      (let ((v1-0 1))
        (cond
          ((cpad-hold? v1-0 r2)
           (let ((a1-1 (new 'stack-no-clear 'vector)))
             (set! (-> a1-1 quad) (-> self root trans quad))
             (let ((v1-4 (new-stack-vector0))
                   (f0-1 (vector-dot (-> self root dynam gravity-normal) a1-1))
                   )
               0.0
               (vector-! v1-4 a1-1 (vector-float*! v1-4 (-> self root dynam gravity-normal) f0-1))
               (let* ((f1-2 (vector-length v1-4))
                      (f2-0 f1-2)
                      (f0-2 (+ 512.0 f0-1))
                      (a2-3 a1-1)
                      )
                 (let ((a0-15 (vector-float*! a1-1 (-> self root dynam gravity-normal) f0-2))
                       (a3-6 (vector-float*! v1-4 v1-4 (/ f1-2 f2-0)))
                       )
                   (.lvf vf4 (&-> a0-15 quad))
                   (.lvf vf5 (&-> a3-6 quad))
                   )
                 (.mov.vf.w vf6 vf0)
                 (.add.vf.xyz vf6 vf4 vf5)
                 (.svf (&-> a2-3 quad) vf6)
                 )
               )
             (move-to-point! (-> self root) a1-1)
             )
           )
          ((cpad-hold? v1-0 l2)
           (let ((a1-3 (new 'stack-no-clear 'vector)))
             (set! (-> a1-3 quad) (-> self root trans quad))
             (let ((v1-10 (new-stack-vector0))
                   (f0-5 (vector-dot (-> self root dynam gravity-normal) a1-3))
                   )
               0.0
               (vector-! v1-10 a1-3 (vector-float*! v1-10 (-> self root dynam gravity-normal) f0-5))
               (let* ((f1-5 (vector-length v1-10))
                      (f2-1 f1-5)
                      (f0-6 (+ -512.0 f0-5))
                      (a2-7 a1-3)
                      )
                 (let ((a0-32 (vector-float*! a1-3 (-> self root dynam gravity-normal) f0-6))
                       (a3-13 (vector-float*! v1-10 v1-10 (/ f1-5 f2-1)))
                       )
                   (.lvf vf4 (&-> a0-32 quad))
                   (.lvf vf5 (&-> a3-13 quad))
                   )
                 (.mov.vf.w vf6 vf0)
                 (.add.vf.xyz vf6 vf4 vf5)
                 (.svf (&-> a2-7 quad) vf6)
                 )
               )
             (move-to-point! (-> self root) a1-3)
             )
           )
          ((cpad-pressed? v1-0 l1 x)
           )
          )
        )
      (let ((v1-20 (new-stack-vector0)))
        (let ((f0-9 (vector-dot (-> self root dynam gravity-normal) (-> self root transv))))
          0.0
          (vector-! v1-20 (-> self root transv) (vector-float*! v1-20 (-> self root dynam gravity-normal) f0-9))
          )
        (let* ((f0-10 (vector-length v1-20))
               (f1-7 f0-10)
               (f2-2 0.0)
               (v0-2 (-> self root transv))
               )
          (let ((a0-47 (vector-float*! (-> self root transv) (-> self root dynam gravity-normal) f2-2))
                (a1-11 (vector-float*! v1-20 v1-20 (/ f0-10 f1-7)))
                )
            (.lvf vf4 (&-> a0-47 quad))
            (.lvf vf5 (&-> a1-11 quad))
            )
          (.mov.vf.w vf6 vf0)
          (.add.vf.xyz vf6 vf4 vf5)
          (.svf (&-> v0-2 quad) vf6)
          )
        )
      )
    )
  :code sleep-code
  :post target-post
  )

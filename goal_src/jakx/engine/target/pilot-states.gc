;;-*-Lisp-*-
(in-package goal)

;; name: pilot-states.gc
;; name in dgo: pilot-states
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

(defstate target-pilot-start (target)
  :event target-generic-event-handler
  :code (behavior ((arg0 handle))
    (cond
      ((handle->process arg0)
       (set! (-> self vehicle) arg0)
       (send-event (view-get-active-camera) 'change-target (handle->process arg0))
       )
      (else
        (break!)
        0
        )
      )
    (until #f
      (suspend)
      )
    #f
    )
  :post (behavior ()
    (target-pilot-post)
    )
  )

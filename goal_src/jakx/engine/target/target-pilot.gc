;;-*-Lisp-*-
(in-package goal)

;; name: target-pilot.gc
;; name in dgo: target-pilot
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

(defbehavior target-pilot-post target ()
  (let ((v1-1 (handle->process (-> self vehicle))))
    (when v1-1
      (set! (-> self root trans quad) (-> (the-as process-drawable v1-1) root trans quad))
      (set! (-> self root transv quad) (-> (the-as process-drawable v1-1) root transv quad))
      (quaternion-copy!
        (the-as quaternion (-> self root rot))
        (the-as quaternion (-> (the-as process-drawable v1-1) root rot))
        )
      )
    )
  0
  (none)
  )

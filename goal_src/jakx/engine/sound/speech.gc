    (((speech-type shooting))
     "shooting"
     )
    (((speech-type announce-race-end))
     "announce-race-end"
     )
    (((speech-type boss-taking-hits))
     "boss-taking-hits"
     )
    (((speech-type frustrated))
     "frustrated"
     )
    (((speech-type event-start))
     "event-start"
     )
    (((speech-type boss-start))
     "boss-start"
     )
    (((speech-type bumping))
     "bumping"
     )
    (((speech-type boss-taunt))
     "boss-taunt"
     )
    (((speech-type boss-kill))
     "boss-kill"
     )
    (((speech-type collecting))
     "collecting"
     )
    (((speech-type taking-hits))
     "taking-hits"
     )
    (((speech-type race-start))
     "race-start"
     )
    (((speech-type race-finish-lose))
     "race-finish-lose"
     )
    (((speech-type deathmatch-finish-win))
     "deathmatch-finish-win"
     )
    (((speech-type boss-support))

    (((speech-type lap-count-1))
     "lap-count-1"
     )
    (((speech-type announce-crash))
     "announce-crash"
     )
    (((speech-type none))
     "none"
     )
    (((speech-type lap-count-last))
     "lap-count-last"
     )
    (((speech-type crashing))
     "crashing"

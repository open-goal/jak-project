(defmethod play ((this speech-info) (arg0 int) (arg1 gui-channel) (arg2 symbol))
  (with-pp
    (let ((gp-0 (new 'static 'sound-id)))
      (when (and (or (not (logtest? (-> this list arg0 flags) (speech-info-item-flag sii0))) (= *game-mode* 'adventure))
                 (or (not (logtest? (-> this list arg0 flags) (speech-info-item-flag sii1))) arg2)
                 )
        (set! gp-0 (add-process *gui-control* pp arg1 (gui-action play) (-> this list arg0 name) -99.0 0))
        (sound-params-set! *gui-control* gp-0 #f -1.0 -1.0 1.0 (-> *setting-control* user-current talker-volume) #t)
        (when (!= (-> *setting-control* user-current dialog-volume) 0.0)
          (if (< *music-volume-during-speech* (-> *setting-control* user-target music-volume))
              (set-setting! 'music-volume 'rel *music-volume-during-speech* 0)
              )
          (if (< *sfx-volume-during-speech* (-> *setting-control* user-target sfx-volume))
              (set-setting! 'sfx-volume 'rel *sfx-volume-during-speech* 0)
              )
          )
        )
      gp-0
      )
    )
  )

(defmethod speech-info-method-10 ((this speech-info) (arg0 string) (arg1 gui-channel))
  (let ((s2-0 0)
        (gp-0 (new 'static 'sound-id))
        )
    (let* ((s1-0 (-> this list allocated-length))
           (s0-0 0)
           (v1-3 (-> this list s0-0))
           )
      (while (< s0-0 s1-0)
        (when (string= arg0 (-> v1-3 name))
          (format 0 "speech: playing speech ~S~%" arg0)
          (set! gp-0 (play this s2-0 arg1 #f))
          )
        (+! s2-0 1)
        (+! s0-0 1)
        (set! v1-3 (-> this list s0-0))
        )
      )
    gp-0
    )
  )

;; WARN: Return type mismatch int vs sound-id.
(defmethod speech-info-method-11 ((this speech-info) (arg0 gui-channel) (arg1 symbol))
  (let* ((gp-0 (-> this list))
         (s3-0 (-> gp-0 length))
         (s5-0 (mod (the-as int (rand-uint31-gen *random-generator*)) s3-0))
         (v0-1 0)
         )
    (when (> s3-0 0)
      (set! v0-1 (the-as int (play this s5-0 arg0 arg1)))
      (let* ((v1-2 (+ s3-0 -1))
             (a0-5 (-> gp-0 s5-0))
             (a1-4 (-> gp-0 v1-2))
             )
        (cond
          ((and (zero? v1-2) (not (logtest? (-> this flags) (speech-info-flag si0))))
           (set! (-> gp-0 length) (-> gp-0 allocated-length))
           )
          (else
            (set! (-> gp-0 s5-0) a1-4)
            (set! (-> gp-0 v1-2) a0-5)
            (set! (-> gp-0 length) v1-2)
            )
          )
        )
      )
    (the-as sound-id v0-1)
    )
  )

(defmethod set-list-len! ((this speech-info))
  (set! (-> this list length) (-> this list allocated-length))
  0
  (none)
  )

(defmethod init! ((this speech-channel))
  (set! (-> this gui-channel) (gui-channel speech))
  (set! (-> this id) (new 'static 'sound-id))
  (set! (-> this current-request) #f)
  (set! (-> this requests) (new 'global 'boxed-array speech-request 3))
  (set! (-> this requests length) 0)
  (let ((s5-0 0)
        (s4-0 (-> this requests allocated-length))
        (s3-0 0)
        )
    (-> this requests s3-0)
    (while (< s3-0 s4-0)
      (let ((v0-1 (new 'global 'speech-request)))
        (set! (-> this requests s5-0) v0-1)
        (let ((v1-10 v0-1))
          (set! (-> v1-10 handle) (the-as handle #f))
          (set! (-> v1-10 name) #f)
          )
        )
      (+! s5-0 1)
      (+! s3-0 1)
      (-> this requests s3-0)
      )
    )
  (let ((v1-16 (-> this speeches)))
    (dotimes (a0-6 31)
      (set! (-> v1-16 a0-6) #f)
      )
    )
  0
  (none)
  )

(defun-debug speech-type->string ((arg0 speech-type))

(defun-debug gui-status->string ((arg0 gui-status))
  (case arg0
    (((gui-status ready))
     "ready"
     )
    (((gui-status active))
     "active"
     )
    (((gui-status stop))
     "stop"
     )
    (((gui-status unknown))
     "unknown"
     )
    (((gui-status hide))
     "hide"
     )
    (((gui-status pending))
     "pending"
     )
    (else
      "*unknown*"
      )
    )
  )

(defmethod speech-channel-method-10 ((this speech-channel))
  (set-time! (-> this time))
  (logclear! (-> this flags) (speech-channel-flag disable))
  (if (or (not (-> *setting-control* user-current speech-control))
          (level-group-method-28 *level*)
          (not (handle-command-list *gui-control* (-> this gui-channel) (the-as gui-connection #f)))
          )
      (logior! (-> this flags) (speech-channel-flag disable))
      )
  (let ((s5-0 (-> this current-request))
        (v1-15 (-> this requests length))
        )
    (cond
      (s5-0
        (cond
          ((nonzero? (-> this id))
           (cond
             ((not (handle->process (-> s5-0 handle)))
              (set-action!
                *gui-control*
                (gui-action stop)
                (-> this id)
                (gui-channel none)
                (gui-action none)
                (the-as string #f)
                (the-as (function gui-connection symbol) #f)
                (the-as process #f)
                )
              (set! (-> this id) (new 'static 'sound-id))
              (set! (-> this current-request) #f)
              (remove-setting! 'music-volume)
              (remove-setting! 'sfx-volume)
              )
             (else
               (case (get-status *gui-control* (-> this id))
                 (((gui-status active))
                  (sound-params-set!
                    *gui-control*
                    (-> this id)
                    #t
                    -1.0
                    -1.0
                    1.0
                    (-> *setting-control* user-current talker-volume)
                    #t
                    )
                  )
                 (((gui-status pending))
                  (when (time-elapsed? (-> s5-0 start-time) (-> s5-0 max-delay))
                    (set-action!
                      *gui-control*
                      (gui-action stop)
                      (-> this id)
                      (gui-channel none)
                      (gui-action none)
                      (the-as string #f)
                      (the-as (function gui-connection symbol) #f)
                      (the-as process #f)
                      )
                    (set! (-> this id) (new 'static 'sound-id))
                    (set! (-> this current-request) #f)
                    (remove-setting! 'music-volume)
                    (remove-setting! 'sfx-volume)
                    )
                  )
                 (((gui-status unknown))
                  (set! (-> this id) (new 'static 'sound-id))
                  (set! (-> this current-request) #f)
                  (remove-setting! 'music-volume)
                  (remove-setting! 'sfx-volume)
                  )
                 )
               )
             )
           )
          (else
            (set! (-> this current-request) #f)
            (remove-setting! 'music-volume)
            (remove-setting! 'sfx-volume)
            )
          )
        )
      ((and (not (logtest? (-> this flags) (speech-channel-flag disable))) (nonzero? v1-15))
       (set! (-> this current-request) (-> this requests (+ v1-15 -1)))
       (let ((s5-1 (-> this current-request)))
         (+! (-> this requests length) -1)
         (let ((s4-0 (- (-> this time) (-> s5-1 req-time)))
               (s3-0 (handle->process (-> s5-1 handle)))
               )
           (let ((s2-0 s3-0))
             (if (type? s2-0 process-drawable)
                 (empty)
                 )
             )
           (cond
             ((or (not s3-0) (< (-> s5-1 max-delay) s4-0))
              (format 0 "WARNING: speech: dropping request for speech ~S.~%" (-> s5-1 name))
              )
             ((begin (set-time! (-> s5-1 start-time)) (logtest? (-> s5-1 flags) (speech-request-flag srf0)))
              (set! (-> this id) (speech-info-method-11
                                   (-> this speeches (-> s5-1 speech-type))
                                   (-> this gui-channel)
                                   (logtest? (-> s5-1 flags) (speech-request-flag srf1))
                                   )
                    )
              )
             (else
               (set! (-> this id)
                     (speech-info-method-10 (-> this speeches (-> s5-1 speech-type)) (-> s5-1 name) (-> this gui-channel))
                     )
               )
             )
           )
         )
       )
      )
    )
  0
  (none)
  )

(defmethod speech-channel-method-11 ((this speech-channel) (arg0 process) (arg1 speech-type) (arg2 string) (arg3 symbol) (arg4 time-frame))
  (cond
    ((-> this speeches arg1)
     (let* ((v1-3 (-> this requests))
            (a0-1 (-> v1-3 length))
            )
       (cond
         ((< a0-1 (-> v1-3 allocated-length))
          (let ((a0-4 (-> v1-3 a0-1)))
            (set! (-> a0-4 handle) (process->handle arg0))
            (set-time! (-> a0-4 req-time))
            (set! (-> a0-4 max-delay) arg4)
            (set! (-> a0-4 speech-type) arg1)
            (set! (-> a0-4 name) arg2)
            (cond
              ((not arg2)
               (logior! (-> a0-4 flags) (speech-request-flag srf0))
               (if arg3
                   (logior! (-> a0-4 flags) (speech-request-flag srf1))
                   (logclear! (-> a0-4 flags) (speech-request-flag srf1))
                   )
               )
              (else
                (logclear! (-> a0-4 flags) (speech-request-flag srf0))
                )
              )
            )
          (+! (-> v1-3 length) 1)
          )
         (else
           (format 0 "WARNING: speech: not playing ~S because there are too many speech-requests.~%" arg2)
           )
         )
       )
     )
    (else
      (format
        0
        "WARNING: speech: not playing ~S because there are no speeches registered for speech-type '~S'.~%"
        (if arg2
            arg2
            "random speech"
            )
        (speech-type->string arg1)
        )
      )
    )
  0
  (none)
  )

;; WARN: Return type mismatch none vs object.
(defmethod speech-channel-method-16 ((this speech-channel) (arg0 int))
  (let ((a0-1 (-> this speeches arg0)))
    (if a0-1
        (set-list-len! a0-1)
        )
    )
  )

(defmethod speech-channel-method-12 ((this speech-channel) (arg0 symbol) (arg1 symbol))
  (when (or arg1 (= arg0 (handle->process (-> this current-request handle))))
    (if (nonzero? (-> this id))
        (set-action!
          *gui-control*
          (gui-action stop)
          (-> this id)
          (gui-channel none)
          (gui-action none)
          (the-as string #f)
          (the-as (function gui-connection symbol) #f)
          (the-as process #f)
          )
        )
    (set! (-> this id) (new 'static 'sound-id))
    (set! (-> this current-request) #f)
    )
  0
  (none)
  )

(defmethod reset! ((this speech-channel))
  (set! (-> this requests length) 0)

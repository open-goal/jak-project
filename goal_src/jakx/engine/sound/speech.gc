(defmethod speech-channel-method-15 ((this speech-channel) (arg0 kheap))
  (let ((v1-0 (-> arg0 base))
        (a1-1 (-> arg0 top-base))
        )
    (dotimes (a2-0 31)
      (let ((a3-2 (-> this speeches a2-0)))
        (when a3-2
          (if (and (>= (the-as uint (-> a3-2 list)) (the-as uint v1-0))
                   (>= (the-as uint a1-1) (the-as uint (-> a3-2 list)))
                   )
              (set! (-> this speeches a2-0) #f)
              )
          )
        )
      )
    )
  0
  (none)
  )

(defmethod init! ((this speech-control))
  (dotimes (s5-0 22)
    (init! (-> this channels s5-0))
    )
  0
  (none)
  )

(defmethod speech-control-method-10 ((this speech-control))
  (dotimes (s5-0 22)
    (speech-channel-method-10 (-> this channels s5-0))
    )
  0
  (none)
  )

(defmethod play-on-channel ((this speech-control)
                           (arg0 process)
                           (arg1 uint)
                           (arg2 speech-type)
                           (arg3 string)
                           (arg4 symbol)
                           (arg5 time-frame)
                           )
  (speech-channel-method-11 (-> this channels arg1) arg0 arg2 arg3 arg4 arg5)
  0
  (none)
  )

(defmethod speech-control-method-16 ((this speech-control) (arg0 int) (arg1 int))
  (speech-channel-method-16 (-> this channels (the-as uint arg0)) arg1)
  )

(defmethod speech-control-method-12 ((this speech-control) (arg0 symbol) (arg1 symbol))
  (dotimes (s3-0 22)
    (speech-channel-method-12 (-> this channels s3-0) arg0 arg1)
    )
  0
  (none)
  )

(defmethod speech-control-method-13 ((this speech-control))
  (speech-control-method-12 this #f #t)
  (dotimes (s5-0 22)
    (reset! (-> this channels s5-0))
    )
  0
  (none)
  )

(defmethod get-channel-len ((this speech-control) (arg0 int) (arg1 int))
  (get-len (-> this channels (the-as uint arg0)) arg1)
  )

(defmethod reset ((this speech-control) (arg0 kheap))
  (dotimes (s4-0 22)
    (speech-channel-method-15 (-> this channels s4-0) arg0)

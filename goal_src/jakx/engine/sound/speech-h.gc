;;-*-Lisp-*-
(in-package goal)

;; name: speech-h.gc
;; name in dgo: speech-h
;; dgos: ENGINE, GAME

;; +++speech-info-flag
(defenum speech-info-flag
  :type uint64
  :bitfield #t
  (si0 0)
  (si1 1)
  (si2 2)
  (si3 3)
  (si4 4)
  (si5 5)
  (si6 6)
  (si7 7)
  (si8 8)
  )
;; ---speech-info-flag

;; +++speech-type
(defenum speech-type
  :type uint8
  (none 0)
  (race-start 1)
  (race-finish-lose 2)
  (race-finish-win 3)
  (bumping 4)
  (passing 5)
  (shooting 6)
  (crashing 7)
  (lap-count 8)
  (collecting 9)
  (taking-hits 10)
  (lap-count-last 11)
  (lap-count-1 12)
  (deathmatch-finish-lose 13)
  (deathmatch-finish-win 14)
  (frustrated 15)
  (event-start 16)
  (announce-race-start 17)
  (announce-race-go 18)
  (announce-race-end 19)
  (announce-crash 20)
  (hangtime 21)
  (boss-start 22)
  (boss-falling-behind 23)
  (boss-catching-up 24)
  (boss-shooting 25)
  (boss-taking-hits 26)
  (boss-bumping 27)
  (boss-kill 28)
  (boss-support 29)
  (boss-taunt 30)
  )
;; ---speech-type

;; +++speech-channel-flag
(defenum speech-channel-flag
  :type uint8
  :bitfield #t
  (disable 0)
  )
;; ---speech-channel-flag

(define-extern get-task-cup-score (function int int))

(declare-type speech-control structure)
(define-extern *speech-control* speech-control)

;; +++speech-info-item-flag
(defenum speech-info-item-flag
  :type uint64
  :bitfield #t
  (sii0 0)
  (sii1 1)
  (sii2 2)
  (sii3 3)
  (sii4 4)
  (sii5 5)
  (sii6 6)
  (sii7 7)
  (sii8 8)
  )
;; ---speech-info-item-flag

;; +++speech-request-flag
(defenum speech-request-flag
  :type uint8
  :bitfield #t
  (srf0 0)
  (srf1 1)
  )
;; ---speech-request-flag


;; DECOMP BEGINS

(define *music-volume-during-speech* 0.85)

(define *sfx-volume-during-speech* 1.0)

(defun pecker-can-speak? ()
  (or (!= *game-mode* 'adventure) (>= (get-task-cup-score 128) 22))
  )

(deftype speech-info-item (structure)
  ((name   string)
   (flags  speech-info-item-flag)
   )
  :pack-me
  )


(deftype speech-info (structure)
  ((list   (array speech-info-item))
   (flags  speech-info-flag)
   )
  (:methods
    (play (_type_ int gui-channel symbol) sound-id)
    (speech-info-method-10 (_type_ string gui-channel) sound-id)
    (speech-info-method-11 (_type_ gui-channel symbol) sound-id)
    (set-list-len! (_type_) none)
    )
  )


(deftype speech-request (structure)
  ((handle       handle)
   (req-time     time-frame)
   (start-time   time-frame)
   (name         string)
   (speech-type  speech-type)
   (flags        speech-request-flag)
   (max-delay    time-frame)
   )
  )


(deftype speech-channel (structure)
  ((flags            speech-channel-flag)
   (gui-channel      gui-channel)
   (delay            uint16)
   (id               sound-id)
   (time             time-frame)
   (current-request  speech-request)
   (requests         (array speech-request))
   (speeches         speech-info  31)
   )
  (:methods
    (init! (_type_) none)
    (speech-channel-method-10 (_type_) none)
    (speech-channel-method-11 (_type_ process speech-type string symbol time-frame) none)
    (speech-channel-method-12 (_type_ symbol symbol) none)
    (reset! (_type_) none)
    (get-len (_type_ int) int)
    (speech-channel-method-15 (_type_ kheap) none)
    (speech-channel-method-16 (_type_ int) object)
    )
  )


(deftype speech-control (structure)
  ((channels  speech-channel  22 :inline)
   )
  (:methods
    (init! (_type_) none)
    (speech-control-method-10 (_type_) none)
    (play-on-channel (_type_ process uint speech-type string symbol time-frame) none)
    (speech-control-method-12 (_type_ symbol symbol) none)
    (speech-control-method-13 (_type_) none)
    (get-channel-len (_type_ int int) int)
    (reset (_type_ kheap) none)
    (speech-control-method-16 (_type_ int int) object)
    )
  )

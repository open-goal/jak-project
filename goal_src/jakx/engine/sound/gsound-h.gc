(deftype ambient-sound (basic)
  ((playing-id   sound-id)
   (entity       entity)
   (sound-count  int32)
   (spec         sound-spec  :inline)
   (play-time    time-frame)
   (time-base    time-frame)
   (time-random  time-frame)
   )
  (:methods
    (new (symbol type basic vector float) _type_)
    (update! (_type_) int)
    (change-sound! (_type_ sound-name) int)
    (update-trans! (_type_ vector) int)
    (update-vol! (_type_ float) int)
    (update-pitch-mod! (_type_ float) none)
    (set-falloff-far! (_type_ float) none)
    (set-falloff-mode! (_type_ float) none)
    (stop! (_type_) int)
    )
  )

;; og:preserve-this
(define-extern effect-param->sound-spec (function sound-spec (pointer float) int process-focusable sound-spec))
(define-extern sound-info-by-name (function string sound-info))
(define-extern new-sound-id (function sound-id))

;; WARN: Return type mismatch object vs ambient-sound.
(defmethod new ambient-sound ((allocation symbol) (type-to-make type) (arg0 basic) (arg1 vector) (arg2 float))
  "Set up ambient-sound. Can use an entity-actor (grabs from lump), sound-spec, or name as a string."
  (with-pp
    (let ((sv-16 (the-as sound-spec #f))
          (sv-32 (the-as sound-name 0))
          (sv-48 (the-as (pointer float) #f))
          (sv-52 (the-as (pointer float) #f))
          (sv-56 0)
          )
      (case (-> arg0 type)
        ((entity-actor)
         (let* ((a0-3
                  (the-as
                    basic
                    ((method-of-type res-lump get-property-struct)
                     (the-as res-lump arg0)
                     'effect-name
                     'exact
                     arg2
                     (the-as structure #f)
                     (the-as (pointer res-tag) #f)
                     *res-static-buf*
                     )
                    )
                  )
                (v1-2 (when a0-3
                        (case (rtype-of a0-3)
                          ((symbol)
                           (symbol->string (the-as symbol a0-3))
                           )
                          ((string)
                           a0-3
                           )
                          (else
                            "unknown"
                            )
                          )
                        )
                      )
                )
           (when v1-2
             (set! sv-32 (string->sound-name (the-as string v1-2)))
             (set! sv-48 (res-lump-data (the-as res-lump arg0) 'cycle-speed (pointer float)))
             (let* ((sv-64 (new 'static 'res-tag))
                    (v1-8
                      (the-as
                        (pointer float)
                        ((method-of-type res-lump get-property-data)
                         (the-as res-lump arg0)
                         'effect-param
                         'exact
                         arg2
                         (the-as pointer #f)
                         (& sv-64)
                         *res-static-buf*
                         )
                        )
                      )
                    )
               (when v1-8
                 (set! sv-52 v1-8)
                 (set! sv-56 (the-as int (-> sv-64 elt-count)))
                 )
               )
             )
           )
         )
        ((sound-spec)
         (set! sv-16 (the-as sound-spec arg0))
         (set! sv-32 (-> sv-16 info name))
         )
        ((string)
         (set! sv-32 (string->sound-name (the-as string arg0)))
         )
        (else
          (format 0 "ERROR: ambient sound was told to play an unknown ~A.~%" arg0)
          )
        )
      (the-as
        ambient-sound
        (cond
          ((nonzero? sv-32)
           (let ((s5-1 (object-new allocation type-to-make (the-as int (-> type-to-make size)))))
             (cond
               (sv-16
                 (quad-copy! (the-as pointer (-> s5-1 spec)) (the-as pointer sv-16) 4)
                 )
               (else
                 (set! (-> s5-1 spec volume) 1024)
                 (set! (-> s5-1 spec pitch-mod) 0)
                 (effect-param->sound-spec (-> s5-1 spec) sv-52 sv-56 (the-as process-focusable pp))
                 (when (and (>= (-> sv-32 char0) (the-as uint 65)) (>= (the-as uint 90) (-> sv-32 char0)))
                   (if (and (nonzero? (-> sv-32 char0))
                            (>= (-> sv-32 char0) (the-as uint 65))
                            (>= (the-as uint 90) (-> sv-32 char0))
                            )
                       (set! sv-32 (copy-and-set-field sv-32 char0 (+ (-> sv-32 char0) 32)))
                       )
                   (if (and (nonzero? (-> sv-32 char1))
                            (>= (-> sv-32 char1) (the-as uint 65))
                            (>= (the-as uint 90) (-> sv-32 char1))
                            )
                       (set! sv-32 (copy-and-set-field sv-32 char1 (+ (-> sv-32 char1) 32)))
                       )
                   (if (and (nonzero? (-> sv-32 char2))
                            (>= (-> sv-32 char2) (the-as uint 65))
                            (>= (the-as uint 90) (-> sv-32 char2))
                            )
                       (set! sv-32 (copy-and-set-field sv-32 char2 (+ (-> sv-32 char2) 32)))
                       )
                   (if (and (nonzero? (-> sv-32 char3))
                            (>= (-> sv-32 char3) (the-as uint 65))
                            (>= (the-as uint 90) (-> sv-32 char3))
                            )
                       (set! sv-32 (copy-and-set-field sv-32 char3 (+ (-> sv-32 char3) 32)))
                       )
                   (if (and (nonzero? (-> sv-32 char4))
                            (>= (-> sv-32 char4) (the-as uint 65))
                            (>= (the-as uint 90) (-> sv-32 char4))
                            )
                       (set! sv-32 (copy-and-set-field sv-32 char4 (+ (-> sv-32 char4) 32)))
                       )
                   (if (and (nonzero? (-> sv-32 char5))
                            (>= (-> sv-32 char5) (the-as uint 65))
                            (>= (the-as uint 90) (-> sv-32 char5))
                            )
                       (set! sv-32 (copy-and-set-field sv-32 char5 (+ (-> sv-32 char5) 32)))
                       )
                   (if (and (nonzero? (-> sv-32 char6))
                            (>= (-> sv-32 char6) (the-as uint 65))
                            (>= (the-as uint 90) (-> sv-32 char6))
                            )
                       (set! sv-32 (copy-and-set-field sv-32 char6 (+ (-> sv-32 char6) 32)))
                       )
                   (if (and (nonzero? (-> sv-32 char7))
                            (>= (-> sv-32 char7) (the-as uint 65))
                            (>= (the-as uint 90) (-> sv-32 char7))
                            )
                       (set! sv-32 (copy-and-set-field sv-32 char7 (+ (-> sv-32 char7) 32)))
                       )
                   (when (and (nonzero? (-> sv-32 char8))
                              (>= (-> sv-32 char8) (the-as uint 65))
                              (>= (the-as uint 90) (-> sv-32 char8))
                              )
                     (let ((v1-136 sv-32))
                       (set! sv-32 (copy-and-set-field v1-136 char8 (+ (-> sv-32 char8) 32)))
                       )
                     )
                   (when (and (nonzero? (-> sv-32 char9))
                              (>= (-> sv-32 char9) (the-as uint 65))
                              (>= (the-as uint 90) (-> sv-32 char9))
                              )
                     (let ((v1-149 sv-32))
                       (set! sv-32 (copy-and-set-field v1-149 char9 (+ (-> sv-32 char9) 32)))
                       )
                     )
                   (when (and (nonzero? (-> sv-32 char10))
                              (>= (-> sv-32 char10) (the-as uint 65))
                              (>= (the-as uint 90) (-> sv-32 char10))
                              )
                     (let ((v1-162 sv-32))
                       (set! sv-32 (copy-and-set-field v1-162 char10 (+ (-> sv-32 char10) 32)))
                       )
                     )
                   (when (and (nonzero? (-> sv-32 char11))
                              (>= (-> sv-32 char11) (the-as uint 65))
                              (>= (the-as uint 90) (-> sv-32 char11))
                              )
                     (let ((v1-173 sv-32))
                       (set! sv-32 (copy-and-set-field v1-173 char11 (+ (-> sv-32 char11) 32)))
                       )
                     )
                   (when (and (nonzero? (-> sv-32 char12))
                              (>= (-> sv-32 char12) (the-as uint 65))
                              (>= (the-as uint 90) (-> sv-32 char12))
                              )
                     (let ((v1-186 sv-32))
                       (set! sv-32 (copy-and-set-field v1-186 char12 (+ (-> sv-32 char12) 32)))
                       )
                     )
                   (when (and (nonzero? (-> sv-32 char13))
                              (>= (-> sv-32 char13) (the-as uint 65))
                              (>= (the-as uint 90) (-> sv-32 char13))
                              )
                     (let ((v1-199 sv-32))
                       (set! sv-32 (copy-and-set-field v1-199 char13 (+ (-> sv-32 char13) 32)))
                       )
                     )
                   (when (and (nonzero? (-> sv-32 char14))
                              (>= (-> sv-32 char14) (the-as uint 65))
                              (>= (the-as uint 90) (-> sv-32 char14))
                              )
                     (let ((v1-212 sv-32))
                       (set! sv-32 (copy-and-set-field v1-212 char14 (+ (-> sv-32 char14) 32)))
                       )
                     )
                   (when (and (nonzero? (-> sv-32 char15))
                              (>= (the-as uint (-> sv-32 char15)) (the-as uint 65))
                              (>= (the-as uint 90) (the-as uint (-> sv-32 char15)))
                              )
                     (let ((v1-223 sv-32))
                       (set! sv-32 (copy-and-set-field v1-223 char15 (+ (-> sv-32 char15) 32)))
                       )
                     )
                   )
                 (set! (-> s5-1 spec info) (sound-info-by-name (the-as string sv-32)))
                 )
               )
             (set! (-> s5-1 playing-id) (new-sound-id))
             (set! (-> s5-1 entity) #f)
             (set! (-> s5-1 sound-count) 1)
             (cond
               (sv-48
                 (set! (-> s5-1 time-base) (the-as time-frame (the int (* 300.0 (-> sv-48 0)))))
                 (set! (-> s5-1 time-random) (the-as time-frame (the int (* 300.0 (-> sv-48 1)))))
                 )
               (else
                 (set! (-> s5-1 time-base) -1)
                 )
               )
             (set! (-> s5-1 spec trans quad) (-> arg1 quad))
             s5-1
             )
           )
          (else
            (the-as ambient-sound 0)
            )
          )
        )
      )
    )
  )

(define *jukebox-time* 0)

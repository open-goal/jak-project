    (+! (-> usage data 0 used) v1-5)
    (+! (-> usage data 0 total) (logand -16 (+ v1-5 15)))
    )
  (dotimes (s3-0 (-> this length))
    (mem-usage (-> this data s3-0) usage flags)
    )
  (the-as drawable-inline-array-actor 0)
  )

(define *additional-spawner-count* 0)

(define *additional-spawners* (new 'static 'array handle 1 (new 'static 'handle)))

(defun register-additional-spawner ((arg0 process))
  (when (>= *additional-spawner-count* 1)

            ((and (nonzero? (-> (the-as process-drawable v1-55) part))
                  (>= (the-as int (-> (the-as process-drawable v1-55) part group)) arg1)
                  (< (the-as int (-> (the-as process-drawable v1-55) part group)) arg2)
                  )
             (format
               #t

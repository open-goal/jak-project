    (dotimes (v1-1 (- *additional-spawner-count* (+ arg0 1)))
      (set! (-> *additional-spawners* (+ v1-1 arg0)) (-> *additional-spawners* (+ arg0 1 v1-1)))
      )
    (let ((v0-0 (+ *additional-spawner-count* -1)))
      (set! *additional-spawner-count* v0-0)
      v0-0
      )
    )
  )


       ((and (logtest? (-> arg0 entity extra kill-mask) (task-mask ctywide))
             (or (= (-> arg3 name) 'ctywide) (= (-> arg3 name) 'waswide))
             )
        (format #t "NOTICE: rogue level entity <task-mask ctywide> ~A still alive~%" arg0)
        (deactivate arg0)

     (deactivate arg0)
     )
    ((= (-> arg0 type) part-tracker)
     (let ((v1-45 (the-as part-tracker arg0)))
       (if (and (nonzero? (-> v1-45 part))
                (>= (the-as int (-> v1-45 part group)) arg1)
                (< (the-as int (-> v1-45 part group)) arg2)

   (max-ang-momentum    float)
   (linear-damping      float)
   (angular-damping     float)
   (bounce-factor       float)
   (friction-factor     float)
   (position            vector      :inline)
   (rot                 vector      :inline)
   (rotation            quaternion  :inline :overlay-at (-> rot data 0))

   (record-count      int32)
   (buffer-len        int32)
   (buffer-size       int32)
   (total-size        int32)
   (rb-debugger-pad1  int32   2)
   (buffer-start      uint32  :inline :dynamic)
   )
  (:methods
    (rb-debugger-method-9 () none)
    (rb-debugger-method-10 () none)
    (rb-debugger-method-11 () none)
    (rb-debugger-method-12 () none)

    )
  0
  )

(defmethod input-handler ((this rb-debugger))
  (when (cpad-pressed? 1 circle)
    (reset! this)
    (set! (-> this user-mode) (rb-debugger-mode recording))
    )
  (logclear! (-> this flags) (rb-debugger-flag rd0))
  (when (cpad-hold? 1 x)
    (logior! (-> this flags) (rb-debugger-flag rd0))
    (set! (-> this user-mode) (rb-debugger-mode play))
    )
  (when (cpad-pressed? 1 square)
    (set! (-> this playback-index) 0)
    (set! (-> this user-mode) (rb-debugger-mode rdm0))
    0
    )
  (if (cpad-pressed? 1 l1)
      (set! (-> this user-mode) (rb-debugger-mode rdm4))
      )
  (if (cpad-pressed? 1 r1)
      (set! (-> this user-mode) (rb-debugger-mode rdm3))
      )
  (if (or (cpad-pressed? 1 up) (cpad-pressed? 1 down))
      (set! (-> this user-mode) (rb-debugger-mode paused))
      )
  (let ((s5-0 1))
    (if (cpad-hold? 1 r2)
        (set! s5-0 4)
        )
    (when (cpad-pressed? 1 left)
      (adjust-playback-index this (- s5-0))
      (set! (-> this user-mode) (rb-debugger-mode paused))
      )
    (when (cpad-pressed? 1 right)
      (adjust-playback-index this s5-0)
      (set! (-> this user-mode) (rb-debugger-mode paused))
      )
    )
  (case (-> this user-mode)
    (((rb-debugger-mode rdm0))
     (set! (-> this hook-control) (rb-hook-control rhc0))
     0
     )
    (((rb-debugger-mode paused))
     (set! (-> this hook-control) (rb-hook-control rhc2))
     (format *stdcon0* "  < PAUSED >")
     )
    (((rb-debugger-mode recording))
     (set! (-> this hook-control) (rb-hook-control rhc3))
     (set! (-> this recorder-index) (rb-debugger-method-11 this (-> this target-count)))
     (set! (-> this playback-index) (-> this recorder-index))
     (format *stdcon0* "  RECORDING")
     )
    (((rb-debugger-mode rdm4))
     (set! (-> this hook-control) (rb-hook-control rhc2))
     (adjust-playback-index this -2)
     (if (zero? (-> this playback-index))
         (set! (-> this user-mode) (rb-debugger-mode paused))
         )
     (format *stdcon0* "  <<<")
     )
    (((rb-debugger-mode rdm3))
     (set! (-> this hook-control) (rb-hook-control rhc2))
     (adjust-playback-index this 2)
     (let ((v1-78 (max 0 (- (-> this record-count) (-> this target-count)))))
       (if (>= (-> this playback-index) v1-78)
           (set! (-> this user-mode) (rb-debugger-mode paused))
           )
       )
     (format *stdcon0* "  >>>")
     )
    (((rb-debugger-mode play))
     (set! (-> this hook-control) (rb-hook-control rhc2))
     (adjust-playback-index this 1)
     (format *stdcon0* "  PLAY >")
     )
    )
  (case (-> this hook-control)
    (((rb-hook-control rhc2) (rb-hook-control rhc3))
     (format
       *stdcon0*
       "  SIM ~s ~d/~d~%"
       (if (logtest? (-> this flags) (rb-debugger-flag rd0))
           "ON "
           "OFF"
           )
       (-> this playback-index)
       (-> this record-count)
       )
     (format *stdcon0* "  debug-targets ~d~%" (-> this target-count))
     (if (zero? (-> this target-count))
         (format *stdcon0* "  <NONE>~%")
         )
     (dotimes (s5-1 (-> this target-count))
       (let ((a3-1 (handle->process (-> this target-array s5-1))))
         (if a3-1
             (format *stdcon0* "  pid ~d ~s~%" (-> a3-1 pid) a3-1)
             (format *stdcon0* "  <INVALID PROCESS>~%")
             )
         )
       )
     )
    )
  0
  (none)
  )


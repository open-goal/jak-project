                    (set! (-> s3-0 0 trans quad) (-> s4-0 position quad))
                    (add-debug-matrix #t (bucket-id debug-no-zbuf1) (-> s3-0 0) (meters 2))
                    )
                  (case (-> this hook-control)
                    (((rb-hook-control rhc2))
                     (cond

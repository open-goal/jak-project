            )
      (set! (-> gp-0 lsphere-count) 0)
      (dotimes (v1-7 (-> gp-0 actor-count))
        (set! (-> gp-0 cshape) (the-as collide-shape-moving (-> gp-0 search-result-array v1-7)))
        (let ((a0-11 (-> gp-0 cshape root-prim)))
          (set! (-> gp-0 group-collide-as) (-> a0-11 prim-core collide-as))
          (when (and (logtest? (-> gp-0 collide-with) (-> gp-0 group-collide-as)) (zero? (-> a0-11 prim-core prim-type)))
            (set! (-> gp-0 prim-count) (the-as int (-> a0-11 specific 0)))
            (let ((a1-10 (-> (the-as collide-shape-prim-group a0-11) child 0)))
              (dotimes (a2-3 (-> gp-0 prim-count))
                (when (and (= (-> a1-10 prim-core prim-type) -1)
                           (> (-> (the-as collide-shape-prim-sphere a1-10) line-sphere-count) 0)
                           (< (-> gp-0 lsphere-count) 4)
                           )
                  (let ((a3-10 (-> gp-0 line-spheres (-> gp-0 lsphere-count))))
                    (set! (-> a3-10 spheres 0 quad) (-> a1-10 prim-core world-sphere quad))
                    (set! (-> a3-10 spheres 1 quad) (-> (the-as collide-shape-prim-group a0-11)
                                                        child
                                                        (-> (the-as collide-shape-prim-sphere a1-10) line-sphere-prim-id)
                                                        prim-core
                                                        world-sphere

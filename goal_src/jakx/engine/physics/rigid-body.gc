;;-*-Lisp-*-
(in-package goal)

;; name: rigid-body.gc
;; name in dgo: rigid-body
;; dgos: ENGINE, GAME

;; +++rb-stack-types
(deftype rigid-body-stack (structure)
  "rigid-body-control::30"
  ((vec vector :inline)
   (mat matrix :inline)
   )
  )

(deftype rigid-body-ang-momentum-stack (structure)
  "rigid-body-control::35"
  ((ang-vel      vector     :inline)
   (ang-mom      vector     :inline)
   (target-rot   quaternion :inline)
   (ang-vel-quat quaternion :inline)
   (rot-conj     quaternion :inline)
   (rot-diff     quaternion :inline)
   (i-world      matrix     :inline)
   )
  )

(deftype line-sphere-hack-stack (structure)
  "collide-sphere-with-line-sphere-hack"
  ((ray-start  sphere :inline)
   (ray-dir    vector :inline)
   (hit-point  vector :inline)
   (line-delta vector :inline)
   (line-dir   vector :inline)
   (line-point vector :inline)
   (unused     vector :inline)
   (normal     vector :inline)
   (u          float)
   (radius     float)
   )
  )

(deftype ray-tube-intersect-stack (structure)
  "ray-tube-intersect"
  ((side       vector :inline)
   (up         vector :inline)
   (axis       vector :inline)
   (tmp        vector :inline)
   (local-pos  vector :inline)
   (local-dir  vector :inline)
   (local-norm vector :inline)
   (local-int  vector :inline)
   (tube-mat   matrix :inline)
   (inv-mat    matrix :inline)
   (len        float)
   (a          float)
   (b          float)
   (c          float)
   (disc       float)
   (t          float)
   (sqrt-disc  float)
   (inv-2a     float)
   (radius     float)
   (t0         float)
   (t1         float)
   (t-min      float)
   (t-max      float)
   (axis-idx   int8)
   )
  )
;; ---rb-stack-types

;; DECOMP BEGINS

(define *debug-move-rigid-body* #t)

(deftype debug-rigid-body-move (structure)
  ((vel-dot-norm     float)
   (time-step-scale  float)
   (best-u           float)
   (i-step           int8)
   (proc2            process-drawable)
   (rbody2           rigid-body-control)
   (best-my-prim     collide-shape-prim)
   (bsphere          sphere              :inline)
   (impact-info      rigid-body-impact   :inline)
   (rbody            rigid-body-control  :inline)
   (pad              uint32              :offset 432)
   )
  )


(deftype rigid-body-work (structure)
  ((max-ang-momentum  float)
   (max-ang-velocity  float)
   (pid               uint32)
   (step-count        int8)
   (debug-history     debug-rigid-body-move  16 :inline)
   )
  )


(define *rigid-body-work* (new 'static 'rigid-body-work))

;; WARN: Return type mismatch int vs object.
(defun-debug debug-draw-rigid-body-move ()
  (let ((gp-0 *rigid-body-work*))
    (dotimes (s5-0 (-> gp-0 step-count))
      (let ((s4-0 (-> gp-0 debug-history s5-0)))
        (draw-debug-x (-> s4-0 impact-info point) (bucket-id debug-no-zbuf1) *color-red*)
        (draw-debug-vector
          (-> s4-0 impact-info point)
          (-> s4-0 impact-info velocity)
          (bucket-id debug-no-zbuf1)
          *color-green*
          (meters 0.00024414062)
          )
        (let ((s3-0 draw-debug-text-3d))
          (format (clear *temp-string*) "~D" s5-0)
          (s3-0
            *temp-string*
            (vector+! (new 'stack-no-clear 'vector) (-> s4-0 impact-info point) (-> s4-0 impact-info velocity))
            (bucket-id debug-no-zbuf1)
            (font-color pink)
            (new 'static 'vector2h :y 8)
            )
          )
        (draw-debug-sphere (-> s4-0 bsphere) (bucket-id debug-no-zbuf1) -1.0 *color-yellow*)
        )
      )
    )
  0
  )

(defmethod new rigid-body-control ((allocation symbol) (type-to-make type) (arg0 process))
  (let ((v0-0 (object-new allocation type-to-make (the-as int (-> type-to-make size)))))
    (set! (-> v0-0 process) arg0)
    v0-0
    )
  )

(defmethod relocate ((this rigid-body-control) (offset int))
  (&+! (-> this process) offset)
  this
  )

(defmethod init-inertia! ((this rigid-body-info))
  (let ((f24-0 (-> this mass))
        (f28-0 (-> this inertial-tensor-box 0))
        (f30-0 (-> this inertial-tensor-box 1))
        (f26-0 (-> this inertial-tensor-box 2))
        )
    (let ((f0-0 f24-0))
      (set! (-> this inv-mass) (/ 1.0 f0-0))
      )
    (matrix-identity! (-> this inertial-tensor))
    (matrix-identity! (-> this inv-inertial-tensor))
    (let ((f0-4 (/ f24-0 12)))
      (set! (-> this inertial-tensor rvec x) (* f0-4 (+ (square f30-0) (square f26-0))))
      (set! (-> this inertial-tensor uvec y) (* f0-4 (+ (square f28-0) (square f26-0))))
      (set! (-> this inertial-tensor fvec z) (* f0-4 (+ (square f28-0) (square f30-0))))
      )
    )
  (let ((f0-6 (-> this inertial-tensor rvec x)))
    (set! (-> this inv-inertial-tensor rvec x) (/ 1.0 f0-6))
    )
  (let ((f0-9 (-> this inertial-tensor uvec y)))
    (set! (-> this inv-inertial-tensor uvec y) (/ 1.0 f0-9))
    )
  (let ((f0-12 (-> this inertial-tensor fvec z)))
    (set! (-> this inv-inertial-tensor fvec z) (/ 1.0 f0-12))
    )
  (let ((f0-15 0.0))
    (dotimes (v1-17 3)
      (set! f0-15 (fmax f0-15 (-> this inertial-tensor vector v1-17 data v1-17)))
      )
    (set! (-> this max-ang-momentum) (* 50.26548 f0-15))
    )
  0
  (none)
  )

;; WARN: Return type mismatch object vs rigid-body-object-constants.
(defmethod get-sym-val ((this rigid-body-object-constants))
  (let ((v0-0 (the-as object #f)))
    (let ((v1-0 (-> this name)))
      (if (nonzero? v1-0)
          (set! v0-0 (-> v1-0 value))
          )
      )
    (the-as rigid-body-object-constants v0-0)
    )
  )

(defun matrix-3x3-triple-transpose-product ((arg0 matrix) (arg1 matrix) (arg2 matrix))
  (let ((s5-0 (new 'stack-no-clear 'inline-array 'matrix 3)))
    (matrix-copy! (-> s5-0 0) arg1)
    (vector-reset! (-> s5-0 0 trans))
    (matrix-transpose! (-> s5-0 1) (-> s5-0 0))
    (matrix*! (-> s5-0 2) arg2 (-> s5-0 0))
    (matrix*! arg0 (-> s5-0 1) (-> s5-0 2))
    )
  arg0
  )

(defmethod reset-force-and-torque! ((this rigid-body-control))
  (set! (-> this force quad) (the-as uint128 0))
  (set! (-> this torque quad) (the-as uint128 0))
  0
  (none)
  )

(defmethod reset-momentum! ((this rigid-body-control))
  (set! (-> this lin-momentum quad) (the-as uint128 0))
  (set! (-> this ang-momentum quad) (the-as uint128 0))
  0
  (none)
  )

(defmethod update-matrix! ((this rigid-body-control))
  (when #t
    (quaternion->matrix (-> this matrix) (the-as quaternion (-> this rot)))
    (let ((s5-0 (new 'stack-no-clear 'inline-array 'vector 1)))
      (vector-rotate*! (-> s5-0 0) (-> this info info cm-offset-joint) (-> this matrix))
      (vector-! (-> this matrix trans) (-> this position) (-> s5-0 0))
      )
    )
  0
  (none)
  )

(defmethod set-transform! ((this rigid-body-control) (arg0 vector) (arg1 quaternion))
  (let ((s3-0 (new 'stack-no-clear 'rigid-body-stack)))
    (quaternion->matrix (-> s3-0 mat) arg1)
    (vector-rotate*! (-> s3-0 vec) (-> this info info cm-offset-joint) (-> s3-0 mat))
    (vector+! (-> this position) arg0 (-> s3-0 vec))
    )
  (quaternion-copy! (the-as quaternion (-> this rot)) arg1)
  (quaternion-normalize! (the-as quaternion (-> this rot)))
  (update-matrix! this)
  0
  (none)
  )

(defmethod set-lin-velocity! ((this rigid-body-control) (arg0 vector))
  (set! (-> this lin-velocity quad) (-> arg0 quad))
  (vector-float*! (-> this lin-momentum) arg0 (-> this info info mass))
  0
  (none)
  )

(defmethod set-ang-velocity! ((this rigid-body-control) (arg0 matrix))
  (let ((s5-0 (new 'stack-no-clear 'inline-array 'matrix 1)))
    (matrix-3x3-triple-transpose-product (-> s5-0 0) (-> this matrix) (-> this info info inertial-tensor))
    (set! (-> this ang-velocity quad) (-> arg0 rvec quad))
    (vector-rotate*! (-> this ang-momentum) (-> arg0 rvec) (-> s5-0 0))
    )
  0
  (none)
  )

(defmethod set-lin-velocity-towards! ((this rigid-body-control) (arg0 vector) (arg1 float))
  (let ((a3-0 (new 'stack-no-clear 'inline-array 'vector 1)))
    (vector-! (-> a3-0 0) arg0 (-> this position))
    (vector-float*! (-> this lin-velocity) (-> a3-0 0) (/ 1.0 arg1))
    )
  (vector-float*! (-> this lin-momentum) (-> this lin-velocity) (-> this info info mass))
  0
  (none)
  )

(defmethod set-ang-momentum-towards! ((this rigid-body-control) (arg0 vector) (arg1 vector))
  (let ((s5-0 (new 'stack-no-clear 'inline-array 'vector 1)))
    (vector-reset! (-> this ang-momentum))
    (get-ang-momentum-towards this (the-as quaternion arg0) (the-as float arg1) (-> s5-0 0))
    (set! (-> this ang-momentum quad) (-> s5-0 0 quad))
    )
  (init-velocities! this)
  0
  (none)
  )

(defmethod get-ang-momentum-towards ((this rigid-body-control) (arg0 quaternion) (arg1 float) (arg2 vector))
  (let ((s4-0 (new 'stack-no-clear 'rigid-body-ang-momentum-stack)))
    (quaternion-copy! (-> s4-0 target-rot) arg0)
    (if (< (quaternion-dot (-> s4-0 target-rot) (the-as quaternion (-> this rot))) 0.0)
        (quaternion-negate! (-> s4-0 target-rot) (-> s4-0 target-rot))
        )
    (quaternion-! (-> s4-0 rot-diff) (-> s4-0 target-rot) (the-as quaternion (-> this rot)))
    (quaternion-conjugate! (-> s4-0 rot-conj) (the-as quaternion (-> this rot)))
    (quaternion*! (-> s4-0 ang-vel-quat) (-> s4-0 rot-diff) (-> s4-0 rot-conj))
    (quaternion-float*! (-> s4-0 ang-vel-quat) (-> s4-0 ang-vel-quat) (/ 2.0 arg1))
    (set! (-> s4-0 ang-vel quad) (-> s4-0 ang-vel-quat quad))
    (set! (-> s4-0 ang-vel w) 1.0)
    (matrix-3x3-triple-transpose-product (-> s4-0 i-world) (-> this matrix) (-> this info info inertial-tensor))
    (vector-rotate*! (-> s4-0 ang-mom) (-> s4-0 ang-vel) (-> s4-0 i-world))
    (vector-! arg2 (-> s4-0 ang-mom) (-> this ang-momentum))
    )
  0
  (none)
  )

(defmethod init! ((this rigid-body-control)
                 (arg0 rigid-body-info)
                 (arg1 vector)
                 (arg2 quaternion)
                 (arg3 (function rigid-body-object float none))
                 )
  (set! (-> this info) (the-as rigid-body-object-constants arg0))
  (set! (-> this force-callback) arg3)
  ((method-of-type rigid-body-info init-inertia!) (-> this info info))
  (let ((v1-2 this))
    (set! (-> v1-2 force quad) (the-as uint128 0))
    (set! (-> v1-2 torque quad) (the-as uint128 0))
    )
  0
  (reset-momentum! this)
  (set-transform! this arg1 arg2)
  (init-velocities! this)
  (set! (-> this linear-damping) (-> arg0 linear-damping))
  (set! (-> this angular-damping) (-> arg0 angular-damping))
  (set! (-> this friction-factor) (-> arg0 friction-factor))
  (set! (-> this bounce-factor) (-> arg0 bounce-factor))
  (set! (-> this max-ang-momentum) (-> arg0 max-ang-momentum))
  0
  (none)
  )

(defmethod get-velocity-at-point ((this rigid-body-control) (arg0 vector) (arg1 vector))
  (let ((v1-0 (new 'stack-no-clear 'inline-array 'vector 2)))
    (vector-! (-> v1-0 0) arg0 (-> this position))
    (vector-cross! (-> v1-0 1) (-> this ang-velocity) (-> v1-0 0))
    (vector+! arg1 (-> v1-0 1) (-> this lin-velocity))
    )
  arg1
  )

(defmethod get-force-at-point ((this rigid-body-control) (arg0 vector) (arg1 vector))
  (let ((v1-0 (new 'stack-no-clear 'inline-array 'vector 2)))
    (vector-! (-> v1-0 0) arg0 (-> this position))
    (vector-cross! (-> v1-0 1) (-> this torque) (-> v1-0 0))
    (vector-float*! (-> v1-0 1) (-> v1-0 1) (/ 1.0 (vector-length-squared (-> v1-0 0))))
    (vector+! arg1 (-> v1-0 1) (-> this force))
    )
  arg1
  )

(defmethod integrate-momentum! ((this rigid-body-control) (arg0 float))
  (vector+*! (-> this lin-momentum) (-> this lin-momentum) (-> this force) arg0)
  (vector+*! (-> this ang-momentum) (-> this ang-momentum) (-> this torque) arg0)
  (let ((f0-2 (-> this max-ang-momentum)))
    (if (< (square f0-2) (vector-length-squared (-> this ang-momentum)))
        (vector-normalize! (-> this ang-momentum) f0-2)
        )
    )
  (set! (-> this force quad) (the-as uint128 0))
  (set! (-> this torque quad) (the-as uint128 0))
  0
  0
  (none)
  )

(defmethod init-velocities! ((this rigid-body-control))
  (let ((v1-0 (-> this info)))
    (vector-float*! (-> this lin-velocity) (-> this lin-momentum) (-> v1-0 info inv-mass))
    (matrix-3x3-triple-transpose-product
      (-> this inv-i-world)
      (-> this matrix)
      (-> v1-0 info inv-inertial-tensor)
      )
    )
  (vector-rotate*! (-> this ang-velocity) (-> this ang-momentum) (-> this inv-i-world))
  0
  (none)
  )

(defmethod integrate-position! ((this rigid-body-control) (arg0 float))
  (vector+*! (-> this position) (-> this position) (-> this lin-velocity) arg0)
  (let ((s4-0 (new 'stack-no-clear 'inline-array 'quaternion 1)))
    (set! (-> s4-0 0 quad) (-> this ang-velocity quad))
    (set! (-> s4-0 0 w) 0.0)
    (quaternion*! (-> s4-0 0) (-> s4-0 0) (the-as quaternion (-> this rot)))
    (quaternion-float*! (-> s4-0 0) (-> s4-0 0) 0.5)
    (+! (-> this rot x) (* (-> s4-0 0 x) arg0))
    (+! (-> this rot y) (* (-> s4-0 0 y) arg0))
    (+! (-> this rot z) (* (-> s4-0 0 z) arg0))
    (+! (-> this rot w) (* (-> s4-0 0 w) arg0))
    )
  (quaternion-normalize! (the-as quaternion (-> this rot)))
  (update-matrix! this)
  0
  (none)
  )

(defun damping-time-adjust ((arg0 float) (arg1 float))
  (let ((f0-0 0.0)
        (f1-0 1.0)
        (f2-2 (* -1.0 arg0 arg1))
        (f3-2 0.016666668)
        )
    (fmax f0-0 (+ f1-0 (* f2-2 (/ 1.0 f3-2))))
    )
  )

(deftype rb-penalty-forces-work (structure)
  ((impact-info    rigid-body-impact  :inline)
   (impact-info2   rigid-body-impact  :inline)
   (force          vector             :inline)
   (tmp            vector             :inline)
   (surf-this      vector             :inline)
   (surf-other     vector             :inline)
   (vel            vector             :inline)
   (vel2           vector             :inline)
   (len2           float)
   (overlap-count  int8)
   (prim-count     int8)
   (prim-ctr       int8)
   (i-cprim        int8)
   (penetrated-by  penetrate)
   )
  )


(defun apply-overlap-penalty-forces ((arg0 collide-shape-moving) (arg1 rigid-body-control))
  (let ((s4-0 (the-as rb-penalty-forces-work #x70002000)))
    (set! (-> s4-0 overlap-count) 0)
    (let ((s3-0 (-> arg0 root-prim)))
      (set! (-> s4-0 prim-count) 1)
      (when (zero? (-> s3-0 prim-core prim-type))
        (let ((v1-3 (the-as collide-shape-prim-group s3-0)))
          (set! s3-0 (-> v1-3 child 0))
          (set! (-> s4-0 prim-count) (the-as int (-> v1-3 num-children)))
          )
        )
      (let ((sv-16 *collide-cache*))
        (set! (-> s4-0 prim-ctr) (-> s4-0 prim-count))
        (while (> (-> s4-0 prim-ctr) 0)
          (let ((v1-7 -1))
            (b! (!= (-> s3-0 prim-core prim-type) v1-7) cfg-21 :delay (nop!))
            )
          (let ((s2-0 (the-as collide-cache-prim (-> sv-16 prims 0 prim-core))))
            (countdown (s1-0 (-> sv-16 num-prims))
              (when (logtest? (-> s3-0 prim-core collide-with) (-> s2-0 prim-core collide-as))
                (set! (-> s4-0 penetrated-by) (penetrate))
                (cond
                  ((>= (-> s2-0 prim-core prim-type) 0)
                   (nop!)
                   0
                   )
                  (else
                    (let ((s0-0 (the-as rigid-body-control #f)))
                      (let ((v1-18 (-> s2-0 prim cshape)))
                        (when v1-18
                          (set! (-> s4-0 penetrated-by) (-> v1-18 penetrated-by))
                          (let ((v1-20 (-> v1-18 process rbody)))
                            (if (nonzero? v1-20)
                                (set! s0-0 v1-20)
                                )
                            )
                          )
                        )
                      (when (not (logtest? (-> s4-0 penetrated-by) (-> arg0 penetrate-using)))
                        (vector-! (-> s4-0 tmp) (-> s3-0 prim-core world-sphere) (-> s2-0 prim-core world-sphere))
                        (set! (-> s4-0 len2) (vector-length-squared (-> s4-0 tmp)))
                        (when (>= (square (+ (-> s3-0 prim-core world-sphere w) (-> s2-0 prim-core world-sphere w))) (-> s4-0 len2))
                          (set! (-> s4-0 impact-info normal quad) (-> s4-0 tmp quad))
                          (vector-normalize! (-> s4-0 impact-info normal) 1.0)
                          (vector+float*!
                            (-> s4-0 surf-other)
                            (-> s2-0 prim-core world-sphere)
                            (-> s4-0 impact-info normal)
                            (-> s2-0 prim-core world-sphere w)
                            )
                          (vector+float*!
                            (-> s4-0 surf-this)
                            (-> s3-0 prim-core world-sphere)
                            (-> s4-0 impact-info normal)
                            (- (-> s3-0 prim-core world-sphere w))
                            )
                          (vector-average! (-> s4-0 impact-info point) (-> s4-0 surf-other) (-> s4-0 surf-this))
                          (get-velocity-at-point arg1 (-> s4-0 impact-info point) (-> s4-0 vel))
                          (when s0-0
                            (get-velocity-at-point s0-0 (-> s4-0 impact-info point) (-> s4-0 vel2))
                            (vector-! (-> s4-0 vel) (-> s4-0 vel) (-> s4-0 vel2))
                            )
                          (set! (-> s4-0 impact-info velocity quad) (-> s4-0 vel quad))
                          (set! (-> s4-0 impact-info impulse) (calc-contact-impulse arg1 s0-0 (-> s4-0 impact-info)))
                          (vector-float*! (-> s4-0 force) (-> s4-0 impact-info normal) (-> s4-0 impact-info impulse))
                          (add-force! arg1 (-> s4-0 force))
                          (integrate-momentum! arg1 1.0)
                          (init-velocities! arg1)
                          (when s0-0
                            (vector-float*! (-> s4-0 tmp) (-> s4-0 force) -1.0)
                            (add-force! s0-0 (-> s4-0 tmp))
                            (integrate-momentum! s0-0 1.0)
                            (init-velocities! s0-0)
                            )
                          0
                          )
                        )
                      )
                    )
                  )
                )
              (&+! s2-0 48)
              )
            )
          (label cfg-21)
          (&+! s3-0 80)
          (+! (-> s4-0 prim-ctr) -1)
          )
        )
      )
    (> (-> s4-0 overlap-count) 0)
    )
  )

(defmethod rbody-step! ((this rigid-body-control) (arg0 collide-shape-moving) (arg1 float))
  (integrate-momentum! this arg1)
  (-> this info)
  (let* ((v1-3 (-> this lin-momentum))
         (a0-2 (-> this lin-momentum))
         (f3-0 (-> this linear-damping))
         (f2-0 arg1)
         (f0-0 0.0)
         (f1-0 1.0)
         (f2-1 (* -1.0 f3-0 f2-0))
         (f3-2 0.016666668)
         )
    (vector-float*! v1-3 a0-2 (fmax f0-0 (+ f1-0 (* f2-1 (/ 1.0 f3-2)))))
    )
  (let* ((v1-5 (-> this ang-momentum))
         (a0-3 (-> this ang-momentum))
         (f3-5 (-> this angular-damping))
         (f2-3 arg1)
         (f0-3 0.0)
         (f1-2 1.0)
         (f2-4 (* -1.0 f3-5 f2-3))
         (f3-7 0.016666668)
         )
    (vector-float*! v1-5 a0-3 (fmax f0-3 (+ f1-2 (* f2-4 (/ 1.0 f3-7)))))
    )
  (init-velocities! this)
  (let ((v1-9 (-> this lin-velocity))
        (f1-4 1638.4)
        )
    (when (and (< (vector-length-squared v1-9) (square f1-4)) (let ((v1-14 (-> this ang-velocity))
                                                                    (f1-7 0.02)
                                                                    )
                                                                (< (vector-length-squared v1-14) (square f1-7))
                                                                )
               )
      (vector-reset! (-> this lin-momentum))
      (vector-reset! (-> this ang-momentum))
      (vector-reset! (-> this lin-velocity))
      (vector-reset! (-> this ang-velocity))
      )
    )
  (rbody-collision arg0 this arg1)
  0
  (none)
  )

(deftype check-line-spheres-hack-params (structure)
  ((time-step  float)
   (mat        matrix)
   (cquery     collide-query)
   (rbody      rigid-body-control)
   )
  )


(deftype hack-line-sphere (structure)
  ((spheres  sphere                     2 :inline)
   (prim     collide-shape-prim-sphere  :offset  28)
   )
  )


(deftype check-line-spheres-hack-work (structure)
  ((fill-sphere          sphere            :inline)
   (fill-delta           vector            :inline)
   (delta                vector            :inline)
   (line-spheres         hack-line-sphere  4 :inline)
   (cshape               collide-shape-moving)
   (collide-with         collide-spec)
   (group-collide-with   collide-spec)
   (group-collide-as     collide-spec)
   (actor-count          int8)

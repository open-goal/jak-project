(deftype ray-tube-intersect-params (structure)
  ((ray-start     sphere  :inline)
   (ray-extrude   vector  :inline)
   (tube-start    vector  :inline)
   (tube-extrude  vector  :inline)
   (tube-radius   float)
   (tt            float)

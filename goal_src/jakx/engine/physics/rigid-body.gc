(defmethod calc-contact-impulse ((this rigid-body-control) (arg0 rigid-body-control) (arg1 rigid-body-impact))
  (let ((gp-0 (new 'stack-no-clear 'inline-array 'vector 3)))
    (set! (-> gp-0 2 x) (+ -4096.0 (vector-dot (-> arg1 velocity) (-> arg1 normal))))
    (set! (-> gp-0 2 w) 0.0)
    (set! (-> gp-0 2 y) 0.0)
    (set! (-> gp-0 2 z) 0.0)
    (when (< (-> gp-0 2 x) 0.0)
      (vector-! (-> gp-0 0) (-> arg1 point) (-> this position))
      (vector-cross! (-> gp-0 1) (-> gp-0 0) (-> arg1 normal))
      (vector-rotate*! (-> gp-0 1) (-> gp-0 1) (-> this inv-i-world))
      (vector-cross! (-> gp-0 1) (-> gp-0 1) (-> gp-0 0))
      (set! (-> gp-0 2 y) (+ (-> this info info inv-mass) (vector-dot (-> arg1 normal) (-> gp-0 1))))
      (when arg0
        (vector-! (-> gp-0 0) (-> arg1 point) (-> arg0 position))
        (vector-cross! (-> gp-0 1) (-> gp-0 0) (-> arg1 normal))
        (vector-rotate*! (-> gp-0 1) (-> gp-0 1) (-> arg0 inv-i-world))
        (vector-cross! (-> gp-0 1) (-> gp-0 1) (-> gp-0 0))
        (set! (-> gp-0 2 z) (+ (-> arg0 info info inv-mass) (vector-dot (-> arg1 normal) (-> gp-0 1))))
        )
      (set! (-> gp-0 2 w) (* (- (-> gp-0 2 x)) (/ 1.0 (+ (-> gp-0 2 y) (-> gp-0 2 z)))))
      )
    (-> gp-0 2 w)
    )
  )

;; WARN: Found some very strange gotos. Check result carefully, this is not well tested.
(defmethod rbody-collision ((this collide-shape-moving) (arg0 rigid-body-control) (arg1 float))
  (rlet ((acc :class vf)
         (Q :class vf)
         (vf0 :class vf)

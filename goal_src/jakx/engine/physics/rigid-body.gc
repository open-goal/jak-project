            (set! s3-0 (-> (the-as collide-shape-prim-group v1-12) child 0))
            )
          (dotimes (s2-0 (-> gp-0 prim-count))
            (when (= (-> s3-0 prim-core prim-type) -1)
              (.lvf vf5 (&-> s3-0 local-sphere quad))
              (.lvf vf1 (&-> s4-1 rvec quad))
              (.lvf vf2 (&-> s4-1 uvec quad))
              (.lvf vf3 (&-> s4-1 fvec quad))
              (.lvf vf4 (&-> s4-1 trans quad))
              (.lvf vf6 (&-> s3-0 prim-core world-sphere quad))

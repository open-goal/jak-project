        (.add.mul.z.vf acc vf3 vf5 acc)
        (.add.mul.w.vf.xyz vf7 vf4 vf0 acc)
        (.sub.vf.xyz vf8 vf7 vf6)
        (.svf (&-> arg2 move-dist quad) vf8)
        (set! sv-36 (the-as collide-spec (logand (the-as collide-spec sv-32) (-> s3-0 prim-core collide-with))))
        (let ((s1-0 (the-as collide-cache-prim (-> sv-16 prims 0 prim-core))))
          (countdown (s0-0 (-> sv-16 num-prims))
            (when (logtest? sv-36 (-> s1-0 prim-core collide-as))
              (cond
                ((>= (-> s1-0 prim-core prim-type) 0)

              (.add.mul.y.vf acc vf2 vf5 acc)
              (.add.mul.z.vf acc vf3 vf5 acc)
              (.add.mul.w.vf.xyz vf7 vf4 vf0 acc)
              (.sub.vf.xyz vf8 vf7 vf6)
              (.svf (&-> s5-1 move-dist quad) vf8)
              (dotimes (s1-0 (-> gp-0 lsphere-count))
                (let ((a1-12 (-> gp-0 line-spheres s1-0)))
                  (collide-sphere-with-line-sphere-hack s3-0 a1-12 s5-1)

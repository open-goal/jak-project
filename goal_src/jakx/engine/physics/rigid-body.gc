              )
            )
          )
        )
      (b! (zero? (-> gp-0 lsphere-count)) cfg-30 :delay (nop!))
      (let ((v1-12 (-> arg0 root-prim)))
        (set! (-> gp-0 group-collide-with) (-> v1-12 prim-core collide-with))
        (let ((s3-0 v1-12)
              (s4-1 (-> arg1 mat))
              (s5-1 (-> arg1 cquery))
              )
          (set! (-> gp-0 prim-count) 1)
          (when (zero? (-> v1-12 prim-core prim-type))

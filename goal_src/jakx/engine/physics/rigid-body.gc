        (let ((v1-5 s3-0))
          (set! sv-32 (the-as int (-> v1-5 prim-core collide-with)))
          (set! s3-0 (-> (the-as collide-shape-prim-group v1-5) child 0))
          (set! sv-24 (the-as int (-> v1-5 specific 0)))
          )
        )
      (countdown (s2-0 sv-24)
        (let ((v1-7 -1))
          (b! (!= (-> s3-0 prim-core prim-type) v1-7) cfg-13 :delay (nop!))
          )
        (.lvf vf5 (&-> s3-0 local-sphere quad))
        (.lvf vf1 (&-> arg1 rvec quad))
        (.lvf vf2 (&-> arg1 uvec quad))
        (.lvf vf3 (&-> arg1 fvec quad))

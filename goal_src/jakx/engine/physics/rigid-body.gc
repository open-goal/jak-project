(defun ray-tube-intersect ((arg0 ray-tube-intersect-params))
  (let ((s5-0 (new 'stack-no-clear 'ray-tube-intersect-stack)))
    (set! (-> s5-0 len) (vector-length (-> arg0 tube-extrude)))
    (vector-float*! (-> s5-0 axis) (-> arg0 tube-extrude) (/ 1.0 (-> s5-0 len)))
    (set! (-> s5-0 axis-idx) 0)
    (dotimes (v1-4 3)
      (if (< (fabs (-> s5-0 axis data v1-4)) 0.578)
          (set! (-> s5-0 axis-idx) v1-4)
          )
      )
    (vector-reset! (-> s5-0 tmp))
    (set! (-> s5-0 tmp data (-> s5-0 axis-idx)) 1.0)
    (vector+float*! (-> s5-0 side) (-> s5-0 tmp) (-> s5-0 axis) (- (vector-dot (-> s5-0 tmp) (-> s5-0 axis))))
    (vector-normalize! (-> s5-0 side) 1.0)
    (vector-cross! (-> s5-0 up) (-> s5-0 axis) (-> s5-0 side))
    (set! (-> s5-0 tube-mat rvec quad) (-> s5-0 side quad))
    (set! (-> s5-0 tube-mat uvec quad) (-> s5-0 up quad))
    (set! (-> s5-0 tube-mat fvec quad) (-> s5-0 axis quad))
    (set! (-> s5-0 tube-mat trans quad) (-> arg0 tube-start quad))
    (set! (-> s5-0 tube-mat trans w) 1.0)
    (matrix-inverse-of-rot-trans! (-> s5-0 inv-mat) (-> s5-0 tube-mat))
    (set! (-> s5-0 tmp quad) (-> arg0 ray-start quad))
    (set! (-> s5-0 tmp w) 1.0)
    (vector-matrix*! (-> s5-0 local-pos) (-> s5-0 tmp) (-> s5-0 inv-mat))
    (vector-rotate*! (-> s5-0 local-dir) (-> arg0 ray-extrude) (-> s5-0 inv-mat))
    (set! (-> s5-0 radius) (+ (-> arg0 ray-start r) (-> arg0 tube-radius)))
    (set! (-> s5-0 a) (+ (square (-> s5-0 local-dir x)) (square (-> s5-0 local-dir y))))
    (set! (-> s5-0 b)
          (* 2.0 (+ (* (-> s5-0 local-pos x) (-> s5-0 local-dir x)) (* (-> s5-0 local-pos y) (-> s5-0 local-dir y))))
          )
    (set! (-> s5-0 c)
          (- (+ (square (-> s5-0 local-pos x)) (square (-> s5-0 local-pos y))) (square (-> s5-0 radius)))
          )
    (cond
      ((< 0.00000000000000000001 (fabs (-> s5-0 a)))
       (set! (-> s5-0 disc) (- (square (-> s5-0 b)) (* 4.0 (-> s5-0 c) (-> s5-0 a))))
       (b! (>= (-> s5-0 disc) 0.0) cfg-8 :delay #f)
       (set! (-> s5-0 t) -1.0)
       (b! #t cfg-29 :delay (nop!))
       (label cfg-8)
       (set! (-> s5-0 sqrt-disc) (sqrtf (-> s5-0 disc)))
       (set! (-> s5-0 inv-2a) (/ 0.5 (-> s5-0 a)))
       (set! (-> s5-0 t0) (* (+ (- (-> s5-0 b)) (-> s5-0 sqrt-disc)) (-> s5-0 inv-2a)))
       (set! (-> s5-0 t1) (* (- (- (-> s5-0 b)) (-> s5-0 sqrt-disc)) (-> s5-0 inv-2a)))
       (set! (-> s5-0 t-min) (fmin (-> s5-0 t0) (-> s5-0 t1)))
       (set! (-> s5-0 t-max) (fmax (-> s5-0 t0) (-> s5-0 t1)))
       (b! (not (or (< 1.0 (-> s5-0 t-min)) (< (-> s5-0 t-max) 0.0))) cfg-16 :delay (empty-form))
       (set! (-> s5-0 t) -1.0)
       (b! #t cfg-29 :delay (nop!))
       (label cfg-16)
       (set! (-> s5-0 t) (fmax 0.0 (-> s5-0 t-min)))
       )
      (else
        (b! (>= 0.0 (-> s5-0 c)) cfg-19 :delay #f)
        (set! (-> s5-0 t) -1.0)
        (b! #t cfg-29 :delay (nop!))
        (label cfg-19)
        (set! (-> s5-0 t) 0.0)
        )
      )
    (vector+float*! (-> s5-0 tmp) (-> s5-0 local-pos) (-> s5-0 local-dir) (-> s5-0 t))
    (cond
      ((and (>= (-> s5-0 tmp z) 0.0) (>= (-> s5-0 len) (-> s5-0 tmp z)))
       (set! (-> s5-0 local-norm quad) (-> s5-0 tmp quad))
       (set! (-> s5-0 local-norm z) 0.0)
       (vector-normalize! (-> s5-0 local-norm) 1.0)
       (vector-float*! (-> s5-0 local-int) (-> s5-0 local-norm) (-> arg0 tube-radius))
       (set! (-> s5-0 local-int z) (-> s5-0 tmp z))
       (vector-matrix*! (-> arg0 intersect) (-> s5-0 local-int) (-> s5-0 tube-mat))
       (vector-rotate*! (-> arg0 normal) (-> s5-0 local-norm) (-> s5-0 tube-mat))
       )
      (else
        (set! (-> s5-0 t) -1.0)
        )
      )
    (label cfg-29)
    (set! (-> arg0 tt) (-> s5-0 t))
    (-> s5-0 t)
    )
  )


      (label cfg-1)
      (set! (-> s5-0 cquery best-dist) -100000000.0)
      (set! (-> s5-0 cquery best-my-prim) #f)
      (set! (-> s5-0 cquery nav-mesh) #f)
      (set! (-> s5-0 orig-position quad) (-> arg0 position quad))
      (quaternion-copy! (-> s5-0 orig-rotation) (the-as quaternion (-> arg0 rot)))
      (integrate-position! arg0 (* (-> s5-0 time-step-scale) (-> s5-0 time-step)))
      (matrix-copy! (-> s5-0 mat) (-> arg0 matrix))
      (set! (-> arg0 position quad) (-> s5-0 orig-position quad))
      (quaternion-copy! (the-as quaternion (-> arg0 rot)) (-> s5-0 orig-rotation))
      (update-matrix! arg0)
      (transform-rigid-body-prims (-> this root-prim) (-> arg0 matrix))
      (when (and (logtest? (-> arg0 flags) (rigid-body-flag vehicle-line-spheres-hack))
                 (not (logtest? (-> arg0 flags) (rigid-body-flag temp-penetrate-mode)))
                 )
        (let ((a1-6 (new 'stack-no-clear 'check-line-spheres-hack-params)))
          (set! (-> a1-6 rbody) arg0)
          (set! (-> a1-6 mat) (-> s5-0 mat))
          (set! (-> a1-6 cquery) (-> s5-0 cquery))
          (set! (-> a1-6 time-step) (* (-> s5-0 time-step-scale) (-> s5-0 time-step)))
          (check-vehicle-line-spheres-hack this a1-6)
          )
        0
        )
      (collide-with-all-collide-cache-prims this arg0 (-> s5-0 mat) (-> s5-0 cquery))
      (let ((f30-0 (-> s5-0 cquery best-dist)))
        (cond
          ((< f30-0 0.0)
           (integrate-position! arg0 (* (-> s5-0 time-step-scale) (-> s5-0 time-step)))
           (init-velocities! arg0)
           (transform-rigid-body-prims (-> this root-prim) (-> arg0 matrix))
           (set! (-> s5-0 time-step-scale) 0.0)
           )
          ((begin
             (update-from-step-size *touching-list* f30-0)
             (integrate-position! arg0 (* (-> s5-0 time-step-scale) (-> s5-0 time-step) f30-0))
             (set! (-> s5-0 time-step-scale) (- (-> s5-0 time-step-scale) (* f30-0 (-> s5-0 time-step-scale))))
             (init-velocities! arg0)
             (transform-rigid-body-prims (-> this root-prim) (-> arg0 matrix))
             (set! (-> s5-0 rbody2) #f)
             (set! (-> s5-0 proc2) #f)
             (when (-> s5-0 cquery nav-mesh)
               (set! (-> s5-0 proc2)
                     (the-as process-focusable (-> (the-as collide-shape-prim (-> s5-0 cquery nav-mesh)) cshape process))
                     )
               (let ((v1-40 (-> s5-0 proc2 rbody)))
                 (when (nonzero? v1-40)
                   (set! (-> s5-0 rbody2) v1-40)
                   (cond

(defun collide-sphere-with-line-sphere-hack ((arg0 collide-shape-prim) (arg1 hack-line-sphere) (arg2 collide-query))
  (let ((s3-0 (new 'stack-no-clear 'line-sphere-hack-stack)))
    (set! (-> s3-0 ray-start quad) (-> arg0 prim-core world-sphere quad))
    (set! (-> s3-0 ray-dir quad) (-> arg2 move-dist quad))
    (vector-! (-> s3-0 line-delta) (the-as vector (-> arg1 spheres 1)) (the-as vector (-> arg1 spheres)))
    (set! (-> s3-0 line-dir quad) (-> s3-0 line-delta quad))
    (vector-normalize! (-> s3-0 line-dir) 1.0)
    (set! (-> s3-0 radius) (-> arg1 spheres 0 r))
    (set! (-> s3-0 u) (ray-cylinder-intersect
                        (-> s3-0 ray-start)
                        (-> s3-0 ray-dir)
                        (the-as vector (-> arg1 spheres))
                        (-> s3-0 line-dir)
                        (+ (-> s3-0 radius) (-> s3-0 ray-start r))
                        (vector-dot (-> s3-0 line-dir) (-> s3-0 line-delta))
                        (-> s3-0 line-point)
                        )
          )
    (when (and (>= (-> s3-0 u) 0.0) (or (< (-> arg2 best-dist) 0.0) (< (-> s3-0 u) (-> arg2 best-dist))))
      (vector+float*! (-> s3-0 hit-point) (the-as vector (-> s3-0 ray-start)) (-> s3-0 ray-dir) (-> s3-0 u))
      (vector-! (-> s3-0 normal) (-> s3-0 hit-point) (-> s3-0 line-point))
      (vector-normalize! (-> s3-0 normal) 1.0)
      (set! (-> arg2 best-dist) (-> s3-0 u))
      (vector+float*! (-> arg2 best-other-tri intersect) (-> s3-0 line-point) (-> s3-0 normal) (-> s3-0 radius))
      (set! (-> arg2 best-other-tri normal quad) (-> s3-0 normal quad))
      (set! (-> arg2 best-my-prim) arg0)
      (set! (-> arg2 nav-mesh) (the-as collide-cache-prim (-> arg1 prim)))
      (set! (-> arg2 best-other-tri pat) (-> arg1 prim pat))
      )
    )
  (none)
  )

(defun check-vehicle-line-spheres-hack ((arg0 collide-shape-moving) (arg1 check-line-spheres-hack-params))

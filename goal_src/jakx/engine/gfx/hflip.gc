;;-*-Lisp-*-
(in-package goal)

;; name: hflip.gc
;; name in dgo: hflip
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

;; definition for function init-hflip-zbuf
;; WARN: Return type mismatch int vs none.
(defun init-hflip-zbuf ()
  (let ((v1-1 (-> *viewport-array* default)))
    (let ((gp-0 (-> v1-1 hflip-zbuf-dma)))
      (set! (-> (the-as dma-buffer gp-0) base) (&+ (the-as dma-buffer gp-0) 28))
      (set! (-> (the-as dma-buffer gp-0) end)
            (&+ (&+ (the-as dma-buffer gp-0) 28) (the-as int (-> (the-as dma-buffer gp-0) allocated-length)))
            )
      (hflip-zbuf-init (the-as dma-buffer gp-0) v1-1)
      (let ((v1-4 (-> (the-as dma-buffer gp-0) base)))
        (set! (-> (the-as (pointer uint64) v1-4) 0) (the-as uint64 #x6000000000000000))
        (set! (-> (the-as (pointer uint32) v1-4) 2) 0)
        (set! (-> (the-as (pointer uint32) v1-4) 3) 0)
        (set! (-> (the-as dma-buffer gp-0) base) (&+ v1-4 16))
        )
      )
    )
  0
  (none)
  )

;; definition for function hflip-z-buf
;; WARN: Return type mismatch int vs none.
(defun hflip-z-buf ((buf dma-buffer) (vport viewport))
  (let ((v1-0 buf))
    (let ((a3-0 (-> vport hflip-zbuf-dma))
          (a0-1 (-> v1-0 base))
          )
      (let ((a2-1 (the-as uint64 (logior (shl (the-as int (&+ a3-0 28)) 32) (the-as int (new 'static 'dma-tag :id (dma-tag-id call)))))))
        (set! (-> (the-as (pointer uint64) a0-1) 0) a2-1)
        )
      (set! (-> (the-as (pointer uint32) a0-1) 2) 0)
      (set! (-> (the-as (pointer uint32) a0-1) 3) (the-as uint (new 'static 'vif-tag :cmd (vif-cmd flushe))))
      (set! (-> v1-0 base) (&+ a0-1 16))
      )
    )
  (set-dirty-mask!
    (-> *level* level-default)
    9
    (* (* (-> vport screen-sx) (-> vport screen-sy)) 4)
    (the-as int (shl (logand (the-as int (-> vport copy-frame)) #x1ff) 13))
    )
  0
  (none)
  )

;; definition for function hflip-zbuf-init
;; WARN: Return type mismatch int vs none.
(defun hflip-zbuf-init ((buf dma-buffer) (vport viewport))
  (let ((pkt1 (the-as (pointer uint64) (-> buf base))))
    (set! (-> pkt1 0) (the-as uint64 #x1000000c))
    (set! (-> (the-as (pointer uint32) pkt1) 2) 0)
    (set! (-> (the-as (pointer uint32) pkt1) 3) (the-as uint #x5000000c))
    )
  (&+! (-> buf base) 16)
  (let ((gif1 (the-as (pointer uint64) (-> buf base))))
    (set! (-> gif1 0) (the-as uint64 #xb000000000008001))
    (set! (-> gif1 1) (the-as uint64 #xeeeeeeeeeeeeeeee))
    )
  (&+! (-> buf base) 16)
  (let ((regs (the-as (pointer uint64) (-> buf base))))
    (set! (-> regs 0) (-> vport copy-frame))
    (set! (-> regs 1) (the-as uint64 (gs-reg64 frame-1)))
    (set! (-> regs 2) (-> vport zbuf-off))
    (set! (-> regs 3) (the-as uint64 (gs-reg64 zbuf-1)))
    (set! (-> regs 4) (the-as uint64 #x2670225c0))
    (set! (-> regs 5) (the-as uint64 (gs-reg64 tex0-1)))
    (set! (-> regs 6) (the-as uint64 #x30003))
    (set! (-> regs 7) (the-as uint64 (gs-reg64 test-1)))
    (set! (-> regs 8) (the-as uint64 0))
    (set! (-> regs 9) (the-as uint64 (gs-reg64 alpha-1)))
    (set! (-> regs 10) (the-as uint64 342))
    (set! (-> regs 11) (the-as uint64 (gs-reg64 prim)))
    (set! (-> regs 12) (the-as uint64 #x3f80000080808080))
    (set! (-> regs 13) (the-as uint64 (gs-reg64 rgbaq)))
    (set! (-> regs 14) (the-as uint64 0))
    (set! (-> regs 15) (the-as uint64 (gs-reg64 tex1-1)))
    (set! (-> regs 16) (the-as uint64 0))
    (set! (-> regs 17) (the-as uint64 (gs-reg64 miptbp1-1)))
    (set! (-> regs 18) (-> vport clamp))
    (set! (-> regs 19) (the-as uint64 (gs-reg64 clamp-1)))
    (set! (-> regs 20) (the-as uint64 0))
    (set! (-> regs 21) (the-as uint64 (gs-reg64 texa)))
    )
  (&+! (-> buf base) 176)
  (let ((pkt2 (the-as (pointer uint64) (-> buf base))))
    (set! (-> pkt2 0) (the-as uint64 #x10000000))
    (set! (-> (the-as (pointer uint32) pkt2) 2) 0)
    (set! (-> (the-as (pointer uint32) pkt2) 3) (the-as uint #x50000000))
    (&+! (-> buf base) 16)
    (let ((num-strips (sar (-> vport screen-sx) 5))
          (sy (-> vport screen-sy))
          )
      (let ((gif2 (the-as (pointer uint64) (-> buf base))))
        (set! (-> gif2 0) (the-as uint64 (logior (logand num-strips #x7fff) #x4400000000008000)))
        (set! (-> gif2 1) (the-as uint64 #x5353))
        )
      (&+! (-> buf base) 16)
      (let ((x 0))
        (dotimes (i num-strips)
          (let ((vtx (the-as (pointer uint64) (-> buf base))))
            (set! (-> vtx 0) (the-as uint64 (shl x 4)))
            (set! (-> vtx 1) (the-as uint64 (shl x 4)))
            (set! (-> vtx 2) (the-as uint64 (logior (shl (shl sy 4) 16) (shl (+ x 32) 4))))
            (set! (-> vtx 3) (the-as uint64 (logior (shl (shl sy 4) 16) (shl (+ x 32) 4))))
            )
          (&+! (-> buf base) 32)
          (+! x 32)
          )
        )
      )
    (let ((qwc (shr (+ (- 16) (- (the-as int (-> buf base)) (the-as int pkt2))) 4)))
      (cond
        ((zero? qwc)
         (set! (-> buf base) (the-as pointer pkt2))
         )
        (else
         (logior! (-> pkt2 0) (the-as uint64 (the-as uint qwc)))
         (logior! (-> pkt2 1) (the-as uint64 (shl (the-as uint qwc) 32)))
         )
        )
      )
    )
  0
  (none)
  )

(init-hflip-zbuf)

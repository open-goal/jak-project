                (-> *tfrag-work* wait-from-spr)
                )
              )
            (with-dma-buffer-add-bucket ((s1-1 (-> *display* frames (-> *display* on-screen) global-buf))
                                         (-> (new 'static 'array bucket-id 12
                                               (bucket-id tfrag-l0-tfrag)

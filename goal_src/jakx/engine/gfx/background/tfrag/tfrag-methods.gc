    (set! (-> *tfrag-work* vu1-enable-tfrag) (the-as int (logand #x80000 (-> *display* vu1-enable-user))))
    (set! (-> *tfrag-work* vu1-enable-tfrag-scissor) (the-as int (logand #x80000 (-> *display* vu1-enable-user))))
    (set! (-> *tfrag-work* tr-stat-tfrag) (-> *terrain-stats* tfrag-trans))
    (set! (-> *tfrag-work* tr-stat-tfrag-scissor) (-> *terrain-stats* tfrag-scissor-trans))
    (let ((v1-12 (-> *tfrag-work* frag-dists quad)))

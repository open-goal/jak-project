;; WARN: Return type mismatch symbol vs none.
(defun tfrag-vu1-init-buffers ()
  (let ((s5-0 *viewport-array*)
        (gp-0 (view-get-active-index))
        )
    (let ((v1-0 gp-0))
      (-> s5-0 data v1-0)
      (set! (-> s5-0 current-viewport-index) (the-as uint v1-0))
      )
    (dotimes (s5-1 6)
      (let ((s4-0 (-> *level* draw-level s5-1))
            (s3-0 (-> *tfrag-init-table* (+ (* s5-1 2) gp-0)))
            )
        (when s4-0
          (set-subdivide-settings! s4-0)
          (let ((s2-0 (-> s4-0 tfrag-gs-test)))
            (tfrag-vu1-init-buf
              (the-as bucket-id (-> s3-0 tfrag-bucket))
              s2-0
              0
              (-> s4-0 tfrag-last-calls 0)
              (logtest? (-> s4-0 info level-flags) (level-flags use-camera-other))
              )
            (tfrag-scissor-vu1-init-buf
              (the-as bucket-id (-> s3-0 tfrag-scissor-bucket))
              s2-0
              0
              (-> s4-0 tfrag-last-calls 1)
              (logtest? (-> s4-0 info level-flags) (level-flags use-camera-other))
              )
            )
          (tfrag-vu1-init-buf
            (the-as bucket-id (-> s3-0 tfrag-trans-bucket))
            (new 'static 'gs-test :zte #x1 :ztst (gs-ztest greater-equal))
            1
            (-> s4-0 tfrag-last-calls 2)
            (logtest? (-> s4-0 info level-flags) (level-flags use-camera-other))
            )
          (tfrag-scissor-vu1-init-buf
            (the-as bucket-id (-> s3-0 tfrag-scissor-trans-bucket))
            (new 'static 'gs-test :zte #x1 :ztst (gs-ztest greater-equal))
            1
            (-> s4-0 tfrag-last-calls 3)
            (logtest? (-> s4-0 info level-flags) (level-flags use-camera-other))
            )
          (tfrag-vu1-init-buf
            (the-as bucket-id (-> s3-0 tfrag-water-bucket))
            (new 'static 'gs-test :ate #x1 :afail #x1 :zte #x1 :ztst (gs-ztest greater-equal))
            1
            (-> s4-0 tfrag-last-calls 4)
            (logtest? (-> s4-0 info level-flags) (level-flags use-camera-other))
            )
          (tfrag-scissor-vu1-init-buf
            (the-as bucket-id (-> s3-0 tfrag-water-scissor-bucket))
            (new 'static 'gs-test :ate #x1 :afail #x1 :zte #x1 :ztst (gs-ztest greater-equal))
            1
            (-> s4-0 tfrag-last-calls 5)
            (logtest? (-> s4-0 info level-flags) (level-flags use-camera-other))
            )
          )
        )
      )
    )
  (none)
  )


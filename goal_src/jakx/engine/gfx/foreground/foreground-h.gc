(defun vu1-bucket-map ((arg0 int) (arg1 int) (arg2 int) (arg3 merc-mode))
  (-> *bucket-map* (+ (+ (* 120 arg0) (* 12 arg1) (* 6 arg2)) (the-as int arg3)))
  )

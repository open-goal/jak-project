(defun init-time-of-day-context ((arg0 time-of-day-context))
  (set-vector! (-> arg0 title-light-group dir0 color) 1.0 1.0 1.0 1.0)
  (set-vector! (-> arg0 title-light-group ambi color) 1.0 1.0 1.0 1.0)
  (set! (-> arg0 title-light-group dir0 extra x) 1.0)
  (set! (-> arg0 title-light-group ambi extra x) 0.5)
  (set-vector! (-> arg0 rim-light-group dir0 color) 0.0 1.9 2.0 1.0)
  (set-vector! (-> arg0 rim-light-group dir1 color) 0.0 1.9 2.0 1.0)
  (set-vector! (-> arg0 rim-light-group dir2 color) 0.0 1.9 2.0 1.0)
  (set-vector! (-> arg0 rim-light-group ambi color) 0.0 0.0 0.3 1.0)
  (set! (-> arg0 rim-light-group dir0 extra x) 1.0)
  (set! (-> arg0 rim-light-group dir1 extra x) 1.0)
  (set! (-> arg0 rim-light-group dir2 extra x) 1.0)
  (set! (-> arg0 rim-light-group ambi extra x) 1.0)
  (set-vector! (-> arg0 front-rear-light-group dir0 color) 1.0 1.0 1.0 1.0)
  (set-vector! (-> arg0 front-rear-light-group dir1 color) 1.0 1.0 1.0 1.0)
  (set-vector! (-> arg0 front-rear-light-group dir2 color) 1.0 1.0 1.0 1.0)
  (set-vector! (-> arg0 front-rear-light-group ambi color) 1.0 1.0 1.0 1.0)
  (set! (-> arg0 front-rear-light-group dir0 extra x) 1.0)
  (set! (-> arg0 front-rear-light-group dir1 extra x) 1.0)
  (set! (-> arg0 front-rear-light-group dir2 extra x) 0.0)
  (set! (-> arg0 front-rear-light-group ambi extra x) 0.0)
  (set-vector! (-> arg0 filter-color) 1.0 1.0 1.0 1.0)
  (set! (-> arg0 override-enable) #f)
  (when *debug-segment*
    (mem-copy! (the-as pointer *override-mood-color-table*) (the-as pointer *no-cloud-mood-color-table*) 256)
    (mem-copy! (the-as pointer *override-mood-fog-table*) (the-as pointer *no-cloud-clear-mood-fog-table*) 384)
    (dotimes (v1-20 8)
      (set! (-> *override-mood-color-table* data v1-20 lgt-color w) 1.0)
      (set! (-> *override-mood-color-table* data v1-20 amb-color w) 1.0)
      (set! (-> *override-mood-fog-table* data v1-20 fog-color w) 1.0)
      (set! (-> *override-mood-fog-table* data v1-20 fog-dists x)
            (/ (-> *override-mood-fog-table* data v1-20 fog-dists x) METER_LENGTH)
            )
      (set! (-> *override-mood-fog-table* data v1-20 fog-dists y)
            (/ (-> *override-mood-fog-table* data v1-20 fog-dists y) METER_LENGTH)
            )
      (set-vector! (-> *time-of-day-context* times v1-20) 1.0 1.0 1.0 1.0)
      )
    #f
    )
  )

(defun set-filter-color! ((arg0 float) (arg1 float) (arg2 float))
  (set-vector! (-> *time-of-day-context* filter-color) arg0 arg1 arg2 1.0)
  0
  (none)
  )

(defun tod-madd! ((arg0 vector) (arg1 vector) (arg2 vector))
  (local-vars (v0-0 float))
  (rlet ((acc :class vf)
         (vf0 :class vf)
         (vf4 :class vf)
         (vf5 :class vf)
         (vf6 :class vf)
         )
    (init-vf0-vector)
    (.mov vf6 arg2)
    (.lvf vf4 (&-> arg0 quad))
    (.lvf vf5 (&-> arg1 quad))
    (.mul.w.vf acc vf4 vf0)
    (.add.mul.x.vf vf4 vf5 vf6 acc)
    (.svf (&-> arg0 quad) vf4)
    (.mov v0-0 vf4)
    v0-0
    )
  )

;; WARN: Return type mismatch float vs vector.
(defun update-environment-colors ((arg0 time-of-day-context))
  (let* ((v1-0 (-> arg0 light-group))
         (s4-0 (-> v1-0 0 ambi color))
         (s5-0 (new 'stack-no-clear 'vector))
         )
    (let ((s2-0 (-> arg0 current-prt-color))
          (s3-0 (-> arg0 current-env-color))
          )
      (vector4-lerp! s5-0 (-> v1-0 0 dir0 color) (-> v1-0 0 dir1 color) (-> v1-0 0 dir1 extra x))
      (when (and (= (-> s2-0 x) 0.0) (= (-> s2-0 y) 0.0) (= (-> s2-0 z) 0.0))
        (set! (-> s2-0 x) (* 0.5 (+ (-> s4-0 x) (* 0.5 (+ (-> s4-0 x) (-> s5-0 x))))))
        (set! (-> s2-0 y) (* 0.5 (+ (-> s4-0 y) (* 0.5 (+ (-> s4-0 y) (-> s5-0 y))))))
        (set! (-> s2-0 z) (* 0.5 (+ (-> s4-0 z) (* 0.5 (+ (-> s4-0 z) (-> s5-0 z))))))
        (set! (-> s2-0 w) 1.0)
        )
      (when (and (= (-> s3-0 x) 0.0) (= (-> s3-0 y) 0.0) (= (-> s3-0 z) 0.0))
        (set! (-> s3-0 x) (* 48.0 (+ (-> s5-0 x) (* 0.5 (+ (-> s4-0 x) (-> s5-0 x))))))
        (set! (-> s3-0 y) (* 48.0 (+ (-> s5-0 y) (* 0.5 (+ (-> s4-0 y) (-> s5-0 y))))))
        (set! (-> s3-0 z) (* 48.0 (+ (-> s5-0 z) (* 0.5 (+ (-> s4-0 z) (-> s5-0 z))))))
        (set! (-> s3-0 w) 128.0)
        )
      )
    (let* ((f0-23 (fmax (fmax (-> s4-0 x) (-> s4-0 y)) (-> s4-0 z)))
           (f2-15 (fmax (fmax (fmax 0.01 (-> s5-0 z)) (-> s5-0 y)) (-> s5-0 x)))
           (f0-27 (fmin 0.85 (- 1.0 (/ (/ f2-15 2) (+ f0-23 f2-15)))))
           )
      (if (!= (-> arg0 shadow-override) 0.0)
          (set! f0-27 (-> arg0 shadow-override))
          )
      (set-vector! (-> arg0 current-shadow-color) f0-27 f0-27 f0-27 1.0)
      )
    )
  (let ((f0-29 0.0))
    (set! (-> arg0 shadow-override) f0-29)
    (the-as vector f0-29)
    )
  )


;;-*-Lisp-*-
(in-package goal)

;; name: viewport-h.gc
;; name in dgo: viewport-h
;; dgos: ENGINE, GAME

(declare-type viewport-array structure)
(declare-type blit-displays-work structure)

(define-extern *viewport-array* viewport-array)
(define-extern view-get-active-math-camera (function math-camera))
(define-extern *blit-displays-work* blit-displays-work)
(define-extern shadow-make-invert-buf (function none))
(define-extern init-warp (function none))
(define-extern init-hflip-zbuf (function none))

;; DECOMP BEGINS

(deftype viewport (structure)
  ((fog-corner           vector        4 :inline)
   (min-fog-corner       vector        :inline)
   (max-fog-corner       vector        :inline)
   (prev-inv-camera-rot  matrix        :inline)
   (motion-vector        vector        :inline)
   (math-camera          math-camera)
   (index                int32)
   (frame                gs-frame)
   (frame-a              gs-frame)
   (zbuf-on              gs-zbuf)
   (zbuf-off             gs-zbuf)
   (scissor              gs-scissor)
   (clamp                gs-clamp)
   (tex0                 gs-tex0)
   (tex0-24              gs-tex0)
   (copy-frame           gs-frame)
   (copy-tex0            gs-tex0)
   (copy-dma             dma-buffer)
   (hflip-zbuf-dma       dma-buffer)
   (glow-frame-1         gs-frame)
   (glow-tex0-1          gs-tex0)
   (glow-frame-2         gs-frame)
   (glow-tex0-2          gs-tex0)
   (shadow-texoffset     vector        :inline)
   (shadow-texscale      vector        :inline)
   (shadow-invert-frame  gs-frame)
   (shadow-dma-frame     gs-frame)
   (shadow-dma-tex0      gs-tex0)
   (shadow-dma           dma-buffer)
   (warp-shader          adgif-shader  :inline)
   (blur-forward-dma     dma-buffer)
   (blur-reverse-dma     dma-buffer)
   (blur-finish-dma      dma-buffer)
   (blur-sx              int32)
   (blur-sy              int32)
   (blur-hx              int32)
   (blur-hy              int32)
   (blur-cx              int32)
   (blur-cy              int32)
   (blur-frame-0         gs-frame)
   (blur-frame-1         gs-frame)
   (blur-frame-a         gs-frame)
   (blur-tex0-0          gs-tex0)
   (blur-tex0-1          gs-tex0)
   (blur-tex0-a          gs-tex0)
   (blur-clamp           gs-clamp)
   (blur-scissor         gs-scissor)
   (blur-scale           float)
   (screen-maxx          int32)
   (screen-maxy          int32)
   (screen-sx            int32)
   (screen-sy            int32)
   (screen-hx            int32)
   (screen-hy            int32)
   (screen-qx            int32)
   (screen-qy            int32)
   (screen-cx            int32)
   (screen-cy            int32)
   (ratio-x              float)
   (ratio-y              float)
   (minx-on-screen       int32         :offset 672)
   (miny-on-screen       int32)
   (scissor-on-screen    gs-scissor)
   )
  (:methods
    (viewport-method-9 (_type_ dma-buffer) _type_)
    (set-scissor-1 (_type_ dma-buffer) _type_)
    (viewport-method-11 (_type_) none)
    (init-gs-regs (_type_) none)
    (viewport-method-13 (_type_) none)
    (viewport-method-14 (_type_) none)
    (viewport-method-15 (_type_) none)
    )
  )


(deftype viewport-array (structure)
  ((mode                    uint32)
   (num-viewports           uint32)
   (current-viewport-index  uint32)
   (data                    viewport  3 :inline)
   (default                 viewport  :inline :overlay-at (-> data 2))
   )
  (:methods
    (new (symbol type) _type_)
    (viewport-array-method-9 (_type_ viewport) none)
    (set-current-viewport (_type_ uint) viewport)
    (get-current-viewport (_type_) viewport)
    )
  )

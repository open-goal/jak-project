;;-*-Lisp-*-
(in-package goal)

;; name: texture.gc
;; name in dgo: texture
;; dgos: ENGINE, GAME

(define-extern texture-page-default-allocate (function texture-pool texture-page kheap int texture-page))
(define-extern texture-page-login (function texture-id (function texture-pool texture-page kheap int texture-page) kheap texture-page-dir-entry))
(define-extern lookup-texture-by-id (function texture-id texture))
(define-extern adgif-shader<-texture! (function adgif-shader texture adgif-shader))

;; DECOMP BEGINS

(defmethod print ((this texture-page))
  (format
    #t
    "#<texture-page ~S :length ~D :dest #x~X :size ~DK @ #x~X>"
    (-> this name)
    (-> this length)
    (shr (-> this segment 0 dest) 6)
    (shr (+ (-> this size) 255) 8)
    this
    )
  this
  )

(defmethod length ((this texture-page))
  (-> this length)
  )

;; WARN: Return type mismatch uint vs int.
(defmethod asize-of ((this texture-page))
  (the-as int (+ (-> this type size) (* (-> this length) 4)))
  )

(defmethod mem-usage ((this texture-page) (usage memory-usage-block) (flags int))
  (set! (-> usage length) (max 83 (-> usage length)))
  (set! (-> usage data 82 name) "texture")
  (+! (-> usage data 82 count) (-> this length))
  (let ((v1-7 (+ (asize-of this) (* (-> this dram-size) 4))))
    (dotimes (a0-6 (-> this length))
      (if (-> this data a0-6)
          (+! v1-7 112)
          )
      )
    (+! (-> usage data 82 used) v1-7)
    (+! (-> usage data 82 total) (logand -16 (+ v1-7 15)))
    )
  this
  )

(defun texture-bpp ((arg0 gs-psm))
  (case arg0
    (((gs-psm mt8))
     8
     )
    (((gs-psm mt4))
     4
     )
    (((gs-psm ct16) (gs-psm ct16s) (gs-psm mz16) (gs-psm mz16s))
     16
     )
    (else
      32
      )
    )
  )

(defun texture-qwc ((arg0 int) (arg1 int) (arg2 gs-psm))
  (let ((v1-0 (texture-bpp arg2)))
    (/ (+ (* (* arg0 arg1) v1-0) 127) 128)
    )
  )

(defun physical-address ((arg0 pointer))
  (logand #xfffffff arg0)
  )

;; WARN: Return type mismatch symbol vs none.
(defun dma-buffer-add-ref-texture ((arg0 dma-buffer) (arg1 pointer) (arg2 int) (arg3 int) (arg4 gs-psm))
  (let* ((s5-0 (physical-address arg1))
         (v1-0 (texture-qwc arg2 arg3 arg4))
         (a0-3 *display*)
         (a1-3 (* 48 (+ (/ v1-0 #x7fff) 1)))
         )
    (+! (-> a0-3 mem-reserve-size) a1-3)
    (when (not (-> a0-3 dma-buffer-overflow))
      (let ((a3-1 (-> a0-3 frames (-> a0-3 on-screen) global-buf)))
        (if (< (-> a3-1 real-buffer-end) (the-as int (&+ (-> a3-1 base) a1-3)))
            (set! (-> a0-3 dma-buffer-overflow) #t)
            )
        )
      (when (not (-> a0-3 dma-buffer-overflow))
        (while (> v1-0 0)
          (let ((a0-6 (min #x7fff v1-0)))
            (let ((a1-8 (if (= v1-0 a0-6)
                            1
                            0
                            )
                        )
                  )
              (let* ((a2-13 arg0)
                     (a3-3 (the-as object (-> a2-13 base)))
                     )
                (set! (-> (the-as dma-packet a3-3) dma) (new 'static 'dma-tag :qwc #x1 :id (dma-tag-id cnt)))
                (set! (-> (the-as dma-packet a3-3) vif0) (new 'static 'vif-tag))
                (set! (-> (the-as dma-packet a3-3) vif1) (new 'static 'vif-tag :imm #x1 :cmd (vif-cmd direct) :msk #x1))
                (set! (-> a2-13 base) (the-as pointer (&+ (the-as dma-packet a3-3) 16)))
                )
              (let* ((a2-14 arg0)
                     (a3-5 (-> a2-14 base))
                     )
                (set! (-> (the-as (pointer uint64) a3-5) 0)
                      (make-u128 0 (logior (logior (shl #x8000000 32) (shr (shl a0-6 49) 49)) (shr (shl a1-8 63) 48)))
                      )
                (set! (-> (the-as (pointer uint64) a3-5) 1) (the-as uint 0))
                (set! (-> a2-14 base) (&-> (the-as (pointer uint64) a3-5) 2))
                )
              )
            (let* ((a1-14 arg0)
                   (a2-15 (the-as object (-> a1-14 base)))
                   )
              (set! (-> (the-as dma-packet a2-15) dma)
                    (new 'static 'dma-tag :id (dma-tag-id ref) :addr (the-as int s5-0) :qwc a0-6)
                    )
              (set! (-> (the-as dma-packet a2-15) vif0) (new 'static 'vif-tag))
              (set! (-> (the-as dma-packet a2-15) vif1) (new 'static 'vif-tag :cmd (vif-cmd direct) :msk #x1 :imm a0-6))
              (set! (-> a1-14 base) (the-as pointer (&+ (the-as dma-packet a2-15) 16)))
              )
            (&+! s5-0 (* a0-6 16))
            (set! v1-0 (- v1-0 a0-6))
            )
          )
        )
      )
    )
  (none)
  )

(defmethod find-entry ((this texture-page-dir) (arg0 level) (arg1 uint))
  (when (and arg0 (>= (-> arg0 index) 6) (>= 17 (-> arg0 index)))
    (-> arg0 texture-page-dir (-> arg0 loaded-texture-page-count))
    (dotimes (v1-8 11)
      (let ((a0-7 (-> arg0 texture-page-dir v1-8 page)))
        (if (and (nonzero? a0-7) a0-7 (= (-> a0-7 id) arg1))
            (return (-> arg0 texture-page-dir v1-8))
            )
        )
      )
    )
  (let ((v1-14 *texture-page-dir*))
    (if (and (nonzero? arg1) (< (the-as int arg1) (-> v1-14 length)))
        (-> v1-14 entries (the-as int arg1))
        (the-as texture-page-dir-entry #f)
        )
    )
  )

(defmethod print ((this texture))
  (format
    #t
    "#<texture ~20S psm: ~6S  ~4D x ~4D  num-mips: ~D :size ~4DK "
    (-> this name)
    (psm->string (-> this psm))
    (-> this w)
    (-> this h)
    (-> this num-mips)
    (shr (-> this size) 8)
    )
  (dotimes (s5-1 (the-as int (-> this num-mips)))
    (format #t " #x~X/~X" (-> this dest s5-1) (-> this width s5-1))
    )
  (if (< (texture-bpp (-> this psm)) 16)
      (format #t " :clut #x~X/1" (-> this clutdest))
      )
  (format #t " @ #x~X>" this)
  this
  )

(defun gs-find-block ((arg0 int) (arg1 int) (arg2 gs-psm))
  (cond
    ((= arg2 (gs-psm ct32))
     (-> ct32-24-block-table (+ arg0 (* arg1 8)))
     )
    ((= arg2 (gs-psm ct24))
     (-> ct32-24-block-table (+ arg0 (* arg1 8)))
     )
    ((= arg2 (gs-psm ct16))
     (-> ct16-block-table (+ arg0 (* arg1 4)))
     )
    ((= arg2 (gs-psm ct16s))
     (-> ct16s-block-table (+ arg0 (* arg1 4)))
     )
    ((= arg2 (gs-psm mz32))
     (-> mz32-24-block-table (+ arg0 (* arg1 8)))
     )
    ((= arg2 (gs-psm mz24))
     (-> mz32-24-block-table (+ arg0 (* arg1 8)))
     )
    ((= arg2 (gs-psm mz16))
     (-> mz16-block-table (+ arg0 (* arg1 4)))
     )
    ((= arg2 (gs-psm mz16s))
     (-> mz16s-block-table (+ arg0 (* arg1 4)))
     )
    ((= arg2 (gs-psm mt8))
     (-> mt8-block-table (+ arg0 (* arg1 8)))
     )
    ((= arg2 (gs-psm mt4))
     (-> mt4-block-table (+ arg0 (* arg1 4)))
     )
    (else
      0
      )
    )
  )

(defun gs-page-width ((arg0 gs-psm))
  (case arg0
    (((gs-psm ct32) (gs-psm ct24) (gs-psm ct16) (gs-psm ct16s))
     64
     )
    (((gs-psm mt8) (gs-psm mt4))
     128
     )
    (else
      (format #t "Warning: Unknown block width for psm ~D~%" arg0)
      1
      )
    )
  )

(defun gs-page-height ((arg0 gs-psm))
  (case arg0
    (((gs-psm ct32) (gs-psm ct24))
     32
     )
    (((gs-psm ct16) (gs-psm ct16s))
     64
     )
    (((gs-psm mt8))
     64
     )
    (((gs-psm mt4))
     128
     )
    (else
      (format #t "Warning: Unknown block width for psm ~D~%" arg0)
      1
      )
    )
  )

(defun gs-block-width ((arg0 gs-psm))
  (case arg0
    (((gs-psm ct32) (gs-psm ct24))
     8
     )
    (((gs-psm ct16) (gs-psm ct16s) (gs-psm mt8))
     16
     )
    (((gs-psm mt4))
     32
     )
    (else
      (format #t "Warning: Unknown block width for psm ~D~%" arg0)
      1
      )
    )
  )

(defun gs-block-height ((arg0 gs-psm))
  (case arg0
    (((gs-psm ct32) (gs-psm ct24) (gs-psm ct16) (gs-psm ct16s))
     8
     )
    (((gs-psm mt8) (gs-psm mt4))
     16
     )
    (else
      (format #t "Warning: Unknown block width for psm ~D~%" arg0)
      1
      )
    )
  )

(defun gs-largest-block ((arg0 int) (arg1 int) (arg2 gs-psm))
  (let* ((s5-0 (gs-block-width arg2))
         (v1-0 (gs-block-height arg2))
         (a0-6 (* (/ (+ s5-0 -1 arg0) s5-0) s5-0))
         (a1-4 (* (/ (+ v1-0 -1 arg1) v1-0) v1-0))
         (s5-1 (/ a0-6 s5-0))
         (s3-1 (/ a1-4 v1-0))
         (s4-1 0)
         )
    (dotimes (s2-0 s5-1)
      (dotimes (s1-0 s3-1)
        (set! s4-1 (max s4-1 (gs-find-block s2-0 s1-0 arg2)))
        )
      )
    s4-1
    )
  )

(defun gs-blocks-used ((arg0 int) (arg1 int) (arg2 gs-psm))
  (let* ((s4-0 (gs-page-width arg2))
         (v1-0 (gs-page-height arg2))
         (a0-6 (* (/ (+ s4-0 -1 arg0) s4-0) s4-0))
         (a1-4 (* (/ (+ v1-0 -1 arg1) v1-0) v1-0))
         (s3-0 (/ a0-6 s4-0))
         (s1-0 (/ a1-4 v1-0))
         (a0-9 (- arg0 (* (+ s3-0 -1) s4-0)))
         (a1-7 (- arg1 (* (+ s1-0 -1) v1-0)))
         )
    (if (or (< a0-9 s4-0) (< a1-7 v1-0))
        (+ (gs-largest-block a0-9 a1-7 arg2) 1 (* (+ (* s3-0 s1-0) -1) 32))
        (* (* s1-0 s3-0) 32)
        )
    )
  )

(defmethod new texture-pool ((allocation symbol) (type-to-make type))
  (initialize! (object-new allocation type-to-make (the-as int (-> type-to-make size))))
  )

(defmethod allocate-vram-words! ((this texture-pool) (arg0 int))
  (let ((v0-0 (-> this cur)))
    (+! (-> this cur) arg0)
    v0-0
    )
  )

(defmethod get-common-page-slot-by-id ((this texture-pool) (arg0 int))
  -1
  )

(defmethod initialize! ((this texture-pool))
  (set! (-> this cur) 0)
  (set! (-> this top) (-> this cur))
  (set! (-> this allocate-func) texture-page-default-allocate)
  (allocate-defaults this)
  (format #t "font-palette start #x~x~%" (/ (-> this cur) 64))
  (set! (-> this font-palette) (allocate-vram-words! this 64))
  (format #t "font-palette end #x~x~%" (/ (-> this cur) 64))
  (dotimes (v1-8 32)
    (set! (-> this common-page v1-8) (the-as texture-page 0))
    )
  (set! (-> this common-page-mask) 0)
  (set! (-> this texture-enable-user-menu)
        (texture-enable-mask tfrag all-pris shrub alpha water warp sprite hud sky)
        )
  (set! (-> this texture-enable-user)
        (texture-enable-mask tfrag all-pris shrub alpha water warp sprite hud sky)
        )
  (dotimes (v1-13 128)
    (set! (-> this ids v1-13) (the-as uint 0))
    )
  this
  )

(defmethod get-leftover-block-count ((this texture-page) (arg0 int) (arg1 int))
  (let ((v1-0 arg1))
    (dotimes (a2-1 arg0)
      (+! v1-0 (-> this segment a2-1 size))
      )
    (logand (/ v1-0 64) 63)
    )
  )

(defmethod print-usage ((this texture-pool))
  (format #t "--------------------~%")
  (format
    #t
    "texture pool ~DK - ~DK (~DK used, ~DK free)~%"
    (/ (-> this top) 256)
    (/ (-> this cur) 256)
    (/ (- (-> this cur) (-> this top)) 256)
    (/ (- #xfa000 (-> this cur)) 256)
    )
  (format #t "--------------------~%")
  this
  )

(defmethod allocate-segment ((this texture-pool) (arg0 texture-pool-segment) (arg1 int))
  (set! (-> arg0 size) (the-as uint arg1))
  (set! (-> arg0 dest) (the-as uint (allocate-vram-words! this arg1)))
  arg0
  )

(defmethod allocate-defaults ((this texture-pool))
  (format #t "texture start #x~x~%" (/ (-> this cur) 64))
  (allocate-segment this (-> this segment-common) #x47000)
  (format #t "texture end #x~x~%" (/ (-> this cur) 64))
  (set! (-> this cur) #xff000)
  0
  (none)
  )

(defmethod remove-data-from-heap ((this texture-page) (arg0 kheap))
  (set! (-> arg0 current) (-> this segment 0 block-data))
  this
  )

(defun texture-page-default-allocate ((arg0 texture-pool) (arg1 texture-page) (arg2 kheap) (arg3 int))
  (dotimes (s3-0 3)
    (let ((a1-2 (allocate-vram-words! arg0 (the-as int (-> arg1 segment s3-0 size)))))
      (relocate-dests! arg1 a1-2 s3-0)
      )
    )
  (upload-now! arg1 (tex-upload-mode seg0-1-2))
  (remove-data-from-heap arg1 arg2)
  (set! (-> arg1 dram-size) (the-as uint 0))
  (dotimes (v1-12 (-> arg1 length))
    (let ((a0-7 (-> arg1 data v1-12)))
      (when a0-7
        (dotimes (a1-6 3)
          (dotimes (a2-2 3)
            (set! (-> (the-as (pointer int32) (+ (+ (* a1-6 16) (* a2-2 4)) (the-as int a0-7))) 15) 0)
            )
          )
        )
      )
    )
  arg1
  )

(defun texture-page-common-allocate ((arg0 texture-pool) (arg1 texture-page) (arg2 kheap) (arg3 int))
  (let ((s5-0 (-> arg0 segment-common dest)))
    (dotimes (s4-0 3)
      (relocate-dests! arg1 (the-as int s5-0) s4-0)
      (+! s5-0 (-> arg1 segment s4-0 size))
      )
    )
  (set! (-> arg1 dram-size) (-> arg1 size))
  arg1
  )

(defun texture-page-font-allocate ((arg0 texture-pool) (arg1 texture-page) (arg2 kheap) (arg3 int))
  (texture-page-common-allocate arg0 arg1 arg2 arg3)
  (upload-now! arg1 (tex-upload-mode seg0-1-2))
  (remove-data-from-heap arg1 arg2)
  (set! (-> arg1 dram-size) (the-as uint 0))
  (dotimes (v1-4 (-> arg1 length))
    (let ((a0-5 (-> arg1 data v1-4)))
      (when a0-5
        (dotimes (a1-5 3)
          (dotimes (a2-2 3)
            (set! (-> (the-as (pointer int32) (+ (+ (* a1-5 16) (* a2-2 4)) (the-as int a0-5))) 15) 0)
            )
          )
        )
      )
    )
  arg1
  )

(defun locate-sub ((arg0 level) (arg1 int) (arg2 int) (arg3 string))
  (when (or (= (-> arg0 status) 'reserved) (and (or (= (-> arg0 status) 'active)
                                                    (= (-> arg0 status) 'alive)
                                                    (= (-> arg0 status) 'loaded)
                                                    (= (-> arg0 status) 'shutdown)
                                                    )
                                                (-> arg0 display?)
                                                )
            )
    (let ((s3-0 (-> arg0 texture-page-dir (the-as uint arg2) page)))
      (when s3-0
        (let ((s2-0 arg1))
          (dotimes (s1-0 3)
            (relocate-dests! s3-0 arg1 s1-0)
            (+! arg1 (-> s3-0 segment s1-0 size))
            )
          (set! arg1 (shl (sar (+ s2-0 (-> s3-0 vram-size) 4095) 12) 12))
          )
        (if (< #x47000 arg1)
            (format 0 arg3 (/ arg1 256) 1136 (-> arg0 name))
            )
        )
      )
    )
  arg1
  )

(defmethod lay-out-sprite-tex ((this texture-pool))
  (let ((a1-0 0)
        (gp-0 "ERROR: Ran out of texture memory for SPRITE (~dk of ~dk) while loading LEVEL ~A~%")
        )
    (countdown (s5-0 6)
      (let ((a0-2 (-> *level* level s5-0)))
        (set! a1-0 (locate-sub a0-2 a1-0 7 gp-0))
        )
      )
    (locate-sub (-> *level* level-default) a1-0 7 gp-0)
    )
  0
  (none)
  )

(defmethod lay-out-hud-tex ((this texture-pool))
  (let ((a1-0 0)
        (gp-0 "ERROR: Ran out of texture memory for HUD (~dk of ~dk) while loading LEVEL ~A~%")
        )
    (countdown (s5-0 6)
      (let ((a0-2 (-> *level* level s5-0)))
        (set! a1-0 (locate-sub a0-2 a1-0 8 gp-0))
        )
      )
    (let ((s5-1 12)
          (s4-0 17)
          )
      (while (>= s4-0 s5-1)
        (let ((a0-4 (-> *level* level s5-1)))
          (if (= (-> a0-4 status) 'active)
              (set! a1-0 (locate-sub a0-4 a1-0 8 gp-0))
              )
          )
        (+! s5-1 1)
        )
      )
    (locate-sub (-> *level* level-default) a1-0 8 gp-0)
    )
  0
  (none)
  )


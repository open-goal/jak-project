                         (begin (set! v1-4 (-> a0-0 status)) (set! a0-5 'alive) (set! a0-6 (= v1-4 a0-5)) a0-6)
                         (begin (set! v1-5 (-> a0-0 status)) (set! a0-7 'loaded) (set! a0-8 (= v1-5 a0-7)) a0-8)
                         (begin (set! v1-6 (-> a0-0 status)) (set! a0-9 'shutdown) (set! v1-3 (= v1-6 a0-9)))

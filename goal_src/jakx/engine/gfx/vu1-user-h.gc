;; dgos: ENGINE, GAME

;; +++tpage-category
;; TODO - copied from jak 3
(defenum tpage-category
  :type int8
  (tfrag 0) ;;
  (pris 1)
  (shrub 2)
  (alpha 3)
  (water 4)
  (warp 5)
  (pris2 6)
  (sprite 7)
  (hud 8) ;; or map?
  (sky 9)
  (hfrag 10)
  )
;; ---tpage-category

;; +++tpage-category-u32
(defenum tpage-category-u32
  :type uint32
  :copy-entries tpage-category
  )
;; ---tpage-category-u32


;;-*-Lisp-*-
(in-package goal)

;; name: warp.gc
;; name in dgo: warp
;; dgos: GAME

;; DECOMP BEGINS

(defun fx-copy-buf ((buf dma-buffer) (vport viewport))
  "Draw the current framebuffer to texture buffer."
  (let ((pkt (the-as (pointer uint64) (-> buf base))))
    (set! (-> pkt 0) (the-as uint64 (logior (shl (the-as uint (-> vport copy-dma data)) 32) (the-as uint (new 'static 'dma-tag :id (dma-tag-id call))))))
    (set! (-> (the-as (pointer uint32) pkt) 2) 0)
    (set! (-> (the-as (pointer uint32) pkt) 3) (the-as uint (new 'static 'vif-tag :cmd (vif-cmd flushe))))
    )
  (&+! (-> buf base) 16)
  (set-dirty-mask!
    (-> *level* level-default)
    5
    (* (* (-> vport screen-sx) (-> vport screen-sy)) 4)
    (the-as int (shl (logand (the-as int (-> vport copy-frame)) #x1ff) 13))
    )
  0
  (none)
  )

(defun warp-shader-init ((vport viewport))
  "Initialize the warp shader for a viewport."
  (let ((shader (-> vport warp-shader)))
    (set! (-> shader reg-0) (gs-reg64 tex0-1))
    (set! (-> shader tex0) (the-as gs-tex0 (-> vport copy-tex0)))
    (set! (-> shader reg-1) (gs-reg64 tex1-1))
    (set! (-> shader tex1) (the-as gs-tex1 32))
    (set! (-> shader reg-2) (gs-reg64 miptbp1-1))
    (set! (-> shader mip-1) (the-as gs-miptbp-1 0))
    (set! (-> shader clamp) (the-as gs-clamp (-> vport clamp)))
    (set! (-> shader reg-4) (gs-reg64 alpha-1))
    (set! (-> shader alpha) (the-as gs-alpha 0))
    )
  0
  (none)
  )

(defun fx-copy-init ((buf dma-buffer) (vport viewport))
  "Initialize the fx copy DMA list for a viewport."
  (let ((pkt1 (the-as (pointer uint64) (-> buf base))))
    (set! (-> pkt1 0) (the-as uint64 #x1000000c))
    (set! (-> (the-as (pointer uint32) pkt1) 2) 0)
    (set! (-> (the-as (pointer uint32) pkt1) 3) (the-as uint #x5000000c))
    )
  (&+! (-> buf base) 16)
  (let ((gif1 (the-as (pointer uint64) (-> buf base))))
    (set! (-> gif1 0) (the-as uint64 #xb000000000008001))
    (set! (-> gif1 1) (the-as uint64 #xeeeeeeeeeeeeeeee))
    )
  (&+! (-> buf base) 16)
  (let ((regs1 (the-as (pointer uint64) (-> buf base))))
    (set! (-> regs1 0) (-> vport copy-frame))
    (set! (-> regs1 1) (the-as uint64 (gs-reg64 frame-1)))
    (set! (-> regs1 2) (-> vport zbuf-off))
    (set! (-> regs1 3) (the-as uint64 (gs-reg64 zbuf-1)))
    (set! (-> regs1 4) (-> vport tex0-24))
    (set! (-> regs1 5) (the-as uint64 (gs-reg64 tex0-1)))
    (set! (-> regs1 6) (the-as uint64 #x30003))
    (set! (-> regs1 7) (the-as uint64 (gs-reg64 test-1)))
    (set! (-> regs1 8) (the-as uint64 0))
    (set! (-> regs1 9) (the-as uint64 (gs-reg64 alpha-1)))
    (set! (-> regs1 10) (the-as uint64 342))
    (set! (-> regs1 11) (the-as uint64 (gs-reg64 prim)))
    (set! (-> regs1 12) (the-as uint64 #x3f80000080808080))
    (set! (-> regs1 13) (the-as uint64 (gs-reg64 rgbaq)))
    (set! (-> regs1 14) (the-as uint64 0))
    (set! (-> regs1 15) (the-as uint64 (gs-reg64 tex1-1)))
    (set! (-> regs1 16) (the-as uint64 0))
    (set! (-> regs1 17) (the-as uint64 (gs-reg64 miptbp1-1)))
    (set! (-> regs1 18) (-> vport clamp))
    (set! (-> regs1 19) (the-as uint64 (gs-reg64 clamp-1)))
    (set! (-> regs1 20) (the-as uint64 0))
    (set! (-> regs1 21) (the-as uint64 (gs-reg64 texflush)))
    )
  (&+! (-> buf base) 176)
  (let ((pkt2 (the-as (pointer uint64) (-> buf base))))
    (let ((tag-ptr pkt2))
      (set! (-> (the-as (pointer uint32) tag-ptr) 0) 0)
      (set! (-> (the-as (pointer uint32) tag-ptr) 1) #x1000)
      (set! (-> (the-as (pointer uint32) tag-ptr) 2) 0)
      (set! (-> (the-as (pointer uint32) tag-ptr) 3) #x5000)
      (&+! (-> buf base) 16)
      (let* ((strip-count (/ (-> vport screen-sx) 32))
             (gif2 (the-as (pointer uint64) (-> buf base)))
             )
        (set! (-> gif2 0) (logior (the-as uint64 #x4400000000008000) (the-as uint64 strip-count)))
        (set! (-> gif2 1) (the-as uint64 #x5353))
        (&+! (-> buf base) 16)
        (let ((u 0))
          (dotimes (strip strip-count)
            (let ((vert (the-as (pointer uint64) (-> buf base))))
              (set! (-> vert 0) (the-as uint64 (shl u 4)))
              (set! (-> vert 1) (the-as uint64 (logior (the-as uint64 #x7300000000000000) (the-as uint64 (shl (+ u 1792) 4)))))
              (set! (-> vert 2) (the-as uint64 (logior (the-as uint64 (shl (-> vport screen-sy) 20)) (the-as uint64 (shl (+ u 32) 4)))))
              (set! (-> vert 3) (the-as uint64 (logior (the-as uint64 (shl (+ u 1824) 4)) (the-as uint64 (shl (-> vport screen-maxy) 20)))))
              )
            (&+! (-> buf base) 32)
            (+! u 32)
            )
          )
        )
      (let ((qwc (/ (- (the-as int (-> buf base)) (the-as int tag-ptr)) 16)))
        (when (> qwc 0)
          (set! (-> (the-as (pointer uint32) tag-ptr) 0) (the-as uint (+ qwc -1)))
          (set! (-> (the-as (pointer uint32) tag-ptr) 3) (the-as uint (logior #x50000000 (+ qwc -1))))
          )
        )
      )
    )
  (let ((pkt3 (the-as (pointer uint64) (-> buf base))))
    (set! (-> pkt3 0) (the-as uint64 #x10000005))
    (set! (-> (the-as (pointer uint32) pkt3) 2) 0)
    (set! (-> (the-as (pointer uint32) pkt3) 3) (the-as uint #x50000005))
    )
  (&+! (-> buf base) 16)
  (let ((gif3 (the-as (pointer uint64) (-> buf base))))
    (set! (-> gif3 0) (the-as uint64 #x4000000000008001))
    (set! (-> gif3 1) (the-as uint64 #xeeeeeeeeeeeeeeee))
    )
  (&+! (-> buf base) 16)
  (let ((regs3 (the-as (pointer uint64) (-> buf base))))
    (set! (-> regs3 0) (-> vport frame))
    (set! (-> regs3 1) (the-as uint64 (gs-reg64 frame-1)))
    (set! (-> regs3 2) (the-as uint64 #x30009))
    (set! (-> regs3 3) (the-as uint64 (gs-reg64 test-1)))
    (set! (-> regs3 4) (the-as uint64 #x3f80000080c0c0c0))
    (set! (-> regs3 5) (the-as uint64 (gs-reg64 rgbaq)))
    (set! (-> regs3 6) (the-as uint64 0))
    (set! (-> regs3 7) (the-as uint64 (gs-reg64 texflush)))
    )
  (&+! (-> buf base) 64)
  0
  (none)
  )

(defun init-warp ()
  "Initialize warp buffers and shaders for all viewports."
  (dotimes (i 3)
    (let* ((vport (-> *viewport-array* data i))
           (dma-buf (the-as dma-buffer (-> vport copy-dma)))
           )
      (set! (-> dma-buf base) (-> dma-buf data))
      (set! (-> dma-buf end) (&+ (-> dma-buf data) (-> dma-buf allocated-length)))
      (fx-copy-init dma-buf vport)
      (let ((tag (the-as (pointer uint64) (-> dma-buf base))))
        (set! (-> tag 0) (the-as uint64 #x60000000))
        (set! (-> (the-as (pointer uint32) tag) 2) 0)
        (set! (-> (the-as (pointer uint32) tag) 3) 0)
        )
      (&+! (-> dma-buf base) 16)
      (warp-shader-init vport)
      )
    )
  0
  (none)
  )

;; top-level initialization
(init-warp)

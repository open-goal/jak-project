        (.add.vf.xyz vf6 vf4 vf5)
        (.svf (&-> a0-8 quad) vf6)
        )
      )
    (set! (-> arg0 trans w) 1.0)
    (if (cpad-hold? arg1 r1)
        (+! (-> arg0 trans y) 80.0)
        )
    (if (cpad-hold? arg1 r2)
        (+! (-> arg0 trans y) -80.0)

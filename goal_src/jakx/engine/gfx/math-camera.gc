    (.add.vf vf28 vf28 vf30)
    (.max.x.vf.w vf28 vf28 vf0)
    (.svf (&-> arg0 quad) vf28)
    (not (logtest? v1-2 63))
    (.mov v0-1 vf23)
    v0-1
    )
  )

(defun reverse-transform-point! ((arg0 vector) (arg1 vector) (arg2 vector) (arg3 vector))
  (let* ((s1-0 (-> (view-get-active-math-camera) perspective))
         (s2-0 (-> (view-get-active-math-camera) camera-rot))
         (f30-1 (* (/ (-> s1-0 fvec w) (-> s1-0 rvec x)) (-> (view-get-active-math-camera) hmge-scale w)))
         (f28-1 (* (/ (-> s1-0 fvec w) (-> s1-0 uvec y)) (-> (view-get-active-math-camera) hmge-scale w)))
         (s4-1 (vector-rotate*! (new 'stack-no-clear 'vector) arg2 s2-0))
         (v1-0 (vector-matrix*! (new 'stack-no-clear 'vector) arg1 s2-0))
         (f0-8 (/ (+ (* (-> s4-1 x) (-> v1-0 x)) (* (-> s4-1 y) (-> v1-0 y)) (* (-> s4-1 z) (-> v1-0 z)))
                  (+ (* (-> s4-1 x) (-> arg3 x) f30-1) (* (-> s4-1 y) (-> arg3 y) f28-1) (-> s4-1 z))
                  )
               )
         (f1-14 (* (-> arg3 x) f0-8 f30-1))
         (f2-9 (* (-> arg3 y) f0-8 f28-1))
         (s5-1 vector-matrix*!)
         (s4-2 arg0)
         (s3-1 (new 'stack-no-clear 'vector))
         )
    (set! (-> s3-1 x) f1-14)
    (set! (-> s3-1 y) f2-9)
    (set! (-> s3-1 z) f0-8)
    (set! (-> s3-1 w) 1.0)
    (s5-1 s4-2 s3-1 (-> (view-get-active-math-camera) inv-camera-rot))
    )
  arg0
  )


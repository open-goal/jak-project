  (set! (-> this y-clip) arg3)
  (set! (-> this fog-start) 40960.0)
  (set! (-> this fog-end) 819200.0)
  (set! (-> this fog-max) 255.0)
  (set! (-> this fog-min) 150.0)
  (matrix-identity! (-> this inv-camera-rot))
  (matrix-identity! (-> this camera-rot))
  (vector-reset! (-> this trans))
  (quaternion-identity! (-> this quat-other))
  (set-vector! (-> this trans-other) 0.0 0.0 0.0 1.0)
  (matrix-identity! (-> this inv-camera-rot-other))
  (matrix-identity! (-> this camera-rot-other))
  (matrix-identity! (-> this camera-temp-other))
  (set! (-> this isometric rvec x) 1.0)
  (set! (-> this isometric uvec y) 0.5)
  (set! (-> this isometric fvec z) -1.0)
  (set! (-> this reset) 1)

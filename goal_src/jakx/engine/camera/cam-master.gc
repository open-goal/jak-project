            )
      (let ((f0-9 (cam-slave-get-float s5-0 'stringMaxLength (-> *CAMERA-bank* default-string-max-z))))
        (if (< 405504.0 f0-9)
            (set! f0-9 (-> *CAMERA-bank* default-string-max-z))

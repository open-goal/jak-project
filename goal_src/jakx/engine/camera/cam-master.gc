  )

(defun cam-master-activate-slave ((arg0 symbol))
  (when (and (view-get-active-camera)
             (or arg0
                 (not (-> (the-as camera-master (view-get-active-camera)) slave))
                 (-> (the-as camera-master (view-get-active-camera)) settings entity-or-mode-changed)
                 )
             )
    (when (and arg0 (-> (the-as camera-master (view-get-active-camera)) slave))
      (deactivate (-> (the-as camera-master (view-get-active-camera)) slave 0))
      (set! (-> (the-as camera-master (view-get-active-camera)) slave) (the-as (pointer camera-slave) #f))
      )
    (let* ((s5-0 (-> (the-as camera-master (view-get-active-camera)) settings))
           (gp-1 (entity-by-name (-> s5-0 real-entity-name)))
           (s4-0 (the-as object (-> s5-0 cam-mode)))
           )
      (if (not (the-as symbol s4-0))
          (set! s4-0 cam-free-floating)
          )
      (send-event (view-get-active-camera) 'set-slave (ppointer->process (process-spawn
                                                                           camera-slave
                                                                           :init cam-slave-init
                                                                           s4-0
                                                                           gp-1
                                                                           :name "camera-slave"
                                                                           :from *camera-dead-pool*
                                                                           :to (view-get-active-camera)
                                                                           )
                                                                         )
                  )
      )
    )
  0
  (none)
  )

(defstate cam-master-active (camera-master)
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (local-vars (v0-1 object) (v1-108 uint))
    (rlet ((acc :class vf)
           (vf0 :class vf)
           (vf4 :class vf)
           (vf5 :class vf)
           (vf6 :class vf)
           (vf7 :class vf)
           )
      (init-vf0-vector)
      (case message
        (('dist-from-interp-src)
         (cond
           ((not (view-get-active-camera-combiner))
            #x48c80000
            )
           ((= (-> (the-as camera-combiner (view-get-active-camera-combiner)) interp-val) 0.0)
            0
            )
           (else
             (-> (the-as camera-combiner (view-get-active-camera-combiner)) dist-from-src)
             )
           )
         )
        (('dist-from-interp-dest)
         (cond
           ((not (view-get-active-camera-combiner))
            0
            )
           ((= (-> (the-as camera-combiner (view-get-active-camera-combiner)) interp-val) 0.0)
            #x48c80000
            )
           (else
             (-> (the-as camera-combiner (view-get-active-camera-combiner)) dist-from-dest)
             )
           )
         )
        (('level-deactivate)
         (format 0 "ERROR <GMJ>: *camera* level-deactivate event not supported anymore~%")
         )
        (('clear-entity)
         (format 0 "ERROR <GMJ>: *camera* clear-entity event not supported anymore~%")
         )
        (('no-intro)
         (format 0 "ERROR <GMJ>: *camera* no-intro event not supported anymore '~S'~%" (-> block param 0))
         )
        (('force-blend)
         (format 0 "ERROR <GMJ>: *camera* force-blend event not supported anymore '~S'~%" (-> block param 0))
         )
        (('teleport-to-transformq)
         (when (> argc 0)
           (let ((gp-1 (the-as object (-> block param 0))))
             (when (-> self slave)
               (deactivate (-> self slave 0))
               (set! (-> self slave) (the-as (pointer camera-slave) #f))
               )
             (set! (-> (the-as vector (-> (view-get-active-camera-combiner) stack)) quad)
                   (-> (the-as matrix gp-1) rvec quad)
                   )
             (quaternion->matrix
               (the-as matrix (&-> (view-get-active-camera-combiner) stack 16))
               (the-as quaternion (+ (the-as uint gp-1) 16))
               )
             )
           (send-event self 'teleport)
           (cam-master-activate-slave #f)
           #t
           )
         )
        (('teleport-to-other-start-string)
         (let ((gp-2 (new 'stack-no-clear 'vector)))
           (when (-> self slave)
             (deactivate (-> self slave 0))
             (set! (-> self slave) (the-as (pointer camera-slave) #f))
             )
           (set! (-> (the-as vector (-> (the-as camera-combiner (view-get-active-camera-combiner)) trans)) quad)
                 (-> *camera-other-trans* quad)
                 )
           (vector-! gp-2 (-> self tpos-curr-adj) *camera-other-trans*)
           (vector-normalize! gp-2 1.0)
           (forward-down->inv-matrix
             (-> (the-as camera-combiner (view-get-active-camera-combiner)) inv-camera-rot)
             gp-2
             (new 'static 'vector :y -1.0)
             )
           )
         (send-event self 'teleport)
         (cam-master-activate-slave #f)
         )
        (('teleport-to-vector-start-string)
         (when (> argc 0)
           (let ((s5-2 (the-as object (-> block param 0)))
                 (gp-3 (new 'stack-no-clear 'vector))
                 )
             (when (-> self slave)
               (deactivate (-> self slave 0))
               (set! (-> self slave) (the-as (pointer camera-slave) #f))
               )
             (set! (-> (the-as vector (-> (the-as camera-combiner (view-get-active-camera-combiner)) trans)) quad)
                   (-> (the-as vector s5-2) quad)
                   )
             (vector-! gp-3 (-> self tpos-curr-adj) (the-as vector s5-2))
             (vector-normalize! gp-3 1.0)
             (forward-down->inv-matrix
               (-> (the-as camera-combiner (view-get-active-camera-combiner)) inv-camera-rot)
               gp-3
               (new 'static 'vector :y -1.0)
               )
             )
           (send-event self 'teleport)
           (cam-master-activate-slave #f)
           )
         )
        (('change-target)
         (let ((a1-15 (-> block param 0)))
           (cond
             ((not a1-15)
              (clear-focused (-> self focus))
              (logclear! (-> self master-options) (cam-master-options-u32 HAVE_TARGET))
              )
             (else
               (focus-on! (-> self focus) (the-as process-focusable a1-15))
               (logior! (-> self master-options) (cam-master-options-u32 HAVE_TARGET))
               (reset-target-tracking)
               )
             )
           )
         (set! (-> (the-as camera-combiner (view-get-active-camera-combiner)) tracking no-follow) #f)
         #f
         )
        (('intro-done?)
         (or (not (-> self slave)) (>= (-> self slave 0 intro-t) 1.0))
         )
        (('query-state)
         (and (-> self slave) (= (-> self slave 0 next-state) (-> block param 0)))
         )
        (('change-to-entity-by-name)
         (format
           0
           "ERROR <GMJ>: *camera* change-to-entity-by-name event not supported anymore '~S'~%"
           (-> block param 0)
           )
         )
        (('change-state)
         (format 0 "ERROR <GMJ>: *camera* change-state event not supported anymore ~A~%" (-> block param 0))
         )
        (('set-slave)
         (let ((s5-4 (process->ppointer (the-as process (-> block param 0))))
               (s4-0 (-> self settings interp-time))
               (gp-4 (-> self slave))
               )
           (when (and s5-4 (!= s5-4 gp-4))
             (set! (-> self slave) (the-as (pointer camera-slave) s5-4))
             (logior! (-> self master-options) (cam-master-options-u32 SET_COMBINER_AXIS))
             (set! (-> (the-as camera-combiner (view-get-active-camera-combiner)) tracking tilt-adjust target)
                   (-> self slave 0 tracking tilt-adjust target)
                   )
             (cond
               ((or (zero? s4-0) (not gp-4))
                (if (view-get-active-math-camera)
                    (set! (-> (view-get-active-math-camera) reset) 1)
                    )
                (send-event (view-get-active-camera-combiner) 'set-interpolation 0)
                (send-event (view-get-active-camera-combiner) 'stop-tracking)
                (if (= (-> (the-as camera-slave (-> s5-4 0)) blend-to-type) (camera-blend-to-type unknown-2))
                    (send-event (view-get-active-camera-combiner) 'start-tracking (ppointer->process s5-4))
                    )
                )
               ((begin
                  (when (< 0.0 (-> gp-4 0 intro-t-step))
                    (set! (-> self outro-t) (-> gp-4 0 intro-t))
                    (set! (-> self outro-t-step) (/ -5.0 (the float s4-0)))
                    (set! (-> self outro-exit-value) (-> gp-4 0 outro-exit-value))
                    (curve-copy! (-> self outro-curve) (-> gp-4 0 intro-curve))
                    )
                  (if (-> self settings no-intro)
                      (set! (-> self outro-t) 0.0)
                      )
                  (send-event (view-get-active-camera-combiner) 'set-interpolation s4-0)
                  (cond
                    ((= (-> gp-4 0 blend-from-type) (camera-blend-from-type unknown-0))
                     (send-event (ppointer->process (-> self decel)) 'change-state cam-fixed)
                     (send-event (view-get-active-camera-combiner) 'stop-tracking)
                     )
                    (else
                      (send-event (ppointer->process (-> self decel)) 'change-state cam-decel)
                      )
                    )
                  (set! v1-108 (-> (the-as camera-combiner (view-get-active-camera-combiner)) tracking-status))
                  (zero? v1-108)
                  )
                (case (-> (the-as camera-slave (-> s5-4 0)) blend-to-type)
                  (((camera-blend-to-type unknown-0))
                   )
                  (((camera-blend-to-type unknown-1))
                   )
                  (((camera-blend-to-type unknown-2))
                   (if (= (-> gp-4 0 blend-from-type) (camera-blend-from-type unknown-1))
                       (send-event (view-get-active-camera-combiner) 'copy-tracking (ppointer->process gp-4))
                       (send-event (view-get-active-camera-combiner) 'start-tracking (ppointer->process s5-4))
                       )
                   (set! (-> (the-as camera-combiner (view-get-active-camera-combiner)) tracking-status) (the-as uint 2))
                   )
                  (else
                    (format 0 "unknown blend-to type~%")
                    )
                  )
                )
               ((= v1-108 1)
                (case (-> (the-as camera-slave (-> s5-4 0)) blend-to-type)
                  (((camera-blend-to-type unknown-0))
                   (set! (-> (the-as camera-combiner (view-get-active-camera-combiner)) tracking-status) (the-as uint 3))
                   )
                  (((camera-blend-to-type unknown-1))
                   (set! (-> (the-as camera-combiner (view-get-active-camera-combiner)) tracking-status) (the-as uint 3))
                   )
                  (((camera-blend-to-type unknown-2))
                   )
                  (else
                    (format 0 "unknown blend-to type~%")
                    )
                  )
                )
               ((or (= v1-108 2) (= v1-108 3))
                (case (-> (the-as camera-slave (-> s5-4 0)) blend-to-type)
                  (((camera-blend-to-type unknown-0))
                   (set! (-> (the-as camera-combiner (view-get-active-camera-combiner)) tracking-status) (the-as uint 0))
                   0
                   )
                  (((camera-blend-to-type unknown-1))
                   (set! (-> (the-as camera-combiner (view-get-active-camera-combiner)) tracking-status) (the-as uint 0))
                   0
                   )
                  (((camera-blend-to-type unknown-2))
                   (set! (-> (the-as camera-combiner (view-get-active-camera-combiner)) tracking-status) (the-as uint 2))
                   )
                  (else
                    (format 0 "unknown blend-to type~%")
                    )
                  )
                )
               (else
                 (format 0 "unknown combiner status~%")
                 )
               )
             (if gp-4
                 (deactivate (-> gp-4 0))
                 )
             )
           )
         )
        (('ease-in)
         (cond
           ((< argc 1)
            (set! (-> self ease-t) 0.0)
            (logclear! (-> self master-options) (cam-master-options-u32 HAVE_EASE_TO_POS))
            )
           ((< argc 2)
            (if (< (the-as float (-> block param 0)) (-> self ease-t))
                (set! (-> self ease-t) (the-as float (-> block param 0)))
                )
            (logclear! (-> self master-options) (cam-master-options-u32 HAVE_EASE_TO_POS))
            )
           (else
             (if (< (the-as float (-> block param 0)) (-> self ease-t))
                 (set! (-> self ease-t) (the-as float (-> block param 0)))
                 )
             (set! (-> self ease-to quad) (-> (the-as vector (-> block param 1)) quad))
             (logior! (-> self master-options) (cam-master-options-u32 HAVE_EASE_TO_POS))
             )
           )
         (set! (-> self ease-step) 0.033333335)
         (set! v0-1 (-> self ease-from))
         (set! (-> (the-as vector v0-1) quad) (-> self tpos-curr-adj quad))
         v0-1
         )
        (('damp-up)
         (set! (-> self upspeed) 0.0)
         )
        (('reset-follow)
         (reset-follow (the-as symbol proc))
         )
        (('teleport)
         (reset-target-tracking)
         (if (-> self slave)
             (send-event (ppointer->process (-> self slave)) message)
             )
         (send-event (view-get-active-camera-combiner) message)
         )
        (('toggle-slave-option)
         (logxor! (-> self slave-options) (the-as uint (-> block param 0)))
         (if (-> self slave)
             (logxor! (-> self slave 0 options) (the-as uint (-> block param 0)))
             )
         (when (-> self decel)
           (set! v0-1 (logxor (-> self decel 0 options) (the-as uint (-> block param 0))))
           (set! (-> self decel 0 options) (the-as cam-slave-options-u32 v0-1))
           v0-1
           )
         )
        (('slave-option?)
         (and (-> self slave) (logtest? (-> self slave 0 options) (-> block param 0)))
         )
        (('set-slave-option)
         (when (-> self slave)
           (set! v0-1 (logior (-> self slave 0 options) (-> block param 0)))
           (set! (-> self slave 0 options) (the-as cam-slave-options-u32 v0-1))
           v0-1
           )
         )
        (('clear-slave-option)
         (when (-> self slave)
           (set! v0-1 (logclear (-> self slave 0 options) (-> block param 0)))
           (set! (-> self slave 0 options) (the-as cam-slave-options-u32 v0-1))
           v0-1
           )
         )
        (('no-follow)
         (when (-> self slave)
           (set! (-> self slave 0 tracking no-follow) (the-as basic #t))
           (vector-reset! (-> self slave 0 tracking follow-off))
           )
         (set! (-> (the-as camera-combiner (view-get-active-camera-combiner)) tracking no-follow) (the-as basic #t))
         (set! v0-1 (-> (the-as camera-combiner (view-get-active-camera-combiner)) tracking follow-off))
         (.svf (&-> (the-as vector v0-1) quad) vf0)
         v0-1
         )
        (('yes-follow)
         (if (-> self slave)
             (set! (-> self slave 0 tracking no-follow) #f)
             )
         (set! (-> (the-as camera-combiner (view-get-active-camera-combiner)) tracking no-follow) #f)
         #f
         )
        (('blend-from-as-fixed)
         (let ((t9-76 format)
               (a0-95 0)
               (a1-35 "ERROR <GMJ>: *camera* blend-from-as-fixed event not supported anymore~%")
               )
           (-> block param 0)
           (t9-76 a0-95 a1-35)
           )
         )
        (('point-of-interest)
         (let ((gp-7 (the-as object (-> block param 0))))
           (let ((v1-197 (view-get-active-math-camera)))
             (set! v0-1 (-> v1-197 trans))
             (let ((v1-198 (-> v1-197 inv-camera-rot fvec)))
               (let ((a0-96 (- (-> self interest-dist))))
                 (.mov vf7 a0-96)
                 )
               (.lvf vf5 (&-> v1-198 quad))
               )
             )
           (.lvf vf4 (&-> (the-as vector gp-7) quad))
           )
         (.add.x.vf.w vf6 vf0 vf0)
         (.mul.x.vf.xyz acc vf5 vf7)
         (.add.mul.w.vf.xyz vf6 vf4 vf0 acc)
         (.svf (&-> (the-as vector v0-1) quad) vf6)
         v0-1
         )
        (('part-water-drip)
         (set! (-> self water-drip-time) (the-as uint (current-time)))
         (set! (-> self water-drip-mult) (the-as float (-> block param 0)))
         (set! (-> self water-drip-speed) (the-as float (-> block param 1)))
         )
        (else
          (and (-> self slave) (let ((v1-204 (new 'stack-no-clear 'event-message-block)))
                                 (set! (-> v1-204 from) (process->ppointer proc))
                                 (set! (-> v1-204 num-params) argc)
                                 (set! (-> v1-204 message) message)
                                 (set! (-> v1-204 param 0) (-> block param 0))
                                 (set! (-> v1-204 param 1) (-> block param 1))
                                 (set! (-> v1-204 param 2) (-> block param 2))
                                 (set! (-> v1-204 param 3) (-> block param 3))
                                 (set! (-> v1-204 param 4) (-> block param 4))
                                 (set! (-> v1-204 param 5) (-> block param 5))
                                 (send-event-function (ppointer->process (-> self slave)) v1-204)
                                 )
               )
          )
        )
      )
    )
  :enter (behavior ()
    (let ((v1-1 (process-spawn
                  camera-slave
                  :init cam-slave-init
                  cam-free-floating
                  #f
                  :name "camera-slave"
                  :from *camera-dead-pool*
                  :to self
                  )
                )
          )
      (set! (-> self slave) (the-as (pointer camera-slave) v1-1))
      (if (not v1-1)
          (format 0 "ERROR <GMJ>: first slave failed to activate~%")
          )
      )
    (let ((v1-6 (process-spawn
                  camera-slave
                  :init cam-slave-init
                  cam-fixed
                  #f
                  :name "camera-slave"
                  :from *camera-dead-pool*
                  :to self
                  )
                )
          )
      (set! (-> self decel) (the-as (pointer camera-slave) v1-6))
      (if (not v1-6)
          (format 0 "ERROR <GMJ>: decel failed to activate~%")
          )
      )
    (if (and (nonzero? camera-master-debug) *debug-segment*)
        (add-connection *debug-engine* self camera-master-debug self #f #f)
        )
    )
  :trans (behavior ()
    (when (not (paused?))
      (vector-negate!
        (-> self local-down)
        (vector-normalize-copy! (-> self local-down) (-> *standard-dynamics* gravity) 1.0)
        )
      (cam-master-effect)
      )
    )
  :code (behavior ()
    (until #f
      (set! (-> self string-min target y) (-> self settings string-min-height))
      (set! (-> self string-max target y) (-> self settings string-max-height))
      (set! (-> self string-min target z) (-> self settings string-min-length))
      (set! (-> self string-max target z) (-> self settings string-max-length))
      (when (logtest? (-> self settings master-options) (cam-master-options IMMEDIATE_STRING_MIN_MAX))
        (set! (-> self string-min value y) (-> self settings string-min-height))
        (set! (-> self string-max value y) (-> self settings string-max-height))
        (set! (-> self string-min value z) (-> self settings string-min-length))
        (set! (-> self string-max value z) (-> self settings string-max-length))
        )
      (set! (-> self string-push-z) (fmax (-> self string-min value z) (-> *CAMERA-bank* default-string-push-z)))
      (master-track-target)
      (set! (-> last-try-to-look-at-data horz) 0.0)
      (set! (-> last-try-to-look-at-data vert) 0.0)
      (when (not (paused?))
        (update! (-> self string-min) (the-as vector #f))
        (update! (-> self string-max) (the-as vector #f))
        )
      (set! (-> self string-min value x)
            (fmin (-> self string-min value x) (+ -4.096 (-> self string-max value x)))
            )
      (set! (-> self string-min value y)
            (fmin (-> self string-min value y) (+ -4.096 (-> self string-max value y)))
            )
      (set! (-> self string-min value z)
            (fmin (-> self string-min value z) (+ -4.096 (-> self string-max value z)))
            )
      (suspend)
      )
    #f
    )
  )

(defbehavior cam-master-init camera-master ()
  (stack-size-set! (-> self main-thread) 512)
  (logclear! (-> self mask) (process-mask menu))
  (set! (-> self master-options) (cam-master-options-u32))
  (set! (-> self settings)
        (the-as cam-setting-data (-> *setting-control* cam-settings (view-get-active-index)))
        )
  (set! (-> self slave) (the-as (pointer camera-slave) #f))
  (set! (-> self decel) (the-as (pointer camera-slave) #f))
  (set! (-> self slave-options) (cam-slave-options-u32 JUMP_PITCHES COLLIDE LINE_OF_SIGHT))
  (set! (-> self view-off-param-save) 1.0)
  (set! (-> self changer) (the-as uint (process->ppointer self)))
  (set! (-> self string-push-z) (-> *CAMERA-bank* default-string-push-z))
  (let ((gp-1 (new-stack-vector0)))
    (set! (-> gp-1 y) (-> self settings string-min-height))
    (set! (-> gp-1 z) (-> self settings string-min-length))
    (init (-> self string-min) gp-1 40.96 409.6 0.9)
    (set! (-> gp-1 y) (-> self settings string-max-height))
    (set! (-> gp-1 z) (-> self settings string-max-length))
    (init (-> self string-max) gp-1 40.96 409.6 0.9)
    )
  (set! (-> self outro-t-step) 0.0)
  (reset-to-collide-spec (-> self focus) (collide-spec jak player-list))
  (let ((a1-4 (new-stack-vector0)))
    (tracking-spline-method-10 (-> self target-spline) a1-4)
    )
  (go cam-master-active)
  0
  (none)
  )

;; WARN: Return type mismatch vector vs none.
(defmethod camera-master-method-15 ((this camera-master) (arg0 vector))
  (if (handle->process (-> this focus handle))
      (vector-! arg0 (-> this tpos-curr) (-> this tpos-old))
      (vector-reset! arg0)
      )
  (none)
  )

;; WARN: Return type mismatch vector vs none.
(defmethod camera-master-method-16 ((this camera-master) (arg0 vector))
  (if (and (-> this slave) (-> this slave 0 next-state) (= (-> this slave 0 next-state name) 'cam-string))
      (set! (-> arg0 quad) (-> this slave 0 view-flat quad))
      (vector-reset! arg0)
      )
  (none)
  )

;;-*-Lisp-*-
(in-package goal)

;; name: cam-states-dbg.gc
;; name in dgo: cam-states-dbg
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

(deftype cam-point-watch-bank (basic)
  ((speed      float)
   (rot-speed  degrees)
   )
  )


(define *CAM_POINT_WATCH-bank* (new 'static 'cam-point-watch-bank :speed 1600.0 :rot-speed (degrees 0.6)))

(defstate cam-point-watch (camera-slave)
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('teleport)
       #f
       )
      (else
        (cam-standard-event-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (when (not (-> self enter-has-run))
      (set! (-> self pivot-rad) 40960.0)
      (set! (-> self blend-from-type) (camera-blend-from-type unknown-1))
      (set! (-> self blend-to-type) (camera-blend-to-type unknown-1))
      )
    )
  :code (behavior ()
    (until #f
      (let ((s5-0 (new-stack-vector0))
            (gp-0 (new-stack-vector0))
            )
        (when (not (logtest? (-> (view-get-active-camera) settings master-options) (cam-master-options IGNORE_ANALOG)))
          (let ((f28-0 (analog-input (the-as int (-> *cpad-list* cpads (view-get-active-index) leftx)) 128.0 48.0 110.0 -1.0))
                (f30-0 (analog-input (the-as int (-> *cpad-list* cpads (view-get-active-index) lefty)) 128.0 48.0 110.0 -1.0))
                (f26-0
                  (analog-input (the-as int (-> *cpad-list* cpads (view-get-active-index) rightx)) 128.0 48.0 110.0 -1.0)
                  )
                (f0-0 (analog-input (the-as int (-> *cpad-list* cpads (view-get-active-index) righty)) 128.0 48.0 110.0 -1.0))
                )
            (cond
              ((cpad-hold? (-> *CAMERA-bank* joypad) r2)
               (set! (-> s5-0 y) (- (-> s5-0 y) (* (/ (-> *CAM_POINT_WATCH-bank* rot-speed) 5) (- f26-0))))
               (set! (-> s5-0 x) (- (-> s5-0 x) (* (/ (-> *CAM_POINT_WATCH-bank* rot-speed) 5) (- f0-0))))
               (+! (-> gp-0 x) (* (/ (-> *CAM_POINT_WATCH-bank* speed) 5) f28-0))
               (+! (-> gp-0 z) (* (/ (-> *CAM_POINT_WATCH-bank* speed) 5) f30-0))
               )
              (else
                (set! (-> s5-0 y) (- (-> s5-0 y) (* 2.0 (-> *CAM_POINT_WATCH-bank* rot-speed) (- f26-0))))
                (set! (-> s5-0 x) (- (-> s5-0 x) (* 2.0 (-> *CAM_POINT_WATCH-bank* rot-speed) (- f0-0))))
                (+! (-> gp-0 x) (* 2.0 (-> *CAM_POINT_WATCH-bank* speed) f28-0))
                (+! (-> gp-0 z) (* 2.0 (-> *CAM_POINT_WATCH-bank* speed) f30-0))
                )
              )
            )
          (let ((s4-4 (new-stack-vector0)))
            (let ((s3-0 (new-stack-matrix0)))
              (matrix-axis-angle! s3-0 (the-as vector (-> self tracking)) (- (-> s5-0 x)))
              (vector-matrix*! s4-4 (-> self tracking inv-mat fvec) s3-0)
              (matrix-axis-angle! s3-0 (-> (view-get-active-camera) local-down) (- (-> s5-0 y)))
              (vector-matrix*! s4-4 s4-4 s3-0)
              )
            (forward-down->inv-matrix (-> self tracking inv-mat) s4-4 (-> (view-get-active-camera) local-down))
            )
          (set! (-> self pivot-rad) (- (-> self pivot-rad) (-> gp-0 z)))
          (if (< (-> self pivot-rad) 4096.0)
              (set! (-> self pivot-rad) 4096.0)
              )
          (set-vector! gp-0 0.0 0.0 (- (-> self pivot-rad)) 1.0)
          (vector-matrix*! (the-as vector (-> self stack)) gp-0 (-> self tracking inv-mat))
          )
        )
      (suspend)
      0
      )
    #f
    )
  )

(deftype cam-free-bank (basic)
  ((speed      float)
   (rot-speed  degrees)
   )
  )


(define *CAM_FREE-bank* (new 'static 'cam-free-bank :speed 3000.0 :rot-speed (degrees 1)))

(defun cam-mouse-input ((arg0 camera-master) (arg1 matrix) (arg2 vector) (arg3 vector))
  (with-pp
    (rlet ((acc :class vf)
           (vf0 :class vf)
           (vf4 :class vf)
           (vf5 :class vf)
           (vf6 :class vf)
           (vf7 :class vf)
           )
      (init-vf0-vector)
      (let ((s1-0 (new 'stack-no-clear 'vector)))
        (vector-! s1-0 (-> *mouse* pos 0) (the-as vector (&-> *mouse* oldposx)))
        (if (< (-> (view-get-active-camera) interest-dist) 409.6)
            (set! (-> (view-get-active-camera) interest-dist) 409.6)
            )
        (let ((s2-0 (new 'stack-no-clear 'vector))
              (s0-0 (new 'stack-no-clear 'vector))
              )
          (let ((sv-224 (new 'stack-no-clear 'vector)))
            0.0
            (let ((sv-208 sv-224))
              (let ((sv-176 (-> (view-get-active-math-camera) trans)))
                (let ((sv-192 (-> arg1 fvec)))
                  (let ((v1-10 (-> (view-get-active-camera) interest-dist)))
                    (.mov vf7 v1-10)
                    )
                  (.lvf vf5 (&-> sv-192 quad))
                  )
                (.lvf vf4 (&-> sv-176 quad))
                )
              (.add.x.vf.w vf6 vf0 vf0)
              (.mul.x.vf.xyz acc vf5 vf7)
              (.add.mul.w.vf.xyz vf6 vf4 vf0 acc)
              (.svf (&-> sv-208 quad) vf6)
              )
            (let ((sv-240 s2-0))
              (.lvf vf4 (&-> (-> (view-get-active-math-camera) trans) quad))
              (.lvf vf5 (&-> sv-224 quad))
              (.mov.vf.w vf6 vf0)
              (.sub.vf.xyz vf6 vf4 vf5)
              (.svf (&-> sv-240 quad) vf6)
              )
            )
          (vector-length s2-0)
          (cond
            ((mouse-hold? left)
             (let ((f30-1 (* 72.81778 (-> *mouse* speedy)))
                   (f28-0 (* -72.81778 (-> *mouse* speedx)))
                   )
               (let ((a2-2 (quaternion-vector-angle! (new 'stack-no-clear 'quaternion) (-> arg1 rvec) f30-1)))
                 (vector-orient-by-quat! s0-0 s2-0 a2-2)
                 )
               (let ((a2-4 (quaternion-vector-angle! (new 'stack-no-clear 'quaternion) *y-vector* f28-0)))
                 (vector-orient-by-quat! s0-0 s0-0 a2-4)
                 )
               (vector-! s0-0 s0-0 s2-0)
               (vector-matrix*! s0-0 s0-0 (matrix-4x4-inverse! (new 'stack-no-clear 'matrix) arg1))
               (+! (-> arg3 x) (-> s0-0 x))
               (+! (-> arg3 y) (-> s0-0 y))
               (+! (-> arg3 z) (-> s0-0 z))
               (+! (-> arg2 x) f30-1)
               (set! (-> arg2 y) (+ (-> arg2 y) f28-0))
               )
             )
            ((mouse-hold? right)
             (+! (-> arg3 z) (* (-> s1-0 x) (-> *CAM_FREE-bank* speed)))
             (set! (-> (view-get-active-camera) interest-dist)
                   (- (-> (view-get-active-camera) interest-dist) (* (-> *CAM_FREE-bank* speed) (-> s1-0 x)))
                   )
             (if (< (-> (view-get-active-camera) interest-dist) 409.6)
                 (set! (-> (view-get-active-camera) interest-dist) 409.6)
                 )
             (when (< -8192.0 (vector-dot (-> arg1 fvec) s2-0))
               (let ((s5-1 (new 'static 'vector :data (new 'static 'array float 4 0.0 0.0 0.0 1.0))))
                 (let ((v1-41 s5-1))
                   (let ((a0-13 (-> arg0 settings mouse-tumble-point)))
                     (let ((a1-9 (-> arg1 fvec)))
                       (let ((a2-7 8192.0))
                         (.mov vf7 a2-7)
                         )
                       (.lvf vf5 (&-> a1-9 quad))
                       )
                     (.lvf vf4 (&-> a0-13 quad))
                     )
                   (.add.x.vf.w vf6 vf0 vf0)
                   (.mul.x.vf.xyz acc vf5 vf7)
                   (.add.mul.w.vf.xyz vf6 vf4 vf0 acc)
                   (.svf (&-> v1-41 quad) vf6)
                   )
                 (setting-control-method-11 *setting-control* (view-get-active-index) pp 'mouse-tumble-point 'abs s5-1 0)
                 )
               )
             )
            ((mouse-hold? middle)
             (+! (-> arg3 x) (* (-> s1-0 x) (-> *CAM_FREE-bank* speed)))
             (+! (-> arg3 y) (* (-> s1-0 y) (-> *CAM_FREE-bank* speed)))
             (new 'static 'vector :data (new 'static 'array float 4 0.0 0.0 0.0 1.0))
             #f
             )
            )
          )
        )
      )
    )
  )

(defun cam-free-floating-input ((arg0 camera-master) (arg1 cam-rotation-tracker) (arg2 vector) (arg3 vector) (arg4 symbol) (arg5 int))
  (with-pp
    (when (view-get-active-camera)
      (if (-> arg0 settings mouse-input)
          (cam-mouse-input arg0 (-> arg1 inv-mat) arg2 arg3)
          )
      (let ((s2-1 (and (-> arg0 settings cpad1-skip-buttons) (= arg5 1)))
            (f30-0 (-> *CAM_FREE-bank* speed))
            )
        (if *camera-turbo-free*
            (set! f30-0 (* 10.0 f30-0))
            )
        (cond
          ((logtest? (-> (view-get-active-camera) settings master-options) (cam-master-options IGNORE_ANALOG))
           )
          ((cpad-hold? arg5 r2)
           (when (logtest? (-> (view-get-active-camera) settings master-options) (cam-master-options READ_BUTTONS))
             (if (cpad-hold? arg5 r1)
                 (+! (-> arg3 y)
                     (+ (/ f30-0 5) (analog-input (the-as int (-> *cpad-list* cpads arg5 abutton 9)) 0.0 32.0 230.0 (/ f30-0 5)))
                     )
                 )
             )
           (when (logtest? (-> (view-get-active-camera) settings master-options) (cam-master-options READ_BUTTONS))
             (if (cpad-hold? arg5 l1)
                 (set! (-> arg3 y)
                       (- (-> arg3 y)
                          (+ (/ f30-0 5) (analog-input (the-as int (-> *cpad-list* cpads arg5 abutton 8)) 0.0 32.0 230.0 (/ f30-0 5)))
                          )
                       )
                 )
             )
           )
          (else
            (when (logtest? (-> (view-get-active-camera) settings master-options) (cam-master-options READ_BUTTONS))
              (if (cpad-hold? arg5 r1)
                  (+! (-> arg3 y)
                      (+ f30-0 (analog-input (the-as int (-> *cpad-list* cpads arg5 abutton 9)) 0.0 32.0 230.0 f30-0))
                      )
                  )
              )
            (when (logtest? (-> (view-get-active-camera) settings master-options) (cam-master-options READ_BUTTONS))
              (if (cpad-hold? arg5 l1)
                  (set! (-> arg3 y)
                        (- (-> arg3 y)
                           (+ f30-0 (analog-input (the-as int (-> *cpad-list* cpads arg5 abutton 8)) 0.0 32.0 230.0 f30-0))
                           )
                        )
                  )
              )
            )
          )
        (when (not (logtest? (-> (view-get-active-camera) settings master-options) (cam-master-options IGNORE_ANALOG)))
          (let ((f26-2 (analog-input (the-as int (-> *cpad-list* cpads arg5 leftx)) 128.0 48.0 110.0 -1.0))
                (f28-4 (analog-input (the-as int (-> *cpad-list* cpads arg5 lefty)) 128.0 48.0 110.0 -1.0))
                (f24-0 (analog-input (the-as int (-> *cpad-list* cpads arg5 rightx)) 128.0 48.0 110.0 -1.0))
                (f0-19 (analog-input (the-as int (-> *cpad-list* cpads arg5 righty)) 128.0 48.0 110.0 -1.0))
                )
            (cond
              ((and (not s2-1) (cpad-hold? arg5 r2))
               (cond
                 ((cpad-hold? arg5 l2)
                  (set! (-> arg2 y) (- (-> arg2 y) (* (/ (-> *CAM_FREE-bank* rot-speed) 2) (- f24-0))))
                  (set! (-> arg2 x) (- (-> arg2 x) (* (/ (-> *CAM_FREE-bank* rot-speed) 2) (- f0-19))))
                  )
                 (else
                   (set! (-> arg2 y) (- (-> arg2 y) (* (- f24-0) (-> *CAM_FREE-bank* rot-speed))))
                   (set! (-> arg2 x) (- (-> arg2 x) (* (- f0-19) (-> *CAM_FREE-bank* rot-speed))))
                   )
                 )
               (+! (-> arg3 x) (* (/ f30-0 5) f26-2))
               (+! (-> arg3 z) (* (/ f30-0 5) f28-4))
               )
              ((and (not s2-1) (cpad-hold? arg5 l2))
               (+! (-> arg3 x) (* f26-2 f30-0))
               (+! (-> arg3 y) (* f0-19 f30-0))
               (+! (-> arg3 z) (* f28-4 f30-0))
               )
              (else
                (set! (-> arg2 y) (- (-> arg2 y) (* 2.0 (-> *CAM_FREE-bank* rot-speed) (- f24-0))))
                (set! (-> arg2 x) (- (-> arg2 x) (* 2.0 (-> *CAM_FREE-bank* rot-speed) (- f0-19))))
                (+! (-> arg3 x) (* 2.0 f30-0 f26-2))
                (+! (-> arg3 z) (* 2.0 f30-0 f28-4))
                )
              )
            )
          )
        )
      (when (not (-> arg0 settings mouse-input))
        (vector-float*! arg2 arg2 (-> pp clock time-adjust-ratio))
        (vector-float*! arg3 arg3 (-> pp clock time-adjust-ratio))
        )
      )
    )
  )

(deftype camera-free-floating-move-info (structure)
  ((rv  vector  :inline)
   (tv  vector  :inline)
   (up  vector  :inline)
   (tm  matrix  :inline)
   )
  )


(defun cam-free-floating-move ((arg0 camera-master) (arg1 cam-rotation-tracker) (arg2 vector) (arg3 vector) (arg4 int))
  (rlet ((vf0 :class vf)
         (vf4 :class vf)
         (vf5 :class vf)
         (vf6 :class vf)
         )
    (init-vf0-vector)
    (if (logtest? (-> *cpad-list* cpads arg4 valid) 128)
        (return (the-as vector #f))
        )
    (if (= *master-mode* 'menu)
        (return (the-as vector #f))
        )
    (let ((s3-0 (new 'stack 'camera-free-floating-move-info)))
      (cam-free-floating-input arg0 arg1 (-> s3-0 rv) (-> s3-0 tv) (not arg3) arg4)
      (vector-matrix*! (-> s3-0 tv) (-> s3-0 tv) (-> arg1 inv-mat))
      (cond
        (arg3
          (matrix-axis-angle! (-> s3-0 tm) arg3 (-> s3-0 rv y))
          (matrix*! (-> arg1 inv-mat) (-> arg1 inv-mat) (-> s3-0 tm))
          (cond
            ((< (vector-dot (-> arg1 inv-mat uvec) arg3) 0.0)
             (forward-down->inv-matrix (-> arg1 inv-mat) (-> arg1 inv-mat fvec) arg3)
             )
            (else
              (vector-negate! (-> s3-0 up) arg3)
              (forward-down->inv-matrix (-> arg1 inv-mat) (-> arg1 inv-mat fvec) (-> s3-0 up))
              )
            )
          )
        (else
          (matrix-axis-angle! (-> s3-0 tm) (-> arg1 inv-mat uvec) (- (-> s3-0 rv y)))
          (matrix*! (-> arg1 inv-mat) (-> arg1 inv-mat) (-> s3-0 tm))
          )
        )
      (matrix-axis-angle! (-> s3-0 tm) (-> arg1 inv-mat rvec) (- (-> s3-0 rv x)))
      (matrix*! (-> arg1 inv-mat) (-> arg1 inv-mat) (-> s3-0 tm))
      (matrix-axis-angle! (-> s3-0 tm) (-> arg1 inv-mat fvec) (- (-> s3-0 rv z)))
      (matrix*! (-> arg1 inv-mat) (-> arg1 inv-mat) (-> s3-0 tm))
      (let ((v0-0 arg2))
        (let ((v1-16 (-> s3-0 tv)))
          (.lvf vf4 (&-> arg2 quad))
          (.lvf vf5 (&-> v1-16 quad))
          )
        (.mov.vf.w vf6 vf0)
        (.add.vf.xyz vf6 vf4 vf5)
        (.svf (&-> v0-0 quad) vf6)
        v0-0
        )
      )
    )
  )

(defstate cam-free-floating (camera-slave)
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('teleport)
       #f
       )
      (else
        (cam-standard-event-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (when (not (-> self enter-has-run))
      (set! (-> self blend-from-type) (camera-blend-from-type unknown-1))
      (set! (-> self blend-to-type) (camera-blend-to-type unknown-1))
      (send-event (view-get-active-camera-combiner) 'stop-tracking)
      )
    )
  :code (behavior ()
    (until #f
      (let ((gp-0 (-> (view-get-active-camera) local-down)))
        (if (logtest? (-> self options) (cam-slave-options-u32 ALLOW_Z_ROT))
            (set! gp-0 (the-as vector #f))
            )
        (when (not (-> (view-get-active-camera) settings mouse-input))
          (if *amy-cam*
              (matrix-rotate-y! (-> self tracking inv-mat) 32768.0)
              )
          (cam-free-floating-move
            (view-get-active-camera)
            (-> self tracking)
            (the-as vector (-> self stack))
            gp-0
            (view-get-active-index)
            )
          (when *amy-cam*
            (matrix-rotate-y! (-> self tracking inv-mat) 32768.0)
            (let ((a1-4 (matrix-rotate-x! (new 'stack-no-clear 'matrix) 16384.0)))
              (matrix*! (-> self tracking inv-mat) a1-4 (-> self tracking inv-mat))
              )
            )
          )
        )
      (suspend)
      )
    #f
    )
  )

;;-*-Lisp-*-
(in-package goal)

;; name: dynamic-mem.gc
;; name in dgo: dynamic-mem
;; dgos: ENGINE, GAME

;; +++memblock-type
(defenum memblock-type
  :type uint8
  (first 0)
  (last 1)
  (free 2)
  (used 3)
  )

;; ---memblock-type

;; +++memblock-flavor
(defenum memblock-flavor
  :type uint8
  (unknown 0)
  (lgaud 1)
  (nelly 2)
  (scert 3)
  (flash 4)
  )
;; ---memblock-flavor

;; DECOMP BEGINS

(deftype memblock (structure)
  ((tp      memblock-type)
   (flavor  memblock-flavor)
   (pad2    int16)
   (paras   int32)
   (prev    memblock)
   (next    memblock)
   )
  )


(define *dynamic-alloc-pool* (new 'static 'inline-array memblock 19200

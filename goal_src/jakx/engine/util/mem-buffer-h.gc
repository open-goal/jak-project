  (let ((v0-0
          (logior (-> (the-as (pointer uint8) (-> this ptr))) (* (-> (the-as (pointer int8) (-> this ptr)) 1) 256))
          )
        )
    (&+! (-> this ptr) 2)
    (the-as int v0-0)
    )

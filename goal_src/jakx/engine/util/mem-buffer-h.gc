(deftype mem-buffer (structure)
  ((base    pointer)
   (ptr     pointer)
   (limit   uint32)
   (in-use  symbol)
   )
  (:methods
    (check-buffer-overrun (_type_ int) none)
    (set-buffer! (_type_ pointer int) none)
    (bytes-used (_type_) int)
    (bytes-remaining (_type_) uint)
    (reset! (_type_) none)
    (write-int8 (_type_ int) none)
    (write-int16 (_type_ int) none)
    (write-int32 (_type_ int) none)
    (write-int64 (_type_ int) none)
    (write-uint8 (_type_ uint) none)
    (write-uint16 (_type_ uint) none)
    (write-uint32 (_type_ uint) none)
    (write-uint64 (_type_ uint) none)
    (write-float (_type_ float) none)
    (write-vector (_type_ vector) none)
    (write-vector-scaled (_type_ vector vector) none)
    (write-quaternion (_type_ quaternion) none)
    (write-level-pos (_type_ vector) none)
    (copy-buffer (_type_ mem-buffer) none)
    (write-symbol (_type_ symbol) none)
    (write-bool (_type_ symbol) none)
    (write-string (_type_ (pointer uint8)) none)
    (write-bytes (_type_ pointer int) none)
    (read-int8 (_type_) int)
    (read-int16 (_type_) int)
    (read-int32 (_type_) int)
    (read-int64 (_type_) int)
    (read-uint8 (_type_) uint)
    (read-uint16 (_type_) uint)
    (read-uint32 (_type_) uint)
    (read-uint64 (_type_) uint)
    (read-float (_type_) float)
    (read-vector (_type_ mem-buffer) none)
    (read-vector-scaled (_type_ vector vector) none)
    (read-quaternion (_type_ quaternion) none)
    (read-level-pos (_type_ mem-buffer) none)
    (read-symbol (_type_) symbol)
    (read-bool (_type_) symbol)
    (read-string (_type_ (pointer uint8)) none)
    (read-bytes (_type_ pointer int) none)
    (dump-mem-used (_type_) none)
    (dump-mem-all (_type_) none)
    (skip-bytes (_type_ int) none)
    )
  )


(defmethod set-buffer! ((this mem-buffer) (arg0 pointer) (arg1 int))
  (set! (-> this base) arg0)
  (set! (-> this ptr) arg0)
  (set! (-> this limit) (the-as uint (&+ arg0 arg1)))
  0
  (none)
  )

(defmethod reset! ((this mem-buffer))
  (set! (-> this ptr) (-> this base))
  0
  (none)
  )

(defmethod check-buffer-overrun ((this mem-buffer) (arg0 int))
  (when (< (-> this limit) (the-as uint (&+ (-> this ptr) arg0)))
    (format 0 "buffer overrun!~%")
    (break!)
    0
    )
  0
  (none)
  )

(defmethod skip-bytes ((this mem-buffer) (arg0 int))
  (&+! (-> this ptr) arg0)
  0
  (none)
  )

(defmethod bytes-used ((this mem-buffer))
  (&- (-> this ptr) (the-as uint (-> this base)))
  )

(defmethod bytes-remaining ((this mem-buffer))
  (- (-> this limit) (the-as uint (-> this ptr)))
  )

(defmethod write-int8 ((this mem-buffer) (arg0 int))
  (set! (-> (the-as (pointer int8) (-> this ptr))) arg0)
  (&+! (-> this ptr) 1)
  0
  (none)
  )

(defmethod write-int16 ((this mem-buffer) (arg0 int))
  (set! (-> (the-as (pointer int8) (-> this ptr))) arg0)
  (set! (-> (the-as (pointer int8) (-> this ptr)) 1) (/ arg0 256))
  (&+! (-> this ptr) 2)
  0
  (none)
  )

(defmethod write-int32 ((this mem-buffer) (arg0 int))
  (set! (-> (the-as (pointer int8) (-> this ptr))) arg0)
  (set! (-> (the-as (pointer int8) (-> this ptr)) 1) (/ arg0 256))
  (set! (-> (the-as (pointer int8) (-> this ptr)) 2) (sar arg0 16))
  (set! (-> (the-as (pointer int8) (-> this ptr)) 3) (sar arg0 24))
  (&+! (-> this ptr) 4)
  0
  (none)
  )

(defmethod write-int64 ((this mem-buffer) (arg0 int))
  (set! (-> (the-as (pointer int8) (-> this ptr))) arg0)
  (set! (-> (the-as (pointer int8) (-> this ptr)) 1) (/ arg0 256))
  (set! (-> (the-as (pointer int8) (-> this ptr)) 2) (sar arg0 16))
  (set! (-> (the-as (pointer int8) (-> this ptr)) 3) (sar arg0 24))
  (set! (-> (the-as (pointer int8) (-> this ptr)) 4) (sar arg0 32))
  (set! (-> (the-as (pointer int8) (-> this ptr)) 5) (sar arg0 40))
  (set! (-> (the-as (pointer int8) (-> this ptr)) 6) (sar arg0 48))
  (set! (-> (the-as (pointer int8) (-> this ptr)) 7) (sar arg0 56))
  (&+! (-> this ptr) 8)
  0
  (none)
  )

(defmethod write-uint8 ((this mem-buffer) (arg0 uint))
  (write-int8 this (the-as int arg0))
  (none)
  )

(defmethod write-uint16 ((this mem-buffer) (arg0 uint))
  (write-int16 this (the-as int arg0))
  (none)
  )

(defmethod write-uint32 ((this mem-buffer) (arg0 uint))
  (write-int32 this (the-as int arg0))
  (none)
  )

(defmethod write-uint64 ((this mem-buffer) (arg0 uint))
  (write-int64 this (the-as int arg0))
  (none)
  )

(defmethod write-float ((this mem-buffer) (arg0 float))
  (write-int32 this (the-as int arg0))
  (none)
  )

(defmethod read-int8 ((this mem-buffer))
  (let ((v0-0 (-> (the-as (pointer int8) (-> this ptr)) 0)))
    (&+! (-> this ptr) 1)
    v0-0
    )
  )


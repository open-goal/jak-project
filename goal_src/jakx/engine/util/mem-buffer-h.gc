;; WARN: Return type mismatch uint vs float.
(defmethod read-float ((this mem-buffer))
  (the-as float (read-uint32 this))
  )

(defmethod write-vector ((this mem-buffer) (arg0 vector))
  (write-int32 this (the-as int (the-as float (-> arg0 x))))
  (write-int32 this (the-as int (the-as float (-> arg0 y))))
  (write-int32 this (the-as int (the-as float (-> arg0 z))))
  0
  (none)
  )

(defmethod read-vector ((this mem-buffer) (arg0 mem-buffer))
  (set! (-> arg0 base) (the-as pointer (read-uint32 this)))
  (set! (-> arg0 ptr) (the-as pointer (read-uint32 this)))
  (set! (-> arg0 limit) (the-as uint (read-uint32 this)))
  0
  (none)
  )

(defmethod write-vector-scaled ((this mem-buffer) (arg0 vector) (arg1 vector))
  (write-int16 this (the int (/ (-> arg0 x) (-> arg1 x))))
  (write-int16 this (the int (/ (-> arg0 y) (-> arg1 y))))
  (write-int16 this (the int (/ (-> arg0 z) (-> arg1 z))))
  0
  (none)
  )

(defmethod read-vector-scaled ((this mem-buffer) (arg0 vector) (arg1 vector))
  (set! (-> arg0 x) (* (-> arg1 x) (the float (read-int16 this))))
  (set! (-> arg0 y) (* (-> arg1 y) (the float (read-int16 this))))
  (set! (-> arg0 z) (* (-> arg1 z) (the float (read-int16 this))))
  0
  (none)
  )

(defmethod write-quaternion ((this mem-buffer) (arg0 quaternion))
  (let ((s5-0 (new 'stack-no-clear 'inline-array 'quaternion 1)))
    (if (< (-> arg0 w) 0.0)
        (quaternion-negate! (-> s5-0 0) arg0)
        (quaternion-copy! (-> s5-0 0) arg0)
        )
    (write-int16 this (the int (* 32767.0 (-> s5-0 0 x))))
    (write-int16 this (the int (* 32767.0 (-> s5-0 0 y))))
    (write-int16 this (the int (* 32767.0 (-> s5-0 0 z))))
    )
  0
  (none)
  )

(defmethod read-quaternion ((this mem-buffer) (arg0 quaternion))
  (set! (-> arg0 x) (* 0.00003051851 (the float (read-int16 this))))
  (set! (-> arg0 y) (* 0.00003051851 (the float (read-int16 this))))
  (set! (-> arg0 z) (* 0.00003051851 (the float (read-int16 this))))
  (set! (-> arg0 w)
        (sqrtf (- 1.0 (+ (* (-> arg0 x) (-> arg0 x)) (* (-> arg0 y) (-> arg0 y)) (* (-> arg0 z) (-> arg0 z)))))
        )
  0
  (none)
  )

(defmethod copy-buffer ((this mem-buffer) (arg0 mem-buffer))
  (mem-copy! (-> this ptr) (-> arg0 base) (bytes-used arg0))
  (&+! (-> this ptr) (bytes-used arg0))
  0
  (none)
  )

(defmethod write-bool ((this mem-buffer) (arg0 symbol))
  (write-int8 this (if arg0
                       1
                       0
                       )
              )
  0
  (none)
  )

(defmethod read-bool ((this mem-buffer))
  (nonzero? (read-int8 this))
  )

(defmethod write-string ((this mem-buffer) (arg0 (pointer uint8)))
  (let ((v1-0 0))
    (let ((a0-1 arg0))
      (while (nonzero? (-> a0-1 0))
        (+! v1-0 1)
        (set! a0-1 (&-> a0-1 1))
        )
      )
    (let ((s5-0 (+ v1-0 1)))
      (mem-copy! (-> this ptr) arg0 s5-0)
      (&+! (-> this ptr) s5-0)
      )
    )
  0
  (none)
  )

;; WARN: new jak 2 until loop case, check carefully
;; WARN: Function (method 47 mem-buffer) has a return type of none, but the expression builder found a return statement.
(defmethod read-string ((this mem-buffer) (arg0 (pointer uint8)))
  (until #f
    (set! (-> arg0 0) (-> (the-as (pointer uint8) (-> this ptr))))
    (&+! (-> this ptr) 1)
    (if (zero? (-> arg0 0))
        (return #f)
        )
    (set! arg0 (&-> arg0 1))
    )
  #f
  0
  (none)
  )

(defmethod write-bytes ((this mem-buffer) (arg0 pointer) (arg1 int))
  (mem-copy! (-> this ptr) arg0 arg1)
  (&+! (-> this ptr) arg1)
  0
  (none)
  )

(defmethod read-bytes ((this mem-buffer) (arg0 pointer) (arg1 int))
  (mem-copy! arg0 (-> this ptr) arg1)
  (&+! (-> this ptr) arg1)
  0
  (none)
  )

(deftype level-bounding-box (structure)
  ((bmin  vector  :inline)
   (bsz   vector  :inline)
   )
  (:methods
    (update! (_type_) none)
    (write-pos (_type_ vector mem-buffer) none)
    (read-pos (_type_ mem-buffer mem-buffer) none)
    )
  )


(defmethod write-pos ((this level-bounding-box) (arg0 vector) (arg1 mem-buffer))
  (write-vector arg1 arg0)
  0
  (none)
  )

(defmethod read-pos ((this level-bounding-box) (arg0 mem-buffer) (arg1 mem-buffer))
  (read-vector arg1 arg0)
  0
  (none)
  )

(define *level-bounding-box* (new 'static 'level-bounding-box))

(defmethod write-level-pos ((this mem-buffer) (arg0 vector))
  (write-pos *level-bounding-box* arg0 this)
  0
  (none)
  )

(defmethod read-level-pos ((this mem-buffer) (arg0 mem-buffer))
  (read-pos *level-bounding-box* arg0 this)
  0
  (none)
  )

(defmethod dump-mem-used ((this mem-buffer))
  (let ((s5-0 (bytes-used this)))
    (format #t "~D bytes:~%" s5-0)
    (dotimes (s4-0 s5-0)
      (format #t "~X " (-> (the-as (pointer uint8) (&+ (-> this base) s4-0))))
      (if (= (logand s4-0 15) 15)
          (format #t "~%")
          )
      )
    )
  (format #t "~%")
  0
  (none)
  )

(defmethod dump-mem-all ((this mem-buffer))
  (let ((s5-0 (- (-> this limit) (the-as uint (-> this base)))))
    (format #t "~D bytes:~%" s5-0)
    (dotimes (s4-0 (the-as int s5-0))
      (format #t "~X " (-> (the-as (pointer uint8) (&+ (-> this base) s4-0))))
      (if (= (logand s4-0 15) 15)
          (format #t "~%")
          )
      )
    )
  (format 0 "~%")
  0
  (none)
  )


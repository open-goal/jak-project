  (let ((v0-0
          (logior (logior (logior (logior (logior (logior (logior (-> (the-as (pointer uint8) (-> this ptr))) (* (-> (the-as (pointer uint8) (-> this ptr)) 1) 256))
                                                          (shl (-> (the-as (pointer uint8) (-> this ptr)) 2) 16)
                                                          )
                                                  (shl (-> (the-as (pointer uint8) (-> this ptr)) 3) 24)
                                                  )
                                          (shl (-> (the-as (pointer uint8) (-> this ptr)) 4) 32)
                                          )

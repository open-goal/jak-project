                          )
                  (shl (-> (the-as (pointer int8) (-> this ptr)) 7) 56)
                  )
          )
        )
    (&+! (-> this ptr) 8)
    (the-as int v0-0)
    )
  )

(defmethod read-uint8 ((this mem-buffer))
  (let ((v0-0 (-> (the-as (pointer uint8) (-> this ptr)))))
    (&+! (-> this ptr) 1)
    v0-0
    )
  )

(defmethod read-uint16 ((this mem-buffer))
  (let ((v0-0
          (logior (-> (the-as (pointer uint8) (-> this ptr))) (* (-> (the-as (pointer uint8) (-> this ptr)) 1) 256))
          )
        )
    (&+! (-> this ptr) 2)
    v0-0
    )
  )

(defmethod read-uint32 ((this mem-buffer))
  (let ((v0-0
          (logior (logior (logior (-> (the-as (pointer uint8) (-> this ptr))) (* (-> (the-as (pointer uint8) (-> this ptr)) 1) 256))
                          (shl (-> (the-as (pointer uint8) (-> this ptr)) 2) 16)
                          )
                  (shl (-> (the-as (pointer uint8) (-> this ptr)) 3) 24)
                  )
          )
        )
    (&+! (-> this ptr) 4)
    v0-0
    )
  )

(defmethod read-uint64 ((this mem-buffer))
  (let ((v0-0
          (logior (logior (logior (logior (logior (logior (logior (-> (the-as (pointer uint8) (-> this ptr))) (* (-> (the-as (pointer uint8) (-> this ptr)) 1) 256))
                                                          (shl (-> (the-as (pointer uint8) (-> this ptr)) 2) 16)
                                                          )
                                                  (shl (-> (the-as (pointer uint8) (-> this ptr)) 3) 24)
                                                  )

;;-*-Lisp-*-
(in-package goal)

;; name: obj-list.gc
;; name in dgo: obj-list
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

(deftype list-link (structure)
  ((prev  list-link)
   (next  list-link)
   )
  :pack-me
  )


(deftype linked-list (structure)
  ((head  list-link)
   (tail  list-link)
   )
  :allow-misaligned
  (:methods
    (clear! (_type_) none)
    (linked-list-method-10 (_type_ list-link) none)
    (linked-list-method-11 (_type_ list-link) none)
    )
  )


(defmethod clear! ((this linked-list))
  (set! (-> this head) #f)
  (set! (-> this tail) #f)
  0
  (none)
  )

(defmethod linked-list-method-10 ((this linked-list) (arg0 list-link))
  (set! (-> arg0 next) #f)
  (set! (-> arg0 prev) (-> this tail))
  (if (-> this tail)
      (set! (-> this tail next) arg0)
      (set! (-> this head) arg0)
      )
  (set! (-> this tail) arg0)
  0
  (none)
  )

(defmethod linked-list-method-11 ((this linked-list) (arg0 list-link))
  (if (-> arg0 prev)
      (set! (-> arg0 prev next) (-> arg0 next))
      (set! (-> this head) (-> arg0 next))
      )
  (if (-> arg0 next)
      (set! (-> arg0 next prev) (-> arg0 prev))
      (set! (-> this tail) (-> arg0 prev))
      )
  0
  (none)
  )

(defun fixup-relocated-link ((arg0 linked-list) (arg1 int) (arg2 int))
  (cond
    ((-> arg0 head)
     (if (-> arg0 head next)
         (set! (-> arg0 head next) (the-as list-link (&+ (the-as pointer (-> arg0 head next)) arg2)))
         )
     )
    (else
      (if (-> (the-as linked-list arg1) head)
          (set! (-> (the-as linked-list arg1) head)
                (the-as list-link (&+ (the-as pointer (-> (the-as linked-list arg1) head)) arg2))
                )
          )
      )
    )
  (cond
    ((-> arg0 tail)
     (if (-> arg0 tail prev)
         (set! (-> arg0 tail prev) (the-as list-link (&+ (the-as pointer (-> arg0 tail prev)) arg2)))
         )
     )
    (else
      (if (-> (the-as list-link arg1) next)
          (set! (-> (the-as linked-list arg1) tail)
                (the-as list-link (&+ (the-as pointer (-> (the-as list-link arg1) next)) arg2))
                )
          )
      )
    )
  0
  (none)
  )

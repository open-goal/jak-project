;;-*-Lisp-*-
(in-package goal)

;; name: nav-graph-editor.gc
;; name in dgo: nav-graph-editor
;; dgos: ENGINE, GAME

;; +++nav-com-type
(defenum nav-com-type
  :type uint32
  (undo-move-node 0)
  (undo-delete-edge 1)
  (undo-delete-node 2)
  (undo-new-node 3)
  (undo-new-edge 4)
  (undo-delete-visnode 5)
  (undo-new-visnode 6)
  )
;; ---nav-com-type

;; DECOMP BEGINS

;; this file is debug only
(declare-file (debug))

(deftype nav-graph-command (structure)
  ((com-type  nav-com-type)
   (id        int32)
   (index     int32)
   (move-vec  vector  :inline)
   )
  )


(deftype nav-graph-command-array (inline-array-class)
  ((data  nav-graph-command  :inline :dynamic)
   )
  )


(set! (-> nav-graph-command-array heap-base) (the-as uint 32))

(deftype nav-graph-editor (process)
  ((nav-graph            mysql-nav-graph)
   (mode                 symbol)
   (command-id           int32)
   (max-command          int32)
   (selected-index       int32)
   (selected-dist        float)
   (selected-node-edge?  symbol)
   (closest-node         int32)
   (dist-closest-node    float)
   (closest-edge         int32)
   (dist-closest-edge    float)
   (mouse-pos            vector          :inline)
   (mouse-hit            vector          :inline)
   (mouse-hit-pick       vector          :inline)
   (mouse-normal         vector          :inline)
   (mouse-spos-hold      vector          :inline)
   (edge-src             int32)
   (edge-dst             int32)
   (edge-visibility      int32)
   (vehicle-edit-mode    symbol)
   (hover-edit-mode      symbol)
   (plane-height         float)
   (plane-height-hold    float)
   (minimap-make-mode    uint8)
   (clipping-dist        float)
   (default-node         mysql-nav-node  :inline)
   (default-edge         mysql-nav-edge  :inline)
   (command-array        nav-graph-command-array)
   )
  (:state-methods
    move-node
    move-plane
    create
    edit-edge
    create-edge
    adjust-plane
    adjust-it
    adjust-minimap
    adjust-node-angle
    adjust-node-radius
    adjust-edge-visibility
    adjust-edge-width
    adjust-edge-density
    draw-closest-minimap
    create-pov
    )
  (:methods
    (nav-graph-editor-method-30 (_type_) none)
    (nav-graph-editor-method-31 (_type_ string string string) object)
    (nav-graph-editor-method-32 (_type_ int) symbol)
    (nav-graph-editor-method-33 (_type_ int) none)
    (nav-graph-editor-method-34 (_type_ int int) none)
    (nav-graph-editor-method-35 (_type_ int) none)
    (nav-graph-editor-method-36 (_type_ vector vector) none)
    (nav-graph-editor-method-37 (_type_) symbol)
    (nav-graph-editor-method-38 (_type_) object)
    (nav-graph-editor-method-39 (_type_) object)
    (nav-graph-editor-method-40 (_type_) none)
    (nav-graph-editor-method-41 (_type_) none)
    (nav-graph-editor-method-42 (_type_) none)
    (nav-graph-editor-method-43 (_type_) none)
    (nav-graph-editor-method-44 (_type_) none)
    (nav-graph-editor-method-45 (_type_) none)
    (clear-selected-index! (_type_) none)
    (nav-graph-editor-method-47 (_type_) symbol)
    (nav-graph-editor-method-48 (_type_) symbol)
    (nav-graph-editor-method-49 (_type_) symbol)
    (nav-graph-editor-method-50 (_type_) symbol)
    (nav-graph-editor-method-51 (_type_) none)
    (inc-cmd-id! (_type_) int)
    (alloc-new-cmd! (_type_ int) nav-graph-command)
    (get-last-cmd (_type_) nav-graph-command)
    (nav-graph-editor-method-55 (_type_) none)
    (nav-graph-editor-method-56 (_type_) int)
    (nav-graph-editor-method-57 (_type_) int)
    (nav-graph-editor-method-58 (_type_ int int) int)
    (nav-graph-editor-method-59 (_type_ int) symbol)
    (nav-graph-editor-method-60 (_type_ int) none)
    (nav-graph-editor-method-61 (_type_ int) none)
    (nav-graph-editor-method-62 (_type_ int int) none)
    (nav-graph-editor-method-63 (_type_) symbol)
    (nav-graph-editor-method-64 (_type_) none)
    (toggle-vehicle-edit-mode! (_type_) none)
    (toggle-hover-edit-mode! (_type_) none)
    (nav-graph-editor-method-67 (_type_ symbol string) none)
    (nav-graph-editor-method-68 (_type_) symbol)
    )
  )


(define *nav-graph-editor* (the-as (pointer nav-graph-editor) #f))

(defun get-node-draw-position ((arg0 vector) (arg1 mysql-nav-node))
  (set! (-> arg0 quad) (-> arg1 position quad))
  (+! (-> arg0 y) (* 0.05 (- (-> (camera-pos) y) (-> arg0 y))))
  arg0
  )

;; WARN: Return type mismatch symbol vs none.
(defmethod nav-graph-editor-method-67 ((this nav-graph-editor) (arg0 symbol) (arg1 string))
  (case arg0
    (('minimap)
     (set! (-> this vehicle-edit-mode) #t)
     (set! (-> this default-node nav_node_flag) (nav-node-flag))
     (set! (-> this clipping-dist) 3276800.0)
     )
    (('hover)
     (set! (-> this hover-edit-mode) #t)
     )
    )
  (if (= (-> (level-get-target-inside *level*) name) 'desert)
      (+! (-> this clipping-dist) 4096000.0)
      )
  (set! (-> this command-array length) 0)
  (init-from-sql! (-> this nav-graph) arg0 arg1)
  (set! (-> this default-node nav_graph_id) (-> this nav-graph nav_graph_id))
  (set! (-> this default-edge nav_graph_id) (-> this nav-graph nav_graph_id))
  (none)
  )

(defmethod nav-graph-editor-method-68 ((this nav-graph-editor))
  (set! (-> this command-array length) 0)
  (exec-sql! (-> this nav-graph))
  )

(defmethod deactivate ((this nav-graph-editor))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (set! *nav-graph-editor* (the-as (pointer nav-graph-editor) #f))
  ((method-of-type process deactivate) this)
  (none)
  )

(defmethod relocate ((this nav-graph-editor) (offset int))
  (call-parent-method this offset)
  )

;; WARN: Return type mismatch symbol vs none.
(defmethod toggle-vehicle-edit-mode! ((this nav-graph-editor))
  (let ((v0-0 (not (-> this vehicle-edit-mode))))
    (set! (-> this vehicle-edit-mode) v0-0)
    (set! (-> this default-node nav_node_flag) (if v0-0
                                                   (nav-node-flag)
                                                   (nav-node-flag pedestrian)
                                                   )
          )
    )
  (none)
  )

;; WARN: Return type mismatch symbol vs none.
(defmethod toggle-hover-edit-mode! ((this nav-graph-editor))
  (set! (-> this hover-edit-mode) (not (-> this hover-edit-mode)))
  (none)
  )

(defmethod nav-graph-editor-method-59 ((this nav-graph-editor) (arg0 int))
  (when (not (-> this hover-edit-mode))
    (let ((gp-0 (-> this nav-graph node-array data arg0)))
      (dotimes (s5-0 (-> *level* length))
        (let ((s4-0 (-> *level* level s5-0)))
          (when (= (-> s4-0 status) 'active)
            (let ((s3-0 (-> s4-0 bsp nav-meshes)))
              (when (nonzero? s3-0)
                (dotimes (s2-0 (-> s3-0 length))
                  (let ((s1-0 (-> s3-0 s2-0)))
                    (-> s1-0 aid)
                    (let ((v1-14 (as-type s1-0 entity-nav-mesh)))
                      (when v1-14
                        (let ((a0-7 (-> v1-14 nav-mesh)))
                          (let ((a1-2 (new 'stack-no-clear 'nav-poly)))
                            (vector-! (-> a1-2 vertex 0) (-> gp-0 position) (the-as vector (-> a0-7 bounds)))
                            (set! (-> a1-2 vertex1 x) 163840.0)
                            (set! (-> a1-2 data 20) (the-as uint 2))
                            )
                          (when ((method-of-object a0-7 nav-mesh-method-42))
                            (set! (-> gp-0 nav_mesh_id) (-> s1-0 aid))
                            (set! (-> gp-0 level_name) (-> s4-0 name))
                            (logior! (-> gp-0 mysql-save-flag) (mysql-save-flag update))
                            (format *stdcon* "~S~%" (-> gp-0 level_name))
                            (return #f)
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    #f
    )
  )


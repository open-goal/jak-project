;;-*-Lisp-*-
(in-package goal)

;; name: default-menu.gc
;; name in dgo: default-menu
;; dgos: ENGINE, GAME


(defenum anim-tester-flags
  :bitfield #t
  :type int32
  (fanimt0)
  (fanimt1)
  (fanimt2)
  (fanimt3)
  (fanimt4)
  (fanimt5)
  )

;; added, still referenced in default-menu
(deftype anim-tester (process-focusable)
  ((flags        anim-tester-flags     :offset-assert 256)
  ;;  (obj-list     glst-list     :inline :offset-assert 260)
  ;;  (current-obj  string                :offset-assert 276)
   (pad uint32 5)
   (speed        int32                 :offset-assert 280)
   )
  )

(define-extern *anim-tester* (pointer anim-tester))
(define-extern set-local-vehicle (function int none))
(define-extern *net-start-view-ct* int)
(define-extern listener-continue (function string none))
(define-extern *generic-consts* generic-consts)
(define-extern *edit-instance* string)
(define-extern find-instance-by-name-level (function string level prototype-bucket))
(define-extern prototype-bucket-type (function prototype-bucket type))
(define-extern play-clean (function symbol int))
(define-extern scene-player-init (function object symbol string object :behavior scene-player))

;; DECOMP BEGINS

;;-*-Lisp-*-
(in-package goal)

;; name: anim-tester.gc
;; name in dgo: anim-tester
;; dgos: ENGINE, GAME

;; DECOMP BEGINS


(defenum anim-tester-flags
  :bitfield #t
  :type int32
  (fanimt0)
  (fanimt1)
  (fanimt2)
  (fanimt3)
  (fanimt4)
  (fanimt5)
  )

;; added, still referenced in default-menu
(deftype anim-tester (process-focusable)
  ((flags        anim-tester-flags     :offset-assert 256)
  ;;  (obj-list     glst-list     :inline :offset-assert 260)
  ;;  (current-obj  string                :offset-assert 276)
   (pad uint32 5)
   (speed        int32                 :offset-assert 280)
   )
  )
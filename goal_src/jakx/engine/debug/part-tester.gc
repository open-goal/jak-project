;;-*-Lisp-*-
(in-package goal)

;; name: part-tester.gc
;; name in dgo: part-tester
;; dgos: ENGINE, GAME

(declare-type part-tester process)
(define-extern *part-tester* (pointer part-tester))

;; DECOMP BEGINS

;; this file is debug only
(declare-file (debug))

(deftype save-memcard (process)
  ((pad  uint8  4)
   )
  (:state-methods
    create-file
    error-error
    done-done
    save-account
    )
  )


(defstate create-file (save-memcard)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('notify)
       (case (-> block param 0)
         (('done)
          (case (-> block param 1)
            ((1)
             (go-virtual save-account)
             )
            (else
              (go-virtual error-error)
              )
            )
          )
         (('error)
          (go-virtual error-error)
          )
         )
       )
      (else
        (target-generic-event-handler proc argc message block)
        )
      )
    )
  :code (behavior ()
    (auto-save-command 'create-file 0 0 self #f #f)
    (until #f
      (suspend)
      )
    #f
    )
  )

(defstate save-account (save-memcard)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('notify)
       (case (-> block param 0)
         (('done)
          (case (-> block param 1)
            ((1)
             (go-virtual done-done)
             )
            (else
              (go-virtual error-error)
              )
            )
          )
         (('error)
          (go-virtual error-error)
          )
         )
       )
      (else
        (target-generic-event-handler proc argc message block)
        )
      )
    )
  :code (behavior ()
    (auto-save-command 'save-common 0 0 self #f #f)
    (until #f
      (suspend)
      )
    #f
    )
  )

(defstate error-error (save-memcard)
  :virtual #t
  :code (behavior ()
    (format 0 " ******** ERROR *******~%")
    )
  )

(defstate done-done (save-memcard)
  :virtual #t
  :code (behavior ()
    (format 0 " ******** DONE *******~%")
    )
  )

(defbehavior save-memcard-init-by-other save-memcard ((arg0 string))
  (set! (-> self name) arg0)
  (go-virtual create-file)
  )

(define-perm *debug-save-memcard-dead-pool* dead-pool
  (new 'debug 'dead-pool 1 #x10000 "*debug-save-memcard-dead-pool*")
  )

;; WARN: Return type mismatch (pointer process) vs (pointer save-memcard).
(defun start-save-memcard ((arg0 string))
  (kill-by-type save-memcard *active-pool*)
  (set! (-> *mc-common-data* net-accounts default-idx) 0)
  (set! (-> *mc-common-data* net-accounts ct) 1)
  (charp<-string (-> *mc-common-data* data) arg0)
  (charp<-string (&-> *mc-common-data* data 64) "retset")
  (process-spawn save-memcard arg0 :name "save-memcard" :from *debug-save-memcard-dead-pool*)
  )


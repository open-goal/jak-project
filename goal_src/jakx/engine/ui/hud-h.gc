;;-*-Lisp-*-
(in-package goal)

;; name: hud-h.gc
;; name in dgo: hud-h
;; dgos: ENGINE, GAME

;; +++hud-sprite-flags
(defenum hud-sprite-flags
  :type uint16
  :bitfield #t
  (flip-x 0)
  (flip-y 1)
  (right 2)
  (center 3)
  (additive 4)
  (subtractive 5)
  (alpha-test 6)
  (center-x 7)
  (center-y 8)
  (fullscreen 9)
  (hsf10 10)
  (hsf11 11)
  (hsf12 12)
  (hsf13 13)
  (hsf14 14)
  (hsf15 15)
  )
;; ---hud-sprite-flags

;; +++hud-flags
(defenum hud-flags
  :type uint32
  :bitfield #t
  (disable 0)
  (should-die 1)
  (show 2)
  )
;; ---hud-flags

;; +++hud-string-flag
(defenum hud-string-flag
  :type uint16
  :bitfield #t
  :copy-entries font-flags
  )
;; ---hud-string-flag


(define-extern dma-add-process-drawable-hud (function process-drawable draw-control float dma-buffer none))
(define-extern char-effect-compute-colors (function font-char-effect int font-color font-context none))
(define-extern draw-string-init-justify (function string dma-buffer font-context draw-string-result))
(define-extern draw-string-asm-packed (function string dma-buffer font-context draw-string-result))
(define-extern draw-effect-string (function string dma-buffer font-context draw-string-result))
(define-extern draw-string3d-asm (function string dma-buffer font-context draw-string-result))
(define-extern current-finish-mode (function symbol))
(define-extern grand-prix-totals-on? (function symbol))
(define-extern end-game-menu-on? (function symbol))
(define-extern in-game-menu-on? (function symbol))
(define-extern high-scores-on? (function symbol))
(define-extern cash-stats-on? (function symbol))

;; DECOMP BEGINS

(deftype hud-string (structure)
  ((text          string)
   (scale         float)
   (width         float)
   (height        float)
   (color         font-color)
   (flags         hud-string-flag)
   (pos           vector4w  :inline)
   (alpha         float)
   (time          float)
   (effect        uint8)
   (effect-color  uint8)
   (text-length   int32)
   )
  (:methods
    (setup-font-context! (_type_ font-context) none)
    )
  )


(deftype hud-corners (structure)
  ((data  int32  8)
   )
  (:methods
    (calc-corners! (_type_ vector4w float hud-sprite-flags float float) none)
    )
  )


(deftype hud-sprite (structure)
  ((pos       vector4w    :inline)
   (offset-x  float       :overlay-at (-> pos data 0))
   (offset-y  float       :overlay-at (-> pos data 1))
   (color     vector4w    :inline)
   (flags     hud-sprite-flags)
   (scale-x   float)
   (width     float       :overlay-at scale-x)
   (scale-y   float)
   (height    float       :overlay-at scale-y)
   (angle     float)
   (tex       texture)
   (tid       texture-id  :overlay-at tex)
   )
  (:methods
    (draw (_type_ dma-buffer level) none)
    (hud-sprite-method-10 () none)
    )
  )


(deftype hud-box (structure)
  ((box    bounding-box2  :inline)
   (min    vector2        :inline :overlay-at (-> box min))
   (max    vector2        :inline :overlay-at (-> box max))
   (color  vector4w       :inline)
   )
  (:methods
    (draw-box-prim-only (_type_ dma-buffer) none)
    (draw-box-alpha-1 (_type_ dma-buffer) none)
    (draw-box-alpha-2 (_type_ dma-buffer) none)
    (draw-box-alpha-3 (_type_ dma-buffer) none)
    )
  )


(deftype hud-icon (structure)
  ((icon     (pointer manipy))
   (pos      vector4w  :inline)
   (scale-x  float)
   (scale-y  float)
   )
  )


(deftype hud (process)
  ((trigger-time    time-frame)
   (last-hide-time  time-frame)
   (offset          float)
   (flags           hud-flags)
   (strings         hud-string  45 :inline)
   (sprites         hud-sprite  50 :inline)
   (icons           hud-icon    2 :inline)
   (num-strings     int32)
   (num-sprites     int32)
   (gui-id          sound-id)
   )
  (:state-methods
    hud-hidden
    hud-in
    )
  (:methods
    (hide-during-letterbox? (_type_) symbol)
    (hide-during-end-game-menu? (_type_) symbol)
    (hide-during-in-game-menu? (_type_) symbol)
    (hide-during-cash-stats? (_type_) symbol)
    (hide-during-high-scores? (_type_) symbol)
    (hide-during-finish-mode? (_type_) symbol)
    (hide-during-grand-prix-totals? (_type_) symbol)
    (draw (_type_) none)
    (should-show? (_type_) symbol)
    (init-callback (_type_) none)
    (hud-event-handler (_type_ process int symbol event-message-block) object)
    (hud-method-28 (_type_) none)
    (alloc-string-if-needed (_type_ int int) none)
    )
  )


(deftype hud-map (hud)
  ((x  float)
   (y  float)
   )
  )

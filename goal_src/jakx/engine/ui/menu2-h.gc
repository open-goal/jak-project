;;-*-Lisp-*-
(in-package goal)

;; name: menu2-h.gc
;; name in dgo: menu2-h
;; dgos: ENGINE, GAME

;; +++base-menu-info-flag
(defenum base-menu-info-flag
  :type uint8
  :bitfield #t
  (hidden 0)
  (disabled 1)
  )
;; ---base-menu-info-flag


(declare-type transition-info structure)
(declare-type base-menu-info structure)
(declare-type base-menu process-drawable)

(define-extern base-menu-init-by-other (function base-menu-info vector int object :behavior base-menu))

;; DECOMP BEGINS

(deftype menu-string (hud-string)
  ((pad  int32)
   )
  )


(deftype menu-option-info (structure)
  ((display-name-id  text-id)
   (sym              symbol)
   (extra            basic)
   (extra-object     basic  :overlay-at extra)
   (extra-int        int32  :overlay-at extra)
   )
  :pack-me
  )


(deftype strings-extra-struct (structure)
  ((text          uint8  128)
   (extra         basic)
   (extra-object  basic    :overlay-at extra)
   (extra-int     int32    :overlay-at extra)
   (extra-int16   int16  2 :overlay-at extra)
   )
  )


(deftype menu-selection-struct (structure)
  ((array-ptr        (array menu-option-info))
   (selection-index  int32)
   (last-sym         symbol)
   )
  )


(deftype animation-info (structure)
  ((enter-anim    int32)
   (exit-anim     int32)
   (running-anim  int32)
   (anim-speed    float)
   (enter-delay   uint32)
   (3d-offset     vector  :inline)
   (3d-offset-x   float   :overlay-at (-> 3d-offset data 0))
   (3d-offset-y   float   :overlay-at (-> 3d-offset data 1))
   (3d-offset-z   float   :overlay-at (-> 3d-offset data 2))
   (3d-offset-w   float   :overlay-at (-> 3d-offset data 3))
   )
  )


(deftype base-menu-info (structure)
  ((menu-type      symbol)
   (children       (array base-menu-info))
   (name-symbol    symbol)
   (3d-menu-type   string)
   (trans-info     transition-info)
   (joint-index    int8)
   (joint-index-2  int8)
   (box-index      int8)
   (flags          base-menu-info-flag)
   (joints         (array int8))
   (anim-delay     uint32)
   (width          int32)
   (height         int32)
   (scale-y        float)
   (scale-x        float)
   (user-data      uint32)
   )
  )


(deftype base-menu (process-drawable)
  ((child-handles      (array handle))
   (info-ptr           base-menu-info)
   (focused?           symbol)
   (3d-menu-2d-offset  vector               :inline)
   (pos-x              float)
   (pos-y              float)
   (pos-z              float)
   (menu-time          uint32)
   (width              int32)
   (height             int32)
   (width-array        (array int32))
   (height-array       (array int32))
   (joint-mat          matrix               :inline)
   (offset-matrix      matrix               :inline)
   (j-mod              joint-mod-set-world  :inline)
   (extra-offset       vector               :inline)
   (pad                int8)
   (hidden?            symbol)
   )
  (:state-methods
    wait-enter
    enter
    running
    hide
    __empty__
    exit
    die
    dummy
    )
  (:methods
    (spawn-children (_type_) symbol)
    (init-menu! (_type_) none)
    (draw-menu (_type_) object)
    (default-event-handler (_type_ process int symbol event-message-block) object)
    (handle-input (_type_ int) object)
    (find-menu-by-name (_type_ symbol) base-menu)
    (all-running? (_type_) symbol)
    )
  )


(deftype jakx-logo-menu (base-menu)
  ()
  )


(define *jakx-logo-seen?* #f)

(deftype map-menu (base-menu)
  ()
  (:methods
    (update-masks (_type_) none)
    )
  )


(deftype selection-menu-manager (base-menu)
  ((selection-index       int32)
   (prev-selection-index  int32)
   (enabled               symbol)
   )
  (:methods
    (select-by-sym (_type_ symbol) none)
    (play-move-sound (_type_) none)
    )
  )


(deftype sprite-info (structure)
  ((offset             vector  :inline)
   (offset-x           float   :overlay-at (-> offset data 0))
   (offset-y           float   :overlay-at (-> offset data 1))
   (offset-z           float   :overlay-at (-> offset data 2))
   (offset-w           float   :overlay-at (-> offset data 3))
   (pos-z              int32)
   (tex-name           string)
   (tex-id             texture-id)
   (scale-x            float)
   (scale-y            float)
   (flags              hud-sprite-flags)
   (offset-from-index  int8)
   (offset-dir         uint8)
   (texture-index      int8)
   )
  )


(deftype transition-info (animation-info)
  ((enter-pos-x      float)
   (enter-pos-y      float)
   (enter-alpha      float)
   (running-alpha    float)
   (exit-alpha       float)
   (running-pos-x    float)
   (running-pos-y    float)
   (exit-pos-x       float)
   (exit-pos-y       float)
   (move-rate        float)
   (scroll-offset-x  int32)
   (scroll-offset-y  int32)
   (scroll-rate      float)
   )
  :pack-me
  )


(deftype sprite-menu-info (base-menu-info)
  ((trans-info    transition-info :override)
   (sprites-info  (array sprite-info))
   (color         rgba)
   )
  )


(deftype hud-sprite-array (inline-array-class)
  ((data  hud-sprite  :inline :dynamic)
   )
  )


(set! (-> hud-sprite-array heap-base) (the-as uint 64))

(deftype sprite-menu (base-menu)
  ((info-ptr  sprite-menu-info :override)
   (sprites   hud-sprite-array)
   (alpha     float)
   )
  (:methods
    (update-sprites (_type_) none)
    )
  )


(deftype menu-prim-strip-client (prim-client)
  ((strip  prim-strip)
   )
  (:methods
    (init-strip-vert! (_type_ prim-strip vector rgba float float) none)
    )
  )


(deftype prim-strip-menu (sprite-menu)
  ((p-client-array  (array menu-prim-strip-client))
   (colors          (array rgba))
   )
  (:methods
    (update-strips (_type_) none)
    )
  )


(deftype sprite-ptr-info (sprite-info)
  ((sprite-ptr  symbol)
   )
  )


(deftype sprite-ptr-menu-info (sprite-menu-info)
  ((sprites-info  (array sprite-ptr-info) :override)
   )
  )


(deftype sprite-ptr-menu (prim-strip-menu)
  ((info-ptr  sprite-ptr-menu-info :override)
   )
  )


(deftype index-sprite-list-menu-info (sprite-menu-info)
  ((pad1         uint32  2)
   (index-list   symbol)
   (horiz-list?  symbol)
   (item-offset  int32)
   (color-array  symbol)
   )
  )


(deftype index-sprite-list-menu (prim-strip-menu)
  ((info-ptr    index-sprite-list-menu-info :override)
   (index-list  (array int8))
   )
  )


(deftype string-info (structure)
  ((offset                   vector  :inline)
   (offset-x                 float   :overlay-at (-> offset data 0))
   (offset-y                 float   :overlay-at (-> offset data 1))
   (offset-z                 float   :overlay-at (-> offset data 2))
   (offset-w                 float   :overlay-at (-> offset data 3))
   (pos-z                    int32)
   (id                       text-id)
   (font-scale               float)
   (width                    float)
   (height                   float)
   (string-ptr               symbol)
   (string-ptr-needs-format  symbol)
   (font-flags               hud-string-flag)
   (font-color               font-color)
   (font-color-2             font-color)
   (font-color-3             font-color)
   (offset-dir               uint8)
   (offset-from-index        int8)
   (offset-type-from         int8)
   (is-player-string         symbol)
   (tmp-talking              int32)
   (extra-arg                symbol)
   )
  )


(deftype menu-string-array (inline-array-class)
  ((data  menu-string  :inline :dynamic)
   )
  )


(set! (-> menu-string-array heap-base) (the-as uint 80))

(deftype string-menu-info (sprite-menu-info)
  ((strings-info  (array string-info))
   (text-ids      symbol)
   )
  )


(deftype string-menu (prim-strip-menu)
  ((info-ptr  string-menu-info :override)
   (strings   menu-string-array)
   (text-ids  (array strings-extra-struct))
   )
  (:methods
    (update-strings (_type_) none)
    (update-text-ids (_type_) none)
    )
  )


(deftype options-bar-indicator (string-menu)
  ()
  )


(deftype game-text-menu-info (string-menu-info)
  ((text-id  text-id)
   )
  )


(deftype game-text-menu (string-menu)
  ((info-ptr  game-text-menu-info :override)
   (text-id   text-id)
   )
  )


(deftype dynamic-string-menu (string-menu)
  ()
  )


(deftype dynamic-driver-info (dynamic-string-menu)
  ()
  )


(deftype dropdown-trans-info (transition-info)
  ((selected-offset  vector)
   )
  )


(deftype dropdown-item-info (string-menu-info)
  ((trans-info                   dropdown-trans-info :override)
   (selection-box-width          int32)
   (selection-box-height         int32)
   (selection-type               symbol)
   (selection-extra              int32)
   (selection-box-offset         vector               :inline)
   (selection-box-offset-x       float                :overlay-at (-> selection-box-offset data 0))
   (selection-box-offset-y       float                :overlay-at (-> selection-box-offset data 1))
   (selection-box-offset-z       float                :overlay-at (-> selection-box-offset data 2))
   (selection-box-offset-w       float                :overlay-at (-> selection-box-offset data 3))
   (selection-box-color          rgba)
   (down-index-modifier          int8)
   (up-index-modifier            int8)
   (left-index-modifier          int8)
   (right-index-modifier         int8)
   (selection-box-texture-index  int8)
   (reset-pad                    uint8)
   )
  )


(deftype dropdown-item (string-menu)
  ((info-ptr            dropdown-item-info :override)
   (selected            symbol)
   (p-client-selection  menu-prim-strip-client)
   (prev-selection      int32)
   (enabled             symbol)
   (selected-offset     vector              :inline)
   )
  (:methods
    (draw-highlight (_type_) none)
    )
  )


(deftype item-list-selection-info (dropdown-item-info)
  ((menu-options-info-sym  symbol)
   (add-string             text-id)
   )
  )


(deftype item-list-selection (dropdown-item)
  ((info-ptr               item-list-selection-info :override)
   (menu-options-info-ptr  menu-selection-struct)
   (selection-type         symbol)
   (selection-index        int32)
   )
  )


(deftype item-list-driver-selection (item-list-selection)
  ()
  )


(deftype item-num-selection-info (item-list-selection-info)
  ((pad1  uint32)
   )
  )


(deftype menu-num-info (structure)
  ((min          int32)
   (max          int32)
   (current-num  int32)
   (last-num     int32)
   )
  )


(deftype item-num-selection (item-list-selection)
  ((info-ptr       item-num-selection-info :override)
   (num-info-ptr   menu-num-info            :overlay-at menu-options-info-ptr)
   (num-selection  int32)
   (sound-id       sound-id)
   )
  )


(deftype item-num-max-selection (item-num-selection)
  ((pad1  uint32)
   )
  )


(deftype games-list-selection (string-menu)
  ((selection-index  int8)
   )
  )


(deftype player-ct-string-menu (string-menu)
  ()
  )


(deftype string-list-selection (dropdown-item)
  ((selection-index  int8)
   )
  )


(deftype basic-list-selection-info (string-menu-info)
  ((menu-options-info-sym  symbol)
   )
  )


(deftype basic-list-selection (string-menu)
  ((info-ptr               basic-list-selection-info :override)
   (menu-options-info-ptr  (array menu-option-info))
   (selection-index        int8)
   )
  )


(deftype big-text-menu-info (sprite-menu-info)
  ((string-info  string-info)
   (text         string)
   (off-2d-x     float)
   (off-2d-y     float)
   )
  )


(deftype big-text-menu (sprite-menu)
  ((info-ptr     big-text-menu-info :override)
   (big-text     string)
   (vert-offset  float)
   (vert-extent  float)
   (temp-string  string)
   )
  (:methods
    (set-text! (_type_ string string) object)
    )
  )

          )
        :joint-index -1
        :joint-index-2 -1
        :joints (new 'static 'boxed-array :type int8 7 8)
        :width -1
        :height -1
        :scale-y 1.0
        :scale-x 1.0
        :sprites-info #f
        :strings-info (new 'static 'boxed-array :type string-info
          (new 'static 'string-info
            :offset (new 'static 'vector :z -1.0 :w 1.0)
            :pos-z #xffff010
            :id (text-id text-id-1364)
            :font-scale 0.6
            :width -1.0
            :height -1.0
            :string-ptr '*current-room-name*

(defstate green-room (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('green-room-game-start)
       (kill-menu self #t #f)
       (go-virtual wait-for-world #f)
       )
      (('menu-selection-event)
       0
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (local-vars (v1-2 symbol) (v1-6 symbol))
    (dotimes (v1-0 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-0))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-0))) info-ptr) *green-room*)
                 )
        (set! v1-2 #t)
        (goto cfg-20)
        )
      )
    (set! v1-2 #f)
    (label cfg-20)
    (when v1-2
      (set! v1-6 #f)
      (goto cfg-24)
      )
    (kill-menu self #t #f)
    (create-menu self *green-room* 0)
    (set! v1-6 #t)
    (label cfg-24)
    (when v1-6
      (dotimes (gp-0 8)
        (when (!= gp-0 (if *net-mgr*
                           (-> *net-mgr* game-state local-machine-idx)
                           0
                           )
                  )
          (let ((a2-4 (-> *net-process-mgr* machines gp-0 acct-id)))
            (if (> a2-4 0)
                (send-chat-msg *net-mgr* "@WaitingToPlay" a2-4 #t)
                )
            )
          )
        )
      )
    )
  :exit (behavior ()
    (let ((a0-1 (handle->process (-> *keyboard-proc* handle))))
      (if a0-1
          (deactivate a0-1)
          )
      )
    )
  :code (behavior ()
    (until #f
      (suspend)
      (when *net-world*
        (update-game-info-strings self)
        (update-ready-room-players self)
        (construct-game-name (-> *game-title-extra* 0 text) (-> *net-active-game* info game-name))
        )
      (set! (-> *player-headphones?-list* length) 0)
      (set! (-> *player-ready?-list* length) 0)
      (suspend-for (seconds 3)
        (let ((s5-0 0))
          (dotimes (s4-0 24)
            (when (and (< s5-0 6) (player-idx-vehicle-selected? *net-world* s4-0))
              (let ((s3-0 (-> *net-world* net-state players s4-0 player-num))
                    (v1-21 (if *net-world*
                               (the-as int (-> *net-world* task-node-info net-play-mode))
                               18
                               )
                           )
                    )
                (cond
                  ((or (zero? v1-21) (= v1-21 13))
                   (let ((s3-1 (-> *net-world* net-state green-room-stats laps-s8 s3-0))
                         (s2-0 (-> *net-world* net-state options advanced-options param1))
                         )
                     (cond
                       ((< s3-1 (the-as int s2-0))
                        (format (clear *medius-policy-string*) "~D / ~D" (+ s3-1 1) s2-0)
                        (copy-charp<-charp (get-extra-player-string s5-0) (-> *medius-policy-string* data))
                        )
                       (else
                         (copy-charp<-charp
                           (get-extra-player-string s5-0)
                           (-> (lookup-text! *common-text* (text-id text-id-3481) #f) data)
                           )
                         )
                       )
                     )
                   )
                  (else
                    (format (clear *medius-policy-string*) "~D" (-> *net-world* net-state green-room-stats scores-s16 s3-0))
                    (copy-charp<-charp (get-extra-player-string s5-0) (-> *medius-policy-string* data))
                    )
                  )
                )
              (+! s5-0 1)
              )
            )
          )
        (empty-form)
        (empty-form)
        (when (cpad-or-kbd-pressed-var? (the-as uint 0) (pad-buttons triangle))
          (logclear! (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons triangle))
          (logclear! (-> *cpad-list* cpads 0 button0-rel 0) (pad-buttons triangle))
          (cpad-or-kbd-clear-func! (the-as uint 0) (pad-buttons triangle))
          (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-1608))
          (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1712))
          (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1926))
          (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-4273))
          (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
          (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
          (go-virtual
            lobby-generic-error-menu
            *lobby-generic-confirmation*
            (lambda :behavior lobby-menu-manager
              ()
              (kill-menu self #t #t)
              (send-event *net-mgr* 'leave-game)
              (while *net-world*
                (suspend)
                )
              (go-virtual host-join-menu)
              )
            (the-as (function symbol object) (lambda :behavior lobby-menu-manager () (go-virtual green-room)))
            #f
            #f
            #f
            )
          (go-virtual lobby-main-screen)
          )
        )
      )
    #f
    )
  )

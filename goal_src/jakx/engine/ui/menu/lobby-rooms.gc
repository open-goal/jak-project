        (do-pending-operation)
        (when *chat-refresh*
          (set! *chat-refresh* #f)
          (goto cfg-105)
          )
        )
      (suspend)
      0
      (label cfg-105)
      )
    #f
    )
  )

(deftype green-room-game-info-menu (string-menu)
  ()
  )


;; WARN: Function (method 67 green-room-game-info-menu) has a return type of none, but the expression builder found a return statement.
(defmethod update-strings ((this green-room-game-info-menu))
  (local-vars (s4-5 int))
  (dotimes (s5-0 (-> this strings length))
    (clear (-> this strings data s5-0 text))
    )
  (if (not *net-world*)
      (return #f)
      )
  (let ((s4-0 0)
        (s5-2 (max 0 (- (- (- (if *net-mgr*
                                  (-> *net-mgr* game-state time)
                                  0
                                  )
                              (if *net-world*
                                  (-> *net-world* net-state game-start-time)
                                  0
                                  )
                              )
                           (if *net-world*
                               (-> *net-world* net-state total-pause-time)
                               0
                               )
                           )
                        (-> *net-world* net-state green-room-stats intro-end-time)
                        )
                   )
              )
        )
    (copy-charp<-charp
      (-> this strings data s4-0 text data)
      (-> (lookup-text! *common-text* (text-id text-id-3332) #f) data)
      )
    (let ((s4-1 (+ s4-0 1)))
      (print-time (-> this strings data s4-1 text) (the-as time-frame s5-2))
      (let ((s4-2 (+ s4-1 1))
            (s5-3 (-> *net-world* net-state options))
            (s3-1 (-> this strings length))
            )
        (when (and (< s4-2 (+ s3-1 -1))
                   (logtest? (-> s5-3 advanced-options flags) (game-task-advanced-options-flag time-limit))
                   )
          (let* ((v1-28 (-> s5-3 advanced-options param1))
                 (s2-1 (* #x4650 (the-as int v1-28)))
                 )
            (copy-charp<-charp
              (-> this strings data s4-2 text data)
              (-> (lookup-text! *common-text* (text-id text-id-2491) #f) data)
              )
            (let ((s4-3 (+ s4-2 1)))
              (print-time (-> this strings data s4-3 text) (the-as time-frame s2-1))
              (set! s4-2 (+ s4-3 1))
              )
            )
          )
        (when (and (< s4-2 (+ s3-1 -1))
                   (logtest? (-> s5-3 advanced-options flags) (game-task-advanced-options-flag score-limit))
                   )
          (let ((s2-2 (-> s5-3 advanced-options param2)))
            (copy-charp<-charp
              (-> this strings data s4-2 text data)
              (-> (lookup-text! *common-text* (text-id text-id-2533) #f) data)
              )
            (let ((s4-4 (+ s4-2 1)))
              (format (-> this strings data s4-4 text) "~D~%" s2-2)
              (set! s4-2 (+ s4-4 1))
              )
            )
          )
        (when (and (< s4-2 (+ s3-1 -1))
                   (and (or (zero? (if *net-world*
                                       (the-as int (-> *net-world* task-node-info net-play-mode))
                                       18
                                       )
                                   )
                            (= (if *net-world*
                                   (the-as int (-> *net-world* task-node-info net-play-mode))
                                   18
                                   )
                               10
                               )
                            (= (if *net-world*
                                   (the-as int (-> *net-world* task-node-info net-play-mode))
                                   18
                                   )
                               13
                               )
                            )
                        (copy-charp<-charp
                          (-> this strings data s4-2 text data)
                          (-> (lookup-text! *common-text* (text-id text-id-2408) #f) data)
                          )
                        (begin (set! s4-5 (+ s4-2 1)) s4-5)
                        (format (-> this strings data s4-5 text) "~D" (-> s5-3 advanced-options param1))
                        (+ s4-5 1)
                        )
                   )
          )
        )
      )
    )
  0
  (none)
  )


(defstate chat-room-select (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (local-vars (v0-0 object))
    (case message
      (('menu-selection-event)
       (if (and *pending-op*
                *lobby-menu-manager*
                (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                   (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                   )
                )
           (return #f)
           )
       (case (-> block param 0)
         (('accept)
          (logclear! (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons x))
          (logclear! (-> *cpad-list* cpads 0 button0-rel 0) (pad-buttons x))
          (cpad-or-kbd-clear-func! (the-as uint 0) (pad-buttons x))
          (case (-> block param 1)
            (('room-list)
             (let* ((a0-18 (-> block param 2))
                    (v1-16 (-> *medius-rooms* data (the-as int a0-18) id))
                    )
               (cond
                 ((!= v1-16 (-> *net-mgr* lobby-state channel-id))
                  (when (not (and *pending-op*
                                  *lobby-menu-manager*
                                  (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                                     (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                                     )
                                  )
                             )
                    (set! (-> *pending-op-args* 0) (-> *medius-rooms* data (the-as int (-> block param 2)) id))
                    (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
                    (set! v0-0
                          (lambda :behavior lobby-menu-manager
                            ((arg0 object))
                            (local-vars (v1-10 object))
                            (kill-menu self #f #f)
                            (when (not (cond
                                         (*net-mgr-pending-behavior-valid*
                                           #f
                                           )
                                         (else
                                           (until v1-10
                                             (suspend)
                                             (set! v1-10
                                                   (or (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'lobby-idle))
                                                       (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'playing-game))
                                                       )
                                                   )
                                             )
                                           (set! *net-mgr-pending-behavior-result* 'undefined)
                                           (send-event *net-mgr* 'do-behavior 'join-room arg0)
                                           (while (= *net-mgr-pending-behavior-result* 'undefined)
                                             (suspend)
                                             )
                                           (suspend)
                                           *net-mgr-pending-behavior-result*
                                           )
                                         )
                                       )
                              (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-2471))
                              (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
                              (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
                              (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
                              (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
                              (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
                              (go-virtual
                                lobby-generic-error-menu
                                *lobby-generic-confirmation*
                                (lambda :behavior lobby-menu-manager () (go-virtual chat-room-select))
                                (the-as (function symbol object) #f)
                                #t
                                #f
                                #f
                                )
                              )
                            (go-virtual chat-room)
                            )
                          )
                    (set! *pending-op* (the-as (function object object object object object object object object object)
                                         (the-as (function object object :behavior lobby-menu-manager) v0-0)
                                         )
                          )
                    v0-0
                    )
                  )
                 (else
                   (when (not (and *pending-op*
                                   *lobby-menu-manager*
                                   (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                                      (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                                      )
                                   )
                              )
                     (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
                     (set! v0-0 (lambda :behavior lobby-menu-manager () (go-virtual chat-room)))
                     (set! *pending-op* (the-as (function object object object object object object object object object)
                                          (the-as (function object :behavior lobby-menu-manager) v0-0)
                                          )
                           )
                     v0-0
                     )
                   )
                 )
               )
             )
            )
          )
         (('cancel)
          (logclear! (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons triangle))
          (logclear! (-> *cpad-list* cpads 0 button0-rel 0) (pad-buttons triangle))
          (cpad-or-kbd-clear-func! (the-as uint 0) (pad-buttons triangle))
          (case (-> block param 1)
            (('room-list)
             (when (not (and *pending-op*
                             *lobby-menu-manager*
                             (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                                (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                                )
                             )
                        )
               (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
               (set! v0-0 (lambda :behavior lobby-menu-manager () (go-virtual chat-room)))
               (set! *pending-op* (the-as (function object object object object object object object object object)
                                    (the-as (function object :behavior lobby-menu-manager) v0-0)
                                    )
                     )
               v0-0
               )
             )
            )
          )
         (('left 'right 'failed-up 'failed-down)
          (case (-> block param 1)
            (('room-list)
             (let* ((v1-49 (-> *medius-rooms* base-page))
                    (a0-53 (-> block param 0))
                    (v1-50 (+ v1-49 (cond
                                      ((= a0-53 'left)
                                       -1
                                       )
                                      ((= a0-53 'failed-up)
                                       -1
                                       )
                                      ((= a0-53 'failed-down)
                                       1
                                       )
                                      (else
                                        1
                                        )
                                      )
                              )
                           )
                    )
               (when (and (>= v1-50 0) (< v1-50 (-> *medius-rooms* total-pages)))
                 (when (not (and *pending-op*
                                 *lobby-menu-manager*
                                 (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                                    (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                                    )
                                 )
                            )
                   (set! (-> *pending-op-args* 0) v1-50)
                   (let ((v1-51 (-> block param 0)))
                     (set! (-> *pending-op-args* 1) (cond
                                                      ((= v1-51 'failed-up)
                                                       -1
                                                       )
                                                      ((= v1-51 'failed-down)
                                                       1
                                                       )
                                                      (else
                                                        0
                                                        )
                                                      )
                           )
                     )
                   (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
                   (set! v0-0
                         (lambda :behavior lobby-menu-manager
                           ((arg0 int) (arg1 int))
                           (local-vars (v1-12 object))
                           (let ((gp-0 (as-type (find-menu self 'room-list) scrolling-menu-room)))
                             (when gp-0
                               (set! (-> gp-0 physical-item-ct) 0)
                               (send-event gp-0 'update)
                               (cond
                                 (*net-mgr-pending-behavior-valid*
                                   )
                                 (else
                                   (until v1-12
                                     (suspend)
                                     (set! v1-12 (or (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'lobby-idle))
                                                     (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'playing-game))
                                                     )
                                           )
                                     )
                                   (set! *net-mgr-pending-behavior-result* 'undefined)
                                   (send-event *net-mgr* 'do-behavior 'refresh-rooms (logior (shl #x8000 16) arg0) #xffffffff3fffffff 0 0 0)
                                   (while (= *net-mgr-pending-behavior-result* 'undefined)
                                     (suspend)
                                     )
                                   (suspend)
                                   *net-mgr-pending-behavior-result*
                                   )
                                 )
                               (send-event (find-menu self 'room-list) 'update)
                               (if (= arg1 -1)
                                   (set! (-> gp-0 prev-id) (-> *medius-rooms* data (+ (-> *medius-rooms* ct) -1) id))
                                   (set! (-> gp-0 prev-id) (-> *medius-rooms* data 0 id))
                                   )
                               (send-event (find-menu self 'room-list) 'update)
                               )
                             )
                           )
                         )
                   (set! *pending-op* (the-as (function object object object object object object object object object)
                                        (the-as (function int int object :behavior lobby-menu-manager) v0-0)
                                        )
                         )
                   v0-0
                   )
                 )
               )
             )
            )
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    '()
    )
  :code (behavior ()
    (local-vars (v1-6 symbol) (v1-32 object))
    (let ((gp-0 (+ (-> *display* real-clock frame-counter) (seconds -30))))
      0
      (dotimes (v1-4 (+ (-> self in-focus-index) 1))
        (when (and (handle->process (-> self menu-handles v1-4))
                   (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-4))) info-ptr) *chat-room-select*)
                   )
          (set! v1-6 #t)
          (goto cfg-20)
          )
        )
      (set! v1-6 #f)
      (label cfg-20)
      (if v1-6
          (goto cfg-24)
          )
      (kill-menu self #t #f)
      (create-menu self *chat-room-select* 0)
      #t
      (label cfg-24)
      (let ((v1-18 (as-type (find-menu self 'room-list) scrolling-menu-room)))
        (if v1-18
            (set! (-> v1-18 prev-id) (-> *net-mgr* lobby-state channel-id))
            )
        )
      (until #f
        (suspend)
        (do-pending-operation)
        (when (>= (- (-> *display* real-clock frame-counter) gp-0) (seconds 30))
          (cond
            (*net-mgr-pending-behavior-valid*
              )
            (else
              (until v1-32
                (suspend)
                (set! v1-32
                      (or (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'lobby-idle))
                          (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'playing-game))
                          )
                      )
                )
              (set! *net-mgr-pending-behavior-result* 'undefined)
              (send-event
                *net-mgr*
                'do-behavior
                'refresh-rooms
                (logior (shl #x8000 16) (-> *medius-rooms* base-page))
                #xffffffff3fffffff
                0
                0
                0
                )
              (while (= *net-mgr-pending-behavior-result* 'undefined)
                (suspend)
                )
              (suspend)
              *net-mgr-pending-behavior-result*
              )
            )
          (set! gp-0 (-> *display* real-clock frame-counter))
          (send-event (find-menu self 'room-list) 'update)
          )
        )
      )
    #f
    )
  )

(define *chat-room*
  (new 'static 'base-menu-info
    :menu-type 'base-menu
    :children (new 'static 'boxed-array :type base-menu-info
      (new 'static 'string-menu-info
        :menu-type 'string-menu
        :children #f
        :name-symbol #f
        :3d-menu-type "skel-top-bar"
        :trans-info (new 'static 'transition-info
          :enter-anim 3
          :exit-anim 5
          :running-anim -1
          :anim-speed 5.0
          :3d-offset (new 'static 'vector :w 1.0)
          :enter-alpha 1.0

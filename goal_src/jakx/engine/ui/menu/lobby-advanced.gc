(defstate running (dropdown-weapon-item)
  :virtual #t
  :trans (behavior ()
    (if (logtest? (-> *net-world* net-state options advanced-options weapons) (ash 1 (-> self info-ptr weapon-type)))
        (set! (-> self colors 0) (new 'static 'rgba :r #x40 :g #x40 :b #x40 :a #x80))
        (set! (-> self colors 0) (new 'static 'rgba :r #x80 :g #x80 :b #x80 :a #x80))
        )
    (call-parent-state-handler trans)
    )
  )

(defmethod handle-input ((this dropdown-weapon-item) (arg0 int))
  (cond
    ((cpad-or-kbd-pressed-var? (the-as uint arg0) (pad-buttons x))
     (let ((v1-0 (get-open-task-node-info)))
       (if (logtest? (-> v1-0 user-advanced-options weapons) (ash 1 (-> this info-ptr weapon-type)))
           (logclear! (-> v1-0 user-advanced-options weapons) (ash 1 (-> this info-ptr weapon-type)))
           (logior! (-> v1-0 user-advanced-options weapons) (ash 1 (-> this info-ptr weapon-type)))
           )
       )
     (logclear! (-> *cpad-list* cpads arg0 button0-abs 0) (pad-buttons x))
     (logclear! (-> *cpad-list* cpads arg0 button0-rel 0) (pad-buttons x))
     (cpad-or-kbd-clear-func! (the-as uint arg0) (pad-buttons x))
     (send-options *net-world*)
     )
    (else
      (call-parent-method this arg0)
      )
    )
  )

(defmethod default-event-handler ((this dropdown-weapon-item) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (case arg2
    (('selected)
     (send-event
       (ppointer->process (-> this parent))
       'menu-selection-event
       'changed
       (-> this info-ptr selection-type)
       (-> this info-ptr weapon-text-id)
       (logtest? (-> (get-open-task-node-info) user-advanced-options weapons) (ash 1 (-> this info-ptr weapon-type)))
       )
     (set! (-> this selected) #t)
     (let ((v0-2 (the-as object (-> arg3 param 0))))
       (set! (-> this prev-selection) (the-as int v0-2))
       v0-2
       )
     )
    (else
      (call-parent-method this arg0 arg1 arg2 arg3)
      )
    )
  )

(define *param1-num-info* (the-as (pointer menu-num-info) #f))

(define *param2-num-info* (the-as (pointer menu-num-info) #f))

(define *param3-num-info* (the-as (pointer menu-num-info) #f))

(defstate host-advanced-options (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (local-vars (v0-0 object))
    (case message
      (('menu-selection-event)
       (case (-> block param 0)
         (('changed)
          (case (-> block param 1)
            (('weapon)
             (let ((v1-4 (the-as string-menu (find-menu self 'weapon-title))))
               (set! v0-0 (-> block param 2))
               (set! (-> v1-4 info-ptr strings-info 0 id) (the-as text-id v0-0))
               )
             v0-0
             )
            )
          )
         (('cancel)
          (case (-> block param 1)
            (('weapon)
             (let ((s4-0 (find-menu self 'weapon-selection-manager))
                   (gp-1 (find-menu self 'advance-options-manager))
                   (s3-0 (the-as string-menu (find-menu self 'weapon-title)))
                   (s5-0 (the-as string-menu (find-menu self 'context-string)))
                   )
               (set! (-> s3-0 info-ptr strings-info 0 id) (text-id text-id-1712))
               (send-event s4-0 'enable #f)
               (send-event gp-1 'enable #t)
               (set! v0-0 2430)
               (set! (-> s5-0 info-ptr strings-info 0 id) (the-as text-id v0-0))
               )
             v0-0
             )
            (else
              (when (kill-menu self #f #f)
                (cond
                  ((zero? (-> self game-connection-type))
                   (go-virtual personal-selection-pop-up (-> self current-local-player))
                   )
                  (else
                    (if (= (if *net-mgr*
                               (-> *net-mgr* game-state local-machine-idx)
                               0
                               )
                           (-> *net-mgr* game-state session-master-idx)
                           )
                        (create-menu self *ready-room-host* 2)
                        (create-menu self *ready-room* 2)
                        )
                    (go-virtual ready-room-state)
                    )
                  )
                )
              )
            )
          )
         (('accept)
          (case (-> block param 1)
            (('reset-ghost)
             (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-3395))
             (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1712))
             (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1926))
             (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-4273))
             (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
             (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
             (go-virtual
               lobby-generic-error-menu
               *lobby-generic-confirmation*
               (lambda :behavior lobby-menu-manager
                 ()
                 (reset-ghost)
                 (go-virtual host-advanced-options (-> self current-local-player))
                 )
               (the-as
                 (function symbol object)
                 (lambda :behavior lobby-menu-manager () (go-virtual host-advanced-options (-> self current-local-player)))
                 )
               #f
               #f
               #f
               )
             )
            )
          )
         (('circle)
          (when (not (or (= (if *net-world*
                                (the-as int (-> *net-world* task-node-info net-play-mode))
                                18
                                )
                            3
                            )
                         (= (if *net-world*
                                (the-as int (-> *net-world* task-node-info net-play-mode))
                                18
                                )
                            10
                            )
                         (= (if *net-world*
                                (the-as int (-> *net-world* task-node-info net-play-mode))
                                18
                                )
                            13
                            )
                         (= (if *net-world*
                                (the-as int (-> *net-world* task-node-info net-play-mode))
                                18
                                )
                            2
                            )
                         )
                     )
            (let ((s4-1 (find-menu self 'weapon-selection-manager))
                  (s5-1 (find-menu self 'advance-options-manager))
                  (gp-2 (the-as string-menu (find-menu self 'context-string)))
                  )
              (send-event s4-1 'enable #t)
              (send-event s5-1 'enable #f)
              (set! v0-0 3041)
              (set! (-> gp-2 info-ptr strings-info 0 id) (the-as text-id v0-0))
              )
            v0-0
            )
          )
         (('param1)
          (let ((v1-83 (get-open-task-node-info)))
            (case (-> block param 1)
              (('next)
               (+! (-> v1-83 user-advanced-options param1) 1)
               (set! (-> v1-83 user-advanced-options param1)
                     (the-as uint (min (the-as int (-> v1-83 user-advanced-options param1)) (-> *param1-num-info* 0 max)))
                     )
               (set! (-> v1-83 user-advanced-options param1)
                     (the-as uint (max (the-as int (-> v1-83 user-advanced-options param1)) (-> *param1-num-info* 0 min)))
                     )
               )
              (('previous)
               (+! (-> v1-83 user-advanced-options param1) -1)
               (set! (-> v1-83 user-advanced-options param1)
                     (the-as uint (min (the-as int (-> v1-83 user-advanced-options param1)) (-> *param1-num-info* 0 max)))
                     )
               (set! (-> v1-83 user-advanced-options param1)
                     (the-as uint (max (the-as int (-> v1-83 user-advanced-options param1)) (-> *param1-num-info* 0 min)))
                     )
               )
              )
            (set! (-> *param1-num-info* 0 current-num) (the-as int (-> v1-83 user-advanced-options param1)))
            )
          (send-options *net-world*)
          )
         (('param2)
          (let ((v1-86 (get-open-task-node-info)))
            (case (-> block param 1)
              (('next)
               (+! (-> v1-86 user-advanced-options param2) 1)
               (set! (-> v1-86 user-advanced-options param2)
                     (the-as uint (min (the-as int (-> v1-86 user-advanced-options param2)) (-> *param2-num-info* 0 max)))
                     )
               (set! (-> v1-86 user-advanced-options param2)
                     (the-as uint (max (the-as int (-> v1-86 user-advanced-options param2)) (-> *param2-num-info* 0 min)))
                     )
               )
              (('previous)
               (+! (-> v1-86 user-advanced-options param2) -1)
               (set! (-> v1-86 user-advanced-options param2)
                     (the-as uint (min (the-as int (-> v1-86 user-advanced-options param2)) (-> *param2-num-info* 0 max)))
                     )
               (set! (-> v1-86 user-advanced-options param2)
                     (the-as uint (max (the-as int (-> v1-86 user-advanced-options param2)) (-> *param2-num-info* 0 min)))
                     )
               )
              )
            (set! (-> *param2-num-info* 0 current-num) (the-as int (-> v1-86 user-advanced-options param2)))
            )
          (send-options *net-world*)
          )
         (('param3)
          (let ((v1-89 (get-open-task-node-info)))
            (case (-> block param 1)
              (('next)
               (+! (-> v1-89 user-advanced-options param3) 1)
               (set! (-> v1-89 user-advanced-options param3)
                     (the-as uint (min (the-as int (-> v1-89 user-advanced-options param3)) (-> *param3-num-info* 0 max)))
                     )
               (set! (-> v1-89 user-advanced-options param3)
                     (the-as uint (max (the-as int (-> v1-89 user-advanced-options param3)) (-> *param3-num-info* 0 min)))
                     )
               )
              (('previous)
               (+! (-> v1-89 user-advanced-options param3) -1)
               (set! (-> v1-89 user-advanced-options param3)
                     (the-as uint (min (the-as int (-> v1-89 user-advanced-options param3)) (-> *param3-num-info* 0 max)))
                     )
               (set! (-> v1-89 user-advanced-options param3)
                     (the-as uint (max (the-as int (-> v1-89 user-advanced-options param3)) (-> *param3-num-info* 0 min)))
                     )
               )
              )
            (set! (-> *param3-num-info* 0 current-num) (the-as int (-> v1-89 user-advanced-options param3)))
            )
          (send-options *net-world*)
          )
         (('time-of-day)
          (case (-> block param 1)
            (('next)
             (next-selection self *time-of-day-array*)
             )
            (('previous)
             (prev-selection self *time-of-day-array*)
             )
            )
          (set-time-of-day
            *net-world*
            (-> *time-of-day-array* array-ptr (-> *time-of-day-array* selection-index) extra-int)
            )
          )
         (('arena-flag)
          (let ((gp-3 (-> block param 1))
                (v1-104 (get-open-task-node-info))
                (a0-129 (-> *game-info* sub-task-list))
                )
            (dotimes (a1-67 (-> a0-129 length))
              (when (nonzero? a1-67)
                (let ((a2-8 (-> a0-129 a1-67)))
                  (when (and (or (= (-> a2-8 net-play-mode) (net-play-mode deathmatch))
                                 (= (-> a2-8 net-play-mode) (net-play-mode hunt))
                                 (= (-> a2-8 net-play-mode) (net-play-mode ctf))
                                 (= (-> a2-8 net-play-mode) (net-play-mode team-deathmatch))
                                 (= (-> a2-8 net-play-mode) (net-play-mode artifact))
                                 (= (-> a2-8 net-play-mode) (net-play-mode king-of-hill))
                                 (= (-> a2-8 net-play-mode) (net-play-mode football))
                                 )
                             (!= (-> a2-8 task) (-> v1-104 task))
                             )
                    (if (and (= (-> a2-8 net-play-mode) (net-play-mode ctf)) (logtest? gp-3 32))
                        (return #f)
                        )
                    (if (logtest? (the-as game-task-advanced-options-flag gp-3) (-> v1-104 user-advanced-options flags))
                        (logior! (-> a2-8 user-advanced-options flags) gp-3)
                        (logclear! (-> a2-8 user-advanced-options flags) gp-3)
                        )
                    )
                  )
                )
              )
            )
          (set! v0-0 #t)
          (set! *last-team-setting* (the-as symbol v0-0))
          v0-0
          )
         (('venue-flag)
          #f
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )

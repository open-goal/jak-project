;;-*-Lisp-*-
(in-package goal)

;; name: lobby-advanced.gc
;; name in dgo: lobby-advanced
;; dgos: MENU2

;; DECOMP BEGINS

(deftype dropdown-weapon-item-info (dropdown-item-info)
  ((weapon-type     int8)
   (weapon-text-id  uint32)
   )
  )


(deftype item-minute-selection (item-num-selection)
  ()
  )


;; WARN: Return type mismatch font-color vs none.
(defmethod update-strings ((this item-minute-selection))
  (let ((t9-0 (method-of-type string-menu update-strings)))
    (t9-0 this)
    )
  (let ((s5-0 (-> this num-info-ptr)))
    (if s5-0
        (format (clear (-> this strings data 0 text)) "~d:00" (-> s5-0 current-num))
        )
    )
  (if (-> this selected)
      (set! (-> this strings data 0 color) (-> this info-ptr strings-info 0 font-color-2))
      (set! (-> this strings data 0 color) (-> this info-ptr strings-info 0 font-color))
      )
  (none)
  )

(deftype dropdown-advanced-flag-item-info (dropdown-item-info)
  ((advanced-flags  game-task-advanced-options-flag)
   (text-id-1       text-id)
   (text-id-2       text-id)
   )
  )


(deftype dropdown-advanced-flag-item (dropdown-item)
  ((info-ptr  dropdown-advanced-flag-item-info :override)
   )
  )


(defmethod update-strings ((this dropdown-advanced-flag-item))
  (call-parent-method this)
  (cond
    ((= (logand (-> *net-world* net-state options advanced-options flags) (-> this info-ptr advanced-flags))
        (-> this info-ptr advanced-flags)
        )
     (if (-> this info-ptr strings-info)
         (set! (-> this info-ptr strings-info 0 id) (-> this info-ptr text-id-1))
         )
     )
    (else
      (if (-> this info-ptr strings-info)
          (set! (-> this info-ptr strings-info 0 id) (-> this info-ptr text-id-2))
          )
      )
    )
  0
  (none)
  )

(defmethod handle-input ((this dropdown-advanced-flag-item) (arg0 int))
  (cond
    ((cpad-or-kbd-pressed-var? (the-as uint arg0) (pad-buttons left))
     (let ((v1-0 (get-open-task-node-info)))
       (logxor! (-> v1-0 user-advanced-options flags) (the-as uint (-> this info-ptr advanced-flags)))
       )
     (send-event
       (ppointer->process (-> this parent))
       'menu-selection-event
       (-> this info-ptr selection-type)
       (-> this info-ptr advanced-flags)
       )
     (send-options *net-world*)
     (logclear! (-> *cpad-list* cpads arg0 button0-abs 0) (pad-buttons left))
     (logclear! (-> *cpad-list* cpads arg0 button0-rel 0) (pad-buttons left))
     (cpad-or-kbd-clear-func! (the-as uint arg0) (pad-buttons left))
     )
    ((cpad-or-kbd-pressed-var? (the-as uint arg0) (pad-buttons right))
     (let ((v1-17 (get-open-task-node-info)))
       (logxor! (-> v1-17 user-advanced-options flags) (the-as uint (-> this info-ptr advanced-flags)))
       )
     (send-event
       (ppointer->process (-> this parent))
       'menu-selection-event
       (-> this info-ptr selection-type)
       (-> this info-ptr advanced-flags)
       )
     (send-options *net-world*)
     (logclear! (-> *cpad-list* cpads arg0 button0-abs 0) (pad-buttons right))
     (logclear! (-> *cpad-list* cpads arg0 button0-rel 0) (pad-buttons right))
     (cpad-or-kbd-clear-func! (the-as uint arg0) (pad-buttons right))
     )
    (else
      (call-parent-method this arg0)
      )
    )
  )

(deftype dropdown-weapon-item (dropdown-item)
  ((info-ptr  dropdown-weapon-item-info :override)
   )
  )


(deftype non-host-advanced-options-menu (string-menu)
  ()
  )


(defmethod update-text-ids ((this non-host-advanced-options-menu))
  (dotimes (s5-0 (-> this strings length))
    (clear (-> this strings data s5-0 text))
    )
  (format (clear (-> this strings data 0 text)) (lookup-text! *common-text* (text-id text-id-2592) #f))
  (if (logtest? (-> *net-world* net-state options advanced-options flags)
                (game-task-advanced-options-flag team-game)
                )
      (format (clear (-> this strings data 1 text)) (lookup-text! *common-text* (text-id text-id-37) #f))
      (format (clear (-> this strings data 1 text)) (lookup-text! *common-text* (text-id text-id-38) #f))
      )
  (format (clear (-> this strings data 2 text)) (lookup-text! *common-text* (text-id text-id-3778) #f))
  (if (logtest? (-> *net-world* net-state options advanced-options flags)
                (game-task-advanced-options-flag friendly-fire)
                )
      (format (clear (-> this strings data 3 text)) (lookup-text! *common-text* (text-id text-id-37) #f))
      (format (clear (-> this strings data 3 text)) (lookup-text! *common-text* (text-id text-id-38) #f))
      )
  (let ((v1-31 (if *net-world*
                   (the-as int (-> *net-world* task-node-info net-play-mode))
                   18
                   )
               )
        )
    (cond
      ((or (zero? v1-31) (= v1-31 10))
       (format (clear (-> this strings data 4 text)) (lookup-text! *common-text* (text-id text-id-2408) #f))
       (format (clear (-> this strings data 5 text)) "~D" (-> *net-world* net-state options advanced-options param1))
       )
      ((or (= v1-31 4) (= v1-31 5) (= v1-31 13))
       (format (clear (-> this strings data 4 text)) (lookup-text! *common-text* (text-id text-id-2491) #f))
       (if (not (logtest? (-> *net-world* net-state options advanced-options flags)
                          (game-task-advanced-options-flag time-limit)
                          )
                )
           (format (clear (-> this strings data 5 text)) (lookup-text! *common-text* (text-id text-id-2548) #f))
           (format
             (clear (-> this strings data 5 text))
             "~D:00"
             (-> *net-world* net-state options advanced-options param1)
             )
           )
       (format (clear (-> this strings data 6 text)) (lookup-text! *common-text* (text-id text-id-2542) #f))
       (if (not (logtest? (-> *net-world* net-state options advanced-options flags)
                          (game-task-advanced-options-flag score-limit)
                          )
                )
           (format (clear (-> this strings data 7 text)) (lookup-text! *common-text* (text-id text-id-2548) #f))
           (format (clear (-> this strings data 7 text)) "~D" (-> *net-world* net-state options advanced-options param2))
           )
       )
      ((= v1-31 14)
       (format (clear (-> this strings data 4 text)) (lookup-text! *common-text* (text-id text-id-2491) #f))
       (if (not (logtest? (-> *net-world* net-state options advanced-options flags)
                          (game-task-advanced-options-flag time-limit)
                          )
                )
           (format (clear (-> this strings data 5 text)) (lookup-text! *common-text* (text-id text-id-2548) #f))
           (format
             (clear (-> this strings data 5 text))
             "~D:00"
             (-> *net-world* net-state options advanced-options param1)
             )
           )
       (format (clear (-> this strings data 6 text)) (lookup-text! *common-text* (text-id text-id-2542) #f))
       (if (not (logtest? (-> *net-world* net-state options advanced-options flags)
                          (game-task-advanced-options-flag score-limit)
                          )
                )
           (format (clear (-> this strings data 7 text)) (lookup-text! *common-text* (text-id text-id-2548) #f))
           (format (clear (-> this strings data 7 text)) "~D" (-> *net-world* net-state options advanced-options param2))
           )
       )
      ((= v1-31 6)
       (format (clear (-> this strings data 4 text)) (lookup-text! *common-text* (text-id text-id-2515) #f))
       (if (not (logtest? (-> *net-world* net-state options advanced-options flags)
                          (game-task-advanced-options-flag collectathon)
                          )
                )
           (format (clear (-> this strings data 5 text)) (lookup-text! *common-text* (text-id text-id-2545) #f))
           (format (clear (-> this strings data 5 text)) (lookup-text! *common-text* (text-id text-id-1373) #f))
           )
       (format (clear (-> this strings data 6 text)) (lookup-text! *common-text* (text-id text-id-2491) #f))
       (if (not (logtest? (-> *net-world* net-state options advanced-options flags)
                          (game-task-advanced-options-flag time-limit)
                          )
                )
           (format (clear (-> this strings data 7 text)) (lookup-text! *common-text* (text-id text-id-2548) #f))
           (format
             (clear (-> this strings data 7 text))
             "~D:00"
             (-> *net-world* net-state options advanced-options param1)
             )
           )
       (format (clear (-> this strings data 8 text)) (lookup-text! *common-text* (text-id text-id-2533) #f))
       (if (not (logtest? (-> *net-world* net-state options advanced-options flags)
                          (game-task-advanced-options-flag score-limit)
                          )
                )
           (format (clear (-> this strings data 9 text)) (lookup-text! *common-text* (text-id text-id-2548) #f))
           (format (clear (-> this strings data 9 text)) "~D" (-> *net-world* net-state options advanced-options param2))
           )
       )
      ((= v1-31 11)
       (format (clear (-> this strings data 4 text)) (lookup-text! *common-text* (text-id text-id-2491) #f))
       (if (not (logtest? (-> *net-world* net-state options advanced-options flags)
                          (game-task-advanced-options-flag time-limit)
                          )
                )
           (format (clear (-> this strings data 5 text)) (lookup-text! *common-text* (text-id text-id-2548) #f))
           (format
             (clear (-> this strings data 5 text))
             "~D:00"
             (-> *net-world* net-state options advanced-options param1)
             )
           )
       (format (clear (-> this strings data 6 text)) (lookup-text! *common-text* (text-id text-id-2533) #f))
       (if (not (logtest? (-> *net-world* net-state options advanced-options flags)
                          (game-task-advanced-options-flag score-limit)
                          )
                )
           (format (clear (-> this strings data 7 text)) (lookup-text! *common-text* (text-id text-id-2548) #f))
           (format (clear (-> this strings data 7 text)) "~D" (-> *net-world* net-state options advanced-options param2))
           )
       )
      ((= v1-31 7)
       (format (clear (-> this strings data 4 text)) (lookup-text! *common-text* (text-id text-id-2491) #f))
       (if (not (logtest? (-> *net-world* net-state options advanced-options flags)
                          (game-task-advanced-options-flag time-limit)
                          )
                )
           (format (clear (-> this strings data 5 text)) (lookup-text! *common-text* (text-id text-id-2548) #f))
           (format
             (clear (-> this strings data 5 text))
             "~D:00"
             (-> *net-world* net-state options advanced-options param1)
             )
           )
       (format (clear (-> this strings data 6 text)) (lookup-text! *common-text* (text-id text-id-2533) #f))
       (format (clear (-> this strings data 7 text)) "~D" (-> *net-world* net-state options advanced-options param2))
       (format (clear (-> this strings data 8 text)) (lookup-text! *common-text* (text-id text-id-2515) #f))
       (if (logtest? (-> *net-world* net-state options advanced-options flags)
                     (game-task-advanced-options-flag kill-plus-flag)
                     )
           (format (clear (-> this strings data 9 text)) (lookup-text! *common-text* (text-id text-id-2516) #f))
           (format (clear (-> this strings data 9 text)) (lookup-text! *common-text* (text-id text-id-2517) #f))
           )
       )
      )
    )
  0
  (none)
  )


(define *advanced-options*
  (new 'static 'base-menu-info
    :menu-type 'base-menu
    :children (new 'static 'boxed-array :type base-menu-info
      (new 'static 'string-menu-info
        :menu-type 'string-menu
        :children #f
        :name-symbol 'menu-banner
        :3d-menu-type "skel-top-bar"
        :trans-info (new 'static 'transition-info
          :enter-anim 3
          :exit-anim 5
          :running-anim -1
          :anim-speed 5.0
          :3d-offset (new 'static 'vector :w 1.0)
          :enter-alpha 1.0
          :running-alpha 1.0
          :exit-alpha 1.0
          :move-rate 100.0
          )
        :joint-index -1
        :joint-index-2 -1
        :joints (new 'static 'boxed-array :type int8 7 8)
        :width -1
        :height -1
        :scale-y 1.0
        :scale-x 1.0
        :sprites-info #f
        :strings-info (new 'static 'boxed-array :type string-info
          (new 'static 'string-info
            :offset (new 'static 'vector :z -1.0 :w 1.0)
            :pos-z #xffff010
            :id (text-id text-id-2277)
            :font-scale 0.6
            :width -1.0
            :height -1.0
            :string-ptr #f
            :string-ptr-needs-format #t
            :font-flags (hud-string-flag shadow kerning middle-vert right large draw-3d ff12)
            :font-color (font-color font-color-53)
            :font-color-2 (font-color red)
            :font-color-3 (font-color green)
            :offset-dir #x2
            :offset-from-index -1
            :is-player-string #f
            :extra-arg #f
            )
          )
        :text-ids #f
        )
      (new 'static 'string-menu-info
        :menu-type 'string-menu
        :children (new 'static 'boxed-array :type base-menu-info
          (new 'static 'string-menu-info
            :menu-type 'string-menu
            :children #f
            :name-symbol #f
            :3d-menu-type #f

        (set! (-> a0-19 info-ptr strings-info 0 id) (text-id text-id-1712))
        )
      (send-event gp-0 'enable #f)
      )
    (update-game-info-strings self)
    )
  :trans (behavior ()
    (when (cpad-or-kbd-pressed-var? (the-as uint 0) (pad-buttons triangle))

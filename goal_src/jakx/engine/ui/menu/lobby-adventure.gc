(defmethod draw-menu ((this adventure-top-bar))
  1690
  (cond
    ((and (-> *lobby-menu-manager* next-state)
          (= (-> *lobby-menu-manager* next-state name) 'adventure-vehicle-select)
          )
     (let ((v1-8 3379))
       (cond
         ((logtest? *lobby-adv-cup* (game-task-node-flag cup1))
          (set! v1-8 4019)
          )
         ((logtest? *lobby-adv-cup* (game-task-node-flag cup2))
          (set! v1-8 4018)
          )
         ((logtest? *lobby-adv-cup* (game-task-node-flag cup3))
          (set! v1-8 4017)
          )
         ((logtest? *lobby-adv-cup* (game-task-node-flag cup4))
          (set! v1-8 3379)
          )
         )
       (set! (-> *adventure-top-bar-title-ids* 0) (the-as text-id v1-8))
       )
     )
    ((logtest? *lobby-adv-cup* (game-task-node-flag cup1))
     (set! (-> *adventure-top-bar-title-ids* 0) (text-id text-id-1690))
     )
    ((logtest? *lobby-adv-cup* (game-task-node-flag cup2))
     (set! (-> *adventure-top-bar-title-ids* 0) (text-id text-id-1691))
     )
    ((logtest? *lobby-adv-cup* (game-task-node-flag cup3))
     (set! (-> *adventure-top-bar-title-ids* 0) (text-id text-id-1692))
     )
    ((logtest? *lobby-adv-cup* (game-task-node-flag cup4))
     (set! (-> *adventure-top-bar-title-ids* 0) (text-id text-id-1693))
     )
    )
  (call-parent-method this)
  0
  )


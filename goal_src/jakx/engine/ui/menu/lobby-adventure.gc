;; WARN: Return type mismatch int vs object.
(defun pulse-new-font-color ()
  (let* ((f0-1 (* 0.0033333334 (the float (current-time))))
         (f0-4 (sin (* 182.04445 (* 360.0 f0-1))))
         (v1-7 (the int (+ 100.0 (* -20.0 f0-4))))
         )
    (set! (-> *font-work* color-table 72 color 0 r) v1-7)
    (set! (-> *font-work* color-table 72 color 0 g) 16)
    (set! (-> *font-work* color-table 72 color 0 b) 16)
    (set! (-> *font-work* color-table 72 color 0 a) 128)
    (set! (-> *font-work* color-table 72 color 1 r) v1-7)
    )
  (set! (-> *font-work* color-table 72 color 1 g) 48)
  (set! (-> *font-work* color-table 72 color 1 b) 48)
  (set! (-> *font-work* color-table 72 color 0 a) 128)
  0
  )

(deftype dropdown-cup (dropdown-item)
  ()
  )


;; WARN: Return type mismatch object vs none.
(defmethod update-strings ((this dropdown-cup))
  (let ((t9-0 (method-of-type dropdown-item update-strings)))
    (t9-0 this)
    )
  (if (-> this enabled)
      (set! (-> this info-ptr strings-info 1 id) (text-id text-id-1737))
      (set! (-> this info-ptr strings-info 1 id) (text-id text-id-1398))
      )
  (let ((v1-5 (-> this info-ptr user-data))
        (a0-9 (-> *game-info* sub-task-list))
        )
    (dotimes (a1-0 (-> a0-9 length))
      (when (nonzero? a1-0)
        (let ((a2-3 (-> a0-9 a1-0)))
          (if (and (-> *game-info* play-list (-> a2-3 task) play-continue)
                   (-> *game-info* play-list (-> a2-3 task) single-player)
                   (logtest? (-> a2-3 flags) v1-5)
                   (nonzero? (-> a2-3 play-count))
                   (>= (-> a2-3 adv-score) 0)
                   )
              (set! (-> this info-ptr strings-info 1 id) (text-id text-id-2905))
              )
          )
        )
      )
    )
  (case (-> this info-ptr selection-type)
    (('cup1)
     (send-event this 'enabled)
     )
    (('cup2)
     (cond
       ((and (= 3 (-> *game-info* grand-prix 0 trophy)) (!= *kernel-boot-message* 'preview))
        (send-event this 'enabled)
        (cond
          ((and (= 3 (-> *game-info* grand-prix 2 trophy)) (!= *kernel-boot-message* 'preview))
           (set! (-> this info-ptr down-index-modifier) 2)
           )
          ((and (= 3 (-> *game-info* grand-prix 1 trophy)) (!= *kernel-boot-message* 'preview))
           (set! (-> this info-ptr down-index-modifier) 1)
           )
          (else
            (set! (-> this info-ptr down-index-modifier) 0)
            0
            )
          )
        )
       (else
         (send-event this 'disabled)
         )
       )
     )
    (('cup3)
     (cond
       ((and (= 3 (-> *game-info* grand-prix 1 trophy)) (!= *kernel-boot-message* 'preview))
        (send-event this 'enabled)
        (cond
          ((and (= 3 (-> *game-info* grand-prix 2 trophy)) (!= *kernel-boot-message* 'preview))
           (set! (-> this info-ptr right-index-modifier) 1)
           )
          (else
            (set! (-> this info-ptr right-index-modifier) 0)
            0
            )
          )
        )
       (else
         (send-event this 'disabled)
         )
       )
     )
    (('cup4)
     (if (and (= 3 (-> *game-info* grand-prix 2 trophy)) (!= *kernel-boot-message* 'preview))
         (send-event this 'enabled)
         (send-event this 'disabled)
         )
     )
    )
  (none)
  )

(deftype dropdown-cup-strings (dynamic-string-menu)
  ()
  )


(defmethod update-strings ((this dropdown-cup-strings))
  (let ((t9-0 (method-of-type dynamic-string-menu update-strings)))
    (t9-0 this)
    )
  (let* ((a0-2 (-> this parent))
         (v1-1 (if a0-2
                   (the-as dropdown-item (-> a0-2 0 self))
                   )
               )
         )
    (cond
      ((-> v1-1 selected)
       (set! (-> this strings data 0 color) (-> this info-ptr strings-info 0 font-color-2))
       (set! (-> this strings data 1 color) (-> this info-ptr strings-info 0 font-color-2))
       )
      (else
        (set! (-> this strings data 0 color) (-> this info-ptr strings-info 0 font-color))
        (set! (-> this strings data 1 color) (-> this info-ptr strings-info 0 font-color))
        )
      )
    (cond
      ((-> v1-1 enabled)
       (if (-> v1-1 selected)
           (set! (-> this colors 1) (new 'static 'rgba :r #x70 :g #x50 :a #x50))
           (set! (-> this colors 1) (new 'static 'rgba :r #x50 :g #x50 :b #x65 :a #x80))
           )
       )
      (else
        (set! (-> this colors 1) (new 'static 'rgba :r #x40 :g #x40 :b #x40 :a #x40))
        )
      )
    )
  (none)
  )

(deftype dropdown-cup-borders (prim-strip-menu)
  ()
  )


;; WARN: Return type mismatch symbol vs none.
(defmethod init-menu! ((this dropdown-cup-borders))
  (call-parent-method this)
  (dotimes (v1-0 (-> this colors length))
    (set! (-> this colors v1-0) (new 'static 'rgba :r #x50 :g #x50 :b #x65 :a #x80))
    )
  (none)
  )


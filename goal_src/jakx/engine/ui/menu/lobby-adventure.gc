;; WARN: new jak 2 until loop case, check carefully
(defbehavior wait-for-fmvlev lobby-menu-manager ()
  (level-get *level* 'fmvlev)
  (let ((f0-1 (* 128.0 (-> *setting-control* user-current bg-a)))
        (gp-0 (new-stack-vector0))
        )
    (set! (-> gp-0 w) f0-1)
    (lobby-level-set! 1 'fmvlev #f)
    (setup
      *screen-filter*
      gp-0
      (new 'static 'vector :w 128.0)
      (* 2.0 (seconds-per-frame))
      (bucket-id debug)
      #x3fffff
      #x33001
      (the-as symbol 0)
      )
    )
  (until (= (-> *screen-filter* color w) 128.0)
    (suspend)
    )
  (until #f
    (let ((v1-13 (level-get *level* 'fmvlev)))
      (if (and v1-13 (= (-> v1-13 status) 'loaded))
          (return #f)
          )
      )
    (suspend)
    )
  #f
  )

(defstate playing-grand-prix (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('menu-selection-event)
       #f
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :code (behavior ()
    (cond
      ((= (-> *game-info* grand-prix-index) 3)
       (-> *game-info* sub-task-list (-> *game-info* playing-grand-prix? boss))
       (cond
         ((= *net-mgr-finish-mode* 'abort)
          (set! (-> *game-info* playing-grand-prix?) #f)
          (go-virtual lobby-results-new-vehicle-animation)
          )
         ((= *net-mgr-finish-mode* 'finish)
          (jukebox-onoff #f)
          (set! (-> *game-info* playing-grand-prix? trophy) (the-as uint 3))
          (dma-release 'fmv-player)
          (until #f
            (let ((v1-14 (new 'stack-no-clear 'array 'int32 2)))
              (when (dma-try-alloc #x80040 #x80040 'fmv-player 0 (&-> v1-14 0) (&-> v1-14 1) #f)
                (suspend)
                (suspend)
                (goto cfg-9)
                )
              )
            (suspend)
            0
            )
          #f
          (label cfg-9)
          (disable *screen-filter*)
          (lobby-level-set! 1 #f #f)
          (jukebox-onoff #t)
          (remove-setting! 'bg-a)
          (set! (-> *game-info* playing-grand-prix?) #f)
          (go-virtual lobby-credits)
          )
         )
       )
      ((= (-> *game-info* grand-prix-index) 2)
       (cond
         ((= *net-mgr-finish-mode* 'abort)
          (set! (-> *game-info* playing-grand-prix?) #f)
          (go-virtual lobby-results-new-vehicle-animation)
          )
         ((= *net-mgr-finish-mode* 'finish)
          (let ((gp-0 3))
            (dotimes (v1-34 22)
              (when (< (-> *game-info* cumulative-grand-prix-score-s32 0)
                       (-> *game-info* cumulative-grand-prix-score-s32 (+ v1-34 1))
                       )
                (if (> gp-0 0)
                    (+! gp-0 -1)
                    )
                )
              )
            (when (and (= gp-0 3) (!= (-> *game-info* playing-grand-prix? trophy) 3))
              (set! *open-new-cup* #t)
              (if (zero? (-> *game-info* playing-grand-prix? boss))
                  (set! (-> *game-info* playing-grand-prix? trophy) (the-as uint gp-0))
                  )
              (wait-for-fmvlev)
              (fmv-player-run (-> *game-info* playing-grand-prix? outro) *target-pool* #f)
              (while *fmv-player*
                (suspend)
                )
              (disable *screen-filter*)
              )
            (when (and (= gp-0 3) (nonzero? (-> *game-info* playing-grand-prix? boss)))
              (+! (-> *game-info* grand-prix-index) 1)
              (set-task-node *net-world* (the-as game-task-node (-> *game-info* playing-grand-prix? boss)))
              (suspend)
              (mem-copy!
                (the-as pointer (-> *net-world* net-state options))
                (the-as pointer (-> (get-open-task-node-info) default-advanced-options-adventure))
                8
                )
              (suspend)
              (lock-game *net-world*)
              (until #f
                (suspend)
                )
              #f
              )
            )
          (set! (-> *game-info* playing-grand-prix?) #f)
          (jukebox-onoff #t)
          (remove-setting! 'bg-a)
          (go-virtual lobby-results-new-vehicle-animation)
          )
         )
       )
      (else
        (jukebox-onoff #t)
        (set! (-> *game-info* playing-grand-prix?) #f)
        (remove-setting! 'bg-a)
        (go-virtual lobby-results-new-vehicle-animation)
        )
      )
    )
  :post lobby-default-post
  )

(defstate adventure-vehicle-select (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('menu-selection-event)
       (case (-> block param 0)
         (('cancel)
          (let ((v1-2 (get-open-task-node-info)))
            (when (not (and (logtest? (game-task-node-flag qualifier) (-> v1-2 flags)) (zero? (-> v1-2 play-count))))
              (when (kill-menu self #f #f)
                (set! (-> *garage-string* 0) (text-id text-id-1712))
                (set! (-> *adventure-bottom-bar-ids* 0) (text-id text-id-1934))
                (if *lobby-adv-grand-prix*
                    (go-virtual adventure-grand-prix)
                    (go-virtual adventure-task)
                    )
                )
              )
            )
          )
         (('circle)
          (when (!= *lobby-adv-selected-task* -1)
            (let ((a0-14 (-> *adventure-task-info-array* *lobby-adv-selected-task*)))
              (when (= (-> a0-14 extra-int) 1)
                (set! *lobby-adv-previous-score* (get-task-total-score))
                (mem-copy!
                  (the-as pointer (-> *net-world* net-state options))
                  (the-as pointer (-> (get-open-task-node-info) default-advanced-options-adventure))
                  8
                  )
                (send-vehicle-to-net-world self)
                (let ((v1-22 (make-sound-instance snd-choice1 (new 'static 'sound-id) (the-as handle #f))))
                  (cond
                    (v1-22
                      (logior! (-> v1-22 flags) (sound-spec-flag needs-update non-positional))
                      (-> v1-22 id)
                      )
                    (else
                      0
                      )
                    )
                  )
                (lock-game *net-world*)
                )
              )
            )
          )
         (('vehicle)
          (case (-> block param 1)
            (('next)
             (next-selection self *menu-vehicle-array*)
             0
             )
            (('previous)
             (prev-selection self *menu-vehicle-array*)
             0
             )
            )
          (set! (-> self vehicle-selected)
                (the-as
                  uint
                  (-> *net-vehicles* (-> *menu-vehicle-array* array-ptr (-> *menu-vehicle-array* selection-index) extra-int) vt)
                  )
                )
          (let* ((a0-35
                   (-> *net-vehicles* (-> *menu-vehicle-array* array-ptr (-> *menu-vehicle-array* selection-index) extra-int) vt)
                   )
                 (a1-8 (-> *game-info* car-info data a0-35 tuning))
                 )
            (-> *car-upgrade-info* data a0-35)
            0
            (lobby-menu-update-performance-globals (the-as car-type a0-35) (the-as symbol a1-8))
            )
          (send-event (find-menu self 'garage-reminder) 'unhide)
          (let ((v0-1 (the-as object (current-time))))
            (set! (-> self state-time) (the-as time-frame v0-1))
            v0-1
            )
          )
         (('accept)
          (when (kill-menu self #f #f)
            (kill-menu self #t #f)
            (kill-menu self #t #f)
            (logior! (-> self vehicle-flags) (lobby-vehicle-flag no-vehicle-selection))
            (if (vehicle-level-ready? self 0)
                (send-event
                  (search-process-tree *active-pool* (lambda ((arg0 process)) (= (-> arg0 type) garage-turntable)))
                  'go-up
                  )
                )
            (go-virtual customize-main-menu)
            )
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (local-vars (v1-2 symbol) (v1-18 symbol))
    (dotimes (v1-0 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-0))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-0))) info-ptr) *adventure-top-bottom*)
                 )
        (set! v1-2 #t)
        (goto cfg-20)
        )
      )
    (set! v1-2 #f)
    (label cfg-20)
    (if v1-2
        (goto cfg-24)
        )
    (kill-menu self #t #f)
    (create-menu self *adventure-top-bottom* 0)
    #t
    (label cfg-24)
    (lobby-level-set! 1 #f #f)
    (set! (-> *garage-string* 0) (text-id text-id-3647))
    (set! (-> *adventure-bottom-bar-ids* 0) (text-id text-id-3648))
    (set! (-> *adventure-bottom-bar-dpad-ids* 0) (text-id text-id-1925))
    (dotimes (v1-16 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-16))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-16))) info-ptr) *map-screen*)
                 )
        (set! v1-18 #t)
        (goto cfg-44)
        )
      )
    (set! v1-18 #f)
    (label cfg-44)
    (if (not v1-18)
        (create-menu self *map-screen* 0)
        )
    (create-menu self *adventure-vehicle-select* 0)
    (copy-string<-string (-> self cam-string) "camera-18")
    (fill-vehicle-list self)
    (update-game-info-strings self)
    (cond
      ((logtest? *lobby-adv-cup* (game-task-node-flag cup1))
       (charp<-string (-> *game-title-extra* 0 text) (lookup-text! *common-text* (text-id text-id-1690) #f))
       )
      ((logtest? *lobby-adv-cup* (game-task-node-flag cup2))
       (charp<-string (-> *game-title-extra* 0 text) (lookup-text! *common-text* (text-id text-id-1691) #f))
       )
      ((logtest? *lobby-adv-cup* (game-task-node-flag cup3))
       (charp<-string (-> *game-title-extra* 0 text) (lookup-text! *common-text* (text-id text-id-1692) #f))
       )
      ((logtest? *lobby-adv-cup* (game-task-node-flag cup4))
       (charp<-string (-> *game-title-extra* 0 text) (lookup-text! *common-text* (text-id text-id-1693) #f))
       )
      )
    (let ((a0-49 (-> *net-world* net-state players 0 vehicle-selection)))
      (dotimes (v1-59 (-> *menu-vehicle-array* array-ptr length))
        (when (= (-> *menu-vehicle-array* array-ptr v1-59 extra-int) a0-49)
          (set! (-> *menu-vehicle-array* selection-index) v1-59)
          (goto cfg-63)
          )
        )
      )
    (set! (-> *menu-vehicle-array* selection-index) 0)
    (set! (-> self vehicle-selected)
          (the-as
            uint
            (-> *net-vehicles* (-> *menu-vehicle-array* array-ptr (-> *menu-vehicle-array* selection-index) extra-int) vt)
            )
          )
    (send-event (find-menu self 'garage-reminder) 'unhide)
    (set-time! (-> self state-time))
    (label cfg-63)
    (let* ((a0-60
             (-> *net-vehicles* (-> *menu-vehicle-array* array-ptr (-> *menu-vehicle-array* selection-index) extra-int) vt)
             )
           (a1-43 (-> *game-info* car-info data a0-60 tuning))
           )
      (-> *car-upgrade-info* data a0-60)
      (lobby-menu-update-performance-globals (the-as car-type a0-60) (the-as symbol a1-43))
      )
    (let ((v1-95 (get-open-task-node-info)))
      (if (and (logtest? (game-task-node-flag qualifier) (-> v1-95 flags)) (zero? (-> v1-95 play-count)))
          (set! (-> *adventure-bottom-bar-triangle-ids* 0) (text-id text-id-1712))
          (set! (-> *adventure-bottom-bar-triangle-ids* 0) (text-id text-id-1935))
          )
      )
    )
  :exit (behavior ()
    (when (not (or (= (-> self next-state name) 'die) (= (-> self next-state name) 'customize-main-menu)))
      (set! (-> *adventure-bottom-bar-ids* 0) (text-id text-id-1934))
      (set! (-> *adventure-bottom-bar-dpad-ids* 0) (text-id text-id-1931))
      )
    )
  :code (behavior ()
    (set! (-> *adventure-garage-reminder-ids* 0) (text-id text-id-4917))
    (cond
      ((= (-> self prev-state name) 'customize-main-menu)
       (set! (-> self state-time) 0)
       0
       )
      (else
        (set! (-> *adventure-garage-reminder-ids* 0) (text-id text-id-3645))
        (set-time! (-> self state-time))
        )
      )
    (suspend)
    (until #f
      (cond
        ((< (seconds 3) (- (current-time) (-> self state-time)))
         (if (vehicle-level-ready? self 0)
             (send-event
               (search-process-tree *active-pool* (lambda ((arg0 process)) (= (-> arg0 type) garage-turntable)))
               'go-up
               )
             )
         (send-event (find-menu self 'garage-reminder) 'hide)
         )
        (else
          (send-event
            (search-process-tree *active-pool* (lambda ((arg0 process)) (= (-> arg0 type) garage-turntable)))
            'go-down
            )
          )
        )
      (suspend)
      )
    #f
    )
  :post lobby-default-post
  )

;; WARN: Return type mismatch int vs game-task-node.
(defun get-new-qualifier ()
  (let* ((gp-0 *lobby-adv-cup*)
         (v1-0 (get-task-cup-score (the-as int gp-0)))
         (a0-2 (-> *game-info* sub-task-list))
         )
    (dotimes (a1-0 (-> a0-2 length))
      (when (nonzero? a1-0)
        (let ((a2-3 (-> a0-2 a1-0)))
          (if (and (-> *game-info* play-list (-> a2-3 task) play-continue)
                   (-> *game-info* play-list (-> a2-3 task) single-player)
                   (logtest? (-> a2-3 flags) gp-0)
                   (logtest? (game-task-node-flag qualifier) (-> a2-3 flags))
                   (and (>= v1-0 (-> a2-3 adv-score)) (>= (-> a2-3 adv-score) 0))
                   (zero? (-> a2-3 play-count))
                   )
              (return (the-as game-task-node a1-0))
              )
          )
        )
      )
    )
  (the-as game-task-node 0)
  )

(defstate adventure-save (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (local-vars (v0-0 object))
    (case message
      (('notify)
       (case (-> block param 0)
         (('done)
          (case (-> block param 1)
            ((1)
             (set! v0-0 1)
             (set! (-> self memcard-status) (the-as uint v0-0))
             )
            (else
              (format 0 "-----------**********---------- ~S~%" "error saving game")
              (set! (-> *profile-errors-continue* 0) (the-as uint 171))
              (set! (-> *profile-errors-continue* 1) (the-as uint 175))
              (set! (-> *profile-errors-continue* 2) (the-as uint 2905))
              (set! v0-0 2)
              (set! (-> self memcard-status) (the-as uint v0-0))
              )
            )
          v0-0
          )
         (('error)
          (format 0 "-------------+++++++++++---------- ~S~%" "error saving game")
          (set! (-> *profile-errors-continue* 0) (the-as uint 171))
          (set! (-> *profile-errors-continue* 1) (the-as uint 175))
          (set! (-> *profile-errors-continue* 2) (the-as uint 2905))
          (set! v0-0 2)
          (set! (-> self memcard-status) (the-as uint v0-0))
          v0-0
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (local-vars (v1-9 symbol))
    (kill-menu self #t #f)
    (set! (-> self split-selection-prev-state) 'adventure-save)
    (cond
      ((-> *setting-control* user-current auto-save)
       (set! (-> *profile-not-remove* 0) (the-as uint 160))
       (set! (-> *profile-not-remove* 1) (the-as uint 164))
       (dotimes (v1-7 (+ (-> self in-focus-index) 1))
         (when (and (handle->process (-> self menu-handles v1-7))
                    (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-7))) info-ptr)
                       *menu-formating-card-profile*
                       )
                    )
           (set! v1-9 #t)
           (goto cfg-21)
           )
         )
       (set! v1-9 #f)
       (label cfg-21)
       (if v1-9
           (goto cfg-25)
           )
       (kill-menu self #t #f)
       (create-menu self *menu-formating-card-profile* 0)
       #t
       (label cfg-25)
       (auto-save-command 'auto-save 0 *profile-slot* self #f #f)
       (set! (-> self memcard-status) (the-as uint 0))
       0
       )
      (else
        (set! (-> self memcard-status) (the-as uint 1))
        )
      )
    )
  :trans (behavior ()
    (local-vars (v1-20 symbol))
    (when (= (-> self memcard-status) 2)
      (if (kill-menu self #f #f)
          (go-virtual no-card)
          )
      )
    (when (= (-> self memcard-status) 1)
      (when (or (kill-menu self #f #f) (not (-> *setting-control* user-current auto-save)))
        (cond
          (*return-to-secrets*
            (go-virtual secrets-menu)
            )
          ((= (get-next-training-task) (game-task-node none))
           (jukebox-onoff #t)
           (set! *adv-coming-back-from-game* #t)
           (dotimes (v1-18 (+ (-> self in-focus-index) 1))
             (when (and (handle->process (-> self menu-handles v1-18))
                        (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-18))) info-ptr) *adventure-top-bottom*)
                        )
               (set! v1-20 #t)
               (goto cfg-32)
               )
             )
           (set! v1-20 #f)
           (label cfg-32)
           (if v1-20
               (goto cfg-36)
               )
           (kill-menu self #t #f)
           (create-menu self *adventure-top-bottom* 0)
           #t
           (label cfg-36)
           (let ((s5-0 #f)
                 (gp-0 #f)
                 )
             (let ((a1-13 (get-new-qualifier)))
               (when (nonzero? a1-13)
                 (let ((s5-1 (-> *game-info* sub-task-list a1-13)))
                   (set-task-node *net-world* a1-13)
                   (if (-> s5-1 ipu)
                       (fmv-player-run-texture (-> s5-1 ipu) *default-pool*)
                       )
                   (set-action!
                     *gui-control*
                     (gui-action stop)
                     (the-as sound-id 1)
                     (gui-channel citizen)
                     (gui-action none)
                     (the-as string #f)
                     (the-as (function gui-connection symbol) #f)
                     (the-as process #f)
                     )
                   (when (-> s5-1 task-sound-description)
                     (remove-setting! 'music-volume)
                     (add-setting! 'music-volume 'rel 0.25 0)
                     (set! (-> *lobby-menu-manager* voice-id)
                           (add-process
                             *gui-control*
                             *lobby-menu-manager*
                             (gui-channel citizen)
                             (gui-action play)
                             (-> s5-1 task-sound-description)
                             -99.0
                             0
                             )
                           )
                     (sound-params-set!
                       *gui-control*
                       (-> *lobby-menu-manager* voice-id)
                       #f
                       -1.0
                       -1.0
                       1.0
                       (-> *setting-control* user-current talker-volume)
                       #t
                       )
                     )
                   )
                 (if (not (handle->process (-> self vehicle-handle)))
                     (set! (-> self vehicle-selected)
                           (-> *game-info* player-info (-> self current-local-player) last-selected-vehicle)
                           )
                     )
                 (set! *lobby-adv-selected-task* 0)
                 (set! (-> *adventure-task-info-array* *lobby-adv-selected-task* extra-int) 1)
                 (set! s5-0 #t)
                 (let ((v1-62 (get-open-task-node-info)))
                   (when v1-62
                     (if (logtest? (game-task-node-flag qualifier) (-> v1-62 flags))
                         (set! gp-0 #t)
                         )
                     )
                   )
                 )
               )
             (cond
               (*open-new-cup*
                 (lobby-level-set! 1 'menumap 'display)
                 (go-virtual adventure-cup)
                 )
               (s5-0
                 (go-virtual adventure-vehicle-select)
                 )
               (gp-0
                 (lobby-level-set! 1 'menumap 'display)
                 (go-virtual adventure-venue)
                 )
               (else
                 (lobby-level-set! 1 'menumap 'display)
                 (go-virtual adventure-map)
                 )
               )
             )
           )
          (else
            (go-virtual adventure-training)
            )
          )
        )
      )
    )
  :code sleep-code
  :post lobby-default-post
  )

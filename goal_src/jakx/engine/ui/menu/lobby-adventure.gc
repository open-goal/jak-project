(defbehavior adventure-map-update lobby-menu-manager ((arg0 symbol))
  (case arg0
    (('kras-city)
     (copy-string<-string (-> self cam-string) "camera-55")
     (set! *lobby-adv-selected-map* (game-task-node-flag kras-city))
     (set-menumap-target! 2)
     )
    (('haven-city)
     (copy-string<-string (-> self cam-string) "camera-56")
     (set! *lobby-adv-selected-map* (game-task-node-flag haven-city))
     (set-menumap-target! 3)
     )
    (('spargus)
     (copy-string<-string (-> self cam-string) "camera-57")
     (set! *lobby-adv-selected-map* (game-task-node-flag spargus))
     (set-menumap-target! 1)
     )
    (('icelands)
     (copy-string<-string (-> self cam-string) "camera-58")
     (set! *lobby-adv-selected-map* (game-task-node-flag icelands))
     (set-menumap-target! 4)
     )
    (('grandprix)
     (cond
       ((logtest? *lobby-adv-cup* (game-task-node-flag cup1))
        (copy-string<-string (-> self cam-string) "camera-60")
        )
       ((logtest? *lobby-adv-cup* (game-task-node-flag cup2))
        (copy-string<-string (-> self cam-string) "camera-61")
        )
       ((logtest? *lobby-adv-cup* (game-task-node-flag cup3))
        (copy-string<-string (-> self cam-string) "camera-70")
        )
       ((logtest? *lobby-adv-cup* (game-task-node-flag cup4))
        (copy-string<-string (-> self cam-string) "camera-62")
        )
       )
     (set! *lobby-adv-selected-map* (game-task-node-flag qualifier))
     (set-menumap-target! 0)
     )
    )
  )

;; WARN: Return type mismatch int vs object.
(defun update-adventure-map-data ()
  (dotimes (v1-0 (-> *adventure-map-stats* length))
    (set! (-> *adventure-map-stats* v1-0 extra) (the-as basic 0))
    )
  (charp<-string (-> *adventure-map-city* 0 text) (lookup-text! *common-text* (text-id text-id-1686) #f))
  (charp<-string (-> *adventure-map-city* 1 text) (lookup-text! *common-text* (text-id text-id-1687) #f))
  (charp<-string (-> *adventure-map-city* 2 text) (lookup-text! *common-text* (text-id text-id-1688) #f))
  (charp<-string (-> *adventure-map-city* 3 text) (lookup-text! *common-text* (text-id text-id-1689) #f))
  (charp<-string (-> *adventure-map-city* 4 text) (lookup-text! *common-text* (text-id text-id-2185) #f))
  (let* ((s5-5 *lobby-adv-cup*)
         (gp-5 (get-task-cup-score (the-as int s5-5)))
         )
    (dotimes (s4-0 4)
      (let* ((v1-18 s4-0)
             (v1-19 (cond
                      ((zero? v1-18)
                       4096
                       )
                      ((= v1-18 1)
                       8192
                       )
                      ((= v1-18 2)
                       #x4000
                       )
                      ((= v1-18 3)
                       #x8000
                       )
                      ((= v1-18 4)
                       #x10000
                       )
                      )
                    )
             )
        0
        0
        (let ((a0-26 #f))
          (let ((a1-12 (-> *game-info* sub-task-list)))
            (dotimes (a2-5 (-> a1-12 length))
              (when (nonzero? a2-5)
                (let ((a3-3 (-> a1-12 a2-5)))
                  (when (and (-> *game-info* play-list (-> a3-3 task) play-continue)
                             (-> *game-info* play-list (-> a3-3 task) single-player)
                             (logtest? (-> a3-3 flags) s5-5)
                             (logtest? (the-as game-task-node-flag v1-19) (-> a3-3 flags))
                             (not (logtest? (game-task-node-flag qualifier) (-> a3-3 flags)))
                             (>= (-> a3-3 adv-score) 0)
                             )
                    (when (and (>= gp-5 (-> a3-3 adv-score)) (>= (-> a3-3 adv-score) 0))
                      (if (zero? (-> a3-3 play-count))
                          (set! a0-26 #t)
                          )
                      (+! (-> *adventure-map-stats* s4-0 extra-int16 0) (the-as int (-> a3-3 medals 0)))
                      (+! (-> *adventure-map-stats* s4-0 extra-int16 1) 3)
                      )
                    )
                  )
                )
              )
            )
          (if a0-26
              (charp<-string (-> *adventure-map-new* s4-0 text) (lookup-text! *common-text* (text-id text-id-1737) #f))
              (charp<-string (-> *adventure-map-new* s4-0 text) "")
              )
          )
        )
      (let ((s3-1 charp<-string)
            (s2-1 (-> *adventure-map-stats* s4-0 text))
            )
        (format
          (clear *temp-string*)
          "~D/~D"
          (-> *adventure-map-stats* s4-0 extra-int16 0)
          (-> *adventure-map-stats* s4-0 extra-int16 1)
          )
        (s3-1 s2-1 *temp-string*)
        )
      )
    (let ((s4-1 4))
      0
      0
      (let ((v1-45 #f))
        (let ((a0-36 #f))
          (let ((a1-18 0)
                (a2-10 (-> *game-info* sub-task-list))
                )
            (dotimes (a3-16 (-> a2-10 length))
              (when (nonzero? a3-16)
                (let ((t0-38 (-> a2-10 a3-16)))
                  (when (and (-> *game-info* play-list (-> t0-38 task) play-continue)
                             (-> *game-info* play-list (-> t0-38 task) single-player)
                             (logtest? (-> t0-38 flags) s5-5)
                             (logtest? (game-task-node-flag qualifier) (-> t0-38 flags))
                             (>= (-> t0-38 adv-score) 0)
                             )
                    (set! (-> *grand-prix-medal* a1-18) -1)
                    (when (and (>= gp-5 (-> t0-38 adv-score)) (>= (-> t0-38 adv-score) 0))
                      (if (zero? (-> t0-38 play-count))
                          (set! v1-45 #t)
                          )
                      (if (!= (-> *game-info* sub-task-list a3-16 medals 0) (game-task-medal gold))
                          (set! a0-36 #t)
                          )
                      (+! (-> *adventure-map-stats* s4-1 extra-int16 0) (the-as int (-> t0-38 medals 0)))
                      (+! (-> *adventure-map-stats* s4-1 extra-int16 1) 3)
                      (set! (-> *grand-prix-medal* a1-18) (the-as int (-> t0-38 medals 0)))
                      )
                    (+! a1-18 1)
                    )
                  )
                )
              )
            )
          (set! (-> *grand-prix-medal* 2) -1)
          (let* ((a1-22 *lobby-adv-cup*)
                 (a1-23 (cond
                          ((= a1-22 (game-task-node-flag cup1))
                           0
                           )
                          ((= a1-22 (game-task-node-flag cup2))
                           1
                           )
                          ((= a1-22 (game-task-node-flag cup3))
                           2
                           )
                          ((= a1-22 (game-task-node-flag cup4))
                           3
                           )
                          (else
                            0
                            )
                          )
                        )
                 )
            (if (and (>= gp-5 (the-as int (-> *game-info* grand-prix a1-23 score))) (not a0-36))
                (set! (-> *grand-prix-medal* 2) (the-as int (-> *game-info* grand-prix a1-23 trophy)))
                )
            (if (and (>= gp-5 (the-as int (-> *game-info* grand-prix a1-23 score)))
                     (not a0-36)
                     (zero? (-> *game-info* grand-prix a1-23 play-count))
                     )
                (set! v1-45 #t)
                )
            )
          )
        (if v1-45
            (charp<-string (-> *adventure-map-new* s4-1 text) (lookup-text! *common-text* (text-id text-id-1737) #f))
            (charp<-string (-> *adventure-map-new* s4-1 text) "")
            )
        )
      (let ((gp-7 charp<-string)
            (s5-7 (-> *adventure-map-stats* s4-1 text))
            )
        (format
          (clear *temp-string*)
          "~D/~D"
          (-> *adventure-map-stats* s4-1 extra-int16 0)
          (-> *adventure-map-stats* s4-1 extra-int16 1)
          )
        (gp-7 s5-7 *temp-string*)
        )
      )
    )
  0
  )

(defstate adventure-map (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('menu-selection-event)
       (case (-> block param 0)
         (('changed)
          (adventure-map-update (the-as symbol (-> block param 1)))
          )
         (('cancel)
          (when (kill-menu self #f #f)
            (send-event (the-as map-menu (handle->process (-> self map-proc))) 'leave)
            (kill-menu self #f #f)
            (go-virtual adventure-cup)
            )
          )
         (('accept)
          (case (-> block param 1)
            (('icelands)
             (-> *adventure-map-stats* 0 extra-int16 1)
             (set! (-> *adventure-city-ids* 0) (text-id text-id-1686))
             )
            (('haven-city)
             (-> *adventure-map-stats* 1 extra-int16 1)
             (set! (-> *adventure-city-ids* 0) (text-id text-id-1687))
             )
            (('kras-city)
             (-> *adventure-map-stats* 2 extra-int16 1)
             (set! (-> *adventure-city-ids* 0) (text-id text-id-1688))
             )
            (('spargus)
             (-> *adventure-map-stats* 3 extra-int16 1)
             (set! (-> *adventure-city-ids* 0) (text-id text-id-1689))
             )
            (('qualifier)
             (-> *adventure-map-stats* 4 extra-int16 1)
             (set! (-> *adventure-city-ids* 0) (text-id text-id-2185))
             )
            (else
              (set! (-> *adventure-city-ids* 0) (text-id text-id-2185))
              0
              )
            )
          (when (kill-menu self #f #f)
            (case (-> block param 1)
              (('grandprix)
               (set! *lobby-adv-grand-prix* #t)
               (go-virtual adventure-grand-prix)
               )
              (else
                (go-virtual adventure-venue)
                )
              )
            )
          )
         (else
           #f
           )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (set! (-> self vehicle-selected) (the-as uint -1))
    (if (= *lobby-adv-cup* (the-as game-task-node-flag -1))
        (set! *lobby-adv-cup* (game-task-node-flag cup1))
        )
    (set! *lobby-adv-grand-prix* (the-as object #f))
    (when *adv-coming-back-from-game*
      (set! *adv-coming-back-from-game* #f)
      (let ((gp-0 0))
        (dotimes (s5-0 (length (-> *game-info* sub-task-list)))
          (let ((v1-8 (-> *game-info* sub-task-list s5-0)))
            (if (and (-> *game-info* play-list (-> v1-8 task) play-continue)
                     (-> *game-info* play-list (-> v1-8 task) single-player)
                     (> (-> v1-8 play-count) 0)
                     )
                (+! gp-0 1)
                )
            )
          )
        (if (zero? gp-0)
            (go-virtual adventure-cup)
            )
        )
      )
    (set! (-> *garage-string* 0) (text-id text-id-1712))
    (set! (-> *adventure-bottom-bar-ids* 0) (text-id text-id-1934))
    (set! (-> *adventure-bottom-bar-dpad-ids* 0) (text-id text-id-1931))
    (set! (-> *adventure-bottom-bar-triangle-ids* 0) (text-id text-id-1935))
    )
  :code (behavior ()
    (local-vars (v1-7 symbol))
    (adventure-map-fade-in)
    (while (!= (level-status? *level* 'menumap #f) 'active)
      (suspend)
      )
    (when (= (-> self prev-state name) 'adventure-cup)
      (dotimes (v1-5 (+ (-> self in-focus-index) 1))
        (when (and (handle->process (-> self menu-handles v1-5))
                   (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-5))) info-ptr) *adventure-top-bottom*)
                   )
          (set! v1-7 #t)
          (goto cfg-24)
          )
        )
      (set! v1-7 #f)
      (label cfg-24)
      (if v1-7
          (goto cfg-28)
          )
      (kill-menu self #t #f)
      (create-menu self *adventure-top-bottom* 0)
      #t
      )
    (label cfg-28)
    (create-menu self *adventure-map* 0)
    (update-adventure-map-data)
    (adventure-map-update 'icelands)
    (restore-selection-index)
    (sleep-code)
    )
  :post lobby-default-post
  )

(define *list-task-medals* (new 'static 'boxed-array :type int8 :length 0 :allocated-length 64))

(define *adventure-venue-info-array*
  (new 'static 'boxed-array :type menu-option-info
    (new 'static 'menu-option-info :display-name-id (text-id text-id-526) :sym #f)
    (new 'static 'menu-option-info :display-name-id (text-id text-id-526) :sym #f)
    (new 'static 'menu-option-info :display-name-id (text-id text-id-526) :sym #f)
    (new 'static 'menu-option-info :display-name-id (text-id text-id-526) :sym #f)
    (new 'static 'menu-option-info :display-name-id (text-id text-id-526) :sym #f)
    (new 'static 'menu-option-info :display-name-id (text-id text-id-526) :sym #f)
    (new 'static 'menu-option-info :display-name-id (text-id text-id-526) :sym #f)
    (new 'static 'menu-option-info :display-name-id (text-id text-id-526) :sym #f)
    )
  )

(deftype dropdown-venue (dropdown-fade)
  ()
  )


;; WARN: Return type mismatch int vs object.
(defmethod draw-menu ((this dropdown-venue))
  (if (-> this enabled)
      (call-parent-method this)
      )
  0
  )

;; WARN: Return type mismatch object vs none.
(defmethod update-strings ((this dropdown-venue))
  (call-parent-method this)
  (cond
    ((= (-> *adventure-venue-info-array* (-> this info-ptr user-data) display-name-id) (text-id text-id-0))
     (send-event this 'disabled)
     )
    (else
      (format
        (clear (-> this strings data 0 text))
        "~S"
        (lookup-text! *common-text* (-> *adventure-venue-info-array* (-> this info-ptr user-data) display-name-id) #f)
        )
      (format
        (clear (-> this strings data 1 text))
        "~G"
        (-> *adventure-venue-new* (-> this info-ptr user-data) text)
        )
      (format
        (clear (-> this strings data 2 text))
        "~G"
        (-> *adventure-venue-stats* (-> this info-ptr user-data) text)
        )
      (dotimes (s5-3 6)
        (set! (-> this info-ptr sprites-info s5-3 scale-x) 0.6)
        (let ((v1-36 (-> *list-task-medals* (+ s5-3 (* (-> this info-ptr user-data) 8)))))
          (cond
            ((= v1-36 -2)
             (set! (-> this p-client-array s5-3 strip tex-id)
                   (lookup-texture-id-by-name "hud-transparent-01" (the-as string #f))
                   )
             (set! (-> this info-ptr sprites-info s5-3 scale-x) 0.0)
             )
            ((= v1-36 -1)
             (set! (-> this p-client-array s5-3 strip tex-id)
                   (lookup-texture-id-by-name "amode-icon-padlock-01" (the-as string #f))
                   )
             )
            ((zero? v1-36)
             (set! (-> this p-client-array s5-3 strip tex-id)
                   (lookup-texture-id-by-name "is-medal-blank-01" (the-as string #f))
                   )
             )
            ((= v1-36 1)
             (set! (-> this p-client-array s5-3 strip tex-id)
                   (lookup-texture-id-by-name "is-medal-bronze-01" (the-as string #f))
                   )
             )
            ((= v1-36 2)
             (set! (-> this p-client-array s5-3 strip tex-id)
                   (lookup-texture-id-by-name "is-medal-silver-01" (the-as string #f))
                   )
             )
            ((= v1-36 3)
             (set! (-> this p-client-array s5-3 strip tex-id)
                   (lookup-texture-id-by-name "is-medal-gold-01" (the-as string #f))
                   )
             )
            )
          )
        )
      )
    )
  (none)
  )

(defmethod handle-input ((this dropdown-venue) (arg0 int))
  (cond
    ((cpad-pressed? arg0 x)
     (send-event
       (ppointer->process (-> this parent))
       'menu-selection-event
       'accept
       (-> *adventure-venue-info-array* (-> this info-ptr user-data) sym)
       )
     (set! (-> *adventure-venue-ids* 0)
           (-> *adventure-venue-info-array* (-> this info-ptr user-data) display-name-id)
           )
     (let ((v1-25 (make-sound-instance snd-choice1 (new 'static 'sound-id) (the-as handle #f))))
       (cond
         (v1-25
           (logior! (-> v1-25 flags) (sound-spec-flag needs-update non-positional))
           (-> v1-25 id)
           )
         (else
           0
           )
         )
       )
     )
    (else
      (call-parent-method this arg0)
      )
    )
  )


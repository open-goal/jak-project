(defbehavior adventure-task-init lobby-menu-manager ()
  (let ((gp-0 0))
    (if *adv-coming-back-from-game*
        (lobby-level-set! 1 'menumap #f)
        )
    (set! (-> *garage-string* 0) (text-id text-id-1712))
    (when (not (or (= (-> self prev-state name) 'customize-main-menu)
                   (= (-> self prev-state name) 'adventure-vehicle-select)
                   )
               )
      (set! *lobby-adv-selected-task* -1)
      (let* ((s2-0 *lobby-adv-cup*)
             (s1-0 (get-task-cup-score (the-as int s2-0)))
             (s3-0 *adventure-task-info-array*)
             (s5-0 0)
             (s4-0 #t)
             )
        (dotimes (v1-10 (-> s3-0 length))
          (set! (-> s3-0 v1-10 display-name-id) (text-id text-id-0))
          )
        (dotimes (s0-0 (-> *adventure-task-stats* length))
          (charp<-string (-> *adventure-task-stats* s0-0 text) "")
          )
        (let ((s0-1 (-> *game-info* sub-task-list))
              (sv-16 0)
              )
          (while (< sv-16 (-> s0-1 length))
            (when (nonzero? sv-16)
              (let ((sv-32 (-> s0-1 sv-16)))
                (when (and (-> *game-info* play-list (-> sv-32 task) play-continue)
                           (-> *game-info* play-list (-> sv-32 task) single-player)
                           (logtest? (-> sv-32 flags) s2-0)
                           (= *lobby-adv-selected-venue* (-> sv-32 level))
                           (>= (-> sv-32 adv-score) 0)
                           (not (logtest? (game-task-node-flag qualifier) (-> sv-32 flags)))
                           )
                  (set! (-> s3-0 s5-0 extra-int) 0)
                  (set! (-> s3-0 s5-0 display-name-id)
                        (-> *net-play-mode-text-ids* (-> *game-info* sub-task-list sv-16 net-play-mode))
                        )
                  (set! (-> s3-0 s5-0 sym) (the-as symbol (-> sv-32 task)))
                  (set! (-> *task-medals* s5-0) (if (and (>= s1-0 (-> sv-32 adv-score)) (>= (-> sv-32 adv-score) 0))
                                                    (the-as int (-> *game-info* sub-task-list sv-16 medals 0))
                                                    -1
                                                    )
                        )
                  (set! (-> *adventure-task-sprite-info-array* s5-0)
                        (lookup-texture-id-by-name
                          (-> *net-play-mode-icon-string* (-> *game-info* sub-task-list sv-16 net-play-mode))
                          (the-as string #f)
                          )
                        )
                  (if (and (and (>= s1-0 (-> sv-32 adv-score)) (>= (-> sv-32 adv-score) 0))
                           (!= (-> *game-info* sub-task-list sv-16 medals 0) 3)
                           )
                      (set! s4-0 #f)
                      )
                  (when (and (>= s1-0 (-> sv-32 adv-score)) (>= (-> sv-32 adv-score) 0))
                    (set! (-> s3-0 s5-0 extra-int) 1)
                    (+! gp-0 1)
                    (format
                      0
                      "------------- ~D ~D ~D~%"
                      (-> *game-info* sub-task-list sv-16 net-play-mode)
                      (-> s3-0 s5-0 display-name-id)
                      (-> *game-info* sub-task-list sv-16 medals 0)
                      )
                    )
                  (+! s5-0 1)
                  )
                )
              )
            (+! sv-16 1)
            )
          )
        (if (zero? gp-0)
            (lobby-level-set! 1 'menumap #f)
            )
        (set! (-> s3-0 length) s5-0)
        (set! (-> *task-medals* length) s5-0)
        (cond
          ((and s4-0 *adv-coming-back-from-game*)
           (set-action!
             *gui-control*
             (gui-action stop)
             (the-as sound-id 1)
             (gui-channel citizen)
             (gui-action none)
             (the-as string #f)
             (the-as (function gui-connection symbol) #f)
             (the-as process #f)
             )
           (go-virtual adventure-venue)
           )
          (else
            (set! *adv-coming-back-from-game* #f)
            #f
            )
          )
        )
      )
    (if (not (handle->process (-> self vehicle-handle)))
        (set! (-> self vehicle-selected)
              (-> *game-info* player-info (-> self current-local-player) last-selected-vehicle)
              )
        )
    (if (!= (-> self prev-state name) 'customize-main-menu)
        (send-vehicle-to-net-world self)
        )
    (if *net-world*
        (set-player-vehicle
          *net-world*
          -1
          (+ (* (if *net-mgr*
                    (-> *net-mgr* game-state local-machine-idx)
                    0
                    )
                2
                )
             1
             )
          (new 'static 'vehicle-load-parts)
          (new 'static 'tuning-info)
          )
        0
        )
    (set! (-> *garage-string* 0) (text-id text-id-1712))
    (set! (-> *adventure-bottom-bar-ids* 0) (text-id text-id-1934))
    (set! (-> *adventure-bottom-bar-dpad-ids* 0) (text-id text-id-1931))
    (set! (-> *adventure-bottom-bar-triangle-ids* 0) (text-id text-id-1935))
    (adventure-map-fade-out (zero? gp-0))
    )
  )

(defstate adventure-task (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('menu-selection-event)
       (format 0 "---------------- ~S~%" (-> block param 0))
       (case (-> block param 0)
         (('event)
          #f
          )
         (('cancel)
          (when (kill-menu self #f #f)
            (kill-menu self #t #f)
            (set! (-> self vehicle-selected) (the-as uint -1))
            (set-action!
              *gui-control*
              (gui-action stop)
              (the-as sound-id 1)
              (gui-channel citizen)
              (gui-action none)
              (the-as string #f)
              (the-as (function gui-connection symbol) #f)
              (the-as process #f)
              )
            (go-virtual adventure-venue)
            )
          )
         (('accept)
          (when (!= *lobby-adv-selected-task* -1)
            (let ((a0-12 (-> *adventure-task-info-array* *lobby-adv-selected-task*)))
              (when (= (-> a0-12 extra-int) 1)
                (kill-menu self #t #f)
                (go-virtual adventure-vehicle-select)
                )
              )
            )
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :exit (behavior ()
    (if (!= (-> self next-state name) 'adventure-vehicle-select)
        (kill-by-type fmv-player *active-pool*)
        )
    )
  :trans (behavior ()
    (when *net-world*
      (format (clear *level-texture-string*) (-> *task-level-info* (-> *net-world* task-info task-level) tex-name))
      (format (clear *map-texture-string*) (-> *task-level-info* (-> *net-world* task-info task-level) tex-name))
      (format *map-texture-string* "-map")
      )
    (if (handle->process (-> self vehicle-handle))
        (send-event
          (search-process-tree *active-pool* (lambda ((arg0 process)) (= (-> arg0 type) garage-turntable)))
          'go-up
          )
        (set! (-> self vehicle-selected)
              (-> *game-info* player-info (-> self current-local-player) last-selected-vehicle)
              )
        )
    (when (and (cpad-hold? 0 r3) *cheat-mode*)
      (let ((v1-30 (get-open-task-node-info)))
        (when v1-30
          (when (nonzero? (-> *cpad-list* cpads 0 button0-rel 0))
            (let ((a0-20 (-> *cheat-temp* 5)))
              (cond
                ((zero? a0-20)
                 (cond
                   ((cpad-pressed? 0 l1)
                    (+! (-> *cheat-temp* 5) 1)
                    )
                   (else
                     (set! (-> *cheat-temp* 5) 0)
                     0
                     )
                   )
                 )
                ((= a0-20 1)
                 (cond
                   ((cpad-pressed? 0 r1)
                    (+! (-> *cheat-temp* 5) 1)
                    )
                   (else
                     (set! (-> *cheat-temp* 5) 0)
                     0
                     )
                   )
                 )
                ((= a0-20 2)
                 (cond
                   ((cpad-pressed? 0 r2)
                    (+! (-> *cheat-temp* 5) 1)
                    )
                   (else
                     (set! (-> *cheat-temp* 5) 0)
                     0
                     )
                   )
                 )
                ((= a0-20 3)
                 (cond
                   ((cpad-pressed? 0 l2)
                    (set! (-> v1-30 medals 0) (game-task-medal gold))
                    (let ((v1-56 (make-sound-instance snd-choice (new 'static 'sound-id) (the-as handle #f))))
                      (cond
                        (v1-56
                          (set! (-> v1-56 fo-power) 0.0)
                          (logior! (-> v1-56 flags) (sound-spec-flag fo-power needs-update non-positional))
                          (-> v1-56 id)
                          )
                        (else
                          0
                          )
                        )
                      )
                    (let ((v1-60 (make-sound-instance snd-choice (new 'static 'sound-id) (the-as handle #f))))
                      (cond
                        (v1-60
                          (set! (-> v1-60 fo-power) 0.0)
                          (logior! (-> v1-60 flags) (sound-spec-flag fo-power needs-update non-positional))
                          (-> v1-60 id)
                          )
                        (else
                          0
                          )
                        )
                      )
                    (set! (-> *cheat-temp* 5) 0)
                    0
                    )
                   (else
                     (set! (-> *cheat-temp* 5) 0)
                     0
                     )
                   )
                 )
                )
              )
            )
          )
        )
      )
    (let ((v1-66 (the-as sprite-ptr-menu (find-menu self '2d-map))))
      (when v1-66
        (if (logtest? (-> *net-world* net-state flags) 8)
            (set! (-> v1-66 info-ptr sprites-info 0 scale-x) -2.0)
            (set! (-> v1-66 info-ptr sprites-info 0 scale-x) 2.0)
            )
        )
      )
    )
  :code (behavior ()
    (local-vars (v1-11 symbol))
    (adventure-task-init)
    (suspend)
    (when *net-world*
      (if (logtest? (-> *game-info* secrets) (game-secrets gs15))
          (net-world-method-59 *net-world* #t)
          (net-world-method-59 *net-world* #f)
          )
      )
    (dotimes (v1-9 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-9))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-9))) info-ptr) *map-screen*)
                 )
        (set! v1-11 #t)
        (goto cfg-24)
        )
      )
    (set! v1-11 #f)
    (label cfg-24)
    (if (not v1-11)
        (create-menu self *map-screen* 0)
        )
    (create-menu self *adventure-task* 0)
    (suspend)
    (cond
      ((= (-> self prev-state name) 'adventure-vehicle-select)
       (restore-selection-index)
       )
      (else
        (let* ((s5-0 (the-as object '(task0 task1 task2 task3 task4 task5)))
               (gp-0 (-> (the-as pair s5-0) car))
               )
          (while (not (null? s5-0))
            (when (send-event (the-as selection-menu-manager (find-menu self (the-as symbol gp-0))) 'open-medal?)
              (select-by-sym (the-as selection-menu-manager (find-menu *lobby-menu-manager* 'manager)) (the-as symbol gp-0))
              (goto cfg-37)
              )
            (set! s5-0 (-> (the-as pair s5-0) cdr))
            (set! gp-0 (-> (the-as pair s5-0) car))
            )
          )
        (select-by-sym (the-as selection-menu-manager (find-menu *lobby-menu-manager* 'manager)) 'task0)
        )
      )
    (label cfg-37)
    (sleep-code)
    )
  :post lobby-default-post
  )

(defstate adventure-grand-prix (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('menu-selection-event)
       (case (-> block param 0)
         (('event)
          #f
          )
         (('cancel)
          (when (kill-menu self #f #f)
            (kill-menu self #t #f)
            (set! (-> self vehicle-selected) (the-as uint -1))
            (set-action!
              *gui-control*
              (gui-action stop)
              (the-as sound-id 1)
              (gui-channel citizen)
              (gui-action none)
              (the-as string #f)
              (the-as (function gui-connection symbol) #f)
              (the-as process #f)
              )
            (go-virtual adventure-map)
            )
          )
         (('accept)
          (when (!= *lobby-adv-selected-task* -1)
            (let ((v1-15 (-> *adventure-task-info-array* *lobby-adv-selected-task*)))
              (cond
                ((= (-> v1-15 sym) 'grand-prix)
                 (when (= (-> v1-15 extra-int) 1)
                   (let* ((v1-17 *lobby-adv-cup*)
                          (v1-18 (cond
                                   ((= v1-17 (game-task-node-flag cup1))
                                    0
                                    )
                                   ((= v1-17 (game-task-node-flag cup2))
                                    1
                                    )
                                   ((= v1-17 (game-task-node-flag cup3))
                                    2
                                    )
                                   ((= v1-17 (game-task-node-flag cup4))
                                    3
                                    )
                                   (else
                                     0
                                     )
                                   )
                                 )
                          )
                     (dotimes (a0-17 23)
                       (set! (-> *game-info* cumulative-grand-prix-score a0-17) (the-as uint 0))
                       )
                     (set! (-> *game-info* playing-grand-prix?) (-> *game-info* grand-prix v1-18))
                     )
                   (+! (-> *game-info* playing-grand-prix? play-count) 1)
                   (kill-menu self #t #f)
                   (go-virtual adventure-vehicle-select)
                   )
                 )
                (else
                  (when (= (-> v1-15 extra-int) 1)
                    (kill-menu self #t #f)
                    (go-virtual adventure-vehicle-select)
                    )
                  )
                )
              )
            )
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (set! (-> *game-info* grand-prix-index) (the-as uint 0))
    (set! (-> *game-info* playing-grand-prix?) #f)
    (set! (-> *adventure-venue-ids* 0) (text-id text-id-2185))
    (set! (-> *garage-string* 0) (text-id text-id-1712))
    (kill-by-type fmv-player *active-pool*)
    (when (!= (-> self prev-state name) 'customize-main-menu)
      (set! *lobby-adv-selected-task* -1)
      (let* ((s1-0 *lobby-adv-cup*)
             (s2-0 (get-task-cup-score (the-as int s1-0)))
             (s5-0 *adventure-task-info-array*)
             (s4-0 0)
             (gp-0 #t)
             )
        (let ((s3-0 #f))
          (dotimes (v1-7 (-> s5-0 length))
            (set! (-> s5-0 v1-7 display-name-id) (text-id text-id-0))
            )
          (dotimes (s0-0 (-> *adventure-task-stats* length))
            (charp<-string (-> *adventure-task-stats* s0-0 text) "")
            )
          (let ((s0-1 (-> *game-info* sub-task-list))
                (sv-16 0)
                )
            (while (< sv-16 (-> s0-1 length))
              (when (nonzero? sv-16)
                (let ((sv-32 (-> s0-1 sv-16)))
                  (when (and (-> *game-info* play-list (-> sv-32 task) play-continue)
                             (-> *game-info* play-list (-> sv-32 task) single-player)
                             (logtest? (-> sv-32 flags) s1-0)
                             (>= (-> sv-32 adv-score) 0)
                             (logtest? (game-task-node-flag qualifier) (-> sv-32 flags))
                             )
                    (set! (-> s5-0 s4-0 extra-int) 0)
                    (set! (-> s5-0 s4-0 display-name-id) (text-id text-id-3392))
                    (set! (-> s5-0 s4-0 sym) (the-as symbol (-> sv-32 task)))
                    (set! (-> *task-medals* s4-0) (if (and (>= s2-0 (-> sv-32 adv-score)) (>= (-> sv-32 adv-score) 0))
                                                      (the-as int (-> *game-info* sub-task-list sv-16 medals 0))
                                                      -1
                                                      )
                          )
                    (if (!= (-> *task-medals* s4-0) 3)
                        (set! s3-0 #t)
                        )
                    (set! (-> *adventure-task-sprite-info-array* s4-0)
                          (lookup-texture-id-by-name
                            (-> *net-play-mode-icon-string* (-> *game-info* sub-task-list sv-16 net-play-mode))
                            (the-as string #f)
                            )
                          )
                    (if (and (and (>= s2-0 (-> sv-32 adv-score)) (>= (-> sv-32 adv-score) 0))
                             (!= (-> *game-info* sub-task-list sv-16 medals 0) 3)
                             )
                        (set! gp-0 #f)
                        )
                    (if (and (>= s2-0 (-> sv-32 adv-score)) (>= (-> sv-32 adv-score) 0))
                        (set! (-> s5-0 s4-0 extra-int) 1)
                        )
                    (+! s4-0 1)
                    )
                  )
                )
              (+! sv-16 1)
              )
            )
          (set! *grand-prix-locked* s3-0)
          (set! (-> s5-0 s4-0 extra-int) 0)
          (set! (-> s5-0 s4-0 display-name-id) (text-id text-id-2185))
          (set! (-> s5-0 s4-0 sym) 'grand-prix)
          (set! (-> *task-medals* s4-0) -1)
          (set! (-> *adventure-task-sprite-info-array* s4-0) (lookup-texture-id-by-name "is-cup-01" (the-as string #f)))
          (let* ((v1-107 *lobby-adv-cup*)
                 (v1-108 (cond
                           ((= v1-107 (game-task-node-flag cup1))
                            0
                            )
                           ((= v1-107 (game-task-node-flag cup2))
                            1
                            )
                           ((= v1-107 (game-task-node-flag cup3))
                            2
                            )
                           ((= v1-107 (game-task-node-flag cup4))
                            3
                            )
                           (else
                             0
                             )
                           )
                         )
                 )
            (when (and (>= s2-0 (the-as int (-> *game-info* grand-prix v1-108 score))) (not s3-0))
              (set! (-> *task-medals* s4-0) (the-as int (-> *game-info* grand-prix v1-108 trophy)))
              (set! (-> s5-0 s4-0 extra-int) 1)
              )
            )
          )
        (let ((v1-116 (+ s4-0 1)))
          (set! (-> s5-0 length) v1-116)
          (set! (-> *task-medals* length) v1-116)
          )
        (cond
          ((and gp-0 *adv-coming-back-from-game*)
           (go-virtual adventure-map)
           )
          (else
            (set! *adv-coming-back-from-game* #f)
            #f
            )
          )
        )
      )
    (if (not (handle->process (-> self vehicle-handle)))
        (set! (-> self vehicle-selected)
              (-> *game-info* player-info (-> self current-local-player) last-selected-vehicle)
              )
        )
    (if (!= (-> self prev-state name) 'customize-main-menu)
        (send-vehicle-to-net-world self)
        )
    (if *net-world*
        (set-player-vehicle
          *net-world*
          -1
          (+ (* (if *net-mgr*
                    (-> *net-mgr* game-state local-machine-idx)
                    0
                    )
                2
                )
             1
             )
          (new 'static 'vehicle-load-parts)
          (new 'static 'tuning-info)
          )
        )
    (set! (-> *garage-string* 0) (text-id text-id-1712))
    (set! (-> *adventure-bottom-bar-ids* 0) (text-id text-id-1934))
    (set! (-> *adventure-bottom-bar-dpad-ids* 0) (text-id text-id-1931))
    (set! (-> *adventure-bottom-bar-triangle-ids* 0) (text-id text-id-1935))
    )
  :exit (behavior ()
    (if (!= (-> self next-state name) 'adventure-vehicle-select)
        (kill-by-type fmv-player *active-pool*)
        )
    )
  :trans (behavior ()
    (when *net-world*
      (format (clear *level-texture-string*) (-> *task-level-info* (-> *net-world* task-info task-level) tex-name))
      (format (clear *map-texture-string*) (-> *task-level-info* (-> *net-world* task-info task-level) tex-name))
      (format *map-texture-string* "-map")
      )
    (if (handle->process (-> self vehicle-handle))
        (send-event
          (search-process-tree *active-pool* (lambda ((arg0 process)) (= (-> arg0 type) garage-turntable)))
          'go-up
          )
        (set! (-> self vehicle-selected)
              (-> *game-info* player-info (-> self current-local-player) last-selected-vehicle)
              )
        )
    )
  :code (behavior ()
    (local-vars (v1-2 symbol))
    (adventure-map-fade-out #f)
    (suspend)
    (dotimes (v1-0 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-0))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-0))) info-ptr) *map-screen*)
                 )
        (set! v1-2 #t)
        (goto cfg-20)
        )
      )
    (set! v1-2 #f)
    (label cfg-20)
    (if (not v1-2)
        (create-menu self *map-screen* 0)
        )
    (create-menu self *adventure-task* 0)
    (cond
      ((= (-> self prev-state name) 'adventure-vehicle-select)
       (restore-selection-index)
       )
      (else
        (let* ((s5-0 (the-as object '(task0 task1 task2 task3 task4 task5)))
               (gp-0 (-> (the-as pair s5-0) car))
               )
          (while (not (null? s5-0))
            (when (send-event (find-menu self (the-as symbol gp-0)) 'open-medal?)
              (select-by-sym (the-as selection-menu-manager (find-menu *lobby-menu-manager* 'manager)) (the-as symbol gp-0))
              (goto cfg-33)
              )
            (set! s5-0 (-> (the-as pair s5-0) cdr))
            (set! gp-0 (-> (the-as pair s5-0) car))
            )
          )
        (select-by-sym (the-as selection-menu-manager (find-menu *lobby-menu-manager* 'manager)) 'task0)
        )
      )
    (label cfg-33)
    (sleep-code)
    )
  :post lobby-default-post
  )


;; WARN: new jak 2 until loop case, check carefully
(defbehavior adventure-venue-init lobby-menu-manager ()
  (set! (-> self vehicle-selected) (the-as uint -1))
  (adventure-map-fade-in)
  (while (!= (level-status? *level* 'menumap #f) 'active)
    (suspend)
    )
  (dotimes (v1-3 64)
    (set! (-> *list-task-medals* v1-3) -2)
    )
  (let* ((s3-0 *lobby-adv-cup*)
         (s2-0 (get-task-cup-score (the-as int s3-0)))
         (s5-0 *adventure-venue-info-array*)
         (s4-0 0)
         (gp-1 #t)
         )
    (let ((s1-0 (new 'stack-no-clear 'array 'int32 8)))
      (dotimes (v1-6 8)
        (set! (-> s1-0 v1-6) 0)
        )
      (set! (-> s5-0 length) (-> s5-0 allocated-length))
      (dotimes (v1-10 (-> s5-0 length))
        (set! (-> s5-0 v1-10 display-name-id) (text-id text-id-0))
        )
      (dotimes (s0-0 (-> *adventure-venue-new* allocated-length))
        (charp<-string (-> *adventure-venue-new* s0-0 text) "")
        )
      (dotimes (s0-1 (-> *adventure-venue-stats* length))
        (charp<-string (-> *adventure-venue-stats* s0-1 text) "")
        (set! (-> *adventure-venue-stats* s0-1 extra) (the-as basic 0))
        )
      (let ((s0-2 (-> *game-info* sub-task-list))
            (sv-48 0)
            )
        (while (< sv-48 (-> s0-2 length))
          (when (nonzero? sv-48)
            (let ((sv-64 (-> s0-2 sv-48)))
              (when (and (-> *game-info* play-list (-> sv-64 task) play-continue)
                         (-> *game-info* play-list (-> sv-64 task) single-player)
                         (logtest? (-> sv-64 flags) s3-0)
                         (logtest? *lobby-adv-selected-map* (-> sv-64 flags))
                         (not (logtest? (game-task-node-flag qualifier) (-> sv-64 flags)))
                         (>= (-> sv-64 adv-score) 0)
                         )
                (let ((a0-23
                        (get-continue-by-name *game-info* (the-as string (-> *game-info* play-list (-> sv-64 task) play-continue)))
                        )
                      )
                  (when a0-23
                    (let ((sv-80 (lookup-level-info (-> a0-23 level)))
                          (sv-96 0)
                          )
                      (until #f
                        (if (= s4-0 sv-96)
                            (goto cfg-67)
                            )
                        (when (= (-> s5-0 sv-96 display-name-id) (-> *task-level-info* (-> sv-80 task-level) text-id))
                          (if (and (zero? (-> sv-64 play-count)) (>= s2-0 (-> sv-64 adv-score)) (>= (-> sv-64 adv-score) 0))
                              (charp<-string (-> *adventure-venue-new* sv-96 text) (lookup-text! *common-text* (text-id text-id-1737) #f))
                              )
                          (if (and (and (>= s2-0 (-> sv-64 adv-score)) (>= (-> sv-64 adv-score) 0)) (!= (-> sv-64 medals 0) 3))
                              (set! gp-1 #f)
                              )
                          (set! (-> *list-task-medals* (+ (* sv-96 8) (-> s1-0 sv-96)))
                                (if (and (>= s2-0 (-> sv-64 adv-score)) (>= (-> sv-64 adv-score) 0))
                                    (the-as int (-> sv-64 medals 0))
                                    -1
                                    )
                                )
                          (when (and (>= s2-0 (-> sv-64 adv-score)) (>= (-> sv-64 adv-score) 0))
                            (+! (-> *adventure-venue-stats* sv-96 extra-int16 0) (the-as int (-> sv-64 medals 0)))
                            (+! (-> *adventure-venue-stats* sv-96 extra-int16 1) 3)
                            )
                          (+! (-> s1-0 sv-96) 1)
                          (goto cfg-67)
                          )
                        (+! sv-96 1)
                        )
                      #f
                      (label cfg-67)
                      (when (= sv-96 s4-0)
                        (if (and (zero? (-> sv-64 play-count)) (>= s2-0 (-> sv-64 adv-score)) (>= (-> sv-64 adv-score) 0))
                            (charp<-string (-> *adventure-venue-new* sv-96 text) (lookup-text! *common-text* (text-id text-id-1737) #f))
                            )
                        (if (and (and (>= s2-0 (-> sv-64 adv-score)) (>= (-> sv-64 adv-score) 0)) (!= (-> sv-64 medals 0) 3))
                            (set! gp-1 #f)
                            )
                        (set! (-> s5-0 s4-0 display-name-id) (-> *task-level-info* (-> sv-80 task-level) text-id))
                        (set! (-> s5-0 s4-0 sym) (-> sv-64 level))
                        (set! (-> *list-task-medals* (+ (* sv-96 8) (-> s1-0 sv-96)))
                              (if (and (>= s2-0 (-> sv-64 adv-score)) (>= (-> sv-64 adv-score) 0))
                                  (the-as int (-> sv-64 medals 0))
                                  -1
                                  )
                              )
                        (when (and (>= s2-0 (-> sv-64 adv-score)) (>= (-> sv-64 adv-score) 0))
                          (+! (-> *adventure-venue-stats* sv-96 extra-int16 0) (the-as int (-> sv-64 medals 0)))
                          (+! (-> *adventure-venue-stats* sv-96 extra-int16 1) 3)
                          )
                        (+! s4-0 1)
                        (+! (-> s1-0 sv-96) 1)
                        )
                      )
                    )
                  )
                )
              )
            )
          (+! sv-48 1)
          )
        )
      )
    (set! (-> s5-0 length) s4-0)
    (set! (-> *adventure-venue-new* length) s4-0)
    (dotimes (s4-1 (-> s5-0 length))
      (let ((s3-1 charp<-string)
            (s2-1 (-> *adventure-venue-stats* s4-1 text))
            )
        (format
          (clear *temp-string*)
          "~D/~D"
          (-> *adventure-venue-stats* s4-1 extra-int16 0)
          (-> *adventure-venue-stats* s4-1 extra-int16 1)
          )
        (s3-1 s2-1 *temp-string*)
        )
      )
    (cond
      ((and gp-1 *adv-coming-back-from-game*)
       (go-virtual adventure-map)
       )
      (else
        (set! *adv-coming-back-from-game* #f)
        #f
        )
      )
    )
  )


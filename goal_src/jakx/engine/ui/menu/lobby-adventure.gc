;; WARN: Return type mismatch int vs game-task-node.
(defun get-next-training-task ()
  (when #t
    (let ((v1-3 (-> *game-info* sub-task-list)))
      (dotimes (gp-0 (-> v1-3 length))
        (when (nonzero? gp-0)
          (let ((a0-3 (-> v1-3 gp-0)))
            (when (and (-> *game-info* play-list (-> a0-3 task) play-continue)
                       (or (= (-> a0-3 net-play-mode) (net-play-mode training))
                           (= (-> a0-3 net-play-mode) (net-play-mode training2))
                           )
                       )
              (when (and (zero? (-> a0-3 play-count)) *net-world*)
                (set-task-node *net-world* (the-as game-task-node gp-0))
                (return (the-as game-task-node gp-0))
                )
              )
            )
          )
        )
      )
    )
  (the-as game-task-node 0)
  )

(defmethod send-vehicle-to-net-world ((this lobby-menu-manager))
  (when *net-world*
    (let ((s5-0 (-> *game-info*
                    car-info
                    data
                    (car-type-from-vehicle-type (the-as vehicle-type-u8 (-> this vehicle-selected)))
                    )
                )
          (gp-1 (find-vehicle-info (the-as symbol (-> this vehicle-selected))))
          )
      (when gp-1
        (set-player-colors
          *net-world*
          (the-as int (to-rgba (-> s5-0 base-color)))
          (the-as int (to-rgba (-> s5-0 stripe-color)))
          (* (if *net-mgr*
                 (-> *net-mgr* game-state local-machine-idx)
                 0
                 )
             2
             )
          )
        (set-player-load-parts
          *net-world*
          (convert-car-info-to-load-parts (the-as car-info-full s5-0))
          (* (if *net-mgr*
                 (-> *net-mgr* game-state local-machine-idx)
                 0
                 )
             2
             )
          )
        (set-player-tuning
          *net-world*
          (the-as int (-> s5-0 tuning))
          (* (if *net-mgr*
                 (-> *net-mgr* game-state local-machine-idx)
                 0
                 )
             2
             )
          )
        (set-player-vehicle
          *net-world*
          (the-as int (-> gp-1 index))
          (* (if *net-mgr*
                 (-> *net-mgr* game-state local-machine-idx)
                 0
                 )
             2
             )
          (new 'static 'vehicle-load-parts)
          (new 'static 'tuning-info)
          )
        )
      )
    (set-player-desired-driver *net-world* 0 (* (if *net-mgr*
                                                    (-> *net-mgr* game-state local-machine-idx)
                                                    0
                                                    )
                                                2
                                                )
                               )
    )
  0
  (none)
  )

(defstate adventure-intro-b (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('net-world-changed)
       #f
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (set-task-node *net-world* (the-as game-task-node (task-node-index-by-name "brdroom-intro-b-task")))
    (lock-game *net-world*)
    )
  :exit (behavior ()
    (kill-by-type fmv-player *active-pool*)
    (set-action!
      *gui-control*
      (gui-action stop)
      (the-as sound-id 1)
      (gui-channel citizen)
      (gui-action none)
      (the-as string #f)
      (the-as (function gui-connection symbol) #f)
      (the-as process #f)
      )
    )
  :code sleep-code
  :post lobby-default-post
  )

(defstate adventure-training (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('menu-selection-event)
       #f
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (cond
      ((zero? (-> *game-info* total-trys))
       (go-virtual adventure-intro-b)
       )
      ((= (get-next-training-task) (game-task-node none))
       (go-virtual adventure-cup)
       )
      )
    )
  :code (behavior ()
    (when *net-world*
      (if (logtest? (-> *game-info* secrets) (game-secrets gs15))
          (net-world-method-59 *net-world* #t)
          (net-world-method-59 *net-world* #f)
          )
      )
    (set-player-load-parts *net-world* *default-vehicle-load-parts* 0)
    (set-player-desired-driver *net-world* 0 (* (if *net-mgr*
                                                    (-> *net-mgr* game-state local-machine-idx)
                                                    0
                                                    )
                                                2
                                                )
                               )
    (set-player-vehicle
      *net-world*
      12
      (* (if *net-mgr*
             (-> *net-mgr* game-state local-machine-idx)
             0
             )
         2
         )
      (new 'static 'vehicle-load-parts)
      (new 'static 'tuning-info)
      )
    (set-player-colors *net-world* (the-as int (the-as uint #x802a501c)) (the-as int (the-as uint #x80411c2d)) 0)
    (mem-copy!
      (the-as pointer (-> *net-world* net-state options))
      (the-as pointer (-> (get-open-task-node-info) default-advanced-options-adventure))
      8
      )
    (lock-game *net-world*)
    (suspend)
    (until #f
      (suspend)
      )
    #f
    (dotimes (gp-1 10)
      (suspend)
      )
    )
  :post lobby-default-post
  )

;; WARN: Return type mismatch int vs object.
(defun setup-cup-menu-score ((arg0 int) (arg1 string))
  (let ((s1-0 (get-task-cup-score arg0))
        (gp-0 0)
        (s5-0 0)
        (s3-0 (clear *temp-string*))
        )
    (let ((v1-1 (-> *game-info* sub-task-list)))
      (dotimes (a0-3 (-> v1-1 length))
        (when (nonzero? a0-3)
          (let ((a1-4 (-> v1-1 a0-3)))
            (when (and (-> *game-info* play-list (-> a1-4 task) play-continue)
                       (-> *game-info* play-list (-> a1-4 task) single-player)
                       (logtest? (-> a1-4 flags) arg0)
                       (>= s1-0 (-> a1-4 adv-score))
                       (>= (-> a1-4 adv-score) 0)
                       )
              (+! gp-0 (the-as int (-> a1-4 medals 0)))
              (+! s5-0 3)
              )
            )
          )
        )
      )
    (format s3-0 "~S ~D/~D" (lookup-text! *common-text* (text-id text-id-4111) #f) gp-0 s5-0)
    (charp<-string (the-as (pointer uint8) arg1) s3-0)
    )
  )

(defstate adventure-cup (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('menu-selection-event)
       (case (-> block param 0)
         (('changed)
          #f
          )
         (('cancel)
          (when (kill-menu self #f #f)
            (set! *lobby-adv-cup* (the-as game-task-node-flag -1))
            (kill-menu self #f #f)
            (send-event *net-mgr* 'leave-game)
            (lobby-level-set! 0 'menu2 'display)
            (create-menu self *base-menu-info* 0)
            (set! *game-mode* #f)
            (lobby-level-set! 1 #f #f)
            (go-virtual game-type-menu)
            )
          )
         (('accept)
          (when (or (= (level-status? *level* 'menumap #f) 'active) (= (level-status? *level* 'menumap #f) 'loaded))
            (case (-> block param 1)
              (('cup1)
               (set! *lobby-adv-cup* (game-task-node-flag cup1))
               )
              (('cup2)
               (set! *lobby-adv-cup* (game-task-node-flag cup2))
               )
              (('cup3)
               (set! *lobby-adv-cup* (game-task-node-flag cup3))
               )
              (('cup4)
               (set! *lobby-adv-cup* (game-task-node-flag cup4))
               )
              )
            (when (kill-menu self #f #f)
              (set-lobby-camera-seek-time! 0.5)
              (go-virtual adventure-map)
              )
            )
          )
         (('square)
          (if (kill-menu self #f #f)
              (go-virtual lobby-scene-player)
              )
          )
         (else
           #f
           )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (set! *open-new-cup* (the-as object #f))
    (set! (-> self current-local-player) 0)
    (set-menumap-target! 0)
    (set! (-> *adventure-bottom-bar-ids* 0) (text-id text-id-1934))
    (set! (-> *adventure-bottom-bar-dpad-ids* 0) (text-id text-id-1931))
    (set! (-> *adventure-bottom-bar-triangle-ids* 0) (text-id text-id-1935))
    (setup-cup-menu-score 128 (the-as string (-> *cup1-extra* 0 text)))
    (setup-cup-menu-score 256 (the-as string (-> *cup2-extra* 0 text)))
    (setup-cup-menu-score 512 (the-as string (-> *cup3-extra* 0 text)))
    (setup-cup-menu-score 1024 (the-as string (-> *cup4-extra* 0 text)))
    )
  :code (behavior ()
    (adventure-map-fade-in)
    (kill-menu self #t #f)
    (suspend-for (seconds 0.5)
      )
    (create-menu self *adventure-cup* 0)
    (restore-selection-index)
    (sleep-code)
    )
  :post lobby-default-post
  )


  ()
  )


;; WARN: Return type mismatch float vs none.
(defmethod update-strings ((this adventure-cup-score))
  (let ((t9-0 (method-of-type string-menu update-strings)))
    (t9-0 this)
    )
  (let* ((s3-0 *lobby-adv-cup*)
         (v1-1 (get-task-cup-score (the-as int s3-0)))
         (s5-0 0)
         (s4-0 0)
         )
    (let ((a0-4 (-> *game-info* sub-task-list)))
      (dotimes (a1-0 (-> a0-4 length))
        (when (nonzero? a1-0)
          (let ((a2-3 (-> a0-4 a1-0)))
            (when (and (-> *game-info* play-list (-> a2-3 task) play-continue)
                       (-> *game-info* play-list (-> a2-3 task) single-player)
                       (logtest? (-> a2-3 flags) s3-0)
                       (>= v1-1 (-> a2-3 adv-score))
                       (>= (-> a2-3 adv-score) 0)
                       )
              (+! s5-0 (the-as int (-> a2-3 medals 0)))
              (+! s4-0 3)
              )
            )
          )
        )
      )
    (cond
      ((or (= (-> *lobby-menu-manager* state name) 'adventure-vehicle-select)
           (= (-> *lobby-menu-manager* state name) 'customize-main-menu)
           (= (-> *lobby-menu-manager* state name) 'die)
           )
       (format (clear (-> this strings data 0 text)) (lookup-text! *common-text* (text-id text-id-1712) #f))
       (format (clear (-> this strings data 1 text)) (lookup-text! *common-text* (text-id text-id-3104) #f))
       (format (clear *temp-string*) "~,,0f" (-> *game-info* player-info 0 cash))
       (charp<-string (-> *player-cash-extra* 0 text) *temp-string*)
       (set! (-> this info-ptr sprites-info 0 scale-x) 1.5)
       )
      (else
        (format (clear (-> this strings data 0 text)) "~D/~D" s5-0 s4-0)
        (format
          (clear (-> this strings data 1 text))
          (lookup-text! *common-text* (-> this info-ptr strings-info 1 id) #f)
          )
        (clear *temp-string*)
        (charp<-string (-> *player-cash-extra* 0 text) *temp-string*)
        (set! (-> this info-ptr sprites-info 0 scale-x) 0.0)
        )
      )
    )
  (none)
  )


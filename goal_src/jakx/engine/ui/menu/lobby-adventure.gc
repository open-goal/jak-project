(defstate adventure-venue (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('menu-selection-event)
       (case (-> block param 0)
         (('event)
          #f
          )
         (('cancel)
          (if (kill-menu self #f #f)
              (go-virtual adventure-map)
              )
          )
         (('changed)
          (let ((gp-0 (as-type proc dropdown-venue)))
            (when gp-0
              (if (handle->process (-> self venue-map))
                  (send-event (handle->process (-> self venue-map)) 'leave)
                  )
              (let ((gp-1 (-> *adventure-venue-info-array* (-> (the-as base-menu gp-0) info-ptr user-data) sym)))
                (format 0 "map = ~S~%" (symbol->string gp-1))
                (show-venue-map self gp-1)
                )
              )
            )
          )
         (('accept)
          (set! *lobby-adv-selected-venue* (the-as symbol (-> block param 1)))
          (when (kill-menu self #f #f)
            (send-event (the-as map-menu (handle->process (-> self map-proc))) 'leave)
            (go-virtual adventure-task)
            )
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (set! (-> *garage-string* 0) (text-id text-id-1712))
    (set! (-> *adventure-bottom-bar-ids* 0) (text-id text-id-1934))
    (set! (-> *adventure-bottom-bar-dpad-ids* 0) (text-id text-id-1931))
    (set! (-> *adventure-bottom-bar-triangle-ids* 0) (text-id text-id-1935))
    )
  :exit (behavior ()
    (set-action!
      *gui-control*
      (gui-action stop)
      (the-as sound-id 1)
      (gui-channel citizen)
      (gui-action none)
      (the-as string #f)
      (the-as (function gui-connection symbol) #f)
      (the-as process #f)
      )
    (if (handle->process (-> self venue-map))
        (send-event (handle->process (-> self venue-map)) 'leave)
        )
    (set! (-> self venue-map) (the-as handle #f))
    )
  :code (behavior ()
    (adventure-venue-init)
    (suspend)
    (create-menu self *adventure-venue* 0)
    (restore-selection-index)
    (sleep-code)
    )
  :post lobby-default-post
  )

(define *adventure-task-sprite-info-array*
  (new 'static 'boxed-array :type texture-id :length 0 :allocated-length 8)
  )

(define *adventure-task-info-array*
  (new 'static 'boxed-array :type menu-option-info
    (new 'static 'menu-option-info :display-name-id (text-id text-id-526) :sym #f)
    (new 'static 'menu-option-info :display-name-id (text-id text-id-526) :sym #f)
    (new 'static 'menu-option-info :display-name-id (text-id text-id-526) :sym #f)
    (new 'static 'menu-option-info :display-name-id (text-id text-id-526) :sym #f)
    (new 'static 'menu-option-info :display-name-id (text-id text-id-526) :sym #f)
    (new 'static 'menu-option-info :display-name-id (text-id text-id-526) :sym #f)
    (new 'static 'menu-option-info :display-name-id (text-id text-id-526) :sym #f)
    (new 'static 'menu-option-info :display-name-id (text-id text-id-526) :sym #f)
    )
  )

(define *task-medals* (new 'static 'boxed-array :type int8 :length 0 :allocated-length 8))

(deftype dropdown-task (dropdown-fade)
  ((medal-msg-start-time  uint32)
   )
  )


(defmethod default-event-handler ((this dropdown-task) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (case arg2
    (('selected)
     (when *net-world*
       (let* ((v1-7 (-> *adventure-task-info-array* (-> this info-ptr user-data)))
              (a0-4 *lobby-adv-cup*)
              (s1-0 (cond
                      ((= a0-4 (game-task-node-flag cup1))
                       0
                       )
                      ((= a0-4 (game-task-node-flag cup2))
                       1
                       )
                      ((= a0-4 (game-task-node-flag cup3))
                       2
                       )
                      ((= a0-4 (game-task-node-flag cup4))
                       3
                       )
                      (else
                        0
                        )
                      )
                    )
              )
         (cond
           ((= (-> v1-7 extra-int) 1)
            (cond
              ((= (-> v1-7 sym) 'grand-prix)
               (set-action!
                 *gui-control*
                 (gui-action stop)
                 (the-as sound-id 1)
                 (gui-channel citizen)
                 (gui-action none)
                 (the-as string #f)
                 (the-as (function gui-connection symbol) #f)
                 (the-as process #f)
                 )
               (kill-by-type fmv-player *active-pool*)
               (if (!= *lobby-adv-selected-task* (-> this info-ptr user-data))
                   (set! *lobby-adv-selected-task* (the-as int (-> this info-ptr user-data)))
                   )
               (set-action!
                 *gui-control*
                 (gui-action stop)
                 (the-as sound-id 1)
                 (gui-channel citizen)
                 (gui-action none)
                 (the-as string #f)
                 (the-as (function gui-connection symbol) #f)
                 (the-as process #f)
                 )
               (when (-> *game-info* grand-prix s1-0 sound-description)
                 (remove-setting *setting-control* *lobby-menu-manager* 'music-volume)
                 (add-setting *setting-control* *lobby-menu-manager* 'music-volume 'rel #x3e800000 0)
                 (set! (-> *lobby-menu-manager* voice-id)
                       (add-process
                         *gui-control*
                         *lobby-menu-manager*
                         (gui-channel citizen)
                         (gui-action play)
                         (-> *game-info* grand-prix s1-0 sound-description)
                         -99.0
                         0
                         )
                       )
                 (sound-params-set!
                   *gui-control*
                   (-> *lobby-menu-manager* voice-id)
                   #f
                   -1.0
                   -1.0
                   1.0
                   (-> *setting-control* user-current talker-volume)
                   #t
                   )
                 )
               (let ((v1-38 (-> *game-info* sub-task-list (-> *game-info* grand-prix s1-0 task1))))
                 (if (-> v1-38 ipu)
                     (fmv-player-run-texture (-> v1-38 ipu) *default-pool*)
                     )
                 )
               (set-task-node
                 *net-world*
                 (the-as game-task-node (-> *game-info* grand-prix s1-0 task (-> *game-info* grand-prix-index)))
                 )
               )
              (else
                (let ((v1-50 (the-as object (-> *adventure-task-info-array* (-> this info-ptr user-data) sym))))
                  (when (the-as symbol v1-50)
                    (let ((s1-1 (-> *game-info* play-list (the-as int v1-50))))
                      (let ((s0-0 (-> s1-1 text-id-long))
                            (sv-96 0)
                            )
                        (while (< sv-96 8)
                          (send-event
                            (handle->process (-> *lobby-menu-manager* menu-handles sv-96))
                            'to-all-children
                            'update-task-text-id
                            s0-0
                            )
                          (+! sv-96 1)
                          )
                        )
                      (set-task-node *net-world* (-> s1-1 play-node))
                      )
                    (when (!= *lobby-adv-selected-task* (-> this info-ptr user-data))
                      (set! *lobby-adv-selected-task* (the-as int (-> this info-ptr user-data)))
                      (let ((s1-2 (get-open-task-node-info)))
                        (if (-> s1-2 ipu)
                            (fmv-player-run-texture (-> s1-2 ipu) *default-pool*)
                            )
                        (set-action!
                          *gui-control*
                          (gui-action stop)
                          (the-as sound-id 1)
                          (gui-channel citizen)
                          (gui-action none)
                          (the-as string #f)
                          (the-as (function gui-connection symbol) #f)
                          (the-as process #f)
                          )
                        (when (-> s1-2 task-sound-description)
                          (remove-setting *setting-control* *lobby-menu-manager* 'music-volume)
                          (add-setting *setting-control* *lobby-menu-manager* 'music-volume 'rel #x3e800000 0)
                          (set! (-> *lobby-menu-manager* voice-id)
                                (add-process
                                  *gui-control*
                                  *lobby-menu-manager*
                                  (gui-channel citizen)
                                  (gui-action play)
                                  (-> s1-2 task-sound-description)
                                  -99.0
                                  0
                                  )
                                )
                          (sound-params-set!
                            *gui-control*
                            (-> *lobby-menu-manager* voice-id)
                            #f
                            -1.0
                            -1.0
                            1.0
                            (-> *setting-control* user-current talker-volume)
                            #t
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
           (else
             (set! *lobby-adv-selected-task* (the-as int (-> this info-ptr user-data)))
             (set-action!
               *gui-control*
               (gui-action stop)
               (the-as sound-id 1)
               (gui-channel citizen)
               (gui-action none)
               (the-as string #f)
               (the-as (function gui-connection symbol) #f)
               (the-as process #f)
               )
             (kill-by-type fmv-player *active-pool*)
             )
           )
         )
       )
     )
    (('open-medal?)
     (if (zero? (-> *task-medals* (-> this info-ptr user-data)))
         (return #t)
         (return #f)
         )
     (the-as none 0)
     )
    )
  ((method-of-type dropdown-fade default-event-handler) this arg0 arg1 arg2 arg3)
  )

;; WARN: Return type mismatch int vs object.
(defmethod draw-menu ((this dropdown-task))
  (if (-> this enabled)
      (call-parent-method this)
      )
  0
  )

(define *grand-prix-locked* #f)

;; WARN: Return type mismatch texture-id vs none.
(defmethod update-strings ((this dropdown-task))
  (local-vars (v0-20 object))
  (call-parent-method this)
  (cond
    ((= (-> *adventure-task-info-array* (-> this info-ptr user-data) display-name-id) (text-id text-id-0))
     (send-event this 'disabled)
     )
    (else
      (format
        (clear (-> this strings data 0 text))
        "~S"
        (lookup-text! *common-text* (-> *adventure-task-info-array* (-> this info-ptr user-data) display-name-id) #f)
        )
      (set! (-> this info-ptr sprites-info 0 scale-x) 0.8)
      (clear (-> this strings data 2 text))
      (clear (-> this strings data 3 text))
      (clear (-> this strings data 4 text))
      (set! (-> this info-ptr sprites-info 2 scale-x) 0.0)
      (set! (-> this info-ptr sprites-info 3 scale-x) 0.0)
      (set! (-> this info-ptr sprites-info 4 scale-x) 0.0)
      (let ((s5-1 (the-as object (-> *adventure-task-info-array* (-> this info-ptr user-data) sym))))
        (when (= (-> *adventure-task-info-array* (-> this info-ptr user-data) sym) 'grand-prix)
          (let* ((v1-39 *lobby-adv-cup*)
                 (s4-1 (-> *game-info* grand-prix (cond
                                                    ((= v1-39 (game-task-node-flag cup1))
                                                     0
                                                     )
                                                    ((= v1-39 (game-task-node-flag cup2))
                                                     1
                                                     )
                                                    ((= v1-39 (game-task-node-flag cup3))
                                                     2
                                                     )
                                                    ((= v1-39 (game-task-node-flag cup4))
                                                     3
                                                     )
                                                    (else
                                                      0
                                                      )
                                                    )
                           )
                       )
                 )
            (dotimes (s3-1 3)
              (set! (-> this info-ptr sprites-info (+ s3-1 2) scale-x) 0.8)
              (let* ((v1-57 (-> *game-info* play-list (-> *game-info* sub-task-list (-> s4-1 task s3-1) task)))
                     (v1-58 (get-continue-by-name *game-info* (the-as string (-> v1-57 play-continue))))
                     (s1-0 (lookup-level-info (-> v1-58 level)))
                     )
                (format
                  (clear (-> this strings data (+ s3-1 2) text))
                  "~S"
                  (lookup-text! *common-text* (-> *task-level-info* (-> s1-0 task-level) text-id) #f)
                  )
                )
              (if (-> this selected)
                  (set! (-> this info-ptr strings-info (+ s3-1 2) font-color) (font-color font-color-51))
                  (set! (-> this info-ptr strings-info (+ s3-1 2) font-color) (font-color font-color-52))
                  )
              (if (-> this selected)
                  (set! (-> this strings data (+ s3-1 2) color) (font-color font-color-51))
                  (set! (-> this strings data (+ s3-1 2) color) (font-color font-color-52))
                  )
              )
            )
          )
        (cond
          ((and *grand-prix-locked* (= (-> *adventure-task-info-array* (-> this info-ptr user-data) sym) 'grand-prix))
           (set! (-> this p-client-array 5 strip tex-id)
                 (lookup-texture-id-by-name "is-medal-gold-01" (the-as string #f))
                 )
           (set! (-> this p-client-array 6 strip tex-id)
                 (lookup-texture-id-by-name "is-medal-gold-01" (the-as string #f))
                 )
           (set! (-> this info-ptr sprites-info 5 scale-x) 0.5)
           (set! (-> this info-ptr sprites-info 5 scale-y) 0.5)
           (set! (-> this info-ptr sprites-info 6 scale-x) 0.5)
           (set! (-> this info-ptr sprites-info 6 scale-y) 0.5)
           )
          (else
            (set! (-> this info-ptr sprites-info 5 scale-x) 0.0)
            (set! (-> this info-ptr sprites-info 6 scale-x) 0.0)
            )
          )
        (let ((v1-116 (-> *task-medals* (-> this info-ptr user-data))))
          (set! v0-20
                (cond
                  ((= v1-116 -1)
                   (set! (-> this info-ptr sprites-info 0 scale-x) 0.6)
                   (set! (-> this p-client-array 0 strip tex-id)
                         (lookup-texture-id-by-name "amode-icon-padlock-01" (the-as string #f))
                         )
                   (cond
                     ((= (-> *adventure-task-info-array* (-> this info-ptr user-data) sym) 'grand-prix)
                      (cond
                        ((< (get-task-cup-score (the-as int *lobby-adv-cup*)) 50)
                         (format (clear (-> this strings data 1 text)) "~d" 50)
                         (set! (-> this info-ptr sprites-info 5 scale-x) 0.0)
                         (set! (-> this info-ptr sprites-info 6 scale-x) 0.0)
                         )
                        (else
                          #f
                          )
                        )
                      )
                     (else
                       (when (the-as symbol s5-1)
                         (let ((v1-134 (-> *game-info* play-list (the-as int s5-1))))
                           (when (nonzero? v1-134)
                             (let ((s5-3 (-> *game-info* sub-task-list (-> v1-134 play-node))))
                               (format (clear (-> this strings data 1 text)) "~d" (-> s5-3 adv-score))
                               (cond
                                 ((>= (the-as uint (- (current-time) (the-as int (-> this medal-msg-start-time)))) (the-as uint 450))
                                  (set! v0-20 #x6000)
                                  (set! (-> this width) (the-as int v0-20))
                                  v0-20
                                  )
                                 (else
                                   (format
                                     (clear (-> this strings data 0 text))
                                     (lookup-text! *common-text* (text-id text-id-3763) #f)
                                     (-> s5-3 adv-score)
                                     )
                                   (set! (-> this info-ptr sprites-info 0 scale-x) 0.0)
                                   (set! (-> this width) #x8800)
                                   (clear (-> this strings data 1 text))
                                   )
                                 )
                               )
                             )
                           )
                         )
                       )
                     )
                   )
                  ((zero? v1-116)
                   (set! v0-20 (lookup-texture-id-by-name
                                 (if (= (-> *adventure-task-info-array* (-> this info-ptr user-data) sym) 'grand-prix)
                                     "hud-trophy-empty-01"
                                     "is-medal-blank-01"
                                     )
                                 (the-as string #f)
                                 )
                         )
                   (set! (-> this p-client-array 0 strip tex-id) (the-as texture-id v0-20))
                   v0-20
                   )
                  ((= v1-116 1)
                   (set! v0-20 (lookup-texture-id-by-name
                                 (if (= (-> *adventure-task-info-array* (-> this info-ptr user-data) sym) 'grand-prix)
                                     "hud-trophy-empty-01"
                                     "is-medal-bronze-01"
                                     )
                                 (the-as string #f)
                                 )
                         )
                   (set! (-> this p-client-array 0 strip tex-id) (the-as texture-id v0-20))
                   v0-20
                   )
                  ((= v1-116 2)
                   (set! v0-20 (lookup-texture-id-by-name
                                 (if (= (-> *adventure-task-info-array* (-> this info-ptr user-data) sym) 'grand-prix)
                                     "hud-trophy-empty-01"
                                     "is-medal-silver-01"
                                     )
                                 (the-as string #f)
                                 )
                         )
                   (set! (-> this p-client-array 0 strip tex-id) (the-as texture-id v0-20))
                   v0-20
                   )
                  ((= v1-116 3)
                   (set! v0-20 (lookup-texture-id-by-name
                                 (if (= (-> *adventure-task-info-array* (-> this info-ptr user-data) sym) 'grand-prix)
                                     "hud-trophy-gold-01"
                                     "is-medal-gold-01"
                                     )
                                 (the-as string #f)
                                 )
                         )
                   (set! (-> this p-client-array 0 strip tex-id) (the-as texture-id v0-20))
                   v0-20
                   )
                  )
                )
          )
        )
      )
    )
  (set! (-> this p-client-array 1 strip tex-id)
        (-> *adventure-task-sprite-info-array* (-> this info-ptr user-data))
        )
  (none)
  )

(defmethod handle-input ((this dropdown-task) (arg0 int))
  (cond
    ((cpad-pressed? arg0 x)
     (cond
       ((send-event
          (ppointer->process (-> this parent))
          'menu-selection-event
          'accept
          (-> *adventure-task-info-array* (-> this info-ptr user-data) sym)
          )
        (let ((v1-19 (make-sound-instance snd-choice1 (new 'static 'sound-id) (the-as handle #f))))
          (cond
            (v1-19
              (logior! (-> v1-19 flags) (sound-spec-flag needs-update non-positional))
              (-> v1-19 id)
              )
            (else
              0
              )
            )
          )
        )
       (else
         (set! (-> this medal-msg-start-time) (the-as uint (current-time)))
         (let ((v1-23 (make-sound-instance snd-illegal1 (new 'static 'sound-id) (the-as handle #f))))
           (cond
             (v1-23
               (logior! (-> v1-23 flags) (sound-spec-flag needs-update non-positional))
               (-> v1-23 id)
               )
             (else
               0
               )
             )
           )
         )
       )
     )
    (else
      (call-parent-method this arg0)
      )
    )
  )


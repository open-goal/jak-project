(deftype dropdown-fade (dropdown-item)
  ()
  )


(defstate enter (dropdown-fade)
  :virtual #t
  :exit (behavior ()
    (dotimes (v1-0 (-> self strings length))
      (set! (-> self strings data v1-0 alpha) 1.0)
      )
    )
  :trans (behavior ()
    (update-strings self)
    )
  :code (behavior ()
    (set-time! (-> self state-time))
    (suspend-for (seconds 0.1)
      (let ((f0-2 (lerp-scale 0.0 1.0 (* 0.0033333334 (the float (- (current-time) time))) 0.0 0.1)))
        (dotimes (v1-7 (-> self strings length))
          (set! (-> self strings data v1-7 alpha) f0-2)
          )
        )
      (empty-form)
      (empty-form)
      )
    (go-virtual running)
    (sleep-code)
    )
  )

(defstate exit (dropdown-fade)
  :virtual #t
  :trans (behavior ()
    (update-strings self)
    )
  :code (behavior ()
    (set-time! (-> self state-time))
    (suspend-for (seconds 0.1)
      (let ((f0-2 (lerp-scale 1.0 0.0 (* 0.0033333334 (the float (- (current-time) time))) 0.0 0.1)))
        (dotimes (v1-7 (-> self strings length))
          (set! (-> self strings data v1-7 alpha) f0-2)
          )
        )
      (empty-form)
      (empty-form)
      )
    (go-virtual die)
    (sleep-code)
    )
  )

(defmethod init-menu! ((this dropdown-fade))
  (call-parent-method this)
  (none)
  )

(deftype dropdown-city (dropdown-fade)
  ()
  )


(define *grand-prix-medal* (new 'static 'array int32 4 0 0 0 0))

;; WARN: Return type mismatch texture-id vs none.
(defmethod update-strings ((this dropdown-city))
  (call-parent-method this)
  (format
    (clear (-> this strings data 0 text))
    "~G"
    (-> *adventure-map-city* (-> this info-ptr user-data) text)
    )
  (format (clear (-> this strings data 1 text)) "~G" (-> *adventure-map-new* (-> this info-ptr user-data) text))
  (format
    (clear (-> this strings data 2 text))
    "~G"
    (-> *adventure-map-stats* (-> this info-ptr user-data) text)
    )
  (cond
    ((= (-> this info-ptr user-data) 4)
     (dotimes (s5-3 2)
       (let ((v1-21 (-> *grand-prix-medal* s5-3)))
         (cond
           ((= v1-21 -1)
            (set! (-> this p-client-array s5-3 strip tex-id)
                  (lookup-texture-id-by-name "amode-icon-padlock-01" (the-as string #f))
                  )
            )
           ((zero? v1-21)
            (set! (-> this p-client-array s5-3 strip tex-id)
                  (lookup-texture-id-by-name "is-medal-blank-01" (the-as string #f))
                  )
            )
           ((= v1-21 1)
            (set! (-> this p-client-array s5-3 strip tex-id)
                  (lookup-texture-id-by-name "is-medal-bronze-01" (the-as string #f))
                  )
            )
           ((= v1-21 2)
            (set! (-> this p-client-array s5-3 strip tex-id)
                  (lookup-texture-id-by-name "is-medal-silver-01" (the-as string #f))
                  )
            )
           ((= v1-21 3)
            (set! (-> this p-client-array s5-3 strip tex-id)
                  (lookup-texture-id-by-name "is-medal-gold-01" (the-as string #f))
                  )
            )
           )
         )
       )
     (case (-> *grand-prix-medal* 2)
       ((-1)
        (set! (-> this p-client-array 2 strip tex-id)
              (lookup-texture-id-by-name "amode-icon-padlock-01" (the-as string #f))
              )
        )
       ((3)
        (set! (-> this p-client-array 2 strip tex-id)
              (lookup-texture-id-by-name "hud-trophy-gold-01" (the-as string #f))
              )
        )
       (else
         (set! (-> this p-client-array 2 strip tex-id)
               (lookup-texture-id-by-name "hud-trophy-empty-01" (the-as string #f))
               )
         )
       )
     )
    (else
      (dotimes (v1-61 3)
        (set! (-> this info-ptr sprites-info v1-61 scale-x) 0.0)
        (set! (-> this info-ptr sprites-info v1-61 scale-y) 0.0)
        )
      )
    )
  (none)
  )


                (when (and (= (-> a0-18 net-play-mode) arg0)
                           (= (-> *menu-level-info-array* s1-0 sym) (-> a0-18 level))
                           (logtest? (-> *task-level-info* (-> *game-info* play-list (-> a0-18 task) task-level) flags)
                                     (task-level-info-flag tli0)
                                     )

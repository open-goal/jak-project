            )
          )
         (('lobby-patch-required)
          (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-2602))
          (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1712))
          (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1926))
          (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-4273))
          (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
          (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
          (go-virtual
            lobby-generic-error-menu
            *lobby-generic-confirmation*
            (lambda :behavior lobby-menu-manager () (kill-menu self #f #f) (go-virtual patch-downloading))
            (the-as (function symbol object) (lambda :behavior lobby-menu-manager () (go-virtual net-connection-error)))
            #f
            #f
            #f
            )
          )
         (('lobby-connect-complete)
          (kill-menu self #t #f)
          (cond
            ((kiosk-code?)
             (set! (-> self local-players) 1)
             (set! *lobby-local-players* (-> self local-players))
             (go-virtual host-join-menu)
             )
            (else
              (go-virtual showing-announcements #f)
              )
            )
          )
         (else
           (lobby-menu-manager-default-handler proc argc message block)
           )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :exit (behavior ()
    (kill-menu self #t #f)
    )
  :code (behavior ()
    (local-vars (v1-2 symbol))
    (dotimes (v1-0 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-0))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-0))) info-ptr) *connecting-to-lobby*)
                 )
        (set! v1-2 #t)
        (goto cfg-20)
        )
      )
    (set! v1-2 #f)
    (label cfg-20)
    (if v1-2
        (goto cfg-26)
        )
    (kill-menu self #t #f)
    (create-menu self *connecting-to-lobby* 0)
    #t
    (until #f
      (if (cpad-or-kbd-pressed-var? (the-as uint 0) (pad-buttons triangle))
          (go-virtual net-connection-error)
          )
      (label cfg-26)
      (suspend)
      )
    #f
    )
  :post lobby-default-post
  )

(defstate num-local-players (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('menu-selection-event)
       (case (-> block param 0)
         (('cancel)
          (when (not (kiosk-code?))
            (cond
              ((or (= (-> self game-connection-type) 2) (= (-> self game-connection-type) 1))
               (cond
                 ((= (-> self split-selection-prev-state) 'lobby-main-screen)
                  (if (kill-menu self #f #f)
                      (go-virtual host-join-menu)
                      )
                  )
                 (else
                   (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-1667))
                   (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1712))
                   (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1926))
                   (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-4273))
                   (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
                   (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
                   (go-virtual
                     lobby-generic-error-menu
                     *lobby-generic-confirmation*
                     (lambda :behavior lobby-menu-manager
                       ()
                       (kill-menu self #f #f)
                       (send-event *net-mgr* 'leave-lobby)
                       (go-virtual pre-game-type-menu)
                       )
                     (the-as (function symbol object) (lambda :behavior lobby-menu-manager () (go-virtual num-local-players)))
                     #f
                     #f
                     #f
                     )
                   )
                 )
               )
              (else
                (when (kill-menu self #t #f)
                  (send-event *net-mgr* 'leave-game)
                  (go-virtual single-event-menu)
                  )
                )
              )
            )
          )
         (('accept)
          (case (-> block param 1)
            (('1p)
             (when (kill-menu self #t #f)
               (set! (-> self local-players) 1)
               (set! *lobby-local-players* (-> self local-players))
               (cond
                 ((= (-> self game-connection-type) 2)
                  (go-virtual host-join-menu)
                  )
                 ((= (-> self game-connection-type) 1)
                  (go-virtual host-join-menu)
                  )
                 (else
                   (set! (-> *num-players-info* min) 1)
                   (set! (-> *num-players-info* max) 2)
                   (go-virtual pre-choose-event-menu)
                   )
                 )
               )
             )
            (('2p)
             (cond
               ((zero? (-> *cpad-list* cpads 1 state))
                (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-2610))
                (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
                (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
                (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
                (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
                (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
                (go-virtual
                  lobby-generic-error-menu
                  *lobby-generic-confirmation*
                  (lambda :behavior lobby-menu-manager () (go-virtual num-local-players))
                  (the-as (function symbol object) (lambda :behavior lobby-menu-manager () (go-virtual num-local-players)))
                  #f
                  #f
                  #f
                  )
                )
               (else
                 (when (kill-menu self #t #f)
                   (set! (-> self local-players) 2)
                   (set! *lobby-local-players* (-> self local-players))
                   (cond
                     ((= (-> self game-connection-type) 2)
                      (go-virtual host-join-menu)
                      )
                     ((= (-> self game-connection-type) 1)
                      (go-virtual host-join-menu)
                      )
                     (else
                       (go-virtual pre-choose-event-menu)
                       )
                     )
                   )
                 )
               )
             (set! (-> *num-players-info* min) 2)
             (let ((v0-1 (the-as object 2)))
               (set! (-> *num-players-info* max) (the-as int v0-1))
               v0-1
               )
             )
            )
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (local-vars (v1-2 symbol))
    (dotimes (v1-0 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-0))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-0))) info-ptr) *num-local-players-menu*)
                 )
        (set! v1-2 #t)
        (goto cfg-20)
        )
      )
    (set! v1-2 #f)
    (label cfg-20)
    (if v1-2
        (goto cfg-24)
        )
    (kill-menu self #t #f)
    (create-menu self *num-local-players-menu* 0)
    #t
    (label cfg-24)
    (fmv-player-run-texture "split" *default-pool*)
    )
  :exit (behavior ()
    (kill-by-type fmv-player *active-pool*)
    )
  :trans (behavior ()
    (let ((v1-1 (the-as index-sprite-list-menu (find-menu self 'split-screen-selection))))
      (when v1-1
        (cond
          ((zero? (-> v1-1 sprites))
           (set! (-> *menu-split-selection-string* 0) (the-as uint 1635))
           (set! (-> *split-screen-sprite-list* 0) 0)
           (set! (-> *split-screen-sprite-list* 1) 1)
           )
          (else
            (set! (-> *menu-split-selection-string* 0) (the-as uint 1636))
            (set! (-> *split-screen-sprite-list* 0) 2)
            (set! (-> *split-screen-sprite-list* 1) 3)
            )
          )
        )
      )
    )
  :code sleep-code
  :post lobby-default-post
  )

(defstate host-join-menu (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('menu-selection-event)
       (case (-> block param 0)
         (('cancel)
          (when (not (kiosk-code?))
            (when (kill-menu self #f #f)
              (create-menu self *num-local-players-menu* 0)
              (set! (-> self split-selection-prev-state) (-> self state name))
              (go-virtual num-local-players)
              )
            )
          )
         (('accept)
          (case (-> block param 1)
            (('join-game-1p)
             (if (kill-menu self #f #f)
                 (go-virtual e3-join-game-menu)
                 )
             )
            (('host-game-1p)
             (when (kill-menu self #f #f)
               (cond
                 ((= (-> self game-connection-type) 2)
                  (send-event *net-mgr* 'create-game)
                  )
                 ((= (-> self game-connection-type) 1)
                  (send-event *net-mgr* 'host-lan-game)
                  )
                 )
               (go-virtual host-wait)
               )
             )
            )
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (local-vars (v1-17 symbol))
    (when (and (= (-> self game-connection-type) 2)
               *net-mgr*
               (nonzero? (-> *net-mgr* lobby-state connect-handle))
               *game-launched-from-room*
               )
      (set! *game-launched-from-room* #f)
      (go-virtual chat-room)
      )
    (if (= (-> self game-connection-type) 2)
        (go-virtual lobby-main-screen)
        )
    (dotimes (v1-15 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-15))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-15))) info-ptr) *join-create-menu*)
                 )
        (set! v1-17 #t)
        (goto cfg-31)
        )
      )
    (set! v1-17 #f)
    (label cfg-31)
    (if v1-17
        (return #f)
        )
    (kill-menu self #t #f)
    (create-menu self *join-create-menu* 0)
    #t
    )
  :code sleep-code
  :post lobby-default-post
  )

(defstate join-game-menu (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('menu-selection-event)
       (case (-> block param 0)
         (('cancel)
          (if (kill-menu self #f #f)
              (go-virtual host-join-menu)
              )
          )
         (('join-game)
          (cond
            ((= (-> self game-connection-type) 2)
             (when (no-menus-dying? self)
               (let ((v1-10 (-> block param 1)))
                 (when (and (>= (the-as int v1-10) 0) (< (the-as int v1-10) *net-available-game-ct*))
                   (when (send-event *net-mgr* 'join-game (-> block param 1))
                     (kill-menu self #f #f)
                     (go-virtual join-wait)
                     )
                   )
                 )
               )
             )
            ((= (-> self game-connection-type) 1)
             (when (no-menus-dying? self)
               (when (send-event *net-mgr* 'connect-lan-game (-> block param 1))
                 (kill-menu self #f #f)
                 (go-virtual join-wait)
                 )
               )
             )
            )
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (let ((v1-1 (the-as dropdown-item (find-menu self 'games-list))))
      (set! (-> v1-1 selected) #t)
      )
    (cond
      ((= (-> self game-connection-type) 2)
       (send-event *net-mgr* 'refresh-games 0)
       )
      ((= (-> self game-connection-type) 1)
       (send-event *net-mgr* 'refresh-lan-games 0)
       )
      )
    (set! (-> self refresh-time) (the-as uint (current-time)))
    )
  :exit (behavior ()
    (kill-by-type fmv-player *active-pool*)
    )
  :trans (behavior ()
    (when (>= (the-as uint (- (current-time) (the-as int (-> self refresh-time)))) (the-as uint 6000))
      (cond
        ((= (-> self game-connection-type) 2)
         (send-event *net-mgr* 'refresh-games 0)
         )
        ((= (-> self game-connection-type) 1)
         (send-event *net-mgr* 'refresh-lan-games 0)
         )
        )
      (set! (-> self refresh-time) (the-as uint (current-time)))
      )
    )
  :code sleep-code
  :post lobby-default-post
  )

(defstate host-wait (lobby-menu-manager)

(defstate local-init (lobby-menu-manager)
  :virtual #t
  :code (behavior ()
    (hack-start-local-game)
    (cond
      ((kiosk-code?)
       (set! (-> self local-players) 1)
       (set! (-> *num-players-info* min) 1)
       (set! (-> *num-players-info* max) 1)
       (go-virtual choose-event-menu)
       )
      (else
        (set! (-> self split-selection-prev-state) (-> self state name))
        (create-menu self *num-local-players-menu* 0)
        (go-virtual num-local-players)
        )
      )
    )
  :post lobby-default-post
  )

(defstate adventure-init (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('die-fast)
       (go-virtual die-fast)
       )
      )
    )
  :code (behavior ()
    (set! (-> self game-connection-type) (the-as uint 0))
    (hack-start-local-game)
    (if (or (demo?) (kiosk?))
        (go-virtual demo-press-start)
        (go-virtual adventure-training)
        )
    )
  :post lobby-default-post
  )

(defstate watch-intro (lobby-menu-manager)
  :virtual #t
  :code (behavior ()
    (start 'debug (get-continue-by-name *game-info* "fmv-intro") 0)
    )
  :post lobby-default-post
  )

(defstate watch-introb (lobby-menu-manager)
  :virtual #t
  :code (behavior ()
    (start 'debug (get-continue-by-name *game-info* "fmv-introb") 0)
    )
  :post lobby-default-post
  )

(defstate lobby-credits (lobby-menu-manager)
  :virtual #t
  :code (behavior ()
    (local-vars (a0-7 object))
    (kill-menu self #t #f)
    (kill-by-type jakx-logo-menu *active-pool*)
    (suspend)
    (kill-by-type fmv-player *active-pool*)
    (suspend)
    (suspend)
    (dma-release 'fmv-player)
    (while *net-world*
      (send-event *net-mgr* 'leave-game)
      (suspend)
      )
    (lobby-level-set! 1 'credits 'display)
    (until a0-7
      (suspend)
      (let ((v1-8 (level-get *level* 'credits)))
        (set! a0-7 (and v1-8 (= (-> v1-8 status) 'active)))
        )
      )
    (activate-end-credits-proc)
    (suspend)
    (while (handle->process (-> *end-credits-proc* handle))
      (suspend)
      )
    (suspend)
    (dma-release 'fmv-player)
    (until #f
      (let ((v1-16 (new 'stack-no-clear 'array 'int32 2)))
        (when (dma-try-alloc #x80040 #x80040 'fmv-player 0 (&-> v1-16 0) (&-> v1-16 1) #f)
          (suspend)
          (suspend)
          (goto cfg-23)
          )
        )
      (suspend)
      0
      )
    #f
    (label cfg-23)
    (hack-start-local-game)
    (go-virtual lobby-results-movie)
    )
  :post (behavior ()
    (update-camera)
    (seek! (-> self garage-lights) (-> self garage-lights-target) 0.06)
    (set-garage-switched! (-> self garage-lights))
    (when (nonzero? (-> self voice-id))
      (case (get-status *gui-control* (-> self voice-id))
        (((gui-status ready) (gui-status pending) (gui-status active))
         )
        (else
          (set! (-> self voice-id) (new 'static 'sound-id))
          (remove-setting! 'music-volume)
          )
        )
      )
    )
  )

(define *lobby-error-accept* (the-as (function object :behavior lobby-menu-manager) #f))

(define *lobby-error-cancel* (the-as (function object object :behavior lobby-menu-manager) #f))

(define *lobby-error-action* (the-as (function object object :behavior lobby-menu-manager) #f))

(define *lobby-error-arg* #f)

(define *lobby-error-extra-confirm-check* (the-as (function object :behavior lobby-menu-manager) #f))

(define *lobby-error-trans* (the-as (function object :behavior lobby-menu-manager) #f))

(defstate lobby-generic-error-menu (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (local-vars (v0-2 object))
    (case message
      (('unless)
       (all-running? (get-in-focus-menu self))
       (return #f)
       v0-2
       )
      (('accept 'cancel)
       (set! *lobby-error-trans* #f)
       (let ((gp-0 (the-as function #f)))
         (set! gp-0 (cond
                      ((= message 'accept)
                       (cond
                         (*lobby-error-extra-confirm-check*
                           (if (*lobby-error-extra-confirm-check*)
                               (set! gp-0 *lobby-error-accept*)
                               )
                           gp-0
                           )
                         (else
                           *lobby-error-accept*
                           )
                         )
                       )
                      (else
                        *lobby-error-cancel*
                        )
                      )
               )
         (when gp-0
           (when (= *lobby-error-action* #f)
             (set! *lobby-error-action* (the-as (function object object :behavior lobby-menu-manager) gp-0))
             gp-0
             )
           )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ((arg0 base-menu-info)
             (arg1 (function object))
             (arg2 (function symbol object))
             (arg3 symbol)
             (arg4 symbol)
             (arg5 symbol)
             )
    (set-setting! 'bg-a 'abs 0.0 0)
    (set! *lobby-error-action* #f)
    (when arg3
      (until (not (kill-menu self #t #f))
        (empty)
        )
      )
    (send-event (get-in-focus-menu self) 'hide)
    (suspend)
    (suspend)
    (create-menu self arg0 0)
    (set! *lobby-error-arg* arg4)
    (set! *lobby-error-accept* (the-as (function object :behavior lobby-menu-manager) arg1))
    (set! *lobby-error-cancel* (the-as (function object object :behavior lobby-menu-manager) arg2))
    (set! *lobby-error-extra-confirm-check* (the-as (function object :behavior lobby-menu-manager) arg5))
    (set! *pending-op* #f)
    )
  :exit (behavior ()
    (set! *lobby-error-trans* #f)
    (send-event (get-in-focus-menu self) 'unhide)
    )
  :trans (behavior ()
    (if *lobby-error-trans*
        (*lobby-error-trans*)
        )
    (let ((a0-1 (get-in-focus-menu self)))
      (when a0-1
        (when (all-running? a0-1)
          (when (cpad-or-kbd-pressed-var? (the-as uint 0) (pad-buttons x))
            (logclear! (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons x))
            (logclear! (-> *cpad-list* cpads 0 button0-rel 0) (pad-buttons x))
            (cpad-or-kbd-clear-func! (the-as uint 0) (pad-buttons x))
            (let ((v1-12 (make-sound-instance snd-choice1 (new 'static 'sound-id) (the-as handle #f))))
              (cond
                (v1-12
                  (logior! (-> v1-12 flags) (sound-spec-flag needs-update non-positional))
                  (-> v1-12 id)
                  )
                (else
                  0
                  )
                )
              )
            (send-event self 'accept)
            )
          (when (cpad-or-kbd-pressed-var? (the-as uint 0) (pad-buttons triangle))
            (logclear! (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons triangle))
            (logclear! (-> *cpad-list* cpads 0 button0-rel 0) (pad-buttons triangle))
            (cpad-or-kbd-clear-func! (the-as uint 0) (pad-buttons triangle))
            (let ((v1-23 (make-sound-instance snd-undo1 (new 'static 'sound-id) (the-as handle #f))))
              (cond
                (v1-23
                  (logior! (-> v1-23 flags) (sound-spec-flag needs-update non-positional))
                  (-> v1-23 id)
                  )
                (else
                  0
                  )
                )
              )
            (send-event self 'cancel)
            )
          )
        )
      )
    )
  :code (behavior ((arg0 base-menu-info)
             (arg1 (function object))
             (arg2 (function symbol object))
             (arg3 symbol)
             (arg4 symbol)
             (arg5 symbol)
             )
    (while (= *lobby-error-action* #f)
      (suspend)
      )
    (set! *lobby-error-accept* #f)
    (set! *lobby-error-cancel* #f)
    (set! *lobby-error-extra-confirm-check* #f)
    (kill-menu self #t #f)
    (*lobby-error-action* *lobby-error-arg*)
    )
  :post lobby-default-post
  )

;; WARN: Return type mismatch string vs object.
(defbehavior adventure-map-fade-in lobby-menu-manager ()
  (local-vars (gp-0 level))
  (let ((v1-1 (level-get *level* 'menumap)))
    (cond
      ((and v1-1 (= (-> v1-1 display?) 'display))
       (copy-string<-string (-> self cam-string) "camera-59")
       )
      (else
        (setup
          *screen-filter*
          (new 'static 'vector)
          (new 'static 'vector :w 128.0)
          (* 2.0 (seconds-per-frame))
          (bucket-id debug)
          #x3fffff
          #x33001
          (the-as symbol 0)
          )
        (until (= (-> *screen-filter* color w) 128.0)
          (suspend)
          )
        (suspend)
        (kill-by-type fmv-player *active-pool*)
        (suspend)
        (suspend)
        (dma-release 'fmv-player)
        (lobby-level-set! 0 'menu2 'special)
        (lobby-level-set! 1 'menumap 'display)
        (until gp-0
          (set! gp-0 (level-get *level* 'menumap))
          (suspend)
          )
        (until (= (-> gp-0 display?) 'display)
          (suspend)
          )
        (copy-string<-string (-> self cam-string) "camera-59")
        (set-lobby-camera-seek-time! 0.001)
        (suspend)
        (set-lobby-camera-seek-time! 0.5)
        (setup
          *screen-filter*
          (new 'static 'vector :w 128.0)
          (new 'static 'vector)
          (* 2.0 (seconds-per-frame))
          (bucket-id debug)
          #x3fffff
          #x33001
          (the-as symbol 0)
          )
        (while (-> *screen-filter* draw?)
          (suspend)
          )
        (the-as string #f)
        )
      )
    )
  )

;; WARN: Return type mismatch float vs object.
;; WARN: new jak 2 until loop case, check carefully
(defbehavior adventure-map-fade-out lobby-menu-manager ((arg0 symbol))
  (local-vars (gp-1 level))
  (let ((v1-1 (level-get *level* 'menu2)))
    (cond
      ((and v1-1 (= (-> v1-1 display?) 'display))
       (lobby-level-set! 1 'menumap #f)
       (if (= (-> self state name) 'game-type-menu)
           (copy-string<-string (-> self cam-string) "camera-6")
           (copy-string<-string (-> self cam-string) "camera-68")
           )
       (if (!= (-> self prev-state name) 'adventure-vehicle-select)
           (set-lobby-camera-seek-time! 0.001)
           )
       (suspend)
       (set-lobby-camera-seek-time! 0.5)
       )
      (else
        (setup
          *screen-filter*
          (new 'static 'vector)
          (new 'static 'vector :w 128.0)
          (* 2.0 (seconds-per-frame))
          (bucket-id debug)
          #x3fffff
          #x33001
          (the-as symbol 0)
          )
        (until (= (-> *screen-filter* color w) 128.0)
          (suspend)
          )
        (dma-release 'fmv-player)
        (until #f
          (let ((v1-17 (new 'stack-no-clear 'array 'uint32 2)))
            (when (dma-try-alloc
                    #x80040
                    #x80040
                    'fmv-player
                    0
                    (the-as (pointer int32) (&-> v1-17 0))
                    (the-as (pointer int32) (&-> v1-17 1))
                    #f
                    )
              (suspend)
              (suspend)
              (goto cfg-17)
              )
            )
          (suspend)
          0
          )
        #f
        (label cfg-17)
        (lobby-level-set! 0 'menu2 'display)
        (if (not arg0)
            (lobby-level-set! 1 #f #f)
            )
        (until gp-1
          (set! gp-1 (level-get *level* 'menu2))
          (suspend)
          )
        (until (= (-> gp-1 display?) 'display)
          (suspend)
          )
        (if (= (-> self state name) 'game-type-menu)
            (copy-string<-string (-> self cam-string) "camera-6")
            (copy-string<-string (-> self cam-string) "camera-68")
            )
        (if (!= (-> self prev-state name) 'adventure-vehicle-select)
            (set-lobby-camera-seek-time! 0.001)
            )
        (suspend)
        (set-lobby-camera-seek-time! 0.5)
        (setup
          *screen-filter*
          (new 'static 'vector :w 128.0)
          (new 'static 'vector)
          (* 2.0 (seconds-per-frame))
          (bucket-id debug)
          #x3fffff
          #x33001
          (the-as symbol 0)
          )
        (while (-> *screen-filter* draw?)
          (suspend)
          )
        (the-as float #f)
        )
      )
    )
  )

(defstate game-type-menu (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('menu-selection-event)
       (case (-> block param 0)
         (('accept)
          (case (-> block param 1)
            (('single-event)
             (when (kill-menu self #f #f)
               (kill-logo-menu self)
               (go-virtual single-event-menu)
               #t
               )
             )
            (('adventure)
             (set! (-> self game-connection-type) (the-as uint 0))
             (set! (-> self local-players) 1)
             (set! *lobby-local-players* (-> self local-players))
             (set! *game-mode* 'adventure)
             (set! (-> self vehicle-selected) (the-as uint -1))
             (when (kill-menu self #f #f)
               (kill-logo-menu self)
               (go-virtual adventure-init)
               )
             )
            (('customize)
             (when (kill-menu self #f #f)
               (kill-logo-menu self)
               (go-virtual customize-main-menu)
               #t
               )
             )
            (('options)
             (when (kill-menu self #f #f)
               (create-menu self *options-menu-info* 0)
               (kill-logo-menu self)
               (go-virtual options-menu)
               #t
               )
             )
            (('secrets)
             (when (kill-menu self #f #f)
               (kill-logo-menu self)
               (go-virtual secrets-menu)
               )
             )
            (('profile)
             (if (kill-menu self #f #f)
                 (go-virtual new-load-save-profile)
                 )
             )
            (('multiplayer)
             (set! *game-mode* 'online)
             (set! (-> *num-players-info* min) 2)
             (set! (-> *num-players-info* max) 6)
             (set! (-> self game-connection-type) (the-as uint 2))
             (go-virtual waiting-network-config-list)
             )
            )
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (set-lobby-camera-seek-time! 0.5)
    (set! (-> self garage-lights-target) 0.0)
    (set! (-> self psp-mode-run?) #f)
    (restore-selection-index)
    )
  :trans (behavior ()
    (lmm-make-logo-menu self)
    (if (not (handle->process (-> self vehicle-handle)))
        (set! (-> self vehicle-selected)
              (-> *game-info* player-info (-> self current-local-player) last-selected-vehicle)
              )
        )
    )
  :code (behavior ()
    (if (= (-> self prev-state name) 'adventure-cup)
        (adventure-map-fade-out #f)
        )
    (copy-string<-string (-> self cam-string) "camera-6")
    (sleep-code)
    )
  :post lobby-default-post
  )

(defstate single-event-menu (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('menu-selection-event)
       (case (-> block param 0)
         (('accept)
          (case (-> block param 1)
            (('local-connection)
             (set! *game-mode* 'single-event)
             (when (kill-menu self #t #f)
               (set! (-> *num-players-info* min) 1)
               (set! (-> *num-players-info* max) 6)
               (set! (-> self game-connection-type) (the-as uint 0))
               (go-virtual local-init)
               )
             )
            (('lan-connection)
             (set! *lobby-fast-connect* #f)
             (set! *game-mode* 'lan)
             (set! (-> *num-players-info* min) 2)
             (set! (-> *num-players-info* max) 6)
             (set! (-> self game-connection-type) (the-as uint 1))
             (go-virtual waiting-network-config-list)
             )
            (('multiplayer 'multiplayer-fast)
             (set! *lobby-fast-connect* (= (-> block param 1) 'multiplayer-fast))
             (set! *game-mode* 'online)
             (set! (-> *num-players-info* min) 2)
             (set! (-> *num-players-info* max) 6)
             (set! (-> self game-connection-type) (the-as uint 2))
             (go-virtual waiting-network-config-list)
             )
            (('adventure)
             (set! (-> self game-connection-type) (the-as uint 0))
             (set! (-> self local-players) 1)
             (set! *lobby-local-players* (-> self local-players))
             (set! *game-mode* 'adventure)
             (when (kill-menu self #t #f)
               (cond
                 ((and (cpad-hold? 0 l1) (cpad-hold? 0 l2))
                  (go-virtual watch-intro)
                  )
                 ((and (cpad-hold? 0 r1) (cpad-hold? 0 r2))
                  (go-virtual watch-introb)
                  )
                 (else
                   (go-virtual adventure-init)
                   )
                 )
               )
             )
            )
          )
         (('cancel)
          (when (kill-menu self #f #f)
            (create-menu self *base-menu-info* 0)
            (go-virtual game-type-menu)
            )
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (local-vars (v1-2 symbol))
    (dotimes (v1-0 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-0))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-0))) info-ptr) *single-event-menu-info*)
                 )
        (set! v1-2 #t)
        (goto cfg-20)
        )
      )
    (set! v1-2 #f)
    (label cfg-20)
    (if v1-2
        (goto cfg-24)
        )
    (kill-menu self #t #f)
    (create-menu self *single-event-menu-info* 0)
    #t
    (label cfg-24)
    (restore-selection-index)
    )
  :code sleep-code
  :post lobby-default-post
  )

(defstate options-menu (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('menu-selection-event)
       (case (-> block param 0)
         (('accept)
          (case (-> block param 1)
            (('graphic)
             (if (kill-menu self #f #f)
                 (go-virtual video-options-menu)
                 )
             )
            (('sound)
             (when (kill-menu self #f #f)
               (create-menu self *sound-options-menu-info* 0)
               (go-virtual sound-options-menu)
               )
             )
            (('game)
             (when (kill-menu self #f #f)
               (create-menu self *game-options-menu-info* 0)
               (go-virtual game-options-menu)
               )
             )
            )
          )
         (('cancel)
          (auto-save-command 'auto-save 0 0 *default-pool* #f #f)
          (when (kill-menu self #f #f)
            (create-menu self *base-menu-info* 0)
            (go-virtual game-type-menu)
            )
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (restore-selection-index)
    )
  :code sleep-code
  :post lobby-default-post
  )

;; WARN: Return type mismatch int vs language-enum.
(defun next-language ((arg0 language-enum))
  (let ((v0-0 (the-as int (+ arg0 1))))
    (cond
      ((= v0-0 -1)
       (set! v0-0 9)
       )
      ((and (< (the-as uint 4) (the-as uint v0-0)) (< (the-as uint v0-0) (the-as uint 8)))
       (set! v0-0 8)
       )
      ((< (the-as uint 9) (the-as uint v0-0))
       (set! v0-0 0)
       )
      )
    (the-as language-enum v0-0)
    )
  )

;; WARN: Return type mismatch int vs language-enum.
(defun prev-language ((arg0 language-enum))
  (let ((v0-0 (the-as int (+ arg0 -1))))
    (cond
      ((= v0-0 -1)
       (set! v0-0 9)
       )
      ((and (< (the-as uint 4) (the-as uint v0-0)) (< (the-as uint v0-0) (the-as uint 8)))
       (set! v0-0 4)
       )
      ((< (the-as uint 9) (the-as uint v0-0))
       (set! v0-0 0)
       )
      )
    (the-as language-enum v0-0)
    )
  )

(defstate game-options-menu (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (local-vars (v0-1 object))
    (case message
      (('menu-selection-event)
       (case (-> block param 0)
         (('cancel)
          (when (kill-menu self #f #f)
            (create-menu self *options-menu-info* 0)
            (go-virtual options-menu)
            )
          )
         (('vibration)
          (case (-> block param 1)
            (('next)
             (next-selection self *vibration-menu-info*)
             )
            (('previous)
             (prev-selection self *vibration-menu-info*)
             )
            )
          )
         (('crash-cam)
          (case (-> block param 1)
            (('next)
             (next-selection self *crash-cam-menu-info*)
             )
            (('previous)
             (prev-selection self *crash-cam-menu-info*)
             )
            )
          )
         (('kill-cam)
          (case (-> block param 1)
            (('next)
             (next-selection self *kill-cam-menu-info*)
             )
            (('previous)
             (prev-selection self *kill-cam-menu-info*)
             )
            )
          )
         (('subtitle)
          (case (-> block param 1)
            (('next 'previous)
             (cond
               ((-> *setting-control* user-default subtitle)
                (set! (-> *setting-control* user-default subtitle) #f)
                #f
                )
               (else
                 (set! v0-1 #t)
                 (set! (-> *setting-control* user-default subtitle) (the-as symbol v0-1))
                 v0-1
                 )
               )
             )
            )
          )
         (('language-subtitle)
          (case (-> block param 1)
            (('next)
             (set! v0-1 (next-language (-> *setting-control* user-default subtitle-language)))
             (set! (-> *setting-control* user-default subtitle-language) (the-as language-enum v0-1))
             v0-1
             )
            (('previous)
             (set! v0-1 (prev-language (-> *setting-control* user-default subtitle-language)))
             (set! (-> *setting-control* user-default subtitle-language) (the-as language-enum v0-1))
             v0-1
             )
            )
          )
         (('language)
          (case (-> block param 1)
            (('next)
             (set! v0-1 (next-language (-> *setting-control* user-default language)))
             (set! (-> *setting-control* user-default language) (the-as language-enum v0-1))
             v0-1
             )
            (('previous)
             (set! v0-1 (prev-language (-> *setting-control* user-default language)))
             (set! (-> *setting-control* user-default language) (the-as language-enum v0-1))
             v0-1
             )
            )
          )
         (('language-audio)
          (case (-> block param 1)
            (('next)
             (+! (-> *setting-control* user-default audio-language) 1)
             )
            (('previous)
             (+! (-> *setting-control* user-default audio-language) -1)
             )
            )
          (if (= (the-as uint (-> *setting-control* user-default audio-language)) 255)
              (set! (-> *setting-control* user-default audio-language) (language-enum italian))
              )
          (set! v0-1 (min-max-wrap-around (the-as int (-> *setting-control* user-default audio-language)) 0 4))
          (set! (-> *setting-control* user-default audio-language) (the-as language-enum v0-1))
          v0-1
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (cond
      ((-> *setting-control* user-default vibration)
       (set! (-> *vibration-menu-info* selection-index) 0)
       0
       )
      (else
        (set! (-> *vibration-menu-info* selection-index) 1)
        )
      )
    (cond
      ((-> *setting-control* user-default crash-cam)
       (set! (-> *crash-cam-menu-info* selection-index) 0)
       0
       )
      (else
        (set! (-> *crash-cam-menu-info* selection-index) 1)
        )
      )
    (cond
      ((-> *setting-control* user-default kill-cam)
       (set! (-> *kill-cam-menu-info* selection-index) 0)
       0
       )
      (else
        (set! (-> *kill-cam-menu-info* selection-index) 1)
        )
      )
    (if (= (scf-get-territory) 1)
        (set! (-> *languge-text-ids* 0) (text-id text-id-521))
        (set! (-> *languge-text-ids* 0) (text-id text-id-18))
        )
    (restore-selection-index)
    )
  :trans (behavior ()
    (if (= (-> *vibration-menu-info* array-ptr (-> *vibration-menu-info* selection-index) sym) 'on)
        (set! (-> *setting-control* user-default vibration) #t)
        (set! (-> *setting-control* user-default vibration) #f)
        )
    (if (= (-> *crash-cam-menu-info* array-ptr (-> *crash-cam-menu-info* selection-index) sym) 'on)
        (set! (-> *setting-control* user-default crash-cam) #t)
        (set! (-> *setting-control* user-default crash-cam) #f)
        )
    (if (= (-> *kill-cam-menu-info* array-ptr (-> *kill-cam-menu-info* selection-index) sym) 'on)
        (set! (-> *setting-control* user-default kill-cam) #t)
        (set! (-> *setting-control* user-default kill-cam) #f)
        )
    (let ((gp-0 (the-as string-menu (find-menu self 'subtitle))))
      (let ((s4-0 (the-as string-menu (find-menu self 'language-subtitle)))
            (s5-0 (the-as string-menu (find-menu self 'language)))
            (v1-16 (the-as string-menu (find-menu self 'language-audio)))
            )
        (set! (-> s4-0 info-ptr strings-info 0 id)
              (-> *languge-text-ids* (-> *setting-control* user-default subtitle-language))
              )
        (set! (-> s5-0 info-ptr strings-info 0 id)
              (-> *languge-text-ids* (-> *setting-control* user-default language))
              )
        (set! (-> v1-16 info-ptr strings-info 0 id)
              (-> *languge-text-ids* (-> *setting-control* user-default audio-language))
              )
        )
      (if (-> *setting-control* user-default subtitle)
          (set! (-> gp-0 info-ptr strings-info 0 id) (text-id text-id-15))
          (set! (-> gp-0 info-ptr strings-info 0 id) (text-id text-id-16))
          )
      )
    )
  :code sleep-code
  :post lobby-default-post
  )

(defstate sound-options-menu (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('menu-selection-event)
       (case (-> block param 0)
         (('accept)
          #f
          )
         (('sfx)
          (case (-> block param 1)
            (('next)
             (set! (-> *setting-control* user-default sfx-volume) (+ 0.01 (-> *setting-control* user-default sfx-volume)))
             )
            (('previous)
             (set! (-> *setting-control* user-default sfx-volume) (+ -0.01 (-> *setting-control* user-default sfx-volume)))
             )
            )
          )
         (('music)
          (case (-> block param 1)
            (('next)
             (+! (-> *setting-control* user-default music-volume) 0.01)
             )
            (('previous)
             (+! (-> *setting-control* user-default music-volume) -0.01)
             )
            )
          (set! (-> *setting-control* user-default music-volume)
                (fmax 0.0 (fmin 1.0 (-> *setting-control* user-default music-volume)))
                )
          )
         (('speech)
          (case (-> block param 1)
            (('next)
             (set! (-> *setting-control* user-default dialog-volume)
                   (+ 0.01 (-> *setting-control* user-default dialog-volume))
                   )
             )
            (('previous)
             (set! (-> *setting-control* user-default dialog-volume)
                   (+ -0.01 (-> *setting-control* user-default dialog-volume))
                   )
             )
            )
          )
         (('stereo-mode)
          (case (-> block param 1)
            (('next)
             (+! (-> *setting-control* user-default stereo-mode) 1)
             (set! (-> *setting-control* user-default stereo-mode)
                   (min-max-wrap-around (-> *setting-control* user-default stereo-mode) 0 2)
                   )
             )
            (('previous)
             (+! (-> *setting-control* user-default stereo-mode) -1)
             (set! (-> *setting-control* user-default stereo-mode)
                   (min-max-wrap-around (-> *setting-control* user-default stereo-mode) 0 2)
                   )
             )
            )
          (let ((v1-44 (-> *setting-control* user-default stereo-mode)))
            (cond
              ((zero? v1-44)
               (set-index *stereo-mode-info* 'mono)
               )
              ((= v1-44 1)
               (set-index *stereo-mode-info* 'stereo)
               )
              ((= v1-44 2)
               (set-index *stereo-mode-info* 'surround)
               )
              )
            )
          )
         (('cancel)
          (when (kill-menu self #f #f)
            (create-menu self *options-menu-info* 0)
            (go-virtual options-menu)
            )
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (let ((v1-1 (-> *setting-control* user-default stereo-mode)))
      (cond
        ((zero? v1-1)
         (set-index *stereo-mode-info* 'mono)
         )
        ((= v1-1 1)
         (set-index *stereo-mode-info* 'stereo)
         )
        ((= v1-1 2)
         (set-index *stereo-mode-info* 'surround)
         )
        )
      )
    )
  :trans (behavior ()
    (set! (-> *setting-control* user-default sfx-volume)
          (fmax 0.0 (fmin 1.0 (-> *setting-control* user-default sfx-volume)))
          )
    (set! (-> *sfx-volume-info* current-num) (the int (* 100.0 (-> *setting-control* user-default sfx-volume))))
    (send-event (find-menu self 'sfx-indicator) 'update (-> *setting-control* user-default sfx-volume))
    (set! (-> *setting-control* user-default music-volume)
          (fmax 0.0 (fmin 1.0 (-> *setting-control* user-default music-volume)))
          )
    (set! (-> *music-volume-info* current-num)
          (the int (* 100.0 (-> *setting-control* user-default music-volume)))
          )
    (send-event (find-menu self 'music-indicator) 'update (-> *setting-control* user-default music-volume))
    (set! (-> *setting-control* user-default dialog-volume)
          (fmax 0.0 (fmin 1.0 (-> *setting-control* user-default dialog-volume)))
          )
    (set! (-> *speech-volume-info* current-num)
          (the int (* 100.0 (-> *setting-control* user-default dialog-volume)))
          )
    (send-event (find-menu self 'dialog-indicator) 'update (-> *setting-control* user-default dialog-volume))
    (cond
      ((zero? (-> *setting-control* user-default stereo-mode))
       (set! (-> *sound-options-sprite-list* 0) 0)
       0
       )
      ((= (-> *setting-control* user-default stereo-mode) 1)
       (set! (-> *sound-options-sprite-list* 0) 1)
       )
      ((= (-> *setting-control* user-default stereo-mode) 2)
       (set! (-> *sound-options-sprite-list* 0) 2)
       )
      )
    )
  :code sleep-code
  :post lobby-default-post
  )

(defstate video-options-menu (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('menu-selection-event)
       (case (-> block param 0)
         (('aspect-ratio)
          (case (-> block param 1)
            (('next)
             (next-selection self *aspect-ratio*)
             )
            (('previous)
             (prev-selection self *aspect-ratio*)
             )
            )
          )
         (('accept)
          (case (-> block param 1)
            (('center-screen)
             (when (kill-menu self #f #f)
               (create-menu self *center-screen-menu-info* 0)
               (go-virtual center-screen-menu)
               )
             )
            )
          )
         (('progressive-scan)
          (cond
            ((-> *setting-control* user-default smode2)
             (set-progressive-scan #f)
             (set-index *progressive-menu-info* 'off)
             )
            (else
              (set-index *progressive-menu-info* 'on)
              (go-virtual progressive-warning 'progressive)
              )
            )
          )
         (('video-mode)
          (cond
            ((= (-> *setting-control* user-default video-mode) 'ntsc)
             (let ((v0-0 (the-as object 'pal)))
               (set! (-> *setting-control* user-default video-mode) (the-as symbol v0-0))
               v0-0
               )
             )
            (else
              (go-virtual progressive-warning 'video-mode)
              )
            )
          )
         (('brightness)
          (case (-> block param 1)
            (('next)
             (set! (-> *setting-control* user-default brightness) (+ 0.01 (-> *setting-control* user-default brightness)))
             )
            (('previous)
             (set! (-> *setting-control* user-default brightness) (+ -0.01 (-> *setting-control* user-default brightness)))
             )
            )
          )
         (('contrast)
          (case (-> block param 1)
            (('next)
             (set! (-> *setting-control* user-default contrast) (+ 0.01 (-> *setting-control* user-default contrast)))
             )
            (('previous)
             (set! (-> *setting-control* user-default contrast) (+ -0.01 (-> *setting-control* user-default contrast)))
             )
            )
          )
         (('cancel)
          (when (kill-menu self #f #f)
            (create-menu self *options-menu-info* 0)
            (go-virtual options-menu)
            )
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (local-vars (v1-2 symbol) (v1-11 symbol))
    (cond
      ((= (scf-get-territory) 1)
       (dotimes (v1-0 (+ (-> self in-focus-index) 1))
         (when (and (handle->process (-> self menu-handles v1-0))
                    (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-0))) info-ptr)
                       *video-options-menu-info-europe*
                       )
                    )
           (set! v1-2 #t)
           (goto cfg-21)
           )
         )
       (set! v1-2 #f)
       (label cfg-21)
       (if (not v1-2)
           (create-menu self *video-options-menu-info-europe* 0)
           )
       (set! (-> *graphic-options-sprite-list* length) 3)
       )
      (else
        (dotimes (v1-9 (+ (-> self in-focus-index) 1))
          (when (and (handle->process (-> self menu-handles v1-9))
                     (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-9))) info-ptr) *video-options-menu-info*)
                     )
            (set! v1-11 #t)
            (goto cfg-44)
            )
          )
        (set! v1-11 #f)
        (label cfg-44)
        (if (not v1-11)
            (create-menu self *video-options-menu-info* 0)
            )
        (set! (-> *graphic-options-sprite-list* length) 2)
        )
      )
    (cond
      ((= (get-aspect-ratio) 'aspect16x9)
       (if (!= (-> *aspect-ratio* array-ptr (-> *aspect-ratio* selection-index) sym) '16x9)
           (next-selection self *aspect-ratio*)
           )
       )
      (else
        (if (!= (-> *aspect-ratio* array-ptr (-> *aspect-ratio* selection-index) sym) '4x3)
            (next-selection self *aspect-ratio*)
            )
        )
      )
    (cond
      ((-> *setting-control* user-default smode2)
       (set-index *progressive-menu-info* 'on)
       (set! (-> *graphic-options-sprite-list* 1) 2)
       )
      (else
        (set-index *progressive-menu-info* 'off)
        (set! (-> *graphic-options-sprite-list* 1) 3)
        )
      )
    (cond
      ((= (-> *setting-control* user-default video-mode) 'ntsc)
       (set-index *video-mode-menu-info* 'ntsc)
       (set! (-> *graphic-options-sprite-list* 2) 5)
       )
      (else
        (set-index *video-mode-menu-info* 'pal)
        (set! (-> *graphic-options-sprite-list* 2) 4)
        )
      )
    )
  :trans (behavior ()
    (cond
      ((= (-> *aspect-ratio* array-ptr (-> *aspect-ratio* selection-index) sym) '16x9)
       (set! (-> *graphic-options-sprite-list* 0) 0)
       (if (!= (get-aspect-ratio) 'aspect16x9)
           (set! (-> *setting-control* user-default aspect-ratio) 'aspect16x9)
           )
       )
      (else
        (set! (-> *graphic-options-sprite-list* 0) 1)
        (if (!= (get-aspect-ratio) 'aspect4x3)
            (set! (-> *setting-control* user-default aspect-ratio) 'aspect4x3)
            )
        )
      )
    (set! (-> *setting-control* user-default contrast)
          (fmax 0.25 (fmin 1.0 (-> *setting-control* user-default contrast)))
          )
    (set! (-> *contrast-info* current-num) (the int (* 100.0 (-> *setting-control* user-default contrast))))
    (send-event (find-menu self 'contrast) 'update (-> *setting-control* user-default contrast))
    (set! (-> *setting-control* user-default brightness)
          (fmax 0.25 (fmin 1.0 (-> *setting-control* user-default brightness)))
          )
    (set! (-> *brightness-info* current-num) (the int (* 100.0 (-> *setting-control* user-default brightness))))
    (send-event (find-menu self 'brightness) 'update (-> *setting-control* user-default brightness))
    )
  :code sleep-code
  :post lobby-default-post
  )

(define *video-change* 'progressive)

(defstate progressive-warning (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('menu-selection-event)
       (case (-> block param 0)
         (('accept)
          (case (-> block param 1)
            (('no)
             (when (kill-menu self #f #f)
               (send-event (get-in-focus-menu self) 'unhide)
               (go-virtual video-options-menu)
               )
             )
            (('yes)
             (when (kill-menu self #f #f)
               (cond
                 ((= *video-change* 'progressive)
                  (set-progressive-scan #t)
                  (go-virtual progressive-accept)
                  )
                 (else
                   (set! (-> *setting-control* user-default video-mode) 'ntsc)
                   (go-virtual progressive-accept)
                   )
                 )
               )
             )
            )
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ((arg0 symbol))
    (set! *video-change* arg0)
    (send-event (get-in-focus-menu self) 'hide)
    (create-menu self *progressive-warning* 0)
    (if (= *video-change* 'progressive)
        (set! (-> *video-mode-ids* 0) (the-as uint 141))
        (set! (-> *video-mode-ids* 0) (the-as uint 140))
        )
    )
  :code (the-as (function symbol object) sleep-code)
  :post lobby-default-post
  )

(defstate progressive-accept (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('menu-selection-event)
       (case (-> block param 0)
         (('accept)
          (case (-> block param 1)
            (('no)
             (when (kill-menu self #f #f)
               (send-event (get-in-focus-menu self) 'unhide)
               (if (= *video-change* 'progressive)
                   (set-progressive-scan #f)
                   (set! (-> *setting-control* user-default video-mode) 'pal)
                   )
               (go-virtual video-options-menu)
               )
             )
            (('yes)
             (when (kill-menu self #f #f)
               (send-event (get-in-focus-menu self) 'unhide)
               (go-virtual video-options-menu)
               )
             )
            )
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (set-time! (-> self state-time))
    (create-menu self *progressive-accept* 0)
    (if (= *video-change* 'progressive)
        (set! (-> *video-mode-change-ids* 0) (the-as uint 145))
        (set! (-> *video-mode-change-ids* 0) (the-as uint 144))
        )
    )
  :code (behavior ()
    (until (< (seconds 10) (- (current-time) (-> self state-time)))
      (suspend)
      )
    (if (= *video-change* 'progressive)
        (set-progressive-scan #f)
        (set! (-> *setting-control* user-default video-mode) 'pal)
        )
    (kill-menu self #t #f)
    (send-event (get-in-focus-menu self) 'unhide)
    (go-virtual video-options-menu)
    )
  :post lobby-default-post
  )

(defstate psp-wait-disconnect (lobby-menu-manager)
  :virtual #t
  :enter (behavior ((arg0 symbol))
    '()
    )
  :code (behavior ((arg0 symbol))
    (when (!= (psplink-stop) -1)
      (until (= (psplink-poll) -2)
        (suspend)
        )
      )
    (cond
      ((= arg0 'secrets-menu)
       (go-virtual secrets-menu)
       )
      ((= arg0 'no-chars)
       (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-4244))
       (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
       (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
       (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
       (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
       (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
       (go-virtual
         lobby-generic-error-menu
         *lobby-generic-confirmation*
         (lambda :behavior lobby-menu-manager () (go-virtual secrets-menu))
         (the-as (function symbol object) #f)
         #t
         #f
         #f
         )
       )
      ((= arg0 'game-type-menu)
       (go-virtual game-type-menu)
       )
      ((= arg0 'lobby-results-new-driver-screen)
       (set! *return-to-secrets* #t)
       (go-virtual lobby-results-new-driver-screen)
       )
      ((= arg0 'lobby-results-new-vehicle-animation)
       (set! *return-to-secrets* #t)
       (go-virtual lobby-results-new-vehicle-animation)
       )
      (else
        (go-virtual secrets-menu)
        )
      )
    )
  )

(defstate center-screen-menu (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (lobby-menu-manager-default-handler proc argc message block)
    )
  :trans (behavior ()
    (cond
      ((cpad-or-kbd-pressed-var? (the-as uint 0) (pad-buttons x))
       (logclear! (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons x))
       (logclear! (-> *cpad-list* cpads 0 button0-rel 0) (pad-buttons x))
       (cpad-or-kbd-clear-func! (the-as uint 0) (pad-buttons x))
       (if (kill-menu self #f #f)
           (go-virtual video-options-menu)
           )
       )
      ((cpad-hold? 0 left l-analog-left)
       (set! (-> *setting-control* user-default screenx)
             (min-max-wrap-around (+ (-> *setting-control* user-default screenx) -2) -96 96)
             )
       )
      ((cpad-hold? 0 right l-analog-right)
       (set! (-> *setting-control* user-default screenx)
             (min-max-wrap-around (+ (-> *setting-control* user-default screenx) 2) -96 96)
             )
       )
      ((cpad-hold? 0 up l-analog-up)
       (set! (-> *setting-control* user-default screeny)
             (min-max-wrap-around (+ (-> *setting-control* user-default screeny) -2) -48 48)
             )
       )
      ((cpad-hold? 0 down l-analog-down)
       (set! (-> *setting-control* user-default screeny)
             (min-max-wrap-around (+ (-> *setting-control* user-default screeny) 2) -48 48)
             )
       )
      ((cpad-or-kbd-pressed-var? (the-as uint 0) (pad-buttons square))
       (set! (-> *setting-control* user-default screenx) 0)
       (set! (-> *setting-control* user-default screeny) 0)
       0
       )
      )
    )
  :code (behavior ()
    (let ((gp-0 (-> *setting-control* user-default screenx))
          (s5-0 (-> *setting-control* user-default screeny))
          )
      (until #f
        (suspend)
        (when (cpad-or-kbd-pressed-var? (the-as uint 0) (pad-buttons triangle))
          (logclear! (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons triangle))
          (logclear! (-> *cpad-list* cpads 0 button0-rel 0) (pad-buttons triangle))
          (cpad-or-kbd-clear-func! (the-as uint 0) (pad-buttons triangle))
          (when (kill-menu self #f #f)
            (set! (-> *setting-control* user-default screenx) gp-0)
            (set! (-> *setting-control* user-default screeny) s5-0)
            (go-virtual video-options-menu)
            )
          )
        )
      )
    #f
    )
  :post lobby-default-post
  )

(defstate lan-connect (lobby-menu-manager)
  :virtual #t
  :code (behavior ()
    (net-mgr-notify-connect self 15)
    (kill-menu self #t #f)
    (cond
      ((kiosk-code?)
       (set! (-> self local-players) 1)
       (set! *lobby-local-players* (-> self local-players))
       (go-virtual host-join-menu)
       )
      (else
        (set! (-> self split-selection-prev-state) (-> self state name))
        (create-menu self *num-local-players-menu* 0)
        (go-virtual num-local-players)
        )
      )
    )
  :post lobby-default-post
  )

(defstate internet-connect (lobby-menu-manager)
  :virtual #t
  :code (behavior ()
    (local-vars (v1-2 object))
    (net-mgr-notify-connect self 15)
    (until v1-2
      (suspend)
      (set! v1-2 (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'idle)))
      )
    (send-event *net-mgr* 'connect-to-lobby #f)
    (go-virtual connecting-to-lobby)
    )
  :post lobby-default-post
  )


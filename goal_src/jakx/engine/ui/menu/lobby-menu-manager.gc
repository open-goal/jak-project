  (the-as lobby-menu-manager ((method-of-type process relocate) this offset))
  )

(defbehavior lobby-menu-manager-init-by-other lobby-menu-manager ()
  (stack-size-set! (-> self main-thread) 1024)
  (set! (-> self menu-handle-1) (the-as handle #f))
  (set! (-> self menu-handle-2) (the-as handle #f))
  (set! (-> self menu-handle-popup) (the-as handle #f))

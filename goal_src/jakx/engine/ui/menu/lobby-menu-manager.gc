(defmethod select-event ((this lobby-menu-manager) (arg0 int) (arg1 symbol))
  (ash 1 arg0)
  (let ((s3-0 0)
        (gp-0 #f)
        )
    (when (or arg1
              (!= (-> *menu-events-info-array* last-sym)

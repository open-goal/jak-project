(defstate wait-for-world (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('lobby-game-unavailable)
       (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-1605))
       (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
       (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
       (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
       (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
       (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
       (go-virtual
         lobby-generic-error-menu
         *lobby-generic-confirmation*
         (lambda :behavior lobby-menu-manager () (go-virtual host-join-menu))
         (the-as (function symbol object) #f)
         #t
         #f
         #f
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :code (behavior ((arg0 symbol))
    (suspend-for (seconds 10)
      (if *net-world*
          (goto cfg-11)
          )
      (suspend)
      )
    (send-event *net-mgr* 'leave-game)
    (send-event self 'lobby-game-unavailable)
    (until #f
      (suspend)
      )
    #f
    (label cfg-11)
    (if (-> *net-world* is-late-join)
        (go-virtual green-room)
        )
    (let ((s5-1 0))
      (dotimes (s4-0 16)
        (if (player-idx-vehicle-selected? *net-world* s4-0)
            (+! s5-1 1)
            )
        )
      (when (< 6 (+ s5-1 (-> self local-players)))
        (send-event *net-mgr* 'leave-game)
        (send-event self 'lobby-too-many-humans)
        (until #f
          (suspend)
          )
        #f
        )
      )
    (case (-> self local-players)
      ((1)
       (set-player-car-from-level-array 0)
       )
      ((2)
       (set-player-car-from-level-array 0)
       (set-player-vehicle
         *net-world*
         0
         (+ (* (if *net-mgr*
                   (-> *net-mgr* game-state local-machine-idx)
                   0
                   )
               2
               )
            1
            )
         *default-vehicle-load-parts*
         (new 'static 'tuning-info)
         )
       )
      )
    (cond
      (arg0
        (go-virtual pre-choose-event-menu)
        )
      (else
        (if (= (if *net-mgr*
                   (-> *net-mgr* game-state local-machine-idx)
                   0
                   )
               (-> *net-mgr* game-state session-master-idx)
               )
            (kick-machines
              (ash 1 (if *net-mgr*
                         (-> *net-mgr* game-state local-machine-idx)
                         0
                         )
                   )
              'game-disbanded
              )
            )
        (if (= (-> self local-players) 2)
            (set! (-> self spawn-another?) #t)
            (set! (-> self spawn-another?) #f)
            )
        (go-virtual personal-selection-pop-up 0)
        )
      )
    )
  :post lobby-default-post
  )

(defbehavior go-confirm-net-quit lobby-menu-manager ()
  (cond
    ((= (if *net-mgr*
            (-> *net-mgr* game-state local-machine-idx)
            0
            )
        (-> *net-mgr* game-state session-master-idx)
        )
     (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-1606))
     (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1712))
     (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1926))
     (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-4273))
     (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
     (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
     (go-virtual
       lobby-generic-error-menu
       *lobby-generic-confirmation*
       (lambda :behavior lobby-menu-manager
         ()
         (kill-menu self #f #f)
         (send-event *net-mgr* 'leave-game)
         (go-virtual host-join-menu)
         )
       (lambda :behavior lobby-menu-manager
         ((arg0 symbol))
         (format 0 "prev state was ~A~%" arg0)
         (cond
           ((= arg0 'ready-room-state)
            (go-virtual ready-room-state)
            )
           ((= arg0 'choose-event-menu)
            (go-virtual choose-event-menu)
            )
           (else
             #f
             )
           )
         )
       #f
       (-> self state name)
       #f
       )
     )
    (else
      (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-1608))
      (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1712))
      (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1926))
      (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-4273))
      (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
      (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
      (go-virtual
        lobby-generic-error-menu
        *lobby-generic-confirmation*
        (lambda :behavior lobby-menu-manager
          ()
          (kill-menu self #f #f)
          (send-event *net-mgr* 'leave-game)
          (go-virtual host-join-menu)
          )
        (lambda :behavior lobby-menu-manager
          ((arg0 symbol))
          (format 0 "prev state was ~A~%" arg0)
          (cond
            ((= arg0 'ready-room-state)
             (go-virtual ready-room-state)
             )
            ((= arg0 'choose-event-menu)
             (go-virtual choose-event-menu)
             )
            (else
              #f
              )
            )
          )
        #f
        (-> self state name)
        #f
        )
      )
    )
  )

(defstate going-to-ready-room (lobby-menu-manager)
  :virtual #t
  :event lobby-menu-manager-default-handler
  :code (behavior ()
    (kill-menu self #t #f)
    (if (= (if *net-mgr*
               (-> *net-mgr* game-state local-machine-idx)
               0
               )
           (-> *net-mgr* game-state session-master-idx)
           )
        (create-menu self *ready-room-host* 2)
        (create-menu self *ready-room* 2)
        )
    (go-virtual ready-room-state)
    )
  )

(defstate ready-room-state (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (local-vars (v0-2 object))
    (case message
      (('notify)
       (logclear! (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons triangle))
       (logclear! (-> *cpad-list* cpads 0 button0-rel 0) (pad-buttons triangle))
       (cpad-or-kbd-clear-func! (the-as uint 0) (pad-buttons triangle))
       (logclear! (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons x))
       (logclear! (-> *cpad-list* cpads 0 button0-rel 0) (pad-buttons x))
       (cpad-or-kbd-clear-func! (the-as uint 0) (pad-buttons x))
       (case (-> block param 0)
         (('done)
          (copy-charp<-charp (-> *medius-policy-string* data) (the-as (pointer uint8) (+ (-> block param 1) 4)))
          (net-mgr-method-57 *net-mgr* *medius-policy-string* -1)
          )
         )
       )
      (('net-world-changed)
       (case (-> block param 0)
         (('task)
          (let ((gp-1 (get-open-task-node-info)))
            (kill-by-type fmv-player *active-pool*)
            (if (-> gp-1 ipu)
                (fmv-player-run-texture (-> gp-1 ipu) *default-pool*)
                )
            )
          )
         (else
           (lobby-menu-manager-default-handler proc argc message block)
           )
         )
       )
      (('menu-selection-event)
       (if (get-keyboard-control)
           (return #f)
           )
       (case (-> block param 0)
         (('changed)
          (case (-> block param 1)
            (('player-1 'player-2 'player-3 'player-4 'player-5 'player-6)
             0
             (let* ((v1-20 (-> block param 1))
                    (v1-21 (cond
                             ((or (= v1-20 'quote) (= v1-20 'player-1))
                              0
                              )
                             ((or (= v1-20 'quote) (= v1-20 'player-2))
                              1
                              )
                             ((or (= v1-20 'quote) (= v1-20 'player-3))
                              2
                              )
                             ((or (= v1-20 'quote) (= v1-20 'player-4))
                              3

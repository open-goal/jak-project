(defmethod create-menu ((this lobby-menu-manager) (arg0 base-menu-info) (arg1 int))
  (when (not (or (= (-> this state name) 'lobby-generic-error-menu)
                 (= (-> this state name) 'inviting-player-to-clan)
                 (= (-> this state name) *this-create-menu-state-name*)
                 )
             )
    (set! *prev-create-menu-state-name* *this-create-menu-state-name*)
    (set! *this-create-menu-state-name* (the-as string (-> this state name)))
    )
  (cond
    ((< -1 (-> this in-focus-index))
     (if (handle->process (-> this menu-handles (-> this in-focus-index)))
         (send-event (handle->process (-> this menu-handles (-> this in-focus-index))) 'lose-focus)
         )
     (+! (-> this in-focus-index) 1)
     (cond
       ((>= (-> this in-focus-index) 8)
        (format #t "ERROR...max number of menus has been exceeded~%")
        )
       ((handle->process (-> this menu-handles (-> this in-focus-index)))
        (format #t "reached dying pool~%returning #f")
        )
       (else
         (let* ((s3-0 (get-process *default-dead-pool* base-menu #x4000 1))
                (v1-38 (when s3-0
                         (let ((s2-0 (method-of-type process activate)))
                           (s2-0 s3-0 this (symbol->string (-> base-menu symbol)) (the-as pointer #x70004000))
                           )
                         (run-now-in-process s3-0 base-menu-init-by-other arg0 (new 'static 'vector :w 1.0) arg1)
                         (-> s3-0 ppointer)
                         )
                       )
                )
           (when v1-38
             (set! (-> this menu-handles (-> this in-focus-index)) (process->handle (-> v1-38 0)))
             (change-to-last-brother (-> v1-38 0))
             )
           )
         )
       )
     )
    (else
      (+! (-> this in-focus-index) 1)
      (cond
        ((handle->process (-> this menu-handles (-> this in-focus-index)))
         (format #t "reached dying pool~%returning #f")
         )
        (else
          (let* ((s3-1 (get-process *default-dead-pool* base-menu #x4000 1))
                 (v1-50 (when s3-1
                          (let ((s2-1 (method-of-type process activate)))
                            (s2-1 s3-1 this (symbol->string (-> base-menu symbol)) (the-as pointer #x70004000))
                            )
                          (run-now-in-process s3-1 base-menu-init-by-other arg0 (new 'static 'vector :w 1.0) arg1)
                          (-> s3-1 ppointer)
                          )
                        )
                 )
            (when v1-50
              (set! (-> this menu-handles (-> this in-focus-index)) (process->handle (-> v1-50 0)))
              (change-to-last-brother (-> v1-50 0))
              )
            )
          )
        )
      )
    )
  )


;; WARN: Return type mismatch int vs object.
(defun filter-events-for-readyroom ()
  (with-pp
    (let ((gp-0 0))
      (dotimes (s5-0 (-> *menu-events-info-all* length))
        (let ((s1-0 #f)
              (s4-0 (-> *game-info* sub-task-list))
              )
          (dotimes (s3-0 (-> s4-0 length))
            (when (nonzero? s3-0)
              (let ((s2-0 (-> s4-0 s3-0)))
                (when (and (not (and (or (= (-> pp stack 112) 2) (= (-> pp stack 112) 1))
                                     (or (= (-> s2-0 net-play-mode) (net-play-mode timebox)) (= (-> s2-0 net-play-mode) (net-play-mode rushhour)))
                                     )
                                )
                           (and (= (-> s2-0 net-play-mode) (-> *menu-events-info-all* s5-0 extra-int))
                                (not (and *net-mgr* (= (-> s2-0 net-play-mode) (net-play-mode timetrial)) (= (-> *net-mgr* game-type) 2)))
                                (not (and *net-mgr* (= (-> s2-0 net-play-mode) (net-play-mode timetrial)) (is-clan-challenge)))
                                (not (and *net-mgr* (= (-> s2-0 net-play-mode) (net-play-mode assassin)) (is-clan-challenge)))
                                (not (and (= *lobby-timetrial-lock-mode* 'timetrial) (!= (-> s2-0 net-play-mode) 3)))
                                (not (and (= *lobby-timetrial-lock-mode* 'no-timetrial) (= (-> s2-0 net-play-mode) (net-play-mode timetrial)))
                                     )
                                (not s1-0)
                                )
                           )
                  (format #t "task: ~A~%" (-> *menu-events-info-all* s5-0 sym))
                  (format #t "humans: ~D, ~D~%" (-> s2-0 max-humans) (-> *num-players-info* current-num))
                  (format #t "cpu: ~D, ~D~%" (-> s2-0 max-cpu) (-> *ai-num-players-info* current-num))
                  (mem-copy!
                    (the-as pointer (-> *menu-events-info-array* array-ptr gp-0))
                    (the-as pointer (-> *menu-events-info-all* s5-0))
                    12
                    )
                  (if (= (-> *menu-events-info-array* array-ptr gp-0 extra-int)
                         (if *net-world*
                             (the-as int (-> *net-world* task-node-info net-play-mode))
                             18
                             )
                         )
                      (set! (-> *menu-events-info-array* selection-index) gp-0)
                      )
                  (+! gp-0 1)
                  (set! s1-0 #t)
                  )
                )
              )
            )
          )
        )
      (set! (-> *menu-events-info-array* array-ptr length) gp-0)
      gp-0
      )
    )
  )

;; WARN: Return type mismatch int vs object.
(defun lmm-make-background-menu ((arg0 lobby-menu-manager))
  (when (not (the-as base-menu (handle->process (-> arg0 menu-handle-background))))
    (let* ((s5-0 (get-process *default-dead-pool* base-menu #x4000 1))
           (v1-5
             (when s5-0
               (let ((s4-0 (method-of-type process activate)))
                 (s4-0 s5-0 arg0 (symbol->string (-> base-menu symbol)) (the-as pointer #x70004000))
                 )
               (run-now-in-process
                 s5-0
                 (the-as (function base-menu-info vector object :behavior lobby-menu-manager) base-menu-init-by-other)
                 *background-menu-info*
                 (new 'static 'vector :w 1.0)
                 )
               (-> s5-0 ppointer)
               )
             )
           )
      (when v1-5
        (set! (-> arg0 menu-handle-background) (process->handle (-> v1-5 0)))
        (change-to-last-brother (-> v1-5 0))
        )
      )
    )
  0
  )

;; WARN: Return type mismatch int vs object.
(defun lmm-make-logo-menu ((arg0 lobby-menu-manager))
  (when (and (not (the-as base-menu (handle->process (-> arg0 menu-handle-logo-subtitle))))
             (not (the-as base-menu (handle->process (-> arg0 menu-handle-logo-main))))
             )
    (let* ((s5-0 (get-process *default-dead-pool* jakx-logo-menu #x4000 1))
           (v1-9 (when s5-0
                   (let ((s4-0 (method-of-type process activate)))
                     (s4-0 s5-0 arg0 (symbol->string (-> jakx-logo-menu symbol)) (the-as pointer #x70004000))
                     )
                   (run-now-in-process
                     s5-0
                     (the-as (function base-menu-info vector object :behavior base-menu) base-menu-init-by-other)
                     *logo-menu-info*
                     (new 'static 'vector :w 1.0)
                     )
                   (-> s5-0 ppointer)
                   )
                 )
           )
      (when v1-9
        (set! (-> arg0 menu-handle-logo-main) (process->handle (-> v1-9 0)))
        (change-to-last-brother (-> v1-9 0))
        )
      )
    (when (zero? (scf-get-territory))
      (let* ((s5-1 (get-process *default-dead-pool* jakx-logo-menu #x4000 1))
             (v1-14 (when s5-1
                      (let ((s4-1 (method-of-type process activate)))
                        (s4-1 s5-1 arg0 (symbol->string (-> jakx-logo-menu symbol)) (the-as pointer #x70004000))
                        )
                      (run-now-in-process
                        s5-1
                        (the-as (function base-menu-info vector object :behavior base-menu) base-menu-init-by-other)
                        *logo-subtitle-menu-info*
                        (new 'static 'vector :w 1.0)
                        )
                      (-> s5-1 ppointer)
                      )
                    )
             )
        (when v1-14
          (set! (-> arg0 menu-handle-logo-subtitle) (process->handle (-> v1-14 0)))
          (change-to-last-brother (-> v1-14 0))
          )
        )
      )
    (if (or (not *fmv-player*) (not (string= "logo.ipu" *fmv-m2v-name*)))
        (fmv-player-run-texture "logo" *default-pool*)
        )
    )
  0
  )

;; WARN: Return type mismatch int vs object.
(defun kill-logo-menu ((arg0 lobby-menu-manager))
  (send-event (the-as base-menu (handle->process (-> arg0 menu-handle-logo-subtitle))) 'die)
  (send-event (the-as base-menu (handle->process (-> arg0 menu-handle-logo-main))) 'die)
  0
  )

(defstate init-state (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('die-fast)
       (go-virtual die-fast)
       )
      )
    )
  :enter (behavior ()
    (set-blackout-frames 0)
    (kill-persister *setting-control* 'title-control-scene 'render)
    (lmm-make-background-menu self)
    (logclear! (-> *game-info* secrets) (game-secrets hflip-screen))
    )
  :code (behavior ()
    (if (!= *game-mode* 'adventure)
        (jukebox-onoff #t)
        )
    (disable *screen-filter*)
    (disable (-> *screen-filter-array* 0))
    (until #f
      (let ((v1-8 (new 'stack-no-clear 'array 'uint32 2)))
        (when (dma-try-alloc
                #x80040
                #x80040
                'fmv-player
                0
                (the-as (pointer int32) (&-> v1-8 0))
                (the-as (pointer int32) (&-> v1-8 1))
                #f
                )
          (suspend)
          (suspend)
          (goto cfg-7)
          )
        )
      (suspend)
      0
      )
    #f
    (label cfg-7)
    (dma-dump)
    (let ((a1-1 (new 'stack-no-clear 'array 'symbol 18)))
      (set! (-> a1-1 0) 'menu1)
      (want-sound-banks *load-state* a1-1)
      )
    (when (and *net-mgr* *should-update-stats* (nonzero? (-> *net-mgr* lobby-state connect-handle)))
      (update-computed-stats! *net-player-ladder-stats-info* (-> *medius-my-player* ladder-stats))
      (medius-start-account-stats-update #t #t)
      )
    (apply-clan-deltas)
    (when (activate-bar)
      (cam-reconnect *setting-control* (view-get-active-index) self 'mode-name 'cam-lobby 0 0.0)
      (cam-reconnect *setting-control* (view-get-active-index) self 'interp-time 'abs 0 0.0)
      )
    (let ((gp-2 *lobby-reset-mode*))
      (set! *lobby-reset-mode* #f)
      (when gp-2
        (set! (-> self local-players) *lobby-local-players*)
        (when *net-world*
          (set! (-> *num-players-info* current-num) (-> *net-world* net-state max-humans))
          (set! (-> *ai-num-players-info* current-num) (-> *net-world* net-state ai-slots))
          (let ((v1-41 (-> *net-world* net-state vehicle-class)))
            (set! (-> *vehicle-class* selection-index) (cond
                                                         ((zero? v1-41)
                                                          0
                                                          )
                                                         ((= v1-41 1)
                                                          1
                                                          )
                                                         (else
                                                           2
                                                           )
                                                         )
                  )
            )
          )
        (set! (-> self game-connection-type) (the-as uint *lobby-menu-manager-game-connection-type*))
        (if *net-mgr*
            (net-mgr-notify-connect self 15)
            )
        )
      (format 0 "***************** ~S~%" gp-2)
      (case gp-2
        (('results 'quit)
         (when (= *game-mode* 'adventure)
           (setting-pers *setting-control* 'bg-a-force (seconds 0.1) 'bg-a-force 'abs 1.0 0)
           (setting-pers *setting-control* 'bg-a-speed (seconds 1) 'bg-a-speed 'abs 1000.0 0)
           (set-setting! 'bg-a 'abs 1.0 0)
           )
         (cond
           ((zero? (-> self game-connection-type))
            (cond
              ((= *game-mode* 'adventure)
               (cond
                 ((or (kiosk?) (demo?))
                  (go-virtual adventure-init)
                  )
                 ((-> *game-info* playing-grand-prix?)
                  (go-virtual playing-grand-prix)
                  )
                 (else
                   (go-virtual lobby-results-movie)
                   )
                 )
               )
              (else
                (auto-save-command 'auto-save 0 *profile-slot* *default-pool* #f #f)
                (set! *lobby-body-parts-return-state-name* (the-as string 'choose-event-menu))
                (go-virtual lobby-results-new-body-parts-screen)
                )
              )
            )
           (else
             (auto-save-command 'auto-save 0 *profile-slot* *default-pool* #f #f)
             (cond
               ((= gp-2 'results)
                (set! *lobby-body-parts-return-state-name* (the-as string 'ready-room-state))
                (go-virtual lobby-results-new-body-parts-screen)
                )
               ((= gp-2 'quit)
                (format 0 "going to host-join-menu~%")
                (go-virtual host-join-menu)
                )
               )
             )
           )
         )
        (('net-game-disconnected)
         (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-1603))
         (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
         (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
         (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
         (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
         (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
         (go-virtual
           lobby-generic-error-menu
           *lobby-generic-confirmation*
           (lambda :behavior lobby-menu-manager () (go-virtual net-connection-error))
           (the-as (function symbol object) #f)
           #t
           #f
           #f
           )
         )
        (('lobby-anti-cheat)
         (go-virtual anti-cheat)
         )
        (('lobby-dirty-cd)
         (send-event *net-mgr* 'leave-lobby)
         (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-1603))
         (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
         (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
         (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
         (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
         (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
         (go-virtual
           lobby-generic-error-menu
           *lobby-generic-confirmation*
           (lambda :behavior lobby-menu-manager () (go-virtual net-connection-error))
           (the-as (function symbol object) #f)
           #t
           #f
           #f
           )
         )
        (('lobby-no-cd)

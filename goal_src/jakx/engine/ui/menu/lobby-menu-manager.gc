;; DECOMP BEGINS

(define *confirm-prev-state-name* (the-as object #f))

(define *thrash-level-loader* (the-as object #f))

(define *lan-crap-last-time* (the-as time-frame 0))

(defun check-lan-crap ()
  (if (not (and *net-mgr* (= (-> *net-mgr* game-type) 2)))
      (return #f)
      )
  (let ((v1-6 0))
    (dotimes (a0-1 8)
      (if (logtest? (-> *net-mgr* game-state connected-bitfield) (ash 1 a0-1))
          (+! v1-6 1)
          )
      )
    (let ((gp-0 (-> *display* real-clock frame-counter)))
      (let ((s5-0 (- gp-0 *lan-crap-last-time*))
            (f0-2 (lerp-scale 0.2 0.4 (the float v1-6) 0.0 6.0))
            )
        (if (and (< s5-0 (the int (* 300.0 f0-2))) (>= s5-0 0))
            (return #t)
            )
        )
      (set! *lan-crap-last-time* gp-0)
      )
    )
  #f
  )

(defbehavior lobby-default-post lobby-menu-manager ()
  (pulse-new-font-color)
  (update-camera)
  (seek! (-> self garage-lights) (-> self garage-lights-target) 0.06)
  (set-garage-switched! (-> self garage-lights))
  (when (and *lobby-menu-manager* (= self *lobby-menu-manager*))
    (when (nonzero? (-> self voice-id))
      (case (get-status *gui-control* (-> self voice-id))
        (((gui-status ready) (gui-status pending) (gui-status active))
         )
        (else
          (set! (-> self voice-id) (new 'static 'sound-id))
          (remove-setting! 'music-volume)
          )
        )
      )
    )
  (update-vehicle self)
  0
  (none)
  )

(defbehavior lobby-menu-manager-default-handler lobby-menu-manager ((arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (case arg2
    (('die)
     (go-virtual die)
     )
    (('die-fast)
     (go-virtual die-fast)
     )
    (('net-world-changed)
     (update-game-info-strings self)
     0
     )
    (('lobby-safe-state?)
     (lobby-safe-state?)
     )
    (('lobby-respond-to-msg)
     (let ((t9-4 lobby-respond-to-msg))
       (-> arg3 param 0)
       (-> arg3 param 1)
       (t9-4)
       )

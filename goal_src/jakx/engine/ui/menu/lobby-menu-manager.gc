(defstate die (lobby-menu-manager)
  :virtual #t
  :enter (behavior ()
    '()
    )
  :exit (behavior ()
    (set! (-> self vehicle-selected) (the-as uint -1))
    )
  :code (behavior ()
    (kill-by-type fmv-player *active-pool*)
    (format 0 "waiting for child menus to die~%")
    (suspend-for (seconds 0.5)
      (suspend)
      )
    (format 0 "done~%")
    0
    )
  :post lobby-default-post
  )


    (let ((s4-0 (-> gp-0 array-ptr (-> gp-0 selection-index) sym)))
      (dotimes (s3-0 (-> *menu-level-info-array* length))
        (when (= (-> *menu-level-info-array* s3-0 sym) s4-0)
          (set-task-node *net-world* (the-as game-task-node (-> *menu-level-info-array* s3-0 extra-int)))
          (update-human-slots this #f)
          (update-ai-slots this #f)
          (let ((s2-0 (get-open-task-node-info)))
            (kill-by-type fmv-player *active-pool*)
            (if (-> s2-0 ipu)
                (fmv-player-run-texture (-> s2-0 ipu) *default-pool*)

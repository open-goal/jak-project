  (set! (-> self menu-handle-logo-subtitle) (the-as handle #f))
  (set! (-> self in-focus-index) -1)
  (set! (-> self all-ready?) #t)
  (set! (-> self current-local-player) 0)
  (set! (-> self spawn-another?) #f)
  (set! (-> self vehicle-handle) (the-as handle #f))
  (set! (-> self vehicle-selected) (the-as uint -1))
  (set! (-> self has-driver? 0) #f)
  (set! (-> self has-driver? 1) #f)
  (set! (-> self cam-string) (new 'process 'string 512 (the-as string #f)))
  (copy-string<-string (-> self cam-string) "camera-6")
  (set! (-> self driver-was-taken?) #t)
  (set! (-> self game-visible?) #f)
  (set! (-> self psp-mode-run?) #f)
  (set! (-> self garage-lights) 0.0)
  (set! (-> self garage-lights-target) 0.0)
  (set! (-> self interpolate-camera?) #f)
  (set! (-> self override-fov) #f)
  (viewport-array-method-9 *viewport-array* 0)
  (dotimes (v1-9 8)
    (set! (-> self menu-handles v1-9) (the-as handle #f))
    )
  (set! (-> self map-proc) (the-as handle #f))
  (set! (-> self venue-map) (the-as handle #f))
  (set! (-> self local-players) 1)
  (set! (-> self game-connection-type) (the-as uint 0))
  (let ((gp-0 0))
    (dotimes (s5-0 (-> *menu-events-info-all* length))
      (mem-copy!
        (the-as pointer (-> *menu-events-info-array* array-ptr s5-0))
        (the-as pointer (-> *menu-events-info-all* s5-0))
        12
        )
      (+! gp-0 1)
      )
    (set! (-> *menu-events-info-array* array-ptr length) gp-0)
    )
  (logior! (-> self mask) (process-mask pause))
  (set! *lobby-menu-manager* self)
  (go-virtual init-state)
  )

(defun lobby-start ()
  (lobby-level-set! 0 'menu2 'display)
  (if (not *lobby-menu-manager*)
      (process-spawn lobby-menu-manager :name "lobby-menu-manager" :to *display-pool*)
      )
  0
  (none)
  )

;; WARN: Return type mismatch int vs object.
(defbehavior flash-game-started process ()
  (format 0 "... game started... suspending until lobby-menu-manager is not doing network stuff...~%")
  (while (or (and *pending-op*
                  *lobby-menu-manager*
                  (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                     (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                     )
                  )
             *net-mgr-pending-behavior-valid*
             )
    (suspend)
    )
  (format 0 "   >>> killing menu manager~%")
  (when *lobby-menu-manager*
    (set! *lobby-menu-manager-game-connection-type* (the-as int (-> *lobby-menu-manager* game-connection-type)))
    (send-event *lobby-menu-manager* 'die)
    )
  0
  )

(defmethod deactivate ((this lobby-menu-manager))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (set! *lobby-menu-manager* #f)
  (send-event (handle->process (-> this vehicle-handle)) 'go 'die)
  (dma-release 'fmv-player)
  (jukebox-onoff #f)
  ((method-of-type process deactivate) this)
  (none)
  )

;; WARN: Return type mismatch int vs object.
(defun update-lobby-camera ((arg0 camera-slave))
  (local-vars (a1-6 structure))
  (when (and *lobby-menu-manager* *interface-cam*)
    (-> *interface-cam* node-list data 4)
    (-> *interface-cam* node-list data 5)
    (let ((s4-0 (new 'stack-no-clear 'matrix)))
      (new 'stack-no-clear 'vector)
      (let ((s3-0 (new 'stack-no-clear 'vector))
            (s5-0 (entity-by-name (-> *lobby-menu-manager* cam-string)))
            )
        (when s5-0
          (set! (-> s3-0 quad) (the-as uint128 0))
          (cond
            (*garage-cinema*
              (new 'stack-no-clear 'matrix)
              (let ((s2-0 (new 'stack-no-clear 'quaternion)))
                (matrix-copy! s4-0 (-> *garage-cinema* node-list data 4 bone transform))
                (matrix->quaternion s2-0 s4-0)
                (quaternion-rotate-y! s2-0 s2-0 32768.0)
                (quaternion->matrix s4-0 s2-0)
                )
              (set! (-> s3-0 quad) (-> *garage-cinema* node-list data 4 bone transform trans quad))
              )
            ((begin
               (cam-slave-get-rot (the-as entity-actor s5-0) s4-0)
               (set! a1-6 (res-lump-struct s5-0 'trans-offset structure))
               a1-6
               )
             (vector+! s3-0 (-> s5-0 trans) (the-as vector a1-6))
             )
            (else
              (set! (-> s3-0 quad) (-> s5-0 trans quad))
              )
            )
          (cond
            ((-> *lobby-menu-manager* interpolate-camera?)
             (let ((s1-0 (new 'stack-no-clear 'quaternion)))
               (let ((s2-1 (new 'stack-no-clear 'quaternion)))
                 (vector-smooth-seek! (-> arg0 trans) s3-0 (* real-camera-seek-time (seconds-per-frame)))
                 (matrix->quaternion s2-1 s4-0)
                 (matrix->quaternion s1-0 (-> arg0 tracking inv-mat))
                 (quaternion-smooth-seek! s1-0 s1-0 s2-1 (* real-camera-seek-time (seconds-per-frame)))
                 )
               (quaternion->matrix (-> arg0 tracking inv-mat) s1-0)
               )
             )
            (else
              (set! (-> arg0 trans quad) (-> s3-0 quad))
              (set! (-> arg0 tracking inv-mat rvec quad) (-> s4-0 rvec quad))
              (set! (-> arg0 tracking inv-mat uvec quad) (-> s4-0 uvec quad))
              (set! (-> arg0 tracking inv-mat fvec quad) (-> s4-0 fvec quad))
              (set! (-> *lobby-menu-manager* interpolate-camera?) #t)
              )
            )
          (cond
            ((-> *lobby-menu-manager* override-fov)
             (format *stdebug* "OVERRIDE FOV: ~F~%" (* 0.005493164 (-> arg0 fov)))
             (format *stdebug* "fov seek ~f~%" (* real-camera-seek-time (seconds-per-frame)))
             (seek!
               (-> arg0 fov)
               (+ (if (= (-> *setting-control* user-default aspect-ratio) 'aspect16x9)
                      14563.556
                      11650.845
                      )
                  (res-lump-float s5-0 'fov-offset)
                  )
               (* 182.04445 (* real-camera-seek-time (seconds-per-frame)))
               )
             )
            ((= (-> *setting-control* user-default aspect-ratio) 'aspect16x9)
             (set! (-> arg0 fov) 14563.556)
             )
            (else
              (set! (-> arg0 fov) 11650.845)
              )
            )
          )
        )
      )
    (when (not (-> arg0 enter-has-run))
      (set! (-> arg0 saved-pt quad) (-> arg0 trans quad))
      (set! (-> arg0 blend-from-type) (camera-blend-from-type unknown-1))
      (set! (-> arg0 blend-to-type) (camera-blend-to-type unknown-0))
      0
      )
    )
  )

(defstate cam-lobby (camera-slave)
  :event cam-standard-event-handler
  :enter (behavior ()
    (when (not (-> self enter-has-run))
      (set! (-> self saved-pt quad) (-> self trans quad))
      (set! (-> self blend-from-type) (camera-blend-from-type unknown-1))
      (set! (-> self blend-to-type) (camera-blend-to-type unknown-0))
      0
      )
    )
  :code (behavior ()
    (until #f
      (update-lobby-camera self)
      (suspend)
      )
    #f
    )
  )

;; WARN: Return type mismatch int vs text-id.
(defun text-id-for-vehicle-type ((arg0 vehicle-type) (arg1 symbol))
  (dotimes (v1-0 (-> *net-vehicles* length))
    (if (= (-> *net-vehicles* v1-0 vt) arg0)
        (return (the-as text-id (if arg1
                                    (-> *net-vehicles* v1-0 id-variant)
                                    (-> *net-vehicles* v1-0 id)
                                    )
                        )
                )
        )
    )
  (the-as text-id 0)
  )

;; WARN: Return type mismatch int vs text-id.
(defun text-id-class-for-vehicle-type ((arg0 vehicle-type))
  (dotimes (v1-0 (-> *net-vehicles* length))
    (when (= (-> *net-vehicles* v1-0 vt) arg0)
      (let ((v1-4 (-> *net-vehicles* v1-0 cup-mask)))
        (return (cond
                  ((logtest? v1-4 (game-task-node-flag cup3))
                   (text-id text-id-4030)
                   )
                  ((logtest? v1-4 (game-task-node-flag cup2))
                   (text-id text-id-4029)
                   )
                  ((logtest? v1-4 (game-task-node-flag cup1))
                   (text-id text-id-4028)
                   )
                  (else
                    (text-id text-id-4033)
                    )
                  )
                )
        )
      )
    )
  (the-as text-id 4033)
  )

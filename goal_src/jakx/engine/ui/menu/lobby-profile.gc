(defstate new-load-save-profile (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('menu-selection-event)
       (case (-> block param 0)
         (('changed)
          #f
          )
         (('cancel)
          (if (kill-menu self #f #f)
              (go-virtual pre-game-type-menu)
              )
          )
         (('accept)
          (case (-> block param 1)
            (('new-profile)
             (set! (-> self profile-new-save) (the-as basic #t))
             (if (kill-menu self #f #f)
                 (go-virtual enter-profile-name)
                 )
             )
            (('load-profile)
             (set! (-> self split-selection-prev-state) 'load-profile)
             (when (kill-menu self #f #f)
               (cond
                 ((zero? (-> *progress-save-info* handle))
                  (set! (-> *profile-errors-continue* 0) (the-as uint 154))
                  (set! (-> *profile-errors-continue* 1) (the-as uint 156))
                  (set! (-> *profile-errors-continue* 2) (the-as uint 158))
                  (go-virtual no-card)
                  )
                 ((zero? (-> *progress-save-info* formatted))
                  (set! (-> *profile-errors-continue* 0) (the-as uint 155))
                  (set! (-> *profile-errors-continue* 1) (the-as uint 156))
                  (set! (-> *profile-errors-continue* 2) (the-as uint 157))
                  (go-virtual no-card)
                  )
                 ((zero? (-> *progress-save-info* inited))
                  (set! (-> *profile-errors-continue* 0) (the-as uint 157))
                  (set! (-> *profile-errors-continue* 1) (the-as uint 156))
                  (set! (-> *profile-errors-continue* 2) (the-as uint 158))
                  (go-virtual no-card)
                  )
                 (else
                   (go-virtual load-profile)
                   )
                 )
               )
             )
            (('save-profile)
             (set! (-> self split-selection-prev-state) 'select-save-profile)
             (set! (-> self profile-new-save) #f)
             (when (kill-menu self #f #f)
               (cond
                 ((zero? (-> *progress-save-info* handle))
                  (set! (-> *profile-errors-continue* 0) (the-as uint 154))
                  (set! (-> *profile-errors-continue* 1) (the-as uint 156))
                  (set! (-> *profile-errors-continue* 2) (the-as uint 158))
                  (go-virtual no-card)
                  )
                 ((zero? (-> *progress-save-info* formatted))
                  (go-virtual want-format)
                  )
                 ((zero? (-> *progress-save-info* inited))
                  (go-virtual want-create-file)
                  )
                 (else
                   (go-virtual select-save-profile)
                   )
                 )
               )
             )
            (('highscore)
             (go-virtual local-highscore-table)
             )
            )
          )
         (else
           #f
           )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (local-vars (v1-5 symbol))
    (set! (-> self profile-save-mode) (the-as basic #t))
    (kill-menu self #t #f)
    (dotimes (v1-3 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-3))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-3))) info-ptr)
                    *menu-new-load-save-profile*
                    )
                 )
        (set! v1-5 #t)
        (goto cfg-20)
        )
      )
    (set! v1-5 #f)
    (label cfg-20)
    (if v1-5
        (return #f)
        )
    (kill-menu self #t #f)
    (create-menu self *menu-new-load-save-profile* 0)
    #t
    )
  :exit (behavior ()
    (if (!= (-> self next-state name) 'pre-game-type-menu)
        (kill-logo-menu self)
        )
    )
  :trans (behavior ()
    (mc-get-slot-info 0 *progress-save-info*)
    (lmm-make-logo-menu self)
    )
  :code sleep-code
  :post lobby-default-post
  )

(define *dropdown-profile-load-save* (the-as base-menu-info #f))

(deftype dropdown-profile (dropdown-item)
  ()
  )


;; WARN: Return type mismatch object vs none.
(defmethod update-strings ((this dropdown-profile))
  (let ((t9-0 (method-of-type string-menu update-strings)))
    (t9-0 this)
    )
  (clear (-> this strings data 1 text))
  (clear (-> this strings data 2 text))
  (clear (-> this strings data 3 text))
  (let ((s5-0 (-> *progress-save-info* file (-> this info-ptr user-data))))
    (cond
      ((= (-> s5-0 present) 1)
       (if *dropdown-profile-load-save*
           (send-event this 'enabled)
           )
       (expand-text-to-charp! *common-text* (-> (clear (-> this strings data 0 text)) data) (-> s5-0 name))
       (let* ((v1-15 (-> s5-0 game-time0))
              (v1-16 (logior (shl (-> s5-0 game-time1) 32) v1-15))
              (s4-1 (/ (the-as int v1-16) #x107ac0))
              (s2-0 (/ (mod (the-as int v1-16) #x107ac0) #x4650))
              (s3-1 format)
              (s1-0 (-> this strings data 1 text))
              (s0-0 "~S")
              )
         (format (clear *temp-string*) "~2,'0D:~2,'0D" s4-1 s2-0)
         (s3-1 s1-0 s0-0 *temp-string*)
         )
       (format (-> this strings data 2 text) "~D%" (the int (-> s5-0 completion-percentage)))
       (if (logtest? (-> s5-0 secrets) 1)
           (format (clear (-> this strings data 3 text)) "~S" (lookup-text! *common-text* (text-id text-id-90) #f))
           (format (-> this strings data 3 text) "--")
           )
       )
      (else
        (if *dropdown-profile-load-save*
            (send-event this 'disabled)
            )
        (format (clear (-> this strings data 0 text)) "~S" (lookup-text! *common-text* (text-id text-id-48) #f))
        (format (-> this strings data 1 text) "--")
        (format (-> this strings data 2 text) "--")
        (format (-> this strings data 3 text) "--")
        )
      )
    )
  (none)
  )

(defmethod init-menu! ((this dropdown-profile))
  (let ((t9-0 (method-of-type dropdown-item init-menu!)))
    (t9-0 this)
    )
  (let ((a0-5 (-> *progress-save-info* file (-> this info-ptr user-data))))
    (cond
      ((= (-> a0-5 present) 1)
       (if *dropdown-profile-load-save*
           (set! (-> this enabled) #t)
           )
       )
      (else
        (if *dropdown-profile-load-save*
            (set! (-> this enabled) #f)
            )
        )
      )
    )
  0
  (none)
  )

(deftype title-load-save-profile (string-menu)
  ()
  )


;; WARN: Return type mismatch object vs none.
(defmethod update-strings ((this title-load-save-profile))
  (let ((t9-0 (method-of-type string-menu update-strings)))
    (t9-0 this)
    )
  (clear (-> this strings data 1 text))
  (format
    (clear (-> this strings data 0 text))
    (lookup-text! *common-text* (the-as text-id (-> *profile-load-save-ids* 0)) #f)
    )
  (cond
    ((= (-> *profile-load-save-ids* 0) 47)
     (cond
       ((-> *lobby-menu-manager* profile-new-save)
        (let* ((s5-1 format)
               (gp-1 (clear (-> this strings data 1 text)))
               (s4-1 "~S")
               (a0-9 *common-text*)
               (t9-6 (method-of-object a0-9 expand-text))
               (a1-2 *game-name-entered*)
               )
          (s5-1 gp-1 s4-1 (t9-6 a0-9 (the-as string a1-2)))
          )
        )
       (else
         (let* ((s5-2 format)
                (gp-2 (clear (-> this strings data 1 text)))
                (s4-2 "~S")
                (a0-12 *common-text*)
                (t9-9 (method-of-object a0-12 expand-text))
                (a1-4 (-> *game-info* save-name))
                )
           (s5-2 gp-2 s4-2 (t9-9 a0-12 a1-4))
           )
         )
       )
     )
    (else
      (format (clear (-> this strings data 0 text)) (lookup-text! *common-text* (text-id text-id-46) #f) 1)
      )
    )
  (none)
  )


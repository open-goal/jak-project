(deftype profile-error-string (string-menu)
  ()
  )


;; WARN: Return type mismatch object vs none.
(defmethod update-strings ((this profile-error-string))
  (let ((t9-0 (method-of-type string-menu update-strings)))
    (t9-0 this)
    )
  (format
    (clear (-> this strings data 0 text))
    (lookup-text! *common-text* (the-as text-id (-> *profile-errors-continue* 0)) #f)
    1
    )
  (format
    (clear (-> this strings data 1 text))
    (lookup-text! *common-text* (the-as text-id (-> *profile-errors-continue* 1)) #f)
    (-> *progress-save-info* mem-required)
    )
  (format
    (clear (-> this strings data 2 text))
    (lookup-text! *common-text* (the-as text-id (-> *profile-errors-continue* 2)) #f)
    1
    )
  (none)
  )


(defbehavior memcard-continue lobby-menu-manager ()
  (local-vars (a0-23 symbol))
  (let ((v1-0 (-> self split-selection-prev-state)))
    (cond
      ((or (= v1-0 'quote) (= v1-0 'load-profile))
       (go-virtual load-profile)
       )
      ((or (= v1-0 'quote) (= v1-0 'save-profile))
       (go-virtual save-profile)
       )
      ((or (= v1-0 'quote) (= v1-0 'select-save-profile))
       (go-virtual select-save-profile)
       )
      ((or (= v1-0 'quote) (= v1-0 'choose-account))
       (go-virtual choose-account)
       )
      ((or (= v1-0 'quote) (= v1-0 'edit-account))
       (go-virtual edit-account)
       )
      ((or (= v1-0 'quote) (= v1-0 'loading-accounts))
       (go-virtual loading-accounts)
       )
      ((or (= v1-0 'quote) (= v1-0 'saving-accounts))
       (go-virtual saving-accounts #t)
       )
      ((begin (set! a0-23 (or (= v1-0 'quote) (= v1-0 'saving-password))) a0-23)
       (go-virtual saving-password a0-23)
       )
      ((or (= v1-0 'quote) (= v1-0 'adventure-save))
       (go-virtual adventure-save)
       )
      (else
        (go-virtual new-load-profile)
        )
      )
    )
  )

(defstate no-card (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (local-vars (a0-11 symbol))
    (case message
      (('menu-selection-event)
       (case (-> block param 0)
         (('changed)
          #f
          )
         (('cancel)
          (if (kill-menu self #f #f)
              (go-profile-state)
              )
          )
         (('accept)
          (case (-> block param 1)
            (('continue)
             (when (kill-menu self #f #f)
               (let ((v1-7 (-> self split-selection-prev-state)))
                 (cond
                   ((= v1-7 'adventure-save)
                    (go-virtual adventure-save)
                    )
                   ((= v1-7 'loading-accounts)
                    (go-virtual loading-accounts)
                    )
                   ((= v1-7 'saving-accounts)
                    (go-virtual saving-accounts #t)
                    )
                   ((begin (set! a0-11 'saving-password) (= v1-7 a0-11))
                    (go-virtual saving-password a0-11)
                    )
                   (else
                     (go-profile-state)
                     )
                   )
                 )
               )
             )
            )
          )
         (else
           #f
           )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (local-vars (v1-4 symbol))
    (kill-menu self #t #f)
    (dotimes (v1-2 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-2))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-2))) info-ptr) *menu-profile-error*)
                 )
        (set! v1-4 #t)
        (goto cfg-20)
        )
      )
    (set! v1-4 #f)
    (label cfg-20)
    (if v1-4
        (return #f)
        )
    (kill-menu self #t #f)
    (create-menu self *menu-profile-error* 0)
    #t
    )
  :trans (behavior ()
    (mc-get-slot-info 0 *progress-save-info*)
    (cond
      ((zero? (-> *progress-save-info* handle))
       (cond
         ((or (= (-> self split-selection-prev-state) 'save-profile)
              (= (-> self split-selection-prev-state) 'select-save-profile)
              )
          (set! (-> *profile-errors-continue* 0) (the-as uint 154))
          (set! (-> *profile-errors-continue* 1) (the-as uint 156))
          (set! (-> *profile-errors-continue* 2) (the-as uint 158))
          )
         (else
           (set! (-> *profile-errors-continue* 0) (the-as uint 157))
           (set! (-> *profile-errors-continue* 1) (the-as uint 2905))
           (set! (-> *profile-errors-continue* 2) (the-as uint 2905))
           )
         )
       )
      ((zero? (-> *progress-save-info* formatted))
       (cond
         ((or (= (-> self split-selection-prev-state) 'save-profile)
              (= (-> self split-selection-prev-state) 'select-save-profile)
              )
          (set! (-> *profile-errors-continue* 0) (the-as uint 155))
          (set! (-> *profile-errors-continue* 1) (the-as uint 156))
          (set! (-> *profile-errors-continue* 2) (the-as uint 158))
          )
         (else
           (set! (-> *profile-errors-continue* 0) (the-as uint 157))
           (set! (-> *profile-errors-continue* 1) (the-as uint 2905))
           (set! (-> *profile-errors-continue* 2) (the-as uint 2905))
           )
         )
       (if (or (= (-> self split-selection-prev-state) 'save-profile)
               (= (-> self split-selection-prev-state) 'select-save-profile)
               )
           (go-virtual want-format)
           )
       )
      ((and (or (= (-> self split-selection-prev-state) 'save-profile)
                (= (-> self split-selection-prev-state) 'select-save-profile)
                )
            (and (< (-> *progress-save-info* mem-actual) (-> *progress-save-info* mem-required))
                 (zero? (-> *progress-save-info* inited))
                 )
            )
       (set! (-> *profile-errors-continue* 0) (the-as uint 153))
       (set! (-> *profile-errors-continue* 1) (the-as uint 156))
       (set! (-> *profile-errors-continue* 2) (the-as uint 158))
       )
      ((zero? (-> *progress-save-info* inited))
       (set! (-> *profile-errors-continue* 0) (the-as uint 157))
       (set! (-> *profile-errors-continue* 1) (the-as uint 2905))
       (set! (-> *profile-errors-continue* 2) (the-as uint 2905))
       (if (or (= (-> self split-selection-prev-state) 'save-profile)
               (= (-> self split-selection-prev-state) 'select-save-profile)
               )
           (go-virtual want-create-file)
           )
       )
      (else
        (if (kill-menu self #f #f)
            (memcard-continue)
            )
        )
      )
    )
  :code sleep-code
  :post lobby-default-post
  )


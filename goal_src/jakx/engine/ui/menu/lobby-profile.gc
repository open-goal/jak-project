    (-> *progress-save-info* mem-required)
    )
  (format
    (clear (-> this strings data 2 text))
    (lookup-text! *common-text* (the-as text-id (-> *profile-yes-no* 2)) #f)
    1
    )
  (format
    (clear (-> this strings data 3 text))
    (lookup-text! *common-text* (the-as text-id (-> *profile-yes-no* 3)) #f)
    0
    )
  (none)
  )

(deftype profile-loading-string (string-menu)

(defstate loading-profile (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (local-vars (v0-0 object))
    (case message
      (('notify)
       (case (-> block param 0)
         (('done)
          (case (-> block param 1)
            ((1)
             (set! v0-0 1)
             (set! (-> self memcard-status) (the-as uint v0-0))
             )
            (else
              (set! v0-0 2)
              (set! (-> self memcard-status) (the-as uint v0-0))
              )
            )
          v0-0
          )
         (('error)
          (case (-> block param 1)
            ((12)
             (set! (-> *profile-errors-continue* 0) (the-as uint 179))
             (set! (-> *profile-errors-continue* 1) (the-as uint 156))
             (set! (-> *profile-errors-continue* 2) (the-as uint 158))
             )
            ((11)
             (set! (-> *profile-errors-continue* 0) (the-as uint 155))
             (set! (-> *profile-errors-continue* 1) (the-as uint 156))
             (set! (-> *profile-errors-continue* 2) (the-as uint 158))
             )
            (else
              (set! (-> *profile-errors-continue* 0) (the-as uint 154))
              (set! (-> *profile-errors-continue* 1) (the-as uint 156))
              (set! (-> *profile-errors-continue* 2) (the-as uint 158))
              )
            )
          (set! v0-0 2)
          (set! (-> self memcard-status) (the-as uint v0-0))
          v0-0
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (local-vars (v1-4 symbol))
    (kill-menu self #t #f)
    (dotimes (v1-2 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-2))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-2))) info-ptr) *menu-loading-profile*)
                 )
        (set! v1-4 #t)
        (goto cfg-20)
        )
      )
    (set! v1-4 #f)
    (label cfg-20)
    (if v1-4
        (goto cfg-24)
        )
    (kill-menu self #t #f)
    (create-menu self *menu-loading-profile* 0)
    #t
    (label cfg-24)
    (set! (-> self memcard-status) (the-as uint 0))
    (auto-save-command 'restore 0 *profile-slot* self #f #f)
    )
  :trans (behavior ()
    (when (= (-> self memcard-status) 2)
      (if (kill-menu self #f #f)
          (go-virtual no-card)
          )
      )
    (when (= (-> self memcard-status) 1)
      (when (kill-menu self #f #f)
        (set! (-> self vehicle-selected) (the-as uint -1))
        (go-virtual pre-game-type-menu)
        )
      )
    )
  :code sleep-code
  :post lobby-default-post
  )

(defstate enter-profile-name (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('notify)
       (case (-> block param 0)
         (('done)
          (let ((a1-1 (-> block param 1)))
            (copy-string<-string (the-as string *game-name-entered*) (the-as string a1-1))
            )
          (go-virtual save-profile)
          )
         (('cancel)
          (go-profile-state)
          )
         )
       )
      )
    )
  :trans (behavior ()
    (mc-get-slot-info 0 *progress-save-info*)
    )
  :code (behavior ()
    (logclear! (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons right left triangle x))
    (logclear! (-> *cpad-list* cpads 0 button0-rel 0) (pad-buttons right left triangle x))
    (cpad-or-kbd-clear-func! (the-as uint 0) (pad-buttons right left triangle x))
    (let ((gp-1 (ppointer->handle (process-spawn keyboard-control 12 55 #f :name "keyboard-control" :to self))))
      (while (handle->process (the-as handle gp-1))
        (suspend)
        )
      )
    (sleep-code)
    )
  )


(defstate boot-memory-card (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('menu-selection-event)
       (case (-> block param 0)
         (('changed)
          #f
          )
         (('cancel)
          #f
          )
         (('accept)
          (case (-> block param 1)
            (('yes)
             (go-virtual new-load-profile)
             )
            (('no)
             (go-virtual boot-memory-card)
             )
            )
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (kill-menu self #t #f)
    )
  :trans (behavior ()
    (mc-get-slot-info 0 *progress-save-info*)
    )
  :code (behavior ()
    (local-vars (v1-13 symbol))
    (suspend-for (seconds 1)
      )
    (cond
      ((zero? (-> *progress-save-info* handle))
       (set! (-> *profile-yes-no* 0) (the-as uint 154))
       (set! (-> *profile-yes-no* 1) (the-as uint 156))
       (set! (-> *profile-yes-no* 2) (the-as uint 152))
       (set! (-> *profile-yes-no* 2) (the-as uint 152))
       (dotimes (v1-11 (+ (-> self in-focus-index) 1))
         (when (and (handle->process (-> self menu-handles v1-11))
                    (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-11))) info-ptr) *menu-boot-memorycard*)
                    )
           (set! v1-13 #t)
           (goto cfg-23)
           )
         )
       (set! v1-13 #f)
       (label cfg-23)
       (if v1-13
           (goto cfg-27)
           )
       (kill-menu self #t #f)
       (create-menu self *menu-boot-memorycard* 0)
       #t
       (label cfg-27)
       )
      (else
        (go-virtual new-load-profile)
        )
      )
    (until #f
      (suspend)
      )
    #f
    )
  :post lobby-default-post
  )

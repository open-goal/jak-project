(define *profile-errors-continue* (new 'static 'boxed-array :type uint32 #x9a #x9c #x9e))

(define *profile-yes-no* (new 'static 'boxed-array :type uint32 #x9a #x9c #x9e #xb59))

(define *profile-not-remove* (new 'static 'boxed-array :type uint32 #x9a #x9c #x9e))


(defstate autosave-icon (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('menu-selection-event)
       (case (-> block param 0)
         (('accept)
          (when (kill-menu self #f #f)
            (set! (-> self vehicle-selected) (the-as uint -1))
            (go-virtual pre-game-type-menu)
            )
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (local-vars (v1-4 symbol))
    (kill-menu self #t #f)
    (dotimes (v1-2 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-2))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-2))) info-ptr) *menu-profile-auto-save*)
                 )
        (set! v1-4 #t)
        (goto cfg-20)
        )
      )
    (set! v1-4 #f)
    (label cfg-20)
    (if v1-4
        (goto cfg-24)
        )
    (kill-menu self #t #f)
    (create-menu self *menu-profile-auto-save* 0)
    #t
    (label cfg-24)
    (set-time! (-> self state-time))
    )
  :trans (behavior ()
    (mc-get-slot-info 0 *progress-save-info*)
    (when (time-elapsed? (-> self state-time) (seconds 0.9))
      (let ((gp-0 (new 'stack 'hud-sprite)))
        (set-vector! (-> gp-0 color) 128 128 128 128)
        (set! (-> gp-0 pos x) 240)
        (set! (-> gp-0 pos y) 180)
        (set! (-> gp-0 pos z) #xffffff)
        (set! (-> gp-0 pos w) 0)
        (set! (-> gp-0 scale-x) 1.1)
        (set! (-> gp-0 scale-y) 1.1)
        (set! (-> gp-0 angle) 0.0)
        (set! (-> gp-0 flags) (hud-sprite-flags))
        (set! (-> gp-0 tex) (get-texture checkpoint level-default-minimap))
        (with-dma-buffer-add-bucket ((s4-0 (-> *display* frames (-> *display* on-screen) global-buf))
                                     (bucket-id hud-draw-hud-alpha)
                                     )
          (draw gp-0 s4-0 (-> self level))
          )
        )
      )
    )
  :code sleep-code
  :post lobby-default-post
  )


(defstate new-load-profile (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('menu-selection-event)
       (case (-> block param 0)
         (('changed)
          #f
          )
         (('cancel)
          #f
          )
         (('accept)
          (case (-> block param 1)
            (('new-profile)
             (set! (-> self profile-new-save) (the-as basic #t))
             (if (kill-menu self #f #f)
                 (go-virtual enter-profile-name)
                 )
             )
            (('load-profile)
             (set! (-> self split-selection-prev-state) 'load-profile)
             (when (kill-menu self #f #f)
               (cond
                 ((zero? (-> *progress-save-info* handle))
                  (set! (-> *profile-errors-continue* 0) (the-as uint 154))
                  (set! (-> *profile-errors-continue* 1) (the-as uint 156))
                  (set! (-> *profile-errors-continue* 2) (the-as uint 158))
                  (go-virtual no-card)
                  )
                 ((zero? (-> *progress-save-info* formatted))
                  (set! (-> *profile-errors-continue* 0) (the-as uint 155))
                  (set! (-> *profile-errors-continue* 1) (the-as uint 156))
                  (set! (-> *profile-errors-continue* 2) (the-as uint 158))
                  (go-virtual no-card)
                  )
                 ((zero? (-> *progress-save-info* inited))
                  (set! (-> *profile-errors-continue* 0) (the-as uint 157))
                  (set! (-> *profile-errors-continue* 1) (the-as uint 156))
                  (set! (-> *profile-errors-continue* 2) (the-as uint 158))
                  (go-virtual no-card)
                  )
                 (else
                   (go-virtual load-profile)
                   )
                 )
               )
             )
            )
          )
         (else
           #f
           )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (local-vars (v1-4 symbol))
    (set! (-> self profile-save-mode) #f)
    (kill-menu self #t #f)
    (dotimes (v1-2 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-2))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-2))) info-ptr) *menu-new-load-profile*)
                 )
        (set! v1-4 #t)
        (goto cfg-20)
        )
      )
    (set! v1-4 #f)
    (label cfg-20)
    (if v1-4
        (return #f)
        )
    (kill-menu self #t #f)
    (create-menu self *menu-new-load-profile* 0)
    #t
    )
  :exit (behavior ()
    (kill-logo-menu self)
    )
  :trans (behavior ()
    (lmm-make-logo-menu self)
    (mc-get-slot-info 0 *progress-save-info*)
    )
  :code sleep-code
  :post lobby-default-post
  )


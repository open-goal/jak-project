(defbehavior go-profile-state lobby-menu-manager ()
  (when (and (= (-> self split-selection-prev-state) 'saving-password)
             (nonzero? (-> *net-mgr* lobby-state connect-handle))
             )
    (set! (-> self split-selection-prev-state) #f)
    (go-virtual lobby-main-screen)
    (return #f)
    )
  (when (= (-> self split-selection-prev-state) 'saving-accounts)
    (go-virtual choose-account)
    (return #f)
    )
  (when (= (-> self split-selection-prev-state) 'waiting-network-config-list)
    (set! (-> self split-selection-prev-state) #f)
    (go-virtual pre-game-type-menu)
    (return #f)
    )
  (if *net-hw-initted*
      (process-spawn-function process hack-reset-state #t)
      )
  (if (-> self profile-save-mode)
      (go-virtual new-load-save-profile)
      (go-virtual new-load-profile)
      )
  )

(defstate load-profile (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('menu-selection-event)
       (case (-> block param 0)
         (('changed)
          #f
          )
         (('cancel)
          (if (kill-menu self #f #f)
              (go-profile-state)
              )
          )
         (('accept)
          (set! *profile-slot* (the-as int (-> block param 2)))
          (if (kill-menu self #f #f)
              (go-virtual loading-profile)
              )
          )
         (else
           #f
           )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (local-vars (v1-8 symbol))
    (set! (-> self split-selection-prev-state) (-> self state name))
    (kill-menu self #t #f)
    (set! *dropdown-profile-load-save* (the-as base-menu-info #t))
    (set! (-> *profile-load-save-ids* 0) (the-as uint 46))
    (dotimes (v1-6 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-6))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-6))) info-ptr) *menu-load-profile*)
                 )
        (set! v1-8 #t)
        (goto cfg-20)
        )
      )
    (set! v1-8 #f)
    (label cfg-20)
    (if v1-8
        (return #f)
        )
    (kill-menu self #t #f)
    (create-menu self *menu-load-profile* 0)
    #t
    )
  :trans (behavior ()
    (mc-get-slot-info 0 *progress-save-info*)
    (when (zero? (-> *progress-save-info* handle))
      (set! (-> *profile-errors-continue* 0) (the-as uint 154))
      (set! (-> *profile-errors-continue* 1) (the-as uint 48))
      (set! (-> *profile-errors-continue* 2) (the-as uint 48))
      (go-virtual no-card)
      )
    (when (cpad-pressed? 0 triangle)
      (when (kill-menu self #f #f)
        (logclear! (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons triangle))
        (logclear! (-> *cpad-list* cpads 0 button0-rel 0) (pad-buttons triangle))
        (go-profile-state)
        )
      )
    )
  :code sleep-code
  :post lobby-default-post
  )

(defstate select-save-profile (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('menu-selection-event)
       (case (-> block param 0)
         (('changed)
          #f
          )
         (('cancel)
          (when (kill-menu self #f #f)
            (if (-> self profile-save-mode)
                (go-virtual new-load-save-profile)
                (go-virtual new-load-profile)
                )
            )
          )
         (('accept)
          (when (kill-menu self #f #f)
            (set! *profile-slot* (the-as int (-> block param 2)))
            (let ((a0-8 (-> *progress-save-info* file *profile-slot*)))
              (if (= (-> a0-8 present) 1)
                  (go-virtual overwrite-profile)
                  (go-virtual saving-profile)
                  )
              )
            )
          )
         (else
           #f
           )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (local-vars (v1-7 symbol))
    (set! (-> self split-selection-prev-state) (-> self state name))
    (kill-menu self #t #f)
    (set! *dropdown-profile-load-save* #f)
    (set! (-> *profile-load-save-ids* 0) (the-as uint 47))
    (dotimes (v1-5 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-5))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-5))) info-ptr) *menu-load-profile*)
                 )
        (set! v1-7 #t)
        (goto cfg-20)
        )
      )
    (set! v1-7 #f)
    (label cfg-20)
    (if v1-7
        (return #f)
        )
    (kill-menu self #t #f)
    (create-menu self *menu-load-profile* 0)
    #t
    )
  :trans (behavior ()
    (mc-get-slot-info 0 *progress-save-info*)
    (when (zero? (-> *progress-save-info* handle))
      (set! (-> *profile-errors-continue* 0) (the-as uint 154))
      (set! (-> *profile-errors-continue* 1) (the-as uint 48))
      (set! (-> *profile-errors-continue* 2) (the-as uint 48))
      (go-virtual no-card)
      )
    )
  :code sleep-code
  :post lobby-default-post
  )


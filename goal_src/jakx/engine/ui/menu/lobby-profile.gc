(defstate save-profile (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('menu-selection-event)
       (case (-> block param 0)
         (('changed)
          #f
          )
         (('cancel)
          (if (kill-menu self #f #f)
              (go-profile-state)
              )
          )
         (('accept)
          (case (-> block param 1)
            (('yes)
             (set! (-> *lobby-menu-manager* split-selection-prev-state) 'select-save-profile)
             (when (kill-menu self #f #f)
               (cond
                 ((zero? (-> *progress-save-info* handle))
                  (go-virtual no-card)
                  )
                 ((zero? (-> *progress-save-info* formatted))
                  (go-virtual want-format)
                  )
                 ((zero? (-> *progress-save-info* inited))
                  (go-virtual want-create-file)
                  )
                 (else
                   (go-virtual select-save-profile)
                   )
                 )
               )
             )
            (('no)
             (when (kill-menu self #f #f)
               (set! (-> self vehicle-selected) (the-as uint -1))
               (reset
                 *game-info*
                 'new-game
                 (the-as game-save #f)
                 (the-as continue-point #f)
                 (logtest? (-> *game-info* secrets) (game-secrets hero-mode))
                 )
               (copy-string<-string (-> *game-info* save-name) (the-as string *game-name-entered*))
               (go-virtual pre-game-type-menu)
               )
             )
            )
          )
         (else
           #f
           )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (local-vars (v1-6 symbol))
    (set! (-> self split-selection-prev-state) (-> self state name))
    (kill-menu self #t #f)
    (dotimes (v1-4 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-4))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-4))) info-ptr) *menu-save-profile*)
                 )
        (set! v1-6 #t)
        (goto cfg-20)
        )
      )
    (set! v1-6 #f)
    (label cfg-20)
    (if v1-6
        (return #f)
        )
    (kill-menu self #t #f)
    (create-menu self *menu-save-profile* 0)
    #t
    )
  :trans (behavior ()
    (mc-get-slot-info 0 *progress-save-info*)
    )
  :code sleep-code
  :post lobby-default-post
  )


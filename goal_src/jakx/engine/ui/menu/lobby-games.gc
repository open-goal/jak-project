(deftype game-info-menu (string-menu)
  ((game  net-available-game)
   )
  (:methods
    (set-game! (_type_ net-available-game) none)
    )
  )


(defmethod set-game! ((this game-info-menu) (arg0 net-available-game))
  (set! (-> this game) arg0)
  0
  (none)
  )

;; WARN: Return type mismatch int vs object.
(defun set-cstring-from-text-id ((arg0 (pointer uint8)) (arg1 text-id))
  (copy-charp<-charp arg0 (-> (lookup-text! *common-text* arg1 #f) data))
  0
  )

;; WARN: Function (method 67 game-info-menu) has a return type of none, but the expression builder found a return statement.
(defmethod update-strings ((this game-info-menu))
  (let ((s5-0 (-> this game))
        (gp-0 (-> this strings))
        )
    0
    (dotimes (s3-0 (-> this strings length))
      (clear (-> this strings data s3-0 text))
      )
    (if (not (and (nonzero? s5-0) s5-0))
        (return #f)
        )
    (let ((s5-1 (-> s5-0 info)))
      (-> *game-info* play-list (-> *game-info* sub-task-list (-> s5-1 task-node) task))
      (if (not (and (nonzero? s5-1) s5-1))
          (return #f)
          )
      (construct-game-name (-> gp-0 data 0 text data) (-> s5-1 game-name))
      (set-cstring-from-text-id (-> gp-0 data 1 text data) (text-id text-id-1859))
      (set-cstring-from-text-id (-> gp-0 data 2 text data) (-> *task-level-info* (-> s5-1 location) text-id))
      (set-cstring-from-text-id (-> gp-0 data 3 text data) (text-id text-id-1860))
      (set-cstring-from-text-id (-> gp-0 data 4 text data) (-> *net-play-mode-text-ids* (-> s5-1 event)))
      )
    (set-cstring-from-text-id (-> gp-0 data 5 text data) (text-id text-id-1861))
    (set-cstring-from-text-id (-> gp-0 data 6 text data) (if (-> *medius-game-info-game* 17)
                                                             (text-id text-id-1862)
                                                             (text-id text-id-1863)
                                                             )
                              )
    )
  0
  (none)
  )

(defmethod default-event-handler ((this game-info-menu) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (case arg2
    (('update-strings)
     (set-game! this (the-as net-available-game (-> arg3 param 0)))
     )
    (else
      (call-parent-method this arg0 arg1 arg2 arg3)
      )
    )
  )


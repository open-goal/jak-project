;; WARN: Return type mismatch int vs object.
(defbehavior refresh-games-lan-or-internet lobby-menu-manager ()
  (local-vars (v1-15 object) (v1-39 object))
  (case (-> self game-connection-type)
    ((2)
     (let ((gp-0 (new 'static 'medius-game-filter-settings)))
       (set! (-> gp-0 burn-version-and-flags) -1)
       (set! (-> gp-0 event) -1)
       (set! (-> gp-0 location) -1)
       (set! (-> gp-0 world) -1)
       (set! (-> gp-0 max-players) -1)
       (set! (-> gp-0 class-type) -1)
       (cond
         (*net-mgr-pending-behavior-valid*
           )
         (else
           (until v1-15
             (suspend)
             (set! v1-15 (or (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'lobby-idle))
                             (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'playing-game))
                             )
                   )
             )
           (set! *net-mgr-pending-behavior-result* 'undefined)
           (send-event *net-mgr* 'do-behavior 'set-filter-state gp-0)
           (while (= *net-mgr-pending-behavior-result* 'undefined)
             (suspend)
             )
           (suspend)
           *net-mgr-pending-behavior-result*
           )
         )
       )
     (cond
       (*net-mgr-pending-behavior-valid*
         )
       (else
         (until v1-39
           (suspend)
           (set! v1-39 (or (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'lobby-idle))
                           (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'playing-game))
                           )
                 )
           )
         (set! *net-mgr-pending-behavior-result* 'undefined)
         (send-event *net-mgr* 'do-behavior 'get-game-list *medius-games* #f)
         (while (= *net-mgr-pending-behavior-result* 'undefined)
           (suspend)
           )
         (suspend)
         *net-mgr-pending-behavior-result*
         )
       )
     )
    (else
      (format 0 "lan games...~%")
      (send-event *net-mgr* 'refresh-lan-games)
      )
    )
  0
  )

(defstate e3-join-game-menu (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (local-vars (v0-3 object))
    (case message
      (('game-list-ready)
       (set! (-> *medius-games* ct) *net-available-game-ct*)
       (dotimes (gp-0 *net-available-game-ct*)
         (mem-copy!
           (the-as pointer (-> *medius-games* data gp-0))
           (the-as pointer (-> *net-available-games* gp-0))
           328
           )
         )
       (let ((a0-6 (as-type (find-menu self 'game-list) scrolling-menu-game)))
         (if a0-6
             (send-event a0-6 'update)
             )
         )
       )
      (('menu-selection-event)
       (if (and *pending-op*
                *lobby-menu-manager*
                (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                   (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                   )
                )
           (return #f)
           )
       (case (-> block param 0)
         (('cancel)
          (if (kill-menu self #f #f)
              (go-virtual host-join-menu)
              )
          )
         (('accept)
          (let ((gp-2 (-> block param 2)))
            (when (and (>= (the-as int gp-2) 0) (< (the-as int gp-2) (-> *medius-games* ct)))
              (when (kill-menu self #f #f)
                (case (-> self game-connection-type)
                  ((2)
                   (set! (-> *net-available-games* 0 medius-world-id) (-> *medius-games* data (the-as int gp-2) medius-world-id))
                   (when (not (and *pending-op*
                                   *lobby-menu-manager*
                                   (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                                      (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                                      )
                                   )
                              )
                     (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
                     (set! v0-3
                           (lambda :behavior lobby-menu-manager () (send-event *net-mgr* 'join-game 0) (go-virtual join-wait))
                           )
                     (set! *pending-op* (the-as (function object object object object object object object object object)
                                          (the-as (function object :behavior lobby-menu-manager) v0-3)
                                          )
                           )
                     v0-3
                     )
                   )
                  (else
                    (when (not (and *pending-op*
                                    *lobby-menu-manager*
                                    (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                                       (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                                       )
                                    )
                               )
                      (set! (-> *pending-op-args* 0) (the-as int gp-2))
                      (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
                      (set! v0-3 (lambda :behavior lobby-menu-manager
                                   ((arg0 object))
                                   (local-vars (v1-2 object))
                                   (until v1-2
                                     (suspend)
                                     (set! v1-2 (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'idle)))
                                     )
                                   (send-event *net-mgr* 'connect-lan-game arg0)
                                   (go-virtual join-wait)
                                   )
                            )
                      (set! *pending-op* (the-as (function object object object object object object object object object)
                                           (the-as (function object object :behavior lobby-menu-manager) v0-3)
                                           )
                            )
                      v0-3
                      )
                    )
                  )
                )
              )
            )
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :code (behavior ()
    (local-vars (v1-4 symbol))
    (set! (-> *medius-games* ct) 0)
    (set! *game-menu-array-to-use* *medius-games*)
    (dotimes (v1-2 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-2))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-2))) info-ptr) *e3-join-game-menu-screen*)
                 )
        (set! v1-4 #t)
        (goto cfg-20)
        )
      )
    (set! v1-4 #f)
    (label cfg-20)
    (if v1-4
        (goto cfg-24)
        )
    (kill-menu self #t #f)
    (create-menu self *e3-join-game-menu-screen* 0)
    #t
    (label cfg-24)
    (refresh-games-lan-or-internet)
    (let ((a0-19 (as-type (find-menu self 'game-list) scrolling-menu-game)))
      (when a0-19
        (set! (-> a0-19 prev-id) (-> *medius-games* data 0 medius-world-id))
        (send-event a0-19 'update)
        )
      )
    (until #f
      (suspend-for (seconds 10)
        (suspend)
        (do-pending-operation)
        )
      (refresh-games-lan-or-internet)
      (let ((a0-22 (as-type (find-menu self 'game-list) scrolling-menu-game)))
        (if a0-22
            (send-event a0-22 'update)
            )
        )
      )
    #f
    )
  )


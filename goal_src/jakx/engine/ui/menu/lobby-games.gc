(defstate game-info-screen (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (local-vars (v0-0 object))
    (case message
      (('menu-selection-event)
       (if (and *pending-op*
                *lobby-menu-manager*
                (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                   (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                   )
                )
           (return #f)
           )
       (case (-> block param 0)
         (('accept)
          (case (-> block param 1)
            (('players)
             (send-event (find-menu self 'player-list) 'selected)
             (send-event (find-menu self 'manager) 'enable #f)
             )
            (('player-list)
             (mem-copy!
               (the-as pointer *player-info-player*)
               (the-as pointer (-> *player-menu-array-to-use* data (-> block param 2)))
               4
               )
             (when (not (and *pending-op*
                             *lobby-menu-manager*
                             (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                                (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                                )
                             )
                        )
               (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
               (set! v0-0 (lambda :behavior lobby-menu-manager () (go-virtual player-info-screen)))
               (set! *pending-op* (the-as (function object object object object object object object object object)
                                    (the-as (function object :behavior lobby-menu-manager) v0-0)
                                    )
                     )
               v0-0
               )
             )
            (('join-game)
             (set! (-> *net-available-games* 0 medius-world-id) *medius-game-info-id*)
             (when (not (and *pending-op*
                             *lobby-menu-manager*
                             (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                                (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                                )
                             )
                        )
               (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
               (set! v0-0 (lambda :behavior lobby-menu-manager
                            ()
                            (kill-menu self #t #f)
                            (send-event *net-mgr* 'join-game 0)
                            (go-virtual join-wait)
                            )
                     )
               (set! *pending-op* (the-as (function object object object object object object object object object)
                                    (the-as (function object :behavior lobby-menu-manager) v0-0)
                                    )
                     )
               v0-0
               )
             )
            )
          )
         (('cancel)
          (case (-> block param 1)
            (('player-list)
             (send-event (find-menu self 'player-list) 'deselected)
             (send-event (find-menu self 'manager) 'enable #t)
             )
            (else
              (let ((v1-46 *prev-create-menu-state-name*))
                (set! *prev-create-menu-state-name* #f)
                (set! *this-create-menu-state-name* #f)
                (cond
                  ((= v1-46 'chat-room)
                   (go-virtual chat-room)
                   )
                  ((= v1-46 'game-search-screen)
                   (go-virtual game-search-screen)
                   )
                  ((= v1-46 'do-quickplay)
                   (go-virtual do-quickplay)
                   )
                  (else
                    (when (not (and *pending-op*
                                    *lobby-menu-manager*
                                    (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                                       (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                                       )
                                    )
                               )
                      (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
                      (set! v0-0 (lambda :behavior lobby-menu-manager () (go-virtual lobby-main-screen)))
                      (set! *pending-op* (the-as (function object object object object object object object object object)
                                           (the-as (function object :behavior lobby-menu-manager) v0-0)
                                           )
                            )
                      v0-0
                      )
                    )
                  )
                )
              )
            )
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (local-vars (v1-8 symbol))
    (set! *last-state-name-game-info-screen* #f)
    (if (= *last-menu-action* 'accept)
        (set! *last-state-name-game-info-screen* (-> self prev-state name))
        (set! *last-state-name-game-info-screen* #f)
        )
    (set! *game-launched-from-room* (= *last-state-name-game-info-screen* 'chat-room))
    (mem-clear! *medius-game-info-game* 328)
    (set! *player-menu-array-to-use* *medius-in-game-players*)
    (dotimes (v1-6 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-6))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-6))) info-ptr) *game-info-screen*)
                 )
        (set! v1-8 #t)
        (goto cfg-23)
        )
      )
    (set! v1-8 #f)
    (label cfg-23)
    (if v1-8
        (goto cfg-27)
        )
    (kill-menu self #t #f)
    (create-menu self *game-info-screen* 0)
    #t
    (label cfg-27)
    (send-event (find-menu self 'player-list) 'deselected)
    (send-event (find-menu self 'players) 'disabled)
    )
  :code (behavior ()
    (local-vars (v1-8 object))
    (until #f
      (if (not (cond
                 (*net-mgr-pending-behavior-valid*
                   #f
                   )
                 (else
                   (until v1-8
                     (suspend)
                     (set! v1-8 (or (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'lobby-idle))
                                    (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'playing-game))
                                    )
                           )
                     )
                   (set! *net-mgr-pending-behavior-result* 'undefined)
                   (send-event *net-mgr* 'do-behavior 'refresh-game-info *medius-game-info-id* *medius-game-info-game*)
                   (while (= *net-mgr-pending-behavior-result* 'undefined)
                     (suspend)
                     )
                   (suspend)
                   *net-mgr-pending-behavior-result*
                   )
                 )
               )
          (go-virtual lobby-main-screen)
          )
      (send-event (find-menu self 'player-list) 'update)
      (send-event (find-menu self 'game-info) 'update-strings *medius-game-info-game*)
      (cond
        ((zero? (-> *medius-in-game-players* ct))
         (send-event (find-menu self 'player-list) 'deselected)
         (send-event (find-menu self 'manager) 'enable #t)
         (send-event (find-menu self 'players) 'disabled)
         )
        (else
          (send-event (find-menu self 'players) 'enabled)
          )
        )
      (suspend-for (seconds 15)
        (do-pending-operation)
        )
      (suspend)
      )
    #f
    )
  )


(defstate set-game-name (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('notify)
       (case (-> block param 0)
         (('done)
          (copy-string<-string *tmp-game-name* (the-as string (-> block param 1)))
          (send-event *net-mgr* 'create-game)
          (go-virtual host-wait)
          )
         (else
           (go-virtual lobby-main-screen)
           )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    '()
    )
  :exit (behavior ()
    (kill-keyboard-control)
    )
  :code (behavior ()
    (local-vars (v1-2 symbol))
    (dotimes (v1-0 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-0))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-0))) info-ptr) *set-game-name*)
                 )
        (set! v1-2 #t)
        (goto cfg-20)
        )
      )
    (set! v1-2 #f)
    (label cfg-20)
    (if v1-2
        (goto cfg-24)
        )
    (kill-menu self #t #f)
    (create-menu self *set-game-name* 0)
    #t
    (label cfg-24)
    (keyboard-control-spawn 14 self (keyboard-control-flag allow-space) (-> *medius-account-name* data))
    (sleep-code)
    )
  )

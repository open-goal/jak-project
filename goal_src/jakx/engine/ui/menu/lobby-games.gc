(defstate game-search-screen (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (local-vars (v0-0 object))
    (case message
      (('menu-selection-event)
       (if (and *pending-op*
                *lobby-menu-manager*
                (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                   (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                   )
                )
           (return #f)
           )
       (case (-> block param 0)
         (('event)
          (case (-> block param 1)
            (('next)
             (next-selection self *menu-events-filter-array*)
             )
            (('previous)
             (prev-selection self *menu-events-filter-array*)
             )
            )
          (init-location-filter-array
            (-> *menu-events-filter-array* array-ptr (-> *menu-events-filter-array* selection-index) extra-int)
            )
          )
         (('location)
          (case (-> block param 1)
            (('next)
             (next-selection self *menu-locations-filter-array*)
             )
            (('previous)
             (prev-selection self *menu-locations-filter-array*)
             )
            )
          )
         (('class)
          (case (-> block param 1)
            (('next)
             (next-selection self *menu-class-filter-array*)
             )
            (('previous)
             (prev-selection self *menu-class-filter-array*)
             )
            )
          )
         (('max-players)
          (case (-> block param 1)
            (('next)
             (set! v0-0 (max (min 6 (+ (-> *menu-max-players-filter* base-val) 1)) (-> *menu-max-players-filter* field)))
             (set! (-> *menu-max-players-filter* base-val) (the-as int v0-0))
             v0-0
             )
            (('previous)
             (set! v0-0 (max (min 6 (+ (-> *menu-max-players-filter* base-val) -1)) (-> *menu-max-players-filter* field)))
             (set! (-> *menu-max-players-filter* base-val) (the-as int v0-0))
             v0-0
             )
            )
          )
         (('car-mode)
          (case (-> block param 1)
            (('next)
             (next-selection self *vehicle-class-search*)
             )
            (('previous)
             (prev-selection self *vehicle-class-search*)
             )
            )
          )
         (('accept)
          (case (-> block param 1)
            (('search)
             (when (not (and *pending-op*
                             *lobby-menu-manager*
                             (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                                (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                                )
                             )
                        )
               (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
               (set! v0-0
                     (lambda :behavior lobby-menu-manager
                       ()
                       (local-vars (v1-30 object) (v1-54 object))
                       (let ((gp-0 (new 'static 'medius-game-filter-settings)))
                         (set! (-> gp-0 burn-version-and-flags) -1)
                         (set! (-> gp-0 event)
                               (-> *menu-events-filter-array* array-ptr (-> *menu-events-filter-array* selection-index) extra-int)
                               )
                         (set! (-> gp-0 location)
                               (-> *menu-locations-filter-array* array-ptr (-> *menu-locations-filter-array* selection-index) extra-int)
                               )
                         (set! (-> gp-0 world) -1)
                         (set! (-> gp-0 max-players) (-> *menu-max-players-filter* base-val))
                         (set! (-> gp-0 class-type)
                               (-> *vehicle-class-search* array-ptr (-> *vehicle-class-search* selection-index) extra-int)
                               )
                         (cond
                           (*net-mgr-pending-behavior-valid*
                             )
                           (else
                             (until v1-30
                               (suspend)
                               (set! v1-30 (or (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'lobby-idle))
                                               (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'playing-game))
                                               )
                                     )
                               )
                             (set! *net-mgr-pending-behavior-result* 'undefined)
                             (send-event *net-mgr* 'do-behavior 'set-filter-state gp-0)
                             (while (= *net-mgr-pending-behavior-result* 'undefined)
                               (suspend)
                               )
                             (suspend)
                             *net-mgr-pending-behavior-result*
                             )
                           )
                         )
                       (cond
                         (*net-mgr-pending-behavior-valid*
                           )
                         (else
                           (until v1-54
                             (suspend)
                             (set! v1-54 (or (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'lobby-idle))
                                             (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'playing-game))
                                             )
                                   )
                             )
                           (set! *net-mgr-pending-behavior-result* 'undefined)
                           (send-event *net-mgr* 'do-behavior 'get-game-list *medius-games* #t)
                           (while (= *net-mgr-pending-behavior-result* 'undefined)
                             (suspend)
                             )
                           (suspend)
                           *net-mgr-pending-behavior-result*
                           )
                         )
                       (send-event (find-menu self 'game-list) 'update)
                       (cond
                         ((> (-> *medius-games* ct) 0)
                          (send-event (find-menu self 'game-list) 'selected)
                          (send-event (find-menu self 'manager) 'enable #f)
                          )
                         (else
                           (send-event (find-menu self 'game-list) 'deselected)
                           (send-event (find-menu self 'manager) 'enable #t)
                           (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-2343))
                           (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
                           (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
                           (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
                           (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
                           (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
                           (go-virtual
                             lobby-generic-error-menu
                             *lobby-generic-confirmation*
                             (lambda :behavior lobby-menu-manager () (go-virtual game-search-screen))
                             (the-as (function symbol object) #f)
                             #t
                             #f
                             #f
                             )
                           )
                         )
                       )
                     )
               (set! *pending-op* (the-as (function object object object object object object object object object)
                                    (the-as (function object :behavior lobby-menu-manager) v0-0)
                                    )
                     )
               v0-0
               )
             )
            (('reset-all)
             (set! (-> *menu-events-filter-array* selection-index) 0)
             (set! (-> *menu-locations-filter-array* selection-index) 0)
             (set! (-> *menu-class-filter-array* selection-index) 0)
             (set! (-> *menu-max-players-filter* base-val) 6)
             (set! (-> *vehicle-class-search* selection-index) 0)
             0
             )
            (('game-list)
             (set! *medius-game-info-id* (-> *medius-games* data (the-as int (-> block param 2)) medius-world-id))
             (when (not (and *pending-op*
                             *lobby-menu-manager*
                             (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                                (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                                )
                             )
                        )
               (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
               (set! v0-0 (lambda :behavior lobby-menu-manager () (go-virtual game-info-screen)))
               (set! *pending-op* (the-as (function object object object object object object object object object)
                                    (the-as (function object :behavior lobby-menu-manager) v0-0)
                                    )
                     )
               v0-0
               )
             )
            (else
              #f
              )
            )
          )
         (('cancel)
          (case (-> block param 1)
            (('game-list)
             (send-event (find-menu self 'game-list) 'deselected)
             (send-event (find-menu self 'manager) 'enable #t)
             (set! (-> *game-menu-array-to-use* ct) 0)
             (send-event (find-menu self 'game-list) 'update)
             )
            (else
              (case *last-state-name-game-info-screen*
                (('chat-room)
                 (when (not (and *pending-op*
                                 *lobby-menu-manager*
                                 (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                                    (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                                    )
                                 )
                            )
                   (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
                   (set! v0-0 (lambda :behavior lobby-menu-manager () (go-virtual chat-room)))
                   (set! *pending-op* (the-as (function object object object object object object object object object)
                                        (the-as (function object :behavior lobby-menu-manager) v0-0)
                                        )
                         )
                   v0-0
                   )
                 )
                (else
                  (when (not (and *pending-op*
                                  *lobby-menu-manager*
                                  (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                                     (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                                     )
                                  )
                             )
                    (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
                    (set! v0-0 (lambda :behavior lobby-menu-manager () (go-virtual lobby-main-screen)))
                    (set! *pending-op* (the-as (function object object object object object object object object object)
                                         (the-as (function object :behavior lobby-menu-manager) v0-0)
                                         )
                          )
                    v0-0
                    )
                  )
                )
              )
            )
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (local-vars (v1-3 symbol) (v1-7 symbol))
    (set! *game-menu-array-to-use* *medius-games*)
    (dotimes (v1-1 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-1))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-1))) info-ptr) *game-search-screen*)
                 )
        (set! v1-3 #t)
        (goto cfg-20)
        )
      )
    (set! v1-3 #f)
    (label cfg-20)
    (when v1-3
      (set! v1-7 #f)
      (goto cfg-24)
      )
    (kill-menu self #t #f)
    (create-menu self *game-search-screen* 0)
    (set! v1-7 #t)
    (label cfg-24)
    (when v1-7
      (cond
        ((= (-> self prev-state name) 'game-info-screen)
         (send-event (find-menu self 'game-list) 'selected)
         (send-event (find-menu self 'manager) 'enable #f)
         )
        (else
          (set! (-> *game-menu-array-to-use* ct) 0)
          (send-event (find-menu self 'game-list) 'deselected)
          (send-event (find-menu self 'manager) 'enable #t)
          (select-by-sym (the-as selection-menu-manager (find-menu self 'manager)) 'search)
          )
        )
      )
    (send-event (find-menu self 'game-list) 'update)
    (init-location-filter-array
      (-> *menu-events-filter-array* array-ptr (-> *menu-events-filter-array* selection-index) extra-int)
      )
    )
  :code (behavior ()
    (until #f
      (do-pending-operation)
      (suspend)
      )
    #f
    )
  :post lobby-default-post
  )


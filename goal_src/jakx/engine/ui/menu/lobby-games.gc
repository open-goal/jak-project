    (set! (-> *menu-locations-filter-array* array-ptr length) *menu-locations-filter-ct*)
    (set! (-> *menu-locations-filter-array* selection-index) 0)
    (dotimes (s5-1 (length (-> *menu-locations-filter-array* array-ptr)))
      (if (= (-> *menu-locations-filter-array* array-ptr s5-1 extra-int) gp-0)
          (set! (-> *menu-locations-filter-array* selection-index) s5-1)

              (let ((a1-7 (-> *menu-locations-filter-array* array-ptr *menu-locations-filter-ct*)))
                (set! (-> a1-7 extra-int) (the-as int (-> a3-5 task-level)))
                (set! (-> a1-7 display-name-id) (-> *task-level-info* (-> a3-5 task-level) text-id))

(defstate do-quickplay (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (local-vars (v0-0 object))
    (case message
      (('menu-selection-event)
       (if (and *pending-op*
                *lobby-menu-manager*
                (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                   (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                   )
                )
           (return #f)
           )
       (case (-> block param 0)
         (('cancel)
          (when (not (and *pending-op*
                          *lobby-menu-manager*
                          (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                             (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                             )
                          )
                     )
            (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
            (set! v0-0 (lambda :behavior lobby-menu-manager () (go-virtual lobby-main-screen)))
            (set! *pending-op* (the-as (function object object object object object object object object object)
                                 (the-as (function object :behavior lobby-menu-manager) v0-0)
                                 )
                  )
            v0-0
            )
          )
         (('accept)
          (let* ((v1-16 (-> block param 1))
                 (v1-17 (if (= v1-16 'racing)
                            0
                            4
                            )
                        )
                 )
            (when (not (and *pending-op*
                            (and *lobby-menu-manager*
                                 (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                                    (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                                    )
                                 )
                            )
                       )
              (set! (-> *pending-op-args* 0) v1-17)
              (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
              (set! v0-0
                    (lambda :behavior lobby-menu-manager
                      ((arg0 medius-game-array))
                      (local-vars (v1-13 object) (v1-37 object))
                      (let ((gp-0 (new 'static 'medius-game-filter-settings)))
                        (set! (-> gp-0 burn-version-and-flags) 15)
                        (set! (-> gp-0 event) (the-as int arg0))
                        (set! (-> gp-0 location) -1)
                        (set! (-> gp-0 world) -1)
                        (set! (-> gp-0 max-players) 6)
                        (set! (-> gp-0 class-type) -1)
                        (cond
                          (*net-mgr-pending-behavior-valid*
                            )
                          (else
                            (until v1-13
                              (suspend)
                              (set! v1-13 (or (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'lobby-idle))
                                              (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'playing-game))
                                              )
                                    )
                              )
                            (set! *net-mgr-pending-behavior-result* 'undefined)
                            (send-event *net-mgr* 'do-behavior 'set-filter-state gp-0)
                            (while (= *net-mgr-pending-behavior-result* 'undefined)
                              (suspend)
                              )
                            (suspend)
                            *net-mgr-pending-behavior-result*
                            )
                          )
                        )
                      (cond
                        (*net-mgr-pending-behavior-valid*
                          )
                        (else
                          (until v1-37
                            (suspend)
                            (set! v1-37 (or (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'lobby-idle))
                                            (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'playing-game))
                                            )
                                  )
                            )
                          (set! *net-mgr-pending-behavior-result* 'undefined)
                          (send-event *net-mgr* 'do-behavior 'get-game-list *medius-games* #f)
                          (while (= *net-mgr-pending-behavior-result* 'undefined)
                            (suspend)
                            )
                          (suspend)
                          *net-mgr-pending-behavior-result*
                          )
                        )
                      (let ((gp-1 (the-as net-available-game #f)))
                        (let ((s5-0 #x98967f))
                          (dotimes (s4-0 (-> *medius-games* ct))
                            (let* ((s3-0 (-> *medius-games* data s4-0))
                                   (v1-57 (-> s3-0 info))
                                   )
                              (when (and (< (-> v1-57 player-count) (-> v1-57 max-players))
                                         (>= (-> v1-57 player-count) (the-as uint 1))
                                         (-> v1-57 in-staging)
                                         )
                                (let ((v1-60 (- (/ (-> v1-57 skill-level) (the-as int (-> v1-57 player-count)))
                                                (get-skill-level (-> *medius-my-player* ladder-stats))
                                                )
                                             )
                                      )
                                  (if (< v1-60 0)
                                      (set! v1-60 (- v1-60))
                                      )
                                  (when (or (not gp-1) (< v1-60 s5-0))
                                    (set! gp-1 s3-0)
                                    (set! s5-0 v1-60)
                                    )
                                  )
                                )
                              )
                            )
                          )
                        (when (not gp-1)
                          (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-2615))
                          (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
                          (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
                          (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
                          (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
                          (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
                          (go-virtual
                            lobby-generic-error-menu
                            *lobby-generic-confirmation*
                            (lambda :behavior lobby-menu-manager () (go-virtual do-quickplay))
                            (the-as (function symbol object) #f)
                            #t
                            #f
                            #f
                            )
                          )
                        (set! *medius-game-info-id* (-> gp-1 medius-world-id))
                        )
                      (go-virtual game-info-screen)
                      )
                    )
              (set! *pending-op* (the-as (function object object object object object object object object object)
                                   (the-as (function medius-game-array object :behavior lobby-menu-manager) v0-0)
                                   )
                    )
              v0-0
              )
            )
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :code (behavior ()
    (local-vars (v1-2 symbol))
    (dotimes (v1-0 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-0))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-0))) info-ptr) *do-quickplay*)
                 )
        (set! v1-2 #t)
        (goto cfg-20)
        )
      )
    (set! v1-2 #f)
    (label cfg-20)
    (if v1-2
        (goto cfg-24)
        )
    (kill-menu self #t #f)
    (create-menu self *do-quickplay* 0)
    #t
    (until #f
      (label cfg-24)
      (suspend)
      (do-pending-operation)
      )
    #f
    )
  )


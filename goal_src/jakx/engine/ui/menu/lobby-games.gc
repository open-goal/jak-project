;; WARN: Return type mismatch int vs object.
(defun init-event-filter-array ()
  (set! *menu-events-filter-ct* 0)
  (mem-copy!
    (the-as pointer (-> *menu-events-filter-array* array-ptr 0))
    (the-as pointer *menu-events-filter-any*)
    12
    )
  (set! *menu-events-filter-ct* (+ *menu-events-filter-ct* 1))
  (let* ((v1-4 (if (beta?)
                   *menu-events-info-beta*
                   *menu-events-info-all*
                   )
               )
         (a0-1 (-> v1-4 length))
         (a1-1 0)
         (a2-3 (-> v1-4 a1-1))
         )
    (while (< a1-1 a0-1)
      (dotimes (a3-0 (-> *game-info* sub-task-list length))
        (let ((t0-2 (-> *game-info* sub-task-list a3-0)))
          (when (and (-> *game-info* play-list (-> t0-2 task) play-continue)
                     (!= (-> t0-2 net-play-mode) 15)
                     (!= (-> t0-2 net-play-mode) 16)
                     (!= (-> t0-2 net-play-mode) 18)
                     (!= (-> t0-2 net-play-mode) 3)
                     (!= (-> t0-2 net-play-mode) 2)
                     (!= (-> t0-2 net-play-mode) 13)
                     (!= (-> t0-2 net-play-mode) 19)
                     )
            (when (= (-> t0-2 net-play-mode) (-> a2-3 extra-int))
              (let ((a2-7 (-> *menu-events-filter-array* array-ptr *menu-events-filter-ct*)))
                (set! (-> a2-7 extra-int) (the-as int (-> t0-2 net-play-mode)))
                (set! (-> a2-7 display-name-id) (-> *net-play-mode-text-ids* (-> t0-2 net-play-mode)))
                (set! (-> a2-7 sym) 'blah)
                )
              (set! *menu-events-filter-ct* (+ *menu-events-filter-ct* 1))
              (goto cfg-27)
              )
            )
          )
        )
      (label cfg-27)
      (+! a1-1 1)
      (set! a2-3 (-> v1-4 a1-1))
      )
    )
  (set! (-> *menu-events-filter-array* array-ptr length) *menu-events-filter-ct*)
  0
  )


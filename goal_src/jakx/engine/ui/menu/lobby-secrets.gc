(define *time-lock-check* (the-as time-frame 0))

(define *locked-text-id* (text-id text-id-0))

(define *locked-msg-index* 0)

(define *scene-type* 0)

(deftype scrolling-secrets-menu (scrolling-menu-medius)
  ((last-delta     int8)
   (valid-indices  int8  64)
   )
  )


(defmethod scrolling-menu-method-70 ((this scrolling-secrets-menu))
  (call-parent-method this)
  0
  (none)
  )

;; WARN: Return type mismatch int vs object.
(defmethod handle-input ((this scrolling-secrets-menu) (arg0 int))
  (if (and (nonzero? (-> this cur-scroll)) (>= (-> *secret-items* (-> this cur-idx) price) 0))
      (return (the-as object #f))
      )
  (if (not (and (-> this selected) (-> this enabled)))
      (return (the-as object #f))
      )
  (let ((s5-0 0)
        (s3-0 (-> this cur-idx))
        (s4-0 (-> this top-idx))
        )
    0
    (when (zero? (-> this cur-scroll))
      (when (>= (-> *secret-items* (-> this cur-idx) price) 0)
        (cond
          ((cpad-or-kbd-pressed-var? (the-as uint arg0) (pad-buttons up))
           (set! s5-0 -1)
           (set! (-> this last-delta) s5-0)
           )
          ((cpad-or-kbd-pressed-var? (the-as uint arg0) (pad-buttons down))
           (set! s5-0 1)
           (set! (-> this last-delta) s5-0)
           )
          ((cpad-or-kbd-pressed-var? (the-as uint arg0) (pad-buttons square))
           (send-event
             (ppointer->process (-> this parent))
             'menu-selection-event
             'square
             (-> this info-ptr selection-type)
             (-> this cur-idx)
             )
           (logclear! (-> *cpad-list* cpads arg0 button0-abs 0) (pad-buttons square))
           (logclear! (-> *cpad-list* cpads arg0 button0-rel 0) (pad-buttons square))
           (cpad-or-kbd-clear-func! (the-as uint arg0) (pad-buttons square))
           (let ((v1-42 (make-sound-instance snd-choice1 (new 'static 'sound-id) (the-as handle #f))))
             (cond
               (v1-42
                 (logior! (-> v1-42 flags) (sound-spec-flag needs-update non-positional))
                 (-> v1-42 id)
                 )
               (else
                 0
                 )
               )
             )
           )
          ((cpad-or-kbd-pressed-var? (the-as uint arg0) (pad-buttons circle))
           (send-event
             (ppointer->process (-> this parent))
             'menu-selection-event
             'circle
             (-> this info-ptr selection-type)
             (-> this cur-idx)
             )
           (logclear! (-> *cpad-list* cpads arg0 button0-abs 0) (pad-buttons circle))
           (logclear! (-> *cpad-list* cpads arg0 button0-rel 0) (pad-buttons circle))
           (cpad-or-kbd-clear-func! (the-as uint arg0) (pad-buttons circle))
           (let ((v1-61 (make-sound-instance snd-choice1 (new 'static 'sound-id) (the-as handle #f))))
             (cond
               (v1-61
                 (logior! (-> v1-61 flags) (sound-spec-flag needs-update non-positional))
                 (-> v1-61 id)
                 )
               (else
                 0
                 )
               )
             )
           )
          ((cpad-or-kbd-pressed-var? (the-as uint arg0) (pad-buttons triangle))
           (send-event
             (ppointer->process (-> this parent))
             'menu-selection-event
             'cancel
             (-> this info-ptr selection-type)
             (-> this cur-idx)
             )
           (logclear! (-> *cpad-list* cpads arg0 button0-abs 0) (pad-buttons triangle))
           (logclear! (-> *cpad-list* cpads arg0 button0-rel 0) (pad-buttons triangle))
           (cpad-or-kbd-clear-func! (the-as uint arg0) (pad-buttons triangle))
           (let ((v1-80 (make-sound-instance snd-undo1 (new 'static 'sound-id) (the-as handle #f))))
             (cond
               (v1-80
                 (logior! (-> v1-80 flags) (sound-spec-flag needs-update non-positional))
                 (-> v1-80 id)
                 )
               (else
                 0
                 )
               )
             )
           )
          ((cpad-or-kbd-pressed-var? (the-as uint arg0) (pad-buttons x))
           (cond
             ((> (-> this physical-item-ct) 0)
              (send-event
                (ppointer->process (-> this parent))
                'menu-selection-event
                'accept
                (-> this info-ptr selection-type)
                (-> this cur-idx)
                )
              (logclear! (-> *cpad-list* cpads arg0 button0-abs 0) (pad-buttons x))
              (logclear! (-> *cpad-list* cpads arg0 button0-rel 0) (pad-buttons x))
              (cpad-or-kbd-clear-func! (the-as uint arg0) (pad-buttons x))
              (let ((v1-100 (make-sound-instance snd-choice1 (new 'static 'sound-id) (the-as handle #f))))
                (cond
                  (v1-100
                    (logior! (-> v1-100 flags) (sound-spec-flag needs-update non-positional))
                    (-> v1-100 id)
                    )
                  (else
                    0
                    )
                  )
                )
              )
             (else
               )
             )
           )
          ((cpad-or-kbd-pressed-var? (the-as uint arg0) (pad-buttons left))
           (cond
             ((-> this info-ptr lr-scroll)
              (set! s5-0 (- (-> this info-ptr visible-item-ct)))
              )
             (else
               (send-event
                 (ppointer->process (-> this parent))
                 'menu-selection-event
                 'left
                 (-> this info-ptr selection-type)
                 (-> this cur-idx)
                 )
               (return (the-as object #f))
               )
             )
           )
          ((cpad-or-kbd-pressed-var? (the-as uint arg0) (pad-buttons right))
           (cond
             ((-> this info-ptr lr-scroll)
              (set! s5-0 (-> this info-ptr visible-item-ct))
              )
             (else
               (send-event
                 (ppointer->process (-> this parent))
                 'menu-selection-event
                 'right
                 (-> this info-ptr selection-type)
                 (-> this cur-idx)
                 )
               (return (the-as object #f))
               )
             )
           )
          )
        )
      (if (and (= (-> this cur-idx) 1) (= (-> this top-idx) 1))
          (set! s5-0 -1)
          )
      (if (< (-> *secret-items* (-> this cur-idx) price) 0)
          (set! s5-0 (cond
                       ((zero? (-> this cur-idx))
                        (set! (-> this cur-idx) 1)
                        s5-0
                        )
                       (else
                         (-> this last-delta)
                         )
                       )
                )
          )
      )
    (if (zero? s5-0)
        (return (the-as object #f))
        )
    (set! (-> this cur-idx) (max 0 (min (+ s5-0 (-> this cur-idx)) (+ (-> this physical-item-ct) -1))))
    (when (= (-> this cur-idx) s3-0)
      (let ((v1-159 (make-sound-instance snd-illegal1 (new 'static 'sound-id) (the-as handle #f))))
        (cond
          (v1-159
            (logior! (-> v1-159 flags) (sound-spec-flag needs-update non-positional))
            (-> v1-159 id)
            )
          (else
            0
            )
          )
        )
      (cond
        ((< s5-0 0)
         (send-event
           (ppointer->process (-> this parent))
           'menu-selection-event
           'failed-up
           (-> this info-ptr selection-type)
           )
         )
        ((> s5-0 0)
         (send-event
           (ppointer->process (-> this parent))
           'menu-selection-event
           'failed-down
           (-> this info-ptr selection-type)
           )
         )
        )
      (return (the-as object #f))
      )
    (let ((v1-184 (make-sound-instance snd-cycle-vert1 (new 'static 'sound-id) (the-as handle #f))))
      (cond
        (v1-184
          (logior! (-> v1-184 flags) (sound-spec-flag needs-update non-positional))
          (-> v1-184 id)
          )
        (else
          0
          )
        )
      )
    (when (and (!= s5-0 1) (!= s5-0 -1))
      (let ((a0-114 (- s3-0 s4-0)))
        (set! (-> this top-idx)
              (max 0 (min (+ a0-114 (-> this cur-idx)) (- (-> this cur-idx) (+ (-> this info-ptr visible-item-ct) -1))))
              )
        )
      (scrolling-menu-method-72 this (-> this cur-idx))
      (scrolling-menu-method-73 this (-> this cur-idx) #t)
      (scrolling-menu-method-74 this)
      (return (the-as object #f))
      )
    (set! (-> this top-idx) (max
                              (min (-> this top-idx) (-> this cur-idx))
                              (- (-> this cur-idx) (+ (-> this info-ptr visible-item-ct) -1))
                              )
          )
    (if (zero? (-> this cur-idx))
        (set! (-> this cur-idx) 1)
        )
    (cond
      ((!= s4-0 (-> this top-idx))
       (set! (-> this cur-scroll) (-> this info-ptr scroll-stages))
       (set! (-> this scroll-dir) s5-0)
       (scrolling-menu-method-72 this -100)
       )
      (else
        (scrolling-menu-method-72 this (-> this cur-idx))
        (scrolling-menu-method-73 this (-> this cur-idx) #t)
        )
      )
    )
  0
  )

(defmethod default-event-handler ((this scrolling-secrets-item) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (case arg2
    (('set-index)
     (dotimes (s4-0 (-> this strings length))
       (clear (-> this strings data s4-0 text))
       )
     (let ((v1-7 (-> arg3 param 0))
           (a0-6 (-> this parent 0))
           )
       (if (or (< (the-as int v1-7) 0) (>= (the-as int v1-7) (-> (the-as scrolling-secrets-menu a0-6) physical-item-ct)))
           (return #f)
           )
       (let ((v0-1 (the-as object (-> (the-as scrolling-secrets-menu a0-6) valid-indices v1-7))))
         (set! (-> this idx) (the-as int v0-1))
         v0-1
         )
       )
     )
    (else
      ((method-of-type scrolling-item default-event-handler) this arg0 arg1 arg2 arg3)
      )
    )
  )

(defun player-finished-adventure-mode? ()
  (dotimes (gp-0 (-> *m2v-info* length))
    (when (string= (the-as string (-> *m2v-info* gp-0 name)) "outroc")
      (if (nonzero? (-> *m2v-info* gp-0 idx))
          (return #t)
          (return #f)
          )
      (the-as none 0)
      )
    )
  #f
  )

;; WARN: Function (method 67 scrolling-secrets-item) has a return type of none, but the expression builder found a return statement.
(defmethod update-strings ((this scrolling-secrets-item))
  (cond
    ((< (-> *secret-items* (-> this idx) price) 0)
     (set! (-> this strings data 0 color) (font-color font-color-60))
     (set! (-> this strings data 1 color) (font-color font-color-60))
     (format
       (clear (-> this strings data 0 text))
       (lookup-text! *common-text* (-> *secret-items* (-> this idx) id) #f)
       )
     (let ((t9-3 (method-of-type string-menu update-strings)))
       (t9-3 this)
       )
     (logior! (-> this strings data 0 flags) (hud-string-flag middle italic))
     (if (-> this info-ptr sprites-info)
         (set! (-> this info-ptr sprites-info 0 scale-x) 0.0)
         )
     (return #f)
     )
    ((-> this selected)
     (set! (-> this strings data 0 color) (-> this info-ptr strings-info 0 font-color-2))
     (set! (-> this strings data 1 color) (-> this info-ptr strings-info 1 font-color-2))
     )
    (else
      (set! (-> this strings data 0 color) (-> this info-ptr strings-info 0 font-color))
      (set! (-> this strings data 1 color) (-> this info-ptr strings-info 1 font-color))
      )
    )
  (logclear! (-> this strings data 0 flags) (hud-string-flag middle italic))
  (cond
    ((logtest? (-> *game-info* secrets) (game-secrets hero-mode))
     (format
       (clear (-> this strings data 0 text))
       (lookup-text! *common-text* (-> *secret-items* (-> this idx) id) #f)
       )
     )
    ((or (and (logtest? (-> *secret-items* (-> this idx) flags) (secret-item-flag requires-100-percent))
              (!= (calculate-percentage *game-info*) 100.0)
              )
         (and (logtest? (-> *secret-items* (-> this idx) flags) (secret-item-flag requires-adventure-complete))
              (not (player-finished-adventure-mode?))
              )
         )
     (format (clear (-> this strings data 0 text)) (lookup-text! *common-text* (text-id text-id-4248) #f))
     )
    ((>= (get-task-cup-score (the-as int (-> *secret-items* (-> this idx) cup)))
         (the-as int (-> *secret-items* (-> this idx) cup-score))
         )
     (format
       (clear (-> this strings data 0 text))
       (lookup-text! *common-text* (-> *secret-items* (-> this idx) id) #f)
       )
     )
    (else
      (format (clear (-> this strings data 0 text)) (lookup-text! *common-text* (text-id text-id-4248) #f))
      )
    )
  (cond
    ((= (-> *secret-items* (-> this idx) button-behavior) 3)
     (clear (-> this strings data 1 text))
     (set! (-> this info-ptr sprites-info 0 scale-x) 0.0)
     )
    ((logtest? (-> *game-info* purchase-secrets) (-> *secret-items* (-> this idx) secret))
     (cond
       ((logtest? (-> *secret-items* (-> this idx) flags) (secret-item-flag requires-100-percent))
        (format (clear (-> this strings data 1 text)) (lookup-text! *common-text* (text-id text-id-47) #f))
        )
       ((= (-> *secret-items* (-> this idx) button-behavior) 1)
        (format (clear (-> this strings data 1 text)) (lookup-text! *common-text* (text-id text-id-3479) #f))
        )
       ((= (-> *secret-items* (-> this idx) button-behavior) 2)
        (format (clear (-> this strings data 1 text)) (lookup-text! *common-text* (text-id text-id-85) #f))
        )
       ((logtest? (-> *secret-items* (-> this idx) secret) (-> *game-info* secrets))
        (format (clear (-> this strings data 1 text)) (lookup-text! *common-text* (text-id text-id-15) #f))
        )
       (else
         (format (clear (-> this strings data 1 text)) (lookup-text! *common-text* (text-id text-id-16) #f))
         )
       )
     (if (-> this info-ptr sprites-info)
         (set! (-> this info-ptr sprites-info 0 scale-x) 0.0)
         )
     )
    (else
      (if (and (= (-> this idx) *locked-msg-index*) (not (time-elapsed? *time-lock-check* (seconds 1))))
          (format (clear (-> this strings data 1 text)) (lookup-text! *common-text* *locked-text-id* #f))
          (format (clear (-> this strings data 1 text)) "~D" (-> *secret-items* (-> this idx) price))
          )
      (if (-> this info-ptr sprites-info)
          (set! (-> this info-ptr sprites-info 0 scale-x) 1.3)
          )
      )
    )
  ((method-of-type string-menu update-strings) this)
  0
  (none)
  )

(defmethod init-menu! ((this scrolling-secrets-menu))
  (call-parent-method this)
  (set! (-> this physical-item-ct) 0)
  (dotimes (v1-0 (min 50 (-> *secret-items* length)))
    (set! (-> this valid-indices (-> this physical-item-ct)) v1-0)
    (+! (-> this physical-item-ct) 1)
    )
  (scrolling-menu-medius-method-77 this)
  (scrolling-menu-method-74 this)
  (scrolling-menu-method-73 this (-> this cur-idx) #f)
  0
  (none)
  )

(defmethod scrolling-menu-method-73 ((this scrolling-secrets-menu) (arg0 int) (arg1 symbol))
  (call-parent-method this arg0 arg1)
  (none)
  )

;; WARN: Return type mismatch object vs none.
(defmethod update-strings ((this scrolling-secrets-menu))
  (let ((t9-0 (method-of-type string-menu update-strings)))
    (t9-0 this)
    )
  (format (clear (-> this strings data 0 text)) "~d" (the int (-> *game-info* player-info 0 cash)))
  (none)
  )


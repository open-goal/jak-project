;; +++secret-item-flag
(defenum secret-item-flag
  :type uint8
  :bitfield #t
  (requires-100-percent 0)
  (requires-adventure-complete 1)
  (bit2 2)
  (bit3 3)
  (bit4 4)
  (bit5 5)
  (bit6 6)
  (bit7 7)
  )
;; ---secret-item-flag


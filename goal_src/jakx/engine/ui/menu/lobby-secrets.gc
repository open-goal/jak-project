(defstate lobby-scene-player (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('menu-selection-event)
       (case (-> block param 0)
         (('accept)
          (case (-> block param 1)
            (('scene)
             (let ((gp-0 (-> block param 2)))
               (when *list-all-scenes*
                 (if (kill-menu self #f #f)
                     (go-virtual lobby-play-fmv (the-as int gp-0))
                     )
                 )
               (dotimes (s5-0 (-> *m2v-info* length))
                 (when (= (+ (-> *m2v-info* s5-0 idx) -1) gp-0)
                   (if (kill-menu self #f #f)
                       (go-virtual lobby-play-fmv s5-0)
                       )
                   )
                 )
               )
             #f
             )
            )
          )
         (('cancel)
          (kill-menu self #t #f)
          (go-virtual adventure-cup)
          )
         (('selection-changed)
          #f
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    '()
    )
  :trans (behavior ()
    '()
    )
  :code (behavior ()
    (local-vars (v1-7 symbol))
    (suspend-for (seconds 0.5)
      )
    (dotimes (v1-5 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-5))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-5))) info-ptr) *scene-player-menu-info*)
                 )
        (set! v1-7 #t)
        (goto cfg-22)
        )
      )
    (set! v1-7 #f)
    (label cfg-22)
    (if v1-7
        (goto cfg-26)
        )
    (kill-menu self #t #f)
    (create-menu self *scene-player-menu-info* 0)
    #t
    (until #f
      (label cfg-26)
      (suspend)
      )
    #f
    )
  :post lobby-default-post
  )

(defstate lobby-commentary-scene-player (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('menu-selection-event)
       (case (-> block param 0)
         (('accept)
          (case (-> block param 1)
            (('scene)
             (let ((gp-0 (-> block param 2)))
               (format #t "idx-passed: ~D~%" gp-0)
               (let ((s5-0 0))
                 (dotimes (s4-0 (-> *m2v-info* length))
                   (when (not (string= (the-as string (-> *m2v-info* s4-0 commentary-sound)) "#f"))
                     (when (= s5-0 gp-0)
                       (kill-menu self #t #f)
                       (go-virtual lobby-play-fmv s4-0)
                       )
                     (+! s5-0 1)
                     )
                   )
                 )
               )
             #f
             )
            )
          )
         (('cancel)
          (kill-menu self #t #f)
          (go-virtual secrets-menu)

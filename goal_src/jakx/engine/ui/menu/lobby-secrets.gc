(defstate lobby-scrapbook (lobby-menu-manager)
  :virtual #t
  :code (behavior ((arg0 int))
    (let* ((v1-0 arg0)
           (gp-0 (cond
                   ((zero? v1-0)
                    'scrap-book1
                    )
                   ((= v1-0 1)
                    'scrap-book2
                    )
                   (else
                     'scrap-book3
                     )
                   )
                 )
           )
      (kill-by-type fmv-player *active-pool*)
      (dma-release 'fmv-player)
      (until #f
        (let ((v1-1 (new 'stack-no-clear 'array 'uint32 2)))
          (when (dma-try-alloc
                  #xd2800
                  #xd2800
                  'title-control
                  0
                  (the-as (pointer int32) (&-> v1-1 0))
                  (the-as (pointer int32) (&-> v1-1 1))
                  #f
                  )
            (suspend)
            (suspend)
            (goto cfg-10)
            )
          )
        (suspend)
        0
        )
      #f
      (label cfg-10)
      (suspend)
      (suspend)
      (title-control-spawn gp-0)
      )
    (while (search-process-tree *active-pool* (lambda ((arg0 process)) (= (-> arg0 type) title-control)))
      (suspend)
      )
    (dma-release 'title-control)
    (until #f
      (let ((v1-8 (new 'stack-no-clear 'array 'uint32 2)))
        (when (dma-try-alloc
                #x80040
                #x80040
                'fmv-player
                0
                (the-as (pointer int32) (&-> v1-8 0))
                (the-as (pointer int32) (&-> v1-8 1))
                #f
                )
          (suspend)
          (suspend)
          (goto cfg-18)
          )
        )
      (suspend)
      0
      )
    #f
    (label cfg-18)
    (go-virtual secrets-menu)
    )
  )

(defstate secrets-menu (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (local-vars (v0-0 object))
    (case message
      (('menu-selection-event)
       (case (-> block param 0)
         (('accept)
          (case (-> block param 1)
            (('secret)
             (let ((gp-0 (-> block param 2)))
               (when (or (< (get-task-cup-score (the-as int (-> *secret-items* gp-0 cup)))
                            (the-as int (-> *secret-items* gp-0 cup-score))
                            )
                         (and (logtest? (-> *secret-items* gp-0 flags) (secret-item-flag requires-100-percent))
                              (!= (calculate-percentage *game-info*) 100.0)
                              )
                         (and (logtest? (-> *secret-items* gp-0 flags) (secret-item-flag requires-adventure-complete))
                              (not (player-finished-adventure-mode?))
                              )
                         )
                 (when (not (logtest? (-> *game-info* secrets) (game-secrets hero-mode)))
                   (set! *time-lock-check* (current-time))
                   (set! *locked-msg-index* (the-as int gp-0))
                   (set! *locked-text-id* (text-id text-id-1723))
                   (return #f)
                   )
                 )
               (cond
                 ((= (-> *secret-items* gp-0 secret) (game-secrets gun-upgrade-red-1))
                  (kill-menu self #t #f)
                  (create-menu self *psp-secrets-menu-info* 0)
                  (go-virtual psp-secrets-menu)
                  )
                 ((logtest? (-> *game-info* purchase-secrets) (-> *secret-items* gp-0 secret))
                  (cond
                    ((logtest? (-> *secret-items* gp-0 secret) (game-secrets scrap-book-1))
                     (if (kill-menu self #f #f)
                         (go-virtual lobby-scrapbook 0)
                         )
                     )
                    ((logtest? (-> *secret-items* gp-0 secret) (game-secrets scrap-book-2))
                     (if (kill-menu self #f #f)
                         (go-virtual lobby-scrapbook 1)
                         )
                     )
                    ((logtest? (-> *secret-items* gp-0 secret) (game-secrets scrap-book-3))
                     (if (kill-menu self #f #f)

    )
  :code sleep-code
  :post lobby-default-post
  )

(defstate lobby-play-fmv (lobby-menu-manager)
  :virtual #t
  :event lobby-menu-manager-default-handler
  :code (behavior ((arg0 int))
    (local-vars (s5-0 level))
    (jukebox-onoff #f)
    (level-get *level* 'fmvlev)
    (setup
      *screen-filter*
      (new 'static 'vector)
      (new 'static 'vector :w 128.0)
      (* 2.0 (seconds-per-frame))
      (bucket-id debug)
      #x3fffff
      #x33001
      (the-as symbol 0)
      )
    (until (= (-> *screen-filter* color w) 128.0)
      (suspend)
      )
    (cond
      ((= (-> self prev-state name) 'lobby-scene-player)
       (copy-string<-string (-> self cam-string) "camera-6")
       )
      (else
        )
      )
    (set-lobby-camera-seek-time! 0.001)
    (suspend)
    (set-lobby-camera-seek-time! 0.5)
    (lobby-level-set! 1 'fmvlev 'display)
    (until s5-0
      (set! s5-0 (level-get *level* 'fmvlev))
      (suspend)
      )
    (until (= (-> s5-0 display?) 'display)
      (suspend)
      )
    (suspend-for (seconds 2)
      )
    (cond
      ((= (-> self prev-state name) 'lobby-scene-player)
       (fmv-player-run (the-as string (-> *m2v-info* arg0 name)) *target-pool* #f)
       )
      ((= (-> self prev-state name) 'secrets-menu)
       (fmv-player-run (the-as string (-> *m2v-info* arg0 name)) *target-pool* #f)
       )
      (else
        (fmv-player-run (the-as string (-> *m2v-info* arg0 name)) *target-pool* #t)
        )
      )
    (while *fmv-player*
      (suspend)
      )
    (suspend-for (seconds 1)
      )
    (disable *screen-filter*)
    (suspend)
    (jukebox-onoff #t)
    (when (not (dma-get-named-buffer 'fmv-player 0 0))
      (until #f
        (let ((v1-45 (new 'stack-no-clear 'array 'uint32 2)))
          (when (dma-try-alloc
                  #x80040
                  #x80040
                  'fmv-player
                  0
                  (the-as (pointer int32) (&-> v1-45 0))
                  (the-as (pointer int32) (&-> v1-45 1))
                  #f
                  )
            (suspend)
            (suspend)
            (goto cfg-26)
            )
          )
        (suspend)
        0
        )
      #f
      )
    (label cfg-26)
    (cond
      ((= (-> self prev-state name) 'lobby-scene-player)
       (adventure-map-fade-in)
       (while (!= (level-status? *level* 'menumap #f) 'active)
         (suspend)
         )
       (go-virtual lobby-scene-player)
       )
      ((= (-> self prev-state name) 'secrets-menu)
       (go-virtual secrets-menu)
       )
      (else
        (go-virtual lobby-commentary-scene-player)
        )
      )
    )
  )

(defbehavior check-for-valid-secret-chars lobby-menu-manager ((arg0 mc-secrets) (arg1 int))
  (let ((a2-0 #f))
    (dotimes (v1-0 (-> *net-drivers* length))
      (cond
        ((= (-> *net-drivers* v1-0 levname) 'jkalev)
         (when (and (logtest? arg0 (mc-secrets jak1-save))
                    (not (logtest? (-> *game-info* driver-unlock) (ash 1 (-> *net-drivers* v1-0 dt))))
                    )
           (logior! (-> *game-info* driver-unlock) (ash 1 (-> *net-drivers* v1-0 dt)))
           (set! a2-0 #t)
           )
         )
        ((= (-> *net-drivers* v1-0 levname) 'jkblev)
         (when (and (logtest? arg0 (mc-secrets jak2-save))
                    (not (logtest? (-> *game-info* driver-unlock) (ash 1 (-> *net-drivers* v1-0 dt))))
                    )
           (logior! (-> *game-info* driver-unlock) (ash 1 (-> *net-drivers* v1-0 dt)))
           (set! a2-0 #t)
           )
         )
        ((= (-> *net-drivers* v1-0 levname) 'jkclev)
         (when (and (logtest? arg0 (mc-secrets jak3-save))
                    (not (logtest? (-> *game-info* driver-unlock) (ash 1 (-> *net-drivers* v1-0 dt))))
                    )
           (logior! (-> *game-info* driver-unlock) (ash 1 (-> *net-drivers* v1-0 dt)))
           (set! a2-0 #t)
           )
         )
        ((= (-> *net-drivers* v1-0 levname) 'ratlev)
         (when (and (logtest? arg0 (mc-secrets ratchet-deadlocked-save))
                    (not (logtest? (-> *game-info* driver-unlock) (ash 1 (-> *net-drivers* v1-0 dt))))
                    )
           (logior! (-> *game-info* driver-unlock) (ash 1 (-> *net-drivers* v1-0 dt)))
           (set! a2-0 #t)
           )
         )
        ((= (-> *net-drivers* v1-0 levname) 'kaelev)
         (when (and (or (zero? arg1) (= arg1 1))
                    (not (logtest? (-> *game-info* driver-unlock) (ash 1 (-> *net-drivers* v1-0 dt))))
                    )
           (logior! (-> *game-info* driver-unlock) (ash 1 (-> *net-drivers* v1-0 dt)))
           (set! a2-0 #t)
           )
         )
        ((= (-> *net-drivers* v1-0 levname) 'tarlev)
         (when (and (or (zero? arg1) (= arg1 1))
                    (not (logtest? (-> *game-info* driver-unlock) (ash 1 (-> *net-drivers* v1-0 dt))))
                    )
           (logior! (-> *game-info* driver-unlock) (ash 1 (-> *net-drivers* v1-0 dt)))
           (set! a2-0 #t)
           )
         )
        ((= (-> *net-drivers* v1-0 levname) 'osmlev)
         (when (and (= arg1 1) (not (logtest? (-> *game-info* driver-unlock) (ash 1 (-> *net-drivers* v1-0 dt)))))
           (logior! (-> *game-info* driver-unlock) (ash 1 (-> *net-drivers* v1-0 dt)))
           (set! a2-0 #t)
           )
         )
        ((= (-> *net-drivers* v1-0 levname) 'ximlev)
         (when (and (= arg1 1) (not (logtest? (-> *game-info* driver-unlock) (ash 1 (-> *net-drivers* v1-0 dt)))))
           (logior! (-> *game-info* driver-unlock) (ash 1 (-> *net-drivers* v1-0 dt)))
           (set! a2-0 #t)
           )
         )
        )
      )
    (cond
      ((= arg1 -1)
       (goto cfg-127)
       )
      (else
        (when (zero? arg1)
          )
        (when (= arg1 1)
          (dotimes (v1-10 (-> *net-vehicles* length))
            (when (and (= (-> *net-vehicles* v1-10 levname) 'daxtl)
                       (not (logtest? (-> *game-info* car-info data (-> *net-vehicles* v1-10 ct) flags) (car-info-flag cif0)))
                       )
              (logior! (-> *game-info* car-info data (-> *net-vehicles* v1-10 ct) flags) (car-info-flag cif0))
              (set! *lobby-awards-new-vehicle* 14)
              )
            )
          )
        )
      )
    (label cfg-127)
    (cond
      (a2-0
        (kill-menu self #t #f)
        (go-virtual psp-wait-disconnect 'lobby-results-new-vehicle-animation)
        )
      (else
        (go-virtual psp-wait-disconnect 'no-chars)
        )
      )
    )
  )

(defstate psp-secrets-menu (lobby-menu-manager)
  :virtual #t
  :enter (behavior ()
    (local-vars (v1-2 symbol))
    (dotimes (v1-0 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-0))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-0))) info-ptr) *psp-secrets-menu-info*)
                 )
        (set! v1-2 #t)
        (goto cfg-20)
        )
      )
    (set! v1-2 #f)
    (label cfg-20)
    (if v1-2
        (goto cfg-24)
        )
    (kill-menu self #t #f)
    (create-menu self *psp-secrets-menu-info* 0)
    #t
    (label cfg-24)
    (psplink-start)
    )
  :trans (behavior ()
    (when (< (seconds 1) (- (current-time) (-> self state-time)))
      (when (cpad-or-kbd-pressed-var? (the-as uint 0) (pad-buttons triangle))
        (logclear! (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons triangle))
        (logclear! (-> *cpad-list* cpads 0 button0-rel 0) (pad-buttons triangle))
        (cpad-or-kbd-clear-func! (the-as uint 0) (pad-buttons triangle))
        (go-virtual psp-wait-disconnect 'secrets-menu)
        )
      )
    )
  :code (behavior ()
    (local-vars (s2-0 int))
    (set-time! (-> self state-time))
    0
    (let ((s4-0 (new 'static 'array int32 4 0 0 0 0))
          (s5-0 0)
          (gp-0 -1)
          )
      (let ((s3-0 0))
        (if (= (calculate-percentage *game-info*) 100.0)
            (set! s3-0 1)
            )
        (while (begin (label cfg-17) (= gp-0 -1))
          (set! (-> s4-0 0) -1)
          (until (>= s2-0 0)
            (set! s2-0 (psplink-poll))
            (set! s5-0 (the-as int (mc-get-secrets)))
            (if (< (seconds 2) (- (current-time) (-> self state-time)))
                (check-for-valid-secret-chars (the-as mc-secrets s5-0) gp-0)
                )
            (suspend)
            )
          (format #t "psp detected~%")
          (when (zero? (psplink-swap-data s2-0 s4-0 s3-0))
            (format #t "swap started~%")
            (until #f
              (let ((s1-0 (psplink-check-swap-data s2-0)))
                (set! s5-0 (the-as int (mc-get-secrets)))
                (format #t "mem-card: ~D~%" (the-as mc-secrets s5-0))
                (cond
                  ((zero? s1-0)
                   (set! gp-0 (-> s4-0 0))
                   )
                  ((< s1-0 0)
                   (format #t "swap error~%")
                   (goto cfg-17)
                   )
                  )
                )
              (if (< (seconds 2) (- (current-time) (-> self state-time)))
                  (check-for-valid-secret-chars (the-as mc-secrets s5-0) gp-0)
                  )
              (suspend)
              )
            #f
            )
          )
        )
      (until (< (seconds 2) (- (current-time) (-> self state-time)))
        (suspend)
        )
      (check-for-valid-secret-chars (the-as mc-secrets s5-0) gp-0)
      )
    )
  :post lobby-default-post
  )

(defstate inviting-player-to-clan (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (local-vars (v0-1 object))
    (case message
      (('notify)
       (case (-> block param 0)
         (('done)
          (copy-charp<-charp *medius-policy-buffer* (the-as (pointer uint8) (+ (-> block param 1) 4)))
          (when (not (and *pending-op*
                          *lobby-menu-manager*
                          (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                             (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                             )
                          )
                     )
            (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
            (set! v0-1
                  (lambda :behavior lobby-menu-manager
                    ()
                    (local-vars (v1-8 object) (v1-76 object))
                    (let ((v1-1 (cond
                                  (*net-mgr-pending-behavior-valid*
                                    #f
                                    )
                                  (else
                                    (until v1-8
                                      (suspend)
                                      (set! v1-8 (or (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'lobby-idle))
                                                     (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'playing-game))
                                                     )
                                            )
                                      )
                                    (set! *net-mgr-pending-behavior-result* 'undefined)
                                    (send-event *net-mgr* 'do-behavior 'finding-player *medius-policy-buffer*)
                                    (while (= *net-mgr-pending-behavior-result* 'undefined)
                                      (suspend)
                                      )
                                    (suspend)
                                    *net-mgr-pending-behavior-result*
                                    )
                                  )
                                )
                          )
                      (when (!= v1-1 'success)
                        (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-1769))
                        (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
                        (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
                        (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
                        (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
                        (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
                        (go-virtual
                          lobby-generic-error-menu
                          *lobby-generic-confirmation*
                          (lambda :behavior lobby-menu-manager () (go-virtual clan-info-screen))
                          (the-as (function symbol object) #f)
                          #t
                          #f
                          #f
                          )
                        )
                      )
                    (cond
                      ((= *medius-player-account-id* (-> *net-mgr* lobby-state my-account-id))
                       (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-3022))
                       (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
                       (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
                       (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
                       (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
                       (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
                       (go-virtual
                         lobby-generic-error-menu
                         *lobby-generic-confirmation*
                         (lambda :behavior lobby-menu-manager () (go-virtual clan-info-screen))
                         (the-as (function symbol object) #f)
                         #t
                         #f
                         #f
                         )
                       )
                      ((contains? (-> *medius-my-clan* members) *medius-player-account-id*)
                       (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-3023))
                       (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
                       (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
                       (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
                       (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
                       (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
                       (go-virtual
                         lobby-generic-error-menu
                         *lobby-generic-confirmation*
                         (lambda :behavior lobby-menu-manager () (go-virtual clan-info-screen))
                         (the-as (function symbol object) #f)
                         #t
                         #f
                         #f
                         )
                       )
                      ((contains? *medius-outstanding-clan-invites* *medius-player-account-id*)
                       (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-3024))
                       (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
                       (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
                       (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
                       (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
                       (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
                       (go-virtual
                         lobby-generic-error-menu
                         *lobby-generic-confirmation*
                         (lambda :behavior lobby-menu-manager () (go-virtual clan-info-screen))
                         (the-as (function symbol object) #f)
                         #t
                         #f
                         #f
                         )
                       )
                      (else
                        (case (cond
                                (*net-mgr-pending-behavior-valid*
                                  #f
                                  )
                                (else
                                  (until v1-76
                                    (suspend)
                                    (set! v1-76 (or (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'lobby-idle))
                                                    (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'playing-game))
                                                    )
                                          )
                                    )
                                  (set! *net-mgr-pending-behavior-result* 'undefined)
                                  (send-event *net-mgr* 'do-behavior 'invite-player-to-clan *medius-player-account-id*)
                                  (while (= *net-mgr-pending-behavior-result* 'undefined)
                                    (suspend)
                                    )
                                  (suspend)
                                  *net-mgr-pending-behavior-result*
                                  )
                                )
                          (('success)
                           (send-chat-with-clan-id "@Invite" *medius-player-account-id* #t)
                           (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-1920))
                           (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
                           (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
                           (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
                           (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
                           (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
                           (go-virtual
                             lobby-generic-error-menu
                             *lobby-generic-confirmation*
                             (lambda :behavior lobby-menu-manager () (go-virtual clan-info-screen))
                             (the-as (function symbol object) #f)
                             #t
                             #f
                             #f
                             )
                           )
                          (else
                            (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-1936))
                            (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
                            (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
                            (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
                            (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
                            (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
                            (go-virtual
                              lobby-generic-error-menu
                              *lobby-generic-confirmation*
                              (lambda :behavior lobby-menu-manager () (go-virtual clan-info-screen))
                              (the-as (function symbol object) #f)
                              #t
                              #f
                              #f
                              )
                            )
                          )
                        )
                      )
                    (go-virtual clan-info-screen)
                    )
                  )
            (set! *pending-op* (the-as (function object object object object object object object object object)
                                 (the-as (function object :behavior lobby-menu-manager) v0-1)
                                 )
                  )
            v0-1
            )
          )
         (else
           (when (not (and *pending-op*
                           *lobby-menu-manager*
                           (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                              (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                              )
                           )
                      )
             (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
             (set! v0-1 (lambda :behavior lobby-menu-manager () (go-virtual clan-info-screen)))
             (set! *pending-op* (the-as (function object object object object object object object object object)
                                  (the-as (function object :behavior lobby-menu-manager) v0-1)
                                  )
                   )
             v0-1
             )
           )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :exit (behavior ()
    (kill-keyboard-control)
    )
  :code (behavior ()
    (local-vars (v1-2 symbol))
    (dotimes (v1-0 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-0))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-0))) info-ptr) *invite-player-to-clan*)
                 )
        (set! v1-2 #t)
        (goto cfg-20)
        )
      )
    (set! v1-2 #f)
    (label cfg-20)
    (if v1-2
        (goto cfg-24)
        )
    (kill-menu self #t #f)
    (create-menu self *invite-player-to-clan* 0)
    #t
    (label cfg-24)
    (keyboard-control-spawn 24 self (keyboard-control-flag allow-space) (the-as (pointer uint8) #f))
    (until #f
      (do-pending-operation)
      (suspend)
      )
    #f
    )
  )

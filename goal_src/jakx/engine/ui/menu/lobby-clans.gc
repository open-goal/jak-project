(defstate clan-incoming-invites (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (local-vars (v0-0 object))
    (case message
      (('async-clan-update)
       (when (not (and *pending-op*
                       *lobby-menu-manager*
                       (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                          (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                          )
                       )
                  )
         (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
         (set! v0-0
               (lambda :behavior lobby-menu-manager
                 ()
                 (local-vars (v1-8 object))
                 (cond
                   (*net-mgr-pending-behavior-valid*
                     )
                   (else
                     (until v1-8
                       (suspend)
                       (set! v1-8 (or (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'lobby-idle))
                                      (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'playing-game))
                                      )
                             )
                       )
                     (set! *net-mgr-pending-behavior-result* 'undefined)
                     (send-event *net-mgr* 'do-behavior 'retrieve-my-clan-data)
                     (while (= *net-mgr-pending-behavior-result* 'undefined)
                       (suspend)
                       )
                     (suspend)
                     *net-mgr-pending-behavior-result*
                     )
                   )
                 (send-event (find-menu self 'clan-incoming-invites-list) 'update)
                 )
               )
         (set! *pending-op* (the-as (function object object object object object object object object object)
                              (the-as (function object :behavior lobby-menu-manager) v0-0)
                              )
               )
         v0-0
         )
       )
      (('menu-selection-event)
       (if (and *pending-op*
                *lobby-menu-manager*
                (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                   (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                   )
                )
           (return #f)
           )
       (case (-> block param 0)
         (('accept)
          (case (-> block param 1)
            (('clan-incoming-invites)
             (send-event (find-menu self 'clan-incoming-invites-list) 'selected)
             (send-event (find-menu self 'manager) 'enable #f)
             )
            (('clan-incoming-invites-list)
             (set! *clan-info-id* (-> *medius-incoming-clan-invites* (-> block param 2) clan-id))
             (when (not (and *pending-op*
                             *lobby-menu-manager*
                             (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                                (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                                )
                             )
                        )
               (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
               (set! v0-0 (lambda :behavior lobby-menu-manager () (go-virtual clan-info-screen)))
               (set! *pending-op* (the-as (function object object object object object object object object object)
                                    (the-as (function object :behavior lobby-menu-manager) v0-0)
                                    )
                     )
               v0-0
               )
             )
            (('create-clan)
             (when (not (and *pending-op*
                             *lobby-menu-manager*
                             (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                                (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                                )
                             )
                        )
               (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
               (set! v0-0 (lambda :behavior lobby-menu-manager () (go-virtual clan-create-screen)))
               (set! *pending-op* (the-as (function object object object object object object object object object)
                                    (the-as (function object :behavior lobby-menu-manager) v0-0)
                                    )
                     )
               v0-0
               )
             )
            )
          )
         (('cancel)
          (case (-> block param 1)
            (('clan-incoming-invites-list)
             (send-event (find-menu self 'clan-incoming-invites-list) 'deselected)
             (send-event (find-menu self 'manager) 'enable #t)
             )
            (else
              (when (not (and *pending-op*
                              *lobby-menu-manager*
                              (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                                 (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                                 )
                              )
                         )
                (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
                (set! v0-0 (lambda :behavior lobby-menu-manager () (go-virtual lobby-main-screen)))
                (set! *pending-op* (the-as (function object object object object object object object object object)
                                     (the-as (function object :behavior lobby-menu-manager) v0-0)
                                     )
                      )
                v0-0
                )
              )
            )
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    '()
    )
  :code (behavior ()
    (local-vars (v1-9 object) (v1-27 symbol) (v1-31 symbol))
    (set! (-> *medius-incoming-clan-invites* length) 0)
    (until #f
      (cond
        (*net-mgr-pending-behavior-valid*
          )
        (else
          (until v1-9
            (suspend)
            (set! v1-9 (or (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'lobby-idle))
                           (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'playing-game))
                           )
                  )
            )
          (set! *net-mgr-pending-behavior-result* 'undefined)
          (send-event *net-mgr* 'do-behavior 'check-my-clan-invitations)
          (while (= *net-mgr-pending-behavior-result* 'undefined)
            (suspend)
            )
          (suspend)
          *net-mgr-pending-behavior-result*
          )
        )
      (dotimes (v1-25 (+ (-> self in-focus-index) 1))
        (when (and (handle->process (-> self menu-handles v1-25))
                   (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-25))) info-ptr)
                      *clan-incoming-invites-screen*
                      )
                   )
          (set! v1-27 #t)
          (goto cfg-38)
          )
        )
      (set! v1-27 #f)
      (label cfg-38)
      (when v1-27
        (set! v1-31 #f)
        (goto cfg-42)
        )
      (kill-menu self #t #f)
      (create-menu self *clan-incoming-invites-screen* 0)
      (set! v1-31 #t)
      (label cfg-42)
      (when v1-31
        (suspend)
        (send-event (find-menu self 'clan-incoming-invites-list) 'update)
        (send-event (find-menu self 'clan-incoming-invites-list) 'deselected)
        )
      (cond
        ((zero? (-> *medius-incoming-clan-invites* length))
         (send-event (find-menu self 'clan-incoming-invites-list) 'deselected)
         (send-event (find-menu self 'clan-incoming-invites-list) 'disabled)
         (send-event (find-menu self 'clan-incoming-invites) 'disabled)
         (send-event (find-menu self 'manager) 'enable #t)
         )
        (else
          (send-event (find-menu self 'clan-incoming-invites-list) 'enabled)
          (send-event (find-menu self 'clan-incoming-invites) 'enabled)
          )
        )
      (suspend-for (seconds 30)
        (do-pending-operation)
        )
      )
    #f
    )
  )


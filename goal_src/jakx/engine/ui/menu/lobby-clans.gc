(defstate clan-sent-invites (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (local-vars (v0-0 object))
    (case message
      (('async-clan-update)
       (when (not (and *pending-op*
                       *lobby-menu-manager*
                       (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                          (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                          )
                       )
                  )
         (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
         (set! v0-0
               (lambda :behavior lobby-menu-manager
                 ()
                 (local-vars (v1-7 object))
                 (cond
                   (*net-mgr-pending-behavior-valid*
                     #f
                     )
                   (else
                     (until v1-7
                       (suspend)
                       (set! v1-7 (or (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'lobby-idle))
                                      (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'playing-game))
                                      )
                             )
                       )
                     (set! *net-mgr-pending-behavior-result* 'undefined)
                     (send-event *net-mgr* 'do-behavior 'retrieve-my-clan-data)
                     (while (= *net-mgr-pending-behavior-result* 'undefined)
                       (suspend)
                       )
                     (suspend)
                     *net-mgr-pending-behavior-result*
                     )
                   )
                 )
               )
         (set! *pending-op* (the-as (function object object object object object object object object object)
                              (the-as (function object :behavior lobby-menu-manager) v0-0)
                              )
               )
         v0-0
         )
       )
      (('menu-selection-event)
       (if (and *pending-op*
                *lobby-menu-manager*
                (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                   (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                   )
                )
           (return #f)
           )
       (case (-> block param 0)
         (('accept)
          (case (-> block param 1)
            (('clan-sent-invites-list)
             (mem-copy!
               (the-as pointer *player-info-player*)
               (the-as pointer (-> *player-menu-array-to-use* data (-> block param 2)))
               4
               )
             (when (not (and *pending-op*
                             *lobby-menu-manager*
                             (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                                (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                                )
                             )
                        )
               (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
               (set! v0-0 (lambda :behavior lobby-menu-manager () (go-virtual player-info-screen)))
               (set! *pending-op* (the-as (function object object object object object object object object object)
                                    (the-as (function object :behavior lobby-menu-manager) v0-0)
                                    )
                     )
               v0-0
               )
             )
            )
          )
         (('cancel)
          (when (not (and *pending-op*
                          *lobby-menu-manager*
                          (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                             (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                             )
                          )
                     )
            (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
            (set! v0-0 (lambda :behavior lobby-menu-manager () (go-virtual clan-main-screen)))
            (set! *pending-op* (the-as (function object object object object object object object object object)
                                 (the-as (function object :behavior lobby-menu-manager) v0-0)
                                 )
                  )
            v0-0
            )
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    '()
    )
  :code (behavior ()
    (local-vars (v1-8 object) (v1-27 symbol) (v1-55 object))
    (cond
      (*net-mgr-pending-behavior-valid*
        )
      (else
        (until v1-8
          (suspend)
          (set! v1-8 (or (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'lobby-idle))
                         (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'playing-game))
                         )
                )
          )
        (set! *net-mgr-pending-behavior-result* 'undefined)
        (send-event *net-mgr* 'do-behavior 'retrieve-outstanding-invites)
        (while (= *net-mgr-pending-behavior-result* 'undefined)
          (suspend)
          )
        (suspend)
        *net-mgr-pending-behavior-result*
        )
      )
    (set! *player-menu-array-to-use* *medius-outstanding-clan-invites*)
    (dotimes (v1-25 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-25))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-25))) info-ptr) *clan-sent-invites*)
                 )
        (set! v1-27 #t)
        (goto cfg-37)
        )
      )
    (set! v1-27 #f)
    (label cfg-37)
    (if v1-27
        (goto cfg-41)
        )
    (kill-menu self #t #f)
    (create-menu self *clan-sent-invites* 0)
    #t
    (label cfg-41)
    (suspend)
    (send-event (find-menu self 'clan-sent-invites-list) 'update)
    (until #f
      (suspend-for (seconds 30)
        (suspend)
        (do-pending-operation)
        )
      (cond
        (*net-mgr-pending-behavior-valid*
          )
        (else
          (until v1-55
            (suspend)
            (set! v1-55 (or (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'lobby-idle))
                            (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'playing-game))
                            )
                  )
            )
          (set! *net-mgr-pending-behavior-result* 'undefined)
          (send-event *net-mgr* 'do-behavior 'retrieve-outstanding-invites)
          (while (= *net-mgr-pending-behavior-result* 'undefined)
            (suspend)
            )
          (suspend)
          *net-mgr-pending-behavior-result*
          )
        )
      (send-event (find-menu self 'clan-sent-invites-list) 'update)
      )
    #f
    )
  )


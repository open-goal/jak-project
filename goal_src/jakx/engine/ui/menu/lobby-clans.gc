          (dotimes (v1-110 (+ (-> self in-focus-index) 1))
            (when (and (handle->process (-> self menu-handles v1-110))
                       (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-110))) info-ptr)
                          *clan-main-screen-no-clan*
                          )
                       )
              (set! v1-112 #t)
              (goto cfg-111)
              )
            )
          (set! v1-112 #f)
          (label cfg-111)
          (if v1-112
              (goto cfg-115)
              )
          (kill-menu self #t #f)
          (create-menu self *clan-main-screen-no-clan* 0)
          #t
          )
        )
      (label cfg-115)
      (suspend)
      (suspend)
      (send-event (find-menu self 'recent-clans-list) 'update)
      (send-event (find-menu self 'clan-incoming-invites-list) 'update)
      (until #f
        (suspend-for (seconds 30)
          (set! (-> *clan-voice-text-ids* 0) (if *aux-voice-enabled*
                                                 (text-id text-id-3630)
                                                 (text-id text-id-3631)
                                                 )
                )
          (do-pending-operation)
          (suspend)
          (when (!= gp-0 (!= (-> *medius-my-clan* medius-id) -1))
            (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-1990))
            (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
            (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
            (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
            (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
            (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
            (go-virtual
              lobby-generic-error-menu
              *lobby-generic-confirmation*
              (lambda :behavior lobby-menu-manager () (go-virtual lobby-main-screen))
              (the-as (function symbol object) #f)
              #t
              #f
              #f
              )
            )
          )
        (cond
          (*net-mgr-pending-behavior-valid*
            )
          (else
            (until v1-159
              (suspend)
              (set! v1-159 (or (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'lobby-idle))
                               (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'playing-game))
                               )
                    )
              )
            (set! *net-mgr-pending-behavior-result* 'undefined)
            (send-event *net-mgr* 'do-behavior 'check-my-clan-invitations)
            (while (= *net-mgr-pending-behavior-result* 'undefined)
              (suspend)
              )
            (suspend)
            *net-mgr-pending-behavior-result*
            )
          )
        (cond
          (*net-mgr-pending-behavior-valid*
            )
          (else
            (until v1-183
              (suspend)
              (set! v1-183 (or (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'lobby-idle))
                               (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'playing-game))
                               )
                    )
              )
            (set! *net-mgr-pending-behavior-result* 'undefined)
            (send-event *net-mgr* 'do-behavior 'get-my-clans)
            (while (= *net-mgr-pending-behavior-result* 'undefined)
              (suspend)
              )
            (suspend)
            *net-mgr-pending-behavior-result*
            )
          )
        )
      )
    #f
    )
  )


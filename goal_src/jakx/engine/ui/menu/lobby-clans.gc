(defstate clan-challenges (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (local-vars (v0-1 object))
    (case message
      (('async-clan-update)
       (when (not (and *pending-op*
                       *lobby-menu-manager*
                       (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                          (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                          )
                       )
                  )
         (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
         (set! *pending-op*
               (the-as (function object object object object object object object object object)
                 (lambda :behavior lobby-menu-manager
                   ()
                   (local-vars (v1-7 object))
                   (cond
                     (*net-mgr-pending-behavior-valid*
                       #f
                       )
                     (else
                       (until v1-7
                         (suspend)
                         (set! v1-7 (or (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'lobby-idle))
                                        (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'playing-game))
                                        )
                               )
                         )
                       (set! *net-mgr-pending-behavior-result* 'undefined)
                       (send-event *net-mgr* 'do-behavior 'retrieve-my-clan-data)
                       (while (= *net-mgr-pending-behavior-result* 'undefined)
                         (suspend)
                         )
                       (suspend)
                       *net-mgr-pending-behavior-result*
                       )
                     )
                   )
                 )
               )
         )
       (send-event (find-menu self 'clan-challenges) 'update)
       )
      (('menu-selection-event)
       (if (and *pending-op*
                *lobby-menu-manager*
                (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                   (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                   )
                )
           (return #f)
           )
       (case (-> block param 0)
         (('accept)
          (format 0 "~A~%" (-> block param 1))
          (case (-> block param 1)
            (('clan-challenges)
             (set! *clan-info-id* (get-other-clan-id (the-as int (-> block param 2))))
             (when (>= *clan-info-id* 0)
               (when (not (and *pending-op*
                               *lobby-menu-manager*
                               (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                                  (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                                  )
                               )
                          )
                 (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
                 (set! v0-1 (lambda :behavior lobby-menu-manager () (go-virtual clan-info-screen)))
                 (set! *pending-op* (the-as (function object object object object object object object object object)
                                      (the-as (function object :behavior lobby-menu-manager) v0-1)
                                      )
                       )
                 v0-1
                 )
               )
             )
            )
          )
         (('cancel)
          (let ((v1-33 *prev-create-menu-state-name*))
            (set! *prev-create-menu-state-name* #f)
            (set! *this-create-menu-state-name* #f)
            (cond
              ((= v1-33 'clan-main-screen)
               (go-virtual clan-main-screen)
               )
              ((= v1-33 'clan-info-screen)
               (go-virtual clan-info-screen)
               )
              (else
                (when (not (and *pending-op*
                                *lobby-menu-manager*
                                (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                                   (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                                   )
                                )
                           )
                  (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
                  (set! v0-1 (lambda :behavior lobby-menu-manager () (go-virtual lobby-main-screen)))
                  (set! *pending-op* (the-as (function object object object object object object object object object)
                                       (the-as (function object :behavior lobby-menu-manager) v0-1)
                                       )
                        )
                  v0-1
                  )
                )
              )
            )
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :code (behavior ()
    (local-vars (v1-8 object) (v1-38 symbol) (v1-66 object))
    (cond
      (*net-mgr-pending-behavior-valid*
        )
      (else
        (until v1-8
          (suspend)
          (set! v1-8 (or (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'lobby-idle))
                         (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'playing-game))
                         )
                )
          )
        (set! *net-mgr-pending-behavior-result* 'undefined)
        (send-event *net-mgr* 'do-behavior 'get-clan-challenges)
        (while (= *net-mgr-pending-behavior-result* 'undefined)
          (suspend)
          )
        (suspend)
        *net-mgr-pending-behavior-result*
        )
      )
    (when (zero? (-> *medius-visible-clan-challenges* length))
      (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-2528))
      (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
      (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
      (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
      (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
      (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
      (go-virtual
        lobby-generic-error-menu
        *lobby-generic-confirmation*
        (lambda :behavior lobby-menu-manager () (go-virtual clan-info-screen))
        (the-as (function symbol object) #f)
        #t
        #f
        #f
        )
      )
    (dotimes (v1-36 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-36))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-36))) info-ptr) *clan-challenges*)
                 )
        (set! v1-38 #t)
        (goto cfg-39)
        )
      )
    (set! v1-38 #f)
    (label cfg-39)
    (if v1-38
        (goto cfg-43)
        )
    (kill-menu self #t #f)
    (create-menu self *clan-challenges* 0)
    #t
    (label cfg-43)
    (suspend)
    (send-event (find-menu self 'clan-challenges) 'update)
    (until #f
      (suspend-for (seconds 30)
        (suspend)
        (do-pending-operation)
        )
      (cond
        (*net-mgr-pending-behavior-valid*
          )
        (else
          (until v1-66
            (suspend)
            (set! v1-66 (or (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'lobby-idle))
                            (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'playing-game))
                            )
                  )
            )
          (set! *net-mgr-pending-behavior-result* 'undefined)
          (send-event *net-mgr* 'do-behavior 'get-clan-challenges)
          (while (= *net-mgr-pending-behavior-result* 'undefined)
            (suspend)
            )
          (suspend)
          *net-mgr-pending-behavior-result*
          )
        )
      (send-event (find-menu self 'clan-challenges) 'update)
      )
    #f
    )
  )


  :code (behavior ()
    (local-vars (v1-18 symbol) (v1-22 symbol) (v1-77 object) (gp-0 medius-cached-info-clan))
    (format 0 "getting clan info...~%")
    (until gp-0
      (set! gp-0 (the-as medius-cached-info-clan (lookup *medius-clan-cache* *clan-info-id* 9000 #f #f)))
      (when (= gp-0 'error)
        (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-2472))
        (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
        (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
        (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
        (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
        (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
        (go-virtual
          lobby-generic-error-menu
          *lobby-generic-confirmation*
          (lambda :behavior lobby-menu-manager () (go-virtual lobby-main-screen))
          (the-as (function symbol object) #f)
          #t
          #f
          #f
          )
        )
      (suspend)
      )
    (format 0 "done~%")
    (set! *player-menu-array-to-use* (-> gp-0 members))
    (setup-clan-info-buttons (-> *clan-info-button-manager* 0))
    (dotimes (v1-16 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-16))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-16))) info-ptr) *clan-info-screen*)
                 )
        (set! v1-18 #t)
        (goto cfg-24)
        )
      )
    (set! v1-18 #f)
    (label cfg-24)
    (when v1-18
      (set! v1-22 #f)
      (goto cfg-28)
      )
    (kill-menu self #t #f)
    (create-menu self *clan-info-screen* 0)
    (set! v1-22 #t)
    (label cfg-28)
    (when v1-22
      (suspend)
      (send-event (find-menu self 'manager) 'next #f)
      )
    (suspend-for (seconds 0.5)
      )
    (if (!= (-> *medius-my-clan* medius-id) *clan-info-id*)
        (move-to-front! *medius-recent-clans* (the-as medius-cache *clan-info-id*))
        )
    (case (-> self prev-state name)
      (('player-info-screen)
       (send-event (find-menu self 'player-list) 'deselected)
       (send-event (find-menu self 'manager) 'enable #t)
       )
      (else
        (send-event (find-menu self 'player-list) 'deselected)
        (send-event (find-menu self 'manager) 'enable #t)
        )
      )
    (send-event (find-menu self 'player-list) 'update)
    (until #f
      (cond
        (*net-mgr-pending-behavior-valid*
          )
        (else
          (until v1-77
            (suspend)
            (set! v1-77 (or (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'lobby-idle))
                            (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'playing-game))
                            )
                  )
            )
          (set! *net-mgr-pending-behavior-result* 'undefined)
          (send-event *net-mgr* 'do-behavior 'retrieve-my-clan-data)
          (while (= *net-mgr-pending-behavior-result* 'undefined)
            (suspend)
            )
          (suspend)
          *net-mgr-pending-behavior-result*
          )
        )
      (until (lookup *medius-clan-cache* *clan-info-id* 9000 #t #f)
        (suspend)
        )
      (send-event (find-menu self 'player-list) 'update)
      (suspend-for (seconds 40)
        (lobby-check-buttons
          setup-clan-info-buttons
          (-> *clan-info-button-manager* 0)
          (-> *clan-info-button-manager* 1)
          'manager
          'root
          )
        (do-pending-operation)
        (case (lookup *medius-clan-cache* *clan-info-id* 9000 #f #f)
          (('error)
           (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-2472))
           (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
           (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
           (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
           (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
           (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
           (go-virtual
             lobby-generic-error-menu
             *lobby-generic-confirmation*
             (lambda :behavior lobby-menu-manager () (go-virtual lobby-main-screen))
             (the-as (function symbol object) #f)
             #t
             #f
             #f
             )
           )
          )
        )
      )
    #f
    )
  )


;; WARN: Return type mismatch symbol vs object.
(defun setup-clan-info-buttons ((arg0 base-menu-info))
  (local-vars (a0-57 medius-incoming-clan-invite))
  (let* ((s4-0 *clan-info-id*)
         (s5-0 1)
         (v1-1 (the-as medius-cached-info-clan (lookup *medius-clan-cache* s4-0 9000 #f #f)))
         (gp-1 (the-as (array dropdown-item-info) (-> arg0 children)))
         )
    (set! (-> gp-1 length) 0)
    (if (not v1-1)
        (return (the-as object #f))
        )
    (if (= v1-1 'error)
        (return (the-as object #f))
        )
    (set! (-> gp-1 s5-0 strings-info 0 id) (text-id text-id-3364))
    (set! (-> gp-1 s5-0 name-symbol) 'stats)
    (let ((s5-1 (+ s5-0 1)))
      (cond
        ((= s4-0 (-> *medius-my-clan* medius-id))
         (when (and (!= (-> *medius-my-clan* medius-id) -1)
                    (= (-> *medius-my-clan* leader-acct-id) (-> *net-mgr* lobby-state my-account-id))
                    )
           (set! (-> gp-1 s5-1 strings-info 0 id) (text-id text-id-1981))
           (set! (-> gp-1 s5-1 name-symbol) 'disband-clan)
           (let ((v1-17 (+ s5-1 1)))
             (set! (-> gp-1 v1-17 strings-info 0 id) (text-id text-id-1978))
             (set! (-> gp-1 v1-17 name-symbol) 'edit-clan-message)
             (let ((v1-18 (+ v1-17 1)))
               (set! (-> gp-1 v1-18 strings-info 0 id) (text-id text-id-1985))
               (set! (-> gp-1 v1-18 name-symbol) 'invite-players)
               (let ((v1-19 (+ v1-18 1)))
                 (set! (-> gp-1 v1-19 strings-info 0 id) (text-id text-id-1979))
                 (set! (-> gp-1 v1-19 name-symbol) 'outgoing-invites)
                 (set! s5-1 (+ v1-19 1))
                 )
               )
             )
           )
         (when (not (and (!= (-> *medius-my-clan* medius-id) -1)
                         (= (-> *medius-my-clan* leader-acct-id) (-> *net-mgr* lobby-state my-account-id))
                         )
                    )
           (set! (-> gp-1 s5-1 strings-info 0 id) (text-id text-id-1894))
           (set! (-> gp-1 s5-1 name-symbol) 'leave-clan)
           (+! s5-1 1)
           )
         (set! (-> gp-1 s5-1 strings-info 0 id) (text-id text-id-3484))
         (set! (-> gp-1 s5-1 name-symbol) 'msg-all-members)
         (let ((v1-33 (+ s5-1 1)))
           (set! (-> gp-1 v1-33 strings-info 0 id) (text-id text-id-1982))
           (set! (-> gp-1 v1-33 name-symbol) 'clan-room)
           (let ((v1-34 (+ v1-33 1)))
             (set! (-> gp-1 v1-34 strings-info 0 id) (text-id text-id-2526))
             (set! (-> gp-1 v1-34 name-symbol) 'clan-challenges)
             (set! s5-1 (+ v1-34 1))
             )
           )
         )
        (else
          (let ((v1-37 (get-clan-challenge-pair-status
                         (-> *medius-my-clan* medius-id)
                         *clan-info-id*
                         (the-as (pointer int32) (&-> '*clan-challenge-id* value))
                         )
                       )
                )
            (dotimes (a0-53 (-> *medius-incoming-clan-invites* length))
              (when (= (-> *medius-incoming-clan-invites* a0-53 clan-id) *clan-info-id*)
                (set! a0-57 (-> *medius-incoming-clan-invites* a0-53))
                (goto cfg-25)
                )
              )
            (set! a0-57 (the-as medius-incoming-clan-invite #f))
            (label cfg-25)
            (when a0-57
              (set! (-> gp-1 s5-1 strings-info 0 id) (text-id text-id-1950))
              (set! (-> gp-1 s5-1 name-symbol) 'accept-invite)
              (let ((a0-63 (+ s5-1 1)))
                (set! (-> gp-1 a0-63 strings-info 0 id) (text-id text-id-1949))
                (set! (-> gp-1 a0-63 name-symbol) 'decline-invite)
                (set! s5-1 (+ a0-63 1))
                )
              )
            (when (and (!= (-> *medius-my-clan* medius-id) -1)
                       (= (-> *medius-my-clan* leader-acct-id) (-> *net-mgr* lobby-state my-account-id))
                       )
              (cond
                (v1-37
                  (let ((a0-72 v1-37))
                    (cond
                      ((zero? a0-72)
                       (set! (-> gp-1 s5-1 strings-info 0 id) (text-id text-id-2384))
                       (set! (-> gp-1 s5-1 name-symbol) 'revoke-challenge)
                       (+! s5-1 1)
                       )
                      ((= a0-72 1)
                       (set! (-> gp-1 s5-1 strings-info 0 id) (text-id text-id-1977))
                       (set! (-> gp-1 s5-1 name-symbol) 'accept-challenge)
                       (let ((a0-78 (+ s5-1 1)))
                         (set! (-> gp-1 a0-78 strings-info 0 id) (text-id text-id-1975))
                         (set! (-> gp-1 a0-78 name-symbol) 'refuse-challenge)
                         (set! s5-1 (+ a0-78 1))
                         )
                       )
                      ((= a0-72 2)
                       (set! (-> gp-1 s5-1 strings-info 0 id) (text-id text-id-2505))
                       (set! (-> gp-1 s5-1 name-symbol) 'revoke-challenge)
                       (+! s5-1 1)
                       )
                      ((= a0-72 3)
                       (set! (-> gp-1 s5-1 strings-info 0 id) (text-id text-id-2384))
                       (set! (-> gp-1 s5-1 name-symbol) 'revoke-challenge)
                       (+! s5-1 1)
                       )
                      )
                    )
                  )
                (else
                  (set! (-> gp-1 s5-1 strings-info 0 id) (text-id text-id-2386))
                  (set! (-> gp-1 s5-1 name-symbol) 'issue-challenge)
                  (+! s5-1 1)
                  )
                )
              )
            (when (= v1-37 3)
              (set! (-> gp-1 s5-1 strings-info 0 id) (text-id text-id-2385))
              (set! (-> gp-1 s5-1 name-symbol) 'challenge-room)
              (+! s5-1 1)
              )
            )
          )
        )
      (set! (-> gp-1 length) s5-1)
      (let ((v1-42 (+ s5-1 -1)))
        (dotimes (a0-99 (-> gp-1 length))
          (set! (-> gp-1 a0-99 left-index-modifier) (if (zero? a0-99)
                                                        80
                                                        0
                                                        )
                )
          (set! (-> gp-1 a0-99 right-index-modifier) (if (zero? a0-99)
                                                         0
                                                         81
                                                         )
                )
          (let ((a1-112 a0-99))
            (set! (-> gp-1 a0-99 up-index-modifier) (cond
                                                      ((zero? a1-112)
                                                       0
                                                       )
                                                      ((= a1-112 1)
                                                       -2
                                                       )
                                                      (else
                                                        -1
                                                        )
                                                      )
                  )
            )
          (let ((a1-114 a0-99))
            (set! (-> gp-1 a0-99 down-index-modifier) (cond
                                                        ((zero? a1-114)
                                                         0
                                                         )
                                                        ((= a1-114 v1-42)
                                                         2
                                                         )
                                                        (else
                                                          1
                                                          )
                                                        )
                  )
            )
          )
        )
      (until (= s5-1 (-> gp-1 allocated-length))
        (set! (-> gp-1 s5-1 strings-info 0 id) (text-id text-id-0))
        (set! (-> gp-1 s5-1 name-symbol) #f)
        (+! s5-1 1)
        )
      )
    (dotimes (v1-55 (-> gp-1 allocated-length))
      (set! (-> gp-1 v1-55 selection-type) (-> gp-1 v1-55 name-symbol))
      )
    )
  #f
  )


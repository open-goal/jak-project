;; WARN: Return type mismatch symbol vs object.
(defbehavior do-pending-operation lobby-menu-manager ()
  (let ((gp-0 *pending-op*))
    (when gp-0
      (when (= (logand (the-as uint #xffffffff) (-> self profile-ticks))
               (logand (the-as uint #xffffffff) *pending-op-serial*)
               )
        (format 0 "doing pending operation #x~X~%" gp-0)
        (gp-0
          (-> *pending-op-args* 0)
          (-> *pending-op-args* 1)
          (-> *pending-op-args* 2)
          (-> *pending-op-args* 3)
          (-> *pending-op-args* 4)
          (-> *pending-op-args* 5)
          (-> *pending-op-args* 6)
          (-> *pending-op-args* 7)
          )
        )
      (set! *pending-op* #f)
      #f
      )
    )
  )

;; WARN: Return type mismatch (pointer uint32) vs object.
(defun fixup-netstring ((arg0 object))
  (expand-text-to-charp!
    *common-text*
    (the-as (pointer uint8) *tmp-netconf-string*)
    (the-as (pointer uint8) arg0)
    )
  *tmp-netconf-string*
  )


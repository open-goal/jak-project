(defmethod get-room-id ((this scrolling-menu-player) (arg0 int))
  (if (or (< arg0 0) (>= arg0 (-> this players ct)))
      -1
      (get-id (-> this players data arg0))
      )
  )

(defmethod default-event-handler ((this scrolling-item-player) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (case arg2
    (('set-index)
     (let ((v0-0 (the-as object (-> arg3 param 0))))
       (set! (-> this idx) (the-as int v0-0))
       v0-0
       )
     )
    (else
      ((method-of-type scrolling-item default-event-handler) this arg0 arg1 arg2 arg3)
      )
    )
  )

(defmethod update-strings ((this scrolling-item-player))
  (call-parent-method this)
  (let ((gp-0 (ppointer->process (-> this parent))))
    (dotimes (s4-0 (-> this strings length))
      (clear (-> this strings data s4-0 text))
      )
    (when (and (>= (-> this idx) 0) (< (-> this idx) (-> (the-as scrolling-menu-player gp-0) players ct)))
      (let ((a0-10 (-> (the-as scrolling-menu-player gp-0) players data (-> this idx))))
        (expand-text-to-charp!
          *common-text*
          (-> this strings data 0 text data)
          ((method-of-type medius-player get-player-name-and-clan) (the-as medius-player a0-10))
          )
        )
      (when (-> (the-as scrolling-menu-player gp-0) info-ptr use-third-color)
        )
      )
    )
  0
  (none)
  )

(defmethod init-menu! ((this scrolling-menu-player))
  (set! (-> this players) *player-menu-array-to-use*)
  (let ((t9-0 (method-of-type scrolling-menu-medius init-menu!)))
    (t9-0 this)
    )
  (set! (-> this physical-item-ct) 0)
  (set! (-> this cur-idx) -1)

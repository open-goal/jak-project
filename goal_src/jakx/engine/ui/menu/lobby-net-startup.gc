;;-*-Lisp-*-
(in-package goal)

;; name: lobby-net-startup.gc
;; name in dgo: lobby-net-startup
;; dgos: MENU2

;; DECOMP BEGINS

;; WARN: Return type mismatch int vs object.
(defbehavior create-and-wait-menu lobby-menu-manager ((arg0 base-menu-info))
  (local-vars (v1-2 symbol))
  (dotimes (v1-0 (+ (-> self in-focus-index) 1))
    (when (and (handle->process (-> self menu-handles v1-0))
               (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-0))) info-ptr) arg0)
               )
      (set! v1-2 #t)
      (goto cfg-20)
      )
    )
  (set! v1-2 #f)
  (label cfg-20)
  (if v1-2
      (goto cfg-24)
      )
  (kill-menu self #t #f)
  (create-menu self arg0 0)
  #t
  (until (all-running? (get-in-focus-menu self))
    (label cfg-24)
    (suspend)
    )
  (dotimes (gp-1 30)
    (suspend)
    )
  0
  )

;; WARN: Return type mismatch int vs text-id.
(defun get-mc-error-text-id ((arg0 mc-status-code))
  (let ((v1-0 arg0))
    (the-as text-id (cond
                      ((= v1-0 (mc-status-code write-error))
                       (the-as text-id (text-id text-id-171))
                       )
                      ((= v1-0 (mc-status-code read-error))
                       (the-as text-id (text-id text-id-170))
                       )
                      ((= v1-0 (mc-status-code no-card))
                       (the-as text-id (text-id text-id-154))
                       )
                      ((= v1-0 (mc-status-code no-format))
                       (the-as text-id (text-id text-id-155))
                       )
                      (else
                        (the-as text-id (text-id text-id-154))
                        )
                      )
            )
    )
  )

(defmethod reset! ((this stored-network-account))
  (set! (-> this name 0) (the-as uint 0))
  (set! (-> this password 0) (the-as uint 0))
  0
  (none)
  )

(defmethod name-empty? ((this stored-network-account))
  (zero? (-> this name-s8 0))
  )

(defmethod compact! ((this stored-network-accounts))
  (let ((s4-0 0)
        (s5-0 0)
        )
    (while (< s4-0 4)
      (when (not (name-empty? (-> this accounts s4-0)))
        (mem-copy! (the-as pointer (-> this accounts s5-0)) (the-as pointer (-> this accounts s4-0)) 128)
        (if (= (-> this default-idx) s4-0)
            (set! (-> this default-idx) s5-0)
            )
        (+! s5-0 1)
        )
      (+! s4-0 1)
      )
    (set! (-> this ct) s5-0)
    (let ((s4-1 3))
      (while (>= s4-1 s5-0)
        (reset! (-> this accounts s5-0))
        (+! s5-0 1)
        )
      )
    )
  (set! (-> this default-idx) (max 0 (min (-> this default-idx) (-> this ct))))
  0
  (none)
  )

(defstate pre-game-type-menu (lobby-menu-manager)
  :virtual #t
  :code (behavior ()
    (when (beta?)
      (when (and (not *no-net-hw-warning-shown*) (!= (knet-dev9-present) 1))
        (set! *no-net-hw-warning-shown* #t)
        (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-2603))
        (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
        (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
        (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
        (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
        (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
        (go-virtual
          lobby-generic-error-menu
          *lobby-generic-confirmation*
          (lambda :behavior lobby-menu-manager () (go-virtual pre-game-type-menu))
          (the-as (function symbol object) #f)
          #t
          #f
          #f
          )
        )
      )
    (when *net-hw-initted*
      (format 0 "resetting net-mgr~%")
      (go-virtual waiting-network-hardware-shutdown 'pre-game-type-menu)
      )
    (hack-reset-state #f)
    (mem-clear! (the-as pointer *ghost-rec*) 100)
    (cond
      ((kiosk?)
       (cond
         ((= *game-mode* #f)
          (create-menu self *base-menu-info* 0)
          (go-virtual game-type-menu)
          )
         (else
           (create-menu self *base-menu-info* 0)
           (go-virtual game-type-menu)
           )
         )
       )
      ((demo?)
       (set! *game-mode* 'adventure)
       (go-virtual adventure-init)
       )
      (*first-boot*
        (set! *first-boot* #f)
        (cond
          (*debug-segment*
            (create-menu self *base-menu-info* 0)
            (go-virtual game-type-menu)
            )
          (else
            (go-virtual boot-memory-card)
            )
          )
        )
      (else
        (create-menu self *base-menu-info* 0)
        (go-virtual game-type-menu)
        )
      )
    )
  )

(deftype scrolling-netconfig-item (scrolling-item)
  ()
  )


(deftype scrolling-netconfig-menu (scrolling-menu)
  ((valid-indices  int8  16)
   )
  )


(defmethod default-event-handler ((this scrolling-netconfig-item) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (case arg2
    (('set-index)
     (dotimes (s4-0 (-> this strings length))
       (clear (-> this strings data s4-0 text))
       )
     (let ((s5-1 (-> arg3 param 0))
           (v1-8 (-> this parent 0))
           )
       0
       (if (or (< (the-as int s5-1) 0)
               (>= (the-as int s5-1) (-> (the-as scrolling-netconfig-menu v1-8) physical-item-ct))
               )
           (return #f)
           )
       (let ((s4-1 (-> (the-as scrolling-netconfig-menu v1-8) valid-indices s5-1)))
         (copy-charp<-charp *medius-policy-buffer* (-> *eznet-list* list s4-1 ifc-name))
         (set! (-> *medius-policy-buffer* 30) (the-as uint 0))
         (format (-> this strings data 0 text) "~D. ~G" (+ s5-1 1) (fixup-netstring *medius-policy-buffer*))
         (format (-> this strings data 1 text) "~G" (fixup-netstring (-> *eznet-list* list s4-1 dev-name)))
         )
       )
     )
    (else
      ((method-of-type scrolling-item default-event-handler) this arg0 arg1 arg2 arg3)
      )
    )
  )

(defmethod update-strings ((this scrolling-netconfig-item))
  (cond
    ((-> this selected)
     (set! (-> this strings data 0 color) (-> this info-ptr strings-info 0 font-color-2))
     (set! (-> this strings data 0 scale) 0.6)
     (set! (-> this strings data 1 color) (-> this info-ptr strings-info 1 font-color-2))
     (set! (-> this strings data 1 scale) 0.5)
     )
    (else
      (set! (-> this strings data 0 color) (-> this info-ptr strings-info 0 font-color))
      (set! (-> this strings data 0 scale) 0.6)
      (set! (-> this strings data 1 color) (-> this info-ptr strings-info 1 font-color))
      (set! (-> this strings data 1 scale) 0.5)
      )
    )
  0
  (none)
  )

(defmethod init-menu! ((this scrolling-netconfig-menu))
  (let ((t9-0 (method-of-type scrolling-menu init-menu!)))
    (t9-0 this)
    )
  (set! *eznet-list* (the-as eznet-combination-list (knet-eenet-get-config-list)))
  (set! (-> this physical-item-ct) 0)
  (set! (-> this cur-idx) 0)
  (dotimes (v1-1 (min 10 (-> *eznet-list* length)))
    (let ((a0-2 v1-1))
      (when (>= (-> *eznet-list* list a0-2 status) 0)
        (if (= a0-2 (+ (-> *eznet-list* default) -1))
            (set! (-> this cur-idx) (-> this physical-item-ct))
            )
        (set! (-> this valid-indices (-> this physical-item-ct)) a0-2)
        (+! (-> this physical-item-ct) 1)
        )
      )
    )
  (set! (-> this top-idx) (-> this cur-idx))
  (set! (-> this top-idx)
        (max 0 (min (-> this top-idx) (- (-> this physical-item-ct) (-> this info-ptr visible-item-ct))))
        )
  (scrolling-menu-method-74 this)
  (scrolling-menu-method-73 this (-> this cur-idx) #f)
  0
  (none)
  )

(defmethod scrolling-menu-method-73 ((this scrolling-netconfig-menu) (arg0 int) (arg1 symbol))
  (set! *net-hw-config-id* (+ (-> this valid-indices arg0) 1))
  ((method-of-type scrolling-menu scrolling-menu-method-73) this arg0 arg1)
  (none)
  )


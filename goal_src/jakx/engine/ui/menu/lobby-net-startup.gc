(define *user-accounts-valid* #f)

(defstate waiting-network-config-list (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('notify)
       (case (-> block param 0)
         (('done)
          (case (-> block param 1)
            ((1)
             (let ((v0-0 (the-as object #t)))
               (set! *user-accounts-valid* (the-as symbol v0-0))
               v0-0
               )
             )
            (else
              (set! *user-accounts-valid* #f)
              #f
              )
            )
          )
         (('error)
          (set! *user-accounts-valid* #f)
          #f
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (kill-menu self #t #f)
    )
  :code (behavior ()
    (until (no-menus-dying? self)
      (suspend)
      )
    (kill-by-type fmv-player *active-pool*)
    (suspend)
    (suspend)
    (when (!= (knet-dev9-present) 1)
      (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-2603))
      (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
      (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
      (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
      (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
      (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
      (go-virtual
        lobby-generic-error-menu
        *lobby-generic-confirmation*
        (lambda :behavior lobby-menu-manager () (go-virtual pre-game-type-menu))
        (the-as (function symbol object) #f)
        #t
        #f
        #f
        )
      )
    (when (not *debug-segment*)
      (auto-save-command 'restore-common 0 0 self #f #f)
      (set! *user-accounts-valid* 'undefined)
      (while (= *user-accounts-valid* 'undefined)
        (suspend)
        )
      (when (not *user-accounts-valid*)
        (set! (-> self split-selection-prev-state) 'waiting-network-config-list)
        (go-virtual no-card)
        )
      )
    (let ((gp-1 (net-hw-start-part1)))
      (when (= *net-hw-last-error* -15)
        (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-2596))
        (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1712))
        (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1926))
        (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-3020))
        (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
        (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
        (go-virtual
          lobby-generic-error-menu
          *lobby-generic-confirmation*
          (lambda :behavior lobby-menu-manager () (go-virtual go-net-config-util 2))
          (the-as (function symbol object) (lambda :behavior lobby-menu-manager () (go-virtual pre-game-type-menu)))
          #f
          #f
          #f
          )
        )
      (when (not gp-1)
        (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-2431))
        (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1712))
        (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1926))
        (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-3020))
        (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
        (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
        (go-virtual
          lobby-generic-error-menu
          *lobby-generic-confirmation*
          (lambda :behavior lobby-menu-manager () (go-virtual go-net-config-util 2))
          (the-as (function symbol object) (lambda :behavior lobby-menu-manager () (go-virtual pre-game-type-menu)))
          #f
          #f
          #f
          )
        )
      )
    (set! *eznet-list* (the-as eznet-combination-list (knet-eenet-get-config-list)))
    (go-virtual choose-network-config)
    )
  )

(defstate choose-network-config (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('menu-selection-event)
       (case (-> block param 0)
         (('cancel)
          (set! *net-hw-config-id* 0)
          (if (kill-menu self #f #f)
              (go-virtual pre-game-type-menu)
              )
          )
         (('accept)
          (if (kill-menu self #f #f)
              (go-virtual waiting-network-hardware)
              )
          )
         (('square)
          (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-2429))
          (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1712))
          (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1926))
          (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-3020))
          (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
          (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
          (go-virtual
            lobby-generic-error-menu
            *lobby-generic-confirmation*
            (lambda :behavior lobby-menu-manager () (go-virtual go-net-config-util 2))
            (the-as (function symbol object) (lambda :behavior lobby-menu-manager () (go-virtual choose-network-config)))
            #f
            #f
            #f
            )
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (local-vars (v1-16 symbol))
    (when (and *lobby-fast-connect*
               (> (-> *eznet-list* length) 0)
               (>= (-> *eznet-list* default) 0)
               (< (-> *eznet-list* default) (-> *eznet-list* length))
               )
      (set! *net-hw-config-id* (-> *eznet-list* default))
      (go-virtual waiting-network-hardware)
      )
    (dotimes (v1-14 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-14))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-14))) info-ptr) *choose-network-config*)
                 )
        (set! v1-16 #t)
        (goto cfg-29)
        )
      )
    (set! v1-16 #f)
    (label cfg-29)
    (if v1-16
        (return #f)
        )
    (kill-menu self #t #f)
    (create-menu self *choose-network-config* 0)
    #t
    )
  :code sleep-code
  :post lobby-default-post
  )

(defstate go-net-config-util (lobby-menu-manager)

(define *fake-mc-stream* (new 'static 'file-stream))

(define *fake-mc-filename* "fake-mc.bin")

;; WARN: Return type mismatch int vs object.
(defun fake-mc-cmd ((arg0 symbol) (arg1 process))
  0
  (case arg0
    (('restore-common)
     (file-stream-open *fake-mc-stream* *fake-mc-filename* 'read)
     (when (!= (file-stream-length *fake-mc-stream*) 1024)
       (file-stream-close *fake-mc-stream*)
       (mem-clear! (the-as pointer *mc-common-data*) 1024)
       (fake-mc-cmd 'save-common (the-as process #f))
       (file-stream-open *fake-mc-stream* *fake-mc-filename* 'read)
       )
     (let ((s5-1 (file-stream-read *fake-mc-stream* (the-as pointer *mc-common-data*) 1024)))
       (file-stream-close *fake-mc-stream*)
       (if (= s5-1 1024)
           (send-event arg1 'notify 'done (mc-status-code ok))
           (send-event arg1 'notify 'error)
           )
       )
     )
    (('save-common)
     (file-stream-open *fake-mc-stream* *fake-mc-filename* 'write)
     (let ((s5-2 (file-stream-write *fake-mc-stream* (the-as pointer *mc-common-data*) (the-as uint 1024))))
       (file-stream-close *fake-mc-stream*)
       (if (= s5-2 1024)
           (send-event arg1 'notify 'done (mc-status-code ok))
           (send-event arg1 'notify 'error)
           )
       )
     )
    )
  0
  )

(define *lobby-mc-ok-function* (the-as (function object) #f))

(define *lobby-mc-error-function* (the-as (function object object) #f))

(defstate waiting-mc (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('notify)
       (case (-> block param 0)
         (('done)
          (case (-> block param 1)
            ((1)
             (kill-menu self #f #f)
             (*lobby-mc-ok-function*)
             )
            (else
              (*lobby-mc-error-function* (-> block param 1))
              )
            )
          )
         (('error)
          (*lobby-mc-error-function* (-> block param 0))
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :code (behavior ((arg0 base-menu-info) (arg1 (function object)) (arg2 (function object object)) (arg3 symbol) (arg4 symbol))
    (when arg3
      (until (not (kill-menu self #t #f))
        (empty)
        )
      )
    (suspend)
    (set! *lobby-mc-ok-function* arg1)
    (set! *lobby-mc-error-function* arg2)
    (when arg0
      (create-menu self arg0 0)
      (until (all-running? (get-in-focus-menu self))
        (suspend)
        )
      (dotimes (s5-1 30)
        (suspend)
        )
      )
    (if *debug-segment*
        (fake-mc-cmd arg4 self)
        (auto-save-command arg4 0 0 self #f #f)
        )
    (until #f
      (suspend)
      )
    #f
    )
  )


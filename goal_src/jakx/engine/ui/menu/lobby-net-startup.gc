(defstate waiting-network-hardware-shutdown (lobby-menu-manager)
  :virtual #t
  :enter (behavior ((arg0 symbol))
    (kill-menu self #t #f)
    (create-menu self *waiting-network-hardware-shutdown* 0)
    )
  :code (behavior ((arg0 symbol))
    (until (all-running? (get-in-focus-menu self))
      (suspend)
      )
    (dotimes (s5-0 30)
      (suspend)
      )
    (format 0 "resetting net-mgr~%")
    (hack-reset-state #t)
    (format 0 "reset complete~%")
    (kill-menu self #f #f)
    (cond
      ((= arg0 'waiting-network-config-list)
       (go-virtual waiting-network-config-list)
       )
      ((= arg0 'pre-game-type-menu)
       (go-virtual pre-game-type-menu)
       )
      )
    )
  )


;; WARN: Return type mismatch int vs object.
(defbehavior start-logging-on lobby-menu-manager ()
  (case (-> self game-connection-type)
    ((2)
     (if (zero? (-> *medius-account-password* data 0))
         (go-virtual entering-password)
         (go-virtual internet-connect)
         )
     )
    ((1)
     (go-virtual lan-connect)
     )
    )
  0
  )

(defstate choose-account (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('menu-selection-event)
       (case (-> block param 0)
         (('cancel)
          (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-3746))
          (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1712))
          (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-3884))
          (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-3883))
          (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
          (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
          (go-virtual
            lobby-generic-error-menu
            *lobby-generic-confirmation*
            (lambda :behavior lobby-menu-manager () (go-virtual pre-game-type-menu))
            (the-as (function symbol object) (lambda :behavior lobby-menu-manager () (go-virtual choose-account)))
            #f
            #f
            #f
            )
          )
         (('accept)
          (let ((gp-0 (-> block param 2)))
            (cond
              ((< (the-as int gp-0) (-> *mc-common-data* net-accounts ct))
               (copy-charp<-charp
                 (-> *medius-account-name* data)
                 (the-as (pointer uint8) (+ (the-as uint (-> *mc-common-data* net-accounts)) (* gp-0 128)))
                 )
               (copy-charp<-charp
                 (-> *medius-account-password* data)
                 (-> *mc-common-data* net-accounts accounts gp-0 password)
                 )
               (when (kill-menu self #f #f)
                 (when (-> *setting-control* user-current auto-save)
                   (set! (-> *mc-common-data* net-accounts default-idx) (the-as int gp-0))
                   (go-virtual
                     waiting-mc
                     (the-as base-menu-info #f)
                     (lambda :behavior lobby-menu-manager () (start-logging-on))
                     (the-as (function object object) (lambda :behavior lobby-menu-manager
                                                        ()
                                                        (set! (-> self split-selection-prev-state) 'choose-account)
                                                        (go-virtual no-card)
                                                        )
                             )
                     #f
                     'save-common
                     )
                   (return #f)
                   )
                 (start-logging-on)
                 )
               )
              (else
                (reset! *edit-stored-network-account*)
                (set! *edit-stored-network-account-idx* -1)
                (go-virtual edit-account)
                )
              )
            )
          )
         (('square)
          (let ((gp-1 (-> block param 2)))
            (when (< (the-as int gp-1) (-> *mc-common-data* net-accounts ct))
              (mem-copy!
                (the-as pointer *edit-stored-network-account*)
                (the-as pointer (-> *mc-common-data* net-accounts accounts gp-1))
                128
                )
              (set! *edit-stored-network-account-idx* (the-as int gp-1))
              (go-virtual edit-account)
              )
            )
          )
         (('circle)
          (let ((gp-2 (-> block param 2)))
            (when (< (the-as int gp-2) (-> *mc-common-data* net-accounts ct))
              (mem-copy!
                (the-as pointer *edit-stored-network-account*)
                (the-as pointer (-> *mc-common-data* net-accounts accounts gp-2))
                128
                )
              (set! *edit-stored-network-account-idx* (the-as int gp-2))
              (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-1706))
              (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1712))
              (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1926))
              (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-3020))
              (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
              (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
              (go-virtual
                lobby-generic-error-menu
                *lobby-generic-confirmation*
                (lambda :behavior lobby-menu-manager
                  ()
                  (kill-menu self #t #f)
                  (set! (-> *mc-common-data* net-accounts accounts *edit-stored-network-account-idx* name 0) (the-as uint 0))
                  (compact! (-> *mc-common-data* net-accounts))
                  (go-virtual saving-accounts #f)
                  )
                (the-as (function symbol object) (lambda :behavior lobby-menu-manager () (go-virtual choose-account)))
                #f
                #f
                #f
                )
              )
            )
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (local-vars (v1-29 symbol))
    (compact! (-> *mc-common-data* net-accounts))
    (if (not (handle->process (-> self vehicle-handle)))
        (set! (-> self vehicle-selected)
              (-> *game-info* player-info (-> self current-local-player) last-selected-vehicle)
              )
        )
    (when *lobby-fast-connect*
      (set! *lobby-fast-connect* #f)
      (let ((gp-0 (-> *mc-common-data* net-accounts default-idx)))
        (when (and (>= (-> *mc-common-data* net-accounts ct) 1)
                   (< gp-0 (-> *mc-common-data* net-accounts ct))
                   (= (-> self game-connection-type) 2)
                   )
          (copy-charp<-charp
            (-> *medius-account-name* data)
            (the-as (pointer uint8) (+ (the-as uint (-> *mc-common-data* net-accounts)) (* gp-0 128)))
            )
          (copy-charp<-charp
            (-> *medius-account-password* data)
            (-> *mc-common-data* net-accounts accounts gp-0 password)
            )
          (start-logging-on)
          )
        )
      )
    (dotimes (v1-27 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-27))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-27))) info-ptr) *choose-account*)
                 )
        (set! v1-29 #t)
        (goto cfg-35)
        )
      )
    (set! v1-29 #f)
    (label cfg-35)
    (if v1-29
        (return #f)
        )
    (kill-menu self #t #f)
    (create-menu self *choose-account* 0)
    #t
    )
  :code sleep-code
  :post lobby-default-post
  )

(deftype edit-account-selection-manager (selection-menu-manager)
  ()
  )


(deftype editable-selection (dropdown-item)
  ((disabled        symbol  :offset 596)
   (keyboard-flags  keyboard-control-flag)
   (max-chars       int32)
   (text            (pointer int8))
   )
  )


(defmethod update-strings ((this editable-selection))
  (let ((t9-0 (method-of-type string-menu update-strings)))
    (t9-0 this)
    )
  (if (and (-> this text) (nonzero? (-> this text 0)))
      (expand-text-to-charp!
        *common-text*
        (-> this strings data 0 text data)
        (the-as (pointer uint8) (-> this text))
        )
      (copy-string<-string (-> this strings data 0 text) "---")
      )
  0
  (none)
  )

(defmethod init-menu! ((this editable-selection))
  (set! (-> this selected) #f)
  (set! (-> this disabled) #f)
  (set! (-> this text) (the-as (pointer int8) #f))
  (let ((v1-1 (-> this info-ptr name-symbol)))
    (cond
      ((= v1-1 'name)
       (cond
         ((= (scf-get-territory) 1)
          (set! (-> this keyboard-flags) (keyboard-control-flag allow-space restrict-chars no-symbols))
          (set! (-> this max-chars) 14)
          )
         (else
           (set! (-> this keyboard-flags) (keyboard-control-flag restrict-chars))
           (set! (-> this max-chars) 15)
           )
         )
       )
      ((= (scf-get-territory) 1)
       (set! (-> this keyboard-flags)
             (keyboard-control-flag allow-space allow-multiple-spaces allow-leading-space restrict-chars-alt no-symbols)
             )
       (set! (-> this max-chars) 14)
       )
      (else
        (set! (-> this keyboard-flags) (keyboard-control-flag restrict-chars))
        (set! (-> this max-chars) 15)
        )
      )
    )
  (call-parent-method this)
  (none)
  )

(defmethod handle-input ((this editable-selection) (arg0 int))
  (with-pp
    (if (get-keyboard-control)
        (return #f)
        )
    (if (cpad-or-kbd-pressed-var? (the-as uint arg0) (pad-buttons x))
        (keyboard-control-spawn (-> this max-chars) pp (-> this keyboard-flags) (the-as (pointer uint8) #f))
        ((method-of-type dropdown-item handle-input) this arg0)
        )
    )
  )

(defstate running (editable-selection)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('notify)
       (case (-> block param 0)
         (('done)
          (copy-charp<-charp (the-as (pointer uint8) (-> self text)) (-> (the-as string (-> block param 1)) data))
          (if (= (-> self info-ptr selection-type) 'password)
              (send-event *lobby-menu-manager* 'set-password)
              )
          )
         )
       )
      (else
        (base-menu-event-handler proc argc message block)
        )
      )
    )
  )

;; WARN: Return type mismatch (pointer uint8) vs none.
(defmethod init-menu! ((this edit-account-selection-manager))
  (call-parent-method this)
  (let ((v1-2 (handle->process (-> this child-handles 0))))
    (set! (-> (the-as editable-selection v1-2) text)
          (the-as (pointer int8) (-> *edit-stored-network-account* name))
          )
    )
  (let ((v1-6 (handle->process (-> this child-handles 2))))
    (set! (-> (the-as editable-selection v1-6) text)
          (the-as (pointer int8) (-> *edit-stored-network-account* password))
          )
    )
  (none)
  )

(deftype dropdown-button (dropdown-item)
  ()
  )


(deftype non-accepting-item-list-selection (item-list-selection)
  ()
  )


(defmethod handle-input ((this non-accepting-item-list-selection) (arg0 int))
  (if (cpad-or-kbd-pressed-var? (the-as uint arg0) (pad-buttons x))
      (return #f)
      )
  (call-parent-method this arg0)
  )


(defstate entering-password (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('notify)
       (case (-> block param 0)
         (('done)
          (copy-charp<-charp (-> *medius-account-password* data) (-> (the-as string (-> block param 1)) data))
          (when (< (strlen (-> *medius-account-password* data)) 6)
            (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-1710))
            (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
            (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
            (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
            (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
            (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
            (go-virtual
              lobby-generic-error-menu
              *lobby-generic-confirmation*
              (lambda :behavior lobby-menu-manager () (go-virtual entering-password))
              (the-as (function symbol object) #f)
              #t
              #f
              #f
              )
            (return #f)
            )
          (go-virtual internet-connect)
          )
         (else
           (go-virtual choose-account)
           )
         )
       )
      )
    )
  :enter (behavior ()
    (local-vars (v1-3 symbol))
    (copy-charp<-charp *enter-pw-acct-name* (-> *medius-account-name* data))
    (dotimes (v1-1 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-1))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-1))) info-ptr) *entering-password*)
                 )
        (set! v1-3 #t)
        (goto cfg-20)
        )
      )
    (set! v1-3 #f)
    (label cfg-20)
    (if v1-3
        (goto cfg-24)
        )
    (kill-menu self #t #f)
    (create-menu self *entering-password* 0)
    #t
    (label cfg-24)
    (keyboard-control-spawn 12 self (keyboard-control-flag) (the-as (pointer uint8) #f))
    )
  :exit (behavior ()
    (kill-keyboard-control)
    )
  :code sleep-code
  )


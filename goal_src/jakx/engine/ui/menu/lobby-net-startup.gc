(defstate edit-account (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('set-password)
       (let ((a0-2 (find-menu *lobby-menu-manager* 'manager)))
         (if a0-2
             (select-by-sym (the-as selection-menu-manager a0-2) 'ok-button)
             )
         )
       (format #t "password-set~%")
       )
      (('menu-selection-event)
       (case (-> block param 0)
         (('cancel)
          (go-virtual choose-account)
          )
         (('accept)
          (cond
            ((= (scf-get-territory) 1)
             (cond
               ((< (strlen (-> *edit-stored-network-account* name)) 2)
                (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-4021))
                (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
                (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
                (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
                (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
                (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
                (go-virtual
                  lobby-generic-error-menu
                  *lobby-generic-confirmation*
                  (lambda :behavior lobby-menu-manager () (go-virtual edit-account))
                  (the-as (function symbol object) #f)
                  #t
                  #f
                  #f
                  )
                (return #f)
                )
               ((= (-> *edit-stored-network-account* name-s8 (+ (strlen (-> *edit-stored-network-account* name)) -1)) 32)
                (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-2600))
                (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
                (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
                (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
                (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
                (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
                (go-virtual
                  lobby-generic-error-menu
                  *lobby-generic-confirmation*
                  (lambda :behavior lobby-menu-manager () (go-virtual edit-account))
                  (the-as (function symbol object) #f)
                  #t
                  #f
                  #f
                  )
                (return #f)
                )
               ((and (zero? (-> *menu-yes-no-array* selection-index))
                     (< (strlen (-> *edit-stored-network-account* password)) 6)
                     )
                (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-4020))
                (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
                (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
                (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
                (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
                (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
                (go-virtual
                  lobby-generic-error-menu
                  *lobby-generic-confirmation*
                  (lambda :behavior lobby-menu-manager () (go-virtual edit-account))
                  (the-as (function symbol object) #f)
                  #t
                  #f
                  #f
                  )
                (return #f)
                )
               )
             )
            (else
              (cond
                ((< (strlen (-> *edit-stored-network-account* name)) 5)
                 (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-1708))
                 (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
                 (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
                 (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
                 (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
                 (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
                 (go-virtual
                   lobby-generic-error-menu
                   *lobby-generic-confirmation*
                   (lambda :behavior lobby-menu-manager () (go-virtual edit-account))
                   (the-as (function symbol object) #f)
                   #t
                   #f
                   #f
                   )
                 (return #f)
                 )
                ((= (-> *edit-stored-network-account* name-s8 (+ (strlen (-> *edit-stored-network-account* name)) -1)) 32)
                 (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-2600))
                 (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
                 (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
                 (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
                 (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
                 (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
                 (go-virtual
                   lobby-generic-error-menu
                   *lobby-generic-confirmation*
                   (lambda :behavior lobby-menu-manager () (go-virtual edit-account))
                   (the-as (function symbol object) #f)
                   #t
                   #f
                   #f
                   )
                 (return #f)
                 )
                ((and (zero? (-> *menu-yes-no-array* selection-index))
                      (< (strlen (-> *edit-stored-network-account* password)) 6)
                      )
                 (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-1710))
                 (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
                 (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
                 (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
                 (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
                 (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
                 (go-virtual
                   lobby-generic-error-menu
                   *lobby-generic-confirmation*
                   (lambda :behavior lobby-menu-manager () (go-virtual edit-account))
                   (the-as (function symbol object) #f)
                   #t
                   #f
                   #f
                   )
                 (return #f)
                 )
                )
              )
            )
          (when (= (-> *menu-yes-no-array* selection-index) 1)
            (set! (-> *edit-stored-network-account* password 0) (the-as uint 0))
            0
            )
          (update-stored-network-account)
          (go-virtual saving-accounts #t)
          )
         (('save-password)
          (case (-> block param 1)
            (('next)
             (next-selection self *menu-yes-no-array*)
             )
            (('previous)
             (prev-selection self *menu-yes-no-array*)
             )
            )
          (let ((a0-68 (find-menu self 'password))
                (a1-13 (new 'stack-no-clear 'event-message-block))
                )
            (set! (-> a1-13 from) (process->ppointer self))

            (the-as (function symbol object) (lambda :behavior lobby-menu-manager () (go-virtual showing-policy)))
            #f
            #f
            #f
            )
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (set! (-> self vehicle-selected) (the-as uint -1))

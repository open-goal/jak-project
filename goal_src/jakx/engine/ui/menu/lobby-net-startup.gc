(defstate showing-announcements (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (lobby-menu-manager-default-handler proc argc message block)
    )
  :enter (behavior ((arg0 symbol))
    (set! (-> self vehicle-selected) (the-as uint -1))
    )
  :exit (behavior ()
    (set! (-> self vehicle-selected)
          (-> *game-info* player-info (-> self current-local-player) last-selected-vehicle)
          )
    )
  :code (behavior ((arg0 symbol))
    (local-vars (v1-9 object) (v1-33 symbol))
    (let ((v1-0 #t)
          (gp-0 #f)
          )
      (while v1-0
        (let ((v1-2 (cond
                      (*net-mgr-pending-behavior-valid*
                        #f
                        )
                      (else
                        (until v1-9
                          (suspend)
                          (set! v1-9 (or (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'lobby-idle))
                                         (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'playing-game))
                                         )
                                )
                          )
                        (set! *net-mgr-pending-behavior-result* 'undefined)
                        (send-event *net-mgr* 'do-behavior 'get-announcements)
                        (while (= *net-mgr-pending-behavior-result* 'undefined)
                          (suspend)
                          )
                        (suspend)
                        *net-mgr-pending-behavior-result*
                        )
                      )
                    )
              )
          (if (!= v1-2 'success)
              (goto cfg-75)
              )
          )
        (if (<= *medius-policy-length* 0)
            (goto cfg-75)
            )
        (set! gp-0 #t)
        (dotimes (v1-31 (+ (-> self in-focus-index) 1))
          (when (and (handle->process (-> self menu-handles v1-31))
                     (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-31))) info-ptr) *showing-announcements*)
                     )
            (set! v1-33 #t)
            (goto cfg-44)
            )
          )
        (set! v1-33 #f)
        (label cfg-44)
        (if v1-33
            (goto cfg-48)
            )
        (kill-menu self #t #f)
        (create-menu self *showing-announcements* 0)
        #t
        (label cfg-48)
        (format 0 "policy length ~D~%" *medius-policy-length*)
        (dotimes (s4-0 *medius-policy-length*)
          (expand-text-to-charp!
            *common-text*
            (-> *medius-policy-string* data)
            (&+ *medius-policy-buffer* (* 1000 s4-0))
            )
          (let ((a0-27 (as-type (find-menu self 'announce) big-text-menu)))
            (when a0-27
              (set! (-> a0-27 vert-offset) 0.0)
              (set-text! a0-27 "" *medius-policy-string2*)
              )
            )
          (dotimes (s3-1 15)
            (suspend)
            )
          (let ((a0-30 (as-type (find-menu self 'announce) big-text-menu)))
            (when a0-30
              (set! (-> a0-30 vert-offset) 0.0)
              (set-text! a0-30 *medius-policy-string* *medius-policy-string2*)
              )
            )
          (until #f
            (suspend)
            (cond
              ((cpad-or-kbd-pressed-var? (the-as uint 0) (pad-buttons x))
               (goto cfg-70)
               )
              ((or (cpad-or-kbd-pressed-var? (the-as uint 0) (pad-buttons square))
                   (cpad-or-kbd-pressed-var? (the-as uint 0) (pad-buttons triangle))
                   )
               (goto cfg-75)
               )
              )
            )
          #f
          (label cfg-70)
          (format 0 "next...~%")
          )
        (set! v1-0 #f)
        )
      (label cfg-75)
      (set! arg0 (and (not gp-0) arg0))
      )
    (when arg0
      (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-3821))
      (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
      (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
      (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
      (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
      (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
      (go-virtual
        lobby-generic-error-menu
        *lobby-generic-confirmation*
        (lambda :behavior lobby-menu-manager () (go-virtual host-join-menu))
        (the-as (function symbol object) #f)
        #t
        #f
        #f
        )
      )
    (cond
      ((= (-> self prev-state name) 'connecting-to-lobby)
       (kill-menu self #t #f)
       (create-menu self *num-local-players-menu* 0)
       (go-virtual num-local-players)
       )
      (else
        (go-virtual host-join-menu)
        )
      )
    (return #f)
    )
  :post (behavior ()
    (cond
      ((cpad-hold? 0 down)
       (let ((v1-6 (as-type (find-menu self 'announce) big-text-menu)))
         (if v1-6
             (set! (-> (the-as big-text-menu v1-6) vert-offset)
                   (fmax
                     (+ -1.0 (-> (the-as big-text-menu v1-6) vert-offset))
                     (the float
                          (min
                            0
                            (- (-> (the-as big-text-menu v1-6) info-ptr height) (the int (-> (the-as big-text-menu v1-6) vert-extent)))
                            )
                          )
                     )
                   )
             )
         )
       )
      ((cpad-hold? 0 up)
       (let ((v1-13 (as-type (find-menu self 'announce) big-text-menu)))
         (if v1-13
             (set! (-> (the-as big-text-menu v1-13) vert-offset)
                   (fmin 0.0 (+ 1.0 (-> (the-as big-text-menu v1-13) vert-offset)))
                   )
             )
         )
       )
      )
    (lobby-default-post)
    )
  )


(defstate anti-cheat (lobby-menu-manager)
  :virtual #t
  :trans (behavior ()
    (when (cpad-or-kbd-pressed-var? (the-as uint 0) (pad-buttons x))
      (kill-menu self #t #f)
      (go-virtual pre-game-type-menu)
      )
    )
  :code (behavior ()
    (local-vars (v1-7 symbol))
    (kill-menu self #f #f)
    (until (no-menus-dying? self)
      (suspend)
      )
    (dotimes (v1-5 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-5))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-5))) info-ptr) *anti-cheat*)
                 )
        (set! v1-7 #t)
        (goto cfg-22)
        )
      )
    (set! v1-7 #f)
    (label cfg-22)
    (if v1-7
        (goto cfg-26)
        )
    (kill-menu self #t #f)
    (create-menu self *anti-cheat* 0)
    #t
    (label cfg-26)
    (set! (-> *medius-policy-buffer* *medius-policy-length*) (the-as uint 0))
    (expand-text-to-charp!
      *common-text*
      (-> *medius-policy-string* data)
      (the-as (pointer uint8) *sys-msg-cheat*)
      )
    (let ((a0-23 (as-type (find-menu self 'text) big-text-menu)))
      (if a0-23
          (set-text! (the-as big-text-menu a0-23) *medius-policy-string* *medius-policy-string2*)
          )
      )
    (sleep-code)
    )
  )

(defstate loading-accounts (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('notify)
       (case (-> block param 0)
         (('done)
          (case (-> block param 1)
            ((1)
             (go-virtual choose-account)
             )
            (else
              (set! (-> self split-selection-prev-state) 'loading-accounts)
              (go-virtual no-card)
              )
            )
          )
         (('error)
          (set! (-> self split-selection-prev-state) 'loading-accounts)
          (go-virtual no-card)
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :code (behavior ()
    (if *debug-segment*
        (fake-mc-cmd 'restore-common self)
        (auto-save-command 'restore-common 0 0 self #f #f)
        )
    (until #f
      (suspend)
      )
    #f
    )
  )

(defbehavior check-mc-during-error lobby-menu-manager ()
  (mc-get-slot-info 0 *progress-save-info*)
  (if (or (zero? (-> *progress-save-info* handle))
          (zero? (-> *progress-save-info* formatted))
          (zero? (-> *progress-save-info* inited))
          )
      (go-virtual no-card)
      )
  )

(defstate saving-accounts (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (format 0 "got msg ~X ~X~%" message (-> block param 1))
    (case message
      (('notify)
       (case (-> block param 0)
         (('done)
          (case (-> block param 1)
            ((1)
             (go-virtual choose-account)
             )
            (else
              (set! (-> self split-selection-prev-state) 'saving-accounts)
              (go-virtual no-card)
              )
            )
          )
         (('error)
          (set! (-> self split-selection-prev-state) 'saving-accounts)
          (go-virtual no-card)
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :code (behavior ((arg0 symbol))
    (suspend)
    (suspend)
    (if (-> *setting-control* user-current auto-save)
        (set! arg0 #f)
        )
    (when arg0
      (set! (-> self split-selection-prev-state) (-> self state name))
      (set! *lobby-error-trans* check-mc-during-error)
      (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-4925))
      (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-129))
      (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
      (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
      (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
      (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
      (go-virtual
        lobby-generic-error-menu
        *lobby-generic-confirmation*
        (lambda :behavior lobby-menu-manager () (go-virtual saving-accounts #f))
        (the-as (function symbol object) (lambda :behavior lobby-menu-manager () (go-virtual choose-account)))
        #f
        #f
        #f
        )
      )
    (if *debug-segment*
        (fake-mc-cmd 'save-common self)
        (auto-save-command 'save-common 0 0 self #f #f)
        )
    (until #f
      (suspend)
      )
    #f
    )
  )

(defstate saving-password-online (lobby-menu-manager)
  :virtual #t
  :event lobby-menu-manager-default-handler
  :code (behavior ()
    (local-vars (v1-8 object))
    (let ((v1-1 (cond
                  (*net-mgr-pending-behavior-valid*
                    #f
                    )
                  (else
                    (until v1-8
                      (suspend)
                      (set! v1-8 (or (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'lobby-idle))
                                     (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'playing-game))
                                     )
                            )
                      )
                    (set! *net-mgr-pending-behavior-result* 'undefined)
                    (send-event *net-mgr* 'do-behavior 'do-change-password *medius-new-account-password*)
                    (while (= *net-mgr-pending-behavior-result* 'undefined)
                      (suspend)
                      )
                    (suspend)
                    *net-mgr-pending-behavior-result*
                    )
                  )
                )
          (a0-4 (the-as object 'success))
          )
      (when (!= v1-1 (the-as symbol a0-4))
        (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-2468))
        (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
        (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
        (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
        (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
        (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
        enter-state
        (set! a0-4 *lobby-generic-confirmation*)
        (go-virtual
          lobby-generic-error-menu
          (the-as base-menu-info a0-4)
          (lambda :behavior lobby-menu-manager () (go-virtual lobby-main-screen))
          (the-as (function symbol object) #f)
          #t
          #f
          #f
          )
        )
      (go-virtual saving-password (the-as symbol a0-4))
      )
    )
  )

(defstate saving-password (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (local-vars (v0-1 object))
    (case message
      (('notify)
       (case (-> block param 0)
         (('done)
          (case (-> block param 1)
            ((1)
             (go-virtual lobby-main-screen)
             (return #f)
             v0-1
             )
            (else
              (set! (-> self split-selection-prev-state) 'saving-password)
              (go-virtual no-card)
              )
            )
          )
         (('error)
          (set! (-> self split-selection-prev-state) 'saving-password)
          (go-virtual no-card)
          )
         )
       )
      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :code (behavior ((arg0 symbol))
    (suspend)
    (suspend)
    (if (-> *setting-control* user-current auto-save)
        (set! arg0 #f)
        )
    (when arg0
      (set! (-> self split-selection-prev-state) (-> self state name))
      (set! *lobby-error-trans* check-mc-during-error)
      (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-4926))
      (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-129))
      (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))
      (set! (-> *lobby-generic-error-bottom-text-ids3* 0) (text-id text-id-1712))
      (set! (-> *lobby-generic-error-bottom-text-ids4* 0) (text-id text-id-1712))
      (set! (-> *lobby-generic-error-bottom-text-ids5* 0) (text-id text-id-1712))
      (go-virtual
        lobby-generic-error-menu
        *lobby-generic-confirmation*
        (lambda :behavior lobby-menu-manager () (go-virtual saving-password #f))
        (the-as (function symbol object) (lambda :behavior lobby-menu-manager () (go-virtual lobby-main-screen)))
        #f
        #f
        #f
        )
      )
    (dotimes (gp-1 4)
      (let ((s5-0 (-> *mc-common-data* net-accounts accounts gp-1)))
        (format
          #t
          "~G ~G ~G ~G~%"
          (-> s5-0 name)
          (-> *medius-account-name* data)
          (-> s5-0 password)
          *medius-old-account-password*
          )
        (when (strncmp (-> s5-0 name) (-> *medius-account-name* data) -1)
          (format #t "yay~%")
          (copy-charp<-charp (-> s5-0 password) *medius-new-account-password*)
          )
        )
      )
    (if *debug-segment*
        (fake-mc-cmd 'save-common self)
        (auto-save-command 'save-common 0 0 self #f #f)
        )
    (until #f
      (suspend)
      )
    #f
    )
  )

(defstate net-connection-error (lobby-menu-manager)
  :virtual #t
  :code (behavior ()
    (hack-reset-state #f)
    (net-mgr-start-hardware-already-done #t)
    (if *net-hw-initted*
        (go-virtual choose-account)
        (go-virtual pre-game-type-menu)
        )
    )
  )

(defstate waiting-for-cd (lobby-menu-manager)
  :virtual #t
  :code (behavior ()
    (kill-menu self #t #f)
    (until (zero? (-> *sound-iop-info* nocd))
      (suspend)
      )
    (go-virtual net-connection-error)
    )
  )

(defun lobby-safe-state? ()
  (if (not *lobby-menu-manager*)
      (return #f)
      )
  (if (or (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'playing-game))
          (nonzero? (-> *net-mgr* game-state connect-handle))
          )
      (return #f)
      )
  (not (send-event *lobby-menu-manager* 'lobby-unsafe-state?))
  )

(defbehavior lobby-respond-to-msg lobby-menu-manager ()
  (local-vars (v1-22 symbol) (v1-35 symbol))
  (if (or (not (lobby-safe-state?))
          (and *pending-op*
               *lobby-menu-manager*
               (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                  (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                  )
               )
          *net-mgr-pending-behavior-valid*
          (not (and (-> *net-mgr* next-state) (= (-> *net-mgr* next-state name) 'lobby-idle)))
          )
      (return #f)
      )
  (let ((gp-0 (get-top-chat-msg)))
    (if (not (and gp-0 (-> gp-0 resp-type)))
        (return #f)
        )
    (case (-> gp-0 resp-type)
      (('clan)
       (dotimes (v1-20 (+ (-> self in-focus-index) 1))
         (when (and (handle->process (-> self menu-handles v1-20))
                    (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-20))) info-ptr) *clan-info-screen*)
                    )
           (set! v1-22 #t)
           (goto cfg-46)
           )
         )
       (set! v1-22 #f)
       (label cfg-46)
       (if v1-22
           (kill-menu self #t #f)
           )
       (set! *clan-info-id* (-> gp-0 id))
       (go-virtual clan-info-screen)
       )
      (('game)
       (dotimes (v1-33 (+ (-> self in-focus-index) 1))
         (when (and (handle->process (-> self menu-handles v1-33))
                    (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-33))) info-ptr) *game-info-screen*)
                    )
           (set! v1-35 #t)
           (goto cfg-70)
           )
         )
       (set! v1-35 #f)
       (label cfg-70)
       (if v1-35
           (kill-menu self #t #f)
           )
       (set! *medius-game-info-id* (-> gp-0 id))
       (go-virtual game-info-screen)
       )
      )
    )
  #t
  )

      (else
        (lobby-menu-manager-default-handler proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (local-vars (v1-7 symbol))
    (cond
      ((zero? (-> *edit-stored-network-account* password-s8 0))
       (set! (-> *menu-yes-no-array* selection-index) 1)
       )
      (else
        (set! (-> *menu-yes-no-array* selection-index) 0)
        0
        )
      )
    (dotimes (v1-5 (+ (-> self in-focus-index) 1))
      (when (and (handle->process (-> self menu-handles v1-5))
                 (= (-> (the-as base-menu (handle->process (-> self menu-handles v1-5))) info-ptr) *edit-account*)
                 )
        (set! v1-7 #t)
        (goto cfg-23)

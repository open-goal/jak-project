(defbehavior do-change-password net-mgr ((arg0 (pointer uint8)))
  (let ((s5-0 (new 'stack 'medius-account-update-password-request)))
    (set! *async-request-ct* (+ *async-request-ct* 1))
    (itoa *async-request-ct* (-> s5-0 message-id))
    (mem-copy! (-> s5-0 session-key) *medius-session-key* 17)
    (copy-charp<-charp (-> s5-0 old-password) (-> *medius-account-password* data))
    (copy-charp<-charp (-> s5-0 new-password) arg0)
    (inspect s5-0)
    (dotimes (s4-0 30)
      (suspend)
      )
    (reset-lobby-state! self)
    (set! *scert-function-id* (scert-function medius-account-update-password))
    (let ((s5-1 (knet-scert-function-3-args s5-0 medius-simple-request-callback #f)))
      (when (nonzero? s5-1)
        (format 0 "initial function call returned ~D~%" s5-1)
        (set! (-> self lobby-state got-error) #t)
        (set! (-> self lobby-state last-medius-error) s5-1)
        )
      )
    )
  (net-async-wait (seconds 15) #t)
  (cond
    ((or (-> self lobby-state got-error)
         (-> self lobby-state timeout)
         (nonzero? (-> self lobby-state last-medius-error))
         (nonzero? (-> self lobby-state last-mgcl-error))
         (nonzero? (-> self lobby-state last-dme-error))
         (nonzero? (-> self lobby-state callback-status))
         )
     *medius-last-response*
     (return #f)
     )
    (else
      *medius-last-response*
      (copy-charp<-charp *medius-old-account-password* (-> *medius-account-password* data))
      (copy-charp<-charp (-> *medius-account-password* data) arg0)
      )
    )
  'success
  )

(defstate change-password (lobby-menu-manager)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (local-vars (v0-1 object))
    (case message
      (('notify)
       (case (-> block param 0)
         (('done)
          (copy-charp<-charp *medius-new-account-password* (-> (the-as string (-> block param 1)) data))
          (when (not (and *pending-op*
                          *lobby-menu-manager*
                          (= (logand (the-as uint #xffffffff) *pending-op-serial*)
                             (logand (the-as uint #xffffffff) (-> *lobby-menu-manager* profile-ticks))
                             )
                          )
                     )
            (set! *pending-op-serial* (-> *lobby-menu-manager* profile-ticks))
            (set! v0-1 (lambda :behavior lobby-menu-manager
                         ()
                         (when (< (strlen *medius-new-account-password*) 6)
                           (set! (-> *lobby-generic-error-text-ids* 0) (text-id text-id-1710))
                           (set! (-> *lobby-generic-error-bottom-text-ids* 0) (text-id text-id-1601))
                           (set! (-> *lobby-generic-error-bottom-text-ids2* 0) (text-id text-id-1712))

;; WARN: Return type mismatch int vs object.
(defun update-stored-network-account ()
  (when (= *edit-stored-network-account-idx* -1)
    (if (>= (-> *mc-common-data* net-accounts ct) 4)
        (return (the-as object #f))
        )
    (set! *edit-stored-network-account-idx* (-> *mc-common-data* net-accounts ct))
    )
  (set! (-> *mc-common-data* net-accounts default-idx) *edit-stored-network-account-idx*)
  (mem-copy!
    (the-as pointer (-> *mc-common-data* net-accounts accounts *edit-stored-network-account-idx*))
    (the-as pointer *edit-stored-network-account*)
    128
    )
  (compact! (-> *mc-common-data* net-accounts))
  0
  )

(deftype scrolling-account-item (scrolling-item)
  ((is-create  symbol)
   )
  )


(deftype scrolling-account-menu (scrolling-menu)
  ()
  )


(define *edit-account-ids* (new 'static 'boxed-array :type uint32 #x788))

(define *delete-account-ids* (new 'static 'boxed-array :type uint32 #x781))

(defmethod default-event-handler ((this scrolling-account-item) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (case arg2
    (('set-index)
     (dotimes (s4-0 (-> this strings length))
       (clear (-> this strings data s4-0 text))
       )
     (let ((v1-7 (-> arg3 param 0)))
       (if (< (the-as int v1-7) 0)
           (return #f)
           )
       (cond
         ((< (the-as int v1-7) (-> *mc-common-data* net-accounts ct))
          (format
            (-> this strings data 0 text)
            "~G"
            (fixup-netstring (+ (the-as uint (-> *mc-common-data* net-accounts)) (* v1-7 128)))
            )
          (set! (-> this is-create) #f)
          #f
          )
         (else
           (copy-string<-string (-> this strings data 0 text) (lookup-text! *common-text* (text-id text-id-1703) #f))
           (let ((v0-1 (the-as object #t)))
             (set! (-> this is-create) (the-as symbol v0-1))
             v0-1
             )
           )
         )
       )
     )
    (else
      ((method-of-type scrolling-item default-event-handler) this arg0 arg1 arg2 arg3)
      )
    )
  )

(defmethod update-strings ((this scrolling-account-item))
  (cond
    ((-> this is-create)
     (cond
       ((-> this selected)
        (set! (-> this strings data 0 color) (font-color font-color-51))
        (set! (-> this strings data 0 scale) 0.6)
        )
       (else
         (set! (-> this strings data 0 color) (font-color font-color-52))
         (set! (-> this strings data 0 scale) 0.5)
         )
       )
     )
    ((-> this selected)
     (set! (-> this strings data 0 color) (-> this info-ptr strings-info 0 font-color-2))
     (set! (-> this strings data 0 scale) 0.6)
     )
    (else
      (set! (-> this strings data 0 color) (-> this info-ptr strings-info 0 font-color))
      (set! (-> this strings data 0 scale) 0.5)
      )
    )
  0
  (none)
  )

(defmethod init-menu! ((this scrolling-account-menu))
  (let ((s5-0 (-> *mc-common-data* net-accounts default-idx)))
    (let ((t9-0 (method-of-type scrolling-menu init-menu!)))
      (t9-0 this)
      )
    (set! (-> this physical-item-ct) (-> *mc-common-data* net-accounts ct))
    (if (< (-> *mc-common-data* net-accounts ct) 4)
        (+! (-> this physical-item-ct) 1)
        )
    (set! (-> this top-idx) 0)
    (set! (-> this cur-idx) s5-0)
    )
  (scrolling-menu-method-74 this)
  (cond
    ((>= (-> this cur-idx) (-> *mc-common-data* net-accounts ct))
     (set! (-> *edit-account-ids* 0) (the-as uint 1712))
     (set! (-> *delete-account-ids* 0) (the-as uint 1712))
     )
    (else
      (set! (-> *edit-account-ids* 0) (the-as uint 1928))
      (set! (-> *delete-account-ids* 0) (the-as uint 1921))
      )
    )
  0
  (none)
  )

(defmethod scrolling-menu-method-73 ((this scrolling-account-menu) (arg0 int) (arg1 symbol))
  (if arg1
      (set! (-> *mc-common-data* net-accounts default-idx) arg0)
      )
  (cond
    ((>= arg0 (-> *mc-common-data* net-accounts ct))
     (set! (-> *edit-account-ids* 0) (the-as uint 1712))
     (set! (-> *delete-account-ids* 0) (the-as uint 1712))
     )
    (else
      (set! (-> *edit-account-ids* 0) (the-as uint 1928))
      (set! (-> *delete-account-ids* 0) (the-as uint 1921))
      )
    )
  ((method-of-type scrolling-menu scrolling-menu-method-73) this arg0 arg1)
  (none)
  )


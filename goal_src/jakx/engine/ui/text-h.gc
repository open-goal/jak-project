;;-*-Lisp-*-
(in-package goal)

;; name: text-h.gc
;; name in dgo: text-h
;; dgos: ENGINE, GAME

(define-extern print-game-text (function string font-context symbol int bucket-id symbol dma-buffer float))

;; DECOMP BEGINS

(deftype game-text (structure)
  ((id     text-id)
   (index  uint32)
   )
  :pack-me
  )


(deftype game-text-info (basic)
  ((length       int32)
   (language-id  int32)
   (group-name   string)
   (dic-index    (pointer uint32))
   (dic-data     (pointer uint8))
   (text         (inline-array game-text))
   (text-data    (pointer uint8))
   )
  (:methods
    (lookup-text! (_type_ text-id symbol) string)
    (lookup-text-length (_type_ text-id symbol) int)
    (expand-text (_type_ string) string)
    (expand-text-to-charp! (_type_ (pointer uint8) (pointer uint8)) object)
    )
  )


(define *text-group-names* (new 'static 'boxed-array :type string "common"))

(define *common-text-heap* (new 'global 'kheap))

(define *common-text* (the-as game-text-info #f))

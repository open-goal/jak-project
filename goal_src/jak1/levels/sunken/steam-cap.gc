(defskelgroup *steam-cap-sg*
  steam-cap
  steam-cap-lod0-jg
  steam-cap-idle-ja
  ((steam-cap-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 3))

(defmethod shove-target-off! ((this steam-cap))
  "Shove Jak away when he overlaps the cap's path but is not registered as a rider, preventing
   the moving cap from trapping him."
  (when *target*
    (let* ((target-position (target-pos 0))
           (target-y (-> target-position y)))
      (when (and (>= target-y (+ -8192.0 (-> this down y)))
                 (and (>= (+ -4096.0 (-> this root trans y)) target-y) (zero? (-> this root riders num-riders))))
        (let ((distance-sq (vector-vector-xz-distance-squared (-> this down) target-position)))
          (when (>= 104857600.0 distance-sq)
            (let ((should-shove? (>= 37748736.0 distance-sq)))
              (when (not should-shove?)
                (when (>= (- (-> this root trans y) (-> this down y)) 3072.0)
                  (let ((overlap-params (new 'stack-no-clear 'vector)))
                    (set! (-> overlap-params x) (the-as float 1))
                    (set! (-> overlap-params y) (the-as float #f))
                    (if (find-overlapping-shapes (-> this root) (the-as overlaps-others-params overlap-params)) (set! should-shove? #t)))))
              (if should-shove? (send-event *target* 'shove #f (static-attack-info ((shove-up (meters 0.5)) (shove-back (meters 1.5))))))))))))
  (none))

(defmethod update-motion! ((this steam-cap))
  "Advance the cap's three control points through the synchronized falling, rising, and resting
   phases; apply bounce physics, particles, and sounds; then update the averaged root position
   and surface orientation."
  (local-vars (at-0 int) (at-1 int) (going-down? symbol))
  (rlet ((vf0 :class vf)
         (vf1 :class vf)
         (vf2 :class vf))
    (init-vf0-vector)
    (let ((phase (get-current-phase (-> this sync))))
      #t
      (cond
        ((< phase (-> this begin-travel-up))
         (let ((up-fraction (/ phase (-> this begin-travel-up))))
           (set! going-down? #t)
           (dotimes (impulse-index 3)
             (let ((launch-point (-> this control-pt impulse-index)))
               (when (= (-> launch-point trans y) (-> this down y))
                 (set! (-> this do-burst?) #t)
                 (let ((a0-2 (+ (the int (* 60.0 (- 1.0 up-fraction))) 3)))
                   (if (zero? (rand-vu-int-count a0-2)) (+! (-> launch-point transv y) (* (rand-vu-float-range 40960.0 57344.0) up-fraction)))))))
           (let ((a0-4 (+ (the int (* 60.0 (- 1.0 up-fraction))) 1)))
             (if (zero? (rand-vu-int-count a0-4)) (spawn (-> this part) (-> this down))))))
        ((< phase (-> this begin-travel-down))
         (let ((down-fraction (/ (- phase (-> this begin-travel-up)) (- (-> this begin-travel-down) (-> this begin-travel-up)))))
           (set! going-down? #f)
           (set! (-> this do-falling-sound?) #t)
           (when (-> this do-burst?)
             (sound-play "sunk-top-rises")
             (set! (-> this do-burst?) #f)
             (spawn (-> this part) (-> this down))
             (spawn (-> this part) (-> this down))
             (spawn (-> this part) (-> this down))
             (spawn (-> this part) (-> this down)))
           (when (< down-fraction 0.94)
             (spawn (-> this part2) (-> this down))
             (let ((spread-position (new 'stack-no-clear 'vector)))
               (set! (-> spread-position quad) (-> this root trans quad))
               (+! (-> spread-position y) -3072.0)
               (spawn (-> this part3) spread-position)))))
        (else
         (set! going-down? #t)
         (when (-> this do-falling-sound?)
           (set! (-> this do-falling-sound?) #f)
           (sound-play "sunk-top-falls")))))
    (dotimes (control-index 3)
      (let ((control-point (-> this control-pt control-index))
            (new-position (new 'stack-no-clear 'vector)))
        (set! (-> new-position quad) (-> control-point trans quad))
        (cond
          (going-down?
           (+! (-> control-point transv y) (* -819200.0 (seconds-per-frame)))
           (let ((a1-10 new-position)
                 (v1-42 new-position)
                 (a0-21 (new 'stack-no-clear 'vector)))
             (.lvf vf1 (&-> (-> control-point transv) quad))
             (let ((f0-17 (seconds-per-frame))) (.mov at-0 f0-17))
             (.mov vf2 at-0)
             (.mov.vf.w vf1 vf0)
             (.mul.x.vf.xyz vf1 vf1 vf2)
             (.svf (&-> a0-21 quad) vf1)
             (vector+! a1-10 v1-42 a0-21))
           (when (< (-> new-position y) (-> this down y))
             (when (-> this do-landing-sound?)
               (set! (-> this do-landing-sound?) #f)
               (sound-play "sunk-top-lands"))
             (set! (-> new-position y) (-> this down y))
             (let ((impact-velocity (-> control-point transv y)))
               (when (< impact-velocity 0.0)
                 (let ((bounce-velocity (* 0.3 (- impact-velocity))))
                   (set! (-> control-point transv y) bounce-velocity)
                   (if (< 7782.4 bounce-velocity) (sound-play "sunk-top-lands" :vol 60)))))))
          (else
           (set! (-> this do-landing-sound?) #t)
           (let ((approach (* 0.000048828126 (- (-> this up y) (-> control-point trans y)))))
             (cond
               ((< 1.0 approach) (set! approach 1.0))
               ((< approach -1.0) (set! approach -1.0)))
             (+! (-> control-point transv y) (* 819200.0 (seconds-per-frame) approach))
             (let ((velocity-y (-> control-point transv y)))
               (when (< 122880.0 (fabs velocity-y))
                 (if (>= velocity-y 0.0) (set! (-> control-point transv y) 122880.0) (set! (-> control-point transv y) -122880.0))))
             (let ((a1-14 new-position)
                   (v1-61 new-position)
                   (a0-26 (new 'stack-no-clear 'vector)))
               (.lvf vf1 (&-> (-> control-point transv) quad))
               (let ((f1-27 (seconds-per-frame))) (.mov at-1 f1-27))
               (.mov vf2 at-1)
               (.mov.vf.w vf1 vf0)
               (.mul.x.vf.xyz vf1 vf1 vf2)
               (.svf (&-> a0-26 quad) vf1)
               (vector+! a1-14 v1-61 a0-26))
             (let ((distance-to-up (- (-> this up y) (-> new-position y)))
                   (was-positive? (>= approach 0.0)))
               (when (!= was-positive? (>= distance-to-up 0.0))
                 (let ((overshoot-velocity (-> control-point transv y)))
                   (when (< 40960.0 (fabs overshoot-velocity))
                     (if (>= overshoot-velocity 0.0) (set! (-> control-point transv y) 40960.0) (set! (-> control-point transv y) -40960.0))))
                 (set! (-> control-point transv y) (* 0.8 (-> control-point transv y))))))))
        (set! (-> control-point trans quad) (-> new-position quad))))
    (let ((y-sum 0.0))
      (dotimes (i 3)
        (+! y-sum (-> this control-pt i trans y)))
      (let ((average-y (/ y-sum 3))
            (root-position (new 'stack-no-clear 'vector)))
        (set! (-> root-position quad) (-> this root trans quad))
        (set! (-> root-position y) average-y)
        (move-to-point! (-> this root) root-position)))
    (let ((edge0 (new 'stack-no-clear 'vector))
          (edge1 (new 'stack-no-clear 'vector))
          (normal (new 'stack-no-clear 'vector)))
      (vector-! edge0 (the-as vector (&-> this stack 176)) (-> this control-pt 0 trans))
      (vector-! edge1 (the-as vector (&-> this stack 208)) (-> this control-pt 0 trans))
      (vector-cross! normal edge0 edge1)
      (vector-normalize! normal 1.0)
      (forward-up-nopitch->quaternion (-> this root quat)
                                      (vector-z-quaternion! (new-stack-vector0) (-> this root quat))
                                      normal))))

(defstate steam-cap-idle (steam-cap)
  :trans rider-trans
  :code
    (behavior ()
      (loop
        (shove-target-off! self)
        (update-motion! self)
        (suspend)))
  :post rider-post)

(defmethod relocate ((this steam-cap) (offset int))
  "Adjust the optional plume controllers after the process allocation moves, then relocate the
   parent drawable."
  (if (nonzero? (-> this part2)) (&+! (-> this part2) offset))
  (if (nonzero? (-> this part3)) (&+! (-> this part3) offset))
  (call-parent-method this offset))

(defmethod deactivate ((this steam-cap))
  "Stop the optional plume particles, then perform ordinary drawable deactivation."
  (if (nonzero? (-> this part2)) (kill-and-free-particles (-> this part2)))
  (if (nonzero? (-> this part3)) (kill-and-free-particles (-> this part3)))
  ((method-of-type process-drawable deactivate) this)
  (none))

(defmethod init-from-entity! ((this steam-cap) (source-entity entity-actor))
  "Initialize collision, animation, travel timing, particles, and the three independently
   bouncing cap control points."
  (logior! (-> this mask) (process-mask platform))
  (let ((cshape (new 'process 'collide-shape-moving this (collide-list-enum hit-by-player))))
    (set! (-> cshape dynam) (copy *standard-dynamics* 'process))
    (set! (-> cshape reaction) default-collision-reaction)
    (set! (-> cshape no-reaction)
          (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (alloc-riders cshape 1)
    (let ((prim (new 'process 'collide-shape-prim-mesh cshape (the-as uint 0) (the-as uint 0))))
      (set! (-> prim prim-core collide-as) (collide-kind ground-object))
      (set! (-> prim collide-with) (collide-kind target))
      (set! (-> prim prim-core action) (collide-action solid rider-plat-sticky))
      (set! (-> prim prim-core offense) (collide-offense indestructible))
      (set! (-> prim transform-index) 4)
      (set-vector! (-> prim local-sphere) 0.0 0.0 0.0 12288.0)
      (set-root-prim! cshape prim))
    (set! (-> cshape nav-radius) (* 0.75 (-> cshape root-prim local-sphere w)))
    (backup-collide-with-as cshape)
    (set! (-> this root) cshape))
  (set! (-> this do-burst?) #f)
  (set! (-> this do-falling-sound?) #f)
  (set! (-> this do-landing-sound?) #f)
  (process-drawable-from-entity! this source-entity)
  (initialize-skeleton this *steam-cap-sg* '())
  (logior! (-> this skel status) (janim-status inited))
  (ja-channel-set! 1)
  (let ((root-channel (-> this skel root-channel 0)))
    (joint-control-channel-group-eval! root-channel
                                       (the-as art-joint-anim (-> this draw art-group data 2))
                                       num-func-identity)
    (set! (-> root-channel frame-num) 0.0))
  (update-transforms! (-> this root))
  (load-params! (-> this sync) this (the-as uint 1800) 0.0 0.15 0.15)
  (let ((travel-up-phase 0.4)
        (travel-down-phase 0.9))
    (let* ((percent-tag (new 'static 'res-tag))
           (percent-values (res-lump-data source-entity 'percent (pointer float) :tag-ptr (& percent-tag))))
      (when percent-values
        (set! travel-up-phase (-> percent-values 0))
        (set! travel-down-phase (-> percent-values 1))
        (if (>= 0.01 travel-up-phase) (set! travel-up-phase 0.01))
        (if (>= 0.01 travel-down-phase) (set! travel-down-phase 0.01))
        (if (>= travel-up-phase travel-down-phase) (set! travel-down-phase (+ 0.01 travel-up-phase)))
        (when (>= travel-up-phase 1.0)
          (set! travel-down-phase (* 0.9 (/ travel-down-phase travel-up-phase)))
          (set! travel-up-phase 0.9))))
    (set! (-> this begin-travel-up) travel-up-phase)
    (set! (-> this begin-travel-down) travel-down-phase))
  (set! (-> this down quad) (-> this root trans quad))
  (set! (-> this up quad) (-> this root trans quad))
  (+! (-> this up y) 40960.0)
  (set! (-> this part) (create-launch-control group-steam-cap-sides this))
  (set! (-> this part2) (create-launch-control group-steam-cap-plume this))
  (set! (-> this part3) (create-launch-control group-steam-cap-plume-spread this))
  (vector-reset! (-> this root transv))
  (let ((control-offset (new 'stack-no-clear 'vector))
        (angle 0.0))
    (dotimes (i 3)
      (let ((control-point (-> this control-pt i)))
        (set-vector! control-offset 0.0 0.0 10240.0 1.0)
        (vector-rotate-around-y! control-offset control-offset angle)
        (set! angle (+ 21845.334 angle))
        (vector+! (-> control-point trans) control-offset (-> this root trans))
        (vector-reset! (-> control-point transv)))))
  (go steam-cap-idle)
  (none))

;;-*-Lisp-*-
(in-package goal)
(bundles "SUN.DGO")
(require "engine/common-obs/baseplat.gc")
(declare-type wedge-plat-outer process)

(declare-type wedge-plat-master process)

(declare-type wedge-plat process)

;; DECOMP BEGINS

(deftype wedge-plat-master (process)
  ((center       vector :inline)
   (rotspeed     float)
   (rotate-inner float)
   (rotate-outer float))
  (:states
   wedge-plat-master-idle))

(defstate wedge-plat-master-idle (wedge-plat-master)
  :code
    (behavior ()
      (loop
        (set! (-> self rotate-inner)
              (the float (sar (shl (the int (+ (-> self rotate-inner) (* (-> self rotspeed) (seconds-per-frame)))) 48) 48)))
        (set! (-> self rotate-outer)
              (the float (sar (shl (the int (- (-> self rotate-outer) (* (-> self rotspeed) (seconds-per-frame)))) 48) 48)))
        (suspend))))

(defmethod init-from-entity! ((this wedge-plat-master) (source-entity entity-actor))
  "Initialize the shared center and counter-rotating inner and outer platform angles."
  (logior! (-> this mask) (process-mask platform))
  (vector-copy! (-> this center) (-> source-entity extra trans))
  (+! (-> this center y) 819.2)
  (set! (-> this rotspeed) (res-lump-float source-entity 'rotspeed))
  (set! (-> this rotate-inner) 0.0)
  (set! (-> this rotate-outer) 0.0)
  (logclear! (-> this mask) (process-mask actor-pause))
  (go wedge-plat-master-idle)
  (none))

(deftype wedge-plat (baseplat)
  ((master   wedge-plat-master)
   (distance float)
   (offset   float))
  (:methods
   (update-tip-state? (_type_) symbol))
  (:states
   wedge-plat-idle
   wedge-plat-tip))

(defskelgroup *wedge-plat-sg*
  wedge-plat
  wedge-plat-lod0-jg
  wedge-plat-idle-ja
  ((wedge-plat-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 6))

(defmethod update-tip-state? ((this wedge-plat))
  "Update the platform's orbit transform from the master angle and return whether it is at a
   tipping orientation."
  (let* ((master (-> this master))
         (master-process (if master (-> (the-as process-drawable (-> master ppointer)) brother))))
    (when master-process
      (let ((center (&-> master-process 27))
            (distance (-> this distance))
            (angle (the float (sar (shl (the int (+ (the-as float (-> master-process 32)) (-> this offset))) 48) 48)))
            (tipped? #f))
        (quaternion-axis-angle! (-> this root quat) 0.0 1.0 0.0 (the float (sar (shl (the int (- 49152.0 angle)) 48) 48)))
        (set! (-> this basetrans x) (+ (the-as float (-> center 0)) (* distance (cos angle))))
        (set! (-> this basetrans y) (the-as float (-> center 1)))
        (set! (-> this basetrans z) (+ (the-as float (-> center 2)) (* distance (sin angle))))
        (let ((cos-angle (cos angle))) (if (or (< 0.95 cos-angle) (< cos-angle -0.95)) (set! tipped? #t)))
        tipped?))))

(defstate wedge-plat-idle (wedge-plat)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('bonk) (bounce! self))))
  :trans plat-trans
  :code
    (behavior ()
      (ja :num-func num-func-identity :frame-num (ja-aframe 0.0 0))
      (loop
        (if (update-tip-state? self) (go wedge-plat-tip))
        (suspend)))
  :post plat-post)

(defstate wedge-plat-tip (wedge-plat)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('bonk) (bounce! self))
        (('touch) (send-event proc 'no-look-around (seconds 1.5)) #f)))
  :trans plat-trans
  :code
    (behavior ()
      (ja-no-eval :group! wedge-plat-tip-ja :num! (seek! (ja-aframe 60.0 0)) :frame-num (ja-aframe 0.0 0))
      (until (ja-done? 0)
        (update-tip-state? self)
        (suspend)
        (ja :num! (seek! (ja-aframe 60.0 0))))
      (ja-no-eval :group! wedge-plat-tip-ja :num! (seek! (ja-aframe 100.0 0)) :frame-num (ja-aframe 60.0 0))
      (until (ja-done? 0)
        (update-tip-state? self)
        (suspend)
        (ja :num! (seek! (ja-aframe 100.0 0))))
      (set-time! (-> self state-time))
      (until (time-elapsed? (-> self state-time) (seconds 1))
        (ja :num-func num-func-identity :frame-num (ja-aframe 100.0 0))
        (update-tip-state? self)
        (suspend))
      (ja-no-eval :group! wedge-plat-tip-ja :num! (seek! (ja-aframe 153.0 0)) :frame-num (ja-aframe 100.0 0))
      (until (ja-done? 0)
        (update-tip-state? self)
        (suspend)
        (ja :num! (seek! (ja-aframe 153.0 0))))
      (go wedge-plat-idle))
  :post plat-post)

(defmethod init-from-entity! ((this wedge-plat) (source-entity entity-actor))
  "Initialize the inner wedge platform's collision, skeleton, master link, orbit offset, and radius."
  (logior! (-> this mask) (process-mask platform))
  (let ((s4-0 (new 'process 'collide-shape-moving this (collide-list-enum hit-by-player))))
    (set! (-> s4-0 dynam) (copy *standard-dynamics* 'process))
    (set! (-> s4-0 reaction) default-collision-reaction)
    (set! (-> s4-0 no-reaction) (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (alloc-riders s4-0 1)
    (let ((s3-0 (new 'process 'collide-shape-prim-mesh s4-0 (the-as uint 0) (the-as uint 0))))
      (set! (-> s3-0 prim-core collide-as) (collide-kind ground-object))
      (set! (-> s3-0 collide-with) (collide-kind target))
      (set! (-> s3-0 prim-core action) (collide-action solid rider-plat-sticky))
      (set! (-> s3-0 prim-core offense) (collide-offense indestructible))
      (set! (-> s3-0 transform-index) 3)
      (set-vector! (-> s3-0 local-sphere) 0.0 0.0 0.0 24576.0)
      (set-root-prim! s4-0 s3-0))
    (set! (-> s4-0 nav-radius) (* 0.75 (-> s4-0 root-prim local-sphere w)))
    (backup-collide-with-as s4-0)
    (set! (-> this root) s4-0))
  (process-drawable-from-entity! this source-entity)
  (initialize-skeleton this *wedge-plat-sg* '())
  (logior! (-> this skel status) (janim-status inited))
  (update-transforms! (-> this root))
  (init-platform! this)
  (set! (-> this master) (the-as wedge-plat-master (entity-actor-lookup source-entity 'alt-actor 0)))
  (set! (-> this offset) (res-lump-float source-entity 'rotoffset))
  (set! (-> this distance) (res-lump-float source-entity 'distance :default 36864.0))
  (logclear! (-> this mask) (process-mask actor-pause))
  (go wedge-plat-idle)
  (none))

(deftype wedge-plat-outer (wedge-plat) ()
  (:states
   wedge-plat-outer-idle
   wedge-plat-outer-tip))

(defskelgroup *wedge-plat-outer-sg*
  wedge-plat-outer
  wedge-plat-outer-lod0-jg
  wedge-plat-outer-idle-ja
  ((wedge-plat-outer-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 8))

(defmethod update-tip-state? ((this wedge-plat-outer))
  "Update the platform's orbit transform from the master angle and return whether it is at a
   tipping orientation."
  (let* ((master (-> this master))
         (master-process (if master (-> (the-as process-drawable (-> master ppointer)) brother))))
    (when master-process
      (let ((center (&-> master-process 27))
            (distance (-> this distance))
            (angle (the float (sar (shl (the int (+ (the-as float (-> master-process 33)) (-> this offset))) 48) 48)))
            (tipped? #f))
        (quaternion-axis-angle! (-> this root quat) 0.0 1.0 0.0 (the float (sar (shl (the int (- 49152.0 angle)) 48) 48)))
        (set! (-> this basetrans x) (+ (the-as float (-> center 0)) (* distance (cos angle))))
        (set! (-> this basetrans y) (the-as float (-> center 1)))
        (set! (-> this basetrans z) (+ (the-as float (-> center 2)) (* distance (sin angle))))
        (let ((sin-angle (sin angle))) (if (or (< 0.95 sin-angle) (< sin-angle -0.95)) (set! tipped? #t)))
        tipped?))))

(defstate wedge-plat-outer-idle (wedge-plat-outer)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('bonk) (bounce! self))))
  :trans plat-trans
  :code
    (behavior ()
      (loop
        (ja :num-func num-func-identity :frame-num (ja-aframe 0.0 0))
        (if (update-tip-state? self) (go wedge-plat-outer-tip))
        (suspend)))
  :post plat-post)

(defstate wedge-plat-outer-tip (wedge-plat-outer)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('bonk) (bounce! self))
        (('touch) (send-event proc 'no-look-around (seconds 1.5)))))
  :trans plat-trans
  :code
    (behavior ()
      (ja-no-eval :group! wedge-plat-outer-tip-ja :num! (seek! (ja-aframe 60.0 0)) :frame-num (ja-aframe 0.0 0))
      (until (ja-done? 0)
        (update-tip-state? self)
        (suspend)
        (ja :num! (seek! (ja-aframe 60.0 0))))
      (ja-no-eval :group! wedge-plat-outer-tip-ja :num! (seek! (ja-aframe 100.0 0)) :frame-num (ja-aframe 60.0 0))
      (until (ja-done? 0)
        (update-tip-state? self)
        (suspend)
        (ja :num! (seek! (ja-aframe 100.0 0))))
      (set-time! (-> self state-time))
      (until (time-elapsed? (-> self state-time) (seconds 1))
        (ja :num-func num-func-identity :frame-num (ja-aframe 100.0 0))
        (update-tip-state? self)
        (suspend))
      (ja-no-eval :group! wedge-plat-outer-tip-ja :num! (seek! (ja-aframe 153.0 0)) :frame-num (ja-aframe 100.0 0))
      (until (ja-done? 0)
        (update-tip-state? self)
        (suspend)
        (ja :num! (seek! (ja-aframe 153.0 0))))
      (go wedge-plat-outer-idle))
  :post plat-post)

(defmethod init-from-entity! ((this wedge-plat-outer) (source-entity entity-actor))
  "Initialize the outer wedge platform's collision, skeleton, master link, orbit offset, and
   radius."
  (logior! (-> this mask) (process-mask platform))
  (let ((s4-0 (new 'process 'collide-shape-moving this (collide-list-enum hit-by-player))))
    (set! (-> s4-0 dynam) (copy *standard-dynamics* 'process))
    (set! (-> s4-0 reaction) default-collision-reaction)
    (set! (-> s4-0 no-reaction) (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (alloc-riders s4-0 1)
    (let ((s3-0 (new 'process 'collide-shape-prim-mesh s4-0 (the-as uint 0) (the-as uint 0))))
      (set! (-> s3-0 prim-core collide-as) (collide-kind ground-object))
      (set! (-> s3-0 collide-with) (collide-kind target))
      (set! (-> s3-0 prim-core action) (collide-action solid rider-plat-sticky rider-plat))
      (set! (-> s3-0 prim-core offense) (collide-offense indestructible))
      (set! (-> s3-0 transform-index) 3)
      (set-vector! (-> s3-0 local-sphere) 0.0 0.0 0.0 32768.0)
      (set-root-prim! s4-0 s3-0))
    (set! (-> s4-0 nav-radius) (* 0.75 (-> s4-0 root-prim local-sphere w)))
    (backup-collide-with-as s4-0)
    (set! (-> this root) s4-0))
  (process-drawable-from-entity! this source-entity)
  (initialize-skeleton this *wedge-plat-sg* '())
  (logior! (-> this skel status) (janim-status inited))
  (update-transforms! (-> this root))
  (init-platform! this)
  (set! (-> this master) (the-as wedge-plat-master (entity-actor-lookup source-entity 'alt-actor 0)))
  (set! (-> this offset) (res-lump-float source-entity 'rotoffset))
  (set! (-> this distance) (res-lump-float source-entity 'distance :default 69632.0))
  (logclear! (-> this mask) (process-mask actor-pause))
  (go wedge-plat-outer-idle)
  (none))

;;-*-Lisp-*-
(in-package goal)
(bundles "SUN.DGO")
(require "engine/common-obs/generic-obs.gc")
(require "engine/util/sync-info.gc")

;; DECOMP BEGINS

(deftype whirlpool (process-drawable)
  ((root             collide-shape :override)
   (spin-ry          float)
   (spin-speed-idle  float)
   (spin-speed-delta float)
   (sync             sync-info-paused :inline))
  (:methods
   (swirl-target! (_type_ float) collide-status))
  (:states
   whirlpool-idle))

(defskelgroup *whirlpool-sg*
  whirlpool
  whirlpool-lod0-jg
  whirlpool-idle-ja
  ((whirlpool-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0.6 0 3))


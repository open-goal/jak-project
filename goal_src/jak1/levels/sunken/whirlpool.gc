(defmethod swirl-target! ((this whirlpool) (spin-speed float))
  "Within ten metres, rotate and pull Jak toward the center with squared falloff, apply the
   resulting velocity through collision, and restore his pre-step collision status."
  (let* ((target-position (target-pos 0))
         (target-distance (vector-vector-xz-distance (-> this root trans) target-position)))
    (when (< target-distance 40960.0)
      (let* ((pull-strength (square (* 0.000024414063 (- 40960.0 target-distance))))
             (angle-to-center (atan (- (-> target-position x) (-> this root trans x)) (- (-> target-position z) (-> this root trans z))))
             (rotation-delta (* (/ pull-strength 2) spin-speed (seconds-per-frame)))
             (new-angle (+ angle-to-center rotation-delta))
             (new-radius (- target-distance (fmin target-distance (* 0.16874999 pull-strength (fabs spin-speed) (seconds-per-frame)))))
             (velocity (new 'stack-no-clear 'vector)))
        (set-vector! velocity (* (sin new-angle) new-radius) 0.0 (* (cos new-angle) new-radius) 1.0)
        (vector+! velocity velocity (-> this root trans))
        (set! (-> velocity x) (* (- (-> velocity x) (-> target-position x)) (-> *display* frames-per-second)))
        (set! (-> velocity y) 0.0)
        (set! (-> velocity z) (* (- (-> velocity z) (-> target-position z)) (-> *display* frames-per-second)))
        (let ((target-control (-> *target* control)))
          (send-event (-> target-control process) 'rotate-y-angle rotation-delta)
          (fill-cache-for-shape! target-control 8192.0 (-> target-control root-prim collide-with))
          (let ((saved-status (-> target-control status)))
            (integrate-and-collide! target-control velocity)
            (set! (-> target-control status) saved-status)
            saved-status))))))

(defstate whirlpool-idle (whirlpool)
  :trans
    (behavior ()
      (let ((f30-0 (+ (* (get-current-phase-with-mirror (-> self sync)) (-> self spin-speed-delta)) (-> self spin-speed-idle))))
        (when (>= (fabs f30-0) 45511.11)
          (let ((a1-0 (new 'stack-no-clear 'vector)))
            (vector-copy! a1-0 (-> self root trans))
            (+! (-> a1-0 y) -8192.0)
            (spawn (-> self part) a1-0)))
        (+! (-> self spin-ry) (* f30-0 (seconds-per-frame)))
        (quaternion-axis-angle! (-> self root quat) 0.0 1.0 0.0 (-> self spin-ry))
        (if (and *target* (logtest? (-> *target* water flag) (water-flag touch-water))) (swirl-target! self f30-0))
        (update! (-> self sound))
        (let ((f0-9 (fmin 1.0 (* 0.000007608261 (fmax 0.0 (+ -28580.979 (fabs f30-0)))))))
          (update-vol! (-> self sound) (the int (* 100.0 f0-9))))))
  :code anim-loop
  :post ja-post)

(defmethod deactivate ((this whirlpool))
  "Stop the whirlpool sound, then perform ordinary drawable deactivation."
  (if (nonzero? (-> this sound)) (stop! (-> this sound)))
  ((method-of-type process-drawable deactivate) this)
  (none))

(defmethod init-from-entity! ((this whirlpool) (source-entity entity-actor))
  "Initialize collision, animation, synchronized spin speeds, particles, and ambient sound."
  (set! (-> this spin-ry) (rand-vu-float-range 0.0 65536.0))
  (let ((cshape (new 'process 'collide-shape this (collide-list-enum hit-by-player))))
    (let ((prim (new 'process 'collide-shape-prim-sphere cshape (the-as uint 0))))
      (set! (-> prim prim-core collide-as) (collide-kind wall-object))
      (set! (-> prim collide-with) (collide-kind target))
      (set! (-> prim prim-core action) (collide-action solid))
      (set! (-> prim prim-core offense) (collide-offense indestructible))
      (set-vector! (-> prim local-sphere) 0.0 -819.2 0.0 11468.8)
      (set-root-prim! cshape prim))
    (set! (-> cshape nav-radius) (* 0.75 (-> cshape root-prim local-sphere w)))
    (backup-collide-with-as cshape)
    (set! (-> this root) cshape))
  (process-drawable-from-entity! this source-entity)
  (initialize-skeleton this *whirlpool-sg* '())
  (load-params! (-> this sync) this (the-as uint 1500) 0.0 0.15 0.15)
  (let ((idle-speed 32768.0)
        (maximum-speed 145635.56))
    (let* ((speed-tag (new 'static 'res-tag))
           (speed-values (res-lump-data source-entity 'speed (pointer float) :tag-ptr (& speed-tag))))
      (when speed-values
        (set! idle-speed (-> speed-values 0))
        (set! maximum-speed (-> speed-values 1))))
    (set! (-> this spin-speed-idle) idle-speed)
    (set! (-> this spin-speed-delta) (- maximum-speed idle-speed)))
  (set! (-> this part) (create-launch-control group-whirlpool-swirl this))
  (set! (-> this sound) (new 'process 'ambient-sound (static-sound-spec "whirlpool" :fo-max 55) (-> this root trans)))
  (ja-channel-set! 1)
  (let ((root-channel (-> this skel root-channel 0)))
    (joint-control-channel-group-eval! root-channel
                                       (the-as art-joint-anim (-> this draw art-group data 2))
                                       num-func-identity)
    (set! (-> root-channel frame-num) 0.0))
  (ja-post)
  (update-transforms! (-> this root))
  (go whirlpool-idle)
  (none))

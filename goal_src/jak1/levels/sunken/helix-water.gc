(defmethod init-from-entity! ((this helix-button) (source-entity entity-actor))
  "Resolve the water and door entities, create the moving button and rider collision, and save
   its camera and depressed positions."
  (set! (-> this fcell-handle) (the-as handle #f))
  (set! (-> this my-water) (entity-actor-lookup source-entity 'alt-actor 0))
  (set! (-> this my-door) (entity-actor-lookup source-entity 'alt-actor 1))
  (let ((collision (new 'process 'collide-shape-moving this (collide-list-enum hit-by-others))))
    (set! (-> collision dynam) (copy *standard-dynamics* 'process))
    (set! (-> collision reaction) default-collision-reaction)
    (set! (-> collision no-reaction)
          (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (alloc-riders collision 1)
    (let ((mesh (new 'process 'collide-shape-prim-mesh collision (the-as uint 0) (the-as uint 0))))
      (set! (-> mesh prim-core collide-as) (collide-kind ground-object))
      (set! (-> mesh collide-with) (collide-kind target))
      (set! (-> mesh prim-core action) (collide-action solid rider-plat-sticky))
      (set! (-> mesh prim-core offense) (collide-offense indestructible))
      (set! (-> mesh transform-index) 0)
      (set-vector! (-> mesh local-sphere) 0.0 14336.0 0.0 22118.4)
      (set-root-prim! collision mesh))
    (set! (-> collision nav-radius) (* 0.75 (-> collision root-prim local-sphere w)))
    (backup-collide-with-as collision)
    (set! (-> this root) collision))
  (process-drawable-from-entity! this source-entity)
  (initialize-skeleton this *helix-button-sg* '())
  (logior! (-> this skel status) (janim-status inited))
  (ja-channel-set! 1)
  (let ((root-channel (-> this skel root-channel 0)))
    (joint-control-channel-group-eval! root-channel
                                       (the-as art-joint-anim (-> this draw art-group data 2))
                                       num-func-identity)
    (set! (-> root-channel frame-num) 0.0))
  (vector-copy! (-> this spawn-trans) (-> this root trans))
  (+! (-> this root trans y) -26624.0)
  (set! (-> this down-y) (+ -6553.6 (-> this root trans y)))
  (set! (-> this fact) (new 'process 'fact-info this (pickup-type eco-pill-random) (-> *FACT-bank* default-pill-inc)))
  (ja-post)
  (update-transforms! (-> this root))
  (set! *helix-button* this)
  (go helix-button-startup)
  (none))

(defmethod consume-next-submerged-actor! ((this helix-water))
  "Advance through the ordered alternate actors as the water reaches them, killing babaks and
   launchers or hiding eco-vent particles."
  (let ((next-index (+ (-> this last-alt-actor-consumed) 1)))
    (when (< next-index (-> this alt-actors length))
      (let* ((actor-entity (-> this alt-actors next-index))
             (actor-process (if actor-entity (-> actor-entity extra process)))
             (actor (if (and (nonzero? actor-process) (type-type? (-> actor-process type) process-drawable)) actor-process)))
        (+ -1638.4 (-> this root trans y))
        (cond
          (actor
           (when (< (-> (the-as process-drawable actor) root trans y) (-> this root trans y))
             (set! (-> this last-alt-actor-consumed) next-index)
             (case (-> actor type)
               ((babak) (send-event actor 'instant-death))
               ((ecovent) (send-event actor 'show-particles #f))
               ((launcher) (send-event actor 'instant-death)))))
          (else (set! (-> this last-alt-actor-consumed) next-index) next-index))))))

(defstate helix-water-idle (helix-water)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('trigger) (go helix-water-activated))
        (('music) (set-setting! 'music 'danger 0.0 0))))
  :code
    (behavior ()
      (set! (-> self root trans y) (-> self start-y))
      (set! (-> self last-alt-actor-consumed) -1)
      (set! (-> self transv-y) 9216.0)
      (suspend)
      (send-event (ppointer->process (-> self dark-eco)) 'move-to (-> self root trans))
      (loop
        (logior! (-> self mask) (process-mask sleep-code))
        (suspend)))
  :post ja-post)

(defstate helix-water-activated (helix-water)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('notify) (when (= (-> proc type) launcherdoor) (remove-setting! 'music) (go helix-water-idle)))))
  :trans
    (behavior ()
      (seek! (-> self root scale y) 0.8 (* 0.667 (seconds-per-frame)))
      (when *target*
        (let ((f0-4 (-> (target-pos 0) y)))
          (when (not (logtest? (-> *target* state-flags) (state-flags grabbed)))
            (let* ((f0-5 (- f0-4 (-> self root trans y)))
                   (f0-6 (+ -40960.0 f0-5))
                   (f0-7 (/ f0-6 (meters 10))))
              (cond
                ((< f0-7 0.0) (set! f0-7 0.0))
                ((< 1.0 f0-7) (set! f0-7 1.0)))
              (set! (-> self transv-y) (+ 3584.0 (* 12800.0 f0-7)))))))
      (+! (-> self root trans y) (* (-> self transv-y) (seconds-per-frame)))
      (if (< (-> self end-y) (-> self root trans y)) (set! (-> self root trans y) (-> self end-y)))
      (send-event (ppointer->process (-> self dark-eco)) 'move-to (-> self root trans))
      (consume-next-submerged-actor! self))
  :code
    (behavior ()
      (send-event (ppointer->process (-> self dark-eco)) 'trigger)
      (loop
        (logior! (-> self mask) (process-mask sleep-code))
        (suspend)))
  :post ja-post)

(defmethod relocate ((this helix-water) (offset int))
  "Relocate the alternate-actor array, then relocate the parent drawable."
  (if (nonzero? (-> this alt-actors)) (&+! (-> this alt-actors) offset))
  (call-parent-method this offset))

(defmethod init-from-entity! ((this helix-water) (source-entity entity-actor))
  "Create the rising water and dark-eco volume, collect the ordered actors it can consume, and
   establish the start and end heights."
  (set! (-> this last-alt-actor-consumed) -1)
  (set! (-> this transv-y) 9216.0)
  (set! (-> this root) (new 'process 'trsqv))
  (process-drawable-from-entity! this source-entity)
  (set! (-> this start-y) (+ -49152.0 (-> this root trans y)))
  (set! (-> this end-y) (+ 851968.0 (-> this start-y)))
  (set-vector! (-> this root scale) 1.0 0.8 1.0 1.0)
  (let ((alt-count (entity-actor-count source-entity 'alt-actor)))
    (set! (-> this alt-actors) (new 'process 'boxed-array entity-actor alt-count))
    (dotimes (i alt-count)
      (set! (-> this alt-actors i) (entity-actor-lookup source-entity 'alt-actor i))))
  (set! (-> this root trans y) (-> this start-y))
  (set! (-> this dark-eco) (process-spawn helix-dark-eco :init water-vol-init-by-other (-> this entity) :to this))
  (set! *helix-water* this)
  (go helix-water-idle)
  (none))

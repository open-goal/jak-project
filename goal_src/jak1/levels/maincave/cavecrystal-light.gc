;;-*-Lisp-*-
(in-package goal)
(bundles "MAI.DGO")
(require "engine/anim/joint-h.gc")
(require "engine/gfx/mood/time-of-day.gc")

;; DECOMP BEGINS

(define *cavecrystal-engine* (new 'loading-level 'engine 'cavecrystal 64))

(deftype cavecrystal-light (structure)
  ((next           cavecrystal-light)
   (crystal-id     int32)
   (intensity      float)
   (fade-start     float)
   (fade-end       float)
   (crystal-handle handle)
   (trans          vector :inline)))

(deftype cavecrystal-light-control (basic)
  ((active-count          int32)
   (head                  cavecrystal-light)
   (last-known-valid-time time-frame)
   (crystal               cavecrystal-light 7 :inline))
  (:methods
   (set-crystal-light! (_type_ int float process-drawable) none)
   (light-intensity-at (_type_ vector) float)
   (inc-intensities! (_type_) none)
   (prune-dead-lights! (_type_) none)
   (create-connection! (_type_ process-drawable res-lump (function object object object object object) int float) connection)
   (execute-connections (_type_) int)))

(define *cavecrystal-light-control* (new 'static 'cavecrystal-light-control :head #f))

(defun cavecrystal-light-control-default-callback ((drawable-pointer (pointer process-drawable)) (joint-index int) (radius float))
  "Blend a drawable from dim gray to white using the crystal-light intensity at its selected joint
   or root position."
  (let ((s5-0 (new 'stack-no-clear 'vector)))
    (let ((v1-1 (-> drawable-pointer 0 node-list)))
      (if (and (>= joint-index 0) (nonzero? v1-1))
        (vector<-cspace! s5-0 (-> v1-1 data joint-index))
        (vector-copy! s5-0 (-> drawable-pointer 0 root trans))))
    (set! (-> s5-0 w) radius)
    (let ((f0-1 (light-intensity-at *cavecrystal-light-control* s5-0))
          (a2-2 (new 'static 'vector :x 1.0 :y 1.0 :z 1.0 :w 1.0))
          (a1-5 (new 'static 'vector :x 0.05 :y 0.05 :z 0.05 :w 1.0)))
      (vector-lerp! (-> drawable-pointer 0 draw color-mult) a1-5 a2-2 f0-1)))
  (none))

(defmethod create-connection! ((this cavecrystal-light-control) (subject process-drawable) (resource res-lump) (callback (function object object object object object)) (joint-index int) (radius float))
  "Connect a drawable to the crystal-light engine when its resource enables crystal lighting."
  (if (nonzero? (res-lump-value resource 'crystal-light uint128))
    (add-connection *cavecrystal-engine* subject callback (process->ppointer subject) joint-index radius)))

(defmethod execute-connections ((this cavecrystal-light-control))
  "Run the cave-crystal lighting connections."
  (execute-connections *cavecrystal-engine* #f))

(defmethod prune-dead-lights! ((this cavecrystal-light-control))
  "Initialize the light slots on first use, then once per frame remove lights whose source
   process is gone."
  (let ((prev-time (-> this last-known-valid-time))
        (now (current-time)))
    (when (!= prev-time now)
      (set! (-> this last-known-valid-time) now)
      (cond
        ((zero? prev-time)
         (set! (-> this active-count) 0)
         (set! (-> this head) #f)
         (dotimes (i 7)
           (let ((crystal (-> this crystal i)))
             (set! (-> crystal next) #f)
             (set! (-> crystal crystal-id) i)
             (set! (-> crystal intensity) 0.0)
             (set! (-> crystal fade-start) 20480.0)
             (set! (-> crystal fade-end) 286720.0)
             (set! (-> crystal crystal-handle) (the-as handle #f)))))
        (else
         (when (> (-> this active-count) 0)
           (let ((prev (the-as cavecrystal-light #f))
                 (cur (-> this head)))
             (while cur
               (cond
                 ((handle->process (-> cur crystal-handle)) (set! prev cur) (set! cur (-> cur next)))
                 (else
                  (let ((next-crystal (-> cur next)))
                    (+! (-> this active-count) -1)
                    (set! (-> cur next) #f)
                    (set! (-> cur intensity) 0.0)
                    ;; Removing the head advances head; later removals splice through prev.
                    (if prev (set! (-> prev next) next-crystal) (set! (-> this head) next-crystal))
                    (set! cur next-crystal)))))))))))
  (none))

(defmethod inc-intensities! ((this cavecrystal-light-control))
  "Rebuild the linked list of lights with positive intensity and update the active count."
  (set! (-> this head) #f)
  (let ((tail (the-as cavecrystal-light #f))
        (active-count 0))
    (dotimes (i 7)
      (let ((crystal (-> this crystal i)))
        (set! (-> crystal next) #f)
        (when (< 0.0 (-> crystal intensity))
          (+! active-count 1)
          (if tail (set! (-> tail next) crystal) (set! (-> this head) crystal))
          (set! tail crystal))))
    (set! (-> this active-count) active-count))
  (none))

;; Invalid IDs return #f after reporting the error; valid updates return none.
(defmethod set-crystal-light! ((this cavecrystal-light-control) (crystal-id int) (intensity float) (source-process process-drawable))
  "Set or clear one crystal light, maintain the active list, and update its palette fade."
  (prune-dead-lights! this)
  (when (or (< crystal-id 0) (>= crystal-id 7))
    (format 0 "ERROR: Bogus cavecrystal id!~%")
    (return #f))
  (let ((crystal (-> this crystal crystal-id)))
    (cond
      ((and (< 0.0 intensity) (>= 0.0 (-> crystal intensity)))
       (+! (-> this active-count) 1)
       (set! (-> crystal intensity) intensity)
       (set! (-> crystal crystal-handle) (process->handle source-process))
       (vector-copy! (-> crystal trans) (-> source-process root trans))
       (inc-intensities! this))
      ((and (>= 0.0 intensity) (< 0.0 (-> crystal intensity)))
       (+! (-> this active-count) -1)
       (set! (-> crystal intensity) 0.0)
       (inc-intensities! this))
      ((< 0.0 intensity) (set! (-> crystal intensity) intensity)))
    (set-fade! *palette-fade-controls* (+ crystal-id 1) intensity 0.0 (-> crystal trans)))
  (none))

(defmethod light-intensity-at ((this cavecrystal-light-control) (probe-pos vector))
  "Return the strongest distance-attenuated crystal light at probe-pos, clamped to 2."
  (prune-dead-lights! this)
  (let ((cur (-> this head))
        (max-intensity 0.0))
    (when cur
      (until (not cur)
        (let* ((fade-start (-> cur fade-start))
               (fade-range (- (-> cur fade-end) fade-start))
               (clamped-dist (fmin (fmax 0.0 (- (- (vector-vector-distance (-> cur trans) probe-pos) (-> probe-pos w)) fade-start)) fade-range))
               (contribution (* (- 1.0 (/ clamped-dist fade-range)) (-> cur intensity))))
          (if (< max-intensity contribution) (set! max-intensity contribution)))
        (set! cur (-> cur next)))
      (set! max-intensity (fmin 2.0 max-intensity)))
    max-intensity))

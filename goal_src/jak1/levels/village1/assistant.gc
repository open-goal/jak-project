;;-*-Lisp-*-
(in-package goal)
(bundles "VI1.DGO")
(require "engine/common-obs/process-taskable.gc")

;; DECOMP BEGINS

(deftype assistant (process-taskable)
  "Keira at the Sandover Village workshop."
  ((sound-id sound-id)))

(defskelgroup *assistant-sg*
  assistant
  assistant-lod0-jg
  assistant-idle-leaning-right-ja
  ((assistant-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 2)
  :shadow assistant-shadow-mg)

(defmethod setup-shadow-settings! ((this assistant))
  "Set Keira's shadow clipping planes around her root position."
  (let ((v1-1 (-> this draw shadow-ctrl)))
    (when v1-1
      (let ((f0-0 (-> this root trans y)))
        (let ((a0-2 v1-1)) (set! (-> a0-2 settings bot-plane w) (- (+ -4096.0 f0-0))))
        0
        (let ((a0-4 v1-1)) (set! (-> a0-4 settings top-plane w) (- (+ 4096.0 f0-0)))))
      0
      (logclear! (-> v1-1 settings flags) (shadow-flags scissor-top))))
  (none))

(defmethod draw-npc-shadow ((this assistant))
  "Update Keira's shadow and sun direction when her highest-detail geometry was drawn; otherwise
   disable the shadow."
  (-> this draw shadow-ctrl)
  (cond
    ((and (-> this draw shadow) (zero? (-> this draw cur-lod)) (logtest? (-> this draw status) (draw-status was-drawn)))
     (let ((v1-9 (-> this draw shadow-ctrl))) (logclear! (-> v1-9 settings flags) (shadow-flags disable-draw)))
     0
     (update-direction-from-time-of-day (-> this draw shadow-ctrl)))
    (else (let ((v1-14 (-> this draw shadow-ctrl))) (logior! (-> v1-14 settings flags) (shadow-flags disable-draw))) 0))
  (none))

(defmethod play-anim! ((this assistant) (commit? symbol))
  "Choose Keira's conversation animation for the current Blue Eco switch or Zoomer stage. When
   commit? is true, apply the corresponding introduction or reminder progression."
  (case (current-status (-> this tasks))
    (((task-status need-hint) (task-status need-introduction))
     (case (current-task (-> this tasks))
       (((game-task jungle-eggtop))
        (when commit?
          (let* ((s5-1 (-> this tasks))
                 (s4-0 (method-of-object s5-1 save-reminder)))
            (s4-0 s5-1 (the int (the-as float (send-event *target* 'query 'pickup (pickup-type fuel-cell)))) 1))
          (close-status! (-> this tasks) (task-status need-introduction)))
        (new 'static
             'spool-anim
             :name "assistant-introduction-blue-eco-switch"
             :index 10
             :parts 11
             :command-list
             '((0 want-levels village1 beach)
              (128 joint "cameraB")
              (312 joint "camera")
              (492 joint "cameraB")
              (537 joint "camera")
              (734 display-level beach movie)
              (734 want-force-vis beach #t)
              (735 alive "ecovent-48")
              (742 blackout 10)
              (743 joint "cameraB")
              (745 blackout 0)
              (839 alive "ecovent-200")
              (841 joint "camera")
              (842 dead "ecovent-48")
              (942 blackout 10)
              (944 joint "cameraB")
              (945 blackout 0)
              (945 dead "ecovent-200")
              (945 display-level beach #f)
              (1049 blackout 10)
              (1051 joint "camera")
              (1052 blackout 0)
              (1135 blackout 10)
              (1137 joint "cameraB")
              (1138 blackout 0)
              (1216 joint "camera"))))
       (else
        (if commit? (close-status! (-> this tasks) (task-status need-introduction)))
        (new 'static
             'spool-anim
             :name "assistant-introduction-race-bike"
             :index 12
             :parts 6
             :command-list
             '((0 want-levels village1 beach) (129 joint "cameraB") (319 joint "camera") (505 joint "cameraB"))))))
    (((task-status need-reminder) (task-status need-reminder-a))
     (set! (-> this skippable) #t)
     (cond
       ((= (current-task (-> this tasks)) (game-task none))
        (new 'static 'spool-anim :name "assistant-reminder-1-generic" :index 14 :parts 2 :command-list '()))
       ((closed? (-> this tasks) (game-task jungle-eggtop) (task-status need-resolution))
        (new 'static 'spool-anim :name "assistant-reminder-1-race-bike" :index 13 :parts 3 :command-list '()))
       ((or (closed? (-> this tasks) (game-task misty-bike) (task-status need-resolution))
            (not (closed? (-> this tasks) (game-task misty-bike) (task-status need-introduction))))
        (new 'static 'spool-anim :name "assistant-reminder-1-blue-eco-switch" :index 11 :parts 3 :command-list '()))
       ((zero? (get-reminder (-> this tasks) 2))
        (if commit? (save-reminder (-> this tasks) 1 2))
        (new 'static 'spool-anim :name "assistant-reminder-1-race-bike" :index 13 :parts 3 :command-list '()))
       (else
        (if commit? (save-reminder (-> this tasks) 0 2))
        (new 'static 'spool-anim :name "assistant-reminder-1-blue-eco-switch" :index 11 :parts 3 :command-list '()))))
    (else
     (if commit?
       (format 0
               "ERROR: <GMJ>: ~S playing anim for task status ~S~%"
               (-> this name)
               (task-status->string (current-status (-> this tasks)))))
     (-> this draw art-group data 3))))

(defmethod get-art-elem ((this assistant))
  "Return Keira's active art element."
  (-> this draw art-group data 3))

(defmethod try-play-ambient-chatter ((this assistant))
  "When the target is within thirty metres, the thirty-second cooldown has elapsed, and the target
   is not more than four metres below her, choose one of five workshop lines."
  (let ((target-offset (ambient-chatter-ready? (-> this ambient) (new 'stack-no-clear 'vector) (seconds 30) 122880.0 this)))
    (when target-offset
      (let ((choice (rand-float-gen)))
        (cond
          ((< 16384.0 (-> target-offset y)) #f)
          ((< 0.8 choice) (play-ambient (-> this ambient) "ASSTLP01" #f (-> this root trans)))
          ((< 0.6 choice) (play-ambient (-> this ambient) "ASSTLP04" #f (-> this root trans)))
          ((< 0.4 choice) (play-ambient (-> this ambient) "ASSTLP05" #f (-> this root trans)))
          ((< 0.2 choice) (play-ambient (-> this ambient) "ASSTLP02" #f (-> this root trans)))
          (else (play-ambient (-> this ambient) "ASSTLP03" #f (-> this root trans))))))))

(defstate idle (assistant)
  :virtual #t
  :code
    (behavior ()
      (if (!= (ja-group) assistant-idle-leaning-right-ja) (ja-channel-push! 1 (seconds 0.2)))
      (loop
        (try-play-ambient-chatter self)
        (ja :group! assistant-idle-leaning-right-ja)
        (countdown (gp-0 (+ (the int (rand-float-gen)) 2))
          (ja-play :group! (ja-group) :num! (seek!) :frame-num 0.0))
        (cond
          ((< (rand-float-gen) 0.66)
           (ja-play :group! assistant-idle-transition-to-welding-ja :num! (seek!) :frame-num 0.0)
           (sound-play "welding-loop" :id (-> self sound-id) :position (target-pos 0))
           (ja :group! assistant-idle-welding-ja)
           (let* ((f30-0 4.0)
                  (v1-76 (/ (the-as int (rand-uint31-gen *random-generator*)) 256))
                  (v1-77 (the-as number (logior #x3f800000 v1-76))))
             (countdown (gp-2 (+ (the int (* f30-0 (+ -1.0 (the-as float v1-77)))) 4))
               (ja-play :group! (ja-group)
                        :num! (seek!)
                        :frame-num 0.0
                        (spawn (-> self part) (vector<-cspace! (new 'stack-no-clear 'vector) (joint-node assistant-lod0-jg torchTIP))))
               (ja-play :group! (ja-group)
                        :num!
                        (seek! 0.0)
                        :frame-num
                        max
                        (spawn (-> self part) (vector<-cspace! (new 'stack-no-clear 'vector) (joint-node assistant-lod0-jg torchTIP))))))
           (sound-stop (-> self sound-id))
           (ja-play :group! assistant-idle-transition-to-welding-ja :num! (seek! 0.0) :frame-num max)
           (if (< (rand-float-gen) 0.66) (ja-play :group! assistant-idle-wiping-brow-ja :num! (seek!) :frame-num 0.0)))
          (else
           (ja-play :group! assistant-idle-transition-right-to-left-ja :num! (seek!) :frame-num 0.0)
           (countdown (gp-3 (+ (the int (rand-float-gen)) 1))
             (ja-play :group! assistant-idle-leaning-left-ja :num! (seek!) :frame-num 0.0))
           (ja-play :group! assistant-idle-transition-left-to-right-ja :num! (seek!) :frame-num 0.0))))))

(defpartgroup group-assistant-torch
  :id 122
  :bounds (static-bspherem 0 0 0 15)
  :parts
  ((sp-item 365 :fade-after (meters 30) :falloff-to (meters 30))
   (sp-item 366 :fade-after (meters 60) :falloff-to (meters 80))))

(defpart 365
  :init-specs
  ((:texture (starflash effects))
   (:num 0.1 1.0)
   (:scale-x (meters 1) (meters 3))
   (:rot-z (degrees 0) (degrees 360))
   (:scale-y :copy scale-x)
   (:r 100.0 28.0)
   (:g 100.0)
   (:b 80.0)
   (:a 32.0 64.0)
   (:fade-a -6.4)
   (:timer (seconds 0.035))
   (:flags (die-when-faded glow))))

(defpart 366
  :init-specs
  ((:texture (hotdot effects))
   (:num 0.1 1.0)
   (:scale-x (meters 0.1) (meters 0.1))
   (:scale-y :copy scale-x)
   (:r 128.0 128.0)
   (:g 128.0)
   (:b 64.0)
   (:a 32.0 96.0)
   (:vel-y (meters 0.013333334) (meters 0.08))
   (:scalevel-x (meters -0.00016666666))
   (:scalevel-y :copy scalevel-x)
   (:fade-g -0.2)
   (:fade-b -0.2)
   (:accel-y (meters -0.002))
   (:friction 0.93)
   (:timer (seconds 4))
   (:flags (die-when-faded))
   (:userdata 140288.0)
   (:func 'check-drop-level-assistant)
   (:conerot-x (degrees 0) (degrees 180))
   (:conerot-y (degrees 45) (degrees 180))))

(defpart 367
  :init-specs
  ((:texture (hotdot effects))
   (:num 3.0 1.0)
   (:scale-x (meters 0.075) (meters 0.075))
   (:scale-y :copy scale-x)
   (:r 128.0 64.0)
   (:g 96.0)
   (:a 32.0 96.0)
   (:vel-y (meters 0.011666667) (meters 0.0033333334))
   (:fade-a -0.85333335)
   (:accel-y (meters -0.00016666666))
   (:timer (seconds 1))
   (:flags (die-when-faded))
   (:conerot-x (degrees 50.000004) (degrees 30))
   (:conerot-y (degrees 0) (degrees 360))))

(defun check-drop-level-assistant ((system sparticle-system) (particle sparticle-cpuinfo) (position vector))
  "Kill a welding spark below its drop height and launch a small impact burst, occasionally playing
   a water-drop sound."
  (when (< (-> position y) (-> particle user-float))
    (let ((impact-position (new 'stack-no-clear 'vector)))
      (sp-kill-particle system particle)
      (if (< (rand-float-gen) 0.25) (sound-play "water-drop"))
      (set-vector! impact-position (-> position x) (-> particle user-float) (-> position z) 1.0)
      (launch-particles (-> *part-id-table* 367) impact-position)))
  (none))

(defmethod init-from-entity! ((this assistant) (source-entity entity-actor))
  "Initialize Keira's workshop actor, welding particles, task state, sound, and lighting, then
   enter idle or deactivate her according to Fire Canyon progress."
  (init-as-taskable! this source-entity *assistant-sg* 3 31 (new 'static 'vector :w 4096.0) 5)
  (set! (-> this bounce-away) #f)
  (set! (-> this part) (create-launch-control group-assistant-torch this))
  (set! (-> this tasks) (get-task-control (game-task jungle-eggtop)))
  (set! (-> this sound-id) (new-sound-id))
  (set! (-> this draw light-index) (the-as uint 1))
  (case (get-task-status (game-task firecanyon-assistant))
    (((task-status unknown)) (go (method-of-object this idle)))
    (else (cleanup-for-death this) (deactivate this)))
  (none))

       (close-status! (-> this tasks) (task-status need-reward-speech))
       (set! (-> this assistant)
             (ppointer->handle (manipy-spawn (-> this root trans) (-> this entity) *assistant-sg* #f :to this)))
       (send-event (handle->process (-> this assistant)) 'anim-mode 'clone-anim)

;;-*-Lisp-*-
(in-package goal)
(bundles "DAR.DGO")
(require "engine/common-obs/generic-obs.gc")
(require "levels/maincave/cavecrystal-light.gc")

;; DECOMP BEGINS

(deftype cavecrystal (process-drawable)
  "An attack-activated Dark Cave crystal that drives one slot of the shared crystal lighting and
   updates connected cave lights."
  ((root collide-shape :override)
   (is-master? symbol)
   (crystal-id int32)
   (glow-u float)
   (glow-wf-period int32)
   (glow-wf-offset int32)
   (prev-compute-glow-time time-frame)
   (start-fade-time time-frame)
   (end-fade-time time-frame)
   (activated-time time-frame)
   (last-updated-user-lighting time-frame)
   (player-attack-id uint64)
   (on-color-mult vector :inline)
   (on-color-emissive vector :inline)
   (off-color-mult vector :inline)
   (off-color-emissive vector :inline))
  (:methods
   (update-connected-crystals! (_type_) none)
   (compute-glow (_type_) float))
  (:states
   cavecrystal-active
   cavecrystal-idle))

(defskelgroup *cavecrystal-sg*
  cavecrystal
  cavecrystal-lod0-jg
  -1
  ((cavecrystal-lod0-mg (meters 20)) (cavecrystal-lod1-mg (meters 999999)))
  :bounds (static-spherem 0 4.7 0 5.4))

(defmethod update-connected-crystals! ((this cavecrystal))
  "Have the master crystal update connected lighting at most once per game tick."
  (when (-> this is-master?)
    (let ((now (current-time)))
      (when (!= (-> this last-updated-user-lighting) now)
        (set! (-> this last-updated-user-lighting) now)
        (execute-connections *cavecrystal-light-control*))))
  (none))

(defmethod compute-glow ((this cavecrystal))
  "Compute glow intensity after activation: ramp to two, settle to a pulsing one, hold until
   timeout, then fade to zero."
  (set! (-> this prev-compute-glow-time) (-> *display* game-frame-counter))
  (let* ((elapsed (max 1 (+ (- 1 (-> this activated-time)) (-> *display* game-frame-counter))))
         (wave-phase (/ (the float (mod (+ (current-time) (-> this glow-wf-offset)) (-> this glow-wf-period)))
                        (the float (-> this glow-wf-period))))
         (pulse (* 0.1 (cos (* 65536.0 wave-phase)))))
    (cond
      ((>= (seconds 0.067) elapsed)
       (let ((ramp (* 0.05 (the float elapsed)))) (fmax 0.0 (fmin 2.0 (+ (* 2.0 ramp) (* ramp pulse))))))
      ((>= (seconds 0.6) elapsed)
       (let ((settle (* 0.00625 (the float (+ elapsed (seconds -0.067)))))) (fmin 2.0 (+ (lerp 2.0 1.0 settle) pulse))))
      ((>= (-> this start-fade-time) elapsed) (+ 1.0 pulse))
      (else
       (let ((fade (fmin 1.0 (* 0.004761905 (the float (- elapsed (-> this start-fade-time)))))))
         (fmax 0.0 (- (+ 1.0 (* (- 1.0 fade) pulse)) fade)))))))

(defstate cavecrystal-idle (cavecrystal)
  :event
    (behavior ((sender process) (argc int) (message symbol) (block event-message-block))
      "Activate when attacked."
      (case message
        (('attack) (go cavecrystal-active))))
  :trans
    (behavior ()
      "Offer the nearby lighting hint and let the master update connected lights."
      (if (and *target* (>= 40960.0 (vector-vector-distance (-> self root trans) (-> *target* control trans))))
        (level-hint-spawn (text-id darkcave-light-hint) "sksp0333" (the-as entity #f) *entity-pool* (game-task none)))
      (update-connected-crystals! self))
  :code
    (behavior ()
      "Sleep while inactive."
      (logior! (-> self mask) (process-mask sleep-code))
      (suspend)
      0))

(defstate cavecrystal-active (cavecrystal)
  :event
    (behavior ((sender process) (argc int) (message symbol) (block event-message-block))
      "Restart the glow only for a new player attack id."
      (case message
        (('attack)
         (let ((attack-id (-> block param 2)))
           (cond
             ((!= attack-id (-> self player-attack-id))
              (set! (-> self player-attack-id) attack-id)
              (set! (-> self activated-time) (-> *display* game-frame-counter))
              #t)
             (else #f))))))
  :enter
    (behavior ()
      "Enable active updates and reset the glow timing."
      (logclear! (-> self mask) (process-mask actor-pause))
      (set! (-> self activated-time) (-> *display* game-frame-counter))
      (set! (-> self prev-compute-glow-time) (-> *display* game-frame-counter)))
  :exit
    (behavior ()
      "Stop the crystal sound and let non-master crystals pause again."
      (stop! (-> self sound))
      (if (not (-> self is-master?)) (logior! (-> self mask) (process-mask actor-pause))))
  :trans
    (behavior ()
      "Update crystal colors and shared light intensity, returning to idle after the fade."
      (let ((glow (compute-glow self)))
        (set! (-> self glow-u) glow)
        (let ((color-delta (new 'stack-no-clear 'vector))
              (max-component 1.993))
          (let ((color-mult (-> self draw color-mult)))
            (vector-! color-delta (-> self on-color-mult) (-> self off-color-mult))
            (vector+*! color-mult (-> self off-color-mult) color-delta glow)
            (set! (-> color-mult x) (fmax 0.0 (fmin (-> color-mult x) max-component)))
            (set! (-> color-mult y) (fmax 0.0 (fmin (-> color-mult y) max-component)))
            (set! (-> color-mult z) (fmax 0.0 (fmin (-> color-mult z) max-component)))
            (set! (-> color-mult w) 1.0))
          (let ((color-emissive (-> self draw color-emissive)))
            (vector-! color-delta (-> self on-color-emissive) (-> self off-color-emissive))
            (vector+*! color-emissive (-> self off-color-emissive) color-delta glow)
            (set! (-> color-emissive x) (fmax 0.0 (fmin (-> color-emissive x) max-component)))
            (set! (-> color-emissive y) (fmax 0.0 (fmin (-> color-emissive y) max-component)))
            (set! (-> color-emissive z) (fmax 0.0 (fmin (-> color-emissive z) max-component)))
            (set! (-> color-emissive w) 0.0)))
        (set-crystal-light! *cavecrystal-light-control* (-> self crystal-id) (-> self glow-u) self)
        (update-connected-crystals! self)
        (when (>= 0.0 glow)
          (level-hint-spawn (text-id darkcave-light-end) "sksp0332" (the-as entity #f) *entity-pool* (game-task none))
          (go cavecrystal-idle)))
      (update! (-> self sound)))
  :code
    (behavior ()
      "Sleep until the next state transition."
      (logior! (-> self mask) (process-mask sleep-code))
      (suspend)
      0))

(defmethod deactivate ((this cavecrystal))
  "Stop the crystal sound, then perform ordinary drawable deactivation."
  (if (nonzero? (-> this sound)) (stop! (-> this sound)))
  ((method-of-type process-drawable deactivate) this)
  (none))

(defmethod init-from-entity! ((this cavecrystal) (entity entity-actor))
  "Create crystal collision, assign its linked-light index and master role, initialize art and
   lighting, start the ambient sound, and enter idle."
  (set! (-> this glow-u) 0.0)
  (set! (-> this player-attack-id) (the-as uint 0))
  (set! (-> this last-updated-user-lighting) 0)
  (set-vector! (-> this off-color-mult) 0.0 0.0 0.0 1.0)
  (set-vector! (-> this off-color-emissive) 0.0 0.0 0.0 0.0)
  (set-vector! (-> this on-color-mult) 1.0 1.0 1.0 1.0)
  (set-vector! (-> this on-color-emissive) 0.0 0.0 0.0 0.0)
  (let ((collision-shape (new 'process 'collide-shape this (collide-list-enum hit-by-others))))
    (let ((collision-mesh (new 'process 'collide-shape-prim-mesh collision-shape (the-as uint 0) (the-as uint 0))))
      (set! (-> collision-mesh prim-core collide-as) (collide-kind wall-object))
      (set! (-> collision-mesh collide-with) (collide-kind target))
      (set! (-> collision-mesh prim-core action) (collide-action solid))
      (set! (-> collision-mesh prim-core offense) (collide-offense indestructible))
      (set! (-> collision-mesh transform-index) 0)
      (set-vector! (-> collision-mesh local-sphere) 0.0 19251.2 0.0 22118.4)
      (set-root-prim! collision-shape collision-mesh))
    (set! (-> collision-shape nav-radius) 4915.2)
    (backup-collide-with-as collision-shape)
    (set! (-> this root) collision-shape))
  (set! (-> this link) (new 'process 'actor-link-info this))
  (set! (-> this crystal-id) (actor-count-before (-> this link)))
  (set! (-> this is-master?) (= (-> this crystal-id) 3))
  (set! (-> this glow-wf-period) (rand-vu-int-range 225 375))
  (set! (-> this glow-wf-offset) (rand-vu-int-range 0 300))
  (if (-> this is-master?) (logclear! (-> this mask) (process-mask actor-pause)))
  (set! (-> this start-fade-time)
        (the-as time-frame (the int (* 300.0 (res-lump-float (-> this entity) 'timeout :default 8.0)))))
  (process-drawable-from-entity! this entity)
  (initialize-skeleton this *cavecrystal-sg* '())
  (nav-mesh-connect this (-> this root) (the-as nav-control #f))
  (set! (-> this draw color-mult quad) (-> this off-color-mult quad))
  (set! (-> this draw color-emissive quad) (-> this off-color-emissive quad))
  (ja-channel-push! 1 0)
  (let ((root-channel (-> this skel root-channel 0)))
    (joint-control-channel-group-eval! root-channel
                                       (the-as art-joint-anim (-> this draw art-group data 3))
                                       num-func-identity)
    (set! (-> root-channel frame-num) 0.0))
  (ja-post)
  (update-transforms! (-> this root))
  (set-crystal-light! *cavecrystal-light-control* (-> this crystal-id) 0.0 this)
  (set! (-> this sound) (new 'process 'ambient-sound (static-sound-spec "crystal-on" :fo-max 80) (-> this root trans)))
  (go cavecrystal-idle)
  (none))

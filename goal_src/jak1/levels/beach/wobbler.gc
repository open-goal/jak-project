;;-*-Lisp-*-
(in-package goal)
(bundles "BEA.DGO")
(require "engine/gfx/hw/display-h.gc")
(require "engine/math/quaternion.gc")

;; DECOMP BEGINS

;; A two-axis spring used to lean an upright object after an impulse. Damping and spring are
;; per-frame coefficients; only the position integration is scaled by elapsed frame time.
(deftype wobbler (basic)
  ((posx    float)
   (posy    float)
   (velx    float)
   (vely    float)
   (spring  float)
   (damping float)
   (height  float))
  (:methods
   (reset! (_type_ float float float) none)
   (inc-xy-vel! (_type_ float float) none)
   (move! (_type_) none)
   (tilt-quaternion! (_type_ quaternion) none)))

(defmethod reset! ((this wobbler) (spring float) (damping float) (height float))
  "Clear displacement and velocity, then set the per-frame spring coefficient, velocity damping
   multiplier, and reference height used to convert displacement into tilt."
  (set! (-> this posx) 0.0)
  (set! (-> this posy) 0.0)
  (set! (-> this velx) 0.0)
  (set! (-> this vely) 0.0)
  (set! (-> this spring) spring)
  (set! (-> this damping) damping)
  (set! (-> this height) height)
  0
  (none))

(defmethod inc-xy-vel! ((this wobbler) (x-impulse float) (y-impulse float))
  "Add an X/Y impulse to the wobble velocity."
  (+! (-> this velx) x-impulse)
  (+! (-> this vely) y-impulse)
  0
  (none))

(defmethod move! ((this wobbler))
  "Advance the two-axis damped spring by one frame. Integrate displacement using
   seconds-per-frame, multiply velocity by damping, then subtract displacement times spring
   without an additional time scale."
  (+! (-> this posx) (* (-> this velx) (seconds-per-frame)))
  (+! (-> this posy) (* (-> this vely) (seconds-per-frame)))
  (set! (-> this velx) (* (-> this velx) (-> this damping)))
  (set! (-> this vely) (* (-> this vely) (-> this damping)))
  (+! (-> this velx) (* -1.0 (-> this posx) (-> this spring)))
  (+! (-> this vely) (* -1.0 (-> this posy) (-> this spring)))
  0
  (none))

(defmethod tilt-quaternion! ((this wobbler) (output quaternion))
  "Set output to the lean represented by the current two-axis displacement. Use
   (posy, 0, -posx) as the normalized tilt axis and atan(displacement magnitude / height) as
   the angle."
  (let ((tilt-axis (new 'stack-no-clear 'vector)))
    (set! (-> tilt-axis x) (-> this posy))
    (set! (-> tilt-axis y) 0.0)
    (set! (-> tilt-axis z) (- (-> this posx)))
    (vector-normalize! tilt-axis 1.0)
    (let* ((tilt-ratio (/ (sqrtf (+ (* (-> this posx) (-> this posx)) (* (-> this posy) (-> this posy)))) (-> this height)))
           (tilt-angle (atan tilt-ratio 1.0)))
      (quaternion-vector-angle! output tilt-axis tilt-angle)))
  0
  (none))

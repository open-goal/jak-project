;;-*-Lisp-*-
(in-package goal)
(bundles "BEA.DGO")
(require "engine/common-obs/process-taskable.gc")
(require "engine/anim/aligner.gc")
(require "engine/geometry/path.gc")

;; DECOMP BEGINS

(deftype pelican-bank (basic)
  ((circle-speed        meters)
   (dive-time           seconds)
   (to-nest0-time       seconds)
   (to-nest1-time       seconds)
   (land-time           seconds)
   (from-nest-time      seconds)
   (spit-time           seconds)
   (pre-spit-wait-time  seconds)
   (post-spit-wait-time seconds)
   (run-away-time       seconds)))

(define *PELICAN-bank*
  (new 'static
       'pelican-bank
       :circle-speed (meters 16)
       :dive-time (seconds 2)
       :to-nest0-time (seconds 4)
       :to-nest1-time (seconds 8)
       :land-time (seconds 2.4)
       :from-nest-time (seconds 20)
       :spit-time (seconds 1)
       :pre-spit-wait-time (seconds 0.5)
       :post-spit-wait-time (seconds 1.5)
       :run-away-time (seconds 10)))

(deftype pelican (process-drawable)
  ((root            collide-shape-moving :override)
   (query           gui-query :inline)
   (fuel-cell       handle)
   (cam-tracker     handle)
   (path-data       curve-control 8)
   (path-circle     curve-control :overlay-at (-> path-data 0))
   (path-dive0      curve-control :overlay-at (-> path-data 1))
   (path-to-nest0   curve-control :overlay-at (-> path-data 2))
   (path-from-nest0 curve-control :overlay-at (-> path-data 3))
   (path-spit0      curve-control :overlay-at (-> path-data 4))
   (path-dive1      curve-control :overlay-at (-> path-data 5))
   (path-to-nest1   curve-control :overlay-at (-> path-data 6))
   (path-to-nest2   curve-control :overlay-at (-> path-data 7))
   (path-cache      curve-control)
   (time-cache      time-frame)
   (path-pos        float)
   (path-speed      float)
   (path-max        float)
   (path-vector     vector :inline)
   (state-vector    vector :inline)
   (state-vector1   vector :inline)
   (state-float     float 2)
   (state-object    symbol)
   (neck            joint-mod))
  (:states
   pelican-circle
   (pelican-dive path-control curve-control time-frame)
   (pelican-explode symbol)
   (pelican-fly-to-end path-control time-frame)
   pelican-from-nest
   pelican-spit
   (pelican-to-nest path-control int)
   (pelican-wait-at-end symbol)
   (pelican-wait-at-nest symbol)))

(defmethod relocate ((this pelican) (offset int))
  "Relocate the eight path controls, cached path control, and neck joint modifier, then
   relocate the process through the parent method."
  (countdown (i 8)
    (if (nonzero? (-> this path-data i)) (&+! (-> this path-data i) offset)))
  (if (nonzero? (-> this path-cache)) (&+! (-> this path-cache) offset))
  (if (nonzero? (-> this neck)) (&+! (-> this neck) offset))
  (call-parent-method this offset))

(defskelgroup *pelican-sg*
  pelican
  pelican-lod0-jg
  pelican-fly-ja
  ((pelican-lod0-mg (meters 20)) (pelican-lod1-mg (meters 40)) (pelican-lod2-mg (meters 999999)))
  :bounds (static-spherem 0 3 0 5)
  :shadow pelican-shadow-mg)

(defbehavior pelican-path-update pelican ((turn-speed float) (turn-time int) (unused float) (alignment-path-scale float) (snap-heading? symbol))
  "Apply the aligner's vertical and forward correction to the current path position, wrap the
   parameter across the path's control-vertex range, move to the evaluated point, and face its
   tangent immediately or over the requested turn time. The third argument is unused."
  (compute-alignment! (-> self align))
  (let ((path-work (new 'stack-no-clear 'vector)))
    (let* ((unwrapped-pos (+ (-> self path-pos) (* (-> self align align trans z) alignment-path-scale)))
           (path-limit (-> self path-max))
           (wrapped-pos (- unwrapped-pos (* (the float (the int (/ unwrapped-pos path-limit))) path-limit))))
      (eval-path-curve-div! (-> self path) path-work wrapped-pos 'interp)
      (+! (-> path-work y) (-> self align align trans y))
      (move-to-point! (-> self root) path-work)
      (get-tangent-at-vertex! (-> self path) path-work wrapped-pos))
    (if snap-heading?
      (set-heading-vec-clear-roll-pitch! (-> self root) path-work)
      (seek-toward-heading-vec! (-> self root) path-work turn-speed (the-as time-frame turn-time)))))

(defbehavior pelican-fly pelican ((flap-count (function pelican int)) (glide-count (function pelican int)))
  "Continuously play batches of wingbeats and optional glides. flap-count returns the number of
   fly cycles in each batch and glide-count returns the following number of glide cycles."
  (loop
    (cond
      ((ja-group? pelican-fly-ja) (ja-no-eval :num! (seek!)) (while (not (ja-done? 0)) (suspend) (ja-eval)))
      (else (ja-channel-push! 1 (seconds 0.25))))
    (let ((num-flaps (flap-count self)))
      (dotimes (flap-i num-flaps)
        (ja-play :group! pelican-fly-ja :num! (seek!) :frame-num 0.0 (ja-blend-eval))))
    (let ((num-glides (glide-count self)))
      (when (> num-glides 0)
        (ja-play :group! pelican-fly-ja :num! (seek! (ja-aframe 12.0 0)) :frame-num 0.0)
        (ja-no-eval :num! (loop! 0.25))
        (ja-channel-push! 1 (seconds 1))
        (dotimes (glide-i num-glides)
          (ja-play :group! pelican-glide-ja :num! (seek!) :frame-num 0.0 (ja-blend-eval)))
        (ja-no-eval :num! (loop!)))))
  (none))

(defbehavior pelican-post pelican ()
  "Run the standard joint-animation post step."
  (ja-post)
  (none))

;; Circle with the fuel cell until the camera tracker starts the dive, grab it near the end of the
;; swoop, and carry it to the nest. An attack from outside the Pelican's 45-degree forward cone
;; starts the spit movie; the released cell follows path-spit0 and becomes a normal pickup when it
;; is touched or attacked. Losing the cell in flight sends the Pelican down its escape path.
;;
;; Persistent stages resume at the nest with the cell (2), reproduce the exploded result without
;; its sound and particles (5), or remove the escaped Pelican at the end of its path (10).
(defstate pelican-circle (pelican)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('dive)
         (let ((dive-requested? (the-as structure #t)))
           (set! (-> self state-object) (the-as symbol dive-requested?))
           dive-requested?))
        (('fuel-cell) (handle->process (-> self fuel-cell)))
        (('position)
         (set! (-> self path-pos) (the-as float (-> block param 0)))
         (let ((tangent (get-tangent-at-vertex! (-> self path) (new 'stack-no-clear 'vector) (-> self path-pos))))
           (set-heading-vec! (-> self root) tangent)))))
  :enter
    (behavior ()
      (while (-> self child)
        (deactivate (-> self child 0)))
      (set! (-> self state-object) #f)
      (let ((fuel-cell-pos (-> self path-vector)))
        (eval-path-curve-div! (-> self path-dive0) fuel-cell-pos 4.5 'interp)
        (+! (-> fuel-cell-pos y) -4505.6)
        (let ((fuel-cell-manipy (manipy-spawn fuel-cell-pos (-> self entity) *fuel-cell-sg* (new 'static 'vector :w 4915.2) :to self)))
          (set! (-> self fuel-cell) (ppointer->handle fuel-cell-manipy))
          (if fuel-cell-manipy
            (send-event (ppointer->process fuel-cell-manipy)
                        'eval
                        (lambda :behavior pelican ()
                          (let ((particles (create-launch-control group-fuel-cell-starburst self))) (set! (-> self part) particles) particles))))))
      (set! (-> self path) (-> self path-circle))
      (set! (-> self path-pos) 0.0)
      (set! (-> self path-max) (the float (+ (-> self path curve num-cverts) -1)))
      (set! (-> self path-speed) (/ (* (-> *PELICAN-bank* circle-speed) (-> self path-max)) (path-distance (-> self path))))
      (set-roll-to-grav-2! (-> self root) -2730.6667))
  :trans
    (behavior ()
      (pelican-path-update 728177.75 30 1.0 (/ (-> self path-max) (path-distance (-> self path))) #f)
      (let ((unwrapped-pos (+ (-> self path-pos) (* (-> self path-speed) (seconds-per-frame))))
            (path-limit (-> self path-max)))
        (set! (-> self path-pos) (- unwrapped-pos (* (the float (the int (/ unwrapped-pos path-limit))) path-limit))))
      (when (and (and *target* (>= 81920.0 (vector-vector-xz-distance (-> self path-vector) (-> *target* control trans))))
                 (not (handle->process (-> self cam-tracker))))
        (set! (-> self cam-tracker)
              (ppointer->handle (process-spawn camera-tracker
                                               :init
                                               camera-tracker-init
                                               (lambda :behavior camera-tracker ()
                                                 (local-vars
                                                   (parent-process process-tree)
                                                   (query-block event-message-block)
                                                   (send-query (function process-tree event-message-block object)))
                                                 (while (not (process-grab? *target*))
                                                   (suspend))
                                                 (send-event (ppointer->process (-> self parent)) 'position 4.0)
                                                 (send-event (ppointer->process (-> self parent)) 'dive)
                                                 (suspend)
                                                 (suspend)
                                                 (send-event *camera* 'blend-from-as-fixed)
                                                 (camera-look-at (the-as pair (ppointer->process (-> self parent))) (the-as uint 0))
                                                 (camera-change-to "camera-215" 0 #f)
                                                 (until (send-query parent-process query-block)
                                                   (suspend)
                                                   (set! query-block (new 'stack-no-clear 'event-message-block))
                                                   (set! (-> query-block from) self)
                                                   (set! (-> query-block num-params) 0)
                                                   (set! (-> query-block message) 'got-cell?)
                                                   (set! send-query send-event-function)
                                                   (set! parent-process (ppointer->process (-> self parent))))
                                                 (send-event *camera* 'point-of-interest #f)
                                                 (while (!= (-> self message) 'release)
                                                   (suspend))
                                                 (set! (-> self message) #f)
                                                 (while (not (process-release? (handle->process (-> self grab-target))))
                                                   (suspend))
                                                 (send-event *camera* 'blend-from-as-fixed)
                                                 (camera-look-at (the-as pair *target*) (the-as uint 0))
                                                 (camera-change-to (the-as string 'base) 150 #f)
                                                 (none))
                                               :to
                                               self)))
        (set! (-> self draw force-lod) 0)
        0)
      (when (and (-> self state-object) (>= (-> self path-pos) 6.0) (< (-> self path-pos) 7.0))
        (let ((perm-state (-> self entity extra perm)))
          (logior! (-> perm-state status) (entity-perm-status user-set-from-cstage))
          (set! (-> perm-state user-int8 0) 2))
        (go pelican-dive (-> self path-dive0) (-> self path-to-nest0) (-> *PELICAN-bank* to-nest0-time))))
  :code
    (behavior ()
      (suspend)
      (send-event (-> self fuel-cell process 0) 'trans-hook fuel-cell-animate)
      (pelican-fly (the-as (function pelican int) (lambda () (rand-vu-int-range 2 4)))
                   (the-as (function pelican int) (lambda () (rand-vu-int-range 3 5)))))
  :post pelican-post)

(defstate pelican-dive (pelican)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('got-cell?) (-> self state-object))
        (('fuel-cell) (handle->process (-> self fuel-cell)))))
  :enter
    (behavior ((dive-path path-control) (next-path curve-control) (next-duration time-frame))
      (init! (-> self query) (the-as string #f) 40 150 25 #t (the-as string #f))
      (set! (-> self state-object) #f)
      (set-time! (-> self state-time))
      (set-roll-to-grav-2! (-> self root) 0.0)
      (let ((fuel-cell-process (handle->process (-> self fuel-cell))))
        (cond
          (fuel-cell-process (send-event fuel-cell-process 'trans-hook fuel-cell-animate))
          (else)))
      (set! (-> self path-cache) next-path)
      (set! (-> self time-cache) next-duration)
      (set! (-> self path) dive-path)
      (set! (-> self path-pos) 0.0)
      (set! (-> self path-max) (the float (+ (-> self path curve num-cverts) -1)))
      (set! (-> self path-speed) (/ (* 300.0 (-> self path-max)) (the float (-> *PELICAN-bank* dive-time))))
      (let ((tangent (new 'stack-no-clear 'vector)))
        (get-tangent-at-vertex! (-> self path) tangent (-> self path-pos))
        (set-heading-vec! (-> self root) tangent))
      (set! (-> self draw force-lod) 0)
      0)
  :exit
    (behavior ()
      (set! (-> self draw force-lod) -1))
  :trans
    (behavior ()
      (if (not (handle->process (-> self fuel-cell)))
        (go pelican-fly-to-end (-> self path-to-nest2) (-> *PELICAN-bank* run-away-time)))
      (pelican-path-update 364088.88 30 0.0 0.0 #t)
      (seek! (-> self path-pos) (-> self path-max) (* (-> self path-speed) (seconds-per-frame)))
      (if (= (-> self path-pos) (-> self path-max)) (go pelican-to-nest (-> self path-cache) (the-as int (-> self time-cache)))))
  :code
    (behavior ((dive-path path-control) (next-path curve-control) (next-duration time-frame))
      (ja-channel-push! 1 (seconds 0.2))
      (ja-play :group!
               pelican-swoop-ja
               :num!
               (seek! (ja-aframe 48.0 0) 0.5)
               :frame-num 0.0
               (ja-blend-eval)
               (let ((fuel-cell-process (handle->process (-> self fuel-cell))))
                 (when (and fuel-cell-process (>= (-> self path-pos) 3.8) (not (send-event fuel-cell-process 'query 'grab)))
                   (level-hint-spawn (text-id zero) (the-as string #f) (-> self entity) *entity-pool* (game-task none))
                   (send-event fuel-cell-process 'grab self)
                   (send-event fuel-cell-process 'draw #f)
                   (send-event fuel-cell-process 'event-hook #f)
                   (set! (-> self state-object) #t))))
      (ja-no-eval :num! (seek!))
      (ja-channel-push! 1 (seconds 0.2))
      (ja-play :group! pelican-fly-ja :num! (seek!) :frame-num 0.0)
      (anim-loop))
  :post pelican-post)

(defstate pelican-to-nest (pelican)
  :enter
    (behavior ((nest-path path-control) (travel-time int))
      (set! (-> self path) nest-path)
      (set! (-> self path-pos) 0.0)
      (set! (-> self path-max) (the float (+ (-> self path curve num-cverts) -1)))
      (set! (-> self path-speed) (/ (* 300.0 (-> self path-max)) (the float travel-time))))
  :trans
    (behavior ()
      (pelican-path-update 546133.3 30 0.0 0.0 #f)
      (seek! (-> self path-pos) (-> self path-max) (* (-> self path-speed) (seconds-per-frame)))
      (if (= (-> self path-pos) (-> self path-max)) (go pelican-wait-at-nest #f)))
  :code
    (behavior ((nest-path path-control) (travel-time int))
      (pelican-fly (the-as (function pelican int) (lambda () 1))
                   (lambda ((bird pelican))
                     (if (and (>= (-> bird path-pos) 4.0) (>= 6.0 (-> bird path-pos))) 1 0))))
  :post pelican-post)

(defstate pelican-wait-at-nest (pelican)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('attack)
         (case (-> block param 1)
           (('explode)
            (let ((fuel-cell-process (handle->process (-> self fuel-cell))))
              (if fuel-cell-process (send-event fuel-cell-process 'trans (-> self root trans))))
            (go pelican-explode #f)
            #f)
           (else
            (let* ((attacker proc)
                   (attacker-drawable (if (and (nonzero? attacker) (type-type? (-> attacker type) process-drawable)) attacker))
                   (forward-cone-half-angle 8192.0)
                   (pelican-root (-> self root))
                   (attacker-pos (-> (the-as process-drawable attacker-drawable) root trans)))
              (if (< forward-cone-half-angle
                     (fabs (deg-diff (y-angle pelican-root)
                                     (vector-y-angle (vector-! (new 'stack-no-clear 'vector) attacker-pos (-> pelican-root trans))))))
                (go pelican-spit))))))
        (('touch) (send-shove-back (-> self root) proc (the-as touching-shapes-entry (-> block param 0)) 0.7 6144.0 16384.0))))
  :enter
    (behavior ((already-at-nest? symbol))
      (set! (-> self path) (-> self path-from-nest0))
      (set! (-> self path-pos) 0.0)
      (set! (-> self path-max) (the float (+ (-> self path curve num-cverts) -1)))
      (set! (-> self path-speed) (/ (* 300.0 (-> self path-max)) (the float (-> *PELICAN-bank* from-nest-time))))
      (let ((nest-pos (-> self state-vector)))
        (eval-path-curve-div! (-> self path) nest-pos (-> self path-pos) 'interp)
        (set! (-> self state-float 0)
              (/ (* 300.0 (vector-vector-distance (-> self root trans) nest-pos)) (the float (-> *PELICAN-bank* land-time)))))
      (get-tangent-at-vertex! (-> self path) (-> self path-vector) (-> self path-pos))
      (when already-at-nest?
        (move-to-point! (-> self root) (-> self state-vector))
        (set-heading-vec! (-> self root) (-> self path-vector))
        (let ((fuel-cell-process (handle->process (-> self fuel-cell))))
          (if fuel-cell-process (send-event fuel-cell-process 'draw #f)))
        (let ((perm-state (-> self entity extra perm))) (if (< 2 (-> perm-state user-int8 0)) (go pelican-explode #t))))
      (if (nonzero? (-> self neck)) (set-mode! (-> self neck) (joint-mod-handler-mode look-at))))
  :exit
    (behavior ()
      (if (nonzero? (-> self neck)) (set-mode! (-> self neck) (joint-mod-handler-mode flex-blend))))
  :trans
    (behavior ()
      (let ((nest-pos (-> self state-vector))
            (next-pos (new 'stack-no-clear 'vector)))
        (set! (-> next-pos quad) (-> self root trans quad))
        (vector-seek! next-pos nest-pos (* (-> self state-float 0) (seconds-per-frame)))
        (move-to-point! (-> self root) next-pos))
      (do-push-aways! (-> self root))
      (seek-toward-heading-vec! (-> self root) (-> self path-vector) 131072.0 (seconds 1))
      (spool-push *art-control* "pelican-spit-ext" 0 self -99.0))
  :code
    (behavior ((already-at-nest? symbol))
      (cond
        (already-at-nest? (ja-channel-set! 1))
        (else
         (ja-no-eval :num! (loop! 0.25))
         (ja-channel-push! 1 (seconds 0.25))
         (ja-play :group! pelican-fly-down-ja :num! (seek!) :frame-num 0.0 (ja-blend-eval))
         (until (vector= (-> self root trans) (-> self state-vector))
           (suspend)
           (ja :num! (loop!)))
         (ja-no-eval :num! (loop!))
         (set! (-> self state-float 0) (* 4.0 (-> self state-float 0)))
         (ja-channel-push! 1 (seconds 0.05))
         (ja-play :group! pelican-land-ja :num! (seek!) :frame-num 0.0 (ja-blend-eval))
         (ja-channel-push! 1 (seconds 0.5))))
      (send-event (handle->process (-> self cam-tracker)) 'message 'release)
      (loop
        (ja-play :group! pelican-sleep-ja :num! (seek!) :frame-num 0.0)))
  :post
    (behavior ()
      (when *target*
        (if *target* (look-at-enemy! (-> *target* neck) (-> self root root-prim prim-core world-sphere) 'nothing self))
        (if (nonzero? (-> self neck)) (set-target! (-> self neck) (target-pos 5))))
      (pelican-post)))

(defstate pelican-spit (pelican)
  :event
    (-> pelican-circle
        event)
  :code
    (behavior ()
      (local-vars (target-grabbed? symbol) (target-released? symbol))
      (let ((beachcam-handle (ppointer->handle (manipy-spawn (-> self entity extra trans) (-> self entity) *beachcam-sg* #f :to self))))
        (let ((other-camera (get-process *default-dead-pool* othercam #x4000)))
          (ppointer->handle (when other-camera
                              (let ((activate-other-camera (method-of-type othercam activate)))
                                (activate-other-camera (the-as othercam other-camera)
                                                       (-> beachcam-handle process 0)
                                                       'othercam
                                                       (the-as pointer #x70004000)))
                              (run-now-in-process other-camera othercam-init-by-other (-> beachcam-handle process 0) 4 #f #t)
                              (-> other-camera ppointer))))
        (let ((clone-cell-handle (ppointer->handle (process-spawn fuel-cell :init fuel-cell-init-as-clone (process->handle self) 0 :to self)))
              (saved-rotation (new 'stack-no-clear 'quaternion)))
          (quaternion-copy! saved-rotation (-> self root quat))
          (until target-grabbed?
            (suspend)
            (set! target-grabbed? (or (not *target*) (process-grab? *target*))))
          (send-event (-> beachcam-handle process 0) 'anim-mode 'clone-anim)
          (ja-play-spooled-anim (new 'static
                                     'spool-anim
                                     :name "pelican-spit-ext"
                                     :index 11
                                     :parts 2
                                     :command-list
                                     '((10 send-event camera 'teleport-to-vector-start-string (static-vectorm -179 16 -421))))
                                (the-as art-joint-anim pelican-sleep-ja)
                                (the-as art-joint-anim #f)
                                (the-as (function process-drawable symbol) false-func))
          (until target-released?
            (suspend)
            (set! target-released? (or (not *target*) (process-release? *target*))))
          (if (handle->process beachcam-handle) (deactivate (-> beachcam-handle process 0)))
          (if (handle->process clone-cell-handle) (deactivate (-> clone-cell-handle process 0)))
          (quaternion-copy! (-> self root quat) saved-rotation)))
      (process-spawn-function process
        (lambda :behavior pelican ()
          (while (or (-> *setting-control* current ambient) (-> *setting-control* current movie) (-> *setting-control* current hint))
            (suspend))
          (level-hint-spawn (text-id beach-pelican-quick-get-cell) "sksp0027" (the-as entity #f) *entity-pool* (game-task none))
          (none))
        :to
        self)
      (let ((fuel-cell-process (handle->process (-> self fuel-cell))))
        (when fuel-cell-process
          (send-event fuel-cell-process 'release)
          (set! (-> self path-cache) (-> self path-spit0))
          (let ((spit-target (new 'stack-no-clear 'vector)))
            (eval-path-curve-div! (-> self path-cache) spit-target (the float (+ (-> self path-cache curve num-cverts) -1)) 'interp)
            (send-event fuel-cell-process 'trans spit-target))
          (send-event fuel-cell-process 'draw #t)
          (send-event fuel-cell-process
                      'event-hook
                      (lambda :behavior pelican ((proc process) (argc int) (message symbol) (block event-message-block))
                        (when (or (= message 'touch) (= message 'attack))
                          (let ((pickup (birth-pickup-at-point (-> self root trans)
                                                               (pickup-type fuel-cell)
                                                               (the float (-> self entity extra perm task))
                                                               #f
                                                               *entity-pool*
                                                               (the-as fact-info #f))))
                            (when pickup
                              (set! (-> (the-as collectable (-> pickup 0)) collect-timeout) 0)
                              0))
                          (deactivate self))))))
      (go pelican-from-nest))
  :post
    (behavior ()
      (if (not (ja-group? pelican-sleep-ja)) (quaternion-identity! (-> self root quat)))
      (pelican-post)))

(defstate pelican-from-nest (pelican)
  :enter
    (behavior ()
      (set! (-> self path-pos) 1.5))
  :trans
    (behavior ()
      (pelican-path-update 131072.0 150 0.0 0.0 #f)
      (seek! (-> self path-pos) (-> self path-max) (* (-> self path-speed) (seconds-per-frame)))
      (if (= (-> self path-pos) (-> self path-max))
        (go pelican-dive (-> self path-dive1) (-> self path-to-nest1) (-> *PELICAN-bank* to-nest1-time))))
  :code
    (behavior ()
      (pelican-fly (the-as (function pelican int) (lambda () (rand-vu-int-range 2 4)))
                   (the-as (function pelican int) zero-func)))
  :post pelican-post)

(defstate pelican-fly-to-end (pelican)
  :enter
    (behavior ((escape-path path-control) (travel-time time-frame))
      (process-entity-status! self (entity-perm-status complete) #t)
      (let ((perm-state (-> self entity extra perm)))
        (logior! (-> perm-state status) (entity-perm-status user-set-from-cstage))
        (set! (-> perm-state user-int8 0) 10))
      (set-time! (-> self state-time))
      (set! (-> self path) escape-path)
      (set! (-> self path-pos) 0.0)
      (set! (-> self path-max) (the float (+ (-> self path curve num-cverts) -1)))
      (set! (-> self path-speed) (/ (* 300.0 (-> self path-max)) (the float travel-time)))
      (set! (-> self state-vector quad) (-> self root trans quad))
      (set! (-> self state-float 0) 0.0)
      (let ((path-start (new 'stack-no-clear 'vector)))
        (eval-path-curve-div! (-> self path) path-start 0.0 'interp)
        (set! (-> self state-float 1) (* 0.0073242188 (vector-vector-distance (-> self root trans) path-start)))))
  :trans
    (behavior ()
      (pelican-path-update 546133.3 30 0.0 0.0 #f)
      (seek! (-> self path-pos) (-> self path-max) (* (-> self path-speed) (seconds-per-frame)))
      (if (= (-> self path-pos) (-> self path-max)) (go pelican-wait-at-end #f))
      (when (not (time-elapsed? (-> self state-time) (the int (-> self state-float 1))))
        (set! (-> self state-float 0) (/ (the float (- (current-time) (-> self state-time))) (-> self state-float 1)))
        (vector-lerp! (-> self root trans) (-> self state-vector) (-> self root trans) (-> self state-float 0))))
  :code
    (behavior ((escape-path path-control) (travel-time time-frame))
      (pelican-fly (the-as (function pelican int) (lambda () 1))
                   (lambda ((bird pelican))
                     (if (and (>= (-> bird path-pos) 4.0) (>= 6.0 (-> bird path-pos))) 1 0))))
  :post pelican-post)

(defstate pelican-wait-at-end (pelican)
  :code
    (behavior ((from-save? symbol))
      (cleanup-for-death self)))

(defstate pelican-explode (pelican)
  :code
    (behavior ((silent? symbol))
      (let ((perm-state (-> self entity extra perm)))
        (logior! (-> perm-state status) (entity-perm-status user-set-from-cstage))
        (set! (-> perm-state user-int8 0) 5))
      (when (not silent?)
        (sound-play "scrate-break")
        (process-spawn part-tracker
                       :init
                       part-tracker-init
                       group-crate-explode
                       -1
                       #f
                       #f
                       #f
                       (-> self root trans)
                       :to
                       *entity-pool*))
      (let ((pickup-pos (new-stack-vector0)))
        (set! (-> pickup-pos quad) (-> self root trans quad))
        (let ((fuel-cell-process (handle->process (-> self fuel-cell))))
          (when fuel-cell-process
            (set! (-> pickup-pos quad) (-> (the-as process-drawable fuel-cell-process) root trans quad))
            (+! (-> pickup-pos y) 8192.0)
            (deactivate fuel-cell-process)))
        (when (not (task-complete? *game-info* (-> self entity extra perm task)))
          (let ((pickup (birth-pickup-at-point pickup-pos
                                               (pickup-type fuel-cell)
                                               (the float (-> self entity extra perm task))
                                               #f
                                               self
                                               (the-as fact-info #f))))
            (send-event (ppointer->process pickup) 'movie-pos 1))))
      (clear-collide-with-as (-> self root))
      (ja-channel-set! 0)
      (anim-loop))
  :post ja-post)

;; INFO: Return type mismatch object vs none.
(defmethod init-from-entity! ((this pelican) (source-entity entity-actor))
  "Initialize the Pelican's collision, skeleton, shadow, alignment, eight path controls, and
   neck tracking, then resume its circling, nest, explosion, or completed state from the
   entity's persistent stage."
  (stack-size-set! (-> this main-thread) 512)
  (let ((root-shape (new 'process 'collide-shape-moving this (collide-list-enum usually-hit-by-player))))
    (set! (-> root-shape dynam) (copy *standard-dynamics* 'process))
    (set! (-> root-shape reaction) default-collision-reaction)
    (set! (-> root-shape no-reaction)
          (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (let ((root-sphere (new 'process 'collide-shape-prim-sphere root-shape (the-as uint 0))))
      (set! (-> root-sphere prim-core collide-as) (collide-kind enemy))
      (set! (-> root-sphere collide-with) (collide-kind target))
      (set! (-> root-sphere prim-core action) (collide-action solid))
      (set! (-> root-sphere prim-core offense) (collide-offense indestructible))
      (set-vector! (-> root-sphere local-sphere) 0.0 12288.0 0.0 12288.0)
      (set-root-prim! root-shape root-sphere))
    (set! (-> root-shape nav-radius) (* 0.75 (-> root-shape root-prim local-sphere w)))
    (backup-collide-with-as root-shape)
    (set! (-> this root) root-shape))
  (process-drawable-from-entity! this source-entity)
  (initialize-skeleton this *pelican-sg* '())
  (set! (-> this draw shadow-ctrl) (new 'process 'shadow-control -81920.0 4096.0 614400.0 (the-as float 25) 409600.0))
  (logclear! (-> this mask) (process-mask actor-pause))
  (set! (-> this align) (new 'process 'align-control this))
  (dotimes (i 8)
    (let ((new-path (new 'process 'curve-control this 'path (the float (+ i 1)))))
      (set! (-> this path-data i) new-path)
      (logior! (-> new-path flags) (path-control-flag display draw-line draw-point draw-text))))
  (set! (-> this fuel-cell) (the-as handle #f))
  (set! (-> this cam-tracker) (the-as handle #f))
  (set! (-> this neck) (new 'process 'joint-mod (joint-mod-handler-mode flex-blend) this 9))
  (set-vector! (-> this neck twist-max) 2730.6667 2730.6667 0.0 1.0)
  (set! (-> this neck up) (the-as uint 1))
  (set! (-> this neck nose) (the-as uint 2))
  (set! (-> this neck ear) (the-as uint 0))
  (set! (-> this neck max-dist) 61440.0)
  (set! (-> this neck ignore-angle) 16384.0)
  (case (-> this entity extra perm user-int8 0)
    ((10) (go pelican-wait-at-end #t))
    ((5) (go pelican-wait-at-nest #t))
    ((2)
     (let ((fuel-cell-manipy (manipy-spawn (-> this root trans) (-> this entity) *fuel-cell-sg* (new 'static 'vector :w 4915.2) :to this)))
       (set! (-> this fuel-cell) (if fuel-cell-manipy (ppointer->handle fuel-cell-manipy) (the-as handle #f)))
       (when fuel-cell-manipy
         (send-event (ppointer->process fuel-cell-manipy)
                     'eval
                     (lambda :behavior pelican ()
                       (let ((particles (create-launch-control group-fuel-cell-starburst self))) (set! (-> self part) particles) particles)))
         (send-event (ppointer->process fuel-cell-manipy) 'trans-hook fuel-cell-animate)))
     (go pelican-wait-at-nest #t))
    (else (go pelican-circle)))
  (none))

(defskelgroup *seagull-sg*
  seagull
  seagull-lod0-jg
  seagull-idle-ja
  ((seagull-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 2))

(defmethod turn-toward-heading! ((this seagull) (target-heading float))
  "Bank toward target-heading by half a degree per frame, within max-tilt, then advance heading
   by one twentieth of the bank angle. Level the bank when the wrapped heading error is within
   two degrees."
  (let ((heading-error (the float (sar (shl (the int (- target-heading (-> this heading))) 48) 48)))
        (bank (- (-> this tilt))))
    (let ((max-bank (-> this max-tilt)))
      (set! bank
            (cond
              ((< heading-error -364.0889) (if (< (- max-bank) bank) (set! bank (+ -91.022224 bank))) bank)
              ((< 364.0889 heading-error) (if (< bank max-bank) (set! bank (+ 91.022224 bank))) bank)
              ((< bank 0.0) (+ 91.022224 bank))
              (else (+ -91.022224 bank)))))
    (set! (-> this tilt) (- bank))
    (set! (-> this heading) (the float (sar (shl (the int (+ (-> this heading) (* 0.05 bank))) 48) 48))))
  0
  (none))

(defmethod steer-toward-target! ((this seagull))
  "Turn toward the flock's current path target, or toward the temporary collision-avoidance
   heading while its timer is active. Mark arrival within twenty metres, and update target-dist
   and angletan, the target's downward slope relative to horizontal distance."
  (let ((to-target (new 'stack-no-clear 'vector)))
    (vector-! to-target (-> this flock 0 target) (-> this root trans))
    (when (< (vector-dot to-target to-target) 6710886400.0)
      (let ((bird-bit (ash 1 (-> this index))))
        (when (not (logtest? bird-bit (-> this flock 0 bird-at-waterfall)))
          (logior! (-> this flock 0 bird-at-waterfall) bird-bit)
          (+! (-> this flock 0 birds-at-waterfall) 1))))
    (cond
      ((> (-> this temp-heading-time) 0)
       (+! (-> this temp-heading-time) -1)
       (let* ((avoiding-bird this)
              (avoidance-heading-error (the float (sar (shl (the int (- (-> this temp-heading) (-> avoiding-bird heading))) 48) 48)))
              (avoidance-bank (- (-> avoiding-bird tilt))))
         (let ((avoidance-max-bank (-> avoiding-bird max-tilt)))
           (set! avoidance-bank
                 (cond
                   ((< avoidance-heading-error -364.0889)
                    (if (< (- avoidance-max-bank) avoidance-bank) (set! avoidance-bank (+ -91.022224 avoidance-bank)))
                    avoidance-bank)
                   ((< 364.0889 avoidance-heading-error)
                    (if (< avoidance-bank avoidance-max-bank) (set! avoidance-bank (+ 91.022224 avoidance-bank)))
                    avoidance-bank)
                   ((< avoidance-bank 0.0) (+ 91.022224 avoidance-bank))
                   (else (+ -91.022224 avoidance-bank)))))
         (set! (-> avoiding-bird tilt) (- avoidance-bank))
         (set! (-> avoiding-bird heading)
               (the float (sar (shl (the int (+ (-> avoiding-bird heading) (* 0.05 avoidance-bank))) 48) 48))))
       0)
      (else
       (let* ((target-heading (atan (-> to-target x) (-> to-target z)))
              (targeting-bird this)
              (target-heading-error (the float (sar (shl (the int (- target-heading (-> targeting-bird heading))) 48) 48)))
              (target-bank (- (-> targeting-bird tilt))))
         (let ((target-max-bank (-> targeting-bird max-tilt)))
           (set! target-bank
                 (cond
                   ((< target-heading-error -364.0889)
                    (if (< (- target-max-bank) target-bank) (set! target-bank (+ -91.022224 target-bank)))
                    target-bank)
                   ((< 364.0889 target-heading-error)
                    (if (< target-bank target-max-bank) (set! target-bank (+ 91.022224 target-bank)))
                    target-bank)
                   ((< target-bank 0.0) (+ 91.022224 target-bank))
                   (else (+ -91.022224 target-bank)))))
         (set! (-> targeting-bird tilt) (- target-bank))
         (set! (-> targeting-bird heading)
               (the float (sar (shl (the int (+ (-> targeting-bird heading) (* 0.05 target-bank))) 48) 48))))
       0))
    (let ((horizontal-distance-squared (+ (* (-> to-target x) (-> to-target x)) (* (-> to-target z) (-> to-target z)))))
      (set! (-> this angletan) (/ (- (-> to-target y)) (sqrtf horizontal-distance-squared)))
      ;; og:preserve-this changed for high fps
      (set! (-> this target-dist)
            (* DISPLAY_FPS_RATIO (sqrtf (+ horizontal-distance-squared (* (-> to-target y) (-> to-target y))))))))
  0
  (none))

(defbehavior seagull-post seagull ()
  "Build the bird orientation from its yaw heading and roll tilt, then update its transforms."
  (let ((roll (new 'stack-no-clear 'quaternion))
        (yaw (new 'stack-no-clear 'quaternion)))
    (quaternion-axis-angle! roll 0.0 0.0 1.0 (-> self tilt))
    (quaternion-axis-angle! yaw 0.0 1.0 0.0 (-> self heading))
    (quaternion*! (-> self root quat) yaw roll))
  (transform-post)
  0
  (none))

(defstate seagull-idle (seagull)
  :enter
    (behavior ()
      (let* ((flock (-> self flock))
             (target-heading (heading-to-target (if flock (-> flock 0 self-override)) self))
             (heading-range 21845.334)
             (heading-base -0.5))
        (set! (-> self heading)
              (the float (sar (shl (the int (+ target-heading (* heading-range (+ heading-base (rand-float-gen))))) 48) 48)))))
  :trans
    (behavior ()
      (when (nonzero? (-> self scared))
        (+! (-> self scared) -1)
        (when (zero? (-> self scared))
          (restore-collide-with-as (-> self root))
          (go seagull-takeoff)))
      (when *target*
        (let ((to-player (vector-! (new 'stack-no-clear 'vector) (-> *target* control trans) (-> self root trans))))
          (when (< (vector-dot to-player to-player) 1677721600.0)
            (let ((flock (-> self flock))) (play-hint (if flock (-> flock 0 self-override)) (-> self index)))))))
  :code
    (behavior ()
      (+! (-> self root trans y) 20480.0)
      (move-to-ground (-> self root) 40960.0 40960.0 #t (collide-kind background))
      (update-transforms! (-> self root))
      (clear-collide-with-as (-> self root))
      (ja :group! seagull-idle-ja :num! (identity (ja-aframe 0.0 0)))
      (loop
        (let* ((action-count 4.0)
               (action-mantissa (/ (the-as int (rand-uint31-gen *random-generator*)) 256))
               (action-random (the-as number (logior #x3f800000 action-mantissa)))
               (action (the int (* action-count (+ -1.0 (the-as float action-random))))))
          (let* ((wait-range 60.0)
                 (wait-mantissa (/ (the-as int (rand-uint31-gen *random-generator*)) 256))
                 (wait-random (the-as number (logior #x3f800000 wait-mantissa)))
                 (wait-frames (the int (* wait-range (+ -1.0 (the-as float wait-random))))))
            (dotimes (i wait-frames)
              (suspend)))
          (cond
            ((zero? action)
             (ja-play :group! seagull-idle-ja :num! (seek! (ja-aframe 4.0 0)) :frame-num (ja-aframe 0.0 0))
             (let* ((idle-wait-range 60.0)
                    (idle-wait-mantissa (/ (the-as int (rand-uint31-gen *random-generator*)) 256))
                    (idle-wait-random (the-as number (logior #x3f800000 idle-wait-mantissa)))
                    (idle-wait-frames (the int (* idle-wait-range (+ -1.0 (the-as float idle-wait-random))))))
               (dotimes (i idle-wait-frames)
                 (suspend)))
             (ja-play :group! seagull-idle-ja :num! (seek! (ja-aframe 10.0 0)) :frame-num (ja-aframe 4.0 0))
             (let* ((turn-wait-range 60.0)
                    (turn-wait-mantissa (/ (the-as int (rand-uint31-gen *random-generator*)) 256))
                    (turn-wait-random (the-as number (logior #x3f800000 turn-wait-mantissa)))
                    (turn-wait-frames (the int (* turn-wait-range (+ -1.0 (the-as float turn-wait-random))))))
               (dotimes (i turn-wait-frames)
                 (suspend)))
             (ja-play :group! seagull-idle-ja :num! (seek! (ja-aframe 14.0 0)) :frame-num (ja-aframe 10.0 0)))
            ((= action 2) (ja-play :group! seagull-peck-ja :num! (seek! (ja-aframe 4.0 0)) :frame-num (ja-aframe 0.0 0)))
            ((= action 3) (ja-play :group! seagull-peck-ja :num! (seek! (ja-aframe 8.0 0)) :frame-num (ja-aframe 4.0 0)))
            ((= action 4) (ja-play :group! seagull-peck-ja :num! (seek! (ja-aframe 12.0 0)) :frame-num (ja-aframe 8.0 0)))))))
  :post seagull-post)

(defmethod move-vertically! ((this seagull) (climb? symbol))
  "Raise vertical velocity by three metres per second until the flock's lift limit when climb?
   is true; otherwise lower it by one metre per second."
  (let ((vertical-velocity (-> this root transv y)))
    (set! vertical-velocity
          (cond
            (climb?
             (if (< vertical-velocity (-> this flock 0 max-lift)) (set! vertical-velocity (+ 12288.0 vertical-velocity)))
             vertical-velocity)
            (else (+ -4096.0 vertical-velocity))))
    ;; og:preserve-this changed for high fps
    (set! (-> this root transv y) (* DISPLAY_FPS_RATIO vertical-velocity)))
  0
  (none))

(defmethod teleport-near-target! ((this seagull))
  "Move ninety percent of the way toward a random point within one metre of the flock target,
   then clear the teleport request."
  (let ((teleport-offset (new 'stack-no-clear 'vector)))
    (let ((x-offset-base -4096.0)
          (x-offset-range 8192.0))
      (set! (-> teleport-offset x) (+ x-offset-base (* x-offset-range (rand-float-gen)) (-> this flock 0 target x))))
    (let ((y-offset-base -4096.0)
          (y-offset-range 8192.0))
      (set! (-> teleport-offset y) (+ y-offset-base (* y-offset-range (rand-float-gen)) (-> this flock 0 target y))))
    (let ((z-offset-base -4096.0)
          (z-offset-range 8192.0))
      (set! (-> teleport-offset z) (+ z-offset-base (* z-offset-range (rand-float-gen)) (-> this flock 0 target z))))
    (vector-! teleport-offset teleport-offset (-> this root trans))
    (vector-float*! teleport-offset teleport-offset 0.9)
    (move-by-vector! (-> this root) teleport-offset))
  (set! (-> this teleport) #f)
  #f)

(defmethod adjust-heading-around-point-slow! ((this seagull) (speed float))
  "Blend horizontal velocity twenty percent toward speed along the bird's current heading,
   retaining eighty percent of the previous velocity."
  (let ((x-velocity (* speed (sin (-> this heading))))
        (z-velocity (* speed (cos (-> this heading)))))
    ;; og:preserve-this changed for high fps
    (set! (-> this root transv x) (* DISPLAY_FPS_RATIO (+ (* 0.8 (-> this root transv x)) (* 0.2 x-velocity))))
    (set! (-> this root transv z) (* DISPLAY_FPS_RATIO (+ (* 0.8 (-> this root transv z)) (* 0.2 z-velocity)))))
  0
  (none))

(defmethod adjust-heading-around-point! ((this seagull) (speed float))
  "Set horizontal velocity to speed along the bird's current heading."
  (let ((x-velocity (* speed (sin (-> this heading))))
        (z-velocity (* speed (cos (-> this heading)))))
    ;; og:preserve-this changed for high fps
    (set! (-> this root transv x) (* DISPLAY_FPS_RATIO x-velocity))
    (set! (-> this root transv z) (* DISPLAY_FPS_RATIO z-velocity)))
  0
  (none))

(defmethod set-glide-sink-velocity! ((this seagull))
  "Set the fixed two-metres-per-second downward velocity used while soaring."
  (set! (-> this root transv y) -8192.0)
  0
  (none))

(defmethod integrate-with-air-bounds! ((this seagull))
  "Predict this frame's endpoint and integrate without background collision only when the
   current and predicted points occupy the same seagull air box. Otherwise use the ordinary
   background collision integrator so crossing a box boundary cannot skip a collision."
  (local-vars (at-0 int))
  (rlet ((vf0 :class vf)
         (vf1 :class vf)
         (vf2 :class vf))
    (init-vf0-vector)
    (let ((displacement (new 'stack-no-clear 'vector))
          (current-pos (-> this root trans))
          (velocity (-> this root transv))
          (next-pos (new 'stack-no-clear 'vector)))
      ;; Scale one packed XYZ velocity by the frame duration; W remains zero.
      (let ((displacement-out displacement))
        (.lvf vf1 (&-> velocity quad))
        (let ((dt (seconds-per-frame))) (.mov at-0 dt))
        (.mov vf2 at-0)
        (.mov.vf.w vf1 vf0)
        (.mul.x.vf.xyz vf1 vf1 vf2)
        (.svf (&-> displacement-out quad) vf1))
      (vector+! next-pos current-pos displacement)
      ;; Both endpoints must remain in the same corridor; a boundary crossing still collides.
      (if (points-in-air? current-pos next-pos *seagull-boxes* 10)
        (integrate-no-collide! (-> this root) (-> this root transv))
        (fill-cache-integrate-and-collide! (-> this root) velocity (collide-kind background))))
    (none)))

;; A bird waits on the ground with collision disabled until a hint scares it.  Takeoff adds lift
;; during the middle of the first wingbeat; ordinary flight then banks toward the flock's moving
;; path target.  A sufficiently steep target descent changes to the wide-bank soaring state, which
;; sinks steadily until the target geometry and slope select another wingbeat or a landing probe.
(defstate seagull-takeoff (seagull)
  :trans
    (behavior ()
      (when (< (+ (current-time) (seconds -2)) (-> self part-time))
        (-> self part)
        (-> self root root-prim prim-core)))
  :code
    (behavior ()
      (set-time! (-> self part-time))
      (ja-play :group!
               seagull-takeoff-ja
               :num!
               (seek! (ja-aframe 4.0 0))
               :frame-num
               (ja-aframe 1.0 0)
               (when (and (>= (ja-frame-num 0) (ja-aframe 2.0 0)) (>= (ja-aframe 3.0 0) (ja-frame-num 0)))
                 (let* ((climbing-bird self)
                        (climb? #t)
                        (vertical-velocity (-> climbing-bird root transv y)))
                   (set! vertical-velocity
                         (cond
                           (climb?
                            (if (< vertical-velocity (-> climbing-bird flock 0 max-lift)) (set! vertical-velocity (+ 12288.0 vertical-velocity)))
                            vertical-velocity)
                           (else (+ -4096.0 vertical-velocity))))
                   ;; og:preserve-this changed for high fps
                   (set! (-> climbing-bird root transv y) (* DISPLAY_FPS_RATIO vertical-velocity)))
                 0
                 (let* ((moving-bird self)
                        (thrust (-> self thrust))
                        (x-velocity (* thrust (sin (-> moving-bird heading))))
                        (z-velocity (* thrust (cos (-> moving-bird heading)))))
                   ;; og:preserve-this changed for high fps
                   (set! (-> moving-bird root transv x)
                         (* DISPLAY_FPS_RATIO (+ (* 0.8 (-> moving-bird root transv x)) (* 0.2 x-velocity))))
                   (set! (-> moving-bird root transv z)
                         (* DISPLAY_FPS_RATIO (+ (* 0.8 (-> moving-bird root transv z)) (* 0.2 z-velocity)))))
                 0)
               (integrate-with-air-bounds! self))
      (ja-no-eval :num! (seek!))
      (ja-channel-push! 1 (seconds 0.067))
      (go seagull-flying))
  :post seagull-post)

(defstate seagull-flying (seagull)
  :trans
    (behavior ()
      (when (< (+ (current-time) (seconds -2)) (-> self part-time))
        (-> self part)
        (-> self root root-prim prim-core)))
  :code
    (behavior ()
      (set! (-> self max-tilt) 1820.4445)
      (let ((wingbeat-count 0))
        (loop
          (ja-play :group!
                   seagull-fly-ja
                   :num! (seek!)
                   :frame-num 0.0
                   (ja-blend-eval)
                   (when (-> self teleport)
                     (teleport-near-target! self)
                     (suspend)
                     0)
                   (let ((steering-bird self)
                         (to-target (new 'stack-no-clear 'vector)))
                     (vector-! to-target (-> steering-bird flock 0 target) (-> steering-bird root trans))
                     (when (< (vector-dot to-target to-target) 6710886400.0)
                       (let ((bird-bit (ash 1 (-> steering-bird index))))
                         (when (not (logtest? bird-bit (-> steering-bird flock 0 bird-at-waterfall)))
                           (logior! (-> steering-bird flock 0 bird-at-waterfall) bird-bit)
                           (+! (-> steering-bird flock 0 birds-at-waterfall) 1))))
                     (cond
                       ((> (-> steering-bird temp-heading-time) 0)
                        (+! (-> steering-bird temp-heading-time) -1)
                        (let* ((avoiding-bird steering-bird)
                               (avoidance-heading-error (the float (sar (shl (the int (- (-> steering-bird temp-heading) (-> avoiding-bird heading))) 48) 48)))
                               (avoidance-bank (- (-> avoiding-bird tilt))))
                          (let ((avoidance-max-bank (-> avoiding-bird max-tilt)))
                            (set! avoidance-bank
                                  (cond
                                    ((< avoidance-heading-error -364.0889)
                                     (if (< (- avoidance-max-bank) avoidance-bank) (set! avoidance-bank (+ -91.022224 avoidance-bank)))
                                     avoidance-bank)
                                    ((< 364.0889 avoidance-heading-error)
                                     (if (< avoidance-bank avoidance-max-bank) (set! avoidance-bank (+ 91.022224 avoidance-bank)))
                                     avoidance-bank)
                                    ((< avoidance-bank 0.0) (+ 91.022224 avoidance-bank))
                                    (else (+ -91.022224 avoidance-bank)))))
                          (set! (-> avoiding-bird tilt) (- avoidance-bank))
                          (set! (-> avoiding-bird heading)
                                (the float (sar (shl (the int (+ (-> avoiding-bird heading) (* 0.05 avoidance-bank))) 48) 48))))
                        0)
                       (else
                        (let* ((target-heading (atan (-> to-target x) (-> to-target z)))
                               (targeting-bird steering-bird)
                               (target-heading-error (the float (sar (shl (the int (- target-heading (-> targeting-bird heading))) 48) 48)))
                               (target-bank (- (-> targeting-bird tilt))))
                          (let ((target-max-bank (-> targeting-bird max-tilt)))
                            (set! target-bank
                                  (cond
                                    ((< target-heading-error -364.0889)
                                     (if (< (- target-max-bank) target-bank) (set! target-bank (+ -91.022224 target-bank)))
                                     target-bank)
                                    ((< 364.0889 target-heading-error)
                                     (if (< target-bank target-max-bank) (set! target-bank (+ 91.022224 target-bank)))
                                     target-bank)
                                    ((< target-bank 0.0) (+ 91.022224 target-bank))
                                    (else (+ -91.022224 target-bank)))))
                          (set! (-> targeting-bird tilt) (- target-bank))
                          (set! (-> targeting-bird heading)
                                (the float (sar (shl (the int (+ (-> targeting-bird heading) (* 0.05 target-bank))) 48) 48))))
                        0))
                     (let ((horizontal-distance-squared (+ (* (-> to-target x) (-> to-target x)) (* (-> to-target z) (-> to-target z)))))
                       (set! (-> steering-bird angletan) (/ (- (-> to-target y)) (sqrtf horizontal-distance-squared)))
                       ;; og:preserve-this changed for high fps
                       (set! (-> steering-bird target-dist)
                             (* DISPLAY_FPS_RATIO (sqrtf (+ horizontal-distance-squared (* (-> to-target y) (-> to-target y))))))))
                   0
                   (let ((past-flap-start? (>= (ja-frame-num 0) (ja-aframe 3.0 0))))
                     (cond
                       ((and past-flap-start? (>= (ja-aframe 9.0 0) (ja-frame-num 0)))
                        (let* ((climbing-bird self)
                               (climb? #t)
                               (climb-velocity (-> climbing-bird root transv y)))
                          (set! climb-velocity
                                (cond
                                  (climb?
                                   (if (< climb-velocity (-> climbing-bird flock 0 max-lift)) (set! climb-velocity (+ 12288.0 climb-velocity)))
                                   climb-velocity)
                                  (else (+ -4096.0 climb-velocity))))
                          ;; og:preserve-this changed for high fps
                          (set! (-> climbing-bird root transv y) (* DISPLAY_FPS_RATIO climb-velocity)))
                        0)
                       (else
                        (let* ((descending-bird self)
                               (descend? #f)
                               (descent-velocity (-> descending-bird root transv y)))
                          (set! descent-velocity
                                (cond
                                  (descend?
                                   (if (< descent-velocity (-> descending-bird flock 0 max-lift)) (set! descent-velocity (+ 12288.0 descent-velocity)))
                                   descent-velocity)
                                  (else (+ -4096.0 descent-velocity))))
                          ;; og:preserve-this changed for high fps
                          (set! (-> descending-bird root transv y) (* DISPLAY_FPS_RATIO descent-velocity)))
                        0)))
                   (let* ((moving-bird self)
                          (thrust (-> self thrust))
                          (x-velocity (* thrust (sin (-> moving-bird heading))))
                          (z-velocity (* thrust (cos (-> moving-bird heading)))))
                     (set! (-> moving-bird root transv x) (+ (* 0.8 (-> moving-bird root transv x)) (* 0.2 x-velocity)))
                     (set! (-> moving-bird root transv z) (+ (* 0.8 (-> moving-bird root transv z)) (* 0.2 z-velocity))))
                   0
                   (integrate-with-air-bounds! self))
          (+! wingbeat-count 1)
          (when (>= wingbeat-count 0)
            (when (>= (-> self angletan) 0.1)
              (if (< 204800.0 (-> self root trans y)) (go seagull-soaring))
              (when (< 57344.0 (-> self root trans y))
                (let* ((soar-threshold 0.8)
                       (soar-mantissa (/ (the-as int (rand-uint31-gen *random-generator*)) 256))
                       (soar-random (the-as number (logior #x3f800000 soar-mantissa))))
                  (if (< soar-threshold (+ -1.0 (the-as float soar-random))) (go seagull-soaring)))))))))
  :post seagull-post)

(defstate seagull-soaring (seagull)
  :trans
    (behavior ()
      (when (< (+ (current-time) (seconds -2)) (-> self part-time))
        (-> self part)
        (-> self root root-prim prim-core)))
  :code
    (behavior ()
      (set-time! (-> self state-time))
      (set! (-> self max-tilt) 4551.1113)
      (loop
        (ja-play :group!
                 seagull-slowfly-ja
                 :num! (seek!)
                 :frame-num 0.0
                 (ja-blend-eval)
                 (when (-> self teleport)
                   (teleport-near-target! self)
                   (suspend)
                   0)
                 (let ((steering-bird self)
                       (to-target (new 'stack-no-clear 'vector)))
                   (vector-! to-target (-> steering-bird flock 0 target) (-> steering-bird root trans))
                   (when (< (vector-dot to-target to-target) 6710886400.0)
                     (let ((bird-bit (ash 1 (-> steering-bird index))))
                       (when (not (logtest? bird-bit (-> steering-bird flock 0 bird-at-waterfall)))
                         (logior! (-> steering-bird flock 0 bird-at-waterfall) bird-bit)
                         (+! (-> steering-bird flock 0 birds-at-waterfall) 1))))
                   (cond
                     ((> (-> steering-bird temp-heading-time) 0)
                      (+! (-> steering-bird temp-heading-time) -1)
                      (let* ((avoiding-bird steering-bird)
                             (avoidance-heading-error (the float (sar (shl (the int (- (-> steering-bird temp-heading) (-> avoiding-bird heading))) 48) 48)))
                             (avoidance-bank (- (-> avoiding-bird tilt))))
                        (let ((avoidance-max-bank (-> avoiding-bird max-tilt)))
                          (set! avoidance-bank
                                (cond
                                  ((< avoidance-heading-error -364.0889)
                                   (if (< (- avoidance-max-bank) avoidance-bank) (set! avoidance-bank (+ -91.022224 avoidance-bank)))
                                   avoidance-bank)
                                  ((< 364.0889 avoidance-heading-error)
                                   (if (< avoidance-bank avoidance-max-bank) (set! avoidance-bank (+ 91.022224 avoidance-bank)))
                                   avoidance-bank)
                                  ((< avoidance-bank 0.0) (+ 91.022224 avoidance-bank))
                                  (else (+ -91.022224 avoidance-bank)))))
                        (set! (-> avoiding-bird tilt) (- avoidance-bank))
                        (set! (-> avoiding-bird heading)
                              (the float (sar (shl (the int (+ (-> avoiding-bird heading) (* 0.05 avoidance-bank))) 48) 48))))
                      0)
                     (else
                      (let* ((target-heading (atan (-> to-target x) (-> to-target z)))
                             (targeting-bird steering-bird)
                             (target-heading-error (the float (sar (shl (the int (- target-heading (-> targeting-bird heading))) 48) 48)))
                             (target-bank (- (-> targeting-bird tilt))))
                        (let ((target-max-bank (-> targeting-bird max-tilt)))
                          (set! target-bank
                                (cond
                                  ((< target-heading-error -364.0889)
                                   (if (< (- target-max-bank) target-bank) (set! target-bank (+ -91.022224 target-bank)))
                                   target-bank)
                                  ((< 364.0889 target-heading-error)
                                   (if (< target-bank target-max-bank) (set! target-bank (+ 91.022224 target-bank)))
                                   target-bank)
                                  ((< target-bank 0.0) (+ 91.022224 target-bank))
                                  (else (+ -91.022224 target-bank)))))
                        (set! (-> targeting-bird tilt) (- target-bank))
                        (set! (-> targeting-bird heading)
                              (the float (sar (shl (the int (+ (-> targeting-bird heading) (* 0.05 target-bank))) 48) 48))))
                      0))
                   (let ((horizontal-distance-squared (+ (* (-> to-target x) (-> to-target x)) (* (-> to-target z) (-> to-target z)))))
                     (set! (-> steering-bird angletan) (/ (- (-> to-target y)) (sqrtf horizontal-distance-squared)))
                     ;; og:preserve-this changed for high fps
                     (set! (-> steering-bird target-dist)
                           (* DISPLAY_FPS_RATIO (sqrtf (+ horizontal-distance-squared (* (-> to-target y) (-> to-target y))))))))
                 0
                 (let ((sinking-bird self)) (set! (-> sinking-bird root transv y) -8192.0))
                 0
                 (let* ((moving-bird self)
                        (thrust (-> self thrust))
                        (x-velocity (* thrust (sin (-> moving-bird heading))))
                        (z-velocity (* thrust (cos (-> moving-bird heading)))))
                   ;; og:preserve-this changed for high fps
                   (set! (-> moving-bird root transv x)
                         (* DISPLAY_FPS_RATIO (+ (* 0.8 (-> moving-bird root transv x)) (* 0.2 x-velocity))))
                   (set! (-> moving-bird root transv z)
                         (* DISPLAY_FPS_RATIO (+ (* 0.8 (-> moving-bird root transv z)) (* 0.2 z-velocity)))))
                 0
                 (integrate-with-air-bounds! self)
                 (when (< (-> self angletan) 0.2)
                   (if (< (-> self root trans y) 40960.0) (go seagull-flying))
                   (when (< (-> self root trans y) 204800.0)
                     (if (and (time-elapsed? (-> self state-time) (seconds 0.5))
                              (let* ((resume-flapping-threshold 0.99)
                                     (resume-flapping-mantissa (/ (the-as int (rand-uint31-gen *random-generator*)) 256))
                                     (resume-flapping-random (the-as number (logior #x3f800000 resume-flapping-mantissa))))
                                (< resume-flapping-threshold (+ -1.0 (the-as float resume-flapping-random)))))
                       (go seagull-flying))))
                 (when (< (-> self target-dist) 81920.0)
                   (when (< 1.0 (-> self angletan))
                     (if (< (-> self target-dist) 20480.0) (go seagull-flying)))
                   (if (and (< 0.4 (-> self angletan)) (>= 1.0 (-> self angletan))) (go seagull-landing 10.0))
                   (if (and (>= (-> self angletan) 0.2) (>= 0.4 (-> self angletan))) (go seagull-landing 5.0))))))
  :post seagull-post)

;; Landing probes one second of downward travel.  Dynamic or missing ground is rejected, and the
;; bird returns to soaring.  On static ground it descends while leveling its bank, blends into the
;; landing animation, and settles back into the idle state.
(defstate seagull-landing (seagull)
  :code
    (behavior ((descent-speed float))
      (let ((ground-hit (new 'stack 'collide-tri-result)))
        0.0
        (let ((landing-move (new 'stack-no-clear 'vector)))
          (set! (-> self root transv y) (* 4096.0 (- descent-speed)))
          (vector-copy! landing-move (-> self root transv))
          (let ((time-to-ground (fill-and-probe-using-line-sphere *collide-cache*
                                                                  (-> self root trans)
                                                                  landing-move
                                                                  409.6
                                                                  (collide-kind background)
                                                                  self
                                                                  ground-hit
                                                                  (new 'static 'pat-surface :noentity #x1))))
            (when (or (< time-to-ground 0.0) (or (< 1.0 time-to-ground) (nonzero? (-> ground-hit pat mode))))
              (suspend)
              (go seagull-soaring))
            (vector-float*! landing-move landing-move time-to-ground)
            (vector+! landing-move landing-move (-> self root trans))
            (while (< 0.5 time-to-ground)
              (suspend)
              (set! time-to-ground (- time-to-ground (seconds-per-frame)))
              (fill-cache-integrate-and-collide! (-> self root) (-> self root transv) (collide-kind background))
              (let* ((approach-bird self)
                     (approach-heading-error (the float (sar (shl (the int (- (-> self heading) (-> approach-bird heading))) 48) 48)))
                     (approach-bank (- (-> approach-bird tilt))))
                (let ((approach-max-bank (-> approach-bird max-tilt)))
                  (set! approach-bank
                        (cond
                          ((< approach-heading-error -364.0889)
                           (if (< (- approach-max-bank) approach-bank) (set! approach-bank (+ -91.022224 approach-bank)))
                           approach-bank)
                          ((< 364.0889 approach-heading-error)
                           (if (< approach-bank approach-max-bank) (set! approach-bank (+ 91.022224 approach-bank)))
                           approach-bank)
                          ((< approach-bank 0.0) (+ 91.022224 approach-bank))
                          (else (+ -91.022224 approach-bank)))))
                (set! (-> approach-bird tilt) (- approach-bank))
                (set! (-> approach-bird heading)
                      (the float (sar (shl (the int (+ (-> approach-bird heading) (* 0.05 approach-bank))) 48) 48))))
              0)
            (ja-no-eval :num! (seek!))
            (ja-channel-push! 1 (seconds 0.135))
            (ja :group! seagull-land-ja :num! (identity (ja-aframe 0.0 0)))
            (while (< 0.0 time-to-ground)
              (suspend)
              (ja :num! (seek!))
              (set! time-to-ground (- time-to-ground (seconds-per-frame)))
              (fill-cache-integrate-and-collide! (-> self root) (-> self root transv) (collide-kind background))
              (let* ((touchdown-bird self)
                     (touchdown-heading-error (the float (sar (shl (the int (- (-> self heading) (-> touchdown-bird heading))) 48) 48)))
                     (touchdown-bank (- (-> touchdown-bird tilt))))
                (let ((touchdown-max-bank (-> touchdown-bird max-tilt)))
                  (set! touchdown-bank
                        (cond
                          ((< touchdown-heading-error -364.0889)
                           (if (< (- touchdown-max-bank) touchdown-bank) (set! touchdown-bank (+ -91.022224 touchdown-bank)))
                           touchdown-bank)
                          ((< 364.0889 touchdown-heading-error)
                           (if (< touchdown-bank touchdown-max-bank) (set! touchdown-bank (+ 91.022224 touchdown-bank)))
                           touchdown-bank)
                          ((< touchdown-bank 0.0) (+ 91.022224 touchdown-bank))
                          (else (+ -91.022224 touchdown-bank)))))
                (set! (-> touchdown-bird tilt) (- touchdown-bank))
                (set! (-> touchdown-bird heading)
                      (the float (sar (shl (the int (+ (-> touchdown-bird heading) (* 0.05 touchdown-bank))) 48) 48))))
              0))))
      (while (not (ja-done? 0))
        (suspend)
        (ja :num! (seek!))
        (let* ((settling-bird self)
               (settling-heading-error (the float (sar (shl (the int (- (-> self heading) (-> settling-bird heading))) 48) 48)))
               (settling-bank (- (-> settling-bird tilt))))
          (let ((settling-max-bank (-> settling-bird max-tilt)))
            (set! settling-bank
                  (cond
                    ((< settling-heading-error -364.0889)
                     (if (< (- settling-max-bank) settling-bank) (set! settling-bank (+ -91.022224 settling-bank)))
                     settling-bank)
                    ((< 364.0889 settling-heading-error)
                     (if (< settling-bank settling-max-bank) (set! settling-bank (+ 91.022224 settling-bank)))
                     settling-bank)
                    ((< settling-bank 0.0) (+ 91.022224 settling-bank))
                    (else (+ -91.022224 settling-bank)))))
          (set! (-> settling-bird tilt) (- settling-bank))
          (set! (-> settling-bird heading)
                (the float (sar (shl (the int (+ (-> settling-bird heading) (* 0.05 settling-bank))) 48) 48))))
        0)
      (go seagull-idle))
  :post seagull-post)

(defun seagull-reaction ((shape collide-shape-moving) (intersection collide-shape-intersect) (unused-a vector) (unused-b vector))
  "Apply the accepted collision displacement while retaining the full vertical move, then remove
   velocity into the hit surface so the bird slides along it. Steer away along the contact normal
   for one second and return the collision contact bits. The final two vector arguments are
   unused."
  (let ((status-bits 0))
    (let ((accepted-move (new 'stack-no-clear 'vector)))
      (vector-float*! accepted-move (-> intersection move-vec) (-> intersection best-u))
      (set! (-> accepted-move y) (-> intersection move-vec y))
      (move-by-vector! shape accepted-move))
    (let ((normal-speed (vector-dot (-> shape transv) (-> intersection best-tri normal)))
          (normal-velocity (new 'stack-no-clear 'vector)))
      (vector-float*! normal-velocity (-> intersection best-tri normal) normal-speed)
      (vector-! (-> shape transv) (-> shape transv) normal-velocity))
    (let ((contact-normal (-> intersection best-tri normal))
          (bird-process (-> shape process)))
      (set! (-> (the-as seagull bird-process) temp-heading) (atan (-> contact-normal x) (-> contact-normal z)))
      (set! (-> (the-as seagull bird-process) temp-heading-time) (seconds 1)))
    (let ((result-status (logior status-bits 3)))
      (set! (-> shape status) (the-as collide-status result-status))
      (the-as collide-status result-status))))

(defbehavior seagull-init-by-other seagull ((position vector) (index int) (flock seagullflock))
  "Create a seagull's moving collision shape and indestructible half-metre sphere, place it at
   position, attach it to flock at index, choose a random thrust from 12.5 to 17.5 metres per
   second, and enter idle."
  (let ((root-shape (new 'process 'collide-shape-moving self (collide-list-enum hit-by-player))))
    (set! (-> root-shape dynam) (copy *standard-dynamics* 'process))
    (set! (-> root-shape reaction) seagull-reaction)
    (set! (-> root-shape no-reaction)
          (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (let ((collision-sphere (new 'process 'collide-shape-prim-sphere root-shape (the-as uint 0))))
      (set! (-> collision-sphere prim-core collide-as) (collide-kind))
      (set! (-> collision-sphere collide-with) (collide-kind background))
      (set! (-> collision-sphere prim-core action) (collide-action solid))
      (set! (-> collision-sphere prim-core offense) (collide-offense indestructible))
      (set-vector! (-> collision-sphere local-sphere) 0.0 2048.0 0.0 2048.0)
      (set-root-prim! root-shape collision-sphere))
    (set! (-> root-shape nav-radius) (* 0.75 (-> root-shape root-prim local-sphere w)))
    (backup-collide-with-as root-shape)
    (set! (-> self root) root-shape))
  (vector-copy! (-> self root trans) position)
  (initialize-skeleton self *seagull-sg* '())
  (logclear! (-> self mask) (process-mask actor-pause))
  (set! (-> self index) index)
  (set! (-> self flock) (the-as (pointer seagullflock) (process->ppointer flock)))
  (set! (-> self heading) 0.0)
  (set! (-> self tilt) 0.0)
  (let ((thrust-base 51200.0)
        (thrust-range 20480.0))
    (set! (-> self thrust) (+ thrust-base (* thrust-range (rand-float-gen)))))
  (set! (-> self teleport) #f)
  (go seagull-idle)
  (none))

(defmethod play-hint ((this seagullflock) (triggering-bird-index int))
  "At most once every five seconds, advance the flock target and sidekick hint, save progress,
   and stagger every bird's takeoff. triggering-bird-index takes off immediately. After the
   fourth target is selected, begin the delayed waterfall transition."
  (when (time-elapsed? (-> this alert-time) (seconds 5))
    (eval-path-curve-div! (-> this path) (-> this target) (the float (-> this targetnum)) 'interp)
    (let ((metres 4096.0)
          (target-index (-> this targetnum)))
      (set! (-> this max-lift)
            (* metres
               (cond
                 ((= target-index 1) 4.0)
                 ((= target-index 2) 4.0)
                 ((= target-index 3) 4.0)
                 (else 10.0)))))
    (case (-> this targetnum)
      ((1) (level-hint-spawn (text-id sidekick-seagulls1) "sksp0020" (the-as entity #f) *entity-pool* (game-task none)))
      ((2) (level-hint-spawn (text-id sidekick-seagulls2) "sksp0022" (the-as entity #f) *entity-pool* (game-task none)))
      ((3) (level-hint-spawn (text-id sidekick-seagulls3) "sksp0023" (the-as entity #f) *entity-pool* (game-task none)))
      ((4) (level-hint-spawn (text-id sidekick-seagulls4) "sksp0024" (the-as entity #f) *entity-pool* (game-task none))))
    (let ((perm-state (-> this entity extra perm)))
      (logior! (-> perm-state status) (entity-perm-status user-set-from-cstage))
      (set! (-> perm-state user-int8 0) (min 2 (-> this targetnum))))
    (+! (-> this targetnum) 1)
    (dotimes (i (-> this birds))
      (set! (-> this bird i 0 scared) (+ (* i 2) 5)))
    (set! (-> this bird triggering-bird-index 0 scared) 1)
    (set! (-> this bird-at-waterfall) (the-as uint 0))
    (set! (-> this birds-at-waterfall) 0)
    (if (>= (-> this targetnum) 4) (set! (-> this teleport-frames) 1500))
    (sound-play "seagull-takeoff")
    (set-time! (-> this alert-time)))
  (none))

(defmethod heading-to-target ((this seagullflock) (bird seagull))
  "Return the heading angle from bird to the flock's current path target."
  (let ((to-target (new 'stack-no-clear 'vector)))
    (eval-path-curve-div! (-> this path) to-target (the float (-> this targetnum)) 'interp)
    (vector-! to-target to-target (-> bird root trans))
    (atan (-> to-target x) (-> to-target z))))

;; The four sidekick hints advance the flock along its path and save the first two steps in the
;; entity's permanent state.  Reaching the last target starts a delayed handoff to the linked
;; avalanche rock: ask it to load, teleport every bird near the final target under blackout, trigger
;; the rock, and keep this flock alive until the rock records completion.
(defstate seagullflock-at-waterfall (seagullflock)
  :code
    (behavior ()
      (local-vars
        (linked-process process)
        (loading-message event-message-block)
        (send-loading (function process-tree event-message-block object)))
      (aybabtu 2)
      (set-time! (-> self state-time))
      (-> self link next)
      (until (send-loading linked-process loading-message)
        (suspend)
        (let ((linked-entity (-> self link next)))
          (set! loading-message (new 'stack-no-clear 'event-message-block))
          (set! (-> loading-message from) self)
          (set! (-> loading-message num-params) 0)
          (set! (-> loading-message message) 'loading)
          (set! send-loading send-event-function)
          (set! linked-process (if linked-entity (-> linked-entity extra process)))))
      (until (time-elapsed? (-> self state-time) (-> self teleport-frames))
        (suspend))
      (close-specific-task! (game-task beach-seagull) (task-status need-reminder))
      (dotimes (i (-> self birds))
        (set! (-> self bird i 0 teleport) #t))
      (let ((avalanche-rock (-> self link next)))
        (set-blackout-frames (seconds 2))
        (suspend)
        (let ((trigger-message (new 'stack-no-clear 'event-message-block)))
          (set! (-> trigger-message from) self)
          (set! (-> trigger-message num-params) 0)
          (set! (-> trigger-message message) 'trigger)
          (let ((send-trigger send-event-function)
                (trigger-target avalanche-rock))
            (send-trigger (if trigger-target (-> trigger-target extra process)) trigger-message)))
        (while (not (logtest? (-> avalanche-rock extra perm status) (entity-perm-status complete)))
          (suspend)))
      (process-entity-status! self (entity-perm-status dead) #t)))

(defstate seagullflock-idle (seagullflock)
  :code
    (behavior ()
      (loop
        (if (> (-> self teleport-frames) 0) (go seagullflock-at-waterfall))
        (if (and *target* (>= 102400.0 (vector-vector-distance (-> self trans) (-> *target* control trans))))
          (level-hint-spawn (text-id zero) (the-as string #f) (-> self entity) *entity-pool* (game-task none)))
        (suspend))))

(defmethod init-from-entity! ((this seagullflock) (source-entity entity-actor))
  "Resume the flock at the path point following its saved hint progress, spawn one bird at the
   target and twenty birds in a ten-metre square, start the ambient flock sound, and enter
   idle."
  (logclear! (-> this mask) (process-mask actor-pause))
  (set! (-> this path) (new 'process 'path-control this 'path 0.0))
  (logior! (-> this path flags) (path-control-flag display draw-line draw-point draw-text))
  (set! (-> this link) (new 'process 'actor-link-info this))
  (set! (-> this targetnum) (+ (-> source-entity extra perm user-int8 0) 1))
  (eval-path-curve-div! (-> this path) (-> this trans) (the float (+ (-> this targetnum) -1)) 'interp)
  (vector-copy! (-> this target) (-> this trans))
  (set! (-> this max-lift) 20480.0)
  (set! (-> this birds) 0)
  (dotimes (i SEAGULLFLOCK_MAX)
    (set! (-> this bird i) (the-as (pointer seagull) #f)))
  (spawn-bird this (-> this trans))
  (dotimes (i 20)
    (let ((spawn-pos (new 'stack-no-clear 'vector)))
      (let* ((x-base (-> this trans x))
             (x-unit-scale 4096.0)
             (x-range 10.0)
             (x-mantissa (/ (the-as int (rand-uint31-gen *random-generator*)) 256))
             (x-random (the-as number (logior #x3f800000 x-mantissa))))
        (set! (-> spawn-pos x) (+ x-base (* x-unit-scale (* x-range (+ -1.0 (the-as float x-random)))))))
      (let* ((z-base (-> this trans z))
             (z-unit-scale 4096.0)
             (z-range 10.0)
             (z-mantissa (/ (the-as int (rand-uint31-gen *random-generator*)) 256))
             (z-random (the-as number (logior #x3f800000 z-mantissa))))
        (set! (-> spawn-pos z) (+ z-base (* z-unit-scale (* z-range (+ -1.0 (the-as float z-random)))))))
      (set! (-> spawn-pos y) (-> this trans y))
      (set! (-> spawn-pos w) 1.0)
      (spawn-bird this spawn-pos)))
  (set! (-> this squall) (new 'process 'ambient-sound sound-seagull-squall (-> this trans)))
  (set! (-> this teleport-frames) 0)
  (logior! (-> this mask) (process-mask enemy))
  (go seagullflock-idle)
  (none))

(defmethod spawn-bird ((this seagullflock) (position vector))
  "Spawn one seagull at position, store it in the flock's fixed bird table, and return the new
   process. Return false when all sixty-four slots are occupied."
  ;; og:preserve-this constant
  (if (= (-> this birds) SEAGULLFLOCK_MAX) (return (the-as (pointer process) #f)))
  (let ((spawned-bird (process-spawn seagull position (-> this birds) this :to this)))
    (set! (-> this bird (-> this birds)) (the-as (pointer seagull) spawned-bird))
    (+! (-> this birds) 1)
    spawned-bird))

(defun-debug beach-rock-trigger ()
  "Start the active seagull flock's one-second delay before the waterfall avalanche transition."
  (set! (-> (the-as seagullflock
                    (search-process-tree *active-pool* (lambda ((candidate process)) (= (-> candidate type) seagullflock))))
            teleport-frames)
        600))

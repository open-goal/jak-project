;;-*-Lisp-*-
(in-package goal)
(bundles "BEA.DGO")
(require "engine/math/vector-h.gc")

;; DECOMP BEGINS

;; An upward-unbounded volume over a rotated X/Z rectangle. The rectangle begins at x-pos/z-pos;
;; vecs[1].x and .z hold its local side lengths, while the unused .y lane keeps the packed layout.
(deftype air-box (structure)
  ((vecs         vector 2 :inline)
   (x-pos        float :overlay-at (-> vecs 0 x))
   (height-level float :overlay-at (-> vecs 0 y))
   (z-pos        float :overlay-at (-> vecs 0 z))
   (cos-angle    float :overlay-at (-> vecs 0 w))
   (x-length     float :offset 16)
   (z-length     float :offset 24)
   (sin-angle    float :offset 28)))

(defun point-in-air-box-area? ((x-offset float) (z-offset float) (air-volume air-box))
  "Return true when an X/Z offset from the air box's origin lies inside its rotated horizontal
   rectangle. Rotate by the stored sine and cosine and test the half-open local ranges
   [0, x-length) and [0, z-length)."
  (let ((inside? #f))
    (let ((local-x (+ (* x-offset (-> air-volume cos-angle)) (* z-offset (-> air-volume sin-angle))))
          (local-z (- (* z-offset (-> air-volume cos-angle)) (* x-offset (-> air-volume sin-angle)))))
      (if (and (>= local-x 0.0) (>= local-z 0.0) (< local-x (-> air-volume x-length)) (< local-z (-> air-volume z-length)))
        (set! inside? #t)))
    inside?))

(defun point-in-air-box? ((position vector) (air-volume air-box))
  "Return true when position is strictly above the air box's height level and its X/Z offset lies
   inside the rotated horizontal rectangle. The volume has no upper height bound."
  (when (< (-> air-volume height-level) (-> position y))
    (let ((x-offset (- (-> position x) (the-as float (-> air-volume x-pos))))
          (z-offset (- (-> position z) (-> air-volume z-pos))))
      (let ((inside? #f))
        (let ((local-x (+ (* x-offset (-> air-volume cos-angle)) (* z-offset (-> air-volume sin-angle))))
              (local-z (- (* z-offset (-> air-volume cos-angle)) (* x-offset (-> air-volume sin-angle)))))
          (if (and (>= local-x 0.0) (>= local-z 0.0) (< local-x (-> air-volume x-length)) (< local-z (-> air-volume z-length)))
            (set! inside? #t)))
        inside?))))

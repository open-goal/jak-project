(defstate ecoventrock-idle (ecoventrock)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('attack)
         (sound-play "cannon-shot")
         (increment-success-for-hint (text-id sidekick-hint-ecorocks))
         (go ecoventrock-break #f))))
  :code
    (behavior ()
      (transform-post)
      (loop
        (logior! (-> self mask) (process-mask sleep))
        (suspend))))

(defstate ecoventrock-break (ecoventrock)
  ;; Break the cap into four temporary rocks. Three fan away from Jak across the ground, while the
  ;; fourth takes a shorter diagonal path from the center of the vent.
  :event process-drawable-fuel-cell-handler
  :enter
    (behavior ((already-broken? symbol))
      (set-time! (-> self state-time)))
  :code
    (behavior ((already-broken? symbol))
      (ja-channel-set! 0)
      (clear-collide-with-as (-> self root))
      (ja-post)
      (process-entity-status! self (entity-perm-status complete) #t)
      (let ((linked-harvester (entity-actor-lookup (-> self entity) 'alt-actor 0)))
        (send-event (if linked-harvester (-> linked-harvester extra process)) 'update))
      (when (not already-broken?)
        (process-spawn part-tracker
                       :init
                       part-tracker-init
                       group-beach-harvester-rock-explosion
                       -1
                       #f
                       #f
                       #f
                       (-> self root root-prim prim-core)
                       :to
                       *entity-pool*)
        (let* ((rock-position (-> self root trans))
               (target-position (target-pos 0))
               (away-x (- (-> rock-position x) (-> target-position x)))
               (away-z (- (-> rock-position z) (-> target-position z)))
               (horizontal-speed 7372.8)
               (vertical-speed 5734.4)
               (horizontal-scale (/ horizontal-speed (sqrtf (+ (square away-x) (square away-z)))))
               (velocity-x (* away-x horizontal-scale))
               (velocity-z (* away-z horizontal-scale))
               (spawn-position (new-stack-vector0))
               (velocity (new-stack-vector0)))
          (set-vector! velocity velocity-x vertical-speed velocity-z 1.0)
          (set-vector! spawn-position
                       (+ (-> rock-position x) (-> velocity x))
                       (-> rock-position y)
                       (+ (-> rock-position z) (-> velocity z))
                       1.0)
          (vector-float*! velocity velocity 10.0)
          (spawn-flying-rock spawn-position velocity 1.0 (-> self entity))
          (let ((left-angle (rand-vu-float-range 90.0 130.0))
                (right-angle (rand-vu-float-range 230.0 270.0)))
            (let ((left-cos (cos (* 182.04445 left-angle)))
                  (left-sin (sin (* 182.04445 left-angle))))
              (set-vector! velocity
                           (+ (* velocity-z left-sin) (* velocity-x left-cos))
                           vertical-speed
                           (+ (* velocity-x (- left-sin)) (* velocity-z left-cos))
                           1.0))
            (set-vector! spawn-position
                         (+ (-> rock-position x) (-> velocity x))
                         (-> rock-position y)
                         (+ (-> rock-position z) (-> velocity z))
                         1.0)
            (vector-float*! velocity velocity 10.0)
            (spawn-flying-rock spawn-position velocity 1.0 (-> self entity))
            (let ((right-cos (cos (* 182.04445 right-angle)))
                  (right-sin (sin (* 182.04445 right-angle))))
              (set-vector! velocity
                           (+ (* velocity-z right-sin) (* velocity-x right-cos))
                           vertical-speed
                           (+ (* velocity-x (- right-sin)) (* velocity-z right-cos))
                           1.0)))
          (set-vector! spawn-position
                       (+ (-> rock-position x) (-> velocity x))
                       (-> rock-position y)
                       (+ (-> rock-position z) (-> velocity z))
                       1.0)
          (vector-float*! velocity velocity 10.0)
          (spawn-flying-rock spawn-position velocity 1.0 (-> self entity))
          (set-vector! velocity
                       (+ (* -0.866 velocity-z) (/ velocity-x 2))
                       (/ vertical-speed 2)
                       (+ (* 0.866 velocity-x) (/ velocity-z 2))
                       1.0)
          (set-vector! spawn-position (-> rock-position x) (+ 3276.8 (-> rock-position y)) (-> rock-position z) 1.0)
          (vector-float*! velocity velocity 10.0)
          (spawn-flying-rock spawn-position velocity 1.0 (-> self entity))))
      (when (or (-> self link prev) (-> self link next))
        (let ((has-linked-task? (the-as symbol #f)))
          (apply-all (-> self link) actor-link-subtask-complete-hook (& has-linked-task?))
          (when has-linked-task?
            (suspend-for (seconds 0.5))
            (let ((camera-handle (cond
                                   (already-broken? (the-as int #f))
                                   (else
                                    (ambient-hint-spawn "gamcam10" (the-as vector #f) *entity-pool* 'camera)
                                    (ppointer->handle (process-spawn pov-camera (-> self root trans) *beachcam-sg* (-> self name) 0 #f '() :to self))))))
              (process-drawable-birth-fuel-cell (the-as entity #f) (the-as vector #f) #f)
              (while (handle->process (the-as handle camera-handle))
                (suspend)))
            (while (-> self child)
              (suspend)))))
      (process-entity-status! self (entity-perm-status dead) #t)
      (deactivate self)))

(defmethod init-from-entity! ((this ecoventrock) (source-entity entity-actor))
  "Create the vent rock's collision and skeleton, attach its actor link and navigation mesh, and
   enter the already-broken state when the entity is persistently complete."
  (logior! (-> this mask) (process-mask enemy))
  (let ((root-shape (new 'process 'collide-shape this (collide-list-enum hit-by-player))))
    (let ((rock-mesh (new 'process 'collide-shape-prim-mesh root-shape (the-as uint 0) (the-as uint 0))))
      (set! (-> rock-mesh prim-core collide-as) (collide-kind enemy))
      (set! (-> rock-mesh collide-with) (collide-kind target))
      (set! (-> rock-mesh prim-core action) (collide-action solid))
      (set! (-> rock-mesh prim-core offense) (collide-offense indestructible))
      (set! (-> rock-mesh transform-index) 0)
      (set-vector! (-> rock-mesh local-sphere) 0.0 2457.6 0.0 6963.2)
      (set-root-prim! root-shape rock-mesh))
    (set! (-> root-shape nav-radius) (* 0.75 (-> root-shape root-prim local-sphere w)))
    (backup-collide-with-as root-shape)
    (set! (-> this root) root-shape))
  (process-drawable-from-entity! this source-entity)
  (initialize-skeleton this *ecoventrock-sg* '())
  (set! (-> this link) (new 'process 'actor-link-info this))
  (transform-post)
  (nav-mesh-connect this (-> this root) (the-as nav-control #f))
  (if (and (-> this entity) (logtest? (-> this entity extra perm status) (entity-perm-status complete)))
    (go ecoventrock-break #t)
    (go ecoventrock-idle))
  (none))

(deftype flying-rock (process-drawable)
  ((root   collide-shape-moving :override)
   (tumble quaternion :inline))
  (:states
   flying-rock-idle
   flying-rock-rolling))

(defskelgroup *kickrock-sg*
  kickrock
  kickrock-lod0-jg
  kickrock-idle-ja
  ((kickrock-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 10))

(defstate flying-rock-rolling (flying-rock)
  ;; First wait for two separate ground contacts so a bouncing rock cannot immediately settle.
  ;; Afterward, roll from horizontal travel until the remaining velocity is negligible.
  :enter
    (behavior ()
      (set-time! (-> self state-time)))
  :code
    (behavior ()
      (let ((on-ground? #f)
            (damping 0.99)
            (ground-contacts 0))
        (while (< ground-contacts 2)
          (cond
            ((logtest? (-> self root status) (collide-status on-surface))
             (when (not on-ground?)
               (+! ground-contacts 1)
               (set! damping 0.8)
               (set! on-ground? #t)))
            (else (when on-ground? (set! damping 0.99) (set! on-ground? #f))))
          (vector-float*! (-> self root transv) (-> self root transv) damping)
          (set! (-> self root transv w) 1.0)
          (if (not on-ground?)
            (vector-v++! (-> self root transv) (compute-acc-due-to-gravity (-> self root) (new-stack-vector0) 1.0)))
          (update-transforms! (-> self root))
          (fill-cache-integrate-and-collide! (-> self root) (-> self root transv) (collide-kind background))
          (quaternion*! (-> self root quat) (-> self root quat) (-> self tumble))
          (suspend)))
      (while (< 2048.0 (vector-length (-> self root transv)))
        (cond
          ((logtest? (-> self root status) (collide-status on-surface))
           (vector-float*! (-> self root transv) (-> self root transv) 0.8))
          (else
           (vector-float*! (-> self root transv) (-> self root transv) 0.99)
           (vector-v++! (-> self root transv) (compute-acc-due-to-gravity (-> self root) (new-stack-vector0) 1.0))))
        (set! (-> self root transv w) 1.0)
        (update-transforms! (-> self root))
        (fill-cache-integrate-and-collide! (-> self root) (-> self root transv) (collide-kind background))
        (let ((roll-axis (new 'stack-no-clear 'vector))
              (speed (vector-length (-> self root transv))))
          (set-vector! roll-axis (-> self root transv z) 0.0 (- (-> self root transv x)) 1.0)
          (vector-normalize! roll-axis 1.0)
          (let ((distance-in-turns (* 0.00061035156 (seconds-per-frame) speed)))
            (quaternion-vector-angle! (-> self tumble) roll-axis (* 10430.379 distance-in-turns))))
        (quaternion*! (-> self root quat) (-> self tumble) (-> self root quat))
        (suspend))
      (go flying-rock-idle))
  :post
    (behavior ()
      (if (time-elapsed? (-> self state-time) (seconds 3)) (go flying-rock-idle))
      (ja-post)))

(defstate flying-rock-idle (flying-rock)
  :code
    (behavior ()
      (clear-collide-with-as (-> self root))
      (while (or (logtest? (-> self draw status) (draw-status was-drawn))
                 (and *target* (>= 204800.0 (vector-vector-distance (-> self root trans) (-> *target* control trans)))))
        (suspend))
      (deactivate self))
  :post ja-post)

(defbehavior flying-rock-init-by-other flying-rock ((position vector) (velocity vector) (scale float) (source-entity entity-actor))
  "Initialize a temporary flying rock at position with velocity and scale, including its spherical
   collision, random initial orientation, and random tumble axis, then enter rolling."
  (set! (-> self entity) source-entity)
  (let ((root-shape (new 'process 'collide-shape-moving self (collide-list-enum hit-by-player))))
    (set! (-> root-shape dynam) (copy *standard-dynamics* 'process))
    (set! (-> root-shape reaction) simple-collision-reaction)
    (set! (-> root-shape no-reaction)
          (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (let ((sphere-prim (new 'process 'collide-shape-prim-sphere root-shape (the-as uint 0))))
      (set! (-> sphere-prim prim-core collide-as) (collide-kind enemy))
      (set! (-> sphere-prim collide-with) (collide-kind background target))
      (set! (-> sphere-prim prim-core action) (collide-action solid))
      (set! (-> sphere-prim prim-core offense) (collide-offense indestructible))
      (set! (-> sphere-prim transform-index) 0)
      (set-vector! (-> sphere-prim local-sphere) 0.0 0.0 0.0 (* 409.6 scale))
      (set-root-prim! root-shape sphere-prim))
    (set! (-> root-shape nav-radius) (* 0.75 (-> root-shape root-prim local-sphere w)))
    (backup-collide-with-as root-shape)
    (set! (-> self root) root-shape))
  (vector-copy! (-> self root trans) position)
  (set-vector! (-> self root scale) scale scale scale 1.0)
  (let ((tumble-axis (new-stack-vector0)))
    (set-vector! tumble-axis
                 (rand-vu-float-range -1.0 1.0)
                 (rand-vu-float-range -1.0 1.0)
                 (rand-vu-float-range -1.0 1.0)
                 1.0)
    (vector-normalize! tumble-axis 1.0)
    (quaternion-vector-angle! (-> self tumble) tumble-axis (rand-vu-float-range 0.0 1820.4445)))
  (quaternion-axis-angle! (-> self root quat) 0.0 1.0 0.0 (rand-vu-float-range 0.0 65536.0))
  (initialize-skeleton self *kickrock-sg* '())
  (vector-copy! (-> self root transv) velocity)
  (go flying-rock-rolling)
  (none))

(defun spawn-flying-rock ((position vector) (velocity vector) (scale float) (source-entity entity))
  "Spawn a temporary flying rock at position with velocity and scale, owned by source-entity."
  (process-spawn flying-rock position velocity scale source-entity :to *entity-pool*)
  0
  (none))

(deftype bladeassm (process-drawable)
  ((root  collide-shape-moving :override)
   (angle float))
  (:states
   bladeassm-idle))

(defskelgroup *bladeassm-sg*
  bladeassm
  bladeassm-lod0-jg
  bladeassm-idle-ja
  ((bladeassm-lod0-mg (meters 20)) (bladeassm-lod1-mg (meters 40)) (bladeassm-lod2-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 10)
  :longest-edge (meters 10))

(defstate bladeassm-idle (bladeassm)
  :code
    (behavior ()
      (loop
        (+! (-> self angle) (* 3640.889 (seconds-per-frame)))
        (set! (-> self angle) (the float (sar (shl (the int (-> self angle)) 48) 48)))
        (pusher-post)
        (suspend))))

(defun bladeassm-prebind-function ((joint-transforms pointer) (joint-count int) (blade-assembly bladeassm))
  "Write the assembly's current blade angle as a Z-axis quaternion into the blade joint transform
   before skeleton binding."
  (quaternion-axis-angle! (the-as quaternion (&+ joint-transforms 144)) 0.0 0.0 1.0 (-> blade-assembly angle))
  0
  (none))

(defmethod init-from-entity! ((this bladeassm) (source-entity entity-actor))
  "Create the blade assembly's moving mesh collision and skeleton, install the joint prebind
   callback that applies its blade angle, disable actor pause, and enter idle."
  (logior! (-> this mask) (process-mask ambient))
  (let ((root-shape (new 'process 'collide-shape-moving this (collide-list-enum hit-by-player))))
    (set! (-> root-shape dynam) (copy *standard-dynamics* 'process))
    (set! (-> root-shape reaction) default-collision-reaction)
    (set! (-> root-shape no-reaction)
          (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (let ((blade-mesh (new 'process 'collide-shape-prim-mesh root-shape (the-as uint 0) (the-as uint 0))))
      (set! (-> blade-mesh prim-core collide-as) (collide-kind ground-object))
      (set! (-> blade-mesh collide-with) (collide-kind target))
      (set! (-> blade-mesh prim-core action) (collide-action solid))
      (set! (-> blade-mesh prim-core offense) (collide-offense indestructible))
      (set! (-> blade-mesh transform-index) 3)
      (set-vector! (-> blade-mesh local-sphere) 0.0 0.0 0.0 49152.0)
      (set-root-prim! root-shape blade-mesh))
    (set! (-> root-shape nav-radius) (* 0.75 (-> root-shape root-prim local-sphere w)))
    (backup-collide-with-as root-shape)
    (set! (-> this root) root-shape))
  (process-drawable-from-entity! this source-entity)
  (initialize-skeleton this *bladeassm-sg* '())
  (set! (-> this skel prebind-function) bladeassm-prebind-function)
  (logclear! (-> this mask) (process-mask actor-pause))
  (go bladeassm-idle)
  (none))

(deftype flutflutegg (process-drawable)
  ((root                collide-shape-moving :override)
   (fall-dist           meters)
   (start               vector :inline)
   (dir                 vector :inline)
   (pos                 float)
   (vel                 float)
   (wobbler             wobbler)
   (last-impulse-time   int32)
   (incomming-attack-id uint64)
   (ambients-played     int32)
   (ambient             ambient-control :inline))
  (:methods
   (apply-hit-impulse! (_type_ float float float) none))
  (:states (flutflutegg-break symbol)
   flutflutegg-idle
   flutflutegg-physics
   flutflutegg-physics-fall))

(defskelgroup *flutflutegg-sg*
  flutflutegg
  flutflutegg-lod0-jg
  flutflutegg-idle-ja
  ((flutflutegg-lod0-mg (meters 20)) (flutflutegg-lod1-mg (meters 40)) (flutflutegg-lod2-mg (meters 999999)))
  :bounds (static-spherem 0 3.5 0 3.5))

(defskelgroup *flutflut-naked-sg*
  flutflut
  flutflut-lod0-jg
  flutflut-flutflut-idle-ja
  ((flutflut-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 8))

(defmethod relocate ((this flutflutegg) (offset int))
  "Relocate the separately allocated wobbler when present, then relocate the drawable."
  (if (nonzero? (-> this wobbler)) (&+! (-> this wobbler) offset))
  (call-parent-method this offset))

;; WARN: Function (method 20 flutflutegg) has a return type of none, but the expression builder found a return statement.
(defmethod apply-hit-impulse! ((this flutflutegg) (velocity-impulse float) (wobble-x-impulse float) (wobble-y-impulse float))
  "Apply a forward velocity impulse and X/Y wobble impulses to the egg. Ignore repeated impulses
   until half a second has elapsed."
  (if (not (time-elapsed? (the-as time-frame (-> this last-impulse-time)) (seconds 0.5))) (return 0))
  (set! (-> this last-impulse-time) (the-as int (current-time)))
  (+! (-> this vel) velocity-impulse)
  (inc-xy-vel! (-> this wobbler) wobble-x-impulse wobble-y-impulse)
  0
  (none))

(defbehavior flutflutegg-hit-sounds flutflutegg ()
  "Play the egg's impact sound and, once the Flut Flut introduction is complete, choose the next
   one-shot hit reaction line that has not already played."
  (sound-play "egg-hit")
  (cond
    ((not (task-closed? (game-task beach-flutflut) (task-status need-introduction))))
    ((not (logtest? (-> self ambients-played) 8))
     (if (play-ambient (-> self ambient) "BIR-AM04" #f (the-as vector #f)) (logior! (-> self ambients-played) 8)))
    ((not (logtest? (-> self ambients-played) 512))
     (if (play-ambient (-> self ambient) "BIR-AM10" #f (the-as vector #f)) (logior! (-> self ambients-played) 512))))
  (none))

(defstate flutflutegg-idle (flutflutegg)
  ;; Hits are projected into the egg's forward/side frame. A hit from behind pushes the egg down
  ;; its fixed track; every accepted hit also rocks it away from the attacker.
  :event
    (behavior ((source process) (argc int) (message symbol) (block event-message-block))
      (when (and (= message 'attack)
                 (or (= (-> block param 1) 'punch) (= (-> block param 1) 'spin) (= (-> block param 1) 'spin-air))
                 (!= (-> self incomming-attack-id) (-> block param 2)))
        (set! (-> self incomming-attack-id) (-> block param 2))
        (flutflutegg-hit-sounds)
        (let ((hit-direction (vector-! (new-stack-vector0) (-> (the-as process-drawable source) root trans) (-> self root trans))))
          (set! (-> hit-direction y) 0.0)
          (vector-normalize! hit-direction 1.0)
          (let ((forward-dot (vector-dot hit-direction (-> self dir)))
                (side-dot (- (* (-> hit-direction x) (-> self dir z)) (* (-> hit-direction z) (-> self dir x)))))
            (if (< forward-dot -0.7)
              (apply-hit-impulse! self 24576.0 (* -8192.0 side-dot) (* -8192.0 forward-dot))
              (apply-hit-impulse! self 0.0 (* -8192.0 side-dot) (* -8192.0 forward-dot)))))
        (go flutflutegg-physics)))
  :trans
    (behavior ()
      (let* ((target-offset (ambient-control-method-10 (-> self ambient) (new 'stack-no-clear 'vector) (seconds 3) 368640.0 self))
             (random-mantissa (/ (the-as int (rand-uint31-gen *random-generator*)) 256))
             (random-bits (the-as number (logior #x3f800000 random-mantissa)))
             (random-choice (+ -1.0 (the-as float random-bits))))
        (cond
          ((not (task-closed? (game-task beach-flutflut) (task-status need-introduction))))
          ((not target-offset))
          ((< 327680.0 (vector-length target-offset)) (set! (-> self ambients-played) 0) 0)
          ((and (not (logtest? (-> self ambients-played) 1))
                (< (vector-length target-offset) 327680.0)
                (< -61440.0 (-> target-offset y)))
           (if (play-ambient (-> self ambient) "BIR-AM01" #f (the-as vector #f)) (logior! (-> self ambients-played) 1)))
          ((and (not (logtest? (-> self ambients-played) 2))
                (< (vector-length target-offset) 163840.0)
                (< -40960.0 (-> target-offset y)))
           (if (play-ambient (-> self ambient) "BIR-AM02" #f (the-as vector #f)) (logior! (-> self ambients-played) 2)))
          ((and (not (logtest? (-> self ambients-played) 16))
                (< (vector-length target-offset) 81920.0)
                (< -24576.0 (-> target-offset y)))
           (if (play-ambient (-> self ambient) "BIR-AM05" #f (the-as vector #f)) (logior! (-> self ambients-played) 16)))
          ((and (not (logtest? (-> self ambients-played) 4))
                (< (vector-length target-offset) 40960.0)
                (< -24576.0 (-> target-offset y)))
           (if (play-ambient (-> self ambient) "BIR-AM03" #f (the-as vector #f)) (logior! (-> self ambients-played) 4)))
          ((< (-> target-offset y) -24576.0))
          ((not (time-elapsed? (-> self ambient last-ambient-time) (seconds 30))))
          ((< 0.8 random-choice) (play-ambient (-> self ambient) "BIR-AM07" #f (-> self root trans)))
          ((< 0.6 random-choice) (play-ambient (-> self ambient) "BIR-AM08" #f (-> self root trans)))
          ((< 0.4 random-choice) (play-ambient (-> self ambient) "BIR-AM09" #f (-> self root trans)))
          ((< 0.2 random-choice) (play-ambient (-> self ambient) "BIR-AM12" #f (-> self root trans)))
          (else (play-ambient (-> self ambient) "BIR-AM13" #f (-> self root trans))))))
  :code
    (behavior ()
      (ja-post)
      (loop
        (suspend))))

(defstate flutflutegg-physics (flutflutegg)
  :event
    (behavior ((source process) (argc int) (message symbol) (block event-message-block))
      (when (and (time-elapsed? (-> self state-time) (seconds 0.5))
                 (= message 'attack)
                 (or (= (-> block param 1) 'punch) (= (-> block param 1) 'spin) (= (-> block param 1) 'spin-air))
                 (!= (-> self incomming-attack-id) (-> block param 2)))
        (set! (-> self incomming-attack-id) (-> block param 2))
        (flutflutegg-hit-sounds)
        (let ((hit-direction (vector-! (new-stack-vector0) (-> (the-as process-drawable source) root trans) (-> self root trans))))
          (set! (-> hit-direction y) 0.0)
          (vector-normalize! hit-direction 1.0)
          (let ((forward-dot (vector-dot hit-direction (-> self dir)))
                (side-dot (- (* (-> hit-direction x) (-> self dir z)) (* (-> hit-direction z) (-> self dir x)))))
            (if (< forward-dot -0.7)
              (apply-hit-impulse! self 24576.0 (* -8192.0 side-dot) (* -8192.0 forward-dot))
              (apply-hit-impulse! self 0.0 (* -8192.0 side-dot) (* -8192.0 forward-dot)))))))
  :code
    (behavior ()
      (set-time! (-> self state-time))
      (loop
        (+! (-> self pos) (* (-> self vel) (seconds-per-frame)))
        ;; og:preserve-this PAL patch here
        (set! (-> self vel) (* (-> self vel) (- 1.0 (* 0.05 (-> *display* time-adjust-ratio)))))
        (move! (-> self wobbler))
        (let ((next-position (new 'stack-no-clear 'vector)))
          (vector-float*! next-position (-> self dir) (-> self pos))
          (vector+! next-position next-position (-> self start))
          (move-to-point! (-> self root) next-position))
        (tilt-quaternion! (-> self wobbler) (-> self root quat))
        (let ((model-yaw (quaternion-axis-angle! (new 'stack-no-clear 'quaternion) 0.0 1.0 0.0 -18204.445)))
          (quaternion*! (-> self root quat) (-> self root quat) model-yaw))
        (suspend)
        (when (>= (-> self pos) (-> self fall-dist))
          (when (task-closed? (game-task beach-flutflut) (task-status need-introduction))
            (if (play-ambient (-> self ambient) "BIR-AM06" #f (the-as vector #f)) (logior! (-> self ambients-played) 32)))
          (go flutflutegg-physics-fall))))
  :post ja-post)

(defstate flutflutegg-physics-fall (flutflutegg)
  :code
    (behavior ()
      (local-vars (landed? symbol))
      (process-spawn camera-tracker
                     :init
                     camera-tracker-init
                     (lambda :behavior camera-tracker ()
                       (while (not (process-grab? *target*))
                         (suspend))
                       (camera-change-to "camera-135" 0 #f)
                       (camera-look-at (the-as pair (ppointer->process (-> self parent))) (the-as uint 9))
                       (suspend-for (seconds 4))
                       (while (not (process-release? (handle->process (-> self grab-target))))
                         (suspend))
                       (camera-look-at (the-as pair *target*) (the-as uint 0))
                       (send-event *camera* 'blend-from-as-fixed)
                       (camera-change-to (the-as string 'base) 75 #f)
                       (none))
                     :to
                     self)
      (close-specific-task! (game-task beach-flutflut) (task-status need-reminder))
      (loop
        (vector-float*! (-> self root transv) (-> self dir) (-> self vel))
        (set-time! (-> self state-time))
        (until landed?
          (vector-v++! (-> self root transv) (compute-acc-due-to-gravity (-> self root) (new-stack-vector0) 0.0))
          (integrate-for-enemy-with-move-to-ground! (-> self root)
                                                    (-> self root transv)
                                                    (collide-kind background)
                                                    8192.0
                                                    #f
                                                    #f
                                                    #f)
          (move! (-> self wobbler))
          (tilt-quaternion! (-> self wobbler) (-> self root quat))
          (let ((model-yaw (quaternion-axis-angle! (new 'stack-no-clear 'quaternion) 0.0 1.0 0.0 -18204.445)))
            (quaternion*! (-> self root quat) (-> self root quat) model-yaw))
          (suspend)
          (set! landed?
                (and (time-elapsed? (-> self state-time) (seconds 0.5)) (logtest? (-> self root status) (collide-status on-surface)))))
        (sound-play "sack-land" :vol 200)
        (go flutflutegg-break #f)))
  :post ja-post)

(defstate flutflutegg-break (flutflutegg)
  :code
    (behavior ((already-broken? symbol))
      (when already-broken?
        (set-vector! (-> self root trans) -231190.94 64559.105 -1164727.5 1.0)
        (quaternion-axis-angle! (-> self root quat) 0.0 1.0 0.0 -18204.445))
      (suspend)
      (update-transforms! (-> self root))
      (if (not already-broken?) (ja-play :group! flutflutegg-crack-ja :num! (seek!) :frame-num 0.0))
      (ja :group! flutflutegg-crack-ja :num! max)
      (while (and (not (task-closed? (game-task beach-flutflut) (task-status need-reward-speech)))
                  (not (logtest? (-> self ambients-played) 1024)))
        (if (play-ambient (-> self ambient) "BIR-AM11" #f (the-as vector #f)) (logior! (-> self ambients-played) 1024))
        (suspend))
      (let ((hint-start-time (current-time)))
        (while (not (task-closed? (game-task beach-flutflut) (task-status need-reward-speech)))
          (if (time-elapsed? hint-start-time (seconds 10))
            (level-hint-spawn (text-id beach-flutflutegg-hint) "sksp0029" (the-as entity #f) *entity-pool* (game-task none)))
          (suspend)))
      (ja-channel-set! 0)
      (while (not (task-closed? (game-task beach-flutflut) (task-status need-resolution)))
        (suspend))
      (ja-channel-set! 1)
      (set-vector! (-> self root trans) -231190.94 64559.105 -1164727.5 1.0)
      (quaternion-axis-angle! (-> self root quat) 0.0 1.0 0.0 0.0)
      (ja :group! flutflutegg-broke-ja :num! max)
      (loop
        (logior! (-> self mask) (process-mask sleep))
        (suspend)))
  :post ja-post)

(defmethod init-from-entity! ((this flutflutegg) (source-entity entity-actor))
  "Create the egg's moving collision and skeleton, capture its starting position and forward
   direction, initialize its travel and wobble state, and resume either the intact or already
   broken task state."
  (let ((root-shape (new 'process 'collide-shape-moving this (collide-list-enum hit-by-player))))
    (set! (-> root-shape dynam) (copy *standard-dynamics* 'process))
    (set! (-> root-shape reaction) default-collision-reaction)
    (set! (-> root-shape no-reaction)
          (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (let ((egg-group (new 'process 'collide-shape-prim-group root-shape (the-as uint 2) 0)))
      (set! (-> egg-group prim-core collide-as) (collide-kind enemy))
      (set! (-> egg-group collide-with) (collide-kind target))
      (set! (-> egg-group prim-core action) (collide-action solid))
      (set! (-> egg-group prim-core offense) (collide-offense indestructible))
      (set-vector! (-> egg-group local-sphere) 0.0 12288.0 0.0 12288.0)
      (set-root-prim! root-shape egg-group)
      (let ((lower-sphere (new 'process 'collide-shape-prim-sphere root-shape (the-as uint 0))))
        (set! (-> lower-sphere prim-core collide-as) (collide-kind enemy))
        (set! (-> lower-sphere collide-with) (collide-kind target))
        (set! (-> lower-sphere prim-core action) (collide-action solid))
        (set! (-> lower-sphere prim-core offense) (collide-offense indestructible))
        (set-vector! (-> lower-sphere local-sphere) 0.0 8192.0 0.0 8192.0)
        (append-prim egg-group lower-sphere))
      (let ((upper-sphere (new 'process 'collide-shape-prim-sphere root-shape (the-as uint 0))))
        (set! (-> upper-sphere prim-core collide-as) (collide-kind enemy))
        (set! (-> upper-sphere collide-with) (collide-kind target))
        (set! (-> upper-sphere prim-core action) (collide-action solid))
        (set! (-> upper-sphere prim-core offense) (collide-offense indestructible))
        (set-vector! (-> upper-sphere local-sphere) 0.0 16384.0 0.0 7782.4)
        (append-prim egg-group upper-sphere)))
    (set! (-> root-shape nav-radius) (* 0.75 (-> root-shape root-prim local-sphere w)))
    (backup-collide-with-as root-shape)
    (set! (-> this root) root-shape))
  (process-drawable-from-entity! this source-entity)
  (initialize-skeleton this *flutflutegg-sg* '())
  (vector-z-quaternion! (-> this dir) (-> this root quat))
  (vector-copy! (-> this start) (-> this root trans))
  (set! (-> this fall-dist) 20480.0)
  (set-yaw-angle-clear-roll-pitch! (-> this root) (+ -16384.0 (y-angle (-> this root))))
  (set! (-> this pos) 0.0)
  (set! (-> this vel) 0.0)
  (set! (-> this wobbler) (new 'process 'wobbler))
  (reset! (-> this wobbler) 0.1 0.98 4096.0)
  (set! (-> this last-impulse-time) 0)
  (set! (-> this ambients-played) 0)
  (if (task-closed? (game-task beach-flutflut) (task-status need-reminder)) (go flutflutegg-break #t) (go flutflutegg-idle))
  (none))

(deftype harvester (process-drawable)
  ((root      collide-shape :override)
   (alt-actor entity-actor))
  (:states
   harvester-idle
   (harvester-inflate symbol)))

(defskelgroup *harvester-sg*
  harvester
  harvester-lod0-jg
  harvester-idle-ja
  ((harvester-lod0-mg (meters 20)) (harvester-lod1-mg (meters 40)) (harvester-lod2-mg (meters 999999)))
  :bounds (static-spherem 0 7 0 11))

(defstate harvester-idle (harvester)
  ;; The vent rock is the harvester's alternate actor. Its persistent completion flag controls
  ;; whether the plant starts deflated or inflates in response to the rock breaking.
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('update)
         (if (and (-> self alt-actor) (logtest? (-> self alt-actor extra perm status) (entity-perm-status complete)))
           (go harvester-inflate #f)))))
  :code
    (behavior ()
      (if (and (-> self alt-actor) (logtest? (-> self alt-actor extra perm status) (entity-perm-status complete)))
        (go harvester-inflate #t))
      (ja :group! harvester-inflate-ja :num! (identity (ja-aframe 1.0 0)))
      (ja-post)
      (loop
        (logior! (-> self mask) (process-mask sleep))
        (suspend))))

(defstate harvester-inflate (harvester)
  :code
    (behavior ((already-inflated? symbol))
      (if (not already-inflated?) (ja-play :group! harvester-inflate-ja :num! (seek!) :frame-num 0.0))
      (loop
        (ja-play :group! harvester-idle-ja :num! (seek!) :frame-num 0.0)))
  :post ja-post)

(defmethod init-from-entity! ((this harvester) (source-entity entity-actor))
  "Create the harvester's five collision meshes and skeleton, resolve its linked vent rock, and
   enter the deflated idle state."
  (logior! (-> this mask) (process-mask ambient))
  (let ((root-shape (new 'process 'collide-shape this (collide-list-enum hit-by-player))))
    (let ((harvester-group (new 'process 'collide-shape-prim-group root-shape (the-as uint 5) 0)))
      (set! (-> harvester-group prim-core collide-as) (collide-kind background))
      (set! (-> harvester-group collide-with) (collide-kind target))
      (set! (-> harvester-group prim-core action) (collide-action solid))
      (set! (-> harvester-group transform-index) 0)
      (set-vector! (-> harvester-group local-sphere) 0.0 20480.0 0.0 40960.0)
      (set-root-prim! root-shape harvester-group)
      (let ((center-mesh (new 'process 'collide-shape-prim-mesh root-shape (the-as uint 0) (the-as uint 0))))
        (set! (-> center-mesh prim-core collide-as) (collide-kind ground-object))
        (set! (-> center-mesh collide-with) (collide-kind target))
        (set! (-> center-mesh prim-core action) (collide-action solid))
        (set! (-> center-mesh prim-core offense) (collide-offense indestructible))
        (set! (-> center-mesh transform-index) 4)
        (set-vector! (-> center-mesh local-sphere) 0.0 6144.0 0.0 24576.0)
        (append-prim harvester-group center-mesh))
      (let ((front-right-mesh (new 'process 'collide-shape-prim-mesh root-shape (the-as uint 1) (the-as uint 0))))
        (set! (-> front-right-mesh prim-core collide-as) (collide-kind ground-object))
        (set! (-> front-right-mesh collide-with) (collide-kind target))
        (set! (-> front-right-mesh prim-core action) (collide-action solid))
        (set! (-> front-right-mesh prim-core offense) (collide-offense indestructible))
        (set! (-> front-right-mesh transform-index) 4)
        (set-vector! (-> front-right-mesh local-sphere) 16384.0 -20480.0 16384.0 20480.0)
        (append-prim harvester-group front-right-mesh))
      (let ((rear-right-mesh (new 'process 'collide-shape-prim-mesh root-shape (the-as uint 2) (the-as uint 0))))
        (set! (-> rear-right-mesh prim-core collide-as) (collide-kind ground-object))
        (set! (-> rear-right-mesh collide-with) (collide-kind target))
        (set! (-> rear-right-mesh prim-core action) (collide-action solid))
        (set! (-> rear-right-mesh prim-core offense) (collide-offense indestructible))
        (set! (-> rear-right-mesh transform-index) 4)
        (set-vector! (-> rear-right-mesh local-sphere) 16384.0 -20480.0 -16384.0 20480.0)
        (append-prim harvester-group rear-right-mesh))
      (let ((rear-left-mesh (new 'process 'collide-shape-prim-mesh root-shape (the-as uint 3) (the-as uint 0))))
        (set! (-> rear-left-mesh prim-core collide-as) (collide-kind ground-object))
        (set! (-> rear-left-mesh collide-with) (collide-kind target))
        (set! (-> rear-left-mesh prim-core action) (collide-action solid))
        (set! (-> rear-left-mesh prim-core offense) (collide-offense indestructible))
        (set! (-> rear-left-mesh transform-index) 4)
        (set-vector! (-> rear-left-mesh local-sphere) -16384.0 -20480.0 -16384.0 20480.0)
        (append-prim harvester-group rear-left-mesh))
      (let ((front-left-mesh (new 'process 'collide-shape-prim-mesh root-shape (the-as uint 4) (the-as uint 0))))
        (set! (-> front-left-mesh prim-core collide-as) (collide-kind ground-object))
        (set! (-> front-left-mesh collide-with) (collide-kind target))
        (set! (-> front-left-mesh prim-core action) (collide-action solid))
        (set! (-> front-left-mesh prim-core offense) (collide-offense indestructible))
        (set! (-> front-left-mesh transform-index) 4)
        (set-vector! (-> front-left-mesh local-sphere) -16384.0 -20480.0 16384.0 20480.0)
        (append-prim harvester-group front-left-mesh)))
    (set! (-> root-shape nav-radius) (* 0.75 (-> root-shape root-prim local-sphere w)))
    (backup-collide-with-as root-shape)
    (set! (-> this root) root-shape))
  (process-drawable-from-entity! this source-entity)
  (initialize-skeleton this *harvester-sg* '())
  (set! (-> this alt-actor) (entity-actor-lookup (-> this entity) 'alt-actor 0))
  (go harvester-idle)
  (none))

(deftype beachcam (process-hidden) ())

(defun beachcam-spawn ()
  "Start the beach cannon camera on the placed alternate actor, attach a cloned power cell to the
   camera for its lifetime, then stop the clone when the camera finishes."
  (with-pp
    (let ((camera-actor (entity-actor-lookup (-> pp entity) 'alt-actor 0)))
      (when camera-actor
        (let* ((camera-handle (ppointer->handle (process-spawn pov-camera
                                                               (-> camera-actor extra trans)
                                                               *beachcam-sg*
                                                               (new 'static 'spool-anim :name "beachcam-cannon" :index 3 :parts 1 :command-list '())
                                                               0
                                                               #f
                                                               '()
                                                               :to
                                                               pp)))
               (fuel-cell-handle (ppointer->handle (process-spawn fuel-cell :init fuel-cell-init-as-clone camera-handle (-> pp entity extra perm task) :to pp))))
          (let ((camera (handle->process camera-handle)))
            (if camera (set! (-> (the-as pov-camera camera) notify-handle) (the-as handle fuel-cell-handle))))
          (while (handle->process camera-handle)
            (suspend))
          (send-event (handle->process fuel-cell-handle) 'stop-cloning))))
    0
    (none)))

;;-*-Lisp-*-
(in-package goal)
(bundles "BEA.DGO")
(require "engine/common-obs/process-taskable.gc")
(require "engine/camera/pov-camera-h.gc")
(require "levels/beach/wobbler.gc")
(define-extern spawn-flying-rock (function vector vector float entity none))

;; DECOMP BEGINS

(defskelgroup *beachcam-sg*
  beachcam
  beachcam-lod0-jg
  beachcam-anim-ja
  ((beachcam-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 60))

(deftype windmill-one (process-drawable)
  ((root     collide-shape-moving :override)
   (sound-id sound-id))
  (:states
   windmill-one-idle))

(defskelgroup *windmill-one-sg*
  windmill-one
  windmill-one-lod0-jg
  windmill-one-idle-ja
  ((windmill-one-lod0-mg (meters 20)) (windmill-one-lod1-mg (meters 40)) (windmill-one-lod2-mg (meters 999999)))
  :bounds (static-spherem -12 -8 -1 16)
  :longest-edge (meters 7.5))

(defstate windmill-one-idle (windmill-one)
  :exit
    (behavior ()
      (sound-stop (-> self sound-id)))
  :trans
    (behavior ()
      (rider-trans)
      (let ((sound-position (vector<-cspace! (new 'stack-no-clear 'vector) (joint-node windmill-one-lod0-jg big))))
        (if (!= (+ (-> sound-position x) (-> sound-position y) (-> sound-position z)) 0.0)
          (sound-play "gears-rumble" :id (-> self sound-id) :position (the-as symbol sound-position)))))
  :code
    (behavior ()
      (loop
        (ja-play :group! windmill-one-idle-ja :num! (seek! max 0.5) :frame-num 0.0)))
  :post rider-post)

(defmethod init-from-entity! ((this windmill-one) (source-entity entity-actor))
  "Create the windmill's sticky moving platform and two blade collision meshes, initialize its
   skeleton, allocate the looping gear sound ID, and enter idle."
  (logior! (-> this mask) (process-mask platform))
  (let ((root-shape (new 'process 'collide-shape-moving this (collide-list-enum hit-by-player))))
    (set! (-> root-shape dynam) (copy *standard-dynamics* 'process))
    (set! (-> root-shape reaction) default-collision-reaction)
    (set! (-> root-shape no-reaction)
          (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (alloc-riders root-shape 1)
    (let ((platform-group (new 'process 'collide-shape-prim-group root-shape (the-as uint 2) 0)))
      (set! (-> platform-group prim-core collide-as) (collide-kind ground-object))
      (set! (-> platform-group collide-with) (collide-kind target))
      (set! (-> platform-group prim-core action) (collide-action solid rider-plat-sticky))
      (set! (-> platform-group transform-index) 0)
      (set-vector! (-> platform-group local-sphere) -40960.0 -40960.0 32768.0 69632.0)
      (set-root-prim! root-shape platform-group)
      (let ((first-blade (new 'process 'collide-shape-prim-mesh root-shape (the-as uint 0) (the-as uint 0))))
        (set! (-> first-blade prim-core collide-as) (collide-kind ground-object))
        (set! (-> first-blade collide-with) (collide-kind target))
        (set! (-> first-blade prim-core action) (collide-action solid rider-plat-sticky))
        (set! (-> first-blade prim-core offense) (collide-offense indestructible))
        (set! (-> first-blade transform-index) 8)
        (set-vector! (-> first-blade local-sphere) 4915.2 0.0 -4915.2 13516.8)
        (append-prim platform-group first-blade))
      (let ((second-blade (new 'process 'collide-shape-prim-mesh root-shape (the-as uint 0) (the-as uint 0))))
        (set! (-> second-blade prim-core collide-as) (collide-kind ground-object))
        (set! (-> second-blade collide-with) (collide-kind target))
        (set! (-> second-blade prim-core action) (collide-action solid rider-plat-sticky))
        (set! (-> second-blade prim-core offense) (collide-offense indestructible))
        (set! (-> second-blade transform-index) 9)
        (set-vector! (-> second-blade local-sphere) 4915.2 0.0 -4915.2 13516.8)
        (append-prim platform-group second-blade)))
    (set! (-> root-shape nav-radius) (* 0.75 (-> root-shape root-prim local-sphere w)))
    (backup-collide-with-as root-shape)
    (set! (-> this root) root-shape))
  (set! (-> this root pause-adjust-distance) 409600.0)
  (process-drawable-from-entity! this source-entity)
  (initialize-skeleton this *windmill-one-sg* '())
  (logior! (-> this skel status) (janim-status inited))
  (update-transforms! (-> this root))
  (set! (-> this sound-id) (new-sound-id))
  (go windmill-one-idle)
  (none))


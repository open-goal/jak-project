(deftype grottopole (process-drawable)
  ((root                collide-shape :override)
   (speed               meters)
   (distance            meters)
   (position            int32)
   (max-position        int32)
   (incomming-attack-id uint64))
  (:states
   grottopole-idle
   grottopole-moving-down
   grottopole-moving-up))

(defskelgroup *grottopole-sg*
  grottopole
  grottopole-lod0-jg
  grottopole-idle-ja
  ((grottopole-lod0-mg (meters 20)) (grottopole-lod1-mg (meters 999999)))
  :bounds (static-spherem 0 -8 0 9))

(defstate grottopole-idle (grottopole)
  ;; Primitive 2 is the lower strike volume and primitive 1 is the upper strike volume. A new
  ;; uppercut from below raises the pole; a new flop from above lowers it.
  :event
    (behavior ((source process) (argc int) (message symbol) (block event-message-block))
      (when (= (-> source type) target)
        (case message
          (('attack)
           (let ((attack-id (-> block param 2)))
             (when (!= attack-id (-> self incomming-attack-id))
               (set! (-> self incomming-attack-id) attack-id)
               (case (-> block param 1)
                 (('uppercut)
                  (when (and (< (-> *target* control trans y) (+ -40960.0 (-> self root trans y)))
                             (< (-> self position) (-> self max-position))
                             ((method-of-type touching-shapes-entry prims-touching?)
                              (the-as touching-shapes-entry (-> block param 0))
                              (the-as collide-shape-moving (-> self root))
                              (the-as uint 2)))
                    (sound-play "grotto-pole-hit")
                    (sound-play "dirt-crumble")
                    (increment-success-for-hint (text-id beach-grottopole-increment))
                    (go grottopole-moving-up)))
                 (('flop)
                  (when (and (< (+ -40960.0 (-> self root trans y)) (-> *target* control trans y))
                             (> (-> self position) 0)
                             ((method-of-type touching-shapes-entry prims-touching?)
                              (the-as touching-shapes-entry (-> block param 0))
                              (the-as collide-shape-moving (-> self root))
                              (the-as uint 1)))
                    (sound-play "grotto-pole-hit")
                    (sound-play "dirt-crumble")
                    (go grottopole-moving-down))))))))))
  :code
    (behavior ()
      (set-time! (-> self state-time))
      (ja :group! grottopole-idle-ja :num! min)
      (transform-post)
      (suspend)
      (loop
        (logior! (-> self mask) (process-mask sleep))
        (suspend))))

(defun move-grottopole ((pole grottopole) (direction float))
  "Move the pole one configured step in direction, clamping the final frame to the exact distance
   and shedding rock particles throughout the motion."
  (let ((distance-moved 0.0)
        (frame-offset (new-stack-vector0))
        (particle-position (new-stack-vector0))
        (finished? #f))
    (set! (-> pole part local-clock) 0)
    (set-vector! frame-offset 0.0 0.0 0.0 1.0)
    (while (and (not finished?) (< distance-moved (-> pole distance)))
      (let ((frame-distance (* (-> pole speed) (seconds-per-frame))))
        (when (< (-> pole distance) (+ distance-moved frame-distance))
          (set! frame-distance (- (-> pole distance) distance-moved))
          (set! finished? #t))
        (set! (-> frame-offset y) (* frame-distance direction))
        (move-by-vector! (-> pole root) frame-offset)
        (+! distance-moved frame-distance))
      (set! (-> particle-position quad) (-> pole entity extra trans quad))
      (+! (-> particle-position y) -4096.0)
      (spawn (-> pole part) particle-position)
      (suspend)
      0))
  0
  (none))

(defun move-grottopole-to-position ((pole grottopole))
  "Move the pole from its placed origin to its saved discrete position."
  (let ((position-offset (new 'stack-no-clear 'vector)))
    (set-vector! position-offset 0.0 (* (-> pole distance) (the float (-> pole position))) 0.0 1.0)
    (move-by-vector! (-> pole root) position-offset))
  0
  (none))

(defstate grottopole-moving-up (grottopole)
  :code
    (behavior ()
      (+! (-> self position) 1)
      (let ((persistent-data (-> self entity extra perm)))
        (logior! (-> persistent-data status) (entity-perm-status user-set-from-cstage))
        (set! (-> persistent-data user-int16 0) (-> self position)))
      (move-grottopole self 1.0)
      (go grottopole-idle))
  :post transform-post)

(defstate grottopole-moving-down (grottopole)
  :code
    (behavior ()
      (+! (-> self position) -1)
      (let ((persistent-data (-> self entity extra perm)))
        (logior! (-> persistent-data status) (entity-perm-status user-set-from-cstage))
        (set! (-> persistent-data user-int16 0) (-> self position)))
      (move-grottopole self -1.0)
      (go grottopole-idle))
  :post transform-post)

(defmethod init-from-entity! ((this grottopole) (source-entity entity-actor))
  "Create the pole's three collision meshes, load its movement speed, step distance, and number
   of positions, restore the saved position from the entity's persistent data, and enter idle."
  (let ((root-shape (new 'process 'collide-shape this (collide-list-enum hit-by-others))))
    (let ((pole-group (new 'process 'collide-shape-prim-group root-shape (the-as uint 3) 0)))
      (set! (-> pole-group prim-core collide-as) (collide-kind wall-object))
      (set! (-> pole-group collide-with) (collide-kind target))
      (set! (-> pole-group prim-core action) (collide-action solid))
      (set-vector! (-> pole-group local-sphere) 0.0 -20480.0 0.0 40960.0)
      (set-root-prim! root-shape pole-group)
      (let ((first-mesh (new 'process 'collide-shape-prim-mesh root-shape (the-as uint 0) (the-as uint 1))))
        (set! (-> first-mesh prim-core collide-as) (collide-kind wall-object))
        (set! (-> first-mesh collide-with) (collide-kind target))
        (set! (-> first-mesh prim-core action) (collide-action solid))
        (set! (-> first-mesh prim-core offense) (collide-offense indestructible))
        (set! (-> first-mesh transform-index) 3)
        (set-vector! (-> first-mesh local-sphere) 0.0 -20480.0 0.0 40960.0)
        (append-prim pole-group first-mesh))
      (let ((second-mesh (new 'process 'collide-shape-prim-mesh root-shape (the-as uint 1) (the-as uint 0))))
        (set! (-> second-mesh prim-core collide-as) (collide-kind wall-object))
        (set! (-> second-mesh collide-with) (collide-kind target))
        (set! (-> second-mesh prim-core action) (collide-action solid))
        (set! (-> second-mesh prim-core offense) (collide-offense indestructible))
        (set! (-> second-mesh transform-index) 3)
        (set-vector! (-> second-mesh local-sphere) 0.0 -20480.0 0.0 40960.0)
        (append-prim pole-group second-mesh))
      (let ((third-mesh (new 'process 'collide-shape-prim-mesh root-shape (the-as uint 2) (the-as uint 2))))
        (set! (-> third-mesh prim-core collide-as) (collide-kind wall-object))
        (set! (-> third-mesh collide-with) (collide-kind target))
        (set! (-> third-mesh prim-core action) (collide-action solid))
        (set! (-> third-mesh prim-core offense) (collide-offense indestructible))
        (set! (-> third-mesh transform-index) 3)
        (set-vector! (-> third-mesh local-sphere) 0.0 -20480.0 0.0 40960.0)
        (append-prim pole-group third-mesh)))
    (set! (-> root-shape nav-radius) (* 0.75 (-> root-shape root-prim local-sphere w)))
    (backup-collide-with-as root-shape)
    (set! (-> this root) root-shape))
  (process-drawable-from-entity! this source-entity)
  (initialize-skeleton this *grottopole-sg* '())
  (set! (-> this speed) (res-lump-float source-entity 'speed :default 81920.0))
  (set! (-> this distance) (res-lump-float source-entity 'distance :default 3072.0))
  (set! (-> this position) 0)
  (set! (-> this max-position) (res-lump-value source-entity 'num-positions int :default (the-as uint128 3)))
  (set! (-> this part) (create-launch-control group-beach-grotto-pole-rocks this))
  (set! (-> this position) (-> this entity extra perm user-int16 0))
  (move-grottopole-to-position this)
  (go grottopole-idle)
  (none))


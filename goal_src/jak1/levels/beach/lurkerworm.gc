(defmethod aim-at-target! ((this lurkerworm))
  "Turn the body twister toward the target and seek the head pitch toward it, clamped between
   -30 and 45 degrees."
  (let ((to-target (new 'stack-no-clear 'vector)))
    (vector-! to-target (target-pos 0) (-> this root trans))
    (set-target! (-> this twister) (atan (-> to-target x) (-> to-target z)))
    (update-twist! (-> this twister))
    (let* ((horizontal-distance (sqrtf (+ (* (-> to-target x) (-> to-target x)) (* (-> to-target z) (-> to-target z)))))
           (target-pitch (atan (-> to-target y) horizontal-distance)))
      (seek! (-> this head-tilt) target-pitch (* 5461.3335 (seconds-per-frame)))))
  (set! (-> this head-tilt) (fmin 8192.0 (fmax -5461.3335 (-> this head-tilt))))
  0
  (none))

(defbehavior lurkerworm-prebind-function lurkerworm ((joint-transforms pointer) (joint-count int) (owner lurkerworm))
  "Apply the current head pitch to the head joint quaternion before binding the skeleton."
  (let ((head-rotation (new 'stack-no-clear 'quaternion))
        (head-transform (&+ joint-transforms 432)))
    (quaternion-axis-angle! head-rotation -1.0 0.0 0.0 (-> owner head-tilt))
    (quaternion*! (the-as quaternion head-transform) (the-as quaternion head-transform) head-rotation))
  0
  (none))

(defun lurkerworm-joint-callback ((owner lurkerworm))
  "Apply the body twister to the bound skeleton joints."
  (apply-twist-to-bones! (-> owner twister) owner)
  0
  (none))

(defmethod particle-effect ((this lurkerworm))
  "Launch sand puffs at body joints 5 through 8."
  (let ((joint-5-pos (vector<-cspace! (new 'stack-no-clear 'vector) (-> this node-list data 5))))
    (launch-particles (-> *part-id-table* 661) joint-5-pos))
  (let ((joint-6-pos (vector<-cspace! (new 'stack-no-clear 'vector) (-> this node-list data 6))))
    (launch-particles (-> *part-id-table* 661) joint-6-pos))
  (let ((joint-7-pos (vector<-cspace! (new 'stack-no-clear 'vector) (-> this node-list data 7))))
    (launch-particles (-> *part-id-table* 661) joint-7-pos))
  (let ((joint-8-pos (vector<-cspace! (new 'stack-no-clear 'vector) (-> this node-list data 8))))
    (launch-particles (-> *part-id-table* 661) joint-8-pos))
  0
  (none))

(defbehavior lurkerworm-default-event-handler lurkerworm ((sender process) (argc int) (message symbol) (block event-message-block))
  "Die on attack. On a qualifying touch, send an attack back to the touching process."
  (case message
    (('attack) (-> block param 1) (go lurkerworm-die))
    (('touch)
     (if ((method-of-type touching-shapes-entry prims-touching?)
          (the-as touching-shapes-entry (-> block param 0))
          (-> self root)
          (the-as uint 1))
       (send-event sender 'attack (-> block param 0) (new 'static 'attack-info))))))

(defbehavior lurkerworm-default-post-behavior lurkerworm ()
  "Aim the worm at the target and run the standard transform post step."
  (aim-at-target! self)
  (transform-post)
  0
  (none))

lurkerworm-default-event-handler

lurkerworm-default-post-behavior

;; A worm remains hidden until the target comes within twenty metres, spots the target, and rises.
;; It then makes exactly three strikes. During each idle animation before a pending strike, proximity
;; increases the per-frame chance of attacking early; reaching the end of the random 10--109 frame
;; wait forces the strike. After the third strike, the next idle wait ends by sinking underground.
(defstate lurkerworm-idle (lurkerworm)
  :event lurkerworm-default-event-handler
  :enter
    (behavior ()
      (ja-channel-set! 0)
      (set-time! (-> self state-time)))
  :code
    (behavior ()
      (loop
        (if (and (time-elapsed? (-> self state-time) (seconds 1))
                 *target*
                 (>= 81920.0 (vector-vector-distance (-> self root trans) (-> *target* control trans))))
          (go lurkerworm-spot))
        (suspend)))
  :post lurkerworm-default-post-behavior)

(defstate lurkerworm-spot (lurkerworm)
  :event lurkerworm-default-event-handler
  :enter
    (behavior ()
      (set-time! (-> self state-time))
      (sound-play "worm-rise1"))
  :code
    (behavior ()
      (set! (-> self part local-clock) 0)
      (loop
        (spawn (-> self part) (-> self root trans))
        (particle-effect self)
        (when (time-elapsed? (-> self state-time) (seconds 1))
          (if (and *target* (>= 81920.0 (vector-vector-distance (-> self root trans) (-> *target* control trans))))
            (go lurkerworm-rise)
            (go lurkerworm-idle)))
        (suspend)))
  :post lurkerworm-default-post-behavior)

(defstate lurkerworm-rise (lurkerworm)
  :event lurkerworm-default-event-handler
  :enter
    (behavior ()
      (set-time! (-> self state-time)))
  :code
    (behavior ()
      (ja-channel-set! 1)
      (ja-play :group!
               lurkerworm-rise-ja
               :num! (seek!)
               :frame-num 0.0
               (spawn (-> self part) (-> self root trans))
               (particle-effect self))
      (set! (-> self strike-count) 3)
      (go lurkerworm-rest))
  :post lurkerworm-default-post-behavior)

(defstate lurkerworm-rest (lurkerworm)
  :event lurkerworm-default-event-handler
  :enter
    (behavior ()
      (set-time! (-> self state-time))
      (set! (-> self vulnerable) #t))
  :exit
    (behavior ()
      (set! (-> self vulnerable) #f))
  :code
    (behavior ()
      (let* ((min-wait 10.0)
             (random-wait-range 100.0)
             (random-mantissa (/ (the-as int (rand-uint31-gen *random-generator*)) 256))
             (random-bits (the-as number (logior #x3f800000 random-mantissa)))
             (frames-left (the int (+ min-wait (* random-wait-range (+ -1.0 (the-as float random-bits))))))
             (strikes-remaining? (nonzero? (-> self strike-count))))
        (if strikes-remaining? (+! (-> self strike-count) -1))
        (ja-play :group!
                 lurkerworm-idle-ja
                 :num! (seek!)
                 :frame-num 0.0
                 (ja-blend-eval)
                 (particle-effect self)
                 (when strikes-remaining?
                   (let* ((distance-factor (- 1.0
                                              (* 0.00009765625
                                                 (+ -16384.0 (if *target* (vector-vector-distance (-> self root trans) (-> *target* control trans)) 4096000.0)))))
                          (strike-chance (/ distance-factor 5)))
                     (if (< (rand-float-gen) strike-chance) (go lurkerworm-strike))))
                 (+! frames-left -1)
                 (when (zero? frames-left)
                   (if strikes-remaining? (go lurkerworm-strike) (go lurkerworm-sink))))
        (if strikes-remaining? (go lurkerworm-strike) (go lurkerworm-sink))))
  :post lurkerworm-default-post-behavior)

(defstate lurkerworm-strike (lurkerworm)
  :event lurkerworm-default-event-handler
  :code
    (behavior ()
      (ja-no-eval :num! (loop!))
      (ja-channel-push! 1 (seconds 0.135))
      (ja-play :group!
               lurkerworm-chomp-ja
               :num!
               (seek! (ja-aframe 13.0 0))
               :frame-num 0.0
               (ja-blend-eval)
               (particle-effect self))
      (ja-no-eval :num! (seek!))
      (ja-channel-push! 1 (seconds 0.135))
      (go lurkerworm-rest))
  :post lurkerworm-default-post-behavior)

(defstate lurkerworm-sink (lurkerworm)
  :event lurkerworm-default-event-handler
  :enter
    (behavior ()
      (set-time! (-> self state-time)))
  :code
    (behavior ()
      (ja-play :group!
               lurkerworm-sink-ja
               :num! (seek!)
               :frame-num 0.0
               (spawn (-> self part2) (-> self root trans))
               (particle-effect self))
      (go lurkerworm-idle))
  :post lurkerworm-default-post-behavior)

(defstate lurkerworm-die (lurkerworm)
  :event process-drawable-death-event-handler
  :code
    (behavior ()
      (logclear! (-> self mask) (process-mask actor-pause))
      (let ((root-primitive (-> self root root-prim)))
        (set! (-> root-primitive collide-with) (collide-kind))
        (set! (-> root-primitive prim-core collide-as) (collide-kind)))
      0
      (ja-play :group! lurkerworm-die-ja :num! (seek!) :frame-num 0.0)
      (cleanup-for-death self))
  :post lurkerworm-default-post-behavior)

(defmethod init-from-entity! ((this lurkerworm) (source-entity entity-actor))
  "Initialize the Lurker Worm's body and attack collision spheres, skeleton, sand effects,
   three-strike body twister, callbacks, navigation radius, and hidden idle state."
  (logior! (-> this mask) (process-mask enemy))
  (let ((root-shape (new 'process 'collide-shape-moving this (collide-list-enum usually-hit-by-player))))
    (set! (-> root-shape dynam) (copy *standard-dynamics* 'process))
    (set! (-> root-shape reaction) default-collision-reaction)
    (set! (-> root-shape no-reaction)
          (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (let ((primitive-group (new 'process 'collide-shape-prim-group root-shape (the-as uint 6) 0)))
      (set! (-> primitive-group prim-core collide-as) (collide-kind enemy))
      (set! (-> primitive-group collide-with) (collide-kind target))
      (set! (-> primitive-group prim-core action) (collide-action solid))
      (set-vector! (-> primitive-group local-sphere) 0.0 10240.0 0.0 24576.0)
      (set-root-prim! root-shape primitive-group)
      (let ((joint-3-sphere (new 'process 'collide-shape-prim-sphere root-shape (the-as uint 0))))
        (set! (-> joint-3-sphere prim-core collide-as) (collide-kind enemy))
        (set! (-> joint-3-sphere collide-with) (collide-kind target))
        (set! (-> joint-3-sphere prim-core action) (collide-action solid))
        (set! (-> joint-3-sphere prim-core offense) (collide-offense indestructible))
        (set! (-> joint-3-sphere transform-index) 3)
        (set-vector! (-> joint-3-sphere local-sphere) 0.0 0.0 0.0 4096.0)
        (append-prim primitive-group joint-3-sphere))
      (let ((joint-5-sphere (new 'process 'collide-shape-prim-sphere root-shape (the-as uint 0))))
        (set! (-> joint-5-sphere prim-core collide-as) (collide-kind enemy))
        (set! (-> joint-5-sphere collide-with) (collide-kind target))
        (set! (-> joint-5-sphere prim-core action) (collide-action solid))
        (set! (-> joint-5-sphere prim-core offense) (collide-offense indestructible))
        (set! (-> joint-5-sphere transform-index) 5)
        (set-vector! (-> joint-5-sphere local-sphere) 0.0 0.0 0.0 4096.0)
        (append-prim primitive-group joint-5-sphere))
      (let ((joint-6-sphere (new 'process 'collide-shape-prim-sphere root-shape (the-as uint 0))))
        (set! (-> joint-6-sphere prim-core collide-as) (collide-kind enemy))
        (set! (-> joint-6-sphere collide-with) (collide-kind target))
        (set! (-> joint-6-sphere prim-core action) (collide-action solid))
        (set! (-> joint-6-sphere prim-core offense) (collide-offense indestructible))
        (set! (-> joint-6-sphere transform-index) 6)
        (set-vector! (-> joint-6-sphere local-sphere) 0.0 0.0 0.0 4096.0)
        (append-prim primitive-group joint-6-sphere))
      (let ((joint-7-sphere (new 'process 'collide-shape-prim-sphere root-shape (the-as uint 0))))
        (set! (-> joint-7-sphere prim-core collide-as) (collide-kind enemy))
        (set! (-> joint-7-sphere collide-with) (collide-kind target))
        (set! (-> joint-7-sphere prim-core action) (collide-action solid))
        (set! (-> joint-7-sphere prim-core offense) (collide-offense indestructible))
        (set! (-> joint-7-sphere transform-index) 7)
        (set-vector! (-> joint-7-sphere local-sphere) 0.0 0.0 0.0 4096.0)
        (append-prim primitive-group joint-7-sphere))
      (let ((joint-8-sphere (new 'process 'collide-shape-prim-sphere root-shape (the-as uint 0))))
        (set! (-> joint-8-sphere prim-core collide-as) (collide-kind enemy))
        (set! (-> joint-8-sphere collide-with) (collide-kind target))
        (set! (-> joint-8-sphere prim-core action) (collide-action solid))
        (set! (-> joint-8-sphere prim-core offense) (collide-offense indestructible))
        (set! (-> joint-8-sphere transform-index) 8)
        (set-vector! (-> joint-8-sphere local-sphere) 0.0 0.0 0.0 4096.0)
        (append-prim primitive-group joint-8-sphere))
      (let ((bite-sphere (new 'process 'collide-shape-prim-sphere root-shape (the-as uint 1))))
        (set! (-> bite-sphere prim-core collide-as) (collide-kind enemy))
        (set! (-> bite-sphere collide-with) (collide-kind target))
        (set! (-> bite-sphere prim-core offense) (collide-offense normal-attack))
        (set! (-> bite-sphere transform-index) 11)
        (set-vector! (-> bite-sphere local-sphere) 0.0 0.0 0.0 6144.0)
        (append-prim primitive-group bite-sphere)))
    (set! (-> root-shape nav-radius) (* 0.75 (-> root-shape root-prim local-sphere w)))
    (backup-collide-with-as root-shape)
    (set! (-> this root) root-shape))
  (process-drawable-from-entity! this source-entity)
  (initialize-skeleton this *lurkerworm-sg* '())
  (set! (-> this fact) (new 'process 'fact-info-enemy this (pickup-type eco-pill-random) (-> *FACT-bank* default-pill-inc)))
  (set! (-> this angle) 0.0)
  (set! (-> this vulnerable) #f)
  (set! (-> this part) (create-launch-control group-beach-sandworm this))
  (set! (-> this part2) (create-launch-control group-beach-sandworm-norocks this))
  (set! (-> this twister) (new 'process 'twister 3 15 1092.2667 72.81778 0.25 0.001))
  (set-max-dry-range! (-> this twister) 3 9 910.2222)
  (set! (-> this head-tilt) 0.0)
  (set! (-> this skel prebind-function) lurkerworm-prebind-function)
  (set! (-> this skel postbind-function) lurkerworm-joint-callback)
  (set! (-> this root nav-radius) 12288.0)
  (nav-mesh-connect this (-> this root) (the-as nav-control #f))
  (go lurkerworm-idle)
  (none))

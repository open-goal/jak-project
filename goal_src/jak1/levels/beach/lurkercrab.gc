;;-*-Lisp-*-
(in-package goal)
(bundles "BEA.DGO")
(require "engine/common-obs/nav-enemy.gc")
(require "engine/target/target-util.gc")

;; DECOMP BEGINS

(defpartgroup group-lurkercrab-slide
  :id 159
  :bounds (static-bspherem 0 -12 0 14)
  :parts
  ((sp-item 663 :fade-after (meters 40) :falloff-to (meters 40))
   (sp-item 664 :fade-after (meters 40) :falloff-to (meters 40))))

(defpart 663
  :init-specs
  ((:texture (bigpuff effects))
   (:num 0.3 0.3)
   (:y (meters -2))
   (:scale-x (meters 2) (meters 2))
   (:scale-y :copy scale-x)
   (:r 100.0 30.0)
   (:g 80.0 20.0)
   (:b 30.0 30.0)
   (:a 16.0 48.0)
   (:vel-y (meters 0.0033333334))
   (:scalevel-x (meters 0.033333335))
   (:fade-a -0.21333334)
   (:accel-y (meters -0.000033333334))
   (:timer (seconds 1))
   (:flags (die-when-faded use-time-of-day-color))))

(defpart 664
  :init-specs
  ((:texture (hotdot effects))
   (:num 0.1 1.0)
   (:y (meters -2))
   (:scale-x (meters 0.2) (meters 0.2))
   (:scale-y :copy scale-x)
   (:r 75.0 60.0)
   (:g 60.0 20.0)
   (:b 23.0 30.0)
   (:a 128.0)
   (:vel-y (meters 0.026666667) (meters 0.026666667))
   (:fade-a -0.42666668)
   (:accel-y (meters -0.0016666667))
   (:timer (seconds 1))
   (:flags (die-when-faded use-time-of-day-color))
   (:conerot-x (degrees 30) (degrees 30))
   (:conerot-y (degrees 0) (degrees 360))
   (:conerot-radius (meters 0.2))))

(deftype lurkercrab (nav-enemy)
  ((orient basic))
  (:states
   lurkercrab-pushed))

(defskelgroup *lurkercrab-sg*
  lurkercrab
  lurkercrab-lod0-jg
  lurkercrab-idle-ja
  ((lurkercrab-lod0-mg (meters 20)) (lurkercrab-lod1-mg (meters 40)) (lurkercrab-lod2-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 2.5))

(defmethod touch-handler ((this lurkercrab) (other-process process) (block event-message-block))
  "When the claw offense is enabled and an offensive primitive touches another process, send
   the generic contact attack. Always apply shove-back, then resolve overlaps unless a contact
   attack has already landed this frame."
  (if (and (logtest? (-> this nav-enemy-flags) (nav-enemy-flags attack-enabled))
           ((method-of-type touching-shapes-entry prims-touching?)
            (the-as touching-shapes-entry (-> block param 0))
            (-> this collide-info)
            (the-as uint 1)))
    (nav-enemy-send-attack other-process (the-as touching-shapes-entry (-> block param 0)) 'generic))
  (send-shove-back (-> this collide-info)
                   other-process
                   (the-as touching-shapes-entry (-> block param 0))
                   0.7
                   6144.0
                   16384.0)
  (if (not (logtest? (-> this nav-enemy-flags) (nav-enemy-flags attack-landed))) (do-push-aways! (-> this collide-info))))

(defmethod attack-handler ((this lurkercrab) (sender process) (block event-message-block))
  "Record the incoming attack handle. Flop, explosion, and dark-eco attacks always kill the
   crab, and every attack kills while its shell is vulnerable. Otherwise enter the pushed
   state, aiming a punch knockback along the target's facing or another hit away from the
   target."
  (let ((previous-attack-id (-> this incomming-attack-id)))
    (set! (-> this incomming-attack-id) (the-as handle (-> block param 2)))
    (let ((attack-type (-> block param 1)))
      (cond
        ((or (= attack-type 'flop) (= attack-type 'explode) (= attack-type 'darkeco))
         (logclear! (-> this mask) (process-mask actor-pause))
         (go (method-of-object this nav-enemy-die)))
        ((= attack-type 'punch)
         (cond
           ((logtest? (-> this nav-enemy-flags) (nav-enemy-flags vulnerable))
            (logclear! (-> this mask) (process-mask actor-pause))
            (go (method-of-object this nav-enemy-die)))
           ((begin
              (let ((punch-destination (new 'stack-no-clear 'vector)))
                (let ((target-heading (quaternion-xz-angle (target-rot))))
                  (set-vector! punch-destination (* 24576.0 (sin target-heading)) 0.0 (* 24576.0 (cos target-heading)) 1.0))
                (vector+! punch-destination (-> this collide-info trans) punch-destination)
                (set! (-> this nav target-pos quad) (-> punch-destination quad)))
              (go lurkercrab-pushed)
              (= previous-attack-id (-> this incomming-attack-id)))
            'push)
           (else #t)))
        ((logtest? (-> this nav-enemy-flags) (nav-enemy-flags vulnerable))
         (logclear! (-> this mask) (process-mask actor-pause))
         (go (method-of-object this nav-enemy-die)))
        ((begin
           (let ((knockback-destination (new 'stack-no-clear 'vector)))
             (vector-! knockback-destination (-> this collide-info trans) (target-pos 0))
             (vector-normalize! knockback-destination 24576.0)
             (vector+! knockback-destination (-> this collide-info trans) knockback-destination)
             (set! (-> this nav target-pos quad) (-> knockback-destination quad)))
           (go lurkercrab-pushed)
           (= previous-attack-id (-> this incomming-attack-id)))
         'push)
        (else #t)))))

nav-enemy-default-event-handler

(defmethod turn-toward-travel! ((this lurkercrab))
  "While orient is true, steer toward target-pos after navigation reports the destination
   reached and otherwise steer along the travel heading. While false, spin in place at two and
   a half turns per second."
  (when (-> this orient)
    (if (logtest? (nav-control-flags reached-destination) (-> this nav flags))
      (seek-to-point-toward-point! (-> this collide-info) (-> this nav target-pos) (-> this rotate-speed) (-> this turn-time))
      (seek-toward-heading-vec! (-> this collide-info) (-> this nav travel) (-> this rotate-speed) (-> this turn-time))))
  (if (not (-> this orient))
    (quaternion-rotate-y! (-> this collide-info quat) (-> this collide-info quat) (* 163840.0 (seconds-per-frame))))
  0
  (none))

(defmethod integrate-and-collide! ((this lurkercrab))
  "Move by the current translation velocity and follow background ground within two metres,
   without hovering or using either special ground probe."
  (integrate-for-enemy-with-move-to-ground! (-> this collide-info)
                                            (-> this collide-info transv)
                                            (collide-kind background)
                                            8192.0
                                            #f
                                            #f
                                            #f)
  0
  (none))

;; The crab keeps its shell closed while walking. On patrol it walks six cycles, may stop for an
;; idle spell, then peeks out: the central body becomes vulnerable and the two claw spheres can
;; attack for two animation passes before the shell closes again. A chase uses the same opening
;; around the full snip attack. Flop, explosion, and dark-eco hits bypass the shell; another hit
;; against a closed shell sets a slide target six metres away before the crab resumes the chase.
(defstate nav-enemy-idle (lurkercrab)
  :virtual #t
  :event nav-enemy-default-event-handler
  :exit
    (behavior ()
      (set! (-> self draw force-lod) -1))
  :code
    (behavior ()
      (set! (-> self target-speed) 0.0)
      (set! (-> self draw force-lod) 2)
      (ja-channel-push! 1 (seconds 0.075))
      (loop
        (ja :group! lurkercrab-idle-ja :num! (identity (ja-aframe 1.0 0)))
        (suspend-for (seconds 3))
        (ja-play :group! lurkercrab-idle-ja :num! (seek! (ja-aframe 19.0 0)) :frame-num (ja-aframe 1.0 0))
        (ja :num-func num-func-identity :frame-num (ja-aframe 19.0 0))
        (suspend-for (seconds 1))
        (ja-play :group! lurkercrab-idle-ja :num! (seek! (ja-aframe 1.0 0)) :frame-num (ja-aframe 19.0 0)))))

(defbehavior lurkercrab-invulnerable lurkercrab ()
  "Protect the crab from ordinary damage and restore indestructible offense on its central
   collision primitive."
  (logclear! (-> self nav-enemy-flags) (nav-enemy-flags vulnerable))
  (let ((body-primitive (find-prim-by-id (-> self collide-info) (the-as uint 2))))
    (when body-primitive
      (let ((offense 4)) (set! (-> body-primitive prim-core offense) (the-as collide-offense offense)) offense))))

(defbehavior lurkercrab-vulnerable lurkercrab ()
  "Expose the crab to damage and change its central collision primitive to normal attack offense."
  (logior! (-> self nav-enemy-flags) (nav-enemy-flags vulnerable))
  (let ((body-primitive (find-prim-by-id (-> self collide-info) (the-as uint 2))))
    (when body-primitive
      (let ((offense 1)) (set! (-> body-primitive prim-core offense) (the-as collide-offense offense)) offense))))

(defstate nav-enemy-patrol (lurkercrab)
  :virtual #t
  :event nav-enemy-default-event-handler
  :exit
    (behavior ()
      (lurkercrab-invulnerable)
      (logclear! (-> self nav-enemy-flags) (nav-enemy-flags attack-enabled))
      (logior! (-> self nav-enemy-flags) (nav-enemy-flags enable-rotate)))
  :code
    (behavior ()
      (if (ja-group? lurkercrab-idle-ja) (ja-play :group! lurkercrab-idle-to-walk-ja :num! (seek!) :frame-num 0.0))
      (ja-channel-push! 1 (seconds 0.075))
      (loop
        (dotimes (walk-cycle 6)
          (ja-play :group! lurkercrab-walk-ja :num! (seek!) :frame-num 0.0))
        (when (nav-enemy-rnd-go-idle? 0.2)
          (ja-no-eval :num! (loop!))
          (ja-channel-push! 1 (seconds 0.6))
          (logclear! (-> self nav-enemy-flags) (nav-enemy-flags enable-rotate))
          (nav-enemy-rnd-int-range 2 6)
          (until (not (nav-enemy-rnd-go-idle? 0.2))
            (ja :group! lurkercrab-idle-ja :num! (identity (ja-aframe 1.0 0)))
            (suspend-for (seconds 2)))
          (logior! (-> self nav-enemy-flags) (nav-enemy-flags enable-rotate))
          (ja-play :group! lurkercrab-idle-to-walk-ja :num! (seek!) :frame-num 0.0))
        (ja-play :group! lurkercrab-peek-ja :num! (seek! (ja-aframe 30.0 0)) :frame-num (ja-aframe 1.0 0))
        (lurkercrab-vulnerable)
        (logior! (-> self nav-enemy-flags) (nav-enemy-flags attack-enabled))
        (dotimes (peek-cycle 2)
          (ja-play :group! lurkercrab-peek-ja :num! (seek! (ja-aframe 60.0 0)) :frame-num (ja-aframe 30.0 0)))
        (lurkercrab-invulnerable)
        (logclear! (-> self nav-enemy-flags) (nav-enemy-flags attack-enabled))
        (ja-play :group! lurkercrab-peek-to-walk-ja :num! (seek! (ja-aframe 90.0 0)) :frame-num (ja-aframe 60.0 0)))))

(defstate nav-enemy-notice (lurkercrab)
  :virtual #t
  :event nav-enemy-default-event-handler
  :code
    (behavior ()
      (go-virtual nav-enemy-chase)))

(defstate nav-enemy-chase (lurkercrab)
  :virtual #t
  :event nav-enemy-default-event-handler
  :exit
    (behavior ()
      (lurkercrab-invulnerable)
      (logclear! (-> self nav-enemy-flags) (nav-enemy-flags attack-enabled)))
  :trans
    (behavior ()
      (if (logtest? (-> *target* state-flags)
                    (state-flags being-attacked invulnerable timed-invulnerable invuln-powerup do-not-notice dying))
        (go-virtual nav-enemy-victory))
      (if (< (ja-aframe-num 0) 2.0) ((-> (method-of-type nav-enemy nav-enemy-chase) trans))))
  :code
    (behavior ()
      (logior! (-> self nav-enemy-flags) (nav-enemy-flags enable-rotate))
      (ja-channel-push! 1 (seconds 0.075))
      (loop
        (ja-play :group! lurkercrab-walk-ja :num! (seek!) :frame-num 0.0)
        (lurkercrab-vulnerable)
        (logior! (-> self nav-enemy-flags) (nav-enemy-flags attack-enabled))
        (ja-play :group! lurkercrab-peek-ja :num! (seek! (ja-aframe 30.0 0)) :frame-num (ja-aframe 1.0 0))
        (ja-play :group! lurkercrab-snip-ja :num! (seek! (ja-aframe 120.0 0)) :frame-num (ja-aframe 30.0 0))
        (ja-play :group! lurkercrab-peek-ja :num! (seek! (ja-aframe 60.0 0)) :frame-num (ja-aframe 30.0 0))
        (ja-play :group! lurkercrab-peek-ja :num! (seek! (ja-aframe 60.0 0)) :frame-num (ja-aframe 30.0 0))
        (lurkercrab-invulnerable)
        (logclear! (-> self nav-enemy-flags) (nav-enemy-flags attack-enabled))
        (ja-play :group! lurkercrab-peek-to-walk-ja :num! (seek! (ja-aframe 90.0 0)) :frame-num (ja-aframe 60.0 0))
        (ja-play :group! lurkercrab-walk-ja :num! (seek!) :frame-num 0.0)
        (ja-play :group! lurkercrab-walk-ja :num! (seek!) :frame-num 0.0))))

(defstate nav-enemy-stop-chase (lurkercrab)
  :virtual #t
  :event nav-enemy-default-event-handler
  :code
    (behavior ()
      (go-virtual nav-enemy-patrol)))

(defstate nav-enemy-stare (lurkercrab)
  :virtual #t
  :event nav-enemy-default-event-handler
  :code
    (behavior ()
      (go-virtual nav-enemy-patrol)))

(defstate nav-enemy-victory (lurkercrab)
  :virtual #t
  :event nav-enemy-default-event-handler
  :code
    (behavior ()
      (set-time! (-> self state-time))
      (ja-channel-push! 1 (seconds 0.075))
      (ja :group! (-> self draw art-group data (-> self nav-info victory-anim)))
      (until (time-elapsed? (-> self state-time) (seconds 1))
        (ja :num-func num-func-identity :frame-num 0.0)
        (suspend))
      (go-virtual nav-enemy-patrol)))

(defstate lurkercrab-pushed (lurkercrab)
  :event nav-enemy-default-event-handler
  :exit
    (behavior ()
      (set! (-> self orient) #t))
  :code
    (behavior ()
      (set! (-> self momentum-speed) 57344.0)
      (set! (-> self target-speed) 0.0)
      (set! (-> self orient) #f)
      (ja-play :group! lurkercrab-kickback-ja :num! (seek! (ja-aframe 18.0 0) 0.75) :frame-num (ja-aframe 1.0 0))
      (suspend-for (seconds 0.25))
      (suspend-for (seconds 0.1))
      (go-virtual nav-enemy-chase))
  :post
    (behavior ()
      (let ((slide-particles (-> self part))
            (root-primitive-core (-> self collide-info root-prim prim-core)))
        (spawn slide-particles (-> root-primitive-core world-sphere)))
      (nav-enemy-travel-post)))

(define *lurkercrab-nav-enemy-info*
  (new 'static
       'nav-enemy-info
       :idle-anim 4
       :walk-anim 6
       :turn-anim -1
       :notice-anim 4
       :run-anim 6
       :jump-anim 6
       :jump-land-anim 6
       :victory-anim 4
       :taunt-anim 4
       :die-anim 11
       :neck-joint -1
       :player-look-at-joint 5
       :run-travel-speed (meters 5)
       :run-rotate-speed (degrees 999.99994)
       :run-acceleration (meters 12)
       :run-turn-time (seconds 0.1)
       :walk-travel-speed (meters 2)
       :walk-rotate-speed (degrees 999.99994)
       :walk-acceleration (meters 12)
       :walk-turn-time (seconds 0.1)
       :attack-shove-back (meters 1.2)
       :attack-shove-up (meters 1.5)
       :shadow-size (meters 2)
       :notice-nav-radius (meters 1)
       :nav-nearest-y-threshold (meters 10)
       :notice-distance (meters 25)
       :stop-chase-distance (meters 35)
       :frustration-distance (meters 8)
       :frustration-time (seconds 4)
       :die-anim-hold-frame 4.0
       :jump-land-anim-end-frame 10000000000.0
       :jump-height-min (meters 1)
       :jump-height-factor 0.5
       :jump-start-anim-speed 1.0
       :shadow-max-y (meters 1)
       :shadow-min-y (meters -1)
       :shadow-locus-dist (meters 150)
       :use-align #f
       :draw-shadow #t
       :move-to-ground #t
       :hover-if-no-ground #f
       :use-momentum #t
       :use-flee #f
       :use-proximity-notice #f
       :use-jump-blocked #f
       :use-jump-patrol #f
       :gnd-collide-with (collide-kind background)
       :debug-draw-neck #f
       :debug-draw-jump #f))

(defmethod init-from-entity! ((this lurkercrab) (source-entity entity-actor))
  "Build the crab's body and joint-mounted claw collision, drawable, skeleton, navigation
   tuning, and slide particles. Begin invulnerable, stationary, and forced to the distant LOD
   in the idle state."
  (let ((root-shape (new 'process 'collide-shape-moving this (collide-list-enum usually-hit-by-player))))
    (set! (-> root-shape dynam) (copy *standard-dynamics* 'process))
    (set! (-> root-shape reaction) default-collision-reaction)
    (set! (-> root-shape no-reaction)
          (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (let ((primitive-group (new 'process 'collide-shape-prim-group root-shape (the-as uint 3) 0)))
      (set! (-> primitive-group prim-core collide-as) (collide-kind enemy))
      (set! (-> primitive-group collide-with) (collide-kind target))
      (set! (-> primitive-group prim-core action) (collide-action solid))
      (set-vector! (-> primitive-group local-sphere) 0.0 10240.0 0.0 12288.0)
      (set-root-prim! root-shape primitive-group)
      (let ((body-primitive (new 'process 'collide-shape-prim-sphere root-shape (the-as uint 2))))
        (set! (-> body-primitive prim-core collide-as) (collide-kind enemy))
        (set! (-> body-primitive collide-with) (collide-kind target))
        (set! (-> body-primitive prim-core action) (collide-action solid))
        (set! (-> body-primitive prim-core offense) (collide-offense indestructible))
        (set-vector! (-> body-primitive local-sphere) 0.0 4915.2 0.0 4096.0)
        (append-prim primitive-group body-primitive))
      (let ((joint-16-claw (new 'process 'collide-shape-prim-sphere root-shape (the-as uint 1))))
        (set! (-> joint-16-claw prim-core collide-as) (collide-kind enemy))
        (set! (-> joint-16-claw collide-with) (collide-kind target))
        (set! (-> joint-16-claw prim-core offense) (collide-offense normal-attack))
        (set! (-> joint-16-claw transform-index) 16)
        (set-vector! (-> joint-16-claw local-sphere) 0.0 0.0 0.0 1638.4)
        (append-prim primitive-group joint-16-claw))
      (let ((joint-21-claw (new 'process 'collide-shape-prim-sphere root-shape (the-as uint 1))))
        (set! (-> joint-21-claw prim-core collide-as) (collide-kind enemy))
        (set! (-> joint-21-claw collide-with) (collide-kind target))
        (set! (-> joint-21-claw prim-core offense) (collide-offense normal-attack))
        (set! (-> joint-21-claw transform-index) 21)
        (set-vector! (-> joint-21-claw local-sphere) 0.0 0.0 0.0 1638.4)
        (append-prim primitive-group joint-21-claw)))
    (set! (-> root-shape nav-radius) 4096.0)
    (backup-collide-with-as root-shape)
    (set! (-> this collide-info) root-shape))
  (process-drawable-from-entity! this source-entity)
  (initialize-skeleton this *lurkercrab-sg* '())
  (init-defaults! this *lurkercrab-nav-enemy-info*)
  (set! (-> this part) (create-launch-control group-lurkercrab-slide this))
  (set! (-> this orient) #t)
  (logclear! (-> this nav-enemy-flags) (nav-enemy-flags vulnerable attack-enabled))
  (set! (-> this target-speed) 0.0)
  (set! (-> this momentum-speed) 0.0)
  (set! (-> this draw force-lod) 2)
  (go (method-of-object this nav-enemy-idle))
  (none))

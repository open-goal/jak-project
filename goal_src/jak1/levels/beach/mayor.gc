(defmethod get-art-elem ((this mayor))
  "Return the art element on the active root animation channel."
  (-> this draw art-group data 3))

(defmethod should-display? ((this mayor))
  "Return whether the target, or the camera before a target exists, is less than fourteen metres
   beyond the Mayor along world Z."
  (if *target*
    (< (- (-> (target-pos 0) z) (-> this root trans z)) 57344.0)
    (< (- (-> (camera-pos) z) (-> this root trans z)) 57344.0)))

(defmethod try-play-ambient-chatter ((this mayor))
  "When the target is within thirty metres and the thirty-second cooldown has elapsed, choose
   one of nine Mayor idle lines with equal probability. After the Lurker-machine reminder is
   complete, six task-specific choices become silence while the three generic lines remain."
  (when (ambient-chatter-ready? (-> this ambient) (new 'stack-no-clear 'vector) (seconds 30) 122880.0 this)
    (let ((choice (rand-float-gen)))
      (cond
        ((< 0.8888889 choice)
         (if (not (closed? (-> this tasks) (game-task jungle-lurkerm) (task-status need-reminder)))
           (play-ambient (-> this ambient) "CHI-LO01" #f (-> this root trans))))
        ((< 0.7777778 choice)
         (if (not (closed? (-> this tasks) (game-task jungle-lurkerm) (task-status need-reminder)))
           (play-ambient (-> this ambient) "CHI-LO02" #f (-> this root trans))))
        ((< 0.6666667 choice)
         (if (not (closed? (-> this tasks) (game-task jungle-lurkerm) (task-status need-reminder)))
           (play-ambient (-> this ambient) "CHI-AM07" #f (-> this root trans))))
        ((< 0.5555556 choice) (play-ambient (-> this ambient) "CHI-AM06" #f (-> this root trans)))
        ((< 0.44444445 choice) (play-ambient (-> this ambient) "CHI-AM05" #f (-> this root trans)))
        ((< 0.33333334 choice) (play-ambient (-> this ambient) "CHI-AM04" #f (-> this root trans)))
        ((< 0.22222222 choice)
         (if (not (closed? (-> this tasks) (game-task jungle-lurkerm) (task-status need-reminder)))
           (play-ambient (-> this ambient) "CHI-AM03" #f (-> this root trans))))
        ((< 0.11111111 choice)
         (if (not (closed? (-> this tasks) (game-task jungle-lurkerm) (task-status need-reminder)))
           (play-ambient (-> this ambient) "CHI-AM02" #f (-> this root trans))))
        (else
         (if (not (closed? (-> this tasks) (game-task jungle-lurkerm) (task-status need-reminder)))
           (play-ambient (-> this ambient) "CHI-AM01" #f (-> this root trans))))))))

(defstate idle (mayor)
  :virtual #t
  :trans
    (behavior ()
      (if (not (should-display? self)) (go-virtual hidden))
      ((-> (method-of-type process-taskable idle) trans)))
  :post
    (behavior ()
      (let ((parent-post (-> (method-of-type process-taskable idle) post)))
        (if parent-post ((the-as (function none) parent-post))))
      (do-push-aways! (-> self root))))

(defmethod init-from-entity! ((this mayor) (source-entity entity-actor))
  "Initialize the Mayor for the jungle Lurker machine and village donation tasks, configure his
   lighting and music flavor, and enter the taskable state selected by current progress."
  (init-as-taskable! this source-entity *mayor-sg* 3 51 (new 'static 'vector :y 4096.0 :w 4096.0) 5)
  (set! (-> this bounce-away) #f)
  (set! (-> this tasks) (get-task-control (game-task jungle-lurkerm)))
  (set! (-> this sound-flava) (music-flava mayor))
  (set! (-> this draw light-index) (the-as uint 2))
  (goto-initial-state! this)
  (none))

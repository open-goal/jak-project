;;-*-Lisp-*-
(in-package goal)
(bundles "BEA.DGO")
(require "engine/common-obs/process-taskable.gc")
(declare-type muse nav-enemy)

;; DECOMP BEGINS

(deftype sculptor (process-taskable)
  ((muse handle))) ;; displayed Muse manipulator

(defskelgroup *sculptor-muse-sg*
  sculptor-muse
  sculptor-muse-lod0-jg
  sculptor-muse-idle-ja
  ((sculptor-muse-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 2.5))

(defskelgroup *sculptor-sg*
  sculptor
  sculptor-lod0-jg
  sculptor-sigh-ja
  ((sculptor-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 2.5)
  :shadow sculptor-shadow-mg)

(defmethod setup-shadow-settings! ((this sculptor))
  "Set the Sculptor's shadow-control bottom and top plane W terms from his root Y position using
   half-metre offsets."
  (let ((shadow-state (-> this draw shadow-ctrl)))
    (when shadow-state
      (let ((root-y (-> this root trans y)))
        (set! (-> shadow-state settings bot-plane w) (- (+ -2048.0 root-y)))
        0
        (set! (-> shadow-state settings top-plane w) (- (+ 2048.0 root-y))))
      0))
  (none))

(defmethod draw-npc-shadow ((this sculptor))
  "Update this character's shadow planes and sun direction when its highest-detail geometry was
   drawn this frame; otherwise disable the shadow."
  (local-vars (shadow-state shadow-control))
  (-> this draw shadow-ctrl)
  (cond
    ((and (-> this draw shadow) (zero? (-> this draw cur-lod)) (logtest? (-> this draw status) (draw-status was-drawn)))
     (set! shadow-state (-> this draw shadow-ctrl))
     (logclear! (-> shadow-state settings flags) (shadow-flags disable-draw))
     0
     (update-direction-from-time-of-day (-> this draw shadow-ctrl)))
    (else
     (set! shadow-state (-> this draw shadow-ctrl))
     (logior! (-> shadow-state settings flags) (shadow-flags disable-draw))
     0))
  (none))

(defbehavior muse-to-idle sculptor ((owner muse))
  "Ensure the displayed Muse manipulator exists, light it, show it with a looping idle animation,
   and attach its origin to joint 26. owner is the Sculptor viewed as a Muse: sculptor.muse and
   muse.incomming-attack-id intentionally share the handle slot at offset 384."
  (if (not (handle->process (-> owner incomming-attack-id)))
    (set! (-> owner incomming-attack-id)
          (ppointer->handle (manipy-spawn (-> owner collide-info trans) (-> owner entity) *sculptor-muse-sg* #f :to owner))))
  (let ((muse-process (handle->process (-> owner incomming-attack-id))))
    (if muse-process (set! (-> (the-as muse muse-process) draw light-index) (the-as uint 3))))
  (send-event (handle->process (-> owner incomming-attack-id)) 'anim-mode 'loop)
  (send-event (handle->process (-> owner incomming-attack-id)) 'art-joint-anim "idle" 0)
  (send-event (handle->process (-> owner incomming-attack-id)) 'draw #t)
  (send-event (handle->process (-> owner incomming-attack-id)) 'origin-joint-index 26))

(defstate give-cell (sculptor)
  :virtual #t
  :enter
    (behavior ()
      (muse-to-idle (the-as muse self))))

(defmethod play-anim! ((this sculptor) (commit? symbol))
  "Choose the Sculptor's conversation animation for the current Misty Muse task stage. When
   commit? is true, apply the corresponding task transition and create the displayed Muse for
   the resolution animation; false only selects or prefetches the animation."
  (case (current-status (-> this tasks))
    (((task-status need-hint) (task-status need-introduction))
     (if commit? (close-status! (-> this tasks) (task-status need-introduction)))
     (new 'static
          'spool-anim
          :name "sculptor-introduction"
          :index 16
          :parts 14
          :command-list
          '((0 display-level beach special)
           (0 kill "med-res-level-2")
           (0 kill "med-res-level-4")
           (0 kill "med-res-level-6")
           (0 kill "med-res-level-7")
           (0 kill "med-res-level-8")
           (0 kill "med-res-level-11")
           (0 kill "med-res-level-14")
           (0 kill "med-res-level-22")
           (0 kill "med-res-level-23")
           (285 joint "cameraB")
           (331 joint "camera")
           (614 joint "cameraB")
           (760 joint "camera")
           (1183 joint "cameraB")
           (1278 joint "camera")
           (1433 joint "cameraB"))))
    (((task-status need-reminder))
     (set! (-> this skippable) #t)
     (new 'static 'spool-anim :name "sculptor-reminder-1" :index 17 :parts 2 :command-list '()))
    (((task-status need-reward-speech))
     (when commit?
       (set! (-> this cell-for-task) (current-task (-> this tasks)))
       (close-current! (-> this tasks))
       (set! (-> this muse)
             (ppointer->handle (manipy-spawn (-> this root trans) (-> this entity) *sculptor-muse-sg* #f :to this)))
       (let ((muse-process (handle->process (-> this muse))))
         (if muse-process (set! (-> (the-as muse muse-process) draw light-index) (the-as uint 3))))
       (send-event (handle->process (-> this muse)) 'center-joint 4)
       (send-event (handle->process (-> this muse)) 'anim-mode 'clone-anim))
     (new 'static
          'spool-anim
          :name "sculptor-resolution"
          :index 18
          :parts 4
          :command-list
          '((51 joint "cameraB") (87 joint "camera"))))
    (else
     (if commit?
       (format 0
               "ERROR: <GMJ>: ~S playing anim for task status ~S~%"
               (-> this name)
               (task-status->string (current-status (-> this tasks)))))
     (-> this draw art-group data 4))))

(defmethod get-art-elem ((this sculptor))
  "Return art element 11 while the Muse task is invalid or awaiting resolution, otherwise
   return the Sculptor's active root-channel art element."
  (case (current-status (-> this tasks))
    (((task-status invalid) (task-status need-resolution)) (-> this draw art-group data 11))
    (else (-> this draw art-group data 3))))

(defmethod try-play-ambient-chatter ((this sculptor))
  "When the target is within thirty metres and the thirty-second cooldown has elapsed, choose
   one of seven Sculptor idle lines with approximately equal probability."
  (when (ambient-control-method-10 (-> this ambient) (new 'stack-no-clear 'vector) (seconds 30) 122880.0 this)
    (let ((choice (rand-float-gen)))
      (cond
        ((< 0.85714287 choice) (play-ambient (-> this ambient) "SCU-LO01" #f (-> this root trans)))
        ((< 0.71428573 choice) (play-ambient (-> this ambient) "SCU-AM05" #f (-> this root trans)))
        ((< 0.5714286 choice) (play-ambient (-> this ambient) "SCU-AM06" #f (-> this root trans)))
        ((< 0.42857143 choice) (play-ambient (-> this ambient) "SCU-AM03" #f (-> this root trans)))
        ((< 0.2857143 choice) (play-ambient (-> this ambient) "SCU-AM04" #f (-> this root trans)))
        ((< 0.14285715 choice) (play-ambient (-> this ambient) "SCU-AM01" #f (-> this root trans)))
        (else (play-ambient (-> this ambient) "SCU-AM02" #f (-> this root trans)))))))

;; During the invalid and need-resolution task stages, alternate small and large sculpting passes:
;; four to seven small strokes, a look at the work, and half the time another two to three large
;; strokes. During other stages, four to seven idle cycles end with either a sigh or a three-part
;; strike.
(defstate idle (sculptor)
  :virtual #t
  :code
    (behavior ()
      (when (!= (ja-group) (get-art-elem self))
        (ja-channel-push! 1 (seconds 0.2))
        (ja :group! (get-art-elem self)))
      (ja-no-eval :num! (seek!))
      (while (not (ja-done? 0))
        (suspend)
        (ja-eval))
      (case (current-status (-> self tasks))
        (((task-status invalid) (task-status need-resolution))
         (ja-play :group! sculptor-from-looking-ja :num! (seek!) :frame-num 0.0)
         (muse-to-idle (the-as muse self))))
      (loop
        (let ((task-stage (current-status (-> self tasks))))
          (cond
            ((or (= task-stage (task-status invalid)) (= task-stage (task-status need-resolution)))
             (ja-play :group! sculptor-to-small-ja :num! (seek!) :frame-num 0.0)
             (countdown (small-repeats-left (+ (the int (* 4.0 (rand-float-gen))) 4))
               (ja-play :group! sculptor-small-ja :num! (seek!) :frame-num 0.0))
             (let ((huge-roll (rand-float-gen)))
               (ja-play :group! sculptor-small-to-looking-ja :num! (seek!) :frame-num 0.0)
               (ja-play :group! sculptor-looking-ja :num! (seek!) :frame-num 0.0)
               (ja-play :group! sculptor-from-looking-ja :num! (seek!) :frame-num 0.0)
               (when (< huge-roll 0.5)
                 (ja-play :group! sculptor-to-huge-ja :num! (seek!) :frame-num 0.0)
                 (countdown (huge-repeats-left (+ (the int (* 2.0 (rand-float-gen))) 2))
                   (ja-play :group! sculptor-huge-ja :num! (seek!) :frame-num 0.0))
                 (ja-play :group! sculptor-huge-to-looking-ja :num! (seek!) :frame-num 0.0)
                 (ja-play :group! sculptor-looking-ja :num! (seek!) :frame-num 0.0)
                 (ja-play :group! sculptor-from-looking-ja :num! (seek!) :frame-num 0.0))))
            ((begin
               (try-play-ambient-chatter self)
               (countdown (idle-repeats-left (+ (the int (* 4.0 (rand-float-gen))) 4))
                 (ja-play :group! sculptor-idle-ja :num! (seek!) :frame-num 0.0))
               (< (rand-float-gen) 0.5))
             (ja-play :group! sculptor-sigh-ja :num! (seek!) :frame-num 0.0))
            (else
             (ja-play :group! sculptor-strikestart-ja :num! (seek!) :frame-num 0.0)
             (ja-play :group! sculptor-strikemiddle-ja :num! (seek!) :frame-num 0.0)
             (ja-play :group! sculptor-strikeend-ja :num! (seek!) :frame-num 0.0)))))))

(defmethod init-from-entity! ((this sculptor) (source-entity entity-actor))
  "Initialize the Sculptor for the Misty Muse task, clear his displayed-Muse handle, configure
   his lighting and music flavor, and enter the taskable state selected by current progress."
  (init-as-taskable! this source-entity *sculptor-sg* 3 40 (new 'static 'vector :w 4096.0) 5)
  (set! (-> this tasks) (get-task-control (game-task misty-muse)))
  (set! (-> this muse) (the-as handle #f))
  (set! (-> this sound-flava) (music-flava sculptor))
  (set! (-> this draw light-index) (the-as uint 3))
  (goto-initial-state! this)
  (none))

;;-*-Lisp-*-
(in-package goal)
(bundles "BEA.DGO")
(require "levels/beach/air-h.gc")
(require "engine/debug/debug-h.gc")
(require "engine/math/math.gc")

;; DECOMP BEGINS

(defun point-in-air? ((position vector) (air-boxes (inline-array air-box)) (count int))
  "Return true when position lies inside any of the first count air boxes. Return false for an
   empty array or when no box contains it."
  (local-vars (inside? symbol))
  (dotimes (i count)
    (let ((air-volume (-> air-boxes i)))
      (set! inside?
            (when (< (-> air-volume height-level) (-> position y))
              (let ((x-offset (- (-> position x) (-> air-volume x-pos)))
                    (z-offset (- (-> position z) (-> air-volume z-pos))))
                (set! inside? #f)
                (let ((local-x (+ (* x-offset (-> air-volume cos-angle)) (* z-offset (-> air-volume sin-angle))))
                      (local-z (- (* z-offset (-> air-volume cos-angle)) (* x-offset (-> air-volume sin-angle)))))
                  (if (and (>= local-x 0.0) (>= local-z 0.0) (< local-x (-> air-volume x-length)) (< local-z (-> air-volume z-length)))
                    (set! inside? #t))))
              inside?)))
    (if inside? (return #t)))
  #f)

(defun points-in-air? ((first-position vector) (second-position vector) (air-boxes (inline-array air-box)) (count int))
  "Return true when both positions lie inside the same one of the first count air boxes. This tests
   the endpoints themselves, not whether the segment between them crosses a box."
  (local-vars (both-inside? symbol))
  (dotimes (i count)
    (let* ((air-volume (-> air-boxes i))
           (minimum-height (-> air-volume height-level)))
      (when (and (< minimum-height (-> first-position y)) (< minimum-height (-> second-position y)))
        (let ((first-x-offset (- (-> first-position x) (-> air-volume x-pos)))
              (first-z-offset (- (-> first-position z) (-> air-volume z-pos)))
              (second-x-offset (- (-> second-position x) (-> air-volume x-pos)))
              (second-z-offset (- (-> second-position z) (-> air-volume z-pos))))
          (let ((first-inside? #f))
            (let ((first-local-x (+ (* first-x-offset (-> air-volume cos-angle)) (* first-z-offset (-> air-volume sin-angle))))
                  (first-local-z (- (* first-z-offset (-> air-volume cos-angle)) (* first-x-offset (-> air-volume sin-angle)))))
              (if (and (>= first-local-x 0.0)
                       (>= first-local-z 0.0)
                       (< first-local-x (-> air-volume x-length))
                       (< first-local-z (-> air-volume z-length)))
                (set! first-inside? #t)))
            (set! both-inside?
                  (and first-inside?
                       (begin
                         (set! both-inside? #f)
                         (let ((second-local-x (+ (* second-x-offset (-> air-volume cos-angle)) (* second-z-offset (-> air-volume sin-angle))))
                               (second-local-z (- (* second-z-offset (-> air-volume cos-angle)) (* second-x-offset (-> air-volume sin-angle)))))
                           (if (and (>= second-local-x 0.0)
                                    (>= second-local-z 0.0)
                                    (< second-local-x (-> air-volume x-length))
                                    (< second-local-z (-> air-volume z-length)))
                             (set! both-inside? #t)))
                         both-inside?)))))
        (if both-inside? (return #t)))))
  #f)

(defun-debug add-debug-air-box ((bucket bucket-id) (air-volume air-box))
  "Draw the air box's rectangular boundary at its minimum height. Use translucent green when the
   camera is inside the volume and translucent red otherwise."
  (local-vars (camera-inside? symbol))
  (let ((camera-position (camera-pos))
        (corner-a (new 'stack-no-clear 'vector))
        (corner-b (new 'stack-no-clear 'vector)))
    (-> air-volume cos-angle)
    (-> air-volume sin-angle)
    (let ((color (the-as uint #x800000ff)))
      (set! camera-inside?
            (when (< (-> air-volume height-level) (-> camera-position y))
              (let ((x-offset (- (-> camera-position x) (-> air-volume x-pos)))
                    (z-offset (- (-> camera-position z) (-> air-volume z-pos))))
                (set! camera-inside? #f)
                (let ((local-x (+ (* x-offset (-> air-volume cos-angle)) (* z-offset (-> air-volume sin-angle))))
                      (local-z (- (* z-offset (-> air-volume cos-angle)) (* x-offset (-> air-volume sin-angle)))))
                  (if (and (>= local-x 0.0) (>= local-z 0.0) (< local-x (-> air-volume x-length)) (< local-z (-> air-volume z-length)))
                    (set! camera-inside? #t))))
              camera-inside?))
      (if camera-inside? (set! color (the-as uint #x8000ff00)))
      (set! (-> corner-a y) (-> air-volume height-level))
      (set! (-> corner-b y) (-> air-volume height-level))
      (set! (-> corner-a w) 1.0)
      (set! (-> corner-b w) 1.0)
      (set! (-> corner-a x) (-> air-volume x-pos))
      (set! (-> corner-a z) (-> air-volume z-pos))
      (set! (-> corner-b x) (+ (-> air-volume x-pos) (* (-> air-volume cos-angle) (-> air-volume x-length))))
      (set! (-> corner-b z) (+ (-> air-volume z-pos) (* (-> air-volume sin-angle) (-> air-volume x-length))))
      (add-debug-line #t bucket corner-a corner-b (the-as rgba color) #f (the-as rgba -1))
      (vector-copy! corner-a corner-b)
      (set! (-> corner-b x) (+ (-> corner-a x) (* (- (-> air-volume sin-angle)) (-> air-volume z-length))))
      (set! (-> corner-b z) (+ (-> corner-a z) (* (-> air-volume cos-angle) (-> air-volume z-length))))
      (add-debug-line #t bucket corner-a corner-b (the-as rgba color) #f (the-as rgba -1))
      (set! (-> corner-a x) (+ (-> air-volume x-pos) (* (- (-> air-volume sin-angle)) (-> air-volume z-length))))
      (set! (-> corner-a z) (+ (-> air-volume z-pos) (* (-> air-volume cos-angle) (-> air-volume z-length))))
      (add-debug-line #t bucket corner-a corner-b (the-as rgba color) #f (the-as rgba -1))
      (set! (-> corner-b x) (-> air-volume x-pos))
      (set! (-> corner-b z) (-> air-volume z-pos))
      (add-debug-line #t bucket corner-a corner-b (the-as rgba color) #f (the-as rgba -1)))))

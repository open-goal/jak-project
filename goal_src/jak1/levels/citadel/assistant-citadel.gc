;;-*-Lisp-*-
(in-package goal)
(bundles "CIT.DGO")
(require "engine/common-obs/process-taskable.gc")

;; DECOMP BEGINS

(deftype assistant-lavatube-end (process-taskable)
  "Keira's end-of-Lava-Tube task character, shown until the Citadel rescue sequence begins."
  ()
  (:methods
   (hidden () _type_ :state :replace)
   (idle () _type_ :state :replace)))

(defskelgroup *assistant-lavatube-end-sg*
  assistant-lavatube-end
  assistant-lavatube-end-lod0-jg
  assistant-lavatube-end-idle-ja
  ((assistant-lavatube-end-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 4)
  :shadow assistant-lavatube-end-shadow-mg)

(defmethod play-anim! ((this assistant-lavatube-end) (commit? symbol))
  "Select the Lava Tube introduction or resolution animation for the current task stage, and
   close the current stage when commit? is true."
  (case (current-status (-> this tasks))
    (((task-status unknown) (task-status need-hint))
     (new 'static 'spool-anim :name "assistant-lavatube-end-resolution" :index 4 :parts 11 :command-list '()))
    (((task-status need-reward-speech))
     (if commit? (close-current! (-> this tasks)))
     (new 'static
          'spool-anim
          :name "assistant-lavatube-end-resolution"
          :index 4
          :parts 11
          :command-list
          '((61 joint "cameraB")
           (151 joint "camera")
           (226 joint "cameraB")
           (273 joint "camera")
           (316 joint "cameraB")
           (451 joint "camera")
           (651 joint "cameraB")
           (786 joint "camera")
           (888 joint "cameraB")
           (1011 joint "camera")
           (1011 shadow target #f)
           (1140 shadow target #t)
           (1191 joint "cameraB"))))
    (else
     (if commit?
       (format 0
               "ERROR: <GMJ>: ~S playing anim for task status ~S~%"
               (-> this name)
               (task-status->string (current-status (-> this tasks)))))
     (get-art-elem this))))

(defmethod get-art-elem ((this assistant-lavatube-end))
  "Return the art element on the active root animation channel."
  (-> this draw art-group data 3))

(defstate hidden (assistant-lavatube-end)
  :virtual #t
  :trans
    (behavior ()
      "Prefetch the current animation, run the shared hidden transition, and test whether Jak is
       within fifteen metres while reward speech remains open."
      (prefetch-play-anim! self)
      ((-> (method-of-type process-taskable hidden) trans))
      (when (and (and *target* (>= 61440.0 (vector-vector-distance (-> self root trans) (-> *target* control trans))))
                 (not (closed? (-> self tasks) (game-task village4-button) (task-status need-reward-speech)))))))

(defstate idle (assistant-lavatube-end)
  :virtual #t
  :enter
    (behavior ()
      "Run the shared idle entry and request the resolution animation when reward speech is due."
      ((-> (method-of-type process-taskable idle) enter))
      (case (get-task-status (game-task village4-button))
        (((task-status need-reward-speech)) (send-event self 'play-anim))))
  :code
    (behavior ()
      "Keep the ordinary idle animation playing on the active root channel."
      (loop
        (when (!= (ja-group) (get-art-elem self))
          (ja-channel-push! 1 (seconds 0.05))
          (ja :group! assistant-lavatube-end-idle-ja))
        (ja-play :group! (ja-group) :num! (seek!) :frame-num 0.0))))

(defmethod should-display? ((this assistant-lavatube-end))
  "Display Keira only for reward speech or an invalid task stage, and hide her once the Green
   Sage rescue has reached need-hint."
  (first-any (-> this tasks) #t)
  (let ((status (current-status (-> this tasks))))
    (and (or (= status (task-status need-reward-speech)) (= status (task-status invalid)))
         (not (task-closed? (game-task citadel-sage-green) (task-status need-hint))))))

(defmethod init-from-entity! ((this assistant-lavatube-end) (entity entity-actor))
  "Initialize Keira as the Lava Tube task character, bind the village4-button task, and enter
   the initial taskable state."
  (init-as-taskable! this entity *assistant-lavatube-end-sg* 3 29 (new 'static 'vector :w 4096.0) 5)
  (set! (-> this tasks) (get-task-control (game-task village4-button)))
  (first-any (-> this tasks) #t)
  (goto-initial-state! this)
  (none))

;;-*-Lisp-*-
(in-package goal)
(bundles "CIT.DGO")
(require "levels/village2/sage-bluehut.gc")

;; TODO
(define-extern *robotboss-sg* skeleton-group)

(declare-type citb-sage process-taskable)

;; DECOMP BEGINS

(defskelgroup *citb-sagecage-sg*
  citb-sagecage
  citb-sagecage-lod0-jg
  citb-sagecage-redsage-idle-ja
  ((citb-sagecage-lod0-mg (meters 20)) (citb-sagecage-lod1-mg (meters 999999)))
  :bounds (static-spherem 0 -6 0 7))

(deftype citb-sagecage (process-drawable)
  "Animated energy cage surrounding one captive Sage. Its twelve bar emitters follow skeleton
joint 3, while the collision mesh switches independently between barred and open variants."
  ((root collide-shape-moving :override)
   (parent-override (pointer citb-sage) :overlay-at parent)
   (bar-array vector 12 :inline)
   (angle-offset float)
   (bars-on symbol)
   (cloning symbol))
  (:methods
   (init-collision! (_type_) none)
   (init-cage! (_type_) none))
  (:states
   citb-sagecage-idle))

(defbehavior citb-sagecage-draw-bars citb-sagecage ()
  "Orient the cage bars toward the camera and launch one bar particle at each of the twelve
   skeleton-relative emitter positions."
  (when (logtest? (-> self draw status) (draw-status was-drawn))
    (let ((joint-transform (-> self node-list data 3 bone transform))
          (bar-world (new 'stack-no-clear 'vector)))
      (let ((orientation (new 'stack-no-clear 'quaternion)))
        (let ((to-camera (new 'stack-no-clear 'vector)))
          (matrix->quaternion orientation joint-transform)
          (vector-! to-camera (camera-pos) (-> self root trans))
          (let ((joint-forward (-> joint-transform vector 2)))
            (set! (-> self angle-offset) (- (atan (-> joint-forward x) (-> joint-forward z)))))
          (quaternion-rotate-local-x! orientation orientation 16384.0)
          (let ((face-angle (+ (-> self angle-offset) (atan (-> to-camera x) (-> to-camera z)))))
            (quaternion-rotate-local-z! orientation orientation face-angle)))
        (quaternion-copy! *particle-quat* orientation))
      (let ((bar-particle (-> *part-id-table* 2473))
            (particle-system *sp-particle-system-3d*))
        (dotimes (i 12)
          (vector-matrix*! bar-world (-> self bar-array i) joint-transform)
          (launch-particles :system particle-system bar-particle bar-world)))))
  0
  (none))

(defbehavior citb-sagecage-update-collision citb-sagecage ()
  "Select the barred collision mesh while bars-on is true and the open mesh otherwise."
  (change-mesh (the-as collide-shape-prim-mesh (-> self root root-prim)) (if (-> self bars-on) 0 1))
  0
  (none))

(defstate citb-sagecage-idle (citb-sagecage)
  :event
    (behavior ((sender process) (argc int) (message symbol) (block event-message-block))
      "Enable or disable the visible bars and collision mesh, or start and stop copying the
            captive Sage's joint animation. Stopping a clone returns the cage to its idle animation."
      (local-vars (event-result object))
      (case message
        (('disable-bars)
         (stop! (-> self sound))
         (sound-play "sagecage-off")
         (set! (-> self bars-on) #f)
         (citb-sagecage-update-collision))
        (('enable-bars) (set! (-> self bars-on) #t) (citb-sagecage-update-collision))
        (('start-cloning) (set! event-result #t) (set! (-> self cloning) (the-as symbol event-result)) event-result)
        (('stop-cloning)
         (set! (-> self cloning) #f)
         (let ((root-channel (-> self skel root-channel 0)))
           (set! event-result citb-sagecage-idle-ja)
           (set! (-> root-channel frame-group) (the-as art-joint-anim event-result)))
         event-result)))
  :trans rider-trans
  :code
    (behavior ()
      "Copy and remap the captive Sage's joints while cloning; otherwise loop the cage animation."
      (loop
        (cond
          ((-> self cloning)
           (let ((parent-sage (ppointer->process (-> self parent-override))))
             (when parent-sage
               (joint-control-copy! (-> self skel) (-> (the-as citb-sage parent-sage) skel))
               (joint-control-remap! (-> self skel)
                                     (-> self draw art-group)
                                     (-> (the-as citb-sage parent-sage) draw art-group)
                                     '()
                                     0
                                     ""))))
          (else (ja :num! (loop!))))
        (suspend)))
  :post
    (behavior ()
      "Move attached riders, then update the cage hum and emit all twelve bars while enabled."
      (rider-post)
      (when (-> self bars-on)
        (update! (-> self sound))
        (citb-sagecage-draw-bars))))

(defmethod init-collision! ((this citb-sagecage))
  "Create the cage's moving, indestructible sticky collision sphere on skeleton transform 3,
   allocate one rider slot, and install it as the drawable root."
  (let ((moving-shape (new 'process 'collide-shape-moving this (collide-list-enum hit-by-player))))
    (set! (-> moving-shape dynam) (copy *standard-dynamics* 'process))
    (set! (-> moving-shape reaction) default-collision-reaction)
    (set! (-> moving-shape no-reaction)
          (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (alloc-riders moving-shape 1)
    (let ((cage-mesh (new 'process 'collide-shape-prim-mesh moving-shape (the-as uint 0) (the-as uint 0))))
      (set! (-> cage-mesh prim-core collide-as) (collide-kind ground-object))
      (set! (-> cage-mesh collide-with) (collide-kind target))
      (set! (-> cage-mesh prim-core action) (collide-action solid rider-plat-sticky))
      (set! (-> cage-mesh prim-core offense) (collide-offense indestructible))
      (set! (-> cage-mesh transform-index) 3)
      (set-vector! (-> cage-mesh local-sphere) 0.0 20480.0 0.0 28672.0)
      (set-root-prim! moving-shape cage-mesh))
    (set! (-> moving-shape nav-radius) (* 0.75 (-> moving-shape root-prim local-sphere w)))
    (backup-collide-with-as moving-shape)
    (set! (-> this root) moving-shape))
  0
  (none))

(defmethod init-cage! ((this citb-sagecage))
  "Initialize cage art, bar-emitter positions, ambient sound, task-dependent bar collision,
   and animation cloning from the captive Sage."
  (initialize-skeleton this *citb-sagecage-sg* '())
  (logior! (-> this skel status) (janim-status inited))
  (set! (-> this root pause-adjust-distance) 409600.0)
  (let ((bar-y 20766.72)
        (far-pos 14745.6)
        (far-neg -14745.6)
        (near-pos 7372.8))
    (let ((near-neg -7372.8))
      (set-vector! (-> this bar-array 0) far-pos bar-y near-neg 1.0)
      (set-vector! (-> this bar-array 1) far-pos bar-y 0.0 1.0)
      (set-vector! (-> this bar-array 2) far-pos bar-y near-pos 1.0)
      (set-vector! (-> this bar-array 3) far-neg bar-y near-neg 1.0)
      (set-vector! (-> this bar-array 4) far-neg bar-y 0.0 1.0)
      (set-vector! (-> this bar-array 5) far-neg bar-y near-pos 1.0)
      (set-vector! (-> this bar-array 6) near-neg bar-y far-pos 1.0)
      (set-vector! (-> this bar-array 7) 0.0 bar-y far-pos 1.0)
      (set-vector! (-> this bar-array 8) near-pos bar-y far-pos 1.0)
      (set-vector! (-> this bar-array 9) near-neg bar-y far-neg 1.0))
    (set-vector! (-> this bar-array 10) 0.0 bar-y far-neg 1.0)
    (set-vector! (-> this bar-array 11) near-pos bar-y far-neg 1.0))
  (set! (-> this sound) (new 'process 'ambient-sound (static-sound-spec "sagecage-gen" :fo-max 20) (-> this root trans)))
  (set! (-> this bars-on) (not (task-complete? *game-info* (-> this entity extra perm task))))
  (citb-sagecage-update-collision)
  (set! (-> this cloning) #t)
  (set! (-> this event-hook) (-> citb-sagecage-idle event))
  0
  (none))

(defbehavior citb-sagecage-init-by-other citb-sagecage ((parent-sage citb-sage))
  "Create a cage for parent-sage, copy its root transform, initialize cage art and collision, and
   enter the cloning idle state."
  (init-collision! self)
  (mem-copy! (the-as pointer (-> self root trans)) (the-as pointer (-> parent-sage root trans)) 16)
  (mem-copy! (the-as pointer (-> self root quat)) (the-as pointer (-> parent-sage root quat)) 16)
  (mem-copy! (the-as pointer (-> self root scale)) (the-as pointer (-> parent-sage root scale)) 16)
  (init-cage! self)
  (go citb-sagecage-idle)
  (none))

(defskelgroup *redsage-sg*
  redsage
  redsage-lod0-jg
  redsage-redsage-idle-ja
  ((redsage-lod0-mg (meters 20)) (redsage-lod1-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 3)
  :shadow redsage-shadow-mg)

(defskelgroup *bluesage-sg*
  bluesage
  bluesage-lod0-jg
  bluesage-bluesage-idle-ja
  ((bluesage-lod0-mg (meters 20)) (bluesage-lod1-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 4)
  :shadow bluesage-shadow-mg)

(defskelgroup *yellowsage-sg*
  yellowsage
  yellowsage-lod0-jg

(deftype citb-robotboss (process-drawable)
  "The shielded robot shell surrounding the Citadel lift. Its visible body is assembled from eight
   child manipulators; the parent owns the collision, looping shield particles, sound, and events."
  ((root collide-shape :override)
   (shield-on symbol))
  (:states
   citb-robotboss-die
   citb-robotboss-idle))

(defstate citb-robotboss-idle (citb-robotboss)
  :event
    (behavior ((sender process) (argc int) (message symbol) (block event-message-block))
      "Handle shield control, death, and shield-contact shove events."
      (the-as symbol
              (cond
                ((= message 'shield-off)
                 (stop! (-> self sound))
                 (if (-> self shield-on) (sound-play "robotcage-off"))
                 (set! (-> self shield-on) #f)
                 #f)
                ((= message 'shield-on) (let ((shield-enabled? #t)) (set! (-> self shield-on) shield-enabled?) shield-enabled?))
                ((= message 'die) (cleanup-for-death self) (the-as symbol (deactivate self)))
                ((or (= message 'touch) (= message 'attack))
                 (sound-play "shield-zap" :position (the-as symbol (target-pos 0)))
                 (the-as symbol
                         (send-event sender 'shove (-> block param 0) (static-attack-info ((shove-up (meters 2)) (shove-back (meters 3))))))))))
  :code
    (behavior ()
      "Assemble and draw the eight robot sections, then maintain the shield effect while
      enabled."
      (let ((nose-part (manipy-spawn (-> self root trans) (-> self entity) *citb-robotboss-nose-sg* #f :to self)))
        (send-event (ppointer->process nose-part) 'anim-mode 'loop)
        (send-event (ppointer->process nose-part) 'art-joint-anim "citb-robotboss-nose-idle" 0)
        (send-event (ppointer->process nose-part) 'draw #t))
      (let ((head-part (manipy-spawn (-> self root trans) (-> self entity) *citb-robotboss-head-sg* #f :to self)))
        (send-event (ppointer->process head-part) 'anim-mode 'loop)
        (send-event (ppointer->process head-part) 'art-joint-anim "citb-robotboss-head-idle" 0)
        (send-event (ppointer->process head-part) 'draw #t))
      (let ((gun-part (manipy-spawn (-> self root trans) (-> self entity) *citb-robotboss-gun-sg* #f :to self)))
        (send-event (ppointer->process gun-part) 'anim-mode 'loop)
        (send-event (ppointer->process gun-part) 'art-joint-anim "citb-robotboss-gun-idle" 0)
        (send-event (ppointer->process gun-part) 'draw #t))
      (let ((left-shoulder-part (manipy-spawn (-> self root trans) (-> self entity) *citb-robotboss-leftshoulder-sg* #f :to self)))
        (send-event (ppointer->process left-shoulder-part) 'anim-mode 'loop)
        (send-event (ppointer->process left-shoulder-part) 'art-joint-anim "citb-robotboss-leftshoulder-idle" 0)
        (send-event (ppointer->process left-shoulder-part) 'draw #t))
      (let ((right-shoulder-part (manipy-spawn (-> self root trans) (-> self entity) *citb-robotboss-rightshoulder-sg* #f :to self)))
        (send-event (ppointer->process right-shoulder-part) 'anim-mode 'loop)
        (send-event (ppointer->process right-shoulder-part) 'art-joint-anim "citb-robotboss-rightshoulder-idle" 0)
        (send-event (ppointer->process right-shoulder-part) 'draw #t))
      (let ((left-arm-part (manipy-spawn (-> self root trans) (-> self entity) *citb-robotboss-leftarm-sg* #f :to self)))
        (send-event (ppointer->process left-arm-part) 'anim-mode 'loop)
        (send-event (ppointer->process left-arm-part) 'art-joint-anim "citb-robotboss-leftarm-idle" 0)
        (send-event (ppointer->process left-arm-part) 'draw #t))
      (let ((right-arm-part (manipy-spawn (-> self root trans) (-> self entity) *citb-robotboss-rightarm-sg* #f :to self)))
        (send-event (ppointer->process right-arm-part) 'anim-mode 'loop)
        (send-event (ppointer->process right-arm-part) 'art-joint-anim "citb-robotboss-rightarm-idle" 0)
        (send-event (ppointer->process right-arm-part) 'draw #t))
      (let ((belly-part (manipy-spawn (-> self root trans) (-> self entity) *citb-robotboss-belly-sg* #f :to self)))
        (send-event (ppointer->process belly-part) 'anim-mode 'loop)
        (send-event (ppointer->process belly-part) 'art-joint-anim "citb-robotboss-belly-idle" 0)
        (send-event (ppointer->process belly-part) 'draw #t))
      (update-transforms! (-> self root))
      (loop
        (when (-> self shield-on)
          (update! (-> self sound))
          (spawn (-> self part) (-> self root trans))
          (set! (-> *palette-fade-controls* control 7 fade) 1.0))
        (suspend)))
  :post ja-post)

(defstate citb-robotboss-die (citb-robotboss)
  :code
    (behavior ()
      "Clean up the assembled robot and deactivate it."
      (cleanup-for-death self)
      (deactivate self)))

(defmethod init-from-entity! ((this citb-robotboss) (source-entity entity-actor))
  "Create the robot's indestructible shell collision, initialize its skeleton and shield
   effects, and remove it when the associated task is invalid; otherwise enter idle."
  (let ((collision-shape (new 'process 'collide-shape this (collide-list-enum hit-by-player))))
    (let ((mesh-primitive (new 'process 'collide-shape-prim-mesh collision-shape (the-as uint 0) (the-as uint 0))))
      (set! (-> mesh-primitive prim-core collide-as) (collide-kind ground-object))
      (set! (-> mesh-primitive collide-with) (collide-kind target))
      (set! (-> mesh-primitive prim-core action) (collide-action solid))
      (set! (-> mesh-primitive prim-core offense) (collide-offense indestructible))
      (set! (-> mesh-primitive transform-index) 3)
      (set-vector! (-> mesh-primitive local-sphere) 0.0 81920.0 0.0 143360.0)
      (set-root-prim! collision-shape mesh-primitive))
    (set! (-> collision-shape nav-radius) (* 0.75 (-> collision-shape root-prim local-sphere w)))
    (backup-collide-with-as collision-shape)
    (set! (-> this root) collision-shape))
  (process-drawable-from-entity! this source-entity)
  (initialize-skeleton this *citb-robotboss-sg* '())
  (set! (-> this part) (create-launch-control group-citb-robotboss-shield this))
  (logclear! (-> this mask) (process-mask actor-pause))
  (set! (-> this shield-on) #t)
  (set! (-> this sound) (new 'process 'ambient-sound (static-sound-spec "robotcage-lp" :fo-max 150) (-> this root trans)))
  (if (= (get-task-status (-> this entity extra perm task)) (task-status invalid))
    (go citb-robotboss-die)
    (go citb-robotboss-idle))
  (none))

(defskelgroup *citb-coil-sg*
  citb-coil
  citb-coil-lod0-jg
  citb-coil-idle-ja
  ((citb-coil-lod0-mg (meters 20)) (citb-coil-lod1-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 4))

(deftype citb-coil (process-drawable)
  "Breakable Citadel power coil. It loops a live glow, records completion when triggered, plays its
   break animation, then continually emits the powered-off effect from the dead coil."
  ((part-off sparticle-launch-control))
  (:states
   citb-coil-break
   citb-coil-broken
   citb-coil-idle))

(defmethod relocate ((this citb-coil) (offset int))
  "Relocate the powered-off particle controller when present, then relocate the drawable."
  (if (nonzero? (-> this part-off)) (&+! (-> this part-off) offset))
  (the-as citb-coil ((method-of-type process-drawable relocate) this offset)))

(defmethod deactivate ((this citb-coil))
  "Free powered-off particles when present, then deactivate the drawable."
  (if (nonzero? (-> this part-off)) (kill-and-free-particles (-> this part-off)))
  ((method-of-type process-drawable deactivate) this)
  (none))

(defstate citb-coil-idle (citb-coil)
  :event
    (behavior ((sender process) (argc int) (message symbol) (block event-message-block))
      "Begin breaking the coil when it receives a trigger."
      (case message
        (('trigger) (go citb-coil-break))))
  :code
    (behavior ()
      "Loop the current live animation until a trigger begins the break."
      (loop
        (ja-play :group! (ja-group) :num! (seek!) :frame-num 0.0)))
  :post
    (behavior ()
      "Emit the live coil glow and update its animation."
      (spawn (-> self part) (-> self root trans))
      (ja-post)))

(defstate citb-coil-break (citb-coil)
  :code
    (behavior ()
      "Persist completion, blend into the death animation, and enter the broken state."
      (process-entity-status! self (entity-perm-status complete) #t)
      (ja-channel-push! 1 (seconds 0.1))
      (ja-play :group! citb-coil-die-ja :num! (seek!) :frame-num 0.0)
      (go citb-coil-broken))
  :post ja-post)

(defstate citb-coil-broken (citb-coil)
  :code
    (behavior ()
      "Pose the dead coil, then continuously emit its powered-off particles."
      (ja-play :group! citb-coil-dead-ja :num! (seek!) :frame-num 0.0)
      (loop
        (spawn (-> self part-off) (-> self root trans))
        (suspend)))
  :post ja-post)

(defmethod init-from-entity! ((this citb-coil) (source-entity entity-actor))
  "Initialize the coil skeleton and live and powered-off particle controls, then enter the
   broken or live state selected by the linked state actor's completion bit."
  (set! (-> this root) (new 'process 'trsqv))
  (process-drawable-from-entity! this source-entity)
  (initialize-skeleton this *citb-coil-sg* '())
  (set! (-> this part) (create-launch-control group-citb-coil-glow this))
  (set! (-> this part-off) (create-launch-control group-citb-coil-off this))
  (let ((persistence-actor (entity-actor-lookup (-> this entity) 'state-actor 0)))
    (if (not persistence-actor) (set! persistence-actor (-> this entity)))
    (if (logtest? (-> persistence-actor extra perm status) (entity-perm-status complete))
      (go citb-coil-broken)
      (go citb-coil-idle)))
  (none))

(defskelgroup *citb-hose-sg*
  citb-hose
  citb-hose-lod0-jg
  citb-hose-idle-ja
  ((citb-hose-lod0-mg (meters 20)) (citb-hose-lod1-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 10))

(deftype citb-hose (process-drawable)
  "Animated Citadel hose that can spit on a spawn event and permanently collapse on a trigger."
  ()
  (:states
   citb-hose-die
   citb-hose-idle
   citb-hose-spawn))

(defbehavior citb-hose-event-handler citb-hose ((sender process) (argc int) (message symbol) (block event-message-block))
  "Send spawn events to the hose's spit state and trigger events to its permanent death state."
  (case message
    (('spawn) (go citb-hose-spawn))
    (('trigger) (go citb-hose-die))))

(defstate citb-hose-idle (citb-hose)
  :event citb-hose-event-handler
  :code
    (behavior ()
      "Loop the hose's idle animation while accepting spawn and trigger events."
      (loop
        (ja-play :group! citb-hose-idle-ja :num! (seek!) :frame-num 0.0)))
  :post ja-post)

(defstate citb-hose-spawn (citb-hose)
  :event citb-hose-event-handler
  :code
    (behavior ()
      "Blend into the hose spit animation once, then return to idle."
      (ja-channel-push! 1 (seconds 0.1))
      (ja-play :group! citb-hose-spit-ja :num! (seek!) :frame-num 0.0)
      (go citb-hose-idle))
  :post ja-post)

(defstate citb-hose-die (citb-hose)
  :event citb-hose-event-handler
  :code
    (behavior ()
      "Persist completion, play the death animation, then remain in its final pose."
      (process-entity-status! self (entity-perm-status complete) #t)
      (ja-channel-push! 1 (seconds 0.1))
      (ja-play :group! citb-hose-die-ja :num! (seek!) :frame-num 0.0)
      (anim-loop))
  :post ja-post)

(defmethod init-from-entity! ((this citb-hose) (source-entity entity-actor))
  "Initialize the hose transform and skeleton, then enter its dead or idle state according to
   the linked state actor's persistent completion bit."
  (set! (-> this root) (new 'process 'trsqv))
  (process-drawable-from-entity! this source-entity)
  (initialize-skeleton this *citb-hose-sg* '())
  (let ((persistence-actor (entity-actor-lookup (-> this entity) 'state-actor 0)))
    (if (not persistence-actor) (set! persistence-actor (-> this entity)))
    (if (logtest? (-> persistence-actor extra perm status) (entity-perm-status complete)) (go citb-hose-die) (go citb-hose-idle)))
  (none))

(deftype citb-chains (process-hidden) ())

(defskelgroup *citb-generator-sg*
  citb-generator
  citb-generator-lod0-jg
  citb-generator-idle-ja
  ((citb-generator-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 2))

(defskelgroup *citb-generator-broken-sg*
  citb-generator
  citb-generator-broken-lod0-jg
  citb-generator-idle-ja
  ((citb-generator-broken-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 2))

(deftype citb-generator (process-drawable)
  "Breakable Citadel generator. Four named generators carry an offset mushroom effect; every
   generator owns intact and broken looks, particles, collision, hints, persistence, linked actor
   activation, and an optional fuel-cell reward."
  ((root collide-shape :override)
   (normal-look lod-set :inline)
   (broken-look lod-set :inline)
   (mushroom-pos vector :inline)
   (mushroom symbol)
   (birth-fuel-cell symbol)
   (trigger-others symbol)
   (part-broken sparticle-launch-control)
   (part-mushroom sparticle-launch-control))
  (:methods
   (init! (_type_) none)
   (setup! (_type_) none))
  (:states
   citb-generator-break
   citb-generator-broken
   citb-generator-idle))

(defmethod relocate ((this citb-generator) (offset int))
  "Relocate both optional particle controllers, then relocate the drawable."
  (if (nonzero? (-> this part-broken)) (&+! (-> this part-broken) offset))
  (if (nonzero? (-> this part-mushroom)) (&+! (-> this part-mushroom) offset))
  (the-as citb-generator ((method-of-type process-drawable relocate) this offset)))

(defmethod deactivate ((this citb-generator))
  "Free particles from both optional controllers, then deactivate the drawable."
  (if (nonzero? (-> this part-broken)) (kill-and-free-particles (-> this part-broken)))
  (if (nonzero? (-> this part-mushroom)) (kill-and-free-particles (-> this part-mushroom)))
  ((method-of-type process-drawable deactivate) this)
  (none))

(defbehavior citb-generator-trigger-others citb-generator ()
  "Trigger every alt-actor, wait half a second outside movie playback, then trigger every
   trigger-actor. Birth a linked actor and retry its event when it is not already available."
  (let ((alt-actor-count (entity-actor-count (-> self entity) 'alt-actor)))
    (dotimes (alt-i alt-actor-count)
      (let ((alt-actor (entity-actor-lookup (-> self entity) 'alt-actor alt-i))
            (alt-event (new 'stack-no-clear 'event-message-block)))
        (set! (-> alt-event from) self)
        (set! (-> alt-event num-params) 0)
        (set! (-> alt-event message) 'trigger)
        (let ((send-alt-event send-event-function)
              (alt-actor-for-send alt-actor))
          (when (not (send-alt-event (if alt-actor-for-send (-> alt-actor-for-send extra process)) alt-event))
            (entity-birth-no-kill alt-actor)
            (suspend)
            (send-event (if alt-actor (-> alt-actor extra process)) 'trigger))))))
  (let ((delay-start (current-time)))
    (while (not (time-elapsed? delay-start (seconds 0.5)))
      (if (movie?) (set! delay-start (current-time)))
      (suspend)))
  (let ((trigger-actor-count (entity-actor-count (-> self entity) 'trigger-actor)))
    (dotimes (trigger-i trigger-actor-count)
      (let ((trigger-actor (entity-actor-lookup (-> self entity) 'trigger-actor trigger-i))
            (trigger-event (new 'stack-no-clear 'event-message-block)))
        (set! (-> trigger-event from) self)
        (set! (-> trigger-event num-params) 0)
        (set! (-> trigger-event message) 'trigger)
        (let ((send-trigger-event send-event-function)
              (trigger-actor-for-send trigger-actor))
          (when (not (send-trigger-event (if trigger-actor-for-send (-> trigger-actor-for-send extra process)) trigger-event))
            (entity-birth-no-kill trigger-actor)
            (suspend)
            (send-event (if trigger-actor (-> trigger-actor extra process)) 'trigger))))))
  0
  (none))

(defstate citb-generator-idle (citb-generator)
  :event
    (behavior ((sender process) (argc int) (message symbol) (block event-message-block))
      "Begin breaking on attack and acknowledge a trigger without changing state."
      (case message
        (('attack)
         (if (-> self mushroom)
           (increment-success-for-hint (text-id citadel-generator))
           (increment-success-for-hint (text-id citadel-generator-no-mushroom)))
         (go citb-generator-break))
        (('trigger) #t)))
  :exit
    (behavior ()
      "Stop the intact generator's ambient sound."
      (stop! (-> self sound)))
  :code
    (behavior ()
      "Maintain intact art, sound, particles, palette glow, and nearby hints until an attack
      begins the break."
      (lods-assign! (-> self draw) (-> self normal-look))
      (update-transforms! (-> self root))
      (loop
        (spawn (-> self part) (-> self root trans))
        (update! (-> self sound))
        (if (-> self mushroom) (spawn (-> self part-mushroom) (-> self mushroom-pos)))
        (if (not (-> self mushroom)) (+! (-> *palette-fade-controls* control 3 fade) 0.3333))
        (when (and *target* (>= 32768.0 (vector-vector-distance (-> self root trans) (-> *target* control trans))))
          (if (-> self mushroom)
            (level-hint-spawn (text-id citadel-generator) "sksp0381" (the-as entity #f) *entity-pool* (game-task none))
            (level-hint-spawn (text-id citadel-generator-no-mushroom) "sksp0384" (the-as entity #f) *entity-pool* (game-task none))))
        (suspend)))
  :post ja-post)

(defstate citb-generator-break (citb-generator)
  :code
    (behavior ()
      "Open linked actors, persist completion, launch the destruction effect, and enter the
      broken state."
      (let ((open-actor-count (entity-actor-count (-> self entity) 'open-actor)))
        (dotimes (open-i open-actor-count)
          (let ((open-actor (entity-actor-lookup (-> self entity) 'open-actor open-i))
                (open-event (new 'stack-no-clear 'event-message-block)))
            (set! (-> open-event from) self)
            (set! (-> open-event num-params) 0)
            (set! (-> open-event message) 'open)
            (let ((send-open-event send-event-function)
                  (open-actor-for-send open-actor))
              (when (not (send-open-event (if open-actor-for-send (-> open-actor-for-send extra process)) open-event))
                (entity-birth-no-kill open-actor)
                (suspend)
                (send-event (if open-actor (-> open-actor extra process)) 'open))))))
      (process-entity-status! self (entity-perm-status complete) #t)
      (process-spawn part-tracker
                     :init
                     part-tracker-init
                     group-citb-generator-break
                     -1
                     #f
                     #f
                     #f
                     (-> self root trans)
                     :to
                     *entity-pool*)
      (sound-play "sagecage-open")
      ;; og:preserve-this NTSC-J patch here
      ; (if (name= (-> self name) "citb-generator-1")
      ; (set-continue! *game-info* "citadel-elevator")
      ; )
      (go citb-generator-broken))
  :post ja-post)

(defstate citb-generator-broken (citb-generator)
  :code
    (behavior ()
      "Switch to broken art, award and await an optional fuel cell, trigger the two linked actor
      groups in sequence, and remain in the final pose."
      (lods-assign! (-> self draw) (-> self broken-look))
      (update-transforms! (-> self root))
      (cond
        ((-> self birth-fuel-cell)
         (process-drawable-birth-fuel-cell (the-as entity #f) (the-as vector #f) #t)
         (when (-> self child)
           (while (-> self child)
             (suspend))
           (citb-generator-trigger-others)))
        (else (citb-generator-trigger-others)))
      (anim-loop))
  :post
    (behavior ()
      "Emit the broken generator particles and update its animation."
      (spawn (-> self part-broken) (-> self root trans))
      (ja-post)))

(defmethod init! ((this citb-generator))
  "Create an indestructible one-metre spherical attack target centred one metre above the
   generator."
  (let ((collision-shape (new 'process 'collide-shape this (collide-list-enum hit-by-player))))
    (let ((sphere-primitive (new 'process 'collide-shape-prim-sphere collision-shape (the-as uint 0))))
      (set! (-> sphere-primitive prim-core collide-as) (collide-kind ground-object))
      (set! (-> sphere-primitive collide-with) (collide-kind target))
      (set! (-> sphere-primitive prim-core action) (collide-action solid))
      (set! (-> sphere-primitive prim-core offense) (collide-offense indestructible))
      (set-vector! (-> sphere-primitive local-sphere) 0.0 4096.0 0.0 4096.0)
      (set-root-prim! collision-shape sphere-primitive))
    (set! (-> collision-shape nav-radius) (* 0.75 (-> collision-shape root-prim local-sphere w)))
    (backup-collide-with-as collision-shape)
    (set! (-> this root) collision-shape))
  0
  (none))

(defmethod setup! ((this citb-generator))
  "Initialize intact and broken art, linked actors, fuel-cell eligibility, named mushroom
   placement, all particle controllers, and the generator's ambient sound."
  (initialize-skeleton this *citb-generator-sg* '())
  (setup-lods! (-> this normal-look) *citb-generator-sg* (-> this draw art-group) (-> this entity))
  (setup-lods! (-> this broken-look) *citb-generator-broken-sg* (-> this draw art-group) (-> this entity))
  (set! (-> this link) (new 'process 'actor-link-info this))
  (set! (-> this birth-fuel-cell) (< (the-as uint 1) (the-as uint (-> this entity extra perm task))))
  (set! (-> this trigger-others) #f)
  (set! (-> this mushroom-pos quad) (-> this root trans quad))
  (let ((mushroom-angle 0.0))
    (cond
      ((name= (-> this name) "citb-generator-1") (set! (-> this mushroom) #t) (set! mushroom-angle 21845.334))
      ((name= (-> this name) "citb-generator-2") (set! (-> this mushroom) #t) (set! mushroom-angle 16384.0))
      ((name= (-> this name) "citb-generator-3") (set! (-> this mushroom) #t) (set! mushroom-angle 16384.0))
      ((name= (-> this name) "citb-generator-4") (set! (-> this mushroom) #t) (set! mushroom-angle -5461.3335))
      (else (set! (-> this mushroom) #f)))
    (when (-> this mushroom)
      (+! (-> this mushroom-pos x) (* 19251.2 (sin mushroom-angle)))
      (+! (-> this mushroom-pos z) (* 19251.2 (cos mushroom-angle)))))
  (set! (-> this part) (create-launch-control group-citb-generator-on this))
  (set! (-> this part-broken) (create-launch-control group-citb-generator-off this))
  (set! (-> this part-mushroom) (create-launch-control group-citb-generator-mushroom-on this))
  (set! (-> this sound) (new 'process 'ambient-sound (static-sound-spec "mushroom-gen" :fo-max 20) (-> this root trans)))
  0
  (none))

(defmethod init-from-entity! ((this citb-generator) (source-entity entity-actor))
  "Create collision, initialize the placed drawable and generator setup, then enter the broken
   or intact state selected by the linked state actor's completion bit."
  (init! this)
  (process-drawable-from-entity! this source-entity)
  (setup! this)
  (let ((persistence-actor (entity-actor-lookup (-> this entity) 'state-actor 0)))
    (if (not persistence-actor) (set! persistence-actor (-> this entity)))
    (if (logtest? (-> persistence-actor extra perm status) (entity-perm-status complete))
      (go citb-generator-broken)
      (go citb-generator-idle)))
  (none))

(defskelgroup *citadelcam-sg*
  citadelcam
  citadelcam-lod0-jg
  citadelcam-idle-ja
  ((citadelcam-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 20))

(deftype citadelcam (process-drawable)
  "Controller for the Citadel staircase reveal. It waits for the blue, red, and yellow Sage tasks,
   triggers the stair actors, plays the reveal camera, and presents the staircase hint."
  ()
  (:states
   citadelcam-idle
   citadelcam-stair-plats))

(defstate citadelcam-idle (citadelcam)
  :event
    (behavior ((sender process) (argc int) (message symbol) (block event-message-block))
      "Begin the staircase reveal when a trigger arrives after the blue, red, and yellow Sage
      tasks are all complete."
      (case message
        (('trigger)
         (when (and (task-complete? *game-info* (game-task citadel-sage-blue))
                    (task-complete? *game-info* (game-task citadel-sage-red))
                    (task-complete? *game-info* (game-task citadel-sage-yellow)))
           (logclear! (-> self mask) (process-mask actor-pause))
           (go citadelcam-stair-plats)))))
  :code
    (behavior ()
      "Remain actor-paused while waiting for the staircase trigger."
      (logior! (-> self mask) (process-mask actor-pause))
      (anim-loop)))

(defstate citadelcam-stair-plats (citadelcam)
  :code
    (behavior ()
      "Trigger every linked stair actor, wait for the staircase camera to finish, show the
      platform hint, and return to the waiting state."
      (let ((trigger-actor-count (entity-actor-count (-> self entity) 'trigger-actor)))
        (dotimes (stair-i trigger-actor-count)
          (let ((trigger-actor (entity-actor-lookup (-> self entity) 'trigger-actor stair-i))
                (trigger-event (new 'stack-no-clear 'event-message-block)))
            (set! (-> trigger-event from) self)
            (set! (-> trigger-event num-params) 0)
            (set! (-> trigger-event message) 'trigger)
            (let ((send-trigger-event send-event-function)
                  (trigger-actor-for-send trigger-actor))
              (when (not (send-trigger-event (if trigger-actor-for-send (-> trigger-actor-for-send extra process)) trigger-event))
                (entity-birth-no-kill trigger-actor)
                (suspend)
                (send-event (if trigger-actor (-> trigger-actor extra process)) 'trigger))))))
      (let ((camera-handle (ppointer->handle (process-spawn pov-camera (-> self root trans) *citadelcam-sg* "citadelcam-stair-plats" 0 #f '() :to self))))
        (while (handle->process (the-as handle camera-handle))
          (suspend)))
      (level-hint-spawn (text-id citadel-plat) "sksp0387" (the-as entity #f) *entity-pool* (game-task none))
      (go citadelcam-idle)))

(defmethod init-from-entity! ((this citadelcam) (source-entity entity-actor))
  "Initialize the placed transform, allow trigger handling while actor-pause is active, and
   enter the waiting state."
  (set! (-> this root) (new 'process 'trsqv))
  (process-drawable-from-entity! this source-entity)
  (logclear! (-> this mask) (process-mask actor-pause))
  (go citadelcam-idle)
  (none))

(deftype citb-battlecontroller (battlecontroller)
  "Citadel enemy encounter variant with a thirty-five-metre activation radius and a bunny ambush
   introduction camera."
  ()
  (:state-methods
   battlecontroller-play-intro-camera
   battlecontroller-die))

(defstate battlecontroller-play-intro-camera (citb-battlecontroller)
  :virtual #t
  :code
    (behavior ()
      (level-hint-spawn (text-id citadel-battle) "sksp0383" (the-as entity #f) *entity-pool* (game-task none))
      (suspend)
      (let ((camera-handle (ppointer->handle (process-spawn pov-camera
                                                            (-> (entity-by-name "citadelcam-1") extra trans)
                                                            *citadelcam-sg*
                                                            "citadel-bunnies"
                                                            0
                                                            #f
                                                            '()
                                                            :to
                                                            self))))
        (send-event (handle->process (the-as handle camera-handle)) 'mask 2048)
        (while (handle->process (the-as handle camera-handle))
          (logclear! (-> *target* state-flags) (state-flags invulnerable))
          (suspend)))
      (go-virtual battlecontroller-active)))

(defstate battlecontroller-die (citb-battlecontroller)
  :virtual #t
  :code
    (behavior ()
      (process-entity-status! self (entity-perm-status complete) #t)
      (call-parent-state-handler code)))

(defmethod setup-paths-and-params! ((this citb-battlecontroller))
  "Apply the shared encounter resource setup and use a thirty-five-metre activation distance."
  (call-parent-method this)
  (set! (-> this activate-distance) 143360.0)
  0
  (none))

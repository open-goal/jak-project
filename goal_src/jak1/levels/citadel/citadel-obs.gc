  (none))

(deftype citb-iris-door (eco-door)
  "Citadel iris door with a four-metre wall collision mesh and automatic distance-based closing."
  ())

(defskelgroup *citb-iris-door-sg*
  citb-iris-door
  citb-iris-door-lod0-jg
  citb-iris-door-idle-ja
  ((citb-iris-door-lod0-mg (meters 20)) (citb-iris-door-lod1-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 8))

(defmethod setup-collision! ((this citb-iris-door))
  "Create the indestructible wall mesh on skeleton transform 0 with a four-metre collision
   sphere and install it as the door root."
  (let ((collision-shape (new 'process 'collide-shape this (collide-list-enum hit-by-others))))
    (let ((mesh-primitive (new 'process 'collide-shape-prim-mesh collision-shape (the-as uint 0) (the-as uint 0))))
      (set! (-> mesh-primitive prim-core collide-as) (collide-kind wall-object))
      (set! (-> mesh-primitive collide-with) (collide-kind target))
      (set! (-> mesh-primitive prim-core action) (collide-action solid))
      (set! (-> mesh-primitive prim-core offense) (collide-offense indestructible))
      (set! (-> mesh-primitive transform-index) 0)
      (set-vector! (-> mesh-primitive local-sphere) 0.0 0.0 0.0 16384.0)
      (set-root-prim! collision-shape mesh-primitive))
    (set! (-> collision-shape nav-radius) (* 0.75 (-> collision-shape root-prim local-sphere w)))
    (backup-collide-with-as collision-shape)
    (set! (-> this root) collision-shape))
  0
  (none))

(defmethod setup-skel-and-params! ((this citb-iris-door))
  "Initialize the iris skeleton, open within eight metres, close beyond twelve metres, enable
   automatic closing, and keep permanent entity state synchronized."
  (initialize-skeleton this *citb-iris-door-sg* '())
  (set! (-> this open-distance) 32768.0)
  (set! (-> this close-distance) 49152.0)
  (set! (-> this auto-close) #t)
  (process-entity-status! this (entity-perm-status complete) #t)
  (update-transforms! (-> this root))
  0
  (none))

(defskelgroup *citb-button-sg*
  citb-button
  citb-button-lod0-jg
  citb-button-idle-ja
  ((citb-button-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 3))

(deftype citb-button (basebutton)
  "Citadel floor button with a three-metre mesh contact surface and a posed up or down skeleton."
  ())

(defmethod setup-collision! ((this citb-button))
  "Create the button's indestructible moving mesh on skeleton transform 3 with a three-metre
   collision sphere and install it as the root."
  (let ((moving-shape (new 'process 'collide-shape-moving this (collide-list-enum hit-by-player))))
    (set! (-> moving-shape dynam) (copy *standard-dynamics* 'process))
    (set! (-> moving-shape reaction) default-collision-reaction)
    (set! (-> moving-shape no-reaction)
          (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (let ((mesh-primitive (new 'process 'collide-shape-prim-mesh moving-shape (the-as uint 0) (the-as uint 0))))
      (set! (-> mesh-primitive prim-core collide-as) (collide-kind ground-object))
      (set! (-> mesh-primitive collide-with) (collide-kind target))
      (set! (-> mesh-primitive prim-core action) (collide-action solid))
      (set! (-> mesh-primitive prim-core offense) (collide-offense indestructible))
      (set! (-> mesh-primitive transform-index) 3)
      (set-vector! (-> mesh-primitive local-sphere) 0.0 0.0 0.0 12288.0)
      (set-root-prim! moving-shape mesh-primitive))
    (set! (-> moving-shape nav-radius) (* 0.75 (-> moving-shape root-prim local-sphere w)))
    (backup-collide-with-as moving-shape)
    (set! (-> this root) moving-shape))
  (the-as collide-shape-moving 0))

(defmethod setup-skel-and-anim! ((this citb-button))
  "Initialize the button skeleton and pose its first animation channel at the final frame when
   down or the first frame when up, then configure its speed and timeout."
  (local-vars (anim-channel joint-control-channel))
  (initialize-skeleton this *citb-button-sg* '())
  (logior! (-> this skel status) (janim-status inited))
  (ja-channel-set! 1)
  (cond
    ((-> this down?)
     (set! anim-channel (-> this skel root-channel 0))
     (joint-control-channel-group-eval! anim-channel
                                        (the-as art-joint-anim (-> this draw art-group data 2))
                                        num-func-identity)
     (set! (-> anim-channel frame-num)
           (the float (+ (-> (the-as art-joint-anim (-> this draw art-group data 2)) data 0 length) -1))))
    (else
     (set! anim-channel (-> this skel root-channel 0))
     (joint-control-channel-group-eval! anim-channel
                                        (the-as art-joint-anim (-> this draw art-group data 2))
                                        num-func-identity)
     (set! (-> anim-channel frame-num) 0.0)))
  (set! (-> this anim-speed) 2.0)
  (set! (-> this timeout) 1.0)
  (update-transforms! (-> this root))
  (ja-post)
  (none))

(deftype citb-launcher (plat)
  "Citadel launch platform paired with a spring launcher child. While the platform follows a path,
   it forwards its base transform to that launcher."
  ((launcher (pointer launcher))))

(defstate plat-path-active (citb-launcher)
  :virtual #t
  :post
    (behavior ()
      (let ((parent-post (-> (method-of-type plat plat-path-active) post)))
        (if parent-post ((the-as (function none :behavior citb-launcher) parent-post))))
      (send-event (ppointer->process (-> self launcher)) 'trans (-> self basetrans))))

(defskelgroup *citb-launcher-sg*
  citb-launcher
  citb-launcher-lod0-jg
  citb-launcher-idle-ja
  ((citb-launcher-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 4))

(defmethod get-unlit-skel ((this citb-launcher))
  "Return the Citadel launcher platform skeleton."
  *citb-launcher-sg*)

(defmethod configure-options! ((this citb-launcher))
  "Spawn the paired spring launcher from the resource spring-height and mode, narrow the
   platform collision sphere to 4.5 metres, and keep it moving while actors are paused."
  (let ((spring-height (res-lump-float (-> this entity) 'spring-height :default 163840.0))
        (spring-mode (res-lump-value (-> this entity) 'mode uint128)))
    (set! (-> this launcher) (process-spawn launcher (-> this root trans) spring-height spring-mode 81920.0 :to this)))
  (set! (-> this root root-prim local-sphere w) 18432.0)
  (logclear! (-> this mask) (process-mask actor-pause))
  0
  (none))


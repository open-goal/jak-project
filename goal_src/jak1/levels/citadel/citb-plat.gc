  (none))

(defskelgroup *citb-stopbox-sg*
  citb-stopbox
  citb-stopbox-lod0-jg
  citb-stopbox-idle-ja
  ((citb-stopbox-lod0-mg (meters 20)) (citb-stopbox-lod1-mg (meters 999999)))
  :bounds (static-spherem 0 -2 0 5.5))

(deftype citb-stopbox (plat)
  "Citadel path platform that always wraps its phase rather than mirroring at the path ends."
  ()
  (:methods
   (plat-path-active () _type_ :state :replace)))

(defstate plat-path-active (citb-stopbox)
  :virtual #t
  :trans
    (behavior ()
      "Evaluate the wrapping path phase, play the hover sound while within twenty metres of the
      listener, and move attached riders."
      (set! (-> self path-pos) (get-current-phase (-> self sync)))
      (eval-path-curve! (-> self path) (-> self basetrans) (-> self path-pos) 'interp)
      (if (< (vector-vector-distance (-> self root trans) (ear-trans)) 81920.0)
        (sound-play "eco-plat-hover" :id (-> self sound-id) :position (the-as symbol (-> self root trans))))
      (plat-trans)))

(defmethod get-unlit-skel ((this citb-stopbox))
  "Return the Citadel stop-box skeleton."
  *citb-stopbox-sg*)

(defmethod setup-collision! ((this citb-stopbox))
  "Create one indestructible sticky rider platform on skeleton transform 0, centred two metres
   below the origin with a 5.5-metre collision sphere."
  (let ((moving-shape (new 'process 'collide-shape-moving this (collide-list-enum hit-by-others))))
    (set! (-> moving-shape dynam) (copy *standard-dynamics* 'process))
    (set! (-> moving-shape reaction) default-collision-reaction)
    (set! (-> moving-shape no-reaction)
          (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (alloc-riders moving-shape 1)
    (let ((mesh-primitive (new 'process 'collide-shape-prim-mesh moving-shape (the-as uint 0) (the-as uint 0))))
      (set! (-> mesh-primitive prim-core collide-as) (collide-kind ground-object))
      (set! (-> mesh-primitive collide-with) (collide-kind target))
      (set! (-> mesh-primitive prim-core action) (collide-action solid rider-plat-sticky rider-plat))
      (set! (-> mesh-primitive prim-core offense) (collide-offense indestructible))
      (set! (-> mesh-primitive transform-index) 0)
      (set-vector! (-> mesh-primitive local-sphere) 0.0 -8192.0 0.0 22528.0)
      (set-root-prim! moving-shape mesh-primitive))
    (set! (-> moving-shape nav-radius) (* 0.75 (-> moving-shape root-prim local-sphere w)))
    (backup-collide-with-as moving-shape)
    (set! (-> this root) moving-shape))
  0
  (none))

(defmethod configure-options! ((this citb-stopbox))
  "Force wrapping path phase and keep the platform active during actor pause."
  (logior! (-> this fact options) (fact-options wrap-phase))
  (logclear! (-> this mask) (process-mask actor-pause))
  0
  (none))

(deftype citb-firehose (process-drawable)
  "Periodic Citadel flame jet. It wakes within seventy metres, blasts whenever its synchronized
   three-second phase wraps, and exposes three attack spheres only during the flame animation."
  ((root collide-shape :override)
   (idle-distance float)
   (sync sync-info :inline)
   (last-sync float)
   (blast-pos vector :inline))
  (:states
   citb-firehose-active
   citb-firehose-blast
   citb-firehose-idle))

(defskelgroup *citb-firehose-sg*
  citb-firehose
  citb-firehose-lod0-jg
  citb-firehose-idle-ja
  ((citb-firehose-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 3 0 15))

(defstate citb-firehose-idle (citb-firehose)
  :trans
    (behavior ()
      "Begin tracking the synchronized phase when Jak comes within seventy metres."
      (if (and *target* (>= (-> self idle-distance) (vector-vector-distance (-> self root trans) (-> *target* control trans))))
        (go citb-firehose-active)))
  :code
    (behavior ()
      "Sleep while the flame jet is out of range."
      (loop
        (suspend)))
  :post ja-post)

(defstate citb-firehose-active (citb-firehose)
  :trans
    (behavior ()
      "Return to idle outside seventy-two metres; otherwise start a blast whenever the
      synchronized phase wraps."
      (if (or (not *target*)
              (< (+ 8192.0 (-> self idle-distance)) (vector-vector-distance (-> self root trans) (-> *target* control trans))))
        (go citb-firehose-idle))
      (let ((phase (get-current-phase (-> self sync)))
            (previous-phase (-> self last-sync)))
        (set! (-> self last-sync) phase)
        (if (< phase previous-phase) (go citb-firehose-blast))))
  :code
    (behavior ()
      "Sleep between synchronized blasts."
      (loop
        (suspend)))
  :post ja-post)

(defbehavior citb-firehose-blast-particles citb-firehose ()
  "Emit sixteen flame particles across a half-circle fan at blast-pos, then emit the attached smoke
   group there."
  (let ((orientation (new 'stack-no-clear 'quaternion)))
    (quaternion-identity! orientation)
    (quaternion-rotate-local-x! orientation orientation -16384.0)
    (dotimes (i 16)
      (quaternion-rotate-local-z! orientation orientation 2048.0)
      (quaternion-copy! *particle-quat* orientation)
      (launch-particles :system *sp-particle-system-3d* (-> *part-id-table* 2541) (-> self blast-pos))))
  (spawn (-> self part) (-> self blast-pos)))

(defstate citb-firehose-blast (citb-firehose)
  :event
    (behavior ((sender process) (argc int) (message symbol) (block event-message-block))
      "Convert a touch from an enabled attack sphere into a damaging attack that shoves the
      target six metres back and three metres up."
      (case message
        (('touch)
         (send-event sender
                     'attack
                     (-> block param 0)
                     (static-attack-info ((mode 'damage) (shove-back (meters 6)) (shove-up (meters 3))))))))
  :code
    (behavior ()
      "Play the opening animation, enable attack collision, emit two looping flame passes from
      skeleton node 5, disable attacks, and play the closing animation before resuming phase
      tracking."
      (ja-play :group! citb-firehose-start-ja :num! (seek!) :frame-num 0.0)
      (ja-channel-push! 1 (seconds 0.1))
      (restore-collide-with-as (-> self root))
      (sound-play "eco-torch" :position (the-as symbol (-> self blast-pos)))
      (dotimes (i 2)
        (ja-play :group!
                 citb-firehose-loopflame-ja
                 :num! (seek!)
                 :frame-num 0.0
                 (set! (-> self blast-pos quad) (-> self node-list data 5 bone transform vector 3 quad))
                 (citb-firehose-blast-particles)))
      (clear-collide-with-as (-> self root))
      (ja-channel-push! 1 (seconds 0.1))
      (ja-play :group! citb-firehose-end-ja :num! (seek!) :frame-num 0.0)
      (go citb-firehose-active))
  :post transform-post)

(defmethod init-from-entity! ((this citb-firehose) (source-entity entity-actor))
  "Create the flame collision volume and three attack spheres, initialize drawable and
   skeleton state, configure a three-second synchronized phase and seventy-metre activation
   radius, create smoke particles, disable attacks, and enter idle."
  (let ((collision-shape (new 'process 'collide-shape this (collide-list-enum hit-by-player))))
    (let ((attack-group (new 'process 'collide-shape-prim-group collision-shape (the-as uint 3) 0)))
      (set! (-> attack-group prim-core collide-as) (collide-kind enemy))
      (set! (-> attack-group collide-with) (collide-kind target))
      (set! (-> attack-group prim-core action) (collide-action solid))
      (set-vector! (-> attack-group local-sphere) 0.0 -61440.0 0.0 36864.0)
      (set-root-prim! collision-shape attack-group)
      (let ((near-sphere (new 'process 'collide-shape-prim-sphere collision-shape (the-as uint 0))))
        (set! (-> near-sphere prim-core collide-as) (collide-kind enemy))
        (set! (-> near-sphere collide-with) (collide-kind target))
        (set! (-> near-sphere prim-core offense) (collide-offense normal-attack))
        (set-vector! (-> near-sphere local-sphere) 0.0 -49152.0 0.0 12288.0)
        (append-prim attack-group near-sphere))
      (let ((middle-sphere (new 'process 'collide-shape-prim-sphere collision-shape (the-as uint 0))))
        (set! (-> middle-sphere prim-core collide-as) (collide-kind enemy))
        (set! (-> middle-sphere collide-with) (collide-kind target))
        (set! (-> middle-sphere prim-core offense) (collide-offense normal-attack))
        (set-vector! (-> middle-sphere local-sphere) 0.0 -61440.0 0.0 14336.0)
        (append-prim attack-group middle-sphere))
      (let ((far-sphere (new 'process 'collide-shape-prim-sphere collision-shape (the-as uint 0))))
        (set! (-> far-sphere prim-core collide-as) (collide-kind enemy))
        (set! (-> far-sphere collide-with) (collide-kind target))
        (set! (-> far-sphere prim-core offense) (collide-offense normal-attack))
        (set-vector! (-> far-sphere local-sphere) 0.0 -73728.0 0.0 16384.0)
        (append-prim attack-group far-sphere)))
    (set! (-> collision-shape nav-radius) (* 0.75 (-> collision-shape root-prim local-sphere w)))
    (backup-collide-with-as collision-shape)
    (set! (-> this root) collision-shape))
  (process-drawable-from-entity! this source-entity)
  (initialize-skeleton this *citb-firehose-sg* '())
  (load-params! (-> this sync) this (the-as uint 900) 0.0 0.15 0.15)
  (set! (-> this idle-distance) 286720.0)
  (set! (-> this part) (create-launch-control group-firehose-blast-smoke this))
  (clear-collide-with-as (-> this root))
  (go citb-firehose-idle)
  (none))

(defskelgroup *citb-exit-plat-sg*
  citb-exit-plat
  citb-exit-plat-lod0-jg
  citb-exit-plat-idle-ja
  ((citb-exit-plat-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 30))

(deftype citb-exit-plat (plat-button)
  "Persistent Citadel exit elevator. Before activation it waits hidden seventy metres below its
   path endpoint; a trigger raises it over two seconds, after which it behaves as a platform
   button and carries Jak while constraining him to a thirty-metre radius."
  ((idle-height float)
   (rise-height float)
   (activated symbol))
  (:methods
   (plat-button-move-downward () _type_ :state :replace)
   (plat-button-move-upward () _type_ :state :replace))
  (:states
   citb-exit-plat-idle
   citb-exit-plat-rise))

(defstate citb-exit-plat-idle (citb-exit-plat)
  :event
    (behavior ((sender process) (argc int) (message symbol) (block event-message-block))
      "On trigger, record local progress and begin rising."
      (case message
        (('trigger)
         (let ((permanent-state (-> self entity extra perm)))
           (logior! (-> permanent-state status) (entity-perm-status user-set-from-cstage))
           (set! (-> permanent-state user-int8 0) 1))
         (go citb-exit-plat-rise))))
  :code
    (behavior ()
      "Wait hidden with collision disabled."
      (logior! (-> self draw status) (draw-status hidden))
      (clear-collide-with-as (-> self root))
      (loop
        (suspend))))

(defstate citb-exit-plat-rise (citb-exit-plat)
  :trans rider-trans
  :code
    (behavior ()
      "Reveal collision and rise from the hidden height to the endpoint over two seconds with an
      ease-out curve, then enter the ordinary platform-button idle state."
      (logclear! (-> self draw status) (draw-status hidden))
      (restore-collide-with-as (-> self root))
      (set-time! (-> self state-time))
      (loop
        (let ((remaining-rise (- 1.0 (* 0.0016666667 (the float (- (current-time) (-> self state-time)))))))
          (when (< remaining-rise 0.0)
            (set! (-> self root trans y) (-> self rise-height))
            (go-virtual plat-button-idle))
          (set! (-> self root trans y) (lerp (-> self rise-height) (-> self idle-height) (square remaining-rise))))
        (suspend)))
  :post rider-post)

(defbehavior citb-exit-plat-move-player citb-exit-plat ((previous-position vector))
  "Move Jak by the platform displacement since previous-position. When his planar offset from the
   new platform centre exceeds thirty metres, also pull him back to that radius, then reset his
   height tracking."
  (let ((platform-displacement (new 'stack-no-clear 'vector)))
    (let ((player-offset (new 'stack-no-clear 'vector)))
      (vector-! platform-displacement (-> self root trans) previous-position)
      (vector-! player-offset (-> *target* control trans) (-> self root trans))
      (set! (-> player-offset y) 0.0)
      (let ((player-distance (vector-length player-offset)))
        (when (< 122880.0 player-distance)
          (vector-normalize! player-offset 1.0)
          (vector+*! platform-displacement platform-displacement player-offset (- 122880.0 player-distance)))))
    (move-by-vector! (-> *target* control) platform-displacement))
  (send-event *target* 'reset-height)
  0
  (none))

(defstate plat-button-move-downward (citb-exit-plat)
  :virtual #t
  :trans
    (behavior ()
      "Run the parent movement transition, then apply the platform displacement and radial
      correction to Jak."
      (let ((previous-position (new 'stack-no-clear 'vector)))
        (vector-copy! previous-position (-> self root trans))
        (let ((parent-transition (-> (the-as (state plat-button) (find-parent-state)) trans)))
          (if parent-transition (parent-transition)))
        (citb-exit-plat-move-player previous-position)))
  :post transform-post)

(defstate plat-button-move-upward (citb-exit-plat)
  :virtual #t
  :trans
    (behavior ()
      "Run the parent movement transition, then apply the platform displacement and radial
      correction to Jak."
      (let ((previous-position (new 'stack-no-clear 'vector)))
        (vector-copy! previous-position (-> self root trans))
        (let ((parent-transition (-> (the-as (state plat-button) (find-parent-state)) trans)))
          (if parent-transition (parent-transition)))
        (citb-exit-plat-move-player previous-position)))
  :post transform-post)

(defmethod can-activate? ((this citb-exit-plat))
  "Allow the exit platform to activate whenever no movie is playing."
  (not (movie?)))

(defmethod setup-skeleton! ((this citb-exit-plat))
  "Initialize the Citadel exit-platform skeleton."
  (initialize-skeleton this *citb-exit-plat-sg* '())
  (none))

(defmethod go-initial-state! ((this citb-exit-plat))
  "Enter the ordinary raised platform-button idle state when already activated; otherwise wait
   hidden below the endpoint."
  (if (-> this activated) (go (method-of-object this plat-button-idle)) (go citb-exit-plat-idle))
  0
  (none))

(defmethod setup-collision! ((this citb-exit-plat))
  "Create a thirty-metre moving collision group with one rider slot and two indestructible
   sticky meshes on skeleton transforms 4 and 3, then install it as root."
  (let ((moving-shape (new 'process 'collide-shape-moving this (collide-list-enum hit-by-others))))
    (set! (-> moving-shape dynam) (copy *standard-dynamics* 'process))
    (set! (-> moving-shape reaction) default-collision-reaction)
    (set! (-> moving-shape no-reaction)
          (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (alloc-riders moving-shape 1)
    (let ((primitive-group (new 'process 'collide-shape-prim-group moving-shape (the-as uint 2) 0)))
      (set! (-> primitive-group prim-core collide-as) (collide-kind ground-object))
      (set! (-> primitive-group collide-with) (collide-kind target))
      (set! (-> primitive-group prim-core action) (collide-action solid rider-plat-sticky))
      (set! (-> primitive-group transform-index) 0)
      (set-vector! (-> primitive-group local-sphere) 0.0 0.0 0.0 122880.0)
      (set-root-prim! moving-shape primitive-group)
      (let ((button-mesh (new 'process 'collide-shape-prim-mesh moving-shape (the-as uint 0) (the-as uint 1))))
        (set! (-> button-mesh prim-core collide-as) (collide-kind ground-object))
        (set! (-> button-mesh collide-with) (collide-kind target))
        (set! (-> button-mesh prim-core action) (collide-action solid rider-plat-sticky))
        (set! (-> button-mesh prim-core offense) (collide-offense indestructible))
        (set! (-> button-mesh transform-index) 4)
        (set-vector! (-> button-mesh local-sphere) 0.0 -2867.2 0.0 7372.8)
        (append-prim primitive-group button-mesh))
      (let ((platform-mesh (new 'process 'collide-shape-prim-mesh moving-shape (the-as uint 1) (the-as uint 2))))
        (set! (-> platform-mesh prim-core collide-as) (collide-kind ground-object))
        (set! (-> platform-mesh collide-with) (collide-kind target))
        (set! (-> platform-mesh prim-core action) (collide-action solid rider-plat-sticky))
        (set! (-> platform-mesh prim-core offense) (collide-offense indestructible))
        (set! (-> platform-mesh transform-index) 3)
        (set-vector! (-> platform-mesh local-sphere) 0.0 0.0 0.0 122880.0)
        (append-prim primitive-group platform-mesh)))
    (set! (-> moving-shape nav-radius) (* 0.75 (-> moving-shape root-prim local-sphere w)))
    (backup-collide-with-as moving-shape)
    (set! (-> this root) moving-shape)
    moving-shape))

(defmethod configure-movement! ((this citb-exit-plat))
  "Force birth and prevent distance culling, read activation from the linked state actor,
   choose and evaluate the proper path endpoint, and place an inactive platform seventy metres
   below it. A finalboss continue starts the platform raised and records its local progress."
  (process-entity-status! this (entity-perm-status force-birth) #t)
  (logclear! (-> this mask) (process-mask actor-pause))
  (set! (-> this draw light-index) (the-as uint 255))
  (let ((state-actor (entity-actor-lookup (-> this entity) 'state-actor 0)))
    (set! (-> this activated) (logtest? (-> state-actor extra perm status) (entity-perm-status complete))))
  (cond
    ((= (-> *game-info* current-continue level) 'finalboss)
     (let ((permanent-state (-> this entity extra perm)))
       (logior! (-> permanent-state status) (entity-perm-status user-set-from-cstage))
       (set! (-> permanent-state user-int8 0) 1))
     (set! (-> this activated) #t)
     (set! (-> this path-pos) 0.0))
    (else (set! (-> this path-pos) 1.0)))
  (let ((platform-position (-> this root trans)))
    (eval-path-curve! (-> this path) platform-position (-> this path-pos) 'interp)
    (vector+! platform-position platform-position (-> this trans-off)))
  (set! (-> this rise-height) (-> this root trans y))
  (set! (-> this idle-height) (+ -286720.0 (-> this rise-height)))
  (if (-> this activated)
    (set! (-> this root trans y) (-> this rise-height))
    (set! (-> this root trans y) (-> this idle-height)))
  (set! (-> this allow-auto-kill) #f)
  (process-entity-status! this (entity-perm-status no-kill) #t)
  0
  (none))

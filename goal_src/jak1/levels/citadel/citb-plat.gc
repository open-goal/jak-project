  (:methods
   (citb-base-plat-active () _type_ :state :replace)))

(defstate citb-base-plat-active (citb-donut)
  :virtual #t
  :post
    (behavior ()
      "Update the rotation sound, rotate the root about Y from the synchronized phase, and update
      attached riders."
      (update! (-> self sound))
      (quaternion-axis-angle! (-> self root quat) 0.0 1.0 0.0 (* 65536.0 (get-current-phase (-> self sync))))
      (rider-post)))

(defmethod setup-collision! ((this citb-donut))
  "Create one indestructible sticky ground mesh on skeleton transform 0 with a ten-metre
   collision sphere and one rider slot."
  (let ((moving-shape (new 'process 'collide-shape-moving this (collide-list-enum hit-by-others))))
    (set! (-> moving-shape dynam) (copy *standard-dynamics* 'process))
    (set! (-> moving-shape reaction) default-collision-reaction)
    (set! (-> moving-shape no-reaction)
          (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (alloc-riders moving-shape 1)
    (let ((mesh-primitive (new 'process 'collide-shape-prim-mesh moving-shape (the-as uint 0) (the-as uint 0))))
      (set! (-> mesh-primitive prim-core collide-as) (collide-kind ground-object))
      (set! (-> mesh-primitive collide-with) (collide-kind target))
      (set! (-> mesh-primitive prim-core action) (collide-action solid rider-plat-sticky))
      (set! (-> mesh-primitive prim-core offense) (collide-offense indestructible))
      (set! (-> mesh-primitive transform-index) 0)
      (set-vector! (-> mesh-primitive local-sphere) 0.0 0.0 0.0 40960.0)
      (set-root-prim! moving-shape mesh-primitive))
    (set! (-> moving-shape nav-radius) (* 0.75 (-> moving-shape root-prim local-sphere w)))
    (backup-collide-with-as moving-shape)
    (set! (-> this root) moving-shape))
  0
  (none))

(defmethod setup-skeleton! ((this citb-donut))
  "Initialize the ring skeleton, configure its synchronized phase, create the rotation sound,
   and keep it active during actor pause."
  (initialize-skeleton this *citb-donut-sg* '())
  (setup-params! (-> this sync) (the-as uint 9000) 0.0 0.15 0.15)
  (set! (-> this sound) (new 'process 'ambient-sound (static-sound-spec "rotate-plat" :fo-max 20) (-> this root trans)))
  (logclear! (-> this mask) (process-mask actor-pause))

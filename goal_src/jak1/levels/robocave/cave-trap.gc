;;-*-Lisp-*-
(in-package goal)
(bundles "ROB.DGO")
(require "levels/maincave/baby-spider.gc")
(declare-type spider-egg process-drawable)

;; DECOMP BEGINS

(deftype cave-trap (process-drawable)
  ((root            collide-shape :override)
   (spider-count    int32)
   (alt-actors      (array entity-actor))
   (spawn-delay     time-frame)
   (last-spawn-time time-frame)
   (debug-targ-pos  vector :inline))
  (:methods
   (try-spawn-baby-spider (_type_) symbol))
  (:states
   cave-trap-active
   cave-trap-give-up
   cave-trap-idle))

(deftype spider-vent (process-drawable)
  ((last-spawn-time time-frame))
  (:states
   spider-vent-idle))

(defstate spider-vent-idle (spider-vent)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (local-vars (v0-0 object))
      (case message
        (('can-spawn?) (return (time-elapsed? (-> self last-spawn-time) (seconds 1))) v0-0)
        (('notify-spawned) (set! v0-0 (current-time)) (set! (-> self last-spawn-time) (the-as time-frame v0-0)) v0-0)))
  :code
    (behavior ()
      (logior! (-> self mask) (process-mask sleep-code))
      (suspend)
      0))

(defmethod init-from-entity! ((this spider-vent) (source-entity entity-actor))
  "Initialize this spider vent and begin accepting spawn queries."
  (set! (-> this last-spawn-time) 0)
  (set! (-> this root) (new 'process 'trsqv))
  (process-drawable-from-entity! this source-entity)
  (go spider-vent-idle)
  (none))

(defbehavior cave-trap-default-event-handler cave-trap ((sender process) (argc int) (message symbol) (event-block event-message-block))
  "Track spawned spiders and activate the trap when a spider egg reports a notification."
  (case message
    (('untrigger)
     (when (= (-> sender type) baby-spider)
       (let ((v0-0 (the-as object (max 0 (+ (-> self spider-count) -1)))))
         (set! (-> self spider-count) (the-as int v0-0))
         v0-0)))
    (('notify) (if (and (= (-> sender type) spider-egg) (= (-> self next-state name) 'cave-trap-idle)) (go cave-trap-active)))))

(deftype spawn-baby-spider-best (structure)
  ((index int32)
   (dist  float)))

(deftype spawn-baby-spider-work (structure)
  ((best spawn-baby-spider-best 4 :inline)))

(defmethod try-spawn-baby-spider ((this cave-trap))
  "Rank alternate spawn actors by whether they are nearby eggs, nearby and visible, visible, or
   simply available, then spawn a baby spider at the best candidate."
  (set-time! (-> this last-spawn-time))
  (set! (-> this spawn-delay) (rand-vu-int-range (seconds 0.1) (seconds 0.5)))
  (let ((work (new 'stack-no-clear 'spawn-baby-spider-work)))
    (let ((search-position (new 'stack-no-clear 'vector)))
      (dotimes (i 4)
        (set! (-> work best i index) -1))
      (set! (-> search-position quad) (-> (matrix-local->world #f #f) vector 2 quad))
      (set! (-> search-position y) 0.0)
      (vector-normalize! search-position 102400.0)
      (vector+! search-position search-position (camera-pos))
      (set! (-> search-position y) (-> (target-pos 0) y))
      (dotimes (actor-index (-> this alt-actors length))
        (let* ((source-actor (-> this alt-actors actor-index))
               (actor-process (if source-actor (-> source-actor extra process)))
               (candidate (if (and (nonzero? actor-process) (type-type? (-> actor-process type) process-drawable)) actor-process)))
          (when candidate
            (when (send-event candidate 'can-spawn?)
              (let ((distance (vector-vector-distance search-position (-> (the-as process-drawable candidate) root trans)))
                    (bounds (new 'stack-no-clear 'sphere)))
                (let ((any-slot (-> work best 3)))
                  (when (or (< (-> any-slot index) 0) (< distance (-> any-slot dist)))
                    (set! (-> any-slot index) actor-index)
                    (set! (-> any-slot dist) distance)))
                (set! (-> bounds quad) (-> (the-as process-drawable candidate) root trans quad))
                (set! (-> bounds w) 4096.0)
                (when (sphere-in-view-frustum? bounds)
                  (let ((visible-slot (-> work best 2)))
                    (when (or (< (-> visible-slot index) 0) (< distance (-> visible-slot dist)))
                      (set! (-> visible-slot index) actor-index)
                      (set! (-> visible-slot dist) distance)))
                  (when (>= 40960.0 distance)
                    (let ((nearby-slot (-> work best 1)))
                      (when (or (< (-> nearby-slot index) 0) (< distance (-> nearby-slot dist)))
                        (set! (-> nearby-slot index) actor-index)
                        (set! (-> nearby-slot dist) distance)))
                    (when (= (-> candidate type) spider-egg)
                      (let ((egg-slot (-> work best)))
                        (when (or (< (-> egg-slot 0 index) 0) (< distance (-> egg-slot 0 dist)))
                          (set! (-> egg-slot 0 index) actor-index)
                          (set! (-> egg-slot 0 dist) distance))))))))))))
    (dotimes (tier 4)
      (let ((chosen-index (-> work best tier index)))
        (when (>= chosen-index 0)
          (let* ((chosen-actor (-> this alt-actors chosen-index))
                 (chosen-process (if chosen-actor (-> chosen-actor extra process)))
                 (chosen (if (and (nonzero? chosen-process) (type-type? (-> chosen-process type) process-drawable)) chosen-process))
                 (spawn-direction (new 'stack-no-clear 'vector))
                 (spawn-params (new 'stack-no-clear 'baby-spider-spawn-params)))
            (vector-! spawn-direction (target-pos 0) (-> (the-as process-drawable chosen) root trans))
            (vector-normalize! spawn-direction 1.0)
            (init! spawn-params (= (-> chosen type) spider-egg) #t #t #t 7 1 'untrigger)
            (let ((spawned (process-spawn baby-spider this (-> (the-as process-drawable chosen) root trans) spawn-direction spawn-params :to this)))
              (when spawned
                (set! (-> (the-as baby-spider (-> spawned 0)) die-if-not-visible?) #t)
                (+! (-> this spider-count) 1)
                (send-event chosen 'notify-spawned)
                (return #f))))))))
  #f)

(defstate cave-trap-idle (cave-trap)
  :event cave-trap-default-event-handler
  :trans
    (behavior ()
      (when *target*
        (let* ((gp-0 (target-pos 0))
               (f0-0 (vector-vector-xz-distance (-> self root trans) (target-pos 0)))
               (f1-1 (- (-> gp-0 y) (-> self root trans y))))
          (when (and (>= 61440.0 f1-1) (>= f1-1 -16384.0))
            (when (>= 274432.0 f0-0)
              (when (or (>= 188416.0 f0-0) (send-event *target* 'query 'powerup (pickup-type eco-yellow)))
                (level-hint-spawn (text-id cave-trap-nest-hint) "sksp0341" (the-as entity #f) *entity-pool* (game-task none))
                (close-specific-task! (game-task cave-spider-tunnel) (task-status need-hint))
                (go cave-trap-active)))))))
  :code
    (behavior ()
      (logior! (-> self mask) (process-mask sleep-code))
      (suspend)
      0))

(defstate cave-trap-active (cave-trap)
  :event cave-trap-default-event-handler
  :enter
    (behavior ()
      (set! (-> self spawn-delay) (seconds 0.5)))
  :trans
    (behavior ()
      (cond
        (*target*
         (let* ((gp-0 (target-pos 0))
                (f0-0 (vector-vector-xz-distance (-> self root trans) (target-pos 0)))
                (f1-1 (- (-> gp-0 y) (-> self root trans y))))
           (if (or (< 73728.0 f1-1) (< f1-1 -24576.0) (< 368640.0 f0-0)) (go cave-trap-give-up)))
         (if (and (< (-> self spider-count) 8) (time-elapsed? (-> self last-spawn-time) (-> self spawn-delay)))
           (try-spawn-baby-spider self)))
        (else (go cave-trap-give-up)))
      0)
  :code
    (behavior ()
      (logior! (-> self mask) (process-mask sleep-code))
      (suspend)
      0))

(defstate cave-trap-give-up (cave-trap)
  :event cave-trap-default-event-handler
  :code
    (behavior ()
      (suspend)
      (go cave-trap-idle)))

(defmethod relocate ((this cave-trap) (offset int))
  "Relocate the alternate-actor array and the rest of this process allocation."
  (if (nonzero? (-> this alt-actors)) (&+! (-> this alt-actors) offset))
  (call-parent-method this offset))

(defmethod init-from-entity! ((this cave-trap) (source-entity entity-actor))
  "Initialize the cave trap's collision, navigation, path, and alternate spawn actors."
  (set! (-> this spider-count) 0)
  (set! (-> this spawn-delay) 0)
  (set! (-> this last-spawn-time) 0)
  (let ((shape (new 'process 'collide-shape this (collide-list-enum hit-by-player))))
    (let ((root-prim (new 'process 'collide-shape-prim-sphere shape (the-as uint 0))))
      (set! (-> root-prim prim-core offense) (collide-offense no-offense))
      (set-vector! (-> root-prim local-sphere) 0.0 0.0 0.0 4096.0)
      (set-root-prim! shape root-prim))
    (set! (-> shape nav-radius) (* 0.75 (-> shape root-prim local-sphere w)))
    (backup-collide-with-as shape)
    (set! (-> this root) shape))
  (process-drawable-from-entity! this source-entity)
  (set! (-> this nav) (new 'process 'nav-control (-> this root) 16 40960.0))
  (logior! (-> this nav flags)
           (nav-control-flags display-marks display-polys display-active-polys display-travel display-spheres))
  (set! (-> this nav nearest-y-threshold) 409600.0)
  (logclear! (-> this root nav-flags) (nav-flags avoid-body))
  (set! (-> this path) (new 'process 'path-control this 'path 0.0))
  (logior! (-> this path flags) (path-control-flag display draw-line draw-point draw-text))
  (let ((actor-count (entity-actor-count source-entity 'alt-actor)))
    (set! (-> this alt-actors) (new 'process 'boxed-array entity-actor actor-count))
    (dotimes (i actor-count)
      (set! (-> this alt-actors i) (entity-actor-lookup source-entity 'alt-actor i))))
  (go cave-trap-idle)
  (none))

;;-*-Lisp-*-
(in-package goal)
(bundles "CIT.DGO" "VI1.DGO" "VI2.DGO" "VI3.DGO")
(require "engine/entity/ambient.gc")
(require "engine/game/task/task-control.gc")
(require "engine/target/target.gc")
(require "engine/camera/pov-camera-h.gc")
(require "engine/common-obs/basebutton.gc")

;; DECOMP BEGINS

(deftype warpgate (process-hidden) ())

;; Bring Jak back from a warp at the destination gate.  The shared target-warp-out enter hook has
;; already saved the lowered gate position in state-vector0 and the continue point in state-vector1.
;; Place Jak at the gate, wait for the destination to settle, then launch him one metre upward while
;; retaining his planar velocity.  The transition hook steers that planar motion toward the continue
;; point at twelve metres per second until Jak touches a surface.
(defstate target-warp-in (target)
  :event target-generic-event-handler
  :enter
    (-> target-warp-out
        enter)
  :exit
    (-> target-warp-out
        exit)
  :trans
    (behavior ()
      (set! (-> self control transv x) (- (-> self control state-vector1 x) (-> self control state-vector0 x)))
      (set! (-> self control transv z) (- (-> self control state-vector1 z) (-> self control state-vector0 z)))
      (vector-xz-normalize! (-> self control transv) 49152.0)
      (if (logtest? (-> self control status) (collide-status on-surface)) (go target-hit-ground #f)))
  :code
    (behavior ((gate-position vector) (continue-position vector))
      (clear-collide-with-as (-> self control))
      (ja-channel-set! 0)
      (vector-reset! (-> self control transv))
      (move-to-point! (-> self control) (-> self control state-vector0))
      (suspend-for (seconds 1))
      (let ((planar-velocity (new-stack-vector0)))
        (let ((gravity-axis-speed (vector-dot (-> self control dynam gravity-normal) (-> self control transv))))
          0.0
          (vector-! planar-velocity
                    (-> self control transv)
                    (vector-float*! planar-velocity (-> self control dynam gravity-normal) gravity-axis-speed)))
        (let* ((planar-speed (vector-length planar-velocity))
               (normalization-speed planar-speed)
               (launch-speed (- (sqrtf (* 8192.0 (-> self control dynam gravity-length))) (* 0.008333334 (- (-> self control dynam gravity-length))))))
          (vector+! (-> self control transv)
                    (vector-float*! (-> self control transv) (-> self control dynam gravity-normal) launch-speed)
                    (vector-float*! planar-velocity planar-velocity (/ planar-speed normalization-speed)))))
      (set-heading-vec! (-> self control) (-> self control transv))
      (rot->dir-targ! (-> self control))
      (set-time! (-> self state-time))
      (set! (-> self post-hook) target-no-stick-post)
      (ja-channel-set! 1)
      (send-event self 'do-effect 'death-warp-in -1.0)
      (sound-play "warpgate-tele")
      (ja-play :group! eichar-duck-high-jump-ja :num! (seek! (ja-aframe 50.0 0)) :frame-num (ja-aframe 40.0 0))
      (restore-collide-with-as (-> self control))
      (ja-play :group! eichar-duck-high-jump-ja :num! (seek!) :frame-num (ja-aframe 50.0 0))
      (target-falling-anim -1 (seconds 0.33)))
  :post target-no-move-post)

;; Offer the warp selector while Jak is within five metres and free to interact.  Village 3's gate
;; is one-sided, so its prompt appears only from the approach sector facing the switch.
(defstate idle (warp-gate)
  :virtual #t
  :event
    (behavior ((sender process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('hide) (go-virtual hidden))))
  :code
    (behavior ()
      (remove-setting! 'allow-progress)
      (set-time! (-> self state-time))
      (loop
        (when (and (and *target* (>= 20480.0 (vector-vector-distance (-> self root trans) (-> *target* control trans))))
                   (and (>= (-> self level-slot) 0)
                        (not (movie?))
                        (not (level-hint-displayed?))
                        (not (logtest? (-> *target* control root-prim prim-core action)
                                       (collide-action edgegrab-cam swingpole-active racer snowball tube flut)))
                        (let* ((gate-root (-> self root))
                               (target-position (-> *target* control trans))
                               (approach-heading (vector-y-angle (vector-! (new 'stack-no-clear 'vector) target-position (-> gate-root trans)))))
                          (or (!= (-> self level-slot) 3) (and (< approach-heading -9102.223) (< -32768.0 approach-heading))))))
          (hide-hud)
          (level-hint-surpress!)
          (kill-current-level-hint '() '(sidekick voicebox) 'exit)
          (when (and (hud-hidden?)
                     (can-grab-display? self)
                     (cond
                       ((or (= (-> *target* next-state name) 'target-warp-in) (= (-> *target* next-state name) 'target-warp-out))
                        (set-time! (-> self state-time))
                        #f)
                       (else #t))
                     (time-elapsed? (-> self state-time) (seconds 0.1)))
            (if (and (cpad-pressed? 0 circle) (process-grab? *target*)) (go-virtual active))
            (if (and *cheat-mode* (cpad-pressed? 0 l3)) (set! (-> self max-slot) 4))
            (let ((prompt-context (new 'stack 'font-context *font-default-matrix* 32 160 0.0 (font-color default) (font-flags shadow kerning))))
              (set-width! prompt-context 440)
              (set-height! prompt-context 80)
              (set-scale! prompt-context 0.9)
              (set-flags! prompt-context (font-flags shadow kerning large))
              (print-game-text (lookup-text! *common-text* (text-id press-to-use) #f) prompt-context #f 128 22))))
        (suspend))))

(defun get-next-slot-up ((gate warp-gate) (slot int))
  "Advance one destination slot, wrapping through the gate's inclusive range and skipping the
   current level."
  (let ((next-slot (+ slot 1)))
    (if (< (-> gate max-slot) next-slot) (set! next-slot (-> gate min-slot)))
    (if (= next-slot (-> gate level-slot)) (+! next-slot 1))
    (if (< (-> gate max-slot) next-slot) (set! next-slot (-> gate min-slot)))
    next-slot))

(defun get-next-slot-down ((gate warp-gate) (slot int))
  "Move back one destination slot, wrapping through the gate's inclusive range and skipping the
   current level."
  (let ((next-slot (+ slot -1)))
    (if (< next-slot (-> gate min-slot)) (set! next-slot (-> gate max-slot)))
    (if (= next-slot (-> gate level-slot)) (+! next-slot -1))
    (if (< next-slot (-> gate min-slot)) (set! next-slot (-> gate max-slot)))
    next-slot))

(defun print-level-name ((slot int) (context font-context) (distance int) (right? int))
  "Draw a destination name on the selected side of the carousel. Distance supplies both the
   horizontal displacement and a linear fade from full intensity at zero to transparent at 300."
  (let ((signed-offset (if right? distance (- distance))))
    (+! (-> context origin x) (the float signed-offset))
    (let ((intensity (- 1.0 (* 0.0033333334 (the float distance)))))
      (print-game-text-scaled (lookup-text! *common-text* (the-as text-id (+ slot 286)) #f)
                              intensity
                              context
                              (the int (* 128.0 intensity))))
    (set! (-> context origin x) (- (-> context origin x) (the float signed-offset))))
  (set-color! context (font-color default))
  context)

;; Hold Jak facing the gate while the destination carousel is open.  The centred entry commits
;; halfway through a 300-unit slide; the old and new neighbours cross at 150 so repeated input can
;; queue the next slot without disturbing the current interpolation.
(defstate active (warp-gate)
  :virtual #t
  :enter
    (behavior ()
      (set-setting! 'allow-progress #f 0.0 0)
      (apply-settings *setting-control*)
      (sound-play "start-options")
      (set-time! (-> self state-time)))
  :trans
    (behavior ()
      (when (or (and (cpad-pressed? 0 triangle) (time-elapsed? (-> self state-time) (seconds 0.1)) (process-release? *target*))
                (not *target*))
        (logclear! (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons triangle))
        (logclear! (-> *cpad-list* cpads 0 button0-rel 0) (pad-buttons triangle))
        (sound-play "cursor-options")
        (go-virtual idle))
      (when *target*
        (let* ((target-control (-> *target* control))
               (gate-position (-> self root trans))
               (heading-error (deg-diff (y-angle target-control)
                                        (vector-y-angle (vector-! (new 'stack-no-clear 'vector) gate-position (-> target-control trans))))))
          (if (!= heading-error 0.0)
            (send-event *target*
                        'rotate-y-angle
                        (fmax (fmin heading-error (* 65536.0 (seconds-per-frame))) (* -65536.0 (seconds-per-frame))))))))
  :code
    (behavior ()
      (let ((selected-slot (get-next-slot-up self (+ (-> self level-slot) -1))))
        0
        (let ((scrolling? #f)
              (scroll-distance 0)
              (scrolling-left? #f)
              (pending-slot selected-slot))
          (loop
            (when (zero? scroll-distance)
              (cond
                ((cpad-pressed? 0 right)
                 (set! scrolling? #t)
                 (set! scrolling-left? #f)
                 (sound-play "cursor-up-down")
                 (set! pending-slot (get-next-slot-up self pending-slot)))
                ((cpad-pressed? 0 left)
                 (set! scrolling? #t)
                 (set! scrolling-left? #t)
                 (sound-play "cursor-up-down")
                 (set! pending-slot (get-next-slot-down self pending-slot)))))
            (if scrolling? (set! scroll-distance (seekl scroll-distance 300 (the int (* 15.0 (-> *display* time-adjust-ratio))))))
            (when (>= scroll-distance 150)
              (set! selected-slot pending-slot)
              (set! scrolling? #f)
              (set! scroll-distance 0))
            (can-grab-display? self)
            (hide-hud)
            (let ((destination (get-continue-by-name *game-info* (-> *warp-info* selected-slot))))
              (lookup-level-info (-> destination level))
              (when (and (time-elapsed? (-> self state-time) (seconds 0.05)) (cpad-pressed? 0 circle))
                (logclear! (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons circle))
                (logclear! (-> *cpad-list* cpads 0 button0-rel 0) (pad-buttons circle))
                (go-virtual use selected-slot (the-as level destination))))
            (let ((menu-context (new 'stack 'font-context *font-default-matrix* 6 110 0.0 (font-color default) (font-flags shadow kerning))))
              (set-scale! menu-context 0.7)
              (set-width! menu-context 500)
              (set-height! menu-context 55)
              (set-flags! menu-context (font-flags shadow kerning middle middle-vert large))
              (print-game-text (lookup-text! *common-text* (text-id warp-gate-use-dpad) #f) menu-context #f 128 22)
              (+! (-> menu-context origin y) 35.0)
              (set-height! menu-context 40)
              (set-color! menu-context (font-color progress-blue))
              0
              (let* ((next-slot (get-next-slot-up self selected-slot))
                     (previous-slot (get-next-slot-down self selected-slot))
                     (second-next-slot (get-next-slot-up self next-slot))
                     (second-previous-slot (get-next-slot-down self previous-slot)))
                (cond
                  (scrolling-left?
                   (let ((outgoing-previous-distance (- 300 (+ scroll-distance 150))))
                     (print-level-name previous-slot menu-context outgoing-previous-distance (the-as int #f)))
                   (let ((incoming-next-distance (+ scroll-distance 150)))
                     (cond
                       ((< incoming-next-distance 225) (print-level-name next-slot menu-context incoming-next-distance (the-as int #t)))
                       (else
                        (let ((second-previous-distance (- 300 scroll-distance)))
                          (print-level-name second-previous-slot menu-context second-previous-distance (the-as int #f)))))))
                  (else
                   (let ((incoming-previous-distance (+ scroll-distance 150)))
                     (cond
                       ((< incoming-previous-distance 225)
                        (print-level-name previous-slot menu-context incoming-previous-distance (the-as int #f)))
                       (else
                        (let ((second-next-distance (- 300 scroll-distance)))
                          (print-level-name second-next-slot menu-context second-next-distance (the-as int #t))))))
                   (let ((outgoing-next-distance (- 300 (+ scroll-distance 150))))
                     (print-level-name next-slot menu-context outgoing-next-distance (the-as int #t))))))
              (when (not scrolling?)
                (set-color! menu-context (font-color progress-yellow)))
              (print-level-name selected-slot menu-context scroll-distance (the-as int scrolling-left?))
              (+! (-> menu-context origin y) 20.0)
              (print-game-text (lookup-text! *common-text* (text-id press-to-warp) #f) menu-context #f 128 22)
              (+! (-> menu-context origin y) 15.0)
              (print-game-text (lookup-text! *common-text* (text-id press-to-exit) #f) menu-context #f 128 22))
            (suspend))))))

(defstate hidden (warp-gate)
  :virtual #t
  :code anim-loop)

(defbehavior warp-gate-init-by-other warp-gate ((position vector))
  "Create a warp selector at position. Determine its current slot from the active level and expose
   destinations only through the furthest unlocked village gate."
  (stack-size-set! (-> self main-thread) 512)
  (set! (-> self root) (new 'process 'trsqv))
  (vector-copy! (-> self root trans) position)
  (logior! (-> self mask) (process-mask actor-pause))
  (set! (-> self level) (-> self entity extra level name))
  (set! (-> self min-slot) 0)
  (let ((current-level (-> self level)))
    (set! (-> self level-slot)
          (cond
            ((= current-level 'training) 0)
            ((= current-level 'village1) 1)
            ((= current-level 'village2) 2)
            ((= current-level 'village3) 3)
            ((or (= current-level 'citadel) (= current-level 'lavatube)) 4)
            (else -1))))
  (set! (-> self max-slot)
        (cond
          ((task-closed? (game-task village4-button) (task-status need-hint)) 4)
          ((task-closed? (game-task village3-button) (task-status need-hint)) 3)
          ((task-closed? (game-task village2-levitator) (task-status need-hint)) 2)
          (else 1)))
  (go-virtual idle)
  (none))

(deftype warp-gate-switch (basebutton)
  ((warp handle))
  (:methods
   (pressable? (_type_) symbol)))

(defskelgroup *warp-gate-switch-sg*
  warp-gate-switch
  warp-gate-switch-lod0-jg
  warp-gate-switch-down-ja
  ((warp-gate-switch-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 1.5))

(defmethod setup-collision! ((this warp-gate-switch))
  "Create one sticky, indestructible ground mesh on skeleton transform 4 inside a three-metre
   primitive group, allocate one rider, and install the moving collision shape as root."
  (let ((collision (new 'process 'collide-shape-moving this (collide-list-enum hit-by-player))))
    (set! (-> collision dynam) (copy *standard-dynamics* 'process))
    (set! (-> collision reaction) default-collision-reaction)
    (set! (-> collision no-reaction)
          (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (alloc-riders collision 1)
    (let ((primitive-group (new 'process 'collide-shape-prim-group collision (the-as uint 1) 0)))
      (set! (-> primitive-group prim-core collide-as) (collide-kind ground-object))
      (set! (-> primitive-group collide-with) (collide-kind target))
      (set! (-> primitive-group prim-core action) (collide-action solid rider-plat-sticky))
      (set-vector! (-> primitive-group local-sphere) 0.0 0.0 0.0 12288.0)
      (set-root-prim! collision primitive-group)
      (let ((mesh-primitive (new 'process 'collide-shape-prim-mesh collision (the-as uint 0) (the-as uint 0))))
        (set! (-> mesh-primitive prim-core collide-as) (collide-kind ground-object))
        (set! (-> mesh-primitive collide-with) (collide-kind target))
        (set! (-> mesh-primitive prim-core action) (collide-action solid rider-plat-sticky))
        (set! (-> mesh-primitive prim-core offense) (collide-offense indestructible))
        (set! (-> mesh-primitive transform-index) 4)
        (set-vector! (-> mesh-primitive local-sphere) 0.0 0.0 0.0 12288.0)
        (append-prim primitive-group mesh-primitive)))
    (set! (-> collision nav-radius) (* 0.75 (-> collision root-prim local-sphere w)))
    (backup-collide-with-as collision)
    (set! (-> this root) collision)
    collision))

(defmethod pressable? ((this warp-gate-switch))
  "Reject presses while Jak is attached to special traversal geometry. The Training switch
   also remains locked until all four tutorial tasks are complete and supplies its blocked
   hint while locked."
  (let ((task (-> this entity extra perm task)))
    (cond
      ((logtest? (-> *target* control root-prim prim-core action)
                 (collide-action edgegrab-cam swingpole-active racer snowball tube flut))
       #f)
      ((= task (game-task training-door))
       (cond
         ((and (task-complete? *game-info* (game-task training-door))
               (task-complete? *game-info* (game-task training-gimmie))
               (task-complete? *game-info* (game-task training-climb))
               (task-complete? *game-info* (game-task training-buzzer)))
          #t)
         (else
          (level-hint-spawn (text-id training-warp-gate-blocked) "sagevb38" (the-as entity #f) *entity-pool* (game-task none))
          #f)))
      (else #t))))

(defmethod setup-skel-and-anim! ((this warp-gate-switch))
  "Restore the switch's initial pressed state from its task, create the warp-gate-switch
   skeleton, and pose its animation at the first or last frame before posting transforms."
  (set! (-> this warp) (the-as handle #f))
  (let ((task (-> this entity extra perm task)))
    (cond
      ((= task (game-task training-door))
       (set! (-> this down?)
             (the-as symbol (and (-> this entity) (logtest? (-> this entity extra perm status) (entity-perm-status complete))))))
      (else
       (if (or (= task (game-task none)) (task-closed? (-> this entity extra perm task) (task-status need-hint)))
         (set! (-> this down?) #t)))))
  (initialize-skeleton this *warp-gate-switch-sg* '())
  (logior! (-> this skel status) (janim-status inited))
  (ja-channel-set! 1)
  (cond
    ((-> this down?)
     (let ((down-channel (-> this skel root-channel 0)))
       (joint-control-channel-group-eval! down-channel
                                          (the-as art-joint-anim (-> this draw art-group data 2))
                                          num-func-identity)
       (set! (-> down-channel frame-num)
             (the float (+ (-> (the-as art-joint-anim (-> this draw art-group data 2)) data 0 length) -1)))))
    (else
     (let ((up-channel (-> this skel root-channel 0)))
       (joint-control-channel-group-eval! up-channel (the-as art-joint-anim (-> this draw art-group data 2)) num-func-identity)
       (set! (-> up-channel frame-num) 0.0))))
  (set! (-> this anim-speed) 2.0)
  (update-transforms! (-> this root))
  (ja-post)
  (none))

(defmethod press! ((this warp-gate-switch) (pressed? symbol))
  "When pressed, close the associated progression task, save the current Village 3 fuel-cell
   count as the gondola's later two-cell baseline, notify the linked actor to start, and update
   the base button state."
  (with-pp
    (when pressed?
      (let ((task (-> this entity extra perm task)))
        (when (nonzero? task)
          (close-specific-task! task (task-status need-hint))
          (when (= task (game-task village3-button))
            (let ((task-control (get-task-control task)))
              (when (zero? (get-reminder task-control 2))
                (let ((saved-task-count (max 1 (the int (-> *game-info* fuel)))))
                  (format #t "VILLAGE3 button saved ~D tasks~%" saved-task-count)
                  (save-reminder task-control saved-task-count 2)))))))
      (let ((event-block (new 'stack-no-clear 'event-message-block)))
        (set! (-> event-block from) pp)
        (set! (-> event-block num-params) 0)
        (set! (-> event-block message) 'start)
        (let ((send-event-fn send-event-function)
              (notify-actor (-> this notify-actor)))
          (send-event-fn (if notify-actor (-> notify-actor extra process)) event-block))))
    ;; og:preserve-this
    ;; note: they appear to be calling this on the wrong object.
    ;; this doesn't actually cause any problems but corrupts the type of `float` in the symbol
    ;; table because they write to some field of pressed?, which is actually #t and not a
    ;; basebutton.  The corruption is completely harmless but is annoying because it looks like
    ;; a more severe memory corruption problem. So we fix it.
    ;; (call-parent-method (the-as warp-gate-switch pressed?) pressed?)
    (call-parent-method this pressed?)))

;; An unpressed switch notifies its linked actor to stop.  Every minute it repeats the reminder
;; sequence appropriate to its progression task; touching or attacking it begins the press only
;; when pressable? accepts Jak's current state.
(defstate basebutton-up-idle (warp-gate-switch)
  :virtual #t
  :event
    (behavior ((sender process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('touch 'attack)
         (when (pressable? self)
           (notify-event! self (-> self event-going-down) (-> self notify-actor))
           (go-virtual basebutton-going-down)))
        (('hide) (send-event (handle->process (-> self warp)) message))
        (else ((-> (method-of-type basebutton basebutton-up-idle) event) sender argc message block))))
  :enter
    (behavior ()
      (set-time! (-> self state-time))
      (let ((parent-enter (-> (method-of-type basebutton basebutton-up-idle) enter))) (if parent-enter (parent-enter))))
  :trans
    (behavior ()
      (let ((event-block (new 'stack-no-clear 'event-message-block)))
        (set! (-> event-block from) self)
        (set! (-> event-block num-params) 0)
        (set! (-> event-block message) 'stop)
        (let ((send-event-fn send-event-function)
              (notify-actor (-> self notify-actor)))
          (send-event-fn (if notify-actor (-> notify-actor extra process)) event-block)))
      (when (time-elapsed? (-> self state-time) (seconds 60))
        (case (-> self entity extra perm task)
          (((game-task training-door))
           (when (and (task-complete? *game-info* (game-task training-door))
                      (task-complete? *game-info* (game-task training-gimmie))
                      (task-complete? *game-info* (game-task training-climb))
                      (task-complete? *game-info* (game-task training-buzzer)))
             (level-hint-spawn (text-id training-warp-gate-reminder) "sagevb39" (the-as entity #f) *entity-pool* (game-task none))
             (clear-text-seen! *game-info* (text-id training-warp-gate-reminder))))
          (((game-task village2-levitator))
           (level-hint-spawn (text-id village2-button-reminder) "asstvb28" (the-as entity #f) *entity-pool* (game-task none))
           (level-hint-spawn (text-id village2-button-reminder2) "asstvb29" (the-as entity #f) *entity-pool* (game-task none))
           (level-hint-spawn (text-id village2-button-reminder3) "asstvb30" (the-as entity #f) *entity-pool* (game-task none)))
          (((game-task village3-button))
           (level-hint-spawn (text-id village3-button-reminder) "asstv103" (the-as entity #f) *entity-pool* (game-task none))
           (level-hint-spawn (text-id village3-button-reminder2) "asstv104" (the-as entity #f) *entity-pool* (game-task none))
           (level-hint-spawn (text-id village3-button-reminder3) "asstv105" (the-as entity #f) *entity-pool* (game-task none))))
        (set-time! (-> self state-time)))
      (let ((parent-trans (-> (method-of-type basebutton basebutton-up-idle) trans))) (if parent-trans (parent-trans)))))

;; Keep the selector process alive while the switch is down and forward hide events to it.  The
;; Training switch repeats its reminder after the beach eco-rock task has been introduced.
(defstate basebutton-down-idle (warp-gate-switch)
  :virtual #t
  :event
    (behavior ((sender process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('hide) (send-event (handle->process (-> self warp)) message))
        (else ((-> (method-of-type basebutton basebutton-down-idle) event) sender argc message block))))
  :enter
    (behavior ()
      (set-time! (-> self state-time))
      (set! (-> self warp) (ppointer->handle (process-spawn warp-gate (-> self notify-actor extra trans) :to self)))
      (process-entity-status! self (entity-perm-status complete) #t)
      (let ((parent-enter (-> (method-of-type basebutton basebutton-down-idle) enter))) (if parent-enter (parent-enter))))
  :exit
    (behavior ()
      (let ((warp-process (handle->process (-> self warp)))) (if warp-process (deactivate warp-process)))
      (let ((parent-exit (-> (method-of-type basebutton basebutton-down-idle) exit))) (if parent-exit (parent-exit))))
  :trans
    (behavior ()
      (when (time-elapsed? (-> self state-time) (seconds 60))
        (case (-> self entity extra perm task)
          (((game-task training-door))
           (when (not (task-closed? (game-task beach-ecorocks) (task-status need-introduction)))
             (level-hint-spawn (text-id training-warp-gate-reminder) "sagevb39" (the-as entity #f) *entity-pool* (game-task none))
             (clear-text-seen! *game-info* (text-id training-warp-gate-reminder)))))
        (set-time! (-> self state-time)))
      (let ((parent-trans (-> (method-of-type basebutton basebutton-down-idle) trans))) (if parent-trans (parent-trans)))))

;; Trigger every linked trigger-actor before running the common button descent.  Actors that are not
;; live yet are born first and receive the trigger on the following tick.
(defstate basebutton-going-down (warp-gate-switch)
  :virtual #t
  :code
    (behavior ()
      (sound-play "warpgate-butt")
      (sound-play "warpgate-act")
      (let ((trigger-count (entity-actor-count (-> self entity) 'trigger-actor)))
        (dotimes (i trigger-count)
          (let ((trigger-actor (entity-actor-lookup (-> self entity) 'trigger-actor i))
                (event-block (new 'stack-no-clear 'event-message-block)))
            (set! (-> event-block from) self)
            (set! (-> event-block num-params) 0)
            (set! (-> event-block message) 'trigger)
            (let ((send-event-fn send-event-function)
                  (actor-for-send trigger-actor))
              (when (not (send-event-fn (if actor-for-send (-> actor-for-send extra process)) event-block))
                (entity-birth-no-kill trigger-actor)
                (suspend)
                (send-event (if trigger-actor (-> trigger-actor extra process)) 'trigger))))))
      (let ((parent-code (-> (the-as (state basebutton) (find-parent-state)) code)))
        (if parent-code ((the-as (function none :behavior basebutton) parent-code))))))

(defskelgroup *village-cam-sg*
  village-cam
  village-cam-lod0-jg
  -1
  ((village-cam-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 80))

(deftype village-cam (process)
  ((root-override trsq)
   (range         meters)
   (index         int32)
   (state-time    time-frame))
  (:state-methods
   idle))

(defmethod relocate ((this village-cam) (offset int))
  "Relocate the copied trigger transform, then let process relocate the allocation and its
   ordinary process-owned storage."
  (if (nonzero? (-> this root-override)) (&+! (-> this root-override) offset))
  (the-as village-cam ((method-of-type process relocate) this offset)))

;; Play the contextual village overview when Jak enters range and no dialog, loading, attack, or
;; progress sequence can conflict with it.  Index 0 alternates two Fire Canyon views after twenty
;; cells; index 1 is intentionally silent; indices 2 and 3 show the Village 2 and Village 3 switch
;; reminders.  The latter two first wait for Jak to leave the trigger, so a task completed while he
;; stands inside retires the now-obsolete camera without interrupting him.  The first Fire Canyon
;; view leaves this trigger asleep for five minutes; its second visit uses the alternate view and
;; then retires it.
(defstate idle (village-cam)
  :virtual #t
  :code
    (behavior ()
      (local-vars (left-range? symbol))
      (loop
        (let ((should-play? (and (and *target* (>= (-> self range) (vector-vector-distance (-> self root-override trans) (-> *target* control trans))))
                                 (and (-> *setting-control* current play-hints)
                                      (< 0.0 (-> *setting-control* current dialog-volume))
                                      (let ((eligibility-index (-> self index)))
                                        (cond
                                          ((zero? eligibility-index)
                                           (and (>= (-> *game-info* fuel) 20.0)
                                                (not (task-closed? (game-task firecanyon-assistant) (task-status need-reward-speech)))))
                                          ((= eligibility-index 2) (not (task-closed? (game-task village2-levitator) (task-status need-hint))))
                                          ((= eligibility-index 3) (not (task-closed? (game-task village3-button) (task-status need-hint))))
                                          (else #t)))))))
          (when should-play?
            (case (-> self index)
              ((2 3)
               (until left-range?
                 (suspend)
                 (set! left-range?
                       (or (not *target*)
                           (< (-> self range) (vector-vector-distance (-> self root-override trans) (-> *target* control trans))))))
               (let* ((recheck-index (-> self index))
                      (still-needed? (cond
                                       ((= recheck-index 2) (not (task-closed? (game-task village2-levitator) (task-status need-hint))))
                                       ((= recheck-index 3) (not (task-closed? (game-task village3-button) (task-status need-hint)))))))
                 (when (not still-needed?)
                   (process-entity-status! self (entity-perm-status no-kill) #f)
                   (process-entity-status! self (entity-perm-status dead) #t)
                   (deactivate self)))))
            (while (and *target*
                        (logtest? (-> *target* control mod-surface flags) (surface-flags jump))
                        (not (logtest? (-> *target* control status) (collide-status on-surface))))
              (suspend))
            (set-time! (-> self state-time))
            (process-grab? *target*)
            (process-entity-status! self (entity-perm-status no-kill) #t)
            (kill-current-level-hint '(ambient) '() 'exit)
            (until (not (or (-> *setting-control* current talking)
                            (or (-> *setting-control* current spooling)
                                (-> *setting-control* current hint)
                                (-> *setting-control* current ambient)
                                (not *target*)
                                (logtest? (-> *target* state-flags) (state-flags being-attacked dying)))))
              (set-setting! 'allow-progress #f 0.0 0)
              (let* ((settings *setting-control*)
                     (set-setting-method (method-of-object settings set-setting))
                     (setting-name 'movie)
                     (setting-owner (process->ppointer self)))
                (set-setting-method settings self setting-name setting-owner 0.0 0))
              (apply-settings *setting-control*)
              (while (or (-> *setting-control* current talking)
                         (-> *setting-control* current spooling)
                         (-> *setting-control* current hint)
                         (!= (-> *level* loading-level) (-> *level* level-default))
                         (not *target*)
                         (logtest? (-> *target* state-flags) (state-flags being-attacked dying))
                         *progress-process*)
                (suspend))
              (while (not (time-elapsed? (-> self state-time) (seconds 1)))
                (suspend))
              (kill-current-level-hint '() '() 'die)
              (suspend)
              (kill-current-level-hint '() '() 'die)
              (process-release? *target*)
              (remove-setting! 'movie)
              (apply-settings *setting-control*)
              (suspend)
              (suspend))
            (let ((sequence-index (-> self index)))
              (cond
                ((zero? sequence-index)
                 (let ((sequence-perm (-> self entity extra perm)))
                   (logior! (-> sequence-perm status) (entity-perm-status user-set-from-cstage))
                   (let ((visit-count (-> sequence-perm user-uint8 0)))
                     (cond
                       ((zero? visit-count)
                        (level-hint-spawn (text-id village1cam-enough-cells) "asstvb04" (the-as entity #f) *entity-pool* (game-task none))
                        (process-spawn pov-camera
                                       (-> self entity extra trans)
                                       *village-cam-sg*
                                       "firecanyon-cam"
                                       0
                                       #f
                                       '((0 want-force-vis village1 #t)
                                        (0 alive "money-2669")
                                        (0 alive "money-2670")
                                        (0 alive "money-2671")
                                        (0 alive "money-2672")
                                        (0 alive "money-2673")
                                        (0 alive "money-2674")
                                        (0 alive "money-2675")
                                        (0 alive "money-2677")
                                        (0 alive "money-2678"))
                                       :to
                                       self))
                       ((= visit-count 1)
                        (level-hint-spawn (text-id village1cam-enough-cells2) "asstvb08" (the-as entity #f) *entity-pool* (game-task none))
                        (process-spawn pov-camera
                                       (-> self entity extra trans)
                                       *village-cam-sg*
                                       "firecanyon-alt-cam"
                                       0
                                       #f
                                       '((0 want-force-vis village1 #t)
                                        (0 alive "money-2669")
                                        (0 alive "money-2670")
                                        (0 alive "money-2671")
                                        (0 alive "money-2672")
                                        (0 alive "money-2673")
                                        (0 alive "money-2674")
                                        (0 alive "money-2675")
                                        (0 alive "money-2677")
                                        (0 alive "money-2678"))
                                       :to
                                       self))))
                   (set! (-> sequence-perm user-int8 0) (seekl (the-as int (-> sequence-perm user-uint8 0)) 255 1))))
                ((= sequence-index 1))
                ((= sequence-index 2)
                 (when (not (task-closed? (game-task village2-levitator) (task-status need-hint)))
                   (level-hint-spawn (text-id village2-button-reminder2) "asstvb29" (the-as entity #f) *entity-pool* (game-task none))
                   (process-spawn pov-camera (-> self entity extra trans) *village-cam-sg* "vi2-button-cam" 0 #f '() :to self)))
                ((= sequence-index 3)
                 (when (not (task-closed? (game-task village3-button) (task-status need-hint)))
                   (level-hint-spawn (text-id village2-button-reminder3) "asstvb30" (the-as entity #f) *entity-pool* (game-task none))
                   (process-spawn pov-camera (-> self entity extra trans) *village-cam-sg* "vi3-button-cam" 0 #f '() :to self)))))
            (while (-> self child)
              (suspend))
            (let ((source-entity (-> self entity)))
              (if (when source-entity
                    (let ((source-task (-> source-entity extra perm task))) (if source-task (= source-task (game-task none)))))
                (set! (-> self entity extra perm task) (game-task complete))))
            (when (zero? (-> self index))
              (let ((source-perm (-> self entity extra perm)))
                (when (= (-> source-perm user-uint8 0) 1)
                  (remove-setting! 'allow-progress)
                  (suspend-for (seconds 300))
                  (go-virtual idle))))
            (process-entity-status! self (entity-perm-status no-kill) #f)
            (process-entity-status! self (entity-perm-status dead) #t)
            (deactivate self)))
        (suspend))))

(defmethod init-from-entity! ((this village-cam) (source-entity entity-actor))
  "Copy the trigger transform, activation range, and sequence index from the entity, make the
   process pause with actors, and enter the hint-camera state."
  (logior! (-> this mask) (process-mask actor-pause))
  (set! (-> this root-override) (new 'process 'trsq))
  (vector-copy! (-> this root-override trans) (-> source-entity extra trans))
  (quaternion-copy! (-> this root-override quat) (-> source-entity quat))
  (vector-identity! (-> this root-override scale))
  (set! (-> this range) (res-lump-float source-entity 'cam-notice-dist :default 81920.0))
  (set! (-> this index) (res-lump-value source-entity 'index int))
  (go (method-of-object this idle))
  (none))

;;-*-Lisp-*-
(in-package goal)
(bundles "VI2.DGO")
(require "levels/village2/village2-obs.gc")
(require "engine/common-obs/process-taskable.gc")

;; DECOMP BEGINS

(deftype warrior (process-taskable) ())

(defskelgroup *warrior-sg*
  warrior
  warrior-lod0-jg
  warrior-idle-ja
  ((warrior-lod0-mg (meters 20)) (warrior-lod1-mg (meters 40)) (warrior-lod2-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 4)
  :shadow warrior-shadow-mg)

(defmethod setup-shadow-settings! ((this warrior))
  "Set the Warrior's shadow bottom and top clip planes relative to his root Y position."
  (let ((shadow-ctrl (-> this draw shadow-ctrl)))
    (when shadow-ctrl
      (let ((trans-y (-> this root trans y)))
        (let ((shadow-ctrl-alias shadow-ctrl))
          (set! (-> shadow-ctrl-alias settings bot-plane w) (- (+ -4096.0 trans-y))))
        0
        (set! (-> shadow-ctrl settings top-plane w) (- (+ 3072.0 trans-y))))
      0))
  (none))

(defmethod draw-npc-shadow ((this warrior))
  "Enable and orient the Warrior's shadow only when its highest-detail mesh was drawn this
   frame; disable it otherwise."
  (local-vars (shadow-ctrl shadow-control))
  (-> this draw shadow-ctrl)
  (cond
    ((and (-> this draw shadow) (zero? (-> this draw cur-lod)) (logtest? (-> this draw status) (draw-status was-drawn)))
     (set! shadow-ctrl (-> this draw shadow-ctrl))
     (logclear! (-> shadow-ctrl settings flags) (shadow-flags disable-draw))
     0
     (update-direction-from-time-of-day (-> this draw shadow-ctrl)))
    (else
     (set! shadow-ctrl (-> this draw shadow-ctrl))
     (logior! (-> shadow-ctrl settings flags) (shadow-flags disable-draw))
     0))
  (none))

(defmethod play-anim! ((this warrior) (commit? symbol))
  "Choose the Warrior's introduction, reminder, or money-task reward animation. When commit? is
   true, advance the task, collect the payment, start the pontoon clone animation, and remove
   the alternate actors."
  (with-pp
    (set! (-> this talk-message) (text-id press-to-talk))
    (case (current-status (-> this tasks))
      (((task-status need-hint) (task-status need-introduction))
       (if commit? (close-status! (-> this tasks) (task-status need-introduction)))
       (new 'static
            'spool-anim
            :name "warrior-introduction"
            :index 6
            :parts 29
            :command-list
            '((125 joint "cameraB")
             (260 joint "camera")
             (574 joint "cameraB")
             (918 joint "camera")
             (1174 joint "cameraB")
             (1174 shadow self #f)
             (1301 joint "camera")
             (1301 shadow self #t)
             (2025 joint "cameraB")
             (2322 joint "camera")
             (2560 joint "cameraB"))))
      (((task-status need-reminder))
       (set! (-> this skippable) #t)
       (new 'static 'spool-anim :name "warrior-reminder-1" :index 7 :parts 3 :command-list '()))
      (((task-status need-reward-speech))
       (cond
         (commit?
          (set! (-> this cell-for-task) (current-task (-> this tasks)))
          (close-current! (-> this tasks))
          (send-event *target* 'get-pickup 5 (- (-> *GAME-bank* money-task-inc)))
          (send-event (-> (entity-by-type allpontoons) extra process) 'clone (process->handle this))
          (dotimes (i (entity-actor-count (-> this entity) 'alt-actor))
            (entity-birth-no-kill (entity-actor-lookup (-> this entity) 'alt-actor i))
            (let ((event-block (new 'stack-no-clear 'event-message-block)))
              (set! (-> event-block from) pp)
              (set! (-> event-block num-params) 0)
              (set! (-> event-block message) 'die)
              (let ((send-fn send-event-function)
                    (alt-actor (entity-actor-lookup (-> this entity) 'alt-actor i)))
                (send-fn (if alt-actor (-> alt-actor extra process)) event-block)))))
         (else (set! (-> this will-talk) #t) (set! (-> this talk-message) (text-id press-to-trade-money))))
       (new 'static 'spool-anim :name "warrior-resolution" :index 8 :parts 6 :command-list '((508 blackout 10) (511 blackout 0))))
      (else
       (if commit?
         (format 0
                 "ERROR: <GMJ>: ~S playing anim for task status ~S~%"
                 (-> this name)
                 (task-status->string (current-status (-> this tasks)))))
       (-> this draw art-group data 5)))))

(defmethod get-art-elem ((this warrior))
  "Return the Warrior's active root animation channel."
  (-> this draw art-group data 5))

(defstate play-anim (warrior)
  :virtual #t
  :exit
    (behavior ()
      (send-event (-> (entity-by-type allpontoons) extra process) 'end-mode)
      ((-> (method-of-type process-taskable play-anim) exit))))

(defmethod try-play-ambient-chatter ((this warrior))
  "After the two-second ambient cooldown and distance check pass, choose one of three Warrior
   idle lines."
  (when (ambient-chatter-ready? (-> this ambient) (new 'stack-no-clear 'vector) (seconds 2) 61440.0 this)
    (let ((roll (rand-float-gen)))
      (cond
        ((< 0.66 roll) (play-ambient (-> this ambient) "WAR-LO1A" #f (-> this root trans)))
        ((< 0.33 roll) (play-ambient (-> this ambient) "WAR-LO1B" #f (-> this root trans)))
        (else (play-ambient (-> this ambient) "WAR-LO1C" #f (-> this root trans)))))))

(defmethod initialize-collision ((this warrior) (center-joint int) (collision-size vector))
  "Build the Warrior's indestructible collision group from one root group and two sphere
   primitives."
  (let ((collision (new 'process 'collide-shape this (collide-list-enum hit-by-player))))
    (let ((root-prim (new 'process 'collide-shape-prim-group collision (the-as uint 2) 0)))
      (set! (-> root-prim prim-core collide-as) (collide-kind enemy))
      (set! (-> root-prim collide-with) (collide-kind target))
      (set! (-> root-prim prim-core action) (collide-action solid))
      (set! (-> root-prim prim-core offense) (collide-offense indestructible))
      (set-vector! (-> root-prim local-sphere) -3072.0 8192.0 0.0 11264.0)
      (set-root-prim! collision root-prim)
      (let ((sphere-prim (new 'process 'collide-shape-prim-sphere collision (the-as uint 0))))
        (set! (-> sphere-prim prim-core collide-as) (collide-kind enemy))
        (set! (-> sphere-prim collide-with) (collide-kind target))
        (set! (-> sphere-prim prim-core action) (collide-action solid))
        (set! (-> sphere-prim prim-core offense) (collide-offense indestructible))
        (set-vector! (-> sphere-prim local-sphere) -2048.0 9216.0 0.0 8192.0)
        (append-prim root-prim sphere-prim))
      (let ((sphere-prim-2 (new 'process 'collide-shape-prim-sphere collision (the-as uint 0))))
        (set! (-> sphere-prim-2 prim-core collide-as) (collide-kind enemy))
        (set! (-> sphere-prim-2 collide-with) (collide-kind target))
        (set! (-> sphere-prim-2 prim-core action) (collide-action solid))
        (set! (-> sphere-prim-2 prim-core offense) (collide-offense indestructible))
        (set-vector! (-> sphere-prim-2 local-sphere) 0.0 2048.0 0.0 4096.0)
        (append-prim root-prim sphere-prim-2)))
    (set! (-> collision nav-radius) (* 0.75 (-> collision root-prim local-sphere w)))
    (backup-collide-with-as collision)
    (set! (-> this root) collision))
  0
  (none))

(defmethod init-from-entity! ((this warrior) (source-entity entity-actor))
  "Initialize the Warrior for the Village 2 money task, configure his music and lighting, and
   enter the current taskable state."
  (init-as-taskable! this source-entity *warrior-sg* 3 33 (new 'static 'vector :y -4096.0 :w 10240.0) 5)
  (set! (-> this tasks) (get-task-control (game-task village2-warrior-money)))
  (set! (-> this sound-flava) (music-flava warrior))
  (set! (-> this draw light-index) (the-as uint 3))
  (goto-initial-state! this)
  (none))

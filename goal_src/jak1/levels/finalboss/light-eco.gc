(defun check-drop-level-lighteco-pops ((system sparticle-system) (particle sparticle-cpuinfo) (position vector))
  "Kill a falling light-eco particle below its stored height and launch its impact effects."
  (when (< (-> position y) (-> particle user-float))
    (let ((impact-position (new 'stack-no-clear 'vector)))
      (sp-kill-particle system particle)
      (set-vector! impact-position (-> position x) (-> position y) (-> position z) 1.0)
      (launch-particles (-> *part-id-table* 2910) impact-position)
      (launch-particles (-> *part-id-table* 2911) impact-position)))
  (none))


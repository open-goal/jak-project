;;-*-Lisp-*-
(in-package goal)
(bundles "FIN.DGO")
(require "levels/snow/snow-ram-boss.gc")

;; DECOMP BEGINS

(deftype green-eco-lurker (nav-enemy)
  "A green-eco blob enemy that chooses an appearance point from its path, jumps into the arena,
and attacks Jak on contact."
  ((played-sound? symbol)
   (sound-delay int32)
   (appear-dest vector :inline)
   (traj trajectory :inline))
  (:methods
   (appear-dest-valid? (_type_ vector) symbol :overlay-at nav-enemy-method-51)
   (pick-appear-dest? (_type_ vector) symbol :overlay-at nav-enemy-method-52)
   (update-appear-shadow! (_type_) symbol :overlay-at nav-enemy-method-53))
  (:states
   green-eco-lurker-appear
   green-eco-lurker-appear-land
   green-eco-lurker-tune-spheres
   green-eco-lurker-wait-to-appear))

(deftype green-eco-lurker-gen (process-drawable)
  "Spawns a fixed number of green-eco blobs, at most three alive at once, and reports completion."
  ((num-to-spawn int32)
   (num-spawned int32)
   (num-alive int32))
  (:states
   spawn-minions))

(defskelgroup *green-eco-lurker-sg*
  green-eco-lurker
  green-eco-lurker-lod0-jg
  -1
  ((green-eco-lurker-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 5.95)
  :shadow green-eco-lurker-shadow-mg)


;;-*-Lisp-*-
(in-package goal)
(bundles "CIT.DGO" "MIS.DGO" "SWA.DGO")
(require "engine/common-obs/babak.gc")

;; DECOMP BEGINS

(deftype battlecontroller-spawner (structure)
  "One encounter entrance: a staged jump path, its current creature, optional linked actors, the
   next path point to cue, and whether this entrance can still spawn."
  ((path path-control)
   (creature handle)
   (trigger-actor entity-actor)
   (blocker-actor entity-actor)
   (state int8)
   (enabled symbol)))


(deftype battlecontroller-creature-type (structure)
  "One weighted enemy type and its limited chance to replace the encounter's ordinary enemy
   pickup."
  ((type2 type)
   (percent float)
   (pickup-percent float)
   (pickup-type pickup-type)
   (max-pickup-count int8)
   (pickup-count int8))
  :allow-misaligned)


(deftype battlecontroller (process-drawable)
  "Coordinates a finite enemy encounter. Enemies enter along named paths until the configured
   live and total limits are met; linked actors, music, camera, ocean visibility, persistence, and
   the final pickup are managed around the battle."
  ((final-pickup-spawn-point vector :inline)
   (activate-distance float)
   (max-spawn-count int16)
   (spawn-count int16)
   (die-count int16)
   (target-count int8)
   (spawner-count int8)
   (creature-type-count int8)
   (spawner-array battlecontroller-spawner 8 :inline)
   (spawn-period time-frame)
   (path-spawn path-control)
   (creature-type-array battlecontroller-creature-type 4 :inline)
   (final-pickup-type pickup-type)
   (prespawn symbol)
   (noticed-player symbol)
   (camera-on symbol)
   (misty-ambush-collision-hack symbol)
   (disable-ocean symbol)
   (disable-near-ocean symbol)
   (disable-mid-ocean symbol))
  (:methods
   (battlecontroller-method-20 () none)
   (battlecontroller-idle () _type_ :state)
   (battlecontroller-play-intro-camera () _type_ :state)
   (battlecontroller-method-23 () none)
   (battlecontroller-active () _type_ :state)
   (battlecontroller-method-25 () none)
   (battlecontroller-die () _type_ :state)
   (setup-paths-and-params! (_type_) none)
   (cleanup-if-finished! (_type_) none)))


(defbehavior battlecontroller-spawners-full? battlecontroller ()
  "Return whether every configured entrance contains a nonfalse creature handle."
  (dotimes (i (-> self spawner-count))
    (if (= (-> self spawner-array i creature) #f) (return #f)))
  #t)

(defbehavior battlecontroller-default-event-handler battlecontroller ((sender process) (argc int) (message symbol) (block event-message-block))
  "Count child deaths. On the last configured death, remember its position and replace its ordinary
   drop when the final reward is not a fuel cell. A trigger event ends the encounter immediately."
  (case message
    (('child-die)
     (+! (-> self die-count) 1)
     (when (= (-> self die-count) (-> self max-spawn-count))
       (let ((child (the-as process-drawable sender)))
         (when child
           (set! (-> self final-pickup-spawn-point quad) (-> child root trans quad))
           (case (-> self final-pickup-type)
             (((pickup-type fuel-cell)) #f)
             (else
              (set! (-> child fact pickup-type) (-> self final-pickup-type))
              (set! (-> child fact pickup-amount) 1.0)
              (set! (-> child fact pickup-spawn-amount) 0.0)))))))
    (('trigger) (go-virtual battlecontroller-die))))

battlecontroller-default-event-handler

(defbehavior battlecontroller-draw-debug battlecontroller ()
  "Draw every configured entrance path."
  (dotimes (i (-> self spawner-count))
    (debug-draw (-> self spawner-array i path)))
  0
  (none))

(defbehavior battlecontroller-camera-on battlecontroller ()
  "Switch to the optional camera-name entity once and remember that the encounter camera is active."
  (when (not (-> self camera-on))
    (set! (-> self camera-on) #t)
    (let ((camera-name (res-lump-struct (-> self entity) 'camera-name structure)))
      (if camera-name (send-event *camera* 'change-to-entity-by-name camera-name))))
  0)

(defbehavior battlecontroller-camera-off battlecontroller ()
  "Clear the encounter's camera entity and active flag."
  (set! (-> self camera-on) #f)
  (send-event *camera* 'clear-entity)
  0
  (none))

(defbehavior battlecontroller-update-spawners battlecontroller ()
  "Advance each waiting creature through its entrance path one cue at a time. After the final
   point, release it to chase and free the entrance for another spawn."
  (dotimes (i (-> self spawner-count))
    (let* ((spawner (-> self spawner-array i))
           (creature (handle->process (-> spawner creature))))
      (when (and creature (logtest? (-> (the-as nav-enemy creature) nav-enemy-flags) (nav-enemy-flags waiting-for-cue)))
        (cond
          ((< (-> spawner state) (-> spawner path curve num-cverts))
           (when (or (-> self noticed-player) (= (-> spawner state) 1))
             (let ((cue-point (new 'stack-no-clear 'vector)))
               (eval-path-curve-div! (-> spawner path) cue-point (the float (-> spawner state)) 'interp)
               (send-event creature 'cue-jump-to-point cue-point))
             (if (not (logtest? (-> (the-as nav-enemy creature) nav-enemy-flags) (nav-enemy-flags waiting-for-cue)))
               (+! (-> spawner state) 1))))
          (else (send-event creature 'cue-chase) (set! (-> spawner creature) (the-as handle #f)))))))
  0
  (none))

(defbehavior battlecontroller-spawn-creature battlecontroller ((spawn-position vector) (cue-point vector))
  "Choose a weighted enemy type, create and initialize it at spawn-position facing cue-point, apply
   the Misty ground-probe mode when requested, and configure its ordinary or limited special
   pickup. Return its handle, or false when creation fails."
  (let ((selection (rand-vu))
        (enemy-type-index 0))
    (dotimes (i (-> self creature-type-count))
      (when (>= selection 0.0)
        (set! selection (- selection (-> self creature-type-array i percent)))
        (if (< selection 0.0) (set! enemy-type-index i))))
    (let* ((enemy-config (-> self creature-type-array enemy-type-index))
           (enemy-type (-> enemy-config type2))
           (enemy (the-as nav-enemy (get-process *default-dead-pool* enemy-type #x4000)))
           (enemy-pointer (when enemy
                            (let ((activate-method (method-of-type process activate)))
                              (activate-method enemy self enemy-type (the-as pointer #x70004000)))
                            (run-now-in-process enemy nav-enemy-init-by-other self spawn-position cue-point)
                            (-> enemy ppointer))))
      (if (and enemy-pointer (zero? (-> (the-as (pointer nav-enemy) enemy-pointer) 0 enemy-info)))
        (set! enemy-pointer (the-as (pointer process) #f)))
      (when (the-as (pointer nav-enemy) enemy-pointer)
        (logclear! (-> (the-as (pointer nav-enemy) enemy-pointer) 0 mask) (process-mask actor-pause))
        (if (-> self misty-ambush-collision-hack)
          (logior! (-> (the-as (pointer nav-enemy) enemy-pointer) 0 nav-enemy-flags) (nav-enemy-flags misty-ambush-ground-probe)))
        (+! (-> self spawn-count) 1)
        (let ((drop-type (-> self fact pickup-type)))
          (cond
            ((and (< (-> enemy-config pickup-count) (-> enemy-config max-pickup-count))
                  (rand-vu-percent? (-> enemy-config pickup-percent)))
             (+! (-> enemy-config pickup-count) 1)
             (set! drop-type (-> enemy-config pickup-type)))
            (else (set! drop-type (-> self fact pickup-type))))
          (set! (-> (the-as (pointer nav-enemy) enemy-pointer) 0 enemy-info pickup-type) drop-type)
          (cond
            ((= drop-type (pickup-type eco-pill)))
            ((= drop-type (pickup-type none))
             (set! (-> (the-as (pointer nav-enemy) enemy-pointer) 0 enemy-info pickup-amount) 0.0)
             (set! (-> (the-as (pointer nav-enemy) enemy-pointer) 0 enemy-info pickup-spawn-amount) 0.0))
            (else
             (set! (-> (the-as (pointer nav-enemy) enemy-pointer) 0 enemy-info pickup-amount) 1.0)
             (set! (-> (the-as (pointer nav-enemy) enemy-pointer) 0 enemy-info pickup-spawn-amount) 0.0)
             (logior! (-> (the-as (pointer nav-enemy) enemy-pointer) 0 enemy-info options) (fact-options fade))
             (set! (-> (the-as (pointer nav-enemy) enemy-pointer) 0 enemy-info fade-time) (seconds 4))))))
      (the-as handle (ppointer->handle enemy-pointer)))))

(defbehavior battlecontroller-spawn-creature-at-spawner battlecontroller ((spawner-index int) (path-point int))
  "If entrance is empty and the total limit permits it, create an enemy at path-point facing the
   following point and remember the next cue index."
  (let* ((spawner (-> self spawner-array spawner-index))
         (path (-> spawner path))
         (spawn-position (eval-path-curve-div! path (new 'stack-no-clear 'vector) (the float path-point) 'interp))
         (cue-point (eval-path-curve-div! path (new 'stack-no-clear 'vector) (the float (+ path-point 1)) 'interp)))
    (when (and (not (handle->process (-> spawner creature))) (< (-> self spawn-count) (-> self max-spawn-count)))
      (let ((enemy-handle (battlecontroller-spawn-creature spawn-position cue-point)))
        (when (handle->process enemy-handle)
          (set! (-> spawner creature) enemy-handle)
          (set! (-> spawner state) (+ path-point 1))))))
  0
  (none))

(defbehavior battlecontroller-spawn-creature-random-spawner battlecontroller ()
  "Choose one entrance, disable it when its blocker is complete, notify its trigger actor, and
   spawn at the beginning of its path when it is enabled and empty."
  (let* ((spawner-index (rand-vu-int-count (-> self spawner-count)))
         (spawner (-> self spawner-array spawner-index)))
    (when (and (-> spawner enabled) (-> spawner blocker-actor))
      (when (logtest? (-> spawner blocker-actor extra perm status) (entity-perm-status complete))
        (set! (-> spawner enabled) #f)
        (let ((enabled-count 0))
          (dotimes (i (-> self spawner-count))
            (if (-> self spawner-array i enabled) (+! enabled-count 1)))
          (if (zero? enabled-count) (set! (-> self spawn-count) (-> self max-spawn-count))))))
    (when (and (-> spawner enabled) (not (handle->process (-> spawner creature))))
      (let ((event-block (new 'stack-no-clear 'event-message-block)))
        (set! (-> event-block from) self)
        (set! (-> event-block num-params) 0)
        (set! (-> event-block message) 'spawn)
        (let ((send-event-fn send-event-function)
              (trigger-actor (-> spawner trigger-actor)))
          (send-event-fn (if trigger-actor (-> trigger-actor extra process)) event-block)))
      (battlecontroller-spawn-creature-at-spawner spawner-index 0)))
  0
  (none))

(defbehavior battlecontroller-fill-all-spawners battlecontroller ()
  "Populate every entrance at path point one. Also create one immediately chasing enemy at each
   point of the optional pathspawn path."
  (dotimes (spawner-i (-> self spawner-count))
    (battlecontroller-spawn-creature-at-spawner spawner-i 1))
  (when (nonzero? (-> self path-spawn))
    (let ((spawn-position (new 'stack-no-clear 'vector)))
      (dotimes (path-i (-> self path-spawn curve num-cverts))
        (eval-path-curve-div! (-> self path-spawn) spawn-position (the float path-i) 'interp)
        (let ((enemy-handle (battlecontroller-spawn-creature spawn-position (-> self root trans))))
          (when (handle->process enemy-handle)
            (suspend)
            (send-event (handle->process enemy-handle) 'cue-chase))))))
  0
  (none))

(defbehavior battlecontroller-battle-begin battlecontroller ()
  "Start danger music, suppress the linked kill actors, trigger the linked start actors, and clear
   the current level hint."
  (set-setting! 'music 'danger 0.0 0)
  (let ((kill-actor-count (entity-actor-count (-> self entity) 'kill-actor)))
    (dotimes (kill-i kill-actor-count)
      (let ((kill-actor (entity-actor-lookup (-> self entity) 'kill-actor kill-i)))
        (if kill-actor (logior! (-> kill-actor extra perm status) (entity-perm-status suppress-birth))))))
  (let ((trigger-actor-count (entity-actor-count (-> self entity) 'trigger-actor)))
    (dotimes (trigger-i trigger-actor-count)
      (let ((event-block (new 'stack-no-clear 'event-message-block)))
        (set! (-> event-block from) self)
        (set! (-> event-block num-params) 0)
        (set! (-> event-block message) 'trigger)
        (let ((send-event-fn send-event-function)
              (trigger-actor (entity-actor-lookup (-> self entity) 'trigger-actor trigger-i)))
          (send-event-fn (if trigger-actor (-> trigger-actor extra process)) event-block)))))
  (level-hint-spawn (text-id zero) (the-as string #f) (-> self entity) *entity-pool* (game-task none))
  0
  (none))

(defbehavior battlecontroller-off battlecontroller ()
  "Remove danger music and allow the linked kill actors to be born again."
  (remove-setting! 'music)
  (let ((kill-actor-count (entity-actor-count (-> self entity) 'kill-actor)))
    (dotimes (i kill-actor-count)
      (let ((kill-actor (entity-actor-lookup (-> self entity) 'kill-actor i)))
        (if kill-actor (logclear! (-> kill-actor extra perm status) (entity-perm-status suppress-birth))))))
  0
  (none))

(defbehavior battlecontroller-battle-end battlecontroller ()
  "Play the Citadel completion line when applicable, then restore music and linked kill actors."
  (case (-> (level-get-target-inside *level*) name)
    (('citadel) (level-hint-spawn (text-id citadel-battle-end) "sksp0378" (the-as entity #f) *entity-pool* (game-task none))))
  (battlecontroller-off)
  (none))

;; Pre-spawned enemies wait one point into their entrance paths. Otherwise the paths are filled
;; only after Jak enters range, so the encounter does not create its children while dormant.
(defstate battlecontroller-idle (battlecontroller)
  :virtual #t
  :event battlecontroller-default-event-handler
  :trans
    (behavior ()
      0)
  :code
    (behavior ()
      (set-time! (-> self state-time))
      (if (-> self prespawn) (battlecontroller-fill-all-spawners))
      (loop
        (when (time-elapsed? (-> self state-time) (seconds 0.1))
          (set-time! (-> self state-time))
          (when (and *target*
                     (>= (-> self activate-distance) (vector-vector-distance (-> self root trans) (-> *target* control trans))))
            (set! (-> self noticed-player) #t)
            (battlecontroller-battle-begin)
            (when (not (-> self prespawn))
              (battlecontroller-fill-all-spawners)
              (suspend)
              0)
            (go-virtual battlecontroller-play-intro-camera)))
        (suspend)))
  :post #f)

;; Subtypes replace this state with their level-specific camera. Keep the controller alive while
;; that state runs; the base has no introduction and proceeds directly to the battle.
(defstate battlecontroller-play-intro-camera (battlecontroller)
  :virtual #t
  :event battlecontroller-default-event-handler
  :enter
    (behavior ()
      (process-entity-status! self (entity-perm-status no-kill) #t))
  :exit
    (behavior ()
      (process-entity-status! self (entity-perm-status no-kill) #f))
  :code
    (behavior ()
      (go-virtual battlecontroller-active)))

(defbehavior battlecontroller-disable-ocean battlecontroller ()
  "Apply this encounter's whole-, middle-, and near-ocean visibility settings."
  (set! *ocean-off* (-> self disable-ocean))
  (set! *ocean-mid-off* (-> self disable-mid-ocean))
  (set! *ocean-near-off* (-> self disable-near-ocean))
  0
  (none))

;; Keep at most target-count children alive and stop only after max-spawn-count enemies have been
;; created and every child has gone away. Entrance-path enemies remain controller children while
;; waiting for jump cues and after they are released to chase.
(defstate battlecontroller-active (battlecontroller)
  :virtual #t
  :event battlecontroller-default-event-handler
  :trans
    (behavior ()
      (if (and *target*
               (>= (-> self activate-distance) (vector-vector-distance (-> self root trans) (-> *target* control trans))))
        (level-hint-spawn (text-id zero) (the-as string #f) (-> self entity) *entity-pool* (game-task none)))
      (battlecontroller-disable-ocean)
      (battlecontroller-update-spawners))
  :code
    (behavior ()
      (set-time! (-> self state-time))
      (battlecontroller-camera-on)
      (loop
        (when (time-elapsed? (-> self state-time) (seconds 0.1))
          (set-time! (-> self state-time))
          (let ((live-count 0))
            (let ((child (-> self child))) (while child (+! live-count 1) (set! child (-> child 0 brother)) (nop!) (nop!)))
            (if (and (zero? live-count) (= (-> self spawn-count) (-> self max-spawn-count))) (go-virtual battlecontroller-die))
            (when (< live-count (-> self target-count))
              (suspend-for (-> self spawn-period))
              (battlecontroller-spawn-creature-random-spawner))))
        (suspend)))
  :post #f)

(defbehavior battlecontroller-special-contents? battlecontroller ()
  "Return whether the final reward is a separately spawned fuel cell."
  (= (-> self final-pickup-type) (pickup-type fuel-cell)))

(defbehavior battlecontroller-special-contents-collected? battlecontroller ()
  "Return whether persistent stage two records collection of the final fuel cell."
  (= (-> self entity extra perm user-int8 0) 2))

(defbehavior battlecontroller-set-special-contents-collected battlecontroller ()
  "Persist stage two after the final fuel cell has left the controller's child list."
  (let ((perm (-> self entity extra perm)))
    (logior! (-> perm status) (entity-perm-status user-set-from-cstage))
    (set! (-> perm user-int8 0) 2))
  0
  (none))

(defbehavior battlecontroller-task-completed? battlecontroller ()
  "Return whether the encounter has reached either persistent completion stage."
  (>= (-> self entity extra perm user-int8 0) 1))

(defbehavior battlecontroller-set-task-completed battlecontroller ()
  "Persist stage one when the enemy encounter ends."
  (let ((perm (-> self entity extra perm)))
    (logior! (-> perm status) (entity-perm-status user-set-from-cstage))
    (set! (-> perm user-int8 0) 1))
  0
  (none))

;; A fuel cell is born separately so its collection can advance persistent state from one to two.
;; Other final pickups are installed on the last defeated enemy by the ordinary event handler.
(defstate battlecontroller-die (battlecontroller)
  :virtual #t
  :event process-drawable-fuel-cell-handler
  :code
    (behavior ()
      (sound-play "money-pickup" :pitch -1.5 :position #f)
      (battlecontroller-battle-end)
      (battlecontroller-camera-off)
      (battlecontroller-set-task-completed)
      (countdown (fade-i (entity-actor-count (-> self entity) 'fade-actor))
        (let ((fade-event (new 'stack-no-clear 'event-message-block)))
          (set! (-> fade-event from) self)
          (set! (-> fade-event num-params) 0)
          (set! (-> fade-event message) 'fade)
          (let ((send-fade-event send-event-function)
                (fade-actor (entity-actor-lookup (-> self entity) 'fade-actor fade-i)))
            (send-fade-event (if fade-actor (-> fade-actor extra process)) fade-event))))
      (countdown (alt-i (entity-actor-count (-> self entity) 'alt-actor))
        (let ((alt-event (new 'stack-no-clear 'event-message-block)))
          (set! (-> alt-event from) self)
          (set! (-> alt-event num-params) 0)
          (set! (-> alt-event message) 'trigger)
          (let ((send-alt-event send-event-function)
                (alt-actor (entity-actor-lookup (-> self entity) 'alt-actor alt-i)))
            (send-alt-event (if alt-actor (-> alt-actor extra process)) alt-event))))
      (when (and (battlecontroller-special-contents?) (not (battlecontroller-special-contents-collected?)))
        (label cfg-15)
        (birth-pickup-at-point (-> self final-pickup-spawn-point)
                               (-> self final-pickup-type)
                               (the float (-> self entity extra perm task))
                               #f
                               self
                               (the-as fact-info #f))
        (when (not (-> self child))
          (suspend)
          (goto cfg-15))
        (while (-> self child)
          (suspend))
        (battlecontroller-set-special-contents-collected))
      (while (-> self child)
        (suspend))
      (process-entity-status! self (entity-perm-status dead) #t))
  :post #f)

(defmethod relocate ((this battlecontroller) (offset int))
  "Relocate each initialized spawner path and the optional bulk-spawn path, then relocate the
   process through the parent method."
  (dotimes (i (-> this spawner-count))
    (let ((spawner (-> this spawner-array i))) (if (nonzero? (-> spawner path)) (&+! (-> spawner path) offset))))
  (if (nonzero? (-> this path-spawn)) (&+! (-> this path-spawn) offset))
  (call-parent-method this offset))

(defmethod deactivate ((this battlecontroller))
  "Restore encounter music and linked kill actors before ordinary process deactivation."
  (with-pp
    (let ((saved-pp pp)) (set! pp this) (battlecontroller-off) (set! pp saved-pp))
    (call-parent-method this)
    0
    (none)))

(defmethod setup-paths-and-params! ((this battlecontroller))
  "Create the encounter's paths and default drop, bind linked spawner actors, and read enemy
   counts, weighted types, per-type pickup limits, delay, final pickup, and prespawn mode from
   the entity resources."
  (set! (-> this fact) (new 'process 'fact-info this (pickup-type eco-pill-random) (-> *FACT-bank* default-pill-inc)))
  (set! (-> this path) (new 'process 'path-control this 'path 0.0))
  (logior! (-> this path flags) (path-control-flag display draw-line draw-point draw-text))
  (set! (-> this activate-distance) 122880.0)
  (let ((valid-spawner-count 0))
    (let* ((path-name-list '(patha pathb pathc pathd pathe pathf pathg pathh))
           (path-name (car path-name-list)))
      (while (not (null? path-name-list))
        (let ((path-resource (res-lump-struct (-> this entity) (the-as symbol path-name) structure))
              (spawner (-> this spawner-array valid-spawner-count)))
          (when (and path-resource (< valid-spawner-count 8))
            (set! (-> spawner path) (new 'process 'path-control this (the-as symbol path-name) 0.0))
            (set! (-> spawner creature) (the-as handle #f))
            (set! (-> spawner trigger-actor) #f)
            (set! (-> spawner blocker-actor) #f)
            (set! (-> spawner enabled) #t)
            (logior! (-> spawner path flags) (path-control-flag display draw-line draw-point draw-text))
            (+! valid-spawner-count 1)))
        (set! path-name-list (cdr path-name-list))
        (set! path-name (car path-name-list))))
    (set! (-> this spawner-count) valid-spawner-count))
  0
  (if (res-lump-struct (-> this entity) 'pathspawn structure)
    (set! (-> this path-spawn) (new 'process 'path-control this 'pathspawn 0.0)))
  (let ((trigger-actor-count (entity-actor-count (-> this entity) 'spawner-trigger-actor)))
    (dotimes (trigger-idx trigger-actor-count)
      (if (< trigger-idx (-> this spawner-count))
        (set! (-> this spawner-array trigger-idx trigger-actor)
              (entity-actor-lookup (-> this entity) 'spawner-trigger-actor trigger-idx)))))
  (let ((blocker-actor-count (entity-actor-count (-> this entity) 'spawner-blocker-actor)))
    (dotimes (blocker-idx blocker-actor-count)
      (if (< blocker-idx (-> this spawner-count))
        (set! (-> this spawner-array blocker-idx blocker-actor)
              (entity-actor-lookup (-> this entity) 'spawner-blocker-actor blocker-idx)))))
  (set! (-> this spawn-period)
        (the-as time-frame (the int (* 300.0 (res-lump-float (-> this entity) 'delay :default 0.1)))))
  (set! (-> this target-count) 10)
  (set! (-> this max-spawn-count) 100)
  (set! (-> this spawn-count) 0)
  (set! (-> this die-count) 0)
  (set! (-> this creature-type-count) 1)
  (set! (-> this noticed-player) #f)
  (set! (-> this camera-on) #f)
  (let ((spawn-limits (res-lump-data (-> this entity) 'num-lurkers (pointer int32))))
    (when spawn-limits
      (set! (-> this target-count) (-> spawn-limits 0))
      (set! (-> this max-spawn-count) (-> spawn-limits 1))))
  (set! (-> this creature-type-array 0 type2) babak)
  (set! (-> this creature-type-array 0 percent) 1.0)
  (let ((valid-type-count 0))
    (let* ((lurker-type-tag (new 'static 'res-tag))
           (enemy-type-data (res-lump-data (-> this entity) 'lurker-type pointer :tag-ptr (& lurker-type-tag))))
      (when enemy-type-data
        ;; The creature-type array has room for four nonzero entries.
        (dotimes (type-i (the-as int (-> lurker-type-tag elt-count)))
          (let ((enemy-type-value (-> (the-as (pointer uint32) (&+ enemy-type-data (* type-i 4))))))
            (when (nonzero? enemy-type-value)
              (set! (-> this creature-type-array valid-type-count type2) (the-as type enemy-type-value))
              (+! valid-type-count 1))))))
    (set! (-> this creature-type-count) valid-type-count))
  (let ((percent-data (res-lump-data (-> this entity) 'percent pointer))
        (percent-sum 0.0))
    (when percent-data
      (dotimes (percent-i (-> this creature-type-count))
        (set! (-> this creature-type-array percent-i percent)
              (fabs (-> (the-as (pointer float) (&+ percent-data (* percent-i 4))))))
        (+! percent-sum (-> this creature-type-array percent-i percent)))
      (cond
        ((= percent-sum 0.0) (set! (-> this creature-type-count) 1) (set! (-> this creature-type-array 0 percent) 1.0))
        (else
         (let ((percent-scale (/ 1.0 percent-sum)))
           ;; This scales entry zero once per creature type. Non-unit input totals therefore do not
           ;; produce a normalized table; the weighted selector below uses the resulting values.
           (dotimes (normalize-i (-> this creature-type-count))
             (set! (-> this creature-type-array 0 percent) (* (-> this creature-type-array 0 percent) percent-scale))))))))
  (set! (-> this final-pickup-type)
        (res-lump-value (-> this entity) 'final-pickup pickup-type :default (the-as uint128 7)))
  (let ((pickup-type-data (res-lump-data (-> this entity) 'pickup-type pointer))
        (max-pickup-count-data (res-lump-data (-> this entity) 'max-pickup-count pointer))
        (pickup-percent-data (res-lump-data (-> this entity) 'pickup-percent pointer)))
    (dotimes (pickup-i (-> this creature-type-count))
      (let ((enemy-config (-> this creature-type-array pickup-i)))
        (set! (-> enemy-config pickup-count) 0)
        (if pickup-type-data
          (set! (-> enemy-config pickup-type)
                (the-as pickup-type (-> (the-as (pointer int32) (&+ pickup-type-data (* pickup-i 4)))))))
        (if max-pickup-count-data
          (set! (-> enemy-config max-pickup-count) (-> (the-as (pointer int32) (&+ max-pickup-count-data (* pickup-i 4))))))
        (if pickup-percent-data
          (set! (-> enemy-config pickup-percent) (-> (the-as (pointer float) (&+ pickup-percent-data (* pickup-i 4)))))))))
  (set! (-> this misty-ambush-collision-hack) #f)
  (set! (-> this disable-ocean) #f)
  (set! (-> this disable-mid-ocean) #f)
  (set! (-> this disable-near-ocean) #t)
  (set! (-> this final-pickup-spawn-point quad) (-> this root trans quad))
  (set! (-> this prespawn) (= (res-lump-value (-> this entity) 'mode uint128) 1))
  0
  (none))

(defmethod cleanup-if-finished! ((this battlecontroller))
  "Enter the completion state when this encounter was already finished, otherwise wait idle."
  (if (battlecontroller-task-completed?)
    (go (method-of-object this battlecontroller-die))
    (go (method-of-object this battlecontroller-idle)))
  0
  (none))

(defmethod init-from-entity! ((this battlecontroller) (source-entity entity-actor))
  "Initialize the controller as an enemy process with a transform root, read its encounter
   paths and parameters, and enter the state selected by persistent completion."
  (logior! (-> this mask) (process-mask enemy))
  (set! (-> this root) (new 'process 'trsqv))
  (process-drawable-from-entity! this source-entity)
  (setup-paths-and-params! this)
  (cleanup-if-finished! this)
  (none))

;;-*-Lisp-*-
(in-package goal)
(bundles "DEM.DGO" "TIT.DGO")
(require "engine/gfx/sprite/sparticle/sparticle-launcher.gc")
(require "engine/ui/hud-h.gc")
(require "engine/game/settings.gc")

;; DECOMP BEGINS

(deftype static-screen (process)
  "A full-screen card assembled from three screen-space particles and faded through background
   alpha settings."
  ((part sparticle-launch-control 1)
   (state-time time-frame))
  (:state-methods (idle int time-frame symbol)))

(defmethod relocate ((this static-screen) (offset int))
  "Relocate the process allocation and its particle launch-control pointer."
  (let ((context *kernel-context*))
    (set! (-> context relocating-process) this)
    (set! (-> context relocating-min) (the-as int (&-> this type)))
    (set! (-> context relocating-max)
          (the-as int (+ (+ (-> this allocated-length) -4 (-> process size)) (the-as int this))))
    (set! (-> context relocating-offset) offset))
  (dotimes (i 1)
    (if (nonzero? (-> this part i)) (&+! (-> this part i) offset)))
  (the-as static-screen ((method-of-type process relocate) this offset)))

(defmethod deactivate ((this static-screen))
  "Free the screen particles, then perform ordinary process deactivation."
  (dotimes (i 1)
    (if (nonzero? (-> this part i)) (kill-and-free-particles (-> this part i))))
  ((method-of-type process deactivate) this)
  (none))

(defpart 2966
  :init-specs
  ((:texture (new 'static 'texture-id :page #x5c6))
   (:num 1.0)
   (:y (meters 1.18))
   (:scale-x (meters 15))
   (:scale-y (meters 6.5))
   (:r 128.0)
   (:g 128.0)
   (:b 128.0)
   (:a 128.0)
   (:timer (seconds -0.005))
   (:flags (die-when-faded write-depth run-while-paused))))

(defpart 2967
  :init-specs
  ((:texture (new 'static 'texture-id :index #x1 :page #x5c6))
   (:num 1.0)
   (:y (meters -1.264))
   (:scale-x (meters 15))
   (:scale-y (meters 3.25))
   (:r 128.0)
   (:g 128.0)
   (:b 128.0)
   (:a 128.0)
   (:timer (seconds -0.005))
   (:flags (die-when-faded write-depth run-while-paused))))

(defpart 2968
  :init-specs
  ((:texture (new 'static 'texture-id :index #x2 :page #x5c6))
   (:num 1.0)
   (:y (meters -2.482))
   (:scale-x (meters 15))
   (:scale-y (meters 1.625))
   (:r 128.0)
   (:g 128.0)
   (:b 128.0)
   (:a 128.0)
   (:timer (seconds -0.005))
   (:flags (die-when-faded write-depth run-while-paused))))

(defpartgroup group-part-screen1
  :id 707
  :flags (screen-space)
  :bounds (static-bspherem 0 0 0 1)
  :parts ((sp-item 2966 :flags (launch-asap)) (sp-item 2967 :flags (launch-asap)) (sp-item 2968 :flags (launch-asap))))

(defstate idle (static-screen)
  :virtual #t
  :enter
    (behavior ((page-index int) (duration time-frame) (dismissible? symbol))
      "Fade the background out and select the requested common texture page."
      (set! (-> *setting-control* current bg-a) 1.0)
      (set! (-> *setting-control* default bg-a) 0.0)
      (add-setting! 'common-page 'set 0.0 (ash 1 (+ page-index 1))))
  :trans
    (behavior ()
      "Hide the HUD and spawn the three screen particles."
      (hide-hud-quick)
      (spawn (-> self part 0) *zero-vector*)
      0)
  :code
    (behavior ((page-index int) (duration time-frame) (dismissible? symbol))
      "Wait for duration or an allowed button dismissal, fade the background back in, and
       release the texture page."
      (local-vars (done? symbol))
      (set-time! (-> self state-time))
      (until done?
        (suspend)
        (set! done?
              (or (and (> duration 0) (time-elapsed? (-> self state-time) duration))
                  (and dismissible?
                       (time-elapsed? (-> self state-time) (seconds 1))
                       (cpad-pressed? 0 select start triangle circle x square)))))
      (set! (-> *setting-control* default bg-a) 1.0)
      (while (!= (-> *setting-control* current bg-a) (-> *setting-control* default bg-a))
        (suspend))
      (remove-setting! 'common-page)
      (suspend)
      0))

(defbehavior static-screen-init-by-other static-screen ((page-index int)
              (top-texture texture-id)
              (middle-texture texture-id)
              (bottom-texture texture-id)
              (duration time-frame)
              (dismissible? symbol))
  "Bind the three texture ids to the shared screen particle group and enter idle with the requested
   page, duration, and dismissal policy."
  (let ((screen-group (lookup-part-group-by-name "group-part-screen1")))
    (when (and screen-group (nonzero? screen-group) (type-type? (-> screen-group type) sparticle-launch-group))
      (set! (-> *part-id-table* 2966 init-specs 0 initial-valuef) (the-as float top-texture))
      (set! (-> *part-id-table* 2967 init-specs 0 initial-valuef) (the-as float middle-texture))
      (set! (-> *part-id-table* 2968 init-specs 0 initial-valuef) (the-as float bottom-texture))
      (set! (-> self part 0) (create-launch-control (the-as sparticle-launch-group screen-group) self))
      (go-virtual idle page-index duration dismissible?)))
  0
  (none))

(defun static-screen-spawn ((page-index int)
        (top-texture texture-id)
        (middle-texture texture-id)
        (bottom-texture texture-id)
        (duration time-frame)
        (dismissible? symbol)
        (owner process-tree))
  "Spawn a three-texture static screen for owner, keep it for duration, and optionally allow
   dismissal after one second."
  (process-spawn static-screen page-index top-texture middle-texture bottom-texture duration dismissible? :to owner))

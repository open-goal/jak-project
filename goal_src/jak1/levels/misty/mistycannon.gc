;; DECOMP BEGINS

;; Angles use the engine's signed 16-bit turn units. A nonzero range makes value relative to min
;; and clamps it to the configured arc; a zero range leaves the tracker free to wrap continuously.
(deftype angle-tracker (structure)
  ((value float)
   (min   float)
   (range float)
   (speed float)))

(defun angle-tracker-apply-move! ((tracker angle-tracker) (input float))
  "Advance a tracker's relative angle by input times speed times seconds-per-frame. Clamp bounded
   trackers and wrap unbounded trackers in 16-bit angle space; return old value minus new value."
  (let* ((step (* input (-> tracker speed) (seconds-per-frame)))
         (new-value (+ (-> tracker value) step)))
    (when (!= (-> tracker range) 0.0)
      (if (< new-value 0.0) (set! new-value 0.0))
      (if (< (-> tracker range) new-value) (set! new-value (-> tracker range))))
    (let ((applied-delta (- (-> tracker value) new-value)))
      (if (= (-> tracker range) 0.0) (set! new-value (the float (sar (shl (the int new-value) 48) 48))))
      (set! (-> tracker value) new-value)
      applied-delta)))

(defun angle-tracker-init-range! ((tracker angle-tracker) (min-angle float) (max-angle float) (speed float))
  "Initialize a tracker with wrapped 16-bit angular bounds min-angle and max-angle, place its
   current value halfway through that range, and set its frame-scaled angular speed."
  (set! (-> tracker min) min-angle)
  (set! (-> tracker range) (the float (sar (shl (the int (- max-angle min-angle)) 48) 48)))
  (if (< (-> tracker range) 0.0) (+! (-> tracker range) 65536.0))
  (set! (-> tracker value) (/ (-> tracker range) 2))
  (set! (-> tracker speed) speed)
  0
  (none))

(defun angle-tracker-get-value ((tracker angle-tracker))
  "Return the tracker's absolute angle, wrapping min plus its relative value to signed 16-bit angle
   space."
  (the float (sar (shl (the int (+ (-> tracker min) (-> tracker value))) 48) 48)))

(defun angle-tracker-set-value ((tracker angle-tracker) (angle float))
  "Set an absolute angle by subtracting the tracker's minimum and clamping the relative value when
   bounded. Return min plus the stored relative value."
  (let ((relative-value (- angle (-> tracker min))))
    (when (!= (-> tracker range) 0.0)
      (if (< relative-value 0.0) (set! relative-value 0.0))
      (if (< (-> tracker range) relative-value) (set! relative-value (-> tracker range))))
    (set! (-> tracker value) relative-value)
    (+ (-> tracker min) relative-value)))

(defun angle-tracker-seek! ((tracker angle-tracker) (target-angle float))
  "Move the tracker toward target-angle by at most speed times seconds-per-frame, using the shortest
   signed difference in 16-bit angle space. Return true only when the target is reached without
   crossing a bounded tracker's endpoint."
  (local-vars (new-value float))
  (let* ((current-angle (the float (sar (shl (the int (+ (-> tracker min) (-> tracker value))) 48) 48)))
         (max-step (* (-> tracker speed) (seconds-per-frame)))
         (angle-delta (the float (sar (shl (the int (- target-angle current-angle)) 48) 48))))
    (when (< (fabs angle-delta) max-step)
      (set! new-value (+ (-> tracker value) angle-delta))
      (cond
        ((= (-> tracker range) 0.0) (set! (-> tracker value) (the float (sar (shl (the int new-value) 48) 48))) (return #t))
        (else
         (when (< new-value 0.0)
           (set! (-> tracker value) 0.0)
           (return #f))
         (when (< (-> tracker range) new-value)
           (set! (-> tracker value) (-> tracker range))
           (return #f))
         (set! (-> tracker value) new-value)
         (return #t)))
      (set! angle-delta (the-as float 0)))
    (cond
      ((< angle-delta 0.0)
       (set! new-value (- (-> tracker value) max-step))
       (set! new-value
             (cond
               ((= (-> tracker range) 0.0) (the float (sar (shl (the int new-value) 48) 48)))
               (else (if (< new-value 0.0) (set! new-value 0.0)) new-value)))
       (set! (-> tracker value) (the float (sar (shl (the int new-value) 48) 48))))
      (else
       (set! new-value (+ (-> tracker value) max-step))
       (set! new-value
             (cond
               ((= (-> tracker range) 0.0) (the float (sar (shl (the int new-value) 48) 48)))
               (else (if (< (-> tracker range) new-value) (set! new-value (-> tracker range))) new-value)))
       (set! (-> tracker value) (the float (sar (shl (the int new-value) 48) 48))))))
  #f)


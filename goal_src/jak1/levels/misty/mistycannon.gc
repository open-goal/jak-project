(deftype mistycannon-missile (process-drawable)
  ((root         collide-shape-moving :override)
   (muzzle-time  float)
   (tumble-quat  quaternion :inline)
   (blast-radius float)
   (water-height float)
   (sfx          uint32)
   (part2        sparticle-launch-control)
   (ground-time  time-frame))
  (:methods
   (spawn-part (_type_) none))
  (:states
   mistycannon-missile-explode
   mistycannon-missile-idle
   mistycannon-missile-in-water))

(defmethod relocate ((this mistycannon-missile) (offset int))
  "Adjust every optional drawable controller owned by this process, then relocate the process
   allocation."
  (if (nonzero? (-> this part2)) (&+! (-> this part2) offset))
  (the-as mistycannon-missile ((method-of-type process-drawable relocate) this offset)))

(defmethod deactivate ((this mistycannon-missile))
  "Stop particles and ambient sound owned by this drawable, then perform the ordinary process
   deactivation."
  (if (nonzero? (-> this part2)) (kill-and-free-particles (-> this part2)))
  ((method-of-type process-drawable deactivate) this)
  (none))

(defskelgroup *mistycannon-missile-sg*
  sack
  sack-lod0-jg
  sack-idle-ja
  ((sack-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 4))

(defmethod spawn-part ((this mistycannon-missile))
  "Spawn the missile's fuse particles at the current position of sack joint 7."
  (let ((fuse-particles (-> this part))
        (fuse-position (vector<-cspace! (new 'stack-no-clear 'vector) (-> this node-list data 7))))
    (spawn fuse-particles fuse-position))
  0
  (none))

;; Keep collision disabled while the sack grows and tumbles through the cannon muzzle. Once it is
;; clear, enable collision, update the incoming positional sound while airborne, and play the impact
;; and fuse animations after the first surface contact.
(defstate mistycannon-missile-idle (mistycannon-missile)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('attack) (go mistycannon-missile-explode))))
  :enter
    (behavior ()
      (set-time! (-> self state-time))
      (set! (-> self sfx) (the-as uint 0))
      0)
  :trans
    (behavior ()
      (if (< (-> self root trans y) (-> self water-height)) (go mistycannon-missile-in-water)))
  :code
    (behavior ()
      (clear-collide-with-as (-> self root))
      (while (not (time-elapsed? (-> self state-time) (the int (* 300.0 (-> self muzzle-time)))))
        (quaternion*! (-> self root quat) (-> self root quat) (-> self tumble-quat))
        (suspend)
        (let ((muzzle-scale (fmin 1.0 (/ (the float (- (current-time) (-> self state-time))) (the float (the int (* 300.0 (-> self muzzle-time))))))))
          (set! (-> self root scale x) (* 0.6 muzzle-scale))
          (set! (-> self root scale y) (* 0.6 muzzle-scale))
          (set! (-> self root scale z) (* 0.6 muzzle-scale))))
      (restore-collide-with-as (-> self root))
      (set-vector! (-> self root scale) 0.6 0.6 0.6 1.0)
      (while (not (logtest? (-> self root status) (collide-status on-surface)))
        (if (and (zero? (-> self sfx))
                 (< (if *target* (vector-vector-distance (-> self root trans) (-> *target* control trans)) 4096000.0) 409600.0))
          (set! (-> self sfx) (the-as uint (sound-play "sack-incoming" :position (the-as symbol (-> self root trans))))))
        (when (nonzero? (-> self sfx))
          (let ((sound-update (the-as sound-rpc-set-param (get-sound-buffer-entry))))
            (set! (-> sound-update command) (sound-command set-param))
            (set! (-> sound-update id) (the-as sound-id (-> self sfx)))
            (let ((sound-position (-> self root trans)))
              (let ((sound-owner self))
                (when (= sound-position #t)
                  (if (and sound-owner (type-type? (-> sound-owner type) process-drawable) (nonzero? (-> sound-owner root)))
                    (set! sound-position (-> sound-owner root trans))
                    (set! sound-position (the-as vector #f)))))
              (sound-trans-convert (-> sound-update parms trans) sound-position))
            (set! (-> sound-update parms mask) (sound-mask trans))
            (-> sound-update id)))
        (quaternion*! (-> self root quat) (-> self root quat) (-> self tumble-quat))
        (suspend))
      (quaternion-set! (-> self root quat) 0.0 0.0 0.0 1.0)
      (update-transforms! (-> self root))
      (when (nonzero? (-> self sfx))
        (sound-stop (the-as sound-id (-> self sfx)))
        (set! (-> self sfx) (the-as uint 0))
        0)
      (set-time! (-> self ground-time))
      (sound-play "sack-land" :position (the-as symbol (-> self root trans)))
      (ja-play :group! sack-hit-ja :num! (seek!) :frame-num 0.0)
      (ja-play :group! sack-fuse-ja :num! (seek!) :frame-num 0.0)
      (go mistycannon-missile-explode))
  :post
    (behavior ()
      (vector-v++! (-> self root transv) (compute-acc-due-to-gravity (-> self root) (new-stack-vector0) 1.0))
      (set! (-> self root root-prim prim-core offense) (collide-offense touch))
      (fill-cache-integrate-and-collide! (-> self root) (-> self root transv) (-> self root root-prim collide-with))
      (set! (-> self root root-prim prim-core offense) (collide-offense indestructible))
      (spawn-part self)
      (when (and (zero? (-> self draw cur-lod)) (logtest? (-> self draw status) (draw-status was-drawn)))
        (if (logtest? (-> self root status) (collide-status on-surface))
          (draw-shadow (-> self root shadow-pos)
                       (-> self root shadow-pos)
                       (-> self root ground-poly-normal)
                       8192.0
                       4096.0
                       (the-as float 0))
          (find-ground-and-draw-shadow (-> self root trans)
                                       (-> self root shadow-pos)
                                       8192.0
                                       (collide-kind background)
                                       (the-as process-drawable #f)
                                       0.0
                                       81920.0)))
      (ja-post)))

(defstate mistycannon-missile-in-water (mistycannon-missile)
  :code
    (behavior ()
      (when (nonzero? (-> self sfx))
        (sound-stop (the-as sound-id (-> self sfx)))
        (set! (-> self sfx) (the-as uint 0))
        0)
      (let ((splash-position (new-stack-vector0)))
        (set! (-> splash-position x) (-> self root trans x))
        (set! (-> splash-position y) (-> self water-height))
        (set! (-> splash-position z) (-> self root trans z))
        (set! (-> splash-position w) 1.0)
        (splash-spawn (the-as basic 1.0) (the-as basic splash-position) 1))
      (label cfg-3)
      (vector-v++! (-> self root transv) (compute-acc-due-to-gravity (-> self root) (new-stack-vector0) 1.0))
      (vector-float*! (-> self root transv) (-> self root transv) 0.5)
      (update-transforms! (-> self root))
      (fill-cache-integrate-and-collide! (-> self root) (-> self root transv) (-> self root root-prim collide-with))
      (seek! (-> self root scale x) 0.0 (/ (-> *display* time-adjust-ratio) 100))
      (seek! (-> self root scale y) 0.0 (/ (-> *display* time-adjust-ratio) 100))
      (seek! (-> self root scale z) 0.0 (/ (-> *display* time-adjust-ratio) 100))
      (when (< 0.05 (-> self root scale x))
        (suspend)
        (goto cfg-3))
      (ja-channel-set! 0))
  :post ja-post)

;; The expanded sphere collects every blast target at once. A narrow line-sphere probe from the
;; blast center to each touched shape rejects targets hidden by background collision before the
;; explosion attack is sent.
(defstate mistycannon-missile-explode (mistycannon-missile)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('touched)
         (let* ((touched-process proc)
                (touched-drawable (if (and (nonzero? touched-process) (type-type? (-> touched-process type) process-drawable)) touched-process)))
           (when touched-drawable
             (let* ((touched-shape (-> (the-as mistycannon-missile touched-drawable) root))
                    (missile-core (-> self root root-prim prim-core))
                    (touched-core (-> touched-shape root-prim prim-core))
                    (line-to-target (new 'stack-no-clear 'vector))
                    (line-hit (new 'stack-no-clear 'collide-tri-result)))
               0.0
               (vector-! line-to-target (-> touched-core world-sphere) (-> missile-core world-sphere))
               (when (< (fill-and-probe-using-line-sphere *collide-cache*
                                                          (-> missile-core world-sphere)
                                                          line-to-target
                                                          40.96
                                                          (collide-kind background)
                                                          self
                                                          line-hit
                                                          (new 'static 'pat-surface :noentity #x1))
                        0.0)
                 (cond
                   ((= (-> proc type) target) (send-event proc 'attack (-> block param 0) (static-attack-info ((mode 'explode)))))
                   (else
                    (let ((attack-event (new 'stack-no-clear 'event-message-block)))
                      (set! (-> attack-event from) self)
                      (set! (-> attack-event num-params) 4)
                      (set! (-> attack-event message) 'attack)
                      (set! (-> attack-event param 0) (-> block param 0))
                      (set! (-> attack-event param 1) (the-as uint 'explode))
                      (let ((attack-id (+ *global-attack-id* 1)))
                        (set! *global-attack-id* attack-id)
                        (set! (-> attack-event param 2) (the-as uint attack-id)))
                      (set! (-> attack-event param 3) (the-as uint 0))
                      (send-event-function proc attack-event)))))))))))
  :code
    (behavior ()
      (if (and *target* (= (-> *target* next-state name) 'target-periscope))
        (sound-play-by-spec (static-sound-spec "explosion" :fo-min 200 :fo-max 400) (new-sound-id) (the-as vector #t))
        (sound-play-by-spec (static-sound-spec "explosion") (new-sound-id) (the-as vector #t)))
      (spawn (-> self part2) (-> self root trans))
      (ja-channel-set! 0)
      (let ((explosion-sphere (-> self root root-prim)))
        (set! (-> explosion-sphere local-sphere w) (-> self blast-radius))
        (set! (-> explosion-sphere prim-core world-sphere w) (-> self blast-radius))
        (set! (-> explosion-sphere collide-with) (collide-kind cak-2 cak-3 target crate enemy wall-object))
        (set! (-> explosion-sphere prim-core collide-as) (collide-kind enemy)))
      (update-transforms! (-> self root))
      (let ((overlap-params (new 'stack-no-clear 'overlaps-others-params)))
        (set! (-> overlap-params options) (overlaps-others-options))
        (set! (-> overlap-params tlist) *touching-list*)
        (find-overlapping-shapes (-> self root) overlap-params))
      (suspend)
      (clear-collide-with-as (-> self root))
      (suspend-for (seconds 3)
        (spawn (-> self part2) (-> self root trans)))
      (kill-and-free-particles (-> self part2))
      (deactivate self))
  :post ja-post)

(defun mistycannon-collision-reaction ((shape collide-shape-moving) (collision collide-shape-intersect) (unused-position vector) (unused-velocity vector))
  "Move through the collision's accepted fraction, reflect velocity about the hit triangle normal,
   damp the result to 15 percent, and report the contact status bits used to end the airborne loop."
  (let ((contact-status 0))
    (let ((accepted-move (new 'stack-no-clear 'vector)))
      (vector-float*! accepted-move (-> collision move-vec) (-> collision best-u))
      (move-by-vector! shape accepted-move))
    (let ((normal-speed (vector-dot (-> shape transv) (-> collision best-tri normal)))
          (normal-impulse (new 'stack-no-clear 'vector)))
      (vector-float*! normal-impulse (-> collision best-tri normal) (* 2.0 normal-speed))
      (vector-! (-> shape transv) (-> shape transv) normal-impulse))
    (vector-float*! (-> shape transv) (-> shape transv) 0.15)
    (let ((result-status (logior contact-status 7)))
      (logior! (-> shape status) result-status)
      (the-as collide-status result-status))))

(deftype mistycannon-init-data (structure)
  ((pos          vector)
   (vel          vector)
   (rotate       float)
   (flight-time  float)
   (muzzle-time  float)
   (blast-radius float)))

(defbehavior mistycannon-missile-init-by-other mistycannon-missile ((init-data mistycannon-init-data) (source-entity entity-actor))
  "Create the missile's moving spherical collision, copy its launch transform and velocity, derive
   its per-frame tumble from the expected flight time, initialize art and fuse/explosion particles,
   read the water height, and enter the airborne state."
  (logior! (-> self mask) (process-mask projectile))
  (logclear! (-> self mask) (process-mask actor-pause))
  (set! (-> self entity) source-entity)
  (let ((moving-shape (new 'process 'collide-shape-moving self (collide-list-enum hit-by-player))))
    (set! (-> moving-shape dynam) (copy *standard-dynamics* 'process))
    (set! (-> moving-shape reaction) mistycannon-collision-reaction)
    (set! (-> moving-shape no-reaction)
          (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (let ((collision-sphere (new 'process 'collide-shape-prim-sphere moving-shape (the-as uint 0))))
      (set! (-> collision-sphere prim-core collide-as) (collide-kind enemy))
      (set! (-> collision-sphere collide-with) (collide-kind background cak-2 cak-3 target crate enemy wall-object))
      (set! (-> collision-sphere prim-core action) (collide-action solid))
      (set! (-> collision-sphere prim-core offense) (collide-offense touch))
      (set! (-> collision-sphere transform-index) 0)
      (set-vector! (-> collision-sphere local-sphere) 0.0 0.0 0.0 1720.3201)
      (set-root-prim! moving-shape collision-sphere))
    (set! (-> moving-shape nav-radius) (* 0.75 (-> moving-shape root-prim local-sphere w)))
    (backup-collide-with-as moving-shape)
    (set! (-> moving-shape event-self) 'touched)
    (set! (-> moving-shape max-iteration-count) (the-as uint 4))
    (set! (-> self root) moving-shape))
  (vector-copy! (-> self root trans) (-> init-data pos))
  (set-vector! (-> self root scale) 0.0 0.0 0.0 1.0)
  (set! (-> self muzzle-time) (-> init-data muzzle-time))
  (quaternion-axis-angle! (-> self root quat) 0.0 1.0 0.0 (-> init-data rotate))
  (let ((tumble-per-frame (/ 655360.0 (the float (the int (* 300.0 (-> init-data flight-time)))))))
    (quaternion-axis-angle! (-> self tumble-quat) 1.0 0.0 0.0 tumble-per-frame))
  (initialize-skeleton self *mistycannon-missile-sg* '())
  (vector-copy! (-> self root transv) (-> init-data vel))
  (set! (-> self blast-radius) (-> init-data blast-radius))
  (set! (-> self water-height) (res-lump-float (-> self entity) 'water-height :default -4096000.0))
  (set! (-> self part) (create-launch-control group-beach-sack-fuse self))
  (set! (-> self part2) (create-launch-control group-beach-sack-explosion self))
  (go mistycannon-missile-idle)
  (none))

(defun spawn-mistycannon-missile ((parent process-tree)
        (position vector)
        (velocity vector)
        (yaw float)
        (flight-time float)
        (muzzle-time float)
        (blast-radius float)
        (source-entity entity))
  "Package position, velocity, yaw, expected flight time, muzzle-growth time, and blast radius,
   then spawn a cannon missile under parent on behalf of source-entity."
  (let ((init-data (new 'stack-no-clear 'mistycannon-init-data)))
    (set! (-> init-data pos) position)
    (set! (-> init-data vel) velocity)
    (set! (-> init-data rotate) yaw)
    (set! (-> init-data flight-time) flight-time)
    (set! (-> init-data muzzle-time) muzzle-time)
    (set! (-> init-data blast-radius) blast-radius)
    (process-spawn mistycannon-missile init-data source-entity :to parent))
  0
  (none))

(deftype mistycannon (process-drawable)
  ((root                   collide-shape-moving :override)
   (fact                   fact-info-enemy :override)
   (rotate                 angle-tracker :inline)
   (tilt                   angle-tracker :inline)
   (front-wheel            float)
   (rear-wheel             float)
   (last-known-rotation    float)
   (part-timer             time-frame)
   (hellmouth              vector :inline)
   (postbindinfo-ok        symbol)
   (launch-origin          vector :inline)
   (goggles                vector :inline)
   (avoid-entity           entity-actor)
   (center-point           vector :inline)
   (at-point               vector :inline)
   (accuracy-range         float)
   (target-theta           float)
   (sound-id               sound-id)
   (aim-sound-id           sound-id)
   (player-touching-grips? symbol))
  (:methods
   (rotate! (_type_ float) none)
   (tilt! (_type_ float) none)
   (fire! (_type_ float float float) none)
   (spawn-muzzle-part! (_type_) none))
  (:states
   mistycannon-aim-at-player
   mistycannon-idle
   mistycannon-player-control
   mistycannon-waiting-for-player
   mistycannon-waiting-for-player-to-fuck-off))

(defbehavior mistycannon-pick-random-target-point mistycannon ()
  "Choose a uniformly distributed point in the horizontal target disk stored in center-point, and
   choose a random target pitch between 15 and 70 degrees."
  (let ((target-radius (* (sqrtf (rand-vu)) (-> self center-point w)))
        (target-angle (* 65536.0 (rand-vu))))
    (set! (-> self at-point x) (+ (-> self center-point x) (* target-radius (cos target-angle))))
    (set! (-> self at-point y) (-> self center-point y))
    (set! (-> self at-point z) (+ (-> self center-point z) (* target-radius (sin target-angle)))))
  (set! (-> self at-point w) 1.0)
  (set! (-> self target-theta) (rand-vu-float-range 2730.6667 12743.111))
  (none))

(defmethod rotate! ((this mistycannon) (input float))
  "Apply a frame-scaled yaw input to the cannon's bounded rotation tracker."
  (angle-tracker-apply-move! (-> this rotate) input)
  0
  (none))

(defmethod tilt! ((this mistycannon) (input float))
  "Apply a frame-scaled pitch input to the cannon's bounded tilt tracker."
  (angle-tracker-apply-move! (-> this tilt) input)
  0
  (none))

;; WARN: Function (method 22 mistycannon) has a return type of none, but the expression builder found a return statement.
(defmethod fire! ((this mistycannon) (launch-speed float) (flight-time float) (blast-radius float))
  "Fire from the current bound muzzle transform at launch-speed. Build the velocity from the
   cannon's yaw and pitch, place hellmouth 24576 units of travel from the muzzle for the flash,
   spawn a missile with flight-time and blast-radius, play the shot, restart muzzle particles,
   and choose the next automatic target. Do nothing until postbinding has supplied a muzzle
   position."
  (if (not (-> this postbindinfo-ok)) (return #f))
  (let* ((origin (-> this launch-origin))
         (launch-velocity (new 'stack-no-clear 'vector))
         (yaw-tracker (-> this rotate))
         (yaw (the float (sar (shl (the int (+ (-> yaw-tracker min) (-> yaw-tracker value))) 48) 48)))
         (pitch-tracker (-> this tilt))
         (pitch (the float (sar (shl (the int (+ (-> pitch-tracker min) (-> pitch-tracker value))) 48) 48)))
         (muzzle-time (/ 24576.0 launch-speed)))
    (let ((cos-pitch (cos pitch)))
      (set! (-> launch-velocity x) (* launch-speed cos-pitch (sin yaw)))
      (set! (-> launch-velocity z) (* launch-speed cos-pitch (cos yaw))))
    (set! (-> launch-velocity y) (* launch-speed (sin pitch)))
    (vector-float*! (-> this hellmouth) launch-velocity muzzle-time)
    (vector+! (-> this hellmouth) (-> this hellmouth) origin)
    (spawn-mistycannon-missile this origin launch-velocity yaw flight-time muzzle-time blast-radius (-> this entity)))
  (sound-play "cannon-shot")
  (set! (-> this part local-clock) 0)
  (set-time! (-> this part-timer))
  (mistycannon-pick-random-target-point)
  0
  (none))

(defmethod spawn-muzzle-part! ((this mistycannon))
  "For three seconds after a shot, update the smoke, flash, and debris particle launch angles
   from the cannon's current yaw and pitch and spawn them at hellmouth."
  (when (not (time-elapsed? (-> this part-timer) (seconds 3)))
    (let ((yaw-tracker (-> this rotate)))
      (set! (-> *part-id-table* 529 init-specs 24 initial-valuef)
            (the float (sar (shl (the int (+ (-> yaw-tracker min) (-> yaw-tracker value))) 48) 48)))
      (set! yaw-tracker (-> this rotate))
      (set! (-> *part-id-table* 530 init-specs 23 initial-valuef)
            (the float (sar (shl (the int (+ (-> yaw-tracker min) (-> yaw-tracker value))) 48) 48)))
      (set! yaw-tracker (-> this rotate))
      (set! (-> *part-id-table* 534 init-specs 21 initial-valuef)
            (the float (sar (shl (the int (+ (-> yaw-tracker min) (-> yaw-tracker value))) 48) 48))))
    (let ((quarter-turn 16384.0)
          (pitch-tracker (-> this tilt)))
      (set! (-> *part-id-table* 529 init-specs 22 initial-valuef)
            (- quarter-turn (the float (sar (shl (the int (+ (-> pitch-tracker min) (-> pitch-tracker value))) 48) 48))))
      (set! quarter-turn 16384.0)
      (set! pitch-tracker (-> this tilt))
      (set! (-> *part-id-table* 530 init-specs 21 initial-valuef)
            (- quarter-turn (the float (sar (shl (the int (+ (-> pitch-tracker min) (-> pitch-tracker value))) 48) 48))))
      (set! quarter-turn 16384.0)
      (set! pitch-tracker (-> this tilt))
      (set! (-> *part-id-table* 534 init-specs 20 initial-valuef)
            (- quarter-turn (the float (sar (shl (the int (+ (-> pitch-tracker min) (-> pitch-tracker value))) 48) 48)))))
    (spawn (-> this part) (-> this hellmouth)))
  0
  (none))

(defskelgroup *mistycannon-sg*
  mistycannon
  mistycannon-lod0-jg
  mistycannon-idle-ja
  ((mistycannon-lod0-mg (meters 20)) (mistycannon-lod1-mg (meters 999999)))
  :bounds (static-spherem 0 5 0 9)
  :longest-edge (meters 4))

(defun mistycannon-prebind-function ((joint-transforms pointer) (joint-count int) (cannon mistycannon))
  "Write the cannon yaw and pitch into the main and muzzle joint quaternions before skeleton
   binding. Accumulate wheel rotation from the yaw change and write the four wheel quaternions."
  (let ((t9-0 quaternion-axis-angle!)
        (a0-1 (&+ joint-transforms 144))
        (a1-1 0.0)
        (a2-1 1.0)
        (a3-0 0.0)
        (yaw-tracker (-> cannon rotate)))
    (t9-0 (the-as quaternion a0-1)
          a1-1
          a2-1
          a3-0
          (the float (sar (shl (the int (+ (-> yaw-tracker min) (-> yaw-tracker value))) 48) 48)))
    (let ((t9-1 quaternion-axis-angle!)
          (a0-2 (&+ joint-transforms 192))
          (a1-2 -1.0)
          (a2-2 0.0)
          (a3-1 0.0)
          (pitch-tracker (-> cannon tilt)))
      (t9-1 (the-as quaternion a0-2)
            a1-2
            a2-2
            a3-1
            (the float (sar (shl (the int (+ (-> pitch-tracker min) (-> pitch-tracker value))) 48) 48))))
    (set! yaw-tracker (-> cannon rotate))
    (let ((yaw-delta (- (the float (sar (shl (the int (+ (-> yaw-tracker min) (-> yaw-tracker value))) 48) 48))
                        (-> cannon last-known-rotation))))
      (set! (-> cannon front-wheel) (the float (sar (shl (the int (+ (-> cannon front-wheel) (* 5.0 yaw-delta))) 48) 48)))
      (set! (-> cannon rear-wheel) (the float (sar (shl (the int (+ (-> cannon rear-wheel) (* 3.0 yaw-delta))) 48) 48))))
    (set! yaw-tracker (-> cannon rotate))
    (set! (-> cannon last-known-rotation)
          (the float (sar (shl (the int (+ (-> yaw-tracker min) (-> yaw-tracker value))) 48) 48))))
  (quaternion-axis-angle! (the-as quaternion (&+ joint-transforms 432)) -1.0 0.0 0.0 (-> cannon front-wheel))
  (quaternion-axis-angle! (the-as quaternion (&+ joint-transforms 384)) 1.0 0.0 0.0 (-> cannon front-wheel))
  (quaternion-axis-angle! (the-as quaternion (&+ joint-transforms 288)) -1.0 0.0 0.0 (-> cannon rear-wheel))
  (quaternion-axis-angle! (the-as quaternion (&+ joint-transforms 336)) 1.0 0.0 0.0 (-> cannon rear-wheel))
  0
  (none))

(defun mistycannon-postbind-function ((cannon mistycannon))
  "After skeleton binding, copy the muzzle joint's world position into launch-origin and transform
   the camera's local eyepoint from the cannon's main joint into goggles."
  (set! (-> cannon launch-origin quad) (-> cannon node-list data 4 bone transform vector 3 quad))
  (let ((camera-position (new 'stack-no-clear 'vector)))
    (set-vector! camera-position 0.0 53248.0 -4096.0 1.0)
    (vector-matrix*! camera-position camera-position (-> cannon node-list data 3 bone transform))
    (vector-copy! (-> cannon goggles) camera-position))
  (set! (-> cannon postbindinfo-ok) #t)
  0
  (none))

(defstate mistycannon-idle (mistycannon)
  :trans
    (behavior ()
      (if (not (and (-> self entity) (logtest? (-> self entity extra perm status) (entity-perm-status complete))))
        (go mistycannon-waiting-for-player))
      (if (and (-> self postbindinfo-ok)
               *target*
               (>= (-> self fact idle-distance) (vector-vector-distance (-> self root trans) (-> *target* control trans))))
        (go mistycannon-aim-at-player))
      (rider-trans))
  :code
    (behavior ()
      (loop
        (spawn-muzzle-part! self)
        (suspend)))
  :post rider-post)

(deftype quadratic-solution (structure)
  ((s1 float)
   (s2 float)))

(defun solve-missile-tilt ((solution quadratic-solution)
        (launch-speed float)
        (horizontal-distance float)
        (height-difference float)
        (gravity float))
  "Solve the two ballistic launch angles for launch speed, horizontal distance, vertical
   displacement, and positive gravity magnitude. The quadratic is expressed in tan(theta); return
   false when its discriminant is negative, otherwise store both angles and return true."
  (let* ((quadratic-a (* (/ horizontal-distance 2) horizontal-distance gravity))
         (quadratic-c-base quadratic-a)
         (quadratic-b (- (* horizontal-distance launch-speed launch-speed)))
         (quadratic-c (+ quadratic-a (* launch-speed launch-speed height-difference)))
         (discriminant (- (square quadratic-b) (* 4.0 quadratic-c quadratic-c-base)))
         (inverse-two-a (/ 0.5 quadratic-c-base)))
    (if (< discriminant 0.0) (return #f))
    (let ((sqrt-discriminant (sqrtf discriminant)))
      (set! (-> solution s1) (atan (* (+ (- quadratic-b) sqrt-discriminant) inverse-two-a) 1.0))
      (set! (-> solution s2) (atan (* (- (- quadratic-b) sqrt-discriminant) inverse-two-a) 1.0))))
  #t)

(deftype trajectory-params (structure)
  ((x       float)
   (y       float)
   (gravity float)
   (theta   float)
   (speed   float)
   (time    float)))

(defun solve-missile-velocity ((trajectory trajectory-params) (theta float))
  "For horizontal distance x, vertical displacement y, positive gravity magnitude, and launch
   angle theta, solve time^2 = (x * tan(theta) - y) / (gravity / 2). When the time is real and
   positive, store its square root and the required launch speed; otherwise leave time and speed
   unchanged."
  (set! (-> trajectory theta) theta)
  (let ((time-squared (* (- (* (-> trajectory x) (tan theta)) (-> trajectory y)) (/ 2.0 (-> trajectory gravity)))))
    (when (< 0.0 time-squared)
      (set! (-> trajectory time) (sqrtf time-squared))
      (set! (-> trajectory speed) (/ (-> trajectory x) (* (-> trajectory time) (cos theta))))))
  0
  (none))

(defbehavior mistycannon-find-best-solution mistycannon ((solution quadratic-solution))
  "Return the index of a ballistic angle within the cannon's tilt range, preferring the lower valid
   angle when both solutions fit; return -1 when neither fits."
  (let ((first-valid? #t)
        (second-valid? #t)
        (best-index -1))
    (let ((min-tilt (-> self tilt min))
          (max-tilt (+ (-> self tilt range) (-> self tilt min))))
      (if (< (-> solution s1) min-tilt) (set! first-valid? #f))
      (if (< max-tilt (-> solution s1)) (set! first-valid? #f))
      (if (< (-> solution s2) min-tilt) (set! second-valid? #f))
      (if (< max-tilt (-> solution s2)) (set! second-valid? #f)))
    (if first-valid? (set! best-index 0))
    (if second-valid? (set! best-index 1))
    (set! second-valid? (and first-valid? second-valid?))
    (when second-valid?
      (if (< (-> solution s1) (-> solution s2)) (set! best-index 0) (set! best-index 1)))
    best-index))

(defbehavior mistycannon-find-trajectory mistycannon ((trajectory trajectory-params))
  "Clear the trajectory time, then solve speed and flight time for the trajectory's current theta."
  (set! (-> trajectory time) 0.0)
  (solve-missile-velocity trajectory (-> trajectory theta))
  (none))

;; WARN: Function mistycannon-do-aim has a return type of none, but the expression builder found a return statement.
(defbehavior mistycannon-do-aim mistycannon ((target-position vector) (target-velocity vector))
  "Lead target-position by target-velocity using the current estimated flight time, add the
   configured horizontal accuracy error, and seek the cannon toward the resulting yaw and ballistic
   pitch. Fire at most once every three seconds when aimed; use a fixed fallback shot when no
   positive flight time can be found. Do nothing until postbinding is ready or while the target is
   too close to avoid-entity."
  (if (not (-> self postbindinfo-ok)) (return #f))
  (when (-> self avoid-entity)
    (let ((avoid-position (-> self avoid-entity extra trans)))
      (if (< (vector-vector-distance target-position avoid-position) 122880.0) (return #f))))
  (let ((trajectory (new 'stack-no-clear 'trajectory-params)))
    (let ((target-offset (new 'stack-no-clear 'vector)))
      (vector-! target-offset target-position (-> self launch-origin))
      (set! (-> trajectory x) (vector-xz-length target-offset))
      (set! (-> trajectory y) (-> target-offset y)))
    (set! (-> trajectory gravity) (-> *standard-dynamics* gravity-length))
    (set! (-> trajectory speed) 409600.0)
    (set! (-> trajectory theta) (-> self target-theta))
    (mistycannon-find-trajectory trajectory)
    (let ((lead-offset (new 'stack-no-clear 'vector))
          (aim-position (new 'stack-no-clear 'vector)))
      (vector-float*! lead-offset target-velocity (* 0.4 (+ 2.0 (-> trajectory time))))
      (vector+! aim-position target-position lead-offset)
      (let ((miss-radius (* (sqrtf (rand-vu)) (-> self accuracy-range)))
            (miss-angle (* 65536.0 (rand-vu))))
        (+! (-> aim-position x) (* miss-radius (cos miss-angle)))
        (+! (-> aim-position z) (* miss-radius (sin miss-angle))))
      (let ((aim-offset (new 'stack-no-clear 'vector)))
        (vector-! aim-offset aim-position (-> self launch-origin))
        (let ((target-yaw (atan (-> aim-offset x) (-> aim-offset z)))) (angle-tracker-seek! (-> self rotate) target-yaw))
        (set! (-> trajectory x) (vector-xz-length aim-offset))
        (set! (-> trajectory y) (-> aim-offset y))))
    (mistycannon-find-trajectory trajectory)
    (when (= (-> trajectory time) 0.0)
      (when (time-elapsed? (-> self state-time) (seconds 3))
        (fire! self 409600.0 2.0 20480.0)
        (set-time! (-> self state-time)))
      (return #f))
    (when (angle-tracker-seek! (-> self tilt) (-> trajectory theta))
      (when (time-elapsed? (-> self state-time) (seconds 3))
        (fire! self (fmax 163840.0 (fmin 409600.0 (-> trajectory speed))) (-> trajectory time) 20480.0)
        (set-time! (-> self state-time)))))
  0
  (none))

;; Automatic fire leads the target and shoots only while it remains inside the cannon's target
;; disk. Outside that disk, keep firing at the separately randomized point and pitch.
(defstate mistycannon-aim-at-player (mistycannon)
  :enter
    (behavior ()
      (set-time! (-> self state-time)))
  :trans
    (behavior ()
      (if (not (and (-> self entity) (logtest? (-> self entity extra perm status) (entity-perm-status complete))))
        (go mistycannon-waiting-for-player))
      (if (not (and *target*
                    (>= (-> self fact idle-distance) (vector-vector-distance (-> self root trans) (-> *target* control trans)))))
        (go mistycannon-idle))
      (rider-trans))
  :code
    (behavior ()
      (loop
        (if (< (vector-vector-xz-distance (target-pos 0) (-> self center-point)) (-> self center-point w))
          (mistycannon-do-aim (-> *target* control trans) (-> *target* control transv))
          (mistycannon-do-aim (-> self at-point) (new-stack-vector0)))
        (spawn-muzzle-part! self)
        (suspend)))
  :post rider-post)

(defstate mistycannon-waiting-for-player (mistycannon)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('touch)
         (when ((method-of-type touching-shapes-entry prims-touching?)
                (the-as touching-shapes-entry (-> block param 0))
                (-> self root)
                (the-as uint 1))
           (let ((touching? (the-as object #t))) (set! (-> self player-touching-grips?) (the-as symbol touching?)) touching?)))
        (('change-mode) (go mistycannon-player-control))))
  :trans
    (behavior ()
      (if (and (-> self entity) (logtest? (-> self entity extra perm status) (entity-perm-status complete)))
        (go mistycannon-aim-at-player))
      (rider-trans))
  :code
    (behavior ()
      (set! (-> self player-touching-grips?) #f)
      (loop
        (let ((resting-pitch 2730.6667)
              (pitch-tracker (-> self tilt)))
          (if (< resting-pitch (the float (sar (shl (the int (+ (-> pitch-tracker min) (-> pitch-tracker value))) 48) 48)))
            (angle-tracker-seek! (-> self tilt) 2730.6667)))
        (spawn-muzzle-part! self)
        (when (and (-> self player-touching-grips?) (not (level-hint-displayed?)))
          (set! (-> self player-touching-grips?) #f)
          (hide-hud)
          (level-hint-surpress!)
          (kill-current-level-hint '() '(sidekick voicebox) 'exit)
          (when (and (hud-hidden?) (can-grab-display? self))
            (let ((prompt-font (new 'stack 'font-context *font-default-matrix* 32 160 0.0 (font-color default) (font-flags shadow kerning))))
              (set-width! prompt-font 440)
              (set-height! prompt-font 80)
              (set-flags! prompt-font (font-flags shadow kerning large))
              (print-game-text (lookup-text! *common-text* (text-id press-to-use) #f) prompt-font #f 128 22))
            (when (cpad-pressed? 0 circle)
              (loop
                (send-event *target* 'change-mode 'periscope self)
                (suspend)
                (suspend)))))
        (suspend)))
  :post rider-post)

(defstate cam-mistycannon (camera-slave)
  :event cam-standard-event-handler
  :enter
    (behavior ()
      (when (not (-> self enter-has-run))
        (set! (-> self blend-from-type) (the-as uint 1))
        (set! (-> self blend-to-type) (the-as uint 1))))
  :trans
    (behavior ()
      (if (not (logtest? (-> *camera* master-options) 2)) (cam-slave-go cam-free-floating)))
  :code
    (behavior ()
      (loop
        (let ((cannon-handle (-> self change-event-from)))
          (vector-copy! (-> self trans) (-> (the-as mistycannon (-> cannon-handle 0)) goggles))
          (let ((rotate-camera! matrix-rotate-yx!)
                (tracking (-> self tracking))
                (yaw-tracker (-> (the-as mistycannon (-> cannon-handle 0)) rotate)))
            (rotate-camera! (-> tracking inv-mat)
                            (the float (sar (shl (the int (+ (-> yaw-tracker min) (-> yaw-tracker value))) 48) 48))
                            3640.889)))
        (suspend))))

(defstate mistycannon-player-control (mistycannon)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('change-mode) (send-event *camera* 'change-state cam-mistycannon 0))))
  :exit
    (behavior ()
      (sound-stop (-> self sound-id))
      (sound-stop (-> self aim-sound-id)))
  :trans
    (behavior ()
      (spawn-muzzle-part! self)
      (rider-trans))
  :code
    (behavior ()
      (send-event *camera* 'change-state cam-mistycannon 0)
      (suspend)
      (set-time! (-> self state-time))
      ;; Holding X for one second starts the charge. Charge rises from 0 to 300, mapping launch
      ;; speed from 50 to 100 meters per second; release or full charge fires exactly once.
      (let ((charge 0)
            (shot-latched? 0))
        (loop
          (when *camera-read-analog*
            (let ((yaw-input (analog-input (the-as int (-> *cpad-list* cpads 0 leftx)) 128.0 48.0 110.0 -1.0))
                  (pitch-input (analog-input (the-as int (-> *cpad-list* cpads 0 lefty)) 128.0 48.0 110.0 -1.0)))
              (rotate! self yaw-input)
              (tilt! self (- pitch-input))
              (if (or (!= yaw-input 0.0) (!= pitch-input 0.0))
                (sound-play "telescope" :id (-> self aim-sound-id))
                (sound-stop (-> self aim-sound-id)))))
          (when (cpad-pressed? 0 triangle)
            (process-entity-status! self (entity-perm-status no-kill) #t)
            (sound-stop (-> self sound-id))
            (send-event *camera* 'change-to-entity-by-name "camera-111")
            (suspend)
            (loop
              (when (send-event *target* 'end-mode)
                (send-event *camera* 'change-state *camera-base-mode* 0)
                (process-entity-status! self (entity-perm-status no-kill) #f)
                (go mistycannon-waiting-for-player-to-fuck-off))
              (suspend)))
          (let ((charging? (and (cpad-hold? 0 x) (time-elapsed? (-> self state-time) (seconds 1)))))
            (when (zero? shot-latched?)
              (when charging?
                (set! charge (seekl charge 300 (the-as int (- (current-time) (-> *display* old-base-frame-counter)))))
                (sound-play "cannon-charge" :id (-> self sound-id) :pitch (* 0.008 (the float charge))))
              (when (or (= charge 300) (and (not (cpad-hold? 0 x)) (nonzero? charge)))
                (let ((launch-power (+ 50 (the int (* 0.16666667 (the float charge))))))
                  (level-hint-spawn (text-id sidekick-mistycannon) "sksp009f" (the-as entity #f) *entity-pool* (game-task none))
                  (fire! self (* 4096.0 (the float launch-power)) 2.0 40960.0))
                (set-time! (-> self state-time))
                (set! charge 0)
                (set! shot-latched? 1)
                (sound-stop (-> self sound-id)))
              (if (nonzero? charge)
                (debug-percent-bar #t (bucket-id debug) 192 160 (* 0.0033333334 (the float charge)) (new 'static 'rgba :r #xff :a #x80)))))
          (if (not (cpad-hold? 0 x)) (set! shot-latched? 0))
          (suspend))))
  :post rider-post)

(defstate mistycannon-waiting-for-player-to-fuck-off (mistycannon)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('touch)
         (when ((method-of-type touching-shapes-entry prims-touching?)
                (the-as touching-shapes-entry (-> block param 0))
                (-> self root)
                (the-as uint 1))
           (let ((touch-time (current-time))) (set! (-> self state-time) touch-time) touch-time)))))
  :enter
    (behavior ()
      (set-time! (-> self state-time)))
  :trans rider-trans
  :code
    (behavior ()
      (loop
        (suspend)
        (spawn-muzzle-part! self)
        (if (time-elapsed? (-> self state-time) (seconds 1)) (go mistycannon-waiting-for-player))))
  :post rider-post)

(defmethod init-from-entity! ((this mistycannon) (source-entity entity-actor))
  "Construct the cannon's three-primitive moving collision shape, skeleton, aiming trackers,
   particle launcher, interaction grip, target area, sounds, and optional entity-resource
   tuning. Start in automatic or player-waiting mode according to the entity's complete bit."
  (logior! (-> this mask) (process-mask enemy))
  (let ((moving-shape (new 'process 'collide-shape-moving this (collide-list-enum hit-by-others))))
    (set! (-> moving-shape dynam) (copy *standard-dynamics* 'process))
    (set! (-> moving-shape reaction) default-collision-reaction)
    (set! (-> moving-shape no-reaction)
          (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (alloc-riders moving-shape 1)
    (let ((cannon-body (new 'process 'collide-shape-prim-group moving-shape (the-as uint 2) 0)))
      (set! (-> cannon-body prim-core collide-as) (collide-kind ground-object))
      (set! (-> cannon-body collide-with) (collide-kind target))
      (set! (-> cannon-body prim-core action) (collide-action solid rider-plat-sticky))
      (set! (-> cannon-body transform-index) 3)
      (set-vector! (-> cannon-body local-sphere) 0.0 20480.0 0.0 40960.0)
      (set-root-prim! moving-shape cannon-body)
      (let ((interaction-trigger (new 'process 'collide-shape-prim-mesh moving-shape (the-as uint 0) (the-as uint 0))))
        (set! (-> interaction-trigger prim-core collide-as) (collide-kind ground-object))
        (set! (-> interaction-trigger collide-with) (collide-kind target))
        (set! (-> interaction-trigger prim-core action) (collide-action solid rider-plat-sticky))
        (set! (-> interaction-trigger prim-core offense) (collide-offense indestructible))
        (set! (-> interaction-trigger transform-index) 3)
        (set-vector! (-> interaction-trigger local-sphere) 0.0 20480.0 0.0 40960.0)
        (append-prim cannon-body interaction-trigger))
      (let ((hit-sphere (new 'process 'collide-shape-prim-sphere moving-shape (the-as uint 1))))
        (set! (-> hit-sphere prim-core collide-as) (collide-kind enemy))
        (set! (-> hit-sphere collide-with) (collide-kind target))
        (set! (-> hit-sphere prim-core offense) (collide-offense indestructible))
        (set! (-> hit-sphere transform-index) 3)
        (set-vector! (-> hit-sphere local-sphere) 0.0 28672.0 -8192.0 4096.0)
        (append-prim cannon-body hit-sphere)))
    (set! (-> moving-shape nav-radius) (* 0.75 (-> moving-shape root-prim local-sphere w)))
    (backup-collide-with-as moving-shape)
    (set! (-> this root) moving-shape))
  (process-drawable-from-entity! this source-entity)
  (quaternion-identity! (-> this root quat))
  (initialize-skeleton this *mistycannon-sg* '())
  (logior! (-> this skel status) (janim-status inited))
  (update-transforms! (-> this root))
  (set! (-> this skel prebind-function) mistycannon-prebind-function)
  (set! (-> this skel postbind-function) mistycannon-postbind-function)
  (set! (-> this fact) (new 'process 'fact-info-enemy this (pickup-type eco-pill-random) (-> *FACT-bank* default-pill-inc)))
  (logclear! (-> this mask) (process-mask actor-pause))
  (let ((min-yaw (res-lump-float source-entity 'rotmin :default 16384.0))
        (max-yaw (res-lump-float source-entity 'rotmax :default 32768.0))
        (yaw-speed (res-lump-float source-entity 'rotspeed :default 3640.889)))
    (angle-tracker-init-range! (-> this rotate) min-yaw max-yaw yaw-speed))
  (let ((min-pitch (res-lump-float source-entity 'tiltmin :default -1820.4445))
        (max-pitch (res-lump-float source-entity 'tiltmax :default 12743.111))
        (pitch-speed (res-lump-float source-entity 'tiltspeed :default 3640.889)))
    (angle-tracker-init-range! (-> this tilt) min-pitch max-pitch pitch-speed))
  (set! (-> this avoid-entity) (entity-actor-lookup (-> this entity) 'alt-actor 0))
  (set! (-> this center-point w) (res-lump-float source-entity 'center-radius))
  (cond
    ((= (-> this center-point w) 0.0)
     (vector-copy! (-> this center-point) (-> this root trans))
     (set! (-> this center-point w) (-> this fact idle-distance)))
    (else
     (let* ((center-x-tag (new 'static 'res-tag))
            (center-x-data (res-lump-data source-entity 'center-point pointer :tag-ptr (& center-x-tag))))
       (set! (-> this center-point x)
             (if (and center-x-data (< 0.0 (the float (-> center-x-tag elt-count)))) (-> (the-as (pointer float) center-x-data)) 0.0)))
     (let* ((center-y-tag (new 'static 'res-tag))
            (center-y-data (res-lump-data source-entity 'center-point (pointer float) :tag-ptr (& center-y-tag))))
       (set! (-> this center-point y)
             (if (and center-y-data (< 1.0 (the float (-> center-y-tag elt-count)))) (-> center-y-data 1) 0.0)))
     (let* ((center-z-tag (new 'static 'res-tag))
            (center-z-data (res-lump-data source-entity 'center-point (pointer float) :tag-ptr (& center-z-tag))))
       (set! (-> this center-point z)
             (if (and center-z-data (< 2.0 (the float (-> center-z-tag elt-count)))) (-> center-z-data 2) 0.0)))))
  (set! (-> this accuracy-range) 16384.0)
  (mistycannon-pick-random-target-point)
  (set! (-> this part) (create-launch-control group-beach-cannon-fire this))
  (set! (-> this part-timer) (+ (current-time) (seconds -10)))
  (set! (-> this postbindinfo-ok) #f)
  (let ((yaw-tracker (-> this rotate)))
    (set! (-> this last-known-rotation)
          (the float (sar (shl (the int (+ (-> yaw-tracker min) (-> yaw-tracker value))) 48) 48))))
  (set! (-> this sound-id) (new-sound-id))
  (set! (-> this aim-sound-id) (new-sound-id))
  (if (and (-> this entity) (logtest? (-> this entity extra perm status) (entity-perm-status complete)))
    (go mistycannon-idle)
    (go mistycannon-waiting-for-player))
  (none))

;;-*-Lisp-*-
(in-package goal)
(bundles "BEA.DGO" "MIS.DGO")
(require "levels/misty/mistycannon.gc")
(require "engine/common-obs/babak.gc")
(declare-type babak-with-cannon babak)

;; DECOMP BEGINS

;; This Babak retreats to its linked cannon when Jak is too far away or well below it. Once mounted,
;; it marks the cannon complete so the cannon aims and fires, and keeps its own transform attached to
;; the cannon's main joint until Jak returns.
(deftype babak-with-cannon (babak)
  ((cannon-ent entity)
   (distance   float))
  (:states
   babak-with-cannon-jump-off-cannon
   babak-with-cannon-jump-onto-cannon
   babak-with-cannon-shooting))

nav-enemy-default-event-handler

(defstate nav-enemy-idle (babak-with-cannon)
  :virtual #t
  :event nav-enemy-default-event-handler
  :trans
    (behavior ()
      (if (and (and *target*
                    (>= (-> self enemy-info idle-distance)
                        (vector-vector-distance (-> self collide-info trans) (-> *target* control trans))))
               (time-elapsed? (-> self state-time) (-> self state-timeout)))
        (go-virtual nav-enemy-patrol)))
  :code
    (behavior ()
      (ja-channel-push! 1 (seconds 0.075))
      (ja-play :group! (-> self draw art-group data (-> self nav-info idle-anim)) :num! (seek!) :frame-num 0.0 (ja-post))
      (anim-loop))
  :post #f)

(defstate nav-enemy-patrol (babak-with-cannon)
  :virtual #t
  :event nav-enemy-default-event-handler
  :trans
    (behavior ()
      (when (time-elapsed? (-> self state-time) (seconds 0.1))
        (let ((target-height-offset (- (-> (target-pos 0) y) (-> self collide-info trans y))))
          (if (and (time-elapsed? (-> self state-time) (seconds 3))
                   (or (or (not *target*)
                           (< (-> self distance) (vector-vector-distance (-> self collide-info trans) (-> *target* control trans))))
                       (< target-height-offset -40960.0)))
            (go babak-run-to-cannon)))
        (when (time-elapsed? (-> self state-time) (-> self state-timeout))
          (if (or (not *target*)
                  (< (-> self enemy-info idle-distance) (vector-vector-distance (-> self collide-info trans) (-> *target* control trans))))
            (go-virtual nav-enemy-idle)))
        (if (nav-enemy-notice-player?) (go-virtual nav-enemy-notice))))
  :code
    (-> (method-of-type babak nav-enemy-patrol)
        code))

(defstate babak-run-to-cannon (babak)
  :event nav-enemy-default-event-handler
  :enter
    (behavior ()
      (set-time! (-> self state-time))
      (set! (-> self nav destination-pos quad) (-> self entity extra trans quad))
      (set! (-> self nav target-pos quad) (-> self entity extra trans quad)))
  :trans
    (behavior ()
      (if (nav-enemy-notice-player?) (go-virtual nav-enemy-chase))
      (if (logtest? (nav-control-flags reached-destination) (-> self nav flags)) (go babak-with-cannon-jump-onto-cannon)))
  :code
    (behavior ()
      (ja-channel-push! 1 (seconds 0.075))
      (loop
        (ja-play :group! babak-charge-ja :num! (seek!) :frame-num 0.0)))
  :post
    (behavior ()
      (nav-enemy-travel-post)))

(defun handle->process-safe ((process-handle handle))
  "Resolve a handle and return its first process, or false when the handle no longer resolves."
  (let ((resolved-process (the-as process #f)))
    (if (handle->process process-handle) (set! resolved-process (-> process-handle process 0)))
    resolved-process))

(defun babak-with-cannon-compute-cannon-dir ((cannon mistycannon) (output vector))
  "Copy the cannon main joint's forward vector to output."
  (set! (-> output quad) (-> cannon node-list data 3 bone transform vector 2 quad))
  output)

(defun babak-with-cannon-compute-ride-point ((cannon mistycannon) (output vector))
  "Transform Babak's fixed local riding offset by the cannon's main joint matrix and write the
   resulting world position to output."
  (set! (-> output quad) (-> cannon root trans quad))
  (let ((ride-offset (new 'static 'vector :y 18149.377 :z -17289.217 :w 1.0))
        (main-joint (-> cannon node-list data 3 bone transform)))
    (vector-matrix*! output ride-offset main-joint))
  output)

(defbehavior babak-with-cannon-ride-cannon-post babak-with-cannon ()
  "When the linked cannon process is live, align Babak to its main-joint forward direction and
   fixed riding point, then run the ordinary simple navigation-enemy post step."
  (let* ((cannon-entity (-> self cannon-ent))
         (cannon-handle (if cannon-entity (-> cannon-entity extra process)))
         (cannon-process (if (and (nonzero? cannon-handle) (type-type? (-> cannon-handle type) process-drawable)) cannon-handle)))
    (when cannon-process
      (let ((cannon-direction (new 'stack-no-clear 'vector)))
        (babak-with-cannon-compute-cannon-dir (the-as mistycannon cannon-process) cannon-direction)
        (forward-up->quaternion (-> self collide-info quat) cannon-direction *y-vector*))
      (babak-with-cannon-compute-ride-point (the-as mistycannon cannon-process) (-> self collide-info trans))))
  (nav-enemy-simple-post)
  (none))

(defstate babak-with-cannon-jump-onto-cannon (babak-with-cannon)
  :event nav-enemy-jump-event-handler
  :exit
    (behavior ()
      (logior! (-> self nav-enemy-flags) (nav-enemy-flags enable-rotate enable-travel)))
  :code
    (behavior ()
      (set-time! (-> self state-time))
      (set! (-> self rotate-speed) (-> self nav-info run-rotate-speed))
      (set! (-> self turn-time) (-> self nav-info run-turn-time))
      (logclear! (-> self nav-enemy-flags) (nav-enemy-flags enable-rotate enable-travel))
      (nav-enemy-neck-control-inactive)
      (let* ((cannon-entity (-> self cannon-ent))
             (cannon-handle (if cannon-entity (-> cannon-entity extra process)))
             (cannon-process (if (and (nonzero? cannon-handle) (type-type? (-> cannon-handle type) process-drawable)) cannon-handle)))
        (cond
          (cannon-process
           (babak-with-cannon-compute-ride-point (the-as mistycannon cannon-process) (-> self event-param-point))
           (nav-enemy-initialize-jump (-> self event-param-point)))
          (else (go-virtual nav-enemy-idle)))
        (when (not (nav-enemy-facing-point? (-> self jump-dest) 5461.3335))
          (ja-channel-push! 1 (seconds 0.2))
          (nav-enemy-turn-to-face-point (-> self jump-dest) 1820.4445))
        (logior! (-> self nav-enemy-flags) (nav-enemy-flags enable-travel))
        (nav-enemy-execute-jump)
        (logclear! (-> self nav-enemy-flags) (nav-enemy-flags enable-rotate enable-travel))
        (set! cannon-entity (-> self cannon-ent))
        (set! cannon-handle (if cannon-entity (-> cannon-entity extra process)))
        (set! cannon-process
              (if (and (nonzero? cannon-handle) (type-type? (-> cannon-handle type) process-drawable)) cannon-handle))
        (when cannon-process
          (let ((cannon-direction (babak-with-cannon-compute-cannon-dir (the-as mistycannon cannon-process) (new 'stack-no-clear 'vector))))
            (when (not (nav-enemy-facing-direction? cannon-direction 1820.4445))
              (ja-channel-push! 1 (seconds 0.2))
              (nav-enemy-turn-to-face-dir cannon-direction 182.04445)
              (forward-up->quaternion (-> self collide-info quat) cannon-direction *y-vector*)))))
      (ja-channel-push! 1 (seconds 0.1))
      (ja-play :group! babak-look-ja :num! (seek!) :frame-num 0.0)
      (go babak-with-cannon-shooting))
  :post nav-enemy-jump-post)

;; The entity position remains the Babak's landing point while cannon-ent names the moving cannon.
;; Rebuild the navigation polygon after landing because the jump begins outside ordinary nav travel.
(defstate babak-with-cannon-jump-off-cannon (babak-with-cannon)
  :event nav-enemy-jump-event-handler
  :exit
    (behavior ()
      (logior! (-> self nav-enemy-flags) (nav-enemy-flags enable-rotate enable-travel)))
  :code
    (behavior ()
      (set-time! (-> self state-time))
      (nav-enemy-initialize-jump (-> self entity extra trans))
      (nav-enemy-neck-control-look-at)
      (logclear! (-> self nav-enemy-flags) (nav-enemy-flags enable-rotate enable-travel))
      (ja-play :group! babak-look-ja :num! (seek! 0.0 2.0) :frame-num max)
      (when (not (nav-enemy-facing-point? (-> self jump-dest) 5461.3335))
        (ja-channel-push! 1 (seconds 0.2))
        (nav-enemy-turn-to-face-point (-> self jump-dest) 1820.4445))
      (logior! (-> self nav-enemy-flags) (nav-enemy-flags enable-travel))
      (nav-enemy-execute-jump)
      (let ((landing-poly (find-poly-fast-from-world (-> self nav) (-> self jump-dest))))
        (set-current-poly! (-> self nav) landing-poly))
      (go-virtual nav-enemy-jump-land))
  :post nav-enemy-jump-post)

(defstate babak-with-cannon-shooting (babak-with-cannon)
  :event nav-enemy-default-event-handler
  :enter
    (behavior ()
      (set-time! (-> self state-time))
      (let ((cannon-entity (entity-actor-lookup (-> self entity) 'alt-actor 0)))
        (if cannon-entity (logior! (-> cannon-entity extra perm status) (entity-perm-status complete)))))
  :exit
    (behavior ()
      (let ((cannon-entity (entity-actor-lookup (-> self entity) 'alt-actor 0)))
        (if cannon-entity (logclear! (-> cannon-entity extra perm status) (entity-perm-status complete)))))
  :trans
    (behavior ()
      (let ((target-height-offset (- (-> (target-pos 0) y) (-> self collide-info trans y))))
        (if (and (< -40960.0 target-height-offset)
                 (and (and *target* (>= (-> self distance) (vector-vector-distance (-> self collide-info trans) (-> *target* control trans))))
                      (time-elapsed? (-> self state-time) (seconds 3))))
          (go babak-with-cannon-jump-off-cannon))))
  :code
    (behavior ()
      (loop
        (suspend)))
  :post babak-with-cannon-ride-cannon-post)

(defstate nav-enemy-die (babak-with-cannon)
  :virtual #t
  :event nav-enemy-default-event-handler
  :trans
    (behavior ()
      (if (and *target* (= (-> *target* current-level name) 'beach)) (spool-push *art-control* "beachcam-cannon" 0 self -1.0))
      (if (and *target* (= (-> *target* current-level name) 'misty)) (spool-push *art-control* "mistycam-cannon" 0 self -1.0))
      (call-parent-state-handler trans)))

;; The first completion starts the level-specific cannon camera before dropping the power cell.
;; Subsequent visits keep the ordinary task-complete behavior without replaying that camera.
(defstate nav-enemy-fuel-cell (babak-with-cannon)
  :virtual #t
  :event process-drawable-fuel-cell-handler
  :code
    (behavior ()
      (ja-channel-set! 0)
      (clear-collide-with-as (-> self collide-info))
      (ja-post)
      (when (not (task-complete? *game-info* (-> self entity extra perm task)))
        (when (not (and (-> self entity) (logtest? (-> self entity extra perm status) (entity-perm-status complete))))
          (process-entity-status! self (entity-perm-status complete) #t)
          (if (and *target* (= (-> *target* current-level name) 'beach)) (beachcam-spawn))
          (if (and *target* (= (-> *target* current-level name) 'misty)) (mistycam-spawn)))
        (if (not (-> self child))
          (birth-pickup-at-point (-> self collide-info trans)
                                 (pickup-type fuel-cell)
                                 (the float (-> self entity extra perm task))
                                 #f
                                 self
                                 (the-as fact-info #f)))
        (while (-> self child)
          (suspend)))
      (cleanup-for-death self)))

(defmethod common-post ((this babak-with-cannon))
  "Keep the beach or Misty cannon camera art spooled while its level is active, then run the
   ordinary navigation-enemy post step."
  (cond
    ((= (level-status *level* 'beach) 'active) (spool-push *art-control* "beachcam-cannon" 0 this -99.0))
    ((= (level-status *level* 'misty) 'active) (spool-push *art-control* "mistycam-cannon" 0 this -99.0)))
  ((method-of-type nav-enemy common-post) this)
  (none))

(defmethod init-from-entity! ((this babak-with-cannon) (source-entity entity-actor))
  "Create Babak collision and drawable state, finish Babak-specific skeleton and navigation
   setup, read the cannon-return distance and linked cannon entity, and disable actor pause.
   Enter fuel-cell behavior only when this placed enemy is complete and configured to carry a
   power cell; otherwise enter idle."
  (initialize-collision this)
  (process-drawable-from-entity! this source-entity)
  (post-init-setup! this)
  (set! (-> this distance) (res-lump-float source-entity 'distance :default 163840.0))
  (set! (-> this cannon-ent) (entity-actor-lookup (-> this entity) 'alt-actor 0))
  (logclear! (-> this mask) (process-mask actor-pause))
  (if (or (not (and (-> this entity) (logtest? (-> this entity extra perm status) (entity-perm-status complete))))
          (not (logtest? (-> this enemy-info options) (fact-options has-power-cell))))
    (go (method-of-object this nav-enemy-idle)))
  (go (method-of-object this nav-enemy-fuel-cell))
  (none))

;;-*-Lisp-*-
(in-package goal)
(bundles "MIS.DGO")
(require "engine/common-obs/generic-obs.gc")
(require "engine/game/task/hint-control.gc")
(declare-type teetertotter process-drawable)

;; DECOMP BEGINS

(deftype teetertotter (process-drawable)
  "Misty Island seesaw that drops a boulder onto one end to launch Jak from the other."
  ((launched-player   basic)
   (in-launch-window  basic)
   (rock-is-dangerous basic))
  (:states
   teetertotter-bend
   teetertotter-idle
   teetertotter-launch))

(defskelgroup *teetertotter-sg*
  teetertotter
  teetertotter-lod0-jg
  teetertotter-idle-ja
  ((teetertotter-lod0-mg (meters 20)) (teetertotter-lod1-mg (meters 40)) (teetertotter-lod2-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 8))

(defun target-on-end-of-teetertotter? ((platform teetertotter))
  "Return whether Jak is at least two meters along the plank's launch end."
  (let ((target-offset (vector-! (new-stack-vector0) (-> *target* control trans) (-> platform root trans))))
    (if (< (vector-dot (vector-x-quaternion! (new-stack-vector0) (-> platform root quat)) target-offset) -8192.0) #t)))

(defstate teetertotter-idle (teetertotter)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('attack)
         (case (-> block param 1)
           (('flop)
            (when (target-on-end-of-teetertotter? self)
              (set! (-> self in-launch-window) #f)
              (increment-success-for-hint (text-id misty-teetertotter))
              (go teetertotter-launch)))))
        (('bonk)
         (when (target-on-end-of-teetertotter? self)
           (level-hint-spawn (text-id misty-teetertotter) "sksp0070" (the-as entity #f) *entity-pool* (game-task none))
           (go teetertotter-bend)))))
  :code
    (behavior ()
      (ja :group! teetertotter-idle-ja :num! min)
      (loop
        (suspend)))
  :post transform-post)

(defstate teetertotter-launch (teetertotter)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (when (= message 'touch)
        ;; The falling rock is deadly during its descent.
        (if (and ((method-of-type touching-shapes-entry prims-touching?)
                  (the-as touching-shapes-entry (-> block param 0))
                  (the-as collide-shape-moving (-> self root))
                  (the-as uint 1))
                 (-> self rock-is-dangerous))
          (send-event proc 'attack (-> block param 0) (static-attack-info ((mode 'deadly)))))
        ;; The other end launches Jak once, during the short impact window.
        (when (and ((method-of-type touching-shapes-entry prims-touching?)
                    (the-as touching-shapes-entry (-> block param 0))
                    (the-as collide-shape-moving (-> self root))
                    (the-as uint 2))
                   (target-on-end-of-teetertotter? self)
                   (not (-> self launched-player))
                   (-> self in-launch-window))
          (when (send-event proc
                            'shove
                            #f
                            (static-attack-info ((shove-back (meters 0)) (shove-up (meters 13)) (angle 'jump) (control 1.0))))
            (let ((v0-0 #t)) (set! (-> self launched-player) v0-0) v0-0)))))
  :code
    (behavior ()
      (set! (-> self launched-player) #f)
      (ja-play :group!
               teetertotter-idle-ja
               :num! (seek!)
               :frame-num 0.0
               ;; The rock is dangerous on frames 12..76; Jak launches on frames 76..82.
               (let ((frame (ja-aframe-num 0)))
                 (set! (-> self in-launch-window) (and (>= frame 76.0) (>= 82.0 frame)))
                 (let ((rock-falling? (>= frame 12.0)))
                   (set! (-> self rock-is-dangerous) (and rock-falling? (>= 76.0 frame))))))
      (go teetertotter-idle))
  :post rider-post)

(defstate teetertotter-bend (teetertotter)
  :code
    (behavior ()
      (ja-play :group! teetertotter-landing-ja :num! (seek!) :frame-num 0.0)
      (go teetertotter-idle))
  :post rider-post)

(defmethod init-from-entity! ((this teetertotter) (source-entity entity-actor))
  "Build the plank, boulder, launch-end, and sticky riding collision, initialize the art, and
   enter the idle state."
  (let ((collision (new 'process 'collide-shape-moving this (collide-list-enum hit-by-player))))
    (set! (-> collision dynam) (copy *standard-dynamics* 'process))
    (set! (-> collision reaction) default-collision-reaction)
    (set! (-> collision no-reaction)
          (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (alloc-riders collision 1)
    (let ((root-group (new 'process 'collide-shape-prim-group collision (the-as uint 5) 0)))
      (set! (-> root-group prim-core collide-as) (collide-kind ground-object))
      (set! (-> root-group collide-with) (collide-kind target))
      (set! (-> root-group prim-core action) (collide-action solid))
      (set-vector! (-> root-group local-sphere) 0.0 12288.0 0.0 36864.0)
      (set-root-prim! collision root-group)
      (let ((rock-sphere (new 'process 'collide-shape-prim-sphere collision (the-as uint 1))))
        (set! (-> rock-sphere prim-core collide-as) (collide-kind ground-object))
        (set! (-> rock-sphere collide-with) (collide-kind target))
        (set! (-> rock-sphere prim-core action) (collide-action solid))
        (set! (-> rock-sphere prim-core offense) (collide-offense indestructible))
        (set! (-> rock-sphere transform-index) 5)
        (set-vector! (-> rock-sphere local-sphere) -4096.0 2048.0 0.0 5120.0)
        (append-prim root-group rock-sphere))
      (let ((primitive-0 (new 'process 'collide-shape-prim-mesh collision (the-as uint 0) (the-as uint 2))))
        (set! (-> primitive-0 prim-core collide-as) (collide-kind ground-object))
        (set! (-> primitive-0 collide-with) (collide-kind target))
        (set! (-> primitive-0 prim-core action) (collide-action solid rider-plat-sticky))
        (set! (-> primitive-0 prim-core offense) (collide-offense indestructible))
        (set! (-> primitive-0 transform-index) 7)
        (set-vector! (-> primitive-0 local-sphere) 0.0 0.0 0.0 32768.0)
        (append-prim root-group primitive-0))
      (let ((primitive-1 (new 'process 'collide-shape-prim-mesh collision (the-as uint 1) (the-as uint 0))))
        (set! (-> primitive-1 prim-core collide-as) (collide-kind ground-object))
        (set! (-> primitive-1 collide-with) (collide-kind target))
        (set! (-> primitive-1 prim-core action) (collide-action solid))
        (set! (-> primitive-1 prim-core offense) (collide-offense indestructible))
        (set! (-> primitive-1 transform-index) 4)
        (set-vector! (-> primitive-1 local-sphere) 0.0 0.0 0.0 32768.0)
        (append-prim root-group primitive-1))
      (let ((primitive-2 (new 'process 'collide-shape-prim-mesh collision (the-as uint 2) (the-as uint 0))))
        (set! (-> primitive-2 prim-core collide-as) (collide-kind ground-object))
        (set! (-> primitive-2 collide-with) (collide-kind target))
        (set! (-> primitive-2 prim-core action) (collide-action solid))
        (set! (-> primitive-2 prim-core offense) (collide-offense indestructible))
        (set! (-> primitive-2 transform-index) 3)
        (set-vector! (-> primitive-2 local-sphere) 0.0 0.0 0.0 32768.0)
        (append-prim root-group primitive-2))
      (let ((primitive-3 (new 'process 'collide-shape-prim-mesh collision (the-as uint 3) (the-as uint 2))))
        (set! (-> primitive-3 prim-core collide-as) (collide-kind ground-object))
        (set! (-> primitive-3 collide-with) (collide-kind target))
        (set! (-> primitive-3 prim-core action) (collide-action solid rider-plat-sticky))
        (set! (-> primitive-3 prim-core offense) (collide-offense indestructible))
        (set! (-> primitive-3 transform-index) 3)
        (set-vector! (-> primitive-3 local-sphere) 0.0 0.0 0.0 32768.0)
        (append-prim root-group primitive-3)))
    (set! (-> collision nav-radius) (* 0.75 (-> collision root-prim local-sphere w)))
    (backup-collide-with-as collision)
    (set! (-> this root) collision))
  (process-drawable-from-entity! this source-entity)
  (initialize-skeleton this *teetertotter-sg* '())
  (set! (-> this launched-player) #f)
  (set! (-> this in-launch-window) #f)
  (set! (-> this rock-is-dangerous) #f)
  (go teetertotter-idle)
  (none))

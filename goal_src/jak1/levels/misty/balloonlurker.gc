  balloonlurker
  balloonlurker-lod0-jg
  balloonlurker-idle-ja
  ((balloonlurker-lod0-mg (meters 20)) (balloonlurker-lod1-mg (meters 40)) (balloonlurker-lod2-mg (meters 999999)))
  :bounds (static-spherem 0 12 0 17))

(defskelgroup *balloonlurker-pilot-sg*
  balloonlurker
  balloonlurker-pilot-lod0-jg
  balloonlurker-pilot-idle-ja
  ((balloonlurker-pilot-lod0-mg (meters 20))
   (balloonlurker-pilot-lod1-mg (meters 40))
   (balloonlurker-pilot-lod2-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 4))

(defbehavior balloonlurker-get-path-point balloonlurker ((index int))
  "Evaluate and select one path control vertex as the current destination."
  (if (<= (-> self path curve num-cverts) 0) (go process-drawable-art-error "no path"))
  (set! (-> self dest-index) index)
  (set! (-> self dest-point-old quad) (-> self dest-point quad))
  (eval-path-curve-div! (-> self path) (-> self dest-point) (the float index) 'interp)
  0
  (none))

(defbehavior balloonlurker-get-next-path-point balloonlurker ()
  "Advance to the next path control vertex, wrapping at the end."
  (if (<= (-> self path curve num-cverts) 0) (go process-drawable-art-error "no path"))
  (let ((next-index (+ (-> self dest-index) 1)))
    (if (= next-index (-> self path curve num-cverts)) (set! next-index 0))
    (balloonlurker-get-path-point next-index))
  0
  (none))

(defbehavior balloonlurker-snap-to-path-point balloonlurker ((index int))
  "Move the balloon to one path control vertex and face along the path tangent."
  (let ((position (new 'stack-no-clear 'vector))
        (tangent (new 'stack-no-clear 'vector)))
    (eval-path-curve-div! (-> self path) position (the float index) 'interp)
    (set! (-> self root-overlay trans quad) (-> position quad))
    (get-tangent-at-vertex! (-> self path) tangent (the float index))
    (set! (-> tangent y) 0.0)
    (vector-normalize! tangent 1.0)
    (forward-up-nopitch->quaternion (-> self root-overlay quat) tangent *up-vector*)))

(defbehavior balloonlurker-find-nearest-path-point balloonlurker ()
  "Select the path control vertex nearest the balloon in the horizontal plane."
  (let ((nearest-index 0))
    (let ((nearest-distance 409600000.0)
          (position (new 'stack-no-clear 'vector)))
      (dotimes (i (-> self path curve num-cverts))
        (eval-path-curve-div! (-> self path) position (the float i) 'interp)
        (let ((distance (vector-vector-xz-distance (-> self root-overlay trans) position)))
          (when (< distance nearest-distance)
            (set! nearest-distance distance)
            (set! nearest-index i)))))
    (balloonlurker-get-path-point nearest-index))
  (set! (-> self dest-point-old quad) (-> self dest-point quad))
  0
  (none))

(defbehavior balloonlurker-player-impulse balloonlurker ()
  "Record the force needed to match Jak's velocity at his contact point."
  (when *target*
    (set! (-> self player-impulse) #t)
    (set! (-> self player-force-position quad) (-> *target* control trans quad))
    (vector-! (-> self player-force) (-> self player-velocity) (-> *target* control transv))
    (vector-float*! (-> self player-force) (-> self player-force) (-> *BALLOONLURKER-bank* player-mass))))

(defbehavior balloonlurker-event-handler balloonlurker ((sender process) (argc int) (message symbol) (event event-message-block))
  "Handle body contact, mine attacks, and death events."
  (case message
    (('touch 'attack)
     (balloonlurker-player-impulse)
     (when ((method-of-type touching-shapes-entry prims-touching?)
            (the-as touching-shapes-entry (-> event param 0))
            (-> self root-overlay)
            (the-as uint 1))
       (do-push-aways! (-> self root-overlay))
       (send-event sender 'shove (-> event param 0) (static-attack-info ((shove-back (meters 2)) (shove-up (meters 0.5))))))
     (dotimes (mine-index 2)
       (let ((mine-prim-id (if (zero? mine-index) 8 16)))
         (when ((method-of-type touching-shapes-entry prims-touching?)
                (the-as touching-shapes-entry (-> event param 0))
                (-> self root-overlay)
                (the-as uint mine-prim-id))
           (let ((mine-prim (find-prim-by-id (-> self root-overlay) (the-as uint mine-prim-id))))
             (when mine-prim
               (set! (-> self explosion-force-position quad) (-> mine-prim prim-core world-sphere quad))
               (if (send-event sender 'attack (-> event param 0) (static-attack-info ((mode 'balloonlurker))))
                 (level-hint-spawn (text-id misty-bike-mines-hint) "sksp0063" (the-as entity #f) *entity-pool* (game-task none)))
               (go balloonlurker-mine-explode mine-index))))))
     #f)
    (('die) (go balloonlurker-die))))

(defmethod accumulate-forces! ((this balloonlurker) (time-step float))
  "Apply buoyancy and drag at four hull points, rudder drag, propeller thrust, mine weight,
   gravity, and pending player or explosion forces for one physics step."
  (let ((s5-0 (new 'stack-no-clear 'vector)))
    (let ((s3-0 (new 'stack-no-clear 'vector))
          (s4-0 (-> this rbody matrix)))
      (dotimes (s2-0 4)
        (let ((s1-0 (-> this control-point-array data s2-0)))
          (vector-matrix*! (-> s1-0 world-pos) (-> s1-0 local-pos) s4-0)
          (velocity-at-point (-> this rbody) (-> s1-0 world-pos) (-> s1-0 velocity))
          (let* ((f30-0 (vector-vector-xz-distance (-> this dest-point) (-> this root-overlay trans)))
                 (f0-0 (vector-vector-xz-distance (-> this dest-point-old) (-> this root-overlay trans)))
                 (f0-6 (/ (- (+ (/ (+ (* f30-0 (-> this dest-point-old y)) (* f0-0 (-> this dest-point y))) (fmax 409.6 (+ f30-0 f0-0)))
                                (-> *BALLOONLURKER-bank* buoyancy-depth-offset))
                             (-> s1-0 world-pos y))
                          (-> this info max-buoyancy-depth))))
            (vector-float*! s5-0
                            *y-vector*
                            (* (/ (-> this buoyancy-factor) 4)
                               (-> this info gravity-factor)
                               (fmax 0.3 (fmin 1.0 f0-6))
                               (-> this info gravity)
                               (-> this rbody mass))))
          (apply-force-at-point! (-> this rbody) (-> s1-0 world-pos) s5-0)
          (vector-float*! s5-0 (-> s1-0 velocity) (* -1.0 (-> this info drag-factor)))
          (apply-force-at-point! (-> this rbody) (-> s1-0 world-pos) s5-0))
        0)
      (let ((s2-1 (-> this control-point-array data 4)))
        (let ((f30-1 (* (-> *BALLOONLURKER-bank* max-rudder-deflection-angle) (-> this rudder-control))))
          (vector-matrix*! (-> s2-1 world-pos) (-> s2-1 local-pos) s4-0)
          (velocity-at-point (-> this rbody) (-> s2-1 world-pos) (-> s2-1 velocity))
          (set-vector! s3-0 (cos f30-1) 0.0 (sin f30-1) 1.0))
        (vector-rotate*! s3-0 s3-0 s4-0)
        (vector-float*! s5-0 s3-0 (* -1.0 (-> *BALLOONLURKER-bank* rudder-factor) (vector-dot s3-0 (-> s2-1 velocity))))
        (apply-force-at-point! (-> this rbody) (-> s2-1 world-pos) s5-0))
      0
      (let ((s3-1 (-> this control-point-array data 5)))
        (vector-matrix*! (-> s3-1 world-pos) (-> s3-1 local-pos) s4-0)
        (set! (-> s3-1 world-pos quad) (-> s3-1 world-pos quad))
        (vector-float*! s5-0 (-> s4-0 vector 2) (-> this engine-thrust))
        (apply-force-at-point! (-> this rbody) (-> s3-1 world-pos) s5-0)))
    (dotimes (s4-1 2)
      (when (-> this mine s4-1 enable)
        (let ((v1-43 (-> this control-point-array data (if (zero? s4-1) 5 4))))
          (vector-float*! s5-0 *y-vector* (-> *BALLOONLURKER-bank* mine-weight))
          (apply-force-at-point! (-> this rbody) (-> v1-43 world-pos) s5-0))))
    (vector-float*! s5-0 *y-vector* (* -1.0 (-> this info gravity-factor) (-> this info gravity) (-> this rbody mass)))
    (apply-force! (-> this rbody) s5-0))
  (when (or (-> this player-impulse) (-> this player-contact))
    (set! (-> this player-impulse) #f)
    (apply-force-at-point! (-> this rbody) (-> this player-force-position) (-> this player-force)))
  (when (-> this explosion)
    (set! (-> this explosion) #f)
    (apply-force-at-point! (-> this rbody) (-> this explosion-force-position) (-> this explosion-force)))
  0
  (none))

(define *balloonlurker-rudder-joint-home* (new 'static 'vector :x 0.5 :y -0.5 :z -0.5 :w 0.5))

(defbehavior balloonlurker-play-sounds balloonlurker ()
  "Update the propeller and pedal sounds while alive, or stop them after death."
  (cond
    ((not (-> self dead))
     (if (zero? (-> self engine-sound-id)) (set! (-> self engine-sound-id) (new-sound-id)))
     (if (zero? (-> self pedal-sound-id)) (set! (-> self pedal-sound-id) (new-sound-id)))
     (when (< (vector-vector-distance (-> self root-overlay trans) (ear-trans)) 286720.0)
       (let* ((f0-2 (/ (-> self engine-thrust) (-> *BALLOONLURKER-bank* max-engine-thrust)))
              (f1-2 100.0)
              (f0-3 (* 3.0 f0-2)))
         (sound-play "propeller"
                     :id (-> self engine-sound-id)
                     :vol
                     f1-2
                     :pitch
                     f0-3
                     :position
                     (the-as symbol (-> self node-list data 4 bone transform vector 3))))
       (sound-play "pedals" :id (-> self pedal-sound-id) :position (the-as symbol (-> self root-overlay trans)))))
    (else
     (when (nonzero? (-> self engine-sound-id))
       (sound-stop (-> self engine-sound-id))
       (set! (-> self engine-sound-id) (new 'static 'sound-id))
       0)
     (when (nonzero? (-> self pedal-sound-id))
       (sound-stop (-> self pedal-sound-id))
       (set! (-> self pedal-sound-id) (new 'static 'sound-id))
       0)))
  (none))

(defbehavior balloonlurker-post balloonlurker ()
  "Update automatic or player steering, propeller and rudder joints, rigid-body simulation, sounds,
   and drawable transforms."
  (set! (-> self anim-frame) (ja-frame-num 0))
  (cond
    ((and (-> self auto-pilot) (not (-> self dead)))
     (let* ((s4-0 (-> self rbody matrix vector 2))
            (s5-0 (-> self rbody matrix))
            (gp-0 (-> self rbody position))
            (f30-0 (vector-vector-xz-distance (-> self dest-point) gp-0)))
       (when (< f30-0 (-> *BALLOONLURKER-bank* throttle-close-distance))
         (balloonlurker-get-next-path-point)
         (set! f30-0 (vector-vector-xz-distance (-> self dest-point) gp-0)))
       (let ((f0-4 (- (vector-dot s4-0 (-> self dest-point)) (vector-dot s4-0 gp-0)))
             (f2-2 (- (vector-dot (the-as vector s5-0) (-> self dest-point)) (vector-dot (the-as vector s5-0) gp-0))))
         (seek! (-> self rudder-control) (fmax -1.0 (fmin 1.0 (/ f2-2 (fmax 4096.0 f0-4)))) (* 4.0 (seconds-per-frame))))
       (let ((f0-12 0.0)
             (f1-7 1.0)
             (f2-4 (* (-> *BALLOONLURKER-bank* throttle-factor) (- f30-0 (-> *BALLOONLURKER-bank* throttle-distance))))
             (f3-3 (-> *BALLOONLURKER-bank* throttle-distance)))
         (set! (-> self throttle-control) (fmax f0-12 (fmin f1-7 (* f2-4 (/ 1.0 f3-3)))))))
     0)
    (else
     (let ((f0-14 (analog-input (the-as int (-> *cpad-list* cpads 1 leftx)) 128.0 48.0 110.0 -1.0)))
       (seek! (-> self rudder-control) f0-14 (* 2.0 (seconds-per-frame))))
     (if (cpad-hold? 1 x)
       (seek! (-> self throttle-control) 1.0 (seconds-per-frame))
       (seek! (-> self throttle-control) 0.0 (* 0.25 (seconds-per-frame))))))
  (seek! (-> self engine-thrust)
         (* (-> self throttle-control) (-> *BALLOONLURKER-bank* max-engine-thrust))
         (/ (-> *BALLOONLURKER-bank* max-engine-thrust) 200))
  (let ((f0-31 60.0)
        (f1-14 1820.4445)
        (f2-6 6735.6445)
        (f3-6 (-> *BALLOONLURKER-bank* max-engine-thrust)))
    (set! (-> self propeller spin-rate) (* f0-31 (+ f1-14 (* f2-6 (/ 1.0 f3-6) (-> self engine-thrust))))))
  (let ((f0-34 (* (-> *BALLOONLURKER-bank* max-rudder-deflection-angle) (-> self rudder-control)))
        (gp-1 (new 'stack-no-clear 'quaternion)))
    (quaternion-vector-angle! gp-1 *x-vector* f0-34)
    (quaternion*! (-> self rudder transform quat) (the-as quaternion *balloonlurker-rudder-joint-home*) gp-1))
  (simulate! self)
  (quaternion-copy! (-> self root-overlay quat) (-> self rbody rotation))
  (get-origin-position (-> self rbody) (-> self root-overlay trans))
  (balloonlurker-play-sounds)
  (when (nonzero? (-> self draw))
    (cond
      ((or (logtest? (-> self draw status) (draw-status no-skeleton-update))
           (logtest? (-> self draw status) (draw-status was-drawn)))
       (logclear! (-> self draw status) (draw-status skip-bones))
       (update-transforms! (-> self root-overlay))
       (ja-post))
      (else
       (set! (-> self draw origin quad) (-> self root-overlay trans quad))
       (logior! (-> self draw status) (draw-status skip-bones)))))
  (none))

(defstate balloonlurker-patrol (balloonlurker)
  :event balloonlurker-event-handler
  :trans
    (behavior ()
      (ja :num! (loop!))
      (set! (-> self anim-frame) (ja-frame-num 0)))
  :code
    (behavior ()
      (when (not (ja-group? balloonlurker-idle-ja))
        (ja-channel-push! 1 (seconds 0.07))
        (ja :group! balloonlurker-idle-ja)
        (ja :num-func num-func-identity :frame-num 0.0))
      (ja-post)
      (anim-loop))
  :post balloonlurker-post)

(defstate balloonlurker-mine-explode (balloonlurker)
  :event balloonlurker-event-handler
  :code
    (behavior ((mine-index int))
      (set! (-> self explosion-force-position quad)
            (-> self node-list data (-> self explosion-joint-index-bytes mine-index) bone transform vector 3 quad))
      (process-spawn part-tracker
                     :init
                     part-tracker-init
                     group-balloonlurker-mine-explosion
                     -1
                     #f
                     #f
                     #f
                     (-> self explosion-force-position)
                     :to
                     *entity-pool*)
      (sound-play "explosion")
      (set! (-> self explosion) #t)
      (vector-! (-> self explosion-force) (-> self rbody position) (-> self explosion-force-position))
      (set! (-> self explosion-force y) (* 2.0 (-> self explosion-force y)))
      (vector-length (-> self explosion-force))
      (vector-normalize! (-> self explosion-force) (-> *BALLOONLURKER-bank* explosion-force))
      (suspend)
      (ja :num! (loop!))
      (let ((mine-mod (-> self mine mine-index)))
        (set! (-> mine-mod enable) #t)
        (set-vector! (-> mine-mod transform scale) 0.0 0.0 0.0 1.0))
      (if (-> self dead) (go balloonlurker-die) (go balloonlurker-patrol)))
  :post balloonlurker-post)

(defstate balloonlurker-die (balloonlurker)
  :event #f
  :enter
    (behavior ()
      (set-time! (-> self state-time))
      (set! (-> self vulnerable) #f)
      (set! (-> self dead) #t))
  :code
    (behavior ()
      (local-vars (v1-27 symbol))
      (process-entity-status! self (entity-perm-status respawn-on-reload) #t)
      (process-entity-status! self (entity-perm-status dead) #t)
      (when (or (-> self link prev) (-> self link next))
        (let ((sv-16 (the-as symbol #f)))
          (let ((sv-20 (-> self child))))
          (let ((sv-24 (entity-actor-lookup (-> self entity) 'alt-actor 0)))
            (entity-birth-no-kill sv-24)
            (apply-all (-> self link) actor-link-dead-hook (& sv-16))
            (when (and sv-16 sv-24)
              (process-grab? *target*)
              (suspend-for (seconds 1))
              (process-release? *target*)
              (while (let ((a1-4 (new 'stack-no-clear 'event-message-block)))
                       (set! (-> a1-4 from) self)
                       (set! (-> a1-4 num-params) 0)
                       (set! (-> a1-4 message) 'task-complete)
                       (let ((v1-17 sv-24)) (not (send-event-function (if v1-17 (-> v1-17 extra process)) a1-4))))
                (suspend))))))
      (set! (-> self buoyancy-factor) (* 4.0 (-> self buoyancy-factor)))
      (until v1-27
        (suspend)
        (ja :num! (loop!))
        (set! v1-27
              (or (time-elapsed? (-> self state-time) (seconds 30)) (< 819200.0 (- (-> self root-overlay trans y) (-> self water-y))))))
      (cleanup-for-death self)
      (while (-> self child)
        (suspend)))
  :post balloonlurker-post)

(defmethod relocate ((this balloonlurker) (offset int))
  "Relocate the four separately allocated joint modifiers."
  (if (nonzero? (-> this propeller)) (&+! (-> this propeller) offset))
  (if (nonzero? (-> this rudder)) (&+! (-> this rudder) offset))
  (if (nonzero? (-> this mine 0)) (&+! (-> this mine 0) offset))
  (if (nonzero? (-> this mine 1)) (&+! (-> this mine 1) offset))
  (call-parent-method this offset))

(defstate balloonlurker-pilot-idle (balloonlurker-pilot)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('attack) (send-event (ppointer->process (-> self parent-override)) 'die) (go balloonlurker-pilot-die))))
  :code
    (behavior ()
      (ja-channel-push! 1 (seconds 0.1))
      (ja :group! balloonlurker-pilot-idle-ja)
      (ja :num-func num-func-identity :frame-num 0.0)
      (loop
        (suspend)
        (ja :num-func num-func-identity :frame-num (-> self parent-override 0 anim-frame))))
  :post
    (behavior ()
      (set! (-> self root trans quad) (-> self parent-override 0 root-overlay trans quad))
      (quaternion-copy! (-> self root quat) (-> self parent-override 0 root-overlay quat))
      (update-transforms! (-> self root))
      (ja-post)))

(defstate balloonlurker-pilot-die (balloonlurker-pilot)
  :event process-drawable-death-event-handler
  :code
    (behavior ()
      (process-spawn part-tracker
                     :init
                     part-tracker-init
                     group-balloonlurker-pilot-death
                     -1
                     #f
                     #f
                     #f
                     (-> self root trans)
                     :to
                     *entity-pool*)
      (velocity-at-point (-> self parent-override 0 rbody) (-> self root trans) (-> self root transv))
      (clear-collide-with-as (-> self root))
      (ja-channel-push! 1 (seconds 0.1))
      (ja-play :group! balloonlurker-pilot-death-ja :num! (seek!) :frame-num 0.0)
      (cleanup-for-death self))
  :post
    (behavior ()
      (vector-v++! (-> self root transv) (compute-acc-due-to-gravity (-> self root) (new-stack-vector0) 0.0))
      (integrate-no-collide! (-> self root) (-> self root transv))
      (ja-post)))

(defmethod balloonlurker-pilot-method-20 ((this balloonlurker-pilot))
  "Create the pilot's touch collision sphere."
  (let ((collision (new 'process 'collide-shape-moving this (collide-list-enum hit-by-player))))
    (set! (-> collision dynam) (copy *standard-dynamics* 'process))
    (set! (-> collision reaction) default-collision-reaction)
    (set! (-> collision no-reaction)
          (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (let ((primitive (new 'process 'collide-shape-prim-sphere collision (the-as uint 2))))
      (set! (-> primitive prim-core collide-as) (collide-kind enemy))
      (set! (-> primitive collide-with) (collide-kind target))
      (set! (-> primitive prim-core offense) (collide-offense touch))
      (set! (-> primitive transform-index) 6)
      (set-vector! (-> primitive local-sphere) 0.0 0.0 0.0 10240.0)
      (set-root-prim! collision primitive))
    (set! (-> collision nav-radius) (* 0.75 (-> collision root-prim local-sphere w)))
    (backup-collide-with-as collision)
    (set! (-> this root) collision))
  0
  (none))

(defmethod balloonlurker-pilot-method-21 ((this balloonlurker-pilot))
  "Initialize the pilot skeleton and select its origin joint."
  (initialize-skeleton this *balloonlurker-pilot-sg* '())
  (set! (-> this draw origin-joint-index) (the-as uint 6))
  0
  (none))

(defbehavior balloonlurker-pilot-init-by-other balloonlurker-pilot ((balloon balloonlurker))
  "Attach a newly spawned pilot to balloon and enter its idle state."
  (logior! (-> self mask) (process-mask enemy))
  (balloonlurker-pilot-method-20 self)
  (logclear! (-> self mask) (process-mask actor-pause))
  (set! (-> self fact) (new 'process 'fact-info-enemy self (pickup-type eco-pill-random) (-> *FACT-bank* default-pill-inc)))
  (set! (-> self root trans quad) (-> balloon root-overlay trans quad))
  (set! (-> self root quat vec quad) (-> balloon root-overlay quat vec quad))
  (set! (-> self root scale quad) (-> balloon root-overlay scale quad))
  (balloonlurker-pilot-method-21 self)
  (go balloonlurker-pilot-idle)
  (none))

(defmethod init-collision! ((this balloonlurker))
  "Create the balloon body, pilot, and mine collision spheres and install the moving shape."
  (let ((collision (new 'process 'collide-shape-moving this (collide-list-enum hit-by-player))))
    (set! (-> collision dynam) (copy *standard-dynamics* 'process))
    (set! (-> collision reaction) default-collision-reaction)
    (set! (-> collision no-reaction)
          (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (let ((root-group (new 'process 'collide-shape-prim-group collision (the-as uint 4) 0)))
      (set! (-> root-group prim-core collide-as) (collide-kind enemy))
      (set! (-> root-group collide-with) (collide-kind target))
      (set! (-> root-group prim-core action) (collide-action solid))
      (set-vector! (-> root-group local-sphere) 0.0 40960.0 0.0 61440.0)
      (set-root-prim! collision root-group)
      (let ((body-sphere (new 'process 'collide-shape-prim-sphere collision (the-as uint 1))))
        (set! (-> body-sphere prim-core collide-as) (collide-kind enemy))
        (set! (-> body-sphere collide-with) (collide-kind target))
        (set! (-> body-sphere prim-core action) (collide-action solid))
        (set! (-> body-sphere prim-core offense) (collide-offense indestructible))
        (set-vector! (-> body-sphere local-sphere) 0.0 57344.0 0.0 28672.0)
        (append-prim root-group body-sphere))
      (let ((pilot-sphere (new 'process 'collide-shape-prim-sphere collision (the-as uint 4))))
        (set! (-> pilot-sphere prim-core collide-as) (collide-kind enemy))
        (set! (-> pilot-sphere collide-with) (collide-kind target))
        (set! (-> pilot-sphere prim-core offense) (collide-offense normal-attack))
        (set! (-> pilot-sphere transform-index) 4)
        (set-vector! (-> pilot-sphere local-sphere) 0.0 0.0 -8192.0 10240.0)
        (append-prim root-group pilot-sphere))
      (let ((mine-0-sphere (new 'process 'collide-shape-prim-sphere collision (the-as uint 8))))
        (set! (-> mine-0-sphere prim-core collide-as) (collide-kind enemy))
        (set! (-> mine-0-sphere collide-with) (collide-kind target))
        (set! (-> mine-0-sphere prim-core offense) (collide-offense normal-attack))
        (set! (-> mine-0-sphere transform-index) 10)
        (set-vector! (-> mine-0-sphere local-sphere) 0.0 -8192.0 0.0 6144.0)
        (append-prim root-group mine-0-sphere))
      (let ((mine-1-sphere (new 'process 'collide-shape-prim-sphere collision (the-as uint 16))))
        (set! (-> mine-1-sphere prim-core collide-as) (collide-kind enemy))
        (set! (-> mine-1-sphere collide-with) (collide-kind target))
        (set! (-> mine-1-sphere prim-core offense) (collide-offense normal-attack))
        (set! (-> mine-1-sphere transform-index) 7)
        (set-vector! (-> mine-1-sphere local-sphere) 0.0 -8192.0 0.0 6144.0)
        (append-prim root-group mine-1-sphere)))
    (set! (-> collision nav-radius) (* 0.75 (-> collision root-prim local-sphere w)))
    (backup-collide-with-as collision)
    (set! (-> collision max-iteration-count) (the-as uint 1))
    (set! (-> this root-overlay) collision))
  0
  (none))

(defmethod init-platform! ((this balloonlurker))
  "Initialize art, path following, rigid-body control points, steering joints, mines, sounds,
   and the balloon's initial control state."
  (logclear! (-> this mask) (process-mask actor-pause))
  (initialize-skeleton this *balloonlurker-sg* '())
  (set! (-> this root-overlay pause-adjust-distance) 1228800.0)
  (set! (-> this fact) (new 'process 'fact-info-enemy this (pickup-type eco-pill-random) (-> *FACT-bank* default-pill-inc)))
  (set! (-> this water-y) (-> this root-overlay trans y))
  (set! (-> this path) (new 'process 'path-control this 'path 0.0))
  (logior! (-> this path flags) (path-control-flag display draw-line draw-point draw-text))
  (set! (-> this link) (new 'process 'actor-link-info this))
  (balloonlurker-find-nearest-path-point)
  (balloonlurker-snap-to-path-point (-> this dest-index))
  (setup-from-constants! this *balloonlurker-constants*)
  (dotimes (i 4)
    (let ((control-point (-> this control-point-array data i)))
      (let ((angle (* 16384.0 (the float (logand i 3)))))
        (set! (-> control-point local-pos x) (* 24576.0 (cos angle)))
        (set! (-> control-point local-pos y) 61440.0)
        (set! (-> control-point local-pos z) (* 36864.0 (sin angle))))
      (set! (-> control-point local-pos w) 1.0)))
  (let ((rudder-point (-> this control-point-array data 4)))
    (set! (-> rudder-point local-pos x) 0.0)
    (set! (-> rudder-point local-pos y) 61440.0)
    (set! (-> rudder-point local-pos z) -40960.0)
    (set! (-> rudder-point local-pos w) 1.0))
  (let ((thrust-point (-> this control-point-array data 5)))
    (set! (-> thrust-point local-pos x) 0.0)
    (set! (-> thrust-point local-pos y) 61440.0)
    (set! (-> thrust-point local-pos z) 40960.0)
    (set! (-> thrust-point local-pos w) 1.0))
  (let ((center-point (-> this control-point-array data 6)))
    (set! (-> center-point local-pos x) 0.0)
    (set! (-> center-point local-pos y) 0.0)
    (set! (-> center-point local-pos z) 0.0)
    (set! (-> center-point local-pos w) 1.0))
  (set! (-> this buoyancy-factor) (-> this info buoyancy-factor))
  (set! (-> this player-impulse) #f)
  (set! (-> this player-contact) #f)
  (set! (-> this auto-pilot) #t)
  (set! (-> this vulnerable) #t)
  (set! (-> this dead) #f)
  (set! (-> this explosion) #f)
  (set! (-> this propeller) (new 'process 'joint-mod-spinner this 4 (new 'static 'vector :z -1.0 :w 1.0) 8192.0))
  (set! (-> this rudder) (new 'process 'joint-mod-set-local this 12 #f #t #f))
  (set! (-> this mine 0) (new 'process 'joint-mod-set-world this 8 #f))
  (set! (-> this mine 1) (new 'process 'joint-mod-set-world this 5 #f))
  (set! (-> this explosion-joint-index-bytes 0) 10)
  (set! (-> this explosion-joint-index-bytes 1) 7)
  (set! (-> this engine-sound-id) (new 'static 'sound-id))
  (set! (-> this pedal-sound-id) (new 'static 'sound-id))
  (set! (-> this player-force quad) (-> *null-vector* quad))
  (set! (-> this player-velocity quad) (-> *null-vector* quad))
  0
  (none))

;; WARN: Function (method 11 balloonlurker) has a return type of none, but the expression builder found a return statement.
(defmethod init-from-entity! ((this balloonlurker) (source-entity entity-actor))
  "Create the collision and drawable platform state, then either remain permanently destroyed
   or spawn the pilot and begin patrolling."
  (logior! (-> this mask) (process-mask enemy))
  (init-collision! this)
  (process-drawable-from-entity! this source-entity)
  (init-platform! this)
  (cond
    ((logtest? (-> (entity-actor-lookup (-> this entity) 'alt-actor 0) extra perm status) (entity-perm-status complete))
     (process-entity-status! this (entity-perm-status dead) #t)
     (return #f))
    (else (process-spawn balloonlurker-pilot this :to this) (go balloonlurker-patrol)))
  (none))

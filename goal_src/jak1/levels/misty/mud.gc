;;-*-Lisp-*-
(in-package goal)
(bundles "MIS.DGO")
(require "engine/common-obs/water-anim.gc")

;; DECOMP BEGINS

(deftype mud (water-anim)
  "Misty Island animated mud with level-specific ripple waveforms and fade distances."
  ())

(define ripple-for-mud
  (new 'static
       'ripple-wave-set
       :count 3
       :converted #f
       :normal-scale 1.0
       :wave
       (new 'static
            'inline-array
            ripple-wave
            4
            (new 'static 'ripple-wave :scale 40.0 :xdiv 1 :speed 1.5)
            (new 'static 'ripple-wave :scale 40.0 :xdiv -1 :zdiv 1 :speed 1.5)
            (new 'static 'ripple-wave :scale 20.0 :xdiv 5 :zdiv 3 :speed 0.75)
            (new 'static 'ripple-wave))))

(define ripple-for-small-mud
  (new 'static
       'ripple-wave-set
       :count 3
       :converted #f
       :normal-scale 1.0
       :wave
       (new 'static
            'inline-array
            ripple-wave
            4
            (new 'static 'ripple-wave :scale 20.0 :xdiv 2 :speed 0.5)
            (new 'static 'ripple-wave :scale 20.0 :xdiv -2 :zdiv 2 :speed 0.5)
            (new 'static 'ripple-wave :scale 20.0 :xdiv 5 :zdiv 3 :speed 0.75)
            (new 'static 'ripple-wave))))

(defmethod setup-water! ((this mud))
  "Run the animated-water setup, mark this volume as mud, create its ripple controller, and
   select large or small waves and fade distances from the placed look."
  (let ((parent-method (method-of-type water-anim setup-water!))) (parent-method this))
  (logclear! (-> this flag) (water-flag part-water))
  (logior! (-> this flag) (water-flag mud))
  (let ((ripple (new 'process 'ripple-control)))
    (set! (-> this draw ripple) ripple)
    (set! (-> ripple global-scale) 3072.0)
    (set! (-> ripple waveform) ripple-for-mud)
    (let ((fade-distances (res-lump-data (-> this entity) 'water-anim-fade-dist (pointer float))))
      (when fade-distances
        (set! (-> ripple close-fade-dist) (-> fade-distances 0))
        (set! (-> ripple far-fade-dist) (-> fade-distances 1))))
    (case (-> this look)
      (((water-look water-anim-misty-mud-by-arena)
        (water-look water-anim-misty-mud-above-skull-front)
        (water-look water-anim-misty-mud-by-dock))
       (set! (-> ripple close-fade-dist) 4096000000.0)
       (set! (-> ripple far-fade-dist) 8192000000.0)))
    (case (-> this look)
      (((water-look water-anim-misty-mud-above-skeleton)
        (water-look water-anim-misty-mud-above-skull-front)
        (water-look water-anim-misty-mud-above-skull-back)
        (water-look water-anim-misty-mud-near-skull)
        (water-look water-anim-misty-mud-other-near-skull)
        (water-look water-anim-misty-mud-lonely-island))
       (set! (-> ripple waveform) ripple-for-small-mud))))
  (none))

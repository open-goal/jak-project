;;-*-Lisp-*-
(in-package goal)
(bundles "SNO.DGO")
(require "engine/common-obs/generic-obs.gc")
(require "engine/geometry/path.gc")
(require "engine/gfx/shadow/shadow-cpu.gc")

;; DECOMP BEGINS

(deftype snow-ball-shadow (process-drawable) ()
  (:states
   snow-ball-shadow-idle))

(deftype snow-ball-junction (structure)
  ((enter-time time-frame)
   (exit-time  time-frame)))

(deftype snow-ball-path-info (structure)
  ((hug-path? symbol)
   (path-pos  vector :inline)))

(deftype snow-ball-roller (process-drawable)
  ((root                   collide-shape-moving :override)
   (which-path             int32)
   (path-u                 float)
   (path-speed             float)
   (path-length            float)
   (path-fall-u            float)
   (path-coming-out-u      float)
   (path-faded-up-u        float)
   (delay-til-bounce       int32)
   (rolling-sound-id       sound-id)
   (rolling-sound-enabled? symbol)
   (last-bounce-time       time-frame)
   (hit-player-time        time-frame)
   (path-info              snow-ball-path-info :inline)
   (junctions              snow-ball-junction 4 :inline))
  (:methods
   (follow-path (_type_) none)
   (play-landing-sound (_type_ float) sound-id)
   (attack-target! (_type_ process-drawable) none))
  (:states
   snow-ball-roller-idle))

(deftype snow-ball (process)
  ((child-override         (pointer snow-ball-roller) :overlay-at child)
   (state-time             time-frame)
   (last-path-picked       int32)
   (same-path-picked-count int32)
   (delay-til-next         int32)
   (path                   curve-control 2))
  (:methods
   (compute-junction-times! (_type_ (inline-array snow-ball-junction) float int) symbol)
   (junctions-clear? (_type_ (inline-array snow-ball-junction) int) symbol))
  (:states
   snow-ball-idle))

(defskelgroup *snow-ball-sg*
  snow-ball
  snow-ball-lod0-jg
  snow-ball-idle-ja
  ((snow-ball-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 3))

(defskelgroup *snow-ball-shadow-sg*
  snow-ball
  snow-ball-shadow-lod0-jg
  -1
  ((snow-ball-shadow-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 -1.5 0 2)
  :shadow snow-ball-shadow-shadow-mg)

(define *snow-ball-shadow-control*
  (new 'static
       'shadow-control
       :settings
       (new 'static
            'shadow-settings
            :flags (shadow-flags disable-fade scissor-top)
            :shadow-dir
            (new 'static 'vector :y -1.0 :w 245760.0)
            :bot-plane
            (new 'static 'plane :y 1.0 :w 26624.0)
            :top-plane
            (new 'static 'plane :y 1.0)
            :fade-dist 819200.0)))

(defstate snow-ball-shadow-idle (snow-ball-shadow)
  :trans
    (behavior ()
      (vector-copy! (-> self root trans) (-> (the-as process-drawable (-> self parent 0)) root trans))
      (update-direction-from-time-of-day (-> self draw shadow-ctrl))
      0)
  :code
    (behavior ()
      (loop
        (logior! (-> self mask) (process-mask sleep-code))
        (suspend)))
  :post ja-post)

(defbehavior snow-ball-shadow-init-by-other snow-ball-shadow ()
  (stack-size-set! (-> self main-thread) 128)
  (logclear! (-> self mask) (process-mask actor-pause movie enemy platform projectile))
  (set! (-> self root) (new 'process 'trsqv))
  (vector-copy! (-> self root trans) (-> (the-as process-drawable (-> self parent 0)) root trans))
  (quaternion-identity! (-> self root quat))
  (vector-identity! (-> self root scale))
  (initialize-skeleton self *snow-ball-shadow-sg* '())
  (ja-channel-set! 1)
  (ja :group! snow-ball-shadow-idle-ja :num! min)
  (set! (-> self draw shadow-ctrl) *snow-ball-shadow-control*)
  (go snow-ball-shadow-idle)
  (none))

(defbehavior snow-ball-roller-path-init snow-ball-roller ()
  (set! (-> self path-u) 0.0)
  (set! (-> self path-length) (path-distance (-> self path)))
  (none))

(defmethod follow-path ((this snow-ball-roller))
  "Update the roller's path target, horizontal motion, fade-in, and end-of-path fall state for
   its current path position."
  (let ((path-info (-> this path-info)))
    (set! (-> path-info hug-path?) #f)
    (let ((previous-path-position (new 'stack-no-clear 'vector)))
      (vector-copy! previous-path-position (-> path-info path-pos))
      (eval-path-curve! (-> this path) (-> path-info path-pos) (-> this path-u) 'interp)
      (let ((emerge-end (-> this path-coming-out-u)))
        (when (< (-> this path-u) emerge-end)
          (+! (-> path-info path-pos y) (- -20480.0 (* -20480.0 (/ (-> this path-u) emerge-end))))
          (set! (-> path-info hug-path?) #t)))
      (let ((fade-end (-> this path-faded-up-u)))
        (cond
          ((< (-> this path-u) fade-end)
           (let ((fade (square (/ (-> this path-u) fade-end)))) (set-vector! (-> this draw color-mult) fade fade fade 1.0)))
          (else (vector-identity! (-> this draw color-mult)))))
      (cond
        ((>= (-> this path-u) (-> this path-fall-u))
         (set! (-> path-info path-pos y) -409600.0)
         (set! (-> path-info path-pos x) (+ (-> previous-path-position x) (-> this root transv x)))
         (set! (-> path-info path-pos z) (+ (-> previous-path-position z) (-> this root transv z)))
         (set! (-> this rolling-sound-enabled?) #f))
        (else
         (set! (-> this root transv x) (- (-> path-info path-pos x) (-> previous-path-position x)))
         (set! (-> this root transv z) (- (-> path-info path-pos z) (-> previous-path-position z)))))))
  (none))

(defmethod play-landing-sound ((this snow-ball-roller) (vertical-speed float))
  "Play the landing sound at a volume derived from the magnitude of the vertical impact speed."
  (let ((volume (* 0.0018780049 (fmin 53248.0 (fmax 0.0 (+ -4096.0 (fabs vertical-speed)))))))
    (sound-play "snowball-land" :vol volume)))

(defbehavior snow-ball-roller-path-update snow-ball-roller ()
  (local-vars (f0-5 float))
  (let ((f0-0 (-> self root trans y)))
    (+! (-> self root transv y) (* -491520.0 (seconds-per-frame)))
    (let ((f30-0 (+ f0-0 (* (-> self root transv y) (seconds-per-frame)))))
      (follow-path self)
      (let ((a1-0 (new 'stack-no-clear 'vector)))
        (let ((a0-1 (-> self path-info))) (vector-copy! a1-0 (-> a0-1 path-pos)))
        (+! (-> a1-0 y) 9216.0)
        (cond
          ((-> self path-info hug-path?) (move-to-point! (-> self root) a1-0) (set! (-> self root transv y) 0.0))
          ((begin (set! f0-5 (- f30-0 (-> a1-0 y))) (< 0.0 f0-5)) (+! (-> a1-0 y) f0-5) (move-to-point! (-> self root) a1-0))
          (else
           (move-to-point! (-> self root) a1-0)
           (let ((f0-7 (-> self root transv y)))
             (cond
               ((>= -40960.0 f0-7) (set! (-> self root transv y) (* 0.4 (- f0-7))) (play-landing-sound self (-> self root transv y)))
               (else (set! (-> self root transv y) 0.0))))
           (when (< (-> self path-u) (-> self path-fall-u))
             (when (time-elapsed? (-> self last-bounce-time) (-> self delay-til-bounce))
               (let ((f0-13 (rand-vu-float-range 8192.0 20480.0))) (+! (-> self root transv y) f0-13) (play-landing-sound self f0-13))
               (set-time! (-> self last-bounce-time))
               (set! (-> self delay-til-bounce) (rand-vu-int-range 300 2100)))))))))
  (let ((s4-0 (new 'stack-no-clear 'vector)))
    (get-tangent-at-percent! (-> self path) s4-0 (-> self path-u))
    (let ((gp-0 (new 'stack-no-clear 'matrix)))
      (let ((s5-0 (new 'stack-no-clear 'matrix)))
        (let ((s3-0 (new 'stack-no-clear 'vector)))
          (vector-negate! s3-0 (-> *standard-dynamics* gravity-normal))
          (forward-down->inv-matrix gp-0 s4-0 s3-0))
        (matrix-rotate-x! s5-0 (* 1.1317686 (-> self path-u) (-> self path-length)))
        (matrix*! gp-0 s5-0 gp-0))
      (matrix->quaternion (-> self root quat) gp-0)))
  (+! (-> self path-u) (* (-> self path-speed) (seconds-per-frame)))
  (if (< 1.0 (-> self path-u)) (set! (-> self path-u) 1.0))
  (let ((f0-23 (- 819200.0 (-> self root trans y))))
    (when (>= f0-23 0.0)
      (cond
        ((>= f0-23 245760.0) (deactivate self))
        (else
         (let ((f0-25 (- 1.0 (/ f0-23 (meters 60)))))
           (set! (-> self root scale x) f0-25)
           (set! (-> self root scale y) f0-25)
           (set! (-> self root scale z) f0-25))))))
  (let ((v1-54 (< (vector-vector-distance (-> self root trans) (math-camera-pos)) 163840.0)))
    (cond
      ((zero? (-> self rolling-sound-id))
       (if (and v1-54 (-> self rolling-sound-enabled?))
         (set! (-> self rolling-sound-id) (sound-play "snowball-roll" :position (the-as symbol (-> self root trans))))))
      ((and v1-54 (-> self rolling-sound-enabled?))
       (sound-play "snowball-roll" :id (-> self rolling-sound-id) :position (the-as symbol (-> self root trans))))
      (else (sound-stop (-> self rolling-sound-id)) (set! (-> self rolling-sound-id) (new 'static 'sound-id)) 0)))
  (none))

(defmethod attack-target! ((this snow-ball-roller) (target process-drawable))
  "Bounce the roller upward and shove target away with an attack event. Keep the shove at least
   60 degrees away from the roller's path direction."
  (cond
    ((< (+ 4096.0 (-> target root trans y)) (-> this root trans y))
     (let ((f0-2 81920.0)) (+! (-> this root transv y) f0-2) (play-landing-sound this f0-2)))
    (else (let ((f0-3 24576.0)) (+! (-> this root transv y) f0-3) (play-landing-sound this f0-3))))
  (let ((push-direction (new 'stack-no-clear 'vector)))
    (let ((path-direction (new 'stack-no-clear 'vector)))
      (vector-! push-direction (-> target root trans) (-> this root trans))
      (set! (-> push-direction y) 0.0)
      (vector-normalize! push-direction 1.0)
      (get-tangent-at-percent! (-> this path) path-direction (-> this path-u))
      (set! (-> path-direction y) 0.0)
      (vector-normalize! path-direction 1.0)
      (let* ((target-angle (atan (-> push-direction x) (-> push-direction z)))
             (path-angle (atan (-> path-direction x) (-> path-direction z)))
             (angle-difference (deg- target-angle path-angle)))
        (when (< (fabs angle-difference) 10922.667)
          (let ((limited-angle (+ path-angle (if (>= angle-difference 0.0) 10922.667 -10922.667))))
            (set-vector! push-direction (sin limited-angle) 0.0 (cos limited-angle) 1.0)))))
    (vector-normalize! push-direction 25600.0)
    (vector+! push-direction push-direction (-> this root trans))
    (vector-! push-direction push-direction (-> target root trans))
    (set! (-> push-direction y) 0.0)
    (let ((shove-distance (vector-length push-direction)))
      (vector-normalize! push-direction 1.0)
      (send-event target
                  'attack
                  #f
                  (static-attack-info ((vector push-direction) (shove-up (meters 3)) (shove-back shove-distance))))))
  (none))

(defstate snow-ball-roller-idle (snow-ball-roller)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('touch 'attack)
         (when (= (-> proc type) target)
           (do-push-aways! (-> self root))
           (when (time-elapsed? (-> self hit-player-time) (seconds 0.5))
             (set-time! (-> self hit-player-time))
             (attack-target! self *target*))))))
  :enter
    (behavior ()
      (set-time! (-> self last-bounce-time))
      (snow-ball-roller-path-init))
  :exit
    (behavior ()
      (set! (-> self rolling-sound-enabled?) #f)
      (when (nonzero? (-> self rolling-sound-id))
        (sound-stop (-> self rolling-sound-id))
        (set! (-> self rolling-sound-id) (new 'static 'sound-id))
        0))
  :trans
    (behavior ()
      (snow-ball-roller-path-update))
  :code
    (behavior ()
      (loop
        (logior! (-> self mask) (process-mask sleep-code))
        (suspend)))
  :post transform-post)

(defbehavior snow-ball-roller-init-by-other snow-ball-roller ((source-entity entity-actor)
              (parent snow-ball)
              (path-speed float)
              (path-index int)
              (junctions (inline-array snow-ball-junction)))
  (set! (-> self rolling-sound-id) (new 'static 'sound-id))
  (set! (-> self rolling-sound-enabled?) #t)
  (set! (-> self path-speed) path-speed)
  (set! (-> self which-path) path-index)
  (set! (-> self hit-player-time) 0)
  (set! (-> self entity) source-entity)
  (dotimes (i 4)
    (mem-copy! (the-as pointer (-> self junctions i)) (the-as pointer (-> junctions i)) 16))
  (let ((collision-shape (new 'process 'collide-shape-moving self (collide-list-enum hit-by-player))))
    (set! (-> collision-shape dynam) (copy *standard-dynamics* 'process))
    (set! (-> collision-shape reaction) default-collision-reaction)
    (set! (-> collision-shape no-reaction)
          (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (let ((collision-prim (new 'process 'collide-shape-prim-sphere collision-shape (the-as uint 0))))
      (set! (-> collision-prim prim-core collide-as) (collide-kind enemy))
      (set! (-> collision-prim collide-with) (collide-kind target))
      (set! (-> collision-prim prim-core action) (collide-action solid))
      (set! (-> collision-prim prim-core offense) (collide-offense indestructible))
      (set-vector! (-> collision-prim local-sphere) 0.0 0.0 0.0 10240.0)
      (set-root-prim! collision-shape collision-prim))
    (set! (-> collision-shape nav-radius) (* 0.75 (-> collision-shape root-prim local-sphere w)))
    (backup-collide-with-as collision-shape)
    (set! (-> self root) collision-shape))
  (set-vector! (-> self root transv) 0.0 0.0 0.0 1.0)
  (process-drawable-from-entity! self source-entity)
  (initialize-skeleton self *snow-ball-sg* '())
  (logclear! (-> self mask) (process-mask actor-pause))
  (set! (-> self path) (new 'process 'curve-control self 'path (the float (+ path-index 1))))
  (logior! (-> self path flags) (path-control-flag display draw-line draw-point draw-text))
  (let ((selected-path (-> self which-path)))
    (cond
      ((zero? selected-path)
       (set! (-> self path-fall-u) 0.8667)
       (set! (-> self path-coming-out-u) 0.05)
       (set! (-> self path-faded-up-u) 0.075))
      ((= selected-path 1)
       (set! (-> self path-fall-u) 0.9105)
       (set! (-> self path-coming-out-u) 0.05)
       (set! (-> self path-faded-up-u) 0.075))))
  (set! (-> self delay-til-bounce) (rand-vu-int-range 900 2100))
  (process-spawn snow-ball-shadow :to self)
  (go snow-ball-roller-idle)
  (none))

(defmethod compute-junction-times! ((this snow-ball) (junctions (inline-array snow-ball-junction)) (path-speed float) (path-index int))
  "Fill four junction intervals with the times at which a roller traveling at path-speed will
   enter and leave the path's crossing regions. The normalized crossing positions differ
   between the two paths."
  (local-vars (normalized-times (pointer float)))
  (if (zero? path-index)
    (set! normalized-times (new 'static 'array float 8 0.3309 0.36 0.4691 0.5061 0.6904 0.7264 0.864 0.8667))
    (set! normalized-times (new 'static 'array float 8 0.3344 0.3528 0.4919 0.5246 0.6967 0.7272 0.8677 0.9105)))
  (let ((progress-per-frame (* path-speed (seconds-per-frame)))
        (junction (-> junctions 0))
        (now (current-time)))
    (dotimes (i 4)
      (set! (-> junction enter-time) (+ now (the int (/ (-> normalized-times 0) progress-per-frame))))
      (set! (-> junction exit-time) (+ now (the int (/ (-> normalized-times 1) progress-per-frame))))
      (set! normalized-times (&-> normalized-times 2))
      (&+! junction 16)))
  #f)

(defmethod junctions-clear? ((this snow-ball) (new-junctions (inline-array snow-ball-junction)) (path-index int))
  "Return true when the proposed crossing intervals do not overlap any active roller. Rollers
   on the same path also compare their fourth interval; rollers on opposite paths only compare
   the three shared crossings."
  (local-vars (result symbol))
  (let ((roller (-> this child-override)))
    (while roller
      (let ((new-junction (-> new-junctions 0))
            (roller-junction (-> roller 0 junctions)))
        (dotimes (i 3)
          (if (and (>= (-> roller-junction 0 exit-time) (-> new-junction enter-time))
                   (>= (-> new-junction exit-time) (-> roller-junction 0 enter-time)))
            (return #f))
          (&+! new-junction 16)
          (set! roller-junction (the-as (inline-array snow-ball-junction) (-> roller-junction 1))))
        (when (= path-index (-> roller 0 which-path))
          (if (>= (-> roller-junction 0 exit-time) (-> new-junction enter-time)) (return #f))))
      (set! roller (the-as (pointer snow-ball-roller) (-> roller 0 brother)))))
  (return #t)
  result)

(defstate snow-ball-idle (snow-ball)
  :code
    (behavior ()
      (local-vars (gp-0 int))
      (set-time! (-> self state-time))
      (set! (-> self delay-til-next) 0)
      (label cfg-1)
      (when (time-elapsed? (-> self state-time) (-> self delay-til-next))
        (set! gp-0
              (cond
                ((>= (-> self same-path-picked-count) 2) (if (zero? (-> self last-path-picked)) (set! gp-0 1) (set! gp-0 0)) gp-0)
                (else (rand-vu-int-range 0 1))))
        (let ((s4-0 0)
              (s5-0 (new 'stack-no-clear 'inline-array 'snow-ball-junction 4)))
          (loop
            (let ((s3-0 (/ (+ 98304.0 (rand-vu-float-range 0.0 32768.0)) (path-distance (-> self path gp-0)))))
              (compute-junction-times! self s5-0 s3-0 gp-0)
              (when (junctions-clear? self s5-0 gp-0)
                (process-spawn snow-ball-roller (-> self entity) self s3-0 gp-0 s5-0 :to self)
                (set-time! (-> self state-time))
                (set! (-> self delay-til-next) (rand-vu-int-range 450 1650))
                (cond
                  ((= gp-0 (-> self last-path-picked)) (+! (-> self same-path-picked-count) 1))
                  (else (set! (-> self last-path-picked) gp-0) (set! (-> self same-path-picked-count) 1)))
                (goto cfg-22)))
            (+! s4-0 1)
            (if (< 5 s4-0) (goto cfg-22)))))
      (label cfg-22)
      (suspend)
      (b! #t cfg-1 :delay (nop!))))

(defmethod relocate ((this snow-ball) (offset int))
  "Relocate the process and adjust both path-control pointers before calling the parent method."
  (dotimes (i 2)
    (if (nonzero? (-> this path i)) (&+! (-> this path i) offset)))
  (call-parent-method this offset))

(defmethod init-from-entity! ((this snow-ball) (source-entity entity-actor))
  "Create both snowball paths, initialize path-selection history, and begin spawning rollers."
  (set! (-> this last-path-picked) 1)
  (set! (-> this same-path-picked-count) 1)
  (dotimes (i 2)
    (set! (-> this path i) (new 'process 'curve-control this 'path (the float (+ i 1)))))
  (logclear! (-> this mask) (process-mask actor-pause))
  (go snow-ball-idle)
  (none))

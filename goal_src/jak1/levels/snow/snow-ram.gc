;;-*-Lisp-*-
(in-package goal)
(bundles "SNO.DGO")
(require "levels/snow/snow-ram-h.gc")
(require "levels/snow/snow-ram-boss.gc")
(require "levels/snow/snow-obs.gc")

;; DECOMP BEGINS

(defskelgroup *ram-sg*
  ram
  ram-lod0-jg
  ram-cock-ja
  ((ram-lod0-mg (meters 20)) (ram-lod1-mg (meters 40)) (ram-lod2-mg (meters 999999)))
  :bounds (static-spherem 0 5 0 8.5)
  :longest-edge (meters 7.7))


(defpart 1921
  :init-specs
  ((:texture (starflash effects))
   (:num 1.0)
   (:scale-x (meters 6) (meters 1))
   (:rot-z (degrees 0) (degrees 360))
   (:scale-y :copy scale-x)
   (:r 100.0)
   (:g 100.0)
   (:b 128.0)

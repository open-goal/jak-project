   (:accel-y (meters 0.00016666666) (meters 0.00016666666))
   (:timer (seconds 0.7))
   (:flags (die-when-faded glow use-time-of-day-color))
   (:conerot-x (degrees 0) (degrees 180))
   (:conerot-y (degrees 0) (degrees 360))

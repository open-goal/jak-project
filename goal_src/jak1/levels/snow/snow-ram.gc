(defmethod spawn-wall-hit-particles! ((this ram))
  "Spawn the wall-impact dust burst in front of the ram during its slam."
  (let ((launch-control (-> this part)))
    (when (nonzero? launch-control)
      (let ((wall-joint-matrix (-> this node-list data 8 bone transform))
            (spawn-position (new 'stack-no-clear 'vector)))
        (set-vector! spawn-position 0.0 0.0 -49152.0 1.0)
        (vector-matrix*! spawn-position spawn-position wall-joint-matrix)
        (set! (-> *part-id-table* 1920 init-specs 16 initial-valuef) (+ 16384.0 (-> this orient-ry)))
        (spawn launch-control spawn-position)))))

(defmethod spawn-wheel-puffs! ((this ram))
  "Spawn dust puffs beside both rear wheels during the ram's slam."
  (let ((launch-control (-> this part2))
        (left-wheel-position (new 'stack-no-clear 'vector))
        (puff-position (new 'stack-no-clear 'vector)))
    (vector<-cspace! left-wheel-position (-> this node-list data 5))
    (set-vector! puff-position 13312.0 -5324.8 0.0 1.0)
    (vector-rotate-around-y! puff-position puff-position (-> this orient-ry))
    (vector+! puff-position puff-position left-wheel-position)
    (spawn launch-control puff-position)
    (set-vector! puff-position -13312.0 -5324.8 0.0 1.0)
    (vector-rotate-around-y! puff-position puff-position (-> this orient-ry))
    (vector+! puff-position puff-position left-wheel-position)
    (spawn launch-control puff-position)
    (let ((right-wheel-position (new 'stack-no-clear 'vector)))
      (set! puff-position (new 'stack-no-clear 'vector))
      (vector<-cspace! right-wheel-position (-> this node-list data 6))
      (set-vector! puff-position 13312.0 -5324.8 0.0 1.0)
      (vector-rotate-around-y! puff-position puff-position (-> this orient-ry))
      (vector+! puff-position puff-position right-wheel-position)
      (spawn launch-control puff-position)
      (set-vector! puff-position -13312.0 -5324.8 0.0 1.0)
      (vector-rotate-around-y! puff-position puff-position (-> this orient-ry))
      (vector+! puff-position puff-position right-wheel-position))
    (spawn launch-control puff-position)))

(defmethod complete-ram-task! ((this ram))
  "Mark this ram complete, update the snow-ram reminder progress, and return whether this ram should
   award the fuel cell."
  (process-entity-status! this (entity-perm-status complete) #t)
  (let ((incomplete-count (alt-actor-list-subtask-incomplete-count this)))
    (cond
      ((zero? incomplete-count)
       (let ((permanent-state (-> this entity extra perm)))
         (logior! (-> permanent-state status) (entity-perm-status user-set-from-cstage))
         (set! (-> permanent-state user-int8 2) 1))
       (if (not (task-complete? *game-info* (-> this entity extra perm task))) (return #t)))
      ((= incomplete-count 1) (close-specific-task! (game-task snow-ram) (task-status need-reminder)))
      (else (close-specific-task! (game-task snow-ram) (task-status need-reminder-a)))))
  #f)

(defstate ram-idle (ram)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('touch 'attack)
         (if ((method-of-type touching-shapes-entry prims-touching?)
              (the-as touching-shapes-entry (-> block param 0))
              (-> self root)
              (the-as uint 1))
           (send-event proc 'attack (-> block param 0) (static-attack-info ((shove-up (meters 0.5)) (shove-back (meters 2)))))))))
  :exit
    (behavior ()
      (logior! (-> self mask) (process-mask actor-pause)))
  :trans
    (behavior ()
      (rider-trans)
      (if (-> self give-fuel-cell-anim) (spool-push *art-control* (-> self give-fuel-cell-anim name) 0 self -99.0)))
  :code
    (behavior ()
      (ja-channel-push! 1 (seconds 0.075))
      (loop
        (sound-play "set-ram")
        (ja-play :group! ram-cock-ja :num! (seek!) :frame-num 0.0)
        (let ((gp-1 #f))
          (sound-play "slam-crash")
          (logclear! (-> self mask) (process-mask actor-pause))
          (ja-play :group!
                   ram-release-ja
                   :num! (seek!)
                   :frame-num 0.0
                   (let ((f30-0 (ja-aframe-num 0)))
                     (when (and (not gp-1) (>= f30-0 61.0))
                       (set! gp-1 #t)
                       (spawn-wall-hit-particles! self))
                     (if (and (>= f30-0 62.0) (< f30-0 97.0)) (spawn-wheel-puffs! self)))))
        (logior! (-> self mask) (process-mask actor-pause))
        (let ((sv-16 (the-as symbol #f)))
          (apply-function-forward (-> self link) actor-link-dead-hook (& sv-16))
          (when (or sv-16 (nonzero? (-> self root riders num-riders)))
            (let ((v1-67 (-> self entity extra perm)))
              (logior! (-> v1-67 status) (entity-perm-status user-set-from-cstage))
              (set! (-> v1-67 user-int8 0) 1))
            (send-event (ppointer->process (-> self child)) 'jump)
            (go ram-fun-idle)))))
  :post rider-post)

(defstate ram-fun-idle (ram)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('notify) (when (= (-> proc type) ram-boss) (if (complete-ram-task! self) (go ram-give-fuel-cell))))))
  :trans
    (behavior ()
      (if (-> self give-fuel-cell-anim) (spool-push *art-control* (-> self give-fuel-cell-anim name) 0 self -99.0)))
  :code
    (behavior ()
      (if (-> self give-fuel-cell?) (go ram-give-fuel-cell))
      (ja-channel-push! 1 0)
      (ja :group! ram-idle-ja :num! min)
      (transform-post)
      (logior! (-> self mask) (process-mask sleep-code))
      (suspend)
      0))

(defstate ram-give-fuel-cell (ram)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('notify) (if (and (= (-> proc type) snowcam) (= (-> block param 0) 'die)) (go ram-fun-idle)))))
  :exit
    (behavior ()
      (process-entity-status! self (entity-perm-status no-kill) #f)
      (logior! (-> self mask) (process-mask actor-pause)))
  :code
    (behavior ()
      (set! (-> self give-fuel-cell?) #f)
      (ja-channel-push! 1 0)
      (ja :group! ram-idle-ja :num! min)
      (transform-post)
      (when (and (not (task-complete? *game-info* (-> self entity extra perm task))) (-> self give-fuel-cell-anim))
        (logclear! (-> self mask) (process-mask actor-pause))
        (process-entity-status! self (entity-perm-status no-kill) #t)
        (let ((v1-14 (process-spawn snowcam
                                    :init
                                    pov-camera-init-by-other
                                    (-> self root trans)
                                    *snowcam-sg*
                                    (-> self give-fuel-cell-anim)
                                    0
                                    self
                                    '()
                                    :to
                                    self)))
          (set! (-> (the-as (pointer snowcam) v1-14) 0 seq) (the-as uint 1)))
        (sound-play "cell-prize")
        (logior! (-> self mask) (process-mask sleep-code))
        (suspend)
        0)
      (go ram-fun-idle)))

(defmethod deactivate ((this ram))
  "Stop the wheel-puff controller before ordinary drawable deactivation."
  (if (nonzero? (-> this part2)) (kill-and-free-particles (-> this part2)))
  ((method-of-type process-drawable deactivate) this)
  (none))

(defmethod relocate ((this ram) (offset int))
  "Adjust the wheel-puff controller pointer before relocating the drawable."
  (if (nonzero? (-> this part2)) (&+! (-> this part2) offset))
  (the-as ram ((method-of-type process-drawable relocate) this offset)))

(defmethod init-from-entity! ((this ram) (entity-record entity-actor))
  "Build the rideable ram collision shape, skeleton, particles, and fuel-cell cutscene settings.
   Restore persistent completion state and spawn the associated ram boss when this placement has a
   navigation mesh."
  (set! (-> this give-fuel-cell?) #f)
  (set! (-> this link) (new 'process 'actor-link-info this))
  (let ((collision-shape (new 'process 'collide-shape-moving this (collide-list-enum hit-by-others))))
    (set! (-> collision-shape dynam) (copy *standard-dynamics* 'process))
    (set! (-> collision-shape reaction) default-collision-reaction)
    (set! (-> collision-shape no-reaction)
          (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (alloc-riders collision-shape 1)
    (let ((root-group (new 'process 'collide-shape-prim-group collision-shape (the-as uint 3) 0)))
      (set! (-> root-group prim-core collide-as) (collide-kind ground-object))
      (set! (-> root-group collide-with) (collide-kind target))
      (set! (-> root-group prim-core action) (collide-action solid rider-plat-sticky))
      (set-vector! (-> root-group local-sphere) 0.0 20480.0 0.0 34816.0)
      (set-root-prim! collision-shape root-group)
      (let ((wall-mesh (new 'process 'collide-shape-prim-mesh collision-shape (the-as uint 0) (the-as uint 1))))
        (set! (-> wall-mesh prim-core collide-as) (collide-kind ground-object))
        (set! (-> wall-mesh collide-with) (collide-kind target))
        (set! (-> wall-mesh prim-core action) (collide-action solid))
        (set! (-> wall-mesh prim-core offense) (collide-offense indestructible))
        (set! (-> wall-mesh transform-index) 8)
        (set-vector! (-> wall-mesh local-sphere) 0.0 0.0 0.0 20480.0)
        (append-prim root-group wall-mesh))
      (let ((platform-mesh (new 'process 'collide-shape-prim-mesh collision-shape (the-as uint 1) (the-as uint 2))))
        (set! (-> platform-mesh prim-core collide-as) (collide-kind ground-object))
        (set! (-> platform-mesh collide-with) (collide-kind target))
        (set! (-> platform-mesh prim-core action) (collide-action solid rider-plat-sticky))
        (set! (-> platform-mesh prim-core offense) (collide-offense indestructible))
        (set! (-> platform-mesh transform-index) 3)
        (set-vector! (-> platform-mesh local-sphere) 0.0 20480.0 0.0 34816.0)
        (append-prim root-group platform-mesh))
      (let ((attack-sphere (new 'process 'collide-shape-prim-sphere collision-shape (the-as uint 4))))
        (set! (-> attack-sphere prim-core collide-as) (collide-kind enemy))
        (set! (-> attack-sphere collide-with) (collide-kind target))
        (set! (-> attack-sphere prim-core offense) (collide-offense no-offense))
        (set! (-> attack-sphere transform-index) 3)
        (set-vector! (-> attack-sphere local-sphere) -4096.0 28672.0 12288.0 2252.8)
        (append-prim root-group attack-sphere)))
    (set! (-> collision-shape nav-radius) 20480.0)
    (backup-collide-with-as collision-shape)
    (set! (-> this root) collision-shape))
  (process-drawable-from-entity! this entity-record)
  (initialize-skeleton this *ram-sg* '())
  (logior! (-> this skel status) (janim-status inited))
  (ja-post)
  (update-transforms! (-> this root))
  (set! (-> this orient-ry) (quaternion-y-angle (-> this root quat)))
  (nav-mesh-connect this (-> this root) (the-as nav-control #f))
  (set! (-> this part) (create-launch-control group-ram-hit-wall this))
  (set! (-> this part2) (create-launch-control group-ram-wheel-puffs this))
  (set! (-> this ram-id) (res-lump-value entity-record 'extra-id int))
  (case (-> this ram-id)
    ((1)
     (set! (-> this give-fuel-cell-anim)
           (new 'static 'spool-anim :name "snowcam-ram-boss-in-cave-fuel-cell" :index 7 :parts 1 :command-list '()))
     (set-vector! (-> this fuel-cell-dest-pos) 3137396.8 803676.2 -13560558.0 1.0))
    ((2)
     (set! (-> this give-fuel-cell-anim)
           (new 'static 'spool-anim :name "snowcam-ram-boss-ice-pond-fuel-cell" :index 8 :parts 1 :command-list '()))
     (set-vector! (-> this fuel-cell-dest-pos) 2790289.5 1058152.5 -13639766.0 1.0))
    ((3)
     (set! (-> this give-fuel-cell-anim)
           (new 'static 'spool-anim :name "snowcam-ram-boss-snow-ball-fuel-cell" :index 9 :parts 1 :command-list '()))
     (set-vector! (-> this fuel-cell-dest-pos) 4208423.0 1037348.9 -13591491.0 1.0))
    (else (set! (-> this give-fuel-cell-anim) #f)))
  (let ((boss-finished? #f))
    (if (nonzero? (-> this entity extra perm user-int8 0)) (set! boss-finished? #t))
    (let ((ram-finished? (= (res-lump-value entity-record 'mode uint128) 1)))
      (when (not ram-finished?)
        (when (and (-> this entity) (logtest? (-> this entity extra perm status) (entity-perm-status complete)))
          (set! ram-finished? #t)
          (if (and (nonzero? (-> this entity extra perm user-int8 2))
                   (not (task-complete? *game-info* (-> this entity extra perm task))))
            (birth-pickup-at-point (-> this fuel-cell-dest-pos)
                                   (pickup-type fuel-cell)
                                   (the float (-> this entity extra perm task))
                                   #f
                                   this
                                   (the-as fact-info #f)))
          (go ram-fun-idle)))
      (cond
        ((and (not ram-finished?) (has-nav-mesh? entity-record))
         (cond
           (boss-finished? (process-spawn ram-boss (-> this entity) this #t :to this) (go ram-fun-idle))
           (else (process-spawn ram-boss (-> this entity) this #f :to this) (go ram-idle))))
        (else (go ram-fun-idle)))))
  (none))

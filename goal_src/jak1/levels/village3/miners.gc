(defbehavior minershort-trans-hook minershort ()
  (spawn (-> self part) (vector<-cspace! (new 'stack-no-clear 'vector) (joint-node minershort-lod0-jg candle)))
  (none))

(defmethod play-anim! ((this minershort) (commit? symbol))
  "Select dialogue animation for the current task stage. If commit? is true, also apply the
   associated task, reward, reminder, and paired-character side effects."
  (set! (-> this talk-message) (text-id press-to-talk))
  (case (current-status (-> this tasks))
    (((task-status need-hint) (task-status need-introduction))
     (if (not commit?) (set! (-> this will-talk) #t))
     (case (current-task (-> this tasks))
       (((game-task village3-miner-money1))
        (when commit?
          (let* ((task-control (-> this tasks))
                 (save-reminder-fn (method-of-object task-control save-reminder)))
            (save-reminder-fn task-control (the int (the-as float (send-event *target* 'query 'pickup (pickup-type fuel-cell)))) 1))
          (send-event (-> this other-miner ppointer 3) 'clone (process->handle this))
          (close-specific-task! (game-task village3-miner-money1) (task-status need-introduction))
          (close-specific-task! (game-task village3-miner-money2) (task-status need-introduction))
          (close-specific-task! (game-task village3-miner-money3) (task-status need-introduction))
          (close-specific-task! (game-task village3-miner-money4) (task-status need-introduction)))
        (new 'static
             'spool-anim
             :name "minershort-introduction-orbs"
             :index 4
             :parts 16
             :command-list
             '((171 joint "cameraB")
              (206 joint "camera")
              (423 joint "cameraB")
              (591 joint "camera")
              (692 joint "cameraB")
              (918 joint "camera")
              (1122 joint "cameraB")
              (1122 shadow self #f)
              (1241 joint "camera")
              (1241 shadow self #t))))
       (((game-task cave-gnawers))
        (when commit?
          (let* ((task-control (-> this tasks))
                 (save-reminder-fn (method-of-object task-control save-reminder)))
            (save-reminder-fn task-control (the int (the-as float (send-event *target* 'query 'pickup (pickup-type fuel-cell)))) 1))
          (send-event (-> this other-miner ppointer 3) 'clone (process->handle this))
          (close-status! (-> this tasks) (task-status need-introduction)))
        (new 'static
             'spool-anim
             :name "minershort-introduction-gnawers"
             :index 9
             :parts 8
             :command-list
             '((0 want-levels village3 maincave)
              (149 joint "cameraB")
              (158 display-level maincave movie)
              (158 want-force-vis maincave #t)
              (435 display-level maincave #f)
              (435 joint "camera")
              (680 joint "cameraB")
              (719 joint "camera"))))
       (else
        (when commit?
          (send-event (-> this other-miner ppointer 3) 'clone (process->handle this))
          (close-status! (-> this tasks) (task-status need-introduction)))
        (new 'static
             'spool-anim
             :name "minershort-introduction-switch"
             :index 11
             :parts 7
             :command-list
             '((2 shadow "minertall-1" #f) (835 shadow "minertall-1" #t))))))
    (((task-status need-reminder))
     (set! (-> this skippable) #t)
     (let ((reminder-index (+ (get-reminder (-> this tasks) 0) 1)))
       (if (< (the-as uint 3) (the-as uint reminder-index)) (set! reminder-index 0))
       (countdown (s3-0 4)
         (let ((candidate-index reminder-index))
           (cond
             ((zero? candidate-index)
              (if (not (or (= (get-task-status (game-task village3-miner-money1)) (task-status need-reminder))
                           (= (get-task-status (game-task village3-miner-money2)) (task-status need-reminder))
                           (= (get-task-status (game-task village3-miner-money3)) (task-status need-reminder))
                           (= (get-task-status (game-task village3-miner-money4)) (task-status need-reminder))))
                (set! reminder-index 1)))
             ((= candidate-index 1)
              (if (!= (get-task-status (game-task cave-gnawers)) (task-status need-reminder)) (set! reminder-index 2)))
             ((= candidate-index 2)
              (if (not (or (= (get-task-status (game-task village3-miner-money1)) (task-status need-reminder))
                           (= (get-task-status (game-task village3-miner-money2)) (task-status need-reminder))
                           (= (get-task-status (game-task village3-miner-money3)) (task-status need-reminder))
                           (= (get-task-status (game-task village3-miner-money4)) (task-status need-reminder))))
                (set! reminder-index 3)))
             (else (if (!= (get-task-status (game-task snow-eggtop)) (task-status need-reminder)) (set! reminder-index 0))))))
       (if commit? (save-reminder (-> this tasks) reminder-index 0))
       (cond
         ((zero? reminder-index) (new 'static 'spool-anim :name "minershort-reminder-1-orbs" :index 5 :parts 3 :command-list '()))
         ((= reminder-index 1)
          (if commit? (send-event (-> this other-miner ppointer 3) 'clone (process->handle this)))
          (new 'static 'spool-anim :name "minershort-reminder-1-gnawers" :index 10 :parts 3 :command-list '()))
         ((= reminder-index 2)
          (if commit? (send-event (-> this other-miner ppointer 3) 'clone (process->handle this)))
          (new 'static 'spool-anim :name "minershort-reminder-2-orbs" :index 6 :parts 2 :command-list '()))
         (else
          (if commit? (send-event (-> this other-miner ppointer 3) 'clone (process->handle this)))
          (new 'static
               'spool-anim
               :name "minershort-reminder-1-switch"
               :index 12
               :parts 5
               :command-list
               '((2 shadow "minertall-1" #f) (500 shadow "minertall-1" #t)))))))
    (((task-status need-reward-speech))
     (let ((reward-count (get-reminder (-> this tasks) 2)))
       (cond
         (commit?
          (send-event (-> this other-miner ppointer 3) 'clone (process->handle this))
          (set! (-> this cell-for-task) (current-task (-> this tasks)))
          (close-current! (-> this tasks))
          (send-event *target* 'get-pickup 5 (- (-> *GAME-bank* money-task-inc)))
          (save-reminder (-> this tasks) (+ reward-count 1) 2))
         (else (set! (-> this will-talk) #t) (set! (-> this talk-message) (text-id press-to-trade-money))))
       (if (< (the-as uint reward-count) (the-as uint 3))
         (new 'static 'spool-anim :name "minershort-resolution-1-orbs" :index 7 :parts 2 :command-list '())
         (new 'static
              'spool-anim
              :name "minershort-resolution-2-orbs"
              :index 8
              :parts 6
              :command-list
              '((154 joint "cameraB") (461 joint "camera"))))))
    (else
     (if commit?
       (format 0
               "ERROR: <GMJ>: ~S playing anim for task status ~S~%"
               (-> this name)
               (task-status->string (current-status (-> this tasks)))))
     (-> this draw art-group data 3))))

(defstate play-anim (minershort)
  :virtual #t
  :exit
    (behavior ()
      (send-event (-> self other-miner ppointer 3) 'end-mode)
      ((-> (method-of-type process-taskable play-anim) exit))))

(defmethod get-art-elem ((this minershort))
  "Return the art element on the active root animation channel."
  (-> this draw art-group data 3))

(defmethod try-play-ambient-chatter ((this minershort))
  "Try to play one of the miners' ambient voice lines after the chatter cooldown."
  (when (ambient-control-method-10 (-> this ambient) (new 'stack-no-clear 'vector) (seconds 30) 122880.0 this)
    (let ((choice (rand-float-gen)))
      (cond
        ((< 0.9655172 choice) (play-ambient (-> this ambient) "MIN-LO01" #f (-> this root trans)))
        ((< 0.9310345 choice) (play-ambient (-> this ambient) "MIN-LO03" #f (-> this root trans)))
        ((< 0.8965517 choice) (play-ambient (-> this ambient) "MIN-LO04" #f (-> this root trans)))
        ((< 0.86206895 choice) (play-ambient (-> this ambient) "MIN-LO05" #f (-> this root trans)))
        ((< 0.82758623 choice) (play-ambient (-> this ambient) "MIN-LO06" #f (-> this root trans)))
        ((< 0.79310346 choice) (play-ambient (-> this ambient) "MSH-AM01" #f (-> this root trans)))
        ((< 0.7586207 choice) (play-ambient (-> this ambient) "MSH-AM02" #f (-> this root trans)))
        ((< 0.7241379 choice) (play-ambient (-> this ambient) "MSH-AM03" #f (-> this root trans)))
        ((< 0.6896552 choice) (play-ambient (-> this ambient) "MSH-AM04" #f (-> this root trans)))
        ((< 0.6551724 choice) (play-ambient (-> this ambient) "MSH-AM05" #f (-> this root trans)))
        ((< 0.62068963 choice) (play-ambient (-> this ambient) "MSH-AM06" #f (-> this root trans)))
        ((< 0.5862069 choice) (play-ambient (-> this ambient) "MSH-AM07" #f (-> this root trans)))
        ((< 0.55172414 choice) (play-ambient (-> this ambient) "MSH-AM08" #f (-> this root trans)))
        ((< 0.51724136 choice) (play-ambient (-> this ambient) "MSH-AM09" #f (-> this root trans)))
        ((< 0.4827586 choice) (play-ambient (-> this ambient) "MSH-AM10" #f (-> this root trans)))
        ((< 0.44827586 choice) (play-ambient (-> this ambient) "MSH-AM11" #f (-> this root trans)))
        ((< 0.41379312 choice) (play-ambient (-> this ambient) "MSH-AM12" #f (-> this root trans)))
        ((< 0.37931034 choice) (play-ambient (-> this ambient) "MSH-AM1A" #f (-> this root trans)))
        ((< 0.3448276 choice) (play-ambient (-> this ambient) "MSH-AM2A" #f (-> this root trans)))
        ((< 0.31034482 choice) (play-ambient (-> this ambient) "MSH-AM3A" #f (-> this root trans)))
        ((< 0.27586207 choice) (play-ambient (-> this ambient) "MTA-AM01" #f (-> this root trans)))
        ((< 0.2413793 choice) (play-ambient (-> this ambient) "MTA-AM02" #f (-> this root trans)))
        ((< 0.20689656 choice) (play-ambient (-> this ambient) "MTA-AM03" #f (-> this root trans)))
        ((< 0.1724138 choice) (play-ambient (-> this ambient) "MTA-AM04" #f (-> this root trans)))
        ((< 0.13793103 choice) (play-ambient (-> this ambient) "MTA-AM05" #f (-> this root trans)))
        ((< 0.10344828 choice) (play-ambient (-> this ambient) "MTA-AM06" #f (-> this root trans)))
        ((< 0.06896552 choice) (play-ambient (-> this ambient) "MTA-AM07" #f (-> this root trans)))
        ((< 0.03448276 choice) (play-ambient (-> this ambient) "MTA-AM08" #f (-> this root trans)))
        (else (play-ambient (-> this ambient) "MTA-AM09" #f (-> this root trans)))))))

(defstate idle (minershort)
  :virtual #t
  :code miners-anim-loop)

(defmethod init-from-entity! ((this minershort) (source-entity entity-actor))
  "Initialize the short miner, candle particles, task control, paired tall miner, and dialogue
   music."
  (init-as-taskable! this source-entity *minershort-sg* 34 46 (new 'static 'vector :w 4096.0) 5)
  (set! (-> this part) (create-launch-control group-minershort-candle this))
  (set! (-> this tasks) (get-task-control (game-task village3-miner-money1)))
  (set! (-> this other-miner) (the-as minertall (entity-actor-lookup source-entity 'alt-actor 0)))
  (set! (-> this cur-trans-hook) minershort-trans-hook)
  (set! (-> this sound-flava) (music-flava miners))
  (set! (-> this draw light-index) (the-as uint 1))
  (goto-initial-state! this)
  (none))

(deftype cavegem (process-drawable) ()
  (:state-methods
   idle))

(defskelgroup *cavegem-sg*
  cavegem
  cavegem-lod0-jg
  cavegem-idle-ja
  ((cavegem-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 9))

(defstate idle (cavegem)
  :virtual #t
  :code
    (behavior ()
      (loop
        (ja-play :group! (ja-group) :num! (seek!) :frame-num 0.0)))
  :post ja-post)

(defmethod init-from-entity! ((this cavegem) (source-entity entity-actor))
  "Initialize this cave gem's drawable and looping skeleton animation."
  (set! (-> this root) (new 'process 'trsqv))
  (process-drawable-from-entity! this source-entity)
  (initialize-skeleton this *cavegem-sg* '())
  (go (method-of-object this idle))
  (none))

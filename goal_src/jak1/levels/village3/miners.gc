;;-*-Lisp-*-
(in-package goal)
(bundles "VI3.DGO")
(require "engine/common-obs/process-taskable.gc")
(declare-type minershort process-taskable)

;; DECOMP BEGINS

;; WARN: rewrite_to_get_var got a none typed variable. Is there unreachable code? [OP: 47]
(defbehavior miners-anim-loop process-taskable ()
  (when (!= (ja-group) (get-art-elem self))
    (ja-channel-push! 1 (seconds 0.2))
    (ja :group! (get-art-elem self)))
  (loop
    (suspend)
    (ja :num! (loop! 2.0))
    (if (= (-> self next-state name) 'idle) (try-play-ambient-chatter self)))
  0)

(deftype minertall (process-taskable) ())

(defskelgroup *minertall-sg*
  minertall
  minertall-lod0-jg
  minertall-idle-ja
  ((minertall-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 2.5)
  :shadow minertall-shadow-mg)

(defmethod setup-shadow-settings! ((this minertall))
  "Set the projected shadow's vertical clipping planes relative to the miner's height."
  (let ((shadow-ctrl (-> this draw shadow-ctrl)))
    (when shadow-ctrl
      (let ((root-y (-> this root trans y)))
        (let ((ctrl shadow-ctrl)) (set! (-> ctrl settings bot-plane w) (- (+ -4096.0 root-y))))
        0
        (let ((ctrl shadow-ctrl)) (set! (-> ctrl settings top-plane w) (- (+ 4096.0 root-y)))))
      0
      (logclear! (-> shadow-ctrl settings flags) (shadow-flags scissor-top))))
  (none))

(defmethod draw-npc-shadow ((this minertall))
  "Update the projected shadow when the highest-detail model was drawn this frame; otherwise
   disable it."
  (-> this draw shadow-ctrl)
  (cond
    ((and (-> this draw shadow) (zero? (-> this draw cur-lod)) (logtest? (-> this draw status) (draw-status was-drawn)))
     (let ((shadow-ctrl (-> this draw shadow-ctrl)))
       (logclear! (-> shadow-ctrl settings flags) (shadow-flags disable-draw)))
     0
     (update-direction-from-time-of-day (-> this draw shadow-ctrl)))
    (else
     (let ((shadow-ctrl (-> this draw shadow-ctrl)))
       (logior! (-> shadow-ctrl settings flags) (shadow-flags disable-draw)))
     0))
  (none))

(defmethod play-anim! ((this minertall) (commit? symbol))
  "Select the tall miner's animation for the current task stage. If commit? is true, report the
   invalid request because this character does not drive task progression."
  (set! (-> this talk-message) (text-id press-to-talk))
  (current-status (-> this tasks))
  (if commit?
    (format 0
            "ERROR: <GMJ>: ~S playing anim for task status ~S~%"
            (-> this name)
            (task-status->string (current-status (-> this tasks)))))
  (the-as basic (-> this draw art-group data 3)))

(defmethod get-art-elem ((this minertall))
  "Return the art element on the active root animation channel."
  (-> this draw art-group data 3))

(defstate idle (minertall)
  :virtual #t
  :trans
    (behavior ()
      (set! (-> self will-talk) #f)
      ((-> (method-of-type process-taskable idle) trans)))
  :code miners-anim-loop)

(defmethod init-from-entity! ((this minertall) (source-entity entity-actor))
  "Initialize the tall miner as a task-controlled character for the village trade sequence."
  (init-as-taskable! this source-entity *minertall-sg* 32 47 (new 'static 'vector :w 4096.0) 5)
  (set! (-> this tasks) (get-task-control (game-task village3-miner-money1)))
  (set! (-> this draw light-index) (the-as uint 1))
  (goto-initial-state! this)
  (none))

(deftype minershort (process-taskable)
  ((other-miner minertall)))

(defskelgroup *minershort-sg*
  minershort
  minershort-lod0-jg
  minershort-idle-ja
  ((minershort-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 2.5)
  :shadow minershort-shadow-mg)


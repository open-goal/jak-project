;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/gfx/ocean/ocean-mid.gc")
(require "engine/collide/collide-frag-h.gc")

;; The ocean is drawn at four resolutions over the same authored data.
;;
;;   far         one quad per 96 m, no wave displacement
;;   mid         a 48x48 grid of 96 m cells, grouped into 6x6 tiles of 8x8 cells for culling
;;   transition  the 96 m cells nearest the camera, redrawn as 4x4 quads of 24 m
;;   near        the 24 m cells nearest the camera, redrawn as 8x8 quads of 3 m and displaced
;;               by the animated wave field
;;
;; This file owns the transition layer and the stitching that joins the grids without cracks.
;; Two grids of cell coordinates appear throughout.  Mid coordinates run 0..47 over the 96 m
;; grid; near coordinates run 0..191 over the 24 m grid, so a mid cell contains the four by
;; four block of near cells starting at (4*mid-z, 4*mid-x).  z is always the first index and x
;; the second, matching the order the masks are stored in.
;;
;; Only the cells around the camera need the finer passes, so the per-frame state covers a 4x4
;; window of mid cells anchored at (mid-minz, mid-minx), which draw-ocean-mid computes from the
;; cells its own proximity test rejected.  Within that window:
;;
;;   trans-camera-masks[16]   one ocean-trans-mask per window cell.  mask[sub-z] bit sub-x is
;;                            set when near cell (4*mid-z + sub-z, 4*mid-x + sub-x) is close
;;                            enough that the near pass will draw it.
;;   trans-temp-masks[16]     the same bits plus the near cells a seam patch has claimed;
;;                            merged into the uploaded strip masks at the end of the pass.
;;   trans-mask-ptrs[64]      window-cell * 4 + strip, pointing at that strip's uploaded VU
;;                            header so its suppression mask can still be changed after the DMA
;;                            data has been built.
;;   near-mask-indices[16]    the ocean-near-indices record draw-ocean-near should use for each
;;                            window cell, or -1.
;;
;; ocean-trans-mask is four mask bytes with a uint64 overlaid on them, so it occupies eight
;; bytes and only the first four are used.  Code that walks the masks as one flat byte array
;; through element zero therefore steps by eight per cell.
;;
;; Every pass builds its vertices the same way, and that is what makes the seams watertight.
;; The EE uploads the four corners of one cell as positions (ocean-trans-add-constants below,
;; or ocean-seams-add-constants for the mid grid), the four corner colors taken from the 49x49
;; corner grid in ocean-colors, and the four corner texture coordinates.  A vertex is then just
;; a list of four bilinear weights, and the VU program evaluates position, color and texture
;; coordinate as the same weighted sum of those four corners.  Two patches that agree on a
;; boundary vertex's weights therefore agree on every attribute of that vertex exactly, and the
;; stitch tables in ocean-trans-tables.gc are authored so that a coarse patch bordering a finer
;; region carries exactly the finer region's boundary vertices: quarter steps where the mid grid
;; meets 24 m geometry, eighth steps where 24 m geometry meets the 3 m near grid.  The coarse
;; patch is retriangulated to fan or strip through those inserted vertices, so none of them is
;; left as a T-junction, and no skirts or degenerate triangles are needed.
;;
;; The masks are the other half of the guarantee: a quad suppressed in one pass is drawn by
;; exactly one other, so the surface is covered once and only once.

;; Cell sizes.  4096 units is one metre.
(defconstant OCEAN-MID-CELL-SIZE 393216.0) ;; 96 m, one cell of the 48x48 mid grid

(defconstant OCEAN-MID-CELL-HALF 196608.0)

(defconstant OCEAN-NEAR-CELL-SIZE 98304.0) ;; 24 m, one cell of the 192x192 near grid

(defconstant OCEAN-NEAR-CELL-HALF 49152.0)

;; Bounding radii used to cull one cell: half its horizontal diagonal, since the cells are flat
;; and the sphere is centred on them.
(defconstant OCEAN-MID-CELL-BOUND 278045.7)

(defconstant OCEAN-NEAR-CELL-BOUND 69511.42)

;; A near cell goes to the near pass once any of its corners is within one full cell diagonal of
;; the camera.  The test is on squared distances.
(defconstant OCEAN-NEAR-CELL-DIAG-SQ 19327350000.0)

(defconstant OCEAN-MID-GRID-DIM 48)

(defconstant OCEAN-NEAR-GRID-DIM 192)

;; ocean-colors holds the 49x49 grid of mid-cell corner colors padded to a stride of 52 so that
;; a row is a whole number of quadwords.
(defconstant OCEAN-COLOR-ROW-STRIDE 52)

;; One ocean-trans-strip is ten vertices, and a mid cell's four strips sit back to back in
;; *ocean-trans-strip-array*.
(defconstant OCEAN-TRANS-STRIP-SIZE 160)

;; A strip mask byte of 255 marks a strip with no water in it at all; it is not emitted.
(defconstant OCEAN-TRANS-STRIP-EMPTY 255)

;; Vertex counts of the stitch tables in ocean-trans-tables.gc.  An edge table subdivides one
;; edge into eight and keeps the other three whole, giving an eleven vertex fan; a corner table
;; subdivides two edges and covers the cell with an eighteen vertex list.
(defconstant OCEAN-TRANS-EDGE-VERTS 11)

(defconstant OCEAN-TRANS-CORNER-VERTS 18)

;; ocean-mid VU1 entry points.  Both read the count and mask header at VU address 8 and the
;; per-vertex weight list at address 17; they differ in how the vertices are connected, which is
;; why each stitch table records the ordering it was authored in.
(defconstant OCEAN-MID-VU-FAN-LIST 275)

(defconstant OCEAN-MID-VU-STRIP-LIST 107)

;; Entry used together with a VIF flusha to close a pass, so the EE can overwrite the shared
;; corner-position constants before the next one starts.
(defconstant OCEAN-MID-VU-PASS-END 41)

;; DECOMP BEGINS

(defun ocean-trans-camera-masks-bit? ((near-z uint) (near-x uint))
  "True when near cell (near-z, near-x) is claimed by the near pass, meaning neither the mid
   grid nor the transition strips may cover it.  Coordinates are cells of the 192x192 near
   grid.  Cells outside the 4x4 mid-cell window anchored at (mid-minz, mid-minx) have no mask
   and read as #f."
  (let ((window-z (- near-z (* (-> *ocean-work* mid-minz) 4)))
        (window-x (- near-x (* (-> *ocean-work* mid-minx) 4))))
    (cond
      ((or (< window-z 0) (>= window-z (the-as uint 16)) (< window-x 0) (>= window-x (the-as uint 16))) #f)
      (else
       (let* ((cell-z (shr window-z 2))
              (cell-x (shr window-x 2))
              (sub-z (logand window-z 3))
              (sub-x (logand window-x 3))
              (cell-index (+ (* cell-z 4) cell-x)))
         (logtest? (-> *ocean-work* trans-camera-masks 0 mask (+ sub-z (* cell-index 8))) (ash 1 sub-x)))))))

(defun ocean-trans-mask-ptrs-bit? ((near-z int) (near-x int))
  "True when the transition strip covering near cell (near-z, near-x) already suppresses it.
   Until draw-ocean-transition-seams merges the camera masks that is exactly the authored land
   mask, so callers use this to ask whether a neighbouring near cell has water in it.  #f when
   the containing mid cell has no strip at all, and #f outside the window."
  (let ((window-z (- near-z (the-as int (* (-> *ocean-work* mid-minz) 4))))
        (window-x (- near-x (the-as int (* (-> *ocean-work* mid-minx) 4)))))
    (cond
      ((or (< (the-as uint window-z) 0)
           (>= (the-as uint window-z) (the-as uint 16))
           (< (the-as uint window-x) 0)
           (>= (the-as uint window-x) (the-as uint 16)))
       #f)
      (else
       (let* ((cell-z (shr window-z 2))
              (cell-x (shr window-x 2))
              (sub-z (logand window-z 3))
              (sub-x (logand window-x 3))
              (strip-header (-> *ocean-work* trans-mask-ptrs (+ (* (+ (* cell-z 4) cell-x) 4) sub-z))))
         ;; word 1 of the header is the strip's suppression mask
         (if strip-header (logtest? (-> strip-header 1) (ash 1 sub-x)) #f))))))

(defun ocean-trans-mask-ptrs-set! ((near-z int) (near-x int))
  "Claim near cell (near-z, near-x) for a seam patch.  Returns #f when the cell has no strip or
   its strip already suppresses it, in which case the caller must not emit geometry.  Otherwise
   records the cell in trans-temp-masks, so draw-ocean-transition-seams takes it away from the
   strip once no further patch can be emitted, and returns #t."
  (let ((window-z (- near-z (the-as int (* (-> *ocean-work* mid-minz) 4))))
        (window-x (- near-x (the-as int (* (-> *ocean-work* mid-minx) 4)))))
    (cond
      ((or (< (the-as uint window-z) 0)
           (>= (the-as uint window-z) (the-as uint 16))
           (< (the-as uint window-x) 0)
           (>= (the-as uint window-x) (the-as uint 16)))
       #f)
      (else
       (let* ((cell-z (shr window-z 2))
              (cell-x (shr window-x 2))
              (sub-z (logand window-z 3))
              (sub-x (logand window-x 3))
              (strip-header (-> *ocean-work* trans-mask-ptrs (+ (* (+ (* cell-z 4) cell-x) 4) sub-z))))
         (cond
           (strip-header
            (cond
              ((logtest? (-> strip-header 1) (ash 1 sub-x)) #f)
              (else
               (let ((temp-mask (-> *ocean-work* trans-temp-masks (+ (* cell-z 4) cell-x))))
                 (logior! (-> temp-mask mask sub-z) (ash 1 sub-x)))
               #t)))
           (else #f)))))))

(defun ocean-trans-add-upload-table ((buf dma-buffer) (near-z int) (near-x int) (weights (pointer float)) (vert-count int) (fan-list? symbol))
  "Emit one seam patch covering near cell (near-z, near-x), a 24 m cell of the 192x192 grid.

   weights is one of the *ocean-trans-*-table* arrays and holds vert-count vertices, each four
   bilinear weights over the cell's corners.  vert-count is OCEAN-TRANS-EDGE-VERTS for the four
   single-edge tables and OCEAN-TRANS-CORNER-VERTS for the four corner tables.  fan-list? picks
   the VU1 entry matching the order that table was authored in.

   Does nothing unless ocean-trans-mask-ptrs-set! can claim the cell, so a cell is never drawn
   twice and is never taken away from a strip that still covers it.

   The DMA appends the cell's transform (ocean-mid-add-matrices), nine quadwords to VU address 8
   holding the vertex count followed by the cell's four corner texture coordinates and four
   corner colors, then the weight list to address 17, then the draw call.  Texture coordinates
   and colors are bilinear blends of the enclosing mid cell's four corner values evaluated with
   the same weights the neighbouring passes use, so shared vertices agree exactly."
  (local-vars
    (weight-readback (inline-array vector))
    (color-readback float)
    (color-3-half uint128)
    (color-3-word uint128)
    (color-0-half uint128)
    (color-0-word uint128)
    (color-2-word uint128)
    (color-1-half uint128)
    (color-1-word uint128)
    (color-2-half uint128))
  (rlet ((acc :class vf)
         (corner-0 :class vf)
         (out-1 :class vf)
         (out-2 :class vf)
         (out-3 :class vf)
         (corner-1 :class vf)
         (corner-2 :class vf)
         (corner-3 :class vf)
         (weight-0 :class vf)
         (weight-1 :class vf)
         (weight-2 :class vf)
         (weight-3 :class vf)
         (out-0 :class vf))
    (when (ocean-trans-mask-ptrs-set! near-z near-x)
      (let ((world-corner (new-stack-vector0)))
        (let ((map-origin (-> *ocean-map* start-corner)))
          (set! (-> world-corner x) (+ (-> map-origin x) (* OCEAN-NEAR-CELL-SIZE (the float near-x))))
          (set! (-> world-corner y) (-> map-origin y))
          (set! (-> world-corner z) (+ (-> map-origin z) (* OCEAN-NEAR-CELL-SIZE (the float near-z)))))
        (set! (-> world-corner w) 1.0)
        (ocean-mid-add-matrices buf world-corner))
      (let* ((qwc 9)
             (dst buf)
             (packet (the-as object (-> dst base))))
        (set! (-> (the-as dma-packet packet) dma) (new 'static 'dma-tag :id (dma-tag-id cnt) :qwc qwc))
        (set! (-> (the-as dma-packet packet) vif0) (new 'static 'vif-tag :imm #x404 :cmd (vif-cmd stcycl)))
        (set! (-> (the-as dma-packet packet) vif1) (new 'static 'vif-tag :imm #x8008 :cmd (vif-cmd unpack-v4-32) :num qwc))
        (set! (-> dst base) (&+ (the-as pointer packet) 16)))
      (set-vector! (the-as vector4w (-> buf base)) vert-count 0 0 0)
      (&+! (-> buf base) 16)
      ;; The four corners of this near cell as bilinear weights over the enclosing mid cell.
      ;; *ocean-trans-corner-table* is the 5x5 grid of quarter-step weights, so the neighbours
      ;; one step along x and one step along z are one and five entries away.
      (let* ((sub-z (logand near-z 3))
             (sub-x (logand near-x 3))
             (corner-index (+ (* 5 sub-z) sub-x)))
        (.lvf weight-0 (&-> (&-> *ocean-trans-corner-table* 0 quad corner-index) 0))
        (.lvf weight-1 (&-> (&-> *ocean-trans-corner-table* 0 quad (+ corner-index 1)) 0))
        (.lvf weight-2 (&-> (&-> *ocean-trans-corner-table* 0 quad (+ corner-index 5)) 0))
        (.lvf weight-3 (&-> (&-> *ocean-trans-corner-table* 0 quad (+ corner-index 6)) 0)))
      (.mov weight-readback weight-3)
      (let ((vu-data (the-as (inline-array vector) (-> buf base))))
        (let ((mid-z (/ near-z 4))
              (mid-x (/ near-x 4)))
          ;; texture coordinates first: the mid cell's unit square sampled at the four corners
          (.lvf corner-0 (&-> *ocean-trans-st-table* 0 quad))
          (.lvf corner-1 (&-> *ocean-trans-st-table* 1 quad))
          (.lvf corner-2 (&-> *ocean-trans-st-table* 2 quad))
          (.lvf corner-3 (&-> *ocean-trans-st-table* 3 quad))
          (.mul.x.vf acc corner-0 weight-0)
          (nop!)
          (.add.mul.y.vf acc corner-1 weight-0 acc)
          (nop!)
          (.add.mul.z.vf acc corner-2 weight-0 acc)
          (nop!)
          (.add.mul.w.vf out-0 corner-3 weight-0 acc)
          (nop!)
          (.mul.x.vf acc corner-0 weight-1)
          (nop!)
          (.add.mul.y.vf acc corner-1 weight-1 acc)
          (nop!)
          (.add.mul.z.vf acc corner-2 weight-1 acc)
          (nop!)
          (.add.mul.w.vf out-1 corner-3 weight-1 acc)
          (.svf (&-> vu-data 0 quad) out-0)
          (.mul.x.vf acc corner-0 weight-2)
          (nop!)
          (.add.mul.y.vf acc corner-1 weight-2 acc)
          (nop!)
          (.add.mul.z.vf acc corner-2 weight-2 acc)
          (nop!)
          (.add.mul.w.vf out-2 corner-3 weight-2 acc)
          (.svf (&-> vu-data 1 quad) out-1)
          (.mul.x.vf acc corner-0 weight-3)
          (nop!)
          (.add.mul.y.vf acc corner-1 weight-3 acc)
          (nop!)
          (.add.mul.z.vf acc corner-2 weight-3 acc)
          (nop!)
          (.add.mul.w.vf out-3 corner-3 weight-3 acc)
          (.svf (&-> vu-data 2 quad) out-2)
          (nop!)
          (.svf (&-> vu-data 3 quad) out-3)
          ;; then the same four blends of the mid cell's corner colors.  Each rgba is widened
          ;; from four bytes to four words by two interleaves against zero before itof.
          (let ((corner-color-0 (the-as uint128 (-> *ocean-map* ocean-colors colors (+ (* OCEAN-COLOR-ROW-STRIDE mid-z) mid-x))))
                (corner-color-1 (the-as uint128 (-> *ocean-map* ocean-colors colors (+ mid-x 1 (* OCEAN-COLOR-ROW-STRIDE mid-z)))))
                (corner-color-2 (the-as uint128 (-> *ocean-map* ocean-colors colors (+ (* OCEAN-COLOR-ROW-STRIDE (+ mid-z 1)) mid-x))))
                (corner-color-3 (the-as uint128 (-> *ocean-map* ocean-colors colors (+ mid-x 1 (* OCEAN-COLOR-ROW-STRIDE (+ mid-z 1)))))))
            (.pextlb color-0-half 0 corner-color-0)
            (nop!)
            (.pextlb color-1-half 0 corner-color-1)
            (nop!)
            (.pextlb color-2-half 0 corner-color-2)
            (nop!)
            (.pextlb color-3-half 0 corner-color-3)))
        (nop!)
        (.pextlh color-0-word 0 color-0-half)
        (nop!)
        (.pextlh color-1-word 0 color-1-half)
        (.mov corner-0 color-0-word)
        (.pextlh color-2-word 0 color-2-half)
        (.mov corner-1 color-1-word)
        (.pextlh color-3-word 0 color-3-half)
        (.mov corner-2 color-2-word)
        (nop!)
        (.mov corner-3 color-3-word)
        (.itof.vf corner-0 corner-0)
        (nop!)
        (.itof.vf corner-1 corner-1)
        (nop!)
        (.itof.vf corner-2 corner-2)
        (nop!)
        (.itof.vf corner-3 corner-3)
        (nop!)
        (.mul.x.vf acc corner-0 weight-0)
        (nop!)
        (.add.mul.y.vf acc corner-1 weight-0 acc)
        (nop!)
        (.add.mul.z.vf acc corner-2 weight-0 acc)
        (nop!)
        (.add.mul.w.vf out-0 corner-3 weight-0 acc)
        (nop!)
        (.mul.x.vf acc corner-0 weight-1)
        (nop!)
        (.add.mul.y.vf acc corner-1 weight-1 acc)
        (nop!)
        (.add.mul.z.vf acc corner-2 weight-1 acc)
        (nop!)
        (.add.mul.w.vf out-1 corner-3 weight-1 acc)
        (.svf (&-> vu-data 4 quad) out-0)
        (.mul.x.vf acc corner-0 weight-2)
        (nop!)
        (.add.mul.y.vf acc corner-1 weight-2 acc)
        (nop!)
        (.add.mul.z.vf acc corner-2 weight-2 acc)
        (nop!)
        (.add.mul.w.vf out-2 corner-3 weight-2 acc)
        (.svf (&-> vu-data 5 quad) out-1)
        (.mul.x.vf acc corner-0 weight-3)
        (nop!)
        (.add.mul.y.vf acc corner-1 weight-3 acc)
        (nop!)
        (.add.mul.z.vf acc corner-2 weight-3 acc)
        (nop!)
        (.add.mul.w.vf out-3 corner-3 weight-3 acc)
        (.svf (&-> vu-data 6 quad) out-2)
        (nop!)
        (.svf (&-> vu-data 7 quad) out-3))
      (.mov color-readback out-3)
      (&+! (-> buf base) 128)
      (let* ((dst buf)
             (packet (the-as object (-> dst base))))
        (set! (-> (the-as dma-packet packet) dma)
              (new 'static 'dma-tag :id (dma-tag-id ref) :addr (the-as int weights) :qwc vert-count))
        (set! (-> (the-as dma-packet packet) vif0) (new 'static 'vif-tag :imm #x404 :cmd (vif-cmd stcycl)))
        (set! (-> (the-as dma-packet packet) vif1) (new 'static 'vif-tag :imm #x8011 :cmd (vif-cmd unpack-v4-32) :num vert-count))
        (set! (-> dst base) (&+ (the-as pointer packet) 16)))
      (if fan-list? (ocean-mid-add-call buf OCEAN-MID-VU-FAN-LIST) (ocean-mid-add-call buf OCEAN-MID-VU-STRIP-LIST)))
    (none)))

(defun ocean-trans-add-upload-strip ((buf dma-buffer) (mid-z uint) (mid-x uint) (strip-mask uint) (window-index uint) (strip-index uint))
  "Emit one row of transition geometry for mid cell (mid-z, mid-x): four 24 m quads out of the
   cell's 4x4 block.  strip-index selects both the row and its ten vertex weights in
   *ocean-trans-strip-array*.  strip-mask is the authored suppression mask for that row, bit q
   clearing quad q.  window-index is the cell's slot in the 4x4 window and is used only to
   record the uploaded header in trans-mask-ptrs, so the mask can still be changed afterwards.

   The header quadword is (10, strip-mask, 0, 0), followed by the mid cell's four corner texture
   coordinates and colors; the ten weight vectors go to VU address 17.  The caller decides
   whether the strip is worth emitting at all: a strip-mask of OCEAN-TRANS-STRIP-EMPTY has no
   water in it."
  (local-vars
    (color-readback float)
    (color-0-half uint128)
    (color-0-word uint128)
    (color-2-word uint128)
    (color-1-half uint128)
    (color-1-word uint128)
    (color-3-word uint128)
    (color-2-half uint128)
    (color-3-half uint128))
  (rlet ((corner-0 :class vf)
         (corner-1 :class vf)
         (corner-2 :class vf)
         (corner-3 :class vf))
    (let ((world-corner (new-stack-vector0)))
      (let ((map-origin (-> *ocean-map* start-corner)))
        (set! (-> world-corner x) (+ (-> map-origin x) (* OCEAN-MID-CELL-SIZE (the float mid-x))))
        (set! (-> world-corner y) (-> map-origin y))
        (set! (-> world-corner z) (+ (-> map-origin z) (* OCEAN-MID-CELL-SIZE (the float mid-z)))))
      (set! (-> world-corner w) 1.0)
      (ocean-mid-add-matrices buf world-corner))
    (let* ((qwc 9)
           (dst buf)
           (packet (the-as object (-> dst base))))
      (set! (-> (the-as dma-packet packet) dma) (new 'static 'dma-tag :id (dma-tag-id cnt) :qwc qwc))
      (set! (-> (the-as dma-packet packet) vif0) (new 'static 'vif-tag :imm #x404 :cmd (vif-cmd stcycl)))
      (set! (-> (the-as dma-packet packet) vif1) (new 'static 'vif-tag :imm #x8008 :cmd (vif-cmd unpack-v4-32) :num qwc))
      (set! (-> dst base) (&+ (the-as pointer packet) 16)))
    (let ((header (the-as object (-> buf base))))
      (set! (-> *ocean-work* trans-mask-ptrs (+ (* window-index 4) strip-index)) (the-as (pointer int32) header))
      (set! (-> (the-as vector4w header) x) 10)
      (set! (-> (the-as vector4w header) y) (the-as int strip-mask))
      (set! (-> (the-as vector4w header) z) 0)
      (set! (-> (the-as vector4w header) w) 0))
    (&+! (-> buf base) 16)
    (let ((vu-data (the-as (inline-array vector) (-> buf base))))
      ;; A strip spans the whole mid cell, so it takes the unit square and the cell's four
      ;; corner colors unblended; the weight list interpolates them.
      (set! (-> vu-data 0 quad) (-> *ocean-trans-st-table* 0 quad))
      (set! (-> vu-data 1 quad) (-> *ocean-trans-st-table* 1 quad))
      (set! (-> vu-data 2 quad) (-> *ocean-trans-st-table* 2 quad))
      (set! (-> vu-data 3 quad) (-> *ocean-trans-st-table* 3 quad))
      (let ((corner-color-0 (the-as uint128 (-> *ocean-map* ocean-colors colors (+ (* OCEAN-COLOR-ROW-STRIDE (the-as int mid-z)) mid-x))))
            (corner-color-1 (the-as uint128 (-> *ocean-map* ocean-colors colors (+ mid-x 1 (* OCEAN-COLOR-ROW-STRIDE (the-as int mid-z))))))
            (corner-color-2 (the-as uint128 (-> *ocean-map* ocean-colors colors (+ (* OCEAN-COLOR-ROW-STRIDE (the-as int (+ mid-z 1))) mid-x))))
            (corner-color-3 (the-as uint128 (-> *ocean-map* ocean-colors colors (+ mid-x 1 (* OCEAN-COLOR-ROW-STRIDE (the-as int (+ mid-z 1))))))))
        (.pextlb color-0-half 0 corner-color-0)
        (nop!)
        (.pextlb color-1-half 0 corner-color-1)
        (nop!)
        (.pextlb color-2-half 0 corner-color-2)
        (nop!)
        (.pextlb color-3-half 0 corner-color-3))
      (nop!)
      (.pextlh color-0-word 0 color-0-half)
      (nop!)
      (.pextlh color-1-word 0 color-1-half)
      (.mov corner-0 color-0-word)
      (.pextlh color-2-word 0 color-2-half)
      (.mov corner-1 color-1-word)
      (.pextlh color-3-word 0 color-3-half)
      (.mov corner-2 color-2-word)
      (nop!)
      (.mov corner-3 color-3-word)
      (.itof.vf corner-0 corner-0)
      (nop!)
      (.itof.vf corner-1 corner-1)
      (nop!)
      (.itof.vf corner-2 corner-2)
      (nop!)
      (.itof.vf corner-3 corner-3)
      (nop!)
      (nop!)
      (.svf (&-> vu-data 4 quad) corner-0)
      (nop!)
      (.svf (&-> vu-data 5 quad) corner-1)
      (nop!)
      (.svf (&-> vu-data 6 quad) corner-2)
      (nop!)
      (.svf (&-> vu-data 7 quad) corner-3))
    (.mov color-readback corner-3)
    (&+! (-> buf base) 128)
    (let* ((qwc 10)
           (dst buf)
           (packet (the-as object (-> dst base))))
      (set! (-> (the-as dma-packet packet) dma)
            (new 'static
                 'dma-tag
                 :id (dma-tag-id ref)
                 :addr
                 (the-as int (+ (+ (* OCEAN-TRANS-STRIP-SIZE (the-as int strip-index)) 0) (the-as int *ocean-trans-strip-array*)))
                 :qwc
                 qwc))
      (set! (-> (the-as dma-packet packet) vif0) (new 'static 'vif-tag :imm #x404 :cmd (vif-cmd stcycl)))
      (set! (-> (the-as dma-packet packet) vif1) (new 'static 'vif-tag :imm #x8011 :cmd (vif-cmd unpack-v4-32) :num qwc))
      (set! (-> dst base) (&+ (the-as pointer packet) 16)))
    (ocean-mid-add-call buf OCEAN-MID-VU-STRIP-LIST)
    (none)))

(defun ocean-transition-check ((cell-mask ocean-trans-mask) (sub-x int) (sub-z int) (cell-corner vector))
  "Test the near cell at (sub-z, sub-x) inside the mid cell whose world corner is cell-corner,
   both indices 0..3.  If any of the near cell's four corners is within one near-cell diagonal
   of the camera, set bit sub-x of cell-mask row sub-z to hand the cell to the near pass and
   return early.  Comparisons are on squared distances against OCEAN-NEAR-CELL-DIAG-SQ.

   The return value is meaningless and every caller ignores it."
  (local-vars (result symbol) (dist-sq float))
  (rlet ((delta :class vf)
         (probe-pos :class vf)
         (cam-pos :class vf))
    (let ((probe (new-stack-vector0))
          (cam-trans (-> *math-camera* trans)))
      1.0
      (set! (-> probe x) (+ (-> cell-corner x) (* OCEAN-NEAR-CELL-SIZE (the float sub-x))))
      (set! (-> probe y) (-> cell-corner y))
      (set! (-> probe z) (+ (-> cell-corner z) (* OCEAN-NEAR-CELL-SIZE (the float sub-z))))
      (let ((probe-src probe)
            (cam-src cam-trans))
        (.lvf probe-pos (&-> probe-src quad))
        (.lvf cam-pos (&-> cam-src quad)))
      (.sub.vf delta cam-pos probe-pos)
      (.mul.vf delta delta delta)
      (.add.y.vf.x delta delta delta)
      (.add.z.vf.x delta delta delta)
      (.mov dist-sq delta)
      (when (< dist-sq OCEAN-NEAR-CELL-DIAG-SQ)
        (logior! (-> cell-mask mask sub-z) (ash 1 sub-x))
        (return #f))
      (+! (-> probe x) OCEAN-NEAR-CELL-SIZE)
      (let ((probe-src probe)
            (cam-src cam-trans))
        (.lvf probe-pos (&-> probe-src quad))
        (.lvf cam-pos (&-> cam-src quad)))
      (.sub.vf delta cam-pos probe-pos)
      (.mul.vf delta delta delta)
      (.add.y.vf.x delta delta delta)
      (.add.z.vf.x delta delta delta)
      (.mov dist-sq delta)
      (when (< dist-sq OCEAN-NEAR-CELL-DIAG-SQ)
        (logior! (-> cell-mask mask sub-z) (ash 1 sub-x))
        (return #f))
      (+! (-> probe z) OCEAN-NEAR-CELL-SIZE)
      (let ((probe-src probe)
            (cam-src cam-trans))
        (.lvf probe-pos (&-> probe-src quad))
        (.lvf cam-pos (&-> cam-src quad)))
      (.sub.vf delta cam-pos probe-pos)
      (.mul.vf delta delta delta)
      (.add.y.vf.x delta delta delta)
      (.add.z.vf.x delta delta delta)
      (.mov dist-sq delta)
      (when (< dist-sq OCEAN-NEAR-CELL-DIAG-SQ)
        (logior! (-> cell-mask mask sub-z) (ash 1 sub-x))
        (return #f))
      (+! (-> probe x) -98304.0)
      (.lvf probe-pos (&-> probe quad))
      (.lvf cam-pos (&-> cam-trans quad)))
    (.sub.vf delta cam-pos probe-pos)
    (.mul.vf delta delta delta)
    (.add.y.vf.x delta delta delta)
    (.add.z.vf.x delta delta delta)
    (.mov dist-sq delta)
    (when (< dist-sq OCEAN-NEAR-CELL-DIAG-SQ)
      (logior! (-> cell-mask mask sub-z) (ash 1 sub-x))
      (return #f)
      result)))

(defun ocean-make-trans-camera-masks ((mid-z uint) (mid-x uint) (window-z uint) (window-x uint))
  "Build the camera mask for mid cell (mid-z, mid-x), whose slot in the 4x4 window is
   (window-z, window-x).  Each of the cell's sixteen near cells is tested against the camera and
   the close ones are handed to the near pass.  Always returns #f."
  (let ((cell-mask (-> *ocean-work* trans-camera-masks (+ (* window-z 4) window-x)))
        (cam-trans (-> *math-camera* trans))
        (cell-corner (new-stack-vector0))
        (cam-offset (new-stack-vector0)))
    (set! (-> cell-corner x) (+ (-> *ocean-map* start-corner x) (* OCEAN-MID-CELL-SIZE (the float mid-x))))
    (set! (-> cell-corner y) (-> *ocean-map* start-corner y))
    (set! (-> cell-corner z) (+ (-> *ocean-map* start-corner z) (* OCEAN-MID-CELL-SIZE (the float mid-z))))
    (set! (-> cell-corner w) 1.0)
    (dotimes (sub-z 4)
      (dotimes (sub-x 4)
        ;; cam-offset is filled in but never passed on; ocean-transition-check works in world
        ;; space from cell-corner.
        (set! (-> cam-offset x) (- (+ (-> cell-corner x) (* OCEAN-NEAR-CELL-SIZE (the float sub-x))) (-> cam-trans x)))
        (set! (-> cam-offset y) (- (-> cell-corner y) (-> cam-trans y)))
        (set! (-> cam-offset z) (- (+ (-> cell-corner z) (* OCEAN-NEAR-CELL-SIZE (the float sub-z))) (-> cam-trans z)))
        (ocean-transition-check cell-mask sub-x sub-z cell-corner))))
  #f)

(defun ocean-trans-add-upload ((buf dma-buffer) (near-z int) (near-x int))
  "Stitch near cell (near-z, near-x), which a transition strip covers, to whichever of its four
   neighbours the near pass has taken over.  Up and down are -z and +z, left and right are -x
   and +x, matching the names of the stitch tables.

   A neighbour the authored mask suppresses has no geometry to match, so that edge needs no
   stitching; when both edges of a corner case fall away the cell is left to its strip.  Only
   the four single-edge and four adjacent-edge cases are handled: a cell with near neighbours on
   opposite sides, or on three or more sides, is left alone."
  (when (not (ocean-trans-mask-ptrs-bit? near-z near-x))
    (let ((near-up? (ocean-trans-camera-masks-bit? (the-as uint (+ near-z -1)) (the-as uint near-x)))
          (near-down? (ocean-trans-camera-masks-bit? (the-as uint (+ near-z 1)) (the-as uint near-x)))
          (near-left? (ocean-trans-camera-masks-bit? (the-as uint near-z) (the-as uint (+ near-x -1))))
          (near-right? (ocean-trans-camera-masks-bit? (the-as uint near-z) (the-as uint (+ near-x 1))))
          (neighbors 0))
      (if near-up? (+! neighbors 1))
      (if near-down? (+! neighbors 2))
      (if near-left? (+! neighbors 4))
      (if near-right? (+! neighbors 8))
      (cond
        ((= neighbors 1)
         (if (not (ocean-trans-mask-ptrs-bit? (+ near-z -1) near-x))
           (ocean-trans-add-upload-table buf near-z near-x *ocean-trans-up-table* OCEAN-TRANS-EDGE-VERTS #t)))
        ((= neighbors 2)
         (if (not (ocean-trans-mask-ptrs-bit? (+ near-z 1) near-x))
           (ocean-trans-add-upload-table buf near-z near-x *ocean-trans-down-table* OCEAN-TRANS-EDGE-VERTS #t)))
        ((= neighbors 4)
         (if (not (ocean-trans-mask-ptrs-bit? near-z (+ near-x -1)))
           (ocean-trans-add-upload-table buf near-z near-x *ocean-trans-left-table* OCEAN-TRANS-EDGE-VERTS #t)))
        ((= neighbors 5)
         (let ((up-suppressed? (ocean-trans-mask-ptrs-bit? (+ near-z -1) near-x))
               (left-suppressed? (ocean-trans-mask-ptrs-bit? near-z (+ near-x -1))))
           (cond
             ((and up-suppressed? left-suppressed?))
             (up-suppressed? (ocean-trans-add-upload-table buf near-z near-x *ocean-trans-left-table* OCEAN-TRANS-EDGE-VERTS #t))
             (left-suppressed? (ocean-trans-add-upload-table buf near-z near-x *ocean-trans-up-table* OCEAN-TRANS-EDGE-VERTS #t))
             (else (ocean-trans-add-upload-table buf near-z near-x *ocean-trans-up-left-table* OCEAN-TRANS-CORNER-VERTS #f)))))
        ((= neighbors 6)
         (let ((down-suppressed? (ocean-trans-mask-ptrs-bit? (+ near-z 1) near-x))
               (left-suppressed? (ocean-trans-mask-ptrs-bit? near-z (+ near-x -1))))
           (cond
             ((and down-suppressed? left-suppressed?))
             (down-suppressed? (ocean-trans-add-upload-table buf near-z near-x *ocean-trans-left-table* OCEAN-TRANS-EDGE-VERTS #t))
             (left-suppressed? (ocean-trans-add-upload-table buf near-z near-x *ocean-trans-down-table* OCEAN-TRANS-EDGE-VERTS #t))
             (else (ocean-trans-add-upload-table buf near-z near-x *ocean-trans-down-left-table* OCEAN-TRANS-CORNER-VERTS #t)))))
        ((= neighbors 8)
         (if (not (ocean-trans-mask-ptrs-bit? near-z (+ near-x 1)))
           (ocean-trans-add-upload-table buf near-z near-x *ocean-trans-right-table* OCEAN-TRANS-EDGE-VERTS #t)))
        ((= neighbors 9)
         (let ((up-suppressed? (ocean-trans-mask-ptrs-bit? (+ near-z -1) near-x))
               (right-suppressed? (ocean-trans-mask-ptrs-bit? near-z (+ near-x 1))))
           (cond
             ((and up-suppressed? right-suppressed?))
             (up-suppressed? (ocean-trans-add-upload-table buf near-z near-x *ocean-trans-right-table* OCEAN-TRANS-EDGE-VERTS #t))
             (right-suppressed? (ocean-trans-add-upload-table buf near-z near-x *ocean-trans-up-table* OCEAN-TRANS-EDGE-VERTS #t))
             (else (ocean-trans-add-upload-table buf near-z near-x *ocean-trans-up-right-table* OCEAN-TRANS-CORNER-VERTS #t)))))
        ((= neighbors 10)
         (let ((down-suppressed? (ocean-trans-mask-ptrs-bit? (+ near-z 1) near-x))
               (right-suppressed? (ocean-trans-mask-ptrs-bit? near-z (+ near-x 1))))
           (cond
             ((and down-suppressed? right-suppressed?))
             (down-suppressed? (ocean-trans-add-upload-table buf near-z near-x *ocean-trans-right-table* OCEAN-TRANS-EDGE-VERTS #t))
             (right-suppressed? (ocean-trans-add-upload-table buf near-z near-x *ocean-trans-down-table* OCEAN-TRANS-EDGE-VERTS #t))
             (else (ocean-trans-add-upload-table buf near-z near-x *ocean-trans-down-right-table* OCEAN-TRANS-CORNER-VERTS #f))))))))
  (none))

(defun draw-ocean-transition-seams ((buf dma-buffer))
  "Emit the seam patches around the border of the near region, then hand the near cells they
   cover over from the transition strips.

   The border is the near-min/near-max box, which draw-ocean-transition already widened by one
   cell in each direction, so every cell in it either belongs to the near pass or touches one
   that does.  Claimed cells accumulate in trans-temp-masks and are merged into the strip
   headers here, at the end, once no further patch can be emitted.  Always returns #f."
  (let ((near-minx (-> *ocean-work* near-minx))
        (near-maxx (-> *ocean-work* near-maxx))
        (near-minz (-> *ocean-work* near-minz))
        (near-maxz (-> *ocean-work* near-maxz))
        (bsphere (new 'stack 'sphere)))
    (set! (-> bsphere y) (-> *ocean-map* start-corner y))
    (set! (-> bsphere w) OCEAN-NEAR-CELL-BOUND)
    (when (and (< near-minx near-maxx) (< near-minz near-maxz))
      (let ((near-z near-minz)
            (z-end near-maxz))
        (while (>= z-end near-z)
          (let ((near-x near-minx)
                (x-end near-maxx))
            (while (>= x-end near-x)
              (set! (-> bsphere x)
                    (+ OCEAN-NEAR-CELL-HALF (* OCEAN-NEAR-CELL-SIZE (the float near-x)) (-> *ocean-map* start-corner x)))
              (set! (-> bsphere z)
                    (+ OCEAN-NEAR-CELL-HALF (* OCEAN-NEAR-CELL-SIZE (the float near-z)) (-> *ocean-map* start-corner z)))
              ;; sphere-cull takes the side planes from vf16-vf19, which draw-ocean-mid loaded
              ;; before entering the transition pass.
              (when (sphere-cull bsphere)
                (if (not (ocean-trans-camera-masks-bit? near-z near-x))
                  (ocean-trans-add-upload buf (the-as int near-z) (the-as int near-x))))
              (+! near-x 1)))
          (+! near-z 1)))))
  (dotimes (cell-index 16)
    (when (nonzero? (-> *ocean-work* trans-camera-masks cell-index word))
      (dotimes (strip-index 4)
        (let ((strip-header (-> *ocean-work* trans-mask-ptrs (+ (* cell-index 4) strip-index))))
          (if strip-header (logior! (-> strip-header 1) (-> *ocean-work* trans-temp-masks 0 mask (+ strip-index (* cell-index 8)))))))))
  #f)

(defun ocean-trans-add-constants ((buf dma-buffer))
  "Replace the four corner positions the ocean-mid program keeps at VU address 765 with the
   corners of a 24 m near cell, so the seam patches that follow evaluate their weight lists at
   near-grid spacing.  ocean-mid-setup-constants installs the 96 m corners and
   ocean-seams-add-constants puts them back.  Returns the new buffer cursor."
  (let* ((qwc 4)
         (dst buf)
         (packet (the-as object (-> dst base))))
    (set! (-> (the-as dma-packet packet) dma) (new 'static 'dma-tag :id (dma-tag-id cnt) :qwc qwc))
    (set! (-> (the-as dma-packet packet) vif0) (new 'static 'vif-tag :imm #x404 :cmd (vif-cmd stcycl)))
    (set! (-> (the-as dma-packet packet) vif1) (new 'static 'vif-tag :imm #x2fd :cmd (vif-cmd unpack-v4-32) :num qwc))
    (set! (-> dst base) (&+ (the-as pointer packet) 16)))
  (let ((corners (the-as matrix (-> buf base))))
    (set-vector! (-> corners vector 0) 0.0 0.0 0.0 1.0)
    (set-vector! (-> corners vector 1) OCEAN-NEAR-CELL-SIZE 0.0 0.0 1.0)
    (set-vector! (-> corners vector 2) 0.0 0.0 OCEAN-NEAR-CELL-SIZE 1.0)
    (set-vector! (-> corners vector 3) OCEAN-NEAR-CELL-SIZE 0.0 OCEAN-NEAR-CELL-SIZE 1.0))
  (let ((next (&+ (-> buf base) 64))) (set! (-> buf base) next) next))

(defun draw-ocean-transition ((buf dma-buffer))
  "Draw the 96 m cells nearest the camera as 24 m geometry and stitch them to their neighbours.
   Called from draw-ocean-mid once it has decided which mid cells are too close for the mid grid
   and published that region as mid-minx/maxx/minz/maxz.

   Four steps.  First test the near cells of each such mid cell against the camera and record
   the ones the near pass will draw, which also fixes the region draw-ocean-near scans.  Second,
   for every mid cell with an authored transition record, emit its four strips of 24 m quads and
   remember where their suppression masks landed.  Third stitch the border of the near region.
   Finally patch the strip masks so that no quad is drawn by both the strips and the near pass.

   Leaves near-minx/maxx/minz/maxz and near-mask-indices ready for draw-ocean-near.  When
   nothing is close enough the near bounds come out inverted and the near pass draws nothing."
  (dotimes (i 16)
    (set! (-> *ocean-work* trans-camera-masks i word) (the-as uint 0))
    (set! (-> *ocean-work* near-mask-indices i) (the-as uint -1)))
  (dotimes (i 64)
    (set! (-> *ocean-work* trans-mask-ptrs i) (the-as (pointer int32) #f)))
  (let ((mid-minx (-> *ocean-work* mid-minx))
        (mid-maxx (-> *ocean-work* mid-maxx))
        (mid-minz (-> *ocean-work* mid-minz))
        (mid-maxz (-> *ocean-work* mid-maxz)))
    (let ((bsphere (new 'stack 'sphere)))
      (set! (-> bsphere y) (-> *ocean-map* start-corner y))
      (set! (-> bsphere w) OCEAN-MID-CELL-BOUND)
      (let ((mid-z mid-minz)
            (z-end mid-maxz))
        (while (>= z-end mid-z)
          (let ((mid-x mid-minx)
                (x-end mid-maxx))
            (while (>= x-end mid-x)
              ;; a cell the mid pass still draws, or one with no water, needs nothing here
              (when (not (ocean-mid-mask-ptrs-bit? mid-z mid-x))
                (when (ocean-mid-camera-masks-bit? mid-z mid-x)
                  (set! (-> bsphere x) (+ OCEAN-MID-CELL-HALF (* OCEAN-MID-CELL-SIZE (the float mid-x)) (-> *ocean-map* start-corner x)))
                  (set! (-> bsphere z) (+ OCEAN-MID-CELL-HALF (* OCEAN-MID-CELL-SIZE (the float mid-z)) (-> *ocean-map* start-corner z)))
                  (if (sphere-cull bsphere) (ocean-make-trans-camera-masks mid-z mid-x (- mid-z mid-minz) (- mid-x mid-minx)))))
              (+! mid-x 1)))
          (+! mid-z 1))))
    ;; The near region is the bounding box of the near cells just claimed, widened by one cell
    ;; so that draw-ocean-transition-seams also visits the cells which only touch it.
    (let ((minx OCEAN-NEAR-GRID-DIM)
          (maxx 0)
          (minz OCEAN-NEAR-GRID-DIM)
          (maxz 0))
      (let ((mid-z mid-minz)
            (z-end mid-maxz))
        (while (>= z-end mid-z)
          (let ((mid-x mid-minx)
                (x-end mid-maxx))
            (while (>= x-end mid-x)
              (let ((cell-mask (-> *ocean-work* trans-camera-masks (+ (* (- mid-z mid-minz) 4) (- mid-x mid-minx)))))
                (when (nonzero? (-> cell-mask word))
                  (dotimes (sub-z 4)
                    (let ((mask-row (-> cell-mask mask sub-z)))
                      (when (nonzero? mask-row)
                        (let ((near-z (+ (* mid-z 4) sub-z)))
                          (if (< near-z (the-as uint minz)) (set! minz (the-as int near-z)))
                          (if (< (the-as uint maxz) near-z) (set! maxz (the-as int near-z))))
                        (dotimes (sub-x 4)
                          (when (logtest? mask-row (ash 1 sub-x))
                            (let ((near-x (+ (* mid-x 4) sub-x)))
                              (if (< near-x (the-as uint minx)) (set! minx (the-as int near-x)))
                              (if (< (the-as uint maxx) near-x) (set! maxx (the-as int near-x)))))))))))
              (+! mid-x 1)))
          (+! mid-z 1)))
      (set! (-> *ocean-work* near-minx) (the-as uint (+ minx -1)))
      (set! (-> *ocean-work* near-maxx) (the-as uint (+ maxx 1)))
      (set! (-> *ocean-work* near-minz) (the-as uint (+ minz -1)))
      (set! (-> *ocean-work* near-maxz) (the-as uint (+ maxz 1))))
    (dotimes (i 16)
      (set! (-> *ocean-work* trans-temp-masks i word) (-> *ocean-work* trans-camera-masks i word)))
    (let ((mid-z mid-minz)
          (z-end mid-maxz))
      (while (>= z-end mid-z)
        (let ((mid-x mid-minx)
              (x-end mid-maxx))
          (while (>= x-end mid-x)
            (when (not (ocean-mid-mask-ptrs-bit? mid-z mid-x))
              (when (ocean-mid-camera-masks-bit? mid-z mid-x)
                (let ((trans-index (-> *ocean-map* ocean-trans-indices data (+ (* (the-as uint OCEAN-MID-GRID-DIM) mid-z) mid-x))))
                  ;; parent selects the cell's suppression record and child the near-grid record
                  ;; draw-ocean-near will need; a negative parent means no transition geometry is
                  ;; authored for this cell.
                  (when (>= (-> trans-index parent) 0)
                    (let ((window-index (+ (* (- mid-z mid-minz) 4) (- mid-x mid-minx))))
                      (set! (-> *ocean-work* near-mask-indices window-index) (the-as uint (-> trans-index child)))
                      (let ((parent-mask (-> *ocean-map* ocean-mid-masks data (-> trans-index parent))))
                        ;; the first four bytes of the record are the four strips' masks
                        (dotimes (strip-index 4)
                          (let ((strip-mask (-> (the-as ocean-mid-mask (+ strip-index (the-as int parent-mask))) mask 0)))
                            (if (!= strip-mask OCEAN-TRANS-STRIP-EMPTY)
                              (ocean-trans-add-upload-strip buf mid-z mid-x strip-mask window-index (the-as uint strip-index)))))))))))
            (+! mid-x 1)))
        (+! mid-z 1))))
  (ocean-mid-add-call-flush buf (the-as uint OCEAN-MID-VU-PASS-END))
  (ocean-trans-add-constants buf)
  (draw-ocean-transition-seams buf)
  (ocean-mid-add-call-flush buf (the-as uint OCEAN-MID-VU-PASS-END))
  0
  (none))

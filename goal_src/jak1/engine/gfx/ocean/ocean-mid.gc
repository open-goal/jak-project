;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/gfx/ocean/ocean.gc")
(require "kernel/gstate.gc")
(require "engine/debug/debug.gc")
(require "engine/gfx/ocean/ocean-trans-tables.gc")

;; The mid pass draws the opaque middle band of the sea: it begins where the fine near grid ends and
;; runs out to the four far quads.  Its geometry is a flat 48-by-48 grid of 96-meter cells anchored at
;; the ocean map's start-corner, so the grid covers 4608 meters on a side.  Nothing about the grid
;; moves with the camera.  What changes per frame is which cells are drawn, which are handed to the
;; denser passes, and which get a second environment-mapped pass.
;;
;; Addressing.  The grid is authored and culled in 6-by-6 blocks of 8-by-8 cells, 768 meters per
;; block.  A block is named by (block-z, block-x) and by the linear index 6 * block-z + block-x used
;; for every per-block array in ocean-work.  A cell is named by its grid coordinates (cell-z, cell-x)
;; in 0..47: cell-z / 8 and cell-x / 8 give the block, cell-z & 7 selects one of the eight bytes of
;; that block's mask, and cell-x & 7 selects the bit inside that byte.  Rows run along z and columns
;; along x, and every mask in this file uses that byte-is-row, bit-is-column layout.  A set bit means
;; "do not draw"; the microprogram skips the cell.
;;
;; Culling has three stages.  ocean-map carries one authored bounding sphere per block, so the first
;; stage is a frustum test of the 36 spheres.  The second stage is authored too: ocean-mid-indices
;; maps a block to the ocean-mid-mask whose set bits are the cells the artist wants suppressed, and a
;; negative index means the block has no mid geometry at all.  The third stage is dynamic.  For a
;; block whose bounding sphere comes within one cell diagonal of the camera, ocean-mid-check walks the
;; three-by-three cell neighborhood around the camera and marks every cell with a corner inside one
;; cell diagonal.  The transition and near passes will redraw those cells at much higher density, so
;; the mid pass has to drop them.  By that point the block's mask is already sitting in the DMA
;; buffer, so mid-mask-ptrs keeps the address of those eight bytes and draw-ocean-mid-seams ORs the
;; extra bits straight into the built packet rather than rebuilding it.
;;
;; The bounding rectangle of the marked cells becomes mid-minx, mid-maxx, mid-minz and mid-maxz.  The
;; transition pass and the seam pass below both walk that rectangle, and the seam pass stitches its
;; border so the 96-meter cells meet the finer geometry without cracks or T-junctions.  The stitching
;; vertices come from the weight tables in ocean-trans-tables: each quadword is a set of bilinear
;; weights over the cell's four corners, so one microprogram entry point covers every edge and corner
;; variant.
;;
;; Work split.  The EE only selects and assembles packets.  Once per frame it builds the
;; ocean-mid-constants block -- camera transform, fog range, GIF tags, the two ADGIF shaders, the
;; per-row index table and the four corner positions of a unit cell -- DMAs it to VU1 data address
;; OCEAN-MID-VU-CONSTANTS and runs entry 0 to latch it.  Per visible block it DMAs one
;; ocean-mid-upload and runs entry 46, or entry 73 for the extra environment pass.  VU1 transforms the
;; corner lattice, applies fog and the environment term, builds GIF packets and kicks them; the GS
;; rasterizes eight 18-vertex triangle strips per block, which is the 128 triangles and 144 vertices
;; the pass reports to *terrain-stats*.  Entry 73 draws the same block twice, hence the doubled
;; counts.
;;
;; VU1 data memory.  Addresses 0..117 and 118..235 are the two halves of a double-buffered input
;; bank: VIF BASE is 0, OFFSET is 118, and every per-block unpack sets the address flag so it lands
;; in the half VU1 is not reading.  The bank is exactly one ocean-mid-upload long.  733..768 holds the
;; resident constants block.  Everything between belongs to the microprogram, including the
;; ocean-mid-work scratch and its GIF output buffers.
;;
;; Packet formats.  ocean-mid-upload is the block packet.  It starts with the camera rotation, with
;; the block origin in camera space substituted into its translation row, followed by that matrix
;; times the perspective matrix.  Then 108 quadwords of vertex color and two mask quadwords.  The
;; colors are nine rows of twelve corner samples copied straight out of ocean-colors; VIF widens each
;; 8-bit RGBA sample into a full quadword and each of the eight mask bytes into a 32-bit lane.  Twelve
;; columns is more than the nine corners a block needs, and it is why ocean-colors is 52 samples wide
;; for a 49-corner grid: the last block starts at column 40 and reads twelve.
;;
;; ocean-mid-upload2 is the seam packet: the same two matrices, a vertex count, the unit-square
;; texture coordinates, the cell's four corner colors widened to floats, and up to eighteen quadwords
;; of corner weights.

;; Grid geometry.
(defconstant OCEAN-MID-CELL (meters 96))

(defconstant OCEAN-MID-HALF-CELL (meters 48))

(defconstant OCEAN-MID-BLOCK (meters 768))

;; 1 / OCEAN-MID-CELL
(defconstant OCEAN-MID-INV-CELL 0.0000025431316)

;; 96 meters * sqrt 2, the diagonal of one cell
(defconstant OCEAN-MID-CELL-DIAGONAL 556091.4)

(defconstant OCEAN-MID-CELL-DIAGONAL-SQ 309237600000.0)

;; circumradius of one cell, 67.88 meters
(defconstant OCEAN-MID-CELL-RADIUS 278045.7)

;; a block closer than this gets the environment pass as well
(defconstant OCEAN-MID-ENV-DISTANCE (meters 192))

(defconstant OCEAN-MID-BLOCK-DIM 6)

(defconstant OCEAN-MID-BLOCK-COUNT 36)

(defconstant OCEAN-MID-CELLS-PER-BLOCK 8)

(defconstant OCEAN-MID-GRID-DIM 48)

;; ocean-colors is a 52-wide grid of corner samples.  A block reads a nine-row patch starting at
;; column 8 * block-x and row 8 * block-z, twelve columns at a time.
(defconstant OCEAN-COLOR-ROW 52)

(defconstant OCEAN-COLOR-ROW-BYTES (* 4 OCEAN-COLOR-ROW))

(defconstant OCEAN-COLOR-BLOCK-ROW (* OCEAN-MID-CELLS-PER-BLOCK OCEAN-COLOR-ROW))

(defconstant OCEAN-MID-COLOR-ROWS 9)

(defconstant OCEAN-MID-COLOR-COLUMNS 12)

;; VU1 data layout.  The double-buffered input bank is exactly one ocean-mid-upload; the constants
;; block is resident above the microprogram's own buffers.
(defconstant OCEAN-MID-VU-BANK-QWC 118)

(defconstant OCEAN-MID-VU-CONSTANTS 733)

(defconstant OCEAN-MID-CONSTANTS-QWC 36)

;; rot and matrix, uploaded by ocean-mid-add-matrices
(defconstant OCEAN-MID-MATRICES-QWC 8)

;; count, four texture coordinates, four colors
(defconstant OCEAN-MID-SEAM-HEADER-QWC 9)

;; VU1 data address of one field of the resident constants block.
(defmacro ocean-mid-vu-const (field)
  `(+ OCEAN-MID-VU-CONSTANTS (/ (offset-of ocean-mid-constants ,field) 16)))

;; Bank-relative VU1 address of one field of a block upload.
(defmacro ocean-mid-upload-addr (field)
  `(/ (offset-of ocean-mid-upload ,field) 16))

;; Bank-relative VU1 address of one field of a seam upload.
(defmacro ocean-mid-upload2-addr (field)
  `(/ (offset-of ocean-mid-upload2 ,field) 16))

;; VU1 entry points, in instruction-pair addresses.  Nothing on the EE side tells the two drain
;; entries apart beyond where each one is called.
(defconstant OCEAN-MID-VU-INIT 0) ;; latch the resident constants

(defconstant OCEAN-MID-VU-END-PASS 41) ;; drain and close a pass

(defconstant OCEAN-MID-VU-BEGIN-SEAM-PASS 43) ;; drain before the transition and seam uploads

(defconstant OCEAN-MID-VU-BLOCK 46) ;; one 8x8 block, textured

(defconstant OCEAN-MID-VU-BLOCK-ENV 73) ;; one 8x8 block, textured plus environment

(defconstant OCEAN-MID-VU-STRIP 107) ;; weighted vertex list, triangle strip

(defconstant OCEAN-MID-VU-FAN 275) ;; weighted vertex list, triangle fan

;; DECOMP BEGINS

;; The microprogram for the mid, seam, and transition passes.
(define ocean-mid-block (new 'static 'vu-function)) ;; :length #x497 :qlength #x24c

(defun ocean-mid-setup-constants ((dst ocean-mid-constants))
  "Build the resident VU1 constants for the mid ocean in place at dst, which must be
   OCEAN-MID-CONSTANTS-QWC quadwords of DMA buffer.  Copies this frame's camera transform, fog range
   and sun environment color, then fills in the GIF tags and ADGIF shaders for the textured and
   environment passes, the per-row index table, and the four corner positions of a unit cell.
   *ocean-subdivide-draw-mode* selects the primitive: 0 is normal textured rendering, 1 draws a
   wireframe and 2 draws untextured Gouraud shading."
  ;; the usual camera math
  (let ((math-cam *math-camera*))
    (set! (-> dst hmge-scale quad) (-> math-cam hmge-scale quad))
    (set! (-> dst inv-hmge-scale quad) (-> math-cam inv-hmge-scale quad))
    (set! (-> dst hvdf-offset quad) (-> math-cam hvdf-off quad))
    (set-vector! (-> dst fog) (-> math-cam pfog0) (-> math-cam fog-min) (-> math-cam fog-max) 3072.0))
  ;; xy scale and offset for the environment-map texture coordinates, and the cell size the
  ;; microprogram steps the corner lattice by.
  (set-vector! (-> dst constants) 0.5 0.5 0.0 OCEAN-MID-CELL)
  (set-vector! (-> dst constants2) 0.5 0.5 1.0 0.0)
  (let ((draw-mode *ocean-subdivide-draw-mode*))
    (cond
      ((zero? draw-mode)
       (set! (-> dst drw-fan tag)
             (new 'static
                  'gif-tag64
                  :nloop #x4
                  :eop #x1
                  :pre #x1
                  :prim
                  (new 'static 'gs-prim :prim (gs-prim-type tri-fan) :iip #x1 :tme #x1 :fge #x1)
                  :nreg #x3)))
      ((= draw-mode 1)
       (set! (-> dst drw-fan tag)
             (new 'static
                  'gif-tag64
                  :nloop #x4
                  :eop #x1
                  :pre #x1
                  :prim
                  (new 'static 'gs-prim :prim (gs-prim-type line-strip) :iip #x1 :tme #x1 :fge #x1)
                  :nreg #x3)))
      ((= draw-mode 2)
       (set! (-> dst drw-fan tag)
             (new 'static
                  'gif-tag64
                  :nloop #x4
                  :eop #x1
                  :pre #x1
                  :prim
                  (new 'static 'gs-prim :prim (gs-prim-type tri-fan) :iip #x1 :fge #x1)
                  :nreg #x3)))))
  (set! (-> dst drw-fan regs)
        (new 'static 'gif-tag-regs :regs0 (gif-reg-id st) :regs1 (gif-reg-id rgbaq) :regs2 (gif-reg-id xyzf2)))
  (let ((draw-mode *ocean-subdivide-draw-mode*))
    (cond
      ((zero? draw-mode)
       (set! (-> dst env-fan tag)
             (new 'static
                  'gif-tag64
                  :nloop #x4
                  :eop #x1
                  :pre #x1
                  :prim
                  (new 'static 'gs-prim :prim (gs-prim-type tri-fan) :iip #x1 :tme #x1 :abe #x1)
                  :nreg #x3)))
      ((= draw-mode 1)
       (set! (-> dst env-fan tag)
             (new 'static
                  'gif-tag64
                  :nloop #x4
                  :eop #x1
                  :pre #x1
                  :prim
                  (new 'static 'gs-prim :prim (gs-prim-type line-strip) :iip #x1 :tme #x1 :abe #x1)
                  :nreg #x3)))
      ((= draw-mode 2)
       (set! (-> dst env-fan tag)
             (new 'static
                  'gif-tag64
                  :nloop #x4
                  :eop #x1
                  :pre #x1
                  :prim
                  (new 'static 'gs-prim :prim (gs-prim-type tri-fan) :iip #x1 :abe #x1)
                  :nreg #x3)))))
  (set! (-> dst env-fan regs)
        (new 'static 'gif-tag-regs :regs0 (gif-reg-id st) :regs1 (gif-reg-id rgbaq) :regs2 (gif-reg-id xyzf2)))
  (set! (-> dst drw-adgif tag) (new 'static 'gif-tag64 :nloop #x5 :nreg #x1))
  (set! (-> dst drw-adgif regs) (new 'static 'gif-tag-regs :regs0 (gif-reg-id a+d)))
  ;; The ocean texture has six mip levels, one more than the five A+D slots of an adgif-shader can
  ;; describe with a single MIPTBP1, so the shader's alpha slot carries MIPTBP2 instead of ALPHA and
  ;; prims 9 selects that register.  Levels 1-3 sit in the two pages after the base page; levels 4-6
  ;; are single blocks after them.
  (let* ((tex-page *ocean-base-page*)
         (tex-block *ocean-base-block*)
         (mip1-block (* (+ tex-page 8) 32))
         (mip2-block (* (+ tex-page 10) 32)))
    (set! (-> dst drw-texture tex0) (new 'static 'gs-tex0 :tbw #x2 :tcc #x1 :th (log2 128) :tw (log2 128) :tbp0 tex-block))
    (set! (-> dst drw-texture prims 1) (gs-reg64 tex0-1))
    (set! (-> dst drw-texture tex1) (new 'static 'gs-tex1 :mxl #x6 :mmag #x1 :mmin #x5 :l #x1 :k #xeed))
    (set! (-> dst drw-texture prims 3) (gs-reg64 tex1-1))
    (set! (-> dst drw-texture miptbp1)
          (new 'static 'gs-miptbp :tbw1 #x1 :tbw2 #x1 :tbw3 #x1 :tbp3 (+ mip2-block 16) :tbp2 mip2-block :tbp1 mip1-block))
    (set! (-> dst drw-texture prims 5) (gs-reg64 miptbp1-1))
    (set! (-> dst drw-texture clamp) (new 'static 'gs-clamp))
    (set! (-> dst drw-texture clamp-reg) (gs-reg64 clamp-1))
    (set! (-> dst drw-texture alpha-as-miptb2)
          (new 'static
               'gs-miptbp
               :tbw1 #x1
               :tbw2 #x1
               :tbw3 #x1
               :tbp1
               (+ mip2-block 20)
               :tbp2
               (+ mip2-block 21)
               :tbp3
               (+ mip2-block 22))))
  (set! (-> dst drw-texture prims 9) (gs-reg64 miptbp2-1))
  (let ((draw-mode *ocean-subdivide-draw-mode*))
    (cond
      ((zero? draw-mode)
       (set! (-> dst drw-strip-0 tag)
             (new 'static
                  'gif-tag64
                  :nloop #x12
                  :pre #x1
                  :prim
                  (new 'static 'gs-prim :prim (gs-prim-type tri-strip) :iip #x1 :tme #x1 :fge #x1)
                  :nreg #x3)))
      ((= draw-mode 1)
       (set! (-> dst drw-strip-0 tag)
             (new 'static
                  'gif-tag64
                  :nloop #x12
                  :pre #x1
                  :prim
                  (new 'static 'gs-prim :prim (gs-prim-type line-strip) :iip #x1 :tme #x1 :fge #x1)
                  :nreg #x3)))
      ((= draw-mode 2)
       (set! (-> dst drw-strip-0 tag)
             (new 'static
                  'gif-tag64
                  :nloop #x12
                  :pre #x1
                  :prim
                  (new 'static 'gs-prim :prim (gs-prim-type tri-strip) :iip #x1 :fge #x1)
                  :nreg #x3)))))
  (set! (-> dst drw-strip-0 regs)
        (new 'static 'gif-tag-regs :regs0 (gif-reg-id st) :regs1 (gif-reg-id rgbaq) :regs2 (gif-reg-id xyzf2)))
  ;; drw-strip-1 is the same tag with eop set; only the last strip of a block uses it.
  (let ((draw-mode *ocean-subdivide-draw-mode*))
    (cond
      ((zero? draw-mode)
       (set! (-> dst drw-strip-1 tag)
             (new 'static
                  'gif-tag64
                  :nloop #x12
                  :eop #x1
                  :pre #x1
                  :prim
                  (new 'static 'gs-prim :prim (gs-prim-type tri-strip) :iip #x1 :tme #x1 :fge #x1)
                  :nreg #x3)))
      ((= draw-mode 1)
       (set! (-> dst drw-strip-1 tag)
             (new 'static
                  'gif-tag64
                  :nloop #x12
                  :eop #x1
                  :pre #x1
                  :prim
                  (new 'static 'gs-prim :prim (gs-prim-type line-strip) :iip #x1 :tme #x1 :fge #x1)
                  :nreg #x3)))
      ((= draw-mode 2)
       (set! (-> dst drw-strip-1 tag)
             (new 'static
                  'gif-tag64
                  :nloop #x12
                  :eop #x1
                  :pre #x1
                  :prim
                  (new 'static 'gs-prim :prim (gs-prim-type tri-strip) :iip #x1 :fge #x1)
                  :nreg #x3)))))
  (set! (-> dst drw-strip-1 regs)
        (new 'static 'gif-tag-regs :regs0 (gif-reg-id st) :regs1 (gif-reg-id rgbaq) :regs2 (gif-reg-id xyzf2)))
  (set! (-> dst env-adgif tag) (new 'static 'gif-tag64 :nloop #x5 :nreg #x1))
  (set! (-> dst env-adgif regs) (new 'static 'gif-tag-regs :regs0 (gif-reg-id a+d)))
  (let ((env-shader (-> dst env-texture)))
    (adgif-shader<-texture-simple! env-shader (get-texture environment-ocean environment-generic))
    (set! (-> env-shader alpha) (new 'static 'gs-alpha :b #x2 :c #x1 :d #x1)))
  (let ((draw-mode *ocean-subdivide-draw-mode*))
    (cond
      ((zero? draw-mode)
       (set! (-> dst env-strip tag)
             (new 'static
                  'gif-tag64
                  :nloop #x12
                  :eop #x1
                  :pre #x1
                  :prim
                  (new 'static 'gs-prim :prim (gs-prim-type tri-strip) :iip #x1 :tme #x1 :abe #x1)
                  :nreg #x3)))
      ((= draw-mode 1)
       (set! (-> dst env-strip tag)
             (new 'static
                  'gif-tag64
                  :nloop #x12
                  :eop #x1
                  :pre #x1
                  :prim
                  (new 'static 'gs-prim :prim (gs-prim-type line-strip) :iip #x1 :tme #x1 :abe #x1)
                  :nreg #x3)))
      ((= draw-mode 2)
       (set! (-> dst env-strip tag)
             (new 'static
                  'gif-tag64
                  :nloop #x12
                  :eop #x1
                  :pre #x1
                  :prim
                  (new 'static 'gs-prim :prim (gs-prim-type tri-strip) :iip #x1)
                  :nreg #x3)))))
  (set! (-> dst env-strip regs)
        (new 'static 'gif-tag-regs :regs0 (gif-reg-id st) :regs1 (gif-reg-id rgbaq) :regs2 (gif-reg-id xyzf2)))
  (set! (-> dst env-color quad) (-> *time-of-day-context* current-sun env-color quad))
  ;; Per-row VU addresses for the eight strips of a block, ordered from the last row back to the
  ;; first.  The middle lane steps by the twelve-quadword color row.
  (set-vector! (-> dst index-table 0) 63 84 66 0)
  (set-vector! (-> dst index-table 1) 54 72 57 0)
  (set-vector! (-> dst index-table 2) 45 60 48 0)
  (set-vector! (-> dst index-table 3) 36 48 39 0)
  (set-vector! (-> dst index-table 4) 27 36 30 0)
  (set-vector! (-> dst index-table 5) 18 24 21 0)
  (set-vector! (-> dst index-table 6) 9 12 12 0)
  (set-vector! (-> dst index-table 7) 0 0 3 0)
  ;; The four corners of a unit cell, in the order the weight tables in ocean-trans-tables blend
  ;; them.  ocean-seams-add-constants restores these after the transition pass replaces them.
  (set-vector! (-> dst pos0) 0.0 0.0 0.0 1.0)
  (set-vector! (-> dst pos1) OCEAN-MID-CELL 0.0 0.0 1.0)
  (set-vector! (-> dst pos2) 0.0 0.0 OCEAN-MID-CELL 1.0)
  (set-vector! (-> dst pos3) OCEAN-MID-CELL 0.0 OCEAN-MID-CELL 1.0)
  (none))

(defun ocean-mid-add-constants ((dma-buf dma-buffer))
  "Append the DMA that loads the mid-ocean constants to VU1 data address OCEAN-MID-VU-CONSTANTS,
   generating the block in place in the buffer.  Advances base past the block."
  (let* ((qwc OCEAN-MID-CONSTANTS-QWC)
         (buf dma-buf)
         (packet (the-as object (-> buf base))))
    (set! (-> (the-as dma-packet packet) dma) (new 'static 'dma-tag :id (dma-tag-id cnt) :qwc qwc))
    (set! (-> (the-as dma-packet packet) vif0)
          (new 'static 'vif-tag :imm (new 'static 'vif-stcycl-imm :cl 4 :wl 4) :cmd (vif-cmd stcycl)))
    (set! (-> (the-as dma-packet packet) vif1)
          (new 'static 'vif-tag :imm (new 'static 'vif-unpack-imm :addr OCEAN-MID-VU-CONSTANTS) :cmd (vif-cmd unpack-v4-32) :num qwc))
    (set! (-> buf base) (&+ (the-as pointer packet) 16)))
  ;; generate the constants in place.
  (ocean-mid-setup-constants (the-as ocean-mid-constants (-> dma-buf base)))
  (&+! (-> dma-buf base) (* 16 OCEAN-MID-CONSTANTS-QWC))
  (none))

(defun ocean-matrix*! ((dst matrix) (left matrix) (right matrix))
  "Set dst to left * right and return dst.  All four result rows are computed before the first store,
   so dst may alias either input."
  (rlet ((acc :class vf)
         (left-row-0 :class vf)
         (out-row-1 :class vf)
         (out-row-2 :class vf)
         (out-row-3 :class vf)
         (left-row-1 :class vf)
         (left-row-2 :class vf)
         (left-row-3 :class vf)
         (right-row-0 :class vf)
         (right-row-1 :class vf)
         (right-row-2 :class vf)
         (right-row-3 :class vf)
         (out-row-0 :class vf))
    (.lvf left-row-0 (&-> left vector 0 quad))
    (.lvf right-row-0 (&-> right vector 0 quad))
    (.lvf right-row-1 (&-> right vector 1 quad))
    (.lvf right-row-2 (&-> right vector 2 quad))
    (.lvf right-row-3 (&-> right vector 3 quad))
    (.lvf left-row-1 (&-> left vector 1 quad))
    (.lvf left-row-2 (&-> left vector 2 quad))
    (.lvf left-row-3 (&-> left vector 3 quad))
    (.mul.x.vf acc right-row-0 left-row-0)
    (.add.mul.y.vf acc right-row-1 left-row-0 acc)
    (.add.mul.z.vf acc right-row-2 left-row-0 acc)
    (.add.mul.w.vf out-row-0 right-row-3 left-row-0 acc)
    (.mul.x.vf acc right-row-0 left-row-1)
    (.add.mul.y.vf acc right-row-1 left-row-1 acc)
    (.add.mul.z.vf acc right-row-2 left-row-1 acc)
    (.add.mul.w.vf out-row-1 right-row-3 left-row-1 acc)
    (.mul.x.vf acc right-row-0 left-row-2)
    (.add.mul.y.vf acc right-row-1 left-row-2 acc)
    (.add.mul.z.vf acc right-row-2 left-row-2 acc)
    (.add.mul.w.vf out-row-2 right-row-3 left-row-2 acc)
    (.mul.x.vf acc right-row-0 left-row-3)
    (.add.mul.y.vf acc right-row-1 left-row-3 acc)
    (.add.mul.z.vf acc right-row-2 left-row-3 acc)
    (.add.mul.w.vf out-row-3 right-row-3 left-row-3 acc)
    (.svf (&-> dst vector 0 quad) out-row-0)
    (.svf (&-> dst vector 1 quad) out-row-1)
    (.svf (&-> dst vector 2 quad) out-row-2)
    (.svf (&-> dst vector 3 quad) out-row-3)
    dst))

(defun ocean-vector-matrix*! ((dst vector) (src vector) (mat matrix))
  "Transform src by mat with an implied w of 1.0, so mat's translation row is added, and return dst.
   src.w is ignored and dst.w receives the fourth column of the product."
  (rlet ((acc :class vf)
         (vf0 :class vf)
         (mat-row-0 :class vf)
         (mat-row-1 :class vf)
         (mat-row-2 :class vf)
         (mat-row-3 :class vf)
         (point :class vf))
    (init-vf0-vector)
    (.lvf mat-row-0 (&-> mat vector 0 quad))
    (.lvf mat-row-1 (&-> mat vector 1 quad))
    (.lvf mat-row-2 (&-> mat vector 2 quad))
    (.lvf mat-row-3 (&-> mat vector 3 quad))
    (.lvf point (&-> src quad))
    (.mul.x.vf acc mat-row-0 point)
    (.add.mul.y.vf acc mat-row-1 point acc)
    (.add.mul.z.vf acc mat-row-2 point acc)
    (.add.mul.w.vf point mat-row-3 vf0 acc)
    (.svf (&-> dst quad) point)
    dst))

(defun ocean-mid-add-matrices ((dma-buf dma-buffer) (origin vector))
  "Append the OCEAN-MID-MATRICES-QWC matrix quadwords that open a mid-ocean upload: the camera
   rotation with origin transformed into camera space substituted into its translation row, then that
   matrix times the perspective matrix.  origin is the world position of the block or cell corner the
   geometry that follows is relative to.  Advances base past the matrices."
  (let ((origin-cam (new-stack-vector0)))
    (-> *math-camera* camera-rot)
    (let* ((qwc OCEAN-MID-MATRICES-QWC)
           (buf dma-buf)
           (packet (the-as object (-> buf base))))
      (set! (-> (the-as dma-packet packet) dma) (new 'static 'dma-tag :id (dma-tag-id cnt) :qwc qwc))
      (set! (-> (the-as dma-packet packet) vif0)
            (new 'static 'vif-tag :imm (new 'static 'vif-stcycl-imm :cl 4 :wl 4) :cmd (vif-cmd stcycl)))
      (set! (-> (the-as dma-packet packet) vif1)
            (new 'static
                 'vif-tag
                 :imm
                 (new 'static 'vif-unpack-imm :flg 1 :addr (ocean-mid-upload-addr rot))
                 :cmd (vif-cmd unpack-v4-32)
                 :num
                 qwc))
      (set! (-> buf base) (&+ (the-as pointer packet) 16)))
    (let ((rot-dst (-> dma-buf base)))
      (let* ((rot-mat (the-as object rot-dst))
             (cam-rot (-> *math-camera* camera-rot))
             (row0 (-> cam-rot vector 0 quad))
             (row1 (-> cam-rot vector 1 quad))
             (row2 (-> cam-rot vector 2 quad))
             (row3 (-> cam-rot vector 3 quad)))
        (set! (-> (the-as matrix rot-mat) vector 0 quad) row0)
        (set! (-> (the-as matrix rot-mat) vector 1 quad) row1)
        (set! (-> (the-as matrix rot-mat) vector 2 quad) row2)
        (set! (-> (the-as matrix rot-mat) vector 3 quad) row3))
      ;; only xyz of the translation row is replaced; its w stays as the camera rotation had it.
      (let ((rot-trans (the-as object (&+ rot-dst 48))))
        (vector-matrix*! origin-cam origin (-> *math-camera* camera-rot))
        (set! (-> (the-as vector rot-trans) x) (-> origin-cam x))
        (set! (-> (the-as vector rot-trans) y) (-> origin-cam y))
        (set! (-> (the-as vector rot-trans) z) (-> origin-cam z)))
      (let ((mat-dst (&+ (-> dma-buf base) 64)))
        (ocean-matrix*! (the-as matrix mat-dst) (the-as matrix rot-dst) (-> *math-camera* perspective)))))
  (&+! (-> dma-buf base) (* 16 OCEAN-MID-MATRICES-QWC))
  (none))

(defun ocean-mid-check ((camera-mask pointer) (cell-x int) (cell-z int) (block-origin vector))
  "Mark cell (cell-x, cell-z) of one block in camera-mask when any of its four corners is within one
   cell diagonal of the camera.  camera-mask is the eight-byte mid-camera-masks entry for that block;
   cell-x and cell-z run 0..7 inside the block and select the bit and the byte.  block-origin is the
   world position of the block's first corner.  The return value is not meaningful -- the fall-through
   path leaves the return register unset -- so callers use this only for its effect on the mask."
  (local-vars (v0-0 symbol) (dist-sq float))
  (rlet ((delta :class vf)
         (corner-pos :class vf)
         (cam-pos :class vf))
    (let ((corner (new-stack-vector0))
          (cam-trans (-> *math-camera* trans)))
      1.0
      (set! (-> corner x) (+ (-> block-origin x) (* OCEAN-MID-CELL (the float cell-x))))
      (set! (-> corner y) (-> block-origin y))
      (set! (-> corner z) (+ (-> block-origin z) (* OCEAN-MID-CELL (the float cell-z))))
      ;; each of the four tests below is an inlined squared distance from a cell corner to the camera.
      (let ((from corner)
            (to cam-trans))
        (.lvf corner-pos (&-> from quad))
        (.lvf cam-pos (&-> to quad)))
      (.sub.vf delta cam-pos corner-pos)
      (.mul.vf delta delta delta)
      (.add.y.vf.x delta delta delta)
      (.add.z.vf.x delta delta delta)
      (.mov dist-sq delta)
      (when (< dist-sq OCEAN-MID-CELL-DIAGONAL-SQ)
        (logior! (-> (the-as (pointer uint8) camera-mask) cell-z) (ash 1 cell-x))
        (return #f))
      (+! (-> corner x) OCEAN-MID-CELL)
      (let ((from corner)
            (to cam-trans))
        (.lvf corner-pos (&-> from quad))
        (.lvf cam-pos (&-> to quad)))
      (.sub.vf delta cam-pos corner-pos)
      (.mul.vf delta delta delta)
      (.add.y.vf.x delta delta delta)
      (.add.z.vf.x delta delta delta)
      (.mov dist-sq delta)
      (when (< dist-sq OCEAN-MID-CELL-DIAGONAL-SQ)
        (logior! (-> (the-as (pointer uint8) camera-mask) cell-z) (ash 1 cell-x))
        (return #f))
      (+! (-> corner z) OCEAN-MID-CELL)
      (let ((from corner)
            (to cam-trans))
        (.lvf corner-pos (&-> from quad))
        (.lvf cam-pos (&-> to quad)))
      (.sub.vf delta cam-pos corner-pos)
      (.mul.vf delta delta delta)
      (.add.y.vf.x delta delta delta)
      (.add.z.vf.x delta delta delta)
      (.mov dist-sq delta)
      (when (< dist-sq OCEAN-MID-CELL-DIAGONAL-SQ)
        (logior! (-> (the-as (pointer uint8) camera-mask) cell-z) (ash 1 cell-x))
        (return #f))
      (+! (-> corner x) (- OCEAN-MID-CELL))
      (.lvf corner-pos (&-> corner quad))
      (.lvf cam-pos (&-> cam-trans quad)))
    (.sub.vf delta cam-pos corner-pos)
    (.mul.vf delta delta delta)
    (.add.y.vf.x delta delta delta)
    (.add.z.vf.x delta delta delta)
    (.mov dist-sq delta)
    (when (< dist-sq OCEAN-MID-CELL-DIAGONAL-SQ)
      (logior! (-> (the-as (pointer uint8) camera-mask) cell-z) (ash 1 cell-x))
      (return #f)
      v0-0)))

(defun ocean-mid-add-call ((dma-buf dma-buffer) (entry int))
  "Append a tag that resets the unpack write cycle and starts the microprogram at entry.  MSCALF
   waits for a microprogram that is already running, so consecutive calls cannot overlap."
  (let* ((buf dma-buf)
         (packet (the-as object (-> buf base))))
    (set! (-> (the-as dma-packet packet) dma) (new 'static 'dma-tag :id (dma-tag-id cnt)))
    (set! (-> (the-as dma-packet packet) vif0)
          (new 'static 'vif-tag :imm (new 'static 'vif-stcycl-imm :cl 4 :wl 4) :cmd (vif-cmd stcycl)))
    (set! (-> (the-as dma-packet packet) vif1) (new 'static 'vif-tag :cmd (vif-cmd mscalf) :msk #x1 :imm entry))
    (set! (-> buf base) (&+ (the-as pointer packet) 16)))
  (none))

(defun ocean-mid-add-call-flush ((dma-buf dma-buffer) (entry uint))
  "Append a tag that starts the microprogram at entry and then stalls VIF1 until the microprogram,
   its transfers and every GIF path have drained.  Used to close a pass before another pass rewrites
   the shared constants."
  (let* ((buf dma-buf)
         (packet (the-as object (-> buf base))))
    (set! (-> (the-as dma-packet packet) dma) (new 'static 'dma-tag :id (dma-tag-id cnt)))
    (set! (-> (the-as dma-packet packet) vif0) (new 'static 'vif-tag :cmd (vif-cmd mscalf) :msk #x1 :imm entry))
    (set! (-> (the-as dma-packet packet) vif1) (new 'static 'vif-tag :cmd (vif-cmd flusha) :msk #x1))
    (set! (-> buf base) (&+ (the-as pointer packet) 16)))
  (none))

(defun ocean-mid-add-upload ((dma-buf dma-buffer) (block-z int) (block-x int) (mask-index int) (block-index int) (camera-dist float))
  "Append the upload for one 8x8 block of the mid grid: the two matrices, the nine-by-twelve patch of
   corner colors, and the authored suppression mask.  block-z and block-x run 0..5, block-index is
   6 * block-z + block-x, and mask-index selects the ocean-mid-mask the map authored for the block.
   camera-dist is the distance from the camera to the block's bounding sphere surface; when it is
   under one cell diagonal the three-by-three cells around the camera are additionally tested with
   ocean-mid-check.  Records the address of the mask words in mid-mask-ptrs so draw-ocean-mid-seams
   can OR the camera mask into this packet after it is built.  Advances base past the packet."
  (let ((block-origin (new-stack-vector0)))
    (let ((map-corner (-> *ocean-map* start-corner)))
      (set! (-> block-origin x) (+ (-> map-corner x) (* OCEAN-MID-BLOCK (the float block-x))))
      (set! (-> block-origin y) (-> map-corner y))
      (set! (-> block-origin z) (+ (-> map-corner z) (* OCEAN-MID-BLOCK (the float block-z)))))
    (set! (-> block-origin w) 1.0)
    ;; compute combined matrix
    (ocean-mid-add-matrices dma-buf block-origin)
    ;; upload color.
    ;; Nine rows of twelve 8-bit RGBA corner samples, taken straight out of the authored color grid.
    ;; VIF widens each sample to a whole quadword, so a row of twelve becomes twelve quadwords.
    (let ((color-row (+ (the-as uint (-> *ocean-map* ocean-colors))
                        (* (+ (* OCEAN-COLOR-BLOCK-ROW block-z) (* block-x OCEAN-MID-CELLS-PER-BLOCK)) 4))))
      (dotimes (row OCEAN-MID-COLOR-ROWS)
        (let* ((buf dma-buf)
               (packet (the-as object (-> buf base))))
          (set! (-> (the-as dma-packet packet) dma) (new 'static 'dma-tag :qwc #x3 :id (dma-tag-id ref) :addr color-row))
          (set! (-> (the-as dma-packet packet) vif0)
                (new 'static 'vif-tag :imm (new 'static 'vif-stcycl-imm :cl 4 :wl 4) :cmd (vif-cmd stcycl)))
          (set! (-> (the-as dma-packet packet) vif1)
                (new 'static
                     'vif-tag
                     :num #xc
                     :cmd (vif-cmd unpack-v4-8)
                     :imm
                     (new 'static 'vif-unpack-imm :flg 1 :usn 1 :addr (+ (* OCEAN-MID-COLOR-COLUMNS row) (ocean-mid-upload-addr colors)))))
          (set! (-> buf base) (&+ (the-as pointer packet) 16)))
        (+! color-row OCEAN-COLOR-ROW-BYTES)))
    ;; upload "mid masks".
    ;; these allow some zones to be skipped.
    ;; using 0 will draw, using 1 willl skip.
    ;; The eight mask bytes become eight 32-bit lanes across the two mask quadwords.
    (let* ((qwc 1)
           (buf dma-buf)
           (packet (the-as object (-> buf base))))
      (set! (-> (the-as dma-packet packet) dma) (new 'static 'dma-tag :id (dma-tag-id cnt) :qwc qwc))
      (set! (-> (the-as dma-packet packet) vif0)
            (new 'static 'vif-tag :imm (new 'static 'vif-stcycl-imm :cl 4 :wl 2) :cmd (vif-cmd stcycl)))
      (set! (-> (the-as dma-packet packet) vif1)
            (new 'static
                 'vif-tag
                 :imm
                 (new 'static 'vif-unpack-imm :flg 1 :usn 1 :addr (ocean-mid-upload-addr masks))
                 :num #x2
                 :cmd (vif-cmd unpack-v4-8)))
      (set! (-> buf base) (&+ (the-as pointer packet) 16)))
    (let ((mask-dst (-> dma-buf base)))
      (let ((mask (-> *ocean-map* ocean-mid-masks data mask-index)))
        ;; keep the address of the live mask words so the seam pass can add the camera bits later.
        (set! (-> *ocean-work* mid-mask-ptrs block-index) (the-as (pointer int64) mask-dst))
        (set! (-> (the-as (pointer uint64) mask-dst)) (-> mask dword))
        ;; (set! (-> (the-as (pointer uint64) mask-dst)) #xffffffffffffffff)
        )
      (set! (-> (the-as (pointer uint64) mask-dst) 1) (the-as uint 0)))
    (&+! (-> dma-buf base) 16)
    ;; when the camera is very close, we need to do additional checking.
    ;; I believe this checks which subtiles will be skipped by the renderer
    ;; and adds them to the camera masks.
    (when (< camera-dist OCEAN-MID-CELL-DIAGONAL)
      (let* ((cam-trans (-> *math-camera* trans))
             (camera-mask (&-> *ocean-work* mid-camera-masks block-index))
             (first-cell-x (+ (the int (* OCEAN-MID-INV-CELL (- (-> cam-trans x) (-> block-origin x)))) -1))
             (first-cell-z (+ (the int (* OCEAN-MID-INV-CELL (- (-> cam-trans z) (-> block-origin z)))) -1)))
        (dotimes (iz 3)
          (dotimes (ix 3)
            (let ((cell-x (+ ix first-cell-x))
                  (cell-z (+ iz first-cell-z)))
              (if (and (>= cell-x 0) (>= cell-z 0) (< cell-x OCEAN-MID-CELLS-PER-BLOCK) (< cell-z OCEAN-MID-CELLS-PER-BLOCK))
                (ocean-mid-check camera-mask cell-x cell-z block-origin))))))
      #f)))

(defun ocean-mid-camera-masks-bit? ((cell-z uint) (cell-x uint))
  "True when cell (cell-z, cell-x) of the 48x48 grid is marked in mid-camera-masks, meaning the
   transition and near passes will redraw it.  Coordinates outside the grid return #t so callers treat
   everything beyond the grid as already handled."
  (cond
    ((or (< (the-as int cell-z) 0)
         (>= (the-as int cell-z) OCEAN-MID-GRID-DIM)
         (< (the-as int cell-x) 0)
         (>= (the-as int cell-x) OCEAN-MID-GRID-DIM))
     #t)
    (else
     (let* ((block-z (/ (the-as int cell-z) OCEAN-MID-CELLS-PER-BLOCK))
            (block-x (/ (the-as int cell-x) OCEAN-MID-CELLS-PER-BLOCK))
            (mask-row (logand cell-z 7))
            (mask-bit (logand cell-x 7))
            (block-index (+ (* OCEAN-MID-BLOCK-DIM block-z) block-x)))
       (logtest? (-> (the-as (pointer uint8) (&-> *ocean-work* mid-camera-masks block-index)) mask-row) (ash 1 mask-bit))))))

(defun ocean-mid-mask-ptrs-bit? ((cell-z uint) (cell-x uint))
  "True when cell (cell-z, cell-x) is suppressed by the mask its block already uploaded this frame.
   Coordinates outside the grid, and blocks that uploaded nothing, return #t."
  (cond
    ((or (< (the-as int cell-z) 0)
         (>= (the-as int cell-z) OCEAN-MID-GRID-DIM)
         (< (the-as int cell-x) 0)
         (>= (the-as int cell-x) OCEAN-MID-GRID-DIM))
     #t)
    (else
     (let* ((block-z (/ (the-as int cell-z) OCEAN-MID-CELLS-PER-BLOCK))
            (block-x (/ (the-as int cell-x) OCEAN-MID-CELLS-PER-BLOCK))
            (mask-row (logand cell-z 7))
            (mask-bit (logand cell-x 7))
            (block-index (+ (* OCEAN-MID-BLOCK-DIM block-z) block-x)))
       (if (-> *ocean-work* mid-mask-ptrs block-index)
         (logtest? (-> (the-as (pointer uint8) (-> *ocean-work* mid-mask-ptrs block-index)) mask-row) (ash 1 mask-bit))
         #t)))))

(defun ocean-mid-camera-masks-set! ((cell-z uint) (cell-x uint))
  "Mark cell (cell-z, cell-x) in mid-camera-masks and return #t, or return #f when the cell is outside
   the grid or its block's uploaded mask already suppresses it.  The uploaded mask is read through
   mid-mask-ptrs without a null check, so the caller has to know the block uploaded one."
  (cond
    ((or (< (the-as int cell-z) 0)
         (>= (the-as int cell-z) OCEAN-MID-GRID-DIM)
         (< (the-as int cell-x) 0)
         (>= (the-as int cell-x) OCEAN-MID-GRID-DIM))
     #f)
    (else
     (let* ((block-z (/ (the-as int cell-z) OCEAN-MID-CELLS-PER-BLOCK))
            (block-x (/ (the-as int cell-x) OCEAN-MID-CELLS-PER-BLOCK))
            (mask-row (logand cell-z 7))
            (mask-bit (logand cell-x 7))
            (block-index (+ (* OCEAN-MID-BLOCK-DIM block-z) block-x))
            (camera-mask (&-> *ocean-work* mid-camera-masks block-index)))
       (cond
         ;; camera-mask is the address of a fixed array element, so this arm is always taken.
         (camera-mask
          (cond
            ((logtest? (-> (the-as (pointer uint8) (-> *ocean-work* mid-mask-ptrs block-index)) mask-row) (ash 1 mask-bit)) #f)
            (else (logior! (-> (the-as (pointer uint8) camera-mask) mask-row) (ash 1 mask-bit)) #t)))
         (else #f))))))

(defun ocean-mid-add-upload-table ((dma-buf dma-buffer) (cell-z uint) (cell-x uint) (weights (pointer float)) (vertex-count int) (fan? symbol))
  "Append one stitching patch for cell (cell-z, cell-x) of the 48x48 grid and start the microprogram
   on it.  weights is vertex-count quadwords of bilinear weights over the cell's four corners, from
   the tables in ocean-trans-tables; fan? selects the triangle-fan entry point, otherwise the
   triangle-strip entry point.  Does nothing when ocean-mid-camera-masks-set! rejects the cell, which
   is also what keeps a cell from being stitched twice.  Besides the two matrices, the packet carries
   the vertex count, the unit-square texture coordinates and the cell's four corner colors widened
   from 8-bit RGBA to floats."
  (local-vars
    (last-corner-readback float)
    (corner0-halfs uint128)
    (corner0-words uint128)
    (corner2-words uint128)
    (corner1-halfs uint128)
    (corner1-words uint128)
    (corner3-words uint128)
    (corner2-halfs uint128)
    (corner3-halfs uint128))
  (rlet ((corner0-color :class vf)
         (corner1-color :class vf)
         (corner2-color :class vf)
         (corner3-color :class vf))
    (when (ocean-mid-camera-masks-set! cell-z cell-x)
      (let ((cell-origin (new-stack-vector0)))
        (let ((map-corner (-> *ocean-map* start-corner)))
          (set! (-> cell-origin x) (+ (-> map-corner x) (* OCEAN-MID-CELL (the float cell-x))))
          (set! (-> cell-origin y) (-> map-corner y))
          (set! (-> cell-origin z) (+ (-> map-corner z) (* OCEAN-MID-CELL (the float cell-z)))))
        (set! (-> cell-origin w) 1.0)
        ;; (format 0 "~`vector`P~%" (-> *ocean-map* start-corner))
        (ocean-mid-add-matrices dma-buf cell-origin))
      (let* ((qwc OCEAN-MID-SEAM-HEADER-QWC)
             (buf dma-buf)
             (packet (the-as object (-> buf base))))
        (set! (-> (the-as dma-packet packet) dma) (new 'static 'dma-tag :id (dma-tag-id cnt) :qwc qwc))
        (set! (-> (the-as dma-packet packet) vif0)
              (new 'static 'vif-tag :imm (new 'static 'vif-stcycl-imm :cl 4 :wl 4) :cmd (vif-cmd stcycl)))
        (set! (-> (the-as dma-packet packet) vif1)
              (new 'static
                   'vif-tag
                   :imm
                   (new 'static 'vif-unpack-imm :flg 1 :addr (ocean-mid-upload2-addr count))
                   :cmd (vif-cmd unpack-v4-32)
                   :num
                   qwc))
        (set! (-> buf base) (&+ (the-as pointer packet) 16)))
      (set-vector! (the-as vector4w (-> dma-buf base)) vertex-count 0 0 0)
      (&+! (-> dma-buf base) 16)
      ;; The four corner colors are 8-bit RGBA in the map.  Two packed unpacks widen each of them to
      ;; four 32-bit lanes and VU0 converts the lanes to floats.  Every line below pairs one
      ;; multimedia operation with one coprocessor operation, so the empty slots belong to the
      ;; schedule rather than being padding.
      (let ((upload (the-as (pointer uint128) (-> dma-buf base))))
        (set! (-> upload 0) (-> *ocean-trans-st-table* 0 quad))
        (set! (-> upload 1) (-> *ocean-trans-st-table* 1 quad))
        (set! (-> upload 2) (-> *ocean-trans-st-table* 2 quad))
        (set! (-> upload 3) (-> *ocean-trans-st-table* 3 quad))
        (let ((corner0-rgba (the-as uint128 (-> *ocean-map* ocean-colors colors (+ (* OCEAN-COLOR-ROW (the-as int cell-z)) cell-x))))
              (corner1-rgba (the-as uint128 (-> *ocean-map* ocean-colors colors (+ cell-x 1 (* OCEAN-COLOR-ROW (the-as int cell-z))))))
              (corner2-rgba (the-as uint128 (-> *ocean-map* ocean-colors colors (+ (* OCEAN-COLOR-ROW (the-as int (+ cell-z 1))) cell-x))))
              (corner3-rgba (the-as uint128 (-> *ocean-map* ocean-colors colors (+ cell-x 1 (* OCEAN-COLOR-ROW (the-as int (+ cell-z 1))))))))
          (.pextlb corner0-halfs 0 corner0-rgba)
          (nop!)
          (.pextlb corner1-halfs 0 corner1-rgba)
          (nop!)
          (.pextlb corner2-halfs 0 corner2-rgba)
          (nop!)
          (.pextlb corner3-halfs 0 corner3-rgba))
        (nop!)
        (.pextlh corner0-words 0 corner0-halfs)
        (nop!)
        (.pextlh corner1-words 0 corner1-halfs)
        (.mov corner0-color corner0-words)
        (.pextlh corner2-words 0 corner2-halfs)
        (.mov corner1-color corner1-words)
        (.pextlh corner3-words 0 corner3-halfs)
        (.mov corner2-color corner2-words)
        (nop!)
        (.mov corner3-color corner3-words)
        (.itof.vf corner0-color corner0-color)
        (nop!)
        (.itof.vf corner1-color corner1-color)
        (nop!)
        (.itof.vf corner2-color corner2-color)
        (nop!)
        (.itof.vf corner3-color corner3-color)
        (nop!)
        (nop!)
        (.svf (&-> upload 4) corner0-color)
        (nop!)
        (.svf (&-> upload 5) corner1-color)
        (nop!)
        (.svf (&-> upload 6) corner2-color)
        (nop!)
        (.svf (&-> upload 7) corner3-color))
      ;; the last converted color is also read back into an EE register; the value is unused.
      (.mov last-corner-readback corner3-color)
      (&+! (-> dma-buf base) 128)
      (let* ((buf dma-buf)
             (packet (the-as object (-> buf base))))
        (set! (-> (the-as dma-packet packet) dma)
              (new 'static 'dma-tag :id (dma-tag-id ref) :addr (the-as int weights) :qwc vertex-count))
        (set! (-> (the-as dma-packet packet) vif0)
              (new 'static 'vif-tag :imm (new 'static 'vif-stcycl-imm :cl 4 :wl 4) :cmd (vif-cmd stcycl)))
        (set! (-> (the-as dma-packet packet) vif1)
              (new 'static
                   'vif-tag
                   :imm
                   (new 'static 'vif-unpack-imm :flg 1 :addr (ocean-mid-upload2-addr verts))
                   :cmd (vif-cmd unpack-v4-32)
                   :num
                   vertex-count))
        (set! (-> buf base) (&+ (the-as pointer packet) 16)))
      (if fan? (ocean-mid-add-call dma-buf OCEAN-MID-VU-FAN) (ocean-mid-add-call dma-buf OCEAN-MID-VU-STRIP)))
    (none)))

(defun ocean-mid-add-upload-top ((dma-buf dma-buffer) (cell-z uint) (cell-x uint))
  "Stitch cell (cell-z, cell-x) on the first row of the region the camera masks cover.  When the cell
   is itself masked the block pass will not draw it, so the cells above and beside it get an edge fan
   facing in; otherwise the cell keeps its mid geometry and its own edges toward the region are
   subdivided.  An edge is only subdivided when the neighbor across it exists, and a cell at mid-minx
   or mid-maxx needs its side edge as well, so both together need a corner table."
  (let ((min-x (-> *ocean-work* mid-minx))
        (max-x (-> *ocean-work* mid-maxx))
        (camera-cell? (ocean-mid-camera-masks-bit? cell-z cell-x)))
    (cond
      ((ocean-mid-mask-ptrs-bit? cell-z cell-x))
      ((= cell-x min-x)
       (cond
         (camera-cell?
          (ocean-mid-add-upload-table dma-buf (+ cell-z -1) cell-x *ocean-down-table* 7 #t)
          (ocean-mid-add-upload-table dma-buf cell-z (+ cell-x -1) *ocean-right-table* 7 #t))
         (else
          (let ((z-hidden? (ocean-mid-mask-ptrs-bit? (+ cell-z 1) cell-x))
                (x-hidden? (ocean-mid-mask-ptrs-bit? cell-z (+ cell-x 1))))
            (cond
              ((and z-hidden? x-hidden?))
              (z-hidden? (ocean-mid-add-upload-table dma-buf cell-z cell-x *ocean-right-table* 7 #t))
              (x-hidden? (ocean-mid-add-upload-table dma-buf cell-z cell-x *ocean-down-table* 7 #t))
              (else (ocean-mid-add-upload-table dma-buf cell-z cell-x *ocean-down-right-table* 10 #f)))))))
      ((= cell-x max-x)
       (cond
         (camera-cell?
          (ocean-mid-add-upload-table dma-buf (+ cell-z -1) cell-x *ocean-down-table* 7 #t)
          (ocean-mid-add-upload-table dma-buf cell-z (+ cell-x 1) *ocean-left-table* 7 #t))
         (else
          (let ((z-hidden? (ocean-mid-mask-ptrs-bit? (+ cell-z 1) cell-x))
                (x-hidden? (ocean-mid-mask-ptrs-bit? cell-z (+ cell-x -1))))
            (cond
              ((and z-hidden? x-hidden?))
              (z-hidden? (ocean-mid-add-upload-table dma-buf cell-z cell-x *ocean-left-table* 7 #t))
              (x-hidden? (ocean-mid-add-upload-table dma-buf cell-z cell-x *ocean-down-table* 7 #t))
              (else (ocean-mid-add-upload-table dma-buf cell-z cell-x *ocean-down-left-table* 10 #t)))))))
      (camera-cell? (ocean-mid-add-upload-table dma-buf (+ cell-z -1) cell-x *ocean-down-table* 7 #t))))
  (none))

(defun ocean-mid-add-upload-middle ((dma-buf dma-buffer) (cell-z uint) (cell-x uint))
  "Stitch cell (cell-z, cell-x) on a row between the first and the last of the camera region.  Only
   the left and right columns of the region need work here; the rows above and below are handled by
   ocean-mid-add-upload-top and ocean-mid-add-upload-bottom."
  (let ((min-x (-> *ocean-work* mid-minx))
        (max-x (-> *ocean-work* mid-maxx))
        (camera-cell? (ocean-mid-camera-masks-bit? cell-z cell-x)))
    (cond
      ((ocean-mid-mask-ptrs-bit? cell-z cell-x))
      ((= cell-x min-x)
       (cond
         (camera-cell? (ocean-mid-add-upload-table dma-buf cell-z (+ cell-x -1) *ocean-right-table* 7 #t))
         ((ocean-mid-mask-ptrs-bit? cell-z (+ cell-x 1)))
         (else (ocean-mid-add-upload-table dma-buf cell-z cell-x *ocean-right-table* 7 #t))))
      ((= cell-x max-x)
       (cond
         (camera-cell? (ocean-mid-add-upload-table dma-buf cell-z (+ cell-x 1) *ocean-left-table* 7 #t))
         ((ocean-mid-mask-ptrs-bit? cell-z (+ cell-x -1)))
         (else (ocean-mid-add-upload-table dma-buf cell-z cell-x *ocean-left-table* 7 #t))))))
  (none))

(defun ocean-mid-add-upload-bottom ((dma-buf dma-buffer) (cell-z uint) (cell-x uint))
  "Stitch cell (cell-z, cell-x) on the last row of the camera region.  This is
   ocean-mid-add-upload-top mirrored in z: the neighbor outside the region is at cell-z plus one here,
   so the up tables replace the down tables."
  (let ((min-x (-> *ocean-work* mid-minx))
        (max-x (-> *ocean-work* mid-maxx))
        (camera-cell? (ocean-mid-camera-masks-bit? cell-z cell-x)))
    (cond
      ((ocean-mid-mask-ptrs-bit? cell-z cell-x))
      ((= cell-x min-x)
       (cond
         (camera-cell?
          (ocean-mid-add-upload-table dma-buf (+ cell-z 1) cell-x *ocean-up-table* 7 #t)
          (ocean-mid-add-upload-table dma-buf cell-z (+ cell-x -1) *ocean-right-table* 7 #t))
         (else
          (let ((z-hidden? (ocean-mid-mask-ptrs-bit? (+ cell-z -1) cell-x))
                (x-hidden? (ocean-mid-mask-ptrs-bit? cell-z (+ cell-x 1))))
            (cond
              ((and z-hidden? x-hidden?))
              (z-hidden? (ocean-mid-add-upload-table dma-buf cell-z cell-x *ocean-right-table* 7 #t))
              (x-hidden? (ocean-mid-add-upload-table dma-buf cell-z cell-x *ocean-up-table* 7 #t))
              (else (ocean-mid-add-upload-table dma-buf cell-z cell-x *ocean-up-right-table* 10 #t)))))))
      ((= cell-x max-x)
       (cond
         (camera-cell?
          (ocean-mid-add-upload-table dma-buf (+ cell-z 1) cell-x *ocean-up-table* 7 #t)
          (ocean-mid-add-upload-table dma-buf cell-z (+ cell-x 1) *ocean-left-table* 7 #t))
         (else
          (let ((z-hidden? (ocean-mid-mask-ptrs-bit? (+ cell-z -1) cell-x))
                (x-hidden? (ocean-mid-mask-ptrs-bit? cell-z (+ cell-x -1))))
            (cond
              ((and z-hidden? x-hidden?))
              (z-hidden? (ocean-mid-add-upload-table dma-buf cell-z cell-x *ocean-left-table* 7 #t))
              (x-hidden? (ocean-mid-add-upload-table dma-buf cell-z cell-x *ocean-up-table* 7 #t))
              (else (ocean-mid-add-upload-table dma-buf cell-z cell-x *ocean-up-left-table* 10 #f)))))))
      (camera-cell? (ocean-mid-add-upload-table dma-buf (+ cell-z 1) cell-x *ocean-up-table* 7 #t))))
  (none))

(defun ocean-seams-add-constants ((dma-buf dma-buffer))
  "Put the four unit-cell corner positions back into the resident constants block.  The transition
   pass leaves 24-meter corners there, so the mid seam pass has to restore the 96-meter cell corners
   before it uploads any weight table.  Advances base past the four quadwords."
  (let* ((qwc 4)
         (buf dma-buf)
         (packet (the-as object (-> buf base))))
    (set! (-> (the-as dma-packet packet) dma) (new 'static 'dma-tag :id (dma-tag-id cnt) :qwc qwc))
    (set! (-> (the-as dma-packet packet) vif0)
          (new 'static 'vif-tag :imm (new 'static 'vif-stcycl-imm :cl 4 :wl 4) :cmd (vif-cmd stcycl)))
    (set! (-> (the-as dma-packet packet) vif1)
          (new 'static
               'vif-tag
               :imm
               (new 'static 'vif-unpack-imm :addr (ocean-mid-vu-const pos0))
               :cmd (vif-cmd unpack-v4-32)
               :num
               qwc))
    (set! (-> buf base) (&+ (the-as pointer packet) 16)))
  (let ((corners (-> dma-buf base)))
    (set-vector! (the-as vector (&+ corners 0)) 0.0 0.0 0.0 1.0)
    (set-vector! (the-as vector (&+ corners 16)) OCEAN-MID-CELL 0.0 0.0 1.0)
    (set-vector! (the-as vector (&+ corners 32)) 0.0 0.0 OCEAN-MID-CELL 1.0)
    (set-vector! (the-as vector (&+ corners 48)) OCEAN-MID-CELL 0.0 OCEAN-MID-CELL 1.0))
  (&+! (-> dma-buf base) 64)
  (none))

(defun sphere-cull-for-ocean ((bsphere vector))
  "NOTE: added in PC port
   Frustum-test one bounding sphere against the four camera side planes and return #t when any part of
   it is inside.  The planes are stored transposed, so one four-lane multiply-add produces all four
   signed distances at once and a packed compare collects their sign bits."
  (local-vars (distances uint128) (negative-lanes uint128) (packed uint128))
  (rlet ((acc :class vf)
         (vf0 :class vf)
         (sphere-pos :class vf)
         (plane-x :class vf)
         (plane-y :class vf)
         (plane-z :class vf)
         (plane-dist :class vf)
         (plane-distance :class vf))
    (init-vf0-vector)
    (let ((math-cam *math-camera*))
      ;; note: these are for sphere cull.
      (.lvf plane-x (&-> math-cam plane 0 quad))
      (.lvf plane-y (&-> math-cam plane 1 quad))
      (.lvf plane-z (&-> math-cam plane 2 quad))
      (.lvf plane-dist (&-> math-cam plane 3 quad)))
    (.lvf sphere-pos (&-> bsphere quad))
    (.mul.x.vf acc plane-x sphere-pos)
    (.add.mul.y.vf acc plane-y sphere-pos acc)
    (.add.mul.z.vf acc plane-z sphere-pos acc)
    (.sub.mul.w.vf plane-distance plane-dist vf0 acc)
    (.add.w.vf plane-distance plane-distance sphere-pos)
    (.mov distances plane-distance)
    (.pcgtw negative-lanes 0 distances)
    (.ppach packed (the-as uint128 0) negative-lanes)
    (zero? (the-as int packed))))

;; definition for function draw-ocean-mid-seams
;; INFO: Return type mismatch symbol vs none.
(defun draw-ocean-mid-seams ((dma-buf dma-buffer))
  "Stitch the border of the region marked in mid-camera-masks so the 96-meter mid cells meet the finer
   transition and near geometry without cracks, then fold the camera masks into the block packets that
   were already built.  mid-minx, mid-maxx, mid-minz and mid-maxz bound the region, and each cell is
   culled with its own 68-meter bounding sphere before any seam work."
  (ocean-seams-add-constants dma-buf)
  (let ((min-x (-> *ocean-work* mid-minx))
        (max-x (-> *ocean-work* mid-maxx))
        (min-z (-> *ocean-work* mid-minz))
        (max-z (-> *ocean-work* mid-maxz))
        (bsphere (new 'stack 'sphere)))
    (set! (-> bsphere y) (-> *ocean-map* start-corner y))
    (set! (-> bsphere w) OCEAN-MID-CELL-RADIUS)
    (let ((cell-z min-z)
          (last-z max-z))
      (while (>= last-z cell-z)
        (let ((cell-x min-x)
              (last-x max-x))
          (while (>= last-x cell-x)
            (set! (-> bsphere x) (+ OCEAN-MID-HALF-CELL (* OCEAN-MID-CELL (the float cell-x)) (-> *ocean-map* start-corner x)))
            (set! (-> bsphere z) (+ OCEAN-MID-HALF-CELL (* OCEAN-MID-CELL (the float cell-z)) (-> *ocean-map* start-corner z)))
            ;; og:preserve-this
            (when (sphere-cull-for-ocean bsphere)
              (cond
                ((= cell-z min-z) (ocean-mid-add-upload-top dma-buf cell-z cell-x))
                ((= cell-z max-z) (ocean-mid-add-upload-bottom dma-buf cell-z cell-x))
                (else (ocean-mid-add-upload-middle dma-buf cell-z cell-x))))
            (+! cell-x 1)))
        (+! cell-z 1))))
  ;; The block packets are still in the buffer, so the camera masks can be added to the suppression
  ;; masks they already carry instead of rebuilding anything.
  (dotimes (block-index OCEAN-MID-BLOCK-COUNT)
    (if (and (-> *ocean-work* mid-mask-ptrs block-index) (nonzero? (-> *ocean-work* mid-camera-masks block-index)))
      (logior! (-> *ocean-work* mid-mask-ptrs block-index 0) (-> *ocean-work* mid-camera-masks block-index))))
  (none))

;; ADDED for PC Port
(defun debug-draw-ocean-tile ((y int) (x int) (color0 rgba) (color1 rgba) (masks int))
  "Draw the outline of one 768-meter mid-ocean tile plus a small filled corner triangle, and label it
   with its coordinates, its linear index and its mask bits.  y is the tile's z index."
  ;;3145728.0
  (let* ((ps (-> *ocean-map* start-corner))
         (p0 (vector-copy! (new-stack-vector0) ps))
         (p1 (vector-copy! (new-stack-vector0) ps))
         (p2 (vector-copy! (new-stack-vector0) ps))
         (p1s (vector-copy! (new-stack-vector0) ps))
         (p2s (vector-copy! (new-stack-vector0) ps))
         (p3 (vector-copy! (new-stack-vector0) ps))
         (x0 (* 3145728.0 (the float x)))
         (y0 (* 3145728.0 (the float y))))
    (+! (-> p0 x) x0)
    (+! (-> p0 z) y0)
    (+! (-> p1 x) (+ x0 3145728.0))
    (+! (-> p1 z) y0)
    (+! (-> p2 x) x0)
    (+! (-> p2 z) (+ y0 3145728.0))
    (+! (-> p1s x) (+ x0 314572.0))
    (+! (-> p1s z) y0)
    (+! (-> p2s x) x0)
    (+! (-> p2s z) (+ y0 314572.0))
    (+! (-> p3 x) (+ x0 3145728.0))
    (+! (-> p3 z) (+ y0 3145728.0))
    (add-debug-flat-triangle #t (bucket-id debug-no-zbuf) p0 p1s p2s color0)
    ;; (add-debug-flat-triangle #t (bucket-id debug-no-zbuf) p3 p1 p2 color0)
    (add-debug-outline-triangle #t (bucket-id debug-no-zbuf) p0 p1 p2 color1)
    (add-debug-outline-triangle #t (bucket-id debug-no-zbuf) p3 p1 p2 color1)
    (format (clear *temp-string*) "o: ~d ~d ~d ~b" x y (+ (* 6 y) x) masks)
    (add-debug-text-3d #t (bucket-id debug-no-zbuf) *temp-string* p0 (font-color red) (the vector2h #f))))

(defun draw-ocean-mid ((dma-buf dma-buffer))
  "Main function to draw the 'mid' ocean
   The mid ocean is used to draw the non-transparent ocean parts.
   There is a large 6x6 grid of tiles.
   Tiles that are closer to the camera have an environment mapping effect applied.
   Each tile is an 8x8 patch of the 48x48 grid of 96-meter cells.  A tile whose bounding sphere comes
   within OCEAN-MID-ENV-DISTANCE of the camera is drawn twice, once textured and once through the
   environment map, which is why it reports twice the triangles.  A negative authored index means the
   tile has no mid geometry.  When the camera is near the water surface this also runs the transition
   and seam passes, which share this file's microprogram and constants."
  (rlet ((plane-x :class vf)
         (plane-y :class vf)
         (plane-z :class vf)
         (plane-dist :class vf)
         (guard-x :class vf)
         (guard-y :class vf)
         (guard-z :class vf)
         (guard-dist :class vf))
    ;; first, reset all masks to 0
    (dotimes (block-index OCEAN-MID-BLOCK-COUNT)
      (set! (-> *ocean-work* mid-mask-ptrs block-index) (the-as (pointer int64) #f))
      (set! (-> *ocean-work* mid-camera-masks block-index) (the-as uint 0)))
    ;; upload VU1 program
    (dma-buffer-add-vu-function dma-buf ocean-mid-block 1)
    ;; set up base+offset for the VU1 program uploads
    (let* ((buf dma-buf)
           (packet (the-as object (-> buf base))))
      (set! (-> (the-as dma-packet packet) dma) (new 'static 'dma-tag :id (dma-tag-id cnt)))
      (set! (-> (the-as dma-packet packet) vif0) (new 'static 'vif-tag :cmd (vif-cmd base)))
      (set! (-> (the-as dma-packet packet) vif1) (new 'static 'vif-tag :imm OCEAN-MID-VU-BANK-QWC :cmd (vif-cmd offset)))
      (set! (-> buf base) (&+ (the-as pointer packet) 16)))
    ;; upload ocean constants
    (ocean-mid-add-constants dma-buf)
    ;; run program to initialize VU1 renderer
    (ocean-mid-add-call dma-buf OCEAN-MID-VU-INIT)
    ;; set up VF registers for sphere culling.
    ;; The planes are stored transposed, one coefficient per register.  sphere-cull-for-ocean loads
    ;; them itself, so these copies are not read again here.
    (let ((math-cam *math-camera*))
      (.lvf plane-x (&-> math-cam plane 0 quad))
      (.lvf plane-y (&-> math-cam plane 1 quad))
      (.lvf plane-z (&-> math-cam plane 2 quad))
      (.lvf plane-dist (&-> math-cam plane 3 quad))
      (.lvf guard-x (&-> math-cam guard-plane 0 quad))
      (.lvf guard-y (&-> math-cam guard-plane 1 quad))
      (.lvf guard-z (&-> math-cam guard-plane 2 quad))
      (.lvf guard-dist (&-> math-cam guard-plane 3 quad)))
    ;; zero the cull scratch vector.
    (set! (-> (new 'stack-no-clear 'vector) quad) (the-as uint128 0))
    ;; draw tiles!
    (let ((cam-trans (-> *math-camera* trans)))
      (dotimes (block-z OCEAN-MID-BLOCK-DIM)
        (dotimes (block-x OCEAN-MID-BLOCK-DIM)
          (let* ((block-index (+ (* OCEAN-MID-BLOCK-DIM block-z) block-x)) ;; tile index
                 (bsphere (-> *ocean-map* ocean-spheres spheres block-index)) ;; vis sphere of ocean
                 ;; the authored indices are signed; a negative one means the tile has no mid geometry.
                 (mask-index (-> (the-as (pointer int16) (+ (* block-index 2) (the-as int (-> *ocean-map* ocean-mid-indices)))))))
            ;; (format 0 "draw ocean tile: ~d x ~d = ~d index ~d~%" block-z block-x block-index mask-index)
            ;; (debug-draw-ocean-tile block-z block-x (new 'static 'rgba :r #x80 :a #x80) (new 'static 'rgba :g #x80 :a #x80) mask-index)
            ;; og:preserve-this
            (when (sphere-cull-for-ocean bsphere)
              ;;(format 0 " vis!~%")
              (cond
                ((< mask-index 0)
                 ;; (format 0 " skip tile.~%")
                 )
                ;; the upload happens either way; this test only picks the entry point.
                ((let ((surface-dist (- (vector-vector-distance bsphere cam-trans) (-> bsphere w))))
                   (ocean-mid-add-upload dma-buf block-z block-x mask-index block-index surface-dist)
                   (< surface-dist OCEAN-MID-ENV-DISTANCE)
                   ;; HACK
                   ;; #t
                   )
                 ;; (format 0 " draw env map~%")
                 (ocean-mid-add-call dma-buf OCEAN-MID-VU-BLOCK-ENV)
                 (+! (-> *terrain-stats* ocean-mid fragments) 1)
                 (+! (-> *terrain-stats* ocean-mid tris) 256)
                 (+! (-> *terrain-stats* ocean-mid dverts) 288))
                (else
                 (ocean-mid-add-call dma-buf OCEAN-MID-VU-BLOCK)
                 (+! (-> *terrain-stats* ocean-mid fragments) 1)
                 (+! (-> *terrain-stats* ocean-mid tris) 128)
                 (+! (-> *terrain-stats* ocean-mid dverts) 144))))))))
    ;; for now, skip seams.
    ;; when it's both on and cam is low
    (when (not (or *ocean-near-off* (< (meters 48) (fabs (-> *math-camera* trans y)))))
      ;; Collapse the per-block camera masks into the cell rectangle the transition and seam passes
      ;; walk.  A mask byte is a cell row and a mask bit is a cell column, so the grid coordinates are
      ;; 8 * block + byte and 8 * block + bit.
      (let ((min-x OCEAN-MID-GRID-DIM)
            (max-x 0)
            (min-z OCEAN-MID-GRID-DIM)
            (max-z 0))
        (dotimes (block-z OCEAN-MID-BLOCK-DIM)
          (dotimes (block-x OCEAN-MID-BLOCK-DIM)
            (let ((camera-mask (&-> *ocean-work* mid-camera-masks (+ (* OCEAN-MID-BLOCK-DIM block-z) block-x))))
              (when (nonzero? (-> camera-mask 0))
                (dotimes (mask-row OCEAN-MID-CELLS-PER-BLOCK)
                  (let ((row-bits (-> (the-as (pointer uint8) camera-mask) mask-row)))
                    (when (nonzero? row-bits)
                      (let ((cell-z (+ (* block-z OCEAN-MID-CELLS-PER-BLOCK) mask-row)))
                        (if (< cell-z min-z) (set! min-z cell-z))
                        (if (< max-z cell-z) (set! max-z cell-z)))
                      (dotimes (mask-bit OCEAN-MID-CELLS-PER-BLOCK)
                        (when (logtest? row-bits (ash 1 mask-bit))
                          (let ((cell-x (+ (* block-x OCEAN-MID-CELLS-PER-BLOCK) mask-bit)))
                            (if (< cell-x min-x) (set! min-x cell-x))
                            (if (< max-x cell-x) (set! max-x cell-x))))))))))))
        (set! (-> *ocean-work* mid-minx) (the-as uint min-x))
        (set! (-> *ocean-work* mid-maxx) (the-as uint max-x))
        (set! (-> *ocean-work* mid-minz) (the-as uint min-z))
        (set! (-> *ocean-work* mid-maxz) (the-as uint max-z))
        ;; a region only one cell wide or one cell deep is left to the block pass.
        (when (and (< min-x max-x) (< min-z max-z))
          (ocean-mid-add-call-flush dma-buf (the-as uint OCEAN-MID-VU-END-PASS))
          (ocean-mid-add-call-flush dma-buf (the-as uint OCEAN-MID-VU-BEGIN-SEAM-PASS))
          (draw-ocean-transition dma-buf)
          (draw-ocean-mid-seams dma-buf))))
    (ocean-mid-add-call-flush dma-buf (the-as uint OCEAN-MID-VU-END-PASS))
    0
    (none)))

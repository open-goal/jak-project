;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/gfx/ocean/ocean-h.gc")
(require "engine/gfx/hw/display.gc")

;; The ocean texture is the surface detail every other ocean pass shares.  Once per
;; frame the animated wave field is rendered into a 128x128 page of VRAM, and the far,
;; mid, transition and near passes then map that page onto each 96-metre mid cell.  It
;; is what makes a flat mid-grid quad look like moving, reflective water without
;; shading the enormous mid grid per vertex.
;;
;; What goes in.  ocean-generate-verts leaves a 32x32 lattice in *ocean-verts*, four
;; vertices per eight quadwords: one lit color per vertex interleaved with the x, y and
;; z components of the four vertex normals, transposed so a single VU1 multiply chain
;; can dot four normals at once.  This pass DMAs that lattice to VU1 in eleven batches
;; of three rows, and the microprogram
;;
;;   - contracts each normal with cam-nrm, the camera's forward axis, to get a
;;     view-dependent reflection strength,
;;   - turns the normal and that strength into an ST coordinate in the ocean
;;     environment map, whose adgif shader ocean-texture-add-envmap installed, and
;;   - places the vertex on a fixed 128x128 grid four texels at a time, stepping with
;;     the `offsets` constants from the `start` origin.
;;
;; Because the reflection term depends on where the camera is looking, the page cannot
;; be baked into art data; it has to be rebuilt whenever the camera turns.
;;
;; Rows and seams.  A VU1 row buffer holds 33 vertices: the 32 uploaded ones plus a
;; copy of the first, which the program appends itself, so a row closes on itself.
;; Each strip joins two adjacent rows into the 66-vertex tri-strip described by the
;; `giftag` constant, and 32 strips fill the page.  The 33rd row is a second copy of
;; row 0, which ocean-texture-add-verts-last re-uploads after the ten full batches.
;;
;; Where it goes, and why twice per frame.  The render target is *ocean-base-page*.
;; The eye renderer's own framebuffer starts at the same VRAM word (see
;; allocate-defaults! in texture.gc), and the eyes bucket sits between
;; ocean-mid-and-far and ocean-near, so both of those buckets have to rebuild the page
;; before sampling it - which is why draw-ocean calls this function twice.  Only the
;; earlier call passes build-mips? true, because only the mid pass reads the coarse
;; levels; those live in the pages above the base level.

;; VU1 data address of the seven-quadword constant block, in quadwords.
(defconstant OCEAN-TEXTURE-VU1-CONSTANTS 985)

;; One upload batch is three rows of 32 vertices at two quadwords each.  The last
;; batch is split: two rows from the end of the lattice plus a wrapped copy of row 0.
(defconstant OCEAN-TEXTURE-BATCH-QWC 192)

(defconstant OCEAN-TEXTURE-TAIL-QWC 128)

(defconstant OCEAN-TEXTURE-WRAP-QWC 64)

;; DECOMP BEGINS

;; Prebuilt DMA/GIF headers.  sprite-tmpl draws one textured sprite from UV and XYZ
;; pairs and is what the mip-chain pass below fills in; sprite-tmpl2 is the same sprite
;; without a texture, blended; adgif-tmpl carries the five A+D registers of an
;; adgif-shader.  Each starts with a DMA tag and a VIF1 DIRECT of the right length, so
;; a caller only has to copy the header and append its own data qwords.
(define *ocean-texture-work*
  (new 'static
       'ocean-texture-work
       :sprite-tmpl
       (new 'static
            'dma-gif-packet
            :dma-vif
            (new 'static
                 'dma-packet
                 :dma
                 (new 'static 'dma-tag :qwc #x6 :id (dma-tag-id cnt))
                 :vif1
                 (new 'static 'vif-tag :imm #x6 :cmd (vif-cmd direct) :msk #x1))
            :gif0
            (new 'static
                 'gif-tag64
                 :nloop #x1
                 :eop #x1
                 :pre #x1
                 :prim
                 (new 'static 'gs-prim :prim (gs-prim-type sprite) :tme #x1 :fst #x1)
                 :nreg #x5)
            :gif1
            (new 'static
                 'gif-tag-regs
                 :regs0 (gif-reg-id rgbaq)
                 :regs1 (gif-reg-id uv)
                 :regs2 (gif-reg-id xyz2)
                 :regs3 (gif-reg-id uv)
                 :regs4 (gif-reg-id xyz2)))
       :sprite-tmpl2
       (new 'static
            'dma-gif-packet
            :dma-vif
            (new 'static
                 'dma-packet
                 :dma
                 (new 'static 'dma-tag :qwc #x4 :id (dma-tag-id cnt))
                 :vif1
                 (new 'static 'vif-tag :imm #x4 :cmd (vif-cmd direct) :msk #x1))
            :gif0
            (new 'static
                 'gif-tag64
                 :nloop #x1
                 :eop #x1
                 :pre #x1
                 :prim
                 (new 'static 'gs-prim :prim (gs-prim-type sprite) :abe #x1)
                 :nreg #x3)
            :gif1
            (new 'static 'gif-tag-regs :regs0 (gif-reg-id rgbaq) :regs1 (gif-reg-id xyz2) :regs2 (gif-reg-id xyz2)))
       :adgif-tmpl
       (new 'static
            'dma-gif-packet
            :dma-vif
            (new 'static
                 'dma-packet
                 :dma
                 (new 'static 'dma-tag :qwc #x6 :id (dma-tag-id cnt))
                 :vif1
                 (new 'static 'vif-tag :imm #x6 :cmd (vif-cmd direct) :msk #x1))
            :gif0
            (new 'static 'gif-tag64 :nloop #x5 :eop #x1 :nreg #x1)
            :gif1
            (new 'static 'gif-tag-regs :regs0 (gif-reg-id a+d)))))

(define ocean-texture-vu1-block
  (new 'static
       'vu-function
       #| :length #x92 :qlength 73 |#
       ))

(defun ocean-texture-setup-constants ((consts ocean-texture-constants))
  "Fill consts, the seven-quadword block the ocean-texture VU1 program keeps at
   OCEAN-TEXTURE-VU1-CONSTANTS.  giftag is the 66-vertex textured tri-strip that one
   strip of the page becomes.  buffers and dests are the pairs of VU1 addresses the
   program alternates between: two 199-quadword output buffers and two 99-quadword
   row buffers, one row being 33 vertices of three quadwords.  start is the origin of
   the destination grid with its constant depth in z, offsets the four- and
   sixteen-texel steps between vertices and rows, and constants the 0.5 scale and bias
   that turn a signed reflection direction into an environment-map coordinate.
   cam-nrm is the camera's forward axis, negated so it points from the surface toward
   the eye; it makes the whole texture view-dependent, which is why this has to be
   rebuilt every frame."
  (set! (-> consts giftag tag)
        (new 'static
             'gif-tag64
             :nloop #x42
             :eop #x1
             :pre #x1
             :prim
             (new 'static 'gs-prim :prim (gs-prim-type tri-strip) :iip #x1 :tme #x1)
             :nreg #x3))
  (set! (-> consts giftag regs)
        (new 'static 'gif-tag-regs :regs0 (gif-reg-id st) :regs1 (gif-reg-id rgbaq) :regs2 (gif-reg-id xyz2)))
  ;; these are VU1 data addresses
  (set-vector! (-> consts buffers) 384 583 384 583)
  (set-vector! (-> consts dests) 782 881 782 881)
  (set-vector! (-> consts start) 0.0 0.0 1048575.94 0.0)
  (set-vector! (-> consts offsets) 4.0 8.0 12.0 16.0)
  (set-vector! (-> consts constants) 0.5 0.5 0.0 0.0)
  (set! (-> consts cam-nrm x) (- (-> *math-camera* inv-camera-rot vector 2 x)))
  (set! (-> consts cam-nrm y) (- (-> *math-camera* inv-camera-rot vector 2 y)))
  (set! (-> consts cam-nrm z) (- (-> *math-camera* inv-camera-rot vector 2 z)))
  (set! (-> consts cam-nrm w) 0.0)
  0
  (none))

(defun ocean-texture-add-constants ((dma-buf dma-buffer))
  "Append the constant block: a seven-quadword VIF unpack to OCEAN-TEXTURE-VU1-CONSTANTS
   whose payload ocean-texture-setup-constants writes straight into the DMA buffer.
   Returns the buffer's new base, past the 112 bytes it filled."
  (let* ((qwc 7)
         (buf dma-buf)
         (packet (the-as object (-> buf base))))
    (set! (-> (the-as dma-packet packet) dma) (new 'static 'dma-tag :id (dma-tag-id cnt) :qwc qwc))
    (set! (-> (the-as dma-packet packet) vif0) (new 'static 'vif-tag :imm #x404 :cmd (vif-cmd stcycl)))
    (set! (-> (the-as dma-packet packet) vif1)
          (new 'static 'vif-tag :imm OCEAN-TEXTURE-VU1-CONSTANTS :cmd (vif-cmd unpack-v4-32) :num qwc))
    (set! (-> buf base) (&+ (the-as pointer packet) 16)))
  (ocean-texture-setup-constants (the-as ocean-texture-constants (-> dma-buf base)))
  (let ((next-base (&+ (-> dma-buf base) 112))) (set! (-> dma-buf base) next-base) next-base))

(defun ocean-texture-add-envmap ((dma-buf dma-buffer))
  "Add DMA packet to set up the GS with the env map texture's ADGIF shader.
   The environment map is the alpha-modulated ocean envmap; the microprogram's ST
   output indexes it, so this has to reach the GS before the first strip.  Returns the
   buffer's new base, past the 112 bytes of header plus shader."
  (let ((packet-out (-> dma-buf base)))
    ;; DMA template for ADGIF setup.
    (set! (-> (the-as (pointer uint128) packet-out) 0) (-> *ocean-texture-work* adgif-tmpl dma-vif quad))
    (set! (-> (the-as (pointer uint128) packet-out) 1) (-> *ocean-texture-work* adgif-tmpl quad 1))
    (let ((shader-out (&+ packet-out 32)))
      ;; this just stores the adgif directly in the DMA buffer
      (adgif-shader<-texture-simple! (the-as adgif-shader shader-out)
                                     (get-texture environment-ocean-alphamod environment-generic))))
  (let ((next-base (&+ (-> dma-buf base) 112))) (set! (-> dma-buf base) next-base) next-base))

(defun ocean-texture-add-verts ((dma-buf dma-buffer) (rows (inline-array vector)))
  "Append one full upload batch: OCEAN-TEXTURE-BATCH-QWC quadwords referenced in place
   from rows, unpacked to quadword 0 of the double-buffered VU1 input area.  That is
   three rows of 32 vertices, colors and transposed normals interleaved.  The data is
   sent by reference, so rows must stay valid until the DMA chain has run."
  (let* ((buf dma-buf)
         (packet (the-as object (-> buf base))))
    (set! (-> (the-as dma-packet packet) dma)
          (new 'static 'dma-tag :qwc OCEAN-TEXTURE-BATCH-QWC :id (dma-tag-id ref) :addr (the-as int rows)))
    (set! (-> (the-as dma-packet packet) vif0) (new 'static 'vif-tag :imm #x404 :cmd (vif-cmd stcycl)))
    ;; imm #x8000 is quadword 0 relative to the VIF TOPS register, so consecutive
    ;; batches land in alternate halves of the input area.
    (set! (-> (the-as dma-packet packet) vif1)
          (new 'static 'vif-tag :imm #x8000 :num OCEAN-TEXTURE-BATCH-QWC :cmd (vif-cmd unpack-v4-32)))
    (let ((next-base (&+ (the-as pointer packet) 16))) (set! (-> buf base) next-base) next-base)))

(defun ocean-texture-add-verts-last ((dma-buf dma-buffer) (rows (inline-array vector)) (wrap-row (inline-array vector)))
  "Append the final upload batch as two transfers: the last two rows of the lattice
   from rows, then a copy of wrap-row - row 0 - unpacked behind them at quadword 128.
   That copy is the 33rd row, so the last strip closes the page against the first row
   and the texture tiles seamlessly in both directions."
  (let* ((buf dma-buf)
         (packet (the-as object (-> buf base))))
    (set! (-> (the-as dma-packet packet) dma)
          (new 'static 'dma-tag :qwc OCEAN-TEXTURE-TAIL-QWC :id (dma-tag-id ref) :addr (the-as int rows)))
    (set! (-> (the-as dma-packet packet) vif0) (new 'static 'vif-tag :imm #x404 :cmd (vif-cmd stcycl)))
    (set! (-> (the-as dma-packet packet) vif1)
          (new 'static 'vif-tag :imm #x8000 :num OCEAN-TEXTURE-TAIL-QWC :cmd (vif-cmd unpack-v4-32)))
    (set! (-> buf base) (&+ (the-as pointer packet) 16)))
  (let* ((buf dma-buf)
         (packet (the-as object (-> buf base))))
    (set! (-> (the-as dma-packet packet) dma)
          (new 'static 'dma-tag :qwc OCEAN-TEXTURE-WRAP-QWC :id (dma-tag-id ref) :addr (the-as int wrap-row)))
    (set! (-> (the-as dma-packet packet) vif0) (new 'static 'vif-tag :imm #x404 :cmd (vif-cmd stcycl)))
    ;; #x8080 is quadword 128 relative to TOPS: straight after the two rows above.
    (set! (-> (the-as dma-packet packet) vif1)
          (new 'static 'vif-tag :imm #x8080 :num OCEAN-TEXTURE-WRAP-QWC :cmd (vif-cmd unpack-v4-32)))
    (let ((next-base (&+ (the-as pointer packet) 16))) (set! (-> buf base) next-base) next-base)))

(defun ocean-texture-add-call-start ((dma-buf dma-buffer))
  "Start the microprogram at its entry point 0, which primes the row buffers from the
   first batch and emits the first two strips.  STMOD is cleared in the second VIF slot
   so the unpacks after it write absolute values."
  (let* ((buf dma-buf)
         (packet (the-as object (-> buf base))))
    (set! (-> (the-as dma-packet packet) dma) (new 'static 'dma-tag :id (dma-tag-id cnt)))
    (set! (-> (the-as dma-packet packet) vif0) (new 'static 'vif-tag :cmd (vif-cmd mscalf) :msk #x1))
    (set! (-> (the-as dma-packet packet) vif1) (new 'static 'vif-tag :cmd (vif-cmd stmod)))
    (set! (-> buf base) (&+ (the-as pointer packet) 16)))
  (none))

(defun ocean-texture-add-call-rest ((dma-buf dma-buffer))
  "Start the microprogram at entry point 2, the steady-state loop: consume one batch of
   three rows and emit three strips."
  (let* ((buf dma-buf)
         (packet (the-as object (-> buf base))))
    (set! (-> (the-as dma-packet packet) dma) (new 'static 'dma-tag :id (dma-tag-id cnt)))
    (set! (-> (the-as dma-packet packet) vif0) (new 'static 'vif-tag :imm #x2 :cmd (vif-cmd mscalf) :msk #x1))
    (set! (-> (the-as dma-packet packet) vif1) (new 'static 'vif-tag :cmd (vif-cmd stmod)))
    (set! (-> buf base) (&+ (the-as pointer packet) 16)))
  (none))

(defun ocean-texture-add-call-done ((dma-buf dma-buffer))
  "Start the microprogram at entry point 4, which kicks the last GIF packet still
   sitting in an output buffer and leaves VU1 idle."
  (let* ((buf dma-buf)
         (packet (the-as object (-> buf base))))
    (set! (-> (the-as dma-packet packet) dma) (new 'static 'dma-tag :id (dma-tag-id cnt)))
    (set! (-> (the-as dma-packet packet) vif0) (new 'static 'vif-tag :imm #x4 :cmd (vif-cmd mscalf) :msk #x1))
    (set! (-> (the-as dma-packet packet) vif1) (new 'static 'vif-tag :cmd (vif-cmd stmod)))
    (set! (-> buf base) (&+ (the-as pointer packet) 16)))
  (none))

(defun draw-ocean-texture ((dma-buf dma-buffer) (verts (inline-array vector)) (build-mips? symbol))
  "Render the wave lattice in verts into the 128x128 ocean texture at *ocean-base-page*.
   verts is *ocean-verts*, the buffer ocean-generate-verts filled earlier this frame;
   it is read by reference, so it must outlive the DMA chain.  build-mips? asks for the
   coarse levels to be produced as well, which only the mid pass needs.

   The chain sets the render target, uploads the microprogram, the constants and the
   environment-map shader, then pushes eleven batches of three vertex rows with a
   microprogram call after each.  Entry point 0 primes the row buffers and emits two
   strips, entry 2 emits three, and entry 4 flushes the last packet, which comes to the
   32 strips that fill the page.  Called twice per frame by draw-ocean: the ocean's VRAM
   is shared with the eye renderer, so the page has to be rebuilt in each bucket that
   samples it."
  ;; tex-page-0 is the render target for the base level; the -1 and -2 pages and the
  ;; block addresses inside them are only used by the mip-chain pass at the end.
  (let* ((first-batch verts)
         (mips? build-mips?)
         (tex-page-0 *ocean-base-page*)
         (tex-block-0 *ocean-base-block*)
         (tex-page-1 (+ tex-page-0 8))
         (tex-block-1 (* tex-page-1 32))
         (tex-page-2 (+ tex-page-0 10))
         (tex-block-2 (* tex-page-2 32)))
    (set-display-gs-state dma-buf tex-page-0 128 128 0 0)
    (dma-buffer-add-vu-function dma-buf ocean-texture-vu1-block 1)
    (let* ((buf dma-buf)
           (packet (the-as object (-> buf base))))
      (set! (-> (the-as dma-packet packet) dma) (new 'static 'dma-tag :id (dma-tag-id cnt)))
      (set! (-> (the-as dma-packet packet) vif0) (new 'static 'vif-tag :cmd (vif-cmd base)))
      (set! (-> (the-as dma-packet packet) vif1) (new 'static 'vif-tag :imm OCEAN-TEXTURE-BATCH-QWC :cmd (vif-cmd offset)))
      (set! (-> buf base) (&+ (the-as pointer packet) 16)))
    (ocean-texture-add-constants dma-buf)
    (ocean-texture-add-envmap dma-buf)
    ;; Software pipeline: the first batch is uploaded before its call so the program
    ;; always has a batch in the other half of the input buffer, and the last batch is
    ;; followed by two calls - one for its own three strips, one to flush.
    (let ((batch first-batch))
      (ocean-texture-add-verts dma-buf batch)
      (let ((next-batch (-> batch OCEAN-TEXTURE-BATCH-QWC)))
        (ocean-texture-add-call-start dma-buf)
        (let ((i 0))
          (while (< i 9)
            (ocean-texture-add-verts dma-buf (the-as (inline-array vector) next-batch))
            (set! next-batch (-> (the-as (inline-array vector) next-batch) OCEAN-TEXTURE-BATCH-QWC))
            (ocean-texture-add-call-rest dma-buf)
            (+! i 1)))
        (ocean-texture-add-verts-last dma-buf (the-as (inline-array vector) next-batch) first-batch)))
    (ocean-texture-add-call-rest dma-buf)
    (ocean-texture-add-call-done dma-buf)
    ;; Mip chain for the page just drawn.  Each level is one textured sprite that reads
    ;; the level above with bilinear filtering, so the GS does the downsampling: 128
    ;; into 64x64 alone on tex-page-1, then 32x32, 16x16, 8x8 and 4x4 packed side by
    ;; side into tex-page-2 at the block offsets the mid pass names in MIPTBP1 and
    ;; MIPTBP2.  The last levels still cover a whole 8x8-pixel block because that is the
    ;; smallest unit the GS can address.  Only the mid pass has MXL high enough to reach
    ;; past the 64x64 level, which is why draw-ocean asks for this in one of its two
    ;; calls.  The PC renderer builds the chain itself, so the whole pass is disabled
    ;; here along with the state restore below.
    ; (when mips?
    ;   (set-display-gs-state dma-buf tex-page-1 64 64 0 0)
    ;   (let* ((direct-buf dma-buf)
    ;          (direct-tag (the-as object (-> direct-buf base)))
    ;          )
    ;     (set! (-> (the-as dma-packet direct-tag) dma) (new 'static 'dma-tag :qwc #x7 :id (dma-tag-id cnt)))
    ;     (set! (-> (the-as dma-packet direct-tag) vif0) (new 'static 'vif-tag))
    ;     (set! (-> (the-as dma-packet direct-tag) vif1) (new 'static 'vif-tag :imm #x7 :cmd (vif-cmd direct) :msk #x1))
    ;     (set! (-> direct-buf base) (&+ (the-as pointer direct-tag) 16))
    ;     )
    ;   (let* ((tag-buf dma-buf)
    ;          (gif-tag-out (the-as object (-> tag-buf base)))
    ;          )
    ;     (set! (-> (the-as gs-gif-tag gif-tag-out) tag) (new 'static 'gif-tag64 :nloop #x1 :eop #x1 :nreg #x6))
    ;     (set! (-> (the-as gs-gif-tag gif-tag-out) regs)
    ;           (new 'static 'gif-tag-regs
    ;             :regs0 (gif-reg-id a+d)
    ;             :regs1 (gif-reg-id a+d)
    ;             :regs2 (gif-reg-id a+d)

;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/gfx/ocean/ocean-tables.gc")
(require "engine/gfx/background/subdivide-h.gc")
(require "engine/gfx/sky/sky-tng.gc")
(require "engine/camera/cam-interface-h.gc")

;; note: changed for high fps

;; The map for the level the camera is in.  update-ocean selects it once per frame and every
;; pass reads it from there; nothing allocates the symbol, so it only needs a type here.
;; ocean-transition is compiled after this file and refers to it as well.
(define-extern *ocean-map* ocean-map)

;; Bits of render-ocean-far's edge mask.  A set bit suppresses the far strip along that edge of
;; the map, which is how the strip behind the camera is left out.  Bit 0 is never tested.
(defconstant OCEAN_FAR_EDGE_Z_MIN 2)

(defconstant OCEAN_FAR_EDGE_Z_MAX 4)

(defconstant OCEAN_FAR_EDGE_X_MAX 8)

(defconstant OCEAN_FAR_EDGE_X_MIN 16)

;; Reciprocal of the wave-field cell size, 1 / (meters 3).  Kept as a reciprocal so converting a
;; world coordinate to wave-field cells stays a single multiply.
(defconstant OCEAN_WAVE_CELL_RECIP 0.00008138021)

;; Reciprocal of one meter, 1 / (meters 1), for measuring the swamp marker distance in meters
;; before squaring it.
(defconstant OCEAN_METER_RECIP 0.00024414062)

(defun ocean-get-height ((world-pos vector))
  "World y of the ocean surface under world-pos.  The live wave field is a 32-by-32 grid of floats
   spaced (meters 3) apart which wraps every (meters 96) - one mid-grid cell - in both x and z,
   so any world position maps into it; the four surrounding samples are bilinearly blended and
   added to the map's base height.  Returns 0.0 when no ocean map is loaded or the wave field has
   not been built yet this frame, so a caller comparing against a real y has to treat 0.0 as
   \"no answer\" rather than \"sea level\"."
  (cond
    ((and *ocean-heights* *ocean-map*)
     ;; *ocean-heights* is declared as ocean-wave-info, but the live field is a plain array of
     ;; 1024 floats, so it is indexed through an untyped pointer.
     (let* ((grid-x (* OCEAN_WAVE_CELL_RECIP (- (-> world-pos x) (-> *ocean-map* start-corner x))))
            (grid-z (* OCEAN_WAVE_CELL_RECIP (- (-> world-pos z) (-> *ocean-map* start-corner z))))
            (frac-x-in grid-x)
            (frac-x (- frac-x-in (the float (the int frac-x-in))))
            (frac-z-in grid-z)
            (frac-z (- frac-z-in (the float (the int frac-z-in))))
            (x0 (logand (the int grid-x) 31))
            (z0 (logand (the int grid-z) 31))
            (x1 (logand (+ x0 1) 31))
            (z1 (logand (+ z0 1) 31))
            (h00 (-> (the-as (pointer float) (+ (the-as uint *ocean-heights*) (* (+ (* z0 32) x0) 4)))))
            (h10 (-> (the-as (pointer float) (+ (the-as uint *ocean-heights*) (* (+ (* z0 32) x1) 4)))))
            (h01 (-> (the-as (pointer float) (+ (the-as uint *ocean-heights*) (* (+ (* z1 32) x0) 4)))))
            (h11 (-> (the-as (pointer float) (+ (the-as uint *ocean-heights*) (* (+ (* z1 32) x1) 4)))))
            (h-at-z0 (+ (* h10 frac-x) (* h00 (- 1.0 frac-x)))))
       (+ (* (+ (* h11 frac-x) (* h01 (- 1.0 frac-x))) frac-z) (* h-at-z0 (- 1.0 frac-z)) (-> *ocean-map* start-corner y))))
    (else 0.0)))

;; Persistent VU0 state for the far-ocean quads.  init-ocean-far-regs latches the combined camera
;; matrix, the homogeneous scale pair and the hvdf offset into VU0 registers, publishes the
;; camera's current pfog0 and fog clamp range through (-> *sky-tng-data* fog), and picks up the
;; ocean GIF tag prepared by init-sky-tng-data.  It has to run after the camera update and before
;; the frame's first quad.
(def-mips2c init-ocean-far-regs (function none))

;; Transform four ocean-vertex records with those registers into the clipping scratchpad, then
;; hand off to draw-large-polygon-ocean, which clips the fan against the guard hyperplanes, does
;; the perspective divide, clamps fog into the camera's range and appends the survivor to the DMA
;; buffer.  The result is #f when the quad was rejected outright, which the strip loops below use
;; as their off-screen test.
(def-mips2c render-ocean-quad (function (inline-array ocean-vertex) dma-buffer symbol))

(defun render-ocean-far ((dma-buf dma-buffer) (facing int))
  "Append the far ocean: one (meters 1440) skirt strip outside each edge of the 48-by-48 map plus
   the four corner quads that close them.  facing carries OCEAN_FAR_EDGE_* bits naming the edges
   to leave out, so the skirt behind the camera and the two corners touching it are never built.
   Skirt vertices carry pos.w of 0.0 instead of 1.0, which drops the translation row out of the
   combined camera matrix and turns them into homogeneous points at infinity along their own
   world direction.  The surface sits within a few meters of y = 0, so that direction is nearly
   horizontal and those vertices project onto the horizon: the sea appears to run all the way to
   it with four quads per edge instead of real geometry.  Each strip walks along its edge and
   stops once render-ocean-quad has accepted a quad and then rejects one."
  (local-vars
    (zmin-edge-z float)
    (zmin-phase int)
    (zmin-x-cell int)
    (zmax-horizon-z float)
    (zmax-phase int)
    (zmax-x-cell int)
    (xmin-edge-x float)
    (xmin-phase int)
    (xmax-horizon-x float)
    (xmax-phase int))
  (let* ((x-cells 48)
         (z-cells 48)
         (start-x (-> *ocean-map* start-corner x))
         (surface-y (-> *ocean-map* start-corner y))
         (start-z (-> *ocean-map* start-corner z))
         (end-z (+ start-z (* (meters 96) (the float z-cells))))
         (end-x (+ start-x (* (meters 96) (the float x-cells))))
         (vertices (-> (scratchpad-object terrain-context) work background dma-area ocean-vertex)))
    (let ((drawn? #f))
      0
      ;; Every far quad is flat shaded with the map's single far color.
      (set! (-> vertices 0 col quad) (-> *ocean-map* far-color quad))
      (set! (-> vertices 1 col quad) (-> *ocean-map* far-color quad))
      (set! (-> vertices 2 col quad) (-> *ocean-map* far-color quad))
      (set! (-> vertices 3 col quad) (-> *ocean-map* far-color quad))
      ;; The two z strips are one cell wide and fifteen texture repeats deep.
      (set-vector! (-> vertices 0 stq) 0.0 0.0 1.0 1.0)
      (set-vector! (-> vertices 1 stq) 1.0 0.0 1.0 1.0)
      (set-vector! (-> vertices 2 stq) 1.0 15.0 1.0 1.0)
      (set-vector! (-> vertices 3 stq) 0.0 15.0 1.0 1.0)
      (when (zero? (logand facing OCEAN_FAR_EDGE_Z_MIN))
        (let ((zmin-horizon-z (+ (meters -1440) start-z)))
          (set! zmin-edge-z start-z)
          (let ((any-drawn? #f))
            (set! zmin-phase 0)
            (set! zmin-x-cell 0)
            (while (< zmin-x-cell x-cells)
              (let ((x0 (+ (* (meters 96) (the float zmin-x-cell)) start-x)))
                (let ((x1 (+ (meters 96) x0)))
                  (let ((vert0 (-> vertices 0)))
                    (set! (-> vert0 pos x) x0)
                    (set! (-> vert0 pos y) surface-y)
                    (set! (-> vert0 pos z) zmin-horizon-z)
                    (set! (-> vert0 pos w) 0.0))
                  (let ((vert1 (-> vertices 1)))
                    (set! (-> vert1 pos x) x1)
                    (set! (-> vert1 pos y) surface-y)
                    (set! (-> vert1 pos z) zmin-horizon-z)
                    (set! (-> vert1 pos w) 0.0))
                  (let ((vert2 (-> vertices 2)))
                    (set! (-> vert2 pos x) x1)
                    (set! (-> vert2 pos y) surface-y)
                    (set! (-> vert2 pos z) zmin-edge-z)
                    (set! (-> vert2 pos w) 1.0)))
                (let ((vert3 (-> vertices 3)))
                  (set! (-> vert3 pos x) x0)
                  (set! (-> vert3 pos y) surface-y)
                  (set! (-> vert3 pos z) zmin-edge-z)
                  (set! (-> vert3 pos w) 1.0)))
              ;; Advances with the strip, but nothing reads it.
              (set! zmin-phase (logand (+ zmin-phase 1) 7))
              (set! drawn? (render-ocean-quad vertices dma-buf))
              (cond
                (drawn? (set! any-drawn? #t))
                (else (if any-drawn? (goto cfg-10))))
              (set! zmin-x-cell (+ zmin-x-cell 1))))))
      (label cfg-10)
      (when (zero? (logand facing OCEAN_FAR_EDGE_Z_MAX))
        (let ((zmax-edge-z end-z))
          (set! zmax-horizon-z (+ (meters 1440) zmax-edge-z))
          (let ((any-drawn? #f))
            (set! zmax-phase 0)
            (set! zmax-x-cell 0)
            (while (< zmax-x-cell x-cells)
              (let ((x0 (+ (* (meters 96) (the float zmax-x-cell)) start-x)))
                (let ((x1 (+ (* (meters 96) (the float (+ zmax-x-cell 1))) start-x)))
                  (let ((vert0 (-> vertices 0)))
                    (set! (-> vert0 pos x) x0)
                    (set! (-> vert0 pos y) surface-y)
                    (set! (-> vert0 pos z) zmax-edge-z)
                    (set! (-> vert0 pos w) 1.0))
                  (let ((vert1 (-> vertices 1)))
                    (set! (-> vert1 pos x) x1)
                    (set! (-> vert1 pos y) surface-y)
                    (set! (-> vert1 pos z) zmax-edge-z)
                    (set! (-> vert1 pos w) 1.0))
                  (let ((vert2 (-> vertices 2)))
                    (set! (-> vert2 pos x) x1)
                    (set! (-> vert2 pos y) surface-y)
                    (set! (-> vert2 pos z) zmax-horizon-z)
                    (set! (-> vert2 pos w) 0.0)))
                (let ((vert3 (-> vertices 3)))
                  (set! (-> vert3 pos x) x0)
                  (set! (-> vert3 pos y) surface-y)
                  (set! (-> vert3 pos z) zmax-horizon-z)
                  (set! (-> vert3 pos w) 0.0)))
              (set! zmax-phase (logand (+ zmax-phase 1) 7))
              ;; drawn? is not refreshed here, so the test below still sees the last quad of the
              ;; -z strip and this strip always walks all of its cells.  Same in the two x strips.
              (render-ocean-quad vertices dma-buf)
              (cond
                (drawn? (set! any-drawn? #t))
                (else (if any-drawn? (goto cfg-20))))
              (set! zmax-x-cell (+ zmax-x-cell 1))))))
      (label cfg-20)
      ;; The x strips run the other way, so the repeat count moves to s.
      (set-vector! (-> vertices 0 stq) 0.0 0.0 1.0 1.0)
      (set-vector! (-> vertices 1 stq) 15.0 0.0 1.0 1.0)
      (set-vector! (-> vertices 2 stq) 15.0 1.0 1.0 1.0)
      (set-vector! (-> vertices 3 stq) 0.0 1.0 1.0 1.0)
      (when (zero? (logand facing OCEAN_FAR_EDGE_X_MIN))
        (let ((xmin-horizon-x (+ (meters -1440) start-x)))
          (set! xmin-edge-x start-x)
          (let ((any-drawn? #f))
            (set! xmin-phase 0)
            (dotimes (z-cell z-cells)
              (let* ((z0 (+ (* (meters 96) (the float z-cell)) start-z))
                     (z1 (+ (meters 96) z0)))
                (let ((vert0 (-> vertices 0)))
                  (set! (-> vert0 pos x) xmin-horizon-x)
                  (set! (-> vert0 pos y) surface-y)
                  (set! (-> vert0 pos z) z0)
                  (set! (-> vert0 pos w) 0.0))
                (let ((vert1 (-> vertices 1)))
                  (set! (-> vert1 pos x) xmin-edge-x)
                  (set! (-> vert1 pos y) surface-y)
                  (set! (-> vert1 pos z) z0)
                  (set! (-> vert1 pos w) 1.0))
                (let ((vert2 (-> vertices 2)))
                  (set! (-> vert2 pos x) xmin-edge-x)
                  (set! (-> vert2 pos y) surface-y)
                  (set! (-> vert2 pos z) z1)
                  (set! (-> vert2 pos w) 1.0))
                (let ((vert3 (-> vertices 3)))
                  (set! (-> vert3 pos x) xmin-horizon-x)
                  (set! (-> vert3 pos y) surface-y)
                  (set! (-> vert3 pos z) z1)
                  (set! (-> vert3 pos w) 0.0)))
              (set! xmin-phase (logand (+ xmin-phase 1) 7))
              ;; Result dropped, as in the +z strip.
              (render-ocean-quad vertices dma-buf)
              (cond
                (drawn? (set! any-drawn? #t))
                (else (if any-drawn? (goto cfg-30))))))))
      (label cfg-30)
      (when (zero? (logand facing OCEAN_FAR_EDGE_X_MAX))
        (let ((xmax-edge-x end-x))
          (set! xmax-horizon-x (+ (meters 1440) end-x))
          (let ((any-drawn? #f))
            (set! xmax-phase 0)
            (dotimes (z-cell z-cells)
              (let* ((z0 (+ (* (meters 96) (the float z-cell)) start-z))
                     (z1 (+ (meters 96) z0)))
                (let ((vert0 (-> vertices 0)))
                  (set! (-> vert0 pos x) xmax-edge-x)
                  (set! (-> vert0 pos y) surface-y)
                  (set! (-> vert0 pos z) z0)
                  (set! (-> vert0 pos w) 1.0))
                (let ((vert1 (-> vertices 1)))
                  (set! (-> vert1 pos x) xmax-horizon-x)
                  (set! (-> vert1 pos y) surface-y)
                  (set! (-> vert1 pos z) z0)
                  (set! (-> vert1 pos w) 0.0))
                (let ((vert2 (-> vertices 2)))
                  (set! (-> vert2 pos x) xmax-horizon-x)
                  (set! (-> vert2 pos y) surface-y)
                  (set! (-> vert2 pos z) z1)
                  (set! (-> vert2 pos w) 0.0))
                (let ((vert3 (-> vertices 3)))
                  (set! (-> vert3 pos x) xmax-edge-x)
                  (set! (-> vert3 pos y) surface-y)
                  (set! (-> vert3 pos z) z1)
                  (set! (-> vert3 pos w) 1.0)))
              (set! xmax-phase (logand (+ xmax-phase 1) 7))
              ;; Result dropped, as in the +z strip.
              (render-ocean-quad vertices dma-buf)
              (cond
                (drawn? (set! any-drawn? #t))
                (else (if any-drawn? (goto cfg-40)))))))))
    (label cfg-40)
    ;; Each corner quad joins the two skirts that meet there.  It has exactly one vertex at the
    ;; map corner and three on the horizon, and is skipped whenever either of its strips was.
    (set-vector! (-> vertices 0 stq) 0.0 0.0 1.0 1.0)
    (set-vector! (-> vertices 1 stq) 15.0 0.0 1.0 1.0)
    (set-vector! (-> vertices 2 stq) 15.0 15.0 1.0 1.0)
    (set-vector! (-> vertices 3 stq) 0.0 15.0 1.0 1.0)
    (when (not (or (logtest? facing OCEAN_FAR_EDGE_Z_MIN) (logtest? facing OCEAN_FAR_EDGE_X_MIN)))
      (let ((horizon-x (+ (meters -1440) start-x))
            (horizon-z (+ (meters -1440) start-z))
            (edge-x start-x)
            (edge-z start-z))
        (let ((vert0 (-> vertices 0)))
          (set! (-> vert0 pos x) horizon-x)
          (set! (-> vert0 pos y) surface-y)
          (set! (-> vert0 pos z) horizon-z)
          (set! (-> vert0 pos w) 0.0))
        (let ((vert1 (-> vertices 1)))
          (set! (-> vert1 pos x) edge-x)
          (set! (-> vert1 pos y) surface-y)
          (set! (-> vert1 pos z) horizon-z)
          (set! (-> vert1 pos w) 0.0))
        (let ((vert2 (-> vertices 2)))
          (set! (-> vert2 pos x) edge-x)
          (set! (-> vert2 pos y) surface-y)
          (set! (-> vert2 pos z) edge-z)
          (set! (-> vert2 pos w) 1.0))
        (let ((vert3 (-> vertices 3)))
          (set! (-> vert3 pos x) horizon-x)
          (set! (-> vert3 pos y) surface-y)
          (set! (-> vert3 pos z) edge-z)
          (set! (-> vert3 pos w) 0.0)))
      (render-ocean-quad vertices dma-buf))
    (when (not (or (logtest? facing OCEAN_FAR_EDGE_Z_MIN) (logtest? facing OCEAN_FAR_EDGE_X_MAX)))
      (let ((edge-x end-x))
        (let ((horizon-z (+ (meters -1440) start-z))
              (horizon-x (+ (meters 1440) end-x)))
          (let ((vert0 (-> vertices 0)))
            (set! (-> vert0 pos x) edge-x)
            (set! (-> vert0 pos y) surface-y)
            (set! (-> vert0 pos z) horizon-z)
            (set! (-> vert0 pos w) 0.0))
          (let ((vert1 (-> vertices 1)))
            (set! (-> vert1 pos x) horizon-x)
            (set! (-> vert1 pos y) surface-y)
            (set! (-> vert1 pos z) horizon-z)
            (set! (-> vert1 pos w) 0.0))
          (let ((vert2 (-> vertices 2)))
            (set! (-> vert2 pos x) horizon-x)
            (set! (-> vert2 pos y) surface-y)
            (set! (-> vert2 pos z) start-z)
            (set! (-> vert2 pos w) 0.0)))
        (let ((vert3 (-> vertices 3)))
          (set! (-> vert3 pos x) edge-x)
          (set! (-> vert3 pos y) surface-y)
          (set! (-> vert3 pos z) start-z)
          (set! (-> vert3 pos w) 1.0)))
      (render-ocean-quad vertices dma-buf))
    (when (not (or (logtest? facing OCEAN_FAR_EDGE_Z_MAX) (logtest? facing OCEAN_FAR_EDGE_X_MIN)))
      (let ((horizon-x (+ (meters -1440) start-x))
            (edge-z end-z)
            (horizon-z (+ (meters 1440) end-z)))
        (let ((vert0 (-> vertices 0)))
          (set! (-> vert0 pos x) horizon-x)
          (set! (-> vert0 pos y) surface-y)
          (set! (-> vert0 pos z) edge-z)
          (set! (-> vert0 pos w) 0.0))
        (let ((vert1 (-> vertices 1)))
          (set! (-> vert1 pos x) start-x)
          (set! (-> vert1 pos y) surface-y)
          (set! (-> vert1 pos z) edge-z)
          (set! (-> vert1 pos w) 1.0))
        (let ((vert2 (-> vertices 2)))
          (set! (-> vert2 pos x) start-x)
          (set! (-> vert2 pos y) surface-y)
          (set! (-> vert2 pos z) horizon-z)
          (set! (-> vert2 pos w) 0.0))
        (let ((vert3 (-> vertices 3)))
          (set! (-> vert3 pos x) horizon-x)
          (set! (-> vert3 pos y) surface-y)
          (set! (-> vert3 pos z) horizon-z)
          (set! (-> vert3 pos w) 0.0)))
      (render-ocean-quad vertices dma-buf))
    (when (not (or (logtest? facing OCEAN_FAR_EDGE_Z_MAX) (logtest? facing OCEAN_FAR_EDGE_X_MAX)))
      (let ((edge-x end-x)
            (edge-z end-z)
            (horizon-x (+ (meters 1440) end-x))
            (horizon-z (+ (meters 1440) end-z)))
        (let ((vert0 (-> vertices 0)))
          (set! (-> vert0 pos x) edge-x)
          (set! (-> vert0 pos y) surface-y)
          (set! (-> vert0 pos z) edge-z)
          (set! (-> vert0 pos w) 1.0))
        (let ((vert1 (-> vertices 1)))
          (set! (-> vert1 pos x) horizon-x)
          (set! (-> vert1 pos y) surface-y)
          (set! (-> vert1 pos z) edge-z)
          (set! (-> vert1 pos w) 0.0))
        (let ((vert2 (-> vertices 2)))
          (set! (-> vert2 pos x) horizon-x)
          (set! (-> vert2 pos y) surface-y)
          (set! (-> vert2 pos z) horizon-z)
          (set! (-> vert2 pos w) 0.0))
        (let ((vert3 (-> vertices 3)))
          (set! (-> vert3 pos x) edge-x)
          (set! (-> vert3 pos y) surface-y)
          (set! (-> vert3 pos z) horizon-z)
          (set! (-> vert3 pos w) 0.0)))
      (render-ocean-quad vertices dma-buf)))
  (none))

(define *swamp-low-ocean-marker* (new 'global 'vector))

;; The swamp's water sits just under its walkways rather than at the level's nominal sea level.
;; draw-ocean lowers start-corner y whenever the camera is within 200 meters of this point.
(set-vector! *swamp-low-ocean-marker* (meters 640) 0.0 (meters -1990) 1.0)

(defun draw-ocean-far ((dma-buf dma-buffer))
  "Build the far-ocean DIRECT packet.  One qword is reserved for the DMA/VIF tag, the skirt and
   corner quads are emitted for the current *ocean-facing* quadrant, the large-polygon stream is
   terminated, and the reserved tag is then backfilled with the qword count actually produced."
  (init-ocean-far-regs)
  (if *debug-segment*
    (add-frame (-> *display* frames (-> *display* on-screen) frame profile-bar 0)
               'draw
               (new 'static 'rgba :r #x40 :b #x40 :a #x80)))
  (let ((tag-start (the-as object (-> dma-buf base))))
    (&+! (-> dma-buf base) 16)
    ;; Leave out the skirt along the edge the camera has its back to.  OCEAN_FACING_Z_MIN is zero.
    (let ((facing *ocean-facing*))
      (cond
        ((zero? facing) (render-ocean-far dma-buf OCEAN_FAR_EDGE_Z_MAX))
        ((= facing OCEAN_FACING_Z_MAX) (render-ocean-far dma-buf OCEAN_FAR_EDGE_Z_MIN))
        ((= facing OCEAN_FACING_X_MIN) (render-ocean-far dma-buf OCEAN_FAR_EDGE_X_MAX))
        ((= facing OCEAN_FACING_X_MAX) (render-ocean-far dma-buf OCEAN_FAR_EDGE_X_MIN))))
    (close-sky-buffer dma-buf)
    (let ((qwc (/ (the-as int (+ (- -16 (the-as int tag-start)) (the-as int (-> dma-buf base)))) 16)))
      (set! (-> (the-as dma-packet tag-start) dma) (new 'static 'dma-tag :id (dma-tag-id cnt) :qwc qwc))
      (set! (-> (the-as dma-packet tag-start) vif0) (new 'static 'vif-tag))
      (set! (-> (the-as dma-packet tag-start) vif1) (new 'static 'vif-tag :cmd (vif-cmd direct) :msk #x1 :imm qwc))))
  (if *debug-segment*
    (add-frame (-> *display* frames (-> *display* on-screen) frame profile-bar 0) 'draw (new 'static 'rgba :g #xff :a #x80))))

(defun ocean-init-buffer ((dma-buf dma-buffer))
  "Set the GS state shared by the far and mid passes: alpha test and depth test always pass, an
   ordinary source-alpha blend, and the six-level 128-by-128 ocean texture.  The mip chain sits
   immediately after the base image in the special VRAM region, so its block addresses are
   computed from *ocean-base-page* rather than stored anywhere.  TEXA's ta0 is raised to 128 for
   the run of ocean drawing; ocean-end-buffer puts it back.  Returns the advanced buffer cursor."
  (let* ((base-page *ocean-base-page*)
         (base-block *ocean-base-block*)
         ;; A 128-by-128 32-bit image is 8 GS pages, so level 1 begins 8 pages in.  Levels 1
         ;; through 6 need 64 + 16 + 4 + 1 + 1 + 1 blocks, which fits in the two pages after
         ;; that, putting level 2 and everything below it in the page at page + 10.
         (mip1-block (* (+ base-page 8) 32))
         (mip2-block (* (+ base-page 10) 32)))
    (let* ((buf dma-buf)
           (chain-tag (the-as object (-> buf base))))
      (set! (-> (the-as dma-packet chain-tag) dma) (new 'static 'dma-tag :qwc #xa :id (dma-tag-id cnt)))
      (set! (-> (the-as dma-packet chain-tag) vif0) (new 'static 'vif-tag))
      (set! (-> (the-as dma-packet chain-tag) vif1) (new 'static 'vif-tag :imm #xa :cmd (vif-cmd direct) :msk #x1))
      (set! (-> buf base) (the-as pointer (&+ (the-as dma-packet chain-tag) 16))))
    (let* ((buf dma-buf)
           (giftag (the-as object (-> buf base))))
      (set! (-> (the-as gs-gif-tag giftag) tag) (new 'static 'gif-tag64 :nloop #x1 :eop #x1 :nreg #x9))
      (set! (-> (the-as gs-gif-tag giftag) regs)
            (new 'static
                 'gif-tag-regs
                 :regs0 (gif-reg-id a+d)
                 :regs1 (gif-reg-id a+d)
                 :regs2 (gif-reg-id a+d)
                 :regs3 (gif-reg-id a+d)
                 :regs4 (gif-reg-id a+d)
                 :regs5 (gif-reg-id a+d)
                 :regs6 (gif-reg-id a+d)
                 :regs7 (gif-reg-id a+d)
                 :regs8 (gif-reg-id a+d)
                 :regs9 (gif-reg-id a+d)
                 :regs10 (gif-reg-id a+d)
                 :regs11 (gif-reg-id a+d)
                 :regs12 (gif-reg-id a+d)
                 :regs13 (gif-reg-id a+d)
                 :regs14 (gif-reg-id a+d)
                 :regs15 (gif-reg-id a+d)))
      (set! (-> buf base) (&+ (the-as pointer giftag) 16)))
    (let* ((buf dma-buf)
           (ad-data (-> buf base)))
      (set! (-> (the-as (pointer gs-test) ad-data) 0)
            (new 'static 'gs-test :ate #x1 :atst (gs-atest always) :zte #x1 :ztst (gs-ztest always)))
      (set! (-> (the-as (pointer gs-reg64) ad-data) 1) (gs-reg64 test-1))
      (set! (-> (the-as (pointer gs-alpha) ad-data) 2) (new 'static 'gs-alpha :b #x1 :d #x1))
      (set! (-> (the-as (pointer gs-reg64) ad-data) 3) (gs-reg64 alpha-1))
      (set! (-> (the-as (pointer gs-tex0) ad-data) 4)
            (new 'static 'gs-tex0 :tbw #x2 :th (log2 128) :tw (log2 128) :tbp0 base-block))
      (set! (-> (the-as (pointer gs-reg64) ad-data) 5) (gs-reg64 tex0-1))
      (set! (-> (the-as (pointer gs-tex1) ad-data) 6) (new 'static 'gs-tex1 :mxl #x6 :mmag #x1 :mmin #x4 :l #x1 :k #xeed))
      (set! (-> (the-as (pointer gs-reg64) ad-data) 7) (gs-reg64 tex1-1))
      ;; Both texture alpha expansion values are 128: the ocean texture's alpha bit selects
      ;; between two half-transparent levels, not between opaque and invisible.
      (set! (-> (the-as (pointer gs-texa) ad-data) 8) (new 'static 'gs-texa :ta0 #x80 :ta1 #x80))
      (set! (-> (the-as (pointer gs-reg64) ad-data) 9) (gs-reg64 texa))
      (set! (-> (the-as (pointer gs-miptbp) ad-data) 10)
            (new 'static 'gs-miptbp :tbw1 #x1 :tbw2 #x1 :tbw3 #x1 :tbp3 (+ mip2-block 16) :tbp2 mip2-block :tbp1 mip1-block))
      (set! (-> (the-as (pointer gs-reg64) ad-data) 11) (gs-reg64 miptbp1-1))
      ;; Levels 4, 5 and 6 are one block each.
      (set! (-> (the-as (pointer gs-miptbp) ad-data) 12)
            (new 'static
                 'gs-miptbp
                 :tbw1 #x1
                 :tbw2 #x1
                 :tbw3 #x1
                 :tbp3
                 (+ mip2-block 22)
                 :tbp2
                 (+ mip2-block 21)
                 :tbp1
                 (+ mip2-block 20)))
      (set! (-> (the-as (pointer gs-reg64) ad-data) 13) (gs-reg64 miptbp2-1))
      (set! (-> (the-as (pointer gs-clamp) ad-data) 14) (new 'static 'gs-clamp))
      (set! (-> (the-as (pointer gs-reg64) ad-data) 15) (gs-reg64 clamp-1))
      (set! (-> (the-as (pointer gs-fogcol) ad-data) 16) (the-as gs-fogcol *fog-color*))
      (set! (-> (the-as (pointer gs-reg64) ad-data) 17) (gs-reg64 fogcol))
      (let ((next-base (&+ ad-data 144))) (set! (-> buf base) next-base) next-base))))

(defun ocean-end-buffer ((dma-buf dma-buffer))
  "Undo ocean-init-buffer's TEXA override so later renderers get the usual expansion, where a
   texture alpha bit of 0 means fully transparent.  Returns the advanced buffer cursor."
  (let* ((buf dma-buf)
         (chain-tag (the-as object (-> buf base))))
    (set! (-> (the-as dma-packet chain-tag) dma) (new 'static 'dma-tag :qwc #x2 :id (dma-tag-id cnt)))
    (set! (-> (the-as dma-packet chain-tag) vif0) (new 'static 'vif-tag))
    (set! (-> (the-as dma-packet chain-tag) vif1) (new 'static 'vif-tag :imm #x2 :cmd (vif-cmd direct) :msk #x1))
    (set! (-> buf base) (&+ (the-as pointer chain-tag) 16)))
  (let* ((buf dma-buf)
         (giftag (the-as object (-> buf base))))
    (set! (-> (the-as gs-gif-tag giftag) tag) (new 'static 'gif-tag64 :nloop #x1 :eop #x1 :nreg #x1))
    (set! (-> (the-as gs-gif-tag giftag) regs)
          (new 'static
               'gif-tag-regs
               :regs0 (gif-reg-id a+d)
               :regs1 (gif-reg-id a+d)
               :regs2 (gif-reg-id a+d)
               :regs3 (gif-reg-id a+d)
               :regs4 (gif-reg-id a+d)
               :regs5 (gif-reg-id a+d)
               :regs6 (gif-reg-id a+d)
               :regs7 (gif-reg-id a+d)
               :regs8 (gif-reg-id a+d)
               :regs9 (gif-reg-id a+d)
               :regs10 (gif-reg-id a+d)
               :regs11 (gif-reg-id a+d)
               :regs12 (gif-reg-id a+d)
               :regs13 (gif-reg-id a+d)
               :regs14 (gif-reg-id a+d)
               :regs15 (gif-reg-id a+d)))
    (set! (-> buf base) (&+ (the-as pointer giftag) 16)))
  (let* ((buf dma-buf)
         (ad-data (-> buf base)))
    (set! (-> (the-as (pointer gs-texa) ad-data) 0) (new 'static 'gs-texa :ta1 #x80))
    (set! (-> (the-as (pointer gs-reg64) ad-data) 1) (gs-reg64 texa))
    (let ((next-base (&+ ad-data 16))) (set! (-> buf base) next-base) next-base)))

;; Per-lane gain applied to the three VU light colors and the ambient before ocean-generate-verts
;; lights the wave vertices.  x is half the other lanes, so the water's lighting is biased away
;; from red.  On PC these four floats live in a global instead of as literal data beside the
;; function that reads them.
;; og:preserve-this PC Port hack
(define *ocean-generate-verts-vector* (new 'global 'vector))

(set-vector! *ocean-generate-verts-vector*
             (the-as float #x42800000)
             (the-as float #x43000000)
             (the-as float #x43000000)
             (the-as float #x43000000))

(defun draw-ocean ()
  "Build this frame's ocean.  The wave field and the displaced near-grid vertices are allocated
   out of the frame's global DMA buffer and regenerated from the current phase, the surface height
   is chosen from where the camera is, and then two chains are appended: the texture, far and mid
   passes go into the ocean-mid-and-far bucket, and the texture and near passes into ocean-near.
   The near chain is dropped when the camera is more than (meters 48) from the surface in y, since
   none of the fine grid would be visible.  The three off switches are debug overrides and clear
   themselves at the end of every unpaused frame."
  (set! *ocean-heights* #f)
  (set! *ocean-verts* (the-as (inline-array vector) #f))
  ;; 4 KiB of wave field followed by 32 KiB of near-grid vertices.  Both stay in this frame's
  ;; global buffer and are read back by DMA, so nothing may be appended between them.
  (let ((frame-buf (-> *display* frames (-> *display* on-screen) frame global-buf)))
    (set! *ocean-heights* (the-as ocean-wave-info (-> frame-buf base)))
    (ocean-interp-wave *ocean-heights*
                       (the uint (* (/ (-> *display* time-factor) 5.0) (-> *display* integral-frame-counter)))) ;; og:preserve-this changed for high fps
    (&+! (-> frame-buf base) 4096)
    (set! *ocean-verts* (the-as (inline-array vector) (-> frame-buf base)))
    (ocean-generate-verts *ocean-verts* *ocean-heights*)
    (&+! (-> frame-buf base) #x8000))
  (when *ocean-map*
    ;; Choose the surface height: just under the swamp walkways when close to their marker, at the
    ;; map's nominal level when the camera is above the deep-water threshold or a movie is running,
    ;; and (meters 24) down otherwise, which is the water line seen from inside the sunken city.
    (let* ((cam-pos (camera-pos))
           (marker *swamp-low-ocean-marker*)
           (dist-x (* OCEAN_METER_RECIP (- (-> cam-pos x) (-> marker x))))
           (dist-x-sq (* dist-x dist-x))
           (dist-z (* OCEAN_METER_RECIP (- (-> cam-pos z) (-> marker z)))))
      (cond
        ;; 200 meters, squared.
        ((< (+ dist-x-sq (* dist-z dist-z)) 40000.0) (set! (-> *ocean-map* start-corner y) (meters -1)))
        ((or (< (meters -100) (-> cam-pos y)) (movie?)) (set! (-> *ocean-map* start-corner y) 0.0))
        (else (set! (-> *ocean-map* start-corner y) (meters -24)))))
    (when (not *ocean-off*)
      (when (logtest? *vu1-enable-user* (vu1-renderer-mask ocean))
        (let* ((mid-buf (-> *display* frames (-> *display* on-screen) frame global-buf))
               (mid-chain-start (-> mid-buf base)))
          (draw-ocean-texture mid-buf *ocean-verts* #t)
          (ocean-init-buffer mid-buf)
          (draw-ocean-far mid-buf)
          (when (not *ocean-mid-off*)
            (draw-ocean-mid mid-buf))
          (ocean-end-buffer mid-buf)
          (let ((mid-chain-end (-> mid-buf base)))
            (let ((next-tag (the-as object (-> mid-buf base))))
              (set! (-> (the-as dma-packet next-tag) dma) (new 'static 'dma-tag :id (dma-tag-id next)))
              (set! (-> (the-as dma-packet next-tag) vif0) (new 'static 'vif-tag))
              (set! (-> (the-as dma-packet next-tag) vif1) (new 'static 'vif-tag))
              (set! (-> mid-buf base) (&+ (the-as pointer next-tag) 16)))
            (dma-bucket-insert-tag (-> *display* frames (-> *display* on-screen) frame bucket-group)
                                   (bucket-id ocean-mid-and-far)
                                   mid-chain-start
                                   (the-as (pointer dma-tag) mid-chain-end))))
        ;; The near grid is only worth building from close to the surface, and it inherits the mid
        ;; grid's suppression masks, so it also goes away when the mid grid is off.
        (when (not (or *ocean-near-off* (or *ocean-mid-off* (< (meters 48) (fabs (-> *math-camera* trans y))))))
          (let* ((near-buf (-> *display* frames (-> *display* on-screen) frame global-buf))
                 (near-chain-start (-> near-buf base)))
            (draw-ocean-texture near-buf *ocean-verts* #f)
            (draw-ocean-near near-buf)
            (ocean-end-buffer near-buf)
            (let ((near-chain-end (-> near-buf base)))
              (let ((next-tag (the-as object (-> near-buf base))))
                (set! (-> (the-as dma-packet next-tag) dma) (new 'static 'dma-tag :id (dma-tag-id next)))
                (set! (-> (the-as dma-packet next-tag) vif0) (new 'static 'vif-tag))
                (set! (-> (the-as dma-packet next-tag) vif1) (new 'static 'vif-tag))
                (set! (-> near-buf base) (&+ (the-as pointer next-tag) 16)))
              (dma-bucket-insert-tag (-> *display* frames (-> *display* on-screen) frame bucket-group)
                                     (bucket-id ocean-near)
                                     near-chain-start
                                     (the-as (pointer dma-tag) near-chain-end))))))))
  (when (not (paused?))
    (set! *ocean-off* #f)
    (set! *ocean-mid-off* #f)
    (set! *ocean-near-off* #f))
  0
  (none))

(defun update-ocean ()
  "Choose the ocean map and the camera-facing quadrant for this frame.  Every active level gets a
   say: an explicit 'none stops the search and leaves no ocean, but only when the camera is inside
   that level's meta geometry and not inside its neighbor's, and any level naming a map wins, with
   later levels overriding earlier ones.  Below (meters -100) the sunken variant replaces whatever
   was chosen, since that is the same water seen from underneath.  *ocean-facing* is set from the
   dominant axis of the camera's forward vector and selects which far strip draw-ocean-far leaves
   out."
  (set! *ocean-map* #f)
  (dotimes (i (-> *level* length))
    (let ((lev (-> *level* level i)))
      (when (= (-> lev status) 'active)
        (let ((ocean-sym (-> lev info ocean)))
          (cond
            ((= ocean-sym 'none)
             (when (and (-> lev meta-inside?) (not (-> lev other meta-inside?)))
               (set! *ocean-map* #f)
               (goto cfg-19)))
            ;; The level info holds the map's name; the symbol's value is the map itself.
            ((and ocean-sym (nonzero? (-> ocean-sym value))) (set! *ocean-map* (the-as ocean-map (-> ocean-sym value)))))))))
  (label cfg-19)
  (if (and *ocean-map* (< (-> *math-camera* trans y) (meters -100))) (set! *ocean-map* *ocean-map-sunken*))
  (let ((cam-forward (new 'stack-no-clear 'vector)))
    (set! (-> cam-forward quad) (-> (matrix-local->world #f #f) vector 2 quad))
    (cond
      ((< (fabs (-> cam-forward z)) (fabs (-> cam-forward x)))
       (if (< (-> cam-forward x) 0.0) (set! *ocean-facing* OCEAN_FACING_X_MIN) (set! *ocean-facing* OCEAN_FACING_X_MAX)))
      ((< (-> cam-forward z) 0.0) (set! *ocean-facing* OCEAN_FACING_Z_MIN) 0)
      (else (set! *ocean-facing* OCEAN_FACING_Z_MAX))))
  0
  (none))

;; The four corners of the unit texture square, in the corner order the weight tables use: s and
;; t in x and y, and q = 1.0 in z for the perspective divide.  Uploaded beside the four corner
;; colors so a cell's texture coordinates interpolate exactly like its positions;
;; ocean-trans-add-upload-table blends these down to a quarter-cell, while
;; ocean-trans-add-upload-strip and ocean-mid-add-upload-table pass them through unchanged.
(define *ocean-trans-st-table*
  (new 'static
       'inline-array
       vector
       4
       (new 'static 'vector :z 1.0)
       (new 'static 'vector :x 1.0 :z 1.0)
       (new 'static 'vector :y 1.0 :z 1.0)
       (new 'static 'vector :x 1.0 :y 1.0 :z 1.0)))

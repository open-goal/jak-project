;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "kernel/gcommon.gc")

;; Foreground lighting has two representations.  light-group is the editable EE
;; form; vu-lights is its transposed, tightly packed VU input.  The light volumes
;; aren't used - foreground lighting is pretty simple.

;; DECOMP BEGINS

;; Three directional lights plus ambient color in the layout consumed by merc and
;; generic VU programs.  direction is transposed: its three vectors contain the
;; x, y, and z components of all three light directions.
;; The w component isn't used for light and can hold magic flags for renderers.
(deftype vu-lights (structure)
  ((direction vector 3 :inline)
   (color     vector 3 :inline)
   (ambient   vector :inline)))

;; One editable directional light.  level scales its contribution; sort-level is
;; working state used while choosing and ordering a light kit.
(deftype light (structure)
  ((direction  vector :inline)
   (color      rgbaf :inline)
   (levels     vector :inline)
   (level      float :overlay-at (-> levels x))
   (sort-level float :overlay-at (-> levels y))))

;; Legacy spatial light record.  The matrix's w lanes hold name, decay policy,
;; ambient/point balance, and intensity beside the transform columns.  func-symbol
;; and func share the color alpha slot while the callback name is being resolved.
(deftype light-ellipse (structure)
  ((matrix              matrix :inline)
   (color               rgbaf :inline)
   (name                basic :overlay-at (-> matrix data 3))
   (decay-start         float :overlay-at (-> matrix data 7))
   (ambient-point-ratio float :overlay-at (-> matrix data 11))
   (level               float :overlay-at (-> matrix data 15))
   (func-symbol         basic :overlay-at (-> color a))
   (func                basic :overlay-at (-> color a))))

;; Collection of spatial lights.
(deftype light-array (array) ())

;; A bounded region referring to the lights that apply inside it.
(deftype light-volume (basic)
  ((light-array light-array)))

;; Spherical light-volume bound.
(deftype light-volume-sphere (light-volume)
  ((bsphere sphere :inline)))

;; Light-volume bound by four vertical planes.
(deftype light-volume-planes (light-volume)
  ((planes vertical-planes)))

;; Legacy collection of spatial light volumes.
(deftype light-volume-array (array) ())

(defmethod print ((this light))
  (format #t
          "#<light [~F] ~F ~F ~F  "
          (-> this levels x)
          (-> this direction x)
          (-> this direction y)
          (-> this direction z))
  (format #t "~F ~F ~F @ #x~X>" (-> this color x) (-> this color y) (-> this color z) this)
  this)

;; Primary editable light kit: three directional contributions and one ambient
;; contribution.  lights is the indexed view of the same four inline records.
(deftype light-group (structure)
  ((dir0   light :inline)
   (dir1   light :inline)
   (dir2   light :inline)
   (ambi   light :inline)
   (lights light 4 :inline :overlay-at dir0)))

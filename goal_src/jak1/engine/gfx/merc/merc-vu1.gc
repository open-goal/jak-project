;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "kernel-defs.gc")

;; PC rendering does not execute the VU1 program in merc-vu1-program.gc, but the DMA-list builder
;; still needs a valid object while constructing the otherwise compatible MERC upload chain.
(#when PC_PORT
  (define merc-vu1-block (new 'static 'vu-function)))

        (label mat2-pipeline-05)
        (label mat2-resume-b)
        (vu-pair (lqi.xyzw clr-c lump-ptr) (add.xyzw pos-b pos-b pos-mtx-3)) ;; #x1a1
        (vu-pair (lqi.xyzw tex-c lump-ptr) (maxw.w pos-a pos-a light-dir-1)) ;; #x1a2

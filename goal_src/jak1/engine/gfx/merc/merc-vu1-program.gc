        (vu-pair (nop) (ftoi4.xyzw xyzf-out pos-b)) ;; #x10a
        (label mat1-pipeline-08)
        (vu-pair (mfp.w rlength P) (maddz.xyz clr-a nrm-mtx-2 tex-a)) ;; #x10b
        (vu-pair (sq.xyzw tex-b dst-b 0) (miniy.xyzw clr-b clr-b vtx-bias-0)) ;; #x10c

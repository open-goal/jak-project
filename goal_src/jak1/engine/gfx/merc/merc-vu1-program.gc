        (vu-pair (nop) (nop)) ;; #x6cc
        (vu-pair (nop) (mulax.xyzw ACC light-color-0 clr-c)) ;; #x6cd
        (vu-pair (ibgtz vtx-flags finish-mat1-pipeline-05) (madday.xyzw ACC light-color-1 clr-c)) ;; #x6ce

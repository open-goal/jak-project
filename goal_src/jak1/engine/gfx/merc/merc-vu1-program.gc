        (vu-pair (lq.xyzw nrm-mtx-2 mtx-ptr 6) (maddaz.xyzw ACC light-color-2 clr-c)) ;; #x125
        (vu-pair (nop) (addx.w xyzf-out xyzf-out vtx-bias-0)) ;; #x126
        (label mat1-pipeline-10)
        (vu-pair (lq.xyzw pos-mtx-0 mtx-ptr 0) (maddw.xyzw clr-c light-ambient vf00)) ;; #x127

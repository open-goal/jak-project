        (vu-pair (nop) (addx.w xyzf-out xyzf-out vtx-bias-0)) ;; #x6d0
        (label finish-mat1-pipeline-05)
        (vu-pair (nop) (maddw.xyzw clr-c light-ambient vf00)) ;; #x6d1
        (vu-pair (ilw.x vtx-flags lump-ptr -3) (itof0.xyzw pos-mtx-0 pos-mtx-0)) ;; #x6d2
        (vu-pair (nop) (itof0.xyzw pos-mtx-1 pos-mtx-1)) ;; #x6d3
        (vu-pair (nop) (ftoi4.xyzw xyzf-out xyzf-out)) ;; #x6d4

        (vu-pair (iand dst2-b dst2-b index-mask) (maddaz.xyzw ACC light-color-2 clr-c)) ;; #x670
        (vu-pair (nop) (addx.w xyzf-out xyzf-out vtx-bias-0)) ;; #x671
        (label mercprime-pipeline-57)

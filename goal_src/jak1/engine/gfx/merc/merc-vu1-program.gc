        (vu-pair (ibne vi00 dst2-c mercprime-pipeline-11) (mulaw.xyzw ACC pos-mtx-0 pos-b)) ;; #x196
        (vu-pair (ilw.y vtx-flags lump-ptr -6) (mulw.xyzw clr-a clr-a rlength)) ;; #x197
        (vu-pair (erleng.xyz P clr-b) (nop)) ;; #x198
        (vu-pair (ibeq mat2-end color-ptr mat3-pipeline-04) (maddaw.xyzw ACC pos-mtx-1 clr-b)) ;; #x199
        (vu-pair (mr32.z tex-b vf00) (maddw.xyzw pos-b pos-mtx-2 tex-b)) ;; #x19a
        (vu-pair (lqi.xyzw pos-c lump-ptr) (mulax.xyzw ACC light-dir-0 clr-a)) ;; #x19b
        (vu-pair (jr mtx-ptr) (madday.xyzw ACC light-dir-1 clr-a)) ;; #x19c

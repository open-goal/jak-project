        (vu-pair (sq.xyzw xyzf-out dst-c 2) (nop)) ;; #x6d8
        (vu-pair (nop) (ftoi4.xyzw xyzf-out pos-c)) ;; #x6d9
        (label finish-mat1-pipeline-06)
        (vu-pair (ibne samecopy-end copy-ptr finish-mat1-pipeline-07) (nop)) ;; #x6da
        (vu-pair (sq.xyzw tex-c dst-c 0) (miniy.xyzw clr-c clr-c vtx-bias-0)) ;; #x6db
        (vu-pair (ior samecopy-end crosscopy-end vi00) (max.xyzw pos-mtx-0 pos-mtx-1 pos-mtx-1)) ;; #x6dc
        (label finish-mat1-pipeline-07)
        (vu-pair (sq.xyzw tex-c dst2-c 0) (nop)) ;; #x6dd
        (vu-pair (sq.xyzw xyzf-out dst2-c 2) (nop)) ;; #x6de
        (vu-pair (lqi.xyzw pos-mtx-2 copy-ptr) (nop)) ;; #x6df
        (vu-pair (nop) (ftoi0.xyzw clr-c clr-c)) ;; #x6e0
        (vu-pair (nop) (nop)) ;; #x6e1
        (vu-pair (nop) (nop)) ;; #x6e2
        (vu-pair (nop) (itof0.xyzw pos-mtx-2 pos-mtx-2)) ;; #x6e3
        (vu-pair (sq.xyzw clr-c dst-c 1) (nop)) ;; #x6e4
        (vu-pair (b copy-vertices) (nop)) ;; #x6e5
        (vu-pair (sq.xyzw clr-c dst2-c 1) (nop)) ;; #x6e6
        (label finish-mat1-pipeline-08)
        (vu-pair (3072.0) (miniw.w pos-c pos-c light-dir-0 :i)) ;; #x6e7

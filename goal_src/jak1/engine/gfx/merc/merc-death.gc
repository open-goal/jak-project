;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/gfx/sprite/sparticle/sparticle-launcher.gc")

;; DECOMP BEGINS

(define *merc-death-globals* (new 'global 'vector))

;; Settings for the dissolving MERC death effect. During the effect, MERC samples vertices at
;; vertex-skip intervals and launches effect particles from their transformed positions. Ordinary
;; triangles remain visible for overlap elapsed ticks before the dissolve takes over completely.
(deftype death-info (basic)
  ((vertex-skip uint16) ;; vertex sampling stride
   (timer       uint8) ;; duration before time-factor scaling
   (overlap     uint8) ;; initial triangle/particle overlap
   (effect      uint32) ;; particle launcher id
   (sound       symbol))) ;; optional death sound

(defun birth-func-death-sparks ()
  "No-op birth callback for death-spark particles."
  0
  (none))

(define death-beach-puppy
  (new 'static 'death-info :vertex-skip #x82 :timer #x4b :overlap #x4 :effect #x29 :sound 'temp-enemy-die))

(define death-jungle-snake
  (new 'static 'death-info :vertex-skip #xa :timer #x4b :overlap #x4 :effect #x29 :sound 'temp-enemy-die))

(define death-default
  (new 'static 'death-info :vertex-skip #x50 :timer #x4b :overlap #x4 :effect #x29 :sound 'temp-enemy-die))

(define death-warp-in (new 'static 'death-info :vertex-skip #x96 :timer #x4b :effect #x29 :sound 'warpgate-tele))

(define death-warp-out (new 'static 'death-info :vertex-skip #x96 :timer #x96 :effect #x29 :sound 'warpgate-tele))

(defpart 41
  :init-specs
  ((:scale-x (meters 0.5))
   (:scale-y :copy scale-x)
   (:r 64.0 32.0)
   (:g 16.0 32.0)
   (:b 48.0 32.0)
   (:a 48.0 48.0)
   (:vel-y (meters 0) (meters 0.006666667))
   (:scalevel-x (meters -0.0016666667))
   (:scalevel-y (meters 0.02))
   (:accel-y (meters -0.00066666666))
   (:timer (seconds 0.4))
   (:flags (die-when-faded glow use-time-of-day-color))
   (:next-time (seconds 0.05) (seconds 0.197))
   (:next-launcher 42)))

(defpart 42
  :init-specs ((:fade-a -1.4222223) (:timer (seconds 0.15)) (:next-time (seconds 0.14)) (:next-launcher 43)))

(defpart 43
  :init-specs ((:scalevel-x (meters 0)) (:fade-a -0.21333334) (:timer (seconds 0) (seconds 0.987))))

(defun merc-death-spawn ((effect-id int) (position vector) (surface-normal vector))
  "Launch the death particle selected by effect-id at position when that part-table entry is a
   particle launcher. surface-normal is reserved for the sampled MERC normal and is currently unused."
  (let ((launcher (-> *part-id-table* effect-id)))
    (if (and (nonzero? launcher) (= (-> launcher type) sparticle-launcher))
      (sp-launch-particles-death *sp-particle-system-2d* launcher position)))
  0
  (none))

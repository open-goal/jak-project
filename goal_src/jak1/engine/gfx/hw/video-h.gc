;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "kernel-defs.gc")

;; Video parameters describe the PAL/NTSC display geometry and aspect-ratio correction. Timing is
;; handled separately. The interlaced frame buffer stores one half-height field at a time.

;; DECOMP BEGINS

(deftype video-parms (structure)
  ((set-video-mode              basic)
   (reset-video-mode            basic)
   (screen-sy                   int32)
   (screen-hy                   int32)
   (screen-miny                 int32)
   (screen-maxy                 int32)
   (screen-masky                int32)
   (display-dx                  int32)
   (display-dy                  int32)
   (screen-pages-high           int32)
   (_pad                        int64)
   (relative-x-scale            float)
   (relative-y-scale            float)
   (_pad2                       int64)
   (relative-x-scale-reciprical float)
   (relative-y-scale-reciprical float)))

;; Default NTSC display geometry. Unspecified fields, including the y reciprocal, begin at zero and
;; are filled when the video system selects its mode and aspect ratio.
(define *video-parms*
  (new 'static
       'video-parms
       :set-video-mode #f
       :reset-video-mode #f
       :screen-sy 224
       :screen-hy 112
       :screen-miny 1824
       :screen-maxy 2272
       :screen-masky #xdf
       :display-dx 0
       :display-dy 8
       :screen-pages-high 7
       :relative-x-scale 1.0
       :relative-y-scale 1.0
       :relative-x-scale-reciprical 1.0))

(define-extern get-video-mode (function symbol))

(define-extern get-aspect-ratio (function symbol))

(define-extern set-hud-aspect-ratio (function symbol symbol none))

(define-extern set-aspect-ratio (function symbol none))

(define-extern set-video-mode (function symbol none))

(defmacro correct-x-int (pos)
  "Scale an integer horizontal coordinate for the active aspect ratio."
  `(the int (* (-> *video-parms* relative-x-scale) (the float ,pos))))

;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/gfx/hw/display.gc")
(require "engine/gfx/depth-cue-h.gc")

;; DECOMP BEGINS

(define *depth-cue-work*
  (new 'static
       'depth-cue-work
       :texture-strip-tmpl
       (new 'static
            'dma-gif-packet
            :dma-vif
            (new 'static
                 'dma-packet
                 :dma
                 (new 'static 'dma-tag :qwc #x6 :id (dma-tag-id cnt))
                 :vif1
                 (new 'static 'vif-tag :imm #x6 :cmd (vif-cmd direct) :msk #x1))
            :gif0
            (new 'static
                 'gif-tag64
                 :nloop 1
                 :eop 1
                 :pre 1
                 ;; Textured, alpha-blended sprite using fixed UV coordinates.
                 :prim
                 (new 'static 'gs-prim :prim (gs-prim-type sprite) :tme #x1 :abe #x1 :fst #x1)
                 :nreg 5)
            :gif1
            (new 'static
                 'gif-tag-regs
                 :regs0 (gif-reg-id rgbaq)
                 :regs1 (gif-reg-id uv)
                 :regs2 (gif-reg-id xyzf2)
                 :regs3 (gif-reg-id uv)
                 :regs4 (gif-reg-id xyzf2)))
       :temp-strip-tmpl
       (new 'static
            'dma-gif-packet
            :dma-vif
            (new 'static
                 'dma-packet
                 :dma
                 (new 'static 'dma-tag :qwc #x6 :id (dma-tag-id cnt))
                 :vif1
                 (new 'static 'vif-tag :imm #x6 :cmd (vif-cmd direct) :msk #x1))
            :gif0
            (new 'static
                 'gif-tag64
                 :nloop 1
                 :eop 1
                 :pre 1
                 ;; Textured copy sprite using fixed UV coordinates.
                 :prim (new 'static 'gs-prim :prim (gs-prim-type sprite) :tme #x1 :fst #x1)
                 :nreg 5)
            :gif1
            (new 'static
                 'gif-tag-regs
                 :regs0 (gif-reg-id rgbaq)
                 :regs1 (gif-reg-id uv)
                 :regs2 (gif-reg-id xyzf2)
                 :regs3 (gif-reg-id uv)
                 :regs4 (gif-reg-id xyzf2)))
       :stencil-tmpl
       (new 'static
            'dma-gif-packet
            :dma-vif
            (new 'static
                 'dma-packet
                 :dma
                 (new 'static 'dma-tag :qwc #x17 :id (dma-tag-id cnt))
                 :vif1
                 (new 'static 'vif-tag :imm #x17 :cmd (vif-cmd direct) :msk #x1))
            ;; Each of the two GIF loops begins with RGBAQ and draws five adjacent sprites.
            :gif0
            (new 'static
                 'gif-tag64
                 :nloop #x2
                 :eop #x1
                 :pre #x1
                 :prim (new 'static 'gs-prim :prim (gs-prim-type sprite))
                 :nreg #xb)
            :gif1
            (new 'static
                 'gif-tag-regs
                 :regs0 (gif-reg-id rgbaq)
                 :regs1 (gif-reg-id xyzf2)
                 :regs2 (gif-reg-id xyzf2)
                 :regs3 (gif-reg-id xyzf2)
                 :regs4 (gif-reg-id xyzf2)
                 :regs5 (gif-reg-id xyzf2)
                 :regs6 (gif-reg-id xyzf2)
                 :regs7 (gif-reg-id xyzf2)
                 :regs8 (gif-reg-id xyzf2)
                 :regs9 (gif-reg-id xyzf2)
                 :regs10 (gif-reg-id xyzf2)))
       :set-color
       (new 'static 'vector4w :x #x80 :y #x80 :z #x80 :w #x80)
       :draw-color
       (new 'static 'vector4w :x #x84 :y #x84 :z #x84 :w #x80)
       :depth
       (new 'static 'depth-cue-data :data (new 'static 'vector :x 1.0 :z 163840.0))
       :front
       (new 'static 'depth-cue-data :data (new 'static 'vector :x 0.999 :y 0.4 :z 4096.0 :w 1.0))))

(defun depth-cue-set-stencil ((dma-buf dma-buffer) (framebuffer-page int) (depth int) (field-offset int) (color vector4w))
  "Append ten 64-pixel sprites which write color only to the destination alpha channel where the
   existing depth passes greater-equal. framebuffer-page is a GS framebuffer base page, depth is a
   GS 24-bit depth value, field-offset is in GS sixteenth-pixel units, and color supplies the
   RGBAQ qword repeated before each group of five sprites."
  (let* ((packet-buffer dma-buf)
         (direct-packet (the-as dma-packet (-> packet-buffer base))))
    (set! (-> direct-packet dma) (new 'static 'dma-tag :qwc #x4 :id (dma-tag-id cnt)))
    (set! (-> direct-packet vif0) (new 'static 'vif-tag))
    (set! (-> direct-packet vif1) (new 'static 'vif-tag :imm #x4 :cmd (vif-cmd direct) :msk #x1))
    (set! (-> packet-buffer base) (&+ (the-as pointer direct-packet) 16)))
  (dma-buffer-add-gif-tag dma-buf (new 'static 'gif-tag64 :nloop #x1 :eop #x1 :nreg #x3) GIF_REGS_ALL_AD)
  (let* ((state-buffer dma-buf)
         (state-out (-> state-buffer base)))
    (set! (-> (the-as (pointer gs-xy-offset) state-out) 0)
          (new 'static 'gs-xy-offset :ofx #x7000 :ofy (+ (* (-> *video-parms* screen-miny) 16) field-offset)))
    (set! (-> (the-as (pointer gs-reg64) state-out) 1) (gs-reg64 xyoffset-1))
    (set! (-> (the-as (pointer gs-frame) state-out) 2) (new 'static 'gs-frame :fbw #x8 :fbmsk #xffffff :fbp framebuffer-page))
    (set! (-> (the-as (pointer gs-reg64) state-out) 3) (gs-reg64 frame-1))
    (set! (-> (the-as (pointer gs-test) state-out) 4) (new 'static 'gs-test :zte #x1 :ztst (gs-ztest greater-equal)))
    (set! (-> (the-as (pointer gs-reg64) state-out) 5) (gs-reg64 test-1))
    (set! (-> state-buffer base) (&+ state-out 48)))
  (let ((packet-data (the-as (inline-array vector4w) (-> dma-buf base)))
        (x #x7000)
        (sprite-width 1024))
    (set! (-> packet-data 0 quad) (-> *depth-cue-work* stencil-tmpl dma-vif quad))
    (set! (-> packet-data 1 quad) (-> *depth-cue-work* stencil-tmpl quad 1))
    (let ((cursor (&-> packet-data 2)))
      (dotimes (i 2)
        (set! (-> cursor 0 quad) (-> color quad))
        (set! cursor (&-> cursor 1))
        (dotimes (j 5)
          (set-vector! (-> cursor 0) x (* (-> *video-parms* screen-miny) 16) depth 0)
          (set-vector! (-> cursor 1) (+ x sprite-width) (* (-> *video-parms* screen-maxy) 16) depth #x10000)
          (+! x sprite-width)
          (set! cursor (&-> cursor 2))))
      (set! (-> dma-buf base) (the-as pointer cursor))
      (the-as vector4w cursor))))

(defun depth-cue-draw-depth ((dma-buf dma-buffer) (depth int) (sharpness float) (alpha float) (on-screen-fbp uint) (field-offset int))
  "Append the sixteen-strip depth-cue filter at depth, applying the filtered RGB only where the
   destination-alpha stencil is set. sharpness scales each temporary strip, alpha controls the
   blend strength, on-screen-fbp is the GS framebuffer base page, and field-offset is in GS
   sixteenth-pixel units."
  (set! (-> *depth-cue-work* draw-color w) (the int (* 128.0 alpha)))
  (let ((scaled-width (the int (* 512.0 sharpness)))
        (scaled-height (the int (* (the float (* (-> *video-parms* screen-sy) 16)) sharpness)))
        (x-offset 0)
        (strip-width 512)
        (temp-fbp *depth-cue-base-page*))
    (dotimes (i 16)
      ;; Shrink one 32-pixel framebuffer strip into the temporary page. Expanding it again below
      ;; lets bilinear filtering blend neighboring samples.
      (let* ((packet-buffer dma-buf)
             (direct-packet (the-as dma-packet (-> packet-buffer base))))
        (set! (-> direct-packet dma) (new 'static 'dma-tag :qwc #x5 :id (dma-tag-id cnt)))
        (set! (-> direct-packet vif0) (new 'static 'vif-tag))
        (set! (-> direct-packet vif1) (new 'static 'vif-tag :imm #x5 :cmd (vif-cmd direct) :msk #x1))
        (set! (-> packet-buffer base)
              (the-as pointer (the-as gs-gif-tag (&+ (the-as pointer direct-packet) 16)))))
      (let* ((tag-buffer dma-buf)
             (gif-tag (the-as gs-gif-tag (-> tag-buffer base))))
        (set! (-> gif-tag tag) (new 'static 'gif-tag64 :nloop #x1 :eop #x1 :nreg #x4))
        (set! (-> gif-tag regs) GIF_REGS_ALL_AD)
        (set! (-> tag-buffer base) (&+ (the-as pointer gif-tag) 16)))
      (let* ((state-buffer dma-buf)
             (state-out (-> state-buffer base)))
        (set! (-> (the-as (pointer gs-xy-offset) state-out) 0)
              (new 'static 'gs-xy-offset :ofy (- 8 field-offset)))
        (set! (-> (the-as (pointer gs-reg64) state-out) 1) (gs-reg64 xyoffset-1))
        (set! (-> (the-as (pointer gs-frame) state-out) 2)
              (new 'static 'gs-frame :fbw #x1 :fbp temp-fbp))
        (set! (-> (the-as (pointer gs-reg64) state-out) 3) (gs-reg64 frame-1))
        (set! (-> (the-as (pointer gs-tex0) state-out) 4)
              (new 'static
                   'gs-tex0
                   :tbw #x8
                   :tw #xa
                   :th #x8
                   :tcc #x1
                   :tbp0 (* on-screen-fbp 32)))
        (set! (-> (the-as (pointer gs-reg64) state-out) 5) (gs-reg64 tex0-1))
        (set! (-> (the-as (pointer gs-test) state-out) 6)
              (new 'static 'gs-test :zte #x1 :ztst (gs-ztest always)))
        (set! (-> (the-as (pointer gs-reg64) state-out) 7) (gs-reg64 test-1))
        (set! (-> state-buffer base) (&+ state-out 64)))
      (let ((temp-strip (the-as (inline-array vector4w) (-> dma-buf base))))
        (set! (-> temp-strip 0 quad) (-> *depth-cue-work* temp-strip-tmpl dma-vif quad))
        (set! (-> temp-strip 1 quad) (-> *depth-cue-work* temp-strip-tmpl quad 1))
        (set! (-> temp-strip 2 quad) (-> *depth-cue-work* set-color quad))
        (set-vector! (-> temp-strip 3) x-offset 0 0 0)
        (set-vector! (-> temp-strip 4) 0 0 0 0)
        (set-vector! (-> temp-strip 5)
                     (+ x-offset strip-width)
                     (* (-> *video-parms* screen-sy) 16)
                     0
                     0)
        (set-vector! (-> temp-strip 6) scaled-width scaled-height 0 #x10000))
      (set! (-> dma-buf base)
            (the-as pointer (-> (the-as depth-cue-work (-> dma-buf base)) set-color)))

      ;; Expand the filtered strip over its original screen column. FBMSK preserves destination
      ;; alpha, and DATE admits only pixels marked by depth-cue-set-stencil.
      (let* ((packet-buffer dma-buf)
             (direct-packet (the-as dma-packet (-> packet-buffer base))))
        (set! (-> direct-packet dma) (new 'static 'dma-tag :qwc #x5 :id (dma-tag-id cnt)))
        (set! (-> direct-packet vif0) (new 'static 'vif-tag))
        (set! (-> direct-packet vif1) (new 'static 'vif-tag :imm #x5 :cmd (vif-cmd direct) :msk #x1))
        (set! (-> packet-buffer base) (&+ (the-as pointer direct-packet) 16)))
      (let* ((tag-buffer dma-buf)
             (gif-tag (the-as gs-gif-tag (-> tag-buffer base))))
        (set! (-> gif-tag tag) (new 'static 'gif-tag64 :nloop #x1 :eop #x1 :nreg #x4))
        (set! (-> gif-tag regs) GIF_REGS_ALL_AD)
        (set! (-> tag-buffer base) (&+ (the-as pointer gif-tag) 16)))
      (let* ((state-buffer dma-buf)
             (state-out (-> state-buffer base)))
        (set! (-> (the-as (pointer gs-xy-offset) state-out) 0)
              (new 'static 'gs-xy-offset :ofy (+ field-offset 4)))
        (set! (-> (the-as (pointer gs-reg64) state-out) 1) (gs-reg64 xyoffset-1))
        (set! (-> (the-as (pointer gs-frame) state-out) 2)
              (new 'static
                   'gs-frame
                   :fbw #x8
                   :fbmsk #xff000000
                   :fbp on-screen-fbp))
        (set! (-> (the-as (pointer gs-reg64) state-out) 3) (gs-reg64 frame-1))
        (set! (-> (the-as (pointer gs-tex0) state-out) 4)
              (new 'static
                   'gs-tex0
                   :tbw #x1
                   :tw #x5
                   :th #x8
                   :tcc #x1
                   :tbp0 (* temp-fbp 32)))
        (set! (-> (the-as (pointer gs-reg64) state-out) 5) (gs-reg64 tex0-1))
        (set! (-> (the-as (pointer gs-test) state-out) 6)
              (new 'static 'gs-test :date #x1 :datm #x1 :zte #x1 :ztst (gs-ztest always)))
        (set! (-> (the-as (pointer gs-reg64) state-out) 7) (gs-reg64 test-1))
        (set! (-> state-buffer base) (&+ state-out 64)))
      (let ((texture-strip (the-as (inline-array vector4w) (-> dma-buf base))))
        (set! (-> texture-strip 0 quad) (-> *depth-cue-work* texture-strip-tmpl dma-vif quad))
        (set! (-> texture-strip 1 quad) (-> *depth-cue-work* texture-strip-tmpl quad 1))
        (set! (-> texture-strip 2 quad) (-> *depth-cue-work* draw-color quad))
        (set-vector! (-> texture-strip 3) 0 0 0 0)
        (set-vector! (-> texture-strip 4) x-offset 0 0 0)
        (set-vector! (-> texture-strip 5) scaled-width scaled-height 0 0)
        (set-vector! (the-as vector4w (&+ (the-as pointer texture-strip) 96))
                     (+ x-offset strip-width)
                     (* (-> *video-parms* screen-sy) 16)
                     depth
                     #x10000))
      (set! (-> dma-buf base)
            (the-as pointer (-> (the-as depth-cue-work (-> dma-buf base)) set-color)))
      (+! x-offset strip-width)))
  #f)

(defun depth-cue-draw-front ((dma-buf dma-buffer) (depth int) (sharpness float) (alpha float) (on-screen-fbp uint) (field-offset int))
  "Append the sixteen-strip full-screen depth-cue filter to dma-buf. Each 32-pixel source strip is
   scaled by sharpness into temporary VRAM, then expanded and alpha-blended back into
   on-screen-fbp at the supplied GS depth. field-offset is the interlaced-field offset in GS
   sixteenth-pixel units."
  ;; Set the blend strength for the filtered strips.
  (set! (-> *depth-cue-work* draw-color w) (the int (* 128.0 alpha)))
  ;; sample the framebuffer in 16 vertical strips shrinking each a little,
  ;; then overlay them back onto the framebuffer
  (let ((scaled-width (the int (* 512.0 sharpness)))
        (scaled-height (the int (* (the float (* (-> *video-parms* screen-sy) 16)) sharpness)))
        (x-offset 0) ;; incremented by 512 each loop
        (strip-width 512))
    ;; repeat for each strip
    (dotimes (i 16)
      ;; sample strip from framebuffer to depth-cue-base-page
      ;; ------------------------------------------------------
      ;; update GS registers
      (dma-buffer-add-gs-set dma-buf
                             ;; set vertex position offset
                             (xyoffset-1 (new 'static 'gs-xy-offset :ofy (- 8 field-offset)))
                             ;; draw to depth-cue-base-page (64px wide)
                             (frame-1 (new 'static 'gs-frame :fbw #x1 :fbp *depth-cue-base-page*))
                             ;; use on-screen framebuffer as texture 0
                             ;; buffer width = 512 pixels
                             ;; USIZE = 1024 texels
                             ;; VSIZE = 256 texels
                             ;; RGBA
                             (tex0-1 (new 'static 'gs-tex0 :tbw #x8 :tw #xa :th #x8 :tcc #x1 :tbp0 (* on-screen-fbp 32)))
                             ;; enable depth test, all pixels pass
                             (test-1 (new 'static 'gs-test :zte #x1 :ztst (gs-ztest always)))
                             ;; keep source rgb, no blending
                             (alpha-1 (new 'static 'gs-alpha)))
      ;; draw sprite
      (let ((temp-strip (the-as (inline-array vector4w) (-> dma-buf base))))
        (set! (-> temp-strip 0 quad) (-> *depth-cue-work* temp-strip-tmpl dma-vif quad)) ;; cnt direct
        (set! (-> temp-strip 1 quad) (-> *depth-cue-work* temp-strip-tmpl quad 1)) ;; draw sprite, 5 regs
        (set! (-> temp-strip 2 quad) (-> *depth-cue-work* set-color quad)) ;; rgbaq
        (set-vector! (-> temp-strip 3) x-offset 0 0 0) ;; uv
        (set-vector! (-> temp-strip 4) 0 0 0 0) ;; xyzf2
        (set-vector! (-> temp-strip 5) (+ x-offset strip-width) (* (-> *video-parms* screen-sy) 16) 0 0) ;; uv
        (set-vector! (-> temp-strip 6) scaled-width scaled-height 0 #x10000) ;; xyzf2
        )
      (&+! (-> dma-buf base) 112)
      ;; overlay strip back onto the on-screen framebuffer
      ;; ------------------------------------------------------
      ;; update GS registers
      (dma-buffer-add-gs-set dma-buf
                             ;; set vertex position offset
                             (xyoffset-1 (new 'static 'gs-xy-offset :ofy (+ field-offset 4)))
                             ;; draw RGB to on-screen-fbp while preserving its alpha stencil
                             (frame-1 (new 'static 'gs-frame :fbw #x8 :fbmsk #xff000000 :fbp on-screen-fbp))
                             ;; supply alpha 128 when sampling the 24-bit temporary texture
                             (texa (new 'static 'gs-texa :ta0 #x80 :ta1 #x80))
                             ;; use depth-cue-base-page as texture 0
                             ;; buffer width = 64 pixels
                             ;; format = PSMCT24
                             ;; USIZE = 32 texels
                             ;; VSIZE = 256 texels
                             ;; RGB
                             (tex0-1 (new 'static 'gs-tex0 :tbw #x1 :psm #x1 :tw #x5 :th #x8 :tbp0 (* *depth-cue-base-page* 32)))
                             ;; blend source and framebuffer RGB
                             (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1)))
      ;; draw sprite
      (let ((texture-strip (the-as (inline-array vector4w) (-> dma-buf base))))
        (set! (-> texture-strip 0 quad) (-> *depth-cue-work* texture-strip-tmpl dma-vif quad))
        (set! (-> texture-strip 1 quad) (-> *depth-cue-work* texture-strip-tmpl quad 1))
        (set! (-> texture-strip 2 quad) (-> *depth-cue-work* draw-color quad)) ;; rgbaq
        (set-vector! (-> texture-strip 3) 0 0 0 0) ;; uv
        (set-vector! (-> texture-strip 4) x-offset 0 0 0) ;; xyzf2
        (set-vector! (-> texture-strip 5) scaled-width scaled-height 0 0) ;; uv
        (set-vector! ;; xyzf2
          (the-as vector4w (&+ (the-as pointer texture-strip) 96))
          (+ x-offset strip-width)
          (* (-> *video-parms* screen-sy) 16)
          depth
          #x10000))
      (&+! (-> dma-buf base) 112)
      ;; next strip
      ;; ------------------------------------------------------
      (+! x-offset strip-width)))
  #f)

(defun depth-cue-calc-z ((camera-z float))
  "Convert a nonzero camera-space Z distance to GS 24-bit depth using the active perspective
   projection and viewport depth offset."
  (+ (* (+ (* camera-z (-> *math-camera* perspective vector 2 z)) (-> *math-camera* perspective vector 3 z))
        (/ (-> *math-camera* d) camera-z))
     (-> *math-camera* hvdf-off z)))

(defun depth-cue ((disp display))
  "Append the enabled full-screen depth-cue postprocess to display's current DMA buffer, restore
   the GS framebuffer state, insert the chain into the depth-cue bucket, and record its DMA usage.
   Return the inserted bucket tag, or false when the renderer is disabled."
  ;; is depth-cue enabled?
  (when (logtest? (vu1-renderer-mask depth-cue) *vu1-enable-user*)
    (let* ((dma-start (-> *display* frames (-> *display* on-screen) frame global-buf base))
           (dma-buf (-> *display* frames (-> *display* on-screen) frame global-buf))
           (chain-start (-> dma-buf base)))
      (let ((screen-index (-> disp on-screen)))
        ;; initial GS register setup
        (dma-buffer-add-gs-set dma-buf
                               ;; depth test on, all pixels pass
                               (test-1 (new 'static 'gs-test :zte #x1 :ztst (gs-ztest always)))
                               ;; don't write to depth buffer
                               (zbuf-1 (new 'static 'gs-zbuf :zbp #x1c0 :psm (gs-psm ct24) :zmsk #x1))
                               ;; bilinear texture sampling
                               (tex1-1 (new 'static 'gs-tex1 :mmag 1 :mmin 1))
                               ;; no mip
                               (miptbp1-1 (new 'static 'gs-miptbp))
                               ;; set texture wrap mode to clamp
                               (clamp-1 (new 'static
                                             'gs-clamp
                                             :wms (gs-tex-wrap-mode clamp)
                                             :wmt (gs-tex-wrap-mode clamp)
                                             :maxu #x1ff
                                             :maxv (-> *video-parms* screen-masky)))
                               ;; blend source and dest
                               (alpha-1 (new 'static 'gs-alpha :b 1 :d 1)))
        (let ((field-offset (* *oddeven* 8))
              (on-screen-fbp (-> disp frames screen-index draw frame1 fbp)))
          ;; draw
          (depth-cue-draw-front dma-buf
                                #xffffff ;; depth
                                (-> *depth-cue-work* front data x) ;; sharpness
                                (-> *depth-cue-work* front data y) ;; alpha
                                on-screen-fbp ;; on-screen frame pointer
                                field-offset) ;; oddeven * 8
          ;; restore GS registers
          (dma-buffer-add-gs-set dma-buf
                                 ;; restore xyoffset register
                                 (xyoffset-1 (new 'static 'gs-xy-offset :ofx #x7000 :ofy (+ (* (-> *video-parms* screen-miny) 16) field-offset)))
                                 ;; restore drawing destination to on-screen framebuffer
                                 (frame-1 (new 'static 'gs-frame :fbw #x8 :fbp on-screen-fbp)))))
      (let ((chain-tail (-> dma-buf base)))
        ;; add DMA chain
        (let ((next-packet (the-as object (-> dma-buf base))))
          (set! (-> (the-as dma-packet next-packet) dma) (new 'static 'dma-tag :id (dma-tag-id next)))
          (set! (-> (the-as dma-packet next-packet) vif0) (new 'static 'vif-tag))
          (set! (-> (the-as dma-packet next-packet) vif1) (new 'static 'vif-tag))
          (set! (-> dma-buf base) (&+ (the-as pointer next-packet) 16)))
        (let ((bucket-tag (dma-bucket-insert-tag (-> *display* frames (-> *display* on-screen) frame bucket-group)
                                           (bucket-id depth-cue)
                                           chain-start
                                           (the-as (pointer dma-tag) chain-tail))))
          ;; record memory usage
          (let ((usage *dma-mem-usage*))
            (when (nonzero? usage)
              (set! (-> usage length) (max 84 (-> usage length)))
              (set! (-> usage data 83 name) "depth-cue")
              (+! (-> usage data 83 count) 1)
              (+! (-> usage data 83 used)
                  (&- (-> *display* frames (-> *display* on-screen) frame global-buf base) (the-as uint dma-start)))
              (set! (-> usage data 83 total) (-> usage data 83 used))))
          bucket-tag)))))

            (vu-pair (sq.xyzw clr-2 dest-ptr 1) (addx.w tex-3 tex-3 gifbuf)) ;; #x1c6
            (vu-pair (sq.xyzw res-02 dest-ptr 2) (mul.xyz pos-13 pos-13 Q)) ;; #x1c7
            (vu-pair (sq.xyzw tex-2 dest2-ptr 0) (mul.xyz tex-3 tex-3 Q)) ;; #x1c8
            (vu-pair (sq.xyzw clr-2 dest2-ptr 1) (nop)) ;; #x1c9
            (vu-pair (sq.xyzw res-02 dest2-ptr 2) (nop)) ;; #x1ca
            (vu-pair (mtir dest-ptr vtx-3.w) (ftoi4.xyz res-13 pos-13)) ;; #x1cb
            (vu-pair (mtir dest2-ptr tex-3.w) (nop)) ;; #x1cc
            (vu-pair (sq.xyzw tex-3 dest-ptr 0) (nop)) ;; #x1cd

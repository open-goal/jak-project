            (vu-pair (0.5) (nop :i)) ;; #x27f
            (vu-pair (lqi.xyz xyzofs point-ptr) (addi.y morph vf00 I)) ;; #x280
            (vu-pair (lqi.xyzw tex-2 point-ptr) (nop)) ;; #x281
            (vu-pair (mtir ind0 inds.x) (addx.w xyzofs xyzofs gifbuf)) ;; #x282
            (vu-pair (mtir ind1 inds.y) (nop)) ;; #x283
            (vu-pair (mtir ind2 inds.z) (mulx.xyz vtx-2 vtx-2 morph)) ;; #x284
            (vu-pair (nop) (nop)) ;; #x285
            (vu-pair (lq.xyzw clr-2 ind0 TIE-VU-PALETTE-BASE) (nop)) ;; #x286
            (vu-pair (lq.xyzw clr1 ind1 TIE-VU-PALETTE-BASE) (add.xyzw vtx-2 vtx-2 xyzofs)) ;; #x287
            (vu-pair (lq.xyzw clr2 ind2 TIE-VU-PALETTE-BASE) (nop)) ;; #x288
            (vu-pair (nop) (nop)) ;; #x289
            (vu-pair (nop) (nop)) ;; #x28a
            (vu-pair (nop) (mulay.xyzw ACC clr1 morph)) ;; #x28b
            (vu-pair (lqi.xyzw inds clr-ptr) (maddy.xyzw clr1 clr2 morph)) ;; #x28c
            (vu-pair (lqi.xyzw vtx-3 point-ptr) (mulaw.xyzw ACC t-mtx3 vf00)) ;; #x28d
            (vu-pair (lqi.xyz xyzofs point-ptr) (maddax.xyzw ACC t-mtx0 vtx-2)) ;; #x28e
            (vu-pair (lqi.xyzw tex-3 point-ptr) (madday.xyzw ACC t-mtx1 vtx-2)) ;; #x28f
            (vu-pair (nop) (maddz.xyzw pos-02 t-mtx2 vtx-2)) ;; #x290

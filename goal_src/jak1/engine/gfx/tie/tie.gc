;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/game/main-h.gc")
(require "engine/gfx/tie/tie-h.gc")
(require "engine/anim/joint.gc")

;; TIE -- tessellating fragment instance engine
;;
;; TIE draws repeated background models. A prototype is authored once, chopped into fragments that
;; fit in VU1 memory, and then placed all over the level by a stream of 64-byte instance records.
;; Each fragment carries its own adgif shaders, packed points, strip packet templates, and a shared
;; time-of-day color palette; each instance record carries a transform, a wind phase, a LOD morph
;; weight, and the palette indices its vertices should use. Upload the fragment once, then let VU1
;; chew through every instance that picked it.
;;
;;   * Level of detail uses a similar strategy to TFRAG where vertices collapse back to the midpoint
;;     of an edge, creating degenerate triangles that can be removed without any popping.
;;     These use a different format than tfrag: each simplifying vertex stores its own position
;;     and the vector to move it back to the edge. It also stores the palette indices
;;     of that edge's two endpoints. Given t = the instance's morph weight, rising from 0 at the near
;;     edge of the LOD band to 1 at the far edge:
;;
;;         position = authored + t * displacement
;;         color    = (1 - t) * own + t * (color(parent1) + color(parent2)) / 2
;;
;;     so at t = 1 the vertex has moved onto its parents' edge and taken that edge's shading, so
;;     the degenerate triangle can be removed.
;;
;;     T-junctions and cracks are avoided by a separate and much blunter decision: the LOD is chosen
;;     per instance, not per fragment, so every fragment of a prototype is always at the same
;;     subdivision level and shares the same t. Two fragments meeting along an edge therefore split
;;     that edge the same number of times and move the shared vertices identically. There is no case
;;     where one half of a mesh is finer than the other, so there is never a vertex sitting in the
;;     middle of a neighbour's edge.
;;   * Palette colors are unpacked with VIF's additive mode on top of a 2^23 ROW, which leaves each
;;     color sitting in the low mantissa bits of an exactly representable float. Blending two of them
;;     with weights that sum to 256 pushes the exponent up by eight and divides the result by 256 for
;;     free -- see the morph pipeline. The same bias lets mtir pull VU addresses out of float lanes.
;;   * TIE is a scatter. There is no intermediate vertex array and no index buffer: entry 6 installs the
;;     shader and strip templates first -- GIF tags and vertex counts included -- and then each vertex is
;;     transformed and written *straight into its own slot* in the finished packet, told which slot it
;;     owns by an offset carried in its own data. Nothing walks a strip list afterwards to collect
;;     vertices.
;;
;;     TFRAG is the opposite design for GIF building: it transforms into an
;;     intermediate array and then a separate pass walks an exported draw-point table, follows each entry
;;     to a vertex, and copies it into the GIF buffer through a sequential cursor -- a gather.
;;
;;     There is no index buffer, so a vertex used by two triangle strips needs a slot in each. The
;;     exporter finds those and gives them a second offset; the renderer transforms once and stores the
;;     identical triplet twice. A vertex cache decided at export time rather than looked up at run time.
;;
;;     Nothing can emit fewer vertices than the template expects, because that would mean patching a GIF
;;     tag's count per fragment per frame. So every conditional below changes *what* goes into a slot,
;;     never *whether* a slot is filled.
;;
;;   * GIF output rotates through three banks, not two, to double buffer fragment and instance swaps.
;;     Within one fragment the two banks named by gifbuf alternate per instance in the ordinary
;;     double-buffered way: each entry-0 invocation rotates gifbuf, fills gifbuf.x, kicks it, and
;;     stops, so the bank being filled is never the bank the GIF is draining. The third bank exists
;;     because a *new* fragment has to install its shader and strip templates into both of the banks it
;;     is about to use, and at that moment one of the previous fragment's two banks still has an
;;     outstanding kick. Entry 6 therefore rotates in the bank that has been idle longest and leaves
;;     the freshly kicked one alone. With two banks it would have to overwrite geometry the GIF had not
;;     read yet.
;;
;;
;;   per level      the visibility string. One bit per instance, in BVH order, so a word of zeroes skips
;;                  32 instances without a transfer.
;;   per prototype  the geometry -- up to four alternative meshes, each cut into fragments -- and one
;;                  time-of-day color palette in prototype-bucket-tie.tie-colors. Also the LOD
;;                  distances, the wind stiffness, and the environment-map fade range.
;;   per fragment   its adgif shaders, its packed point stream, its strip templates, and its slice of the
;;                  prototype palette, named by color-index and color-count.
;;   per instance   64 bytes: a packed transform, a bounding sphere, a wind index, and a pointer to its
;;                  own stream of palette indices.
;;
;; The palette is the part worth being clear about. The colors themselves belong to the prototype and are
;; expanded and uploaded once per prototype per frame, to VU 838, where all of its fragments and all of
;; its instances read the same 128 entries. Each prototype has its own indices into
;; that per-prototype pallete.
;;
;; TIE can emit to generic to handle environment maps, but we don't need this on PC: instead we just
;; send all TIE to the PC renderers which handles environment mapping.

;; DECOMP BEGINS

;;;;;;;;;;;;;;;;;
;; Basic Methods
;;;;;;;;;;;;;;;;;
(defmethod login ((this tie-fragment))
  "Log in each five-quadword adgif shader referenced by this fragment."
  (let ((shaders (-> this gif-ref))
        (shader-count (/ (-> this tex-count) (the-as uint 5))))
    (dotimes (i (the-as int shader-count))
      (adgif-shader-login-no-remap (-> shaders i))))
  this)

(defmethod inspect ((this drawable-inline-array-instance-tie))
  (format #t "[~8x] ~A~%" this (-> this type))
  (format #t "~Tlength: ~D~%" (-> this length))
  (format #t "~Tdata[~D]: @ #x~X~%" (-> this length) (-> this data))
  (dotimes (i (-> this length))
    (format #t "~T  [~D] ~A~%" i (-> this data i)))
  this)

(defmethod asize-of ((this drawable-inline-array-instance-tie))
  "Return the array header size plus storage for its active inline TIE instances."
  (the-as int (+ (-> drawable-inline-array-instance-tie size) (* (+ (-> this length) -1) 64))))

;; This method is mistakenly duplicated, this earlier definition is overwritten by the later one.
;; OpenGOAL flags this as an error, so we comment out on PC.
(#unless PC_PORT
  (defmethod login ((this drawable-tree-instance-tie))
    "Leave this TIE instance tree unchanged."
    this))

;; INFO: this function exists in multiple non-identical object files
(defmethod login ((this drawable-tree-instance-tie))
  "Log in every child drawable in this TIE instance tree."
  (dotimes (i (-> this length))
    (login (-> this data i)))
  (the-as drawable-tree-instance-tie #f))

(defmethod inspect ((this prototype-tie))
  (format #t "[~8x] ~A~%" this (-> this type))
  (format #t "~Tlength: ~D~%" (-> this length))
  (format #t "~Tdata[~D]: @ #x~X~%" (-> this length) (-> this data))
  (dotimes (i (-> this length))
    (format #t "~T  [~D] ~A~%" i (-> this data i)))
  this)

(defmethod login ((this prototype-tie))
  "Log in every inline TIE fragment."
  (dotimes (i (-> this length))
    (login (-> this data i)))
  this)

(defmethod mem-usage ((this drawable-tree-instance-tie) (usage memory-usage-block) (flags mem-usage-flags))
  "Account for the tree header, its child drawables, and its prototype array. The prototype
   pass is marked so fragments are not charged as independent allocations a second time."
  (mem-usage-add-symbol! usage drawable-group 1 32)
  (dotimes (i (-> this length))
    (mem-usage (-> this data i) usage flags))
  ;; Bit 0 marks the prototype walk. Bits 1 through 4 are passed through to select instance-color
  ;; accounting and its geometry category.
  (mem-usage (-> this prototypes prototype-array-tie) usage (logior flags (mem-usage-flags prototype-data)))
  this)

(defmethod mem-usage ((this tie-fragment) (usage memory-usage-block) (flags mem-usage-flags))
  "Account for this prototype's header and referenced shader, point, draw-point, generic, and
   debug data. With the instance-color flag, account only for one instance's packed color table in
   the geometry-selected color category."
  (when (logtest? flags (mem-usage-flags instance-colors))
    (let ((color-bytes (* (-> this color-count) 4))
          (color-category (cond
                            ((logtest? flags (mem-usage-flags tie-geometry-1)) 20)
                            ((logtest? flags (mem-usage-flags tie-geometry-2)) 21)
                            (else 22))))
      (+! (-> usage data color-category count) 1)
      (+! (-> usage data color-category used) color-bytes)
      (+! (-> usage data color-category total) (logand -4 (+ color-bytes 3))))
    (set! (-> usage length) (max 23 (-> usage length)))
    (set! this this)
    (goto cfg-13))
  (set! (-> usage length) (max 18 (-> usage length)))
  (set! (-> usage data 9 name) "tie-fragment")
  (set! (-> usage data 10 name) "tie-gif")
  (set! (-> usage data 11 name) "tie-points")
  (set! (-> usage data 12 name) "tie-colors")
  (set! (-> usage data 14 name) "tie-debug")
  (set! (-> usage data 13 name) "tie-draw-points")
  (set! (-> usage data 17 name) "tie-generic")
  (+! (-> usage data 9 count) 1)
  (let ((header-bytes (asize-of this)))
    (+! (-> usage data 9 used) header-bytes)
    (+! (-> usage data 9 total) (logand -16 (+ header-bytes 15))))
  (let ((shader-bytes (* (-> this gif-count) 16)))
    (+! (-> usage data 10 count) (-> this tex-count))
    (+! (-> usage data 10 used) shader-bytes)
    (+! (-> usage data 10 total) (logand -16 (+ shader-bytes 15))))
  (let ((point-bytes (* (-> this vertex-count) 16)))
    (+! (-> usage data 11 count) (-> this vertex-count))
    (+! (-> usage data 11 used) point-bytes)
    (+! (-> usage data 11 total) (logand -16 (+ point-bytes 15))))
  (let ((draw-point-bytes (* (-> this dp-qwc) 16)))
    (+! (-> usage data 13 count) (* (-> this dp-qwc) 16))
    (+! (-> usage data 13 used) draw-point-bytes)
    (+! (-> usage data 13 total) (logand -16 (+ draw-point-bytes 15))))
  (let ((generic-bytes (* (-> this generic-count) 16)))
    (+! (-> usage data 17 count) 1)
    (+! (-> usage data 17 used) generic-bytes)
    (+! (-> usage data 17 total) (logand -16 (+ generic-bytes 15))))
  (when (nonzero? (-> this debug-lines))
    (dotimes (i (-> this debug-lines length))
      (+! (-> usage data 14 count) (-> (the-as (pointer int32) (-> this debug-lines i)) 0))
      (let ((debug-line-bytes (asize-of (the-as basic (-> this debug-lines i)))))
        ;; ????: the count is charged to tie-debug above, but the bytes are charged to tie-colors
        ;; here.
        (+! (-> usage data 12 used) debug-line-bytes)
        (+! (-> usage data 12 total) (logand -16 (+ debug-line-bytes 15))))))
  (label cfg-13)
  this)

(defmethod mem-usage ((this instance-tie) (usage memory-usage-block) (flags mem-usage-flags))
  "Account for this instance and, when it owns color overrides, ask each available geometry
   prototype to account for the corresponding packed instance-color table."
  (mem-usage-add! usage instance-tie 1 (asize-of this))
  (when (nonzero? (-> this error))
    (set! (-> usage length) (max 24 (-> usage length)))
    (set! (-> usage data 23 name) "instance-tie-colors*")
    (set! (-> usage data 19 name) "instance-tie-colors0")
    (set! (-> usage data 20 name) "instance-tie-colors1")
    (set! (-> usage data 21 name) "instance-tie-colors2")
    (set! (-> usage data 22 name) "instance-tie-colors3")
    (+! (-> usage data 23 count) 1)
    (let ((bucket (-> this bucket-ptr)))
      ;; This subtotal is computed but not stored.
      (+ (-> usage data 19 used) (-> usage data 20 used) (-> usage data 21 used) (-> usage data 22 used))
      (dotimes (i 4)
        (let ((geometry (-> bucket geometry-override i)))
          (when (nonzero? geometry)
            (let ((t9-1 (method-of-object geometry mem-usage))
                  (a1-2 usage)
                  (geometry-index i))
              (t9-1 geometry
                    a1-2
                    (the-as mem-usage-flags
                            (logior (the-as mem-usage-flags
                                            (logior (cond
                                                      ((= geometry-index 1) 4)
                                                      ((= geometry-index 2) 8)
                                                      ((= geometry-index 3) 16)
                                                      (else 0))
                                                    2))
                                    flags)))))))))
  this)

(defmethod mem-usage ((this drawable-inline-array-instance-tie) (usage memory-usage-block) (flags mem-usage-flags))
  "Account for the inline-array header and every active TIE instance."
  (mem-usage-add-symbol! usage drawable-group 1 32)
  (dotimes (i (-> this length))
    (mem-usage (-> this data i) usage flags))
  this)

(defmethod mem-usage ((this prototype-tie) (usage memory-usage-block) (flags mem-usage-flags))
  "Account for the prototype-array header and every inline TIE fragment."
  (mem-usage-add-symbol! usage drawable-group 1 32)
  (dotimes (i (-> this length))
    (mem-usage (-> this data i) usage flags))
  this)

(defmethod asize-of ((this prototype-tie))
  "Return the prototype-array header size plus storage for its active inline fragments."
  (the-as int (+ (-> prototype-tie size) (* (+ (-> this length) -1) 64))))

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; TIE Renderer
;;;;;;;;;;;;;;;;;;;;;;;;;;

(deftype tie-consts (structure)
  ((data      uint32 24)
   (vector    vector 6 :inline :overlay-at (-> data 0))
   (quads     uint128 6 :overlay-at (-> data 0))
   (adgif     gs-gif-tag :inline :overlay-at (-> data 0)) ;; five-register A+D tag for a shader
   (strgif    gs-gif-tag :inline :overlay-at (-> data 4)) ;; ST/RGBAQ/XYZF2 tag for a triangle strip
   (extra     vector :inline :overlay-at (-> data 8)) ;; x,z: sum of the three GIF addresses
   (gifbufs   vector :inline :overlay-at (-> data 12)) ;; the two GIF banks this fragment owns
   (clrbufs   qword :inline :overlay-at (-> data 16)) ;; the two instance-record input banks
   (misc      qword :inline :overlay-at (-> data 20)) ;; x: wanted TEST state, y: installed state
   (atestgif  gs-gif-tag :inline :offset 96) ;; one-register A+D tag, written ahead of the TEST value
   (atest     ad-cmd 2 :inline :offset 112)
   (atest-tra ad-cmd :inline :overlay-at (-> atest 0)) ;; alpha-tested translucent pass
   (atest-def ad-cmd :inline :overlay-at (-> atest 1)))) ;; ordinary opaque pass

;; How the two halves of TIE divide the work.
;;
;; EE, instance pass: cull each placement against the camera, pick near / ordinary / Generic and a
;; level of detail, transform its rows, run the wind spring, and link a compact instance record onto
;; the chosen prototype-and-LOD list.
;;
;; EE, prototype pass: visit only the lists that got something. Expand that prototype's time-of-day
;; palette and emit the DMA/VIF chain that uploads one fragment -- shaders, strip templates, packed
;; points -- followed by every instance record hanging off it. Two scratchpad palette banks and two
;; scratchpad output banks alternate, so the EE builds the next packet while DMA is still returning
;; the last one.
;;
;; VU1: entry 6 installs the fragment's templates, then entry 0 runs once per instance batch. It
;; expands the packed points, transforms four vertices at a time, divides by w, looks each vertex's
;; color out of the palette, and writes ST/RGBAQ/XYZF triplets straight into a GIF bank.
;;
;; VU1 memory map:
;;
;;     0 -  49   prototype point stream as uploaded (packed 16-bit)
;;    50 - 197   expanded point stream; conversion works backwards into the space it consumes
;;   198 - 241   instance input bank A (transform, morph, packet state, palette indices)
;;   242 - 285   instance input bank B
;;   286 - 469   GIF output bank 0
;;   470 - 653   GIF output bank 1
;;   654 - 837   GIF output bank 2
;;   838 - 965   time-of-day color palette, 128 entries
;;   966 - 974   tie-consts
;;   976 - 977   the alpha-test packet assembled just before each kick
;;
;; VIF alternates the two 44-quadword instance banks so it can fill one while VU1 reads the other.
;;
;; The GIF output rotation, in full, because it is the least obvious part of the program.
;;
;; gifbuf holds two of the three bank addresses, duplicated as (A B A B) so that mr32 -- which rotates
;; lanes by one -- swaps which of the two is in x while leaving the pair intact. Sequence per fragment:
;;
;;   entry 6   gifbuf.x <- extra.x - gifbuf.x - gifbuf.y, i.e. the third bank, the one this fragment's
;;             predecessor did not touch last. Templates are installed into gifbuf.x and gifbuf.y,
;;             which are now the two banks this fragment owns. mr32, then stop.
;;   entry 0   mr32, fill gifbuf.x, kick gifbuf.x, mr32 clrbuf to flip the instance input bank, stop.
;;             Once per instance, so successive instances of the same fragment alternate banks.
;;
;; Within a fragment that is plain double buffering: the bank being filled is never the bank the GIF is
;; draining. The third bank is for the fragment boundary. Entry 6 has to write templates into *both*
;; banks it will use, and at that moment the last instance of the previous fragment has an outstanding
;; kick on one of the two banks it was using. Rotating in the longest-idle bank keeps entry 6 away from
;; it.
;;
;;
;; Vertices are not assigned to a bank or a slot by their position in the stream. Each vertex carries
;; its own destination offset in the w lane of its position quadword; add the current bank's biased
;; address, mtir it out, and that is where the triplet goes.
;;
;; That addressing scheme is also how reuse works. The strip templates are prebuilt with a fixed slot
;; per vertex per strip, so there is no index buffer and a vertex belonging to two strips has to appear
;; in both. Such a vertex carries a second offset in the w lane of its ST quadword and the
;; dual-destination loop variants store the identical ST, RGBAQ and XYZF2 triplet to both slots -- same
;; texture coordinates, same time-of-day color, same screen position, transformed once.
;;
;; The four group-terminating addresses arrive as offsets relative to whichever bank the exporter had
;; in mind, so kick-addr remembers the base they are currently expressed against and each instance
;; rebases them by the difference. Entry 6 sets kick-addr to zero, which turns the first instance's
;; rebase into a plain "make these absolute in the bank I am filling".
;;
;; Entry points: 0 render an instance stream, 2 finish and kick the current GIF bank, 4 empty (used
;; purely to wait for the previous invocation), 6 install a fragment's templates, 8 initialize the
;; persistent buffer registers and the alpha-test selector.

;; Where the point-expansion loop picks up the packed stream. These two have no type behind them --
;; the stream is untyped packed data -- so they stay plain constants.
(defconstant TIE-VU-PROTOTYPE-POINT-0 50)

(defconstant TIE-VU-PROTOTYPE-POINT-1 51)

(defconstant TIE-VU-PALETTE-BASE 838)

;; tie-consts is uploaded as one nine-quadword block, and its field order *is* its upload order, so the
;; addresses are derived from the type rather than transcribed one per line. Change the type and every
;; address in the program follows; there is nothing to keep in sync by hand.
(defconstant TIE-VU-CONSTS 966)

(defmacro tie-const (&rest path)
  `(+ TIE-VU-CONSTS (/ (offset-of tie-consts ,@path) 16)))

;; Two scratch quadwords past the end of tie-consts, where the alpha-test packet is assembled before it
;; is kicked. Outside the type, so named directly.
(defconstant TIE-VU-ATEST-PACKET 976)

(defconstant TIE-VU-ATEST-DATA 977)

;; One instance record is a tie-matrix -- six quadwords -- followed by one quadword of palette indices,
;; and the render loops address it relative to clr-ptr. Same trick: take the quadword index from the
;; type. The index stream continues past the end of the record, one quadword per four vertices, which is
;; why the stride is one more than the last field.
(defmacro tie-instance-qword (&rest path)
  `(/ (offset-of tie-matrix ,@path) 16))

(defconstant TIE-VU-INSTANCE-PALETTE-INDICES (+ (tie-instance-qword fog) 1))

(defconstant TIE-VU-INSTANCE-STRIDE (+ TIE-VU-INSTANCE-PALETTE-INDICES 1))

(#when PC_PORT
  (define tie-vu1-block (new 'static 'vu-function :length 0 :qlength 0)))

(#unless PC_PORT
  (defvu1 tie-vu1-block
          ;; Register aliases for the render pipelines. Sixteen integer and thirty-two vector registers
          ;; have to cover template installation, point expansion, and both pipelines, so the setup
          ;; entries borrow most of these for unrelated temporaries. Those entries are written with
          ;; physical registers below; the names below mean what they say from render-basic-stream on.
          ;;
          ;; Vocabulary. A "bp" is a base point: an ordinary vertex, one input quadword plus its ST, one
          ;; output slot. An "ip" is an interpolated point: it also carries the offset toward the
          ;; midpoint of the edge it subdivides and the palette indices of that edge's two endpoints,
          ;; so the morph weight can collapse it onto that edge. Each kind is split into two groups:
          ;; group 1 is the vertices with a single output slot, group 2 the vertices shared by two
          ;; triangle strips, which have to be written twice. skip-bp2 and skip-ips say whether the
          ;; second and the interpolated groups exist at all, and the four target-*-ptr values are the
          ;; output addresses at which each group ends.
          (rlet ((itemp :reg vi01) ;; scratch: bank deltas, entry selectors, GIF addresses
                 (point-ptr :reg vi02) ;; cursor into the uploaded prototype point stream
                 (clr-ptr :reg vi03) ;; cursor into the instance records (matrix, morph, indices)
                 (target-bp1-ptr :reg vi04) ;; output address that ends the first base-point group
                 (skip-bp2 :reg vi05) ;; nonzero when this fragment has no second base-point group
                 (target-bp2-ptr :reg vi06) ;; output address that ends the second base-point group
                 (target-ip1-ptr :reg vi07) ;; output address that ends the first interp-point group
                 (target-ip2-ptr :reg vi08) ;; output address that ends the second interp-point group
                 (ind0 :reg vi09) ;; palette index for this vertex
                 (ind1 :reg vi10) ;; first neighbour index, interp points only
                 (ind2 :reg vi11) ;; second neighbour index, interp points only
                 (dest-ptr :reg vi12) ;; GIF write cursor in the bank being filled
                 (dest2-ptr :reg vi13) ;; GIF write cursor in the fragment's other bank
                 (skip-ips :reg vi14) ;; zero when this fragment has interpolated points
                 (kick-addr :reg vi15) ;; base of the bank most recently handed to the GIF
                 (t-mtx0 :reg vf01) ;; instance transform, rows 0 through 3
                 (t-mtx1 :reg vf02)
                 (t-mtx2 :reg vf12)
                 (t-mtx3 :reg vf13)
                 (vtx-0 :reg vf05) ;; four packed input vertices in flight
                 (vtx-1 :reg vf06)
                 (vtx-2 :reg vf07)
                 (vtx-3 :reg vf08)
                 (pos-02 :reg vf09) ;; homogeneous positions for the even and odd halves of the group
                 (pos-13 :reg vf10)
                 (clr-0 :reg vf11) ;; the group's four time-of-day colors
                 (clr-1 :reg vf03)
                 (clr-2 :reg vf04)
                 (clr-3 :reg vf14)
                 (tex-0 :reg vf15) ;; the group's four ST coordinates
                 (tex-1 :reg vf16)
                 (tex-2 :reg vf17)
                 (tex-3 :reg vf18)
                 (res-02 :reg vf19) ;; screen-space XYZF results, even and odd halves
                 (res-13 :reg vf20)
                 (gifbuf :reg vf21) ;; biased addresses of the rotating GIF output banks
                 (clrbuf :reg vf22) ;; alternating instance/color input-bank addresses
                 (extra :reg vf23) ;; sum of the three GIF addresses, plus the saved output cursors
                 (inds :reg vf24) ;; packed time-of-day palette indices for one vertex
                 (morph :reg vf27) ;; per-instance LOD blend: x collapses geometry, zw blend colors
                 (xyzofs :reg vf28) ;; interp point's second position, and the output base in w
                 (clr1 :reg vf29) ;; first neighbour color, then their average
                 (clr2 :reg vf30) ;; second neighbour color
                 )
            ;; Entry table. Each entry is one instruction pair holding a branch plus whatever setup fits in
            ;; the slots; entry 8 has no branch at all and simply runs off the end of the table into #x009.
            ;; The E bit at #x00c is what stops entry 8, and the store at #x00d runs in its delay pair, which
            ;; is why the "previously installed TEST state" starts at -1 -- no state can match it, so the
            ;; first fragment always sends one.
            (vu-pair (b render-basic-stream) (nop)) ;; #x000
            (vu-pair (mr32.xyzw gifbuf gifbuf) (nop)) ;; #x001
            (vu-pair (b finish-current-gif-buffer) (nop)) ;; #x002
            (vu-pair (nop) (nop)) ;; #x003
            (vu-pair (b finish-vu-entry) (nop)) ;; #x004
            (vu-pair (nop) (nop)) ;; #x005
            (vu-pair (b initialize-fragment-templates) (nop)) ;; #x006
            (vu-pair (iaddi point-ptr vi00 0x0) (subx.xz gifbuf extra gifbuf)) ;; #x007
            (vu-pair (iaddi itemp vi00 0x1) (nop)) ;; #x008
            (vu-pair (lq.xyzw gifbuf vi00 (tie-const gifbufs)) (nop)) ;; #x009
            (vu-pair (lq.xz extra vi00 (tie-const extra)) (nop)) ;; #x00a
            (vu-pair (lq.xyzw clrbuf vi00 (tie-const clrbufs)) (nop)) ;; #x00b
            (vu-pair (isw.x vi00 vi00 (tie-const misc)) (nop :e)) ;; #x00c
            (vu-pair (isw.y itemp vi00 (tie-const misc)) (nop)) ;; #x00d
            ;; Entry 6. A fragment's GIF output is prebuilt: the adgif shader packets and the strip tags are
            ;; laid down first, and the render loop only fills in the vertex triplets between them. Because
            ;; the fragment splits its vertices across both of the banks it owns, every template has to be
            ;; written into both. The destination offsets and repeat counts ride along in words of the
            ;; uploaded packet data that the GIF ignores, so one stream describes the templates and where
            ;; they go.
            ;;
            ;; Physical registers from here to setup-instance-render: vi04 is the running destination offset,
            ;; vi05 and vi06 are the two bank base addresses, vi09 is the repeat count, and vf01 through
            ;; vf07 are just quadwords in transit. None of them hold their render-loop meaning yet.
            (label initialize-fragment-templates)
            (vu-pair (lq.xyz vf01 vi00 (tie-const adgif)) (nop)) ;; #x00e

            (vu-pair (nop) (nop)) ;; #x201
            (vu-pair (nop) (nop)) ;; #x202
            (vu-pair (nop) (mul.xyz pos-13 pos-13 Q)) ;; #x203
            (vu-pair (mtir dest-ptr vtx-0.w) (mul.xyz tex-1 tex-1 Q)) ;; #x204
            (vu-pair (mtir dest2-ptr vtx-1.w) (nop)) ;; #x205

            (label basic-short-slot1)
            (vu-pair (div Q vf00.w pos-02.w) (addx.w vtx-1 vtx-1 gifbuf)) ;; #x20f
            (vu-pair (sq.xyzw tex-0 dest-ptr 0) (addx.w vtx-2 vtx-2 gifbuf)) ;; #x210
            (vu-pair (sq.xyzw clr-0 dest-ptr 1) (nop)) ;; #x211

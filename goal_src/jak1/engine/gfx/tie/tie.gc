            (vu-pair (sq.xyzw res-13 dest-ptr 2) (ftoi4.xyz res-02 pos-02)) ;; #x21b
            (vu-pair (sq.xyzw tex-2 dest2-ptr 0) (nop)) ;; #x21c
            (vu-pair (sq.xyzw clr-2 dest2-ptr 1) (nop)) ;; #x21d

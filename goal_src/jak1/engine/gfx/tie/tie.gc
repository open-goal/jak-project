            (vu-pair (sq.xyzw res-13 dest2-ptr 2) (addx.w tex-0 tex-0 gifbuf)) ;; #x36c
            (vu-pair (lq.xyzw clr-2 ind0 TIE-VU-PALETTE-BASE) (nop)) ;; #x36d
            (vu-pair (lq.xyzw clr1 ind1 TIE-VU-PALETTE-BASE) (mulaw.xyzw ACC t-mtx3 vf00)) ;; #x36e
            (vu-pair (lq.xyzw clr2 ind2 TIE-VU-PALETTE-BASE) (nop)) ;; #x36f
            (vu-pair (lqi.xyzw inds clr-ptr) (nop)) ;; #x370
            (vu-pair (ibne target-ip2-ptr dest-ptr morph-loop-slot3) (nop)) ;; #x371
            (vu-pair (mtir dest-ptr vtx-0.w) (maddax.xyzw ACC t-mtx0 vtx-2)) ;; #x372
            (vu-pair (b finalize-and-kick-gif) (nop)) ;; #x373
            (vu-pair (nop) (nop)) ;; #x374
            (label morph-loop)
            (vu-pair (lqi.xyzw vtx-0 point-ptr) (madday.xyzw ACC t-mtx1 vtx-3)) ;; #x375
            (vu-pair (lqi.xyz xyzofs point-ptr) (maddz.xyzw pos-13 t-mtx2 vtx-3)) ;; #x376
            (vu-pair (lqi.xyzw tex-0 point-ptr) (mul.xyz tex-2 tex-2 Q)) ;; #x377
            (vu-pair (mtir dest2-ptr tex-1.w) (mul.xyz pos-02 pos-02 Q)) ;; #x378
            (vu-pair (mtir ind0 inds.x) (mulay.xyzw ACC clr1 morph)) ;; #x379
            (vu-pair (mtir ind1 inds.y) (maddy.xyzw clr1 clr2 morph)) ;; #x37a
            (vu-pair (mtir ind2 inds.z) (nop)) ;; #x37b
            (vu-pair (sq.xyzw clr-1 dest-ptr 1) (ftoi4.xyz res-02 pos-02)) ;; #x37c
            (vu-pair (div Q vf00.w pos-13.w) (mulx.xyz vtx-0 vtx-0 morph)) ;; #x37d
            (vu-pair (sq.xyzw tex-1 dest-ptr 0) (addx.w tex-3 tex-3 gifbuf)) ;; #x37e
            (vu-pair (sq.xyzw res-13 dest-ptr 2) (mulaw.xyzw ACC clr1 morph)) ;; #x37f
            (vu-pair (sq.xyzw tex-1 dest2-ptr 0) (maddz.xyzw clr-3 clr-3 morph)) ;; #x380
            (vu-pair (sq.xyzw clr-1 dest2-ptr 1) (add.xyzw vtx-0 vtx-0 xyzofs)) ;; #x381
            (vu-pair (sq.xyzw res-13 dest2-ptr 2) (nop)) ;; #x382
            (vu-pair (lq.xyzw clr-0 ind0 TIE-VU-PALETTE-BASE) (nop)) ;; #x383
            (vu-pair (lq.xyzw clr1 ind1 TIE-VU-PALETTE-BASE) (mulaw.xyzw ACC t-mtx3 vf00)) ;; #x384
            (vu-pair (lq.xyzw clr2 ind2 TIE-VU-PALETTE-BASE) (nop)) ;; #x385
            (vu-pair (lqi.xyzw inds clr-ptr) (nop)) ;; #x386
            (vu-pair (ibeq target-ip2-ptr dest-ptr finalize-and-kick-gif) (nop)) ;; #x387
            (vu-pair (mtir dest-ptr vtx-2.w) (maddax.xyzw ACC t-mtx0 vtx-0)) ;; #x388
            (label morph-loop-slot1)
            (vu-pair (lqi.xyzw vtx-1 point-ptr) (madday.xyzw ACC t-mtx1 vtx-0)) ;; #x389
            (vu-pair (lqi.xyz xyzofs point-ptr) (maddz.xyzw pos-02 t-mtx2 vtx-0)) ;; #x38a
            (vu-pair (lqi.xyzw tex-1 point-ptr) (mul.xyz tex-3 tex-3 Q)) ;; #x38b
            (vu-pair (mtir dest2-ptr tex-2.w) (mul.xyz pos-13 pos-13 Q)) ;; #x38c
            (vu-pair (mtir ind0 inds.x) (mulay.xyzw ACC clr1 morph)) ;; #x38d
            (vu-pair (mtir ind1 inds.y) (maddy.xyzw clr1 clr2 morph)) ;; #x38e
            (vu-pair (mtir ind2 inds.z) (nop)) ;; #x38f
            (vu-pair (sq.xyzw clr-2 dest-ptr 1) (ftoi4.xyz res-13 pos-13)) ;; #x390
            (vu-pair (div Q vf00.w pos-02.w) (mulx.xyz vtx-1 vtx-1 morph)) ;; #x391
            (vu-pair (sq.xyzw tex-2 dest-ptr 0) (addx.w tex-0 tex-0 gifbuf)) ;; #x392
            (vu-pair (sq.xyzw res-02 dest-ptr 2) (mulaw.xyzw ACC clr1 morph)) ;; #x393
            (vu-pair (sq.xyzw tex-2 dest2-ptr 0) (maddz.xyzw clr-0 clr-0 morph)) ;; #x394
            (vu-pair (sq.xyzw clr-2 dest2-ptr 1) (add.xyzw vtx-1 vtx-1 xyzofs)) ;; #x395
            (vu-pair (sq.xyzw res-02 dest2-ptr 2) (nop)) ;; #x396
            (vu-pair (lq.xyzw clr-1 ind0 TIE-VU-PALETTE-BASE) (nop)) ;; #x397
            (vu-pair (lq.xyzw clr1 ind1 TIE-VU-PALETTE-BASE) (mulaw.xyzw ACC t-mtx3 vf00)) ;; #x398
            (vu-pair (lq.xyzw clr2 ind2 TIE-VU-PALETTE-BASE) (nop)) ;; #x399
            (vu-pair (lqi.xyzw inds clr-ptr) (nop)) ;; #x39a
            (vu-pair (ibeq target-ip2-ptr dest-ptr finalize-and-kick-gif) (nop)) ;; #x39b
            (vu-pair (mtir dest-ptr vtx-3.w) (maddax.xyzw ACC t-mtx0 vtx-1)) ;; #x39c
            (label morph-loop-slot2)
            (vu-pair (lqi.xyzw vtx-2 point-ptr) (madday.xyzw ACC t-mtx1 vtx-1)) ;; #x39d
            (vu-pair (lqi.xyz xyzofs point-ptr) (maddz.xyzw pos-13 t-mtx2 vtx-1)) ;; #x39e
            (vu-pair (lqi.xyzw tex-2 point-ptr) (mul.xyz tex-0 tex-0 Q)) ;; #x39f
            (vu-pair (mtir dest2-ptr tex-3.w) (mul.xyz pos-02 pos-02 Q)) ;; #x3a0
            (vu-pair (mtir ind0 inds.x) (mulay.xyzw ACC clr1 morph)) ;; #x3a1
            (vu-pair (mtir ind1 inds.y) (maddy.xyzw clr1 clr2 morph)) ;; #x3a2
            (vu-pair (mtir ind2 inds.z) (nop)) ;; #x3a3
            (vu-pair (sq.xyzw clr-3 dest-ptr 1) (ftoi4.xyz res-02 pos-02)) ;; #x3a4
            (vu-pair (div Q vf00.w pos-13.w) (mulx.xyz vtx-2 vtx-2 morph)) ;; #x3a5
            (vu-pair (sq.xyzw tex-3 dest-ptr 0) (addx.w tex-1 tex-1 gifbuf)) ;; #x3a6
            (vu-pair (sq.xyzw res-13 dest-ptr 2) (mulaw.xyzw ACC clr1 morph)) ;; #x3a7
            (vu-pair (sq.xyzw tex-3 dest2-ptr 0) (maddz.xyzw clr-1 clr-1 morph)) ;; #x3a8
            (vu-pair (sq.xyzw clr-3 dest2-ptr 1) (add.xyzw vtx-2 vtx-2 xyzofs)) ;; #x3a9
            (vu-pair (sq.xyzw res-13 dest2-ptr 2) (nop)) ;; #x3aa
            (vu-pair (lq.xyzw clr-2 ind0 TIE-VU-PALETTE-BASE) (nop)) ;; #x3ab
            (vu-pair (lq.xyzw clr1 ind1 TIE-VU-PALETTE-BASE) (mulaw.xyzw ACC t-mtx3 vf00)) ;; #x3ac
            (vu-pair (lq.xyzw clr2 ind2 TIE-VU-PALETTE-BASE) (nop)) ;; #x3ad
            (vu-pair (lqi.xyzw inds clr-ptr) (nop)) ;; #x3ae
            (vu-pair (ibeq target-ip2-ptr dest-ptr finalize-and-kick-gif) (nop)) ;; #x3af
            (vu-pair (mtir dest-ptr vtx-0.w) (maddax.xyzw ACC t-mtx0 vtx-2)) ;; #x3b0
            (label morph-loop-slot3)
            (vu-pair (lqi.xyzw vtx-3 point-ptr) (madday.xyzw ACC t-mtx1 vtx-2)) ;; #x3b1
            (vu-pair (lqi.xyz xyzofs point-ptr) (maddz.xyzw pos-02 t-mtx2 vtx-2)) ;; #x3b2
            (vu-pair (lqi.xyzw tex-3 point-ptr) (mul.xyz tex-1 tex-1 Q)) ;; #x3b3
            (vu-pair (mtir dest2-ptr tex-0.w) (mul.xyz pos-13 pos-13 Q)) ;; #x3b4
            (vu-pair (mtir ind0 inds.x) (mulay.xyzw ACC clr1 morph)) ;; #x3b5
            (vu-pair (mtir ind1 inds.y) (maddy.xyzw clr1 clr2 morph)) ;; #x3b6
            (vu-pair (mtir ind2 inds.z) (nop)) ;; #x3b7
            (vu-pair (sq.xyzw clr-0 dest-ptr 1) (ftoi4.xyz res-13 pos-13)) ;; #x3b8
            (vu-pair (div Q vf00.w pos-02.w) (mulx.xyz vtx-3 vtx-3 morph)) ;; #x3b9
            (vu-pair (sq.xyzw tex-0 dest-ptr 0) (addx.w tex-2 tex-2 gifbuf)) ;; #x3ba
            (vu-pair (sq.xyzw res-02 dest-ptr 2) (mulaw.xyzw ACC clr1 morph)) ;; #x3bb
            (vu-pair (sq.xyzw tex-0 dest2-ptr 0) (maddz.xyzw clr-2 clr-2 morph)) ;; #x3bc
            (vu-pair (sq.xyzw clr-0 dest2-ptr 1) (add.xyzw vtx-3 vtx-3 xyzofs)) ;; #x3bd
            (vu-pair (sq.xyzw res-02 dest2-ptr 2) (nop)) ;; #x3be
            (vu-pair (lq.xyzw clr-3 ind0 TIE-VU-PALETTE-BASE) (nop)) ;; #x3bf
            (vu-pair (lq.xyzw clr1 ind1 TIE-VU-PALETTE-BASE) (mulaw.xyzw ACC t-mtx3 vf00)) ;; #x3c0
            (vu-pair (lq.xyzw clr2 ind2 TIE-VU-PALETTE-BASE) (nop)) ;; #x3c1
            (vu-pair (lqi.xyzw inds clr-ptr) (nop)) ;; #x3c2
            (vu-pair (ibne target-ip2-ptr dest-ptr morph-loop) (nop)) ;; #x3c3
            (vu-pair (mtir dest-ptr vtx-1.w) (maddax.xyzw ACC t-mtx0 vtx-3)) ;; #x3c4
            ;; Assemble the alpha-test packet, kick it, kick the finished output bank, then rotate: the two GIF
            ;; addresses move on, the instance input bank flips, and the point cursor resets for the next
            ;; batch. misc.x is the TEST state this fragment wants and misc.y is the one currently installed,
            ;; so a run of fragments with the same state does not re-send it.
            ;;
            ;; Two kicks leave, not one. The fragment filled two banks, so the second is handed over as well,
            ;; and the E bit on the first kick's pair is what ends this invocation of entry 0.
            (label finalize-and-kick-gif)
            (vu-pair (ilw.x itemp vi00 (tie-const misc)) (nop)) ;; #x3c5
            (vu-pair (ilw.y dest-ptr vi00 (tie-const misc)) (nop)) ;; #x3c6
            (vu-pair (lq.xyzw vtx-0 vi00 (tie-const atestgif)) (nop)) ;; #x3c7
            (vu-pair (lq.xyzw vtx-1 vi00 (tie-const atest 0)) (nop)) ;; #x3c8
            (vu-pair (lq.xyzw vtx-2 vi00 (tie-const atest 1)) (nop)) ;; #x3c9
            (vu-pair (sq.xyzw vtx-0 vi00 TIE-VU-ATEST-PACKET) (nop)) ;; #x3ca
            (vu-pair (ibne vi00 itemp kick-active-gif-buffers) (nop)) ;; #x3cb
            (vu-pair (sq.xyzw vtx-2 vi00 TIE-VU-ATEST-DATA) (nop)) ;; #x3cc
            (vu-pair (sq.xyzw vtx-1 vi00 TIE-VU-ATEST-DATA) (nop)) ;; #x3cd
            (label kick-active-gif-buffers)
            (vu-pair (iaddiu point-ptr vi00 TIE-VU-ATEST-PACKET) (nop)) ;; #x3ce
            (vu-pair (isw.y itemp vi00 (tie-const misc)) (nop)) ;; #x3cf
            (vu-pair (xgkick point-ptr) (nop)) ;; #x3d0
            (vu-pair (mtir itemp gifbuf.x) (nop)) ;; #x3d1
            (vu-pair (mtir dest-ptr extra.w) (nop)) ;; #x3d2
            (vu-pair (mr32.xyzw clrbuf clrbuf) (nop)) ;; #x3d3
            (vu-pair (iaddiu point-ptr vi00 TIE-VU-PROTOTYPE-POINT-0) (nop)) ;; #x3d4
            (vu-pair (mfir.y extra vi00) (nop)) ;; #x3d5
            (vu-pair (xgkick itemp) (nop :e)) ;; #x3d6
            (vu-pair (mtir clr-ptr clrbuf.x) (nop)) ;; #x3d7
            (label finish-current-gif-buffer)
            (vu-pair (mtir itemp extra.y) (nop)) ;; #x3d8
            (vu-pair (mtir dest-ptr extra.w) (nop)) ;; #x3d9
            (vu-pair (mr32.xyzw clrbuf clrbuf) (nop)) ;; #x3da
            (vu-pair (iaddiu point-ptr vi00 TIE-VU-PROTOTYPE-POINT-0) (nop)) ;; #x3db
            (vu-pair (iadd itemp itemp kick-addr) (nop)) ;; #x3dc
            (vu-pair (mfir.y extra dest-ptr) (nop :e)) ;; #x3dd
            (vu-pair (mtir clr-ptr clrbuf.x) (nop)) ;; #x3de
            (label finish-vu-entry)
            (vu-pair (nop) (nop :e)) ;; #x3df
            (vu-pair (nop) (nop)) ;; #x3e0
            )))

(defun tie-init-consts ((consts tie-consts) (alpha-blend int))
  "Build the VU1 GIF templates, triple-buffer addresses, instance-data bank addresses, and alpha-test
   states used by TIE. The three GIF output addresses are stored as 2^23-biased floats so VU1 can
   recover their integer addresses with mtir, and their sum lets the program select the third bank by
   subtracting the two current banks. alpha-blend controls the ABE bit in the geometry primitive."
  (set! (-> consts adgif tag) (new 'static 'gif-tag64 :nloop #x5 :nreg #x1))
  (set! (-> consts adgif regs) (new 'static 'gif-tag-regs :regs0 (gif-reg-id a+d)))
  (cond
    ((zero? *subdivide-draw-mode*)
     (set! (-> consts strgif tag)
           (new 'static
                'gif-tag64
                :pre #x1
                :nreg #x3
                :prim
                (new 'static 'gs-prim :prim (gs-prim-type tri-strip) :iip #x1 :tme #x1 :fge #x1 :abe alpha-blend))))
    ((= *subdivide-draw-mode* 3)
     (set! (-> consts strgif tag)
           (new 'static
                'gif-tag64
                :pre #x1
                :nreg #x3
                :prim
                (new 'static 'gs-prim :prim (gs-prim-type tri-strip) :iip #x1 :tme #x1 :fge #x1 :abe alpha-blend))))
    ((= *subdivide-draw-mode* 1)
     (set! (-> consts strgif tag)
           (new 'static
                'gif-tag64
                :pre #x1
                :nreg #x3
                :prim
                (new 'static 'gs-prim :prim (gs-prim-type line-strip) :iip #x1 :fge #x1 :abe alpha-blend))))
    ((= *subdivide-draw-mode* 2)
     (set! (-> consts strgif tag)
           (new 'static
                'gif-tag64
                :pre #x1
                :nreg #x3
                :prim
                (new 'static 'gs-prim :prim (gs-prim-type tri-strip) :iip #x1 :fge #x1 :abe alpha-blend)))))
  (set! (-> consts strgif regs)
        (new 'static 'gif-tag-regs :regs0 (gif-reg-id st) :regs1 (gif-reg-id rgbaq) :regs2 (gif-reg-id xyzf2)))
  ;; Encode VU addresses 286, 470, and 654 in the low mantissa bits of 2^23-based floats. VU1
  ;; rotates the active pair by subtracting it from the sum of all three addresses.
  (let ((gif-buffer-a 8388894.0)
        (gif-buffer-b 8389078.0)
        (gif-buffer-c 8389262.0))
    (set! (-> consts gifbufs x) gif-buffer-c)
    (set! (-> consts gifbufs y) gif-buffer-b)
    (set! (-> consts gifbufs z) gif-buffer-c)
    (set! (-> consts gifbufs w) gif-buffer-b)
    (set! (-> consts extra x) (+ gif-buffer-a gif-buffer-b gif-buffer-c))
    (set! (-> consts extra y) 0.0)
    (set! (-> consts extra z) (+ gif-buffer-a gif-buffer-b gif-buffer-c)))
  ;; The two instance input banks are 44 quadwords apart. Each begins with a matrix at 198 or 242;
  ;; its corresponding instance color-index stream begins six quadwords later.
  (set! (-> consts clrbufs vector4w x) 198)
  (set! (-> consts clrbufs vector4w y) 242)
  (set! (-> consts clrbufs vector4w z) 198)
  (set! (-> consts clrbufs vector4w w) 242)
  (set! (-> consts atestgif tag) (new 'static 'gif-tag64 :nloop #x1 :eop #x1 :nreg #x1))
  (set! (-> consts atestgif regs) (new 'static 'gif-tag-regs :regs0 (gif-reg-id a+d)))
  ;; The fragment selector chooses between an alpha-tested translucent pass and the normal state.
  (set! (-> consts atest-tra cmd) (gs-reg test-1))
  (set! (-> consts atest-tra data)
        (the uint
             (new 'static 'gs-test :ate #x1 :atst (gs-atest greater-equal) :aref #x26 :zte #x1 :ztst (gs-ztest greater-equal))))
  (set! (-> consts atest-def cmd) (gs-reg test-1))
  (set! (-> consts atest-def data)
        (the uint (new 'static 'gs-test :atst (gs-atest not-equal) :zte #x1 :ztst (gs-ztest greater-equal))))
  (set! (-> consts misc vector4w x) 0)
  (set! (-> consts misc vector4w y) -1)
  (none))

(defun tie-init-engine ((dma-buf dma-buffer) (test-state gs-test) (alpha-blend int))
  "Append the TIE VU1 upload and initialization packets to dma-buf. This installs the requested GS
   TEST state, uploads the constant block, initializes the microprogram, and configures VIF's ROW,
   BASE/OFFSET, mode, and cycle state for the packed instance stream. alpha-blend controls the geometry
   primitive's ABE bit."
  (when (logtest? *vu1-enable-user* (vu1-renderer-mask tie))
    (dma-buffer-add-vu-function dma-buf tie-vu1-block 1)
    (dma-buffer-add-cnt-vif2 dma-buf #x2 (new 'static 'vif-tag) (new 'static 'vif-tag :imm #x2 :cmd (vif-cmd direct) :msk #x1))
    (let* ((v1-4 dma-buf)
           (direct-gif (the-as gs-gif-tag (-> v1-4 base))))
      (set! (-> direct-gif tag) (new 'static 'gif-tag64 :nloop #x1 :eop #x1 :nreg #x1))
      (set! (-> direct-gif regs) GIF_REGS_ALL_AD)
      (set! (-> v1-4 base) (the-as pointer (&+ direct-gif 16))))
    (let* ((v1-5 dma-buf)
           (test-data (-> v1-5 base)))
      (set! (-> (the-as (pointer gs-test) test-data) 0) test-state)
      (set! (-> (the-as (pointer gs-reg64) test-data) 1) (gs-reg64 test-1))
      (set! (-> v1-5 base) (&+ test-data 16)))
    (let ((constant-qwc 9))
      (let* ((v1-6 dma-buf)
             (constant-packet (the-as dma-packet (-> v1-6 base))))
        (set! (-> constant-packet dma) (new 'static 'dma-tag :id (dma-tag-id cnt) :qwc constant-qwc))
        (set! (-> constant-packet vif0) (new 'static 'vif-tag :cmd (vif-cmd stmod)))
        (set! (-> constant-packet vif1) (new 'static 'vif-tag :imm #x3c6 :cmd (vif-cmd unpack-v4-32) :num constant-qwc))
        (set! (-> v1-6 base) (&+ (the-as pointer constant-packet) 16)))
      (tie-init-consts (the-as tie-consts (-> dma-buf base)) alpha-blend)
      (&+! (-> dma-buf base) (* constant-qwc 16)))
    (dma-buffer-add-cnt-vif2 dma-buf
                             0
                             (new 'static 'vif-tag :imm #x8 :cmd (vif-cmd mscalf) :msk #x1)
                             (new 'static 'vif-tag :cmd (vif-cmd flusha) :msk #x1))
    (dma-buffer-add-cnt-vif2 dma-buf #x2 (new 'static 'vif-tag) (new 'static 'vif-tag :cmd (vif-cmd strow) :msk #x1))
    (let ((row-data (the-as (pointer uint32) (-> dma-buf base))))
      (set-vector! (-> (the-as (inline-array vector4w) row-data) 0) #x4b000000 #x4b000000 #x4b000000 #x4b000000)
      (set! (-> (the-as (pointer vif-tag) row-data) 4) (new 'static 'vif-tag :cmd (vif-cmd base)))
      (set! (-> (the-as (pointer vif-tag) row-data) 5) (new 'static 'vif-tag :imm #x2c :cmd (vif-cmd offset)))
      (set! (-> (the-as (pointer vif-tag) row-data) 6) (new 'static 'vif-tag :cmd (vif-cmd stmod)))
      (set! (-> (the-as (pointer vif-tag) row-data) 7) (new 'static 'vif-tag :imm #x404 :cmd (vif-cmd stcycl)))
      (set! (-> dma-buf base) (&+ (the-as pointer row-data) 32)))
    0)
  0
  (none))

(defun tie-end-buffer ((dma-buf dma-buffer))
  "Append the TIE shutdown packets, restoring the normal GS TEST state and clearing the VIF mask,
   mode, and ROW state changed by tie-init-engine."
  (when (logtest? *vu1-enable-user* (vu1-renderer-mask tie))
    (dma-buffer-add-cnt-vif2 dma-buf #x2 (new 'static 'vif-tag) (new 'static 'vif-tag :imm #x2 :cmd (vif-cmd direct) :msk #x1))
    (dma-buffer-add-gif-tag dma-buf (new 'static 'gif-tag64 :nloop #x1 :eop #x1 :nreg #x1) GIF_REGS_ALL_AD)
    (let* ((v1-5 dma-buf)
           (test-data (-> v1-5 base)))
      (set! (-> (the-as (pointer gs-test) test-data) 0)
            (new 'static 'gs-test :atst (gs-atest not-equal) :zte #x1 :ztst (gs-ztest greater-equal)))
      (set! (-> (the-as (pointer gs-reg64) test-data) 1) (gs-reg64 test-1))
      (set! (-> v1-5 base) (&+ test-data 16)))
    (dma-buffer-add-cnt-vif2 dma-buf #x2 (new 'static 'vif-tag :cmd (vif-cmd stmask)) (new 'static 'vif-tag))
    (let* ((v1-7 dma-buf)
           (reset-data (the-as (pointer uint32) (-> v1-7 base))))
      (set! (-> (the-as (pointer vif-tag) reset-data) 0) (new 'static 'vif-tag :imm #x4 :cmd (vif-cmd mscalf) :msk #x1))
      (set! (-> (the-as (pointer vif-tag) reset-data) 1) (new 'static 'vif-tag :cmd (vif-cmd stmod)))
      (set! (-> (the-as (pointer vif-tag) reset-data) 2) (new 'static 'vif-tag :cmd (vif-cmd flusha) :msk #x1))
      (set! (-> (the-as (pointer vif-tag) reset-data) 3) (new 'static 'vif-tag :cmd (vif-cmd strow) :msk #x1))
      (set! (-> (the-as (pointer vif-tag) reset-data) 4) (new 'static 'vif-tag))
      (set! (-> (the-as (pointer vif-tag) reset-data) 5) (new 'static 'vif-tag))
      (set! (-> (the-as (pointer vif-tag) reset-data) 6) (new 'static 'vif-tag))
      (set! (-> (the-as (pointer vif-tag) reset-data) 7) (new 'static 'vif-tag))
      (set! (-> v1-7 base) (&+ (the-as pointer reset-data) 32)))
    0)
  0
  (none))

;; Register-name tables for the two dumps below. These are the names the program was written
;; against, which makes them the best evidence we have for what each register is for -- but they have
;; drifted. In the shipped microprogram the transform rows live in vf1, vf2, vf12 and vf13 while the
;; four vertex colors live in vf11, vf3, vf4 and vf14, so the entries for 3, 4, 12 and 13 below name
;; the wrong pair. The tables are original code and are left exactly as they are; the aliases in the
;; microprogram follow the instructions instead.

(defun-debug tie-int-reg ((register-index int))
  "Return the source name assigned to a TIE VU1 integer register."
  (let ((i register-index))
    (cond
      ((zero? i) "zero")
      ((= i 1) "itemp")
      ((= i 2) "point-ptr")
      ((= i 3) "clr-ptr")
      ((= i 4) "target-bp1-ptr")
      ((= i 5) "skip-bp2")
      ((= i 6) "target-bp2-ptr")
      ((= i 7) "target-ip1-ptr")
      ((= i 8) "target-ip2-ptr")
      ((= i 9) "ind/ind0")
      ((= i 10) "    ind1")
      ((= i 11) "    ind2")
      ((= i 12) "dest-ptr")
      ((= i 13) "dest2-ptr")
      ((= i 14) "skip-ips")
      ((= i 15) "kick-addr"))))

(defun-debug tie-float-reg ((register-index int))
  "Return the source name assigned to a TIE VU1 floating-point register."
  (let ((i register-index))
    (cond
      ((zero? i) "zero")
      ((= i 1) "t-mtx0")
      ((= i 2) "t-mtx1")
      ((= i 3) "t-mtx2")
      ((= i 4) "t-mtx3")
      ((= i 5) "vtx-0")
      ((= i 6) "vtx-1")
      ((= i 7) "vtx-2")
      ((= i 8) "vtx-3")
      ((= i 9) "pos-0/2")
      ((= i 10) "pos-1/3")
      ((= i 11) "clr-0")
      ((= i 12) "clr-1")
      ((= i 13) "clr-2")
      ((= i 14) "clr-3")
      ((= i 15) "tex-0")
      ((= i 16) "tex-1")
      ((= i 17) "tex-2")
      ((= i 18) "tex-3")
      ((= i 19) "res-0/2")
      ((= i 20) "res-1/3")
      ((= i 21) "gifbuf")
      ((= i 22) "clrbuf")
      ((= i 23) "extra")
      ((= i 24) "inds")
      ((= i 25) "--")
      ((= i 26) "--")
      ((= i 27) "morph")
      ((= i 28) "xyzofs")
      ((= i 29) "clr1")
      ((= i 30) "clr2")
      ((= i 31) "--"))))

(defun-debug tie-ints ()
  "Print the saved TIE VU1 integer-register values with their source names."
  (let ((register-data (the-as (pointer uint32) (+ #x3fa0 #x1100c000))))
    (dotimes (i 16)
      (if (< i 10) (format 0 " "))
      (format 0 "vi~d: ~6d #x~4,'0X ~s~%" i (-> register-data (* i 4)) (-> register-data (* i 4)) (tie-int-reg i))))
  (none))

(defun-debug tie-floats ()
  "Print the saved TIE VU1 floating-point-register values, as words and floats, with their source
   names."
  (let ((register-data (the-as (pointer uint32) (+ #x3da0 #x1100c000))))
    (dotimes (i 32)
      (if (< i 10) (format 0 " "))
      (format 0
              "vf~d: #x~8,'0X #x~8,'0X #x~8,'0X #x~8,'0X "
              i
              (-> register-data (* i 4))
              (-> register-data (+ (* i 4) 1))
              (-> register-data (+ (* i 4) 2))
              (-> register-data (+ (* i 4) 3)))
      (format 0
              "~F ~F ~F ~F ~s~%"
              (-> register-data (* i 4))
              (-> register-data (+ (* i 4) 1))
              (-> register-data (+ (* i 4) 2))
              (-> register-data (+ (* i 4) 3))
              (tie-float-reg i))))
  (none))

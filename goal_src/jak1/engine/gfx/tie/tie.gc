            (vu-pair (sq.xyzw res-02 dest2-ptr 2) (nop)) ;; #x21f
            (vu-pair (b finalize-and-kick-gif) (nop)) ;; #x220
            (vu-pair (nop) (nop)) ;; #x221
            ;; Entry 0, interpolated-point path. This is where TIE changes level of detail, and it does it by
            ;; un-tessellating the mesh continuously rather than by swapping one for another.
            ;;
            ;; An ip is a vertex that only exists because an edge was split. Its record is three consecutive
            ;; quadwords once VIF has unpacked the point stream as V4-16, against two for a base point,
            ;; matching generic-tie-interp-point and generic-tie-base-point respectively:
            ;;
            ;;     +0   -> vtx-N     xyz: the displacement that puts this vertex back on the edge it
            ;;                       subdivides.  w: its output slot.
            ;;     +1   -> xyzofs    xyz: where it was actually authored.  w is not read.
            ;;     +2   -> tex-N     ST, with the second output slot in w.
            ;;
            ;; Two instructions do the whole morph:
            ;;
            ;;     (mulx.xyz vtx-0 vtx-0 morph)     ;; the +0 quadword, scaled by the morph weight
            ;;     (add.xyzw vtx-0 vtx-0 xyzofs)    ;; plus the +1 quadword, unscaled
            ;;
            ;; so position = authored + t * displacement with t = morph.x. t is zero at the near edge of
            ;; the instance's LOD band and one at the far edge, so up close only the authored position
            ;; contributes and by the far edge the vertex has slid onto its parents' edge -- exactly the
            ;; surface the next-coarser geometry has, leaving the triangles about to vanish degenerate.
            ;; (The coarsest geometry uses far-morph, whose x is 1, which is what fixes the direction:
            ;; t = 1 is the collapsed end, not the detailed one.)
            ;;
            ;; xyzofs is the original name for this register, and it names the role rather than the
            ;; contents: it is the register added to xyz. Its w lane really is an offset -- it carries the
            ;; output bank's biased address into the same add -- but its xyz is a position.
            ;;
            ;; generic-tie-interp-point names these two vectors the other way round, with the plain x/y/z
            ;; on the one this loop scales. Those are real names out of the game's type information, so
            ;; they may simply be backwards, or that type may only ever have described the Generic
            ;; converter's own copy of the geometry. There is no type for this stream to compare against.
            ;;
            ;; The color follows the same interpolation, and this is what gives away the parentage: inds
            ;; carries three palette indices for an ip rather than one. clr-0 is the vertex's own color, and
            ;; clr1 and clr2 are the two parents. The two parents are averaged first -- morph.y is forced to
            ;; 0.5 right here for that one purpose -- and then
            ;;
            ;;     color = own * morph.z + average(parent1, parent2) * morph.w
            ;;
            ;; with morph.z starting at 256 and falling to 0 while morph.w does the reverse. At t = 1 the
            ;; vertex carries exactly the shading of the edge it has collapsed onto, so the coarser mesh's
            ;; interpolation across that edge is reproduced exactly.
            ;;
            ;; The 0.5 is an immediate in this program, not a value the exporter picks, so the color always
            ;; lands on the plain average of the two parents. The position displacement is authored data and
            ;; is under no such constraint -- so the shading assumes the collapse target is the edge
            ;; midpoint even though nothing here enforces it.
            ;;
            ;; Those weights sum to 256 rather than 1.0, which looks wrong until you remember that a palette
            ;; entry is a 2^23-biased float carrying its color in the low mantissa bits. Weights summing to
            ;; 256 raise the exponent by eight, so the mantissa of the result already holds the weighted sum
            ;; divided by 256 and the low byte of each lane is the blended channel. The GS reads only that
            ;; byte out of RGBAQ, so the leftover exponent bits cost nothing. One multiply-add, no
            ;; normalization, no unpack, no clamp.
            ;;
            ;; Note also that an ip burns a whole quadword of the index stream for its three indices while
            ;; base points pack four per quadword. That is what tie-fragment.base-colors is counting.
            ;;
            ;; Same tail problem as the base-point path, same answer: a variant per slot.
            (label begin-morph-stream)
            (vu-pair (lqi.xyzw vtx-0 point-ptr) (nop)) ;; #x222
            (vu-pair (0.5) (subw.w xyzofs vf00 vf00 :i)) ;; #x223
            (vu-pair (lqi.xyz xyzofs point-ptr) (addi.y morph vf00 I)) ;; #x224
            (vu-pair (lqi.xyzw tex-0 point-ptr) (nop)) ;; #x225
            (vu-pair (mtir ind0 inds.x) (nop)) ;; #x226
            (vu-pair (mtir ind1 inds.y) (addx.w xyzofs xyzofs gifbuf)) ;; #x227
            (vu-pair (mtir ind2 inds.z) (mulx.xyz vtx-0 vtx-0 morph)) ;; #x228
            (vu-pair (nop) (nop)) ;; #x229
            (vu-pair (lq.xyzw clr-0 ind0 TIE-VU-PALETTE-BASE) (nop)) ;; #x22a
            (vu-pair (lq.xyzw clr1 ind1 TIE-VU-PALETTE-BASE) (add.xyzw vtx-0 vtx-0 xyzofs)) ;; #x22b
            (vu-pair (lq.xyzw clr2 ind2 TIE-VU-PALETTE-BASE) (nop)) ;; #x22c
            (vu-pair (nop) (nop)) ;; #x22d
            (vu-pair (nop) (nop)) ;; #x22e
            (vu-pair (nop) (mulay.xyzw ACC clr1 morph)) ;; #x22f
            (vu-pair (lqi.xyzw inds clr-ptr) (maddy.xyzw clr1 clr2 morph)) ;; #x230
            (vu-pair (lqi.xyzw vtx-1 point-ptr) (mulaw.xyzw ACC t-mtx3 vf00)) ;; #x231
            (vu-pair (lqi.xyz xyzofs point-ptr) (maddax.xyzw ACC t-mtx0 vtx-0)) ;; #x232
            (vu-pair (lqi.xyzw tex-1 point-ptr) (madday.xyzw ACC t-mtx1 vtx-0)) ;; #x233
            (vu-pair (nop) (maddz.xyzw pos-02 t-mtx2 vtx-0)) ;; #x234
            (vu-pair (mtir ind0 inds.x) (mulaw.xyzw ACC clr1 morph)) ;; #x235
            (vu-pair (mtir ind1 inds.y) (maddz.xyzw clr-0 clr-0 morph)) ;; #x236
            (vu-pair (mtir ind2 inds.z) (mulx.xyz vtx-1 vtx-1 morph)) ;; #x237
            (vu-pair (nop) (nop)) ;; #x238
            (vu-pair (lq.xyzw clr-1 ind0 TIE-VU-PALETTE-BASE) (nop)) ;; #x239
            (vu-pair (lq.xyzw clr1 ind1 TIE-VU-PALETTE-BASE) (add.xyzw vtx-1 vtx-1 xyzofs)) ;; #x23a
            (vu-pair (lq.xyzw clr2 ind2 TIE-VU-PALETTE-BASE) (nop)) ;; #x23b
            (vu-pair (div Q vf00.w pos-02.w) (nop)) ;; #x23c
            (vu-pair (nop) (nop)) ;; #x23d
            (vu-pair (nop) (mulay.xyzw ACC clr1 morph)) ;; #x23e
            (vu-pair (lqi.xyzw inds clr-ptr) (maddy.xyzw clr1 clr2 morph)) ;; #x23f
            (vu-pair (lqi.xyzw vtx-2 point-ptr) (mulaw.xyzw ACC t-mtx3 vf00)) ;; #x240
            (vu-pair (lqi.xyz xyzofs point-ptr) (maddax.xyzw ACC t-mtx0 vtx-1)) ;; #x241
            (vu-pair (lqi.xyzw tex-2 point-ptr) (madday.xyzw ACC t-mtx1 vtx-1)) ;; #x242
            (vu-pair (nop) (maddz.xyzw pos-13 t-mtx2 vtx-1)) ;; #x243
            (vu-pair (mtir ind0 inds.x) (mulaw.xyzw ACC clr1 morph)) ;; #x244
            (vu-pair (mtir ind1 inds.y) (mulx.xyz vtx-2 vtx-2 morph)) ;; #x245
            (vu-pair (mtir ind2 inds.z) (maddz.xyzw clr-1 clr-1 morph)) ;; #x246
            (vu-pair (nop) (mul.xyz res-02 pos-02 Q)) ;; #x247
            (vu-pair (lq.xyzw clr-2 ind0 TIE-VU-PALETTE-BASE) (mul.xyz tex-0 tex-0 Q)) ;; #x248
            (vu-pair (lq.xyzw clr1 ind1 TIE-VU-PALETTE-BASE) (add.xyzw vtx-2 vtx-2 xyzofs)) ;; #x249
            (vu-pair (lq.xyzw clr2 ind2 TIE-VU-PALETTE-BASE) (nop)) ;; #x24a
            (vu-pair (div Q vf00.w pos-13.w) (ftoi4.xyz res-02 res-02)) ;; #x24b
            (vu-pair (nop) (nop)) ;; #x24c
            (vu-pair (b morph-pipeline-slot3) (mulay.xyzw ACC clr1 morph)) ;; #x24d
            (vu-pair (lqi.xyzw inds clr-ptr) (maddy.xyzw clr1 clr2 morph)) ;; #x24e
            (label morph-pipeline-slot0)
            (vu-pair (lqi.xyzw vtx-1 point-ptr) (nop)) ;; #x24f
            (vu-pair (lqi.xyzw inds clr-ptr) (subw.w xyzofs vf00 vf00)) ;; #x250
            (vu-pair (0.5) (nop :i)) ;; #x251
            (vu-pair (lqi.xyz xyzofs point-ptr) (addi.y morph vf00 I)) ;; #x252
            (vu-pair (lqi.xyzw tex-1 point-ptr) (nop)) ;; #x253
            (vu-pair (mtir ind0 inds.x) (addx.w xyzofs xyzofs gifbuf)) ;; #x254
            (vu-pair (mtir ind1 inds.y) (nop)) ;; #x255
            (vu-pair (mtir ind2 inds.z) (mulx.xyz vtx-1 vtx-1 morph)) ;; #x256
            (vu-pair (nop) (nop)) ;; #x257
            (vu-pair (lq.xyzw clr-1 ind0 TIE-VU-PALETTE-BASE) (nop)) ;; #x258
            (vu-pair (lq.xyzw clr1 ind1 TIE-VU-PALETTE-BASE) (add.xyzw vtx-1 vtx-1 xyzofs)) ;; #x259
            (vu-pair (lq.xyzw clr2 ind2 TIE-VU-PALETTE-BASE) (nop)) ;; #x25a
            (vu-pair (nop) (nop)) ;; #x25b
            (vu-pair (nop) (nop)) ;; #x25c
            (vu-pair (nop) (mulay.xyzw ACC clr1 morph)) ;; #x25d
            (vu-pair (lqi.xyzw inds clr-ptr) (maddy.xyzw clr1 clr2 morph)) ;; #x25e
            (vu-pair (lqi.xyzw vtx-2 point-ptr) (mulaw.xyzw ACC t-mtx3 vf00)) ;; #x25f
            (vu-pair (lqi.xyz xyzofs point-ptr) (maddax.xyzw ACC t-mtx0 vtx-1)) ;; #x260
            (vu-pair (lqi.xyzw tex-2 point-ptr) (madday.xyzw ACC t-mtx1 vtx-1)) ;; #x261
            (vu-pair (nop) (maddz.xyzw pos-13 t-mtx2 vtx-1)) ;; #x262
            (vu-pair (mtir ind0 inds.x) (mulaw.xyzw ACC clr1 morph)) ;; #x263
            (vu-pair (mtir ind1 inds.y) (maddz.xyzw clr-1 clr-1 morph)) ;; #x264
            (vu-pair (mtir ind2 inds.z) (mulx.xyz vtx-2 vtx-2 morph)) ;; #x265
            (vu-pair (nop) (nop)) ;; #x266
            (vu-pair (lq.xyzw clr-2 ind0 TIE-VU-PALETTE-BASE) (nop)) ;; #x267
            (vu-pair (lq.xyzw clr1 ind1 TIE-VU-PALETTE-BASE) (add.xyzw vtx-2 vtx-2 xyzofs)) ;; #x268
            (vu-pair (lq.xyzw clr2 ind2 TIE-VU-PALETTE-BASE) (nop)) ;; #x269
            (vu-pair (div Q vf00.w pos-13.w) (nop)) ;; #x26a
            (vu-pair (nop) (nop)) ;; #x26b
            (vu-pair (nop) (mulay.xyzw ACC clr1 morph)) ;; #x26c
            (vu-pair (lqi.xyzw inds clr-ptr) (maddy.xyzw clr1 clr2 morph)) ;; #x26d
            (vu-pair (lqi.xyzw vtx-3 point-ptr) (mulaw.xyzw ACC t-mtx3 vf00)) ;; #x26e
            (vu-pair (lqi.xyz xyzofs point-ptr) (maddax.xyzw ACC t-mtx0 vtx-2)) ;; #x26f
            (vu-pair (lqi.xyzw tex-3 point-ptr) (madday.xyzw ACC t-mtx1 vtx-2)) ;; #x270
            (vu-pair (nop) (maddz.xyzw pos-02 t-mtx2 vtx-2)) ;; #x271
            (vu-pair (mtir ind0 inds.x) (mulaw.xyzw ACC clr1 morph)) ;; #x272
            (vu-pair (mtir ind1 inds.y) (mulx.xyz vtx-3 vtx-3 morph)) ;; #x273
            (vu-pair (mtir ind2 inds.z) (maddz.xyzw clr-2 clr-2 morph)) ;; #x274
            (vu-pair (nop) (mul.xyz res-13 pos-13 Q)) ;; #x275
            (vu-pair (lq.xyzw clr-3 ind0 TIE-VU-PALETTE-BASE) (mul.xyz tex-1 tex-1 Q)) ;; #x276
            (vu-pair (lq.xyzw clr1 ind1 TIE-VU-PALETTE-BASE) (add.xyzw vtx-3 vtx-3 xyzofs)) ;; #x277
            (vu-pair (lq.xyzw clr2 ind2 TIE-VU-PALETTE-BASE) (nop)) ;; #x278
            (vu-pair (div Q vf00.w pos-02.w) (ftoi4.xyz res-13 res-13)) ;; #x279
            (vu-pair (nop) (nop)) ;; #x27a
            (vu-pair (b morph-final-slot0) (mulay.xyzw ACC clr1 morph)) ;; #x27b
            (vu-pair (lqi.xyzw inds clr-ptr) (maddy.xyzw clr1 clr2 morph)) ;; #x27c
            (label morph-pipeline-slot1)
            (vu-pair (lqi.xyzw vtx-2 point-ptr) (nop)) ;; #x27d

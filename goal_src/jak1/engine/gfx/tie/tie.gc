            (vu-pair (sq.xyzw res-13 dest-ptr 2) (nop)) ;; #x1d9
            (vu-pair (iaddi point-ptr point-ptr -0x1) (ftoi4.xyz res-02 pos-02)) ;; #x1da
            (vu-pair (nop) (nop)) ;; #x1db
            (vu-pair (nop) (nop)) ;; #x1dc
            (vu-pair (nop) (mul.xyz pos-13 pos-13 Q)) ;; #x1dd
            (vu-pair (mtir dest-ptr vtx-2.w) (mul.xyz tex-3 tex-3 Q)) ;; #x1de
            (vu-pair (mtir dest2-ptr vtx-3.w) (nop)) ;; #x1df
            (vu-pair (sq.xyzw tex-2 dest-ptr 0) (nop)) ;; #x1e0
            (vu-pair (sq.xyzw clr-2 dest-ptr 1) (nop)) ;; #x1e1
            (vu-pair (sq.xyzw res-02 dest-ptr 2) (ftoi4.xyz res-13 pos-13)) ;; #x1e2
            (vu-pair (sq.xyzw tex-3 dest2-ptr 0) (nop)) ;; #x1e3
            (vu-pair (sq.xyzw clr-3 dest2-ptr 1) (nop)) ;; #x1e4
            (vu-pair (ibeq vi00 skip-ips begin-morph-stream) (nop)) ;; #x1e5
            (vu-pair (sq.xyzw res-13 dest2-ptr 2) (nop)) ;; #x1e6
            (vu-pair (b finalize-and-kick-gif) (nop)) ;; #x1e7
            (vu-pair (nop) (nop)) ;; #x1e8
            (label basic-short-slot3)
            (vu-pair (div Q vf00.w pos-02.w) (addx.w vtx-3 vtx-3 gifbuf)) ;; #x1e9
            (vu-pair (sq.xyzw tex-2 dest-ptr 0) (addx.w vtx-0 vtx-0 gifbuf)) ;; #x1ea
            (vu-pair (sq.xyzw clr-2 dest-ptr 1) (nop)) ;; #x1eb
            (vu-pair (sq.xyzw res-02 dest-ptr 2) (nop)) ;; #x1ec
            (vu-pair (iaddi point-ptr point-ptr -0x1) (ftoi4.xyz res-13 pos-13)) ;; #x1ed

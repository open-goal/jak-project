;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/math/matrix.gc")
(require "engine/game/main-h.gc")
(require "engine/gfx/math-camera-h.gc")
(require "engine/gfx/hw/gs.gc")

;; TIE near -- the version of TIE for geometry close enough to touch the camera.
;;
;; Ordinary TIE is allowed to be careless about the view volume: it either rejects a fragment
;; outright or projects it and lets the GS scissor the result. That stops working the moment a
;; triangle straddles the camera plane, because dividing by a w near zero throws coordinates off to
;; infinity and the GS has no way to recover. So the instance pass hands anything that comes near the
;; guard volume to this renderer instead, which keeps positions homogeneous long enough to clip them
;; properly.
;;
;; The fast path is unchanged: whole triangles inside the guard volume go through the same four-wide
;; strip pipeline as ordinary TIE. Only the awkward ones are expensive. A triangle sharing an outside
;; plane with all three vertices is thrown away; a triangle that actually crosses is copied into the
;; work area and run through six Sutherland-Hodgman passes -- plus and minus x, y, z -- then emitted
;; as a triangle fan. Every vertex generated on the way interpolates homogeneous position, packed
;; color, and STQ with the same edge parameter, so the new edges match the old ones exactly.
;;
;; The clipper is written as one polygon loop plus six two-instruction subroutines, one per plane,
;; whose addresses are installed into the plane records by entry 8. That is why the plane records have
;; a code pointer in them.
;;
;; On PC the graphics API clips primitives itself, so the port keeps this renderer disabled and lets
;; ordinary TIE draw everything.

;; DECOMP BEGINS

;; The eleven constant quadwords uploaded to VU1 966 through 976. Declaration order is upload order,
;; so each field's index below is its VU address minus 966.
(deftype tie-near-consts (structure)
  ((extra     qword :inline) ;; x,z: sum of the three GIF bank addresses
   (gifbufs   qword :inline) ;; the two GIF banks this fragment owns
   (clrbufs   qword :inline) ;; the two instance-record input banks
   (adgif     gs-gif-tag :inline) ;; five-register A+D tag for a shader
   (strgif    gs-gif-tag :inline) ;; tag for an unclipped triangle strip
   (fangif    gs-gif-tag :inline) ;; tag for a clipped triangle fan; selected by index off strgif
   (hvdfoffs  vector :inline) ;; screen-space offset added after perspective divide
   (invhscale vector :inline) ;; undoes the homogeneous clip scale once a vertex survives
   (guard     vector :inline) ;; guard-volume half-extents used to widen the clip planes
   (atest     ad-cmd 2 :inline)
   (atest-tra ad-cmd :inline :overlay-at (-> atest 0)) ;; alpha-tested translucent pass
   (atest-def ad-cmd :inline :overlay-at (-> atest 1)))) ;; ordinary opaque pass

;; The near path shares TIE's VU memory map up to the palette; from 966 it diverges.
;;
;;   966 - 976   tie-near-consts
;;   977 - 1017  six seven-quadword clipping-plane slots
;;  1019 - 1022  deferred-edge stack for the polygon walk
;;      1023     saved pipeline state for resuming an interrupted strip
(defconstant TIE-NEAR-VU-PALETTE-BASE 838)

;; tie-near-consts is uploaded as one eleven-quadword block and its field order is its upload order, so
;; the addresses come from the type instead of eleven hand-written constants that could drift from it.
(defconstant TIE-NEAR-VU-CONSTS 966)

(defmacro tie-near-const (&rest path)
  `(+ TIE-NEAR-VU-CONSTS (/ (offset-of tie-near-consts ,@path) 16)))

;; One clipping-plane record, seven quadwords: the first vertex of the output polygon, the current
;; vertex, the address of that plane's signed-distance subroutine, and room for the generated
;; boundary vertices. The six records are contiguous so the polygon loop can walk them with one
;; stride, and entry 8 clears them and installs the six subroutine addresses.
(defconstant TIE-NEAR-VU-CLIP-PLANE-X-POS 977)

(defconstant TIE-NEAR-VU-CLIP-PLANE-X-NEG 984)

(defconstant TIE-NEAR-VU-CLIP-PLANE-Y-POS 991)

(defconstant TIE-NEAR-VU-CLIP-PLANE-Y-NEG 998)

(defconstant TIE-NEAR-VU-CLIP-PLANE-Z-POS 1005)

(defconstant TIE-NEAR-VU-CLIP-PLANE-Z-NEG 1012)

;; Edges whose far end has to wait until the near end is emitted are pushed here. The pop form
;; addresses the stack one entry low so the index decrement comes for free.
(defconstant TIE-NEAR-VU-EDGE-STACK 1019)

(defconstant TIE-NEAR-VU-EDGE-STACK-POP 1018)

;; Where the strip pipeline parks its phase before diving into the clipper, so a crossing triangle in
;; the middle of a four-vertex group can be handled and the group resumed exactly where it stopped.
(defconstant TIE-NEAR-VU-CLIP-STATE 1023)

;; Entry points match ordinary TIE so the two renderers can share the prototype packet builder:
;; 0 render an instance stream, 2 finish and kick the current GIF bank, 4 empty (wait for the
;; previous invocation), 6 install a fragment's templates, 8 initialize the persistent buffers --
;; and, unique to this program, clear the six clipping-plane records and install their
;; signed-distance subroutine addresses.
(#when PC_PORT
  (define tie-near-vu1-block (new 'static 'vu-function :length 0 :qlength 0)))

(#unless PC_PORT
  (defvu1 tie-near-vu1-block
          ;; Registers are named in two groups, because this program is really two programs sharing a
          ;; register file: the four-wide strip pipeline it inherits from ordinary TIE, and the polygon
          ;; clipper. The two do not agree about anything except the three persistent buffer registers,
          ;; so a single name per register would be wrong half the time and everything else keeps its
          ;; physical spelling.
          ;;
          ;; tie-near-float-reg and tie-near-int-reg below are the tables the program was written
          ;; against and are the source of invh and hvdfnc, but they have drifted: they describe the
          ;; clipper, where the strip pipeline has vf15 as a palette color and vf27/vf28 as GIF tags.
          (rlet ((gifbuf :reg vf21) ;; biased addresses of the two GIF banks this fragment owns
                 (clrbuf :reg vf22) ;; alternating instance-record input-bank addresses
                 (extra :reg vf23) ;; sum of the three GIF addresses, plus saved output cursors
                 ;; The polygon clipper, from setup-polygon-clip to the end of the program. Derived from
                 ;; interpolate-clip-vertex and the six distance subroutines rather than from the table.
                 (edge-p0 :reg vf18) ;; homogeneous position of the edge's first vertex
                 (edge-p1 :reg vf19) ;; and of its second
                 (edge-clr0 :reg vf27) ;; packed color of each endpoint
                 (edge-clr1 :reg vf28)
                 (edge-stq0 :reg vf24) ;; xyz: texture STQ. w: signed distance to the plane being clipped
                 (edge-stq1 :reg vf25) ;; the same, except w is overwritten with d0 - d1 for the divide
                 (new-p :reg vf20) ;; the boundary vertex this edge generates
                 (new-clr :reg vf29)
                 (new-stq :reg vf26)
                 (invh :reg vf14) ;; inverse homogeneous scale, undone once a vertex survives clipping
                 (hvdfnc :reg vf16) ;; screen-space offset added after the perspective divide
                 )
          (vu-pair (b render-basic-stream) (nop)) ;; #x000
          (vu-pair (mr32.xyzw gifbuf gifbuf) (nop)) ;; #x001
          (vu-pair (b finish-current-gif-buffer) (nop)) ;; #x002
          (vu-pair (nop) (nop)) ;; #x003
          (vu-pair (nop) (nop :e)) ;; #x004
          (vu-pair (nop) (nop)) ;; #x005
          (vu-pair (b initialize-fragment-templates) (nop)) ;; #x006
          (vu-pair (iaddi vi02 vi00 0x0) (subx.xz gifbuf extra gifbuf)) ;; #x007
          (vu-pair (b initialize-near-state) (nop)) ;; #x008
          (vu-pair (nop) (nop)) ;; #x009
          (label initialize-near-state)
          ;; Entry 8's own work, on top of the persistent buffer registers: clear the six clipping-plane
          ;; slots and install each plane's signed-distance subroutine address into the z lane of its
          ;; slot's header. One polygon loop then serves all six planes by calling through that lane, which
          ;; is why the addresses have to be materialized as immediates here.
          ;;
          ;; A slot is seven quadwords. Header lane roles, from the walk in close-polygon:
          ;;
          ;;     +0  x: address of the last vertex this plane emitted
          ;;         y: address of the first, so the loop can close the polygon back onto it
          ;;         z: this plane's signed-distance subroutine
          ;;     +1 .. +3   first vertex generated at this plane: position, color, STQ
          ;;     +4 .. +6   second, when one edge produces two
          (vu-pair (lq.xyzw gifbuf vi00 (tie-near-const gifbufs)) (nop)) ;; #x00a
          (vu-pair (lq.xz extra vi00 (tie-near-const extra)) (nop)) ;; #x00b
          (vu-pair (lq.xyzw clrbuf vi00 (tie-near-const clrbufs)) (nop)) ;; #x00c
          (vu-pair (sq.xyzw vf00 vi00 TIE-NEAR-VU-CLIP-PLANE-X-POS) (nop)) ;; #x00d
          (vu-pair (sq.xyzw vf00 vi00 TIE-NEAR-VU-CLIP-PLANE-X-NEG) (nop)) ;; #x00e
          (vu-pair (sq.xyzw vf00 vi00 TIE-NEAR-VU-CLIP-PLANE-Y-POS) (nop)) ;; #x00f
          (vu-pair (sq.xyzw vf00 vi00 TIE-NEAR-VU-CLIP-PLANE-Y-NEG) (nop)) ;; #x010
          (vu-pair (sq.xyzw vf00 vi00 TIE-NEAR-VU-CLIP-PLANE-Z-POS) (nop)) ;; #x011
          (vu-pair (sq.xyzw vf00 vi00 TIE-NEAR-VU-CLIP-PLANE-Z-NEG) (nop)) ;; #x012
          (vu-pair (iaddiu vi01 vi00 (vu-label positive-x-distance)) (nop)) ;; #x013
          (vu-pair (isw.z vi01 vi00 TIE-NEAR-VU-CLIP-PLANE-X-POS) (nop)) ;; #x014
          (vu-pair (iaddiu vi01 vi00 (vu-label negative-x-distance)) (nop)) ;; #x015
          (vu-pair (isw.z vi01 vi00 TIE-NEAR-VU-CLIP-PLANE-X-NEG) (nop)) ;; #x016
          (vu-pair (iaddiu vi01 vi00 (vu-label positive-y-distance)) (nop)) ;; #x017
          (vu-pair (isw.z vi01 vi00 TIE-NEAR-VU-CLIP-PLANE-Y-POS) (nop)) ;; #x018
          (vu-pair (iaddiu vi01 vi00 (vu-label negative-y-distance)) (nop)) ;; #x019
          (vu-pair (isw.z vi01 vi00 TIE-NEAR-VU-CLIP-PLANE-Y-NEG) (nop)) ;; #x01a
          (vu-pair (iaddiu vi01 vi00 (vu-label positive-z-distance)) (nop)) ;; #x01b
          (vu-pair (isw.z vi01 vi00 TIE-NEAR-VU-CLIP-PLANE-Z-POS) (nop)) ;; #x01c
          (vu-pair (iaddiu vi01 vi00 (vu-label negative-z-distance)) (nop :e)) ;; #x01d
          (vu-pair (isw.z vi01 vi00 TIE-NEAR-VU-CLIP-PLANE-Z-NEG) (nop)) ;; #x01e
          (label initialize-fragment-templates)
          (vu-pair (lq.xyz vf01 vi00 (tie-near-const adgif)) (nop)) ;; #x01f
          (vu-pair (ilwr.w vi04 vi02) (nop)) ;; #x020
          (vu-pair (ilw.w vi09 vi02 1) (nop)) ;; #x021
          (vu-pair (mtir vi06 gifbuf.y) (nop)) ;; #x022
          (vu-pair (lqi.xyzw vf02 vi02) (suby.xz gifbuf gifbuf gifbuf)) ;; #x023
          (vu-pair (lqi.xyzw vf03 vi02) (nop)) ;; #x024
          (vu-pair (lqi.xyzw vf04 vi02) (nop)) ;; #x025
          (vu-pair (lqi.xyzw vf05 vi02) (nop)) ;; #x026
          (vu-pair (mtir vi05 gifbuf.x) (nop)) ;; #x027
          (vu-pair (lqi.xyzw vf06 vi02) (subw.w vf01 vf01 vf01)) ;; #x028
          (label copy-adgif-templates)
          (vu-pair (iadd vi03 vi04 vi05) (nop)) ;; #x029
          (vu-pair (iadd vi04 vi04 vi06) (nop)) ;; #x02a
          (vu-pair (iaddi vi09 vi09 -0x1) (nop)) ;; #x02b
          (vu-pair (sqi.xyzw vf01 vi03) (nop)) ;; #x02c
          (vu-pair (sqi.xyzw vf02 vi03) (nop)) ;; #x02d
          (vu-pair (sqi.xyzw vf03 vi03) (nop)) ;; #x02e
          (vu-pair (sqi.xyzw vf04 vi03) (nop)) ;; #x02f
          (vu-pair (sqi.xyzw vf05 vi03) (nop)) ;; #x030
          (vu-pair (sqi.xyzw vf06 vi03) (nop)) ;; #x031
          (vu-pair (sqi.xyzw vf01 vi04) (nop)) ;; #x032
          (vu-pair (sqi.xyzw vf02 vi04) (nop)) ;; #x033
          (vu-pair (sqi.xyzw vf03 vi04) (nop)) ;; #x034
          (vu-pair (sqi.xyzw vf04 vi04) (nop)) ;; #x035
          (vu-pair (sqi.xyzw vf05 vi04) (nop)) ;; #x036
          (vu-pair (sqi.xyzw vf06 vi04) (nop)) ;; #x037
          (vu-pair (ilwr.w vi04 vi02) (nop)) ;; #x038
          (vu-pair (lqi.xyzw vf02 vi02) (nop)) ;; #x039
          (vu-pair (lqi.xyzw vf03 vi02) (nop)) ;; #x03a
          (vu-pair (lqi.xyzw vf04 vi02) (nop)) ;; #x03b
          (vu-pair (lqi.xyzw vf05 vi02) (nop)) ;; #x03c
          (vu-pair (ibgtz vi09 copy-adgif-templates) (nop)) ;; #x03d
          (vu-pair (lqi.xyzw vf06 vi02) (nop)) ;; #x03e
          (vu-pair (mtir vi09 vf02.w) (nop)) ;; #x03f
          (vu-pair (iaddi vi02 vi02 -0x2) (subw.w vf07 vf07 vf07)) ;; #x040
          (vu-pair (ilwr.x vi07 vi02) (nop)) ;; #x041
          (vu-pair (ilwr.y vi08 vi02) (nop)) ;; #x042
          (vu-pair (ilwr.z vi04 vi02) (nop)) ;; #x043
          (vu-pair (iaddi vi09 vi09 -0x1) (nop)) ;; #x044
          (vu-pair (iaddi vi02 vi02 0x1) (nop)) ;; #x045
          (vu-pair (ibeq vi00 vi09 finish-template-copy) (nop)) ;; #x046
          (vu-pair (lq.xyz vf07 vi08 (tie-near-const strgif)) (nop)) ;; #x047
          (label copy-strip-templates)
          (vu-pair (iadd vi03 vi04 vi05) (nop)) ;; #x048
          (vu-pair (iadd vi04 vi04 vi06) (nop)) ;; #x049
          (vu-pair (iaddi vi09 vi09 -0x1) (nop)) ;; #x04a
          (vu-pair (sq.xyzw vf07 vi03 0) (nop)) ;; #x04b
          (vu-pair (iswr.x vi07 vi03) (nop)) ;; #x04c
          (vu-pair (sq.xyzw vf07 vi04 0) (nop)) ;; #x04d
          (vu-pair (iswr.x vi07 vi04) (nop)) ;; #x04e
          (vu-pair (ilwr.x vi07 vi02) (nop)) ;; #x04f
          (vu-pair (ilwr.y vi08 vi02) (nop)) ;; #x050
          (vu-pair (ilwr.z vi04 vi02) (nop)) ;; #x051
          (vu-pair (iaddi vi02 vi02 0x1) (nop)) ;; #x052
          (vu-pair (ibne vi00 vi09 copy-strip-templates) (nop)) ;; #x053
          (vu-pair (lq.xyz vf07 vi08 (tie-near-const strgif)) (nop)) ;; #x054
          (label finish-template-copy)
          (vu-pair (iaddiu vi07 vi07 0x4000) (nop)) ;; #x055
          (vu-pair (iaddiu vi07 vi07 0x4000) (nop)) ;; #x056
          (vu-pair (iadd vi03 vi04 vi05) (nop)) ;; #x057
          (vu-pair (iadd vi04 vi04 vi06) (nop)) ;; #x058
          (vu-pair (sq.xyzw vf07 vi03 0) (nop)) ;; #x059
          (vu-pair (iswr.x vi07 vi03) (nop)) ;; #x05a
          (vu-pair (sq.xyzw vf07 vi04 0) (nop)) ;; #x05b
          (vu-pair (iswr.x vi07 vi04) (nop)) ;; #x05c
          (vu-pair (mtir vi12 vf04.x) (nop)) ;; #x05d
          (vu-pair (mtir vi13 vf04.y) (nop)) ;; #x05e
          (vu-pair (iaddiu vi11 vi00 0x32) (nop)) ;; #x05f
          (vu-pair (64.0) (nop :i)) ;; #x060
          (vu-pair (iaddiu vi12 vi12 0x32) (nop)) ;; #x061
          (vu-pair (lqi.xyzw vf06 vi11) (nop)) ;; #x062
          (vu-pair (lqi.xyzw vf12 vi11) (nop)) ;; #x063
          (vu-pair (nop) (nop)) ;; #x064
          (vu-pair (nop) (nop)) ;; #x065
          (vu-pair (nop) (itof0.xyzw vf06 vf06)) ;; #x066
          (vu-pair (lqi.xyzw vf07 vi11) (itof12.xyz vf12 vf12)) ;; #x067
          (vu-pair (lqi.xyzw vf13 vi11) (itof0.w vf12 vf12)) ;; #x068
          (vu-pair (nop) (nop)) ;; #x069
          (vu-pair (ibeq vi12 vi11 prepare-instance-stream) (muli.xyz vf06 vf06 I)) ;; #x06a
          (vu-pair (nop) (itof0.xyzw vf07 vf07)) ;; #x06b
          (label convert-packed-control-points)
          (vu-pair (lqi.xyzw vf08 vi11) (itof12.xyz vf13 vf13)) ;; #x06c
          (vu-pair (lqi.xyzw vf14 vi11) (itof0.w vf13 vf13)) ;; #x06d
          (vu-pair (sq.xyzw vf12 vi11 -5) (nop)) ;; #x06e
          (vu-pair (ibeq vi12 vi11 prepare-instance-stream) (muli.xyz vf07 vf07 I)) ;; #x06f
          (vu-pair (sq.xyzw vf06 vi11 -6) (itof0.xyzw vf08 vf08)) ;; #x070
          (vu-pair (lqi.xyzw vf06 vi11) (itof12.xyz vf14 vf14)) ;; #x071
          (vu-pair (lqi.xyzw vf12 vi11) (itof0.w vf14 vf14)) ;; #x072
          (vu-pair (sq.xyzw vf13 vi11 -5) (nop)) ;; #x073
          (vu-pair (ibeq vi12 vi11 prepare-instance-stream) (muli.xyz vf08 vf08 I)) ;; #x074
          (vu-pair (sq.xyzw vf07 vi11 -6) (itof0.xyzw vf06 vf06)) ;; #x075
          (vu-pair (lqi.xyzw vf07 vi11) (itof12.xyz vf12 vf12)) ;; #x076
          (vu-pair (lqi.xyzw vf13 vi11) (itof0.w vf12 vf12)) ;; #x077
          (vu-pair (sq.xyzw vf14 vi11 -5) (nop)) ;; #x078
          (vu-pair (ibne vi12 vi11 convert-packed-control-points) (muli.xyz vf06 vf06 I)) ;; #x079
          (vu-pair (sq.xyzw vf08 vi11 -6) (itof0.xyzw vf07 vf07)) ;; #x07a
          (label prepare-instance-stream)
          (vu-pair (iaddi vi11 vi11 -0x4) (nop)) ;; #x07b
          (vu-pair (iadd vi13 vi13 vi11) (nop)) ;; #x07c
          (vu-pair (ior vi02 vi11 vi00) (nop)) ;; #x07d
          (vu-pair (lqi.xyzw vf09 vi11) (nop)) ;; #x07e
          (vu-pair (lqi.xyzw vf06 vi11) (nop)) ;; #x07f
          (vu-pair (lqi.xyzw vf12 vi11) (nop)) ;; #x080
          (vu-pair (nop) (nop)) ;; #x081
          (vu-pair (nop) (nop)) ;; #x082
          (vu-pair (ibeq vi13 vi11 setup-instance-render) (nop)) ;; #x083
          (vu-pair (nop) (itof0.xyzw vf09 vf09)) ;; #x084
          (vu-pair (lqi.xyzw vf10 vi11) (itof0.xyzw vf06 vf06)) ;; #x085
          (vu-pair (lqi.xyzw vf07 vi11) (itof0.w vf12 vf12)) ;; #x086
          (vu-pair (lqi.xyzw vf13 vi11) (itof12.xyz vf12 vf12)) ;; #x087
          (vu-pair (nop) (nop)) ;; #x088
          (vu-pair (nop) (muli.xyz vf09 vf09 I)) ;; #x089
          (vu-pair (ibeq vi13 vi11 setup-instance-render) (muli.xyz vf06 vf06 I)) ;; #x08a
          (vu-pair (nop) (itof0.xyzw vf10 vf10)) ;; #x08b
          (label convert-indexed-points)
          (vu-pair (lqi.xyzw vf11 vi11) (itof0.xyzw vf07 vf07)) ;; #x08c
          (vu-pair (lqi.xyzw vf08 vi11) (itof0.w vf13 vf13)) ;; #x08d
          (vu-pair (lqi.xyzw vf14 vi11) (itof12.xyz vf13 vf13)) ;; #x08e
          (vu-pair (sqi.xyzw vf09 vi02) (nop)) ;; #x08f
          (vu-pair (sqi.xyzw vf06 vi02) (muli.xyz vf10 vf10 I)) ;; #x090
          (vu-pair (ibeq vi13 vi11 setup-instance-render) (muli.xyz vf07 vf07 I)) ;; #x091
          (vu-pair (sqi.xyzw vf12 vi02) (itof0.xyzw vf11 vf11)) ;; #x092
          (vu-pair (lqi.xyzw vf09 vi11) (itof0.xyzw vf08 vf08)) ;; #x093
          (vu-pair (lqi.xyzw vf06 vi11) (itof0.w vf14 vf14)) ;; #x094
          (vu-pair (lqi.xyzw vf12 vi11) (itof12.xyz vf14 vf14)) ;; #x095
          (vu-pair (sqi.xyzw vf10 vi02) (nop)) ;; #x096
          (vu-pair (sqi.xyzw vf07 vi02) (muli.xyz vf11 vf11 I)) ;; #x097
          (vu-pair (ibeq vi13 vi11 setup-instance-render) (muli.xyz vf08 vf08 I)) ;; #x098
          (vu-pair (sqi.xyzw vf13 vi02) (itof0.xyzw vf09 vf09)) ;; #x099
          (vu-pair (lqi.xyzw vf10 vi11) (itof0.xyzw vf06 vf06)) ;; #x09a
          (vu-pair (lqi.xyzw vf07 vi11) (itof0.w vf12 vf12)) ;; #x09b
          (vu-pair (lqi.xyzw vf13 vi11) (itof12.xyz vf12 vf12)) ;; #x09c
          (vu-pair (sqi.xyzw vf11 vi02) (nop)) ;; #x09d
          (vu-pair (sqi.xyzw vf08 vi02) (muli.xyz vf09 vf09 I)) ;; #x09e
          (vu-pair (ibne vi13 vi11 convert-indexed-points) (muli.xyz vf06 vf06 I)) ;; #x09f
          (vu-pair (sqi.xyzw vf14 vi02) (itof0.xyzw vf10 vf10)) ;; #x0a0
          (label setup-instance-render)
          (vu-pair (mtir vi01 vf04.z) (nop)) ;; #x0a1
          (vu-pair (mtir vi05 vf02.x) (nop)) ;; #x0a2
          (vu-pair (mtir vi14 vf02.y) (nop)) ;; #x0a3
          (vu-pair (mtir vi04 vf03.x) (nop)) ;; #x0a4
          (vu-pair (ibne vi00 vi01 use-default-alpha-test) (nop)) ;; #x0a5
          (vu-pair (isubiu vi09 vi00 0x7fff) (nop)) ;; #x0a6
          (vu-pair (b finish-instance-setup) (nop)) ;; #x0a7
          (vu-pair (lq.xyzw vf05 vi00 (tie-near-const atest 0)) (nop)) ;; #x0a8
          (label use-default-alpha-test)
          (vu-pair (lq.xyzw vf05 vi00 (tie-near-const atest 1)) (nop)) ;; #x0a9
          (label finish-instance-setup)
          (vu-pair (iaddiu vi01 vi00 0x3c6) (nop)) ;; #x0aa
          (vu-pair (mtir vi06 vf03.y) (nop)) ;; #x0ab
          (vu-pair (mtir vi07 vf03.z) (nop)) ;; #x0ac
          (vu-pair (mtir vi08 vf03.w) (nop)) ;; #x0ad
          (vu-pair (iaddi vi15 vi00 0x0) (nop)) ;; #x0ae
          (vu-pair (mtir vi03 clrbuf.x) (nop)) ;; #x0af
          (vu-pair (iaddiu vi02 vi00 0x32) (nop)) ;; #x0b0
          (vu-pair (sq.xyzw vf01 vi01 0) (nop)) ;; #x0b1
          (vu-pair (sq.xyzw vf05 vi01 1) (nop)) ;; #x0b2
          (vu-pair (iswr.x vi09 vi01) (nop)) ;; #x0b3
          (vu-pair (mr32.xyzw gifbuf gifbuf) (nop)) ;; #x0b4
          (vu-pair (mfir.y extra vi00) (nop)) ;; #x0b5
          (vu-pair (mfir.w extra vi00) (nop)) ;; #x0b6
          (vu-pair (xgkick vi01) (nop)) ;; #x0b7
          (vu-pair (nop) (nop :e)) ;; #x0b8
          (vu-pair (nop) (nop)) ;; #x0b9
          (label render-basic-stream)
          (vu-pair (lqi.xyzw vf05 vi02) (nop)) ;; #x0ba
          (vu-pair (lq.xyzw vf24 vi03 6) (nop)) ;; #x0bb

          (vu-pair (lq.xyzw edge-clr0 vi05 1) (nop)) ;; #x67b
          (vu-pair (lq.xyzw edge-clr1 vi04 1) (nop)) ;; #x67c
          (vu-pair (lq.xyz edge-stq0 vi05 2) (nop)) ;; #x67d
          (vu-pair (fsand vi10 0x2) (nop)) ;; #x67e
          (vu-pair (fsand vi11 0x2) (subw.w edge-stq1 edge-stq0 edge-stq1)) ;; #x67f
          (vu-pair (ibne vi00 vi10 emit-leaving-intersection) (nop)) ;; #x680
          (vu-pair (lq.xyz edge-stq1 vi04 2) (nop)) ;; #x681
          (vu-pair (ibne vi00 vi11 emit-entering-intersection) (nop)) ;; #x682
          (vu-pair (div Q edge-stq0.w edge-stq1.w) (nop)) ;; #x683
          (vu-pair (b clip-edge-loop) (nop)) ;; #x684
          (vu-pair (iaddi vi06 vi06 0x7) (nop)) ;; #x685
          (label emit-entering-intersection)
          (vu-pair (bal vi08 interpolate-clip-vertex) (nop)) ;; #x686
          (vu-pair (iaddi vi04 vi06 0x1) (nop)) ;; #x687
          (vu-pair (sq.xyzw new-p vi06 1) (nop)) ;; #x688
          (vu-pair (sq.xyzw new-clr vi06 2) (nop)) ;; #x689
          (vu-pair (sq.xyz new-stq vi06 3) (nop)) ;; #x68a
          (vu-pair (b clip-edge-loop) (nop)) ;; #x68b
          (vu-pair (iaddi vi06 vi06 0x7) (nop)) ;; #x68c
          (label emit-leaving-intersection)
          (vu-pair (ibne vi00 vi11 resume-deferred-edge) (nop)) ;; #x68d
          (vu-pair (div Q edge-stq0.w edge-stq1.w) (nop)) ;; #x68e
          (vu-pair (bal vi08 interpolate-clip-vertex) (nop)) ;; #x68f
          (vu-pair (nop) (nop)) ;; #x690
          (vu-pair (sq.xyzw new-p vi06 4) (nop)) ;; #x691
          (vu-pair (sq.xyzw new-clr vi06 5) (nop)) ;; #x692
          (vu-pair (sq.xyz new-stq vi06 6) (nop)) ;; #x693
          (vu-pair (iaddi vi06 vi06 0x7) (nop)) ;; #x694
          (vu-pair (isw.x vi06 vi07 TIE-NEAR-VU-EDGE-STACK) (nop)) ;; #x695
          (vu-pair (isw.y vi04 vi07 TIE-NEAR-VU-EDGE-STACK) (nop)) ;; #x696
          (vu-pair (iaddi vi07 vi07 0x1) (nop)) ;; #x697
          (vu-pair (b clip-edge-loop) (nop)) ;; #x698
          (vu-pair (iaddi vi04 vi06 -0x3) (nop)) ;; #x699
          (label emit-final-clip-vertex)
          (vu-pair (lq.xyzw edge-p0 vi04 0) (nop)) ;; #x69a
          (vu-pair (lq.xyzw edge-clr0 vi04 1) (nop)) ;; #x69b
          (vu-pair (lq.xyz edge-stq0 vi04 2) (nop)) ;; #x69c
          (vu-pair (iaddi vi02 vi02 0x1) (nop)) ;; #x69d
          (vu-pair (nop) (nop)) ;; #x69e
          (vu-pair (div Q vf00.w edge-p0.w) (mul.xyz edge-p0 edge-p0 invh)) ;; #x69f
          (vu-pair (nop) (ftoi0.xyzw edge-clr0 edge-clr0)) ;; #x6a0
          (vu-pair (nop) (subw.w edge-p0 vf00 vf00)) ;; #x6a1
          (vu-pair (iaddi vi12 vi12 0x3) (nop)) ;; #x6a2
          (vu-pair (waitq) (mul.xyz edge-stq0 edge-stq0 Q)) ;; #x6a3
          (vu-pair (sq.xyzw edge-clr0 vi12 -2) (mul.xyz edge-p0 edge-p0 Q)) ;; #x6a4
          (vu-pair (nop) (add.xyzw edge-p0 edge-p0 hvdfnc)) ;; #x6a5
          (vu-pair (sq.xyz edge-stq0 vi12 -3) (ftoi4.xyzw edge-p0 edge-p0)) ;; #x6a6
          (vu-pair (sq.xyzw edge-p0 vi12 -1) (nop)) ;; #x6a7
          (label resume-deferred-edge)
          (vu-pair (iblez vi07 finish-clip-plane) (nop)) ;; #x6a8
          (vu-pair (nop) (nop)) ;; #x6a9
          (vu-pair (ilw.x vi06 vi07 TIE-NEAR-VU-EDGE-STACK-POP) (nop)) ;; #x6aa
          (vu-pair (ilw.y vi04 vi07 TIE-NEAR-VU-EDGE-STACK-POP) (nop)) ;; #x6ab
          (vu-pair (b clip-edge-loop) (nop)) ;; #x6ac
          (vu-pair (iaddi vi07 vi07 -0x1) (nop)) ;; #x6ad
          (label finish-clip-plane)
          (vu-pair (jr vi15) (nop)) ;; #x6ae
          (vu-pair (nop) (nop)) ;; #x6af
          (label close-polygon)
          ;; Close the last edge back to the first vertex for every plane and terminate the generated
          ;; lists. A zero final vertex count suppresses the triangle fan.
          (vu-pair (iaddiu vi06 vi00 TIE-NEAR-VU-CLIP-PLANE-X-POS) (nop)) ;; #x6b0
          (label close-plane-loop)
          (vu-pair (ilwr.x vi05 vi06) (nop)) ;; #x6b1
          (vu-pair (ilwr.y vi04 vi06) (nop)) ;; #x6b2
          (vu-pair (ilwr.z vi03 vi06) (nop)) ;; #x6b3
          (vu-pair (nop) (nop)) ;; #x6b4
          (vu-pair (ibeq vi00 vi05 advance-clip-plane) (nop)) ;; #x6b5
          (vu-pair (lq.xyzw edge-p0 vi04 0) (nop)) ;; #x6b6
          (vu-pair (ibeq vi04 vi05 advance-clip-plane) (nop)) ;; #x6b7
          (vu-pair (lq.xyzw edge-p1 vi05 0) (nop)) ;; #x6b8
          (vu-pair (jalr vi08 vi03) (nop)) ;; #x6b9
          (vu-pair (lq.xyzw edge-clr0 vi04 1) (nop)) ;; #x6ba
          (vu-pair (lq.xyzw edge-clr1 vi05 1) (nop)) ;; #x6bb
          (vu-pair (lq.xyz edge-stq0 vi04 2) (nop)) ;; #x6bc
          (vu-pair (fsand vi10 0x2) (nop)) ;; #x6bd
          (vu-pair (fsand vi11 0x2) (subw.w edge-stq1 edge-stq0 edge-stq1)) ;; #x6be
          (vu-pair (ibeq vi11 vi10 advance-clip-plane) (nop)) ;; #x6bf
          (vu-pair (lq.xyz edge-stq1 vi05 2) (nop)) ;; #x6c0
          (vu-pair (ibeq vi00 vi10 close-with-entering-intersection) (nop)) ;; #x6c1
          (vu-pair (div Q edge-stq0.w edge-stq1.w) (nop)) ;; #x6c2
          (vu-pair (bal vi08 interpolate-clip-vertex) (nop)) ;; #x6c3
          (vu-pair (nop) (nop)) ;; #x6c4
          (vu-pair (sq.xyzw new-p vi06 4) (nop)) ;; #x6c5
          (vu-pair (sq.xyzw new-clr vi06 5) (nop)) ;; #x6c6
          (vu-pair (sq.xyz new-stq vi06 6) (nop)) ;; #x6c7
          (vu-pair (iaddi vi04 vi06 0x4) (nop)) ;; #x6c8
          (vu-pair (ior vi13 vi06 vi00) (nop)) ;; #x6c9
          (vu-pair (bal vi15 begin-clip-plane) (nop)) ;; #x6ca
          (vu-pair (iaddi vi06 vi06 0x7) (nop)) ;; #x6cb
          (vu-pair (b advance-clip-plane) (nop)) ;; #x6cc
          (vu-pair (ior vi06 vi13 vi00) (nop)) ;; #x6cd
          (label close-with-entering-intersection)
          (vu-pair (bal vi08 interpolate-clip-vertex) (nop)) ;; #x6ce
          (vu-pair (nop) (nop)) ;; #x6cf
          (vu-pair (sq.xyzw new-p vi06 1) (nop)) ;; #x6d0
          (vu-pair (sq.xyzw new-clr vi06 2) (nop)) ;; #x6d1
          (vu-pair (sq.xyz new-stq vi06 3) (nop)) ;; #x6d2
          (vu-pair (iaddi vi04 vi06 0x1) (nop)) ;; #x6d3
          (vu-pair (ior vi13 vi06 vi00) (nop)) ;; #x6d4
          (vu-pair (bal vi15 begin-clip-plane) (nop)) ;; #x6d5
          (vu-pair (iaddi vi06 vi06 0x7) (nop)) ;; #x6d6
          (vu-pair (ior vi06 vi13 vi00) (nop)) ;; #x6d7
          (label advance-clip-plane)
          (vu-pair (isubiu vi01 vi06 TIE-NEAR-VU-CLIP-PLANE-Z-NEG) (nop)) ;; #x6d8
          (vu-pair (iswr.x vi00 vi06) (nop)) ;; #x6d9
          (vu-pair (iswr.y vi00 vi06) (nop)) ;; #x6da
          (vu-pair (ibltz vi01 close-plane-loop) (nop)) ;; #x6db
          (vu-pair (iaddi vi06 vi06 0x7) (nop)) ;; #x6dc
          (vu-pair (ibeq vi00 vi02 restore-after-polygon-clip) (nop)) ;; #x6dd
          (vu-pair (ilw.x vi15 vi00 TIE-NEAR-VU-CLIP-STATE) (nop)) ;; #x6de
          (vu-pair (iaddiu vi02 vi02 0x4000) (nop)) ;; #x6df
          (vu-pair (iaddiu vi02 vi02 0x4000) (nop)) ;; #x6e0
          (label restore-after-polygon-clip)
          (vu-pair (jr vi15) (nop)) ;; #x6e1
          (vu-pair (isw.x vi02 vi09 6) (nop)) ;; #x6e2
          ;; One two-instruction subroutine per clip plane, whose addresses entry 8 stored into the plane
          ;; records. Each one writes the signed distance of both edge endpoints into the w lane of their
          ;; STQ register -- positive means inside. Packing the distance into the spare lane of a register
          ;; the clipper already has to keep live is what makes a plane test cost two instructions.
          (label positive-x-distance)
          (vu-pair (jr vi08) (addx.w edge-stq0 edge-p0 edge-p0)) ;; #x6e3
          (vu-pair (nop) (addx.w edge-stq1 edge-p1 edge-p1)) ;; #x6e4
          (label negative-x-distance)
          (vu-pair (jr vi08) (subx.w edge-stq0 edge-p0 edge-p0)) ;; #x6e5
          (vu-pair (nop) (subx.w edge-stq1 edge-p1 edge-p1)) ;; #x6e6
          (label positive-y-distance)
          (vu-pair (jr vi08) (addy.w edge-stq0 edge-p0 edge-p0)) ;; #x6e7
          (vu-pair (nop) (addy.w edge-stq1 edge-p1 edge-p1)) ;; #x6e8
          (label negative-y-distance)
          (vu-pair (jr vi08) (suby.w edge-stq0 edge-p0 edge-p0)) ;; #x6e9
          (vu-pair (nop) (suby.w edge-stq1 edge-p1 edge-p1)) ;; #x6ea
          (label positive-z-distance)
          (vu-pair (jr vi08) (addz.w edge-stq0 edge-p0 edge-p0)) ;; #x6eb
          (vu-pair (nop) (addz.w edge-stq1 edge-p1 edge-p1)) ;; #x6ec
          (label negative-z-distance)
          (vu-pair (jr vi08) (subz.w edge-stq0 edge-p0 edge-p0)) ;; #x6ed
          (vu-pair (nop) (subz.w edge-stq1 edge-p1 edge-p1)) ;; #x6ee
          (label interpolate-clip-vertex)
          ;; Q = d0 / (d0 - d1). Apply the same edge parameter to homogeneous position, packed color, and
          ;; STQ so the new boundary vertex preserves the original triangle's attribute interpolation.
          (vu-pair (nop) (sub.xyzw new-p edge-p1 edge-p0)) ;; #x6ef
          (vu-pair (nop) (sub.xyzw new-clr edge-clr1 edge-clr0)) ;; #x6f0
          (vu-pair (nop) (sub.xyz new-stq edge-stq1 edge-stq0)) ;; #x6f1
          (vu-pair (waitq) (mul.xyzw new-p new-p Q)) ;; #x6f2
          (vu-pair (nop) (mul.xyzw new-clr new-clr Q)) ;; #x6f3
          (vu-pair (nop) (mul.xyz new-stq new-stq Q)) ;; #x6f4
          (vu-pair (nop) (add.xyzw new-p edge-p0 new-p)) ;; #x6f5
          (vu-pair (jr vi08) (add.xyzw new-clr edge-clr0 new-clr)) ;; #x6f6
          (vu-pair (nop) (add.xyz new-stq edge-stq0 new-stq)) ;; #x6f7
          )))

(defun tie-near-init-consts ((consts tie-near-consts) (alpha-blend int))
  "Build the TIE near-path packet templates, triple-buffer addresses, instance-data bank addresses,
   camera projection constants, clipping guard volume, and normal and translucent alpha-test states.
   alpha-blend controls the ABE bit in the strip and clipped-polygon primitives."
  (set! (-> consts adgif tag) (new 'static 'gif-tag64 :nloop #x5 :nreg #x1))
  (set! (-> consts adgif regs) (new 'static 'gif-tag-regs :regs0 (gif-reg-id a+d)))
  (set! (-> consts atest-tra cmd) (gs-reg test-1))
  (set! (-> consts atest-tra data)
        (the uint
             (new 'static 'gs-test :ate #x1 :atst (gs-atest greater-equal) :aref #x26 :zte #x1 :ztst (gs-ztest greater-equal))))
  (set! (-> consts atest-def cmd) (gs-reg test-1))
  (set! (-> consts atest-def data)
        (the uint (new 'static 'gs-test :atst (gs-atest not-equal) :zte #x1 :ztst (gs-ztest greater-equal))))
  (cond
    ((zero? *subdivide-draw-mode*)
     (set! (-> consts strgif tag)
           (new 'static
                'gif-tag64
                :pre #x1
                :nreg #x3
                :prim
                (new 'static 'gs-prim :prim (gs-prim-type tri-strip) :iip #x1 :tme #x1 :fge #x1 :abe alpha-blend))))
    ((= *subdivide-draw-mode* 3)
     (set! (-> consts strgif tag)
           (new 'static
                'gif-tag64
                :pre #x1
                :prim
                (new 'static 'gs-prim :prim (gs-prim-type tri-strip) :iip #x1 :tme #x1 :fge #x1)
                :nreg #x3)))
    ((= *subdivide-draw-mode* 1)
     (set! (-> consts strgif tag)
           (new 'static
                'gif-tag64
                :pre #x1
                :nreg #x3
                :prim
                (new 'static 'gs-prim :prim (gs-prim-type line-strip) :iip #x1 :fge #x1 :abe alpha-blend))))
    ((= *subdivide-draw-mode* 2)
     (set! (-> consts strgif tag)
           (new 'static
                'gif-tag64
                :pre #x1
                :nreg #x3
                :prim
                (new 'static 'gs-prim :prim (gs-prim-type tri-strip) :iip #x1 :fge #x1 :abe alpha-blend)))))
  (set! (-> consts strgif regs)
        (new 'static 'gif-tag-regs :regs0 (gif-reg-id st) :regs1 (gif-reg-id rgbaq) :regs2 (gif-reg-id xyzf2)))
  (set! (-> consts fangif tag)
        (new 'static
             'gif-tag64
             :pre #x1
             :nreg #x3
             :prim
             (new 'static 'gs-prim :prim (gs-prim-type tri-fan) :iip #x1 :tme #x1 :fge #x1 :abe alpha-blend)))
  (set! (-> consts fangif regs)
        (new 'static 'gif-tag-regs :regs0 (gif-reg-id st) :regs1 (gif-reg-id rgbaq) :regs2 (gif-reg-id xyzf2)))
  ;; Encode VU addresses 286, 470, and 654 in the low mantissa bits of 2^23-based floats. VU1
  ;; rotates the active pair by subtracting it from the sum of all three addresses.
  (let ((gif-buffer-a 8388894.0)
        (gif-buffer-b 8389078.0)
        (gif-buffer-c 8389262.0))
    (set! (-> consts gifbufs vector4w x) (the-as int gif-buffer-c))
    (set! (-> consts gifbufs vector4w y) (the-as int gif-buffer-b))
    (set! (-> consts gifbufs vector4w z) (the-as int gif-buffer-c))
    (set! (-> consts gifbufs vector4w w) (the-as int gif-buffer-b))
    (set! (-> consts extra vector4w x) (the-as int (+ gif-buffer-a gif-buffer-b gif-buffer-c)))
    (set! (-> consts extra vector4w y) (the-as int 0.0))
    (set! (-> consts extra vector4w z) (the-as int (+ gif-buffer-a gif-buffer-b gif-buffer-c))))
  ;; The two input banks are 44 quadwords apart.
  (set! (-> consts clrbufs vector4w x) 198)
  (set! (-> consts clrbufs vector4w y) 242)
  (set! (-> consts clrbufs vector4w z) 198)
  (set! (-> consts clrbufs vector4w w) 242)
  (let ((camera *math-camera*))
    (vector-copy! (-> consts invhscale) (-> camera inv-hmge-scale))
    (vector-copy! (-> consts hvdfoffs) (-> camera hvdf-off))
    (vector-copy! (-> consts guard) (-> camera guard)))
  (none))

(defun tie-near-init-engine ((dma-buf dma-buffer) (test-state gs-test) (alpha-blend int))
  "Append the TIE near-path VU1 upload and initialization packets to dma-buf. This uploads the
   constant block, initializes the microprogram, and configures VIF's ROW, BASE/OFFSET, mode, and cycle
   state for the packed instance stream. alpha-blend controls the geometry primitives' ABE bit. The
   test-state argument is accepted by the shared renderer interface but is not used by this path."
  (when (logtest? *vu1-enable-user* (vu1-renderer-mask tie-near))
    (dma-buffer-add-vu-function dma-buf tie-near-vu1-block 1)
    ;; Upload tie-near-consts to VU address 966.
    (let ((constant-qwc 11))
      (let* ((buffer dma-buf)
             (constant-packet (the-as dma-packet (-> buffer base))))
        (set! (-> constant-packet dma) (new 'static 'dma-tag :qwc constant-qwc :id (dma-tag-id cnt)))
        (set! (-> constant-packet vif0) (new 'static 'vif-tag :cmd (vif-cmd stmod)))
        (set! (-> constant-packet vif1) (new 'static 'vif-tag :imm #x3c6 :num constant-qwc :cmd (vif-cmd unpack-v4-32)))
        (set! (-> buffer base) (&+ (the-as pointer constant-packet) 16)))
      (tie-near-init-consts (the-as tie-near-consts (-> dma-buf base)) alpha-blend)
      (&+! (-> dma-buf base) (* constant-qwc 16)))
    ;; Entry 8 initializes the output and instance banks and installs the clipping-plane callbacks.
    (let* ((buffer dma-buf)
           (init-packet (the-as dma-packet (-> buffer base))))
      (set! (-> init-packet dma) (new 'static 'dma-tag :id (dma-tag-id cnt)))
      (set! (-> init-packet vif0) (new 'static 'vif-tag :imm #x8 :cmd (vif-cmd mscalf) :msk #x1))
      (set! (-> init-packet vif1) (new 'static 'vif-tag :cmd (vif-cmd flusha) :msk #x1))
      (set! (-> buffer base) (&+ (the-as pointer init-packet) 16)))
    ;; 2^23 in every ROW lane turns small packed integers into exact floating-point bit patterns
    ;; under VIF additive mode. mtir later recovers the address and index bits without conversion.
    (let* ((buffer dma-buf)
           (row-packet (the-as dma-packet (-> buffer base))))
      (set! (-> row-packet dma) (new 'static 'dma-tag :qwc #x2 :id (dma-tag-id cnt)))
      (set! (-> row-packet vif0) (new 'static 'vif-tag))
      (set! (-> row-packet vif1) (new 'static 'vif-tag :cmd (vif-cmd strow) :msk #x1))
      (set! (-> buffer base) (&+ (the-as pointer row-packet) 16)))
    (let ((row-data (the-as (pointer uint32) (-> dma-buf base))))
      (set! (-> (the-as (inline-array vector4w) row-data) 0 x) #x4b000000)
      (set! (-> (the-as (inline-array vector4w) row-data) 0 y) #x4b000000)
      (set! (-> (the-as (inline-array vector4w) row-data) 0 z) #x4b000000)
      (set! (-> (the-as (inline-array vector4w) row-data) 0 w) #x4b000000)
      (set! (-> (the-as (pointer vif-tag) row-data) 4) (new 'static 'vif-tag :cmd (vif-cmd base)))
      (set! (-> (the-as (pointer vif-tag) row-data) 5) (new 'static 'vif-tag :imm #x2c :cmd (vif-cmd offset)))
      (set! (-> (the-as (pointer vif-tag) row-data) 6) (new 'static 'vif-tag :cmd (vif-cmd stmod)))
      (set! (-> (the-as (pointer vif-tag) row-data) 7) (new 'static 'vif-tag :imm #x404 :cmd (vif-cmd stcycl)))
      (set! (-> dma-buf base) (&+ (the-as pointer row-data) 32)))
    0)
  (none))

(defun tie-near-end-buffer ((dma-buf dma-buffer))
  "Append the TIE near-path shutdown packets, restoring the normal GS TEST state and clearing the
   VIF mask, mode, and ROW state changed by tie-near-init-engine."
  (when (logtest? *vu1-enable-user* (vu1-renderer-mask tie-near))
    ;; Restore the alpha/depth test used by the translucent near path.
    (dma-buffer-add-gs-set dma-buf
                           (test-1 (new 'static 'gs-test :ate #x1 :atst (gs-atest greater-equal) :aref #x26 :zte #x1 :ztst (gs-ztest greater-equal))))
    ;; Clear the VIF mask, execute the empty entry 4, and restore mode and ROW for the next renderer.
    (let* ((buffer dma-buf)
           (mask-packet (the-as dma-packet (-> buffer base))))
      (set! (-> mask-packet dma) (new 'static 'dma-tag :qwc #x2 :id (dma-tag-id cnt)))
      (set! (-> mask-packet vif0) (new 'static 'vif-tag :cmd (vif-cmd stmask)))
      (set! (-> mask-packet vif1) (new 'static 'vif-tag))
      (set! (-> buffer base) (&+ (the-as pointer mask-packet) 16)))
    (let* ((buffer dma-buf)
           (reset-data (the-as (pointer uint32) (-> buffer base))))
      (set! (-> (the-as (pointer vif-tag) reset-data) 0) (new 'static 'vif-tag :imm #x4 :cmd (vif-cmd mscalf) :msk #x1))
      (set! (-> (the-as (pointer vif-tag) reset-data) 1) (new 'static 'vif-tag :cmd (vif-cmd stmod)))
      (set! (-> (the-as (pointer vif-tag) reset-data) 2) (new 'static 'vif-tag :cmd (vif-cmd flusha) :msk #x1))
      (set! (-> (the-as (pointer vif-tag) reset-data) 3) (new 'static 'vif-tag :cmd (vif-cmd strow) :msk #x1))
      (set! (-> (the-as (pointer vif-tag) reset-data) 4) (new 'static 'vif-tag))
      (set! (-> (the-as (pointer vif-tag) reset-data) 5) (new 'static 'vif-tag))
      (set! (-> (the-as (pointer vif-tag) reset-data) 6) (new 'static 'vif-tag))
      (set! (-> (the-as (pointer vif-tag) reset-data) 7) (new 'static 'vif-tag))
      (set! (-> buffer base) (&+ (the-as pointer reset-data) 32)))
    0)
  (none))

(defun tie-near-make-perspective-matrix ((out-matrix matrix))
  "Build the TIE near-path perspective matrix by applying the camera's homogeneous projection
   scale to camera-temp."
  (column-scale-matrix! out-matrix (-> *math-camera* hmge-scale) (-> *math-camera* camera-temp)))

(defun tie-near-int-reg ((register-index int))
  "Return the source name assigned to a TIE near-path VU1 integer register."
  (let ((i register-index))
    (cond
      ((zero? i) "zero")
      ((= i 1) "itemp")
      ((= i 2) "delta")
      ((= i 3) "dest-0")
      ((= i 4) "dest-1")
      ((= i 5) "dest-2")
      ((= i 6) "dest-3")
      ((= i 7) "delta-ptr")
      ((= i 8) "prev")
      ((= i 9) "itemp2"))))

(defun tie-near-float-reg ((register-index int))
  "Return the source name assigned to a TIE near-path VU1 floating-point register."
  (let ((i register-index))
    (cond
      ((zero? i) "zero")
      ((= i 1) "vtx-0")
      ((= i 2) "vtx-1")
      ((= i 3) "vtx-2")
      ((= i 4) "vtx-3")
      ((= i 5) "hvtx-0")
      ((= i 6) "hvtx-1")
      ((= i 7) "hvtx-2")
      ((= i 8) "hvtx-3")
      ((= i 9) "tex-0")
      ((= i 10) "tex-1")
      ((= i 11) "tex-2")

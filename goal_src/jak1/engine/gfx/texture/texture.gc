(defun gs-find-block ((block-x int) (block-y int) (texture-format gs-psm))
  "Map a block coordinate to its swizzled block index within a GS page."
  (cond
    ((zero? texture-format) (-> ct32-24-block-table (+ block-x (shl block-y 3))))
    ((= texture-format (gs-psm ct24)) (-> ct32-24-block-table (+ block-x (shl block-y 3))))
    ((= texture-format (gs-psm ct16)) (-> ct16-block-table (+ block-x (shl block-y 2))))
    ((= texture-format (gs-psm ct16s)) (-> ct16s-block-table (+ block-x (shl block-y 2))))
    ((= texture-format (gs-psm mz32)) (-> mz32-24-block-table (+ block-x (shl block-y 3))))
    ((= texture-format (gs-psm mz24)) (-> mz32-24-block-table (+ block-x (shl block-y 3))))
    ((= texture-format (gs-psm mz16)) (-> mz16-block-table (+ block-x (shl block-y 2))))
    ((= texture-format (gs-psm mz16s)) (-> mz16s-block-table (+ block-x (shl block-y 2))))
    ((= texture-format (gs-psm mt8)) (-> mt8-block-table (+ block-x (shl block-y 3))))
    ((= texture-format (gs-psm mt4)) (-> mt4-block-table (+ block-x (shl block-y 2))))
    (else 0)))

(defun gs-page-width ((texture-format gs-psm))
  "Return the GS page width in pixels for a texture format."
  (case texture-format
    (((gs-psm ct32) (gs-psm ct24) (gs-psm ct16) (gs-psm ct16s)) 64)
    (((gs-psm mt8) (gs-psm mt4)) 128)
    (else (format #t "Warning: Unknown block width for psm ~D~%" texture-format) 1)))

(defun gs-page-height ((texture-format gs-psm))
  "Return the GS page height in pixels for a texture format."
  (case texture-format
    (((gs-psm ct32) (gs-psm ct24)) 32)
    (((gs-psm ct16) (gs-psm ct16s)) 64)
    (((gs-psm mt8)) 64)
    (((gs-psm mt4)) 128)
    (else (format #t "Warning: Unknown block width for psm ~D~%" texture-format) 1)))

(defun gs-block-width ((texture-format gs-psm))
  "Return the GS block width in pixels for a texture format."
  (case texture-format
    (((gs-psm ct32) (gs-psm ct24)) 8)
    (((gs-psm ct16) (gs-psm ct16s) (gs-psm mt8)) 16)
    (((gs-psm mt4)) 32)
    (else (format #t "Warning: Unknown block width for psm ~D~%" texture-format) 1)))

(defun gs-block-height ((texture-format gs-psm))
  "Return the GS block height in pixels for a texture format."
  (case texture-format
    (((gs-psm ct32) (gs-psm ct24) (gs-psm ct16) (gs-psm ct16s)) 8)
    (((gs-psm mt8) (gs-psm mt4)) 16)
    (else (format #t "Warning: Unknown block width for psm ~D~%" texture-format) 1)))

(defun gs-largest-block ((texture-width int) (texture-height int) (texture-format gs-psm))
  "Determine the largest block occupied by the given texture"
  (let* ((block-width (gs-block-width texture-format))
         (block-height (gs-block-height texture-format))
         ;; round up to neaest block.
         (real-width (* (/ (+ (+ block-width -1) texture-width) block-width) block-width))
         (real-height (* (/ (+ (+ block-height -1) texture-height) block-height) block-height))
         ;; and now convert to actual blocks
         (width-blocks (/ real-width block-width))
         (height-blocks (/ real-height block-height))
         (max-block 0))
    ;; loop over each block...
    (dotimes (x width-blocks)
      (dotimes (y height-blocks)
        ;; and see where it is.
        (set! max-block (max max-block (gs-find-block x y texture-format)))))
    max-block))

(defun gs-blocks-used ((texture-width int) (texture-height int) (texture-format gs-psm))
  "Count the GS blocks occupied by a texture. Complete pages use 32 blocks; the final
   partial page uses the format's swizzled block table to find its highest occupied block."
  (let* ((page-width (gs-page-width texture-format))
         (page-height (gs-page-height texture-format))
         (real-width (* (/ (+ (+ page-width -1) texture-width) page-width) page-width))
         (real-height (* (/ (+ (+ page-height -1) texture-height) page-height) page-height))
         (width-blocks (/ real-width page-width))
         (height-blocks (/ real-height page-height))
         (remaining-width (- texture-width (* (+ width-blocks -1) page-width)))
         (remaining-height (- texture-height (* (+ height-blocks -1) page-height))))
    (if (or (< remaining-width page-width) (< remaining-height page-height))
      (+ (+ (gs-largest-block remaining-width remaining-height texture-format) 1)
         (shl (+ (* width-blocks height-blocks) -1) 5))
      (shl (* height-blocks width-blocks) 5))))


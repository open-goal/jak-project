;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "kernel-defs.gc")

;; Per-renderer enables for the VU1 drawing pass. The debug menu edits the menu mask, which is
;; copied to the active mask at the start of each frame.

(defenum vu1-renderer-mask
  :bitfield #t
  (sky 3)
  (ocean 4)
  (ocean-wave 5)
  (tfrag 6)
  (tie-near 7)
  (tie 8)
  (generic 9)
  (merc 10)
  (shrubbery 11)
  (shrub-near 12)
  (billboard 13)
  (trans-shrubbery 14)
  (trans-tfrag 15)
  (sprite 16)
  (shadow 17)
  (depth-cue 18)
  ;; These slots are enabled by the original default mask but have no readers.
  (reserved-19 19)
  (reserved-20 20))

;; DECOMP BEGINS

(define *vu1-enable-user-menu*
  (vu1-renderer-mask sky
                     ocean
                     ocean-wave
                     tfrag
                     tie-near
                     tie
                     generic
                     merc
                     shrubbery
                     shrub-near
                     billboard
                     trans-shrubbery
                     trans-tfrag
                     sprite
                     shadow
                     depth-cue
                     reserved-19
                     reserved-20))

;; Depth cue is implemented by the PC renderer rather than the VU1 bucket.
(#when PC_PORT
  (logclear! *vu1-enable-user-menu* (vu1-renderer-mask depth-cue)))

;; This is populated from the menu mask at the start of each frame.
(define *vu1-enable-user* (the-as vu1-renderer-mask 0))

;; A DMA sink identifies the bucket and texture-page context used by a foreground renderer.
(deftype dma-foreground-sink (basic)
  ((bucket                   bucket-id)
   (foreground-texture-page  int8)
   (foreground-texture-level int8)
   (foreground-output-bucket int8)))

;; VU1 data-memory addresses retained across generic foreground submissions.
(deftype generic-bucket-state (structure)
  ((gifbuf-adr uint32)
   (inbuf-adr  uint32))
  :pack-me)

;; The generic renderer extends a normal sink with its persistent VU1 buffer addresses.
(deftype generic-dma-foreground-sink (dma-foreground-sink)
  ((state generic-bucket-state :inline)))

;; Three foreground sink references share one array. The named aliases select the merc slot at
;; index zero and the generic slot at index one without storing duplicate references.
(declare-type level basic)

(deftype dma-foreground-sink-group (basic)
  ((sink         dma-foreground-sink 3)
   (merc-sink    dma-foreground-sink :overlay-at (-> sink 0))
   (generic-sink generic-dma-foreground-sink :overlay-at (-> sink 1))
   (level        level)))

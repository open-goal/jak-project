                 (b.le a1 r0 generic-envmap-dproc-finish-tail :delay (m.ni a3 vf20)))
      (asm-block vertex-loop
                 (label generic-envmap-dproc-vertex-loop)
                 ;; VU0 entry 48 converts the next four normal/eye pairs while the EE packs and writes the
                 ;; preceding reflected texture coordinates.

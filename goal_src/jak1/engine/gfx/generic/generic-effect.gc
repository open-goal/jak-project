                 (m.ni vf22 t4)
                 (nop!)
                 (m.ni vf23 t5)
                 (nop!)
                 (m.ni vf24 t6)
                 (nop!)
                 (m.ni vf27 t3)
                 (l.q t3 at (generic-work-offset saves envmap index-mask))
                 (callms GENERIC-VU0-ENVMAP)
                 (nop!)
                 (l.dr t2 t1)
                 (nop!)
                 (l.dl t2 t1 7)
                 (nop!)
                 (add.i t1 t1 8)
                 (pextlh t2 r0 t2)
                 (mmi-nop!)
                 (and.q t3 t2 t3)
                 (mmi-nop!)
                 (sll.w t3 t3 5)

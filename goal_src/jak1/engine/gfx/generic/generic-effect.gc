                 (add.w t5 t3 a0)
                 (mmi-nop!)
                 (srl32 t6 t5 0)
                 (l.s f4 t5 24)
                 (pcpyud t7 t5 r0)
                 (l.s f3 t6 24)
                 (srl32 t8 t7 0)
                 (l.s f2 t7 24)
                 (and.q t3 t2 a1)

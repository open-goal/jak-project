                 (m t9 f1)
                 (nop!)
                 (nop!)
                 (nop!)
                 (m.ni vf21 a3)
                 (nop!)
                 (m.ni vf9 t3)
                 (nop!)
                 (m.ni vf10 t4)
                 (nop!)
                 (m.ni vf11 t5)
                 (nop!)
                 (m.ni vf12 t6)
                 (pextlw a3 t9 t8)
                 (nop!)
                 (pcpyld a3 a3 t7)
                 (nop!)
                 (nop!)
                 (m.ni vf22 t0)

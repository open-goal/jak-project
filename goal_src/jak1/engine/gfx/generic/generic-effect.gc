                 (m.ni vf23 t1)
                 (nop!)
                 (m.ni vf24 t2)
                 (nop!)
                 (m.ni vf27 a3)
                 (nop!)
                 (callms GENERIC-VU0-ENVMAP)
                 (nop!)
                 (mmi-nop!)
                 (nop!)
                 (mmi-nop!)
                 (nop!)
                 (mmi-nop!)
                 (nop!)
                 (mmi-nop!)
                 (nop!)
                 (mmi-nop!)
                 (nop!)
                 (mmi-nop!)
                 (nop!)
                 (mmi-nop!)
                 (nop!)
                 (l.s f1 a2 24)
                 (sub.s f1 f1 f0)
                 (l.s f2 a2 56)
                 (div.s f3 f0 f1)
                 (l.s f5 a2 88)
                 (nop!)
                 (l.s f1 a2 120)
                 (nop!)
                 (l.q a3 a2 16)
                 (nop!)
                 (nop!)
                 (sub.s f4 f2 f0)
                 (nop!)
                 (sub.s f2 f5 f0)
                 (nop!)
                 (sub.s f1 f1 f0)
                 (nop!)
                 (mul.s f3 f3 f0)
                 (l.q t0 a2 48)
                 (div.s f4 f0 f4)
                 (l.q t1 a2 80)
                 (nop!)
                 (l.q t2 a2 112)
                 (nop!)
                 (l.q t3 a2)

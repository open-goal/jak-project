                 (sra.w t3 t3 8)
                 (l.q t4 t5 16)
                 (sub.s f4 f4 f0)
                 (nop!)
                 (sub.s f3 f3 f0)
                 (nop!)
                 (sub.s f2 f2 f0)
                 (nop!)

    ;; Clip one edge list against one plane.  vi06 selects the plane-distance helper, vi07 is the
    ;; previous endpoint, vi08 is the current endpoint, and vi09 advances through seven-qword edge
    ;; records.  Crossing edges call the interpolator at #x41b and splice the new endpoint into the
    ;; list used by the next plane.
    (label clipper-begin-plane)
    (vu-pair (iaddiu vi09 vi00 0x38b) (nop)) ;; #x38c
    (label clipper-restart-list)
    (vu-pair (iaddi pending-depth vi00 0x0) (nop)) ;; #x38d
    ;; One plane, one edge list. vi06 is the plane-distance helper, the two endpoints are measured with
    ;; one call, and an edge whose endpoints straddle the plane is split at the interpolated crossing
    ;; and the new endpoint spliced into the list the next plane will walk. Six planes, so the list is
    ;; rewritten up to six times and can only grow.
    (label clipper-next-edge)
    (vu-pair (isubiu vi01 vi09 0x3b5) (nop)) ;; #x38e
    (vu-pair (ilwr.y vi08 vi09) (nop)) ;; #x38f
    (vu-pair (ibgez vi01 clipper-project-vertex) (nop)) ;; #x390
    (vu-pair (ilwr.z vi06 vi09) (nop)) ;; #x391
    (vu-pair (lq.xyzw vf24 vi07 0) (nop)) ;; #x392
    (vu-pair (lq.xyzw vf23 vi08 0) (nop)) ;; #x393
    (vu-pair (ibne vi00 vi08 clipper-measure-edge) (nop)) ;; #x394
    (vu-pair (iswr.y vi07 vi09) (nop)) ;; #x395
    (vu-pair (jalr clip-link vi06) (nop)) ;; #x396
    (vu-pair (iswr.x vi07 vi09) (nop)) ;; #x397
    (vu-pair (nop) (nop)) ;; #x398
    (vu-pair (nop) (nop)) ;; #x399
    (vu-pair (nop) (nop)) ;; #x39a
    (vu-pair (fsand vi02 0x2) (nop)) ;; #x39b
    (vu-pair (ibne vi00 vi02 clipper-pop-pending-list) (nop)) ;; #x39c
    (vu-pair (nop) (nop)) ;; #x39d
    (vu-pair (b clipper-next-edge) (nop)) ;; #x39e
    (vu-pair (iaddi vi09 vi09 0x7) (nop)) ;; #x39f
    (label clipper-measure-edge)
    (vu-pair (jalr clip-link vi06) (nop)) ;; #x3a0
    (vu-pair (lq.xyzw vf15 vi08 1) (nop)) ;; #x3a1
    (vu-pair (lq.xyzw vf16 vi07 1) (nop)) ;; #x3a2
    (vu-pair (lq.xyzw vf12 vi08 2) (nop)) ;; #x3a3
    (vu-pair (fsand vi01 0x2) (nop)) ;; #x3a4
    (vu-pair (fsand vi02 0x2) (subw.w vf31 vf30 vf31)) ;; #x3a5
    (vu-pair (ibne vi00 vi01 clipper-splice-endpoint) (nop)) ;; #x3a6
    (vu-pair (lq.xyzw vf13 vi07 2) (nop)) ;; #x3a7
    (vu-pair (ibne vi00 vi02 clipper-split-edge) (nop)) ;; #x3a8
    (vu-pair (div Q vf30.w vf31.w) (nop)) ;; #x3a9
    (vu-pair (b clipper-next-edge) (nop)) ;; #x3aa
    (vu-pair (iaddi vi09 vi09 0x7) (nop)) ;; #x3ab
    (label clipper-split-edge)
    (vu-pair (bal clip-link clipper-interpolate-crossing) (nop)) ;; #x3ac
    (vu-pair (iaddi vi07 vi09 0x1) (nop)) ;; #x3ad
    (vu-pair (sq.xyzw vf25 vi09 1) (nop)) ;; #x3ae
    (vu-pair (sq.xyzw vf17 vi09 2) (nop)) ;; #x3af
    (vu-pair (sq.xyzw vf14 vi09 3) (nop)) ;; #x3b0
    (vu-pair (b clipper-next-edge) (nop)) ;; #x3b1
    (vu-pair (iaddi vi09 vi09 0x7) (nop)) ;; #x3b2
    (label clipper-splice-endpoint)
    (vu-pair (ibne vi00 vi02 clipper-pop-pending-list) (nop)) ;; #x3b3
    (vu-pair (div Q vf30.w vf31.w) (nop)) ;; #x3b4
    (vu-pair (bal clip-link clipper-interpolate-crossing) (nop)) ;; #x3b5
    (vu-pair (nop) (nop)) ;; #x3b6
    (vu-pair (sq.xyzw vf25 vi09 4) (nop)) ;; #x3b7
    (vu-pair (sq.xyzw vf17 vi09 5) (nop)) ;; #x3b8
    (vu-pair (sq.xyzw vf14 vi09 6) (nop)) ;; #x3b9
    (vu-pair (iaddi vi09 vi09 0x7) (nop)) ;; #x3ba
    (vu-pair (isw.x vi09 pending-depth 949) (nop)) ;; #x3bb
    (vu-pair (isw.y vi07 pending-depth 949) (nop)) ;; #x3bc
    (vu-pair (iaddi pending-depth pending-depth 0x1) (nop)) ;; #x3bd
    (vu-pair (b clipper-next-edge) (nop)) ;; #x3be
    (vu-pair (iaddi vi07 vi09 -0x3) (nop)) ;; #x3bf
    ;; Project a surviving clip-space vertex and append its color, STQ, and GS position to the
    ;; temporary packet.
    (label clipper-project-vertex)
    (vu-pair (lq.xyzw vf23 vi07 0) (nop)) ;; #x3c0
    (vu-pair (lq.xyzw vf15 vi07 1) (nop)) ;; #x3c1
    (vu-pair (lq.xyzw vf12 vi07 2) (nop)) ;; #x3c2
    (vu-pair (iaddi vi05 vi05 0x1) (nop)) ;; #x3c3
    (vu-pair (nop) (nop)) ;; #x3c4
    (vu-pair (div Q vf00.w vf23.w) (nop)) ;; #x3c5
    (vu-pair (nop) (ftoi0.xyzw vf15 vf15)) ;; #x3c6
    (vu-pair (nop) (mul.xyzw vf23 vf23 invh-scale)) ;; #x3c7
    (vu-pair (iaddi vi03 vi03 0x3) (nop)) ;; #x3c8
    (vu-pair (waitq) (nop)) ;; #x3c9
    (vu-pair (sq.xyzw vf15 vi03 -2) (mul.xyz vf23 vf23 Q)) ;; #x3ca
    (vu-pair (nop) (mul.xyz vf12 vf12 Q)) ;; #x3cb
    (vu-pair (nop) (add.xyzw vf23 vf23 hvdf-offset)) ;; #x3cc
    (vu-pair (nop) (maxy.w vf23 vf23 fog-consts)) ;; #x3cd
    (vu-pair (nop) (miniz.w vf23 vf23 fog-consts)) ;; #x3ce
    (vu-pair (nop) (ftoi4.xyzw vf23 vf23)) ;; #x3cf
    (vu-pair (sq.xyzw vf12 vi03 -3) (nop)) ;; #x3d0
    (vu-pair (sq.xyzw vf23 vi03 -1) (nop)) ;; #x3d1
    (label clipper-pop-pending-list)
    (vu-pair (iblez pending-depth clipper-plane-done) (nop)) ;; #x3d2
    (vu-pair (nop) (nop)) ;; #x3d3
    (vu-pair (ilw.x vi09 pending-depth 948) (nop)) ;; #x3d4
    (vu-pair (ilw.y vi07 pending-depth 948) (nop)) ;; #x3d5
    (vu-pair (b clipper-next-edge) (nop)) ;; #x3d6
    (vu-pair (iaddi pending-depth pending-depth -0x1) (nop)) ;; #x3d7
    (label clipper-plane-done)
    (vu-pair (jr transform-return) (nop)) ;; #x3d8
    (vu-pair (nop) (nop)) ;; #x3d9
    ;; Close each edge ring.  If the closing edge crosses the active plane, insert its interpolated
    ;; endpoint and run the newly split portion through the same plane before continuing.
    (label clipper-close-ring)
    (vu-pair (iaddiu vi09 vi00 0x38b) (nop)) ;; #x3da
    (label clipper-close-next-ring)
    (vu-pair (ilwr.x vi08 vi09) (nop)) ;; #x3db
    (vu-pair (ilwr.y vi07 vi09) (nop)) ;; #x3dc
    (vu-pair (ilwr.z vi06 vi09) (nop)) ;; #x3dd
    (vu-pair (nop) (nop)) ;; #x3de
    (vu-pair (ibeq vi00 vi08 clipper-clear-edge) (nop)) ;; #x3df
    (vu-pair (lq.xyzw vf23 vi07 0) (nop)) ;; #x3e0
    (vu-pair (ibeq vi07 vi08 clipper-clear-edge) (nop)) ;; #x3e1
    (vu-pair (lq.xyzw vf24 vi08 0) (nop)) ;; #x3e2
    (vu-pair (jalr clip-link vi06) (nop)) ;; #x3e3
    (vu-pair (lq.xyzw vf15 vi07 1) (nop)) ;; #x3e4
    (vu-pair (lq.xyzw vf16 vi08 1) (nop)) ;; #x3e5
    (vu-pair (lq.xyzw vf12 vi07 2) (nop)) ;; #x3e6
    (vu-pair (fsand vi01 0x2) (nop)) ;; #x3e7
    (vu-pair (fsand vi02 0x2) (subw.w vf31 vf30 vf31)) ;; #x3e8
    (vu-pair (ibeq vi02 vi01 clipper-clear-edge) (nop)) ;; #x3e9
    (vu-pair (lq.xyzw vf13 vi08 2) (nop)) ;; #x3ea
    (vu-pair (ibeq vi00 vi01 clipper-split-closing-edge) (nop)) ;; #x3eb
    (vu-pair (div Q vf30.w vf31.w) (nop)) ;; #x3ec
    (vu-pair (bal clip-link clipper-interpolate-crossing) (nop)) ;; #x3ed
    (vu-pair (nop) (nop)) ;; #x3ee
    (vu-pair (sq.xyzw vf25 vi09 4) (nop)) ;; #x3ef
    (vu-pair (sq.xyzw vf17 vi09 5) (nop)) ;; #x3f0
    (vu-pair (sq.xyzw vf14 vi09 6) (nop)) ;; #x3f1
    (vu-pair (iaddi vi07 vi09 0x4) (nop)) ;; #x3f2
    (vu-pair (ior input-bank vi09 vi00) (nop)) ;; #x3f3
    (vu-pair (bal transform-return clipper-restart-list) (nop)) ;; #x3f4
    (vu-pair (iaddi vi09 vi09 0x7) (nop)) ;; #x3f5
    (vu-pair (b clipper-clear-edge) (nop)) ;; #x3f6
    (vu-pair (ior vi09 input-bank vi00) (nop)) ;; #x3f7
    (label clipper-split-closing-edge)
    (vu-pair (bal clip-link clipper-interpolate-crossing) (nop)) ;; #x3f8
    (vu-pair (nop) (nop)) ;; #x3f9
    (vu-pair (sq.xyzw vf25 vi09 1) (nop)) ;; #x3fa
    (vu-pair (sq.xyzw vf17 vi09 2) (nop)) ;; #x3fb
    (vu-pair (sq.xyzw vf14 vi09 3) (nop)) ;; #x3fc
    (vu-pair (iaddi vi07 vi09 0x1) (nop)) ;; #x3fd
    (vu-pair (ior input-bank vi09 vi00) (nop)) ;; #x3fe
    (vu-pair (bal transform-return clipper-restart-list) (nop)) ;; #x3ff
    (vu-pair (iaddi vi09 vi09 0x7) (nop)) ;; #x400
    (vu-pair (ior vi09 input-bank vi00) (nop)) ;; #x401
    (label clipper-clear-edge)
    (vu-pair (isubiu vi01 vi09 0x3ae) (nop)) ;; #x402
    (vu-pair (iswr.x vi00 vi09) (nop)) ;; #x403
    (vu-pair (iswr.y vi00 vi09) (nop)) ;; #x404
    (vu-pair (ibltz vi01 clipper-close-next-ring) (nop)) ;; #x405
    (vu-pair (iaddi vi09 vi09 0x7) (nop)) ;; #x406
    (vu-pair (ibeq vi00 vi05 clipper-return) (nop)) ;; #x407
    (vu-pair (mtir transform-return vf31.x) (nop)) ;; #x408
    (vu-pair (iaddiu vi05 vi05 0x4000) (nop)) ;; #x409
    (vu-pair (iaddiu vi05 vi05 0x4000) (nop)) ;; #x40a
    (vu-pair (iswr.x vi05 vi04) (nop)) ;; #x40b
    (label clipper-return)
    (vu-pair (nop) (nop)) ;; #x40c
    (vu-pair (jr transform-return) (nop)) ;; #x40d
    (vu-pair (nop) (nop)) ;; #x40e
    ;; Homogeneous plane distances, one two-pair subroutine per plane.  The paired result for the two
    ;; edge endpoints is returned in vf30.w and vf31.w; its signs tell the caller whether the edge stays
    ;; inside or crosses.  Each is w plus or minus one coordinate, so the names read off the boundary
    ;; being measured: w + x is zero on x = -w and positive inside it.
    ;;
    ;; The six addresses are installed into the six plane records by the reset entry, which is what makes
    ;; the clipper's plane loop a call through a record field rather than six special cases.
    (label negative-x-distance)
    (vu-pair (jr clip-link) (addx.w vf30 vf23 vf23)) ;; #x40f
    (vu-pair (nop) (addx.w vf31 vf24 vf24)) ;; #x410
    (label positive-x-distance)
    (vu-pair (jr clip-link) (subx.w vf30 vf23 vf23)) ;; #x411
    (vu-pair (nop) (subx.w vf31 vf24 vf24)) ;; #x412
    (label negative-y-distance)
    (vu-pair (jr clip-link) (addy.w vf30 vf23 vf23)) ;; #x413
    (vu-pair (nop) (addy.w vf31 vf24 vf24)) ;; #x414
    (label positive-y-distance)
    (vu-pair (jr clip-link) (suby.w vf30 vf23 vf23)) ;; #x415
    (vu-pair (nop) (suby.w vf31 vf24 vf24)) ;; #x416
    (label negative-z-distance)
    (vu-pair (jr clip-link) (addz.w vf30 vf23 vf23)) ;; #x417
    (vu-pair (nop) (addz.w vf31 vf24 vf24)) ;; #x418
    (label positive-z-distance)
    (vu-pair (jr clip-link) (subz.w vf30 vf23 vf23)) ;; #x419
    (vu-pair (nop) (subz.w vf31 vf24 vf24)) ;; #x41a
    ;; Interpolate clip-space position, packed color, and STQ at the crossing fraction in Q.
    (label clipper-interpolate-crossing)
    (vu-pair (nop) (sub.xyzw vf25 vf24 vf23)) ;; #x41b
    (vu-pair (nop) (sub.xyzw vf17 vf16 vf15)) ;; #x41c
    (vu-pair (nop) (sub.xyzw vf14 vf13 vf12)) ;; #x41d
    (vu-pair (waitq) (mul.xyzw vf25 vf25 Q)) ;; #x41e
    (vu-pair (nop) (mul.xyzw vf17 vf17 Q)) ;; #x41f
    (vu-pair (nop) (mul.xyzw vf14 vf14 Q)) ;; #x420
    (vu-pair (nop) (add.xyzw vf25 vf23 vf25)) ;; #x421
    (vu-pair (jr clip-link) (add.xyzw vf17 vf15 vf17)) ;; #x422
    (vu-pair (nop) (add.xyzw vf14 vf12 vf14)) ;; #x423
    ;; Copy the finished ST/RGBAQ/XYZF2 stream into the current GIF buffer, kick it, then advance
    ;; vi12 to the next 279-qword input bank and wrap after the third bank.
    ;; The strip is finished. Copy the ST/RGBAQ/XYZF2 run into the header buffer behind its adgif
    ;; prologue, kick it, and advance to the next input bank - wrapping after the third, because the
    ;; GIF is still reading the one before.
    (label copy-to-gif-buffer)
    (vu-pair (iaddi vi14 header-buf 0x7) (nop)) ;; #x424
    (vu-pair (lq.xyzw vf03 header-buf 4) (nop)) ;; #x425
    (vu-pair (ilw.w vi02 header-buf 6) (nop)) ;; #x426
    (vu-pair (lq.xyzw vf21 header-buf 5) (nop)) ;; #x427
    (vu-pair (lq.xyzw vf22 header-buf 6) (nop)) ;; #x428
    (label copy-next-strip)
    (vu-pair (ilwr.w vi03 vi14) (nop)) ;; #x429
    (vu-pair (ilw.w vi04 vi14 1) (nop)) ;; #x42a
    (vu-pair (lqi.xyzw vf16 vi14) (nop)) ;; #x42b
    (vu-pair (lqi.xyzw vf17 vi14) (nop)) ;; #x42c
    (vu-pair (lqi.xyzw vf18 vi14) (nop)) ;; #x42d
    (vu-pair (lqi.xyzw vf19 vi14) (nop)) ;; #x42e
    (vu-pair (lqi.xyzw vf20 vi14) (nop)) ;; #x42f
    (vu-pair (iadd vi06 vi03 input-bank) (nop)) ;; #x430
    (vu-pair (sqi.xyzw adgif-tag vi06) (nop)) ;; #x431
    (vu-pair (sqi.xyzw vf16 vi06) (nop)) ;; #x432
    (vu-pair (sqi.xyzw vf17 vi06) (nop)) ;; #x433
    (vu-pair (sqi.xyzw vf18 vi06) (nop)) ;; #x434
    (vu-pair (sqi.xyzw vf19 vi06) (nop)) ;; #x435
    (vu-pair (sqi.xyzw vf20 vi06) (nop)) ;; #x436
    (vu-pair (sqi.xyzw vf21 vi06) (nop)) ;; #x437
    (vu-pair (sqi.xyzw vf22 vi06) (nop)) ;; #x438
    (vu-pair (sqi.xyzw vf03 vi06) (nop)) ;; #x439
    (vu-pair (ibgez vi04 copy-next-strip) (nop)) ;; #x43a
    (vu-pair (isw.x vi04 vi06 -1) (nop)) ;; #x43b
    (vu-pair (iadd vi02 input-bank vi02) (nop)) ;; #x43c
    (vu-pair (nop) (nop)) ;; #x43d
    (vu-pair (xgkick vi02) (nop)) ;; #x43e
    (vu-pair (isubiu vi01 input-bank 0x22e) (nop)) ;; #x43f
    (vu-pair (nop) (nop)) ;; #x440
    (vu-pair (ibltz vi01 program-done) (nop)) ;; #x441
    (vu-pair (iaddiu input-bank input-bank 0x117) (nop)) ;; #x442
    (vu-pair (iaddi input-bank vi00 0x0) (nop)) ;; #x443
    ;; Entry 4 and the common completion point.
    (label program-done)
    (vu-pair (nop) (nop :e)) ;; #x444
    (vu-pair (nop) (nop)) ;; #x445
    )))

(defun generic-setup-constants ((constants generic-constants) (alpha-blend int))
  "Fill the Generic VU1 constant block from the active camera and select alpha blending for its
   triangle-strip GIF tag."
  (let ((camera *math-camera*))
    (set-vector!
      (-> constants fog)
      (-> camera pfog0)
      (-> camera fog-min)
      (-> camera fog-max)
      3071.0))
  (set! (-> constants adgif tag) (new 'static 'gif-tag64 :nloop #x7 :nreg #x1))
  (set! (-> constants adgif regs) (new 'static 'gif-tag-regs :regs0 (gif-reg-id a+d)))
  (set! (-> constants giftag tag)
        (new 'static
             'gif-tag64
             :pre #x1
             :nreg #x3
             :prim
             (new 'static
                  'gs-prim
                  :prim (gs-prim-type tri-strip)
                  :iip #x1
                  :tme #x1
                  :fge #x1
                  :abe alpha-blend)))
  (set! (-> constants giftag regs)
        (new 'static 'gif-tag-regs :regs0 (gif-reg-id st) :regs1 (gif-reg-id rgbaq) :regs2 (gif-reg-id xyzf2)))
  (vector-copy! (-> constants hvdf-offset) (-> *math-camera* hvdf-off))
  (vector-copy! (-> constants hmge-scale) (-> *math-camera* hmge-scale))
  (vector-copy! (-> constants invh-scale) (-> *math-camera* inv-hmge-scale))
  (vector-copy! (-> constants guard) (-> *math-camera* guard))
  (set! (-> constants adnop dword 0) (the-as uint #x5026b))
  (set! (-> constants adnop dword 1) (the-as uint 71))
  (set! (-> constants flush dword 0) (the-as uint #x3f80000080808080))
  (set! (-> constants flush dword 1) (the-as uint 1))
  (none))

(defun generic-add-constants ((dma-buf dma-buffer) (alpha-blend int))
  "Append the ten-qword Generic camera, fog, GIF, guard-band, and packet constant block to dma-buf."
  (let* ((qword-count 10)
         (buffer dma-buf)
         (packet (the-as dma-packet (-> buffer base))))
    (set! (-> packet dma) (new 'static 'dma-tag :id (dma-tag-id cnt) :qwc qword-count))
    (set! (-> packet vif0) (new 'static 'vif-tag :imm #x404 :cmd (vif-cmd stcycl)))
    (set! (-> packet vif1)
          (new 'static
               'vif-tag
               :imm GENERIC-VU1-CONSTANTS
               :cmd (vif-cmd unpack-v4-32)
               :num qword-count))
    (set! (-> buffer base) (the-as pointer (&+ packet 16))))
  (generic-setup-constants (the-as generic-constants (-> dma-buf base)) alpha-blend)
  (&+! (-> dma-buf base) 160)
  (none))

(defun generic-init-buf ((dma-buf dma-buffer) (alpha-blend int) (zbuf gs-zbuf))
  "Upload and initialize the Generic VU1 renderer, set its GS alpha/depth state, upload the ten
   qword camera and packet constant block, start entry zero, and reset VIF BASE, OFFSET, and ROW."
  (when (logtest? *vu1-enable-user* (vu1-renderer-mask generic))
    (dma-buffer-add-vu-function dma-buf generic-vu1-block 1)
    (let* ((buffer dma-buf)
           (upload-packet (the-as dma-packet (-> buffer base))))
      (set! (-> upload-packet dma) (new 'static 'dma-tag :qwc #x3 :id (dma-tag-id cnt)))
      (set! (-> upload-packet vif0) (new 'static 'vif-tag))
      (set! (-> upload-packet vif1)
            (new 'static 'vif-tag :imm #x3 :cmd (vif-cmd direct) :msk #x1))
      (set! (-> buffer base) (the-as pointer (&+ upload-packet 16))))
    (let* ((buffer dma-buf)
           (direct-tag (the-as gs-gif-tag (-> buffer base))))
      (set! (-> direct-tag tag) (new 'static 'gif-tag64 :nloop #x1 :eop #x1 :nreg #x2))
      (set! (-> direct-tag regs)
            (new 'static
                 'gif-tag-regs
                 :regs0 (gif-reg-id a+d)
                 :regs1 (gif-reg-id a+d)
                 :regs2 (gif-reg-id a+d)
                 :regs3 (gif-reg-id a+d)
                 :regs4 (gif-reg-id a+d)
                 :regs5 (gif-reg-id a+d)
                 :regs6 (gif-reg-id a+d)
                 :regs7 (gif-reg-id a+d)
                 :regs8 (gif-reg-id a+d)
                 :regs9 (gif-reg-id a+d)
                 :regs10 (gif-reg-id a+d)
                 :regs11 (gif-reg-id a+d)
                 :regs12 (gif-reg-id a+d)
                 :regs13 (gif-reg-id a+d)
                 :regs14 (gif-reg-id a+d)
                 :regs15 (gif-reg-id a+d)))
      (set! (-> buffer base) (the-as pointer (&+ direct-tag 16))))
    (let* ((buffer dma-buf)
           (gs-registers (-> buffer base)))
      (set! (-> (the-as (pointer gs-test) gs-registers) 0)
            (new 'static
                 'gs-test
                 :ate #x1
                 :atst (gs-atest greater-equal)
                 :aref #x26
                 :afail #x1
                 :zte #x1
                 :ztst (gs-ztest greater-equal)))
      (set! (-> (the-as (pointer uint64) gs-registers) 1) (the-as uint (gs-reg test-1)))
      (set! (-> (the-as (pointer gs-zbuf) gs-registers) 2) zbuf)
      (set! (-> (the-as (pointer uint64) gs-registers) 3) (the-as uint (gs-reg zbuf-1)))
      (set! (-> buffer base) (&+ gs-registers 32)))
    (generic-add-constants dma-buf alpha-blend)
    ;; MSCALF with a zero immediate: entry GENERIC-VU1-INIT, which loads the constant block we just
    ;; uploaded and then falls through into the reset entry.
    (let* ((buffer dma-buf)
           (start-packet (the-as dma-packet (-> buffer base))))
      (set! (-> start-packet dma) (new 'static 'dma-tag :qwc #x2 :id (dma-tag-id cnt)))
      (set! (-> start-packet vif0)
            (new 'static 'vif-tag :cmd (vif-cmd mscalf) :msk #x1))
      (set! (-> start-packet vif1) (new 'static 'vif-tag :cmd (vif-cmd stmod)))
      (set! (-> buffer base) (the-as pointer (&+ start-packet 16))))
    (let ((vif-state (the-as (pointer int32) (-> dma-buf base))))
      (set! (-> (the-as (pointer vif-tag) vif-state) 0)
            (new 'static 'vif-tag :cmd (vif-cmd base)))
      (set! (-> (the-as (pointer vif-tag) vif-state) 1)
            (new 'static 'vif-tag :cmd (vif-cmd offset)))
      (set! (-> (the-as (pointer vif-tag) vif-state) 2) (new 'static 'vif-tag))
      (set! (-> (the-as (pointer vif-tag) vif-state) 3)
            (new 'static 'vif-tag :cmd (vif-cmd strow) :msk #x1))
      (set! (-> vif-state 4) 0)
      (set! (-> vif-state 5) 0)
      (set! (-> vif-state 6) 0)
      (set! (-> vif-state 7) 0)
      (set! (-> dma-buf base) (&+ (the-as pointer vif-state) 32))))
  0
  (none))

;; unused
(defun generic-reset-buffers ((dma-buf dma-buffer) (output-buffer int) (input-buffer int))
  "Select one of the two VU1 header buffers and one of the three input-bank offsets, then call the
   buffer-install entry to adopt them. This helper is unused by the shipped game."
  ;; Normally the two rotations run themselves: the packet builder advances its copy of the cursors
  ;; and the VU program advances its own, and the two stay in step because they start together. This
  ;; is the override, for putting a sink back onto a known pair without re-uploading the program.
  (when (logtest? *vu1-enable-user* (vu1-renderer-mask generic))
    (let ((output-addresses (new 'static 'vector4w :x GENERIC-VU1-HEADER-A :y GENERIC-VU1-HEADER-B))
          ;; bank offsets, not cursors: the packet builder's inbuf-adr is one of these plus
          ;; GENERIC-VU1-INBUF-FIRST, because the first nine quadwords of a bank belong to strip 0.
          (input-offsets (new 'static 'vector4w :y #x117 :z #x22e)))
      (let* ((buffer dma-buf)
             (packet (the-as dma-packet (-> buffer base))))
        (set! (-> packet dma) (new 'static 'dma-tag :qwc #x2 :id (dma-tag-id cnt)))
        (set! (-> packet vif0)
              (new 'static 'vif-tag :imm #x404 :cmd (vif-cmd stcycl)))
        (set! (-> packet vif1)
              (new 'static
                   'vif-tag
                   :imm #x38a
                   :num #x1
                   :cmd (vif-cmd unpack-v4-32)))
        (set! (-> buffer base)
              (the-as pointer (the-as dma-packet (&+ (the-as pointer packet) 16)))))
      (let ((control (the-as (pointer uint32) (-> dma-buf base))))
        (set! (-> control 0) 0)
        (set! (-> control 1) 0)
        (let ((output-address (-> output-addresses data output-buffer)))
          (set! (-> control 2) output-address))
        (let ((input-offset (-> input-offsets data input-buffer)))
          (set! (-> control 3) input-offset))
        (set! (-> control 4) 0)
        (set! (-> control 5) 0)
        (set! (-> control 6) 0)
        ;; The last word of the payload is read back as a VIF code: MSCALF with immediate
        ;; GENERIC-VU1-SET-BUFFERS, so the unpack and the call are one packet.
        (let ((mscalf-set-buffers (the-as uint #x1500000c)))
          (set! (-> control 7) mscalf-set-buffers))
        (set! (-> dma-buf base) (&+ (the-as pointer control) 32)))))
  0
  (none))

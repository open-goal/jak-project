;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/math/vector-h.gc")
(require "engine/gfx/generic/generic-h.gc")
(require "engine/gfx/generic/generic-vu1-h.gc")
(require "engine/gfx/vu1-user-h.gc")
(require "engine/gfx/math-camera-h.gc")
(require "engine/gfx/hw/gs.gc")
(#when PC_PORT
  ;; The PC renderer consumes the Generic DMA packets directly and does not execute the VU1
  ;; program, but the packet builder still needs this object while constructing the upload chain.
  (define generic-vu1-block (new 'static 'vu-function :length #x0 :qlength #x0)))

;; Generic input occupies three 279-qword VIF input banks at 0, 279, and 558.  vi12 selects
;; the active input bank.  The two 30-qword header buffers begin at 837 and 867, with vi13
;; selecting the one currently in use; each holds the transform matrix, the strip GIF tag, two A+D
;; quadwords, and the fragment's adgif shaders.  Camera, fog, GIF, and packet constants occupy
;; qwords 897 through 906.  The remaining memory holds six clipping-plane records, linked edge
;; lists, projected vertices, and the temporary GIF packet used when a strip crosses the view
;; volume.
;;
;; There is no separate GIF output buffer.  The draw path transforms each vertex in place inside the
;; input bank and then writes a nine-qword prologue - adgif tag, shader, the two A+D quadwords, and
;; the strip GIF tag with its NLOOP filled in - into the bank immediately ahead of each strip's
;; vertices, so one xgkick per fragment walks the whole thing.  This is why the uploaded stream
;; carries three padding vertices at every strip boundary: they are the space the prologue occupies.
;; Three input banks rather than two because that kick is asynchronous: the GIF is still reading one
;; bank while the EE uploads into the second and this program transforms the third.
;;
;; Each input vertex carries texture coordinates, packed color, and position.  The draw paths
;; transform positions with the uploaded matrix, divide by homogeneous w, apply the GS viewport
;; scale and offset, clamp depth and fog, convert the result to GS fixed point, and emit
;; ST/RGBAQ/XYZF2 triples.  Bit zero of S is not a coordinate: it carries the draw point's no-kick
;; flag, and a vertex that has it gets 3071.0 added to w before ftoi4, which lands in bit 15 of the
;; packed value as the GS ADC bit.  The full path records the VU clip flags and clips partially
;; visible strips against all six homogeneous view planes.  New edge vertices interpolate texture,
;; color, and position before projection so perspective correction remains valid.  A clipped triangle
;; does not rejoin the strip - it is drawn as its own triangle fan with its own kick, and TEST_1 is
;; restored afterwards.
;;
;; The entry table uses two instruction pairs per public entry:
;;   0  load the permanent constants and initialize all renderer state
;;   2  reset the output and clipping state without reloading constants
;;   4  finish without drawing
;;   6  transform and draw, running the polygon clipper on any triangle that crosses a plane
;;   8  transform and draw, testing the same clip flags but only rejecting: a crossing vertex gets
;;      3071.0 added to its w, which sets the GS ADC bit, and the strip carries on. Cheaper than
;;      entry 6 by the whole clipper, and correct wherever a dropped triangle is acceptable.
;;  10  rescale an already-packed position/color stream in place, then branch into entry 8's loop -
;;      it does not have a draw path of its own
;;  12  install the header-buffer and input-bank addresses uploaded at qword 906
(#unless PC_PORT
  (defvu1 generic-vu1-block
    ;; Register aliases. These seven vector registers are loaded once by the init entry and are live for
    ;; the whole program, and the four transform rows are reloaded per strip but always mean the same
    ;; thing, so all eleven are named. The two buffer selectors and the vertex cursor are named for the
    ;; same reason.
    ;;
    ;; Nothing else is. This is four largely independent programs sharing one instruction memory - the
    ;; in-place fixup, the two transform pipelines, and the clipper - and they disagree about almost
    ;; every remaining register. vi01 through vi09 are addresses, counts, kick comparands and clip flags
    ;; in the transform loops and plane pointers, edge cursors and endpoint pointers in the clipper;
    ;; vf12 through vf31 are four vertices in flight in one and clip-space endpoints, plane distances and
    ;; GIF payloads in the other. One alias set would be wrong three quarters of the time, so those keep
    ;; their physical names and each section says below what it is using them for.
    (rlet ((fog-consts :reg vf01)     ;; x pfog0, y fog-min, z fog-max, w 3071.0 - the ADC bias
           (adgif-tag :reg vf02)
           (hvdf-offset :reg vf04)
           (hmge-scale :reg vf05)
           (invh-scale :reg vf06)
           (guard :reg vf07)          ;; guard-band scale, applied before the clip test
           (xform-row-0 :reg vf08)    ;; the four rows arrive per strip out of the header buffer
           (xform-row-1 :reg vf09)
           (xform-row-2 :reg vf10)
           (xform-row-3 :reg vf11)
           (header-buf :reg vi13)     ;; the header buffer this invocation reads its matrix and shaders from
           (input-bank :reg vi12)     ;; the input bank it transforms in place
           (transform-return :reg vi15) ;; where a clipped draw returns to in the transform loop
           ;; Two registers that mean one thing in the transform loops and another in the clipper. Both
           ;; names are given; each use site picks the one that is true where it stands.
           (vertex-cursor :reg vi10)  ;; transform: three quadwords per vertex
           (pending-depth :reg vi10)  ;; clipper: depth of the pending edge-list stack
           (triangle-count :reg vi11) ;; transform: starts at -2, so it reaches zero on the third vertex
           (clip-link :reg vi11))     ;; clipper: link register for the plane helpers and the interpolator
    ;; Public entry table.
    (vu-pair (b load-constants) (nop)) ;; #x000
    (vu-pair (nop) (nop)) ;; #x001
    (vu-pair (b reset-buffers-and-planes) (nop)) ;; #x002
    (vu-pair (nop) (nop)) ;; #x003
    (vu-pair (b program-done) (nop)) ;; #x004
    (vu-pair (nop) (nop)) ;; #x005
    (vu-pair (b clip-select-header) (nop)) ;; #x006
    (vu-pair (nop) (nop)) ;; #x007
    (vu-pair (b direct-select-header) (nop)) ;; #x008
    (vu-pair (nop) (nop)) ;; #x009
    (vu-pair (b fixup-rewrite-header) (nop)) ;; #x00a
    (vu-pair (nop) (nop)) ;; #x00b
    (vu-pair (b adopt-external-buffers) (nop)) ;; #x00c
    (vu-pair (nop) (nop)) ;; #x00d
    ;; Entry 10: normalize a packed input stream in place before joining the transform path.
    (label fixup-rewrite-header)
    (vu-pair (iaddiu vi02 vi00 0x381) (nop)) ;; #x00e
    (vu-pair (lq.xyzw vf31 vi02 (generic-const-qword adnop)) (nop)) ;; #x00f
    (vu-pair (isubiu vi02 header-buf 0x363) (addw.z vf22 vf00 vf00)) ;; #x010
    (vu-pair (iaddiu header-buf header-buf 0x1e) (addw.z vf23 vf00 vf00)) ;; #x011
    (vu-pair (ibne vi00 vi02 fixup-set-up-scan) (addw.z vf24 vf00 vf00)) ;; #x012
    (vu-pair (lq.xyzw vf03 vi00 899) (addw.z vf25 vf00 vf00)) ;; #x013
    (vu-pair (iaddiu header-buf vi00 0x345) (nop)) ;; #x014
    (label fixup-set-up-scan)
    (vu-pair (ilw.x vi01 header-buf 5) (nop)) ;; #x015
    (vu-pair (iaddi vi07 input-bank 0xa) (nop)) ;; #x016
    (vu-pair (iaddi vi05 vi01 -0x1) (nop)) ;; #x017
    (vu-pair (lq.xyzw vf17 header-buf 4) (nop)) ;; #x018
    (vu-pair (sq.xyzw vf31 header-buf 5) (nop)) ;; #x019
    (vu-pair (sq.xyzw vf31 header-buf 6) (nop)) ;; #x01a
    (vu-pair (0.0078125) (nop :i)) ;; #x01b
    (vu-pair (move.xyzw vf13 vf17) (muli.xyz vf17 vf17 I)) ;; #x01c
    (vu-pair (move.xyzw vf14 vf17) (nop)) ;; #x01d
    (vu-pair (move.xyzw vf15 vf17) (nop)) ;; #x01e
    (vu-pair (move.xyzw vf16 vf17) (nop)) ;; #x01f
    (vu-pair (sq.xyzw vf03 header-buf 4) (nop)) ;; #x020
    (vu-pair (isw.w vi01 header-buf 5) (nop)) ;; #x021
    (vu-pair (isw.w vi00 header-buf 6) (nop)) ;; #x022
    (label fixup-convert-four)
    (vu-pair (lq.xyz vf13 vi07 0) (nop)) ;; #x023
    (vu-pair (lq.xyz vf14 vi07 3) (nop)) ;; #x024
    (vu-pair (lq.xyz vf15 vi07 6) (nop)) ;; #x025
    (vu-pair (lq.xyz vf16 vi07 9) (nop)) ;; #x026
    (vu-pair (iaddi vi07 vi07 0xc) (itof0.xyz vf13 vf13)) ;; #x027
    (vu-pair (iaddi vi05 vi05 -0x4) (itof0.xyz vf14 vf14)) ;; #x028
    (vu-pair (nop) (itof0.xyz vf15 vf15)) ;; #x029
    (vu-pair (nop) (itof0.xyz vf16 vf16)) ;; #x02a
    (vu-pair (nop) (mul.xyz vf13 vf13 vf17)) ;; #x02b
    (vu-pair (nop) (mul.xyz vf14 vf14 vf17)) ;; #x02c
    (vu-pair (nop) (mul.xyz vf15 vf15 vf17)) ;; #x02d
    (vu-pair (nop) (mul.xyz vf16 vf16 vf17)) ;; #x02e
    (vu-pair (lq.xyzw vf18 vi07 -11) (ftoi0.xyz vf13 vf13)) ;; #x02f
    (vu-pair (lq.xyzw vf19 vi07 -8) (ftoi0.xyz vf14 vf14)) ;; #x030
    (vu-pair (lq.xyzw vf20 vi07 -5) (ftoi0.xyz vf15 vf15)) ;; #x031
    (vu-pair (lq.xyzw vf21 vi07 -2) (ftoi0.xyz vf16 vf16)) ;; #x032
    (vu-pair (sq.xyzw vf13 vi07 -12) (itof0.xyzw vf18 vf18)) ;; #x033
    (vu-pair (sq.xyzw vf14 vi07 -9) (itof0.xyzw vf19 vf19)) ;; #x034
    (vu-pair (sq.xyzw vf15 vi07 -6) (itof0.xyzw vf20 vf20)) ;; #x035
    (vu-pair (sq.xyzw vf16 vi07 -3) (itof0.xyzw vf21 vf21)) ;; #x036
    (vu-pair (sq.xyzw vf18 vi07 -11) (nop)) ;; #x037
    (vu-pair (sq.xyzw vf19 vi07 -8) (nop)) ;; #x038
    (vu-pair (sq.xyzw vf20 vi07 -5) (nop)) ;; #x039
    (vu-pair (ibgez vi05 fixup-convert-four) (nop)) ;; #x03a
    (vu-pair (sq.xyzw vf21 vi07 -2) (nop)) ;; #x03b
    (vu-pair (b direct-next-strip) (nop)) ;; #x03c
    (vu-pair (nop) (nop)) ;; #x03d
    ;; Entry 0 begins here.  Load the ten-qword constant block, then fall through to entry 2.
    (label load-constants)
    (vu-pair (iaddiu vi01 vi00 0x381) (nop)) ;; #x03e
    (vu-pair (lq.xyzw fog-consts vi01 (generic-const-qword fog)) (nop)) ;; #x03f
    (vu-pair (lq.xyzw adgif-tag vi01 (generic-const-qword adgif)) (nop)) ;; #x040
    (vu-pair (lq.xyzw vf03 vi01 (generic-const-qword giftag)) (nop)) ;; #x041
    (vu-pair (lq.xyzw hvdf-offset vi01 (generic-const-qword hvdf-offset)) (nop)) ;; #x042
    (vu-pair (lq.xyzw hmge-scale vi01 (generic-const-qword hmge-scale)) (nop)) ;; #x043
    (vu-pair (lq.xyzw invh-scale vi01 (generic-const-qword invh-scale)) (nop)) ;; #x044
    (vu-pair (lq.xyzw guard vi01 (generic-const-qword guard)) (nop)) ;; #x045
    ;; Entry 2: choose the first input bank and GIF buffer and initialize the six clip-plane records.
    (label reset-buffers-and-planes)
    (vu-pair (iaddiu header-buf vi00 0x363) (nop)) ;; #x046
    (vu-pair (iaddi vi02 header-buf 0x5) (nop)) ;; #x047
    (vu-pair (iaddi input-bank vi00 0x0) (nop)) ;; #x048
    (vu-pair (isw.x vi02 vi01 (generic-const-qword stores)) (nop)) ;; #x049
    (vu-pair (isw.y vi02 vi01 (generic-const-qword stores)) (nop)) ;; #x04a
    (vu-pair (sq.xyzw vf00 vi00 907) (nop)) ;; #x04b
    (vu-pair (sq.xyzw vf00 vi00 914) (nop)) ;; #x04c
    (vu-pair (sq.xyzw vf00 vi00 921) (nop)) ;; #x04d
    (vu-pair (sq.xyzw vf00 vi00 928) (nop)) ;; #x04e
    (vu-pair (sq.xyzw vf00 vi00 935) (nop)) ;; #x04f
    (vu-pair (sq.xyzw vf00 vi00 942) (nop)) ;; #x050
    (vu-pair (iaddiu vi01 vi00 (vu-label negative-x-distance)) (nop)) ;; #x051
    (vu-pair (isw.z vi01 vi00 907) (nop)) ;; #x052
    (vu-pair (iaddiu vi01 vi00 (vu-label positive-x-distance)) (nop)) ;; #x053
    (vu-pair (isw.z vi01 vi00 914) (nop)) ;; #x054
    (vu-pair (iaddiu vi01 vi00 (vu-label negative-y-distance)) (nop)) ;; #x055
    (vu-pair (isw.z vi01 vi00 921) (nop)) ;; #x056
    (vu-pair (iaddiu vi01 vi00 (vu-label positive-y-distance)) (nop)) ;; #x057
    (vu-pair (isw.z vi01 vi00 928) (nop)) ;; #x058
    (vu-pair (iaddiu vi01 vi00 (vu-label negative-z-distance)) (nop)) ;; #x059
    (vu-pair (isw.z vi01 vi00 935) (nop)) ;; #x05a
    (vu-pair (iaddiu vi01 vi00 (vu-label positive-z-distance)) (nop :e)) ;; #x05b
    (vu-pair (isw.z vi01 vi00 942) (nop)) ;; #x05c
    ;; Entry 12: load the externally selected GIF-buffer and input-bank bases from qword 906.
    (label adopt-external-buffers)
    (vu-pair (iaddiu vi01 vi00 0x381) (nop)) ;; #x05d
    (vu-pair (ilw.z header-buf vi01 (generic-const-qword stores)) (nop)) ;; #x05e
    (vu-pair (ilw.w input-bank vi01 (generic-const-qword stores)) (nop)) ;; #x05f
    (vu-pair (iaddi vi02 header-buf 0x6) (nop)) ;; #x060
    (vu-pair (isw.x vi02 vi01 (generic-const-qword stores)) (nop :e)) ;; #x061
    (vu-pair (isw.y vi02 vi01 (generic-const-qword stores)) (nop)) ;; #x062
    (vu-pair (isubiu vi02 header-buf 0x363) (nop)) ;; #x063
    (vu-pair (iaddiu header-buf header-buf 0x1e) (nop)) ;; #x064
    (vu-pair (ibne vi00 vi02 external-buffers-installed) (nop)) ;; #x065
    (vu-pair (isubiu vi01 vi01 0x100) (nop)) ;; #x066
    (vu-pair (iaddiu header-buf vi00 0x345) (nop)) ;; #x067
    (label external-buffers-installed)
    (vu-pair (iaddi vi03 header-buf 0x7) (nop)) ;; #x068
    (vu-pair (iaddi vi03 header-buf 0x7) (nop)) ;; #x069
    (vu-pair (isw.x vi03 vi00 906) (nop)) ;; #x06a
    (vu-pair (jr transform-return) (nop)) ;; #x06b
    (vu-pair (isw.y vi03 vi00 906) (nop)) ;; #x06c
    ;; Entry 8: transform and project a strip which can go directly to the GIF packet builder.
    (label direct-select-header)
    (vu-pair (isubiu vi02 header-buf 0x363) (addw.z vf22 vf00 vf00)) ;; #x06d
    (vu-pair (iaddiu header-buf header-buf 0x1e) (addw.z vf23 vf00 vf00)) ;; #x06e
    (vu-pair (ibne vi00 vi02 direct-begin-strip) (addw.z vf24 vf00 vf00)) ;; #x06f
    (vu-pair (nop) (addw.z vf25 vf00 vf00)) ;; #x070
    (vu-pair (iaddiu header-buf vi00 0x345) (nop)) ;; #x071
    (label direct-begin-strip)
    (vu-pair (iaddi vi03 header-buf 0x7) (nop)) ;; #x072
    (vu-pair (ilw.w vi01 header-buf 5) (nop)) ;; #x073
    (vu-pair (isw.x vi03 vi00 906) (nop)) ;; #x074
    (vu-pair (iaddi vertex-cursor input-bank 0x9) (subw.w vf18 vf00 vf00)) ;; #x075
    (vu-pair (lq.xyzw xform-row-0 header-buf 0) (subw.w vf19 vf00 vf00)) ;; #x076
    (vu-pair (lq.xyzw xform-row-1 header-buf 1) (subw.w vf20 vf00 vf00)) ;; #x077
    (vu-pair (lq.xyzw xform-row-2 header-buf 2) (subw.w vf21 vf00 vf00)) ;; #x078
    (vu-pair (lq.xyzw xform-row-3 header-buf 3) (ftoi12.z vf22 vf22)) ;; #x079
    (vu-pair (iadd vi02 vi01 vi01) (ftoi12.z vf23 vf23)) ;; #x07a
    (vu-pair (iadd vi01 vi01 vi02) (sub.xyzw vf16 vf16 vf16)) ;; #x07b
    (vu-pair (iaddi triangle-count vi00 -0x2) (sub.xyzw vf17 vf17 vf17)) ;; #x07c
    (vu-pair (lq.xy vf22 vertex-cursor 0) (nop)) ;; #x07d
    (vu-pair (lq.xyz vf16 vertex-cursor 2) (nop)) ;; #x07e
    (vu-pair (mtir vi02 vf22.x) (mulaw.xyzw ACC xform-row-3 vf00)) ;; #x07f
    (vu-pair (iaddi vertex-cursor vertex-cursor 0x3) (maddax.xyzw ACC xform-row-0 vf16)) ;; #x080
    (vu-pair (lq.xy vf23 vertex-cursor 0) (madday.xyzw ACC xform-row-1 vf16)) ;; #x081
    (vu-pair (lq.xyz vf17 vertex-cursor 2) (nop)) ;; #x082
    (vu-pair (iand vi06 vi02 triangle-count) (nop)) ;; #x083
    (vu-pair (mfir.x vf22 vi06) (maddz.xyzw vf12 xform-row-2 vf16)) ;; #x084
    (vu-pair (iadd vi14 vertex-cursor vi01) (ftoi12.z vf24 vf24)) ;; #x085
    (vu-pair (isw.w input-bank vi00 906) (ftoi12.z vf25 vf25)) ;; #x086
    (vu-pair (nop) (nop)) ;; #x087
    (vu-pair (div Q fog-consts.x vf12.w) (itof12.xyz vf18 vf22)) ;; #x088
    (vu-pair (mtir vi03 vf23.x) (mulaw.xyzw ACC xform-row-3 vf00)) ;; #x089
    (vu-pair (iaddi vertex-cursor vertex-cursor 0x3) (maddax.xyzw ACC xform-row-0 vf17)) ;; #x08a
    (vu-pair (lq.xy vf24 vertex-cursor 0) (madday.xyzw ACC xform-row-1 vf17)) ;; #x08b
    (vu-pair (lq.xyz vf16 vertex-cursor 2) (nop)) ;; #x08c
    (vu-pair (iand vi07 vi03 triangle-count) (nop)) ;; #x08d
    (vu-pair (mfir.x vf23 vi07) (maddz.xyzw vf13 xform-row-2 vf17)) ;; #x08e
    (vu-pair (nop) (mul.xyz vf12 vf12 Q)) ;; #x08f
    (vu-pair (nop) (mul.xyz vf18 vf18 Q)) ;; #x090
    (vu-pair (nop) (nop)) ;; #x091
    (vu-pair (div Q fog-consts.x vf13.w) (itof12.xyz vf19 vf23)) ;; #x092
    (vu-pair (nop) (add.xyzw vf12 vf12 hvdf-offset)) ;; #x093
    (vu-pair (mtir vi04 vf24.x) (mulaw.xyzw ACC xform-row-3 vf00)) ;; #x094
    (vu-pair (iaddi vertex-cursor vertex-cursor 0x3) (maddax.xyzw ACC xform-row-0 vf16)) ;; #x095
    (vu-pair (lq.xy vf25 vertex-cursor 0) (madday.xyzw ACC xform-row-1 vf16)) ;; #x096
    (vu-pair (lq.xyz vf17 vertex-cursor 2) (miniz.w vf12 vf12 fog-consts)) ;; #x097
    (vu-pair (iand vi08 vi04 triangle-count) (nop)) ;; #x098
    (vu-pair (mfir.x vf24 vi08) (maddz.xyzw vf14 xform-row-2 vf16)) ;; #x099
    (vu-pair (nop) (mul.xyz vf13 vf13 Q)) ;; #x09a
    (vu-pair (nop) (mul.xyz vf19 vf19 Q)) ;; #x09b
    (vu-pair (iaddi vi14 vi14 0x9) (maxy.w vf12 vf12 fog-consts)) ;; #x09c
    ;; Prime the four-deep pipeline. Four vertices are in flight at once - vf22 through vf25 hold their
    ;; packed coordinates and vf12 through vf15 their clip-space positions - so the loop proper cannot
    ;; start until four are loaded, four transforms are under way and the first divide has been issued.
    (label direct-prime-divide)
    (vu-pair (div Q fog-consts.x vf14.w) (itof12.xyz vf20 vf24)) ;; #x09d
    (vu-pair (ibeq vi02 vi06 direct-prime-slot-0) (add.xyzw vf13 vf13 hvdf-offset)) ;; #x09e
    (vu-pair (mtir vi05 vf25.x) (mulaw.xyzw ACC xform-row-3 vf00)) ;; #x09f
    (vu-pair (nop) (addw.w vf12 vf12 fog-consts)) ;; #x0a0
    (label direct-prime-slot-0)
    (vu-pair (iaddi vertex-cursor vertex-cursor 0x3) (maddax.xyzw ACC xform-row-0 vf17)) ;; #x0a1
    (vu-pair (lq.xy vf22 vertex-cursor 0) (madday.xyzw ACC xform-row-1 vf17)) ;; #x0a2
    (vu-pair (lq.xyz vf16 vertex-cursor 2) (miniz.w vf13 vf13 fog-consts)) ;; #x0a3
    (vu-pair (iand vi09 vi05 triangle-count) (ftoi4.xyzw vf12 vf12)) ;; #x0a4
    (vu-pair (mfir.x vf25 vi09) (maddz.xyzw vf15 xform-row-2 vf17)) ;; #x0a5
    (vu-pair (sq.xyzw vf18 vertex-cursor -12) (mul.xyz vf14 vf14 Q)) ;; #x0a6
    (vu-pair (ibeq vi14 vertex-cursor direct-strip-complete) (mul.xyz vf20 vf20 Q)) ;; #x0a7
    (vu-pair (sq.xyzw vf12 vertex-cursor -10) (maxy.w vf13 vf13 fog-consts)) ;; #x0a8
    (vu-pair (div Q fog-consts.x vf15.w) (itof12.xyz vf21 vf25)) ;; #x0a9
    (vu-pair (ibeq vi03 vi07 direct-prime-slot-1) (add.xyzw vf14 vf14 hvdf-offset)) ;; #x0aa
    (vu-pair (mtir vi02 vf22.x) (mulaw.xyzw ACC xform-row-3 vf00)) ;; #x0ab
    (vu-pair (nop) (addw.w vf13 vf13 fog-consts)) ;; #x0ac
    (label direct-prime-slot-1)
    (vu-pair (iaddi vertex-cursor vertex-cursor 0x3) (maddax.xyzw ACC xform-row-0 vf16)) ;; #x0ad
    (vu-pair (lq.xy vf23 vertex-cursor 0) (madday.xyzw ACC xform-row-1 vf16)) ;; #x0ae
    (vu-pair (lq.xyz vf17 vertex-cursor 2) (miniz.w vf14 vf14 fog-consts)) ;; #x0af
    (vu-pair (iand vi06 vi02 triangle-count) (ftoi4.xyzw vf13 vf13)) ;; #x0b0
    (vu-pair (mfir.x vf22 vi06) (maddz.xyzw vf12 xform-row-2 vf16)) ;; #x0b1
    (vu-pair (sq.xyzw vf19 vertex-cursor -12) (mul.xyz vf15 vf15 Q)) ;; #x0b2
    (vu-pair (ibeq vi14 vertex-cursor direct-strip-complete) (mul.xyz vf21 vf21 Q)) ;; #x0b3
    (vu-pair (sq.xyzw vf13 vertex-cursor -10) (maxy.w vf14 vf14 fog-consts)) ;; #x0b4
    (vu-pair (div Q fog-consts.x vf12.w) (itof12.xyz vf18 vf22)) ;; #x0b5
    (vu-pair (ibeq vi04 vi08 direct-prime-slot-2) (add.xyzw vf15 vf15 hvdf-offset)) ;; #x0b6
    (vu-pair (mtir vi03 vf23.x) (mulaw.xyzw ACC xform-row-3 vf00)) ;; #x0b7
    (vu-pair (nop) (addw.w vf14 vf14 fog-consts)) ;; #x0b8
    (label direct-prime-slot-2)
    (vu-pair (iaddi vertex-cursor vertex-cursor 0x3) (maddax.xyzw ACC xform-row-0 vf17)) ;; #x0b9
    (vu-pair (lq.xy vf24 vertex-cursor 0) (madday.xyzw ACC xform-row-1 vf17)) ;; #x0ba
    (vu-pair (lq.xyz vf16 vertex-cursor 2) (miniz.w vf15 vf15 fog-consts)) ;; #x0bb
    (vu-pair (iand vi07 vi03 triangle-count) (ftoi4.xyzw vf14 vf14)) ;; #x0bc

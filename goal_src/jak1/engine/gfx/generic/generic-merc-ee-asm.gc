                 (s.w a3 a2 128)
                 (nop!)
                 (s.w a1 a2 16)
                 (add.i a3 r0 DMA-CHCR-STR)
                 (s.w a0 a2 32)
                 (add a0 a1 t0)
                 (s.w a3 a2)
                 (nop!)
                 (s.w a0 at (generic-work-offset saves basep))
                 (m a0 r0)

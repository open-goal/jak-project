                 (l.w v1 v1 #x1c80)
                 (lui a0 #x7000)
                 (l.wu a0 a0 76)
                 (sub v1 v1 a0)
                 (slt v1 r0 v1)
                 (b.nz v1 gme-fragment-visible :delay (m v1 s7))
                 (lui v1 #x7000)
                 (s.b r0 v1 (generic-work-offset in-buf merc ctrl header display-this-fragment))
                 (lui v1 #x7000)
                 (s.b r0 v1 (generic-work-offset in-buf merc ctrl header display-triangles))
                 (m v1 r0))

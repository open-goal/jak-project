                 (l.hu v1 v1 #x1a6c)
                 (s.q v1 sp 96)
                 (l.hu v1 s1 20)
                 (s.q v1 sp 112)
                 (add.i v1 sp 16)
                 (s.q v1 sp 128)
                 (l.q v1 sp 128)
                 (s.q r0 v1)
                 (add.i v1 sp 32)
                 (s.q v1 sp 144)
                 (l.q v1 sp 144)
                 (s.q r0 v1)

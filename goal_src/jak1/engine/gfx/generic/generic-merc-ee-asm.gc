    (vu-pair (iaddiu vi01 vi00 0x13a) (nop)) ;; #x00f
    (vu-pair (ior vi01 vi03 vi00) (nop)) ;; #x010
    (label stage-vertex-stream)
    (vu-pair (lqi.xyzw vf29 vi10) (nop)) ;; #x011
    (vu-pair (iadd vi02 vi08 vi11) (nop)) ;; #x012
    (vu-pair (iadd vi04 vi02 vi12) (nop)) ;; #x013
    (vu-pair (iadd vi06 vi04 vi13) (nop)) ;; #x014
    (vu-pair (mtir vi13 vf29.w) (itof0.xyzw vf18 vf29 :e)) ;; #x015
    (vu-pair (iaddiu vi09 vi00 0x7f) (nop)) ;; #x016
    (vu-pair (sq.xyzw vf23 vi14 3) (mulx.xyzw vf11 vf20 vf19)) ;; #x017

;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/gfx/sprite/sprite.gc")
(require "engine/gfx/math-camera.gc")

;; Draws the heat-haze/water-warp particles. These distort
;; a roughly circular area underneath the particle.

;; The mesh contains two conentric rings of vertices. Both rings have `turns` vertices.
;; So `turns = 3` would be a triangle, turns = 4 is a square, etc.

;; There is a triangle fan at the center, using the vertices of the inner ring,
;; and a triangle strip in between the inner and outer rings.
;; The center and outer ring sample the framebuffer at their current position and
;; the inner ring samples at an offset. This makes the center and edge of the distort sprite
;; have no distortion, eliminating discontinuities and making the effect clearly centered around
;; the sprite's center.

;; This geometry is controlled by the color: red controls the outer ring radius, g the inner,
;; and b the sampling location of the inner ring. Setting g = b will effectively disable the effect,
;; increasing the difference will increase the strength.

;; DECOMP BEGINS

;; Unit spokes for every supported side count. Each spoke is stored twice: once in projected screen
;; units for the mesh, then in framebuffer ST units for sampling. ientry points VU1 at the right set
;; for a given `turns`; the last angle-zero pair closes the 11-sided set.
(deftype sprite-distorter-sine-tables (basic)
  ((aspx   float)
   (aspy   float)
   (entry  vector 128 :inline)
   (ientry qword 9 :inline)
   (giftag gs-gif-tag :inline)
   (color  qword :inline)))

;; VU1 memory for the distorter.
;;
;;   352 - 479   entry: 128 quadwords, alternating screen direction and framebuffer ST offset
;;   480 - 488   ientry: the first direction of each turn count from 3 through 11
;;   489         giftag: one strip of five vertices, its loop count patched per sprite
;;   490         color: neutral 128 grey
;;   511         the number of sprites in this batch
;;   512 -       three quadwords per sprite: projected centre, centre ST plus turn count, warp scales
;;
;;   0 - 175     GIF output buffer 0
;; 176 - 351     GIF output buffer 1
(defconstant SPRITE-DISTORT-VU-TABLES 352)

(defmacro sprite-distort-const (&rest path)
  `(+ SPRITE-DISTORT-VU-TABLES
      (/ (- (offset-of sprite-distorter-sine-tables ,@path)
            (offset-of sprite-distorter-sine-tables entry))
         16)))

(defconstant SPRITE-DISTORT-VU-COUNT 511)

(defconstant SPRITE-DISTORT-VU-INPUT 512)

(defconstant SPRITE-DISTORT-VU-GIF-BUFFER-0 0)

(defconstant SPRITE-DISTORT-VU-GIF-BUFFER-1 176)

(define *sprite-distorter-sine-tables* (new 'global 'sprite-distorter-sine-tables))

(defun sprite-distorter-generate-tables ()
  "Build the spoke tables used by the distortion mesh. Each spoke has matching screen-space and
   framebuffer-ST directions, and the tables are rebuilt when the projection changes."
  (let ((tables *sprite-distorter-sine-tables*))
    (let ((entry-index 0)
          (turn-table-index 0)
          (turns 3)
          ;; get camera aspect
          (aspect-x (- (-> *math-camera* perspective vector 0 x)))
          (aspect-y (- (-> *math-camera* perspective vector 1 y))))
      ;; regenerate if aspect ratio changed
      ;; og:preserve-this Fix intermittent crash on start up due to a race with the DMA
      (when #t
        (set! (-> tables aspx) aspect-x)
        (set! (-> tables aspy) aspect-y)
        (while (< turns 12)
          ;; ientry holds absolute VU addresses, and the program indexes it with turns - 3.
          (set! (-> tables ientry turn-table-index vector4w x) (+ entry-index SPRITE-DISTORT-VU-TABLES))
          (+! turn-table-index 1)
          (dotimes (i turns)
            (let ((angle (* 65536.0 (/ (the float i) (the float turns)))))
              (set-vector! (-> tables entry entry-index) (* (sin angle) aspect-x) (* (cos angle) aspect-y) 0.0 0.0)
              (let ((next-entry-index (+ entry-index 1)))
                ;; Same spoke as above, converted to the framebuffer's 512x256 ST grid.
                (set-vector! (-> tables entry next-entry-index)
                             (* (/ aspect-x 512) (sin angle))
                             (* (/ aspect-y 256) (cos angle))
                             0.0
                             0.0)
                (set! entry-index (+ next-entry-index 1)))))
          (+! turns 1))
        ;; final entry pair
        (set-vector! (-> tables entry entry-index) 0.0 aspect-y 0.0 0.0)
        (let ((closing-offset-index (+ entry-index 1)))
          (set-vector! (-> tables entry closing-offset-index) 0.0 (/ aspect-y 256) 0.0 0.0)
          (+ closing-offset-index 1) ;; ?
          )))
    ;; set up giftag
    (set! (-> tables giftag tag)
          (new 'static
               'gif-tag64
               :nloop #x1
               :eop #x1
               :pre #x1
               :prim
               (new 'static 'gs-prim :prim (gs-prim-type tri-strip) :tme #x1)
               :nreg #xf))
    ;; set up registers
    (set! (-> tables giftag regs) (gs-reg-list st rgbaq xyzf2 st rgbaq xyzf2 st rgbaq xyzf2 st rgbaq xyzf2 st rgbaq xyzf2))

    ;; set color
    (set! (-> tables color vector4w x) 128)
    (set! (-> tables color vector4w y) 128)
    (set! (-> tables color vector4w z) 128)
    (set! (-> tables color vector4w w) 128))
  0
  (none))

;; PC rendering does not execute the VU1 program in sprite-distort-vu1.gc, but the DMA-list builder
;; still requires a valid object.
(#when PC_PORT
  (define sprite-distort-vu1-block (new 'static 'vu-function)))

(defun sprite-init-distorter ((dma-buff dma-buffer) (frame-base-pointer uint))
  "Set up framebuffer sampling for the distortion pass, upload the spoke tables, and load its VU1
   program."
  ;;(format #t "distorter: ~d~%" (-> *sprite-aux-list* entry))
  ;; set up GS registers
  (dma-buffer-add-gs-set dma-buff
                         ;; dont update zbuffer
                         (zbuf-1 (new 'static 'gs-zbuf :zbp #x1c0 :psm (gs-psm ct24) :zmsk 1))
                         ;; use framebuffer as texture
                         (tex0-1 (new 'static 'gs-tex0 :tbw #x8 :tw #x9 :th #x8 :tbp0 (* frame-base-pointer 32)))
                         ;; bilinear filtering
                         (tex1-1 (new 'static 'gs-tex1 :mmag 1 :mmin 1))
                         ;; mipmapping
                         (miptbp1-1 (new 'static 'gs-miptbp))
                         ;; set texture wrap mode to clamp
                         (clamp-1 (new 'static
                                       'gs-clamp
                                       :wms (gs-tex-wrap-mode region-clamp)
                                       :wmt (gs-tex-wrap-mode region-clamp)
                                       :maxu #x1ff
                                       :maxv (-> *video-parms* screen-masky)))
                         ;; blend source and framebuffer RGB
                         (alpha-1 (new 'static 'gs-alpha :b 1 :d 1)))
  ;; send current aspect used by the sine tables (PC only)
  (#when PC_PORT
    (let ((packet (the-as dma-packet (-> dma-buff base))))
      (set! (-> packet dma) (new 'static 'dma-tag :id (dma-tag-id cnt) :qwc 1))
      (set! (-> packet vif0) (new 'static 'vif-tag))
      (set! (-> packet vif1) (new 'static 'vif-tag :cmd (vif-cmd pc-port)))
      (&+! (-> dma-buff base) 16))
    (let ((aspect-vec (the-as vector (-> dma-buff base))))
      (set-vector! aspect-vec (-> *sprite-distorter-sine-tables* aspx) (-> *sprite-distorter-sine-tables* aspy) 0.0 0.0)
      (&+! (-> dma-buff base) 16)))
  ;; send distorter sine tables
  (dma-buffer-add-ref-vif2 dma-buff
                           #x8b
                           (-> *sprite-distorter-sine-tables* entry)
                           (new 'static 'vif-tag :imm #x404 :cmd (vif-cmd stcycl))
                           (new 'static
                                'vif-tag
                                :imm
                                SPRITE-DISTORT-VU-TABLES
                                :num #x8b
                                :cmd (vif-cmd unpack-v4-32)))
  ;; load VU1 code
  (dma-buffer-add-vu-function dma-buff sprite-distort-vu1-block 1)
  0
  (none))

(defun sprite-draw-distorters ((dma-buff dma-buffer))
  "Project the distortion particles, clip them, and send the visible discs to VU1 in batches of at
   most 170. Bad side counts fall back to 11, and discs are shrunk to stay on the framebuffer."
  (local-vars (clip-flags int) (warp-sprite sprite-vec-data-2d) (center-st pointer) (warp-params pointer))
  (rlet ((acc :class vf)
         (Q :class vf)
         (vf0 :class vf)
         (vf1 :class vf)
         (vf10 :class vf)
         (vf2 :class vf)
         (vf3 :class vf)
         (vf4 :class vf)
         (vf5 :class vf)
         (vf6 :class vf)
         (vf8 :class vf)
         (vf9 :class vf))
    (init-vf0-vector)
    (.lvf vf8 (&-> *math-camera* hmge-scale quad))
    (let ((upload-tag (-> dma-buff base))
          (chunk-count 0)
          (uploaded-count 0))
      (&+! (-> dma-buff base) 16)
      (let* ((aux-list *sprite-aux-list*)
             (aux-count (-> aux-list entry)))
        (dotimes (i aux-count)
          (set! warp-sprite (-> aux-list data i))
          (let ((packed-sprite (the-as object (-> dma-buff base))))
            (set! center-st (&+ (the-as pointer packed-sprite) 16))
            (set! warp-params (&+ (the-as pointer packed-sprite) 32))
            (cond
              ((= (-> warp-sprite matrix) (sprite-matrix-mode screen))
               (.lvf vf3 (&-> *math-camera* sprite-2d vector 0 quad))
               (.lvf vf4 (&-> *math-camera* sprite-2d vector 1 quad))
               (.lvf vf5 (&-> *math-camera* sprite-2d vector 2 quad))
               (.lvf vf6 (&-> *math-camera* sprite-2d vector 3 quad))
               (.lvf vf9 (&-> *math-camera* sprite-2d-hvdf quad)))
              (else
               (.lvf vf3 (&-> *math-camera* camera-temp vector 0 quad))
               (.lvf vf4 (&-> *math-camera* camera-temp vector 1 quad))
               (.lvf vf5 (&-> *math-camera* camera-temp vector 2 quad))
               (.lvf vf6 (&-> *math-camera* camera-temp vector 3 quad))
               (.lvf vf9 (&-> *math-camera* hvdf-off quad))))
            (.lvf vf1 (&-> warp-sprite x-y-z-sx quad))
            (.lvf vf2 (&-> warp-sprite color quad))
            (.mul.w.vf acc vf6 vf0)
            (.add.mul.x.vf acc vf3 vf1 acc)
            (.add.mul.y.vf acc vf4 vf1 acc)
            (.add.mul.z.vf vf1 vf5 vf1 acc)
            (.mul.vf vf10 vf1 vf8)
            (.div.vf Q vf0 vf10 :fsf #b11 :ftf #b11)
            ;;(TODO.VCLIP vf10 vf10)
            (b! (zero? (-> warp-sprite flag)) cfg-21)
            (.wait.vf)
            (.mul.vf.xyz vf1 vf1 Q)
            (.mul.vf.xyz vf2 vf2 Q)
            ;;(.cfc2.i clip-flags Clipping)
            ;; og:preserve-this PC reads the portable clip result instead of the VU0 control register.
            (set! clip-flags (vu-clip vf10 0)) ;; safe to just drop the higher bits.
            (b! (logtest? clip-flags 63) cfg-21 :delay (.add.vf vf1 vf1 vf9))
            (.max.x.vf.w vf1 vf1 vf0)
            ;; VU1 gets the projected centre, its matching framebuffer ST, and the particle's RGB:
            ;; red = seamless outer radius, green = warp-ring radius, blue = sample radius there.
            (.svf (&-> (the-as vector packed-sprite) quad) vf1)
            (.svf (&-> (the-as vector warp-params) quad) vf2)
            (set! (-> (the-as vector packed-sprite) w) 255.0)
            (set! (-> (the-as (pointer float) center-st)) (* 0.001953125 (+ -1792.0 (-> (the-as vector packed-sprite) x))))
            (set! (-> (the-as vector center-st) y)
                  (* 0.00390625 (+ -2048.0 (the float (-> *video-parms* screen-hy)) (-> (the-as vector packed-sprite) y)))))
          (set! (-> (the-as vector center-st) z) 1.0)
          (when (or (< (-> warp-sprite flag) 3) (< 11 (-> warp-sprite flag)))
            (format 0 "Turns = ~D!!!~%" (-> warp-sprite flag))
            (set! (-> (the-as (pointer int32) warp-sprite) 4) 11))
          (set! (-> (the-as (pointer int32) center-st) 3) (-> warp-sprite flag))
          (let* ((projection-y (- (-> *math-camera* perspective vector 1 y)))
                 (center-t (-> (the-as vector center-st) y))
                 (bottom-t (+ center-t (* (-> (the-as (pointer float) warp-params)) projection-y)))
                 (visible-scale 256.0)
                 (warp-scale (-> (the-as (pointer float) warp-params))))
            ;; Keep the outer edge inside the bottom of the framebuffer and cap it at 128 pixels.
            ;; Scale all three radii together so the shape of the warp does not change.
            (if (< (the float (-> *video-parms* screen-sy)) bottom-t)
              (set! visible-scale (/ (- (the float (-> *video-parms* screen-sy)) center-t) projection-y)))
            (if (< 128.0 visible-scale) (set! visible-scale 128.0))
            (when (< visible-scale warp-scale)
              (let ((scale-ratio (/ visible-scale warp-scale))) (.mov vf1 scale-ratio))
              (.mul.x.vf vf2 vf2 vf1)
              (.svf (&-> (the-as vector warp-params) quad) vf2)))
          (&+! (-> dma-buff base) 48)
          (+! chunk-count 1)
          ;; One VIF UNPACK carries at most 85 three-quadword sprites. Two consecutive uploads fill
          ;; the 170-sprite VU input area before address 511 receives the total and MSCALF starts it.
          (when (= chunk-count 85)
            (let ((chunk-end (-> dma-buff base)))
              (set! (-> dma-buff base) upload-tag)
              (let* ((packet-buffer dma-buff)
                     (upload-packet (the-as dma-packet (-> packet-buffer base))))
                (set! (-> upload-packet dma) (new 'static 'dma-tag :id (dma-tag-id cnt) :qwc (* 3 chunk-count)))
                (set! (-> upload-packet vif0) (new 'static 'vif-tag))
                (set! (-> upload-packet vif1)
                      (new 'static
                           'vif-tag
                           :cmd (vif-cmd unpack-v4-32)
                           :imm
                           (shr (shl (+ (* 3 uploaded-count) SPRITE-DISTORT-VU-INPUT) 54) 54)
                           :num
                           (* 3 chunk-count)))
                (set! (-> packet-buffer base) (&+ (the-as pointer upload-packet) 16)))
              (set! (-> dma-buff base) chunk-end))
            (set! chunk-count 0)
            (+! uploaded-count 85)
            (when (= uploaded-count 170)
              (let* ((count-buffer dma-buff)
                     (count-packet (the-as dma-packet (-> count-buffer base))))
                (set! (-> count-packet dma) (new 'static 'dma-tag :qwc #x1 :id (dma-tag-id cnt)))
                (set! (-> count-packet vif0) (new 'static 'vif-tag))
                (set! (-> count-packet vif1) (new 'static 'vif-tag :imm SPRITE-DISTORT-VU-COUNT :num #x1 :cmd (vif-cmd unpack-v4-32)))
                (set! (-> count-buffer base) (&+ (the-as pointer count-packet) 16)))
              (let* ((data-buffer dma-buff)
                     (count-data (the-as vector4w (-> data-buffer base))))
                (set! (-> count-data x) uploaded-count)
                (set! (-> count-data y) 0)
                (set! (-> count-data z) 0)
                (set! (-> count-data w) 0)
                (set! (-> data-buffer base) (&+ (the-as pointer count-data) 16)))
              (let* ((run-buffer dma-buff)
                     (run-packet (the-as dma-packet (-> run-buffer base))))
                (set! (-> run-packet dma) (new 'static 'dma-tag :id (dma-tag-id cnt)))
                (set! (-> run-packet vif0) (new 'static 'vif-tag :cmd (vif-cmd mscalf) :msk #x1))
                (set! (-> run-packet vif1) (new 'static 'vif-tag :cmd (vif-cmd flush) :msk #x1))
                (set! (-> run-buffer base) (&+ (the-as pointer run-packet) 16)))
              (set! uploaded-count 0))
            (set! upload-tag (-> dma-buff base))
            (&+! (-> dma-buff base) 16))
          (label cfg-21)))
      (cond
        ((zero? chunk-count) (set! (-> dma-buff base) upload-tag) (nop!) 0)
        (else
         (let ((chunk-end (-> dma-buff base)))
           (set! (-> dma-buff base) upload-tag)
           (let* ((packet-buffer dma-buff)
                  (upload-packet (the-as dma-packet (-> packet-buffer base))))
             (set! (-> upload-packet dma) (new 'static 'dma-tag :id (dma-tag-id cnt) :qwc (* 3 chunk-count)))
             (set! (-> upload-packet vif0) (new 'static 'vif-tag))
             (set! (-> upload-packet vif1)
                   (new 'static
                        'vif-tag
                        :cmd (vif-cmd unpack-v4-32)
                        :imm
                        (shr (shl (+ (* 3 uploaded-count) SPRITE-DISTORT-VU-INPUT) 54) 54)
                        :num
                        (* 3 chunk-count)))
             (set! (-> packet-buffer base) (&+ (the-as pointer upload-packet) 16)))
           (set! (-> dma-buff base) chunk-end))))
      (let ((total-count (+ chunk-count uploaded-count)))
        (when (nonzero? total-count)
          (let* ((count-buffer dma-buff)
                 (count-packet (the-as dma-packet (-> count-buffer base))))
            (set! (-> count-packet dma) (new 'static 'dma-tag :qwc #x1 :id (dma-tag-id cnt)))
            (set! (-> count-packet vif0) (new 'static 'vif-tag))
            (set! (-> count-packet vif1) (new 'static 'vif-tag :imm SPRITE-DISTORT-VU-COUNT :num #x1 :cmd (vif-cmd unpack-v4-32)))
            (set! (-> count-buffer base) (&+ (the-as pointer count-packet) 16)))
          (let* ((data-buffer dma-buff)
                 (count-data (the-as vector4w (-> data-buffer base))))
            (set! (-> count-data x) total-count)
            (set! (-> count-data y) 0)
            (set! (-> count-data z) 0)
            (set! (-> count-data w) 0)
            (set! (-> data-buffer base) (&+ (the-as pointer count-data) 16)))
          (let ((run-packet (the-as dma-packet (-> dma-buff base))))
            (set! (-> run-packet dma) (new 'static 'dma-tag :id (dma-tag-id cnt)))
            (set! (-> run-packet vif0) (new 'static 'vif-tag :cmd (vif-cmd mscalf) :msk #x1))
            (set! (-> run-packet vif1) (new 'static 'vif-tag :cmd (vif-cmd flush) :msk #x1))
            (set! (-> dma-buff base) (&+ (the-as pointer run-packet) 16))))))
    0
    (none)))

;; og:preserve-this Fix intermittent crash on start up due to a race with the DMA
(sprite-distorter-generate-tables)

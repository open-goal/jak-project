;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "kernel/gcommon.gc")

;; sparticle (likely sprite - particle) is the particle system.
;; it handles spawning and updating particles and submits them
;; to the sprite renderer.

;; A type of particle is defined by a list of `field-init-spec`
;; The `init-spec` specifies a field by enum ID and how to initialize it: a constant, 
;; a random value in a certain range, etc.
;; For example, you might set the `texture` field to the texture-id, or the `scale-x`
;; to a random float between 0.8 and 1.2.

;; The fields are identified by an enum with a very specific grouping and order.
;; Fields are grouped based on their consumers, and ordered so consecutive field ids
;; within a group correspond to adjacent fields in memory.

;; The definitions are constant and built by the `defpart` macro. Customizing particles
;; is possible through callbacks, not modifying the definition.


;; There are five types of fields:
;; misc fields
;; sprite fields
;; cpu fields
;; launch fields
;; weird fields

;; these are arranged based on how the engine consumes.

;; List of all settable fields and group markers.
;; The documentation here is for the field values consumed by
;; the particle system, not the user-facing `defpart` options.
(defenum sp-field-id
  :type uint16
  
  ;; misc fields control particle launch settings
  (misc-fields-start 0)
  (spt-texture 1)       ;; texture-id of the particle
  (spt-anim 2)          ;; unused
  (spt-anim-speed 3)    ;; unused
  
  ;; callback on birth:
  ;;  (function sparticle-system sparticle-cpuinfo sprite-vec-data-2/3d sparticle-launcher sparticle-launch-state none)
  (spt-birth-func 4)
  (spt-joint/refpoint 5) ;; unused, use callbacks instead.
  (spt-num 6)            ;; particles to spawn per NTSC frame
  (spt-sound 7)          ;; sound-spec specifying sound effect
  (misc-fields-end 8)
  
  ;; sprite fields set the initial value of the rendering parameters.
  (sprite-fields-start 9)
  ;; position offset from the launch origin.
  (spt-x 10)
  (spt-y 11)
  (spt-z 12)
  (spt-scale-x 13) ;; x-axis scale
  (spt-rot-x 14)   ;; x-axis euler rotation for 3D sprites, unused for 2D
  (spt-rot-y 15)   ;; y-axis euler rotation for 3D sprites, unused for 2D
  (spt-rot-z 16)   ;; z-axis euler rotation for 3D, rotation for 2D (around cam axis)
  (spt-scale-y 17) ;; y-axis scale
  ;; initial color and alpha, from 0 to 255 (clamped)
  (spt-r 18)
  (spt-g 19)
  (spt-b 20)
  (spt-a 21)
  (sprite-fields-end 22)
  
  ;; sprite fields for the per-frame "CPU" update (movement, etc)
  (cpu-fields-start 23)
  (spt-omega 24)  ;; when "orbit" is enabled, the initial orbiting phase (angle)
  (spt-vel-x 25)  ;; x-axis velocity, or orbit angular velocity when "orbit" (launcher frame)
  (spt-vel-y 26)  ;; y-axis velocity, or orbit plane rotation when "orbit"
  (spt-vel-z 27)  ;; z-axis velocity, or orbit radius velocity when "orbit"
  (spt-scalevel-x 28) ;; x-axis scale velocity
  (spt-rotvel-x 29) ;; 3D sprite x euler angle rate
  (spt-rotvel-y 30) ;; 3D sprite y euler angle rate
  (spt-rotvel-z 31) ;; 3D sprite z euler angle rate, 2D sprite rotation rate
  (spt-scalevel-y 32) ;; y-axis scale velocity
  ;; color channel change per frame
  (spt-fade-r 33)
  (spt-fade-g 34)
  (spt-fade-b 35)
  (spt-fade-a 36)
  ;; acceleration. By default, in launcher frame, but in world if `use-global-acc` is set.
  (spt-accel-x 37)
  (spt-accel-y 38)
  (spt-accel-z 39)
  (spt-dummy 40)   ;; no effect
  ;; not used as an initialization value, corresponds
  ;; to a field written by the engine.
  (spt-quat-x 41)
  (spt-quat-y 42)
  (spt-quat-z 43)
  (spt-quad-w 44)
  (spt-friction 45) ;; x,y,z velocity damping.
  (spt-timer 46)    ;; liftime in 300Hz ticks, -1 is forever.
  (spt-flags 47)    ;; bitfield sp-cpuinfo-flag flags
  (spt-userdata 48) ;; 32-bit value for use in callbacks
  ;; callback run before a particle is processed
  ;;  (function sparticle-system sparticle-cpuinfo sprite-vec-data-2/3d)
  (spt-func 49)
  
  ;; next-time and next-launcher are set together.
  ;; after spt-next-time ticks (300Hz), the parameters of
  ;; next-launcher are applied.
  ;; Note that only sprite-fields and cpu-fields are modified this way.
  ;; Unspecfied fields remain the same. This allows multi-phase particles:
  ;; for example, it's common to have a next-launcher that only applies
  ;; a `:fade-a -1` to fade out a particle, keeping all other settings
  ;; the same.
  (spt-next-time 50)
  (spt-next-launcher 51)
  (cpu-fields-end 52)

  ;; these fields adjust other fields immediately before launch
  (launch-fields-start 53)
  ;; rotate the velocity of a particle, in xyz euler angles
  (spt-launchrot-x 54)
  (spt-launchrot-y 55)
  (spt-launchrot-z 56)
  ;; unused.
  (spt-launchrot-w 57)
  
  ;; "conerot" applies an offset of `conerot-radius` to the launch position along +y,
  ;; then rotates the offset and velocity together according the euler angles conerot-x,y,z
  ;; Imagine a sphere centered at the launch origin with radius `conerot-radius`.
  ;; conerot launches particles radially outward on part of the sphere, bounded by the
  ;; conerot euler angle range.
  
  ;; Example: village1 fountain launches particles "up and out"
  ;; (not the very high center jet, the splash going off the sides)
  
  ;; outward launch velocity
  ;; (:vel-x (meters 0.02) (meters 0.013333334))
  ;; upward launch velocity
  ;; (:vel-y (meters 0.02) (meters 0.01))

  ;; tilt away from vertical by 45 + rand*30 degrees
  ;; (:conerot-x (degrees 45) (degrees 30))
  ;; launch in all directions around the circular fountain
  ;; (:conerot-y (degrees 0) (degrees 360))
  ;; vary the radius
  ;; (:conerot-radius (meters 0.4) (meters 0.3))

  
  (spt-conerot-x 58)
  (spt-conerot-y 59)
  (spt-conerot-z 60)

  (spt-conerot-w 61)   ;; unused
  (spt-conerot-radius 62)
  
  ;; another rotation, applied to both x,y,z position offset and velocity
  (spt-rotate-y 63)
  (launch-fields-end 64)
  
  ;; these two fields are not used and have no effect
  (spt-scale 65)
  (spt-scalevel 66)
  
  (spt-end 67))

;; sp-flag controls how a field value is interpreted.
;; The int, float, float-int-rand options create a randomized number:
;; int:            initial + truncate(rand * random-range) * random-mult
;; float:          initial + rand * random-rangef * random-multf
;; float-int-rand: initial + truncate(rand * (random-range + 1)) * random-multf
(defenum sp-flag
  :type uint16
  (int 0)
  (float 1)
  (float-int-rand 2)
  (copy-from-other 3) ;; copy an earlier field at the negative offset in initial-value
  (object 4) ;; raw object or label pointer, such as a sound-spec or :data payload
  (symbol 5) ;; store the symbol's value
  (launcher 6) ;; treat initial-value as an index in *part-id-table*
  )

;; DECOMP BEGINS

;; This describes the initial value and randomization parameter
;; for a field.
(deftype sp-field-init-spec (structure)
  ((field          sp-field-id)
   (flags          sp-flag)
   (initial-valuef float)
   (random-rangef  float)
   (random-multf   float)
   (initial-value  int32 :overlay-at initial-valuef)
   (random-range   int32 :overlay-at random-rangef)
   (random-mult    int32 :overlay-at random-multf)
   (func           symbol :overlay-at initial-valuef)
   (tex            texture-id :overlay-at initial-valuef)
   (pntr           pointer :overlay-at initial-valuef)
   (sym            symbol :overlay-at initial-valuef)
   (sound          sound-spec :overlay-at initial-valuef)))

;; Definition of a particle effect as a list of fields and some state.
;; The `birthaccum` state is used to launch, on average, `:num` particles
;; per NTSC frame. It stores the fractional pending launch count.
;; `soundaccum` works the same way, except to trigger sound effects, using
;; the :num from the sound-spec.
;; This is obviously somewhat flawed, as two instances of the same particle may
;; cause strange birthing patterns (image both set :num 0.5), so
;; particle effects in a group have alternate storage for birthaccum.
;; Soundaccum is still shared in that case.
(deftype sparticle-launcher (basic)
  ((birthaccum float)
   (soundaccum float)
   (init-specs (inline-array sp-field-init-spec))))

;; A particle group is a list of sparticle-launchers that are launched
;; in a specific sequence.

;; Controls when and how one particle-launcher in a launch-group works.
(defenum sp-group-item-flag
  :bitfield #t
  :type uint16
  (3d 0) ;; use the oriented 3D particle system rather than 2D billboards
  ;; Loop the periodic scheule (ignored with one-shot or every-frame)
  (loop 1)
  ;; Begin inactive and wait for parent particle
  (child 2)
  ;; Ignore schedule and launch once as soon as the item is active
  (one-shot 3)
  ;; Launch particles on every frame
  (every-frame 6)
  )

;; One launcher in a group, with its timing and visibility parameters. Timing
;; uses 300 Hz ticks. period is the cycle length, with zero meaning continuous
;; launch; length is the active window within a cycle; and offset changes the
;; instance's phase. fade-after decreases emission beyond that camera distance,
;; while falloff-to is the distance where the linearly scaled emission rate
;; reaches zero. hour-mask suppresses emission during selected in-game hours.
(deftype sparticle-group-item (structure)
  ((launcher   uint32) ;; launcher ID
   (fade-after meters) ;; decrease launch rate starting at this distance from cam
   (falloff-to meters) ;; stop launching at this distance from cam
   (flags      sp-group-item-flag) ;; settings
   (period     uint16) ;; schedule period, 300 Hz ticks
   (length     uint16) ;; duration when active
   (offset     uint16) ;; offset of active duration
   (hour-mask  uint32) ;; suppress in certain hours
   ;; binding is the launcher ID of a child.
   ;; When launching this item, search the group for an inactive
   ;; child with this launcher ID, then launch the child and
   ;; have it follow this item.
   (binding    uint32)))

(defmacro sp-item (launcher &key (fade-after 0.0) &key (falloff-to 0.0) &key (flags ()) &key (period 0) &key (length 0) &key (offset 0) &key (hour-mask 0) &key (binding 0))
  "Construct a launch-group item for launcher with its timing, distance, and binding options."
  `(new 'static
       'sparticle-group-item
       :launcher ,launcher
       :fade-after ,fade-after
       :falloff-to ,falloff-to
       :flags (sp-group-item-flag ,@flags)
       :period ,period
       :length ,length
       :offset ,offset
       :hour-mask ,hour-mask
       :binding ,binding))

;; Per-instance state for one item in a launch-control.
(defenum sp-launch-state-flags
  :bitfield #t
  :type uint16
  (enabled 0)   ;; enabled and considered by spawn
  (launched 1)) ;; a launch occurred

(declare-type sparticle-cpuinfo structure)

;; state of a single launcher in a group. Each instance of a group has
;; one of these for each group-item in the group.
(deftype sparticle-launch-state (structure)
  ((group-item sparticle-group-item)       ;; definition (const)
   (flags      sp-launch-state-flags)      ;; flags
   (randomize  uint16)                     ;; allocation slot randomization
   (origin     vector)                     ;; launch-origin
   (sprite3d   sprite-vec-data-3d)         ;; parent's 3D data (needed to rotate child), or #f if unparented/2d-parent
   (sprite     sparticle-cpuinfo)          ;; parent's cpuinfo
   (offset     uint32)                     ;; scheduler offset
   (accum      float)                      ;; birth accumulator
   (spawn-time uint32)                     ;; most recent launch time (300Hz ticks)
   
   ;; I haven't found a use for these, it's possible some callbacks reused these fields,
   ;; but it should be done with care to avoid breaking the particle code.
   (swarm      basic :overlay-at offset)
   (seed       uint32 :overlay-at accum)
   (time       uint32 :overlay-at spawn-time)
   (spec       basic :overlay-at sprite)
   (id         uint32 :overlay-at sprite3d)))

;; options for an entire group
;; use-local-clock means the effect maintains its own clock, which starts at 0.
;; Without this, the clock is based on a global particle clock and might
;; not start at zero. (useful for syncrhonizing multiple effects)
;; 
;; always-process disables view frustum culling for processing.
;;   this is useful for particle effects that take a while to get
;;   going, like a waterfall that drops particles from high up.
;;   you woudln't want the waterfall to restart each time
;;   the player looks away and back.
;; randomize-order attempts to add some more randomness to the draw
;; order of sprites.
;; only used on the sentinel beach waterfall.
(defenum sp-group-flag
  :bitfield #t
  :type uint16
  (use-local-clock 0)
  (always-process 1)
  (screen-space 2)
  (randomize-order 3)
  )

;; definition of a launch group (constant)
(deftype sparticle-launch-group (basic)
  ((length          int16)
   ;; these durations are not used by sparticle directly, instead they
   ;; are read by part-tracker or other consumers to decide how long
   ;; to spawn, then how long to wait before launched particles should
   ;; be cleaned up.
   (duration        uint16)
   (linger-duration uint16)
   (flags           sp-group-flag)
   (name            string)
   (launcher        (inline-array sparticle-group-item))
   (bounds          sphere :inline)) ;; bounding-sphere for culling
  (:methods
   (create-launch-control (_type_ process) sparticle-launch-control)))

;; runtime state of a single instance of a group, containing a sparticle-launch-state per sparticle-group-item in the group.
(deftype sparticle-launch-control (inline-array-class)
  ((group            sparticle-launch-group) ;; definition (constant)
   (proc             process) ;; owning process
   (local-clock      int32)   ;; scheduler clock when use-local-clock is set
   (fade             float)   ;; seems unused??
   (matrix           int32)   ;; select different rendering matrix, used for screen-space sprites
   (last-spawn-frame int32)   ;; last frame where `spawn` processed it
   (last-spawn-time  int32)   ;; last particle 300Hz timer where `spawn` processed it
   (center           vector :inline) ;; launch origin
   (data             sparticle-launch-state :inline :dynamic))
  (:methods
   (initialize (_type_ sparticle-launch-group process) none)
   (is-visible? (_type_ vector) symbol)
   (spawn (_type_ vector) object)
   (kill-and-free-particles (_type_) none)
   (kill-particles (_type_) none)))

(set! (-> sparticle-launch-control heap-base) (the-as uint 32))

(defmacro defpartgroup (name &key id &key parts &key (duration 3000) &key (linger-duration 1500) &key (flags ()) &key bounds)
  "Install a named particle group at id with its launchers, lifetimes, flags, and bounds."
  `(begin
    ; (defconstant ,name ,id)
    (set! (-> *part-group-id-table* ,id)
          (new 'static
               'sparticle-launch-group
               :duration ,duration
               :linger-duration ,linger-duration
               :flags (sp-group-flag ,@flags)
               :bounds ,bounds
               :name ,(symbol->string name)
               :length ,(length parts)
               :launcher
               (new 'static 'inline-array sparticle-group-item ,(length parts) ,@parts)))))

(defmacro get-part-group (id)
  "Return the particle launch-group registered at id."
  `(-> *part-group-id-table* ,id))

(desfun param-float? (p)
  "Return true when p is a floating literal or a supported floating unit form."
  (or (float? p) (and (pair? p) (eq? 'meters (car p))) (and (pair? p) (eq? 'degrees (car p)))))

(desfun param-int? (p)
  "Return true when p is an integer literal or a seconds form."
  (or (integer? p) (and (pair? p) (eq? 'seconds (car p)))))

(desfun param-symbol? (p)
  "Return true when p is a quoted symbol form."
  (and (pair? p) (eq? 'quote (car p))))

(seval
  (begin
    (define *sparticle-fields* (make-string-hash-table))
    (doenum (name val 'sp-field-id)
            (hash-table-set! *sparticle-fields*
                             (if (string-starts-with? (symbol->string name) "spt-") (string->symbol (string-substr (symbol->string name) 4 0)) name)
                             (list val
                                   name
                                   (member name
                                           '(spt-vel-x spt-vel-y
                                                      spt-vel-z
                                                      spt-scalevel-x
                                                      spt-scalevel-y
                                                      spt-rotvel-x
                                                      spt-rotvel-y
                                                      spt-rotvel-z
                                                      spt-fade-r
                                                      spt-fade-g
                                                      spt-fade-b
                                                      spt-fade-a
                                                      spt-accel-x
                                                      spt-accel-y
                                                      spt-accel-z)))))
    ;; you cannot define these fields ever.
    (define *sparticle-fields-banned*
      '(misc-fields-start misc-fields-end
                         sprite-fields-start
                         sprite-fields-end
                         cpu-fields-start
                         cpu-fields-end
                         launch-fields-start
                         launch-fields-end
                         end))))

;; the last field ID defined, to make sure that fields are defined in order.
(seval
  (define *last-field-id* -1))

(desfun process-init-spec (x)
  "Validate and translate one defpart field initializer into an sp-field-init-spec.
   Fields must appear in storage order so a later field may copy an earlier one."
  (let* ((head (symbol->string (car x)))
         (params (cdr x))
         (field-name (string->symbol (string-substr head 1 0)))
         (field-lookup (hash-table-try-ref *sparticle-fields* field-name))
         (field (cdr field-lookup))
         (store? (member ':store params))
         (param-count (if store? (1- (length params)) (length params))))
    (when (not (car field-lookup))
      (fmt #t "unknown sparticle field {}\n" x))
    (when (neq? (string-ref head 0) #\:)
      (fmt #t "invalid sparticle field {}\n" x))
    ; (when (member field-name *sparticle-fields-banned*)
    ;   (fmt #t "you cannot use sparticle field {}\n" field-name))
    (let ((field-id (car field))
          (field-enum-name (cadr field))
          (vel? (and #f (caddr field)))
          (param0 (and (>= param-count 1) (first params)))
          (param1 (and (>= param-count 2) (second params)))
          (param2 (and (>= param-count 3) (third params))))
      (when (>= *last-field-id* field-id)
        (fmt #t "field {} must come after field {}, not before\n" field-name (car (nth *last-field-id* *sparticle-fields*))))
      (set! *last-field-id* field-id)
      (cond
        ((eq? field-name 'flags)
         `(new 'static
              'sp-field-init-spec
              :field (sp-field-id ,field-enum-name)
              :initial-value (sp-cpuinfo-flag ,@param0)
              :random-mult 1))
        ((eq? field-name 'texture)
         (if (eq? (car param0) 'new)
           `(new 'static 'sp-field-init-spec :field (sp-field-id ,field-enum-name) :tex ,param0 :flags (sp-flag int))
           `(new 'static
                'sp-field-init-spec
                :field (sp-field-id ,field-enum-name)
                :tex
                ,(string->symbol-format "{}-{}" (car param0) (cadr param0))
                :flags (sp-flag int))))
        ((eq? field-name 'next-launcher)
         `(new 'static 'sp-field-init-spec :field (sp-field-id ,field-enum-name) :initial-value ,param0 :flags (sp-flag launcher)))
        ((eq? field-name 'sound)
         `(new 'static 'sp-field-init-spec :field (sp-field-id ,field-enum-name) :sound ,param0 :flags (sp-flag object)))
        ((and (= 2 param-count) (symbol? param0) (eq? param0 ':copy))
         (let* ((other-field-lookup (hash-table-try-ref *sparticle-fields* (cadr (member ':copy params))))
                (other-field (cdr other-field-lookup))
                (other-field-id (car other-field)))
           (when (>= other-field-id field-id)
             (fmt #t
                  "warning copying to sparticle field {} from {} - you can only copy from fields before this one!\n"
                  field-name
                  (cadr other-field)))
           `(new 'static
                'sp-field-init-spec
                :field (sp-field-id ,field-enum-name)
                :flags (sp-flag copy-from-other)
                :initial-value ,(- other-field-id field-id)
                :random-mult 1)))
        ((and (= 2 param-count) (symbol? param0) (eq? param0 ':data))
         `(new 'static
              'sp-field-init-spec
              :field (sp-field-id ,field-enum-name)
              :flags (sp-flag object)
              :object
              ,(cadr (member ':data params))))
        ((and (= 1 param-count) (param-symbol? param0))
         `(new 'static 'sp-field-init-spec :field (sp-field-id ,field-enum-name) :flags (sp-flag symbol) :sym ,param0))
        ((and (= 1 param-count) (param-float? param0))
         `(new 'static
              'sp-field-init-spec
              :field (sp-field-id ,field-enum-name)
              :flags
              (sp-flag ,(if store? 'float-store 'float))
              :initial-valuef
              ,(if vel? `(/ ,param0 60.0) param0)
              :random-rangef 0.0
              :random-multf 1.0))
        ((and (= 2 param-count) (param-float? param0) (param-float? param1))
         `(new 'static
              'sp-field-init-spec
              :field (sp-field-id ,field-enum-name)
              :flags
              (sp-flag ,(if store? 'float-store 'float))
              :initial-valuef
              ,(if vel? `(/ ,param0 60.0) param0)
              :random-rangef
              ,(if vel? `(/ ,param1 60.0) param1)
              :random-multf 1.0))
        ((and (= 3 param-count) (param-float? param0) (param-float? param1) (param-float? param2))
         `(new 'static
              'sp-field-init-spec
              :field (sp-field-id ,field-enum-name)
              :flags
              (sp-flag ,(if store? 'float-store 'float))
              :initial-valuef
              ,(if vel? `(/ ,param0 60.0) param0)
              :random-rangef ,param1
              :random-multf
              ,(if vel? `(/ ,param2 60.0) param2)))
        ((and (= 3 param-count) (param-float? param0) (param-int? param1) (param-float? param2))
         `(new 'static
              'sp-field-init-spec
              :field (sp-field-id ,field-enum-name)
              :flags (sp-flag float-int-rand)
              :initial-valuef
              ,(if vel? `(/ ,param0 60.0) param0)
              :random-range ,param1
              :random-multf
              ,(if vel? `(/ ,param2 60.0) param2)))
        ((and (= 1 param-count) (param-int? param0))
         `(new 'static
              'sp-field-init-spec
              :field (sp-field-id ,field-enum-name)
              :flags (sp-flag int)
              :initial-value ,param0
              :random-range 0
              :random-mult 1))
        ((and (= 2 param-count) (param-int? param0) (param-int? param1))
         `(new 'static
              'sp-field-init-spec
              :field (sp-field-id ,field-enum-name)
              :flags (sp-flag int)
              :initial-value ,param0
              :random-range ,param1
              :random-mult 1))
        ((and (= 3 param-count) (param-int? param0) (param-int? param1) (param-int? param2))
         `(new 'static
              'sp-field-init-spec
              :field (sp-field-id ,field-enum-name)
              :flags (sp-flag int)
              :initial-value ,param0
              :random-range ,param1
              :random-mult ,param2))
        (#t `(new 'static 'sp-field-init-spec :field (sp-field-id spt-end)))))))

(defmacro defpart (id &key (init-specs ()))
  "Build a particle launcher from init-specs and register it at id."
  (begin
    (set! *last-field-id* -1)
    `(set! (-> *part-id-table* ,id)
          (new 'static
               'sparticle-launcher
               :init-specs
               (new 'static
                    'inline-array
                    sp-field-init-spec
                    ,(1+ (length init-specs))
                    ,@(apply process-init-spec init-specs)
                    (new 'static 'sp-field-init-spec :field (sp-field-id spt-end)))))))

;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/gfx/hw/display.gc")
(require "engine/gfx/sprite/sparticle/sparticle-launcher.gc")

;; This file contains the interface between sparticle and sprite as well as the actual particle updates.

;; DECOMP BEGINS

(defmethod print ((this sparticle-cpuinfo))
  (format #t "<sparticle-cpuinfo>~%")
  (dotimes (i 16)
    (format #t "~D:~F~%" i (the-as float (-> this data i))))
  (format #t "TIMER:~D~%" (-> this timer))
  (the-as sparticle-cpuinfo (format #t "FLAGS:~X~%" (-> this flags))))

(defun sp-particle-copy! ((dst sparticle-cpuinfo) (src sparticle-cpuinfo))
  "Copy src's rendered sprite, shader, and simulated CPU state to dst without replacing dst's
   pool bookkeeping, ownership key, binding, or cached record pointers."
  (vector-copy! (-> dst sprite x-y-z-sx) (-> src sprite x-y-z-sx))
  (vector-copy! (-> dst sprite flag-rot-sy) (-> src sprite flag-rot-sy))
  (vector-copy! (-> dst sprite color) (-> src sprite color))
  (dotimes (i 10)
    (set! (-> dst adgif prims i) (-> src adgif prims i)))
  (vector-copy! (-> dst vel-sxvel) (-> src vel-sxvel))
  (vector-copy! (-> dst rot-syvel) (-> src rot-syvel))
  (vector-copy! (-> dst fade) (-> src fade))
  (vector-copy! (-> dst acc) (-> src acc))
  (set! (-> dst friction) (-> src friction))
  (set! (-> dst timer) (-> src timer))
  (set! (-> dst flags) (-> src flags))
  (set! (-> dst user-float) (-> src user-float))
  (set! (-> dst func) (-> src func))
  (none))

(defmethod new sparticle-system ((allocation symbol)
            (type-to-make type)
            (group0-length int)
            (group1-length int)
            (is-3d? symbol)
            (sprite-memory pointer)
            (adgif-memory (inline-array adgif-shader)))
  "Allocate a particle pool with two groups rounded up to 64-slot blocks. sprite-memory and
   adgif-memory provide parallel rendering storage for every rounded slot; each CPU entry is linked
   to its matching records and each allocation bitmap begins with every slot free."
  (#when PC_BIG_MEMORY
    (*! group0-length SPRITE_MAX_AMOUNT_MULT)
    ; (*! group1-length SPRITE_MAX_AMOUNT_MULT)
    )
  (let ((sys (object-new allocation type-to-make (the-as int (-> type-to-make size)))))
    (let* ((group0-blocks (/ (+ group0-length 63) 64)) ;; num blocks
           (group1-blocks (/ (+ group1-length 63) 64))
           (group0-rounded-length (* group0-blocks 64)) ;; length
           (group1-rounded-length (* group1-blocks 64))
           (total-blocks (+ group0-blocks group1-blocks))
           (total-length (+ group0-rounded-length group1-rounded-length)))
      (set! (-> sys blocks 0) group0-blocks)
      (set! (-> sys length 0) group0-rounded-length)
      (set! (-> sys num-alloc 0) 0)
      (set! (-> sys blocks 1) group1-blocks)
      (set! (-> sys length 1) group1-rounded-length)
      (set! (-> sys num-alloc 1) 0)
      (set! (-> sys is-3d) is-3d?)
      ;; per block uint64 (bit per-sprite)
      (set! (-> sys alloc-table) (the-as (pointer uint64) (malloc 'global (* total-blocks 8))))
      ;; per particle
      (set! (-> sys cpuinfo-table) (the-as (inline-array sparticle-cpuinfo) (malloc 'global (* 144 total-length))))
      ;; sprite data
      (set! (-> sys vecdata-table) sprite-memory)
      ;; adgifs
      (set! (-> sys adgifdata-table) adgif-memory)
      (dotimes (block total-blocks)
        ;; fill alloc-table with 1's
        (set! (-> sys alloc-table block) (the-as uint -1)))
      (dotimes (i total-length)
        (set! (-> sys cpuinfo-table i valid) #f)
        ;; link cpuinfos to sprite data
        (set! (-> sys cpuinfo-table i sprite) (the-as sprite-vec-data-2d (&+ (-> sys vecdata-table) (* 48 i))))
        ;; and to adgif
        (set! (-> sys cpuinfo-table i adgif) (-> sys adgifdata-table i))
        ;; default init adgifs.
        (adgif-shader<-texture-simple! (-> sys adgifdata-table i) (the-as texture #f))
        (set! (-> sys adgifdata-table i alpha) (new 'static 'gs-alpha :b #x2 :d #x1))))
    sys))

;;;;;;;;;;;;;;;;;;;;
;; particle systems
;;;;;;;;;;;;;;;;;;;;

;; note: these constants must match the sizes of the sprite arrays.

(define *sp-particle-system-2d*
  (new 'global 'sparticle-system 1920 128 #f (the pointer (-> *sprite-array-2d* vec-data)) (-> *sprite-array-2d* adgif-data)))

(define *sp-particle-system-3d*
  (new 'global 'sparticle-system 256 0 #t (the pointer (-> *sprite-array-3d* vec-data)) (-> *sprite-array-3d* adgif-data)))

;;;;;;;;;;;;;;;;;;;;
;; alloc and block
;;;;;;;;;;;;;;;;;;;;

(defun sp-get-block-size ((sys sparticle-system) (group int))
  "Return one past the highest partly occupied block in group, or zero when the group is empty."
  (let ((used-blocks 0))
    (let ((block-offset 0)
          (num-blocks (-> sys blocks 0)))
      (when (= group 1)
        (set! block-offset num-blocks)
        (set! num-blocks (-> sys blocks 1)))
      (dotimes (i num-blocks)
        (if (!= (-> sys alloc-table (+ block-offset i)) -1) (set! used-blocks (+ i 1)))))
    used-blocks))

(defun sp-get-approx-alloc-size ((sys sparticle-system) (group int))
  "Return the number of slots through the last partly occupied block in group, rounded to 64.
   This includes free holes and is the prefix that must be processed."
  ;; This is just (* 64 (sp-get-block-size sys group)).
  (let ((selected-group group)
        (used-blocks 0))
    (let ((block-offset 0)
          (num-blocks (-> sys blocks 0)))
      (when (= selected-group 1)
        (set! block-offset num-blocks)
        (set! num-blocks (-> sys blocks 1)))
      (dotimes (i num-blocks)
        (if (!= (-> sys alloc-table (+ block-offset i)) -1) (set! used-blocks (+ i 1)))))
    (* used-blocks 64)))

(defun sp-free-particle ((sys sparticle-system) (slot int) (cpuinfo sparticle-cpuinfo) (sprite-data sprite-vec-data-2d))
  "Release slot back to sys, clear its valid state and sprite alpha, and detach any active launcher."
  ;; clear flags on our launch state.
  (if (and (-> cpuinfo binding) (nonzero? (-> cpuinfo binding)))
    (logclear! (-> cpuinfo binding flags) (sp-launch-state-flags enabled launched)))
  ;; Set the free bit for this slot.
  (let ((block (/ slot 64))
        (bit (logand slot 63)))
    (logior! (-> sys alloc-table block) (ash 1 bit)))
  ;; decrease alloc count for the appropriate group
  (if (< slot (-> sys length 0)) (+! (-> sys num-alloc 0) -1) (+! (-> sys num-alloc 1) -1))
  (set! (-> cpuinfo valid) #f)
  (set! (-> sprite-data a) 0.0)
  0
  (none))

(#when PC_PORT
  (defun sp-get-particle ((sys sparticle-system) (group int) (binding sparticle-launch-state))
    "Allocate the first free particle in group, clear its bitmap bit, and return its CPU record.
   Return false when all slots are occupied."
    ;; og:preserve-this
    ;; pc port note : this function originally attempted to find a free sparticle by picking a "random"
    ;; (actually incremental) starting block and going from there. we disable that completely for pc
    ;; because it is actually detrimental since we may alloc sparticles spread over way too many blocks
    ;; which can have a negative impact on our performance.
    (let ((block-offset 0)
          (num-blocks (-> sys blocks 0))
          (block-index 0))
      (when (= group 1)
        (set! block-offset num-blocks)
        (set! num-blocks (-> sys blocks 1)))
      (dotimes (i num-blocks)
        (when (nonzero? (-> sys alloc-table (+ block-offset block-index)))
          (dotimes (bit 64)
            (when (nonzero? (logand (ash 1 bit) (-> sys alloc-table (+ block-offset block-index))))
              (logxor! (-> sys alloc-table (+ block-offset block-index)) (ash 1 bit))
              (+! (-> sys num-alloc group) 1)
              (let ((cpuinfo (-> sys cpuinfo-table (+ bit (* (+ block-offset block-index) 64)))))
                (set! (-> cpuinfo valid) #t)
                (return cpuinfo)))))
        (+! block-index 1)
        (if (= block-index num-blocks) (set! block-index 0))))
    (the-as sparticle-cpuinfo #f)))

(defun sp-kill-particle ((sys sparticle-system) (cpuinfo sparticle-cpuinfo))
  "Release a main-memory particle immediately. A scratchpad copy is instead marked with a zero
   timer so its block update can perform the release safely."
  (cond
    ;; modified to check the end of the spad too.
    ((in-scratchpad? cpuinfo)
     ;; If in the scratchpad, just set the timer to 0.
     (set! (-> cpuinfo timer) 0)
     0)
    (else
     (let ((slot (/ (the-as int (- (the-as uint cpuinfo) (the-as uint (-> sys cpuinfo-table 0)))) 144)))
       (when (or (< slot 0) (>= slot (+ (-> sys length 0) (-> sys length 1))))
         ;; invalid location for particle, error
         (format 0 "Tried to release particle ~D~%" slot)
         (return #f))
       ;; free it.
       (sp-free-particle sys slot cpuinfo (-> cpuinfo sprite)))))
  #t
  (none))

;;;;;;;;;;;;;;;;
;; effects
;;;;;;;;;;;;;;;;

(defun sp-orbiter ((sys sparticle-system) (cpuinfo sparticle-cpuinfo) (out-pos vector))
  "Advance cpuinfo around the center pointer packed in user-float and write the world position to
   out-pos. omega and radius hold the current orbit state; vel-sxvel.x and .z change them over time,
   while .y supplies the incremental precession of the orbit plane. rotvel3d accumulates that plane
   orientation before it rotates the in-plane offset."
  (let* ((angle (-> cpuinfo omega))
         (radius (-> cpuinfo radius))
         (angular-velocity (-> cpuinfo vel-sxvel x))
         (plane-precession (-> cpuinfo vel-sxvel y))
         (radial-velocity (-> cpuinfo vel-sxvel z))
         (dt (-> *sp-frame-time* y))
         (new-angle (+ angle (* angular-velocity dt))))
    (set! (-> cpuinfo omega) new-angle)
    (let ((new-radius (+ radius (* radial-velocity dt))))
      (set! (-> cpuinfo radius) new-radius)
      (let ((sin-angle (sin new-angle))
            (cos-angle (cos new-angle))
            (sin-half-precession (sin (* 0.5 plane-precession)))
            (cos-half-precession (cos (* 0.5 plane-precession)))
            (precession (new 'stack-no-clear 'vector))
            (orbit-offset (new 'stack-no-clear 'vector)))
        (let ((rotation (new 'stack-no-clear 'matrix)))
          (set-vector! precession (* sin-half-precession cos-angle) 0.0 (* sin-half-precession sin-angle) cos-half-precession)
          (quaternion*! (-> cpuinfo rotvel3d) (the-as quaternion precession) (-> cpuinfo rotvel3d))
          (quaternion-normalize! (-> cpuinfo rotvel3d))
          (set-vector! orbit-offset (* sin-angle new-radius) 0.0 (* cos-angle new-radius) 1.0)
          (quaternion->matrix rotation (-> cpuinfo rotvel3d))
          (vector-matrix*! orbit-offset orbit-offset rotation))
        (let ((center (the-as object (-> cpuinfo user-float))))
          (set! (-> out-pos x) (+ (-> orbit-offset x) (-> (the-as sprite-vec-data-2d center) x)))
          (set! (-> out-pos y) (+ (-> orbit-offset y) (-> (the-as sprite-vec-data-2d center) y)))
          (set! (-> out-pos z) (+ (-> orbit-offset z) (-> (the-as sprite-vec-data-2d center) z)))))))
  0
  (none))

;;;;;;;;;;;;;;;;;;;;;
;; particle update
;;;;;;;;;;;;;;;;;;;;;

(defun sp-process-block-2d ((sys sparticle-system)
          (scratchpad-cpuinfo int)
          (scratchpad-sprite-data int)
          (start-slot int)
          (count int)
          (paused? symbol))
    "Update a scratchpad block of 2D particles using the original simulation rules."
    (let ((cpuinfos (the-as (inline-array sparticle-cpuinfo) scratchpad-cpuinfo))
          (sprites (the-as (inline-array sprite-vec-data-2d) scratchpad-sprite-data))
          (ticks (logand (the-as int (-> *sp-frame-time* x)) 255))
          (tick-scale (-> *sp-frame-time* y))
          (frame-scale (-> *sp-frame-time* z)))
      (dotimes (i count)
        (let ((cpuinfo (-> cpuinfos i))
              (sprite (-> sprites i))
              (slot (+ start-slot i)))
          (when (-> cpuinfo valid)
            (cond
              ;; Paused particles do not age or simulate, but a zero timer still frees them and
              ;; a newly launched particle still becomes visible.
              ((and paused?
                    (not (logtest? (-> cpuinfo flags) (sp-cpuinfo-flag run-while-paused))))
               (cond
                 ((= (-> cpuinfo timer) 0)
                  (sp-free-particle sys slot cpuinfo sprite))
                 ((logtest? (-> cpuinfo flags) (sp-cpuinfo-flag just-launched))
                  (logclear! (-> cpuinfo flags) (sp-cpuinfo-flag just-launched))
                  (set! (-> sprite a) (-> cpuinfo cache-alpha)))))
              ;; A timer which reached zero on the preceding update dies before doing any more work.
              ((= (-> cpuinfo timer) 0)
               (sp-free-particle sys slot cpuinfo sprite))
              (else
               ;; -1 is an infinite lifetime. Finite timers clamp at zero and are freed next update.
               (when (!= (-> cpuinfo timer) -1)
                 (set! (-> cpuinfo timer) (max 0 (- (-> cpuinfo timer) ticks))))

               (when (logtest? (-> cpuinfo flags) (sp-cpuinfo-flag just-launched))
                 (logclear! (-> cpuinfo flags) (sp-cpuinfo-flag just-launched))
                 (set! (-> sprite a) (-> cpuinfo cache-alpha)))

               (when (nonzero? (the-as uint (-> cpuinfo func)))
                 ((the-as (function sparticle-system
                                   sparticle-cpuinfo
                                   sprite-vec-data-3d
                                   none)
                          (-> cpuinfo func))
                  sys
                  cpuinfo
                  (the-as sprite-vec-data-3d sprite)))

               ;; The 2D original relaunches when the decremented countdown is zero or negative.
               (when (nonzero? (the-as uint (-> cpuinfo next-launcher)))
                 (let ((next-time (- (the-as int (-> cpuinfo next-time)) ticks)))
                   (set! (-> cpuinfo next-time) (the-as uint next-time))
                   (when (< next-time 1)
                     (sp-relaunch-particle-2d sys
                                              (the-as sparticle-launcher (-> cpuinfo next-launcher))
                                              cpuinfo
                                              (the-as sprite-vec-data-3d sprite)))))

               ;; Acceleration is measured in 60 Hz frames. Friction retains
               ;; 1 - (1 - friction) * frame-scale of the xyz velocity.
               (+! (-> cpuinfo vel-sxvel x) (* (-> cpuinfo acc x) frame-scale))
               (+! (-> cpuinfo vel-sxvel y) (* (-> cpuinfo acc y) frame-scale))
               (+! (-> cpuinfo vel-sxvel z) (* (-> cpuinfo acc z) frame-scale))
               (when (nonzero? (the-as int (-> cpuinfo friction)))
                 (let ((retained (- 1.0 (* (- 1.0 (-> cpuinfo friction)) frame-scale))))
                   (*! (-> cpuinfo vel-sxvel x) retained)
                   (*! (-> cpuinfo vel-sxvel y) retained)
                   (*! (-> cpuinfo vel-sxvel z) retained)))

               ;; Velocity, scale velocity, billboard rotation, and fade use 300 Hz ticks.
               (+! (-> sprite x) (* (-> cpuinfo vel-sxvel x) tick-scale))
               (+! (-> sprite y) (* (-> cpuinfo vel-sxvel y) tick-scale))
               (+! (-> sprite z) (* (-> cpuinfo vel-sxvel z) tick-scale))
               (+! (-> sprite sx) (* (-> cpuinfo vel-sxvel w) tick-scale))
               (+! (-> sprite rot) (* (-> cpuinfo rot-syvel z) tick-scale))
               (+! (-> sprite sy) (* (-> cpuinfo rot-syvel w) tick-scale))
               (+! (-> sprite r) (* (-> cpuinfo fade x) tick-scale))
               (+! (-> sprite g) (* (-> cpuinfo fade y) tick-scale))
               (+! (-> sprite b) (* (-> cpuinfo fade z) tick-scale))
               (+! (-> sprite a) (* (-> cpuinfo fade w) tick-scale))
               (set! (-> sprite r) (fmax (-> sprite r) 0.0))
               (set! (-> sprite g) (fmax (-> sprite g) 0.0))
               (set! (-> sprite b) (fmax (-> sprite b) 0.0))
               (set! (-> sprite a) (fmax (-> sprite a) 0.0))
               (set! (-> sprite rot) (unwrap-angle (-> sprite rot)))

               (when (logtest? (-> cpuinfo flags) (sp-cpuinfo-flag orbit))
                 (sp-orbiter sys cpuinfo (-> sprite x-y-z-sx)))

               (let ((dies?
                       (or
                         (and (logtest? (-> cpuinfo flags) (sp-cpuinfo-flag die-when-color-0))
                              (= (-> sprite r) 0.0)
                              (= (-> sprite g) 0.0)
                              (= (-> sprite b) 0.0))
                         (and (logtest? (-> cpuinfo flags) (sp-cpuinfo-flag die-when-faded))
                              (<= (the-as int (-> sprite a)) 0))
                         (and (logtest? (-> cpuinfo flags) (sp-cpuinfo-flag die-when-scale-0))
                              (or (< (the-as int (-> sprite sx)) 0)
                                  (< (the-as int (-> sprite sy)) 0))))))
                 (when dies?
                   (sp-free-particle sys slot cpuinfo sprite))))))))
    (none)))


(defun sp-process-block-3d ((sys sparticle-system)
          (scratchpad-cpuinfo int)
          (scratchpad-sprite-data int)
          (start-slot int)
          (count int)
          (paused? symbol))
    "Update a scratchpad block of oriented 3D particles using the original simulation rules."
    (let ((cpuinfos (the-as (inline-array sparticle-cpuinfo) scratchpad-cpuinfo))
          (sprites (the-as (inline-array sprite-vec-data-3d) scratchpad-sprite-data))
          (ticks (logand (the-as int (-> *sp-frame-time* x)) 255))
          (tick-scale (-> *sp-frame-time* y))
          (frame-scale (-> *sp-frame-time* z)))
      (dotimes (i count)
        (let ((cpuinfo (-> cpuinfos i))
              (sprite (-> sprites i))
              (slot (+ start-slot i)))
          (when (-> cpuinfo valid)
            (cond
              ((and paused?
                    (not (logtest? (-> cpuinfo flags) (sp-cpuinfo-flag run-while-paused))))
               (cond
                 ((= (-> cpuinfo timer) 0)
                  (sp-free-particle sys slot cpuinfo (the-as sprite-vec-data-2d sprite)))
                 ((logtest? (-> cpuinfo flags) (sp-cpuinfo-flag just-launched))
                  (logclear! (-> cpuinfo flags) (sp-cpuinfo-flag just-launched))
                  (set! (-> sprite a) (-> cpuinfo cache-alpha)))))
              ((= (-> cpuinfo timer) 0)
               (sp-free-particle sys slot cpuinfo (the-as sprite-vec-data-2d sprite)))
              (else
               (when (!= (-> cpuinfo timer) -1)
                 (set! (-> cpuinfo timer) (max 0 (- (-> cpuinfo timer) ticks))))

               (when (logtest? (-> cpuinfo flags) (sp-cpuinfo-flag just-launched))
                 (logclear! (-> cpuinfo flags) (sp-cpuinfo-flag just-launched))
                 (set! (-> sprite a) (-> cpuinfo cache-alpha)))

               (when (nonzero? (the-as uint (-> cpuinfo func)))
                 ((the-as (function sparticle-system
                                   sparticle-cpuinfo
                                   sprite-vec-data-3d
                                   none)
                          (-> cpuinfo func))
                  sys
                  cpuinfo
                  sprite))

               ;; Unlike the 2D path, the 3D original waits until next-time is strictly negative.
               (when (nonzero? (the-as uint (-> cpuinfo next-launcher)))
                 (let ((next-time (- (the-as int (-> cpuinfo next-time)) ticks)))
                   (set! (-> cpuinfo next-time) (the-as uint next-time))
                   (when (< next-time 0)
                     (sp-relaunch-particle-3d sys
                                              (the-as sparticle-launcher (-> cpuinfo next-launcher))
                                              cpuinfo
                                              sprite))))

               (+! (-> cpuinfo vel-sxvel x) (* (-> cpuinfo acc x) frame-scale))
               (+! (-> cpuinfo vel-sxvel y) (* (-> cpuinfo acc y) frame-scale))
               (+! (-> cpuinfo vel-sxvel z) (* (-> cpuinfo acc z) frame-scale))
               (when (nonzero? (the-as int (-> cpuinfo friction)))
                 (let ((retained (- 1.0 (* (- 1.0 (-> cpuinfo friction)) frame-scale))))
                   (*! (-> cpuinfo vel-sxvel x) retained)
                   (*! (-> cpuinfo vel-sxvel y) retained)
                   (*! (-> cpuinfo vel-sxvel z) retained)))

               (+! (-> sprite x) (* (-> cpuinfo vel-sxvel x) tick-scale))
               (+! (-> sprite y) (* (-> cpuinfo vel-sxvel y) tick-scale))
               (+! (-> sprite z) (* (-> cpuinfo vel-sxvel z) tick-scale))
               (+! (-> sprite sx) (* (-> cpuinfo vel-sxvel w) tick-scale))
               (+! (-> sprite sy) (* (-> cpuinfo rot-syvel w) tick-scale))
               (+! (-> sprite r) (* (-> cpuinfo fade x) tick-scale))
               (+! (-> sprite g) (* (-> cpuinfo fade y) tick-scale))
               (+! (-> sprite b) (* (-> cpuinfo fade z) tick-scale))
               (+! (-> sprite a) (* (-> cpuinfo fade w) tick-scale))
               (set! (-> sprite r) (fmax (-> sprite r) 0.0))
               (set! (-> sprite g) (fmax (-> sprite g) 0.0))
               (set! (-> sprite b) (fmax (-> sprite b) 0.0))
               (set! (-> sprite a) (fmax (-> sprite a) 0.0))

               ;; Reconstruct the omitted quaternion w, apply one rotational step (two after a
               ;; long frame), then store the equivalent sign with nonnegative omitted w.
               (let ((rotation (new 'stack-no-clear 'quaternion)))
                 (set-vector! rotation
                              (-> sprite qx)
                              (-> sprite qy)
                              (-> sprite qz)
                              (sqrtf (- (- (- 1.0 (square (-> sprite qz)))
                                                 (square (-> sprite qy)))
                                            (square (-> sprite qx)))))
                 (when (>= ticks 10)
                   (quaternion*! rotation rotation (-> cpuinfo rotvel3d)))
                 (quaternion*! rotation rotation (-> cpuinfo rotvel3d))
                 (cond
                   ((< (-> rotation w) 0.0)
                    (set! (-> sprite qx) (- 0.0 (-> rotation x)))
                    (set! (-> sprite qy) (- 0.0 (-> rotation y)))
                    (set! (-> sprite qz) (- 0.0 (-> rotation z))))
                   (else
                    (set! (-> sprite qx) (-> rotation x))
                    (set! (-> sprite qy) (-> rotation y))
                    (set! (-> sprite qz) (-> rotation z)))))

               (let ((dies?
                       (or
                         (and (logtest? (-> cpuinfo flags) (sp-cpuinfo-flag die-when-color-0))
                              (= (-> sprite r) 0.0)
                              (= (-> sprite g) 0.0)
                              (= (-> sprite b) 0.0))
                         (and (logtest? (-> cpuinfo flags) (sp-cpuinfo-flag die-when-faded))
                              (<= (the-as int (-> sprite a)) 0))
                         (and (logtest? (-> cpuinfo flags) (sp-cpuinfo-flag die-when-scale-0))
                              (or (< (the-as int (-> sprite sx)) 0)
                                  (< (the-as int (-> sprite sy)) 0))))))
                 (when dies?
                   (sp-free-particle sys
                                     slot
                                     cpuinfo
                                     (the-as sprite-vec-data-2d sprite))))))))))
    (none))

(defun sp-copy-to-spr ((scratchpad-offset int) (memory pointer) (size int))
  "Copy size bytes from main memory to a scratchpad offset, rounded up to whole quadwords."
  ;; The PC port uses the fake scratchpad.
  (let ((quadword-count (/ (+ size 15) 16)))
    (__mem-move (&+ (scratchpad-start) scratchpad-offset) memory (the uint (* quadword-count 16)))
    ;; (dma-send-to-spr-no-flush
    ;;   (the-as uint scratchpad-offset) (the-as uint memory) (the-as uint quadword-count) #t)
    )
  0
  (none))

(defun sp-copy-from-spr ((scratchpad-offset int) (memory pointer) (size int))
  "Copy size bytes from a scratchpad offset to main memory, rounded up to whole quadwords."
  ;; The PC port uses the fake scratchpad.
  (let ((quadword-count (/ (+ size 15) 16)))
    (__mem-move memory (&+ (scratchpad-start) scratchpad-offset) (the uint (* quadword-count 16)))
    ;; (dma-send-from-spr-no-flush
    ;;   (the-as uint memory) (the-as uint scratchpad-offset) (the-as uint quadword-count) #t)
    )
  0
  (none))

(defun sp-process-block ((sys sparticle-system) (start-slot int) (sprite-array-data sprite-array-2d) (count int))
  "Copy count parallel particle records beginning at start-slot into scratchpad, update them, and
   copy the mutable CPU and sprite records back. Shader records are input-only."
  ;; Scratchpad offset 0 is reserved. Each particle contributes 144 bytes of CPU state, 48 bytes of
  ;; sprite data, and 80 bytes of shader state, in that order.
  (local-vars (adgif-offset int) (adgif-size int) (scratchpad-cpuinfo int) (scratchpad-sprite-data int))
  (let ((cpu-offset 16)
        (cpu-size (* 144 count))
        (sprite-size (* 48 count)))
    (set! adgif-size (* 80 count))
    (let ((sprite-offset (+ cpu-offset cpu-size)))
      (set! adgif-offset (+ sprite-offset sprite-size))
      (sp-copy-to-spr cpu-offset (the-as pointer (-> sys cpuinfo-table start-slot)) cpu-size)
      (sp-copy-to-spr sprite-offset (&+ (-> sys vecdata-table) (* 48 start-slot)) sprite-size)
      (let ((copy-to-scratchpad sp-copy-to-spr)
            (adgif-data (-> sys adgifdata-table start-slot)))
        (copy-to-scratchpad adgif-offset (the-as pointer adgif-data) adgif-size))
      ;; alternate to run without doing scratchpad (will change behavior of kill, but at least works for hud)
      ; (set! scratchpad-cpuinfo (the-as int (-> sys cpuinfo-table start-slot)))
      ; (set! scratchpad-sprite-data (the-as int (&+ (-> sys vecdata-table) (* 48 start-slot))))
      (set! scratchpad-cpuinfo (+ (the int (scratchpad-start)) cpu-offset))
      (set! scratchpad-sprite-data (+ (the int (scratchpad-start)) sprite-offset))
      (cond
        ((-> sys is-3d)
           (sp-process-block-3d sys scratchpad-cpuinfo scratchpad-sprite-data start-slot count (paused?)))
        (else
           (sp-process-block-2d sys scratchpad-cpuinfo scratchpad-sprite-data start-slot count (paused?))))
      (sp-copy-from-spr cpu-offset (the-as pointer (-> sys cpuinfo-table start-slot)) cpu-size)
      (sp-copy-from-spr sprite-offset (&+ (-> sys vecdata-table) (* 48 start-slot)) sprite-size)))
  0
  (none))

(defun sp-process-particle-system ((sys sparticle-system) (group int) (sprite-array-data sprite-array-2d))
  "Update the active prefix of one particle-system group in scratchpad-sized chunks and publish
   that prefix length to the matching sprite-array group."
  (let* ((scratchpad-header-size 16)
         ;; 16 KiB scratchpad minus the header, at 144 + 48 + 80 bytes per particle.
         (chunk-size (/ (- #x4000 scratchpad-header-size) 272))
         (start-slot 0)
         (remaining (sp-get-approx-alloc-size sys group)))
    ;; group 1 starts after group 0
    (if (= group 1) (set! start-slot (* (-> sys blocks 0) 64)))
    (set! (-> sprite-array-data num-valid group) remaining)
    ;; flush before processing
    (flush-cache 0)
    (while (>= remaining chunk-size)
      (sp-process-block sys start-slot sprite-array-data chunk-size)
      (set! remaining (- remaining chunk-size))
      (+! start-slot chunk-size))
    ;; if there's anything leftover, don't forget that.
    (if (> remaining 0) (sp-process-block sys start-slot sprite-array-data remaining)))
  0
  (none))

(define-perm *particles-flag* symbol #t)

(defun forall-particles-with-key-runner ((key sparticle-launch-control) (func (function sparticle-system sparticle-cpuinfo none)) (sys sparticle-system))
  "Call func for every valid particle in sys whose launch-control key matches key."
  (local-vars (bit int))
  (let ((cpuinfo (the-as object (-> sys cpuinfo-table 0)))
        (sprite-data (&+ (-> sys vecdata-table) 0))
        (total-blocks (+ (-> sys blocks 0) (-> sys blocks 1))))
    (dotimes (block total-blocks)
      (cond
        ((!= (-> sys alloc-table block) -1) ;; block has something allocated.
         (set! bit 0)
         (while (< bit 64)
           (if (and (-> (the-as sparticle-cpuinfo cpuinfo) valid) ;; is allocated
                    (= (-> (the-as sparticle-cpuinfo cpuinfo) key) key) ;; matches the key
                    )
             (func sys (the-as sparticle-cpuinfo cpuinfo)) ;; run the callback!
             )
           (set! cpuinfo (-> (the-as (inline-array sparticle-cpuinfo) cpuinfo) 1)) ;; next cpu
           (&+! sprite-data 48) ;; next vec
           (+! bit 1)))
        (else
         ;; skip the whole block!
         (set! cpuinfo (-> (the-as (inline-array sparticle-cpuinfo) cpuinfo) 64))
         (&+! sprite-data 3072)))))
  0
  (none))

(defun forall-particles-with-key ((key sparticle-launch-control)
        (func (function sparticle-system sparticle-cpuinfo none))
        (do-2d? symbol)
        (do-3d? symbol))
  "Call func for particles owned by key in the selected 2D and 3D systems."
  (if do-2d? (forall-particles-with-key-runner key func *sp-particle-system-2d*))
  (if do-3d? (forall-particles-with-key-runner key func *sp-particle-system-3d*))
  0
  (none))

(defun sparticle-kill-it ((sys sparticle-system) (cpuinfo sparticle-cpuinfo))
  "Stop a particle and detach its launch-state without releasing its pool slot."
  (set! (-> cpuinfo timer) 0)
  (set! (-> cpuinfo func) (the-as basic 0)) ;; don't let the callback run and save the timer
  (when (and (-> cpuinfo binding) (nonzero? (-> cpuinfo binding)))
    ;; kill the launcher too.
    (logclear! (-> cpuinfo binding flags) (sp-launch-state-flags enabled launched))
    ;; Forget the binding because its heap may be unloaded before this pool slot is reused.
    (set! (-> cpuinfo binding) #f))
  0
  (none))

(defun sparticle-kill-it-level0 ((sys sparticle-system) (cpuinfo sparticle-cpuinfo))
  "Stop cpuinfo when it belongs to level heap zero."
  (if (logtest? (-> cpuinfo flags) (sp-cpuinfo-flag level0)) (sparticle-kill-it sys cpuinfo))
  0
  (none))

(defun sparticle-kill-it-level1 ((sys sparticle-system) (cpuinfo sparticle-cpuinfo))
  "Stop cpuinfo when it belongs to level heap one."
  (if (logtest? (-> cpuinfo flags) (sp-cpuinfo-flag level1)) (sparticle-kill-it sys cpuinfo))
  0
  (none))

(defun sparticle-60-to-50 ((sys sparticle-system) (cpuinfo sparticle-cpuinfo) (sprite-data pointer))
  "Convert one 3D particle's per-frame rotation quaternion from a 60 Hz step to a 50 Hz step."
  ;; The extracted angle is radians. 12516.455 is (65536 / 2pi) * (6 / 5), converting it to the
  ;; engine's rotation units while enlarging a 5-tick step to the equivalent 6-tick step.
  (let ((rotational-step (-> cpuinfo rotvel3d))
        (axis-angle (new 'stack-no-clear 'quaternion)))
    (vector-angle<-quaternion! (the-as vector axis-angle) rotational-step)
    (set! (-> axis-angle w) (* 12516.455 (-> axis-angle w)))
    (quaternion-vector-angle! rotational-step (the-as vector axis-angle) (-> axis-angle w)))
  0
  (none))

(defun sparticle-50-to-60 ((sys sparticle-system) (cpuinfo sparticle-cpuinfo) (sprite-data pointer))
  "Convert one 3D particle's per-frame rotation quaternion from a 50 Hz step to a 60 Hz step."
  ;; 8691.982 is (65536 / 2pi) * (5 / 6), the inverse conversion and timestep ratio.
  (let ((rotational-step (-> cpuinfo rotvel3d))
        (axis-angle (new 'stack-no-clear 'quaternion)))
    (vector-angle<-quaternion! (the-as vector axis-angle) rotational-step)
    (set! (-> axis-angle w) (* 8691.982 (-> axis-angle w)))
    (quaternion-vector-angle! rotational-step (the-as vector axis-angle) (-> axis-angle w)))
  0
  (none))

(defun kill-all-particles-with-key ((key sparticle-launch-control))
  "Stop every 2D and 3D particle owned by key without releasing its pool slots."
  (forall-particles-with-key key sparticle-kill-it #t #t)
  0
  (none))

(defun forall-particles-runner ((func (function sparticle-system sparticle-cpuinfo pointer none)) (sys sparticle-system))
  "Call func for every valid particle in sys, passing its CPU record and parallel sprite record.
   Completely free 64-slot blocks are skipped."
  (let ((cpuinfo (the-as object (-> sys cpuinfo-table 0)))
        (sprite-data (&+ (-> sys vecdata-table) 0))
        (total-blocks (+ (-> sys blocks 0) (-> sys blocks 1))))
    (dotimes (block total-blocks)
      (cond
        ((!= (-> sys alloc-table block) -1)
         (dotimes (bit 64)
           (if (-> (the-as sparticle-cpuinfo cpuinfo) valid) (func sys (the-as sparticle-cpuinfo cpuinfo) sprite-data))
           (set! cpuinfo (+ (the-as uint cpuinfo) 144))
           (&+! sprite-data 48)))
        (else (set! cpuinfo (&+ (the-as pointer cpuinfo) 9216)) (&+! sprite-data 3072)))))
  0
  (none))

(defun forall-particles ((func function) (do-2d? symbol) (do-3d? symbol))
  "Call func for every valid particle in the selected 2D and 3D systems."
  (if do-2d?
    (forall-particles-runner (the-as (function sparticle-system sparticle-cpuinfo pointer none) func)
                             *sp-particle-system-2d*))
  (if do-3d?
    (forall-particles-runner (the-as (function sparticle-system sparticle-cpuinfo pointer none) func)
                             *sp-particle-system-3d*))
  0
  (none))

(defun kill-all-particles-in-level ((lev level))
  "Stop every particle tagged for lev's active level heap without releasing its pool slot."
  (forall-particles (if (zero? (-> lev index)) sparticle-kill-it-level0 sparticle-kill-it-level1) #t #t)
  0)

(defun all-particles-50-to-60 ()
  "Rescale every live 3D particle's rotational step when switching from 50 Hz to 60 Hz."
  (forall-particles-runner sparticle-50-to-60 *sp-particle-system-3d*)
  (none))

(defun all-particles-60-to-50 ()
  "Rescale every live 3D particle's rotational step when switching from 60 Hz to 50 Hz."
  (forall-particles-runner sparticle-60-to-50 *sp-particle-system-3d*)
  (none))

(defun set-particle-frame-time ((ticks int))
  "Set particle timing from elapsed 300 Hz ticks: retain the tick count as both packed bits and a
   float, and store the equivalent number of 60 Hz frames in the remaining lanes."
  ;; The low byte of x carries the integer tick count. #x800000 supplies a normal float exponent so
  ;; the packed value does not become a denormal when VU code loads the whole vector.
  (set-vector! *sp-frame-time* (the-as float (logior #x800000 ticks)) (the float ticks) (* 0.2 ticks) (* 0.2 ticks))
  (none))

(defun process-particles ()
  "Update particle timing, all 2D, HUD, and 3D particle groups, profiling bars, and deferred
   launches for one display frame."
  (local-vars (start-ticks uint))
  (when *particles-flag*
    0
    0
    (set! start-ticks (get-cpu-clock))
    (set! *sp-launcher-lock* #t)
    ;; start a profile frame.
    (if *debug-segment*
      (add-frame (-> *display* frames (-> *display* on-screen) frame profile-bar 0)
                 'draw
                 (new 'static 'rgba :r #x40 :b #x40 :a #x80)))
    ;; update timer
    (let ((ticks (logand (the-as int (-> *sp-frame-time* x)) 255)))
      (set! *particle-300hz-timer* (+ *particle-300hz-timer* ticks))
      (cond
        (*sp-60-hz* (when (or (= ticks 6) (= ticks 12)) (set! *sp-60-hz* #f) (all-particles-60-to-50)))
        (else (when (or (= ticks 5) (= ticks 10)) (set! *sp-60-hz* #t) (all-particles-50-to-60)))))
    ;; process the particles
    ;; og:preserve-this made this not run when paused, since aux sprites wont get added.
    (unless (paused?)
      (clear-sprite-aux-list))
    (sp-process-particle-system *sp-particle-system-2d* 0 *sprite-array-2d*)
    (sp-process-particle-system *sp-particle-system-2d* 1 *sprite-array-2d*)
    (sp-process-particle-system *sp-particle-system-3d* 0 (the-as sprite-array-2d *sprite-array-3d*))
    (if *debug-segment*
      (add-frame (-> *display* frames (-> *display* on-screen) frame profile-bar 0)
                 'draw
                 (new 'static 'rgba :r #x80 :g #x80 :b #xff :a #x80)))
    (set! *sp-launcher-lock* #f)
    ;; launch queued particles
    (sp-clear-queue)
    (let ((elapsed-usec
            (* 1000000.0 (cpu-ticks-to-seconds (- (get-cpu-clock) start-ticks)))))
      (if *display-sprite-info*
        (format *stdcon*
                "Particle time = ~F us for ~D 2D [~D warp] and ~D HUD and ~D 3D~%"
                elapsed-usec
                (-> *sp-particle-system-2d* num-alloc 0)
                (-> *sprite-aux-list* entry)
                (-> *sp-particle-system-2d* num-alloc 1)
                (-> *sp-particle-system-3d* num-alloc 0)))))
  (#when PARTICLE_ADGIF_CACHE_STATS
    (particle-adgif-cache-stats-frame))
  0
  (none))

;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/gfx/mood/time-of-day-h.gc")
(require "engine/draw/drawable-h.gc")
(require "engine/gfx/sprite/sparticle/sparticle-launcher-h.gc")
(require "engine/gfx/sprite/sprite.gc")
(require "kernel/gstate.gc")
(require "engine/collide/collide-shape-h.gc")

;; The launcher side of the particle system: the *part-id-table*/*part-group-id-table* effect
;; registries, field initialization from defpart init-specs (sp-init-fields!), the launch
;; rotation/adgif setup helpers used by the launch code, the relaunch (multi-phase
;; effect) path, and sparticle-launch-control (the per-process instance of an effect group,
;; with its spawn scheduler). See sparticle-launcher-h.gc for the type/macro definitions.

;; og:preserve-this added macro
;; the rate was defaulted to DISPLAY_FPS_RATIO before, but sp-launch-particles-var checks
;; if the rate is not 1.0 and crashes the game.
(defmacro launch-particles (&key (system *sp-particle-system-2d*) particle origin &key (launch-state (the-as sparticle-launch-state #f)) &key (launch-control (the-as sparticle-launch-control #f)) &key (rate 1.0))
  `(sp-launch-particles-var ,system ,particle ,origin ,launch-state ,launch-control ,rate))

;; decomp begins

;; global particle clock, advanced by process-particles each frame by the tick count in
;; *sp-frame-time* x (5/frame at 60fps, 6 at 50fps -- i.e. 300 ticks per second).
;; All spawn scheduling (period/length/offset) is in these ticks.
(define *particle-300hz-timer* 0)

;; The decoded "misc fields" (misc-fields-start..end of sp-field-id) of a launcher, filled in by
;; sp-init-fields!: texture/anim selection, birth-func, launch joint, count per birth, and sound
(deftype sparticle-birthinfo (structure)
  ((sprite       texture-id)
   (anim         int32)
   (anim-speed   float)
   (birth-func   basic)
   (joint-ppoint int32)
   (num-to-birth float)
   (sound        basic)
   (dataf        float 1 :overlay-at sprite)
   (data         uint32 1 :overlay-at sprite)))

(defmethod inspect ((this sparticle-launcher))
  "Print a particle launcher and its field initializers."
  (format #t "~X: sparticle-launcher~%" this)
  (let ((i 0))
    (while (!= (-> this init-specs i field) (sp-field-id spt-end))
      (let ((init-spec (-> this init-specs i)))
        (format #t
                "~T~S : ~F / #x~X / ~D~%"
                (enum->string sp-field-id (-> init-spec field))
                (-> init-spec initial-valuef)
                (-> init-spec initial-valuef)
                (-> init-spec initial-valuef)))
      (+! i 1)))
  (the-as sparticle-launcher 0))

;;;;;;;;;;;;;;;;;;;;;;;;
;; particle tables
;;;;;;;;;;;;;;;;;;;;;;;;

;; All particle effects (sparticle-launcher) and groups (sparticle-launch-groups) are statically defined
;; Code defining particle effects should add itself to the tables.
;; When a level heap is discarded, it should call (unlink-part-group-by-heap <heap>) to remove references to
;; particle effects that are going to be discarded.

;; All the particle launchers.
;; Particle effects will add themselves to this table when the code is loaded/linked
(define *part-id-table* (new 'global 'boxed-array sparticle-launcher 3584))

;; All the particle groups.
(define *part-group-id-table* (new 'global 'boxed-array sparticle-launch-group 1024))

(defun lookup-part-group-by-name ((name string))
  "Return the first registered particle launch group whose name matches name, or false."
  (let* ((table *part-group-id-table*)
         (len (-> table length)))
    (dotimes (i len)
      (let ((group (-> table i)))
        (if (and (nonzero? group) (string= name (-> group name)))
            (return (the-as basic group))))))
  (the-as sparticle-launch-group #f))

(defun lookup-part-group-pointer-by-name ((name string))
  "Return the table slot containing the first particle launch group named name, or a null pointer."
  (let* ((table *part-group-id-table*)
         (len (-> table length)))
    (dotimes (i len)
      (let ((group (-> table i)))
        (if (and (nonzero? group) (string= name (-> group name)))
          ;; og:preserve-this
          ;;(return (&+ (-> table data) (* i 4)))
          (return (&-> table i))))))
  (the-as (pointer sparticle-launch-group) #f))

(defun part-group-pointer? ((ptr pointer))
  "Return true when ptr addresses a slot inside the particle-group registry."
  (let ((table *part-group-id-table*))
    ;; og:preserve-this
    ;; just check if we are inside the array.
    (and (>= (the-as int ptr) (the-as int (-> table data))) (< (the-as int ptr) (the-as int (&-> table 1024))))))

(defun unlink-part-group-by-heap ((heap kheap))
  "Clear every particle-group registry slot whose value lies inside heap's active address range."
  (let* ((table *part-group-id-table*)
         (i (-> table length))
         (heap-start (-> heap base))
         (heap-end (-> heap top-base)))
    (while (nonzero? i)
      (+! i -1)
      (let ((group (-> table i)))
        (when (and (>= (the-as int group) (the-as int heap-start)) (< (the-as int group) (the-as int heap-end)))
          (set! (-> table i) (the-as sparticle-launch-group 0))
          0))))
  0)

;;;;;;;;;;;;;;;;;;;;;;;
;; particle init
;;;;;;;;;;;;;;;;;;;;;;;

;; og:preserve-this this was rewritten from assembly
(#when PC_PORT
  ;; Walk a launcher's sorted init-spec list and write the initial value of every field in the
  ;; half-open id range (field-id, end-field-id] to consecutive floats starting at dest. (field-id
  ;; is pre-incremented below so the lower bound is exclusive of the "...-start" marker.) The init-specs are stored in
  ;; ascending field order, 16 bytes each. For each field, the flags select how the value is computed
  ;; (see sp-flag): plain value, value + random (rand-vu in [0,1) times random-range), copy from an
  ;; earlier already-written field, symbol/launcher/object lookup, etc.
  ;; write-missing-fields: when #t, fields not present in the spec list are zeroed; when #f they are
  ;; left untouched (used by the relaunch path so existing values survive).
  ;; Returns a pointer to the next unprocessed init-spec, so callers can chain ranges (e.g. sprite
  ;; fields then cpu fields) through one continuous walk.
  (defun sp-init-fields! ((dest (pointer float))
          (specs (inline-array sp-field-init-spec))
          (field-id sp-field-id)
          (end-field-id sp-field-id)
          (write-missing-fields symbol))
    "Walk sorted 16-byte init specs and initialize consecutive fields in the half-open ID range
   (field-id, end-field-id]. Missing fields are zeroed only when write-missing-fields is true. Return
   the next unconsumed spec so callers can process adjacent field ranges without restarting."
    (1+! field-id)
    (let ((cur-spec specs))
      (while (< (-> cur-spec 0 field) field-id)
        (&+! cur-spec 16))
      (if (>= field-id end-field-id) (return cur-spec))
      (until (= field-id end-field-id)
        (cond
          ((!= (-> cur-spec 0 field) field-id)
           (if write-missing-fields (set! (-> dest) 0.0))
           ;; reduce by 16 because it will be incremented by 16 right after but we don't want to advance field
           (&+! cur-spec -16))
          ((= field-id (sp-field-id spt-sound)) (set! (-> dest) (-> cur-spec 0 initial-valuef)))
          (else
           (case (-> cur-spec 0 flags)
             (((sp-flag float))
              (if (= (-> cur-spec 0 random-range) 0)
                (set! (-> dest) (-> cur-spec 0 initial-valuef))
                (set! (-> dest)
                      (+ (-> cur-spec 0 initial-valuef) (* (-> cur-spec 0 random-multf) (* (rand-vu) (-> cur-spec 0 random-rangef)))))))
             (((sp-flag float-int-rand))
              (if (= (-> cur-spec 0 random-range) 0)
                (set! (-> dest) (-> cur-spec 0 initial-valuef))
                (set! (-> dest)
                      (+ (-> cur-spec 0 initial-valuef)
                         (* (-> cur-spec 0 random-multf) (the int (* (rand-vu) (1+ (-> cur-spec 0 random-range)))))))))
             (((sp-flag copy-from-other)) (set! (-> dest) (-> dest (-> cur-spec 0 initial-value))))
             (((sp-flag symbol)) (set! (-> dest) (the-as float (-> cur-spec 0 sym value))))
             (((sp-flag launcher)) (set! (-> dest) (the-as float (-> *part-id-table* (-> cur-spec 0 initial-value)))))
             (((sp-flag object)) (set! (-> dest) (the-as float (-> cur-spec 0 pntr))))
             (else
              (if (= (-> cur-spec 0 random-range) 0)
                (set! (-> dest) (-> cur-spec 0 initial-valuef))
                (set! (-> dest)
                      (the-as float
                              (+ (-> cur-spec 0 initial-value) (* (-> cur-spec 0 random-mult) (the int (* (rand-vu) (-> cur-spec 0 random-range))))))))))))
        (1+! field-id)
        (&+! dest 4)
        (&+! cur-spec 16))
      cur-spec)))

;;;;;;;;;;;;;;;;;;;;;;;
;; launch queue
;;;;;;;;;;;;;;;;;;;;;;;

;; og:preserve-this
;(#if (not PC_BIG_MEMORY)
(defconstant SPARTICLE_QUEUE_SIZE 32)

;(defconstant SPARTICLE_QUEUE_SIZE 80))

(deftype sp-queued-launch-particles (structure)
  ((sp-system   sparticle-system)
   (sp-launcher sparticle-launcher)
   (pos         vector :inline)))

;; og:preserve-this constant
(deftype sp-launch-queue (basic)
  ((in-use int32)
   (queue  sp-queued-launch-particles SPARTICLE_QUEUE_SIZE :inline)))

(define *sp-launcher-lock* #f)

(define *sp-launch-queue* (new 'global 'sp-launch-queue))

(define *sp-launcher-enable* #t)

;;;;;;;;;;;;;;;;;;;
;; particle adgif
;;;;;;;;;;;;;;;;;;;

;; the particle system can modify the adgif shader as part of particle effects.
;; it also is responsible for setting up the adgif.

(defun particle-setup-adgif ((shader adgif-shader) (tex-id texture-id))
  "Initialize a particle shader from tex-id and install the particle renderer's GS register layout,
   alpha blend, and depth-buffer settings."
  ;; grab the texture
  (let ((tex (lookup-texture-by-id tex-id)))
    ;; set up some texture stuff
    (set! (-> shader tex1) (new 'static 'gs-tex1 :mmag #x1 :mmin #x1))
    (set! (-> shader tex0 tfx) 0)
    ;; get the default adgif settings for this txture
    (if tex (adgif-shader<-texture! shader tex)))
  ;; we'll use the usual tex0/tex1/miptbp1
  (set! (-> shader prims 1) (gs-reg64 tex0-1))
  (set! (-> shader prims 3) (gs-reg64 tex1-1))
  (set! (-> shader prims 5) (gs-reg64 miptbp1-1))
  ;; The particle packet uses this slot for the depth-buffer register.
  (set! (-> shader clamp-reg) (gs-reg64 zbuf-1))
  ;; this is sometimes "gs-miptbp" instead.
  (set! (-> shader prims 9) (gs-reg64 alpha-1))
  (set! (-> shader alpha) (new 'static 'gs-alpha :b #x1 :d #x1))
  ;; og:preserve-this clamp is actually zbuf for sparticles, not gs-clamp.
  (set! (-> shader clamp) (the gs-clamp (new 'static 'gs-zbuf :zbp #x1c0 :psm (gs-psm ct24) :zmsk #x1)))
  0
  (none))

;; last and lastgif remember the most recent hit. tidhash and spadgif hold the populated cache.
(deftype particle-adgif-cache (basic)
  ((used    int32)
   (last    uint16)
   (lastgif adgif-shader)
   (tidhash uint16 80)
   (spadgif adgif-shader 80 :inline)))

(define *particle-adgif-cache* (new 'global 'particle-adgif-cache))

(set! (-> *particle-adgif-cache* used) 0)

(defglobalconstant PARTICLE_ADGIF_CACHE_STATS #f)

(#when PARTICLE_ADGIF_CACHE_STATS

  (define *particle-adgif-stat-calls* 0)
  (define *particle-adgif-stat-hits* 0)
  (define *particle-adgif-stat-misses* 0)

  (defun particle-adgif-cache-stats-frame ()
    "Print and reset the per-frame particle ADGIF cache counters."
    (format *stdcon*
            "particle-adgif: ~D calls, ~D hits, ~D misses, cache capacity ~D/80~%"
            *particle-adgif-stat-calls*
            *particle-adgif-stat-hits*
            *particle-adgif-stat-misses*
            (-> *particle-adgif-cache* used))
    (set! *particle-adgif-stat-calls* 0)
    (set! *particle-adgif-stat-hits* 0)
    (set! *particle-adgif-stat-misses* 0)
    (none)))

;; Cache particle shaders by a folded 16-bit texture ID. First check the most recently used
;; texture, then linearly scan through the 80 entry cache. Once the cache is full, all
;; future misses fall back to rebuilding the shader. In jak2/jak3 the cache is cleared on level
;; unload, but for Jak 1, the 80 entry cache seems large enough to hold most (or all?) textures.
(#when PC_PORT
  (defun particle-adgif ((shader-out adgif-shader) (tex-id texture-id))
    "Copy the particle shader for tex-id to shader-out, filling a free cache entry when possible."
    (#when PARTICLE_ADGIF_CACHE_STATS
      (+! *particle-adgif-stat-calls* 1))
    (let* ((cache *particle-adgif-cache*)
           (texture-hash
             (the-as uint16
                     (logand (logxor (sar (the-as int tex-id) 20) (sar (the-as int tex-id) 8))
                             #xffff)))
           (cached-shader (the-as adgif-shader #f)))
      ;; last is zero-initialized, so the hash alone is not enough to prove that lastgif is valid.
      (when (and (= texture-hash (-> cache last)) (nonzero? (-> cache lastgif)))
        (set! cached-shader (-> cache lastgif)))
      (let ((i 0))
        (while (and (not cached-shader) (< i (-> cache used)))
          (when (= texture-hash (-> cache tidhash i))
            (set! cached-shader (-> cache spadgif i)))
          (+! i 1)))
      (cond
        (cached-shader
         (#when PARTICLE_ADGIF_CACHE_STATS
           (+! *particle-adgif-stat-hits* 1))
         (quad-copy! (the-as pointer shader-out) (the-as pointer cached-shader) 5)
         (set! (-> cache last) texture-hash)
         (set! (-> cache lastgif) cached-shader))
        ((< (-> cache used) 80)
         (#when PARTICLE_ADGIF_CACHE_STATS
           (+! *particle-adgif-stat-misses* 1))
         (let* ((cache-index (-> cache used))
                (new-shader (-> cache spadgif cache-index)))
           (set! (-> cache tidhash cache-index) texture-hash)
           (+! (-> cache used) 1)
           (particle-setup-adgif new-shader tex-id)
           (quad-copy! (the-as pointer shader-out) (the-as pointer new-shader) 5)
           (set! (-> cache last) texture-hash)
           (set! (-> cache lastgif) new-shader)))
        (else
         (#when PARTICLE_ADGIF_CACHE_STATS
           (+! *particle-adgif-stat-misses* 1))
         (particle-setup-adgif shader-out tex-id))))
    (none)))

;;;;;;;;;;;;;;;;;;;
;; launch
;;;;;;;;;;;;;;;;;;;

(defun sp-queue-launch ((sys sparticle-system) (launcher sparticle-launcher) (pos vector))
  "Append a particle launch request while the launcher is busy, returning the new queue size. Print
   an error and return zero when the fixed queue is full."
  (let ((queue *sp-launch-queue*))
    ;; og:preserve-this constant
    ;; make sure we have room in the queue
    (when (= (-> queue in-use) SPARTICLE_QUEUE_SIZE)
      (format 0 "ERROR: sp-launch-particles called during processing, and queue is full~%")
      (return 0))
    ;; make a new entry in the queue
    (let ((entry (-> queue queue (-> queue in-use))))
      (set! (-> entry sp-system) sys)
      (set! (-> entry sp-launcher) launcher)
      (vector-copy! (-> entry pos) pos))
    (let ((new-count (+ (-> queue in-use) 1))) (set! (-> queue in-use) new-count) new-count)))

(defun sp-adjust-launch ((launchinfo sparticle-launchinfo) (cpuinfo sparticle-cpuinfo) (init-specs (inline-array sp-field-init-spec)))
  "Read a launcher's launch-field specs and apply its launch rotation, cone direction, and optional
   Y rotation to the particle's position, velocity, acceleration, and stored cone orientation."
  (let ((local-info (new 'stack-no-clear 'sparticle-launchinfo)))
    (let ((rot-mat (new 'stack-no-clear 'matrix))
          (cone-axis (new 'stack-no-clear 'vector)))
      ;; use the field-init-spec to create a totally new launchinfo.
      (sp-init-fields! (the-as (pointer float) (-> local-info launchrot))
                       init-specs
                       (sp-field-id launch-fields-start)
                       (sp-field-id launch-fields-end)
                       #t)
      ;; rotate vel to include the launchrot and conerot
      (matrix-rotate-xyz! rot-mat (-> local-info launchrot))
      (vector3s-matrix*! (the-as vector3s (-> cpuinfo vel-sxvel)) (the-as vector3s (-> cpuinfo vel-sxvel)) rot-mat)
      (matrix-rotate-xyz! rot-mat (-> local-info conerot))
      (vector3s-matrix*! (the-as vector3s (-> cpuinfo vel-sxvel)) (the-as vector3s (-> cpuinfo vel-sxvel)) rot-mat)
      ;; cone axis (pre-rotation to local, y is default, but there's a flag for z)
      (if (logtest? (sp-cpuinfo-flag launch-along-z) (-> cpuinfo flags))
        (set-vector! cone-axis 0.0 0.0 (-> local-info coneradius) 1.0)
        (set-vector! cone-axis 0.0 (-> local-info coneradius) 0.0 1.0))
      ;; rotate cone
      (vector-matrix*! cone-axis cone-axis rot-mat)
      ;; Add the rotated cone-radius offset to the launch position.
      (+! (-> launchinfo launchrot x) (-> cone-axis x))
      (+! (-> launchinfo launchrot y) (-> cone-axis y))
      (+! (-> launchinfo launchrot z) (-> cone-axis z)))
    ;; if desired, apply addition y rotation.
    (when (!= (-> local-info rotate-y) 0.0)
      (let ((yrot-mat (new 'stack-no-clear 'matrix)))
        (matrix-rotate-y! yrot-mat (-> local-info rotate-y))
        (vector3s-rotate*! (the-as vector3s (-> launchinfo launchrot)) (the-as vector3s (-> launchinfo launchrot)) yrot-mat)
        (vector3s-rotate*! (the-as vector3s (-> cpuinfo vel-sxvel)) (the-as vector3s (-> cpuinfo vel-sxvel)) yrot-mat)
        ;; optionally rotate acc.
        (if (not (logtest? (sp-cpuinfo-flag use-global-acc) (-> cpuinfo flags)))
          (vector3s-rotate*! (the-as vector3s (-> cpuinfo acc)) (the-as vector3s (-> cpuinfo acc)) yrot-mat)))
      ;; Keep the stored cone orientation aligned with the additional Y rotation when requested.
      (if (logtest? (sp-cpuinfo-flag set-conerot) (-> cpuinfo flags))
        (set! (-> launchinfo conerot y) (+ 16384.0 (-> local-info rotate-y))))))
  0
  (none))

(defun sp-euler-convert ((launchinfo sparticle-launchinfo) (cpuinfo sparticle-cpuinfo))
  "Convert the launch cone Euler angles to the xyz-only quaternion expected by 3D sprites, choosing
   a positive implicit w, and convert 300 Hz angular velocity to a per-display-frame quaternion step."
  (rlet ((vf0 :class vf)
         (vf1 :class vf)
         (vf2 :class vf))
    (init-vf0-vector)
    (let ((euler (new 'stack-no-clear 'vector))
          (quat (new 'stack-no-clear 'quaternion)))
      ;; convert conerot to a quaternion
      (set-vector! euler (-> launchinfo conerot x) (-> launchinfo conerot y) (-> launchinfo conerot z) 1.0)
      (quaternion-zxy! quat euler)
      ;; flip the sign of w if needed. the sprite renderer _requires_ that w be positive
      ;; because it doesn't actually store w!
      ;; this code also preserves w.
      (cond
        ((< (-> quat w) 0.0)
         (.lvf vf1 (&-> launchinfo conerot quad))
         (.lvf vf2 (&-> quat vec quad))
         (.sub.vf.xyz vf1 vf0 vf2)
         (.svf (&-> launchinfo conerot quad) vf1))
        (else
         (.lvf vf1 (&-> launchinfo conerot quad))
         (.lvf vf2 (&-> quat vec quad))
         (.add.vf.xyz vf1 vf0 vf2)
         (.svf (&-> launchinfo conerot quad) vf1))))
    ;; Convert the 300 Hz angular velocities to one display-frame step.
    (cond
      (*sp-60-hz*
       (set! (-> cpuinfo rot-syvel x) (* 5.0 (-> cpuinfo rot-syvel x)))
       (set! (-> cpuinfo rot-syvel y) (* 5.0 (-> cpuinfo rot-syvel y)))
       (set! (-> cpuinfo rot-syvel z) (* 5.0 (-> cpuinfo rot-syvel z))))
      (else
       (set! (-> cpuinfo rot-syvel x) (* 6.0 (-> cpuinfo rot-syvel x)))
       (set! (-> cpuinfo rot-syvel y) (* 6.0 (-> cpuinfo rot-syvel y)))
       (set! (-> cpuinfo rot-syvel z) (* 6.0 (-> cpuinfo rot-syvel z)))))
    ;; this one gets stored in a separate rotvel3d.
    (quaternion-zxy! (-> cpuinfo rotvel3d) (-> cpuinfo rot-syvel))
    0
    (none)))

(defun sp-rotate-system ((launchinfo sparticle-launchinfo) (cpuinfo sparticle-cpuinfo) (rot sprite-vec-data-3d))
  "Rotate a particle's launch offset, velocity, and local acceleration by the owning system's
   xyz-only quaternion."
  (let ((rot-mat (new 'stack-no-clear 'matrix)))
    (let ((quat (new 'stack-no-clear 'quaternion)))
      (let* ((dst-quat quat)
             (src-rot rot)
             (qx (-> src-rot qx-qy-qz-sy x))
             (qy (-> src-rot qx-qy-qz-sy y))
             (qz (-> src-rot qx-qy-qz-sy z)))
        (set-vector! dst-quat qx qy qz (sqrtf (- (- (- 1.0 (square qz)) (square qy)) (square qx)))))
      (quaternion->matrix rot-mat quat))
    (vector3s-rotate*! (the-as vector3s (-> launchinfo launchrot)) (the-as vector3s (-> launchinfo launchrot)) rot-mat)
    (vector3s-rotate*! (the-as vector3s (-> cpuinfo vel-sxvel)) (the-as vector3s (-> cpuinfo vel-sxvel)) rot-mat)
    (if (not (logtest? (sp-cpuinfo-flag use-global-acc) (-> cpuinfo flags)))
        (vector3s-rotate*! (the-as vector3s (-> cpuinfo acc)) (the-as vector3s (-> cpuinfo acc)) rot-mat)))
  0
  (none))

;; Decode the launcher's misc fields once, accumulate fractional births, then initialize each new
;; particle.
(#when PC_PORT
  (defun sp-launch-particles-var ((sys sparticle-system)
          (launcher sparticle-launcher)
          (pos vector)
          (launch-state sparticle-launch-state)
          (launch-control sparticle-launch-control)
          (rate float))
    "Birth rate-scaled particles, initialize their renderer and simulation state, and attach them to
     the optional launch control."
    (unless *sp-launcher-enable*
      (return 0))
    
    ;; If a particle's update function launches a particle, we can't safely run the code below.
    ;; During particle updates, *sp-launcher-lock* is set, and we fall back to queuing the particle
    ;; for later lanuching.
    (when *sp-launcher-lock*
      ;; the queue doesn't store launch-state, launch-control, or rate, so if we
      ;; have a non-default here, crash and alert the user.
      (when (or launch-state launch-control (!= rate 1.0))
        (format 0 "Crashing: particle launched with non-default with lock held~%")
        (set! (-> (the-as (pointer uint64) 2) 0) 0))
      (sp-queue-launch sys launcher pos)
      (return 0))

    (let ((birthinfo (new 'stack-no-clear 'sparticle-birthinfo))
          (sprite-tmp (new 'stack-no-clear 'sprite-vec-data-3d))
          (origin (new 'stack-no-clear 'vector)))
      ;; Store origin before any decoding
      (vector-copy! origin pos)
      (let ((sprite-2d (the-as sprite-vec-data-2d sprite-tmp))
            (launchinfo (the-as sparticle-launchinfo sprite-tmp))
            ;; decode misc fields
            (sprite-spec
              (sp-init-fields! (&-> birthinfo dataf 0)
                               (-> launcher init-specs)
                               (sp-field-id misc-fields-start)
                               (sp-field-id misc-fields-end)
                               #t)))
        ;; update birth counter
        (let ((birth-increment (* (-> birthinfo num-to-birth) rate)))
          ;; if a launch-state is provided, birth increment is stored there, otherwise
          ;; use the one in the launcher object itself (shared across all places the launcher is used)
          (if launch-state
            (+! (-> launch-state accum) birth-increment)
            (+! (-> launcher birthaccum) birth-increment)))
        ;; Cast to int to truncate and see if accumulator has reached 1.0 or more.
        (while (nonzero? (the int (if launch-state (-> launch-state accum) (-> launcher birthaccum))))
          
          ;; prepase to allocate
          (let ((group-index 0)
                (allocation-state (the-as sparticle-launch-state #f)))
            (when (and launch-control (-> launch-control group))
              (let ((group-flags (-> launch-control group flags)))
                ;; select screen-space group
                (when (logtest? group-flags (sp-group-flag screen-space))
                  (set! group-index 1))
                ;; if allocation order is "randomized", provide the launch state to
                ;; the allocator, which stashes the last position in the buffer the
                ;; allocator checked.
                (when (logtest? group-flags (sp-group-flag randomize-order))
                  (set! allocation-state launch-state))))

            ;; Allocate! If it fails, return immediately, leaving the birth accumulator >1 so
            ;; we try again.
            (let ((cpuinfo (sp-get-particle sys group-index allocation-state)))
              (unless cpuinfo
                (return 0))
              
              ;; decode sprite fields (passed to renderer)
              (let* ((cpu-spec (sp-init-fields! (&-> sprite-tmp x-y-z-sx x)
                                                sprite-spec
                                                (sp-field-id sprite-fields-start)
                                                (sp-field-id sprite-fields-end)
                                                #t))
                     ;; decode sparticle fields
                     (launch-spec (sp-init-fields! (&-> cpuinfo omega)
                                                   cpu-spec
                                                   (sp-field-id cpu-fields-start)
                                                   (sp-field-id cpu-fields-end)
                                                   #t))
                     (particle-flags (-> cpuinfo flags)))
                (unless (-> sys is-3d)
                  ;; 2D sprites need to populate a matrix for the VU program.
                  (cond
                    ;; for screen space, we use the matrix provided, or 1 for aux-list (ignored?)
                    ((and launch-control
                          (-> launch-control group)
                          (logtest? (-> launch-control group flags) (sp-group-flag screen-space)))
                     ;; grab 2D matrix, or use default camera matrix for aux (distort) sprites
                     (set! (-> sprite-2d matrix)
                           (the-as sprite-matrix-mode
                                   (if (logtest? particle-flags (sp-cpuinfo-flag aux-list))
                                     1
                                     (-> launch-control matrix)))))
                    (else
                      ;; for camera space, the upper bits of matrix are a flag to disable fogging.
                     (set! (-> sprite-2d matrix)
                           (the-as sprite-matrix-mode
                                   (shr (logand particle-flags (sp-cpuinfo-flag no-fog)) 14)))))
                  ;; unwrap angle here, VU1 program expects this to be 16-bit within a single rotation.
                  (set! (-> sprite-2d rot) (unwrap-angle (-> sprite-2d rot))))

                ;; truncate RGB values. aux-list (distorter) use this for radius, and don't need need clamping.
                (unless (logtest? particle-flags (sp-cpuinfo-flag aux-list))
                  (set! (-> sprite-tmp r) (fmin (-> sprite-tmp r) 255.0))
                  (set! (-> sprite-tmp g) (fmin (-> sprite-tmp g) 255.0))
                  (set! (-> sprite-tmp b) (fmin (-> sprite-tmp b) 255.0)))
                
                ;; set up orbit (see sparticle-launcher-h.gc)
                (when (and launch-control (logtest? particle-flags (sp-cpuinfo-flag orbit)))
                  (let* ((axis-angle (-> launchinfo launchrot x))
                         (axis-x (cos axis-angle))
                         (axis-z (- (sin axis-angle))))
                    (set! (-> cpuinfo radius) (-> launchinfo launchrot z))
                    (quaternion-axis-angle! (-> cpuinfo rotvel3d)
                                            axis-x
                                            0.0
                                            axis-z
                                            (-> launchinfo launchrot y)))
                  ;; Orbit updates use the parent particle's renderer record as their center.
                  (set! (-> cpuinfo user-sprite) (-> launch-state sprite sprite)))
                
                (set! (-> cpuinfo binding) (the-as sparticle-launch-state #f))
                
                ;; handle bound sprites
                (when (and launch-state (nonzero? (-> launch-state group-item binding)))
                  (let ((binding-id (-> launch-state group-item binding))
                        (state-index 0)
                        (binding-installed? #f))
                    ;; iterate through launcher looking for a dead launcher matching binding
                    (while (and (< state-index (-> launch-control length)) (not binding-installed?))
                      (let ((candidate (-> launch-control data state-index)))
                        (when (and (= (-> candidate group-item launcher) binding-id)
                                   (not (logtest? (-> candidate flags) (sp-launch-state-flags enabled))))
                          ;; found it, enable!
                          (logior! (-> candidate flags) (sp-launch-state-flags enabled))
                          ;; link
                          (set! (-> candidate origin) (-> cpuinfo sprite x-y-z-sx))
                          (set! (-> candidate sprite3d)
                                (if (-> sys is-3d)
                                  (the-as sprite-vec-data-3d (-> cpuinfo sprite))
                                  (the-as sprite-vec-data-3d #f)))
                          (set! (-> candidate sprite) cpuinfo)
                          (set! (-> cpuinfo binding) candidate)
                          (set! binding-installed? #t)))
                      (+! state-index 1))))

                ;; check if there are any leftover fields that adjust the launch
                (when (< (the-as int16 (-> launch-spec 0 field)) 64)
                  (sp-adjust-launch launchinfo cpuinfo launch-spec))
                ;; 3D euler -> quaternion update
                (when (-> sys is-3d)
                  (sp-euler-convert launchinfo cpuinfo))
                (when (and launch-state
                           (!= (-> launch-state sprite3d) #f)
                           (nonzero? (-> launch-state sprite3d)))
                  (sp-rotate-system launchinfo cpuinfo (-> launch-state sprite3d)))

                ;; add origin position after rotations
                (+! (-> launchinfo launchrot x) (-> origin x))
                (+! (-> launchinfo launchrot y) (-> origin y))
                (+! (-> launchinfo launchrot z) (-> origin z))
                
                ;; get ADGIF shader info for this particle's texture.
                (particle-adgif (-> cpuinfo adgif) (-> birthinfo sprite))
                ;; Set blending mode on ADGIF based on flags.
                (when (logtest? particle-flags (sp-cpuinfo-flag blend-erase-dest))
                  (set! (-> cpuinfo adgif alpha) (new 'static 'gs-alpha :a 2 :b 1 :d 2)))
                (when (logtest? particle-flags (sp-cpuinfo-flag subtract-blend))
                  (set! (-> cpuinfo adgif alpha) (new 'static 'gs-alpha :a 2 :d 1)))
                (when (logtest? particle-flags (sp-cpuinfo-flag glow))
                  (set! (-> cpuinfo adgif alpha) (new 'static 'gs-alpha :b 2 :d 1)))
                (when (logtest? particle-flags (sp-cpuinfo-flag write-depth))
                  (set! (-> cpuinfo adgif clamp)
                        (the gs-clamp (new 'static 'gs-zbuf :zbp #x1c0 :psm (gs-psm ct24)))))

                ;; run user-provided birth callback
                (when (nonzero? (the-as uint (-> birthinfo birth-func)))
                  ((the-as (function sparticle-system
                                    sparticle-cpuinfo
                                    sprite-vec-data-3d
                                    sparticle-launcher
                                    sparticle-launch-state
                                    none)
                           (-> birthinfo birth-func))
                   sys
                   cpuinfo
                   sprite-tmp
                   launcher
                   launch-state))
                
                ;; play sound. Use a single birth accumulator in the launcher def itself.
                (when (nonzero? (the-as uint (-> birthinfo sound)))
                  (+! (-> launcher soundaccum) (-> (the-as sound-spec (-> birthinfo sound)) num))
                  (let ((sound-remainder (- (-> launcher soundaccum) 1.0)))
                    ;; The assembly tests the sign bit of the subtraction result directly.
                    (when (>= (the-as int sound-remainder) 0)
                      (set! (-> launcher soundaccum) sound-remainder)
                      (sound-play-by-spec (the-as sound-spec (-> birthinfo sound)) (new-sound-id) origin))))

                ;; Handle distortion sprites - these are processed like normal on CPU,
                ;; but passed to a different list for rendering
                (when (logtest? particle-flags (sp-cpuinfo-flag aux-list))
                  ;; set up callback to add to aux list
                  (set! (-> cpuinfo func) add-to-sprite-aux-list)
                  ;; alpha is 0 for these particles, we don't want that to kill them
                  (logclear! particle-flags (sp-cpuinfo-flag die-when-faded))
                  (set! (-> sprite-tmp a) 0.0)
                  (set! (-> cpuinfo fade a) 0.0)
                  ;; clamp number of "turns" (number of sides on distort polygon)
                  (set! (-> sprite-2d flag) (max 3 (min 11 (-> sprite-2d flag)))))

                ;; check if particle is in each level and set appropriate flags.
                ;; this is used to kill particles when a level unloads.
                (cond
                  ((and (>= (the-as int launcher) (the-as int (-> *level* level0 heap base)))
                        (< (the-as int launcher) (the-as int (-> *level* level0 heap top-base))))
                   (logior! particle-flags (sp-cpuinfo-flag level0)))
                  ((and (>= (the-as int launcher) (the-as int (-> *level* level1 heap base)))
                        (< (the-as int launcher) (the-as int (-> *level* level1 heap top-base))))
                   (logior! particle-flags (sp-cpuinfo-flag level1))))
                
                ;; apply time-of-day coloring
                (when (= (logand particle-flags
                                 (sp-cpuinfo-flag aux-list use-time-of-day-color))
                         (sp-cpuinfo-flag use-time-of-day-color))
                  (let ((time-color (-> *time-of-day-context* current-prt-color)))
                    (*! (-> sprite-tmp r) (-> time-color x))
                    (*! (-> sprite-tmp g) (-> time-color y))
                    (*! (-> sprite-tmp b) (-> time-color z))
                    (*! (-> cpuinfo fade r) (-> time-color x))
                    (*! (-> cpuinfo fade g) (-> time-color y))
                    (*! (-> cpuinfo fade b) (-> time-color z))))

                ;; Set the launch control as the "key", essentially the owner for the particle.
                ;; We can later look it up by key to kill associated particles.
                (set! (-> cpuinfo key)
                      (if launch-control launch-control (the-as sparticle-launch-control 0)))
                
                ;; copy sprite data out (there's a race on reading this data with DMA, this
                ;; provides a more atomic update after all updates/processing)
                (let ((sprite-out (the-as sprite-vec-data-3d (-> cpuinfo sprite))))
                  (vector-copy! (-> sprite-out x-y-z-sx) (-> sprite-tmp x-y-z-sx))
                  (vector-copy! (-> sprite-out qx-qy-qz-sy) (-> sprite-tmp qx-qy-qz-sy))
                  (vector-copy! (-> sprite-out r-g-b-a) (-> sprite-tmp r-g-b-a))
                  ;; set alpha to zero, initially disabled, it will get restored on first update.
                  (set! (-> sprite-out a) 0.0))
                (logior! particle-flags (sp-cpuinfo-flag just-launched))
                (set! (-> cpuinfo flags) particle-flags)
                (set! (-> cpuinfo cache-alpha) (-> sprite-tmp a))))
            ;; decrement birth accumulators after a successful birth.
            (if launch-state
              (+! (-> launch-state accum) -1.0)
              (+! (-> launcher birthaccum) -1.0)))))
      (none))))

;;;;;;;;;;;;;;;
;; enemy death
;;;;;;;;;;;;;;;

;; Enemy-death particles are a special case. Particles are launched from positions on the mesh to
;; make it look like the enemy is dissolving. These bypass the usual launcher system and instead
;; launch exactly one particle per sp-launch-particles-death call.

(define *death-adgif* (the-as adgif-shader #f))

(defun sp-launch-particles-death ((sys sparticle-system) (launcher sparticle-launcher) (pos vector))
  "Launch the enemy-death effect as one 2D particle,
   runs the launcher's sprite+cpu init specs, applies time-of-day tint, points its adgif at the
   shared *death-adgif* shader, and marks it just-launched. The particle is born invisible and the
   update function restores its alpha. This path does not use launch-state or launch-control."
  (rlet ((vf0 :class vf)
         (vf1 :class vf)
         (vf2 :class vf)
         (vf3 :class vf)
         (vf30 :class vf)
         (vf31 :class vf)
         (vf4 :class vf)
         (vf5 :class vf)
         (vf6 :class vf))
    (init-vf0-vector)
    ;; vf30 = launch position (pos). vf31 = 255.0 broadcast (#x437f0000 is the float 255.0),
    ;; used below as the saturation ceiling for the 8-bit color components.
    (.lvf vf30 (&-> pos quad))
    (let ((max-color-bits #x437f0000))
      (.mov vf31 max-color-bits))
    (let ((sprite-tmp (new 'stack-no-clear 'sprite-vec-data-2d))
          ;; get a particle, from the particle system
          ;; this gets us a "cpuinfo", which is the state of a particle.
          (cpuinfo (sp-get-particle sys 0 (the-as sparticle-launch-state #f))))
      (if (not cpuinfo)
        ;; if we're out of particles, just igve up.
        (return 0))
      (let* ((first-spec (-> launcher init-specs 0))
             ;; initialize the sprite fields. this is done to a temporary structure on the stack
             ;; the death particle effect has some special initialization stuff below that will
             ;; modify this data before setting the actual sprite data.
             (next-spec (sp-init-fields! (&-> sprite-tmp x)
                                         (the-as (inline-array sp-field-init-spec) first-spec)
                                         (sp-field-id sprite-fields-start)
                                         (sp-field-id sprite-fields-end)
                                         #t)))
        ;; initialize the cpu fields, this is the initial particle state.
        (sp-init-fields! (&-> cpuinfo omega)
                         (the-as (inline-array sp-field-init-spec) next-spec)
                         (sp-field-id cpu-fields-start)
                         (sp-field-id cpu-fields-end)
                         #t))
      ;; convert rotations
      (set! (-> sprite-tmp matrix) (sprite-matrix-mode camera))
      (set! (-> sprite-tmp rot) (the float (sar (shl (the int (-> sprite-tmp rot)) 48) 48)))
      ;; convert color/position.
      (.lvf vf4 (&-> sprite-tmp color quad))
      (.lvf vf5 (&-> sprite-tmp x-y-z-sx quad))
      (.min.x.vf.xyz vf4 vf4 vf31)
      (.add.vf.xyz vf5 vf5 vf30)
      (.svf (&-> sprite-tmp color quad) vf4)
      (.svf (&-> sprite-tmp x-y-z-sx quad) vf5)
      (when (not *death-adgif*)
        ;; first time we get here, set up the adgif shader.
        (set! *death-adgif* (new 'static 'adgif-shader))
        (particle-adgif *death-adgif* (new 'static 'texture-id :index #x18 :page #x2))
        (set! (-> *death-adgif* alpha) (new 'static 'gs-alpha :b #x2 :d #x1)))
      ;; copy the death-adgif to the adgif of our particle
      (let ((adgif-q0 (-> *death-adgif* quad 0 quad))) (set! (-> cpuinfo adgif quad 0 quad) adgif-q0))
      (let ((adgif-q1 (-> *death-adgif* quad 1 quad))) (set! (-> cpuinfo adgif quad 1 quad) adgif-q1))
      (let ((adgif-q2 (-> *death-adgif* quad 2 quad))) (set! (-> cpuinfo adgif quad 2 quad) adgif-q2))
      (let ((adgif-q3 (-> *death-adgif* quad 3 quad))) (set! (-> cpuinfo adgif quad 3 quad) adgif-q3))
      (let ((adgif-q4 (-> *death-adgif* quad 4 quad))) (set! (-> cpuinfo adgif quad 4 quad) adgif-q4))
      ;; tint by time of day
      (.lvf vf4 (&-> (-> *time-of-day-context* current-prt-color) quad))
      (.lvf vf5 (&-> sprite-tmp color quad))
      (.lvf vf6 (&-> cpuinfo fade quad))
      (.mul.vf.xyz vf5 vf5 vf4)
      (.mul.vf.xyz vf6 vf6 vf4)
      (.svf (&-> sprite-tmp color quad) vf5)
      (.svf (&-> cpuinfo fade quad) vf6)
      ;; no key for these particles
      (set! (-> cpuinfo key) (the-as sparticle-launch-control 0))
      (set! (-> cpuinfo binding) #f)
      ;; copy the sprite data
      (let ((sprite-data (-> cpuinfo sprite)))
        (.lvf vf1 (&-> sprite-tmp x-y-z-sx quad))
        (.lvf vf2 (&-> sprite-tmp flag-rot-sy quad))
        (.lvf vf3 (&-> sprite-tmp color quad))
        (.svf (&-> sprite-data x-y-z-sx quad) vf1)
        (.svf (&-> sprite-data flag-rot-sy quad) vf2)
        (.sub.w.vf.w vf3 vf0 vf0)
        (.svf (&-> sprite-data color quad) vf3))
      ;; we're done!
      (logior! (-> cpuinfo flags) (sp-cpuinfo-flag just-launched))
      (set! (-> cpuinfo cache-alpha) (-> sprite-tmp a))
      ;; The particle is born invisible (its real alpha stashed in cache-alpha, sprite alpha 0).
      ;; On the next process-particles pass, the per-block update function sees just-launched,
      ;; restores the alpha from cache-alpha, and clears the bit.
      )
    0
    (none)))


(defun sp-clear-queue ()
  "Launch every deferred particle request and empty the launch queue."
  (let ((queue *sp-launch-queue*))
    (when (> (-> queue in-use) 0)
      (dotimes (i (-> queue in-use))
        (let ((entry (-> queue queue i)))
          (launch-particles :system (-> entry sp-system) (-> entry sp-launcher) (-> entry pos) :rate 1.0)))
      (set! (-> queue in-use) 0)
      0))
  0
  (none))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; relaunch / aging model
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Each particle carries two 300hz countdowns, decremented by the update kernel
;; (sp-process-block-2d/3d): `timer` is the lifetime -- when it hits 0 the particle is
;; freed -- and `next-time` is the relaunch timer. When next-time expires and the particle has a
;; `next-launcher` set, the kernel calls sp-relaunch-particle-2d/3d
;; with that next-launcher: the particle is NOT freed, its fields are re-initialized in place from the
;; new launcher's init-specs (sp-relaunch-setup-fields, write-missing-fields=#f so unspecified
;; fields keep their current values), and it keeps aging. This is how the game creates
;; multi-phase effects (e.g. smoke that changes textures/colors and slows down).

(defun sp-relaunch-setup-fields ((user object) (launcher sparticle-launcher) (cpuinfo sparticle-cpuinfo) (sprite sprite-vec-data-3d))
  "Reset the sprite+cpu fields of an existing (live) particle from a launcher's init-specs.
   Only fields the launcher specifies are overwritten; the level0/level1 flags are preserved."
  (let ((first-spec (-> launcher init-specs 0))
        (level-flags (logand (-> cpuinfo flags) (sp-cpuinfo-flag level0 level1))))
    (set! (-> cpuinfo next-launcher) (the-as basic 0))
    (cond
      ;; use-time-of-day-color path: re-init the fields AND apply time-of-day tinting to the
      ;; color/fade. Trick: pre-set color/fade to the sentinel 99999.0, re-run sp-init-fields! with
      ;; write-missing-fields=#f so only fields the launcher actually specifies get overwritten.
      ;; Afterwards, any component still == 99999.0 was not specified, so restore its saved value;
      ;; otherwise multiply the freshly-written value by the current time-of-day particle color.
      ((and (logtest? (-> cpuinfo flags) (sp-cpuinfo-flag use-time-of-day-color))
            (not (logtest? (-> cpuinfo flags) (sp-cpuinfo-flag aux-list))))
       (let ((saved-r (-> sprite r-g-b-a x))
             (saved-g (-> sprite r-g-b-a y))
             (saved-b (-> sprite r-g-b-a z))
             (saved-fade-r (-> cpuinfo fade x))
             (saved-fade-g (-> cpuinfo fade y))
             (saved-fade-b (-> cpuinfo fade z)))
         (set! (-> sprite r-g-b-a x) 99999.0)
         (set! (-> sprite r-g-b-a y) 99999.0)
         (set! (-> sprite r-g-b-a z) 99999.0)
         (set! (-> cpuinfo fade x) 99999.0)
         (set! (-> cpuinfo fade y) 99999.0)
         (set! (-> cpuinfo fade z) 99999.0)
         (let ((next-spec (sp-init-fields! (&-> sprite x-y-z-sx x)
                                           (the-as (inline-array sp-field-init-spec) first-spec)
                                           (sp-field-id sprite-fields-start)
                                           (sp-field-id sprite-fields-end)
                                           #f)))
           (sp-init-fields! (&-> cpuinfo omega) next-spec (sp-field-id cpu-fields-start) (sp-field-id cpu-fields-end) #f))
         ;; clear all flags except for the level.
         (logior! (-> cpuinfo flags) level-flags)
         ;; unused...
         (if (logtest? (-> cpuinfo flags) (sp-cpuinfo-flag level1)) (-> *level* level1) (-> *level* level0))
         
         ;; apply time-of-day tinting
         (let ((tod-color (-> *time-of-day-context* current-prt-color)))
           (if (= (-> sprite r-g-b-a x) 99999.0)
             (set! (-> sprite r-g-b-a x) saved-r)
             (set! (-> sprite r-g-b-a x) (* (-> sprite r-g-b-a x) (-> tod-color x))))
           (if (= (-> sprite r-g-b-a y) 99999.0)
             (set! (-> sprite r-g-b-a y) saved-g)
             (set! (-> sprite r-g-b-a y) (* (-> sprite r-g-b-a y) (-> tod-color y))))
           (if (= (-> sprite r-g-b-a z) 99999.0)
             (set! (-> sprite r-g-b-a z) saved-b)
             (set! (-> sprite r-g-b-a z) (* (-> sprite r-g-b-a z) (-> tod-color z))))
           (if (= (-> cpuinfo fade x) 99999.0)
             (set! (-> cpuinfo fade x) saved-fade-r)
             (set! (-> cpuinfo fade x) (* (-> cpuinfo fade x) (-> tod-color x))))
           (if (= (-> cpuinfo fade y) 99999.0)
             (set! (-> cpuinfo fade y) saved-fade-g)
             (set! (-> cpuinfo fade y) (* (-> cpuinfo fade y) (-> tod-color y))))
           (if (= (-> cpuinfo fade z) 99999.0)
             (set! (-> cpuinfo fade z) saved-fade-b)
             (set! (-> cpuinfo fade z) (* (-> cpuinfo fade z) (-> tod-color z)))))))
      (else
        ;; no time-of-day trick needed, just re-init fields.
       (let ((next-spec (sp-init-fields! (&-> sprite x-y-z-sx x)
                                         (the-as (inline-array sp-field-init-spec) first-spec)
                                         (sp-field-id sprite-fields-start)
                                         (sp-field-id sprite-fields-end)
                                         #f)))
         (sp-init-fields! (&-> cpuinfo omega) next-spec (sp-field-id cpu-fields-start) (sp-field-id cpu-fields-end) #f)))))
  0
  0
  (none))

(defun sp-relaunch-particle-2d ((user object) (launcher sparticle-launcher) (cpuinfo sparticle-cpuinfo) (sprite sprite-vec-data-3d))
  "Reinitialize a 2D particle, then route auxiliary-list particles back onto the
   sprite aux list (their func is reset by the field re-init, so it must be re-installed)."
  (sp-relaunch-setup-fields user launcher cpuinfo sprite)
  (when (logtest? (-> cpuinfo flags) (sp-cpuinfo-flag aux-list))
    (set! (-> cpuinfo func) add-to-sprite-aux-list)
    ;; aux-list (distortion) particles are forced fully transparent, so clear die-when-faded
    ;; (alpha == 0 would otherwise auto-kill them instantly).
    (set! (-> sprite r-g-b-a w) 0.0)
    (set! (-> cpuinfo fade w) 0.0)
    (logclear! (-> cpuinfo flags) (sp-cpuinfo-flag die-when-faded)))
  0
  (none))

(defun sp-relaunch-particle-3d ((user object) (launcher sparticle-launcher) (cpuinfo sparticle-cpuinfo) (sprite sprite-vec-data-3d))
  "Reinitialize a 3D particle, then rebuild its orientation. The old quaternion is
   saved (w recovered as sqrt(1-x^2-y^2-z^2) since sprites don't store w), the re-init'd euler
   rotation is converted with quaternion-zxy!, optionally composed with the old quat
   (left/right-multiply-quat flags), and stored back with w forced non-negative. Also rescales
   rot-syvel by the ticks-per-frame (5 at 60hz / 6 at 50hz) and rebuilds rotvel3d."
  ;; do all the 3d-specific stuff here, the general relaunch only does 2d fields.
  (rlet ((vf0 :class vf)
         (vf1 :class vf)
         (vf2 :class vf))
    (init-vf0-vector)
    (let ((parent-quat (new 'stack-no-clear 'quaternion)))
      (let* ((dst-quat parent-quat)
             (spr sprite)
             (qx (-> spr qx-qy-qz-sy x))
             (qy (-> spr qx-qy-qz-sy y))
             (qz (-> spr qx-qy-qz-sy z)))
        (set! (-> dst-quat x) qx)
        (set! (-> dst-quat y) qy)
        (set! (-> dst-quat z) qz)
        (set! (-> dst-quat w) (sqrtf (- (- (- 1.0 (square qz)) (square qy)) (square qx)))))
      (set! (-> sprite qx-qy-qz-sy x) 0.0)
      (set! (-> sprite qx-qy-qz-sy y) 0.0)
      (set! (-> sprite qx-qy-qz-sy z) 0.0)
      (sp-relaunch-setup-fields user launcher cpuinfo sprite)
      (let ((euler (new 'stack-no-clear 'vector))
            (quat (new 'stack-no-clear 'quaternion)))
        (set-vector! euler (-> sprite qx-qy-qz-sy x) (-> sprite qx-qy-qz-sy y) (-> sprite qx-qy-qz-sy z) 1.0)
        (quaternion-zxy! quat euler)
        (cond
          ((logtest? (sp-cpuinfo-flag left-multiply-quat) (-> cpuinfo flags)) (quaternion*! quat parent-quat quat))
          (else (if (logtest? (sp-cpuinfo-flag right-multiply-quat) (-> cpuinfo flags)) (quaternion*! quat quat parent-quat))))
        (cond
          ((< (-> quat w) 0.0)
           (.lvf vf1 (&-> sprite qx-qy-qz-sy quad))
           (.lvf vf2 (&-> quat vec quad))
           (.sub.vf.xyz vf1 vf0 vf2)
           (.svf (&-> sprite qx-qy-qz-sy quad) vf1))
          (else
           (.lvf vf1 (&-> sprite qx-qy-qz-sy quad))
           (.lvf vf2 (&-> quat vec quad))
           (.add.vf.xyz vf1 vf0 vf2)
           (.svf (&-> sprite qx-qy-qz-sy quad) vf1)))))
    (cond
      (*sp-60-hz*
       (set! (-> cpuinfo rot-syvel x) (* 5.0 (-> cpuinfo rot-syvel x)))
       (set! (-> cpuinfo rot-syvel y) (* 5.0 (-> cpuinfo rot-syvel y)))
       (set! (-> cpuinfo rot-syvel z) (* 5.0 (-> cpuinfo rot-syvel z))))
      (else
       (set! (-> cpuinfo rot-syvel x) (* 6.0 (-> cpuinfo rot-syvel x)))
       (set! (-> cpuinfo rot-syvel y) (* 6.0 (-> cpuinfo rot-syvel y)))
       (set! (-> cpuinfo rot-syvel z) (* 6.0 (-> cpuinfo rot-syvel z)))))
    (quaternion-zxy! (-> cpuinfo rotvel3d) (-> cpuinfo rot-syvel))
    0
    (none)))

;;;;;;;;;;;;;;;;;;;;
;; launch control
;;;;;;;;;;;;;;;;;;;;

;; a launch-control is an instance of a particle effect group. it holds the definition and the state.
;; the launch-controls are always associated with a process. this allows the memory to be reclaimed once the
;; particles are despawned.

(defmethod initialize ((this sparticle-launch-control) (group sparticle-launch-group) (proc process))
  "Initialize this control's timing and one launch-state for every valid launcher in group."
  (let ((state-idx 0))
    ;; init
    (set! (-> this group) group)
    (set! (-> this proc) proc)
    (set! (-> this local-clock) 0)
    (set! (-> this fade) 1.0)
    (set! (-> this matrix) 0)
    (set! (-> this last-spawn-frame) (the-as int (+ (-> *display* real-actual-frame-counter) (seconds -0.007))))
    (set! (-> this last-spawn-time) 0)
    ;; iterate through the effects in the group
    (dotimes (i (-> group length))
      (let* ((item (-> group launcher i)) ;; the group-item (definition of the effect)
             (launcher (-> *part-id-table* (-> item launcher))) ;; the actual effect for the group item
             (state (-> this data state-idx)) ;; our state for this particular instance of this effect within the group.
             )
        (when (nonzero? launcher)
          (set! (-> state group-item) item)
          (cond
            ((= (-> launcher type) sparticle-launcher)
             ;; init state
             (set! (-> state accum) 0.0)
             (set! (-> state spawn-time) (the-as uint (+ *particle-300hz-timer* -30000)))
             (set! (-> state offset) (-> item offset))
             (set! (-> state randomize) (the-as uint 0))
             (cond
               ((logtest? (-> item flags) (sp-group-item-flag child))
                ;; start dead, another particle will bind this one and set enabled
                ;; and also set origin/sprite3d/sprite to the parent.
                (logclear! (-> state flags) (sp-launch-state-flags enabled))
                (set! (-> state origin) #f)
                (set! (-> state sprite3d) #f)
                (set! (-> state sprite) #f))
               (else
                ;; not child, enable the launcher
                (logior! (-> state flags) (sp-launch-state-flags enabled))
                ;; set the position now.
                (set! (-> state origin) (-> this center))
                ;; set #f in the link to parent fields, this isn't a child.
                (set! (-> state sprite3d) #f)
                (set! (-> state sprite) #f)))
             (+! state-idx 1))
            (else (format 0 "initialize called with non-particle-launcher~%"))))))
    (set! (-> this length) state-idx))
  0
  (none))

(defmethod create-launch-control ((this sparticle-launch-group) (proc process))
  "Allocate and initialize per-process launch state for every valid launcher in this group."
  (let ((launch-control (the-as sparticle-launch-control (new 'process 'sparticle-launch-control (-> this length)))))
    (when (zero? launch-control)
      (go process-drawable-art-error "memory")
      (return (the-as sparticle-launch-control 0)))
    (initialize launch-control this proc)
    launch-control))

(defmethod kill-and-free-particles ((this sparticle-launch-control))
  "Mark every item inactive, reset this control's timing, kill its particles, and release its
   optional sprite transform."
  ;; clear the flag.
  (countdown (i (-> this length))
    (let ((state (-> this data i)))
      (logclear! (-> state flags) (sp-launch-state-flags launched))))
  (set! (-> this local-clock) 0)
  (set! (-> this fade) 1.0)
  ;; kill the particles (let them go back to the sparticle system.)
  (kill-all-particles-with-key this)
  ;; release matrices
  (if (> (-> this matrix) 0)
      (sprite-release-user-hvdf (-> this matrix)))
  0
  (none))

(defmethod kill-particles ((this sparticle-launch-control))
  "Kill particles belonging to this control without resetting item flags or releasing its optional
   sprite transform."
  (kill-all-particles-with-key this)
  0
  (none))

(defmethod is-visible? ((this sparticle-launch-control) (offset vector))
  "Return true when the group's bounds at offset intersect the view, or when bounds or an attached
   matrix prevent useful sphere culling."
  (let* ((group (-> this group))
         (bounds-radius (-> group bounds w)))
    (cond
      ((= bounds-radius 0.0) ;; visibility sphere has 0 size, just say yes always
       #t)
      ((nonzero? (-> this matrix)) ;; The bounds cannot be tested here without applying the attached matrix.
       #t)
      (else
       ;; sphere with offset
       (let ((vis-sphere (vector+! (new 'stack-no-clear 'vector) offset (the-as vector (-> group bounds)))))
         (set! (-> vis-sphere w) bounds-radius)
         ;; debug draw sphere
         (if (and *display-actor-vis* (or (not *display-actor-anim*) (name= *display-actor-anim* (-> this proc name))))
           (add-debug-sphere *display-actor-vis* (bucket-id debug) vis-sphere (-> vis-sphere w) (new 'static 'rgba :g #xff :a #x80)))
         ;; og:preserve-this can we see it?
         (#if (not PC_PORT)
           (sphere-in-view-frustum? (the-as sphere vis-sphere))
           (if (-> *pc-settings* ps2-parts?)
             ;; og:preserve-this pc port: launchers have larger bsphere if you have ps2 parts off
             (sphere-in-view-frustum? (the-as sphere vis-sphere))
             (sphere-in-view-frustum? (the-as sphere (begin (*! (-> vis-sphere w) 8.0) vis-sphere))))))))))

(defmethod spawn ((this sparticle-launch-control) (pos vector))
  "Per-frame entry point for a launch-control: emit particles for each active group-item as the
   schedule dictates. pos is the world position to launch from.
   Time is tracked in 300hz ticks: (now - last-time) is the number of ticks since the previous
   frame (the base burst count). rate/burst-rate scale that count, reduced by distance falloff
   (falloff-to) and clipped to the per-period launch window.
   For periodic items (period != 0), [offset .. offset+length) within each period is the active
   window; the periodic path computes how much of the elapsed interval overlapped that window. Items are
   suppressed by hour-mask (time of day) and by fade-after (camera distance)."
  (vector-copy! (-> this center) pos)
  ;; og:preserve-this
  ;; check if we are visible (remove this check to force particles to be drawn.)
  (if (not (or (is-visible? this pos)
               (logtest? (-> this group flags) (sp-group-flag always-process screen-space))))
    (return (the-as object 0)))
  (let ((now *particle-300hz-timer*)
        (last-time (-> this last-spawn-time)))
    ;; Do not accumulate a large birth interval when this control was skipped for one or more frames.
    (let ((frame-counter (-> *display* real-actual-frame-counter)))
      (if (!= frame-counter (+ (-> this last-spawn-frame) 1))
        (set! last-time (- now (logand (the-as int (-> *sp-frame-time* x)) 255)))))
    (set! (-> this last-spawn-frame) (the-as int (-> *display* real-actual-frame-counter)))
    (set! (-> this last-spawn-time) now)
    
    ;; if we're using the local clock, update the clock in the launch-control (only ticks when visible, starts at 0 
    ;; when launch-control is first run)
    (when (logtest? (-> this group flags) (sp-group-flag use-local-clock))
      (set! last-time (-> this local-clock))
      (+! (-> this local-clock) (logand (the-as int (-> *sp-frame-time* x)) 255))
      (set! now (-> this local-clock)))
    (let ((cam-dist (vector-vector-distance pos (math-camera-pos)))
          ;; hour mask
          (hour-bit (ash 1 (if *time-of-day-proc* (-> *time-of-day-proc* 0 hour) 0))))
      (if (nonzero? (-> this matrix)) ;; if we have an additional matrix, say we're at the camera so we always draw.
        (set! cam-dist 0.0))
      ;; og:preserve-this if we have ps2 particles off, say we're at the camera
      (with-pc
        (if (not (-> *pc-settings* ps2-parts?)) (set! cam-dist 0.0)))
      ;; loop over particles in the group.
      (let ((item-idx (-> this length)))
        (while (begin
                 (label item-loop)
                 (nonzero? item-idx))
          (+! item-idx -1)
          (let* ((state (-> this data item-idx))
                 (item (-> state group-item))
                 (launcher (-> *part-id-table* (-> item launcher))))
            (when (and launcher (nonzero? launcher) (logtest? (-> state flags) (sp-launch-state-flags enabled)))
              ;; we are active, and it is possible to launch.
              ;; rate is the launch rate: 1.0, reduced linearly toward 0 as distance approaches falloff-to.
              (let ((rate 1.0))
                (if (!= (-> item falloff-to) 0.0) (set! rate (- 1.0 (/ cam-dist (-> item falloff-to)))))
                ;; reject if bad type
                (let ((launcher-type sparticle-launcher)) (b! (!= (-> launcher type) launcher-type) bad-launcher :delay (nop!)))
                ;; og:preserve-this PAL patch here
                ;; If this is a one-shot item (one-shot or every-frame), take the
                ;; immediate-launch path just below; otherwise use the periodic scheduler.
                (b! (zero? (logand (-> item flags) (sp-group-item-flag one-shot every-frame))) periodic-path :delay (nop!))
                (when (or (zero? (logand (-> state flags) (sp-launch-state-flags launched)))
                          (logtest? (-> item flags) (sp-group-item-flag every-frame)))
                  ;; particles are not active (or every-frame forces a burst every call):
                  ;; launch one burst.
                  (set! (-> state spawn-time) (the-as uint now))
                  (logior! (-> state flags) (sp-launch-state-flags launched))
                  (if (< 0.0 rate)
                    (launch-particles :system
                                      (if (logtest? (-> item flags) (sp-group-item-flag 3d)) *sp-particle-system-3d* *sp-particle-system-2d*)
                                      launcher
                                      (-> state origin)
                                      :launch-state
                                      state
                                      :launch-control
                                      this
                                      :rate
                                      rate)))
                
                (b! #t next-item :delay (nop!))
                (label periodic-path)
                ;; reject if bad time of day
                (when (logtest? hour-bit (-> item hour-mask))
                  0
                  (goto next-item))
                (when (not (or (= (-> item fade-after) 0.0) (< cam-dist (-> item fade-after))))
                  0
                  (b! #t next-item :delay (nop!))
                  (set! item (the-as sparticle-group-item 0)))
                ;; period == 0 -> launch continuously: rate = 0.2 * elapsed_ticks (0.2 = 1/5 converts
                ;; 300hz ticks to 60hz frame units, matching *sp-frame-time* z/w) scaled by distance.
                (b! (nonzero? (-> item period)) compute-periodic-overlap)
                (let ((burst-rate (* 0.2 (the float (- now last-time)) rate)))
                  (b! #t emit-periodic :delay (nop!))
                  ;; In the periodic case, last-phase is the phase of the previous spawn and
                  ;; now-phase = phase of now. The four cases below compute how many of the elapsed
                  ;; ticks fell inside the [0, length) emission window of the period.
                  (label compute-periodic-overlap)
                  (let ((last-phase (mod (+ last-time (-> this data item-idx offset)) (the-as int (-> item period))))
                        (now-phase (mod (the-as uint (+ now (-> this data item-idx offset))) (-> item period)))
                        (window-len (-> item length)))
                    (set! burst-rate
                          (cond
                            ((and (< last-phase (the-as int window-len)) (< now-phase window-len)) (* 0.2 (the float (- now last-time)) rate))
                            ((and (< last-phase (the-as int window-len)) (>= now-phase window-len))
                             (* 0.2 (the float (- window-len (the-as uint last-phase))) rate))
                            ((and (>= last-phase (the-as int window-len)) (< now-phase window-len)) (* 0.2 (the float now-phase) rate))
                            (else
                             ;; both endpoints are outside the emission window: only loop
                             ;; items may start a new cycle (and only once a full period has
                             ;; elapsed since the last spawn); others go dormant.
                             (when (not (logtest? (-> item flags) (sp-group-item-flag loop)))
                               0
                               (goto next-item))
                             (when (< (the-as uint (- now (the-as int (-> this data item-idx spawn-time)))) (-> item period))
                               0
                               (goto next-item))
                             (set! (-> this data item-idx offset) (- (-> item period) now-phase))
                             (* 0.2 (the float (- now last-time)) rate)))))
                  (label emit-periodic)
                  (set! (-> state spawn-time) (the-as uint now))
                  (logior! (-> state flags) (sp-launch-state-flags launched))
                  (if (< 0.0 burst-rate)
                    (launch-particles :system
                                      (if (logtest? (-> item flags) (sp-group-item-flag 3d)) *sp-particle-system-3d* *sp-particle-system-2d*)
                                      launcher
                                      (-> state origin)
                                      :launch-state
                                      state
                                      :launch-control
                                      this
                                      :rate
                                      burst-rate))))
              (label next-item)
              (b! #t item-loop :delay (nop!))
              (label bad-launcher)
              (format 0 "spawn called for non-sparticle-launcher~%")))))))
  0)

;;;;;;;;;;;;;;;;;;;;;;;
;; tracking callbacks
;;;;;;;;;;;;;;;;;;;;;;;

;; these are commonly used callbacks for making particles follow an object

(defun sparticle-track-root ((user object) (cpuinfo sparticle-cpuinfo) (out-pos vector))
  "Write the tracked drawable's root translation to out-pos."
  (let ((trans (-> (the-as process-drawable (-> cpuinfo key proc)) root trans)))
    (set! (-> out-pos x) (-> trans x))
    (set! (-> out-pos y) (-> trans y))
    (set! (-> out-pos z) (-> trans z)))
  0
  (none))

(defun sparticle-track-root-prim ((user object) (cpuinfo sparticle-cpuinfo) (out-pos vector))
  "Write the tracked drawable's root collision primitive center to out-pos."
  (let ((prim-core (-> (the-as collide-shape (-> (the-as process-drawable (-> cpuinfo key proc)) root)) root-prim prim-core)))
    (set! (-> out-pos x) (-> prim-core world-sphere x))
    (set! (-> out-pos y) (-> prim-core world-sphere y))
    (set! (-> out-pos z) (-> prim-core world-sphere z)))
  0
  (none))

;;;;;;;;;;;;;;;;;;;;;
;; birth funcs
;;;;;;;;;;;;;;;;;;;;;

(defun birth-func-copy-rot-color ((sys sparticle-system)
        (cpuinfo sparticle-cpuinfo)
        (sprite3d sprite-vec-data-3d)
        (launcher sparticle-launcher)
        (launch-state sparticle-launch-state))
  "Birth callback: copy the launching object's (launch-state sprite) rotation and color onto the
   new particle. The launcher's 3d quaternion only stores xyz (w is recomputed as
   sqrt(1 - x^2 - y^2 - z^2) since the sprite renderer assumes w>=0), then it is spun about y by the
   parent sprite's `rot` and re-stored (again forcing w>=0 by sign-flipping all components)."
  (local-vars (dummy0 float) (dummy1 float))
  (rlet ((vf0 :class vf)
         (vf1 :class vf)
         (vf2 :class vf))
    (init-vf0-vector)
    (let ((parent (-> launch-state sprite)))
      (let ((quat (new 'stack-no-clear 'vector)))
        (let* ((spr sprite3d)
               (qx (-> spr qx-qy-qz-sy x))
               (qy (-> spr qx-qy-qz-sy y))
               (qz (-> spr qx-qy-qz-sy z)))
          (set! (-> quat x) qx)
          (set! (-> quat y) qy)
          (set! (-> quat z) qz)
          (set! (-> quat w) (sqrtf (- (- (- 1.0 (square qz)) (square qy)) (square qx)))))
        (quaternion-rotate-y! (the-as quaternion quat) (the-as quaternion quat) (-> parent sprite rot))
        (let ((spr-out sprite3d))
          (cond
            ((< (-> quat w) 0.0)
             (.lvf vf1 (&-> spr-out qx-qy-qz-sy quad))
             (.lvf vf2 (&-> quat quad))
             (.sub.vf.xyz vf1 vf0 vf2)
             (.svf (&-> spr-out qx-qy-qz-sy quad) vf1)
             (.mov dummy0 vf1))
            (else
             (.lvf vf1 (&-> spr-out qx-qy-qz-sy quad))
             (.lvf vf2 (&-> quat quad))
             (.add.vf.xyz vf1 vf0 vf2)
             (.svf (&-> spr-out qx-qy-qz-sy quad) vf1)
             (.mov dummy1 vf1)))))
      (set! (-> sprite3d r-g-b-a x) (-> parent sprite r))
      (set! (-> sprite3d r-g-b-a y) (-> parent sprite g))
      (set! (-> sprite3d r-g-b-a z) (-> parent sprite b)))
    0
    (none)))

;; flips between two mirrored conerot variants in birth-func-copy2-rot-color (incremented each call).
(define *global-toggle* 0)

(defun birth-func-copy2-rot-color ((sys sparticle-system)
        (cpuinfo sparticle-cpuinfo)
        (sprite3d sprite-vec-data-3d)
        (launcher sparticle-launcher)
        (launch-state sparticle-launch-state))
  "Birth callback: like birth-func-copy-rot-color, but builds the rotation from euler angles
   (y = the parent sprite's rot, z = +/-90deg offset by the parent's scale-x) instead of
   composing quaternions. *global-toggle* alternates the sign of the z angle every call,
   producing mirrored pairs of particles."
  (local-vars (dummy0 float) (dummy1 float))
  (rlet ((vf0 :class vf)
         (vf1 :class vf)
         (vf2 :class vf))
    (init-vf0-vector)
    (let ((parent (-> launch-state sprite)))
      (let ((quat (new 'stack-no-clear 'vector)))
        (let* ((spr sprite3d)
               (qx (-> spr qx-qy-qz-sy x))
               (qy (-> spr qx-qy-qz-sy y))
               (qz (-> spr qx-qy-qz-sy z)))
          (set-vector! quat qx qy qz (sqrtf (- (- (- 1.0 (square qz)) (square qy)) (square qx)))))
        (let ((euler (new-stack-vector0)))
          (set! (-> euler y) (-> parent sprite rot))
          (set! (-> euler z)
                (if (logtest? *global-toggle* 1)
                    (unwrap-angle (- 16384.0 (-> parent sprite sx)))
                    (unwrap-angle (+ 16384.0 (-> parent sprite sx)))))
          (quaternion-zxy! (the-as quaternion quat) euler))
        (let ((spr-out sprite3d))
          (cond
            ((< (-> quat w) 0.0)
             (.lvf vf1 (&-> spr-out qx-qy-qz-sy quad))
             (.lvf vf2 (&-> quat quad))
             (.sub.vf.xyz vf1 vf0 vf2)
             (.svf (&-> spr-out qx-qy-qz-sy quad) vf1)
             (.mov dummy0 vf1))
            (else
             (.lvf vf1 (&-> spr-out qx-qy-qz-sy quad))
             (.lvf vf2 (&-> quat quad))
             (.add.vf.xyz vf1 vf0 vf2)
             (.svf (&-> spr-out qx-qy-qz-sy quad) vf1)
             (.mov dummy1 vf1)))))
      (set! (-> sprite3d r-g-b-a x) (-> parent sprite r))
      (set! (-> sprite3d r-g-b-a y) (-> parent sprite g))
      (set! (-> sprite3d r-g-b-a z) (-> parent sprite b)))
    (set! *global-toggle* (+ *global-toggle* 1))
    0
    (none)))

(defun birth-func-copy-omega-to-z ((sys sparticle-system)
        (cpuinfo sparticle-cpuinfo)
        (sprite3d sprite-vec-data-3d)
        (launcher sparticle-launcher)
        (launch-state sparticle-launch-state))
  "Birth callback: seed the new particle's z-rotation from omega and its initial scale from
   the launch-state's next-time."
  ;; -16384.0 is -90 degrees in the 65536-units-per-revolution fixed-point angle convention.
  (set! (-> sprite3d qx-qy-qz-sy z) (+ -16384.0 (-> cpuinfo omega)))
  (set! (-> cpuinfo next-time) (-> launch-state sprite next-time))
  ;; Convert the parent's countdown to the scale value used by this effect.
  (set! (-> sprite3d x-y-z-sx w) (* 163.85638 (the float (-> launch-state sprite next-time))))
  0
  (none))

(defun birth-func-random-next-time ((sys sparticle-system)
        (cpuinfo sparticle-cpuinfo)
        (sprite3d sprite-vec-data-3d)
        (launcher sparticle-launcher)
        (launch-state sparticle-launch-state))
  "Birth callback: randomize the new particle's relaunch countdown (next-time) uniformly in
   [0, user-float) ticks, de-synchronizing particles that share a launcher chain."
  (set! (-> cpuinfo next-time) (the-as uint (the int (rand-vu-float-range 0.0 (-> cpuinfo user-float)))))
  0
  (none))

                        (set! main-flags (logior main-flags 32))
                        (set! q-lo-tmpl (-> fw large-font-lo-tmpl-qw))
                        (b! #t main-next-character :delay (set! q-hi-tmpl (-> fw large-font-hi-tmpl-qw)))
                        (label main-set-color)
                        (set! (-> fw last-color-32) arg-value)
                        (.sll color-byte-offset-2 arg-value 4)
                        (let ((cur-color-0 (-> fw current-verts color 0 quad))
                              (color-cursor (the-as object (+ color-byte-offset-2 (the-as int fw)))))
                          (let ((cur-color-1 (-> fw current-verts color 1 quad)))
                            (set! (-> fw src-verts color 0 quad) cur-color-0)
                            (set! (-> fw src-verts color 1 quad) cur-color-1))
                          (let ((cur-color-2 (-> fw current-verts color 2 quad)))
                            (let ((cur-color-3 (-> fw current-verts color 3 quad)))
                              (set! (-> fw src-verts color 2 quad) cur-color-2)
                              (set! (-> fw src-verts color 3 quad) cur-color-3)))
                          (let ((packed-color-0 (the-as uint128 (-> (the-as font-work color-cursor) color-table 0 color 0))))
                            (let ((packed-color-1 (the-as uint128 (-> (the-as font-work color-cursor) color-table 0 color 1))))
                              (.pextlb wide-color-0t r0 packed-color-0)
                              (.pextlh wide-color-0 r0 wide-color-0t)
                              (.pextlb wide-color-1t r0 packed-color-1)))
                          (set! (-> fw current-verts color 0 quad) (the-as uint128 wide-color-0))
                          (.pextlh wide-color-1 r0 wide-color-1t)
                          (set! (-> fw dest-verts color 0 quad) (the-as uint128 wide-color-0))
                          (set! (-> fw current-verts color 1 quad) (the-as uint128 wide-color-1))
                          (set! (-> fw dest-verts color 1 quad) (the-as uint128 wide-color-1))
                          (let ((packed-color-2 (the-as uint128 (-> (the-as font-work color-cursor) color-table 0 color 2))))
                            (let ((packed-color-3 (the-as uint128 (-> (the-as font-work color-cursor) color-table 0 color 3))))
                              (.pextlb wide-color-2t r0 packed-color-2)
                              (.pextlh wide-color-2 r0 wide-color-2t)
                              (.pextlb wide-color-3t r0 packed-color-3))))
                        (set! (-> fw current-verts color 2 quad) (the-as uint128 wide-color-2))
                        (.pextlh wide-color-3 r0 wide-color-3t)
                        (set! (-> fw dest-verts color 2 quad) (the-as uint128 wide-color-2))
                        (set! (-> fw current-verts color 3 quad) (the-as uint128 wide-color-3))
                        (b! #t main-next-character :delay (set! (-> fw dest-verts color 3 quad) (the-as uint128 (the-as int wide-color-3))))
                        (label main-set-kerning)
                        (let ((not-kerning-mask -3))
                          (b! (zero? arg-value) main-next-character :delay (set! main-flags (logand main-flags not-kerning-mask))))
                        (b! #t main-next-character :delay (set! main-flags (logior main-flags 2)))
                        (label main-horizontal-offset)
                        (.mov corner0 arg-value)
                        (let ((minus-test (+ sign-char-6 -45)))
                          (b! (zero? sign-char-6) main-set-horizontal-offset :delay (.itof.vf corner0 corner0))
                          (b! (zero? minus-test) main-subtract-horizontal-offset))
                        (b! #t main-next-character :delay (.add.x.vf.x cursor cursor corner0))
                        (label main-subtract-horizontal-offset)
                        (b! #t main-next-character :delay (.sub.x.vf.x cursor cursor corner0))
                        (label main-set-horizontal-offset)
                        (b! #t main-next-character :delay (.add.x.vf.x cursor vf0 corner0))
                        (label main-vertical-offset)
                        (.mov corner0 arg-value))
                      (let ((minus-test (+ sign-char-6 -45)))
                        (b! (zero? sign-char-6) main-set-vertical-offset :delay (.itof.vf corner0 corner0))
                        (b! (zero? minus-test) main-subtract-vertical-offset))
                      (b! #t main-next-character :delay (.add.x.vf.y cursor cursor corner0))
                      (label main-subtract-vertical-offset)
                      (b! #t main-next-character :delay (.sub.x.vf.y cursor cursor corner0))
                      (label main-set-vertical-offset)
                      (b! #t main-next-character :delay (.add.x.vf.y cursor vf0 corner0))
                      (label main-save-style)
                      (let ((saved-color-index (-> fw last-color-32)))
                        (.lvf color0 (&-> fw current-verts color 0 quad))
                        (.lvf color1 (&-> fw current-verts color 1 quad))
                        (.lvf color2 (&-> fw current-verts color 2 quad))
                        (.lvf color3 (&-> fw current-verts color 3 quad))
                        (set! (-> fw save-last-color-32) saved-color-index))
                      (.svf (&-> fw save-color 0 quad) color0)
                      (.svf (&-> fw save-color 1 quad) color1)
                      (.svf (&-> fw save-color 2 quad) color2)
                      (.svf (&-> fw save-color 3 quad) color3)
                      (b! #t main-next-character :delay (.svf (&-> fw save quad) cursor))
                      (label main-restore-style)
                      (let ((restored-color-index (-> fw save-last-color-32)))
                        (.lvf color0 (&-> fw save-color 0 quad))
                        (.lvf color1 (&-> fw save-color 1 quad))
                        (.lvf color2 (&-> fw save-color 2 quad))
                        (.lvf color3 (&-> fw save-color 3 quad))
                        (set! (-> fw last-color-32) restored-color-index))
                      (.svf (&-> fw current-verts color 0 quad) color0)
                      (.svf (&-> fw dest-verts color 0 quad) color0)
                      (.svf (&-> fw current-verts color 1 quad) color1)
                      (.svf (&-> fw dest-verts color 1 quad) color1)
                      (.svf (&-> fw current-verts color 2 quad) color2)
                      (.svf (&-> fw dest-verts color 2 quad) color2)
                      (.svf (&-> fw current-verts color 3 quad) color3)
                      (.svf (&-> fw dest-verts color 3 quad) color3)
                      (b! #t main-next-character :delay (.lvf cursor (&-> fw save quad)))
                      (label main-extended-character)
                      (set! char (-> str-cursor 4))
                      (set! str-cursor (&-> str-cursor 1))
                      (.add.vf.xyz corner3 cursor size3)
                      (let ((extended-code (logand char 127)))
                        (.sub.vf corner0 limits cursor)
                        (let ((extended-index (+ extended-code 255))) (b! #t emit-main-glyph :delay (.sll glyph-offset-3 extended-index 4))))
                      (label main-character)
                      (.add.vf.xyz corner3 cursor size3)
                      (.sll glyph-offset-3 char 4)
                      (.sub.vf corner0 limits cursor)
                      (b! (= char 10) main-line-break :delay (set! newline-test-3 (+ char -13)))
                      (b! (nonzero? newline-test-3) emit-main-glyph)
                      (label main-line-break)
                      (set! justify-cursor (&-> (the-as (pointer uint64) justify-cursor) 2))
                      (b! #t main-next-character :delay (.lvf cursor (+ (the-as int justify-cursor) 944)))
                      (label emit-main-glyph)
                      (.addu glyph-addr-3 glyph-offset-3 glyph-table)
                      (.lvf st0 (+ glyph-addr-3 -256))
                      (.mov space-left-bits-3 corner0)
                      (b! (< (the-as int space-left-bits-3) 0) draw-finish :delay (.add.vf.xyz st1 st0 size-st1))
                      (.sra space-left-sign-3 space-left-bits-3 31)
                      (.add.vf.xyz st2 st0 size-st2)
                      (b! (< space-left-sign-3 0) main-next-character :delay (.add.vf.xyz st3 st0 size-st3))
                      (.add.vf.xyz corner0 cursor vf0)
                      (.add.vf.xyz corner1 cursor size1)
                      (.add.vf.xyz corner2 cursor size2)
                      (.svf (&-> fw current-verts tex-st 0 quad) st0)
                      (.add.vf.xyz corner3 cursor size3)
                      (.svf (&-> fw current-verts tex-st 1 quad) st1)
                      (.mul.vf advance st0 size1)
                      (.svf (&-> fw current-verts tex-st 2 quad) st2)
                      (.svf (&-> fw current-verts tex-st 3 quad) st3)
                      (.svf (&-> fw current-verts pos 0 quad) corner0)
                      (.svf (&-> fw current-verts pos 1 quad) corner1)
                      (.svf (&-> fw current-verts pos 2 quad) corner2)
                      (.svf (&-> fw current-verts pos 3 quad) corner3)
                      (.lvf corner0 (&-> fw current-verts pos 0 quad))
                      (.lvf corner1 (&-> fw current-verts pos 1 quad))
                      (.mul.w.vf acc mat-row3 vf0)
                      (.lvf corner2 (&-> fw current-verts pos 2 quad))
                      (.add.mul.x.vf acc mat-row0 corner0 acc)
                      (.lvf corner3 (&-> fw current-verts pos 3 quad))
                      (.add.mul.y.vf acc mat-row1 corner0 acc)
                      (.add.mul.z.vf corner0 mat-row2 corner0 acc)
                      (.mul.w.vf acc mat-row3 vf0)
                      (.add.mul.x.vf acc mat-row0 corner1 acc)
                      (.add.mul.y.vf acc mat-row1 corner1 acc)
                      (.add.mul.z.vf corner1 mat-row2 corner1 acc)
                      (.mul.w.vf acc mat-row3 vf0)
                      (.add.mul.x.vf acc mat-row0 corner2 acc)
                      (.add.mul.y.vf acc mat-row1 corner2 acc)
                      (.add.mul.z.vf corner2 mat-row2 corner2 acc)
                      (.mul.w.vf acc mat-row3 vf0)
                      (.add.mul.x.vf acc mat-row0 corner3 acc)
                      (.add.mul.y.vf acc mat-row1 corner3 acc)
                      (.add.mul.z.vf corner3 mat-row2 corner3 acc)
                      (.div.vf Q limits corner0 :fsf #b10 :ftf #b11)
                      (let ((char-tmpl-lo (-> fw char-tmpl dma-vif quad)))
                        (let ((char-tmpl-hi (-> fw char-tmpl quad 1)))
                          (set! (-> (the-as (pointer uint128) dma-out) 0) char-tmpl-lo)
                          (set! (-> (the-as (pointer uint128) dma-out) 1) char-tmpl-hi)))
                      (.lvf st0 (&-> fw current-verts tex-st 0 quad))
                      (let ((glyph-tmpl q-lo-tmpl))
                        (.lvf st1 (&-> fw current-verts tex-st 1 quad))
                        (let ((wide-glyph-flag (logand char 128)))
                          (.lvf st2 (&-> fw current-verts tex-st 2 quad))
                          (.movn-128 glyph-tmpl-sel-2 q-hi-tmpl wide-glyph-flag glyph-tmpl)))))
                  (.mul.vf.xyz corner0 corner0 Q)
                  (set! (-> (the-as (pointer uint128) dma-out) 2) (the uint128 glyph-tmpl-sel-2))
                  (.mul.vf.xyz st0 st0 Q)
                  (.nop.vf)
                  (.nop.vf)
                  (.div.vf Q limits corner1 :fsf #b10 :ftf #b11)
                  (.lvf st3 (&-> fw current-verts tex-st 3 quad))
                  (.add.vf corner0 corner0 hvdf-offset)
                  (.lvf color0 (&-> fw current-verts color 0 quad))
                  (.lvf color1 (&-> fw current-verts color 1 quad))
                  (.lvf color2 (&-> fw current-verts color 2 quad))
                  (vftoi4.xyzw corner0 corner0)
                  (.mul.vf.xyz corner1 corner1 Q)
                  (.mul.vf.xyz st1 st1 Q)
                  (.svf (&-> (the-as (pointer uint128) dma-out) 3) st0)
                  (.nop.vf)
                  (.nop.vf)
                  (.div.vf Q limits corner2 :fsf #b10 :ftf #b11)
                  (.svf (&-> (the-as (pointer uint128) dma-out) 4) color0)
                  (.lvf color3 (&-> fw current-verts color 3 quad))
                  (.svf (&-> (the-as (pointer uint128) dma-out) 5) corner0)
                  (.add.vf corner1 corner1 hvdf-offset)
                  (vftoi4.xyzw corner1 corner1)
                  (.mul.vf.xyz corner2 corner2 Q)
                  (.mul.vf.xyz st2 st2 Q)
                  (.svf (&-> (the-as (pointer uint128) dma-out) 6) st1)
                  (.nop.vf)
                  (.nop.vf)
                  (.div.vf Q limits corner3 :fsf #b10 :ftf #b11)
                  (.svf (&-> (the-as (pointer uint128) dma-out) 7) color1)
                  (.svf (&-> (the-as (pointer uint128) dma-out) 8) corner1)
                  (.add.vf corner2 corner2 hvdf-offset)
                  (vftoi4.xyzw corner2 corner2)
                  (.mul.vf.xyz corner3 corner3 Q)
                  (.mul.vf.xyz st3 st3 Q)
                  (.svf (&-> (the-as (pointer uint128) dma-out) 9) st2)
                  (.svf (&-> (the-as (pointer uint128) dma-out) 10) color2)
                  (.add.vf corner3 corner3 hvdf-offset)
                  ;;(s.vf! (+ dma-out 176) vf3)
                  (.svf (+ (the-as int dma-out) 176) corner2)
                  (let ((kerning-flag (logand main-flags 2))) (b! (zero? kerning-flag) main-advance-fixed))))))
          (b! #t finish-main-glyph :delay (.add.w.vf.x cursor cursor advance))
          (label main-advance-fixed)
          (.add.w.vf.x cursor cursor size2)
          (label finish-main-glyph)
          (vftoi4.xyzw corner3 corner3)
          ;;(s.vf! (+ dma-out 192) vf8)
          (.svf (+ (the-as int dma-out) 192) st3)
          ;;(s.vf! (+ dma-out 208) vf12)
          (.svf (+ (the-as int dma-out) 208) color3)
          ;;(s.vf! (+ dma-out 224) vf4)
          (.svf (+ (the-as int dma-out) 224) corner3)
          (b! #t main-next-character :delay (set! dma-out (&+ dma-out 240)))
          (label draw-finish)
          (let ((out-buf (-> fw buf)))
            ;;(s.w! (+ v1-6 4) dma-out)
            (set! (-> (the-as (pointer pointer) out-buf) 1) dma-out))))
      (.lvf origin (&-> ctxt origin quad))
      (.sub.vf cursor cursor origin)
      (.mov advance-x cursor)
      advance-x)))

(defun draw-string-adv ((str string) (buf dma-buffer) (ctxt font-context))
  "Draw str into buf with ctxt, then advance ctxt's origin x by the returned width."
  (+! (-> ctxt origin x) (draw-string str buf ctxt))
  (none))

(#when PC_PORT
  (defun get-string-length ((str string) (ctxt font-context))
    "Interpret str with ctxt's size, alignment, and kerning settings without drawing, and return the
   horizontal displacement from the starting origin. This must parse commands exactly the way
   draw-string's layout pass does, or measured and drawn text disagree."
    (local-vars (advance-x float))
    (rlet ((vf0 :class vf)
           (temp-vf :class vf) ;; the display scale during setup, then the itof'd command argument
           (size1 :class vf)
           (size2 :class vf)
           (advance :class vf)
           (cursor :class vf)
           (origin :class vf)
           (limits :class vf)
           (glyph :class vf))
      (init-vf0-vector)
      (.lvf limits (&-> ctxt context-vec quad))
      (.lvf cursor (&-> ctxt origin quad))
      (.lvf origin (&-> ctxt origin quad))
      (let ((flags (-> ctxt flags))
            (work *font-work*))
        (.lvf temp-vf (&-> *video-parms* relative-x-scale-reciprical))
        (.mul.vf.xy limits limits temp-vf)
        (.mul.vf.xy cursor cursor temp-vf)
        ;; hack! fixes small font widescreen
        (unless (logtest? (-> ctxt flags) (font-flags pc-hack))
          (.mul.vf.xy origin origin temp-vf))
        (set! (-> work str-ptr) (the-as uint str))
        (set! (-> work flags) flags)
        (.mov.vf temp-vf vf0)
        (let ((glyph-table (cond
                             ((logtest? flags (font-flags large))
                              (.lvf size1 (&-> work size1-large quad))
                              (.lvf size2 (&-> work size2-large quad))
                              *font24-table*)
                             (else (.lvf size1 (&-> work size1-small quad)) (.lvf size2 (&-> work size2-small quad)) *font12-table*))))
          (label next-character)
          (let ((cur-char (-> str data 0)))
            (set! str (the-as string (&-> (the-as (pointer uint8) str) 1)))
            (if (zero? cur-char) (goto finish))
            (when (= cur-char 1)
              (let ((extended-code (-> str data 0)))
                (set! str (the-as string (&-> (the-as (pointer uint8) str) 1)))
                (set! cur-char (+ (logand extended-code 127) 255))
                (goto measure-glyph)))
            (when (= cur-char #\~)
              (set! cur-char (-> str data 0))
              (set! str (the-as string (&-> (the-as (pointer uint8) str) 1)))
              (if (zero? cur-char) (goto finish))
              (when (or (= cur-char #\Y) (= cur-char #\y))
                (.svf (&-> work save quad) cursor)
                (goto next-character))
              (when (or (= cur-char #\Z) (= cur-char #\z))
                (.lvf cursor (&-> work save quad))
                (goto next-character))
              (let ((sign-char (if (or (= cur-char #\-) (= cur-char #\+)) cur-char 0))
                    (arg-val 0))
                (when (or (nonzero? sign-char) (and (>= cur-char #\0) (<= cur-char #\9)))
                  (label format-digits)
                  (set! cur-char (-> str data 0))
                  (set! str (the-as string (&-> (the-as (pointer uint8) str) 1)))
                  (if (zero? cur-char) (goto finish))
                  (case cur-char
                    ((#\n #\N)
                     (cond
                       ((nonzero? arg-val)
                        (.lvf size1 (&-> work size1-large quad))
                        (.lvf size2 (&-> work size2-large quad))
                        (set! glyph-table *font24-table*)
                        (logior! flags (font-flags large)))
                       (else
                        (.lvf size1 (&-> work size1-small quad))
                        (.lvf size2 (&-> work size2-small quad))
                        (set! glyph-table *font12-table*)
                        (logclear! flags (font-flags large))))
                     (goto next-character))
                    ((#\l #\L #\w #\W #\j #\J #\v #\V) (goto next-character))
                    ((#\k #\K)
                     (if (zero? arg-val) (logclear! flags (font-flags kerning)) (logior! flags (font-flags kerning)))
                     (goto next-character))
                    ((#\h #\H)
                     (.mov temp-vf arg-val)
                     (.itof.vf temp-vf temp-vf)
                     (cond
                       ((zero? sign-char) (.add.x.vf.x cursor vf0 temp-vf))
                       ((= sign-char #\-) (.sub.x.vf.x cursor cursor temp-vf))
                       (else (.add.x.vf.x cursor cursor temp-vf)))
                     (goto next-character)))
                  (when (and (>= cur-char #\0) (<= cur-char #\9))
                    (set! arg-val (+ (* arg-val 10) (- cur-char #\0)))
                    (goto format-digits)))))
            (cond
              ((and (!= cur-char 10) (!= cur-char 13))
               (label measure-glyph)
               (.lvf glyph (&-> glyph-table (- cur-char 16) quad))
               (.mul.vf advance glyph size1)
               (if (logtest? flags (font-flags kerning)) (.add.w.vf.x cursor cursor advance) (.add.w.vf.x cursor cursor size2)))
              (else (.add.x.vf.x cursor vf0 origin)))
            (goto next-character))))
      (label finish)
      (.sub.vf cursor cursor origin)
      (.mov advance-x cursor)
      advance-x)))

(defun draw-string-xy ((str string) (buf dma-buffer) (x int) (y int) (color font-color) (flags font-flags))
  "Draw str at x,y with a temporary context initialized from the default font matrix, color, and
   flags, append its glyph packets to buf, and return the horizontal advance."
  (let ((ctxt (new 'stack 'font-context *font-default-matrix* x y 0.0 color flags))) (draw-string str buf ctxt)))

(#when PC_PORT
  ;; Scale font globals around one draw so PC UI code can size text independently.
  (defun draw-string-xy-scaled ((str string) (buf dma-buffer) (x int) (y int) (color font-color) (flags font-flags) (scale float))
    "Draw str at x,y with color and flags, temporarily scale the font matrix and video parameters by
   scale, and restore all shared values afterward."
    (let* ((font-ctxt (new 'stack 'font-context *font-default-matrix* x y 0.0 color flags))
           (scaled-width (* (-> font-ctxt width) scale))
           (scaled-height (* (-> font-ctxt height) scale))
           (orig-mat-x-scale (-> font-ctxt mat vector 0 x))
           (orig-mat-y-scale (-> font-ctxt mat vector 1 y))
           (orig-vid-parms-x-scale (-> *video-parms* relative-x-scale))
           (orig-vid-parms-y-scale (-> *video-parms* relative-y-scale)))
      ;; scaling globals *font-default-matrix*, *video-parms* (based on print-game-text scaling)
      (*! (-> *font-default-matrix* vector 0 x) scale)
      (*! (-> *font-default-matrix* vector 1 y) scale)
      (*! (-> *video-parms* relative-x-scale) scale)
      (*! (-> *video-parms* relative-y-scale) scale)
      (set! (-> *video-parms* relative-x-scale-reciprical) (/ 1.0 (-> *video-parms* relative-x-scale)))
      (set! (-> *video-parms* relative-y-scale-reciprical) (/ 1.0 (-> *video-parms* relative-y-scale)))
      (draw-string str buf font-ctxt)
      ;; un-scaling globals *font-default-matrix*, *video-params*
      (set! (-> *font-default-matrix* vector 0 x) orig-mat-x-scale)
      (set! (-> *font-default-matrix* vector 1 y) orig-mat-y-scale)
      (set! (-> *video-parms* relative-x-scale) orig-vid-parms-x-scale)
      (set! (-> *video-parms* relative-y-scale) orig-vid-parms-y-scale)
      (set! (-> *video-parms* relative-x-scale-reciprical) (/ 1.0 (-> *video-parms* relative-x-scale)))
      (set! (-> *video-parms* relative-y-scale-reciprical) (/ 1.0 (-> *video-parms* relative-y-scale))))
    (none)))

(#when PC_PORT
  (defun draw-string ((str string) (buf dma-buffer) (ctxt font-context))
    "Draw str with ctxt's transform, origin, colors, size, alignment, shadow, and kerning settings.
   Interpret embedded font commands while appending glyph packets to buf and return the horizontal
   displacement from the starting origin."
    (local-vars
      (r0 uint128)
      (advance-x float)
      (justify-mode-1 int)
      (small-table-1 (inline-array vector))
      (small-table-2 (inline-array vector))
      (small-table-3 (inline-array vector))
      (not-large-mask int)
      (q-hi-tmpl uint128)
      (color-byte-offset-1 int)
      (q-verts-2t uint128)
      (q-verts-2 uint128)
      (q-verts-3t uint128)
      (q-verts-3 uint128)
      (digit-times-ten-1 int)
      (newline-test-1 uint)
      (justify-mode-2 int)
      (glyph-addr-1 int)
      (space-left-bits-1 int)
      (space-left-sign-1 int)
      (digit-times-ten-2 int)
      (digit-times-ten-3 int)
      (color-byte-offset-2 int)
      (wide-color-3t uint128)
      (wide-color-3 uint128)
      (q-verts-1t uint128)
      (q-verts-1 uint128)
      (extended-test-1 uint)
      (tilde-test-1 uint)
      (sign-char-1 int)
      (sign-char-2 int)
      (glyph-offset-1 int)
      (extended-test-2 uint)
      (tilde-test-2 uint)
      (sign-char-3 int)
      (sign-char-4 int)
      (glyph-offset-2 int)
      (glyph-addr-2 int)
      (space-left-bits-2 int)
      (space-left-sign-2 int)
      (glyph-tmpl-sel-1 uint128)
      (extended-test-3 uint)
      (tilde-test-3 uint)
      (sign-char-5 int)
      (sign-char-6 int)
      (wide-color-1t uint128)
      (wide-color-1 uint128)
      (wide-color-2t uint128)
      (wide-color-2 uint128)
      (glyph-offset-3 int)
      (glyph-addr-3 int)
      (space-left-bits-3 int)
      (space-left-sign-3 int)
      (glyph-tmpl-sel-2 uint128)
      (q-verts-0t uint128)
      (q-verts-0 uint128)
      (char-test-3-1 uint)
      (char-test-4-1 uint)
      (char-test-5-1 uint)
      (char-test-6-1 uint)
      (char-test-7-1 uint)
      (char-test-10-1 uint)
      (char-test-11-1 uint)
      (char-test-12-1 uint)
      (char-test-13-1 uint)
      (char-test-14-1 uint)
      (newline-test-2 uint)
      (char-test-20-1 uint)
      (char-test-21-1 uint)
      (char-test-22-1 uint)
      (char-test-23-1 uint)
      (char-test-24-1 uint)
      (wide-color-0t uint128)
      (wide-color-0 uint128)
      (newline-test-3 uint)
      (char-test-0 uint)
      (char-test-2 uint)
      (char-test-3-2 uint)
      (char-test-4-2 uint)
      (char-test-5-2 uint)
      (char-test-6-2 uint)
      (char-test-7-2 uint)
      (char-test-8 uint)
      (char-test-9 uint)
      (char-test-10-2 uint)
      (char-test-11-2 uint)
      (char-test-12-2 uint)
      (char-test-13-2 uint)
      (char-test-14-2 uint)
      (char-test-15 uint)
      (char-test-16 uint)
      (char-test-17 uint)
      (char-test-18 uint)
      (char-test-20-2 uint)
      (char-test-21-2 uint)
      (char-test-22-2 uint)
      (char-test-23-2 uint)
      (char-test-24-2 uint)
      (char-test-25 uint)
      (char-test-26 uint)
      (char-test-27 uint)
      (char-test-28 uint)
      (char-test-29 uint)
      (char-test-30 uint)
      (char-test-31 uint)
      (char-test-32 uint)
      (char-test-33 uint)
      (char-test-34 uint)
      (char-test-35 uint)
      (char-test-36 uint)
      (char-test-38 uint)
      (char-test-39 uint)
      (char-test-40 uint)
      (char-test-41 uint)
      (char-test-42 uint)
      (char-test-43 uint)
      (char-test-44 uint)
      (char-test-45 uint)
      (char-test-46 uint)
      (char-test-47 uint)
      (char-test-48 uint)
      (char-test-49 uint)
      (char-test-50 uint)
      (char-test-51 uint)
      (char-test-52 uint)
      (char-test-53 uint)
      (digit-temp-0 uint)
      (digit-times-four-1 int)
      (digit-temp-2 uint)
      (digit-times-four-2 int)
      (digit-temp-4 uint)
      (digit-times-four-3 int))
    (set! r0 (the-as uint128 0))
    (rlet ((acc :class vf)
           (Q :class vf)
           (vf0 :class vf)
           (corner0 :class vf)
           (color1 :class vf)
           (color2 :class vf)
           (color3 :class vf)
           (size1 :class vf)
           (size2 :class vf)
           (size3 :class vf)
           (size-st1 :class vf)
           (size-st2 :class vf)
           (size-st3 :class vf)
           (advance :class vf)
           (corner1 :class vf)
           (cursor :class vf)
           (origin :class vf)
           (limits :class vf)
           (shadow-offset :class vf)
           (hvdf-offset :class vf)
           (mat-row0 :class vf)
           (mat-row1 :class vf)
           (corner2 :class vf)
           (mat-row2 :class vf)
           (mat-row3 :class vf)
           (corner3 :class vf)
           (st0 :class vf)
           (st1 :class vf)
           (st2 :class vf)
           (st3 :class vf)
           (color0 :class vf))
      (init-vf0-vector)
      (let ((camera *math-camera*))
        (.lvf shadow-offset (&-> camera hvdf-off quad))
        (.lvf hvdf-offset (&-> camera hvdf-off quad)))
      ;; og:preserve-this PC port modification: adjust shadow x to account for widescreen
      (let ((shadow-x 2.)
            (shadow-y 1.)
            (correction (-> *video-parms* relative-x-scale))
            (temp-vec (new-stack-vector0)))
        (set! (-> temp-vec quad) (-> *math-camera* hvdf-off quad))
        (+! (-> temp-vec x) (* correction shadow-x))
        (+! (-> temp-vec y) shadow-y)
        (.lvf shadow-offset (&-> temp-vec quad)))
      ;; original version
      ; (.add.w.vf.xy shadow-offset shadow-offset vf0)
      ; (.add.w.vf.x shadow-offset shadow-offset vf0)
      (let ((mat (-> ctxt mat)))
        (.lvf limits (&-> ctxt context-vec quad))
        (.lvf cursor (&-> ctxt origin quad))
        (.lvf origin (&-> ctxt origin quad))
        (.lvf mat-row0 (&-> mat vector 0 quad))
        (.lvf mat-row1 (&-> mat vector 1 quad))
        (.lvf mat-row2 (&-> mat vector 2 quad))
        (.lvf mat-row3 (&-> mat vector 3 quad)))
      (let ((video-parms *video-parms*)) (.lvf corner0 (+ (the-as int video-parms) 64)))
      (.mul.vf.xy limits limits corner0)
      (.mul.vf.xy cursor cursor corner0)
      ;; hack! fixes small font widescreen
      (unless (logtest? (-> ctxt flags) (font-flags pc-hack))
        (.mul.vf.xy origin origin corner0))
      (let ((fw *font-work*))
        (set! (-> fw buf) buf)
        (let ((dma-out (-> buf base)))
          (set! (-> fw str-ptr) (the-as uint str))
          (let ((layout-flags (-> ctxt flags-signed)))
            (.mov.vf corner0 vf0)
            (.mov.vf corner1 vf0)
            (.mov.vf corner2 vf0)
            (.mov.vf corner3 vf0)
            (set! (-> fw flags) (the-as font-flags layout-flags))
            (.lvf size-st1 (&-> fw size-st1 quad))
            (.lvf size-st2 (&-> fw size-st2 quad))
            (.lvf size-st3 (&-> fw size-st3 quad))
            (let ((large-flag (logand layout-flags 32)))
              (b! (nonzero? large-flag) draw-use-large-font :delay (set! small-table-1 *font12-table*)))
            (let ((glyph-table small-table-1))
              (.lvf size1 (&-> fw size1-small quad))
              (.lvf size2 (&-> fw size2-small quad))
              (.lvf size3 (&-> fw size3-small quad))
              (let ((q-lo-tmpl (-> fw small-font-lo-tmpl-qw)))
                (b! #t prepare-font-colors :delay (set! q-hi-tmpl (-> fw small-font-hi-tmpl-qw)))
                (label draw-use-large-font)
                (set! glyph-table *font24-table*)
                (.lvf size1 (&-> fw size1-large quad))
                (.lvf size2 (&-> fw size2-large quad))
                (.lvf size3 (&-> fw size3-large quad))
                (set! q-lo-tmpl (-> fw large-font-lo-tmpl-qw))
                (set! q-hi-tmpl (-> fw large-font-hi-tmpl-qw))
                (label prepare-font-colors)
                (let ((color-index (-> ctxt color-s32)))
                  (set! (-> fw last-color-32) color-index)
                  (.sll color-byte-offset-1 color-index 4))
                ;; The color table is four packed RGBA bytes per entry but the GS wants one 32-bit
                ;; component per lane, so each word is widened in two steps: pextlb spreads the four
                ;; bytes into halfwords against zero, pextlh spreads those into words. The pairs are
                ;; interleaved so a load is always in flight while the previous one widens.
                (let ((fw+col (the-as object (+ color-byte-offset-1 (the-as int fw)))))
                  (let ((q-verts-0p (the-as uint128 (-> (the-as font-work fw+col) color-table 0 color 0))))
                    (let ((q-verts-1p (the-as uint128 (-> (the-as font-work fw+col) color-table 0 color 1))))
                      (.pextlb q-verts-0t r0 q-verts-0p)
                      (let ((q-verts-2p (the-as uint128 (-> (the-as font-work fw+col) color-table 0 color 2))))
                        (.pextlh q-verts-0 r0 q-verts-0t)
                        (let ((q-verts-3p (the-as uint128 (-> (the-as font-work fw+col) color-table 0 color 3))))
                          (.pextlb q-verts-1t r0 q-verts-1p)
                          (set! (-> fw current-verts color 0 quad) (the-as uint128 q-verts-0))
                          (.pextlh q-verts-1 r0 q-verts-1t)
                          (set! (-> fw dest-verts color 0 quad) (the-as uint128 q-verts-0))
                          (.pextlb q-verts-2t r0 q-verts-2p)
                          (set! (-> fw current-verts color 1 quad) (the-as uint128 q-verts-1))
                          (.pextlh q-verts-2 r0 q-verts-2t)
                          (set! (-> fw dest-verts color 1 quad) (the-as uint128 q-verts-1))
                          (.pextlb q-verts-3t r0 q-verts-3p))))))
                (set! (-> fw current-verts color 2 quad) (the-as uint128 q-verts-2))
                (.pextlh q-verts-3 r0 q-verts-3t)
                (set! (-> fw dest-verts color 2 quad) (the-as uint128 q-verts-2))
                (set! (-> fw current-verts color 3 quad) (the-as uint128 q-verts-3))
                (set! (-> fw dest-verts color 3 quad) (the-as uint128 q-verts-3))
                (let ((justify-cursor (the-as object fw)))
                  (label layout-next-character)
                  (let ((char (-> (the-as (pointer uint8) str) 4)))
                    (set! str (the-as string (&-> (the-as (pointer uint8) str) 1)))
                    (b! (zero? char) layout-finish :delay (set! extended-test-1 (+ char -1)))
                    (b! (zero? extended-test-1) layout-extended-character :delay (set! tilde-test-1 (+ char -126)))
                    (b! (nonzero? tilde-test-1) layout-character)
                    (set! char (-> (the-as (pointer uint8) str) 4))
                    (set! str (the-as string (&-> (the-as (pointer uint8) str) 1)))
                    (let ((sign-char 0)
                          (arg-value 0))
                      (b! (zero? char) layout-finish :delay (set! char-test-0 (+ char -43)))
                      (.movz sign-char-1 char char-test-0 sign-char)
                      (let ((char-test-1 (+ char -45))) (.movz sign-char-2 char char-test-1 sign-char-1))
                      (b! (nonzero? sign-char-2) layout-format-digits :delay (set! char-test-2 (+ char -121)))
                      (b! (zero? char-test-2) layout-save-position :delay (set! char-test-3-1 (+ char -89)))
                      (b! (zero? char-test-3-1) layout-save-position :delay (set! char-test-4-1 (+ char -122)))
                      (b! (zero? char-test-4-1) layout-restore-position :delay (set! char-test-5-1 (+ char -90)))
                      (b! (zero? char-test-5-1) layout-restore-position :delay (set! char-test-6-1 (+ char -48)))
                      (b! (< (the-as int char-test-6-1) 0) layout-character :delay (set! char-test-7-1 (+ char -57)))
                      (b! (> (the-as int char-test-7-1) 0) layout-character :delay (set! arg-value (the-as int (+ char -48))))
                      (label layout-format-digits)
                      (set! char (-> (the-as (pointer uint8) str) 4))
                      (set! str (the-as string (&-> (the-as (pointer uint8) str) 1)))
                      (b! (zero? char) layout-finish :delay (set! char-test-3-2 (+ char -110)))
                      (b! (zero? char-test-3-2) layout-use-small-font :delay (set! char-test-4-2 (+ char -78)))
                      (b! (zero? char-test-4-2) layout-use-small-font :delay (set! char-test-5-2 (+ char -108)))
                      (b! (zero? char-test-5-2) layout-next-character :delay (set! char-test-6-2 (+ char -76)))
                      (b! (zero? char-test-6-2) layout-next-character :delay (set! char-test-7-2 (+ char -119)))
                      (b! (zero? char-test-7-2) layout-next-character :delay (set! char-test-8 (+ char -87)))
                      (b! (zero? char-test-8) layout-next-character :delay (set! char-test-9 (+ char -107)))
                      (b! (zero? char-test-9) layout-set-kerning :delay (set! char-test-10-2 (+ char -75)))
                      (b! (zero? char-test-10-2) layout-set-kerning :delay (set! char-test-11-2 (+ char -106)))
                      (b! (zero? char-test-11-2) layout-set-justification :delay (set! char-test-12-2 (+ char -74)))
                      (b! (zero? char-test-12-2) layout-set-justification :delay (set! char-test-13-2 (+ char -104)))
                      (b! (zero? char-test-13-2) layout-horizontal-offset :delay (set! char-test-14-2 (+ char -72)))
                      (b! (zero? char-test-14-2) layout-horizontal-offset :delay (set! char-test-15 (+ char -118)))
                      (b! (zero? char-test-15) layout-vertical-offset :delay (set! char-test-16 (+ char -86)))
                      (b! (zero? char-test-16) layout-vertical-offset :delay (set! char-test-17 (+ char -48)))
                      (b! (< (the-as int char-test-17) 0) layout-character :delay (set! digit-temp-0 (+ char -57)))
                      (b! (> (the-as int digit-temp-0) 0) layout-character :delay (.sll digit-times-four-1 arg-value 2))
                      (let ((digit-times-five (+ arg-value digit-times-four-1))) (.sll digit-times-ten-1 digit-times-five 1))
                      (b! #t layout-format-digits :delay (set! arg-value (+ digit-times-ten-1 char-test-17)))
                      (label layout-use-small-font)
                      (b! (nonzero? arg-value) layout-use-large-font :delay (set! not-large-mask -33))
                      (set! glyph-table *font12-table*)
                      (.lvf size1 (&-> fw size1-small quad))
                      (.lvf size2 (&-> fw size2-small quad))
                      (.lvf size3 (&-> fw size3-small quad))
                      (set! layout-flags (logand layout-flags not-large-mask))
                      (set! q-lo-tmpl (-> fw small-font-lo-tmpl-qw))
                      (b! #t layout-next-character :delay (set! q-hi-tmpl (-> fw small-font-hi-tmpl-qw)))
                      (label layout-use-large-font)
                      (set! glyph-table *font24-table*)
                      (.lvf size1 (&-> fw size1-large quad))
                      (.lvf size2 (&-> fw size2-large quad))
                      (.lvf size3 (&-> fw size3-large quad))
                      (set! layout-flags (logior layout-flags 32))
                      (set! q-lo-tmpl (-> fw large-font-lo-tmpl-qw))
                      (b! #t layout-next-character :delay (set! q-hi-tmpl (-> fw large-font-hi-tmpl-qw)))
                      (label layout-set-kerning)
                      (let ((not-kerning-mask -3))
                        (b! (zero? arg-value) layout-next-character :delay (set! layout-flags (logand layout-flags not-kerning-mask))))
                      (b! #t layout-next-character :delay (set! layout-flags (logior layout-flags 2)))
                      (label layout-set-justification)
                      (let ((not-justify-mask -21)
                            (right-justify-test (+ arg-value -2)))
                        (b! (zero? arg-value) layout-next-character :delay (set! layout-flags (logand layout-flags not-justify-mask)))
                        (b! (zero? right-justify-test) layout-set-right-justification))
                      (b! #t layout-next-character :delay (set! layout-flags (logior layout-flags 16)))
                      (label layout-set-right-justification)
                      (b! #t layout-next-character :delay (set! layout-flags (logior layout-flags 4)))
                      (label layout-horizontal-offset)

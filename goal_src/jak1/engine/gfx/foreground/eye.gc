;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/gfx/hw/display.gc")
(require "engine/gfx/foreground/eye-h.gc")
(require "engine/ps2/vu1-macros.gc")
(require "engine/math/vector.gc")

;; note: changed for high fps

;; ------------------------------------------------------------------------------------------------
;; Eye rendering
;; ------------------------------------------------------------------------------------------------
;; Eyes are not part of a character's mesh. Every animated head reserves two texture slots and merc
;; samples them like any other material; what this file does is composite those two textures every
;; frame out of separate iris, pupil and eyelid art, so a character can look around and blink without
;; a single extra vertex or bone.
;;
;; VRAM layout
;;   All eyes share one 64x352 PSMCT32 render target at *eyes-base-page*. It is eleven 64x32 tiles
;;   stacked vertically, one per eye-control slot, and each tile holds two 32x32 textures side by
;;   side: the left eye at x 0..31 and the right eye at x 32..63. get-eye-block turns a slot and an
;;   eye index into the block address merc must put in tex0, and login-adgifs patches that into the
;;   two shaders whose art-time texture ids mark them as eye materials.
;;
;;   update-eyes installs the tile with the drawing offset at (32, 32), so every sprite coordinate in
;;   render-eyes is 32 larger than the pixel it lands on. The scissor registers take pixel
;;   coordinates, which is why the two sets of numbers never agree.
;;
;; What a tile is built from
;;   Four sprite passes per eye, reading the three shaders merc-eye-ctrl supplies:
;;     1. fill    the iris texture sampled at texel (0, 0) and stretched over the whole tile. Artists
;;                put the sclera color there, so this is a flat fill that also seeds the alpha plane.
;;     2. iris    the iris texture, centered on the eye's x/y and sized by iris-scale.
;;     3. pupil   the pupil texture, alpha blended, centered on the same point.
;;     4. lid     the eyelid texture, sliding down over the tile as lid goes from 0 to 1.
;;   The pupil pass runs with the alpha test failing always and afail RGB_ONLY, so it updates color
;;   and leaves the alpha the first two passes wrote. The lid pass draws with vertex alpha zero, which
;;   punches the rows it covers down to alpha zero; merc's blend then shows skin there, not an eye.
;;
;; Where the work is queued
;;   update-eyes runs in the foreground pass and appends to three buckets: pris-tex0, pris-tex1 and
;;   eyes. Each one sits immediately ahead of the merc bucket for the level it belongs to, so a tile
;;   is composited just before the characters that sample it are drawn. Which bucket a slot uses
;;   depends on the level its process came from; anything outside the two resident levels goes in
;;   eyes, shared by everything drawn from the common art group.
;;
;; Where the numbers come from
;;   merc-eye-anim samples the eye animation attached to the drawable's frame group. A keyframe is
;;   eight bytes of fixed point (merc-eye-anim-frame); convert-eye-data unpacks one into the two
;;   vectors of an eye, and two vector lerps blend the keyframes on either side of the current frame
;;   number straight into the eye-control slot. Blinking is separate: an eye whose lid value is
;;   negative is asking for the automatic blink, and update-eyes drives that from a per-slot countdown
;;   and a ten-sample envelope.

;; DECOMP BEGINS

;; The three DMA/GIF headers every eye sprite and adgif set copies. Their GIF tags are stored as raw
;; qwords because dma-gif-packet declares gif as plain uint64s:
;;   sprite-tmpl   nloop 1, eop, pre, nreg 5, prim (sprite tme fst); regs rgbaq uv xyz2 uv xyz2.
;;                 fst means uv carries texel coordinates in 12.4 rather than st.
;;   sprite-tmpl2  the same with abe set, for the passes that alpha blend.
;;   adgif-tmpl    nloop 5, eop, nreg 1, regs a+d -- the five A+D pairs of an adgif-shader.
;; blink-table is the automatic blink envelope, read backwards as random-time counts down: the lid
;; snaps shut over three samples, holds for four, and opens over three.
(define *eye-work*
  (new 'static
       'eye-work
       :sprite-tmpl
       (new 'static
            'dma-gif-packet
            :dma-vif
            (new 'static
                 'dma-packet
                 :dma
                 (new 'static 'dma-tag :qwc #x6 :id (dma-tag-id cnt))
                 :vif1
                 (new 'static 'vif-tag :imm #x6 :cmd (vif-cmd direct) :msk #x1))
            :gif
            (new 'static 'array uint64 2 #x508b400000008001 #x53531))
       :sprite-tmpl2
       (new 'static
            'dma-gif-packet
            :dma-vif
            (new 'static
                 'dma-packet
                 :dma
                 (new 'static 'dma-tag :qwc #x6 :id (dma-tag-id cnt))
                 :vif1
                 (new 'static 'vif-tag :imm #x6 :cmd (vif-cmd direct) :msk #x1))
            :gif
            (new 'static 'array uint64 2 #x50ab400000008001 #x53531))
       :adgif-tmpl
       (new 'static
            'dma-gif-packet
            :dma-vif
            (new 'static
                 'dma-packet
                 :dma
                 (new 'static 'dma-tag :qwc #x6 :id (dma-tag-id cnt))
                 :vif1
                 (new 'static 'vif-tag :imm #x6 :cmd (vif-cmd direct) :msk #x1))
            :gif
            (new 'static 'array uint64 2 #x1000000000008005 #xe))
       :blink-table
       (new 'static 'array float 10 0.0 0.667 0.9 1.0 1.0 1.0 1.0 0.333 0.1 0.0)))

;; WARN: Stack slot offset 16 signed mismatch
;; WARN: Stack slot offset 16 signed mismatch
;; WARN: Stack slot offset 16 signed mismatch
;; WARN: Stack slot offset 16 signed mismatch
(defun render-eyes ((dma-buf dma-buffer) (ctrl eye-control) (slot int))
  "Composite one eye-control slot's 64x32 tile into the shared eye render target and return the new
   DMA base. dma-buf must already have the eye framebuffer, scissor and (32, 32) drawing offset
   installed, which update-eyes does once per bucket. slot picks the tile, and it has to be the index
   this eye-control occupies in *eye-control-array*, because merc was handed the block address for
   that same tile.
   Appends 1552 bytes: three adgif sets, five sprites, and the scissor and alpha-test changes between
   them.
   Writes through ctrl as a side effect. An eye whose lid is negative is asking for the automatic
   blink, and its lid is replaced here with the value the current blink calls for, so the sign is
   consumed the first time the eye is drawn after merc-eye-anim sets it."
  (local-vars (right-y float))
  ;; Primitive coordinates, offset by (32, 32) from the pixel they land on; the scissor registers
  ;; below use pixels. The left eye occupies pixels x 0..31 of the tile and the right eye x 32..63,
  ;; so their centers sit 16 and 48 past origin-x. The eye's own x/y span -1 to 1 and so slide the
  ;; iris and pupil by up to 32 pixels either way, and everything is finally scaled by 16 for the GS's
  ;; 12.4 format.
  (let ((origin-x 32)
        (origin-y (+ (* slot 32) 32))
        (scissor-y0 (* slot 32)))
    (let ((left-x (* 16.0 (+ (the float (+ origin-x 16)) (* 32.0 (-> ctrl left x)))))
          (left-y (* 16.0 (+ (the float (+ origin-y 16)) (* 32.0 (-> ctrl left y)))))
          (right-x (* 16.0 (+ (the float (+ origin-x 48)) (* 32.0 (-> ctrl right x))))))
      (set! right-y (* 16.0 (+ (the float (+ origin-y 16)) (* 32.0 (-> ctrl right y)))))
      (let ((iris-shader (-> ctrl shaders 0)))
        ;; ADGIF 0: the iris material, used for both the flat fill and the iris itself. The art's
        ;; shader is copied wholesale and then three registers are overridden: clamp to the 32x32
        ;; texture so the fill cannot wrap, and the fifth A+D pair is retargeted from miptbp1 to
        ;; alpha-1 to carry the ordinary source-over blend.
        (let ((adgif-out (the-as object (-> dma-buf base))))
          (set! (-> (the-as dma-gif-packet adgif-out) dma-vif quad) (-> *eye-work* adgif-tmpl dma-vif quad))
          (set! (-> (the-as dma-gif-packet adgif-out) quad 1) (-> *eye-work* adgif-tmpl quad 1))
          (let ((iris-adgif (the-as adgif-shader (&+ (the-as pointer adgif-out) 32))))
            (quad-copy! (the-as pointer iris-adgif) (the-as pointer iris-shader) 5)
            (set! (-> iris-adgif clamp)
                  (new 'static 'gs-clamp :wms (gs-tex-wrap-mode clamp) :wmt (gs-tex-wrap-mode clamp) :maxu #x1f :maxv #x1f))
            (set! (-> iris-adgif alpha) (new 'static 'gs-alpha :b #x1 :d #x1))
            (set! (-> iris-adgif prims 9) (gs-reg64 alpha-1))))
        (&+! (-> dma-buf base) 112)
        ;; SCISSOR0: the whole tile, both eyes, for the flat fill below
        (let* ((buf dma-buf)
               (dma-out (the-as object (-> buf base))))
          (set! (-> (the-as dma-packet dma-out) dma) (new 'static 'dma-tag :qwc #x2 :id (dma-tag-id cnt)))
          (set! (-> (the-as dma-packet dma-out) vif0) (new 'static 'vif-tag))
          (set! (-> (the-as dma-packet dma-out) vif1) (new 'static 'vif-tag :imm #x2 :cmd (vif-cmd direct) :msk #x1))
          (set! (-> buf base) (&+ (the-as pointer dma-out) 16)))
        (let* ((buf dma-buf)
               (gif-out (the-as object (-> buf base))))
          (set! (-> (the-as gs-gif-tag gif-out) tag) (new 'static 'gif-tag64 :nloop #x1 :eop #x1 :nreg #x1))
          (set! (-> (the-as gs-gif-tag gif-out) regs)
                (new 'static
                     'gif-tag-regs
                     :regs0 (gif-reg-id a+d)
                     :regs1 (gif-reg-id a+d)
                     :regs2 (gif-reg-id a+d)
                     :regs3 (gif-reg-id a+d)
                     :regs4 (gif-reg-id a+d)
                     :regs5 (gif-reg-id a+d)
                     :regs6 (gif-reg-id a+d)
                     :regs7 (gif-reg-id a+d)
                     :regs8 (gif-reg-id a+d)
                     :regs9 (gif-reg-id a+d)
                     :regs10 (gif-reg-id a+d)
                     :regs11 (gif-reg-id a+d)
                     :regs12 (gif-reg-id a+d)
                     :regs13 (gif-reg-id a+d)
                     :regs14 (gif-reg-id a+d)
                     :regs15 (gif-reg-id a+d)))
          (set! (-> buf base) (&+ (the-as pointer gif-out) 16)))
        (let* ((buf dma-buf)
               (reg-out (-> buf base)))
          (set! (-> (the-as (pointer gs-scissor) reg-out) 0)
                (new 'static 'gs-scissor :scax1 #x3f :scay1 (+ scissor-y0 31) :scay0 scissor-y0))
          (set! (-> (the-as (pointer gs-reg64) reg-out) 1) (gs-reg64 scissor-1))
          (set! (-> buf base) (&+ reg-out 16)))
        ;; SPRITE0: clear both eyes to the sclera color. Both uv corners are (0, 0), so the whole
        ;; 64x32 tile is filled with texel (0, 0) of the iris texture. Color 128 in every lane is
        ;; unity for the GS, so the texel passes through and its alpha seeds the tile's alpha plane.
        ;; z is pushed to the far end because the depth test is disabled anyway.
        (let ((fill-sprite (the-as (inline-array vector4w) (-> dma-buf base))))
          (set! (-> fill-sprite 0 quad) (-> *eye-work* sprite-tmpl dma-vif quad))
          (set! (-> fill-sprite 1 quad) (-> *eye-work* sprite-tmpl quad 1))
          (set-vector! (-> fill-sprite 2) 128 128 128 128)
          (set-vector! (-> fill-sprite 3) 0 0 0 0)
          (set-vector! (-> fill-sprite 4) (* origin-x 16) (* origin-y 16) #xffffff 0)
          (set-vector! (-> fill-sprite 5) 0 0 0 0)
          (set-vector! (-> fill-sprite 6) (* (+ origin-x 64) 16) (* (+ origin-y 32) 16) #xffffff 0))
        (set! (-> dma-buf base) (the-as pointer (-> (the-as (inline-array vector4w) (-> dma-buf base)) 7)))
        ;; the full texture extent in the GS's 12.4 texel format, for every sprite that samples the
        ;; whole iris texture rather than one texel of it
        (let ((u-max (ash 16 (-> iris-shader tex0 tw)))
              (v-max (ash 16 (-> iris-shader tex0 th))))
          ;; SCISSOR1: left eye only, so an oversized iris cannot bleed into the right eye
          (let* ((buf dma-buf)
                 (dma-out (the-as object (-> buf base))))
            (set! (-> (the-as dma-packet dma-out) dma) (new 'static 'dma-tag :qwc #x2 :id (dma-tag-id cnt)))
            (set! (-> (the-as dma-packet dma-out) vif0) (new 'static 'vif-tag))
            (set! (-> (the-as dma-packet dma-out) vif1) (new 'static 'vif-tag :imm #x2 :cmd (vif-cmd direct) :msk #x1))
            (set! (-> buf base) (&+ (the-as pointer dma-out) 16)))
          (let* ((buf dma-buf)
                 (gif-out (the-as object (-> buf base))))
            (set! (-> (the-as gs-gif-tag gif-out) tag) (new 'static 'gif-tag64 :nloop #x1 :eop #x1 :nreg #x1))
            (set! (-> (the-as gs-gif-tag gif-out) regs)
                  (new 'static
                       'gif-tag-regs
                       :regs0 (gif-reg-id a+d)
                       :regs1 (gif-reg-id a+d)
                       :regs2 (gif-reg-id a+d)
                       :regs3 (gif-reg-id a+d)
                       :regs4 (gif-reg-id a+d)
                       :regs5 (gif-reg-id a+d)
                       :regs6 (gif-reg-id a+d)
                       :regs7 (gif-reg-id a+d)
                       :regs8 (gif-reg-id a+d)
                       :regs9 (gif-reg-id a+d)
                       :regs10 (gif-reg-id a+d)
                       :regs11 (gif-reg-id a+d)
                       :regs12 (gif-reg-id a+d)
                       :regs13 (gif-reg-id a+d)
                       :regs14 (gif-reg-id a+d)
                       :regs15 (gif-reg-id a+d)))
            (set! (-> buf base) (&+ (the-as pointer gif-out) 16)))
          (let* ((buf dma-buf)
                 (reg-out (-> buf base)))
            (set! (-> (the-as (pointer gs-scissor) reg-out) 0)
                  (new 'static 'gs-scissor :scax1 #x1f :scay1 (+ scissor-y0 31) :scay0 scissor-y0))
            (set! (-> (the-as (pointer gs-reg64) reg-out) 1) (gs-reg64 scissor-1))
            (set! (-> buf base) (&+ reg-out 16)))
          ;; SPRITE1: the left iris, centered on the animated look direction. half-size is in
          ;; 1/16-pixel units, so iris-scale 1.0 gives a 32-pixel sprite, exactly the tile height.
          (let* ((half-size (* 256.0 (-> ctrl left iris-scale)))
                 (sprite-out (the-as (inline-array vector4w) (-> dma-buf base)))
                 (x0 (the int (- left-x half-size)))
                 (y0 (the int (- left-y half-size)))
                 (x1 (the int (+ left-x half-size)))
                 (y1 (the int (+ left-y half-size))))
            (set! (-> sprite-out 0 quad) (-> *eye-work* sprite-tmpl dma-vif quad))
            (set! (-> sprite-out 1 quad) (-> *eye-work* sprite-tmpl quad 1))
            (set-vector! (-> sprite-out 2) 128 128 128 128)
            (set-vector! (-> sprite-out 3) 0 0 0 0)
            (set-vector! (-> sprite-out 4) x0 y0 #xffffff 0)
            (set-vector! (-> sprite-out 5) u-max v-max 0 0)
            (set-vector! (-> sprite-out 6) x1 y1 #xffffff 0))
          (set! (-> dma-buf base) (the-as pointer (-> (the-as (inline-array vector4w) (-> dma-buf base)) 7)))
          ;; SCISSOR2: right eye only
          (let* ((buf dma-buf)
                 (dma-out (the-as object (-> buf base))))
            (set! (-> (the-as dma-packet dma-out) dma) (new 'static 'dma-tag :qwc #x2 :id (dma-tag-id cnt)))
            (set! (-> (the-as dma-packet dma-out) vif0) (new 'static 'vif-tag))
            (set! (-> (the-as dma-packet dma-out) vif1) (new 'static 'vif-tag :imm #x2 :cmd (vif-cmd direct) :msk #x1))
            (set! (-> buf base) (&+ (the-as pointer dma-out) 16)))
          (let* ((buf dma-buf)
                 (gif-out (the-as object (-> buf base))))
            (set! (-> (the-as gs-gif-tag gif-out) tag) (new 'static 'gif-tag64 :nloop #x1 :eop #x1 :nreg #x1))
            (set! (-> (the-as gs-gif-tag gif-out) regs)
                  (new 'static
                       'gif-tag-regs
                       :regs0 (gif-reg-id a+d)
                       :regs1 (gif-reg-id a+d)
                       :regs2 (gif-reg-id a+d)
                       :regs3 (gif-reg-id a+d)
                       :regs4 (gif-reg-id a+d)
                       :regs5 (gif-reg-id a+d)
                       :regs6 (gif-reg-id a+d)
                       :regs7 (gif-reg-id a+d)
                       :regs8 (gif-reg-id a+d)
                       :regs9 (gif-reg-id a+d)
                       :regs10 (gif-reg-id a+d)
                       :regs11 (gif-reg-id a+d)
                       :regs12 (gif-reg-id a+d)
                       :regs13 (gif-reg-id a+d)
                       :regs14 (gif-reg-id a+d)
                       :regs15 (gif-reg-id a+d)))
            (set! (-> buf base) (&+ (the-as pointer gif-out) 16)))
          (let* ((buf dma-buf)
                 (reg-out (-> buf base)))
            (set! (-> (the-as (pointer gs-scissor) reg-out) 0)
                  (new 'static 'gs-scissor :scax0 #x20 :scax1 #x3f :scay1 (+ scissor-y0 31) :scay0 scissor-y0))
            (set! (-> (the-as (pointer gs-reg64) reg-out) 1) (gs-reg64 scissor-1))
            (set! (-> buf base) (&+ reg-out 16)))
          ;; SPRITE2: the right iris, from the same texture and with its own animated center
          (let* ((half-size (* 256.0 (-> ctrl right iris-scale)))
                 (sprite-out (the-as (inline-array vector4w) (-> dma-buf base)))
                 (x0 (the int (- right-x half-size)))
                 (y0 (the int (- right-y half-size)))
                 (x1 (the int (+ right-x half-size)))
                 (y1 (the int (+ right-y half-size))))
            (set! (-> sprite-out 0 quad) (-> *eye-work* sprite-tmpl dma-vif quad))
            (set! (-> sprite-out 1 quad) (-> *eye-work* sprite-tmpl quad 1))
            (set-vector! (-> sprite-out 2) 128 128 128 128)
            (set-vector! (-> sprite-out 3) 0 0 0 0)
            (set-vector! (-> sprite-out 4) x0 y0 #xffffff 0)
            (set-vector! (-> sprite-out 5) u-max v-max 0 0)
            (set-vector! (-> sprite-out 6) x1 y1 #xffffff 0))))
      (set! (-> dma-buf base) (the-as pointer (-> (the-as (inline-array vector4w) (-> dma-buf base)) 7)))
      ;; TEST: alpha test enabled with atst NEVER and afail RGB_ONLY, so the pupil pass that follows
      ;; always "fails" and the GS writes color but not alpha. The alpha the fill and iris left in the
      ;; tile is what merc keys off, and the pupil must not disturb it.
      (let* ((buf dma-buf)
             (dma-out (the-as object (-> buf base))))
        (set! (-> (the-as dma-packet dma-out) dma) (new 'static 'dma-tag :qwc #x2 :id (dma-tag-id cnt)))
        (set! (-> (the-as dma-packet dma-out) vif0) (new 'static 'vif-tag))
        (set! (-> (the-as dma-packet dma-out) vif1) (new 'static 'vif-tag :imm #x2 :cmd (vif-cmd direct) :msk #x1))
        (set! (-> buf base) (&+ (the-as pointer dma-out) 16)))
      (let* ((buf dma-buf)
             (gif-out (the-as object (-> buf base))))
        (set! (-> (the-as gs-gif-tag gif-out) tag) (new 'static 'gif-tag64 :nloop #x1 :eop #x1 :nreg #x1))
        (set! (-> (the-as gs-gif-tag gif-out) regs)
              (new 'static
                   'gif-tag-regs
                   :regs0 (gif-reg-id a+d)
                   :regs1 (gif-reg-id a+d)
                   :regs2 (gif-reg-id a+d)
                   :regs3 (gif-reg-id a+d)
                   :regs4 (gif-reg-id a+d)
                   :regs5 (gif-reg-id a+d)
                   :regs6 (gif-reg-id a+d)
                   :regs7 (gif-reg-id a+d)
                   :regs8 (gif-reg-id a+d)
                   :regs9 (gif-reg-id a+d)
                   :regs10 (gif-reg-id a+d)
                   :regs11 (gif-reg-id a+d)
                   :regs12 (gif-reg-id a+d)
                   :regs13 (gif-reg-id a+d)
                   :regs14 (gif-reg-id a+d)
                   :regs15 (gif-reg-id a+d)))
        (set! (-> buf base) (&+ (the-as pointer gif-out) 16)))
      (let* ((buf dma-buf)
             (reg-out (-> buf base)))
        (set! (-> (the-as (pointer gs-test) reg-out) 0)
              (new 'static 'gs-test :ate #x1 :afail #x3 :zte #x1 :ztst (gs-ztest always)))
        (set! (-> (the-as (pointer gs-reg64) reg-out) 1) (gs-reg64 test-1))
        (set! (-> buf base) (&+ reg-out 16)))
      ;; ADGIF 1: the pupil material, patched the same way as the iris
      (let ((pupil-shader (-> ctrl shaders 1)))
        (let ((adgif-out (the-as object (-> dma-buf base))))
          (set! (-> (the-as (inline-array vector4w) adgif-out) 0 quad) (-> *eye-work* adgif-tmpl dma-vif quad))
          (set! (-> (the-as (inline-array vector4w) adgif-out) 1 quad) (-> *eye-work* adgif-tmpl quad 1))
          (let ((pupil-adgif (the-as adgif-shader (&+ (the-as pointer adgif-out) 32))))
            (quad-copy! (the-as pointer pupil-adgif) (the-as pointer pupil-shader) 5)
            (set! (-> pupil-adgif clamp)
                  (new 'static 'gs-clamp :wms (gs-tex-wrap-mode clamp) :wmt (gs-tex-wrap-mode clamp) :maxu #x1f :maxv #x1f))
            (set! (-> pupil-adgif alpha) (new 'static 'gs-alpha :b #x1 :d #x1))
            (set! (-> pupil-adgif prims 9) (gs-reg64 alpha-1))))
        (&+! (-> dma-buf base) 112)
        (let ((u-max (ash 16 (-> pupil-shader tex0 tw)))
              (v-max (ash 16 (-> pupil-shader tex0 th))))
          (let* ((buf dma-buf)
                 (dma-out (the-as object (-> buf base))))
            (set! (-> (the-as dma-packet dma-out) dma) (new 'static 'dma-tag :qwc #x2 :id (dma-tag-id cnt)))
            (set! (-> (the-as dma-packet dma-out) vif0) (new 'static 'vif-tag))
            (set! (-> (the-as dma-packet dma-out) vif1) (new 'static 'vif-tag :imm #x2 :cmd (vif-cmd direct) :msk #x1))
            (set! (-> buf base) (&+ (the-as pointer dma-out) 16)))
          (let* ((buf dma-buf)
                 (gif-out (the-as object (-> buf base))))
            (set! (-> (the-as gs-gif-tag gif-out) tag) (new 'static 'gif-tag64 :nloop #x1 :eop #x1 :nreg #x1))
            (set! (-> (the-as gs-gif-tag gif-out) regs)
                  (new 'static
                       'gif-tag-regs
                       :regs0 (gif-reg-id a+d)
                       :regs1 (gif-reg-id a+d)
                       :regs2 (gif-reg-id a+d)
                       :regs3 (gif-reg-id a+d)
                       :regs4 (gif-reg-id a+d)
                       :regs5 (gif-reg-id a+d)
                       :regs6 (gif-reg-id a+d)
                       :regs7 (gif-reg-id a+d)
                       :regs8 (gif-reg-id a+d)
                       :regs9 (gif-reg-id a+d)
                       :regs10 (gif-reg-id a+d)
                       :regs11 (gif-reg-id a+d)
                       :regs12 (gif-reg-id a+d)
                       :regs13 (gif-reg-id a+d)
                       :regs14 (gif-reg-id a+d)
                       :regs15 (gif-reg-id a+d)))
            (set! (-> buf base) (&+ (the-as pointer gif-out) 16)))
          (let* ((buf dma-buf)
                 (reg-out (-> buf base)))
            (set! (-> (the-as (pointer gs-scissor) reg-out) 0)
                  (new 'static 'gs-scissor :scax1 #x1f :scay1 (+ scissor-y0 31) :scay0 scissor-y0))
            (set! (-> (the-as (pointer gs-reg64) reg-out) 1) (gs-reg64 scissor-1))
            (set! (-> buf base) (&+ reg-out 16)))
          ;; the left pupil, on the same center as the iris but from sprite-tmpl2, whose prim has abe
          ;; set, so it blends over the iris instead of replacing it
          (let* ((half-size (* 256.0 (-> ctrl left pupil-scale)))
                 (sprite-out (the-as (inline-array vector4w) (-> dma-buf base)))
                 (x0 (the int (- left-x half-size)))
                 (y0 (the int (- left-y half-size)))
                 (x1 (the int (+ left-x half-size)))
                 (y1 (the int (+ left-y half-size))))
            (set! (-> sprite-out 0 quad) (-> *eye-work* sprite-tmpl2 dma-vif quad))
            (set! (-> sprite-out 1 quad) (-> *eye-work* sprite-tmpl2 quad 1))
            (set-vector! (-> sprite-out 2) 128 128 128 128)
            (set-vector! (-> sprite-out 3) 0 0 0 0)
            (set-vector! (-> sprite-out 4) x0 y0 #xffffff 0)
            (set-vector! (-> sprite-out 5) u-max v-max 0 0)
            (let ((last-vertex (the-as (inline-array vector4w) (-> sprite-out 6))))
              (set! (-> last-vertex 0 x) x1)
              (set! (-> last-vertex 0 y) y1)
              (set! (-> last-vertex 0 z) #xffffff)
              (set! (-> last-vertex 0 w) 0)))
          (set! (-> dma-buf base) (the-as pointer (-> (the-as (inline-array vector4w) (-> dma-buf base)) 7)))
          (let* ((buf dma-buf)
                 (dma-out (the-as object (-> buf base))))
            (set! (-> (the-as dma-packet dma-out) dma) (new 'static 'dma-tag :qwc #x2 :id (dma-tag-id cnt)))
            (set! (-> (the-as dma-packet dma-out) vif0) (new 'static 'vif-tag))
            (set! (-> (the-as dma-packet dma-out) vif1) (new 'static 'vif-tag :imm #x2 :cmd (vif-cmd direct) :msk #x1))
            (set! (-> buf base) (&+ (the-as pointer dma-out) 16)))
          (let* ((buf dma-buf)
                 (gif-out (the-as object (-> buf base))))
            (set! (-> (the-as gs-gif-tag gif-out) tag) (new 'static 'gif-tag64 :nloop #x1 :eop #x1 :nreg #x1))
            (set! (-> (the-as gs-gif-tag gif-out) regs)
                  (new 'static
                       'gif-tag-regs
                       :regs0 (gif-reg-id a+d)
                       :regs1 (gif-reg-id a+d)
                       :regs2 (gif-reg-id a+d)
                       :regs3 (gif-reg-id a+d)
                       :regs4 (gif-reg-id a+d)
                       :regs5 (gif-reg-id a+d)
                       :regs6 (gif-reg-id a+d)
                       :regs7 (gif-reg-id a+d)
                       :regs8 (gif-reg-id a+d)
                       :regs9 (gif-reg-id a+d)
                       :regs10 (gif-reg-id a+d)
                       :regs11 (gif-reg-id a+d)
                       :regs12 (gif-reg-id a+d)
                       :regs13 (gif-reg-id a+d)
                       :regs14 (gif-reg-id a+d)
                       :regs15 (gif-reg-id a+d)))
            (set! (-> buf base) (&+ (the-as pointer gif-out) 16)))
          (let* ((buf dma-buf)
                 (reg-out (-> buf base)))
            (set! (-> (the-as (pointer gs-scissor) reg-out) 0)
                  (new 'static 'gs-scissor :scax0 #x20 :scax1 #x3f :scay1 (+ scissor-y0 31) :scay0 scissor-y0))
            (set! (-> (the-as (pointer gs-reg64) reg-out) 1) (gs-reg64 scissor-1))
            (set! (-> buf base) (&+ reg-out 16)))
          ;; the right pupil
          (let* ((half-size (* 256.0 (-> ctrl right pupil-scale)))
                 (sprite-out (the-as (inline-array vector4w) (-> dma-buf base)))
                 (x0 (the int (- right-x half-size)))
                 (y0 (the int (- right-y half-size)))
                 (x1 (the int (+ right-x half-size)))
                 (y1 (the int (+ right-y half-size))))
            (set! (-> sprite-out 0 quad) (-> *eye-work* sprite-tmpl2 dma-vif quad))
            (set! (-> sprite-out 1 quad) (-> *eye-work* sprite-tmpl2 quad 1))
            (set-vector! (-> sprite-out 2) 128 128 128 128)
            (set-vector! (-> sprite-out 3) 0 0 0 0)
            (set-vector! (-> sprite-out 4) x0 y0 #xffffff 0)
            (set-vector! (-> sprite-out 5) u-max v-max 0 0)
            (set-vector! (-> sprite-out 6) x1 y1 #xffffff 0)))))
    (set! (-> dma-buf base) (the-as pointer (-> (the-as (inline-array vector4w) (-> dma-buf base)) 7)))
    (let* ((buf dma-buf)
           (dma-out (the-as object (-> buf base))))
      (set! (-> (the-as dma-packet dma-out) dma) (new 'static 'dma-tag :qwc #x2 :id (dma-tag-id cnt)))
      (set! (-> (the-as dma-packet dma-out) vif0) (new 'static 'vif-tag))
      (set! (-> (the-as dma-packet dma-out) vif1) (new 'static 'vif-tag :imm #x2 :cmd (vif-cmd direct) :msk #x1))
      (set! (-> buf base) (&+ (the-as pointer dma-out) 16)))
    (let* ((buf dma-buf)
           (gif-out (the-as object (-> buf base))))
      (set! (-> (the-as gs-gif-tag gif-out) tag) (new 'static 'gif-tag64 :nloop #x1 :eop #x1 :nreg #x1))
      (set! (-> (the-as gs-gif-tag gif-out) regs)
            (new 'static
                 'gif-tag-regs
                 :regs0 (gif-reg-id a+d)
                 :regs1 (gif-reg-id a+d)
                 :regs2 (gif-reg-id a+d)
                 :regs3 (gif-reg-id a+d)
                 :regs4 (gif-reg-id a+d)
                 :regs5 (gif-reg-id a+d)
                 :regs6 (gif-reg-id a+d)
                 :regs7 (gif-reg-id a+d)
                 :regs8 (gif-reg-id a+d)
                 :regs9 (gif-reg-id a+d)
                 :regs10 (gif-reg-id a+d)
                 :regs11 (gif-reg-id a+d)
                 :regs12 (gif-reg-id a+d)
                 :regs13 (gif-reg-id a+d)
                 :regs14 (gif-reg-id a+d)
                 :regs15 (gif-reg-id a+d)))
      (set! (-> buf base) (&+ (the-as pointer gif-out) 16)))
    (let* ((buf dma-buf)
           (reg-out (-> buf base)))
      (set! (-> (the-as (pointer gs-test) reg-out) 0)
            (new 'static 'gs-test :ate #x1 :atst (gs-atest always) :zte #x1 :ztst (gs-ztest always)))
      (set! (-> (the-as (pointer gs-reg64) reg-out) 1) (gs-reg64 test-1))
      (set! (-> buf base) (&+ reg-out 16)))
    ;; ADGIF 2: the eyelid material. Its blend is (Cd - Cs) * As + Cs, and the lid sprites below carry
    ;; a vertex alpha of zero, so the lid replaces the color outright and drops the tile's alpha to
    ;; zero wherever it covers. That is what makes a closed eye read as skin once merc samples it.
    (let ((lid-shader (-> ctrl shaders 2)))
      (let ((adgif-out (the-as object (-> dma-buf base))))
        (set! (-> (the-as dma-gif-packet adgif-out) dma-vif quad) (-> *eye-work* adgif-tmpl dma-vif quad))
        (set! (-> (the-as dma-gif-packet adgif-out) quad 1) (-> *eye-work* adgif-tmpl quad 1))
        (let ((lid-adgif (the-as adgif-shader (&+ (the-as pointer adgif-out) 32))))
          (quad-copy! (the-as pointer lid-adgif) (the-as pointer lid-shader) 5)
          (set! (-> lid-adgif clamp)
                (new 'static 'gs-clamp :wms (gs-tex-wrap-mode clamp) :wmt (gs-tex-wrap-mode clamp) :maxu #x1f :maxv #x1f))
          (set! (-> lid-adgif alpha) (new 'static 'gs-alpha :a #x1))
          (set! (-> lid-adgif prims 9) (gs-reg64 alpha-1))))
      (set! (-> dma-buf base) (-> (the-as (inline-array dma-gif-packet) (-> dma-buf base)) 3 gif))
      (let ((u-max (ash 16 (-> lid-shader tex0 tw)))
            (v-max (ash 16 (-> lid-shader tex0 th))))
        ;; A negative lid is the animation asking for the automatic blink. Its magnitude is how far
        ;; below fully open the eye should sit at rest, so 1 + lid is that resting closure, and the
        ;; blink envelope closes the rest of the way from there. The sign is consumed by this
        ;; rewrite, which is why it happens even though the value is only read once below.
        (when (< (-> ctrl left lid) 0.0)
          (let ((base-closed (+ 1.0 (-> ctrl left lid))))
            (set! (-> ctrl left lid) (+ base-closed (* (- 1.0 base-closed) (-> ctrl blink))))))
        (let* ((buf dma-buf)
               (dma-out (the-as object (-> buf base))))
          (set! (-> (the-as dma-packet dma-out) dma) (new 'static 'dma-tag :qwc #x2 :id (dma-tag-id cnt)))
          (set! (-> (the-as dma-packet dma-out) vif0) (new 'static 'vif-tag))
          (set! (-> (the-as dma-packet dma-out) vif1) (new 'static 'vif-tag :imm #x2 :cmd (vif-cmd direct) :msk #x1))
          (set! (-> buf base) (&+ (the-as pointer dma-out) 16)))
        (let* ((buf dma-buf)
               (gif-out (the-as object (-> buf base))))
          (set! (-> (the-as gs-gif-tag gif-out) tag) (new 'static 'gif-tag64 :nloop #x1 :eop #x1 :nreg #x1))
          (set! (-> (the-as gs-gif-tag gif-out) regs)
                (new 'static
                     'gif-tag-regs
                     :regs0 (gif-reg-id a+d)
                     :regs1 (gif-reg-id a+d)
                     :regs2 (gif-reg-id a+d)
                     :regs3 (gif-reg-id a+d)
                     :regs4 (gif-reg-id a+d)
                     :regs5 (gif-reg-id a+d)
                     :regs6 (gif-reg-id a+d)
                     :regs7 (gif-reg-id a+d)
                     :regs8 (gif-reg-id a+d)
                     :regs9 (gif-reg-id a+d)
                     :regs10 (gif-reg-id a+d)
                     :regs11 (gif-reg-id a+d)
                     :regs12 (gif-reg-id a+d)
                     :regs13 (gif-reg-id a+d)
                     :regs14 (gif-reg-id a+d)
                     :regs15 (gif-reg-id a+d)))
          (set! (-> buf base) (&+ (the-as pointer gif-out) 16)))
        (let* ((buf dma-buf)
               (reg-out (-> buf base)))
          (set! (-> (the-as (pointer gs-scissor) reg-out) 0)
                (new 'static 'gs-scissor :scax1 #x1f :scay1 (+ scissor-y0 31) :scay0 scissor-y0))
          (set! (-> (the-as (pointer gs-reg64) reg-out) 1) (gs-reg64 scissor-1))
          (set! (-> buf base) (&+ reg-out 16)))
        ;; The left lid, a tile-wide band whose top edge is one tile height above the eye at lid 0 and
        ;; flush with the eye's top at lid 1, so lid runs from fully open to fully closed. lid-scale
        ;; sets its height; a band shorter than the tile leaves the bottom of the eye visible even
        ;; when closed. The scissor is what hides the band while the eye is open.
        (let* ((lid-y (+ (the float (+ origin-y -32)) (* 32.0 (-> ctrl left lid))))
               (sprite-out (the-as (inline-array vector4w) (-> dma-buf base)))
               (x0 (* origin-x 16))
               (y0 (the int (* 16.0 lid-y)))
               (x1 (* (+ origin-x 32) 16))
               (y1 (the int (* 16.0 (+ lid-y (* 32.0 (-> ctrl left lid-scale)))))))
          (set! (-> sprite-out 0 quad) (-> *eye-work* sprite-tmpl2 dma-vif quad))
          (set! (-> sprite-out 1 quad) (-> *eye-work* sprite-tmpl2 quad 1))
          (set-vector! (-> sprite-out 2) 128 128 128 0)
          (set-vector! (-> sprite-out 3) 0 0 0 0)
          (set-vector! (-> sprite-out 4) x0 y0 #xffffff 0)
          (set-vector! (-> sprite-out 5) u-max v-max 0 0)
          (set-vector! (-> sprite-out 6) x1 y1 #xffffff 0))
        (set! (-> dma-buf base) (the-as pointer (-> (the-as (inline-array vector4w) (-> dma-buf base)) 7)))
        (when (< (-> ctrl right lid) 0.0)
          (let ((base-closed (+ 1.0 (-> ctrl right lid))))
            (set! (-> ctrl right lid) (+ base-closed (* (- 1.0 base-closed) (-> ctrl blink))))))
        (let* ((buf dma-buf)
               (dma-out (the-as object (-> buf base))))
          (set! (-> (the-as dma-packet dma-out) dma) (new 'static 'dma-tag :qwc #x2 :id (dma-tag-id cnt)))
          (set! (-> (the-as dma-packet dma-out) vif0) (new 'static 'vif-tag))
          (set! (-> (the-as dma-packet dma-out) vif1) (new 'static 'vif-tag :imm #x2 :cmd (vif-cmd direct) :msk #x1))
          (set! (-> buf base) (&+ (the-as pointer dma-out) 16)))
        (let* ((buf dma-buf)
               (gif-out (the-as object (-> buf base))))
          (set! (-> (the-as gs-gif-tag gif-out) tag) (new 'static 'gif-tag64 :nloop #x1 :eop #x1 :nreg #x1))
          (set! (-> (the-as gs-gif-tag gif-out) regs)
                (new 'static
                     'gif-tag-regs
                     :regs0 (gif-reg-id a+d)
                     :regs1 (gif-reg-id a+d)
                     :regs2 (gif-reg-id a+d)
                     :regs3 (gif-reg-id a+d)
                     :regs4 (gif-reg-id a+d)
                     :regs5 (gif-reg-id a+d)
                     :regs6 (gif-reg-id a+d)
                     :regs7 (gif-reg-id a+d)
                     :regs8 (gif-reg-id a+d)
                     :regs9 (gif-reg-id a+d)
                     :regs10 (gif-reg-id a+d)
                     :regs11 (gif-reg-id a+d)
                     :regs12 (gif-reg-id a+d)
                     :regs13 (gif-reg-id a+d)
                     :regs14 (gif-reg-id a+d)
                     :regs15 (gif-reg-id a+d)))
          (set! (-> buf base) (&+ (the-as pointer gif-out) 16)))
        (let* ((buf dma-buf)
               (reg-out (-> buf base)))
          (set! (-> (the-as (pointer gs-scissor) reg-out) 0)
                (new 'static 'gs-scissor :scax0 #x20 :scax1 #x3f :scay1 (+ scissor-y0 31) :scay0 scissor-y0))
          (set! (-> (the-as (pointer gs-reg64) reg-out) 1) (gs-reg64 scissor-1))
          (set! (-> buf base) (&+ reg-out 16)))
        ;; The right lid. x runs from the tile's right edge back to the middle rather than the other
        ;; way round, which mirrors the lid art horizontally so a lid drawn for one eye reads
        ;; correctly on both.
        ;; The height comes from the *left* eye's lid-scale. Jak 2 and Jak 3 have the same expression
        ;; here, so it is not a transcription slip; in practice both eyes of a head are given the same
        ;; lid-scale, which is why it never showed.
        (let* ((lid-y (+ (the float (+ origin-y -32)) (* 32.0 (-> ctrl right lid))))
               (sprite-out (the-as (inline-array vector4w) (-> dma-buf base)))
               (x0 (* (+ origin-x 64) 16))
               (y0 (the int (* 16.0 lid-y)))
               (x1 (* (+ origin-x 32) 16))
               (y1 (the int (* 16.0 (+ lid-y (* 32.0 (-> ctrl left lid-scale)))))))
          (set! (-> sprite-out 0 quad) (-> *eye-work* sprite-tmpl2 dma-vif quad))
          (set! (-> sprite-out 1 quad) (-> *eye-work* sprite-tmpl2 quad 1))
          (set-vector! (-> sprite-out 2) 128 128 128 0)
          (set-vector! (-> sprite-out 3) 0 0 0 0)
          (set-vector! (-> sprite-out 4) x0 y0 #xffffff 0)
          (set-vector! (-> sprite-out 5) u-max v-max 0 0)
          (set-vector! (-> sprite-out 6) x1 y1 #xffffff 0)))))
  (let ((buf-end (-> (the-as (inline-array vector4w) (-> dma-buf base)) 7)))
    (set! (-> dma-buf base) (the-as pointer buf-end))
    (the-as pointer buf-end)))

(defun update-eyes ()
  "Build every eye tile needed this frame. Runs three times over the buckets that precede the merc
   pris draws -- pris-tex0, pris-tex1 and eyes -- installing the eye render target at the head of
   each and restoring the normal framebuffer state at the tail, so a bucket's tiles exist in VRAM
   exactly while that bucket's characters are drawn.
   In between, walks all eleven eye-control slots and composites the ones whose process is still
   alive, is flagged for eye animation, and was drawn this frame. Each of those also advances its
   blink countdown, unless the game is paused.
   Called from drawable's foreground pass, before sprite-draw."
  ;; Setup GS for level 0 eyes.
  ;; Point the GS at the 64x352 eye render target, scissored to the whole thing, with the drawing
  ;; offset at (32, 32) and depth writes off. The alpha test is then set to pass everything, because
  ;; the pupil pass inside render-eyes leaves it configured to fail and each bucket has to start from
  ;; a known state. These three blocks are identical apart from the bucket they land in.
  (let* ((dma-buf (-> *display* frames (-> *display* on-screen) frame global-buf))
         (bucket-start (-> dma-buf base)))
    (set-display-gs-state-offset dma-buf *eyes-base-page* 64 352 0 0 32 32)
    (let* ((buf dma-buf)
           (dma-out (the-as object (-> buf base))))
      (set! (-> (the-as dma-packet dma-out) dma) (new 'static 'dma-tag :qwc #x2 :id (dma-tag-id cnt)))
      (set! (-> (the-as dma-packet dma-out) vif0) (new 'static 'vif-tag))
      (set! (-> (the-as dma-packet dma-out) vif1) (new 'static 'vif-tag :imm #x2 :cmd (vif-cmd direct) :msk #x1))
      (set! (-> buf base) (&+ (the-as pointer dma-out) 16)))
    (let* ((buf dma-buf)
           (gif-out (the-as object (-> buf base))))
      (set! (-> (the-as gs-gif-tag gif-out) tag) (new 'static 'gif-tag64 :nloop #x1 :eop #x1 :nreg #x1))
      (set! (-> (the-as gs-gif-tag gif-out) regs)
            (new 'static
                 'gif-tag-regs
                 :regs0 (gif-reg-id a+d)
                 :regs1 (gif-reg-id a+d)
                 :regs2 (gif-reg-id a+d)
                 :regs3 (gif-reg-id a+d)
                 :regs4 (gif-reg-id a+d)
                 :regs5 (gif-reg-id a+d)
                 :regs6 (gif-reg-id a+d)
                 :regs7 (gif-reg-id a+d)
                 :regs8 (gif-reg-id a+d)
                 :regs9 (gif-reg-id a+d)
                 :regs10 (gif-reg-id a+d)
                 :regs11 (gif-reg-id a+d)
                 :regs12 (gif-reg-id a+d)
                 :regs13 (gif-reg-id a+d)
                 :regs14 (gif-reg-id a+d)
                 :regs15 (gif-reg-id a+d)))
      (set! (-> buf base) (&+ (the-as pointer gif-out) 16)))
    (let* ((buf dma-buf)
           (reg-out (-> buf base)))
      (set! (-> (the-as (pointer gs-test) reg-out) 0)
            (new 'static 'gs-test :ate #x1 :atst (gs-atest always) :zte #x1 :ztst (gs-ztest always)))
      (set! (-> (the-as (pointer gs-reg64) reg-out) 1) (gs-reg64 test-1))
      (set! (-> buf base) (&+ reg-out 16)))
    (let ((next-tag (-> dma-buf base)))
      (let ((dma-out (the-as object (-> dma-buf base))))
        (set! (-> (the-as dma-packet dma-out) dma) (new 'static 'dma-tag :id (dma-tag-id next)))
        (set! (-> (the-as dma-packet dma-out) vif0) (new 'static 'vif-tag))
        (set! (-> (the-as dma-packet dma-out) vif1) (new 'static 'vif-tag))
        (set! (-> dma-buf base) (&+ (the-as pointer dma-out) 16)))
      (dma-bucket-insert-tag (-> *display* frames (-> *display* on-screen) frame bucket-group)
                             (bucket-id pris-tex0)
                             bucket-start
                             (the-as (pointer dma-tag) next-tag))))
  ;; Setup GS for level 1 eyes
  (let* ((dma-buf (-> *display* frames (-> *display* on-screen) frame global-buf))
         (bucket-start (-> dma-buf base)))
    (set-display-gs-state-offset dma-buf *eyes-base-page* 64 352 0 0 32 32)
    (let* ((buf dma-buf)
           (dma-out (the-as object (-> buf base))))
      (set! (-> (the-as dma-packet dma-out) dma) (new 'static 'dma-tag :qwc #x2 :id (dma-tag-id cnt)))
      (set! (-> (the-as dma-packet dma-out) vif0) (new 'static 'vif-tag))
      (set! (-> (the-as dma-packet dma-out) vif1) (new 'static 'vif-tag :imm #x2 :cmd (vif-cmd direct) :msk #x1))
      (set! (-> buf base) (&+ (the-as pointer dma-out) 16)))
    (let* ((buf dma-buf)
           (gif-out (the-as object (-> buf base))))
      (set! (-> (the-as gs-gif-tag gif-out) tag) (new 'static 'gif-tag64 :nloop #x1 :eop #x1 :nreg #x1))
      (set! (-> (the-as gs-gif-tag gif-out) regs)
            (new 'static
                 'gif-tag-regs
                 :regs0 (gif-reg-id a+d)
                 :regs1 (gif-reg-id a+d)
                 :regs2 (gif-reg-id a+d)
                 :regs3 (gif-reg-id a+d)
                 :regs4 (gif-reg-id a+d)
                 :regs5 (gif-reg-id a+d)
                 :regs6 (gif-reg-id a+d)
                 :regs7 (gif-reg-id a+d)
                 :regs8 (gif-reg-id a+d)
                 :regs9 (gif-reg-id a+d)
                 :regs10 (gif-reg-id a+d)
                 :regs11 (gif-reg-id a+d)
                 :regs12 (gif-reg-id a+d)
                 :regs13 (gif-reg-id a+d)
                 :regs14 (gif-reg-id a+d)
                 :regs15 (gif-reg-id a+d)))
      (set! (-> buf base) (&+ (the-as pointer gif-out) 16)))
    (let* ((buf dma-buf)
           (reg-out (-> buf base)))
      (set! (-> (the-as (pointer gs-test) reg-out) 0)
            (new 'static 'gs-test :ate #x1 :atst (gs-atest always) :zte #x1 :ztst (gs-ztest always)))
      (set! (-> (the-as (pointer gs-reg64) reg-out) 1) (gs-reg64 test-1))
      (set! (-> buf base) (&+ reg-out 16)))
    (let ((next-tag (-> dma-buf base)))
      (let ((dma-out (the-as object (-> dma-buf base))))
        (set! (-> (the-as dma-packet dma-out) dma) (new 'static 'dma-tag :id (dma-tag-id next)))
        (set! (-> (the-as dma-packet dma-out) vif0) (new 'static 'vif-tag))
        (set! (-> (the-as dma-packet dma-out) vif1) (new 'static 'vif-tag))
        (set! (-> dma-buf base) (&+ (the-as pointer dma-out) 16)))
      (dma-bucket-insert-tag (-> *display* frames (-> *display* on-screen) frame bucket-group)
                             (bucket-id pris-tex1)
                             bucket-start
                             (the-as (pointer dma-tag) next-tag))))
  ;; Setup GS for common eyes
  (let* ((dma-buf (-> *display* frames (-> *display* on-screen) frame global-buf))
         (bucket-start (-> dma-buf base)))
    (set-display-gs-state-offset dma-buf *eyes-base-page* 64 352 0 0 32 32)
    (let* ((buf dma-buf)
           (dma-out (the-as object (-> buf base))))
      (set! (-> (the-as dma-packet dma-out) dma) (new 'static 'dma-tag :qwc #x2 :id (dma-tag-id cnt)))
      (set! (-> (the-as dma-packet dma-out) vif0) (new 'static 'vif-tag))
      (set! (-> (the-as dma-packet dma-out) vif1) (new 'static 'vif-tag :imm #x2 :cmd (vif-cmd direct) :msk #x1))
      (set! (-> buf base) (&+ (the-as pointer dma-out) 16)))
    (let* ((buf dma-buf)
           (gif-out (the-as object (-> buf base))))
      (set! (-> (the-as gs-gif-tag gif-out) tag) (new 'static 'gif-tag64 :nloop #x1 :eop #x1 :nreg #x1))
      (set! (-> (the-as gs-gif-tag gif-out) regs)
            (new 'static
                 'gif-tag-regs
                 :regs0 (gif-reg-id a+d)
                 :regs1 (gif-reg-id a+d)
                 :regs2 (gif-reg-id a+d)
                 :regs3 (gif-reg-id a+d)
                 :regs4 (gif-reg-id a+d)
                 :regs5 (gif-reg-id a+d)
                 :regs6 (gif-reg-id a+d)
                 :regs7 (gif-reg-id a+d)
                 :regs8 (gif-reg-id a+d)
                 :regs9 (gif-reg-id a+d)
                 :regs10 (gif-reg-id a+d)
                 :regs11 (gif-reg-id a+d)
                 :regs12 (gif-reg-id a+d)
                 :regs13 (gif-reg-id a+d)
                 :regs14 (gif-reg-id a+d)
                 :regs15 (gif-reg-id a+d)))
      (set! (-> buf base) (&+ (the-as pointer gif-out) 16)))
    (let* ((buf dma-buf)
           (reg-out (-> buf base)))
      (set! (-> (the-as (pointer gs-test) reg-out) 0)
            (new 'static 'gs-test :ate #x1 :atst (gs-atest always) :zte #x1 :ztst (gs-ztest always)))
      (set! (-> (the-as (pointer gs-reg64) reg-out) 1) (gs-reg64 test-1))
      (set! (-> buf base) (&+ reg-out 16)))
    (let ((next-tag (-> dma-buf base)))
      (let ((dma-out (the-as object (-> dma-buf base))))
        (set! (-> (the-as dma-packet dma-out) dma) (new 'static 'dma-tag :id (dma-tag-id next)))
        (set! (-> (the-as dma-packet dma-out) vif0) (new 'static 'vif-tag))
        (set! (-> (the-as dma-packet dma-out) vif1) (new 'static 'vif-tag))
        (set! (-> dma-buf base) (&+ (the-as pointer dma-out) 16)))
      (dma-bucket-insert-tag (-> *display* frames (-> *display* on-screen) frame bucket-group)
                             (bucket-id eyes)
                             bucket-start
                             (the-as (pointer dma-tag) next-tag))))
  ;; rendering of eyes.
  (dotimes (slot 11)
    ;; grab the eye and the process
    (let* ((ctrl (-> *eye-control-array* data slot))
           (proc (handle->process (-> ctrl process))))
      ;; see if we need the eye
      (when (and proc
                 (logtest? (-> (the-as process-drawable proc) skel status) (janim-status eye))
                 (logtest? (-> (the-as process-drawable proc) draw status) (draw-status was-drawn)))
        (when (-> ctrl shaders)
          ;; update blinking.
          ;; random-time counts down once per frame. While both lids are non-negative neither eye
          ;; wants an automatic blink, so the counter is parked at 60 and blink is held at zero.
          ;; Otherwise the last ten counts index blink-table, and reaching zero picks a fresh interval
          ;; of one to four seconds. The counter is stored in 60fps units and scaled on both sides of
          ;; the comparison, which is what keeps the blink the same length at a higher frame rate.
          (when (not (paused?))
            (cond
              ((and (>= (-> ctrl left lid) 0.0) (>= (-> ctrl right lid) 0.0))
               (set! (-> ctrl random-time)
                     (the int
                          (* (1/ DISPLAY_FPS_RATIO) ;; og:preserve-this changed for high fps
                             (the-as uint 60))))
               (set! (-> ctrl blink) 0.0))
              (else
               (+! (-> ctrl random-time) -1)
               (let ((blink-frame (the int (* DISPLAY_FPS_RATIO (-> ctrl random-time))))) ;; og:preserve-this changed for high fps
                 (when (< blink-frame (the-as uint 10))
                   (set! (-> ctrl blink) (-> *eye-work* blink-table blink-frame))
                   (if (zero? blink-frame)
                     (set! (-> ctrl random-time)
                           (the-as uint
                                   (the int
                                        (* (1/ DISPLAY_FPS_RATIO) ;; og:preserve-this changed for high fps
                                           (rand-vu-float-range 60.0 240.0)))))))))))
          ;; pick between level and common eyes.
          ;; level is the index of the level the process came from. Indices 0 and 1 are the two
          ;; resident levels and get the texture bucket in front of that level's merc draw; anything
          ;; else came from the common art group and shares the eyes bucket.
          (cond
            ((>= (the-as uint 1) (-> ctrl level))
             ;; level eyes
             (let* ((dma-buf (-> *display* frames (-> *display* on-screen) frame global-buf))
                    (bucket-start (-> dma-buf base)))
               (render-eyes dma-buf ctrl slot)
               (let ((next-tag (-> dma-buf base)))
                 (let ((dma-out (the-as object (-> dma-buf base))))
                   (set! (-> (the-as dma-packet dma-out) dma) (new 'static 'dma-tag :id (dma-tag-id next)))
                   (set! (-> (the-as dma-packet dma-out) vif0) (new 'static 'vif-tag))
                   (set! (-> (the-as dma-packet dma-out) vif1) (new 'static 'vif-tag))
                   (set! (-> dma-buf base) (&+ (the-as pointer dma-out) 16)))
                 (dma-bucket-insert-tag (-> *display* frames (-> *display* on-screen) frame bucket-group)
                                        (the-as bucket-id (if (zero? (-> ctrl level)) (bucket-id pris-tex0) (bucket-id pris-tex1)))
                                        bucket-start
                                        (the-as (pointer dma-tag) next-tag)))))
            (else
             (let* ((dma-buf (-> *display* frames (-> *display* on-screen) frame global-buf))
                    (bucket-start (-> dma-buf base)))
               (render-eyes dma-buf ctrl slot)
               (let ((next-tag (-> dma-buf base)))
                 (let ((dma-out (the-as object (-> dma-buf base))))
                   (set! (-> (the-as dma-packet dma-out) dma) (new 'static 'dma-tag :id (dma-tag-id next)))
                   (set! (-> (the-as dma-packet dma-out) vif0) (new 'static 'vif-tag))
                   (set! (-> (the-as dma-packet dma-out) vif1) (new 'static 'vif-tag))
                   (set! (-> dma-buf base) (&+ (the-as pointer dma-out) 16)))
                 (dma-bucket-insert-tag (-> *display* frames (-> *display* on-screen) frame bucket-group)
                                        (bucket-id eyes)
                                        bucket-start
                                        (the-as (pointer dma-tag) next-tag))))))))))
  ;; Restore the game framebuffer at the tail of each of the same three buckets. reset-display-gs-state
  ;; does not touch ALPHA_1, which the eyelid pass repointed, so the ordinary source-over equation is
  ;; written back by hand. These three blocks are identical apart from the bucket.
  (let* ((dma-buf (-> *display* frames (-> *display* on-screen) frame global-buf))
         (bucket-start (-> dma-buf base)))
    (reset-display-gs-state *display* dma-buf *oddeven*)
    (let* ((buf dma-buf)
           (dma-out (the-as object (-> buf base))))
      (set! (-> (the-as dma-packet dma-out) dma) (new 'static 'dma-tag :qwc #x2 :id (dma-tag-id cnt)))
      (set! (-> (the-as dma-packet dma-out) vif0) (new 'static 'vif-tag))
      (set! (-> (the-as dma-packet dma-out) vif1) (new 'static 'vif-tag :imm #x2 :cmd (vif-cmd direct) :msk #x1))
      (set! (-> buf base) (&+ (the-as pointer dma-out) 16)))
    (let* ((buf dma-buf)
           (gif-out (the-as object (-> buf base))))
      (set! (-> (the-as gs-gif-tag gif-out) tag) (new 'static 'gif-tag64 :nloop #x1 :eop #x1 :nreg #x1))
      (set! (-> (the-as gs-gif-tag gif-out) regs)
            (new 'static
                 'gif-tag-regs
                 :regs0 (gif-reg-id a+d)
                 :regs1 (gif-reg-id a+d)
                 :regs2 (gif-reg-id a+d)
                 :regs3 (gif-reg-id a+d)
                 :regs4 (gif-reg-id a+d)
                 :regs5 (gif-reg-id a+d)
                 :regs6 (gif-reg-id a+d)
                 :regs7 (gif-reg-id a+d)
                 :regs8 (gif-reg-id a+d)
                 :regs9 (gif-reg-id a+d)
                 :regs10 (gif-reg-id a+d)
                 :regs11 (gif-reg-id a+d)
                 :regs12 (gif-reg-id a+d)
                 :regs13 (gif-reg-id a+d)
                 :regs14 (gif-reg-id a+d)
                 :regs15 (gif-reg-id a+d)))
      (set! (-> buf base) (&+ (the-as pointer gif-out) 16)))
    (let* ((buf dma-buf)
           (reg-out (-> buf base)))
      (set! (-> (the-as (pointer gs-alpha) reg-out) 0) (new 'static 'gs-alpha :b #x1 :d #x1))
      (set! (-> (the-as (pointer gs-reg64) reg-out) 1) (gs-reg64 alpha-1))
      (set! (-> buf base) (&+ reg-out 16)))
    (let ((next-tag (-> dma-buf base)))
      (let ((dma-out (the-as object (-> dma-buf base))))
        (set! (-> (the-as dma-packet dma-out) dma) (new 'static 'dma-tag :id (dma-tag-id next)))
        (set! (-> (the-as dma-packet dma-out) vif0) (new 'static 'vif-tag))
        (set! (-> (the-as dma-packet dma-out) vif1) (new 'static 'vif-tag))
        (set! (-> dma-buf base) (&+ (the-as pointer dma-out) 16)))
      (dma-bucket-insert-tag (-> *display* frames (-> *display* on-screen) frame bucket-group)
                             (bucket-id pris-tex0)
                             bucket-start
                             (the-as (pointer dma-tag) next-tag))))
  (let* ((dma-buf (-> *display* frames (-> *display* on-screen) frame global-buf))
         (bucket-start (-> dma-buf base)))
    (reset-display-gs-state *display* dma-buf *oddeven*)
    (let* ((buf dma-buf)
           (dma-out (the-as object (-> buf base))))
      (set! (-> (the-as dma-packet dma-out) dma) (new 'static 'dma-tag :qwc #x2 :id (dma-tag-id cnt)))
      (set! (-> (the-as dma-packet dma-out) vif0) (new 'static 'vif-tag))
      (set! (-> (the-as dma-packet dma-out) vif1) (new 'static 'vif-tag :imm #x2 :cmd (vif-cmd direct) :msk #x1))
      (set! (-> buf base) (&+ (the-as pointer dma-out) 16)))
    (let* ((buf dma-buf)
           (gif-out (the-as object (-> buf base))))
      (set! (-> (the-as gs-gif-tag gif-out) tag) (new 'static 'gif-tag64 :nloop #x1 :eop #x1 :nreg #x1))
      (set! (-> (the-as gs-gif-tag gif-out) regs)
            (new 'static
                 'gif-tag-regs
                 :regs0 (gif-reg-id a+d)
                 :regs1 (gif-reg-id a+d)
                 :regs2 (gif-reg-id a+d)
                 :regs3 (gif-reg-id a+d)
                 :regs4 (gif-reg-id a+d)
                 :regs5 (gif-reg-id a+d)
                 :regs6 (gif-reg-id a+d)
                 :regs7 (gif-reg-id a+d)
                 :regs8 (gif-reg-id a+d)
                 :regs9 (gif-reg-id a+d)
                 :regs10 (gif-reg-id a+d)
                 :regs11 (gif-reg-id a+d)
                 :regs12 (gif-reg-id a+d)
                 :regs13 (gif-reg-id a+d)
                 :regs14 (gif-reg-id a+d)
                 :regs15 (gif-reg-id a+d)))
      (set! (-> buf base) (&+ (the-as pointer gif-out) 16)))
    (let* ((buf dma-buf)
           (reg-out (-> buf base)))
      (set! (-> (the-as (pointer gs-alpha) reg-out) 0) (new 'static 'gs-alpha :b #x1 :d #x1))
      (set! (-> (the-as (pointer gs-reg64) reg-out) 1) (gs-reg64 alpha-1))
      (set! (-> buf base) (&+ reg-out 16)))
    (let ((next-tag (-> dma-buf base)))
      (let ((dma-out (the-as object (-> dma-buf base))))
        (set! (-> (the-as dma-packet dma-out) dma) (new 'static 'dma-tag :id (dma-tag-id next)))
        (set! (-> (the-as dma-packet dma-out) vif0) (new 'static 'vif-tag))
        (set! (-> (the-as dma-packet dma-out) vif1) (new 'static 'vif-tag))
        (set! (-> dma-buf base) (&+ (the-as pointer dma-out) 16)))
      (dma-bucket-insert-tag (-> *display* frames (-> *display* on-screen) frame bucket-group)
                             (bucket-id pris-tex1)
                             bucket-start
                             (the-as (pointer dma-tag) next-tag))))
  (let* ((dma-buf (-> *display* frames (-> *display* on-screen) frame global-buf))
         (bucket-start (-> dma-buf base)))
    (reset-display-gs-state *display* dma-buf *oddeven*)
    (let* ((buf dma-buf)
           (dma-out (the-as object (-> buf base))))
      (set! (-> (the-as dma-packet dma-out) dma) (new 'static 'dma-tag :qwc #x2 :id (dma-tag-id cnt)))
      (set! (-> (the-as dma-packet dma-out) vif0) (new 'static 'vif-tag))
      (set! (-> (the-as dma-packet dma-out) vif1) (new 'static 'vif-tag :imm #x2 :cmd (vif-cmd direct) :msk #x1))
      (set! (-> buf base) (&+ (the-as pointer dma-out) 16)))
    (let* ((buf dma-buf)
           (gif-out (the-as object (-> buf base))))
      (set! (-> (the-as gs-gif-tag gif-out) tag) (new 'static 'gif-tag64 :nloop #x1 :eop #x1 :nreg #x1))
      (set! (-> (the-as gs-gif-tag gif-out) regs)
            (new 'static
                 'gif-tag-regs
                 :regs0 (gif-reg-id a+d)
                 :regs1 (gif-reg-id a+d)
                 :regs2 (gif-reg-id a+d)
                 :regs3 (gif-reg-id a+d)
                 :regs4 (gif-reg-id a+d)
                 :regs5 (gif-reg-id a+d)
                 :regs6 (gif-reg-id a+d)
                 :regs7 (gif-reg-id a+d)
                 :regs8 (gif-reg-id a+d)
                 :regs9 (gif-reg-id a+d)
                 :regs10 (gif-reg-id a+d)
                 :regs11 (gif-reg-id a+d)
                 :regs12 (gif-reg-id a+d)
                 :regs13 (gif-reg-id a+d)
                 :regs14 (gif-reg-id a+d)
                 :regs15 (gif-reg-id a+d)))
      (set! (-> buf base) (&+ (the-as pointer gif-out) 16)))
    (let* ((buf dma-buf)
           (reg-out (-> buf base)))
      (set! (-> (the-as (pointer gs-alpha) reg-out) 0) (new 'static 'gs-alpha :b #x1 :d #x1))
      (set! (-> (the-as (pointer gs-reg64) reg-out) 1) (gs-reg64 alpha-1))
      (set! (-> buf base) (&+ reg-out 16)))
    (let ((next-tag (-> dma-buf base)))
      (let ((dma-out (the-as object (-> dma-buf base))))
        (set! (-> (the-as dma-packet dma-out) dma) (new 'static 'dma-tag :id (dma-tag-id next)))
        (set! (-> (the-as dma-packet dma-out) vif0) (new 'static 'vif-tag))
        (set! (-> (the-as dma-packet dma-out) vif1) (new 'static 'vif-tag))
        (set! (-> dma-buf base) (&+ (the-as pointer dma-out) 16)))
      (dma-bucket-insert-tag (-> *display* frames (-> *display* on-screen) frame bucket-group)
                             (bucket-id eyes)
                             bucket-start
                             (the-as (pointer dma-tag) next-tag))))
  0
  (none))

(defun get-eye-block ((slot int) (eye-index int))
  "Return the GS block address of one eye's 32x32 texture. slot picks the tile in the shared eye
   render target and eye-index picks the left (0) or right (1) half of that tile. merc's adgif login
   stores the result in tex0 tbp0 for the two shaders an art group marked as eye materials.
   A tile is exactly one PSMCT32 page, so each slot advances 32 blocks. Inside the page the right eye
   begins at pixel x 32, which is block column 4 of the page's 8x4 block grid, and PSMCT32's block
   swizzle puts that at block 16.
   The PC renderer keys eye textures off an index rather than a VRAM address, so its path returns
   slot * 2 + eye-index."
  (#when PC_PORT
    ;; hack to make this easier to figure out on the PC side.
    (return (+ *eyes-base-block* (* slot 2) eye-index)))
  (let ((tile slot)
        (block-offset (-> ct32-24-block-table (* eye-index 4))))
    (+ *eyes-base-block* (* tile 32) block-offset)))

(defun convert-eye-data ((dest eye) (frame uint))
  "Unpack one packed eye keyframe into dest's two vectors. frame is a merc-eye-anim-frame read as a
   single doubleword. Bytes 0 to 2 are the signed pupil x, pupil y and blink values; they become
   data 0 at 1/128 per unit, so they span -1 to just under 1, and a negative blink is what asks
   render-eyes for the automatic eyelid blink. Bytes 4 to 6 are the unsigned iris, pupil and lid
   scales; they become data 1 at 1/64 per unit, spanning 0 to just under 4. Bytes 3 and 7 land in the
   two w lanes and nothing reads them.
   Each group is widened to 32-bit lanes with packed interleaves against zero and then shifted so the
   VU's fixed-point convert lands the value in the right place: there is no packed byte-to-float
   instruction, and both converts work on a whole quadword.
   The float return value is the iris scale, left in the register by the last transfer. No caller
   uses it."
  (local-vars
    (result float)
    (signed-halfwords uint128)
    (signed-words-hi uint128)
    (signed-words uint128)
    (unsigned-halfwords uint128)
    (unsigned-words uint128)
    (scaled-words uint128))
  (rlet ((vf1 :class vf)
         (vf2 :class vf))
    (.pextlb signed-halfwords frame 0)
    (.pextlh signed-words-hi signed-halfwords 0)
    (.pw.sra signed-words signed-words-hi 16)
    (.mov vf1 signed-words)
    (.pextlb unsigned-halfwords 0 frame)
    (.pextuh unsigned-words 0 unsigned-halfwords)
    (.pw.sll scaled-words unsigned-words 6)
    (.mov vf2 scaled-words)
    (vitof15.xyzw vf1 vf1)
    (vitof12.xyzw vf2 vf2)
    (.svf (&-> dest data 0 quad) vf1)
    (.svf (&-> dest data 1 quad) vf2)
    (.mov result vf2)
    result))

(defun merc-eye-anim ((proc process-drawable))
  "Sample proc's eye animation into its eye-control slot. Does nothing unless the skeleton is flagged
   for eye animation, its merc geometry carries a merc-eye-ctrl, channel 0 is playing a frame group,
   and that frame group has eye animation data.
   Publishes into the slot everything render-eyes needs that does not come from the animation: proc's
   handle, the three shaders of the eye material, and the index of the level proc belongs to.
   Then writes both eyes by interpolating the packed keyframes on either side of channel 0's frame
   number. Frame numbers past the last keyframe clamp to it, so an animation may end on a held eye
   pose."
  (let* ((eye-ctrl (-> proc draw mgeo header eye-ctrl))
         (chan (-> proc skel root-channel 0))
         (anim (-> chan frame-group)))
    (when (and (logtest? (-> proc skel status) (janim-status eye))
               (nonzero? eye-ctrl)
               (> (-> proc skel active-channels) 0)
               anim
               (nonzero? (-> anim eye-anim-data)))
      (let* ((ctrl (-> *eye-control-array* data (-> eye-ctrl eye-slot)))
             (frame0 (min (the int (-> chan frame-num)) (-> anim eye-anim-data max-frame)))
             (frame1 (min (+ (the int (-> chan frame-num)) 1) (-> anim eye-anim-data max-frame)))
             (frame-num (-> chan frame-num))
             (blend (- frame-num (* (the float (the int (/ frame-num 1.0))) 1.0))))
        (set! (-> ctrl process) (process->handle proc))
        (set! (-> ctrl shaders) (the-as (inline-array adgif-shader) (-> eye-ctrl iris-shader)))
        (set! (-> ctrl level)
              (the-as uint (-> (if (-> proc entity) (-> proc entity extra level) (-> *level* level-default)) index)))
        (let ((sample0 (new 'stack-no-clear 'eye))
              (sample1 (new 'stack-no-clear 'eye)))
          (cond
            ((-> anim eye-anim-data)
             (convert-eye-data sample0 (-> anim eye-anim-data data (* frame0 2) dword))
             (convert-eye-data sample1 (-> anim eye-anim-data data (* frame1 2) dword))
             ;; each pair of lerps writes one eye's two vectors in place. 96 is the eye-control
             ;; stride, so these addresses are the left and right eye of data[eye-slot].
             (vector4-lerp! (the-as vector (+ (the-as uint (-> *eye-control-array* data 0 left)) (* 96 (-> eye-ctrl eye-slot))))
                            (the-as vector (-> sample0 data))
                            (the-as vector (-> sample1 data))
                            blend)
             (vector4-lerp! (the-as vector (+ (the-as uint (-> *eye-control-array* data 0 left data 1)) (* 96 (-> eye-ctrl eye-slot))))
                            (-> sample0 data 1)
                            (-> sample1 data 1)
                            blend)
             (convert-eye-data sample0 (-> anim eye-anim-data data (+ (* frame0 2) 1) dword))
             (convert-eye-data sample1 (-> anim eye-anim-data data (+ (* frame1 2) 1) dword))
             (vector4-lerp! (the-as vector (+ (the-as uint (-> *eye-control-array* data 0 right)) (* 96 (-> eye-ctrl eye-slot))))
                            (the-as vector (-> sample0 data))
                            (the-as vector (-> sample1 data))
                            blend)
             (vector4-lerp! (the-as vector (+ (the-as uint (-> *eye-control-array* data 0 right data 1)) (* 96 (-> eye-ctrl eye-slot))))
                            (-> sample0 data 1)
                            (-> sample1 data 1)
                            blend))
            ;; Looking straight ahead with unit scales, for a frame group with no eye animation. The
            ;; test above the whole block already required eye-anim-data, so nothing reaches this.
            (else
             (let ((default-ctrl (-> *eye-control-array* data (-> eye-ctrl eye-slot))))
               (set! (-> default-ctrl left data 0 x) 0.0)
               (set! (-> default-ctrl left data 0 y) 0.0)
               (set! (-> default-ctrl left data 0 z) -1.0)
               (set! (-> default-ctrl left data 1 x) 1.0)
               (set! (-> default-ctrl left data 1 y) 1.0)
               (set! (-> default-ctrl left data 1 z) 1.0)
               (set! (-> default-ctrl right data 0 x) 0.0)
               (set! (-> default-ctrl right data 0 y) 0.0)
               (set! (-> default-ctrl right data 0 z) -1.0)
               (set! (-> default-ctrl right data 1 x) 1.0)
               (set! (-> default-ctrl right data 1 y) 1.0)
               (set! (-> default-ctrl right data 1 z) 1.0))))))
      ;; eye-done is set and then cleared again on the way out, so it is never observable outside
      ;; this function.
      (logior! (-> proc skel status) (janim-status eye-done))))
  (if (logtest? (-> proc skel status) (janim-status eye-done)) (logclear! (-> proc skel status) (janim-status eye-done)))
  0
  (none))

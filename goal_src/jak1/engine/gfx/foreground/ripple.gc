;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/gfx/hw/display-h.gc")
(require "engine/math/quaternion.gc")
(require "engine/gfx/merc/merc-h.gc")
(require "kernel/gkernel-h.gc")
(require "engine/game/game-h.gc")
(define-extern ripple-create-wave-table (function ripple-wave-set int))

(define-extern ripple-apply-wave-table (function merc-effect symbol))

;; DECOMP BEGINS

(deftype ripple-request (structure)
  ((waveform ripple-wave-set)
   (effect   merc-effect))
  :pack-me)

(deftype ripple-globals (structure)
  ((count    int32)
   (requests ripple-request 16 :inline)))

(define *ripple-globals* (new 'global 'ripple-globals))

(defun ripple-make-request ((waveform ripple-wave-set) (effect merc-effect))
  "Queue an effect to receive a waveform during this frame. Ignore duplicate effects and requests
   beyond the sixteen-entry buffer."
  (let ((request-count (-> *ripple-globals* count))
        (requests (-> *ripple-globals* requests))
        (already-queued 0))
    (when (< request-count 16)
      (dotimes (i request-count)
        (if (= effect (-> requests i effect))
            (set! already-queued 1)))
      (when (zero? already-queued)
        (set! (-> requests request-count effect) effect)
        (set! (-> requests request-count waveform) waveform)
        (+! (-> *ripple-globals* count) 1))))
  0
  (none))

(defun ripple-update-waveform-offs ((wave-set ripple-wave-set))
  "Advance every wave's 16-bit phase by the number of display frames since the wave set was last
   updated. The PC port scales the advance for high frame rates so the animation retains its original
   speed."
  (let ((elapsed-frames (the float (- (-> *display* integral-frame-counter) (the-as int (-> wave-set frame-save))))))
    (when (!= elapsed-frames 0.0)
      (dotimes (i (-> wave-set count))
        (let ((wave (-> wave-set wave i)))
          ;; og:preserve-this scale the phase step to retain the original speed above 60 Hz
          (+! (-> wave offs) (* elapsed-frames (* DISPLAY_FPS_RATIO (-> wave delta))))
          (set! (-> wave offs) (the float (logand (the int (-> wave offs)) #xffff)))))
      (set! (-> wave-set frame-save) (the-as uint (-> *display* integral-frame-counter)))))
  0
  (none))

;; Ripple generation uses VU0 data memory for its cosine interpolation table and the scratchpad for
;; the 16 by 16 height/normal field. The EE versions retain the vector pipeline and packed vertex
;; writes used by the renderer.
(#unless PC_PORT
  (defun ripple-execute-init ()
    "Build the 256-entry VU0 cosine table used while generating ripple vertices. Each entry holds one
     cosine sample and the delta to the next sample, allowing linear interpolation between samples."
    (declare (asm-func none))
    (rlet ((coefficients :reg vf7)
           (phase-step :reg vf6)
           (phase :reg vf5)
           (sample :reg vf9)
           (negated-sample :reg vf10)
           (phase-squared :reg vf1)
           (phase-fourth :reg vf2)
           (phase-sixth :reg vf3)
           (phase-eighth :reg vf4)
           (next-sample :reg vf8)
           (positive-address :reg vi1)
           (negative-address :reg vi2)
           (count :reg v1)
           (result :reg v0))
      (add.i sp sp -16)
      (s.d fp sp 8)
      (m fp t9)
      (l.vf coefficients *cos-poly-vec*)
      (m! phase-step 0.024543691)
      (m! negative-address 128)
      (m! sample 1.0)
      (iaddi positive-address vi0 0)
      (add.i count r0 128)
      (move.vf phase phase-step)
      (label build-cosine-table)
      ;; Evaluate the cosine polynomial at the next phase. sample.y keeps the difference from the
      ;; preceding sample so a fractional table index can interpolate with one multiply-add.
      (mul.vf phase-squared phase phase)
      (adda.w.vf vf0 vf0)
      (add.x.vf.x phase phase phase-step)
      (sub.x.vf.y sample vf0 sample)
      (mul.vf phase-fourth phase-squared phase-squared)
      (madda.x.vf phase-squared coefficients)
      (mul.vf phase-sixth phase-fourth phase-squared)
      (madda.y.vf phase-fourth coefficients)
      (mul.vf phase-eighth phase-fourth phase-fourth)
      (madda.z.vf phase-sixth coefficients)
      (add.i count count -1)
      (madd.w.vf next-sample phase-eighth coefficients)
      (add.x.vf.y sample sample next-sample)
      (sub.vf negated-sample vf0 sample)
      (sqi.vf sample positive-address)
      (move.vf sample next-sample)
      (b.nz count build-cosine-table :delay (sqi.vf negated-sample negative-address))
      (m result r0)
      (jr ra :delay (add.i sp sp 16))
      (nop!)
      (nop!)))
  (defun ripple-create-wave-table ((wave-set ripple-wave-set))
    "Convert an uninitialized wave set's directions and speeds, advance its phases, and sum its waves
     into a 16 by 16 scratchpad height field. Pack the height and forward-difference x/z slopes into
     unsigned bytes based at 128; neighbor reads wrap at the field edges so the table tiles."
    (declare (asm-func int) (allow-saved-regs))
    (add.i sp sp -80)
    (s.d ra sp)
    (s.d fp sp 8)
    (m fp t9)
    (s.q s4 sp 16)
    (s.q s5 sp 32)
    (s.q gp sp 48)
    (s.s f28 sp 64)
    (s.s f30 sp 68)
    (m gp wave-set)
    ;; Convert the authoring controls once. xdiv/zdiv select the travel direction and wavelength;
    ;; speed becomes a negative 16-bit phase step per video frame.
    (l.wu v1 gp 4)
    (b.ne s7 v1 ripple-wave-set-ready :delay (m v1 s7))
    (add.i s5 r0 0)
    (b ripple-convert-test :delay (nop!))
    (label ripple-convert-wave)
    (add.i v1 r0 28)
    (mult3 v1 v1 s5)
    (add.i v1 v1 16)
    (add s4 v1 gp)
    (m! t9 atan)
    (l.h v1 s4 10)
    (m f0 v1)
    (cvt.s.w f0 f0)
    (m a0 f0)
    (l.h v1 s4 8)
    (m f0 v1)
    (cvt.s.w f0 f0)
    (m a1 f0)
    (jalr ra t9 :delay (sll v0 ra 0))
    (m f28 v0)
    (m! f0 16.0)
    (l.h v1 s4 8)
    (l.h a0 s4 8)
    (mult3 v1 v1 a0)
    (l.h a0 s4 10)
    (l.h a1 s4 10)
    (mult3 a0 a0 a1)
    (add v1 v1 a0)
    (m f1 v1)
    (cvt.s.w f1 f1)
    (sqrt.s f1 f1)
    (div.s f30 f0 f1)
    (m! t9 cos)
    (m a0 f28)
    (jalr ra t9 :delay (sll v0 ra 0))
    (m f0 v0)
    (m! f1 65536.0)
    (div.s f1 f1 f30)
    (mul.s f0 f0 f1)
    (s.s f0 s4 16)
    (m! t9 sin)
    (m a0 f28)
    (jalr ra t9 :delay (sll v0 ra 0))
    (m f0 v0)
    (m! f1 65536.0)
    (div.s f1 f1 f30)
    (mul.s f0 f0 f1)
    (s.s f0 s4 20)
    (m! v1 *setting-control*)
    (l.wu v1 v1 80)
    (m! a0 'ntsc)
    (b.ne v1 a0 ripple-check-pal :delay (m a0 s7))
    (m! f0 0.016666668)
    (m! f1 -65536.0)
    (div.s f1 f1 f30)
    (mul.s f0 f0 f1)
    (l.s f1 s4 12)
    (mul.s f0 f0 f1)
    (s.s f0 s4 24)
    (m v1 f0)
    (b ripple-convert-next :delay (nop!))
    (label ripple-check-pal)
    (m! a0 'pal)
    (b.ne v1 a0 ripple-convert-next :delay (m v1 s7))
    (m! f0 0.02)
    (m! f1 -65536.0)
    (div.s f1 f1 f30)
    (mul.s f0 f0 f1)
    (l.s f1 s4 12)
    (mul.s f0 f0 f1)
    (s.s f0 s4 24)
    (m v1 f0)
    (label ripple-convert-next)
    (add.i s5 s5 1)
    (label ripple-convert-test)
    (l.w v1 gp)
    (slt v1 s5 v1)
    (b.nz v1 ripple-convert-wave :delay (nop!))
    (m v1 s7)
    (m v1 s7)
    (m! v1 #t)
    (s.w v1 gp 4)
    (label ripple-wave-set-ready)
    (m! t9 ripple-update-waveform-offs)
    (m a0 gp)
    (jalr ra t9 :delay (sll v0 ra 0))
    ;; Clear the 256-float accumulation grid in the first 1024 bytes of scratchpad.
    (lui v1 #x7000)
    (add.i a0 r0 64)
    (m a1 v1)
    (label ripple-clear-grid)
    (add.i a0 a0 -1)
    (s.q r0 a1)
    (nop!)
    (nop!)
    (nop!)
    (nop!)
    (b.nz a0 ripple-clear-grid :delay (add.i a1 a1 16))
    ;; Add every wave to all 256 samples. The integer part of the phase selects VU0's cosine
    ;; table; the fractional part multiplies the stored delta to interpolate between entries.
    (add.i a0 r0 0)
    (b ripple-sum-wave-test :delay (nop!))
    (label ripple-sum-wave)
    (add.i a1 r0 28)
    (mult3 a1 a1 a0)
    (add.i a1 a1 16)
    (add a1 a1 gp)
    (m! f0 16384.0)
    (m! f1 0.00390625)
    (l.s f2 a1 4)
    (mul.s f1 f1 f2)
    (add.s f0 f0 f1)
    (m! f1 0.00390625)
    (l.s f2 a1 16)
    (mul.s f1 f1 f2)
    (m! f2 0.00390625)
    (l.s f3 a1 20)
    (mul.s f2 f2 f3)
    (l.s f3 a1)
    (add.i a1 r0 255)
    (m a2 f0)
    (m vf1 a2)
    (m a2 f1)
    (m vf2 a2)
    (m a2 f2)
    (m vf3 a2)
    (m a2 f3)
    (m vf4 a2)
    (m vi1 a1)
    (m a1 v1)
    (add.i a2 r0 16)
    (move.vf vf6 vf0)
    (label ripple-sum-row)
    (add.i a3 r0 16)
    (move.vf vf5 vf0)
    (label ripple-sum-column)
    (l.w at a1)
    (adda.x.vf vf1 vf0)
    (madda.vf vf2 vf5)
    (madd.vf vf7 vf3 vf6)
    (m vf10 at)
    (add.w.vf vf5 vf5 vf0)
    (ftoi.vf vf8 vf7)
    (mtir.x vi2 vf8)
    (itof.vf vf8 vf8)
    (iand vi2 vi2 vi1)
    (lqi.vf vf9 vi2)
    (sub.vf vf7 vf7 vf8)
    (adda.x.vf vf0 vf9)
    (madd.y.vf vf9 vf7 vf9)
    (adda.x.vf vf10 vf0)
    (madd.vf vf10 vf9 vf4)
    (m at vf10)
    (s.w at a1)
    (add.i a3 a3 -1)
    (b.nz a3 ripple-sum-column :delay (add.i a1 a1 4))
    (add.i a2 a2 -1)
    (b.nz a2 ripple-sum-row :delay (add.w.vf vf6 vf6 vf0))
    (m a1 vf6)
    (add.i a0 a0 1)
    (label ripple-sum-wave-test)
    (l.w a1 gp)
    (slt a1 a0 a1)
    (b.nz a1 ripple-sum-wave :delay (nop!))
    (m a0 s7)
    (m a0 s7)
    ;; Pack each height and its forward x/z differences. The last column and row wrap to the first,
    ;; giving the field identical values and slopes on opposite edges.
    (m! f1 128.0)
    (m! f0 255.0)
    (l.s f2 gp 12)
    (m a0 f2)
    (m vf16 a0)
    (m a0 f1)
    (m vf14 a0)
    (m a0 f0)
    (m vf15 a0)
    (max.x.vf vf16 vf0 vf16)
    (min.x.vf.w vf16 vf0 vf0)
    (m v1 v1)
    (add.i v0 r0 15)
    (label ripple-pack-row)
    (add.i a0 r0 15)
    (nop!)
    (label ripple-pack-column)
    (add.i a2 r0 4)
    (add.i at r0 -60)
    (mov.z a2 at a0)
    (add.i a1 r0 64)
    (add.i at r0 -960)
    (add a2 a2 v1)
    (mov.z a1 at v0)
    (l.w at v1)
    (l.w a2 a2)
    (add a1 a1 v1)
    (l.w a1 a1)
    (m vf11 at)
    (m vf12 a2)
    (m vf13 a1)
    (add.x.vf vf11 vf0 vf11)
    (sub.x.vf.y vf11 vf11 vf12)
    (sub.x.vf.z vf11 vf11 vf13)
    (mul.vf.yzw vf11 vf11 vf16)
    (add.x.vf vf11 vf11 vf14)
    (max.x.vf vf11 vf11 vf0)
    (min.x.vf vf11 vf11 vf15)
    (ftoi.vf vf11 vf11)
    (m at vf11)
    (ppach at at at)
    (ppacb at at at)
    (s.w at v1 1024)
    (add.i v1 v1 4)
    (b.nz a0 ripple-pack-column :delay (add.i a0 a0 -1))
    (b.nz v0 ripple-pack-row :delay (add.i v0 v0 -1))
    (l.d ra sp)
    (l.d fp sp 8)
    (l.s f30 sp 68)
    (l.s f28 sp 64)
    (l.q gp sp 48)
    (l.q s5 sp 32)
    (l.q s4 sp 16)
    (jr ra :delay (add.i sp sp 80))
    (nop!)
    (nop!))
  (defun ripple-apply-wave-table ((effect merc-effect))
    "Patch one MERC effect's packed vertices from the current ripple table. Each two-byte query
     selects a table entry with its low nibbles; the entry supplies the vertex's y byte and x/z normal
     bytes. Fragment geometry, query, and control streams advance according to their packed counts."
    (declare (asm-func symbol))
    (rlet ((table)
           (fragment-control)
           (fragment-geometry)
           (queries)
           (blend-control)
           (fragment-count)
           (fragment-index)
           (vertex-count)
           (unsigned-four-count)
           (vertex-data)
           (vertex-data-cursor)
           (query-cursor)
           (vertices-left)
           (query-x)
           (query-z)
           (table-index)
           (table-entry)
           (height)
           (normal-x)
           (normal-z)
           (advance)
           (test)
           (result :reg v0))
      (lui table #x7000)
      (add.i table table 1024)
      (l.wu fragment-control effect 4)
      (l.wu fragment-geometry effect)
      (l.wu queries effect 8)
      (l.wu blend-control effect 12)
      (l.hu fragment-count effect 18)
      (add.i fragment-index r0 0)
      (b apply-next-fragment :delay (nop!))
      (label apply-fragment)
      (l.bu vertex-count blend-control)
      ;; The unsigned section precedes the twelve-byte packed vertices in each geometry fragment.
      (l.bu unsigned-four-count fragment-control)
      (add.i advance unsigned-four-count 3)
      (srl advance advance 2)
      (sll advance advance 4)
      (add fragment-geometry fragment-geometry advance)
      (m vertex-data fragment-geometry)
      (m vertices-left vertex-count)
      (m vertex-data-cursor vertex-data)
      (m query-cursor queries)
      (label apply-vertex)
      ;; Two low nibbles select one of the 256 toroidal grid samples.
      (l.b query-x query-cursor)
      (l.b query-z query-cursor 1)
      (and.i query-x query-x #xf)
      (and.i query-z query-z #xf)
      (sll query-z query-z 4)
      (add table-index query-x query-z)
      (sll table-index table-index 2)
      (add table-entry table table-index)
      (l.b height table-entry)
      (l.b normal-x table-entry 1)
      (l.b normal-z table-entry 2)
      (s.b height vertex-data-cursor 7)
      (s.b normal-x vertex-data-cursor 2)
      (s.b normal-z vertex-data-cursor 10)
      (add.i vertices-left vertices-left -1)
      (add.i query-cursor query-cursor 2)
      (b.nz vertices-left apply-vertex :delay (add.i vertex-data-cursor vertex-data-cursor 12))
      ;; Step over the remaining packed geometry, fragment control, aligned query bytes, and the
      ;; two-byte per-fragment blend control entry.
      (l.bu advance fragment-control 2)
      (l.bu test fragment-control 1)
      (add.i test test 3)
      (srl test test 2)
      (add advance advance test)
      (sll advance advance 4)
      (add fragment-geometry fragment-geometry advance)
      (l.bu advance fragment-control 3)
      (sll advance advance 1)
      (add.i advance advance 4)
      (add fragment-control fragment-control advance)
      (sll vertex-count vertex-count 1)
      (add.i vertex-count vertex-count 15)
      (and.i vertex-count vertex-count #xfff0)
      (add queries queries vertex-count)
      (add.i blend-control blend-control 2)
      (add.i fragment-index fragment-index 1)
      (label apply-next-fragment)
      (slt test fragment-index fragment-count)
      (b.nz test apply-fragment :delay (nop!))
      (m result s7)
      (jr ra :delay (add sp sp r0))
      (nop!)
      (nop!)))
  (defun ripple-matrix-scale ((source pointer)
          (count int)
          (subtract-scale float)
          (primary-scale float)
          (secondary-scale float)
          (destination pointer))
    "Copy count 128-byte records from source to destination. Qwords at offsets 0, 32, and 80 are
     copied unchanged; the vector at 16 is scaled by primary-scale, the vector at 48 has the original
     16 vector times subtract-scale removed, and the vectors at 64 and 96 are scaled by secondary-scale."
    (declare (asm-func none))
    (rlet ((primary :reg vf1)
           (subtract :reg vf2)
           (secondary :reg vf3)
           (source-16 :reg vf5)
           (source-48 :reg vf6)
           (source-64 :reg vf7)
           (source-96 :reg vf8)
           (scaled-subtract :reg vf4)
           (copy-0 :type i128)
           (copy-32 :type i128)
           (copy-80 :type i128)
           (result :reg v0))
      (m primary primary-scale)
      (m subtract subtract-scale)
      (m secondary secondary-scale)
      (label copy-ripple-record)
      (l.vf source-16 source 16)
      (l.vf source-48 source 48)
      (l.vf source-64 source 64)
      (l.vf source-96 source 96)
      (mul.x.vf scaled-subtract source-16 subtract)
      (mul.x.vf source-16 source-16 primary)
      (l.q copy-0 source)
      (mul.x.vf source-64 source-64 secondary)
      (l.q copy-32 source 32)
      (mul.x.vf source-96 source-96 secondary)
      (s.q copy-0 destination)
      (l.q copy-80 source 80)
      (sub.vf source-48 source-48 scaled-subtract)
      (s.q copy-32 destination 32)
      (s.vf source-16 destination 16)
      (s.q copy-80 destination 80)
      (add.i count count -1)
      (s.vf source-64 destination 64)
      (add.i source source 128)
      (s.vf source-48 destination 48)
      (add.i destination destination 128)
      (b.nz count copy-ripple-record :delay (s.vf source-96 destination -32))
      (m result r0)
      (jr ra :delay (add sp sp r0))
      (nop!)
      (nop!)
      (nop!))))

;; Plain-GOAL ripple implementation.
(deftype ripple-cosine-table (structure)
  ((entry vector 256 :inline)))

(define *ripple-cosine-table* (new 'global 'ripple-cosine-table))

(defun ripple-cosine-table-init ((table ripple-cosine-table))
  "Build the cosine interpolation table used by the plain-GOAL ripple generator. The first half
   covers zero through pi; negated copies in the second half complete the cycle."
  (let ((phase-step 0.024543691)
        (phase 0.024543691)
        (sample 1.0))
    (dotimes (i 128)
      ;; Match the original degree-eight cosine polynomial. Keeping the delta beside each sample
      ;; lets the table generator linearly interpolate the low eight phase bits.
      (let* ((phase-squared (square phase))
             (phase-fourth (square phase-squared))
             (phase-sixth (* phase-fourth phase-squared))
             (phase-eighth (square phase-fourth))
             (next-sample (+ 1.0
                             (* phase-squared (-> *cos-poly-vec* x))
                             (* phase-fourth (-> *cos-poly-vec* y))
                             (* phase-sixth (-> *cos-poly-vec* z))
                             (* phase-eighth (-> *cos-poly-vec* w))))
             (delta (- next-sample sample))
             (positive-entry (-> table entry i))
             (negative-entry (-> table entry (+ i 128))))
        (set! (-> positive-entry x) sample)
        (set! (-> positive-entry y) delta)
        (set! (-> negative-entry x) (- sample))
        (set! (-> negative-entry y) (- delta))
        (set! sample next-sample)
        (+! phase phase-step))))
  (none))

(ripple-cosine-table-init *ripple-cosine-table*)

(defun ripple-execute-init ()
  ;; nothing to initialize in the re-written ripple implementation.
  (none))

(defun ripple-create-wave-table ((wave-set ripple-wave-set))
  "Sum the wave set into a 16 by 16 height grid, then pack height and x/z slopes into the
   scratchpad table consumed by MERC vertices. The grid wraps in both directions so it tiles."
  ;; Build wave deltas
  (when (not (-> wave-set converted))
    (dotimes (i (-> wave-set count))
      (let* ((wave (-> wave-set wave i))
             (direction (atan (the float (-> wave zdiv)) (the float (-> wave xdiv))))
             (wavelength (/ 16.0
                            (sqrtf (the float (+ (square (the int (-> wave xdiv)))
                                                   (square (the int (-> wave zdiv))))))))
             (phase-per-cell (/ 65536.0 wavelength)))
        (set! (-> wave xmul) (* (cos direction) phase-per-cell))
        (set! (-> wave zmul) (* (sin direction) phase-per-cell))
        (cond
          ((= (-> *setting-control* current video-mode) 'ntsc)
           (set! (-> wave delta) (* 0.016666668 (- phase-per-cell) (-> wave speed))))
          ((= (-> *setting-control* current video-mode) 'pal)
           (set! (-> wave delta) (* 0.02 (- phase-per-cell) (-> wave speed)))))))
    (set! (-> wave-set converted) #t))

  ;; update wave phases
  (ripple-update-waveform-offs wave-set)
  (let ((heights (scratchpad-ptr float))
        (packed-table (scratchpad-ptr uint8 :offset 1024)))
    
    ;; initialize heights to zero
    (dotimes (grid-index 256)
      (set! (-> heights grid-index) 0.0))

    ;; Add each wave to the height table
    (dotimes (wave-index (-> wave-set count))
      (let* ((wave (-> wave-set wave wave-index))
             (phase-base (+ 16384.0 (* 0.00390625 (-> wave offs))))
             (phase-x-step (* 0.00390625 (-> wave xmul)))
             (phase-z-step (* 0.00390625 (-> wave zmul))))
        (dotimes (grid-z 16)
          (dotimes (grid-x 16)
            (let* ((grid-index (+ grid-x (* grid-z 16)))
                   (phase (+ phase-base
                             (* (the float grid-x) phase-x-step)
                             (* (the float grid-z) phase-z-step)))
                   (table-index (the int phase))
                   (fraction (- phase (the float table-index)))
                   (entry (-> *ripple-cosine-table* entry (logand table-index #xff)))
                   (sample (+ (-> entry x) (* fraction (-> entry y)))))
              (+! (-> heights grid-index) (* sample (-> wave scale))))))))

    ;; Create packed vertex data in MERC vertex format [pos-y, nrm-x, nrm-z, PAD] 
    (dotimes (grid-z 16)
      (dotimes (grid-x 16)
        (let* ((grid-index (+ grid-x (* grid-z 16)))
               (right-index (+ (mod (+ grid-x 1) 16) (* grid-z 16)))
               (down-index (+ grid-x (* (mod (+ grid-z 1) 16) 16)))
               (height (-> heights grid-index))
               (normal-scale (fmax 0.0 (-> wave-set normal-scale)))
               (packed-index (* grid-index 4)))
          ;; height
          (set! (-> packed-table packed-index)
                (the-as uint (the int (fmax 0.0 (fmin 255.0 (+ 128.0 height))))))
          ;; finite difference to get normal X
          (set! (-> packed-table (+ packed-index 1))
                (the-as uint
                        (the int
                             (fmax 0.0
                                   (fmin 255.0
                                         (+ 128.0 (* normal-scale (- height (-> heights right-index)))))))))
          ;; finite difference to get normal Y
          (set! (-> packed-table (+ packed-index 2))
                (the-as uint
                        (the int
                             (fmax 0.0
                                   (fmin 255.0
                                         (+ 128.0 (* normal-scale (- height (-> heights down-index)))))))))
          (set! (-> packed-table (+ packed-index 3)) 128))))
  0))

(defun ripple-apply-wave-table ((effect merc-effect))
  "Patch the packed height and normal bytes of every rippled MERC vertex. Each two-byte query uses
   its low nibbles as x/z coordinates in the 16 by 16 table."
  (let ((packed-table (scratchpad-ptr uint8 :offset 1024))
        (fragment (-> effect frag-geo))
        (fragment-control (-> effect frag-ctrl))
        (queries (the-as (pointer uint8) (-> effect blend-data)))
        (blend-control (-> effect blend-ctrl)))
    (dotimes (fragment-index (the-as int (-> effect frag-count)))
      (let* ((vertex-count (-> blend-control blend-vtx-count))
             ;; Unsigned-four data is qword-aligned immediately before the packed vertices.
             (vertex-data (the-as merc-vtx
                                  (&+ (the-as pointer fragment)
                                      (logand (* (+ (-> fragment-control unsigned-four-count) 3) 4)
                                              #xfff0)))))
        (dotimes (vertex-index (the-as int vertex-count))
          (let* ((table-x (logand (-> queries (* vertex-index 2)) #xf))
                 (table-z (logand (-> queries (+ (* vertex-index 2) 1)) #xf))
                 (table-index (* (+ table-x (* table-z 16)) 4))
                 (vertex (the-as merc-vtx
                                 (&+ (the-as pointer vertex-data) (* vertex-index 12)))))
            (set! (-> vertex pos-y) (-> packed-table table-index))
            (set! (-> vertex nrm-x) (-> packed-table (+ table-index 1)))
            (set! (-> vertex nrm-z) (-> packed-table (+ table-index 2)))))

        ;; Advance the four packed streams independently; their fragment records have different
        ;; alignment and variable-length tails.
        (set! fragment
              (the-as merc-fragment
                      (&+ (the-as pointer vertex-data)
                          (* (+ (-> fragment-control fp-qwc)
                                (/ (+ (-> fragment-control lump-four-count) 3) 4))
                             16))))
        (set! fragment-control
              (the-as merc-fragment-control
                      (&+ (the-as pointer fragment-control)
                          (+ 4 (* (-> fragment-control mat-xfer-count) 2)))))
        (set! queries
              (the-as (pointer uint8)
                      (&+ queries (logand (+ (* vertex-count 2) 15) #xfff0))))
        (set! blend-control (the-as merc-blend-ctrl (&+ (the-as pointer blend-control) 2))))))
  #f)

(defun ripple-execute ()
  "Build each requested waveform table once, apply it to every queued effect that shares that
   waveform, and clear the request list."
  (when (-> *ripple-globals* count)
    (ripple-execute-init)
    (let ((request-index 0)
          (request-count (-> *ripple-globals* count))
          (requests (-> *ripple-globals* requests)))
      (while (!= request-index request-count)
        (when (-> requests request-index waveform)
          (let ((match-index request-index)
                (waveform (-> requests request-index waveform)))
            ;; og:preserve-this changed for high fps, use ntsc for table
            (protect ((-> *setting-control* current video-mode))
              (when (= (-> *setting-control* current video-mode) 'custom)
                (set! (-> *setting-control* current video-mode) 'ntsc))
                (ripple-create-wave-table waveform))
            (while (!= match-index request-count)
              (when (= waveform (-> requests match-index waveform))
                  (ripple-apply-wave-table (-> requests match-index effect))
                (set! (-> requests match-index waveform) #f))
              (+! match-index 1))))
        (+! request-index 1)))
    (set! (-> *ripple-globals* count) 0)
    0)
  (none))

(defun-debug ripple-add-debug-sphere ((drawable process-drawable) (grid-point vector) (x-slope float) (z-slope float))
  "Transform one local ripple-grid point by the drawable's inverse yaw and root translation, then
   draw a debug sphere at the resulting world position. x-slope and z-slope displace the local x/z
   coordinates in proportion to the point's z component."
  (let ((negative-yaw (- (quaternion-y-angle (-> drawable root quat))))
        (world-position (new-stack-vector0)))
    (let ((local-x (+ (-> grid-point x) (* x-slope (-> grid-point z))))
          (local-z (+ (-> grid-point y) (* z-slope (-> grid-point z)))))
      (set! (-> world-position x) (- (* local-x (cos negative-yaw)) (* local-z (sin negative-yaw))))
      (set! (-> world-position y) 0.0)
      (set! (-> world-position z) (+ (* local-z (cos negative-yaw)) (* local-x (sin negative-yaw)))))
    (set! (-> world-position w) 0.0)
    (vector+! world-position world-position (-> drawable root trans))
    (add-debug-sphere #t (bucket-id debug) world-position 2048.0 (new 'static 'rgba :r #xff :g #xff :a #x80)))
  (none))

(defun ripple-slow-add-sine-waves ((wave-set ripple-wave-set) (grid-x float) (grid-z float))
  "Evaluate every wave at one grid coordinate, sum the scaled cosines, and clamp the height to the
   signed-byte range used by the packed ripple table."
  (let ((height 0.0))
    (dotimes (i (-> wave-set count))
      (let* ((wave (-> wave-set wave i))
             (phase (+ (-> wave offs) (* grid-x (-> wave xmul)) (* grid-z (-> wave zmul)))))
        (+! height (* (-> wave scale) (cos phase)))))
    (fmax -127.0 (fmin 127.0 height))))

(defun ripple-find-height ((drawable process-drawable) (unused int) (point vector))
  "Return the ripple surface height at point for a drawable whose first MERC effect is rippled.
   Transform the point into the effect's grid, evaluate the four surrounding wave samples, bilinearly
   interpolate them, and apply the drawable's faded or global ripple scale. The integer argument is
   reserved and currently unused."
  (let* ((base-height (-> drawable root trans y))
         (draw (-> drawable draw))
         (effects (-> draw lod-set lod (-> draw cur-lod) geo effect)))
    (if (or (not (logtest? (-> effects 0 effect-bits) (effect-bits ripple))) (not (-> draw ripple))) (return base-height))
    (let* ((extra-info (-> effects 0 extra-info))
           (ripple-info (the-as mei-ripple (+ (the-as uint extra-info) (* (-> extra-info ripple-offset) 16))))
           (ripple-control (-> draw ripple))
           (wave-set (-> ripple-control waveform)))
      (if (not (-> ripple-control waveform)) (return base-height))
      (if (not (-> wave-set converted)) (return base-height))
      (let* ((local-x (- (-> point x) (-> drawable root trans x)))
             (local-z (- (-> point z) (-> drawable root trans z)))
             (grid-angle (+ (quaternion-y-angle (-> drawable root quat)) (-> ripple-info angle)))
             (angle-cos (cos grid-angle))
             (angle-sin (sin grid-angle))
             (rotated-x (- (* local-x angle-cos) (* local-z angle-sin)))
             (rotated-z (+ (* local-z angle-cos) (* local-x angle-sin)))
             (inverse-grid-size (/ 1.0 (-> ripple-info grid-size)))
             (grid-x (* inverse-grid-size (- rotated-x (-> ripple-info x-base))))
             (grid-z (* inverse-grid-size (- rotated-z (-> ripple-info z-base)))))
        (ripple-update-waveform-offs wave-set)
        (let* ((cell-x (the float (the int grid-x)))
               (cell-z (the float (the int grid-z)))
               (height-00 (ripple-slow-add-sine-waves wave-set cell-x cell-z))
               (height-10 (ripple-slow-add-sine-waves wave-set (+ 1.0 cell-x) cell-z))
               (height-01 (ripple-slow-add-sine-waves wave-set cell-x (+ 1.0 cell-z)))
               (height-11 (ripple-slow-add-sine-waves wave-set (+ 1.0 cell-x) (+ 1.0 cell-z)))
               (interp-x0 (+ height-00 (* (- grid-x cell-x) (- height-10 height-00))))
               (interp-x1 (+ height-01 (* (- grid-x cell-x) (- height-11 height-01))))
               (interpolated-height (+ interp-x0 (* (- grid-z cell-z) (- interp-x1 interp-x0))))
               (ripple-scale (-> ripple-control faded-scale)))
          (if (< ripple-scale 0.0) (set! ripple-scale (-> ripple-control global-scale)))
          (+ base-height (* (/ interpolated-height 128) ripple-scale)))))))

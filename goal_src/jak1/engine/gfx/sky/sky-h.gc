;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/math/trigonometry.gc")

;; The sky system positions the two suns and moon, draws the sky dome and cloud
;; layers, and supplies lighting colors.  Time-of-day data selects and blends
;; among as many as eight authored snapshots for each level.

;; DECOMP BEGINS

(defenum sky-sun-index
  :type int32
  (sun 0)
  (green-sun 1))

(defenum sky-orbit-index
  :type int32
  (sun 0)
  (green-sun 1)
  (moon 2))

;; The snapshot pair and blend amount at the beginning and end of one hour.
;; During the hour, the mood system interpolates morph-start to morph-end and
;; uses the result to blend the two snapshots.  The same schedule structure is
;; used for fog, lighting palettes, and sky textures.
(deftype sky-color-hour (structure)
  ((snapshot1   int32)
   (snapshot2   int32)
   (morph-start float)
   (morph-end   float)))

;; A complete repeating 24-hour snapshot schedule.
(deftype sky-color-day (structure)
  ((hour sky-color-hour 24 :inline)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Old Sky Renderer
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; The original sky renderer is no longer drawn, but its sun, moon, and orbit
;; data still drive the replacement renderer and the weather particles.

;; A closed 16-segment oval.  Entry 16 repeats entry 0 for strip closure.
(deftype sky-circle-data (structure)
  ((data vector 17 :inline)))

;; Position, apparent radii, and center-to-edge colors for one sun.
;; The four raw quadwords are also the upload layout expected by the old renderer.
(deftype sky-sun-data (structure)
  ((data           uint128 4)
   (pos            vector :inline :overlay-at (-> data 0))
   (r-sun          float :overlay-at (-> data 1))
   (r-halo         float :offset 20)
   (r-aurora       float :offset 24)
   (c-sun-start    rgba :overlay-at (-> data 2))
   (c-sun-end      rgba :overlay-at (-> data 3))
   (c-halo-start   rgba :offset 36)
   (c-halo-end     rgba :offset 52)
   (c-aurora-start rgba :offset 40)
   (c-aurora-end   rgba :offset 56)))

;; Position and scale tracked by the moon particle.
(deftype sky-moon-data (structure)
  ((data  uint128 2)
   (pos   vector :inline :overlay-at (-> data 0))
   (scale vector :inline :overlay-at (-> data 1))))

;; Parameters for a sun or moon orbit.  high-noon is an hour of day; tilt and
;; rise are stored in radians (sky-set-orbit accepts degrees); dist is the orbit
;; radius; and the halo limits are the endpoints used to animate r-aurora.
(deftype sky-orbit (structure)
  ((high-noon float)
   (tilt      float)
   (rise      float)
   (dist      float)
   (min-halo  float)
   (max-halo  float))
  :allow-misaligned)

;; Contiguous old-renderer upload image: 17 circle vectors, two four-vector
;; suns, and a two-vector moon.
(deftype sky-upload-data (basic)
  ((circle sky-circle-data :inline)
   (sun    sky-sun-data 2 :inline)
   (moon   sky-moon-data :inline)
   (data   uint128 27 :overlay-at (-> circle data))))

;; Shared celestial parameters.  The renderer and weather systems still use
;; upload-data for the current sun and moon positions; the light fields belong
;; to the retired renderer.
(deftype sky-parms (basic)
  ((orbit             sky-orbit 3 :inline)
   (upload-data       sky-upload-data :inline)
   (sun-lights        light-group :inline)
   (moon-lights       light-group :inline)
   (default-lights    light-group :inline)
   (default-vu-lights vu-lights :inline))
  (:methods
   (new (symbol type) _type_)))

(defmethod new sky-parms ((allocation symbol) (type-to-make type))
  "Allocate the shared sky parameters and initialize the embedded upload-data type."
  (let ((result (object-new allocation type-to-make (the-as int (-> type-to-make size)))))
    (set! (-> result upload-data type) sky-upload-data)
    result))

(define *sky-parms* (new 'global 'sky-parms))

;; Standalone storage for the old renderer's oval vertices.
(define *sky-upload-data* (new 'global 'sky-upload-data))

;; Generate the oval, repeating the first point at the end.
(dotimes (i 17)
  (let ((angle (+ MINUS_PI (* 0.39269906 (the float (logand i 15))))))
    (set! (-> *sky-upload-data* circle data i x) (* 2.2 (sin-rad angle)))
    (set! (-> *sky-upload-data* circle data i y) (cos-rad angle)))
  (set! (-> *sky-upload-data* circle data i z) 0.0)
  (set! (-> *sky-upload-data* circle data i w) 0.0))

;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; new sky renderer (TNG)
;;;;;;;;;;;;;;;;;;;;;;;;;;;

(deftype sky-tng-data (basic)
  ;; The three tags select the base dome, textured roof, and fogged ocean forms.
  ;; fog is shared with the sky, boundary, and far-ocean VU paths.  The two
  ;; offset pairs scroll the two cloud layers independently.
  ((giftag-base gs-gif-tag :inline)
   (giftag-roof gs-gif-tag :inline)
   (giftag-ocean gs-gif-tag :inline)
   (fog vector :inline)
   (sky uint32 8)
   (time float)
   (off-s-0 uint16)
   (off-t-0 uint16)
   (off-s-1 uint16)
   (off-t-1 uint16)))

(deftype sky-work (structure)
  ;; Ready-to-copy GIF packet headers and five-qword textured-sprite payloads
  ;; used while compositing the level's sky and cloud textures.
  ((adgif-tmpl dma-gif-packet :inline)
   (draw-tmpl dma-gif-packet :inline)
   (blend-tmpl dma-gif-packet :inline)
   (sky-data qword 5 :inline)
   (cloud-data qword 5 :inline)))

(deftype sky-vertex (structure)
  ;; Floating-point position, perspective texture coordinates, and RGBA color.
  ((pos vector :inline)
   (stq vector :inline)
   (col vector :inline)))

;; Set after the first sky or cloud snapshot is copied into the level texture.
;; Further snapshots alpha-blend over the first instead of replacing it.
(define *sky-drawn* #f)

(define *cloud-drawn* #f)

(declare-type time-of-day-context basic)

(define-extern update-sky-tng-data (function float none))

(define-extern make-sky-textures (function time-of-day-context int none))

(define-extern sky-base-polygons (inline-array sky-vertex))

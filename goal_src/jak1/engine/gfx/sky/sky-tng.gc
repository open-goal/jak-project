       (new 'static
            'sky-vertex
            :pos
            (new 'static 'vector :x 40960000.0)
            :stq
            (new 'static 'vector :x 1.0 :z 1.0)
            :col
            (new 'static 'vector :x 128.0 :y 128.0 :z 128.0 :w 128.0))

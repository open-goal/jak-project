;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/gfx/lights-h.gc")
(require "engine/gfx/sky/sky-utils.gc")

;; DECOMP BEGINS

(defun sky-make-sun-data ((parms sky-parms) (sun-index sky-sun-index) (hour float))
  "Place one sun on its tilted orbit for hour, completing one revolution per 24 hours. Its
   aurora radius blends from min-halo to max-halo as the sun rises to high noon and stays at
   min-halo throughout the far half of the orbit."
  (let* ((orbit-data (-> parms orbit sun-index))
         (sun-data (-> parms upload-data sun sun-index))
         (phase-hours (- hour (-> orbit-data high-noon)))
         (phase-angle (* 2730.6667 phase-hours))
         (sin-distance (* (sin phase-angle) (-> orbit-data dist)))
         (phase-cosine (cos phase-angle)))
    (let* ((cos-distance (* phase-cosine (-> orbit-data dist)))
           (vertical-position (* cos-distance (cos-rad (-> orbit-data tilt))))
           (tilted-cos-distance (* cos-distance (sin-rad (-> orbit-data tilt))))
           (sin-rise (sin-rad (-> orbit-data rise)))
           (cos-rise (cos-rad (-> orbit-data rise))))
      (set! (-> sun-data pos z) (- (+ (* sin-distance cos-rise) (* tilted-cos-distance sin-rise))))
      (set! (-> sun-data pos y) vertical-position)
      (set! (-> sun-data pos x) (- (* tilted-cos-distance cos-rise) (* sin-distance sin-rise))))
    (let ((day-height (if (< phase-cosine 0.0) 0.0 phase-cosine)))
      (set! (-> parms upload-data sun sun-index r-aurora)
            (+ (* (-> orbit-data min-halo) (- 1.0 day-height)) (* (-> orbit-data max-halo) day-height)))))
  (none))

(defun sky-make-moon-data ((parms sky-parms) (hour float))
  "Place the moon on its tilted orbit for hour, completing one revolution per 24 hours."
  (let* ((orbit-data (-> parms orbit 2))
         (moon-data (-> parms upload-data moon))
         (phase-hours (- hour (-> orbit-data high-noon)))
         (phase-angle (* 2730.6667 phase-hours))
         (sin-distance (* (sin phase-angle) (-> orbit-data dist)))
         (cos-distance (* (cos phase-angle) (-> orbit-data dist)))
         (vertical-position (* cos-distance (cos-rad (-> orbit-data tilt))))
         (tilted-cos-distance (* cos-distance (sin-rad (-> orbit-data tilt))))
         (sin-rise (sin-rad (-> orbit-data rise)))
         (cos-rise (cos-rad (-> orbit-data rise))))
    (set! (-> moon-data pos z) (- (+ (* sin-distance cos-rise) (* tilted-cos-distance sin-rise))))
    (set! (-> moon-data pos y) vertical-position)
    (set! (-> moon-data pos x) (- (* tilted-cos-distance cos-rise) (* sin-distance sin-rise))))
  (none))

;;;;;;;;;;;;;;;;;;;;;
;; Old Sky Renderer
;;;;;;;;;;;;;;;;;;;;;

(defun sky-make-light ((parms sky-parms) (dst-light light) (orbit-index sky-orbit-index) (light-color rgba))
  "Point dst-light toward the selected sun or moon, assign light-color's RGB bytes as normalized
   floats while replacing its alpha with 1, and enable the light's first level."
  (let* ((orbit-data (-> parms orbit orbit-index))
         (body-data (if (= orbit-index (sky-orbit-index moon))
                        (-> parms upload-data moon)
                        (-> parms upload-data sun orbit-index)))
         (byte-to-float 0.003921569)
         (inverse-distance (/ 1.0 (-> orbit-data dist)))
         (dst dst-light))
    (set! (-> dst direction x) (* (-> (the-as sky-sun-data body-data) pos x) inverse-distance))
    (set! (-> dst direction y) (* (-> (the-as sky-sun-data body-data) pos y) inverse-distance))
    (set! (-> dst direction z) (* (-> (the-as sky-sun-data body-data) pos z) inverse-distance))
    (set-vector! (-> dst color)
                 (* (the float (-> light-color r)) byte-to-float)
                 (* (the float (-> light-color g)) byte-to-float)
                 (* (the float (-> light-color b)) byte-to-float)
                 1.0)
    (set! (-> dst levels x) 1.0))
  (none))

(deftype sky-frame-data (structure)
  ((data              uint128 18)
   (world-homo-matrix matrix :inline :overlay-at (-> data 0))
   (hmge-scale        vector :inline :overlay-at (-> data 4))
   (hvdf-offset       vector :inline :overlay-at (-> data 5))
   (consts            vector :inline :overlay-at (-> data 6))
   (pfog0             float :overlay-at (-> data 6))
   (radius            float :overlay-at (-> consts y)) ;; reserved by the current VU program
   (nokick            float :overlay-at (-> consts w))
   (strip-giftag      qword :inline :overlay-at (-> data 7)) ;; reserved
   (col-adgif         qword :inline :overlay-at (-> data 8))
   (save              uint128 5 :overlay-at (-> data 9)) ;; reserved workspace
   (sun-fan-giftag    qword :inline :overlay-at (-> data 14))
   (sun-strip-giftag  qword :inline :overlay-at (-> data 15))
   (sun-alpha         qword :inline :overlay-at (-> data 16))
   (sun-alpha-giftag  qword :inline :overlay-at (-> data 17))))

(defun sky-init-upload-data ((parms sky-parms) (sun-color rgba))
  "Initialize the normal sun's center-to-edge color layers from one packed color, using alpha
   96 for the inner halo, 48 for its outer edge and the inner aurora, and 0 at the aurora edge."
  (set! (-> parms upload-data sun 0 c-sun-start) sun-color)
  (set! (-> parms upload-data sun 0 c-sun-end) sun-color)
  (set! (-> parms upload-data sun 0 c-halo-start) sun-color)
  (set! (-> parms upload-data sun 0 c-halo-end) sun-color)
  (set! (-> parms upload-data sun 0 c-aurora-start) sun-color)
  (set! (-> parms upload-data sun 0 c-aurora-end) sun-color)
  (set! (-> parms upload-data sun 0 c-halo-start a) 96)
  (set! (-> parms upload-data sun 0 c-halo-end a) 48)
  (set! (-> parms upload-data sun 0 c-aurora-start a) 48)
  (set! (-> parms upload-data sun 0 c-aurora-end a) 0)
  0
  (none))

;; The old renderer sends the oval in sky-upload-data to VU address 256 and an 18-qword
;; sky-frame-data block to address 291.  Each sun is drawn in three pieces: an 18-vertex fan for
;; the disc, a 34-vertex strip from r-sun to r-halo, and another 34-vertex strip from r-halo to
;; r-aurora.  The fan and strips carry separate center-to-edge colors from the packed sun data.
;;
;; VU1 transforms the celestial position and generated oval vertices, performs the perspective
;; divide, applies the GS scale and offset, and converts XYZF to 12.4 fixed point.  It retains the
;; clip flags for the other vertices in the current triangle.  When all three vertices lie outside
;; the same clip plane, adding nokick to the output w lane sets the GS ADC bit and suppresses that
;; triangle.  The two 128-qword output banks alternate so XGKICK can consume one while the next
;; packet is assembled.  The packets are rebuilt because the camera projection, fog, time-of-day
;; lighting, celestial positions, and animated halo radius can all change from one frame to the next.
(#when PC_PORT
  (define sky-vu1-block (new 'static 'vu-function)))

(#unless PC_PORT
  (defvu1 sky-vu1-block
          ;; Stable vector-register roles:
          ;;   vf01       transformed sun center       vf02       sun, halo, and aurora radii
          ;;   vf03/vf09 packed start/end colors      vf05       shared RGBAQ A+D record
          ;;   vf06/vf10 generated inner/outer point  vf07/vf08 projected point and clip test
          ;;   vf25       fog/radius/no-kick constants vf26/vf27 GS offset and projection scale
          ;;   vf28..vf31 world-homogeneous matrix
          ;; Frame constants occupy VU addresses 291 through 308.  The first entry only loads the shared
          ;; projection state.  The draw entry starts at draw-sun-0 and falls through to draw-sun-1.
          (vu-pair (iaddi vi14 vi00 0x0) (nop)) ;; #x000
          (vu-pair (lq.xyzw vf28 vi00 291) (nop)) ;; #x001 world-homo-matrix row 0
          (vu-pair (lq.xyzw vf29 vi00 292) (nop)) ;; #x002 world-homo-matrix row 1
          (vu-pair (lq.xyzw vf30 vi00 293) (nop)) ;; #x003 world-homo-matrix row 2
          (vu-pair (lq.xyzw vf31 vi00 294) (nop)) ;; #x004 world-homo-matrix row 3
          (vu-pair (lq.xyzw vf27 vi00 295) (nop)) ;; #x005 hmge-scale
          (vu-pair (lq.xyzw vf26 vi00 296) (nop :e)) ;; #x006 hvdf-offset
          (vu-pair (lq.xyzw vf25 vi00 297) (nop)) ;; #x007 pfog0, radius, unused, nokick
          ;; Draw one sun.  vf01 is its direction, vf02 contains its three radii, and vf03/vf09 contain
          ;; the three packed start/end colors.  The caller loads those four qwords and returns through
          ;; vi15 after this common body has kicked the disc and both annular strips.
          (label draw-sun)
          (vu-pair (lq.xyzw vf05 vi00 299) (nop)) ;; #x008 col-adgif
          (vu-pair (lq.xyzw vf07 vi00 308) (nop)) ;; #x009 sun-alpha-giftag
          (vu-pair (lq.xyzw vf08 vi00 307) (nop)) ;; #x00a sun-alpha
          (vu-pair (ior vi04 vi14 vi00) (nop)) ;; #x00b
          (vu-pair (iaddiu vi02 vi00 0x100) (mulax.xyzw ACC vf28 vf01)) ;; #x00c circle data
          (vu-pair (lq.xyzw vf04 vi00 305) (madday.xyzw ACC vf29 vf01)) ;; #x00d fan giftag
          (vu-pair (iaddiu vi03 vi00 0x11) (maddz.xyzw vf01 vf30 vf01)) ;; #x00e
          ;; The fan starts with the alpha state, tag, center color, and transformed center.  Each of the
          ;; 17 oval samples then contributes an edge color and an XYZF vertex.
          (vu-pair (sqi.xyzw vf07 vi04) (nop)) ;; #x00f
          (vu-pair (sqi.xyzw vf08 vi04) (nop)) ;; #x010
          (vu-pair (sqi.xyzw vf04 vi04) (nop)) ;; #x011
          (vu-pair (sqi.xyzw vf05 vi04) (nop)) ;; #x012
          (vu-pair (sq.x vf03 vi04 -1) (nop)) ;; #x013 disc center color
          (vu-pair (sqi.xyzw vf01 vi04) (nop)) ;; #x014
          (label build-disc-fan)
          (vu-pair (lqi.xyzw vf06 vi02) (nop)) ;; #x015
          (vu-pair (sqi.xyzw vf05 vi04) (nop)) ;; #x016
          (vu-pair (sq.x vf09 vi04 -1) (nop)) ;; #x017 disc edge color
          (vu-pair (nop) (nop)) ;; #x018
          (vu-pair (nop) (mulx.xyzw vf06 vf06 vf02)) ;; #x019 r-sun
          (vu-pair (nop) (nop)) ;; #x01a
          (vu-pair (nop) (nop)) ;; #x01b
          (vu-pair (nop) (nop)) ;; #x01c
          (vu-pair (nop) (add.xyzw vf06 vf06 vf01)) ;; #x01d
          (vu-pair (iaddi vi03 vi03 -0x1) (nop)) ;; #x01e
          (vu-pair (nop) (nop)) ;; #x01f
          (vu-pair (ibne vi00 vi03 build-disc-fan) (nop)) ;; #x020
          (vu-pair (sqi.xyzw vf06 vi04) (nop)) ;; #x021
          ;; Project the fan vertices in place.  vi05 retains the center's clip flags and vi06 retains
          ;; the preceding edge's flags, so their intersection with vi07 identifies a fully rejected fan
          ;; triangle.  The first edge cannot complete a triangle and starts with vi06 clear.
          (vu-pair (iaddi vi04 vi14 0x3) (nop)) ;; #x022
          (vu-pair (iaddi vi05 vi00 0x0) (nop)) ;; #x023
          (vu-pair (iaddi vi06 vi00 0x0) (nop)) ;; #x024
          (vu-pair (iaddiu vi03 vi00 0x11) (nop)) ;; #x025
          (vu-pair (lq.xyzw vf07 vi04 1) (nop)) ;; #x026 center
          (vu-pair (iaddi vi04 vi04 0x2) (nop)) ;; #x027
          (vu-pair (nop) (nop)) ;; #x028
          (vu-pair (nop) (nop)) ;; #x029
          (vu-pair (div Q vf25.x vf07.w) (mul.xyzw vf08 vf07 vf27)) ;; #x02a
          (vu-pair (move.z vf07 vf00) (nop)) ;; #x02b
          (vu-pair (nop) (nop)) ;; #x02c
          (vu-pair (nop) (nop)) ;; #x02d
          (vu-pair (nop) (clipw.xyz vf08 vf08)) ;; #x02e
          (vu-pair (nop) (nop)) ;; #x02f
          (vu-pair (nop) (nop)) ;; #x030
          (vu-pair (iaddiu vi01 vi00 0x2f) (mul.xy vf07 vf07 Q)) ;; #x031
          (vu-pair (fcget vi05) (nop)) ;; #x032 center clip flags
          (vu-pair (iand vi05 vi05 vi01) (nop)) ;; #x033
          (vu-pair (nop) (nop)) ;; #x034
          (vu-pair (nop) (add.xyzw vf07 vf07 vf26)) ;; #x035
          (vu-pair (nop) (nop)) ;; #x036
          (vu-pair (nop) (nop)) ;; #x037
          (vu-pair (nop) (nop)) ;; #x038
          (vu-pair (nop) (maxx.w vf07 vf07 vf00)) ;; #x039
          (vu-pair (nop) (nop)) ;; #x03a
          (vu-pair (nop) (nop)) ;; #x03b
          (vu-pair (nop) (nop)) ;; #x03c
          (vu-pair (nop) (ftoi4.xyzw vf07 vf07)) ;; #x03d
          (vu-pair (nop) (nop)) ;; #x03e
          (vu-pair (nop) (nop)) ;; #x03f
          (vu-pair (nop) (nop)) ;; #x040
          (vu-pair (sq.xyzw vf07 vi04 -1) (nop)) ;; #x041
          (label project-disc-edge)
          (vu-pair (lq.xyzw vf07 vi04 1) (nop)) ;; #x042
          (vu-pair (iaddi vi04 vi04 0x2) (nop)) ;; #x043
          (vu-pair (nop) (nop)) ;; #x044
          (vu-pair (nop) (nop)) ;; #x045
          (vu-pair (div Q vf25.x vf07.w) (mul.xyzw vf08 vf07 vf27)) ;; #x046
          (vu-pair (move.z vf07 vf00) (nop)) ;; #x047
          (vu-pair (nop) (nop)) ;; #x048
          (vu-pair (nop) (nop)) ;; #x049
          (vu-pair (nop) (clipw.xyz vf08 vf08)) ;; #x04a
          (vu-pair (nop) (nop)) ;; #x04b
          (vu-pair (nop) (nop)) ;; #x04c
          (vu-pair (iaddiu vi01 vi00 0x2f) (mul.xy vf07 vf07 Q)) ;; #x04d
          (vu-pair (fcget vi07) (nop)) ;; #x04e current edge clip flags
          (vu-pair (iand vi07 vi07 vi01) (nop)) ;; #x04f
          (vu-pair (iand vi06 vi06 vi05) (nop)) ;; #x050
          (vu-pair (iand vi06 vi06 vi07) (add.xyzw vf07 vf07 vf26)) ;; #x051
          (vu-pair (nop) (nop)) ;; #x052
          (vu-pair (ibne vi00 vi06 reject-disc-triangle) (nop)) ;; #x053
          (vu-pair (nop) (nop)) ;; #x054
          (vu-pair (nop) (maxx.w vf07 vf07 vf00)) ;; #x055
          (vu-pair (nop) (nop)) ;; #x056
          (vu-pair (nop) (nop)) ;; #x057
          (vu-pair (nop) (nop)) ;; #x058
          (vu-pair (nop) (ftoi4.xyzw vf07 vf07)) ;; #x059
          (vu-pair (iaddi vi03 vi03 -0x1) (nop)) ;; #x05a
          (vu-pair (ior vi06 vi07 vi00) (nop)) ;; #x05b
          (vu-pair (ibne vi00 vi03 project-disc-edge) (nop)) ;; #x05c
          (vu-pair (sq.xyzw vf07 vi04 -1) (nop)) ;; #x05d
          (vu-pair (b disc-kicked) (nop)) ;; #x05e
          (vu-pair (xgkick vi14) (nop)) ;; #x05f branch delay
          (label reject-disc-triangle)
          (vu-pair (nop) (maxx.w vf07 vf07 vf00)) ;; #x060
          (vu-pair (nop) (nop)) ;; #x061
          (vu-pair (nop) (nop)) ;; #x062
          (vu-pair (nop) (nop)) ;; #x063
          (vu-pair (nop) (addw.w vf07 vf07 vf25)) ;; #x064 set ADC/no-kick
          (vu-pair (nop) (nop)) ;; #x065
          (vu-pair (nop) (nop)) ;; #x066
          (vu-pair (nop) (nop)) ;; #x067
          (vu-pair (nop) (ftoi4.xyzw vf07 vf07)) ;; #x068
          (vu-pair (iaddi vi03 vi03 -0x1) (nop)) ;; #x069
          (vu-pair (ior vi06 vi07 vi00) (nop)) ;; #x06a
          (vu-pair (ibne vi00 vi03 project-disc-edge) (nop)) ;; #x06b
          (vu-pair (sq.xyzw vf07 vi04 -1) (nop)) ;; #x06c
          (vu-pair (xgkick vi14) (nop)) ;; #x06d
          ;; Build the two annular strips in the other output bank.  MR32 advances the packed color and
          ;; radius vectors from sun to halo and then halo to aurora.  Each oval sample emits the inner
          ;; and outer colored vertices needed by the strip.
          (label disc-kicked)
          (vu-pair (iaddiu vi01 vi00 0x80) (nop)) ;; #x06e
          (vu-pair (isub vi14 vi01 vi14) (nop)) ;; #x06f
          (vu-pair (iaddi vi08 vi00 0x2) (nop)) ;; #x070
          (label build-annular-strip)
          (vu-pair (iaddiu vi02 vi00 0x100) (nop)) ;; #x071 circle data
          (vu-pair (lq.xyzw vf04 vi00 306) (nop)) ;; #x072 strip giftag
          (vu-pair (iaddiu vi03 vi00 0x11) (nop)) ;; #x073
          (vu-pair (ior vi04 vi14 vi00) (nop)) ;; #x074
          (vu-pair (mr32.xyzw vf03 vf03) (nop)) ;; #x075 next start color
          (vu-pair (mr32.xyzw vf09 vf09) (nop)) ;; #x076 next end color
          (vu-pair (sqi.xyzw vf04 vi04) (nop)) ;; #x077
          (vu-pair (nop) (nop)) ;; #x078
          (label build-strip-vertices)
          (vu-pair (lqi.xyzw vf06 vi02) (nop)) ;; #x079
          (vu-pair (sq.xyzw vf05 vi04 0) (nop)) ;; #x07a
          (vu-pair (sq.x vf03 vi04 0) (nop)) ;; #x07b inner color
          (vu-pair (sq.xyzw vf05 vi04 2) (nop)) ;; #x07c
          (vu-pair (sq.x vf09 vi04 2) (mulx.xyzw vf10 vf06 vf02)) ;; #x07d inner radius
          (vu-pair (iaddi vi04 vi04 0x4) (muly.xyzw vf06 vf06 vf02)) ;; #x07e outer radius
          (vu-pair (nop) (nop)) ;; #x07f
          (vu-pair (nop) (nop)) ;; #x080
          (vu-pair (nop) (add.xyzw vf10 vf10 vf01)) ;; #x081
          (vu-pair (nop) (add.xyzw vf06 vf06 vf01)) ;; #x082
          (vu-pair (nop) (nop)) ;; #x083
          (vu-pair (iaddi vi03 vi03 -0x1) (nop)) ;; #x084
          (vu-pair (sq.xyzw vf10 vi04 -3) (nop)) ;; #x085
          (vu-pair (ibne vi00 vi03 build-strip-vertices) (nop)) ;; #x086
          (vu-pair (sq.xyzw vf06 vi04 -1) (nop)) ;; #x087
          ;; Project all 34 strip vertices.  vi05 and vi06 are the two preceding clip masks; a nonzero
          ;; intersection with vi07 means the current strip triangle is wholly outside one clip plane.
          (vu-pair (iaddi vi04 vi14 0x1) (nop)) ;; #x088
          (vu-pair (iaddi vi05 vi00 0x0) (nop)) ;; #x089
          (vu-pair (iaddi vi06 vi00 0x0) (nop)) ;; #x08a
          (vu-pair (iaddiu vi03 vi00 0x22) (nop)) ;; #x08b
          (label project-strip-vertex)
          (vu-pair (lq.xyzw vf07 vi04 1) (nop)) ;; #x08c
          (vu-pair (iaddi vi04 vi04 0x2) (nop)) ;; #x08d
          (vu-pair (nop) (nop)) ;; #x08e
          (vu-pair (nop) (nop)) ;; #x08f
          (vu-pair (div Q vf25.x vf07.w) (mul.xyzw vf08 vf07 vf27)) ;; #x090
          (vu-pair (move.z vf07 vf00) (nop)) ;; #x091
          (vu-pair (nop) (nop)) ;; #x092
          (vu-pair (nop) (nop)) ;; #x093
          (vu-pair (nop) (clipw.xyz vf08 vf08)) ;; #x094
          (vu-pair (nop) (nop)) ;; #x095
          (vu-pair (nop) (nop)) ;; #x096
          (vu-pair (iaddiu vi01 vi00 0x2f) (mul.xy vf07 vf07 Q)) ;; #x097
          (vu-pair (fcget vi07) (nop)) ;; #x098
          (vu-pair (iand vi07 vi07 vi01) (nop)) ;; #x099
          (vu-pair (iand vi05 vi05 vi06) (nop)) ;; #x09a
          (vu-pair (iand vi05 vi05 vi07) (add.xyzw vf07 vf07 vf26)) ;; #x09b
          (vu-pair (nop) (nop)) ;; #x09c
          (vu-pair (ibne vi00 vi05 reject-strip-triangle) (nop)) ;; #x09d
          (vu-pair (nop) (nop)) ;; #x09e
          (vu-pair (nop) (maxx.w vf07 vf07 vf00)) ;; #x09f
          (vu-pair (nop) (nop)) ;; #x0a0
          (vu-pair (nop) (nop)) ;; #x0a1
          (vu-pair (nop) (nop)) ;; #x0a2
          (vu-pair (ior vi05 vi06 vi00) (ftoi4.xyzw vf07 vf07)) ;; #x0a3
          (vu-pair (iaddi vi03 vi03 -0x1) (nop)) ;; #x0a4
          (vu-pair (ior vi06 vi07 vi00) (nop)) ;; #x0a5
          (vu-pair (ibne vi00 vi03 project-strip-vertex) (nop)) ;; #x0a6
          (vu-pair (sq.xyzw vf07 vi04 -1) (nop)) ;; #x0a7
          (vu-pair (b strip-kicked) (nop)) ;; #x0a8
          (vu-pair (xgkick vi14) (nop)) ;; #x0a9 branch delay
          (label reject-strip-triangle)
          (vu-pair (nop) (maxx.w vf07 vf07 vf00)) ;; #x0aa
          (vu-pair (nop) (nop)) ;; #x0ab
          (vu-pair (nop) (nop)) ;; #x0ac
          (vu-pair (nop) (nop)) ;; #x0ad
          (vu-pair (nop) (addw.w vf07 vf07 vf25)) ;; #x0ae set ADC/no-kick
          (vu-pair (nop) (nop)) ;; #x0af
          (vu-pair (nop) (nop)) ;; #x0b0
          (vu-pair (nop) (nop)) ;; #x0b1
          (vu-pair (ior vi05 vi06 vi00) (ftoi4.xyzw vf07 vf07)) ;; #x0b2
          (vu-pair (iaddi vi03 vi03 -0x1) (nop)) ;; #x0b3
          (vu-pair (ior vi06 vi07 vi00) (nop)) ;; #x0b4
          (vu-pair (ibne vi00 vi03 project-strip-vertex) (nop)) ;; #x0b5
          (vu-pair (sq.xyzw vf07 vi04 -1) (nop)) ;; #x0b6
          (vu-pair (xgkick vi14) (nop)) ;; #x0b7
          (label strip-kicked)
          (vu-pair (iaddi vi08 vi08 -0x1) (nop)) ;; #x0b8
          (vu-pair (iaddiu vi01 vi00 0x80) (nop)) ;; #x0b9
          (vu-pair (isub vi14 vi01 vi14) (nop)) ;; #x0ba
          (vu-pair (ibne vi00 vi08 build-annular-strip) (nop)) ;; #x0bb
          (vu-pair (mr32.xyzw vf02 vf02) (nop)) ;; #x0bc advance sun/halo to halo/aurora
          (vu-pair (jr vi15) (nop)) ;; #x0bd
          (vu-pair (nop) (nop)) ;; #x0be
          ;; The draw entry selects the first packed sun record, then falls through to the second.
          (label draw-sun-0)
          (vu-pair (lq.xyzw vf01 vi00 273) (nop)) ;; #x0bf position
          (vu-pair (lq.xyzw vf02 vi00 274) (nop)) ;; #x0c0 radii
          (vu-pair (lq.xyzw vf03 vi00 275) (nop)) ;; #x0c1 start colors
          (vu-pair (lq.xyzw vf09 vi00 276) (nop)) ;; #x0c2 end colors
          (vu-pair (bal vi15 draw-sun) (nop)) ;; #x0c3
          (vu-pair (nop) (nop)) ;; #x0c4
          (label draw-sun-1)
          (vu-pair (lq.xyzw vf01 vi00 277) (nop)) ;; #x0c5 position
          (vu-pair (lq.xyzw vf02 vi00 278) (nop)) ;; #x0c6 radii
          (vu-pair (lq.xyzw vf03 vi00 279) (nop)) ;; #x0c7 start colors
          (vu-pair (lq.xyzw vf09 vi00 280) (nop)) ;; #x0c8 end colors
          (vu-pair (bal vi15 draw-sun) (nop)) ;; #x0c9
          (vu-pair (nop) (nop)) ;; #x0ca
          (vu-pair (nop) (nop :e)) ;; #x0cb
          (vu-pair (nop) (nop)) ;; #x0cc
          ))

(defun sky-add-frame-data ((dma-buf dma-buffer) (unused object))
  "Append the old sky renderer's 18-quadword frame constants, refresh its VU light block, copy
   the current circle, sun, and moon data into contiguous upload storage, and append the VIF
   transfer for that 27-quadword image."
  (let ((frame-qwc 18))
    (dma-buffer-add-cnt-vif2 dma-buf
                             frame-qwc
                             (new 'static 'vif-tag :imm #x404 :cmd (vif-cmd stcycl))
                             (new 'static 'vif-tag :imm #x123 :cmd (vif-cmd unpack-v4-32) :num frame-qwc))
    (let ((frame (the-as sky-frame-data (-> dma-buf base))))
      (dotimes (i 4)
        (set! (-> frame world-homo-matrix vector i quad) (-> *math-camera* camera-temp vector i quad)))
      (vector-copy! (-> frame hmge-scale) (-> *math-camera* hmge-scale))
      (vector-copy! (-> frame hvdf-offset) (-> *math-camera* hvdf-off))
      ;; The sky uses a fixed GS depth plane rather than the camera's z offset.
      (set! (-> frame hvdf-offset z) 0.0)
      (set! (-> frame pfog0) (-> *math-camera* pfog0))
      (set! (-> frame radius) 4096000.0)
      (set! (-> frame nokick) 3072.0)
      (set-vector! (-> frame col-adgif vector4w) #x20606080 #x3f800000 1 0)
      (set! (-> frame sun-fan-giftag dword 0) (the-as uint #x2026c00000008012))
      (set! (-> frame sun-fan-giftag dword 1) (the-as uint 78))
      (set! (-> frame sun-strip-giftag dword 0) (the-as uint #x2026400000008022))
      (set! (-> frame sun-strip-giftag dword 1) (the-as uint 78))
      (set! (-> frame sun-alpha dword 0) (the-as uint 68))
      (set! (-> frame sun-alpha dword 1) (the-as uint 66))
      (set! (-> frame sun-alpha-giftag dword 0) (the-as uint #x1000000000000001))
      (set! (-> frame sun-alpha-giftag dword 1) (the-as uint 14)))
    (&+! (-> dma-buf base) (* frame-qwc 16)))
  (vu-lights<-light-group! (-> *sky-parms* default-vu-lights) (-> *time-of-day-context* light-group 0))
  (qmem-copy<-! (the-as pointer (-> *sky-upload-data* circle))
                (the-as pointer (-> *sky-parms* upload-data circle))
                432)
  (dma-buffer-add-ref-vif2 dma-buf
                           #x1b
                           (the-as int (-> *sky-upload-data* circle))
                           (new 'static 'vif-tag)
                           (new 'static 'vif-tag :imm #x100 :num #x1b :cmd (vif-cmd unpack-v4-32)))
  #f)

(defun sky-upload ((dma-buf dma-buffer) (unused object))
  "Upload the old sky VU1 program and its current frame and celestial data, then start the
   program's setup entry point."
  (dma-buffer-add-vu-function dma-buf sky-vu1-block 1)
  (sky-add-frame-data dma-buf unused)
  (dma-buffer-add-cnt-vif2 dma-buf
                           0
                           (new 'static 'vif-tag :cmd (vif-cmd mscalf) :msk #x1 :imm #x0)
                           (new 'static 'vif-tag :cmd (vif-cmd flushe) :msk #x1))
  (none))

(defun sky-draw ((dma-buf dma-buffer))
  "Append the VIF command that starts the old sky VU1 program's draw entry point."
  (dma-buffer-add-cnt-vif2 dma-buf
                           0
                           (new 'static 'vif-tag :cmd (vif-cmd mscalf) :msk #x1 :imm #xbf)
                           (new 'static 'vif-tag :cmd (vif-cmd flushe) :msk #x1))
  (none))

;; set the suns
(sky-set-sun-radii *sky-parms* (sky-sun-index sun) 60.0 200.0 300.0)

(sky-set-sun-radii *sky-parms* (sky-sun-index green-sun) 15.0 20.0 300.0)

(sky-set-sun-colors *sky-parms*
                    (sky-sun-index green-sun)
                    (static-rgba #xc2 #xfe #x78 #x80)
                    (static-rgba #xc2 #xfe #x78 #x80)
                    (static-rgba #xc2 #xfe #x78 #x20)
                    (static-rgba #xc2 #xfe #x78 0))

(sky-set-orbit *sky-parms* (sky-orbit-index sun) 12.5 -15.0 0.0 9950.0 300.0 300.0)

(sky-set-orbit *sky-parms* (sky-orbit-index green-sun) 4.0 0.0 60.0 9950.0 120.0 120.0)

(sky-set-orbit *sky-parms* (sky-orbit-index moon) 0.0 0.0 -10.0 9950.0 0.0 0.0)

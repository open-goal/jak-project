;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/gfx/sky/sky-h.gc")
(defun sky-set-sun-radii ((parms sky-parms) (index sky-sun-index) (sun-radius float) (halo-radius float) (aurora-radius float))
  "Set the apparent sun, halo, and aurora radii in the sun record selected by index's low bit."
  (let ((sun-index (logand index (sky-sun-index green-sun))))
    (set! (-> parms upload-data sun sun-index r-sun) sun-radius)
    (set! (-> parms upload-data sun sun-index r-halo) halo-radius)
    (set! (-> parms upload-data sun sun-index r-aurora) aurora-radius))
  #f)

(defun sky-set-sun-colors ((parms sky-parms)
        (index sky-sun-index)
        (sun-center-color rgba)
        (sun-edge-color rgba)
        (halo-edge-color rgba)
        (aurora-edge-color rgba))
  "Set a sun's continuous center-to-edge color gradient. The sun edge is also the halo center,
   and the halo edge is also the aurora center."
  (let ((sun-index (logand index (sky-sun-index green-sun))))
    (set! (-> parms upload-data sun sun-index c-sun-start) sun-center-color)
    (set! (-> parms upload-data sun sun-index c-sun-end) sun-edge-color)
    (set! (-> parms upload-data sun sun-index c-halo-start) sun-edge-color)
    (set! (-> parms upload-data sun sun-index c-halo-end) halo-edge-color)
    (set! (-> parms upload-data sun sun-index c-aurora-start) halo-edge-color)
    (set! (-> parms upload-data sun sun-index c-aurora-end) aurora-edge-color))
  #f)

(defun sky-set-sun-colors-sun ((parms sky-parms) (index sky-sun-index) (center-color rgba) (edge-color rgba))
  "Set the center and edge colors of the sun record selected by index's low bit."
  (let ((sun-index (logand index (sky-sun-index green-sun))))
    (set! (-> parms upload-data sun sun-index c-sun-start) center-color)
    (set! (-> parms upload-data sun sun-index c-sun-end) edge-color))
  #f)

(defun sky-set-sun-colors-halo ((parms sky-parms) (index sky-sun-index) (center-color rgba) (edge-color rgba))
  "Set the center and edge colors of the halo record selected by index's low bit."
  (let ((sun-index (logand index (sky-sun-index green-sun))))
    (set! (-> parms upload-data sun sun-index c-halo-start) center-color)
    (set! (-> parms upload-data sun sun-index c-halo-end) edge-color))
  #f)

(defun sky-set-sun-colors-aurora ((parms sky-parms) (index sky-sun-index) (center-color rgba) (edge-color rgba))
  "Set the center and edge colors of the aurora record selected by index's low bit."
  (let ((sun-index (logand index (sky-sun-index green-sun))))
    (set! (-> parms upload-data sun sun-index c-aurora-start) center-color)
    (set! (-> parms upload-data sun sun-index c-aurora-end) edge-color))
  #f)

(defun sky-set-orbit ((parms sky-parms)
        (orbit-index sky-orbit-index)
        (high-noon float)
        (tilt-degrees float)
        (rise-degrees float)
        (distance float)
        (min-halo float)
        (max-halo float))
  "Configure the sun, green-sun, or moon orbit. High-noon is an hour of the day; tilt and rise
   are supplied in degrees and stored in radians; distance is the orbit radius; and the halo
   bounds control a sun's animated aurora radius."
  (set! (-> parms orbit orbit-index high-noon) high-noon)
  (set! (-> parms orbit orbit-index tilt) (* 0.017453292 tilt-degrees))
  (set! (-> parms orbit orbit-index rise) (* 0.017453292 rise-degrees))
  (set! (-> parms orbit orbit-index dist) distance)
  (set! (-> parms orbit orbit-index min-halo) min-halo)
  (set! (-> parms orbit orbit-index max-halo) max-halo)
  #f)

;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/gfx/sprite/sparticle/sparticle-h.gc")
(require "engine/physics/dynamics-h.gc")
(require "engine/collide/collide-cache.gc")
(require "engine/gfx/shadow/shadow-h.gc")
(require "engine/gfx/sprite/sparticle/sparticle-launcher-h.gc")

;; ------------------------------------------------------------------------------------------------
;; Fake shadows
;; ------------------------------------------------------------------------------------------------
;; Most things that need a shadow do not need the projected-volume renderer in shadow-cpu. A thrown
;; crate, a projectile, or a small enemy gets a "fake shadow" instead: one round sprite laid flat on
;; the ground, tilted to match the surface it landed on and faded out as the caster rises. This file
;; is the whole front end. It probes for the ground, turns the surface normal into the rotation the
;; sprite renderer wants, and appends the result to *fake-shadow-buffer*.
;;
;; Orientation is packed. fake-shadow keeps only qx/qy/qz of the unit quaternion that rotates +y onto
;; the ground normal; the 3D sprite VU1 program recovers w from those three lanes. That is why
;; compute-and-draw-shadow negates the vector whenever quaternion-vector-angle! produced a negative
;; w: only the positive-w hemisphere survives the round trip. flags is the other packed field, and
;; sprite-add-shadow-chunk reads its bit 0 to pick an additive sprite instead of the usual
;; subtractive one.
;;
;; The buffer is double-buffered because filling and drawing happen in different phases of the frame.
;; Process code fills the buffer that is open, drawable's foreground pass calls
;; swap-fake-shadow-buffers just before sprite-draw, and sprite-draw hands the buffer that swap
;; retired to sprite-add-shadow-all. Nothing carries over between frames; the swap only guarantees
;; that the list is not appended to while the DMA for it is built.

;; DECOMP BEGINS

(defun add-fake-shadow-to-buffer ((pos vector) (ground-rot vector) (scale float) (flags int))
  "Append one shadow sprite to the fake-shadow buffer that is currently open for filling.
   pos is the world position of the sprite's center, already lifted clear of the ground.
   ground-rot supplies the xyz lanes of the unit quaternion that rotates +y onto the ground
   normal; its w lane is not stored and is reconstructed by the sprite VU1 program.
   scale is the sprite size in world units, and flags selects the sprite's blend mode: bit 0
   picks additive, otherwise the sprite is subtracted from the frame buffer.
   Does nothing once the buffer holds 32 shadows."
  (let ((buf *fake-shadow-buffer*))
    (when (< (-> buf num-shadows) 32)
      (let ((entry (-> buf data (-> buf num-shadows))))
        (set! (-> entry px) (-> pos x))
        (set! (-> entry py) (-> pos y))
        (set! (-> entry pz) (-> pos z))
        (set! (-> entry scale) scale)
        (set! (-> entry qx) (-> ground-rot x))
        (set! (-> entry qy) (-> ground-rot y))
        (set! (-> entry qz) (-> ground-rot z))
        (set! (-> entry flags) flags))
      (+! (-> buf num-shadows) 1)))
  0
  (none))

(defun swap-fake-shadow-buffers ()
  "Retire the buffer that is open for filling and open the other one, empty. The retired buffer
   stays intact for sprite-add-shadow-all, which recomputes which of the two it is the same way."
  (set! *fake-shadow-buffer*
        (if (= *fake-shadow-buffer* *fake-shadow-buffer-1*) *fake-shadow-buffer-2* *fake-shadow-buffer-1*))
  (set! (-> *fake-shadow-buffer* num-shadows) 0)
  0
  (none))

(defun draw-shadow ((pos vector) (ground-pos vector) (ground-rot vector) (radius float) (fade-height float) (flags float))
  "Queue a fake shadow at ground-pos for a caster at pos, sized radius where the two touch and
   shrinking linearly to nothing as the caster climbs fade-height above the ground. Nothing is
   queued once the caster reaches fade-height. ground-rot and flags pass straight through to
   add-fake-shadow-to-buffer; flags is an integer carried in a float register."
  (let ((height (- (-> pos y) (-> ground-pos y))))
    (if (< height fade-height)
      (add-fake-shadow-to-buffer ground-pos ground-rot (* (- 1.0 (/ height fade-height)) radius) (the-as int flags))))
  0
  (none))

(defun compute-and-draw-shadow ((pos vector) (ground-pos vector) (ground-normal vector) (radius vector) (fade-height float) (flags float))
  "Queue a fake shadow lying flat on a surface whose normal is ground-normal. pos is the caster,
   ground-pos is the contact point found for it, and radius, fade-height and flags mean what they
   do in draw-shadow; radius is a float carried in a pointer register and flags an integer carried
   in a float register.
   Returns without queueing anything when the caster has already reached fade-height.
   Raises ground-pos by a centimeter as a side effect, so the sprite does not z-fight the surface
   it sits on."
  (local-vars (rot-x float))
  (rlet ((vf0 :class vf)
         (vf1 :class vf)
         (vf2 :class vf))
    (init-vf0-vector)
    ;; the vector helpers below clobber the argument registers, so keep working copies
    (let ((normal ground-normal)
          (scale radius)
          (max-height fade-height)
          (shadow-flags flags))
      (when (< (- (-> pos y) (-> ground-pos y)) max-height)
        (let ((tilt-axis (new 'stack-no-clear 'vector))
              (ground-quat (new 'stack-no-clear 'vector))
              (rot-work (new 'stack-no-clear 'sparticle-cpuinfo)))
          (+! (-> ground-pos y) (meters 0.01))
          ;; rotate +y onto the normal: the axis is the horizontal direction perpendicular to the
          ;; normal's xz projection, and the angle is how far the normal leans away from vertical
          (set! (-> tilt-axis x) (-> normal z))
          (set! (-> tilt-axis y) 0.0)
          (set! (-> tilt-axis z) (- (-> normal x)))
          (vector-normalize! tilt-axis 1.0)
          (quaternion-vector-angle! (the-as quaternion ground-quat) tilt-axis (acos (-> normal y)))
          ;; keep xyz only, in the hemisphere where w is positive, since that is all fake-shadow
          ;; stores and all the sprite program can invert. the masked add and subtract leave the w
          ;; lane of the loaded quadword alone, and the move out of it is unused.
          (let ((dest rot-work))
            (cond
              ((< (-> ground-quat w) 0.0)
               (.lvf vf1 (&-> dest vel-sxvel quad))
               (.lvf vf2 (&-> ground-quat quad))
               (.sub.vf.xyz vf1 vf0 vf2)
               (.svf (&-> dest vel-sxvel quad) vf1)
               (.mov rot-x vf1))
              (else
               (.lvf vf1 (&-> dest vel-sxvel quad))
               (.lvf vf2 (&-> ground-quat quad))
               (.add.vf.xyz vf1 vf0 vf2)
               (.svf (&-> dest vel-sxvel quad) vf1)
               (.mov rot-x vf1))))
          (draw-shadow pos ground-pos (-> rot-work vel-sxvel) (the-as float scale) max-height shadow-flags))))
    0
    (none)))

(defun find-ground-and-draw-shadow ((pos vector)
        (ground-pos vector)
        (radius float)
        (collide-with collide-kind)
        (ignore-proc process-drawable)
        (probe-y-offset float)
        (probe-length float))
  "Probe straight down for the surface under pos and queue a fake shadow on it. The probe starts
   probe-y-offset above pos, reaches probe-length, considers only collide-with surfaces, and skips
   ignore-proc's own primitives along with anything marked noentity.
   radius sizes the shadow sprite; pass 0 to probe without drawing anything, which is what a caster
   that already has a real projected shadow wants. probe-length doubles as the height over which the
   sprite fades out.
   ground-pos, when it is not #f, receives the contact point. It is left alone on a water bottom, so
   a caster over water keeps the reference point it already had, and it is placed at the bottom of
   the probe range when nothing was hit at all."
  (let ((probe-origin (new 'stack-no-clear 'vector)))
    (set! (-> probe-origin quad) (-> pos quad))
    ;; a second stack vector is reserved here and never used
    (new 'stack-no-clear 'vector)
    (+! (-> probe-origin y) probe-y-offset)
    (let ((hit (new 'stack-no-clear 'collide-tri-result)))
      (cond
        ((>= (fill-and-probe-using-y-probe *collide-cache*
                                           probe-origin
                                           probe-length
                                           collide-with
                                           ignore-proc
                                           hit
                                           (new 'static 'pat-surface :noentity #x1))
             0.0)
         (if (!= radius 0.0)
           (compute-and-draw-shadow probe-origin
                                    (-> hit intersect)
                                    (-> hit normal)
                                    (the-as vector radius)
                                    probe-length
                                    (the-as float 0)))
         (if (and ground-pos (!= (-> hit pat material) (pat-material waterbottom)))
           (set! (-> ground-pos quad) (-> hit intersect quad))))
        (else (if ground-pos (vector+float*! ground-pos pos (-> *standard-dynamics* gravity-normal) (- probe-length)))))))
  0
  (none))

(defbehavior do-target-shadow target ()
  "Refresh the player's ground reference point once per frame. The player casts a real projected
   shadow, so the radius is zero and this probe only updates control shadow-pos, which is seeded
   from trans first in case the probe finds nothing. Skipped while off a surface, while swimming,
   diving or flopping, and while the drawable is hidden or has its bones suppressed."
  (if (and (logtest? (-> self control status) (cshape-moving-flags onsurf))
           (!= (-> self control mod-surface mode) 'swim)
           (!= (-> self control mod-surface mode) 'dive)
           (!= (-> self next-state name) 'target-flop)
           (not (logtest? (-> self draw status) (draw-status hidden no-anim skip-bones))))
    (set! (-> self control shadow-pos quad) (-> self control trans quad))
    (find-ground-and-draw-shadow (-> self control trans)
                                 (-> self control shadow-pos)
                                 0.0
                                 (-> (the-as collide-shape-prim (-> self control root-prim)) collide-with)
                                 self
                                 0.0
                                 (meters 20)))
  0
  (none))

(defpart 362
  :init-specs
  ((:texture (bigpuff effects))
   (:num 8.0)
   (:scale-x (meters 0.3))
   (:rot-z (degrees -180) (degrees 360))
   (:scale-y :copy scale-x)
   (:r 90.0)
   (:g 90.0)
   (:b 90.0)
   (:a 20.0 20.0)
   (:vel-y (meters 0.002))
   (:scalevel-x (meters 0.004166667))
   (:scalevel-y :copy scalevel-x)
   (:fade-a -0.3)
   (:timer (seconds 16.68))
   (:flags (die-when-faded glow))
   (:launchrot-x (degrees -20) (degrees 15))
   (:conerot-x (degrees 90))
   (:conerot-y (degrees -180) (degrees 360))
   (:conerot-radius (meters 0.2))))

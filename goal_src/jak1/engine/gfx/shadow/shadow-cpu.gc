;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/gfx/hw/display.gc")
(require "engine/gfx/foreground/bones-h.gc")
(require "engine/gfx/mood/time-of-day-h.gc")
(require "engine/gfx/shadow/shadow-vu1-h.gc")
(require "engine/collide/collide-mesh-h.gc")
(require "engine/gfx/generic/generic-h.gc")
(require "engine/gfx/generic/generic-vu1-h.gc")
(require "engine/gfx/background/subdivide-h.gc")
(require "engine/collide/pat-h.gc")

;; NOTE: this file is a bit of a mess now.
;; I'm planning to remove most of it and replace with PC shadow
;; renderer very soon.

;; ------------------------------------------------------------------------------------------------
;; What the shadow renderer draws
;; ------------------------------------------------------------------------------------------------
;; A character's shadow is a real projected volume, not a decal. Every drawable that owns a shadow-geo
;; -- a low-polygon stand-in for its mesh, skinned by the same bone matrices merc uses -- gets its
;; silhouette found as seen from the light, extruded onto the ground plane, and drawn as a closed
;; volume into the frame buffer's alpha plane. Alpha is the stencil: shadow-dma-init paints the whole
;; window with SHADOW-ALPHA-CLEAR, the volume's front and back walls nudge it up and back down, and
;; shadow-dma-end darkens every pixel whose alpha did not come back to where it started.
;;
;; Where the light is
;;   shadow-settings holds the whole projection. center is the world position of the caster's shadow
;;   joint. shadow-dir is the direction the light comes from; update-direction-from-time-of-day copies
;;   the sun out of *time-of-day-context*, so shadows swing with the clock. Its w lane, dist-to-locus,
;;   turns that direction into a point light:
;;
;;       locus = center + shadow-dir * dist-to-locus
;;
;;   Every vertex is projected along the ray running from locus outward through the vertex until it
;;   meets bot-plane. The default locus is a hundred meters out, so the projection is very nearly
;;   parallel, but keeping it a point costs nothing and lets a close light fan a shadow out correctly.
;;   collide-to-find-planes probes straight down for the surface the shadow lands on and puts
;;   bot-plane there; top-plane optionally cuts the volume off above the caster.
;;
;; Who queues one
;;   draw-bones-shadow appends one shadow-dma-packet per caster while it builds that drawable's
;;   foreground DMA, and links it into the current *shadow-queue* run through the packet's
;;   generic-merc-tag. A run is a null-terminated chain of those packets; there are fifteen runs and
;;   bones complains if a frame wants more. shadow-execute-all walks each nonempty run once, so a
;;   single call to shadow-execute handles every caster in that run, one after another.
;;
;; How the work divides
;;   EE    per caster: pull the settings, geometry, and bone matrices into the scratchpad over toSPR;
;;         skin the vertices in place; move the locus, the two planes, and the light direction into
;;         camera space; project every vertex onto bot-plane to get its dual; clip both ends against
;;         the near plane and optionally the top plane; classify every triangle against the light;
;;         collect the silhouette edges; then write four VIF packets -- vertices, single-sided caps,
;;         silhouette quads, double-sided caps -- each ending in the MSCALF that starts the matching
;;         VU1 entry.
;;   VU1   transform by the perspective matrix, divide by w, apply the viewport and fog scales, clip
;;         against the frustum, and emit GIF packets. It never sees an index it did not get from the
;;         EE and never computes a silhouette; all it knows is "triangle from three vertex slots" and
;;         "quad from two originals and their two duals".
;;   GS    does the counting, in the alpha plane, with the frame buffer bound as its own texture.
;;
;; Buffers
;;   *gsf-buffer*     the 9216-byte shadow-dcache workspace. Shared with the generic renderer, so the
;;                    shadow pass owns it only for the length of its bucket. The first 160 bytes are
;;                    the header -- table pointers, counters, camera-space planes -- and the rest is a
;;                    bump arena that dcache-top rewinds for each caster.
;;   scratchpad       shadow-work overlays the renderer work area. inbuf is the toSPR landing zone and
;;                    holds one caster's settings, geometry, and matrices. Skinning rewrites the
;;                    vertices there, so the arena only has to hold the duals and the three work lists.
;;   VU1 memory       two twelve-quadword GIF output buffers, alternated around every XGKICK, plus the
;;                    vertex and index areas mapped in shadow-vu1-h.
;;   frame buffer     the alpha plane is the stencil, and the frame buffer is also the texture that
;;                    reads it back.
;;
;; The alpha stencil
;;   TEX0 points at the frame buffer currently being drawn, TFX is MODULATE and TCC is RGBA, so a
;;   shadow polygon's output alpha is
;;
;;       new = old * vertex-alpha / 128
;;
;;   with the texture coordinate derived from the very screen position the vertex lands on. Front
;;   faces carry alpha 130 and back faces 127, so entering the volume scales alpha up by 130/128 and
;;   leaving it scales back down by 127/128: a multiplicative depth counter that lands back on
;;   SHADOW-ALPHA-CLEAR exactly when the two agree. FBMSK protects RGB and ZMSK protects depth, so the
;;   volume itself is invisible while it is being counted. shadow-dma-end then lays one textured sprite
;;   over the window with ATST NOTEQUAL against SHADOW-ALPHA-CLEAR and blends the frame buffer toward
;;   the time of day's shadow color, weighted by that same alpha.
;;
;;   Sampling the frame buffer while writing it means the texture cache has to be dropped between
;;   primitives. That is why every VU1 GIF buffer starts with a TEXFLUSH ahead of its primitive tag
;;   instead of setting it once for the pass.
;;
;;   shadow-dma-init also takes the interlace half-line out of XYOFFSET for the duration of the pass
;;   and shadow-dma-end puts it back. The stencil only means anything if the pixel a polygon writes is
;;   the pixel it samples, and half a scanline of Y offset would sample the wrong one.
;; ------------------------------------------------------------------------------------------------

;; The frame buffer alpha a shadow pass starts and ends at. A nonzero baseline gives the
;; multiplicative counter room in both directions and gives the resolve pass a usable blend weight.
(defconstant SHADOW-ALPHA-CLEAR #x60)

;; The scratchpad holds a terrain-context: a short header naming the level and its mood, then a work
;; area that each renderer overlays with its own record. shadow-work is ours, and that is where the
;; otherwise unexplained sixteen comes from.
(defmacro shadow-spr-offset (&rest path)
  `(+ (offset-of terrain-context work) (offset-of shadow-work ,@path)))

;; toSPR drops one caster's whole record into inbuf. DMAtag transfer is on, so each tag quadword in
;; the source chain lands in the scratchpad ahead of the data it introduces, and every record before
;; the geometry has a fixed size. That makes all four interesting addresses constants:
;;
;;   inbuf +   0   the packet's generic-merc-tag; its next-ptr chains to the following caster
;;   inbuf +  16   shadow-settings, five quadwords
;;   inbuf +  96   the geo-ref tag
;;   inbuf + 112   shadow-header, followed by qwc-data quadwords of packed geometry
;;   ...           the mtx-ref tag, then one 128-byte pris-mtx per joint
(defconstant SHADOW-SPR-INPUT (shadow-spr-offset inbuf))
(defconstant SHADOW-SPR-SETTINGS (+ SHADOW-SPR-INPUT (type-size dma-packet)))
(defconstant SHADOW-SPR-GEO
  (+ SHADOW-SPR-SETTINGS (type-size shadow-settings) (type-size dma-packet)))

;; Skinning reaches the matrices through the geometry, since they follow it in the same transfer:
;; past the geometry there is the mtx-ref tag quadword and then the matrices themselves, and the table
;; base is biased one record further still, so a shadow-matrix-ref index of zero selects the second
;; matrix transferred. draw-bones-shadow already starts the transfer two records into the drawable's
;; matrix area.
(defconstant SHADOW-MATRIX-BIAS (+ (type-size dma-packet) (type-size pris-mtx)))


;; What starts the input transfer: source chain with DMAtag transfer, which is what puts the settings
;; and the geometry at fixed scratchpad addresses. dir stays zero because the direction of a
;; scratchpad transfer is fixed by the channel.
(defconstant DMA-CHCR-START-SPR-CHAIN (new 'static 'dma-chcr :mod 1 :tte 1 :str 1))

;; VU0 entry points. Entry 0 classifies four triangles against the light at once. Entry 28 projects
;; four vertices onto the ground plane, one call behind: its results come out on the following call.
;; Entry 68 is the same routine with the loads removed, and drains the last group.
(defconstant SHADOW-VU0-CLASSIFY-TRIS 0)
(defconstant SHADOW-VU0-PROJECT-VERTS 28)
(defconstant SHADOW-VU0-PROJECT-DRAIN 68)

;; Spin on the input channel until it goes idle, counting the polls that found it busy so a frame that
;; is waiting on the shadow transfer says so. The three-instruction gaps are the EE's load delay: a
;; loaded word is not usable in the two instructions after its load.
;;
;; Eleven instructions. retry names the counter load sitting in the first branch's delay slot, so a
;; jump back to it re-reads the counter and then falls into the second poll; ready names the
;; instruction after the loop.
(defmacro shadow-wait-counting-stalls! (stalls busy channel counter retry ready)
  `(begin
     (l.w ,stalls (-> ,channel chcr))
     (and.i ,stalls ,stalls DMA-CHCR-STR)
     (b.z ,stalls ,ready :delay (at-label ,retry (l.w ,stalls ,counter)))
     (nop!)
     (l.w ,busy (-> ,channel chcr))
     (nop!)
     (and.i ,busy ,busy DMA-CHCR-STR)
     (add.i ,stalls ,stalls 1)
     (b.nz ,busy ,retry :delay (s.w ,stalls ,counter))
     (label ,ready)))

;; DECOMP BEGINS

(defmethod asize-of ((this shadow-geo))
  "Return the complete packed shadow geometry size."
  (the-as int (-> this total-size)))

(defmethod mem-usage ((this shadow-geo) (usage memory-usage-block) (flags mem-usage-flags))
  "Charge this packed shadow geometry's used and 16-byte-aligned sizes to usage."
  (mem-usage-add! usage shadow-geo 1 (-> this total-size))
  this)

(define *shadow-data*
  (new 'static
       'shadow-data
       :texoffset
       (new 'static 'vector :x 256.5 :y 112.5)
       :texscale
       (new 'static 'vector :x 0.001953125 :y 0.00390625)
       :clrs
       (new 'static
            'inline-array
            vector
            2
            (new 'static 'vector :x (the-as float #x80) :w (the-as float #x82))
            (new 'static 'vector :y (the-as float #x80) :w (the-as float #x7f)))
       :dma-unpack-template
       (new 'static
            'dma-packet
            :dma
            (new 'static 'dma-tag :id (dma-tag-id cnt))
            :vif0
            (new 'static 'vif-tag :cmd (vif-cmd flusha) :msk #x1)
            :vif1
            (new 'static 'vif-tag :cmd (vif-cmd unpack-v4-32)))
       :dma-cnt
       (new 'static 'dma-tag :id (dma-tag-id cnt))
       :vif-unpack-v4-8
       (new 'static 'vif-tag :cmd (vif-cmd unpack-v4-8))))

(defun shadow-dma-init ((dma-buf dma-buffer))
  "Append GS state and full-screen strips which initialize framebuffer alpha for the shadow-volume
   pass while masking color and depth writes."
  (let* ((v1-0 *display*)
         (framebuffer-page (-> v1-0 frames (-> v1-0 on-screen) draw frame1 fbp)))
    (* framebuffer-page 32)
    (let ((texture-width 512)
          (screen-height (-> *video-parms* screen-sy))
          (x-offset 1792)
          (screen-min-y (-> *video-parms* screen-miny)))
      2304
      (let ((screen-max-y (-> *video-parms* screen-maxy))
            (strip-count (/ texture-width 32))
            (y-offset (* screen-min-y 16))
            (chain-start (-> dma-buf base)))
        (dma-buffer-add-cnt-vif2 dma-buf 0 (new 'static 'vif-tag) (new 'static 'vif-tag :cmd (vif-cmd direct) :msk #x1))
        (dma-buffer-add-gif-tag dma-buf (new 'static 'gif-tag64 :nloop #xa :eop #x1 :nreg #x1) (gs-reg-list a+d))
        (let ((t4-2 (-> dma-buf base)))
          (set! (-> (the-as (pointer gs-reg) t4-2) 8) (gs-reg texflush))
          (set! (-> (the-as (pointer gs-reg) t4-2) 24) (gs-reg test-1))
          (set! (-> (the-as (pointer gs-test) t4-2) 2)
                (new 'static 'gs-test :ate #x1 :atst (gs-atest always) :zte #x1 :ztst (gs-ztest always)))
          (set! (-> (the-as (pointer gs-reg) t4-2) 40) (gs-reg alpha-1))
          (set! (-> (the-as (pointer gs-alpha) t4-2) 4) (new 'static 'gs-alpha :b #x1 :d #x1))
          (set! (-> (the-as (pointer gs-reg) t4-2) 56) (gs-reg frame-1))
          (set! (-> (the-as (pointer gs-frame) t4-2) 6) (new 'static 'gs-frame :fbw #x8 :fbmsk #xffffff :fbp framebuffer-page))
          (set! (-> (the-as (pointer gs-reg) t4-2) 72) (gs-reg zbuf-1))
          (set! (-> (the-as (pointer gs-zbuf) t4-2) 8) (new 'static 'gs-zbuf :zbp #x1c0 :psm (gs-psm ct24) :zmsk #x1))
          (set! (-> (the-as (pointer gs-reg) t4-2) 88) (gs-reg xyoffset-1))
          (set! (-> (the-as (pointer gs-xy-offset) t4-2) 10) (new 'static 'gs-xy-offset :ofx (* x-offset 16) :ofy y-offset))
          (set! (-> (the-as (pointer gs-reg) t4-2) 104) (gs-reg tex0-1))
          (set! (-> (the-as (pointer gs-tex0) t4-2) 12)
                (new 'static 'gs-tex0 :tbw #x8 :tw #x9 :th #x8 :tcc #x1 :tbp0 (* framebuffer-page 32)))
          (set! (-> (the-as (pointer gs-reg) t4-2) 120) (gs-reg tex1-1))
          (set! (-> (the-as (pointer gs-tex1) t4-2) 14) (new 'static 'gs-tex1))
          (set! (-> (the-as (pointer gs-reg) t4-2) 136) (gs-reg miptbp1-1))
          (set! (-> (the-as (pointer gs-miptbp) t4-2) 16) (new 'static 'gs-miptbp))
          (set! (-> (the-as (pointer gs-reg) t4-2) 152) (gs-reg clamp-1))
          (set! (-> (the-as (pointer gs-clamp) t4-2) 18)
                (new 'static
                     'gs-clamp
                     :wms (gs-tex-wrap-mode region-clamp)
                     :wmt (gs-tex-wrap-mode region-clamp)
                     :maxv
                     (+ screen-height -1)
                     :maxu
                     (+ texture-width -1))))
        (&+! (-> dma-buf base) 160)
        (dma-buffer-add-gif-tag dma-buf
                                (new 'static 'gif-tag64 :nloop #x1 :eop #x1 :flg (gif-flag reg-list) :nreg #x2)
                                (new 'static 'gif-tag-regs :regs1 (gif-reg-id rgbaq)))
        (let* ((t2-8 dma-buf)
               (t3-7 (-> t2-8 base)))
          (set! (-> (the-as (pointer gs-prim) t3-7) 0) (new 'static 'gs-prim :prim (gs-prim-type sprite)))
          (set! (-> (the-as (pointer gs-rgbaq) t3-7) 1) (new 'static 'gs-rgbaq :a #x60))
          (set! (-> t2-8 base) (&+ t3-7 16)))
        (dma-buffer-add-gif-tag dma-buf
                                (new 'static 'gif-tag64 :eop #x1 :flg (gif-flag reg-list) :nreg #x2 :nloop strip-count)
                                (gs-reg-list xyz2 xyz2))
        (let ((x 0))
          (dotimes (i strip-count)
            (let* ((t4-10 dma-buf)
                   (t5-12 (-> t4-10 base)))
              (set! (-> (the-as (pointer gs-xyzf) t5-12) 0)
                    (new 'static 'gs-xyzf :z #x1ffff :y (* screen-min-y 16) :x (* (+ x-offset x) 16)))
              (set! (-> (the-as (pointer gs-xyzf) t5-12) 1)
                    (new 'static 'gs-xyzf :z #x1ffff :y (* screen-max-y 16) :x (* (+ x 32 x-offset) 16)))
              (set! (-> t4-10 base) (&+ t5-12 16)))
            (+! x 32)))
        (dma-buffer-add-gif-tag dma-buf (new 'static 'gif-tag64 :nloop #x4 :eop #x1 :nreg #x1) (gs-reg-list a+d))
        (cond
          (*shadow-debug*
           (let* ((a2-5 dma-buf)
                  (a3-3 (-> a2-5 base)))
             (set! (-> (the-as (pointer gs-test) a3-3) 0)
                   (new 'static 'gs-test :ate #x1 :atst (gs-atest always) :zte #x1 :ztst (gs-ztest greater-equal)))
             (set! (-> (the-as (pointer gs-reg64) a3-3) 1) (gs-reg64 test-1))
             (set! (-> (the-as (pointer gs-zbuf) a3-3) 2) (new 'static 'gs-zbuf :zbp #x1c0 :psm (gs-psm ct24)))
             (set! (-> (the-as (pointer gs-reg64) a3-3) 3) (gs-reg64 zbuf-1))
             (set! (-> (the-as (pointer gs-frame) a3-3) 4) (new 'static 'gs-frame :fbw #x8 :fbp framebuffer-page))
             (set! (-> (the-as (pointer gs-reg64) a3-3) 5) (gs-reg64 frame-1))
             (set! (-> (the-as (pointer uint64) a3-3) 6) (the-as uint 0))
             (set! (-> (the-as (pointer gs-reg64) a3-3) 7) (gs-reg64 texflush))
             (set! (-> a2-5 base) (&+ a3-3 64))))
          (else
           (let* ((a2-6 dma-buf)
                  (a3-4 (-> a2-6 base)))
             (set! (-> (the-as (pointer gs-test) a3-4) 0)
                   (new 'static 'gs-test :ate #x1 :atst (gs-atest always) :zte #x1 :ztst (gs-ztest greater-equal)))
             (set! (-> (the-as (pointer gs-reg64) a3-4) 1) (gs-reg64 test-1))
             (set! (-> (the-as (pointer gs-zbuf) a3-4) 2) (new 'static 'gs-zbuf :zbp #x1c0 :psm (gs-psm ct24) :zmsk #x1))
             (set! (-> (the-as (pointer gs-reg64) a3-4) 3) (gs-reg64 zbuf-1))
             (set! (-> (the-as (pointer gs-frame) a3-4) 4) (new 'static 'gs-frame :fbw #x8 :fbmsk #xffffff :fbp framebuffer-page))
             (set! (-> (the-as (pointer gs-reg64) a3-4) 5) (gs-reg64 frame-1))
             (set! (-> (the-as (pointer uint64) a3-4) 6) (the-as uint 0))
             (set! (-> (the-as (pointer gs-reg64) a3-4) 7) (gs-reg64 texflush))
             (set! (-> a2-6 base) (&+ a3-4 64)))))
        (let ((qwc (/ (the-as int (+ (- -16 (the-as int chain-start)) (the-as int (-> dma-buf base)))) 16)))
          (cond
            ((nonzero? qwc)
             (logior! (-> (the-as (pointer uint64) chain-start) 0) (shr (shl qwc 48) 48))
             (logior! (-> (the-as (pointer uint64) chain-start) 1) (shl (shr (shl qwc 48) 48) 32)))
            (else
             (set! (-> dma-buf base) chain-start)))))))
  (none))

(defun shadow-dma-end ((dma-buf dma-buffer))
  "Close the shadow pass: darken every pixel whose alpha did not come back to SHADOW-ALPHA-CLEAR, then
   put the frame buffer, depth, and interlace state back the way the rest of the frame expects."
  ;; The resolve is sixteen textured sprites covering the window, with the alpha test set to NOTEQUAL
  ;; against SHADOW-ALPHA-CLEAR so only pixels the volume touched are written. The sprite samples the
  ;; frame buffer through TEX0, modulates it by the time of day's shadow color, and blends the result
  ;; against what is already there weighted by the alpha the counting left behind -- so a pixel that is
  ;; more deeply inside the volume darkens slightly more.
  ;;
  ;; y-offset below includes the interlace half-line again: it is the restore value for the buckets
  ;; after this one, not for the resolve itself.
  (local-vars (t9-2 int) (ra-0 int) (ra-1 int) (ra-2 int))
  (let* ((v1-0 *display*)
         (framebuffer-page (-> v1-0 frames (-> v1-0 on-screen) draw frame1 fbp)))
    (* framebuffer-page 32)
    (let ((texture-width 512)
          (screen-height (-> *video-parms* screen-sy))
          (x-offset 1792)
          (screen-min-y (-> *video-parms* screen-miny)))
      2304
      (-> *video-parms* screen-maxy)
      (let ((strip-count (/ texture-width 32))
            (y-offset (+ (* *oddeven* 8) (* screen-min-y 16))))
        (let* ((t2-1 dma-buf)
               (t3-0 (the-as object (-> t2-1 base))))
          (set! (-> (the-as dma-packet t3-0) dma) (new 'static 'dma-tag :qwc #x5 :id (dma-tag-id cnt)))
          (set! (-> (the-as dma-packet t3-0) vif0) (new 'static 'vif-tag :cmd (vif-cmd flusha) :msk #x1))
          (set! (-> (the-as dma-packet t3-0) vif1) (new 'static 'vif-tag :imm #x5 :cmd (vif-cmd direct) :msk #x1))
          (set! (-> t2-1 base) (&+ (the-as pointer t3-0) 16)))
        (let* ((t2-2 dma-buf)
               (t3-2 (the-as object (-> t2-2 base))))
          (set! (-> (the-as gs-gif-tag t3-2) tag) (new 'static 'gif-tag64 :nloop #x1 :eop #x1 :nreg #x4))
          (set! (-> (the-as gs-gif-tag t3-2) regs)
                (new 'static
                     'gif-tag-regs
                     :regs0 (gif-reg-id a+d)
                     :regs1 (gif-reg-id a+d)
                     :regs2 (gif-reg-id a+d)
                     :regs3 (gif-reg-id a+d)
                     :regs4 (gif-reg-id a+d)
                     :regs5 (gif-reg-id a+d)
                     :regs6 (gif-reg-id a+d)
                     :regs7 (gif-reg-id a+d)
                     :regs8 (gif-reg-id a+d)
                     :regs9 (gif-reg-id a+d)
                     :regs10 (gif-reg-id a+d)
                     :regs11 (gif-reg-id a+d)
                     :regs12 (gif-reg-id a+d)
                     :regs13 (gif-reg-id a+d)
                     :regs14 (gif-reg-id a+d)
                     :regs15 (gif-reg-id a+d)))
          (set! (-> t2-2 base) (&+ (the-as pointer t3-2) 16)))
        (let* ((t2-3 dma-buf)
               (t3-4 (-> t2-3 base)))
          (set! (-> (the-as (pointer uint64) t3-4) 0) (the-as uint 0))
          (set! (-> (the-as (pointer gs-reg64) t3-4) 1) (gs-reg64 texflush))
          (set! (-> (the-as (pointer gs-test) t3-4) 2)
                (new 'static 'gs-test :ate #x1 :atst (gs-atest not-equal) :aref #x60 :zte #x1 :ztst (gs-ztest always)))
          (set! (-> (the-as (pointer gs-reg64) t3-4) 3) (gs-reg64 test-1))
          (set! (-> (the-as (pointer gs-frame) t3-4) 4) (new 'static 'gs-frame :fbw #x8 :fbp framebuffer-page))
          (set! (-> (the-as (pointer gs-reg64) t3-4) 5) (gs-reg64 frame-1))
          (set! (-> (the-as (pointer uint64) t3-4) 6) (the-as uint 0))
          (set! (-> (the-as (pointer gs-reg64) t3-4) 7) (gs-reg64 texflush))
          (set! (-> t2-3 base) (&+ t3-4 64)))
        (let ((t2-4 (-> dma-buf base)))
          (let* ((t3-6 dma-buf)
                 (t4-13 (the-as object (-> t3-6 base))))
            (set! (-> (the-as dma-packet t4-13) dma) (new 'static 'dma-tag :id (dma-tag-id cnt)))
            (set! (-> (the-as dma-packet t4-13) vif0) (new 'static 'vif-tag :cmd (vif-cmd flusha) :msk #x1))
            (set! (-> (the-as dma-packet t4-13) vif1) (new 'static 'vif-tag :cmd (vif-cmd direct) :msk #x1))
            (set! (-> t3-6 base) (&+ (the-as pointer t4-13) 16)))
          (let* ((t4-15 (the-as uint #x3f80000080404040))
                 (t3-8 (-> *time-of-day-context* current-shadow-color))
                 (t5-14 (the-as gs-rgbaq
                                (logior (logand (logior (logand (logior (logand t4-15 -256) (shr (shl (the int (* 128.0 (-> t3-8 x))) 56) 56)) -65281)
                                                        (shr (shl (the int (* 128.0 (-> t3-8 y))) 56) 48))
                                                -16711681)
                                        (shr (shl (the int (* 128.0 (-> t3-8 z))) 56) 40))))
                 (t3-12 dma-buf)
                 (t4-21 (the-as object (-> t3-12 base))))
            (set! (-> (the-as gs-gif-tag t4-21) tag) (new 'static 'gif-tag64 :nloop #x1 :flg (gif-flag reg-list) :nreg #x2))
            (set! (-> (the-as gs-gif-tag t4-21) regs) (new 'static 'gif-tag-regs :regs1 (gif-reg-id rgbaq)))
            (set! (-> (the-as (pointer gs-prim) t4-21) 2) (new 'static 'gs-prim :prim (gs-prim-type sprite) :tme #x1 :abe #x1))
            (set! (-> (the-as (pointer gs-rgbaq) t4-21) 3) t5-14)
            (set! (-> (the-as (inline-array gs-gif-tag) t4-21) 2 tag)
                  (new 'static 'gif-tag64 :eop #x1 :flg (gif-flag reg-list) :nreg #x4 :nloop strip-count))
            (set! (-> (the-as (inline-array gs-gif-tag) t4-21) 2 regs)
                  (new 'static
                       'gif-tag-regs
                       :regs0 (gif-reg-id st)
                       :regs1 (gif-reg-id xyz2)
                       :regs2 (gif-reg-id st)
                       :regs3 (gif-reg-id xyz2)))
            (set! (-> t3-12 base) (&+ (the-as pointer t4-21) 48)))
          (let ((x 0)
                (u 0))
            (dotimes (i strip-count)
              (let ((t8-0 x))
                (+! x 32)
                (let* ((t6-5 dma-buf)
                       (t7-0 (-> t6-5 base)))
                  (let ((t9-1 (shl (the-as int (* 0.00390625 (+ 0.5 (the float (the-as int u))))) 32)))
                    (let ((f0-12 (* 0.001953125 (+ 0.5 (the float t8-0))))) (.mov ra-0 f0-12))
                    ;;(.dsll32 ra-1 ra-0 0)
                    (set! ra-1 (shl ra-0 32))
                    ;;(.dsrl32 ra-2 ra-1 0)
                    (set! ra-2 (shr ra-1 32))
                    ;(.or t9-2 t9-1 ra-2)
                    (set! t9-2 (logior t9-1 ra-2)))
                  (set! (-> (the-as (pointer int64) t7-0)) t9-2)
                  (set! (-> (the-as (pointer gs-xyzf) t7-0) 1)
                        (new 'static 'gs-xyzf :z #x1ffff :y (* (+ screen-min-y u) 16) :x (* (+ x-offset t8-0) 16)))
                  (set! (-> (the-as (pointer gs-st) t7-0) 2)
                        (new 'static 'gs-st :s (* 0.001953125 (+ 0.5 (the float x))) :t (* 0.00390625 (+ 0.5 (the float screen-height)))))
                  (set! (-> (the-as (pointer gs-xyzf) t7-0) 3)
                        (new 'static 'gs-xyzf :z #x1ffff :y (* (+ screen-min-y screen-height) 16) :x (* (+ x-offset x) 16)))
                  (set! (-> t6-5 base) (&+ t7-0 32))))))
          (let ((t0-5 (/ (the-as int (+ (- -16 (the-as int t2-4)) (the-as int (-> dma-buf base)))) 16)))
            (cond
              ((nonzero? t0-5)
               (logior! (-> (the-as (pointer uint64) t2-4)) (shr (shl t0-5 48) 48))
               (logior! (-> (the-as (pointer uint64) t2-4) 1) (shl (shr (shl t0-5 48) 48) 32)))
              (else (set! (-> dma-buf base) t2-4)))))
        (let* ((a3-3 dma-buf)
               (t0-11 (the-as object (-> a3-3 base))))
          (set! (-> (the-as dma-packet t0-11) dma) (new 'static 'dma-tag :qwc #x7 :id (dma-tag-id cnt)))
          (set! (-> (the-as dma-packet t0-11) vif0) (new 'static 'vif-tag))
          (set! (-> (the-as dma-packet t0-11) vif1) (new 'static 'vif-tag :imm #x7 :cmd (vif-cmd direct) :msk #x1))
          (set! (-> a3-3 base) (&+ (the-as pointer t0-11) 16)))
        (let* ((a3-4 dma-buf)
               (t0-13 (the-as object (-> a3-4 base))))
          (set! (-> (the-as gs-gif-tag t0-13) tag) (new 'static 'gif-tag64 :nloop #x1 :eop #x1 :nreg #x6))
          (set! (-> (the-as gs-gif-tag t0-13) regs)
                (new 'static
                     'gif-tag-regs
                     :regs0 (gif-reg-id a+d)
                     :regs1 (gif-reg-id a+d)
                     :regs2 (gif-reg-id a+d)
                     :regs3 (gif-reg-id a+d)
                     :regs4 (gif-reg-id a+d)
                     :regs5 (gif-reg-id a+d)
                     :regs6 (gif-reg-id a+d)
                     :regs7 (gif-reg-id a+d)
                     :regs8 (gif-reg-id a+d)
                     :regs9 (gif-reg-id a+d)
                     :regs10 (gif-reg-id a+d)
                     :regs11 (gif-reg-id a+d)
                     :regs12 (gif-reg-id a+d)
                     :regs13 (gif-reg-id a+d)
                     :regs14 (gif-reg-id a+d)
                     :regs15 (gif-reg-id a+d)))
          (set! (-> a3-4 base) (&+ (the-as pointer t0-13) 16)))
        (let* ((a3-5 dma-buf)
               (t0-15 (-> a3-5 base)))
          (set! (-> (the-as (pointer gs-test) t0-15) 0)
                (new 'static 'gs-test :atst (gs-atest not-equal) :zte #x1 :ztst (gs-ztest greater-equal)))
          (set! (-> (the-as (pointer gs-reg64) t0-15) 1) (gs-reg64 test-1))
          (set! (-> (the-as (pointer gs-xy-offset) t0-15) 2) (new 'static 'gs-xy-offset :ofx (* x-offset 16) :ofy y-offset))
          (set! (-> (the-as (pointer gs-reg64) t0-15) 3) (gs-reg64 xyoffset-1))
          (set! (-> (the-as (pointer gs-alpha) t0-15) 4) (new 'static 'gs-alpha :b #x1 :d #x1))
          (set! (-> (the-as (pointer gs-reg64) t0-15) 5) (gs-reg64 alpha-1))
          (set! (-> (the-as (pointer gs-frame) t0-15) 6) (new 'static 'gs-frame :fbw #x8 :fbp framebuffer-page))
          (set! (-> (the-as (pointer gs-reg64) t0-15) 7) (gs-reg64 frame-1))
          (set! (-> (the-as (pointer gs-zbuf) t0-15) 8) (new 'static 'gs-zbuf :zbp #x1c0 :psm (gs-psm ct24)))
          (set! (-> (the-as (pointer gs-reg64) t0-15) 9) (gs-reg64 zbuf-1))
          (set! (-> (the-as (pointer uint64) t0-15) 10) (the-as uint 0))
          (set! (-> (the-as (pointer gs-reg64) t0-15) 11) (gs-reg64 texflush))
          (set! (-> a3-5 base) (&+ t0-15 96))))))
  (none))

(deftype shadow-stats (structure)
  ((num-single-tris  uint32 :offset-assert 0)
   (num-double-tris  uint32 :offset-assert 4)
   (num-single-edges uint32 :offset-assert 8)
   (num-double-edges uint32 :offset-assert 12))
  :method-count-assert 9
  :size-assert #x10
  :flag-assert #x900000010)

;; The shadow renderer's workspace, laid over *gsf-buffer* -- which the generic renderer also uses, so
;; the shadow pass owns it only for the length of its own bucket. dcache-top is the bump cursor: it
;; starts at data for each caster and each stage appends its list to it in pipeline order, first the
;; dual vertices and then the three work lists. Nothing is freed, and nothing moves, because the table
;; pointers recorded here are what the packet builders read.
;;
;; The *-table fields point at arrays inside the caster's packed geometry in the scratchpad; the *-list
;; fields point at what the classifiers built in the arena. center, plane, top-plane, near-plane, and
;; light-dir are all in camera space by the time any stage past shadow-init-vars runs. vtx-min is not
;; written by anything here.
(deftype shadow-dcache (structure)
  ((vtx-table              uint32 :offset-assert 0)
   (single-edge-table      uint32 :offset-assert 4)
   (double-edge-table      uint32 :offset-assert 8)
   (double-tri-table       uint32 :offset-assert 12)
   (dcache-top             uint32 :offset-assert 16)
   (num-facing-single-tris uint32 :offset-assert 20)
   (num-single-edges       uint32 :offset-assert 24)
   (num-double-edges       uint32 :offset-assert 28)
   (single-tri-list        uint32 :offset-assert 32)
   (single-edge-list       uint32 :offset-assert 36)
   (double-edge-list       uint32 :offset-assert 40)
   (ptr-dual-verts         uint32 :offset-assert 44)
   (stats                  shadow-stats :inline :offset-assert 48)
   (center                 vector :inline :offset-assert 64)
   (plane                  vector :inline :offset-assert 80)
   (top-plane              vector :inline :offset-assert 96)
   (near-plane             vector :inline :offset-assert 112)
   (light-dir              vector :inline :offset-assert 128)
   (vtx-min                vector :inline :offset-assert 144)
   (data                   uint8 :dynamic :offset-assert 160))
  :method-count-assert 9
  :size-assert #xa0
  :flag-assert #x9000000a0)

(#when PC_PORT
  ;; Shadow classification and edge construction are performed by the native implementation.
  (define shadow-vu0-block (new 'static 'vu-function :length #x0 :qlength #x0)))

(#when PC_PORT
  (def-mips2c shadow-xform-verts function)
  (def-mips2c shadow-execute (function shadow-dma-packet pointer pointer))

  ;; These stages are incorporated into native shadow-execute. They remain separate on EE because
  ;; the original function enters each assembly stage directly.
  (defun shadow-calc-dual-verts ()
    "Project every vertex onto the ground plane along its ray from the light locus."
    (none))
  (defun shadow-scissor-edges ()
    "Clip both ends of every extrusion against the camera's near plane."
    (none))
  (defun shadow-scissor-top ()
    "Pull any vertex above top-plane down onto it, shortening the volume from the top."
    (none))
  (defun shadow-init-vars ()
    "Move the light locus, light direction, and clipping planes into camera space."
    (none))
  (defun shadow-find-facing-single-tris ()
    "Mark and collect the single-sided triangles that face the light."
    (none))
  (defun shadow-find-single-edges ()
    "Collect the silhouette of a single-sided mesh."
    (none))
  (defun shadow-find-facing-double-tris ()
    "Choose the light-facing winding of every double-sided triangle."
    (none))
  (defun shadow-find-double-edges ()
    "Collect the silhouette of a double-sided mesh, two quads per interior fold."
    (none))
  (defun shadow-add-verts ()
    "Append the skinned-vertex and dual-vertex uploads."
    (none))
  (defun shadow-add-facing-single-tris ()
    "Append the single-sided cap list."
    (none))
  (defun shadow-add-single-edges ()
    "Append the single-sided silhouette list."
    (none))
  (defun shadow-add-double-tris ()
    "Append the double-sided cap list."
    (none))
  (defun shadow-add-double-edges ()
    "Append the double-sided silhouette list."
    (none)))

(defun shadow-vu0-upload ()
  "Upload the shadow face-classification and dual-vertex VU0 program."
  (#unless PC_PORT
    (let ((dma-buf *vu0-dma-list*))
      (let ((v1-0 dma-buf))
        (set! (-> v1-0 base) (-> v1-0 data))
        (set! (-> v1-0 end) (&-> v1-0 data-buffer (-> v1-0 allocated-length))))
      (dma-buffer-add-vu-function dma-buf shadow-vu0-block 0)
      (let* ((v1-1 dma-buf)
             (end-tag (-> v1-1 base)))
        (set! (-> (the-as (pointer int64) end-tag)) #x70000000)
        (s.d! (+ end-tag 8) 0)
        (set! (-> v1-1 base) (&+ end-tag 16)))
      (.sync.l)
      (dma-buffer-send-chain (the-as dma-bank-source #x10008000) dma-buf)))
  0
  (none))

(defun shadow-execute-all ((dma-buf dma-buffer) (queue shadow-queue))
  "Build the frame shadow pass for every nonempty queued run, bracket it with alpha initialization
   and resolve packets, and insert the completed chain into the shadow bucket."
  (add-profile-frame! #x40 0 #x40 #x80 'draw)
  (when (logtest? (vu1-renderer-mask shadow) *vu1-enable-user*)
    (when (> (-> queue cur-run) 0)
      (let ((has-shadow? #f))
        (dotimes (i (the-as int (-> queue cur-run)))
          (if (nonzero? (-> queue run i first))
              (set! has-shadow? #t)))
        (when has-shadow?
          (shadow-vu0-upload)
          (with-dma-buffer-add-bucket ((global-buf (-> (current-frame) global-buf)) (bucket-id shadow))
            (shadow-vu1-init-buffer global-buf)
            (flush-cache 0)
            (let ((workspace (the-as shadow-dcache *gsf-buffer*)))
              (set! (-> workspace stats num-single-tris) (the-as uint 0))
              (set! (-> workspace stats num-double-tris) (the-as uint 0))
              (set! (-> workspace stats num-single-edges) (the-as uint 0))
              (set! (-> workspace stats num-double-edges) (the-as uint 0)))
            0
            (shadow-dma-init global-buf)
            (dotimes (i (the-as int (-> queue cur-run)))
              (let ((run (-> queue run i)))
                (if (nonzero? (-> run first))
                    (set! (-> global-buf base) (shadow-execute (the-as shadow-dma-packet (-> run first)) (-> global-buf base))))))
            (shadow-dma-end global-buf))))
      (when #f
        (let ((workspace (the-as shadow-dcache *gsf-buffer*)))
          (format *stdcon* "#single tris : ~4d~%" (-> workspace stats num-single-tris))
          (format *stdcon* "#double tris : ~4d~%" (-> workspace stats num-double-tris))
          (format *stdcon* "#single edges: ~4d~%" (-> workspace stats num-single-edges))
          (format *stdcon* "#double edges: ~4d~%" (-> workspace stats num-double-edges))))))
  (add-profile-frame! #x40 #x42 #xe0 #x80 'draw)
  0
  (none))

(defmethod update-direction-from-time-of-day ((this shadow-control))
  "Copy the current time-of-day shadow direction into this control."
  (let ((shadow-direction (-> *time-of-day-context* current-shadow)))
    (set! (-> this settings shadow-dir x) (-> shadow-direction x))
    (set! (-> this settings shadow-dir y) (-> shadow-direction y))
    (set! (-> this settings shadow-dir z) (-> shadow-direction z)))
  0
  (none))

(defmethod collide-to-find-planes ((this shadow-control) (origin vector) (bottom-offset float) (top-offset float) (cast-length float))
  "Probe downward from origin and place the bottom and top clipping planes at the hit height plus
   their respective offsets. Disable drawing when no background surface is found within
   cast-length."
  (with-pp
    (let ((hit (new 'stack-no-clear 'collide-tri-result))
          (ray-start (new 'stack-no-clear 'vector))
          (ray (new 'stack-no-clear 'vector)))
      (vector-copy! ray-start origin)
      (set! (-> ray-start y) (+ 4096.0 (-> ray-start y)))
      (set-vector! ray 0.0 (- cast-length) 0.0 1.0)
      (cond
        ((>= (fill-and-probe-using-line-sphere *collide-cache*
                                               ray-start
                                               ray
                                               8192.0
                                               (collide-kind background)
                                               pp
                                               hit
                                               (new 'static 'pat-surface :noentity #x1))
             0.0)
         (let ((v1-2 this)) (logclear! (-> v1-2 settings flags) (shadow-flags disable-draw)))
         0
         (let ((v1-4 this)) (set! (-> v1-4 settings bot-plane w) (- (+ (-> hit intersect y) bottom-offset))))
         0
         (set! (-> this settings top-plane w) (- (+ (-> hit intersect y) top-offset)))
         0)
        (else (let ((v1-7 this)) (logior! (-> v1-7 settings flags) (shadow-flags disable-draw))) 0)))
    0
    (none)))

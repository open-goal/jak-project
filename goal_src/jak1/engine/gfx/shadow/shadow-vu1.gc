        (vu-pair (div Q start-dist.w end-dist.w) (nop)) ;; #x26f
        (vu-pair (b next-polygon-vertex) (nop)) ;; #x270
        (vu-pair (iaddi poly poly 0x7) (nop)) ;; #x271
        (label edge-enters)
        (vu-pair (bal sub-return interpolate-clip-vertex) (nop)) ;; #x272
        (vu-pair (iaddi vi07 poly 0x1) (nop)) ;; #x273
        (vu-pair (sq.xyzw clipped poly 1) (nop)) ;; #x274
        (vu-pair (b next-polygon-vertex) (nop)) ;; #x275
        (vu-pair (iaddi poly poly 0x7) (nop)) ;; #x276
        (label edge-leaves)
        (vu-pair (ibne vi00 vi02 pop-deferred-edge) (nop)) ;; #x277
        (vu-pair (div Q start-dist.w end-dist.w) (nop)) ;; #x278
        (vu-pair (bal sub-return interpolate-clip-vertex) (nop)) ;; #x279
        (vu-pair (nop) (nop)) ;; #x27a
        (vu-pair (sq.xyzw clipped poly 4) (nop)) ;; #x27b
        (vu-pair (iaddi poly poly 0x7) (nop)) ;; #x27c
        (vu-pair (isw.x poly stack-depth SHADOW-VU1-CLIP-STACK) (nop)) ;; #x27d
        (vu-pair (isw.y vi07 stack-depth SHADOW-VU1-CLIP-STACK) (nop)) ;; #x27e
        (vu-pair (iaddi stack-depth stack-depth 0x1) (nop)) ;; #x27f
        (vu-pair (b next-polygon-vertex) (nop)) ;; #x280
        (vu-pair (iaddi vi07 poly -0x3) (nop)) ;; #x281
        ;; This vertex is inside every plane. Undo the homogeneous scale, divide, build ST from the screen
        ;; position, and append an ST/XYZF pair to the clipper's output.
        (label project-polygon-vertex)
        (vu-pair (lq.xyzw edge-start vi07 0) (nop)) ;; #x282
        (vu-pair (iaddi out-count out-count 0x1) (nop)) ;; #x283
        (vu-pair (div Q vf00.w edge-start.w) (nop)) ;; #x284
        (vu-pair (nop) (mul.xyzw edge-start edge-start invhscale)) ;; #x285
        (vu-pair (iaddi out-cursor out-cursor 0x2) (nop)) ;; #x286
        (vu-pair (waitq) (subw.w edge-start vf00 vf00)) ;; #x287
        (vu-pair (nop) (mul.xyz edge-start edge-start Q)) ;; #x288
        (vu-pair (nop) (add.xy clip-st edge-start texoffset)) ;; #x289
        (vu-pair (nop) (add.xyzw edge-start edge-start hvdfoff)) ;; #x28a
        (vu-pair (nop) (mul.xy clip-st clip-st texscale)) ;; #x28b
        (vu-pair (nop) (mini.xyzw screen-min screen-min edge-start)) ;; #x28c
        (vu-pair (nop) (max.xyzw screen-max screen-max edge-start)) ;; #x28d
        (vu-pair (sq.xyzw clip-st out-cursor -2) (ftoi4.xyzw edge-start edge-start)) ;; #x28e
        (vu-pair (sq.xyzw edge-start out-cursor -1) (nop)) ;; #x28f
        (label pop-deferred-edge)
        (vu-pair (iblez stack-depth plane-done) (nop)) ;; #x290
        (vu-pair (nop) (nop)) ;; #x291
        (vu-pair (ilw.x poly stack-depth (- SHADOW-VU1-CLIP-STACK 1)) (nop)) ;; #x292
        (vu-pair (ilw.y vi07 stack-depth (- SHADOW-VU1-CLIP-STACK 1)) (nop)) ;; #x293
        (vu-pair (b next-polygon-vertex) (nop)) ;; #x294
        (vu-pair (iaddi stack-depth stack-depth -0x1) (nop)) ;; #x295
        (label plane-done)
        (vu-pair (jr clip-return) (nop)) ;; #x296
        (vu-pair (nop) (nop)) ;; #x297
        ;; Walk the finished polygon and emit it. An edge that enters or leaves the frustum is recursed into so
        ;; the crossing vertex exists before the edge is written out.
        (label emit-clipped-polygon)
        (vu-pair (iaddiu poly vi00 SHADOW-VU1-CLIP-POLY) (nop)) ;; #x298
        (label emit-edge)
        (vu-pair (ilwr.x vi08 poly) (nop)) ;; #x299
        (vu-pair (ilwr.y vi07 poly) (nop)) ;; #x29a
        (vu-pair (ilwr.z vi06 poly) (nop)) ;; #x29b
        (vu-pair (nop) (nop)) ;; #x29c
        (vu-pair (ibeq vi00 vi08 next-emit-edge) (nop)) ;; #x29d
        (vu-pair (lq.xyzw edge-start vi07 0) (nop)) ;; #x29e
        (vu-pair (ibeq vi07 vi08 next-emit-edge) (nop)) ;; #x29f
        (vu-pair (lq.xyzw edge-end vi08 0) (nop)) ;; #x2a0
        (vu-pair (jalr sub-return vi06) (nop)) ;; #x2a1
        (vu-pair (nop) (nop)) ;; #x2a2
        (vu-pair (nop) (nop)) ;; #x2a3
        (vu-pair (nop) (nop)) ;; #x2a4
        (vu-pair (fsand vi01 0x2) (nop)) ;; #x2a5
        (vu-pair (fsand vi02 0x2) (subw.w end-dist start-dist end-dist)) ;; #x2a6
        (vu-pair (ibeq vi02 vi01 next-emit-edge) (nop)) ;; #x2a7
        (vu-pair (nop) (nop)) ;; #x2a8
        (vu-pair (ibeq vi00 vi01 emit-entering-edge) (nop)) ;; #x2a9
        (vu-pair (div Q start-dist.w end-dist.w) (nop)) ;; #x2aa
        (vu-pair (bal sub-return interpolate-clip-vertex) (nop)) ;; #x2ab
        (vu-pair (nop) (nop)) ;; #x2ac
        (vu-pair (sq.xyzw clipped poly 4) (nop)) ;; #x2ad
        (vu-pair (iaddi vi07 poly 0x4) (nop)) ;; #x2ae
        (vu-pair (ior saved-poly poly vi00) (nop)) ;; #x2af
        (vu-pair (bal clip-return walk-polygon) (nop)) ;; #x2b0
        (vu-pair (iaddi poly poly 0x7) (nop)) ;; #x2b1
        (vu-pair (b next-emit-edge) (nop)) ;; #x2b2
        (vu-pair (ior poly saved-poly vi00) (nop)) ;; #x2b3
        (label emit-entering-edge)
        (vu-pair (bal sub-return interpolate-clip-vertex) (nop)) ;; #x2b4
        (vu-pair (nop) (nop)) ;; #x2b5
        (vu-pair (sq.xyzw clipped poly 1) (nop)) ;; #x2b6
        (vu-pair (iaddi vi07 poly 0x1) (nop)) ;; #x2b7
        (vu-pair (ior saved-poly poly vi00) (nop)) ;; #x2b8
        (vu-pair (bal clip-return walk-polygon) (nop)) ;; #x2b9
        (vu-pair (iaddi poly poly 0x7) (nop)) ;; #x2ba
        (vu-pair (ior poly saved-poly vi00) (nop)) ;; #x2bb
        (label next-emit-edge)
        (vu-pair (isubiu vi01 poly (- SHADOW-VU1-CLIP-STACK SHADOW-VU1-CLIP-STRIDE)) (nop)) ;; #x2bc
        (vu-pair (iswr.x vi00 poly) (nop)) ;; #x2bd
        (vu-pair (iswr.y vi00 poly) (nop)) ;; #x2be
        (vu-pair (ibltz vi01 emit-edge) (nop)) ;; #x2bf
        (vu-pair (iaddi poly poly 0x7) (nop)) ;; #x2c0
        ;; Nothing survived: skip the kick. Otherwise patch the vertex count and the EOP bit into the primitive
        ;; tag, kick the polygon, then kick a one-register A+D packet out of the constant area to put RGBAQ
        ;; back for whatever draws next.
        (vu-pair (ibeq vi00 out-count clip-return-point) (nop)) ;; #x2c1
        (vu-pair (mtir clip-return end-dist.x) (nop)) ;; #x2c2
        ;; iaddiu's immediate is fifteen bits, so the GIF tag's EOP bit takes two of them.
        ;; out-count is the surviving vertex count and becomes the tag's nloop at the same time.
        (vu-pair (iaddiu out-count out-count 0x4000) (nop)) ;; #x2c3
        (vu-pair (iaddiu out-count out-count 0x4000) (nop)) ;; #x2c4
        (vu-pair (iswr.x out-count out-gif) (nop)) ;; #x2c5
        (vu-pair (iaddiu vi01 vi00 SHADOW-VU1-CLIP-GIF) (nop)) ;; #x2c6
        (vu-pair (xgkick vi01) (nop)) ;; #x2c7
        (vu-pair (lq.xyzw start-dist vi00 (shadow-const adgif)) (nop)) ;; #x2c8
        (vu-pair (lq.xyzw end-dist vi00 (shadow-const flush)) (nop)) ;; #x2c9
        (vu-pair (iaddiu vi01 vi00 SHADOW-VU1-RESTORE-GIF) (nop)) ;; #x2ca
        ;; -0x7fff is 0x8001: nloop of one with EOP set, patched into the trailing A+D tag.
        (vu-pair (isubiu vi02 vi00 0x7fff) (nop)) ;; #x2cb
        (vu-pair (sq.xyzw start-dist vi01 0) (nop)) ;; #x2cc
        (vu-pair (iswr.x vi02 vi01) (nop)) ;; #x2cd
        (vu-pair (sq.xyzw end-dist vi01 1) (nop)) ;; #x2ce
        (vu-pair (nop) (nop)) ;; #x2cf
        (vu-pair (xgkick vi01) (nop)) ;; #x2d0
        (label clip-return-point)
        (vu-pair (nop) (nop)) ;; #x2d1
        (vu-pair (jr clip-return) (nop)) ;; #x2d2
        (vu-pair (nop) (nop)) ;; #x2d3
        ;; Six two-instruction plane tests, each leaving both endpoints' signed distances in the w lanes of
        ;; start-dist and end-dist. The sign of w is what the walk above tests with fsand.
        (label distance-to-minus-x)
        (vu-pair (jr sub-return) (addx.w start-dist edge-start edge-start)) ;; #x2d4
        (vu-pair (nop) (addx.w end-dist edge-end edge-end)) ;; #x2d5
        (label distance-to-plus-x)
        (vu-pair (jr sub-return) (subx.w start-dist edge-start edge-start)) ;; #x2d6
        (vu-pair (nop) (subx.w end-dist edge-end edge-end)) ;; #x2d7
        (label distance-to-minus-y)
        (vu-pair (jr sub-return) (addy.w start-dist edge-start edge-start)) ;; #x2d8
        (vu-pair (nop) (addy.w end-dist edge-end edge-end)) ;; #x2d9
        (label distance-to-plus-y)
        (vu-pair (jr sub-return) (suby.w start-dist edge-start edge-start)) ;; #x2da
        (vu-pair (nop) (suby.w end-dist edge-end edge-end)) ;; #x2db
        (label distance-to-minus-z)
        (vu-pair (jr sub-return) (addz.w start-dist edge-start edge-start)) ;; #x2dc
        (vu-pair (nop) (addz.w end-dist edge-end edge-end)) ;; #x2dd
        (label distance-to-plus-z)
        (vu-pair (jr sub-return) (subz.w start-dist edge-start edge-start)) ;; #x2de
        (vu-pair (nop) (subz.w end-dist edge-end edge-end)) ;; #x2df
        ;; Linear interpolation along an edge, using the ratio the caller already handed to the divider.
        (label interpolate-clip-vertex)
        (vu-pair (nop) (sub.xyzw clipped edge-end edge-start)) ;; #x2e0
        (vu-pair (waitq) (mul.xyzw clipped clipped Q)) ;; #x2e1
        (vu-pair (jr sub-return) (add.xyzw clipped edge-start clipped)) ;; #x2e2
        (vu-pair (nop) (nop))))) ;; #x2e3
  )

(defun shadow-vu1-add-constants ((dma-buf dma-buffer))
  "Upload the shadow projection, texture, fog, color, and GIF constants plus the initial VU1 GIF
   buffer template."
  (let* ((qwc 13)
         (packet-buffer dma-buf)
         (upload-packet (the-as dma-packet (-> packet-buffer base))))
    (set! (-> upload-packet dma) (new 'static 'dma-tag :id (dma-tag-id cnt) :qwc qwc))
    (set! (-> upload-packet vif0) (new 'static 'vif-tag :imm #x404 :cmd (vif-cmd stcycl)))
    (set! (-> upload-packet vif1) (new 'static 'vif-tag :imm #x370 :cmd (vif-cmd unpack-v4-32) :num qwc))
    (set! (-> packet-buffer base) (&+ (the-as pointer upload-packet) 16)))
  (let ((constants (the-as shadow-vu1-constants (-> dma-buf base)))
        (camera *math-camera*)
        (shadow-state *shadow-data*)
        (tri-template *shadow-vu1-tri-template*))
    (vector-copy! (-> constants hmgescale) (-> camera hmge-scale))
    (vector-copy! (-> constants invhscale) (-> camera inv-hmge-scale))
    (vector-copy! (-> constants texoffset) (-> shadow-state texoffset))
    (vector-copy! (-> constants texscale) (-> shadow-state texscale))
    (vector-copy! (-> constants hvdfoff) (-> camera hvdf-off))
    (set! (-> constants fog x) (-> camera pfog0))
    (vector-copy! (-> constants clrs 0) (-> shadow-state clrs 0))
    (vector-copy! (-> constants clrs 1) (-> shadow-state clrs 1))
    (set! (-> constants adgif qword) (-> tri-template adgif qword))
    (set! (-> constants texflush quad) (-> tri-template ad quad))
    (set! (-> constants flush quad) (-> tri-template flush quad))
    (set! (-> constants trigif qword) (-> tri-template trigif qword))
    (set! (-> constants quadgif qword) (-> tri-template quadgif qword)))
  (&+! (-> dma-buf base) 208)
  (let* ((gif-upload-buffer dma-buf)
         (gif-upload (the-as dma-packet (-> gif-upload-buffer base))))
    (set! (-> gif-upload dma) (new 'static 'dma-tag :qwc #x4 :id (dma-tag-id cnt)))
    (set! (-> gif-upload vif0) (new 'static 'vif-tag :imm #x404 :cmd (vif-cmd stcycl)))
    (set! (-> gif-upload vif1) (new 'static 'vif-tag :imm #x3ac :num #x4 :cmd (vif-cmd unpack-v4-32)))
    (set! (-> gif-upload-buffer base) (&+ (the-as pointer gif-upload) 16)))
  (let* ((gif-template-buffer dma-buf)
         (gif-template (the-as shadow-vu1-gifbuf-template (-> gif-template-buffer base))))
    (set! (-> gif-template adgif tag) (new 'static 'gif-tag64 :nloop #x1 :nreg #x2))
    (set! (-> gif-template adgif regs) (gs-reg-list a+d rgbaq))
    (set! (-> gif-template ad data) (the-as uint 0))
    (set! (-> gif-template ad cmds) (the-as uint 63))
    (set! (-> gif-template flush data) (the-as uint 0))
    (set! (-> gif-template flush cmds) (the-as uint 0))
    (set! (-> gif-template trigif tag)
          (new 'static
               'gif-tag64
               :nloop #x3
               :eop #x1
               :pre #x1
               :prim
               (new 'static 'gs-prim :prim (gs-prim-type tri-fan) :tme #x1)
               :nreg #x2))
    (set! (-> gif-template trigif regs) (gs-reg-list st xyzf2))
    (set! (-> gif-template-buffer base) (&+ (the-as pointer gif-template) 64)))
  (none))

(defun shadow-vu1-add-matrix ((dma-buf dma-buffer) (camera math-camera))
  "Upload the four perspective-matrix rows every shadow-volume vertex is transformed by, to
   SHADOW-VU1-MATRIX."
  (let ((qwc 4))
    (let* ((packet-buffer dma-buf)
           (upload-packet (the-as object (-> packet-buffer base))))
      (set! (-> (the-as dma-packet upload-packet) dma) (new 'static 'dma-tag :id (dma-tag-id cnt) :qwc qwc))
      (set! (-> (the-as dma-packet upload-packet) vif0) (new 'static 'vif-tag :imm #x404 :cmd (vif-cmd stcycl)))
      (set! (-> (the-as dma-packet upload-packet) vif1) (new 'static 'vif-tag :cmd (vif-cmd unpack-v4-32) :num qwc))
      (set! (-> packet-buffer base) (the-as pointer (&+ (the-as dma-packet upload-packet) 16)))))
  (let ((matrix-out (the-as object (-> dma-buf base))))
    (matrix-copy! (the-as matrix matrix-out) (-> camera perspective))
    (set! (-> dma-buf base) (the-as pointer (&+ (the-as matrix matrix-out) 64))))
  (none))

(defun shadow-vu1-init-buffer ((dma-buf dma-buffer))
  "Append the shadow VU1 program, constants, camera matrix, and initialization call to a DMA buffer."
  (dma-buffer-add-vu-function dma-buf shadow-vu1-block 1)
  (shadow-vu1-add-constants dma-buf)
  (shadow-vu1-add-matrix dma-buf *math-camera*)
  (dma-buffer-add-cnt-vif2 dma-buf
                           0
                           (new 'static 'vif-tag :cmd (vif-cmd mscalf) :msk #x1 :imm #xa)
                           (new 'static 'vif-tag :cmd (vif-cmd flushe) :msk #x1))
  (none))

        (vu-pair (sq.xyzw vf00 vi00 (+ SHADOW-VU1-CLIP-POLY (* 4 SHADOW-VU1-CLIP-STRIDE))) (nop)) ;; #x218
        (vu-pair (sq.xyzw vf00 vi00 (+ SHADOW-VU1-CLIP-POLY (* 5 SHADOW-VU1-CLIP-STRIDE))) (nop)) ;; #x219
        (vu-pair (iaddiu vi01 vi00 (vu-label distance-to-minus-x)) (nop)) ;; #x21a
        (vu-pair (isw.z vi01 vi00 SHADOW-VU1-CLIP-POLY) (nop)) ;; #x21b
        (vu-pair (iaddiu vi01 vi00 (vu-label distance-to-plus-x)) (nop)) ;; #x21c
        (vu-pair (isw.z vi01 vi00 (+ SHADOW-VU1-CLIP-POLY (* 1 SHADOW-VU1-CLIP-STRIDE))) (nop)) ;; #x21d
        (vu-pair (iaddiu vi01 vi00 (vu-label distance-to-minus-y)) (nop)) ;; #x21e
        (vu-pair (isw.z vi01 vi00 (+ SHADOW-VU1-CLIP-POLY (* 2 SHADOW-VU1-CLIP-STRIDE))) (nop)) ;; #x21f

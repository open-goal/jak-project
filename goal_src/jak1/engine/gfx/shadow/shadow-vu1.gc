;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/gfx/shadow/shadow-cpu.gc")

;; NOTE: this file is a bit of a mess now.
;; I'm planning to remove most of it and replace with PC shadow
;; renderer very soon.

;; The perspective matrix goes in at the bottom of VU1 data memory, one row per quadword.
(defconstant SHADOW-VU1-MATRIX 0)

;; The clipper's scratch, all of it above the constant block. Six polygon records, then the stack of
;; edges whose crossing vertex still has to be generated, then the clipper's own GIF buffer, then its
;; output vertices. SHADOW-VU1-CLIP-VERTS is where a drawing entry parks the clip-space positions it
;; is handing over; they are three quadwords apart because a polygon vertex slot is that big, even
;; though only the position quadword of each is ever written here.
(defconstant SHADOW-VU1-CLIP-POLY 893)
(defconstant SHADOW-VU1-CLIP-STRIDE 7)
(defconstant SHADOW-VU1-CLIP-STACK
  (+ SHADOW-VU1-CLIP-POLY (* 6 SHADOW-VU1-CLIP-STRIDE)))
(defconstant SHADOW-VU1-CLIP-GIF 940)
(defconstant SHADOW-VU1-CLIP-OUT 944)
(defconstant SHADOW-VU1-CLIP-VERTS 1000)

;; The two-quadword packet at the very top of VU memory that puts RGBAQ back after a clipped polygon.
(defconstant SHADOW-VU1-RESTORE-GIF 1022)

;; DECOMP BEGINS

;; Projection and GS state uploaded once per shadow pass, as one thirteen-quadword block. hmgescale
;; and invhscale scale into and back out of the clipper's homogeneous space; hvdfoff shifts the
;; divided position into GS screen and depth units; texoffset and texscale turn that same screen
;; position into the texture coordinate that reads the frame buffer's alpha plane back; fog x is
;; pfog0, the numerator of the perspective divide. clrs holds the two vertex colors whose alpha is the
;; stencil increment and decrement, and the four tags at the end are copied into both GIF output
;; buffers by the init entry.
(deftype shadow-vu1-constants (structure)
  ((hmgescale vector :inline)
   (invhscale vector :inline)
   (texoffset vector :inline)
   (texscale  vector :inline)
   (hvdfoff   vector :inline)
   (fog       vector :inline)
   (clrs      vector 2 :inline)
   (adgif     gs-gif-tag :inline)
   (texflush  ad-cmd :inline)
   (flush     ad-cmd :inline)
   (trigif    gs-gif-tag :inline)
   (quadgif   gs-gif-tag :inline)))

;; The field order of shadow-vu1-constants *is* the upload order, so a constant's VU address is its
;; quadword index within the type. Naming it that way rather than as thirteen separate numbers means
;; the addresses cannot drift away from the record shadow-vu1-add-constants fills in.
;;
;; (shadow-const hmgescale) is 880 and (shadow-const quadgif) is 892. It has to live below the deftype
;; rather than with the other addresses above, because it reads that type's layout.
(defconstant SHADOW-VU-CONSTS 880)

(defmacro shadow-const (&rest path)
  `(+ SHADOW-VU-CONSTS (/ (offset-of shadow-vu1-constants ,@path) 16)))

;; One VU1 GIF output buffer. The triangle and quad tags share the state prefix but select three or
;; four ST/XYZF vertex pairs.
(deftype shadow-vu1-gifbuf-template (structure)
  ((adgif   gs-gif-tag :inline)
   (ad      ad-cmd :inline)
   (flush   ad-cmd :inline)
   (trigif  gs-gif-tag :inline)
   (quadgif gs-gif-tag :inline)))

(define *shadow-vu1-tri-template*
  (new 'static
       'shadow-vu1-gifbuf-template
       :adgif
       (new 'static
            'gs-gif-tag
            :tag
            (new 'static 'gif-tag64 :nloop #x1 :nreg #x1)
            :regs
            (new 'static 'gif-tag-regs :regs0 (gif-reg-id a+d)))
       :ad
       (new 'static 'ad-cmd :cmd (gs-reg texflush))
       :flush
       (new 'static 'ad-cmd :data #x3f80000000000000 :cmd (gs-reg rgbaq))
       :trigif
       (new 'static
            'gs-gif-tag
            :tag
            (new 'static
                 'gif-tag64
                 :nloop #x1
                 :eop #x1
                 :pre #x1
                 :prim
                 (new 'static 'gs-prim :prim (gs-prim-type tri-fan) :tme #x1)
                 :nreg #x7)
            :regs
            (new 'static
                 'gif-tag-regs
                 :regs0 (gif-reg-id rgbaq)
                 :regs1 (gif-reg-id st)
                 :regs2 (gif-reg-id xyzf2)
                 :regs3 (gif-reg-id st)
                 :regs4 (gif-reg-id xyzf2)
                 :regs5 (gif-reg-id st)
                 :regs6 (gif-reg-id xyzf2)))
       :quadgif
       (new 'static
            'gs-gif-tag
            :tag
            (new 'static
                 'gif-tag64
                 :nloop #x1
                 :eop #x1
                 :pre #x1
                 :prim
                 (new 'static 'gs-prim :prim (gs-prim-type tri-fan) :tme #x1)
                 :nreg #x9)
            :regs
            (new 'static
                 'gif-tag-regs
                 :regs0 (gif-reg-id rgbaq)
                 :regs1 (gif-reg-id st)
                 :regs2 (gif-reg-id xyzf2)
                 :regs3 (gif-reg-id st)
                 :regs4 (gif-reg-id xyzf2)
                 :regs5 (gif-reg-id st)
                 :regs6 (gif-reg-id xyzf2)
                 :regs7 (gif-reg-id st)
                 :regs8 (gif-reg-id xyzf2)))))

(#when PC_PORT
  ;; Shadow-volume rasterization is performed by the native renderer on PC.
  (define shadow-vu1-block (new 'static 'vu-function :length #x0 :qlength #x0)))

(#unless PC_PORT
  ;; VU1's whole job is to rasterize a shadow volume the EE has already built. It gets a table of
  ;; skinned vertices, a table of their duals on the ground plane, and one index list; it does not know
  ;; what a silhouette is and never computes one.
  ;;
  ;; The three closed pieces of the volume come from the three drawing entries, dispatched by MSCALF:
  ;;
  ;;   SHADOW-VU1-ENTRY-SINGLE-TRIS   the near and far caps of a single-sided mesh
  ;;   SHADOW-VU1-ENTRY-EDGES         the walls, one quad per silhouette edge, both kinds of mesh
  ;;   SHADOW-VU1-ENTRY-DOUBLE-TRIS   the near and far caps of a double-sided mesh
  ;;   SHADOW-VU1-ENTRY-INIT          set both GIF buffers up and cache the constants
  ;;
  ;; Both cap entries make two passes over the same index list: once from the skinned vertices and once
  ;; from the duals, with two of the three indices exchanged so the ground cap faces outward. That is
  ;; what closes the volume, and it is why a cap list costs two passes and no extra data.
  ;;
  ;; Every path does the same thing to a vertex: multiply by the perspective matrix, divide xyz by w
  ;; scaled by pfog0, add hvdfoff, and derive ST from the same screen position so the polygon samples
  ;; the frame buffer's alpha plane exactly where it writes it. The face's own cross product picks
  ;; between the two vertex colors, whose alphas are the stencil's increment and decrement. A primitive
  ;; that touches the frustum goes to the clipper at the bottom of the program instead of straight out.
  ;;
  ;; The two GIF output buffers alternate around every XGKICK, so the next primitive is assembled while
  ;; the GS is still reading the last one. The alternation is a lane rotate of one register rather than
  ;; a test: gif-buffers holds A B A B and mr32 turns it by one lane per kick.
  (defvu1 shadow-vu1-block
    ;; Registers that hold the same thing for the whole program: the pair of GIF output buffer
    ;; addresses, and the projection, texture, and fog constants the init entry cached.
    (rlet ((gif-buffers :reg vf01)
           (hmgescale :reg vf02)
           (texoffset :reg vf03)
           (texscale :reg vf04)
           (hvdfoff :reg vf05)
           (screen-min :reg vf10)
           (screen-max :reg vf11)
           (fog :reg vf12)
           (invhscale :reg vf13))
      ;; The dispatch table. Each MSCALF immediate lands on one of these branch pairs; the E bit at the
      ;; bottom stops the program if the EE ever calls an unused slot.
      (vu-pair (b init-buffers) (nop)) ;; #x000
      (vu-pair (nop) (nop)) ;; #x001
      (vu-pair (b draw-single-caps) (nop)) ;; #x002
      (vu-pair (nop) (nop)) ;; #x003
      (vu-pair (b draw-silhouette-quads) (nop)) ;; #x004
      (vu-pair (nop) (nop)) ;; #x005
      (vu-pair (b draw-double-caps) (nop)) ;; #x006
      (vu-pair (nop) (nop)) ;; #x007
      (vu-pair (nop) (nop :e)) ;; #x008
      (vu-pair (nop) (nop)) ;; #x009
      ;; The drawing pipeline: one transform, one clip test, one GIF packet, repeated for every record in
      ;; whichever index list the entry selected.
      (rlet ((mtx-row-0 :reg vf06)
             (mtx-row-1 :reg vf07)
             (mtx-row-2 :reg vf08)
             (mtx-row-3 :reg vf09)
             (first-vertex :reg vf15)
             (indices :reg vf16)
             (pos-0 :reg vf17)
             (pos-1 :reg vf18)
             (pos-2 :reg vf19)
             (pos-3 :reg vf20)
             (clip-0 :reg vf21)
             (clip-1 :reg vf22)
             (clip-2 :reg vf23)
             (clip-3 :reg vf24)
             (st-0 :reg vf25)
             (st-1 :reg vf26)
             (st-2 :reg vf27)
             (st-3 :reg vf28)
             (edge-a :reg vf29)
             (edge-b :reg vf30)
             (color :reg vf31)
             (gif-buffer :reg vi02)
             (list :reg vi03)
             (slot-0 :reg vi04)
             (slot-1 :reg vi05)
             (slot-2 :reg vi06)
             (count :reg vi08))
        ;; vi01 and vi07 stay physical. vi01 is the flag-test scratch in every loop and the cap
        ;; orientation in the double-sided one; vi07 belongs to the clipper and is only saved and
        ;; restored around a call into it.
        ;; Entry SHADOW-VU1-ENTRY-INIT. Cache both GIF output buffer addresses in the four lanes of one
        ;; register and load the projection constants every drawing entry needs. Rotating that register's
        ;; lanes is how the two buffers alternate later, so the order comes out A B A B without a test.
        (label init-buffers)
        (vu-pair (iaddiu vi01 vi00 SHADOW-VU1-GIFBUF-A) (nop)) ;; #x00a
        (vu-pair (iaddiu gif-buffer vi00 SHADOW-VU1-GIFBUF-B) (nop)) ;; #x00b
        (vu-pair (mfir.x gif-buffers vi01) (nop)) ;; #x00c
        (vu-pair (mfir.y gif-buffers gif-buffer) (nop)) ;; #x00d
        (vu-pair (mfir.z gif-buffers vi01) (nop)) ;; #x00e
        (vu-pair (mfir.w gif-buffers gif-buffer) (nop)) ;; #x00f
        (vu-pair (lq.xyzw hmgescale vi00 (shadow-const hmgescale)) (nop)) ;; #x010
        (vu-pair (lq.xyzw texoffset vi00 (shadow-const texoffset)) (nop)) ;; #x011
        (vu-pair (lq.xyzw texscale vi00 (shadow-const texscale)) (nop)) ;; #x012
        (vu-pair (lq.xyzw hvdfoff vi00 (shadow-const hvdfoff)) (nop)) ;; #x013
        (vu-pair (lq.xyzw fog vi00 (shadow-const fog)) (nop :e)) ;; #x014
        (vu-pair (lq.xyzw invhscale vi00 (shadow-const invhscale)) (nop)) ;; #x015
        ;; Entry SHADOW-VU1-ENTRY-SINGLE-TRIS: the near and far caps of a single-sided volume. Each record in
        ;; the triangle list is three vertex indices. The first loop draws them from the skinned vertices; the
        ;; second draws the same triangles from their duals with two indices exchanged, so the ground cap
        ;; faces the other way and the volume is closed.
        ;;
        ;; The layout of a GIF output buffer, filled in from slot 3 onward as each vertex is finished:
        ;;
        ;;    0  A+D tag, one register        3  RGBAQ, the front or back face color
        ;;    1  TEXFLUSH                     4  ST of vertex 0     5  XYZF2 of vertex 0
        ;;    2  the primitive's GIF tag      6  ST of vertex 1     7  XYZF2 of vertex 1
        ;;                                    8  ST of vertex 2     9  XYZF2 of vertex 2
        ;;                                   10  ST of vertex 3    11  XYZF2 of vertex 3
        ;;
        ;; The TEXFLUSH is not decoration. TEX0 points at the frame buffer this pass is writing, so the
        ;; texture cache has to be dropped before every primitive or a wall would sample the alpha as it stood
        ;; several polygons ago.
        (label draw-single-caps)
        (vu-pair (iaddiu list vi00 SHADOW-VU1-TRI-LIST) (nop)) ;; #x016
        (vu-pair (ilwr.x count list) (nop)) ;; #x017
        (vu-pair (mtir gif-buffer gif-buffers.x) (nop)) ;; #x018
        (vu-pair (iaddi list list 0x1) (addw.z st-0 vf00 vf00)) ;; #x019
        (vu-pair (lq.xyzw st-0 vi00 (shadow-const adgif)) (addw.z st-1 vf00 vf00)) ;; #x01a
        (vu-pair (lq.xyzw edge-a vi00 (shadow-const texflush)) (addw.z st-2 vf00 vf00)) ;; #x01b
        (vu-pair (lq.xyzw edge-b vi00 (shadow-const trigif)) (addw.z st-3 vf00 vf00)) ;; #x01c
        (vu-pair (lq.xyzw mtx-row-0 vi00 SHADOW-VU1-MATRIX) (nop)) ;; #x01d
        (vu-pair (lq.xyzw mtx-row-1 vi00 (+ SHADOW-VU1-MATRIX 1)) (nop)) ;; #x01e
        (vu-pair (lq.xyzw mtx-row-2 vi00 (+ SHADOW-VU1-MATRIX 2)) (nop)) ;; #x01f
        (vu-pair (lq.xyzw mtx-row-3 vi00 (+ SHADOW-VU1-MATRIX 3)) (nop)) ;; #x020
        (vu-pair (mtir vi01 gif-buffers.y) (nop)) ;; #x021
        (vu-pair (sq.xyzw st-0 gif-buffer 0) (nop)) ;; #x022
        (vu-pair (sq.xyzw edge-a gif-buffer 1) (nop)) ;; #x023
        (vu-pair (sq.xyzw edge-b gif-buffer 2) (nop)) ;; #x024
        (vu-pair (sq.xyzw st-0 vi01 0) (nop)) ;; #x025
        (vu-pair (sq.xyzw edge-a vi01 1) (nop)) ;; #x026
        (vu-pair (sq.xyzw edge-b vi01 2) (nop)) ;; #x027
        ;; One triangle. Transform three vertices, divide by w, take the face's own cross product to choose the
        ;; front or back alpha, and clip. The screen position is also the texture coordinate:
        ;; ST is (screen + texoffset) * texscale, so a polygon samples the alpha at exactly the pixel it is
        ;; about to write. screen-min and screen-max accumulate a screen bounding box that nothing in this
        ;; program ever reads back.
        (label single-cap-loop)
        (vu-pair (lqi.xyzw indices list) (nop)) ;; #x028
        (vu-pair (nop) (nop)) ;; #x029
        (vu-pair (nop) (nop)) ;; #x02a
        (vu-pair (nop) (nop)) ;; #x02b
        (vu-pair (mtir slot-0 indices.x) (nop)) ;; #x02c
        (vu-pair (mtir slot-1 indices.y) (nop)) ;; #x02d
        (vu-pair (mtir slot-2 indices.z) (nop)) ;; #x02e
        (vu-pair (nop) (nop)) ;; #x02f
        (vu-pair (lq.xyzw pos-0 slot-0 SHADOW-VU1-VERTS) (nop)) ;; #x030
        (vu-pair (lq.xyzw pos-1 slot-1 SHADOW-VU1-VERTS) (nop)) ;; #x031
        (vu-pair (lq.xyzw pos-2 slot-2 SHADOW-VU1-VERTS) (nop)) ;; #x032
        (vu-pair (nop) (mulaw.xyzw ACC mtx-row-3 vf00)) ;; #x033
        (vu-pair (move.xyzw first-vertex pos-0) (maddax.xyzw ACC mtx-row-0 pos-0)) ;; #x034
        (vu-pair (nop) (madday.xyzw ACC mtx-row-1 pos-0)) ;; #x035
        (vu-pair (nop) (maddz.xyzw pos-0 mtx-row-2 pos-0)) ;; #x036
        (vu-pair (nop) (mulaw.xyzw ACC mtx-row-3 vf00)) ;; #x037
        (vu-pair (nop) (sub.xyzw edge-a pos-1 first-vertex)) ;; #x038
        (vu-pair (nop) (sub.xyzw edge-b pos-2 first-vertex)) ;; #x039
        (vu-pair (div Q fog.x pos-0.w) (maddax.xyzw ACC mtx-row-0 pos-1)) ;; #x03a
        (vu-pair (nop) (mul.xyzw clip-0 pos-0 hmgescale)) ;; #x03b
        (vu-pair (nop) (madday.xyzw ACC mtx-row-1 pos-1)) ;; #x03c
        (vu-pair (nop) (maddz.xyzw pos-1 mtx-row-2 pos-1)) ;; #x03d
        (vu-pair (nop) (mulaw.xyzw ACC mtx-row-3 vf00)) ;; #x03e
        (vu-pair (nop) (maddax.xyzw ACC mtx-row-0 pos-2)) ;; #x03f
        (vu-pair (nop) (madday.xyzw ACC mtx-row-1 pos-2)) ;; #x040
        (vu-pair (div Q fog.x pos-1.w) (mul.xyz pos-0 pos-0 Q)) ;; #x041
        (vu-pair (nop) (maddz.xyzw pos-2 mtx-row-2 pos-2)) ;; #x042
        (vu-pair (nop) (mul.xyzw clip-1 pos-1 hmgescale)) ;; #x043
        (vu-pair (nop) (opmula.xyz ACC edge-a edge-b)) ;; #x044
        (vu-pair (nop) (opmsub.xyz edge-a edge-b edge-a)) ;; #x045
        (vu-pair (nop) (add.xy st-0 pos-0 texoffset)) ;; #x046
        (vu-pair (nop) (add.xyzw pos-0 pos-0 hvdfoff)) ;; #x047
        (vu-pair (div Q fog.x pos-2.w) (mul.xyz pos-1 pos-1 Q)) ;; #x048
        (vu-pair (nop) (mul.xyzw clip-2 pos-2 hmgescale)) ;; #x049
        (vu-pair (nop) (mul.xyz edge-a edge-a first-vertex)) ;; #x04a
        (vu-pair (nop) (mul.xy st-0 st-0 texscale)) ;; #x04b
        (vu-pair (nop) (mini.xyzw screen-min screen-min pos-0)) ;; #x04c
        (vu-pair (nop) (max.xyzw screen-max screen-max pos-0)) ;; #x04d
        (vu-pair (nop) (ftoi4.xyzw pos-0 pos-0)) ;; #x04e
        (vu-pair (nop) (add.xy st-1 pos-1 texoffset)) ;; #x04f
        (vu-pair (nop) (add.xyzw pos-1 pos-1 hvdfoff)) ;; #x050
        (vu-pair (fcset 0x0) (addy.x edge-a edge-a edge-a)) ;; #x051
        (vu-pair (nop) (mul.xyz pos-2 pos-2 Q)) ;; #x052
        (vu-pair (sq.xyzw st-0 gif-buffer 4) (mini.xyzw screen-min screen-min pos-1)) ;; #x053
        (vu-pair (sq.xyzw pos-0 gif-buffer 5) (max.xyzw screen-max screen-max pos-1)) ;; #x054
        (vu-pair (nop) (clipw.xyz clip-0 clip-0)) ;; #x055
        (vu-pair (nop) (mul.xy st-1 st-1 texscale)) ;; #x056
        (vu-pair (nop) (addz.x edge-a edge-a edge-a)) ;; #x057
        (vu-pair (nop) (ftoi4.xyzw pos-1 pos-1)) ;; #x058
        (vu-pair (nop) (add.xy st-2 pos-2 texoffset)) ;; #x059
        (vu-pair (sq.xyzw st-1 gif-buffer 6) (add.xyzw pos-2 pos-2 hvdfoff)) ;; #x05a
        (vu-pair (fsand vi01 0x2) (clipw.xyz clip-1 clip-1)) ;; #x05b
        (vu-pair (sq.xyzw pos-1 gif-buffer 7) (clipw.xyz clip-2 clip-2)) ;; #x05c
        (vu-pair (ibeq vi00 vi01 single-cap-back-color) (mul.xy st-2 st-2 texscale)) ;; #x05d
        (vu-pair (nop) (mini.xyzw screen-min screen-min pos-2)) ;; #x05e
        (vu-pair (b single-cap-emit) (nop)) ;; #x05f
        (vu-pair (lq.xyzw color vi00 (shadow-const clrs 1)) (max.xyzw screen-max screen-max pos-2)) ;; #x060
        (label single-cap-back-color)
        (vu-pair (lq.xyzw color vi00 (shadow-const clrs 0)) (max.xyzw screen-max screen-max pos-2)) ;; #x061
        (label single-cap-emit)
        ;; Six clip bits per vertex, three vertices: anything set means the triangle touched the frustum.
        (vu-pair (fcand vi01 0x3ffff) (ftoi4.xyzw pos-2 pos-2)) ;; #x062
        (vu-pair (ibne vi00 vi01 single-cap-clip) (nop)) ;; #x063
        (vu-pair (iaddi count count -0x1) (nop)) ;; #x064
        (vu-pair (sq.xyzw st-2 gif-buffer 8) (nop)) ;; #x065
        (vu-pair (sq.xyzw color gif-buffer 3) (nop)) ;; #x066
        (vu-pair (sq.xyzw pos-2 gif-buffer 9) (nop)) ;; #x067
        (vu-pair (xgkick gif-buffer) (nop)) ;; #x068
        (vu-pair (mtir gif-buffer gif-buffers.y) (nop)) ;; #x069
        (vu-pair (mr32.xyzw gif-buffers gif-buffers) (nop)) ;; #x06a
        (label single-cap-next)
        (vu-pair (ibgtz count single-cap-loop) (nop)) ;; #x06b
        (vu-pair (nop) (nop)) ;; #x06c
        (vu-pair (iaddiu list vi00 SHADOW-VU1-TRI-LIST) (nop)) ;; #x06d
        (vu-pair (ilwr.x count list) (nop)) ;; #x06e
        (vu-pair (iaddi list list 0x1) (nop)) ;; #x06f
        ;; The far cap: the same triangles read from the dual vertices, with slot-1 and slot-2 exchanged.
        (label single-dual-cap-loop)
        (vu-pair (lqi.xyzw indices list) (nop)) ;; #x070
        (vu-pair (nop) (nop)) ;; #x071
        (vu-pair (nop) (nop)) ;; #x072
        (vu-pair (nop) (nop)) ;; #x073
        (vu-pair (mtir slot-0 indices.x) (nop)) ;; #x074
        (vu-pair (mtir slot-1 indices.y) (nop)) ;; #x075
        (vu-pair (mtir slot-2 indices.z) (nop)) ;; #x076
        (vu-pair (nop) (nop)) ;; #x077
        (vu-pair (lq.xyzw pos-0 slot-0 SHADOW-VU1-DUAL-VERTS) (nop)) ;; #x078
        (vu-pair (lq.xyzw pos-1 slot-2 SHADOW-VU1-DUAL-VERTS) (nop)) ;; #x079
        (vu-pair (lq.xyzw pos-2 slot-1 SHADOW-VU1-DUAL-VERTS) (nop)) ;; #x07a
        (vu-pair (nop) (mulaw.xyzw ACC mtx-row-3 vf00)) ;; #x07b
        (vu-pair (move.xyzw first-vertex pos-0) (maddax.xyzw ACC mtx-row-0 pos-0)) ;; #x07c
        (vu-pair (nop) (madday.xyzw ACC mtx-row-1 pos-0)) ;; #x07d
        (vu-pair (nop) (maddz.xyzw pos-0 mtx-row-2 pos-0)) ;; #x07e
        (vu-pair (nop) (mulaw.xyzw ACC mtx-row-3 vf00)) ;; #x07f
        (vu-pair (nop) (sub.xyzw edge-a pos-1 first-vertex)) ;; #x080
        (vu-pair (nop) (sub.xyzw edge-b pos-2 first-vertex)) ;; #x081
        (vu-pair (div Q fog.x pos-0.w) (maddax.xyzw ACC mtx-row-0 pos-1)) ;; #x082
        (vu-pair (nop) (mul.xyzw clip-0 pos-0 hmgescale)) ;; #x083
        (vu-pair (nop) (madday.xyzw ACC mtx-row-1 pos-1)) ;; #x084
        (vu-pair (nop) (maddz.xyzw pos-1 mtx-row-2 pos-1)) ;; #x085
        (vu-pair (nop) (mulaw.xyzw ACC mtx-row-3 vf00)) ;; #x086
        (vu-pair (nop) (maddax.xyzw ACC mtx-row-0 pos-2)) ;; #x087
        (vu-pair (nop) (madday.xyzw ACC mtx-row-1 pos-2)) ;; #x088
        (vu-pair (div Q fog.x pos-1.w) (mul.xyz pos-0 pos-0 Q)) ;; #x089
        (vu-pair (nop) (maddz.xyzw pos-2 mtx-row-2 pos-2)) ;; #x08a
        (vu-pair (nop) (mul.xyzw clip-1 pos-1 hmgescale)) ;; #x08b
        (vu-pair (nop) (opmula.xyz ACC edge-a edge-b)) ;; #x08c
        (vu-pair (nop) (opmsub.xyz edge-a edge-b edge-a)) ;; #x08d
        (vu-pair (nop) (add.xy st-0 pos-0 texoffset)) ;; #x08e
        (vu-pair (nop) (add.xyzw pos-0 pos-0 hvdfoff)) ;; #x08f
        (vu-pair (div Q fog.x pos-2.w) (mul.xyz pos-1 pos-1 Q)) ;; #x090
        (vu-pair (nop) (mul.xyzw clip-2 pos-2 hmgescale)) ;; #x091
        (vu-pair (nop) (mul.xyz edge-a edge-a first-vertex)) ;; #x092
        (vu-pair (nop) (mul.xy st-0 st-0 texscale)) ;; #x093
        (vu-pair (nop) (mini.xyzw screen-min screen-min pos-0)) ;; #x094
        (vu-pair (nop) (max.xyzw screen-max screen-max pos-0)) ;; #x095
        (vu-pair (nop) (ftoi4.xyzw pos-0 pos-0)) ;; #x096
        (vu-pair (nop) (add.xy st-1 pos-1 texoffset)) ;; #x097
        (vu-pair (nop) (add.xyzw pos-1 pos-1 hvdfoff)) ;; #x098
        (vu-pair (fcset 0x0) (addy.x edge-a edge-a edge-a)) ;; #x099
        (vu-pair (nop) (mul.xyz pos-2 pos-2 Q)) ;; #x09a
        (vu-pair (sq.xyzw st-0 gif-buffer 4) (mini.xyzw screen-min screen-min pos-1)) ;; #x09b
        (vu-pair (sq.xyzw pos-0 gif-buffer 5) (max.xyzw screen-max screen-max pos-1)) ;; #x09c
        (vu-pair (nop) (clipw.xyz clip-0 clip-0)) ;; #x09d
        (vu-pair (nop) (mul.xy st-1 st-1 texscale)) ;; #x09e
        (vu-pair (iaddi count count -0x1) (addz.x edge-a edge-a edge-a)) ;; #x09f
        (vu-pair (nop) (ftoi4.xyzw pos-1 pos-1)) ;; #x0a0
        (vu-pair (nop) (add.xy st-2 pos-2 texoffset)) ;; #x0a1
        (vu-pair (sq.xyzw st-1 gif-buffer 6) (add.xyzw pos-2 pos-2 hvdfoff)) ;; #x0a2
        (vu-pair (fsand vi01 0x2) (clipw.xyz clip-1 clip-1)) ;; #x0a3
        (vu-pair (sq.xyzw pos-1 gif-buffer 7) (clipw.xyz clip-2 clip-2)) ;; #x0a4
        (vu-pair (ibeq vi00 vi01 single-dual-cap-back-color) (mul.xy st-2 st-2 texscale)) ;; #x0a5
        (vu-pair (nop) (mini.xyzw screen-min screen-min pos-2)) ;; #x0a6
        (vu-pair (b single-dual-cap-emit) (nop)) ;; #x0a7
        (vu-pair (lq.xyzw color vi00 (shadow-const clrs 1)) (max.xyzw screen-max screen-max pos-2)) ;; #x0a8
        (label single-dual-cap-back-color)
        (vu-pair (lq.xyzw color vi00 (shadow-const clrs 0)) (max.xyzw screen-max screen-max pos-2)) ;; #x0a9
        (label single-dual-cap-emit)
        (vu-pair (fcand vi01 0x3ffff) (ftoi4.xyzw pos-2 pos-2)) ;; #x0aa
        (vu-pair (ibne vi00 vi01 single-dual-cap-clip) (nop)) ;; #x0ab
        (vu-pair (sq.xyzw st-2 gif-buffer 8) (nop)) ;; #x0ac
        (vu-pair (sq.xyzw color gif-buffer 3) (nop)) ;; #x0ad
        (vu-pair (sq.xyzw pos-2 gif-buffer 9) (nop)) ;; #x0ae
        (vu-pair (xgkick gif-buffer) (nop)) ;; #x0af
        (vu-pair (mtir gif-buffer gif-buffers.y) (nop)) ;; #x0b0
        (vu-pair (mr32.xyzw gif-buffers gif-buffers) (nop)) ;; #x0b1
        (label single-dual-cap-next)
        (vu-pair (ibgtz count single-dual-cap-loop) (nop)) ;; #x0b2
        (vu-pair (nop) (nop)) ;; #x0b3
        (vu-pair (nop) (nop :e)) ;; #x0b4
        (vu-pair (nop) (nop)) ;; #x0b5
        ;; A triangle crossed the frustum. Park its three clip-space positions where the clipper expects them,
        ;; pack the four integer registers the clipper will overwrite into the lanes of one vector, and call it.
        (label single-cap-clip)
        (vu-pair (sq.xyzw clip-0 vi00 SHADOW-VU1-CLIP-VERTS) (nop)) ;; #x0b6
        (vu-pair (sq.xyzw clip-1 vi00 (+ SHADOW-VU1-CLIP-VERTS 3)) (nop)) ;; #x0b7
        (vu-pair (sq.xyzw clip-2 vi00 (+ SHADOW-VU1-CLIP-VERTS 6)) (nop)) ;; #x0b8
        (vu-pair (sq.xyzw color vi00 (+ SHADOW-VU1-CLIP-GIF 2)) (nop)) ;; #x0b9
        (vu-pair (mfir.x edge-a gif-buffer) (nop)) ;; #x0ba
        (vu-pair (mfir.y edge-a list) (nop)) ;; #x0bb
        (vu-pair (mfir.z edge-a vi07) (nop)) ;; #x0bc
        (vu-pair (bal vi15 clip-triangle) (nop)) ;; #x0bd
        (vu-pair (mfir.w edge-a count) (nop)) ;; #x0be
        (vu-pair (mtir count edge-a.w) (nop)) ;; #x0bf
        (vu-pair (mtir list edge-a.y) (nop)) ;; #x0c0
        (vu-pair (mtir vi07 edge-a.z) (nop)) ;; #x0c1
        (vu-pair (b single-cap-next) (nop)) ;; #x0c2
        (vu-pair (mtir gif-buffer edge-a.x) (nop)) ;; #x0c3
        (label single-dual-cap-clip)
        (vu-pair (sq.xyzw clip-0 vi00 SHADOW-VU1-CLIP-VERTS) (nop)) ;; #x0c4
        (vu-pair (sq.xyzw clip-1 vi00 (+ SHADOW-VU1-CLIP-VERTS 3)) (nop)) ;; #x0c5
        (vu-pair (sq.xyzw clip-2 vi00 (+ SHADOW-VU1-CLIP-VERTS 6)) (nop)) ;; #x0c6
        (vu-pair (sq.xyzw color vi00 (+ SHADOW-VU1-CLIP-GIF 2)) (nop)) ;; #x0c7
        (vu-pair (mfir.x edge-a gif-buffer) (nop)) ;; #x0c8
        (vu-pair (mfir.y edge-a list) (nop)) ;; #x0c9
        (vu-pair (mfir.z edge-a vi07) (nop)) ;; #x0ca
        (vu-pair (bal vi15 clip-triangle) (nop)) ;; #x0cb
        (vu-pair (mfir.w edge-a count) (nop)) ;; #x0cc
        (vu-pair (mtir count edge-a.w) (nop)) ;; #x0cd
        (vu-pair (mtir list edge-a.y) (nop)) ;; #x0ce
        (vu-pair (mtir vi07 edge-a.z) (nop)) ;; #x0cf
        (vu-pair (b single-dual-cap-next) (nop)) ;; #x0d0
        (vu-pair (mtir gif-buffer edge-a.x) (nop)) ;; #x0d1
        ;; Entry SHADOW-VU1-ENTRY-EDGES: the walls. Each record is two vertex indices and an orientation flag,
        ;; and the quad runs from those two vertices to their two duals. The flag chooses which endpoint leads,
        ;; which is how a wall off a back-facing double-sided sheet still winds outward.
        (label draw-silhouette-quads)
        (vu-pair (iaddiu list vi00 SHADOW-VU1-EDGE-LIST) (nop)) ;; #x0d2
        (vu-pair (ilwr.x count list) (nop)) ;; #x0d3
        (vu-pair (mtir gif-buffer gif-buffers.x) (nop)) ;; #x0d4
        (vu-pair (iaddi list list 0x1) (addw.z st-0 vf00 vf00)) ;; #x0d5
        (vu-pair (lq.xyzw st-0 vi00 (shadow-const adgif)) (addw.z st-1 vf00 vf00)) ;; #x0d6
        (vu-pair (lq.xyzw edge-a vi00 (shadow-const texflush)) (addw.z st-2 vf00 vf00)) ;; #x0d7
        (vu-pair (lq.xyzw edge-b vi00 (shadow-const quadgif)) (nop)) ;; #x0d8
        (vu-pair (lq.xyzw mtx-row-0 vi00 SHADOW-VU1-MATRIX) (nop)) ;; #x0d9
        (vu-pair (lq.xyzw mtx-row-1 vi00 (+ SHADOW-VU1-MATRIX 1)) (nop)) ;; #x0da
        (vu-pair (lq.xyzw mtx-row-2 vi00 (+ SHADOW-VU1-MATRIX 2)) (nop)) ;; #x0db
        (vu-pair (lq.xyzw mtx-row-3 vi00 (+ SHADOW-VU1-MATRIX 3)) (nop)) ;; #x0dc
        (vu-pair (mtir vi01 gif-buffers.y) (nop)) ;; #x0dd
        (vu-pair (sq.xyzw st-0 gif-buffer 0) (nop)) ;; #x0de
        (vu-pair (sq.xyzw edge-a gif-buffer 1) (nop)) ;; #x0df
        (vu-pair (sq.xyzw edge-b gif-buffer 2) (nop)) ;; #x0e0
        (vu-pair (sq.xyzw st-0 vi01 0) (nop)) ;; #x0e1
        (vu-pair (sq.xyzw edge-a vi01 1) (nop)) ;; #x0e2
        (vu-pair (sq.xyzw edge-b vi01 2) (nop)) ;; #x0e3
        (label quad-loop)
        (vu-pair (lqi.xyzw indices list) (nop)) ;; #x0e4
        (vu-pair (nop) (nop)) ;; #x0e5
        (vu-pair (nop) (nop)) ;; #x0e6
        (vu-pair (nop) (nop)) ;; #x0e7
        (vu-pair (mtir slot-2 indices.z) (nop)) ;; #x0e8
        (vu-pair (mtir slot-0 indices.x) (nop)) ;; #x0e9
        (vu-pair (mtir slot-1 indices.y) (nop)) ;; #x0ea
        (vu-pair (ibeq vi00 slot-2 quad-swapped) (nop)) ;; #x0eb
        (vu-pair (nop) (nop)) ;; #x0ec
        (vu-pair (lq.xyzw pos-0 slot-0 SHADOW-VU1-VERTS) (nop)) ;; #x0ed
        (vu-pair (lq.xyzw pos-1 slot-1 SHADOW-VU1-VERTS) (nop)) ;; #x0ee
        (vu-pair (lq.xyzw pos-2 slot-1 SHADOW-VU1-DUAL-VERTS) (nop)) ;; #x0ef
        (vu-pair (b quad-transform) (nop)) ;; #x0f0
        (vu-pair (lq.xyzw pos-3 slot-0 SHADOW-VU1-DUAL-VERTS) (nop)) ;; #x0f1
        ;; The orientation flag was zero, so the pair leads with the other endpoint.
        (label quad-swapped)
        (vu-pair (lq.xyzw pos-0 slot-1 SHADOW-VU1-VERTS) (nop)) ;; #x0f2
        (vu-pair (lq.xyzw pos-1 slot-0 SHADOW-VU1-VERTS) (nop)) ;; #x0f3
        (vu-pair (lq.xyzw pos-2 slot-0 SHADOW-VU1-DUAL-VERTS) (nop)) ;; #x0f4
        (vu-pair (lq.xyzw pos-3 slot-1 SHADOW-VU1-DUAL-VERTS) (nop)) ;; #x0f5
        (label quad-transform)
        (vu-pair (move.xyzw first-vertex pos-0) (mulaw.xyzw ACC mtx-row-3 vf00)) ;; #x0f6
        (vu-pair (nop) (maddax.xyzw ACC mtx-row-0 pos-0)) ;; #x0f7
        (vu-pair (nop) (madday.xyzw ACC mtx-row-1 pos-0)) ;; #x0f8
        (vu-pair (nop) (maddz.xyzw pos-0 mtx-row-2 pos-0)) ;; #x0f9
        (vu-pair (nop) (mulaw.xyzw ACC mtx-row-3 vf00)) ;; #x0fa
        (vu-pair (nop) (sub.xyzw edge-a pos-1 first-vertex)) ;; #x0fb
        (vu-pair (nop) (sub.xyzw edge-b pos-2 first-vertex)) ;; #x0fc
        (vu-pair (div Q fog.x pos-0.w) (maddax.xyzw ACC mtx-row-0 pos-1)) ;; #x0fd
        (vu-pair (nop) (mul.xyzw clip-0 pos-0 hmgescale)) ;; #x0fe
        (vu-pair (nop) (madday.xyzw ACC mtx-row-1 pos-1)) ;; #x0ff
        (vu-pair (nop) (maddz.xyzw pos-1 mtx-row-2 pos-1)) ;; #x100
        (vu-pair (nop) (mulaw.xyzw ACC mtx-row-3 vf00)) ;; #x101
        (vu-pair (nop) (maddax.xyzw ACC mtx-row-0 pos-2)) ;; #x102
        (vu-pair (nop) (madday.xyzw ACC mtx-row-1 pos-2)) ;; #x103
        (vu-pair (div Q fog.x pos-1.w) (mul.xyz pos-0 pos-0 Q)) ;; #x104
        (vu-pair (nop) (maddz.xyzw pos-2 mtx-row-2 pos-2)) ;; #x105
        (vu-pair (nop) (mulaw.xyzw ACC mtx-row-3 vf00)) ;; #x106
        (vu-pair (nop) (maddax.xyzw ACC mtx-row-0 pos-3)) ;; #x107
        (vu-pair (nop) (madday.xyzw ACC mtx-row-1 pos-3)) ;; #x108
        (vu-pair (nop) (maddz.xyzw pos-3 mtx-row-2 pos-3)) ;; #x109
        (vu-pair (nop) (mul.xyzw clip-1 pos-1 hmgescale)) ;; #x10a
        (vu-pair (div Q fog.x pos-2.w) (mul.xyz pos-1 pos-1 Q)) ;; #x10b
        (vu-pair (nop) (add.xy st-0 pos-0 texoffset)) ;; #x10c
        (vu-pair (nop) (add.xyzw pos-0 pos-0 hvdfoff)) ;; #x10d
        (vu-pair (nop) (opmula.xyz ACC edge-a edge-b)) ;; #x10e
        (vu-pair (nop) (opmsub.xyz edge-a edge-b edge-a)) ;; #x10f
        (vu-pair (nop) (mul.xyzw clip-2 pos-2 hmgescale)) ;; #x110
        (vu-pair (nop) (mul.xyz edge-a edge-a first-vertex)) ;; #x111
        (vu-pair (div Q fog.x pos-3.w) (mul.xyz pos-2 pos-2 Q)) ;; #x112
        (vu-pair (nop) (mul.xyzw clip-3 pos-3 hmgescale)) ;; #x113
        (vu-pair (nop) (mul.xy st-0 st-0 texscale)) ;; #x114
        (vu-pair (nop) (mini.xyzw screen-min screen-min pos-0)) ;; #x115
        (vu-pair (nop) (max.xyzw screen-max screen-max pos-0)) ;; #x116
        (vu-pair (nop) (ftoi4.xyzw pos-0 pos-0)) ;; #x117
        (vu-pair (nop) (add.xy st-1 pos-1 texoffset)) ;; #x118
        (vu-pair (nop) (mul.xyz pos-3 pos-3 Q)) ;; #x119
        (vu-pair (nop) (add.xyzw pos-1 pos-1 hvdfoff)) ;; #x11a
        (vu-pair (nop) (addy.x edge-a edge-a edge-a)) ;; #x11b
        (vu-pair (sq.xyzw st-0 gif-buffer 4) (mini.xyzw screen-min screen-min pos-1)) ;; #x11c
        (vu-pair (sq.xyzw pos-0 gif-buffer 5) (max.xyzw screen-max screen-max pos-1)) ;; #x11d
        (vu-pair (nop) (clipw.xyz clip-0 clip-0)) ;; #x11e
        (vu-pair (nop) (mul.xy st-1 st-1 texscale)) ;; #x11f
        (vu-pair (nop) (addz.x edge-a edge-a edge-a)) ;; #x120
        (vu-pair (nop) (ftoi4.xyzw pos-1 pos-1)) ;; #x121
        (vu-pair (nop) (add.xy st-2 pos-2 texoffset)) ;; #x122
        (vu-pair (sq.xyzw st-1 gif-buffer 6) (add.xyzw pos-2 pos-2 hvdfoff)) ;; #x123
        (vu-pair (fsand vi01 0x2) (clipw.xyz clip-1 clip-1)) ;; #x124
        (vu-pair (sq.xyzw pos-1 gif-buffer 7) (clipw.xyz clip-2 clip-2)) ;; #x125
        (vu-pair (nop) (clipw.xyz clip-3 clip-3)) ;; #x126
        (vu-pair (nop) (add.xy st-3 pos-3 texoffset)) ;; #x127
        (vu-pair (nop) (add.xyzw pos-3 pos-3 hvdfoff)) ;; #x128
        (vu-pair (nop) (mul.xy st-2 st-2 texscale)) ;; #x129
        (vu-pair (nop) (mini.xyzw screen-min screen-min pos-2)) ;; #x12a
        (vu-pair (nop) (max.xyzw screen-max screen-max pos-2)) ;; #x12b
        (vu-pair (ibeq vi00 vi01 quad-back-color) (mul.xy st-3 st-3 texscale)) ;; #x12c
        (vu-pair (nop) (mini.xyzw screen-min screen-min pos-3)) ;; #x12d
        (vu-pair (b quad-emit) (nop)) ;; #x12e
        (vu-pair (lq.xyzw color vi00 (shadow-const clrs 1)) (max.xyzw screen-max screen-max pos-3)) ;; #x12f
        (label quad-back-color)
        (vu-pair (lq.xyzw color vi00 (shadow-const clrs 0)) (max.xyzw screen-max screen-max pos-3)) ;; #x130
        (label quad-emit)
        ;; Four vertices this time, so twenty-four accumulated clip bits.
        (vu-pair (fcand vi01 0xffffff) (ftoi4.xyzw pos-2 pos-2)) ;; #x131
        (vu-pair (ibne vi00 vi01 quad-clip) (max.xyzw screen-max screen-max pos-3)) ;; #x132
        (vu-pair (iaddi count count -0x1) (nop)) ;; #x133
        (vu-pair (sq.xyzw st-2 gif-buffer 8) (ftoi4.xyzw pos-3 pos-3)) ;; #x134
        (vu-pair (sq.xyzw color gif-buffer 3) (nop)) ;; #x135
        (vu-pair (sq.xyzw pos-2 gif-buffer 9) (nop)) ;; #x136
        (vu-pair (sq.xyzw st-3 gif-buffer 10) (nop)) ;; #x137
        (vu-pair (sq.xyzw pos-3 gif-buffer 11) (nop)) ;; #x138
        (vu-pair (xgkick gif-buffer) (nop)) ;; #x139
        (vu-pair (mtir gif-buffer gif-buffers.y) (nop)) ;; #x13a
        (vu-pair (mr32.xyzw gif-buffers gif-buffers) (nop)) ;; #x13b
        (label quad-next)
        (vu-pair (ibgtz count quad-loop) (nop)) ;; #x13c
        (vu-pair (nop) (nop)) ;; #x13d
        (vu-pair (nop) (nop :e)) ;; #x13e
        (vu-pair (nop) (nop)) ;; #x13f
        (label quad-clip)
        (vu-pair (sq.xyzw clip-0 vi00 SHADOW-VU1-CLIP-VERTS) (nop)) ;; #x140
        (vu-pair (sq.xyzw clip-1 vi00 (+ SHADOW-VU1-CLIP-VERTS 3)) (nop)) ;; #x141
        (vu-pair (sq.xyzw clip-2 vi00 (+ SHADOW-VU1-CLIP-VERTS 6)) (nop)) ;; #x142
        (vu-pair (sq.xyzw clip-3 vi00 (+ SHADOW-VU1-CLIP-VERTS 9)) (nop)) ;; #x143
        (vu-pair (sq.xyzw color vi00 (+ SHADOW-VU1-CLIP-GIF 2)) (nop)) ;; #x144
        (vu-pair (mfir.x edge-a gif-buffer) (nop)) ;; #x145
        (vu-pair (mfir.y edge-a list) (nop)) ;; #x146
        (vu-pair (mfir.z edge-a vi07) (nop)) ;; #x147
        (vu-pair (bal vi15 clip-quad) (nop)) ;; #x148
        (vu-pair (mfir.w edge-a count) (nop)) ;; #x149
        (vu-pair (mtir count edge-a.w) (nop)) ;; #x14a
        (vu-pair (mtir list edge-a.y) (nop)) ;; #x14b
        (vu-pair (mtir vi07 edge-a.z) (nop)) ;; #x14c
        (vu-pair (b quad-next) (nop)) ;; #x14d
        (vu-pair (mtir gif-buffer edge-a.x) (nop)) ;; #x14e
        ;; Entry SHADOW-VU1-ENTRY-DOUBLE-TRIS: the caps of a double-sided volume. Every triangle is drawn, but
        ;; the faces byte the CPU classifier wrote decides whether the authored winding is used as-is or with
        ;; its last two indices exchanged. There are two passes here as well, near then far, and the far pass
        ;; takes the opposite branch so the ground cap faces the other way.
        (label draw-double-caps)
        (vu-pair (iaddiu list vi00 SHADOW-VU1-TRI-LIST) (nop)) ;; #x14f
        (vu-pair (ilwr.x count list) (nop)) ;; #x150
        (vu-pair (mtir gif-buffer gif-buffers.x) (nop)) ;; #x151
        (vu-pair (iaddi list list 0x1) (addw.z st-0 vf00 vf00)) ;; #x152
        (vu-pair (lq.xyzw st-0 vi00 (shadow-const adgif)) (addw.z st-1 vf00 vf00)) ;; #x153
        (vu-pair (lq.xyzw edge-a vi00 (shadow-const texflush)) (addw.z st-2 vf00 vf00)) ;; #x154
        (vu-pair (lq.xyzw edge-b vi00 (shadow-const trigif)) (addw.z st-3 vf00 vf00)) ;; #x155
        (vu-pair (lq.xyzw mtx-row-0 vi00 SHADOW-VU1-MATRIX) (nop)) ;; #x156
        (vu-pair (lq.xyzw mtx-row-1 vi00 (+ SHADOW-VU1-MATRIX 1)) (nop)) ;; #x157
        (vu-pair (lq.xyzw mtx-row-2 vi00 (+ SHADOW-VU1-MATRIX 2)) (nop)) ;; #x158
        (vu-pair (lq.xyzw mtx-row-3 vi00 (+ SHADOW-VU1-MATRIX 3)) (nop)) ;; #x159
        (vu-pair (mtir vi01 gif-buffers.y) (nop)) ;; #x15a
        (vu-pair (sq.xyzw st-0 gif-buffer 0) (nop)) ;; #x15b
        (vu-pair (sq.xyzw edge-a gif-buffer 1) (nop)) ;; #x15c
        (vu-pair (sq.xyzw edge-b gif-buffer 2) (nop)) ;; #x15d
        (vu-pair (sq.xyzw st-0 vi01 0) (nop)) ;; #x15e
        (vu-pair (sq.xyzw edge-a vi01 1) (nop)) ;; #x15f
        (vu-pair (sq.xyzw edge-b vi01 2) (nop)) ;; #x160
        (label double-cap-loop)
        (vu-pair (lqi.xyzw indices list) (nop)) ;; #x161
        (vu-pair (nop) (nop)) ;; #x162
        (vu-pair (nop) (nop)) ;; #x163
        (vu-pair (nop) (nop)) ;; #x164
        (vu-pair (mtir vi01 indices.w) (nop)) ;; #x165
        (vu-pair (mtir slot-0 indices.x) (nop)) ;; #x166
        (vu-pair (mtir slot-1 indices.y) (nop)) ;; #x167
        (vu-pair (mtir slot-2 indices.z) (nop)) ;; #x168
        (vu-pair (ibeq vi00 vi01 double-cap-reversed) (nop)) ;; #x169
        (vu-pair (lq.xyzw pos-0 slot-0 SHADOW-VU1-VERTS) (nop)) ;; #x16a
        (vu-pair (lq.xyzw pos-1 slot-1 SHADOW-VU1-VERTS) (nop)) ;; #x16b
        (vu-pair (b double-cap-transform) (nop)) ;; #x16c
        (vu-pair (lq.xyzw pos-2 slot-2 SHADOW-VU1-VERTS) (nop)) ;; #x16d
        (label double-cap-reversed)
        (vu-pair (lq.xyzw pos-2 slot-1 SHADOW-VU1-VERTS) (nop)) ;; #x16e
        (vu-pair (lq.xyzw pos-1 slot-2 SHADOW-VU1-VERTS) (nop)) ;; #x16f
        (label double-cap-transform)
        (vu-pair (nop) (mulaw.xyzw ACC mtx-row-3 vf00)) ;; #x170
        (vu-pair (move.xyzw first-vertex pos-0) (maddax.xyzw ACC mtx-row-0 pos-0)) ;; #x171
        (vu-pair (nop) (madday.xyzw ACC mtx-row-1 pos-0)) ;; #x172
        (vu-pair (nop) (sub.xyzw edge-a pos-1 pos-0)) ;; #x173
        (vu-pair (nop) (sub.xyzw edge-b pos-2 pos-0)) ;; #x174
        (vu-pair (nop) (maddz.xyzw pos-0 mtx-row-2 pos-0)) ;; #x175
        (vu-pair (nop) (mulaw.xyzw ACC mtx-row-3 vf00)) ;; #x176
        (vu-pair (div Q fog.x pos-0.w) (maddax.xyzw ACC mtx-row-0 pos-1)) ;; #x177
        (vu-pair (nop) (madday.xyzw ACC mtx-row-1 pos-1)) ;; #x178
        (vu-pair (nop) (mul.xyzw clip-0 pos-0 hmgescale)) ;; #x179
        (vu-pair (nop) (maddz.xyzw pos-1 mtx-row-2 pos-1)) ;; #x17a
        (vu-pair (nop) (mulaw.xyzw ACC mtx-row-3 vf00)) ;; #x17b
        (vu-pair (nop) (maddax.xyzw ACC mtx-row-0 pos-2)) ;; #x17c
        (vu-pair (nop) (madday.xyzw ACC mtx-row-1 pos-2)) ;; #x17d
        (vu-pair (div Q fog.x pos-1.w) (mul.xyz pos-0 pos-0 Q)) ;; #x17e
        (vu-pair (nop) (maddz.xyzw pos-2 mtx-row-2 pos-2)) ;; #x17f
        (vu-pair (nop) (mul.xyzw clip-1 pos-1 hmgescale)) ;; #x180
        (vu-pair (nop) (opmula.xyz ACC edge-a edge-b)) ;; #x181
        (vu-pair (nop) (opmsub.xyz edge-a edge-b edge-a)) ;; #x182
        (vu-pair (nop) (add.xy st-0 pos-0 texoffset)) ;; #x183
        (vu-pair (nop) (add.xyzw pos-0 pos-0 hvdfoff)) ;; #x184
        (vu-pair (div Q fog.x pos-2.w) (mul.xyz pos-1 pos-1 Q)) ;; #x185
        (vu-pair (nop) (mul.xyzw clip-2 pos-2 hmgescale)) ;; #x186
        (vu-pair (nop) (mul.xyz edge-a edge-a first-vertex)) ;; #x187
        (vu-pair (nop) (mul.xy st-0 st-0 texscale)) ;; #x188
        (vu-pair (nop) (mini.xyzw screen-min screen-min pos-0)) ;; #x189
        (vu-pair (nop) (max.xyzw screen-max screen-max pos-0)) ;; #x18a
        (vu-pair (nop) (ftoi4.xyzw pos-0 pos-0)) ;; #x18b

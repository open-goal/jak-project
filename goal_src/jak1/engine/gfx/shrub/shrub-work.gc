;; Both flavours start the draw entry. Patched here rather than written into the static data because
;; the entry address is a property of the microprogram, not of the packet.
(set! (-> *instance-shrub-work* mscalf-tmpl vif0 imm) SHRUB-VU-ENTRY-DRAW)

(set! (-> *instance-shrub-work* mscalf-ret-tmpl vif0 imm) SHRUB-VU-ENTRY-DRAW)

(defun upload-generic-shrub ((dma-buf dma-buffer) (fragment generic-shrub-fragment) (matrix-vu-address int) (stream-vu-address int))
  "Append a near-shrub VU1 upload to dma-buf. Unpack the camera matrix and two control quadwords at
   matrix-vu-address, upload fragment's control records immediately after them, place its texture
   coordinates, colors, and vertices at stream-vu-address and the next two addresses, then start
   VU1 entry 10."
  (let* ((dma-state dma-buf)
         (matrix-packet (the-as object (-> dma-state base))))
    (set! (-> (the-as dma-packet matrix-packet) dma) (new 'static 'dma-tag :qwc #x6 :id (dma-tag-id cnt)))
    (set! (-> (the-as dma-packet matrix-packet) vif0) (new 'static 'vif-tag :imm #x404 :cmd (vif-cmd stcycl)))
    (set! (-> (the-as dma-packet matrix-packet) vif1)
          (new 'static 'vif-tag :num #x6 :cmd (vif-cmd unpack-v4-32) :imm (shr (shl matrix-vu-address 54) 54)))
    (set! (-> dma-state base) (&+ (the-as pointer matrix-packet) 16)))
  (matrix-copy! (the-as matrix (-> dma-buf base)) (-> *math-camera* camera-temp))
  (&+! (-> dma-buf base) 64)
  ;; Entry 10 expects the camera rows followed by (1, 1, 1, 128) and
  ;; (vertex-count, 0, 0, 0).
  (let* ((dma-state dma-buf)
         (control-data (the-as object (-> dma-state base))))
    (set! (-> (the-as vector4w-2 control-data) vector 0 x) #x3f800000)
    (set! (-> (the-as vector4w-2 control-data) vector 0 y) #x3f800000)
    (set! (-> (the-as vector4w-2 control-data) vector 0 z) #x3f800000)
    (set! (-> (the-as vector4w-2 control-data) vector 0 w) 128)
    (set! (-> (the-as vector4w-2 control-data) vector 1 x) (the-as int (-> fragment vtx-cnt)))
    (set! (-> (the-as vector4w-2 control-data) vector 1 y) 0)
    (set! (-> (the-as vector4w-2 control-data) vector 1 z) 0)
    (set! (-> (the-as vector4w-2 control-data) vector 1 w) 0)
    (set! (-> dma-state base) (&+ (the-as pointer control-data) 32)))
  (let* ((dma-state dma-buf)
         (control-packet (the-as object (-> dma-state base))))
    (set! (-> (the-as dma-packet control-packet) dma)
          (new 'static 'dma-tag :id (dma-tag-id ref) :addr (-> fragment cnt) :qwc (-> fragment cnt-qwc)))
    (set! (-> (the-as dma-packet control-packet) vif0) (new 'static 'vif-tag))
    (set! (-> (the-as dma-packet control-packet) vif1)
          (new 'static
               'vif-tag
               :cmd (vif-cmd unpack-v4-32)
               :imm
               (shr (shl (+ matrix-vu-address 6) 54) 54)
               :num (-> fragment cnt-qwc)))
    (set! (-> dma-state base) (&+ (the-as pointer control-packet) 16)))
  (let* ((dma-state dma-buf)
         (stq-packet (the-as object (-> dma-state base))))
    (set! (-> (the-as dma-packet stq-packet) dma)
          (new 'static 'dma-tag :id (dma-tag-id ref) :addr (-> fragment stq) :qwc (-> fragment stq-qwc)))
    (set! (-> (the-as dma-packet stq-packet) vif0) (new 'static 'vif-tag :imm #x103 :cmd (vif-cmd stcycl)))
    (set! (-> (the-as dma-packet stq-packet) vif1)
          (new 'static 'vif-tag :cmd (vif-cmd unpack-v2-16) :imm (shr (shl stream-vu-address 54) 54) :num (-> fragment vtx-cnt)))
    (set! (-> dma-state base) (&+ (the-as pointer stq-packet) 16)))
  (let* ((dma-state dma-buf)
         (color-packet (the-as object (-> dma-state base))))
    (set! (-> (the-as dma-packet color-packet) dma)
          (new 'static 'dma-tag :id (dma-tag-id ref) :addr (-> fragment col) :qwc (-> fragment col-qwc)))
    (set! (-> (the-as dma-packet color-packet) vif0) (new 'static 'vif-tag))
    (set! (-> (the-as dma-packet color-packet) vif1)
          (new 'static
               'vif-tag
               :cmd (vif-cmd unpack-v3-8)
               :imm
               (shr (shl (+ stream-vu-address 1) 54) 54)
               :num (-> fragment vtx-cnt)))
    (set! (-> dma-state base) (&+ (the-as pointer color-packet) 16)))
  (let* ((dma-state dma-buf)
         (vertex-packet (the-as object (-> dma-state base))))
    (set! (-> (the-as dma-packet vertex-packet) dma)
          (new 'static 'dma-tag :id (dma-tag-id ref) :addr (-> fragment vtx) :qwc (-> fragment vtx-qwc)))
    (set! (-> (the-as dma-packet vertex-packet) vif0) (new 'static 'vif-tag))
    (set! (-> (the-as dma-packet vertex-packet) vif1)
          (new 'static
               'vif-tag
               :cmd (vif-cmd unpack-v3-16)
               :imm
               (shr (shl (+ stream-vu-address 2) 54) 54)
               :num (-> fragment vtx-cnt)))
    (set! (-> dma-state base) (&+ (the-as pointer vertex-packet) 16)))
  (let* ((dma-state dma-buf)
         (run-packet (the-as object (-> dma-state base))))
    (set! (-> (the-as dma-packet run-packet) dma) (new 'static 'dma-tag :id (dma-tag-id cnt)))
    (set! (-> (the-as dma-packet run-packet) vif0) (new 'static 'vif-tag :imm #x404 :cmd (vif-cmd stcycl)))
    (set! (-> (the-as dma-packet run-packet) vif1) (new 'static 'vif-tag :imm #xa :cmd (vif-cmd mscal) :msk #x1))
    (set! (-> dma-state base) (&+ (the-as pointer run-packet) 16)))
  dma-buf)

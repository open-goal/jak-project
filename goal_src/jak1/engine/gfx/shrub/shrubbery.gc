;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/gfx/background/subdivide.gc")
(require "engine/anim/joint.gc")
(require "engine/draw/draw-node-h.gc")
(require "engine/gfx/background/background.gc")
(require "engine/collide/collide-shape-h.gc")
(require "engine/gfx/background/wind-h.gc")
(require "engine/gfx/shrub/shrub-work.gc")

;; SHRUB -- the instanced foliage renderer.
;; (see assembly in shrubbery-ee-asm.gc)
;;
;; Shrub draws the small repeated background props: bushes, grass tufts, cattails, palm fronds,
;; etc. Like TIE it is built around prototypes and instances. A prototype is authored once and
;; exported four times, at four levels of detail. An instance is one 80-byte placement of that
;; prototype somewhere in the level.
;;
;; The four geometries of a prototype-bucket-shrub, nearest first:
;;
;;   0  prototype-generic-shrub    handed to the generic renderer, used when the geometry needs
;;                                 to be clipped.
;;   1  prototype-shrubbery        the ordinary VU1 path, one or more packed shrubbery fragments.
;;   2  prototype-trans-shrubbery  the same format with alpha-test fail enabled, so the model can
;;                                 fade out.
;;   3  billboard                  a single camera-facing quad, built by the EE as raw GS packets;
;;                                 VU1 is not involved at all.
;;
;; An instance picks one of the four geometries from its camera distance and the prototype's dists /
;; rdists. There is no morph between levels and no blending of two geometries, other than the fade-out
;; of the transparent version.
;;
;; Color. Each level's shrub tree owns one time-of-day palette, interpolated once per frame into
;; the 1024-entry colors table in instance-shrub-work. An instance stores one index into that table
;; and that one color multiplies the whole instance.
;; So two bushes from the same prototype can be lit differently, but a single bush is lit by only
;; a single color.
;;
;; Visibility. Shrub does not participate in the packed visibility strings -- unpack-vis below is a
;; deliberate no-op. Culling is entirely the draw-node BVH: each node's bounding sphere is tested
;; against the four side planes by VU0, and its camera depth decides whether to descend, skip the
;; subtree, or emit its leaf span. Leaves are then tested individually, again on VU0, before their
;; distance selects a geometry. The tree allows any child count and any leaf depth, so the walk
;; carries its own six-entry node/count stack instead of draw-node-cull's fixed-depth bit walk.
;;
;; Passes:
;;
;;   EE, instance pass (draw-inline-array-instance-shrub): walk the BVH, cull, classify, shear the
;;   instance into the wind, and append a compact record to the chosen geometry's list. Instances
;;   arrive through the scratchpad in bulk and the records are assembled in the scratchpad too, so
;;   the EE is reading one bank while DMA fills the other and returns the finished one.
;;
;;   EE, prototype pass (draw-prototype-inline-array-shrub): for each geometry that got anything,
;;   terminate its list with a count packet, then upload the prototype's model once and CALL the
;;   accumulated instance chain. Billboards skip VU1 and are written as GS packets directly.
;;
;;   VU1: entry 17 or 21 relocates a freshly uploaded model and expands its packed vertices and
;;   colors in place; entry 103 transforms one ring of instance matrices against that model and
;;   writes ST / RGBAQ / XYZF2 triples into a GIF output buffer.
;;
;; The instance chain is built backwards and read forwards. Each new instance record is a DMA tag
;; whose ADDR is patched to the record appended before it, so the chain runs newest-first. Records
;; are grouped ten at a time, alternating between two VU matrix rings, and mod-count says which
;; slot in that twenty-position cycle comes next. At each group boundary the tag is a cnt rather
;; than a next, so the chain flows by adjacency into the packet written immediately after it: the
;; group's count word when a ring fills, or an MSCALF that runs entry 103 when the next group opens.
;; The very first group's MSCALF is a ret tag, because the whole chain is entered with a call. Read
;; in DMA order the result is: the current partial group's count and matrices, its MSCALF, then each
;; earlier full group in reverse, each ending in its own MSCALF, then ret. Ten instances per draw
;; call, and no matrix is ever uploaded twice.
;;
;; Shrub VU1 memory map. Everything except the two GIF output buffers has a GOAL type describing it.
;;
;;     0 -   2   shrub-view-data: giftag, camera constants, fog clamp. Entry 0 copies all three
;;               quadwords into registers, which is why the model bank may start at 2 and overwrite
;;               the last of them. Two words of the middle quadword are then reused as the
;;               program's own saved cursors -- see tex-start-ptr and mtx-buf-ptr.
;;     2 - 161   model bank A: one shrubbery's object, vertex, color and STQ streams
;;   162 - 321   model bank B
;;   322 - 372   instance ring A: one count word plus ten five-quadword shrubbery-matrix records
;;   373 - 423   instance ring B
;;   424 - 823   GIF output buffer 0
;;   824 - 1023  GIF output buffer 1
;;
;; The two model banks are selected with the VIF BASE register, so the packed streams in a shrubbery
;; carry unpack addresses relative to zero and the EE decides where they land by writing
;; *shrub-state*. The two instance rings and the two GIF buffers alternate for the usual reason: the
;; EE is filling one while VU1 or the GIF drains the other.

(defmethod login ((this billboard))
  "Log in the billboard's single flat adgif shader."
  (adgif-shader-login (-> this flat))
  this)

(defmethod mem-usage ((this billboard) (usage memory-usage-block) (flags mem-usage-flags))
  "Account for this billboard's inline storage."
  (mem-usage-add! usage billboard 1 (asize-of this))
  this)

(defun-recursive mem-usage-shrub-walk draw-node ((nodes draw-node) (node-count int) (usage memory-usage-block) (flags mem-usage-flags))
  "Recursively account for node storage and leaf instance-shrubbery records across node-count
   contiguous shrub BVH roots. flags is forwarded for the memory-usage traversal."
  (mem-usage-add! usage draw-node node-count (* node-count 32))
  (let ((node nodes))
    (dotimes (i node-count)
      (let ((child-count (-> node child-count)))
        (cond
          ((logtest? (-> node flags) (draw-node-flags children-are-draw-nodes))
           (mem-usage-shrub-walk (the-as draw-node (-> node child)) (the-as int child-count) usage flags))
          (else
           (mem-usage-add! usage instance-shrubbery child-count (* (the-as uint 80) child-count)))))
      (&+! node 32)))
  nodes)

(defmethod mem-usage ((this drawable-tree-instance-shrub) (usage memory-usage-block) (flags mem-usage-flags))
  "Account for the tree header, optional time-of-day palette, recursive draw-node hierarchy,
   and prototype array."
  (mem-usage-add-symbol! usage drawable-group 1 32)
  ;; Time-of-day colors are allocated separately from the tree.
  (when (nonzero? (-> this colors-added))
    (mem-usage-add! usage shrubbery-pal 1 (asize-of (-> this colors-added))))
  ;; Account recursively for the instance hierarchy, then for its prototype geometry.
  (mem-usage-shrub-walk (the-as draw-node (&+ (-> this data 0) 32))
                        (-> (the-as drawable-group (-> this data 0)) length)
                        usage
                        flags)
  (mem-usage (-> this info prototype-inline-array-shrub) usage (logior flags (mem-usage-flags prototype-data)))
  this)

(defmethod login ((this generic-shrub-fragment))
  "Log in each five-quadword adgif shader record in this generic shrub fragment."
  (let ((texture-count (/ (-> this cnt-qwc) (the-as uint 5))))
    (dotimes (i (the-as int texture-count))
      ;; no remap needed since shrub data references the level's combined tpages
      ;; already.
      (adgif-shader-login-no-remap (-> this textures i))))
  this)

(defmethod mem-usage ((this generic-shrub-fragment) (usage memory-usage-block) (flags mem-usage-flags))
  "Account separately for this fragment header and its referenced control, vertex, color, and
   texture-coordinate streams."
  ;; The fragment header and referenced packed streams are separate allocations.
  (mem-usage-add! usage generic-shrub 1 (asize-of this))
  (mem-usage-add! usage generic-shrub-data 1 (* (+ (-> this cnt-qwc) (-> this vtx-qwc) (-> this col-qwc) (-> this stq-qwc)) 16))
  this)

(defmethod inspect ((this prototype-shrubbery))
  (format #t "[~8x] ~A~%" this (-> this type))
  (format #t "~Tlength: ~D~%" (-> this length))
  (format #t "~Tdata[~D]: @ #x~X~%" (-> this length) (-> this data))
  (dotimes (i (-> this length))
    (format #t "~T  [~D] ~A~%" i (-> this data i)))
  this)

(defmethod mem-usage ((this prototype-shrubbery) (usage memory-usage-block) (flags mem-usage-flags))
  "Account for the prototype-array header and each inline shrubbery fragment."
  (mem-usage-add-symbol! usage drawable-group 1 32)
  (dotimes (i (-> this length))
    (mem-usage (-> this data i) usage flags))
  this)

(defmethod login ((this prototype-shrubbery))
  "Log in every inline shrubbery fragment."
  (dotimes (i (-> this length))
    (login (-> this data i)))
  this)

(defmethod asize-of ((this prototype-shrubbery))
  "Return the prototype-shrubbery header size plus storage for its active inline fragments."
  (the-as int (+ (-> prototype-shrubbery size) (* (+ (-> this length) -1) 32))))

(defmethod login ((this prototype-generic-shrub))
  "Log in every generic shrub fragment in the group."
  (dotimes (i (-> this length))
    (login (-> this data i)))
  this)

(defmethod login ((this shrubbery))
  "Log in both adgif shaders for every shader pair, then finish the PC texture setup."
  (let ((texture-count (* (-> this header data 0) 2)))
    (dotimes (i (the-as int texture-count))
      (adgif-shader-login-no-remap (-> this textures i))))
  (shrubbery-login-post-texture this)
  this)

(defmethod mem-usage ((this shrubbery) (usage memory-usage-block) (flags mem-usage-flags))
  "Account separately for the shrub header and its object, vertex, color, and
   texture-coordinate streams."
  (mem-usage-add! usage shrubbery 1 (asize-of this))
  (mem-usage-add! usage shrubbery-vertex 1 (* (-> this vtx-qwc) 16))
  (mem-usage-add! usage shrubbery-color 1 (* (-> this col-qwc) 16))
  (mem-usage-add! usage shrubbery-object 1 (* (-> this obj-qwc) 16))
  (mem-usage-add! usage shrubbery-stq 1 (* (-> this stq-qwc) 16))
  this)

(defmethod login ((this drawable-tree-instance-shrub))
  "Log in the tree's prototype array when it is present."
  (if (nonzero? (-> this info prototype-inline-array-shrub))
      (login (-> this info prototype-inline-array-shrub)))
  this)

(defun shrub-num-tris ((shrub shrubbery))
  "Return the number of triangles encoded by shrub: display vertices minus two strip-start
   vertices for each triangle strip."
  (- (-> shrub header data 2) (* (-> shrub header data 1) 2)))

(defun shrub-make-perspective-matrix ((out matrix))
  "Copy the current camera transform to out, divide its homogeneous coefficients by pfog0, and fold
   the horizontal, vertical, depth, and fog offsets into the first three components."
  (matrix-copy! out (-> *math-camera* camera-temp))
  (let ((inverse-pfog0 (/ 1.0 (-> *math-camera* pfog0))))
    (set! (-> out vector 0 w) (* (-> out vector 0 w) inverse-pfog0))
    (set! (-> out vector 1 w) (* (-> out vector 1 w) inverse-pfog0))
    (set! (-> out vector 2 w) (* (-> out vector 2 w) inverse-pfog0))
    (set! (-> out vector 3 w) (* (-> out vector 3 w) inverse-pfog0)))
  (+! (-> out vector 0 x) (* (-> out vector 0 w) (-> *math-camera* hvdf-off x)))
  (+! (-> out vector 1 x) (* (-> out vector 1 w) (-> *math-camera* hvdf-off x)))
  (+! (-> out vector 2 x) (* (-> out vector 2 w) (-> *math-camera* hvdf-off x)))
  (+! (-> out vector 3 x) (* (-> out vector 3 w) (-> *math-camera* hvdf-off x)))
  (+! (-> out vector 0 y) (* (-> out vector 0 w) (-> *math-camera* hvdf-off y)))
  (+! (-> out vector 1 y) (* (-> out vector 1 w) (-> *math-camera* hvdf-off y)))
  (+! (-> out vector 2 y) (* (-> out vector 2 w) (-> *math-camera* hvdf-off y)))
  (+! (-> out vector 3 y) (* (-> out vector 3 w) (-> *math-camera* hvdf-off y)))
  (+! (-> out vector 0 z) (* (-> out vector 0 w) (-> *math-camera* hvdf-off z)))
  (+! (-> out vector 1 z) (* (-> out vector 1 w) (-> *math-camera* hvdf-off z)))
  (+! (-> out vector 2 z) (* (-> out vector 2 w) (-> *math-camera* hvdf-off z)))
  (+! (-> out vector 3 z) (* (-> out vector 3 w) (-> *math-camera* hvdf-off z)))
  out)

(defun shrub-init-view-data ((view-data shrub-view-data))
  "Fill the three quadwords of shrub VU1 constants from the current math camera. tex-start-ptr and
   mtx-buf-ptr are only starting values for two words the microprogram then uses as its own saved
   cursors; the fifth adgif register is left out of the tag on purpose."
  ;; The A+D tag written ahead of every shader in the output packet. An adgif shader is five register
  ;; writes but only four of them change per shader -- the alpha setting is sent once per pass -- so
  ;; the tag says four and the model's object stream supplies exactly four quadwords per shader.
  ;;
  ;; The two pointer fields are floats on purpose. mtx-buf-ptr is 2^23, whose bit pattern has a zero
  ;; low half, so the microprogram's ILW of it reads zero and its first instance-ring flip lands on
  ;; a real ring address. Adding a small integer to 2^23 keeps the result exactly representable and
  ;; leaves that integer in the low mantissa bits, which is how the program moves VU addresses in
  ;; and out of float lanes all through the draw entry.
  (set! (-> view-data texture-giftag tag) (new 'static 'gif-tag64 :nloop #x1 :nreg #x4))
  (set! (-> view-data texture-giftag regs) (gs-reg-list a+d a+d a+d a+d))
  (set! (-> view-data texture-giftag word 3) (the-as uint #x40a00000))
  (set! (-> view-data tex-start-ptr) (the-as int 25167696.0))
  (set! (-> view-data mtx-buf-ptr) (the-as int 8388608.0))
  (set! (-> view-data fog-0) (-> *math-camera* pfog0))
  (set! (-> view-data fog-1) (-> *math-camera* pfog1))
  (set! (-> view-data fog-min) (-> *math-camera* fog-min))
  (set! (-> view-data fog-max) (-> *math-camera* fog-max))
  #f)

(defun shrub-upload-view-data ((dma-buf dma-buffer))
  "Append the current camera fog and texture/GIF constants to the shrub VU1 input packet."
  (let ((qwc-count 3))
    (let* ((dma-state dma-buf)
           (packet (the-as object (-> dma-state base))))
      (set! (-> (the-as dma-packet packet) dma) (new 'static 'dma-tag :id (dma-tag-id cnt) :qwc qwc-count))
      (set! (-> (the-as dma-packet packet) vif0) (new 'static 'vif-tag :imm #x404 :cmd (vif-cmd stcycl)))
      (set! (-> (the-as dma-packet packet) vif1) (new 'static 'vif-tag :cmd (vif-cmd unpack-v4-32) :num qwc-count))
      (set! (-> dma-state base) (&+ (the-as pointer packet) 16)))
    (shrub-init-view-data (the-as shrub-view-data (-> dma-buf base)))
    (&+! (-> dma-buf base) (* qwc-count 16)))
  #f)

(defun shrub-time ((factor-a int) (factor-b int) (factor-c int) (repeat-count int) (inner-factor int))
  "Evaluate the unused shrub timing-model polynomial for five integer factors."
  (+ (* factor-a 8)
     29
     (* 22 factor-c)
     (* 11 factor-b)
     (* (+ (* inner-factor 2) 15 (* 5 factor-c) (* 13 factor-a)) repeat-count)
     53))

(define shrub-vu1-block (new 'static 'vu-function :length #x0 :qlength #x0))

(defun shrub-do-init-frame ((dma-buf dma-buffer))
  "Upload and initialize the shrub VU1 program and install its VIF row, column, and mask state."
  ;; Upload the program and the three quadwords of camera-dependent view constants.
  (dma-buffer-add-vu-function dma-buf shrub-vu1-block 1)
  (shrub-upload-view-data dma-buf)
  ;; Run entry zero, then wait for it: everything after this depends on the buffer-address vectors
  ;; it builds, and the unpack state installed below must not race the microprogram.
  (dma-buffer-add-cnt-vif2 dma-buf
                           0
                           (new 'static 'vif-tag :cmd (vif-cmd mscalf) :msk #x1 :imm #x0)
                           (new 'static 'vif-tag :cmd (vif-cmd flushe) :msk #x1))
  (let* ((dma-state dma-buf)
         (vif-state-packet (the-as object (-> dma-state base))))
    (set! (-> (the-as dma-packet vif-state-packet) dma) (new 'static 'dma-tag :qwc #x3 :id (dma-tag-id cnt)))
    (set! (-> (the-as dma-packet vif-state-packet) vif0) (new 'static 'vif-tag))
    (set! (-> (the-as dma-packet vif-state-packet) vif1) (new 'static 'vif-tag))
    (set! (-> dma-state base) (&+ (the-as pointer vif-state-packet) 16)))
  (let ((vif-state (-> dma-buf base)))
  ;; Unpack state for the packed model streams, installed once per pass because the streams
  ;; themselves are static and carry only their own unpack codes. MASK is 0xa0a0a0a0: two bits per
  ;; component per cycle, selecting COL for the z and w of every unpacked quadword and leaving x and
  ;; y to the data. COL is 4096, which is 1.0 in the 20.12 format the microprogram converts from, so
  ;; a two-component texture coordinate arrives as (s t 1.0 1.0) and the perspective-correct q falls
  ;; out of the same multiply as s and t. ROW's 0x8080 biases the components that come from it.
    (set! (-> (the-as (pointer vif-tag) vif-state) 0) (new 'static 'vif-tag :cmd (vif-cmd strow) :msk #x1))
    (set! (-> (the-as (pointer uint32) vif-state) 1) (the-as uint #x8080))
    (set! (-> (the-as (pointer uint32) vif-state) 2) (the-as uint #x8080))
    (set! (-> (the-as (pointer uint32) vif-state) 3) (the-as uint #x8080))
    (set! (-> (the-as (pointer uint32) vif-state) 4) (the-as uint 0))
    (set! (-> (the-as (pointer vif-tag) vif-state) 5) (new 'static 'vif-tag :cmd (vif-cmd stcol) :msk #x1))
    (set! (-> (the-as (pointer uint32) vif-state) 6) (the-as uint 4096))
    (set! (-> (the-as (pointer uint32) vif-state) 7) (the-as uint 4096))
    (set! (-> (the-as (pointer uint32) vif-state) 8) (the-as uint 4096))
    (set! (-> (the-as (pointer uint32) vif-state) 9) (the-as uint 4096))
    (set! (-> (the-as (pointer vif-tag) vif-state) 10) (new 'static 'vif-tag :cmd (vif-cmd stmask)))
    (set! (-> (the-as (pointer uint32) vif-state) 11) (the-as uint #xa0a0a0a0))
    (set! (-> dma-buf base) (&+ vif-state 48)))
  (set! *shrub-state* SHRUB-VU-MODEL-BANK-A)
  #f)

(defun shrub-init-frame ((dma-buf dma-buffer) (test gs-test))
  "Initialize the shrub VU1 program, VIF state, and GS TEST register in dma-buf."
  (shrub-do-init-frame dma-buf)
  (let* ((dma-state dma-buf)
         (direct-packet (the-as object (-> dma-state base))))
    (set! (-> (the-as dma-packet direct-packet) dma) (new 'static 'dma-tag :qwc #x2 :id (dma-tag-id cnt)))
    (set! (-> (the-as dma-packet direct-packet) vif0) (new 'static 'vif-tag))
    (set! (-> (the-as dma-packet direct-packet) vif1) (new 'static 'vif-tag :imm #x2 :cmd (vif-cmd direct) :msk #x1))
    (set! (-> dma-state base) (the-as pointer (the-as gs-gif-tag (&+ (the-as pointer direct-packet) 16)))))
  (dma-buffer-add-gif-tag dma-buf (new 'static 'gif-tag64 :nloop #x1 :eop #x1 :nreg #x1) GIF_REGS_ALL_AD)
  (let ((test-packet (-> dma-buf base)))
    (set! (-> (the-as (pointer gs-test) test-packet) 0) test)
    (set! (-> (the-as (pointer gs-reg64) test-packet) 1) (gs-reg64 test-1))
    (set! (-> dma-buf base) (&+ test-packet 16)))
  (none))

(defun shrub-upload-model ((shrub shrubbery) (dma-buf dma-buffer) (start-bank int))
  "Append shrub's static object, vertex, color, and texture-coordinate streams to dma-buf, run the
   model initialization entry selected by start-bank, and hand the other VU1 bank to the next model."
  ;; The four streams are laid out contiguously behind obj, and their VIF unpack codes are part of
  ;; the data, so one REF tag uploads the complete packed model without the EE writing a byte of it.
  ;; Those unpack addresses are relative to zero and BASE decides where they land, which is what
  ;; makes the same static model usable in either bank; OFFSET is zero because the alternation is
  ;; being done by hand here rather than by the VIF's own double buffering.
  (let* ((dma-state dma-buf)
         (upload-packet (the-as object (-> dma-state base))))
    (set! (-> (the-as dma-packet upload-packet) dma)
          (new 'static
               'dma-tag
               :id (dma-tag-id ref)
               :addr (-> shrub obj)
               :qwc
               (+ (-> shrub obj-qwc) (-> shrub vtx-qwc) (-> shrub col-qwc) (-> shrub stq-qwc))))
    (set! (-> (the-as dma-packet upload-packet) vif0) (new 'static 'vif-tag :cmd (vif-cmd base) :imm *shrub-state*))
    (set! (-> (the-as dma-packet upload-packet) vif1) (new 'static 'vif-tag :cmd (vif-cmd offset)))
    (set! (-> dma-state base) (&+ (the-as pointer upload-packet) 16)))
  ;; The two model-init entries differ only in which instance ring the following draw entry reads,
  ;; and start-bank in shrub-work.gc says which one this ring position needs.
  (cond
    ((= start-bank 1)
     (dma-buffer-add-cnt-vif2 dma-buf 0 (new 'static 'vif-tag) (new 'static 'vif-tag :cmd (vif-cmd mscal) :msk #x1 :imm #x11)))
    (else
     (dma-buffer-add-cnt-vif2 dma-buf 0 (new 'static 'vif-tag) (new 'static 'vif-tag :cmd (vif-cmd mscal) :msk #x1 :imm #x15))))
  ;; Hand the other bank to the next model.
  (set! *shrub-state* (- SHRUB-VU-MODEL-BANK-SUM *shrub-state*))
  #f)

(#unless PC_PORT
  (defun draw-prototype-inline-array-shrub ((prototype-count int) (buckets (inline-array prototype-bucket-shrub)))
    "Finish and submit the near, opaque, translucent, and billboard DMA chains accumulated for
     prototype-count shrub buckets."
    (local-vars
      (opaque-chain uint)
      (opaque-fragment drawable)
      (opaque-fragments-left int)
      (translucent-chain uint)
      (translucent-fragment drawable)
      (translucent-fragments-left int))
    ;; Terminate each prototype's opaque and translucent instance chains with a count packet. The
    ;; template encodes the VU destination selected by mod-count; patching next links the packet to
    ;; the chain assembled by draw-inline-array-instance-shrub.
    (let ((bucket (the-as object buckets))
          (dma-buf (-> *display* frames (-> *display* on-screen) frame global-buf)))
      (countdown (i prototype-count)
        (when (nonzero? (-> (the-as prototype-bucket-shrub bucket) count 1))
          (let ((opaque-count-packet (the-as object (-> dma-buf base))))
            (set! (-> (the-as vector4w opaque-count-packet) quad)
                  (-> *instance-shrub-work* count-tmpl (-> (the-as prototype-bucket-shrub bucket) mod-count 1) quad))
            (set! (-> (the-as vector4w opaque-count-packet) dword 0)
                  (logior (logand (-> (the-as vector4w opaque-count-packet) dword 0) (the-as uint #x80000000ffffffff))
                          (shr (shl (-> (the-as prototype-bucket-shrub bucket) next 1) 33) 1)))
            (set! (-> (the-as prototype-bucket-shrub bucket) next-clear-2) (the-as int opaque-count-packet)))
          (&+! (-> dma-buf base) 16))
        (when (nonzero? (-> (the-as prototype-bucket-shrub bucket) count 2))
          (let ((translucent-count-packet (the-as object (-> dma-buf base))))
            (set! (-> (the-as vector4w translucent-count-packet) quad)
                  (-> *instance-shrub-work* count-tmpl (-> (the-as prototype-bucket-shrub bucket) mod-count 2) quad))
            (set! (-> (the-as vector4w translucent-count-packet) dword 0)
                  (logior (logand (-> (the-as vector4w translucent-count-packet) dword 0) (the-as uint #x80000000ffffffff))
                          (shr (shl (-> (the-as prototype-bucket-shrub bucket) next 2) 33) 1)))
            (set! (-> (the-as prototype-bucket-shrub bucket) next-clear-3) (the-as int translucent-count-packet)))
          (&+! (-> dma-buf base) 16))
        (set! bucket (-> (the-as (inline-array prototype-bucket-shrub) bucket) 1))))
    ;; Near shrubs use the generic renderer with full matrices. Patch the last near chain to a
    ;; copied initialization packet, then submit it to the level's generic-shrub bucket.
    (when (logtest? *vu1-enable-user* (vu1-renderer-mask shrub-near))
      (when (nonzero? (-> *instance-shrub-work* near-count))
        (let ((dma-start (-> *display* frames (-> *display* on-screen) frame global-buf base)))
          (with-dma-buffer-add-bucket ((dma-buf (-> *display* frames (-> *display* on-screen) frame global-buf)) (if (zero? (-> (scratchpad-object terrain-context) bsp lev-index)) (bucket-id shrub-generic0) (bucket-id shrub-generic1))) :bucket-group (-> *display* frames (-> *display* on-screen) frame bucket-group) (generic-init-buf dma-buf 0 (new 'static 'gs-zbuf :zbp #x1c0 :psm (gs-psm ct24))) (let* ((dma-state dma-buf)
                             (direct-packet (the-as object (-> dma-state base))))
                        (set! (-> (the-as dma-packet direct-packet) dma) (new 'static 'dma-tag :qwc #x2 :id (dma-tag-id cnt)))
                        (set! (-> (the-as dma-packet direct-packet) vif0) (new 'static 'vif-tag))
                        (set! (-> (the-as dma-packet direct-packet) vif1) (new 'static 'vif-tag :imm #x2 :cmd (vif-cmd direct) :msk #x1))
                        (set! (-> dma-state base) (&+ (the-as pointer direct-packet) 16))) (let* ((dma-state dma-buf)
                             (giftag (the-as object (-> dma-state base))))
                        (set! (-> (the-as gs-gif-tag giftag) tag) (new 'static 'gif-tag64 :nloop #x1 :eop #x1 :nreg #x1))
                        (set! (-> (the-as gs-gif-tag giftag) regs) GIF_REGS_ALL_AD)
                        (set! (-> dma-state base) (&+ (the-as pointer giftag) 16))) (let* ((dma-state dma-buf)
                             (test-packet (-> dma-state base)))
                        (set! (-> (the-as (pointer gs-test) test-packet) 0)
                              (new 'static 'gs-test :ate #x1 :atst (gs-atest greater-equal) :aref #x26 :zte #x1 :ztst (gs-ztest greater-equal)))
                        (set! (-> (the-as (pointer gs-reg64) test-packet) 1) (gs-reg64 test-1))
                        (set! (-> dma-state base) (&+ test-packet 16))) (let ((near-packet (+ (+ (-> *instance-shrub-work* current-shrub-near-packet) 5152) (the-as uint *instance-shrub-work*)))
                            (output-matrix (the-as object (-> dma-buf base)))
                            (near-chain-tail (+ (-> *instance-shrub-work* near-last) 176)))
                        (let ((patched-init-tag (logior (logand (l.d (+ near-packet 96)) (the-as uint #x80000000ffffffff))
                                                        (shr (shl (-> *instance-shrub-work* near-next) 33) 1))))
                          (s.d! (+ near-packet 96) patched-init-tag))
                        (let ((init-tag (l.q (+ near-packet 96)))
                              (init-data-0 (l.q (+ near-packet 112)))
                              (init-data-1 (l.q (+ near-packet 128))))
                          (set! (-> (the-as matrix3 output-matrix) vector 0 quad) init-tag)
                          (set! (-> (the-as matrix3 output-matrix) vector 1 quad) init-data-0)
                          (set! (-> (the-as matrix3 output-matrix) vector 2 quad) init-data-1))
                        (let ((after-matrix (&+ (the-as pointer output-matrix) 48)))
                          (s.w! (+ near-chain-tail 4) after-matrix)
                          (set! (-> dma-buf base) after-matrix))))
          (let ((usage *dma-mem-usage*))
            (when (nonzero? usage)
              (set! (-> usage length) (max 28 (-> usage length)))
              (set! (-> usage data 27 name) "shrubbery")
              (+! (-> usage data 27 count) 1)
              (+! (-> usage data 27 used)
                  (&- (-> *display* frames (-> *display* on-screen) frame global-buf base) (the-as uint dma-start)))
              (set! (-> usage data 27 total) (-> usage data 27 used)))))))
    ;; Opaque and translucent shrubs share the model uploader but use separate GS TEST state and
    ;; output buckets. Each prototype can contain several packed shrubbery fragments; upload each
    ;; fragment once, then CALL the instance chain accumulated for that prototype.
    (when (logtest? *vu1-enable-user* (vu1-renderer-mask shrubbery))
      (let ((dma-start (-> *display* frames (-> *display* on-screen) frame global-buf base)))
        (with-dma-buffer-add-bucket ((dma-buf (-> *display* frames (-> *display* on-screen) frame global-buf)) (if (zero? (-> (scratchpad-object terrain-context) bsp lev-index)) (bucket-id shrub0) (bucket-id shrub1))) :bucket-group (-> *display* frames (-> *display* on-screen) frame bucket-group) (shrub-init-frame dma-buf
                                    (new 'static 'gs-test :ate #x1 :atst (gs-atest greater-equal) :aref #x26 :zte #x1 :ztst (gs-ztest greater-equal))) (let ((bucket (the-as prototype-bucket-shrub buckets)))
                    (countdown (i prototype-count)
                      (when (nonzero? (-> bucket count 1))
                        (let ((geometry (-> bucket geometry 1)))
                          (set! opaque-chain (-> bucket next 1))
                          (set! opaque-fragment (&+ geometry 32))
                          (set! opaque-fragments-left (-> (the-as drawable-group geometry) length)))
                        (while (nonzero? opaque-fragments-left)
                          (+! opaque-fragments-left -1)
                          (shrub-upload-model (the-as shrubbery opaque-fragment)
                                              dma-buf
                                              (the-as int (-> *instance-shrub-work* start-bank (-> bucket mod-count 1))))
                          (let* ((dma-state dma-buf)
                                 (call-packet (the-as object (-> dma-state base))))
                            (set! (-> (the-as dma-packet call-packet) dma) (new 'static 'dma-tag :id (dma-tag-id call) :addr opaque-chain))
                            (set! (-> (the-as dma-packet call-packet) vif0) (new 'static 'vif-tag))
                            (set! (-> (the-as dma-packet call-packet) vif1) (new 'static 'vif-tag))
                            (set! (-> dma-state base) (&+ (the-as pointer call-packet) 16)))
                          (&+! opaque-fragment 32)))
                      (&+! bucket 112))))
        (let ((usage *dma-mem-usage*))
          (when (nonzero? usage)
            (set! (-> usage length) (max 28 (-> usage length)))
            (set! (-> usage data 27 name) "shrubbery")
            (+! (-> usage data 27 count) 1)
            (+! (-> usage data 27 used)
                (&- (-> *display* frames (-> *display* on-screen) frame global-buf base) (the-as uint dma-start)))
            (set! (-> usage data 27 total) (-> usage data 27 used))))))
    (when (logtest? *vu1-enable-user* (vu1-renderer-mask trans-shrubbery))
      (let ((dma-start (-> *display* frames (-> *display* on-screen) frame global-buf base)))
        (with-dma-buffer-add-bucket ((dma-buf (-> *display* frames (-> *display* on-screen) frame global-buf)) (if (zero? (-> (scratchpad-object terrain-context) bsp lev-index)) (bucket-id shrub-trans0) (bucket-id shrub-trans1))) :bucket-group (-> *display* frames (-> *display* on-screen) frame bucket-group) (shrub-init-frame dma-buf
                                    (new 'static
                                         'gs-test
                                         :ate #x1
                                         :atst (gs-atest greater-equal)
                                         :aref #x26
                                         :afail #x1
                                         :zte #x1
                                         :ztst (gs-ztest greater-equal))) (let ((bucket (the-as prototype-bucket-shrub buckets)))
                    (countdown (i prototype-count)
                      (when (nonzero? (-> bucket count 2))
                        (let ((geometry (-> bucket geometry 2)))
                          (set! translucent-chain (-> bucket next 2))
                          (set! translucent-fragment (&+ geometry 32))
                          (set! translucent-fragments-left (-> (the-as drawable-group geometry) length)))
                        (while (nonzero? translucent-fragments-left)
                          (+! translucent-fragments-left -1)
                          (shrub-upload-model (the-as shrubbery translucent-fragment)
                                              dma-buf
                                              (the-as int (-> *instance-shrub-work* start-bank (-> bucket mod-count 2))))
                          (let* ((dma-state dma-buf)
                                 (call-packet (the-as object (-> dma-state base))))
                            (set! (-> (the-as dma-packet call-packet) dma) (new 'static 'dma-tag :id (dma-tag-id call) :addr translucent-chain))
                            (set! (-> (the-as dma-packet call-packet) vif0) (new 'static 'vif-tag))
                            (set! (-> (the-as dma-packet call-packet) vif1) (new 'static 'vif-tag))
                            (set! (-> dma-state base) (&+ (the-as pointer call-packet) 16)))
                          (&+! translucent-fragment 32)))
                      (&+! bucket 112))))
        (let ((usage *dma-mem-usage*))
          (when (nonzero? usage)
            (set! (-> usage length) (max 28 (-> usage length)))
            (set! (-> usage data 27 name) "shrubbery")
            (+! (-> usage data 27 count) 1)
            (+! (-> usage data 27 used)
                (&- (-> *display* frames (-> *display* on-screen) frame global-buf base) (the-as uint dma-start)))
            (set! (-> usage data 27 total) (-> usage data 27 used))))))
    ;; Billboards are emitted directly as GS packets. Each active prototype contributes its shader,
    ;; distance constants, chain links, and count data to a seven-quadword record.
    (when (logtest? *vu1-enable-user* (vu1-renderer-mask billboard))
      (let* ((dma-start (-> *display* frames (-> *display* on-screen) frame global-buf base))
             (dma-buf (-> *display* frames (-> *display* on-screen) frame global-buf))
             (chain-start (-> dma-buf base)))
        (let* ((dma-state dma-buf)
               (direct-packet (the-as object (-> dma-state base))))
          (set! (-> (the-as dma-packet direct-packet) dma) (new 'static 'dma-tag :qwc #x2 :id (dma-tag-id cnt)))
          (set! (-> (the-as dma-packet direct-packet) vif0) (new 'static 'vif-tag))
          (set! (-> (the-as dma-packet direct-packet) vif1) (new 'static 'vif-tag :imm #x2 :cmd (vif-cmd direct) :msk #x1))
          (set! (-> dma-state base) (&+ (the-as pointer direct-packet) 16)))
        (let* ((dma-state dma-buf)
               (setup-packet (the-as object (-> dma-state base))))
          (set! (-> (the-as dma-packet setup-packet) dma) (new 'static 'dma-tag :qwc #x8001 :addr #x10000000))
          (let ((setup-fill (the-as uint #xeeeeeeeeeeeeeeee))) (s.d! (+ (the-as dma-packet setup-packet) 8) setup-fill))
          (set! (-> dma-state base) (&+ (the-as pointer setup-packet) 16)))
        (let* ((dma-state dma-buf)
               (setup-data (-> dma-state base)))
          (set! (-> (the-as (pointer int64) setup-data)) #x5180b)
          (let ((setup-address 71)) (s.d! (+ setup-data 8) setup-address))
          (set! (-> dma-state base) (&+ setup-data 16)))
        (let ((output (-> dma-buf base)))
          (while (nonzero? prototype-count)
            (+! prototype-count -1)
            (when (nonzero? (-> (the-as prototype-bucket-shrub buckets) count 3))
              (set! (-> *instance-shrub-work* adgif-tmpl dma-vif dma addr) (-> (the-as prototype-bucket-shrub buckets) next 3))
              (set! (-> (the-as (pointer uint128) output)) (-> *instance-shrub-work* adgif-tmpl dma-vif quad))
              (let ((adgif-data (-> *instance-shrub-work* adgif-tmpl quad 1))) (s.q! (+ output 16) adgif-data))
              (let ((billboard (the-as prototype-bucket-shrub (-> (the-as prototype-bucket-shrub buckets) geometry 3))))
                (let ((distance-data (-> billboard dists quad))) (s.q! (+ output 32) distance-data))
                (let ((reciprocal-distance-data (-> billboard rdists quad))) (s.q! (+ output 48) reciprocal-distance-data))
                (let ((next-data (-> billboard next-clear))) (s.q! (+ output 64) next-data))
                (let ((count-data (-> billboard count-clear-qword))) (s.q! (+ output 80) count-data))
                (let ((last-data (-> billboard last-clear))) (s.q! (+ output 96) last-data)))
              (&+! output 112)
              (set! (-> (the-as prototype-bucket-shrub buckets) last 3 dma addr) (the-as int output)))
            (set! buckets (the-as (inline-array prototype-bucket-shrub) (-> buckets 1))))
          (set! (-> dma-buf base) output))
        (let ((chain-end (-> dma-buf base)))
          (let ((end-packet (the-as dma-packet (-> dma-buf base))))
            (set! (-> end-packet dma) (new 'static 'dma-tag :id (dma-tag-id next)))
            (set! (-> end-packet vif0) (new 'static 'vif-tag))
            (set! (-> end-packet vif1) (new 'static 'vif-tag))
            (set! (-> dma-buf base) (the-as pointer (&+ end-packet 16))))
          (let ((insert-result (dma-bucket-insert-tag (-> *display* frames (-> *display* on-screen) frame bucket-group)
                                                      (if (zero? (-> (scratchpad-object terrain-context) bsp lev-index)) (bucket-id shrub-billboard0) (bucket-id shrub-billboard1))
                                                      chain-start
                                                      (the-as (pointer dma-tag) chain-end))))
            (let ((usage *dma-mem-usage*))
              (when (nonzero? usage)
                (set! (-> usage length) (max 34 (-> usage length)))
                (set! (-> usage data 33 name) "billboard")
                (+! (-> usage data 33 count) 1)
                (+! (-> usage data 33 used)
                    (&- (-> *display* frames (-> *display* on-screen) frame global-buf base) (the-as uint dma-start)))
                (set! (-> usage data 33 total) (-> usage data 33 used))))
            insert-result))))))

(defun draw-drawable-tree-instance-shrub ((tree drawable-tree-instance-shrub) (level level))
  "Clear the frame's shrub prototype buckets, traverse tree when shrub rendering is enabled, submit
   the generated chains, update scratchpad wait statistics, and store the nearest shrub distance in
   level. On PC, submit the tree to the native renderer in place of the EE chain builders."
  ;; The performance buckets measure tree traversal and prototype submission separately.
  (set-vector! (-> *instance-shrub-work* min-dist) 4095996000.0 4095996000.0 4095996000.0 4095996000.0)
  (set! (-> *instance-shrub-work* near-last) (the-as uint 0))
  (set! (-> *instance-shrub-work* near-next) (the-as uint 0))
  (set! (-> *instance-shrub-work* near-count) (the-as uint 0))
  (set! (-> *instance-shrub-work* wind-vectors) (-> tree info wind-vectors))
  (set! (-> *instance-shrub-work* wait-to-spr) (the-as uint 0))
  (set! (-> *instance-shrub-work* wait-from-spr) (the-as uint 0))
  (when (logtest? *vu1-enable-user* (vu1-renderer-mask shrubbery shrub-near billboard trans-shrubbery))
    (let* ((prototypes (-> tree info prototype-inline-array-shrub))
           (prototype-count (-> prototypes length))
           (buckets (-> prototypes data)))
      (countdown (bucket-index prototype-count)
        (let ((bucket (-> prototypes data bucket-index)))
          (set! (-> bucket next-clear) (the-as uint128 0))
          (set! (-> bucket last-clear) (the-as uint128 0))
          (set! (-> bucket count-clear) (the-as uint 0)))
        0)
      (let ((dma-buf (-> *display* frames (-> *display* on-screen) frame global-buf)))
        (when (nonzero? (-> tree length))
          (let ((dma-start (-> *display* frames (-> *display* on-screen) frame global-buf base)))
            (reset! (-> *perf-stats* data (perf-stat-bucket inst-shrub)))
            ; (draw-inline-array-instance-shrub
            ;   dma-buf
            ;   (&+ (-> tree data 0) 32)
            ;   (-> (the-as drawable-group (-> tree data 0)) length)
            ;   buckets
            ;   )
            ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
            ;; NOTE: this part is completely rewritten for PC
            ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
            (when (logtest? *vu1-enable-user* (vu1-renderer-mask shrubbery))
              (with-dma-buffer-add-bucket ((pc-dma-buf (-> *display* frames (-> *display* on-screen) frame global-buf)) (the-as bucket-id
                                                               (if (zero? (-> (scratchpad-object terrain-context) bsp lev-index)) (bucket-id shrub0) (bucket-id shrub1)))) :bucket-group (-> *display* frames (-> *display* on-screen) frame bucket-group) (add-pc-tfrag3-data pc-dma-buf (-> *level* data (-> (scratchpad-object terrain-context) bsp lev-index)))))
            (read! (-> *perf-stats* data (perf-stat-bucket inst-shrub)))
            (reset! (-> *perf-stats* data (perf-stat-bucket proto-shrub)))
            ; (draw-prototype-inline-array-shrub prototype-count buckets)
            (read! (-> *perf-stats* data (perf-stat-bucket proto-shrub)))
            (let ((usage *dma-mem-usage*))
              (when (nonzero? usage)
                (set! (-> usage length) (max 28 (-> usage length)))
                (set! (-> usage data 27 name) "shrubbery")
                (+! (-> usage data 27 count) 1)
                (+! (-> usage data 27 used)
                    (&- (-> *display* frames (-> *display* on-screen) frame global-buf base) (the-as uint dma-start)))
                (set! (-> usage data 27 total) (-> usage data 27 used))))))))
    (update-wait-stats (-> *perf-stats* data (perf-stat-bucket inst-shrub))
                       (the-as uint 0)
                       (-> *instance-shrub-work* wait-to-spr)
                       (-> *instance-shrub-work* wait-from-spr))
    (set! (-> level closest-object 2) (-> *instance-shrub-work* min-dist x)))
  0
  (none))

(defmethod draw ((this drawable-tree-instance-shrub) (root drawable-tree-instance-shrub) (frame display-frame))
  "Queue this shrub tree and its owning level for the background pass; root and frame are provided
   by the drawable interface but are not needed."
  (let* ((queue-index (-> *background-work* shrub-tree-count))
         (level-index (-> (scratchpad-object terrain-context) bsp lev-index))
         (owning-level (-> *level* level level-index)))
    (set! (-> *background-work* shrub-trees queue-index) this)
    (set! (-> *background-work* shrub-levels queue-index) owning-level))
  (+! (-> *background-work* shrub-tree-count) 1)
  (none))

(defmethod unpack-vis ((this drawable-tree-instance-shrub) (source (pointer int8)) (destination (pointer int8)))
  "Shrub trees do not use packed visibility IDs; leave destination unchanged and return it."
  destination)

(defmethod collect-stats ((this drawable-tree-instance-shrub))
  "Accumulate enabled near-shrub, opaque-shrub, translucent-shrub, and billboard counts, including
   fragment, instance, triangle, and displayed-vertex totals."
  (when (logtest? *vu1-enable-user* (vu1-renderer-mask shrubbery shrub-near billboard trans-shrubbery))
    (let* ((prototypes (-> this info prototype-inline-array-shrub))
           (bucket (the-as object (-> prototypes data))))
      (countdown (prototype-index (-> prototypes length))
        (when (logtest? *vu1-enable-user* (vu1-renderer-mask shrub-near))
          (let ((near-count (-> (the-as prototype-bucket-shrub bucket) count 0))
                (near-geometry (-> (the-as prototype-bucket-shrub bucket) geometry 0)))
            (when (nonzero? near-count)
              (let ((fragment-count (-> (the-as drawable-group near-geometry) length)))
                (+! (-> *terrain-stats* shrub groups) 1)
                (+! (-> *terrain-stats* shrub fragments) (* fragment-count (the-as int near-count))))
              (+! (-> *terrain-stats* shrub instances) near-count))))
        (when (logtest? *vu1-enable-user* (vu1-renderer-mask shrubbery))
          (let ((opaque-count (-> (the-as prototype-bucket-shrub bucket) count 1))
                (opaque-geometry (-> (the-as prototype-bucket-shrub bucket) geometry 1)))
            (when (nonzero? opaque-count)
              (let ((fragment (&+ opaque-geometry 32))
                    (fragment-count (-> (the-as drawable-group opaque-geometry) length)))
                (+! (-> *terrain-stats* shrub groups) 1)
                (+! (-> *terrain-stats* shrub fragments) fragment-count)
                (+! (-> *terrain-stats* shrub instances) opaque-count)
                (while (nonzero? fragment-count)
                  (+! fragment-count -1)
                  (let ((triangle-count (* (shrub-num-tris (the-as shrubbery fragment)) opaque-count))
                        (display-vertex-count (* (-> (the-as shrubbery fragment) header data 2) opaque-count)))
                    (+! (-> *terrain-stats* shrub tris) triangle-count)
                    (+! (-> *terrain-stats* shrub dverts) display-vertex-count))
                  (&+! fragment 32))))))
        (when (logtest? *vu1-enable-user* (vu1-renderer-mask trans-shrubbery))
          (let ((translucent-count (-> (the-as prototype-bucket-shrub bucket) count 2))
                (translucent-geometry (-> (the-as prototype-bucket-shrub bucket) geometry 2)))
            (when (nonzero? translucent-count)
              (let ((fragment (&+ translucent-geometry 32))
                    (fragment-count (-> (the-as drawable-group translucent-geometry) length)))
                (+! (-> *terrain-stats* trans-shrub groups) 1)
                (+! (-> *terrain-stats* trans-shrub fragments) fragment-count)
                (+! (-> *terrain-stats* trans-shrub instances) translucent-count)
                (while (nonzero? fragment-count)
                  (+! fragment-count -1)
                  (let ((triangle-count (* (shrub-num-tris (the-as shrubbery fragment)) translucent-count))
                        (display-vertex-count (* (-> (the-as shrubbery fragment) header data 2) translucent-count)))
                    (+! (-> *terrain-stats* trans-shrub tris) triangle-count)
                    (+! (-> *terrain-stats* trans-shrub dverts) display-vertex-count))
                  (&+! fragment 32))))))
        (when (logtest? *vu1-enable-user* (vu1-renderer-mask billboard))
          (let ((billboard-count (-> (the-as prototype-bucket-shrub bucket) count 3)))
            (when (nonzero? billboard-count)
              (+! (-> *terrain-stats* billboard groups) 1)
              (+! (-> *terrain-stats* billboard instances) billboard-count)
              (+! (-> *terrain-stats* billboard tris) (* billboard-count 2))
              (+! (-> *terrain-stats* billboard dverts) (* billboard-count 4)))))
        (set! bucket (-> (the-as (inline-array prototype-bucket-shrub) bucket) 1)))))
  (none))

(#unless PC_PORT
  (defun shrub-upload-test ((fragment generic-shrub-fragment))
    "Debug-upload one generic shrub fragment to VU1 memory and wait for the transfer to finish."
    (let ((dma-buf (new 'debug 'dma-buffer 1024)))
      (clear-vu1-mem)
      (upload-generic-shrub dma-buf fragment 0 128)
      (let ((packet (-> dma-buf base)))
        (set! (-> (the-as (pointer int64) packet)) #x70000000)
        (s.d! (+ packet 8) 0)
        (set! (-> dma-buf base) (&+ packet 16)))
      (dma-send-chain (the-as dma-bank-source #x10009000) (the-as uint (-> dma-buf data))))
    (dma-sync (the-as pointer #x10008000) 0 0)
    0
    (none))
  ;; This small dependency experiment repeatedly issues three VU0 multiplies beside an FPU max.
  ;; It is retained for measuring how the two pipelines overlap.
  (defun test-func ()
    "Run the short VU0/FPU dependency timing experiment."
    (declare (asm-func none))
    (add.i v1 r0 999)
    (label repeat-test)
    (mul.vf vf3 vf2 vf2)
    (nop!)
    (mul.vf vf4 vf2 vf2)
    (nop!)
    (mul.vf vf5 vf2 vf2)
    (nop!)
    (max.s f0 f1 f0)
    (nop!)
    (b.gt v1 r0 repeat-test :delay (add.i v1 v1 -1))
    (m v0 r0)
    (jr ra :delay (add sp sp r0))
    (nop!)
    (nop!)
    (nop!)))

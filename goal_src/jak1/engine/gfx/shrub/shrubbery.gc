                 (b advance-instance :delay (add.i packet-cursor packet-cursor 16))
                 (label select-second-matrix)
                 (add.i t5 t4 -9)
                 (nop!)
                 (b.z t5 use-second-indexed-matrix :delay (add.i t4 t4 -19))
                 (b.nz t4 advance-instance :delay (nop!))

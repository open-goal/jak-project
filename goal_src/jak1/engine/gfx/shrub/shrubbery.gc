                 (s.h t7 (-> work mod-count 1))
                 (add.i packet-cursor packet-cursor 96)
                 (s.w a2 packet-cursor -92)
                 (b.z t4 use-second-shared-matrix :delay (s.w t5 (-> work next 1)))
                 (b.nz t8 select-second-matrix :delay (nop!))
                 (label use-second-shared-matrix)
                 (nop!)

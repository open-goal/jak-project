;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "kernel-defs.gc")

;; Depth-cue is an effect that tries to blur things in the distance,
;; however it does not look very good on modern high resolution displays.
;; Naughty Dog dropped this effect in later games.
;; This is disabled by default on PC.

;; DECOMP BEGINS

;; Parameters for one framebuffer depth-cue pass.
(deftype depth-cue-data (structure)
  ((data      vector :inline)
   (sharpness float :overlay-at (-> data x)) ;; Scale applied while resampling each screen strip.
   (alpha     float :overlay-at (-> data y)) ;; Strength of the filtered overlay.
   (distance  float :overlay-at (-> data z)) ;; Camera-space distance for the depth pass.
   (w         float :overlay-at (-> data w))))

;; Static GIF packet fragments and parameters used to assemble the depth-cue DMA chain.
(deftype depth-cue-work (structure)
  ((texture-strip-tmpl dma-gif-packet :inline) ;; Copy a filtered temporary strip to the framebuffer.
   (temp-strip-tmpl    dma-gif-packet :inline) ;; Copy a framebuffer strip into temporary VRAM.
   (stencil-tmpl       dma-gif-packet :inline) ;; Sprite packet used to write the destination-alpha stencil.
   (clear-color        vector4w :inline)
   (set-color          vector4w :inline) ;; Neutral color for the framebuffer-to-texture copy.
   (draw-color         vector4w :inline) ;; Overlay color; alpha is filled for each pass.
   (depth              depth-cue-data) ;; Depth-dependent pass parameters.
   (front              depth-cue-data))) ;; Full-screen foreground pass parameters.

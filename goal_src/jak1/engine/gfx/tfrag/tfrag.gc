                ;; shader block's second quadword. That word is the upper half of the adgif A+D slot whose lower half is
                ;; the texture id, so login never touches it and the exporter parks the constant there.
                (label render-morphed-clipped-bank0)
                (vu-pair (ilw.w shader-base input-bank 4) (addw.z point-record vf00 vf00)) ;; #x382
                (vu-pair (lq.xyzw strip-tag vi00 TFRAG-VU-STRGIF) (nop)) ;; #x383
                (vu-pair (lq.xyzw hvdf-offset vi00 TFRAG-VU-HVDF-OFFSET) (nop)) ;; #x384
                (vu-pair (lq.xyzw adgif-tag vi00 TFRAG-VU-ADGIF) (nop)) ;; #x385
                (vu-pair (iadd shader-base shader-base input-bank) (nop)) ;; #x386

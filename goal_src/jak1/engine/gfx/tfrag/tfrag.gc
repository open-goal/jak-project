              (vu-pair (ilw.w parent-b-vertex parent-record TFRAG-VU-BANK-1) (mini.xy weight-0 weight-0 val)) ;; #x151
              (vu-pair (ibne vi00 points-left morph-points-bank1-loop) (add.xyzw parent-sum-color parent-b-color parent-a-color)) ;; #x152
              (vu-pair (sq.xyzw color-1 store-vertex (+ TFRAG-VU-BANK-1 1)) (itof0.xyzw pos-1 packed-pos)) ;; #x153
              (label morph-points-bank1-done)
              (vu-pair (jr subroutine-link) (nop)) ;; #x154
              (vu-pair (nop) (nop))) ;; #x155
            (rlet ((points-left :reg vi02)
                   (point-cursor :reg vi03)
                   (endpoint-cursor :reg vi04)
                   (own-vertex-0 :reg vi05)
                   (own-vertex-1 :reg vi06)
                   (parent-record-0 :reg vi07)
                   (parent-record-1 :reg vi08)
                   (parent-b-vertex :reg vi09)
                   (parent-a-vertex :reg vi10)
                   (store-vertex :reg vi11)
                   (parent-b-collapsed :reg vi01)                        ;; sign flag of parent-b.w - collapse-dist
                   (parent-a-collapsed :reg vi12)
                   (val :reg vf02)
                   (cam-row-x :reg vf05)
                   (cam-row-y :reg vf06)
                   (cam-row-z :reg vf07)
                   (cam-trans :reg vf08)
                   (pos-0 :reg vf12)
                   (pos-1 :reg vf13)
                   (color-0 :reg vf14)
                   (color-1 :reg vf15)
                   (weight-0 :reg vf16)
                   (weight-1 :reg vf17)
                   (k0 :reg vf18)
                   (k1 :reg vf19)
                   (parent-b-pos :reg vf20)
                   (parent-b-color :reg vf21)
                   (parent-a-pos :reg vf22)
                   (parent-a-color :reg vf23)
                   (parent-sum-pos :reg vf24)
                   (parent-sum-color :reg vf25)
                   (collapse-dist :reg vf26)                             ;; k0s[level].w, broadcast in w only
                   (replacement-record :reg vf27))
              ;; The same unwind, with the edge-retirement test added. Everything above is driven by the point's OWN
              ;; depth, and a point is authored displaced from the midpoint - that displacement is the detail it exists
              ;; to add - so its depth is the midpoint's depth plus the displacement's w component. Which means a point
              ;; can still be short of its saturation distance while the edge it splits is entirely past it, and the
              ;; smooth blend would leave a residual bump on an edge that is supposed to be flat by now.
              ;;
              ;; So this variant asks a question about the EDGE instead of about the point: are BOTH parents past
              ;; collapse-dist? If they are, the edge has retired, and the point is forced the rest of the way rather
              ;; than being interpolated there. That is the whole reason the mechanism exists. It is not an
              ;; optimisation - the two paths are the same length and issue the same number of memory operations, as
              ;; set out below - and it is not a second collapse target either; it is what makes completion of the
              ;; collapse a function of the two endpoints, which are shared, undisplaced, and identical in every patch
              ;; that owns this edge, instead of a function of the point's own displaced position, which is not.
              ;;
              ;; collapse-dist is dists.k0s[level].w, and set-tfrag-dists! puts the same float there that it built the
              ;; band from, so the retirement distance and the distance at which weight.y reaches zero and weight.x
              ;; reaches one half are the same number. The two mechanisms cannot disagree about when a level is done.
              ;;
              ;; TWO IDIOMS IN THE TEST, both of which recur later and neither of which reads as code without
              ;; explanation.
              ;;
              ;; First, the comparison. (subw.w vf00 parent-pos collapse-dist) writes to vf00, whose writes are
              ;; discarded, so the subtraction computes nothing - it exists purely to set the sign flag, which the
              ;; matching (fsand flag 0x2) reads four pairs later because four is the VU's status-flag latency. Both
              ;; endpoints are compared, so there are two subtractions and two fsands, spaced four apart each. Mind
              ;; the sign while reading them: transformed w is negative and grows more negative with distance, and so
              ;; does collapse-dist, so a set sign flag means that endpoint is FARTHER than the boundary.
              ;;
              ;; Second, the combination. The two flags are ANDed - (iand parent-b-collapsed parent-b-collapsed
              ;; parent-a-collapsed) - so the branch is taken only when BOTH endpoints are past the distance, never
              ;; either. That is the whole point of asking about the endpoints rather than about the point: an edge
              ;; retires when the edge is done, and both patches sharing that edge evaluate the same two endpoints.
              ;;
              ;; WHY THERE IS A BRANCH HERE AT ALL, since it is the question this code raises and the answer is not
              ;; "to save work". Count the two paths. The branch is the fifteenth pair of the stage, so the first
              ;; fourteen are common to both; what differs is a five-pair tail either way:
              ;;
              ;;   normal tail                                    substitute tail
              ;;   -------------------------------------------    ------------------------------------------------
              ;;   ilw.w own-vertex-0, 2(point-cursor)            lq   replacement-record, 0(parent-record-N)
              ;;   (nop)                                          ilw.w own-vertex-0, 2(point-cursor)
              ;;   sq   pos-N,   0(store-vertex)                  (nop)
              ;;   loop test on points-left                       loop test on points-left
              ;;   sq   color-N, 1(store-vertex)                  sq   replacement-record, 0(point-cursor)
              ;;
              ;; Five pairs against five, three memory operations against three. The branch trades two stores TO THE
              ;; VERTEX for one load and one store TO THE RECORD. Nothing is saved; the two outcomes simply need
              ;; different stores, and that is the whole reason for the branch.
              ;;
              ;; It has to be either/or rather than both, and the budget is why. Only the lower slot of a pair can
              ;; carry a load or a store, so a five-pair tail has five scalar slots, and one of them is the loop test.
              ;; Doing both outcomes would want the vertex-address prefetch, two vertex stores, the record load and
              ;; the record store - five memory operations plus the branch, in four available slots. It does not fit.
              ;;
              ;; And notice the upper slots: both tails issue the SAME four vector operations, in the same order,
              ;; shifted one pair apart. That is not a coincidence and not something a branch could change. In a
              ;; four-deep software-pipelined loop the vector work in a stage's tail belongs to the points still in
              ;; flight - the parent sums computed here are consumed by the next stage's blend, not by this point - so
              ;; a per-point branch cannot skip vector work even in principle. It can only redirect the scalar slots,
              ;; which is exactly what it does.
              ;;
              ;; WHAT REJOINING REPEATS: nothing, for the point that retired. Both tails end at
              ;; collapse-points-bank0-stage1, which works on the next point of the group entirely, and both have
              ;; already prefetched the vertex address two points ahead and tested points-left. The retired point is
              ;; finished either way. Its vertex is left holding the integers the VIF unpacked - not because anything
              ;; skipped its transform, which was issued in the common fourteen pairs, but because the store that
              ;; would have written the result was replaced by the store that redirects its record. The substitute
              ;; tail carries two extra pairs after its loop test, (jr subroutine-link) and a nop, reached only when
              ;; points-left has run out; the normal path reaches the same return through collapse-points-done.
              ;;
              ;; The EE only asks for this variant when the patch's bounding sphere straddles the boundary. When the
              ;; whole sphere is nearer, no endpoint can be past it, the test cannot fire, and the shorter loop above
              ;; is used instead.
              ;;
              ;; ONE BODY, TWO LEVELS. collapse-level1-points and collapse-level0-points are preambles, not loops:
              ;; each loads its own count, point cursor, endpoint table, coefficient pair and collapse distance, and
              ;; then enters collapse-points-bank0, which is shared. The plain pair above works the same way -
              ;; morph-level1-points and morph-level0-points into one morph-points-bank0. So the four blend behaviours
              ;; in this program come out of two loop bodies and four preambles, and each body additionally has a
              ;; bank-1 copy of itself for the second VIF buffer. Level 0 and level 1 are not duplicated code.
              (label collapse-level1-points)
              (vu-pair (ilw.x points-left input-bank 1) (nop)) ;; #x156
              (vu-pair (ilw.w point-cursor input-bank 2) (nop)) ;; #x157
              (vu-pair (ilw.x endpoint-cursor input-bank 4) (nop)) ;; #x158
              (vu-pair (lq.xyzw fog vi00 TFRAG-VU-FOG) (nop)) ;; #x159
              (vu-pair (ibeq vi00 points-left collapse-points-done) (nop)) ;; #x15a
              (vu-pair (lq.xyzw val vi00 TFRAG-VU-VAL) (nop)) ;; #x15b
              (vu-pair (lq.xy k0 vi00 TFRAG-VU-K0-LEVEL1) (nop)) ;; #x15c
              (vu-pair (lq.xy k1 vi00 TFRAG-VU-K1-LEVEL1) (nop)) ;; #x15d
              (vu-pair (b collapse-points-bank0) (nop)) ;; #x15e
              (vu-pair (lq.w collapse-dist vi00 TFRAG-VU-K0-LEVEL1) (nop)) ;; #x15f
              (label collapse-level0-points)
              (vu-pair (ilwr.z points-left input-bank) (nop)) ;; #x160
              (vu-pair (ilw.y point-cursor input-bank 2) (nop)) ;; #x161
              (vu-pair (ilw.z endpoint-cursor input-bank 3) (nop)) ;; #x162
              (vu-pair (lq.xyzw fog vi00 TFRAG-VU-FOG) (nop)) ;; #x163
              (vu-pair (ibeq vi00 points-left collapse-points-done) (nop)) ;; #x164
              (vu-pair (lq.xyzw val vi00 TFRAG-VU-VAL) (nop)) ;; #x165
              (vu-pair (lq.xy k0 vi00 TFRAG-VU-K0-LEVEL0) (nop)) ;; #x166
              (vu-pair (lq.xy k1 vi00 TFRAG-VU-K1-LEVEL0) (nop)) ;; #x167
              (vu-pair (lq.w collapse-dist vi00 TFRAG-VU-K0-LEVEL0) (nop)) ;; #x168
              (label collapse-points-bank0)
              (vu-pair (lq.xyzw cam-row-x input-bank TFRAG-VU-CAMERA) (nop)) ;; #x169
              (vu-pair (lq.xyzw cam-row-y input-bank (+ TFRAG-VU-CAMERA 1)) (nop)) ;; #x16a
              (vu-pair (lq.xyzw cam-row-z input-bank (+ TFRAG-VU-CAMERA 2)) (nop)) ;; #x16b
              (vu-pair (ibne vi00 input-bank collapse-points-bank1) (nop)) ;; #x16c
              (vu-pair (lq.xyzw cam-trans input-bank (+ TFRAG-VU-CAMERA 3)) (nop)) ;; #x16d
              (vu-pair (ilwr.w own-vertex-0 point-cursor) (nop)) ;; #x16e
              (vu-pair (nop) (nop)) ;; #x16f
              (vu-pair (nop) (nop)) ;; #x170
              (vu-pair (nop) (nop)) ;; #x171
              (vu-pair (lq.xyzw pos-0 own-vertex-0 0) (nop)) ;; #x172
              (vu-pair (ilwr.z parent-a-vertex point-cursor) (nop)) ;; #x173
              (vu-pair (ilwr.x parent-record-0 endpoint-cursor) (nop)) ;; #x174
              (vu-pair (nop) (nop)) ;; #x175
              (vu-pair (nop) (itof0.xyzw pos-0 pos-0)) ;; #x176
              (vu-pair (nop) (nop)) ;; #x177
              (vu-pair (nop) (mulaw.xyzw ACC cam-trans vf00)) ;; #x178
              (vu-pair (ilwr.w parent-b-vertex parent-record-0) (nop)) ;; #x179
              (vu-pair (lq.xyzw parent-a-pos parent-a-vertex 0) (maddax.xyzw ACC cam-row-x pos-0)) ;; #x17a
              (vu-pair (nop) (madday.xyzw ACC cam-row-y pos-0)) ;; #x17b
              (vu-pair (lq.xyzw parent-a-color parent-a-vertex 1) (maddz.xyzw pos-0 cam-row-z pos-0)) ;; #x17c
              (vu-pair (lq.xyzw parent-b-pos parent-b-vertex 0) (nop)) ;; #x17d
              (vu-pair (lq.xyzw parent-b-color parent-b-vertex 1) (nop)) ;; #x17e
              (vu-pair (lq.xyzw color-0 own-vertex-0 1) (nop)) ;; #x17f
              (vu-pair (ilw.w own-vertex-1 point-cursor 1) (nop)) ;; #x180
              (vu-pair (nop) (mulaw.xy ACC k1 vf00)) ;; #x181
              (vu-pair (nop) (maddw.xy weight-0 k0 pos-0)) ;; #x182
              (vu-pair (nop) (add.xyzw parent-sum-pos parent-b-pos parent-a-pos)) ;; #x183
              (vu-pair (nop) (add.xyzw parent-sum-color parent-b-color parent-a-color)) ;; #x184
              (label collapse-points-bank0-stage0)
              (vu-pair (lq.xyzw pos-1 own-vertex-1 0) (nop)) ;; #x185
              (vu-pair (ilw.z parent-a-vertex point-cursor 1) (subw.w vf00 parent-b-pos collapse-dist)) ;; #x186
              (vu-pair (ilwr.y parent-record-1 endpoint-cursor) (subw.w vf00 parent-a-pos collapse-dist)) ;; #x187
              (vu-pair (ior store-vertex own-vertex-0 vi00) (mini.xy weight-0 weight-0 val)) ;; #x188
              (vu-pair (iaddi points-left points-left -0x1) (itof0.xyzw pos-1 pos-1)) ;; #x189
              (vu-pair (fsand parent-b-collapsed 0x2) (itof0.xyzw color-0 color-0)) ;; #x18a
              (vu-pair (fsand parent-a-collapsed 0x2) (mulaw.xyzw ACC cam-trans vf00)) ;; #x18b
              (vu-pair (ilwr.w parent-b-vertex parent-record-1) (maxx.xy weight-0 weight-0 vf00)) ;; #x18c
              (vu-pair (lq.xyzw parent-a-pos parent-a-vertex 0) (maddax.xyzw ACC cam-row-x pos-1)) ;; #x18d
              (vu-pair (iand parent-b-collapsed parent-b-collapsed parent-a-collapsed) (madday.xyzw ACC cam-row-y pos-1)) ;; #x18e
              (vu-pair (lq.xyzw parent-a-color parent-a-vertex 1) (maddz.xyzw pos-1 cam-row-z pos-1)) ;; #x18f
              (vu-pair (lq.xyzw parent-b-pos parent-b-vertex 0) (mulax.xyzw ACC parent-sum-pos weight-0)) ;; #x190
              (vu-pair (lq.xyzw parent-b-color parent-b-vertex 1) (maddy.xyzw pos-0 pos-0 weight-0)) ;; #x191
              (vu-pair (ibne vi00 parent-b-collapsed substitute-parent-bank0-stage0) (mulax.xyzw ACC parent-sum-color weight-0)) ;; #x192
              (vu-pair (lq.xyzw color-1 own-vertex-1 1) (maddy.xyzw color-0 color-0 weight-0)) ;; #x193
              (vu-pair (ilw.w own-vertex-0 point-cursor 2) (nop)) ;; #x194
              (vu-pair (nop) (mulaw.xy ACC k1 vf00)) ;; #x195
              (vu-pair (sq.xyzw pos-0 store-vertex 0) (maddw.xy weight-1 k0 pos-1)) ;; #x196
              (vu-pair (ibeq vi00 points-left collapse-points-done) (add.xyzw parent-sum-pos parent-b-pos parent-a-pos)) ;; #x197
              (vu-pair (sq.xyzw color-0 store-vertex 1) (add.xyzw parent-sum-color parent-b-color parent-a-color)) ;; #x198
              (label collapse-points-bank0-stage1)
              (vu-pair (lq.xyzw pos-0 own-vertex-0 0) (nop)) ;; #x199
              (vu-pair (ilw.z parent-a-vertex point-cursor 2) (subw.w vf00 parent-b-pos collapse-dist)) ;; #x19a
              (vu-pair (ilwr.z parent-record-0 endpoint-cursor) (subw.w vf00 parent-a-pos collapse-dist)) ;; #x19b
              (vu-pair (ior store-vertex own-vertex-1 vi00) (mini.xy weight-1 weight-1 val)) ;; #x19c
              (vu-pair (iaddi points-left points-left -0x1) (itof0.xyzw pos-0 pos-0)) ;; #x19d
              (vu-pair (fsand parent-b-collapsed 0x2) (itof0.xyzw color-1 color-1)) ;; #x19e
              (vu-pair (fsand parent-a-collapsed 0x2) (mulaw.xyzw ACC cam-trans vf00)) ;; #x19f
              (vu-pair (ilwr.w parent-b-vertex parent-record-0) (maxx.xy weight-1 weight-1 vf00)) ;; #x1a0
              (vu-pair (lq.xyzw parent-a-pos parent-a-vertex 0) (maddax.xyzw ACC cam-row-x pos-0)) ;; #x1a1
              (vu-pair (iand parent-b-collapsed parent-b-collapsed parent-a-collapsed) (madday.xyzw ACC cam-row-y pos-0)) ;; #x1a2
              (vu-pair (lq.xyzw parent-a-color parent-a-vertex 1) (maddz.xyzw pos-0 cam-row-z pos-0)) ;; #x1a3
              (vu-pair (lq.xyzw parent-b-pos parent-b-vertex 0) (mulax.xyzw ACC parent-sum-pos weight-1)) ;; #x1a4
              (vu-pair (lq.xyzw parent-b-color parent-b-vertex 1) (maddy.xyzw pos-1 pos-1 weight-1)) ;; #x1a5
              (vu-pair (ibne vi00 parent-b-collapsed substitute-parent-bank0-stage1) (mulax.xyzw ACC parent-sum-color weight-1)) ;; #x1a6
              (vu-pair (lq.xyzw color-0 own-vertex-0 1) (maddy.xyzw color-1 color-1 weight-1)) ;; #x1a7
              (vu-pair (ilw.w own-vertex-1 point-cursor 3) (nop)) ;; #x1a8
              (vu-pair (nop) (mulaw.xy ACC k1 vf00)) ;; #x1a9
              (vu-pair (sq.xyzw pos-1 store-vertex 0) (maddw.xy weight-0 k0 pos-0)) ;; #x1aa
              (vu-pair (ibeq vi00 points-left collapse-points-done) (add.xyzw parent-sum-pos parent-b-pos parent-a-pos)) ;; #x1ab
              (vu-pair (sq.xyzw color-1 store-vertex 1) (add.xyzw parent-sum-color parent-b-color parent-a-color)) ;; #x1ac
              (label collapse-points-bank0-stage2)
              (vu-pair (lq.xyzw pos-1 own-vertex-1 0) (nop)) ;; #x1ad
              (vu-pair (ilw.z parent-a-vertex point-cursor 3) (subw.w vf00 parent-b-pos collapse-dist)) ;; #x1ae
              (vu-pair (ilwr.w parent-record-1 endpoint-cursor) (subw.w vf00 parent-a-pos collapse-dist)) ;; #x1af
              (vu-pair (ior store-vertex own-vertex-0 vi00) (mini.xy weight-0 weight-0 val)) ;; #x1b0
              (vu-pair (iaddi points-left points-left -0x1) (itof0.xyzw pos-1 pos-1)) ;; #x1b1
              (vu-pair (fsand parent-b-collapsed 0x2) (itof0.xyzw color-0 color-0)) ;; #x1b2
              (vu-pair (fsand parent-a-collapsed 0x2) (mulaw.xyzw ACC cam-trans vf00)) ;; #x1b3
              (vu-pair (ilwr.w parent-b-vertex parent-record-1) (maxx.xy weight-0 weight-0 vf00)) ;; #x1b4
              (vu-pair (lq.xyzw parent-a-pos parent-a-vertex 0) (maddax.xyzw ACC cam-row-x pos-1)) ;; #x1b5
              (vu-pair (iand parent-b-collapsed parent-b-collapsed parent-a-collapsed) (madday.xyzw ACC cam-row-y pos-1)) ;; #x1b6
              (vu-pair (lq.xyzw parent-a-color parent-a-vertex 1) (maddz.xyzw pos-1 cam-row-z pos-1)) ;; #x1b7
              (vu-pair (lq.xyzw parent-b-pos parent-b-vertex 0) (mulax.xyzw ACC parent-sum-pos weight-0)) ;; #x1b8
              (vu-pair (lq.xyzw parent-b-color parent-b-vertex 1) (maddy.xyzw pos-0 pos-0 weight-0)) ;; #x1b9
              (vu-pair (ibne vi00 parent-b-collapsed substitute-parent-bank0-stage2) (mulax.xyzw ACC parent-sum-color weight-0)) ;; #x1ba
              (vu-pair (lq.xyzw color-1 own-vertex-1 1) (maddy.xyzw color-0 color-0 weight-0)) ;; #x1bb
              (vu-pair (ilw.w own-vertex-0 point-cursor 4) (nop)) ;; #x1bc
              (vu-pair (iaddi endpoint-cursor endpoint-cursor 0x1) (mulaw.xy ACC k1 vf00)) ;; #x1bd
              (vu-pair (sq.xyzw pos-0 store-vertex 0) (maddw.xy weight-1 k0 pos-1)) ;; #x1be
              (vu-pair (ibeq vi00 points-left collapse-points-done) (add.xyzw parent-sum-pos parent-b-pos parent-a-pos)) ;; #x1bf
              (vu-pair (sq.xyzw color-0 store-vertex 1) (add.xyzw parent-sum-color parent-b-color parent-a-color)) ;; #x1c0
              (label collapse-points-bank0-stage3)
              (vu-pair (lq.xyzw pos-0 own-vertex-0 0) (nop)) ;; #x1c1
              (vu-pair (ilw.z parent-a-vertex point-cursor 4) (subw.w vf00 parent-b-pos collapse-dist)) ;; #x1c2
              (vu-pair (ilwr.x parent-record-0 endpoint-cursor) (subw.w vf00 parent-a-pos collapse-dist)) ;; #x1c3
              (vu-pair (ior store-vertex own-vertex-1 vi00) (mini.xy weight-1 weight-1 val)) ;; #x1c4
              (vu-pair (iaddi points-left points-left -0x1) (itof0.xyzw pos-0 pos-0)) ;; #x1c5
              (vu-pair (fsand parent-b-collapsed 0x2) (itof0.xyzw color-1 color-1)) ;; #x1c6
              (vu-pair (fsand parent-a-collapsed 0x2) (mulaw.xyzw ACC cam-trans vf00)) ;; #x1c7
              (vu-pair (ilwr.w parent-b-vertex parent-record-0) (maxx.xy weight-1 weight-1 vf00)) ;; #x1c8
              (vu-pair (lq.xyzw parent-a-pos parent-a-vertex 0) (maddax.xyzw ACC cam-row-x pos-0)) ;; #x1c9
              (vu-pair (iand parent-b-collapsed parent-b-collapsed parent-a-collapsed) (madday.xyzw ACC cam-row-y pos-0)) ;; #x1ca
              (vu-pair (lq.xyzw parent-a-color parent-a-vertex 1) (maddz.xyzw pos-0 cam-row-z pos-0)) ;; #x1cb
              (vu-pair (lq.xyzw parent-b-pos parent-b-vertex 0) (mulax.xyzw ACC parent-sum-pos weight-1)) ;; #x1cc
              (vu-pair (lq.xyzw parent-b-color parent-b-vertex 1) (maddy.xyzw pos-1 pos-1 weight-1)) ;; #x1cd
              (vu-pair (ibne vi00 parent-b-collapsed substitute-parent-bank0-stage3) (mulax.xyzw ACC parent-sum-color weight-1)) ;; #x1ce
              (vu-pair (lq.xyzw color-0 own-vertex-0 1) (maddy.xyzw color-1 color-1 weight-1)) ;; #x1cf
              (vu-pair (ilw.w own-vertex-1 point-cursor 5) (nop)) ;; #x1d0
              (vu-pair (iaddi point-cursor point-cursor 0x4) (mulaw.xy ACC k1 vf00)) ;; #x1d1
              (vu-pair (sq.xyzw pos-1 store-vertex 0) (maddw.xy weight-0 k0 pos-0)) ;; #x1d2
              (vu-pair (ibne vi00 points-left collapse-points-bank0-stage0) (add.xyzw parent-sum-pos parent-b-pos parent-a-pos)) ;; #x1d3
              (vu-pair (sq.xyzw color-1 store-vertex 1) (add.xyzw parent-sum-color parent-b-color parent-a-color)) ;; #x1d4
              (label collapse-points-done)
              (vu-pair (jr subroutine-link) (nop)) ;; #x1d5
              (vu-pair (nop) (nop)) ;; #x1d6
              ;; The edge has retired: copy parent B's whole point record over this point's record and do not store the
              ;; blended vertex. Four copies follow, one per pipeline stage, differing only in which record register the
              ;; source comes from and which of the four slots at point-cursor it lands in.
              ;;
              ;; Nothing is left dangling by skipping the vertex store, because a strip never names a vertex directly.
              ;; The draw address book holds point-record addresses, and a record's w lane holds the VU address of its
              ;; vertex, which is how every renderer gets there: ilwr.w vertex, draw-point then lq pos, 0(vertex). So
              ;; overwriting the record redirects the strip at parent B's vertex, and this point's own vertex slot is
              ;; simply never read again - it still holds the packed integers the VIF unpacked into it.
              ;;
              ;; The point therefore draws as a duplicate of parent B: same position, same color, same texture
              ;; coordinate. Its triangles collapse to zero area, which the GS rejects in setup, and the two triangles
              ;; that used to share it, (A P X) and (P B X), become (A B X) plus nothing. Coverage is identical, and so
              ;; is texture: the point's ST is the authored edge midpoint, the VU emits STQ already divided by w, and
              ;; screen-space interpolation of that is exact, so a strip through the split point samples the same
              ;; texels as the unsplit edge. Color is the one attribute that is only nearly identical - the loop above
              ;; had blended it to the average of the two parents', which is the value at the three-dimensional
              ;; midpoint, but the GS interpolates Gouraud color linearly in screen space and the midpoint does not
              ;; project to the screen midpoint. The difference is the foreshortening across one edge at collapse
              ;; distance, which is 30 m out at the nearest.
              ;;
              ;; A degenerate rather than a dropped vertex because the strip's length is not the VU's to choose:
              ;; strip-verts comes out of the exported strip table, is written into the strip's GIF tag as NLOOP, and
              ;; times three gives chunk-end, which is the vertex loop's only exit test. All of that is fixed before the
              ;; first vertex is touched, the loop itself is a branchless four-stage pipeline, and a triangle strip
              ;; cannot lose an interior vertex without being split into two strips with two tags. A zero-area triangle
              ;; costs a GS setup and no fragments, which is cheaper than any of that.

                (vu-pair (sqi.xyzw stq-0 gif-cursor) (nop)) ;; #x3c0
                (vu-pair (sqi.xyzw color-0 gif-cursor) (ftoi4.xyzw pos-0 pos-0)) ;; #x3c1

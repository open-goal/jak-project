                (vu-pair (lqi.xyzw shader-2 shader-cursor) (nop)) ;; #x36a
                (vu-pair (sqi.xyzw adgif-tag gif-cursor) (nop)) ;; #x36b
                (vu-pair (sqi.xyzw shader-0 gif-cursor) (nop)) ;; #x36c
                (vu-pair (sqi.xyzw shader-1 gif-cursor) (nop)) ;; #x36d
                (vu-pair (sqi.xyzw shader-2 gif-cursor) (nop)) ;; #x36e
                (vu-pair (lqi.xyzw shader-0 shader-cursor) (nop)) ;; #x36f
                (vu-pair (lqi.xyzw shader-1 shader-cursor) (nop)) ;; #x370
                (vu-pair (iadd vi01 strip-verts strip-verts) (nop)) ;; #x371
                (vu-pair (iadd vi01 vi01 strip-verts) (nop)) ;; #x372
                (vu-pair (sqi.xyzw shader-0 gif-cursor) (nop)) ;; #x373
                (vu-pair (sqi.xyzw shader-1 gif-cursor) (nop)) ;; #x374
                (vu-pair (ior chunk-start gif-cursor vi00) (nop)) ;; #x375

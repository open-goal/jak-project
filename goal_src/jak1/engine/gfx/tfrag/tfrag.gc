                (vu-pair (sqi.xyzw shader-1 gif-cursor) (nop)) ;; #x3a8
                (vu-pair (lq.xyzw pos-1 vertex 0) (nop)) ;; #x3a9
                (vu-pair (lq.xyzw color-1 vertex 1) (nop)) ;; #x3aa

                (vu-pair (iadd vi01 vi01 strip-verts) (mul.xyz stq-0 stq-0 Q)) ;; #x3ac
                (vu-pair (ilwr.z draw-point draw-cursor) (nop)) ;; #x3ad
                (vu-pair (iadd chunk-end gif-cursor vi01) (subz.xyz stq-1 point-record st-bias)) ;; #x3ae

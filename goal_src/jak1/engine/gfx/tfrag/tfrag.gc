                     (hmge-scale :reg vf08)
                     (point-record :reg vf25)                                ;; ST and vertex address, read as floats
                     (pos-0 :reg vf09)
                     (pos-1 :reg vf10)
                     (pos-2 :reg vf11)
                     (pos-3 :reg vf12)
                     (clip-0 :reg vf13)                                      ;; position scaled for the guard-volume test
                     (clip-1 :reg vf14)
                     (clip-2 :reg vf15)
                     (clip-3 :reg vf16)
                     (color-0 :reg vf17)
                     (color-1 :reg vf18)
                     (color-2 :reg vf19)
                     (color-3 :reg vf20)
                     (stq-0 :reg vf21)
                     (stq-1 :reg vf22)
                     (stq-2 :reg vf23)
                     (stq-3 :reg vf24))
                ;; Renderer for a prepared stream that may reach close to the camera. Same four-deep strip pipeline as the
                ;; one below plus the guard-volume clip test: each position is scaled by hmge-scale into clip-N, clipw
                ;; records which planes it fell outside, and fcand collects the result for the whole triangle. Only VU
                ;; TFRAG-VU-DRAW-LEVEL1-CLIPPED and TFRAG-VU-DRAW-BASE pay for that.

;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/gfx/background/subdivide.gc")
(require "engine/anim/joint.gc")
(require "engine/gfx/background/background-h.gc")
(require "engine/gfx/tfrag/tfrag-near.gc")

;; Terrain fragments are collected into inline arrays under a drawable tree. The background
;; renderer queues those trees, then builds the terrain DMA stream here after visibility has been
;; computed.
;;
;; How the work splits between the EE and VU1
;; ------------------------------------------
;; The EE never touches a vertex. Terrain geometry lives in the level file as ready-made VIF chains,
;; three per patch, and all the EE does is decide which chain to reference and which microprogram
;; entry to call. Per batch of sixteen fragments it:
;;
;;   - DMAs the 64-byte tfragment headers into one of two 1024-byte scratchpad banks while it builds
;;     packets out of the other, so header fetch and packet building overlap;
;;   - culls each fragment's bounding sphere against four planes, then classifies its distance to pick
;;     the base, level-0 or level-1 stream and the matching VU entry;
;;   - expands the fragment's packed uint16 color indices into scratchpad RGBA through
;;     *tfrag-work*.color-ptr and appends them as a CNT packet, because the time-of-day palette
;;     changes every frame while the geometry never does;
;;   - writes REF tags pointing at the level's chains, plus an MSCAL, into one of two 128-quadword
;;     output banks and hands the full one to the VIF DMA while filling the other.
;;
;; VU1 owns everything geometric. It unpacks the chain into one of two 328-quadword input banks
;; (alternating, so the next patch uploads while this one draws), runs the LOD collapse over the
;; detail levels, transforms and projects, applies fog and the guard volume, packs GS vertices into
;; one of two GIF buffers, and kicks. Shared constants sit above both input banks and are uploaded
;; once per frame by add-tfrag-data.
;;
;; The detail hierarchy, because the names run the opposite way to the detail and a reader will
;; otherwise assume "base" is the finest
;; --------------------------------------------------------------------------------------------------
;; A patch's vertices are one nested list: the base vertices, then the level-0 additions, then the
;; level-1 additions. Each addition splits an edge of the mesh below it, so:
;;
;;   base stream      coarsest, drawn when the patch is FARTHEST away
;;   level-0 stream   base + level-0 additions
;;   level-1 stream   base + level-0 + level-1 additions, finest, drawn when CLOSEST
;;
;; The classifier steps DOWN, level 1 to level 0 to base, as the patch recedes, and the VU unwinds one
;; subdivision level at a time, the coarser one first. Unwinding slides each added point onto the
;; midpoint of the edge it splits, so it never merges into another point on the way; it just stops
;; contributing, and the level below it is then an exact description of the same surface. A point's
;; parents are always at a strictly coarser level, so the hierarchy is only ever two deep and nothing
;; is chasing anything.
;;
;; What spans the EE and VU halves is the seam rule: the VU decides how far a point has been unwound
;; from that point's own depth and per-frame globals only, and the EE only drops a subdivision level
;; once the WHOLE bounding sphere is past the distance where that level has finished unwinding. Those
;; two together mean a patch never abandons detail that a neighbour is still displaying. See
;; classify-fragment-lod below for the part of the argument that lives on this side.

;; VU1 data-memory map. Quadword addresses; the two input banks alternate under VIF TOP, so a
;; bank-relative address is used directly as an offset from the TOP register.
(defconstant TFRAG-VU-BANK-0 0)
(defconstant TFRAG-VU-BANK-1 328)
(defconstant TFRAG-VU-CONTROL 0)        ;; tfrag-control, five quadwords, bank relative
(defconstant TFRAG-VU-CAMERA 5)         ;; camera transform, four rows, bank relative

;; The fourteen shared quadwords of tfrag-data, uploaded once per frame at TFRAG-VU-CONSTANTS.
(defconstant TFRAG-VU-CONSTANTS 656)
(defconstant TFRAG-VU-FOG 656)
(defconstant TFRAG-VU-VAL 657)          ;; (0.5, 1.0, 2048.0, 0.0)
(defconstant TFRAG-VU-STRGIF 658)
(defconstant TFRAG-VU-FANGIF 659)
(defconstant TFRAG-VU-ADGIF 660)
(defconstant TFRAG-VU-HVDF-OFFSET 661)
(defconstant TFRAG-VU-HMGE-SCALE 662)
(defconstant TFRAG-VU-INVH-SCALE 663)
(defconstant TFRAG-VU-AMBIENT 664)
(defconstant TFRAG-VU-GUARD 665)
;; tfrag-dists: slope pair then intercept pair, level 0 then level 1. The w lane of each slope
;; entry is that level's collapse distance.
(defconstant TFRAG-VU-K0-LEVEL0 666)
(defconstant TFRAG-VU-K0-LEVEL1 667)
(defconstant TFRAG-VU-K1-LEVEL0 668)
(defconstant TFRAG-VU-K1-LEVEL1 669)

;; Two GIF output buffers. One is written while the other is being read out by xgkick.
(defconstant TFRAG-VU-GIF-BUF-0 672)
(defconstant TFRAG-VU-GIF-BUF-1 848)

;; Scratchpad bank alternation. Each mask is whatever bits the two bank offsets disagree on, which for
;; the packet banks is not the bank size: they are 2048 bytes long but sit at 2048 and 4096, so the
;; mask is #x1800. As a literal that looks like a typo, so derive it.
(defconstant TFRAG-INPUT-BANK-FLIP (logxor (offset-of tfrag-dma banka) (offset-of tfrag-dma bankb)))
(defconstant TFRAG-PACKET-BANK-FLIP (logxor (offset-of tfrag-dma outa) (offset-of tfrag-dma outb)))

;; Microprogram entry points, as the EE spells them in its MSCAL immediates. These seven are the ones
;; the EE actually selects; the other seven even addresses either terminate at once or duplicate
;; TFRAG-VU-DRAW-BASE, and nothing reaches them. The names are reconstructed - the original source's
;; names for them are not recovered.
(defconstant TFRAG-VU-INIT 0)                   ;; set up both GIF buffers, once per frame
(defconstant TFRAG-VU-DRAW-BASE 6)              ;; the coarsest mesh; no simplification to do
(defconstant TFRAG-VU-DRAW-LEVEL0 10)           ;; level 0, whole patch inside its distance band
(defconstant TFRAG-VU-DRAW-LEVEL0-CROSSING 8)   ;; level 0, patch straddles the far end of that band
(defconstant TFRAG-VU-DRAW-LEVEL1 16)           ;; level 1, whole patch inside its distance band
(defconstant TFRAG-VU-DRAW-LEVEL1-CROSSING 14)  ;; level 1, patch straddles the far end of that band
(defconstant TFRAG-VU-DRAW-LEVEL1-CLIPPED 18)   ;; level 1, near enough to need the guard-volume clip

;;;;;;;;;;;;;;;;;;;;;;;;
;; basic methods
;;;;;;;;;;;;;;;;;;;;;;;;

(defmethod login ((this tfragment))
  "Log in every inline adgif shader used by this terrain fragment."
  (dotimes (i (the-as int (-> this num-shaders)))
    (adgif-shader-login-no-remap (-> this shader i)))
  this)

;; definition for method 8 of type tfragment
(defmethod mem-usage ((this tfragment) (usage memory-usage-block) (flags int))
  "Account for the fragment header, overlapping base/common/LOD DMA streams, colors, and debug
   data. With the color-only flag, record only the packed per-LOD colors; the separate-prototype-data
   flag excludes those colors from the ordinary total."
  ;; The color-only pass keeps its packed-color total in category 19.
  (when (logtest? flags 2)
    (+! (-> usage data 19 count) 1)
    (let ((color-bytes (+ (-> this num-base-colors) (-> this num-level0-colors) (-> this num-level1-colors))))
      (+! (-> usage data 19 used) color-bytes)
      (+! (-> usage data 19 total) (logand -4 (+ color-bytes 3))))
    (set! this this)
    (goto cfg-16))
  (let ((category 1))
    (set! (-> usage length) (max (-> usage length) (+ category 8)))
    (set! (-> usage data category name) (symbol->string 'tfragment))
    (+! (-> usage data category count) 1)
    ;; The tfragment header itself.
    (let ((header-bytes (asize-of this)))
      (+! (-> usage data category used) header-bytes)
      (+! (-> usage data category total) (logand -16 (+ header-bytes 15))))
    ;; The base DMA stream.
    (set! (-> usage data (+ category 1) name) "tfragment-base")
    (+! (-> usage data (+ category 1) count) 1)
    (let ((base-bytes (* (-> this dma-qwc 0) 16)))
      (+! (-> usage data (+ category 1) used) base-bytes)
      (+! (-> usage data (+ category 1) total) base-bytes))
    ;; The portion shared by the detail streams.
    (set! (-> usage data (+ category 2) name) "tfragment-common")
    (+! (-> usage data (+ category 2) count) 1)
    (let ((common-bytes (* (- (-> this dma-qwc 1) (-> this dma-qwc 0)) 16)))
      (+! (-> usage data (+ category 2) used) common-bytes)
      (+! (-> usage data (+ category 2) total) common-bytes))
    ;; The first detail stream.
    (set! (-> usage data (+ category 3) name) "tfragment-level0")
    (when (nonzero? (-> this num-level0-colors))
      (+! (-> usage data (+ category 3) count) 1)
      (let ((level-0-bytes (* (- (-> this dma-qwc 2) (-> this dma-qwc 0)) 16)))
        (+! (-> usage data (+ category 3) used) level-0-bytes)
        (+! (-> usage data (+ category 3) total) level-0-bytes)))
    ;; The DMA chains can overlap, so the level-1 contribution is not simply dma-qwc[3] * 16.
    (set! (-> usage data (+ category 4) name) "tfragment-level1")
    (when (not (or (= (-> this dma-level-1) (-> this dma-common))
                   (= (-> this dma-level-1) (-> this dma-base))
                   (zero? (-> this num-level1-colors))))
      (+! (-> usage data (+ category 4) count) 1)
      (let ((level-1-bytes (* (- (-> this dma-qwc 3)
                                 (the-as uint (- (/ (the-as int (- (-> this dma-level-1) (-> this dma-common))) 16) (the-as int (-> this dma-qwc 0)))))
                              16)))
        (+! (-> usage data (+ category 4) used) level-1-bytes)
        (+! (-> usage data (+ category 4) total) level-1-bytes)))
    ;; Packed time-of-day colors.
    (set! (-> usage data (+ category 5) name) "tfragment-color")
    (+! (-> usage data (+ category 5) count) 1)
    (let ((packed-color-bytes (if (logtest? flags 1)
                                0
                                (the-as int (* (+ (-> this num-base-colors) (-> this num-level0-colors) (-> this num-level1-colors)) 2)))))
      (+! (-> usage data (+ category 5) used) packed-color-bytes)
      (+! (-> usage data (+ category 5) total) (logand -16 (+ packed-color-bytes 15))))
    (set! (-> usage data (+ category 6) name) "tfragment-debug"))
  (label cfg-16)
  this)

;;;;;;;;;;;;;;;;;;;;;;;
;; tree/array methods
;;;;;;;;;;;;;;;;;;;;;;;

(defmethod inspect ((this drawable-inline-array-tfrag))
  (format #t "[~8x] ~A~%" this (-> this type))
  (format #t "~Tlength: ~D~%" (-> this length))
  (format #t "~Tdata[~D]: @ #x~X~%" (-> this length) (-> this data))
  (dotimes (i (-> this length))
    (format #t "~T  [~D] ~A~%" i (-> this data i)))
  this)

;; definition for method 9 of type drawable-inline-array-tfrag
(defmethod login ((this drawable-inline-array-tfrag))
  "Log in every inline terrain fragment."
  (dotimes (i (-> this length))
    (login (-> this data i)))
  this)

;; definition for method 8 of type drawable-inline-array-tfrag
(defmethod mem-usage ((this drawable-inline-array-tfrag) (usage memory-usage-block) (flags int))
  "Account for the inline-array header and delegate to every terrain fragment."
  (set! (-> usage length) (max 1 (-> usage length)))
  (set! (-> usage data 0 name) (symbol->string 'drawable-group))
  (+! (-> usage data 0 count) 1)
  (let ((header-bytes 32))
    (+! (-> usage data 0 used) header-bytes)
    (+! (-> usage data 0 total) (logand -16 (+ header-bytes 15))))
  (dotimes (i (-> this length))
    (mem-usage (-> this data i) usage flags))
  this)

;; definition for method 8 of type drawable-tree-tfrag
(defmethod mem-usage ((this drawable-tree-tfrag) (usage memory-usage-block) (flags int))
  "Account for the tree header, optional time-of-day palette, and every inline fragment array."
  (set! (-> usage length) (max 1 (-> usage length)))
  (set! (-> usage data 0 name) "drawable-group")
  (+! (-> usage data 0 count) 1)
  (let ((header-bytes (asize-of this)))
    (+! (-> usage data 0 used) header-bytes)
    (+! (-> usage data 0 total) (logand -16 (+ header-bytes 15))))
  (when (nonzero? (-> this time-of-day-pal))
    (set! (-> usage length) (max 9 (-> usage length)))
    (set! (-> usage data 8 name) "tfragment-pal")
    (+! (-> usage data 8 count) 1)
    (let ((palette-bytes (asize-of (-> this time-of-day-pal))))
      (+! (-> usage data 8 used) palette-bytes)
      (+! (-> usage data 8 total) (logand -16 (+ palette-bytes 15)))))
  (dotimes (i (-> this length))
    (mem-usage (-> this arrays i) usage flags))
  this)

;; definition for method 5 of type drawable-inline-array-tfrag
;; INFO: Return type mismatch uint vs int.
(defmethod asize-of ((this drawable-inline-array-tfrag))
  "Return the nominal inline-array size, which includes its first terrain fragment, plus 64
   bytes for each additional active fragment."
  (the-as int (+ (-> drawable-inline-array-tfrag size) (* (+ (-> this length) -1) 64))))

;;;;;;;;;;;;;;;;;;;;;;
;; tfrag renderer
;;;;;;;;;;;;;;;;;;;;;;

(define *tfrag-display-stats* #f)

(#when PC_PORT
  (define tfrag-vu1-block (new 'static 'vu-function :length #x0 :qlength #x0)))

;; ==================================================================================================
;; The terrain microprogram, end to end
;; ==================================================================================================
;;
;; --------------------------------------------------------------------------------------------------
;; 1. What a tfragment is
;; --------------------------------------------------------------------------------------------------
;; A patch of terrain: one surface, a few dozen to a few hundred vertices, culled and drawn as a unit.
;; What makes it more than a mesh is that it carries three nested descriptions of that same surface and
;; can simplify itself twice as it recedes.
;;
;;   base      the coarsest description, drawn when the patch is FARTHEST away
;;   level 0   base plus a set of extra vertices, each splitting one edge of the base mesh
;;   level 1   level 0 plus another such set, each splitting one edge of the level-0 mesh
;;
;; The vertices are one nested array in that order, so choosing a description is choosing how many of
;; them to upload. Nothing is duplicated between the three and there is no separate low-detail mesh.
;; The names run opposite to the detail: base is the simplest, level 1 the finest.
;;
;; --------------------------------------------------------------------------------------------------
;; 2. How a patch simplifies itself
;; --------------------------------------------------------------------------------------------------
;; Each added vertex splits an edge, so the way to remove it without a visible jump is to slide it onto
;; the midpoint of that edge first. Once it is there the two triangles that share it tile exactly the
;; one triangle the coarser mesh has, and it can stop being uploaded with nothing changing on screen.
;; That slide is what the VU program spends most of its preparation time doing, driven per vertex by
;; that vertex's own distance from the camera:
;;
;;   position = own * weight.y + (endpoint1 + endpoint2) * weight.x
;;
;; with weight.y falling 1 -> 0 and weight.x rising 0 -> 0.5 across the level's distance band, so the
;; far end of the slide is exactly the midpoint of the two endpoints. Color blends the same way, and
;; the texture coordinate needs no blend because the exporter already stores the edge midpoint.
;;
;; EDGE RETIREMENT is the second half of it, and the term is worth pinning down because everything
;; below refers to it. A vertex is authored displaced from the midpoint - that displacement is the
;; detail it exists to add - so its own distance is the midpoint's distance plus whatever the
;; displacement contributes. That means a vertex can still be short of the end of its band while the
;; edge it splits is entirely past it, and the slide alone would leave a residual bump on an edge that
;; is supposed to be flat by now. So the program also asks a question about the EDGE rather than the
;; vertex: are BOTH of its endpoints past the distance where this level finishes simplifying? When they
;; are, the edge has RETIRED, and the vertex is forced the rest of the way rather than interpolated
;; there - its point record is overwritten with the record of one endpoint, so it draws as a duplicate
;; of that endpoint and its triangles go to zero area. Same resulting surface, reached in one step.
;;
;; The reason for asking about the endpoints instead of the vertex is that the endpoints are shared with
;; the neighbouring patch and are not displaced, so both patches reach the same answer at the same
;; camera distance. That is the whole seam argument; classify-fragment-lod carries the rest of it.
;;
;; --------------------------------------------------------------------------------------------------
;; 3. The data layout
;; --------------------------------------------------------------------------------------------------
;; Six kinds of thing, all uploaded into one VU input bank, all located by tfrag-control at its front:
;;
;;   vertices          position and color, and nothing else            ptr-vtxdata
;;   point records     texture coordinate, plus which vertex to use     ptr-base/level0/level1-points
;;   endpoint tables   the second endpoint of each split edge           ptr-interpolated-0/1
;;   the index list    which point records to draw, in order            ptr-draw-points
;;   strip data        where to break that order into strips            ptr-strip-data
;;   shader data       adgif shaders, five quadwords each               ptr-texture-data
;;
;; Everything is packed small in the level file and expanded by the VIF on the way in, so a size means
;; one thing on the EE side and another in VU memory. The expansions are:
;;
;;   holder                packed in the level file        in VU memory after the unpack
;;   -------------------   -----------------------------   ------------------------------------------
;;   vertex position       12 bytes, unpack v3-32          one quadword, w set to 0x80 by the unpack
;;   vertex color          4 bytes, unpack v4-8            one quadword, one channel per lane
;;   point record          8 bytes, unpack v4-16 unsigned  one quadword, one field per lane
;;   endpoint table entry  1 byte, unpack v4-8 unsigned    one 32-bit lane
;;   draw list entry       1 byte, unpack v4-8 unsigned    one 32-bit lane
;;   strip data entry      4 bytes, unpack v4-8 signed     one quadword, one field per lane
;;
;; The one-byte entries are the reason additive ROW mode is worth setting up: a byte plus a ROW holding
;; an array base comes out of the VIF as an absolute VU address, so an index costs one byte in the file
;; and needs no arithmetic once it lands.
;;
;; A VERTEX is two quadwords in VU memory: position, then color. It does NOT hold a texture coordinate.
;; The position arrives as integers and is converted and transformed in place; the color is unpacked
;; separately by the EE each frame because it follows the time of day.
;;
;; A POINT RECORD is one quadword and is the only thing that names a vertex. Base records and detail
;; records - detail meaning the level-0 and level-1 records - have the same layout, because one VIF
;; command with one ROW unpacks a level's records together:
;;
;;   lane   base record                          detail record (level 0 and level 1)
;;   ----   ----------------------------------   ------------------------------------------------
;;   x, y   texture coordinate + 2048.0          texture coordinate + 2048.0
;;   z      unused; its ROW term is zero          VU address of one endpoint's VERTEX
;;   w      VU address of this point's vertex     VU address of this point's own vertex
;;
;; MAIN AND SHARED RECORDS. Each point has exactly one MAIN record. That is the record carrying the
;; endpoint information, and it is the one the blend loop walks. Any further use of the same point - a
;; wrap seam, a shader change - gets a SHARED record instead: same vertex address, a different texture
;; coordinate, no endpoint data of its own, and crucially not walked by the blend loop. A second main
;; record would blend the same vertex twice; that is why the shared records are a separate array with a
;; separate count. "Main" is descriptive; the control block names only the shared ones.
;;
;; The consequence is retirement. Retiring a point rewrites a record, and every record naming that point
;; has to be rewritten or it will still point at a vertex the blend loop never stored. The blend pass
;; only sees main records, so the shared arrays get their own retirement pass - and their own endpoint
;; tables, so it can run the same both-endpoints test.
;;
;; Each level's shared array ABUTS its main array exactly: ptr-shared-level0-points is
;; ptr-level0-points + num-level0-points, and likewise for base and level 1. Contiguous and disjoint,
;; which is what lets one VIF command unpack both.
;;
;; An ENDPOINT TABLE holds the OTHER endpoint of each split edge - the one the record's z lane does not
;; name. There is one per level, because each level's points split the edges of a different mesh:
;; ptr-interpolated-0 for level 0 and ptr-interpolated1 for level 1, plus ptr-shared-interpolated-0 and
;; ptr-shared-interpolated1 for the shared arrays. Entries run four per quadword in four 32-bit lanes,
;; read with ilwr.x/.y/.z/.w, in the same order as the point list they parallel. Each lane is a VU
;; memory address of a point RECORD, not of a vertex and not an index:
;;
;;   * an address, because that endpoint may be any kind of point - base, level 0, level 1, or one of
;;     the shared records - so there is no single array to index into;
;;   * a record rather than a vertex, because this is also the record a retiring point is overwritten
;;     WITH, and that has to carry the texture coordinate too.
;;
;; So the two endpoints of an edge are named differently on purpose: one as a vertex, in the spare z
;; lane, because only its position and color are ever wanted; the other as a record, in the table,
;; because it doubles as the replacement.
;;
;; Three holders that are easy to confuse, and do not overlap at all:
;;
;;   holder                  contains                              read by
;;   ---------------------   -----------------------------------   ---------------------------------
;;   record z lane           one endpoint's VERTEX address          the blend loops only
;;   endpoint table entry    the other endpoint's RECORD address    the blend loops, and the retirement
;;                                                                  substitution
;;   ptr-draw-points         RECORD addresses to be drawn, in       the gather only
;;                           strip order - neither endpoint
;;
;; ptr-draw-points is the index list, and what it indexes is point records - main and shared alike, in
;; whatever order the strips need them. It has to hold both kinds, since a shared record exists precisely
;; to be drawn with its own texture coordinate. Getting from an entry to a position is two hops:
;; ilwr.x draw-point, draw-cursor takes one of four record addresses out of a quadword, then
;; ilwr.w vertex, draw-point reads that record's vertex address and lq.xy point-record, 0(draw-point)
;; reads its texture coordinate. It carries no endpoint information at all and duplicates nothing in the
;; endpoint tables.
;;
;; STRIP DATA is one quadword per entry and drives the packet structure: .x is the next strip's vertex
;; count, zero meaning the fragment is finished; .y negative means kick the buffer and keep the current
;; shader, non-negative means load a new one first; .z is a shader index relative to ptr-texture-data.
;;
;; --------------------------------------------------------------------------------------------------
;; 4. The VU program
;; --------------------------------------------------------------------------------------------------
;; Buffering first, because every loop below exists in two copies because of it.
;;
;;   input banks       two, double-buffered by the VIF. Every entry begins with xtop, and every pass and
;;                     renderer has a duplicated bank-1 copy of itself selected by ibne against
;;                     input-bank, because the load and store immediates differ by TFRAG-VU-BANK-1.
;;                     Handover is the VIF's, at the MSCAL.
;;   vertex array      double-buffered for free: ptr-vtxdata is bank-relative, so the transformed
;;                     vertices live in the input bank and ARE the uploaded data, rewritten in place.
;;                     No second allocation and nothing copied to get there.
;;   GIF output        two buffers, addresses in the x and y lanes of gif-buffers, swapped by mr32 at
;;                     every kick. Two is enough because the gather writes through one sequential
;;                     cursor, so only one buffer is ever being filled.
;;
;; The passes, in the order they run. The fullest case is TFRAG-VU-DRAW-LEVEL1-CROSSING:
;;
;;  1. transform-base-points. Walks a PREFIX of ptr-vtxdata straight through with lqi/sqi - not through
;;     the records - converting the packed integers to float, transforming the position by the camera
;;     rows and converting the color, storing both back in place. The store cursor trails the load
;;     cursor by six quadwords because four vertices are in flight. The prefix is num-base-points here;
;;     transform-base-and-level0-points is the same loop counted by num-base-points + num-level0-points,
;;     and it is what the LEVEL1 entries use instead.
;;
;;     There is no pass that transforms every vertex. Whatever the prefix does not cover is transformed
;;     by the blend loop that owns it, which is why a straight-through walk can coexist with vertices
;;     that end up never transformed at all - see pass 3.
;;  2. morph-level0-points. Walks ptr-level0-points; for each record, loads the vertex it names,
;;     transforms it, slides it toward the midpoint of its two endpoints by that vertex's own distance,
;;     and stores it back in place. So this loop is where a level-0 vertex gets transformed, not pass 1.
;;     Counted by num-level0-points, which excludes the shared points - that is what stops a shared
;;     vertex being blended twice.
;;  3. collapse-level1-points. As above over ptr-level1-points, plus the edge-retirement test and the
;;     record substitution when an edge has retired. The retirement branch saves nothing: both paths are
;;     five pairs long and issue three memory operations, and the branch trades two stores to the vertex
;;     for one load and one store to the record. The transform and slide are already issued when it is
;;     reached. So a retired point's vertex is left holding the integers the VIF unpacked - not because
;;     anything skipped its transform, but because the store that would have written the result was
;;     replaced by the store that redirects its record - and nothing reads it afterwards, because that
;;     record now names the endpoint's vertex. See collapse-level1-points for the slot budget that makes
;;     it either/or.
;;
;;     Both levels can retire, and the labels overstate how much code there is: morph-level0-points and
;;     morph-level1-points are two preambles onto one shared loop body, and collapse-level0-points and
;;     collapse-level1-points are two more onto another. A preamble loads its level's count, point
;;     cursor, endpoint table, coefficient pair and collapse distance, and that is all that differs.
;;     Four blend behaviours, two loop bodies, and a bank-1 copy of each body for the second VIF buffer.
;;  4. collapse-shared-level1-points. The retirement test again, over ptr-shared-level1-points, and
;;     nothing else - no blend and no vertex store. It is not optional and not cosmetic: a shared record
;;     inherits the slide for free, because the slide writes the vertex and the duplicate reads it, but
;;     it cannot inherit the substitution, because that rewrites a record and the duplicate has its own.
;;     A retiring vertex is deliberately left unwritten - it still holds the integers the VIF unpacked -
;;     so a duplicate still naming it would gather raw integers reinterpreted as floats. Redirecting the
;;     duplicates too is what prevents that.
;;  5. One of the four renderers: the gather.
;;
;; The gather, per vertex:
;;
;;     ilwr.w vertex, draw-point       one of four record addresses from a ptr-draw-points quadword
;;     lq.xy  point-record, 0(draw-point)   texture coordinate, out of the RECORD
;;     lq     pos, 0(vertex)           position, out of the VERTEX that record names
;;     lq     color, 1(vertex)         color, likewise
;;     div    Q, fog.x, pos.w          perspective divide
;;     ... xyz and st scaled by Q, hvdf-offset added, w clamped between fog.y and fog.z for the fog
;;         byte, ftoi4 for position, ftoi0 for color, val.z subtracted to unbias the texture coordinate
;;     sqi    stq / color / pos, gif-cursor      three quadwords, sequential, in that order
;;
;; Four vertices are in flight. The loop's only exit test is the write cursor reaching chunk-end, which
;; was computed as gif-cursor + 3 * strip-verts before the first vertex was touched, so a strip's length
;; comes from ptr-strip-data and is not decided as it goes.
;;
;; Tags are built, not templated. The A+D tag and the strip tag are two of the per-frame constants, and
;; the closer sqi's them into the buffer at the cursor as it goes, followed by shader quadwords out of
;; ptr-texture-data when the shader changes. Two fields are patched afterwards: NLOOP, immediately after
;; each strip tag is written, from the ptr-strip-data count; and EOP, at kick time, by reading the last
;; strip tag's first word back out of the buffer, ORing gif-eop and storing it again.
;;
;; A strip is a GIF tag at the current cursor followed by 3 * NLOOP quadwords, and there is no degenerate
;; stitching between strips - each one is simply a new tag. close-strip, and close-base-strip which is
;; the base renderer's own copy, is the subroutine every gather loop calls when its cursor reaches
;; chunk-end. It closes the strip just finished, reads the next ptr-strip-data entry, and either starts
;; another strip in the same buffer, or kicks and starts one in the other, or flushes and ends the
;; program. Renderers reach it through a return address loaded into subroutine-link by hand rather than
;; by bal, so each can resume in the middle of its four-deep pipeline.
;;
;; XGKICK: one per buffer, issued in the closer, never in the gather loop. There is no wait and no poll
;; anywhere in the program - the only thing preventing a buffer being refilled while the GIF is still
;; reading it is that filling the other one and reaching the next kick takes longer than the transfer,
;; together with XGKICK's own serialisation. That is an inference from the absence of a wait, not
;; something the instruction stream states.
;;
;; Which program runs when. The EE picks one entry per patch from the patch's bounding sphere; see
;; classify-fragment-lod for how it decides.
;;
;;   entry point                      addr   passes        renderer
;;   ------------------------------   ----   -----------   ------------------------------------------
;;   TFRAG-VU-INIT                      0   -             sets up both GIF buffers, once per frame
;;   TFRAG-VU-DRAW-BASE                 6   none          transforms in its own pipeline, guard-clipped
;;   TFRAG-VU-DRAW-LEVEL0              10   1, 2          prepared, unclipped
;;   TFRAG-VU-DRAW-LEVEL0-CROSSING      8   1, 2+retire   prepared, unclipped
;;                                            + shared level 0
;;   TFRAG-VU-DRAW-LEVEL1              16   1+2 fused,    prepared, unclipped
;;                                            level-1 slide
;;   TFRAG-VU-DRAW-LEVEL1-CROSSING     14   1, 2, 3, 4    prepared, unclipped
;;   TFRAG-VU-DRAW-LEVEL1-CLIPPED      18   as LEVEL1     prepared, guard-clipped
;;
;; Addresses 2, 22 and 24 terminate immediately; 4 is a renderer with no preparation and no clip; 12 and
;; 20 duplicate TFRAG-VU-DRAW-BASE. The EE selects none of them.
;;
;; The -CROSSING entries are the only ones carrying the retirement test and the shared pass, and that
;; pairing is not an optimisation detail. The others are selected exactly when the whole bounding sphere
;; is inside the band, so no endpoint can have retired, the test provably cannot fire, and no shared
;; record can be left naming an abandoned vertex. Note also that every substituting pass is paired with
;; a NON-substituting pass for each coarser level, which is what guarantees an endpoint's vertex has
;; always been written before anything is redirected at it.
;;
;; --------------------------------------------------------------------------------------------------
;; Closing note: this renderer gathers, and TIE scatters
;; --------------------------------------------------------------------------------------------------
;; Worth stating once, because it explains why the two files look so different. In TIE a vertex carries
;; its own GIF destination offset in its data and the transform loop writes it straight into the one slot
;; it owns - scattered, no intermediate, no indirection. Here the transform passes write into the vertex
;; array and a separate pass walks ptr-draw-points to collect from it. Three consequences:
;;
;;   * a strip can be redirected by rewriting a point record, because records are what the gather
;;     follows. TIE has nothing between its vertices and its packet, so it cannot;
;;   * a vertex needed twice with two texture coordinates costs one more record here, and a second
;;     transformed copy in TIE;
;;   * two GIF buffers suffice here, where TIE rotates three, because only one is ever being filled.
;;
;; See tie.gc for that side; this comment does not repeat it.
;;
;; --------------------------------------------------------------------------------------------------
;; Whose words these are
;; --------------------------------------------------------------------------------------------------
;; tfrag-control supplies the vocabulary for everything structural. From it: points, and base, level-0
;; and level-1 as their groups; shared; interpolated, which is what the game calls a point that splits
;; an edge and hence the table naming its second endpoint; vtxdata, draw-points, strip-data,
;; texture-data.
;;
;; Endpoint, midpoint, retire, collapse and duplicate are descriptive terms adopted while reading the
;; instruction stream, as are the entry-point constant names above. Nothing in the data distinguishes
;; the two endpoints of an edge by name, so "parent A" and "parent B" in the register aliases below are
;; only a way of telling the z lane from the endpoint-table entry.
;;
;; --------------------------------------------------------------------------------------------------
;; Register conventions
;; --------------------------------------------------------------------------------------------------
;; gif-cursor is the GIF write cursor and chunk-end the address it stops at; draw-cursor walks
;; ptr-draw-points and draw-point holds the record it currently names, vertex the vertex that record
;; names; strip-cursor walks ptr-strip-data, shader-cursor the shader being copied, strip-verts the
;; current strip's length. Those hold across the whole rendering half and are aliased there. In the
;; preparation passes point-cursor walks a level's point records and endpoint-cursor its endpoint table.
;; Inside a renderer the vector registers change role every few instructions, so each renderer gets its
;; own nested rlet and only the values that live for its whole body are named.
(#unless PC_PORT
  (defvu1 tfrag-vu1-block
          (rlet ((input-bank :reg vi14)                                  ;; VIF TOP: 0 or TFRAG-VU-BANK-1
                 (subroutine-link :reg vi15)                             ;; bal link, or a resume address loaded by hand
                 (fog :reg vf01))                                        ;; TFRAG-VU-FOG; never holds anything else
            ;; Even entry addresses. Two things vary: how much preparation the incoming stream needs before a
            ;; renderer can look at it, and whether that renderer has to guard-clip. Entries 4, 6, 12 and 20 have no
            ;; preparation at all, so their renderer converts and transforms positions itself; the rest hand their
            ;; renderer positions a preparation pass has already transformed and collapsed. TFRAG-VU-DRAW-BASE is the base
            ;; mesh, the coarsest one. Entries 2, 22 and 24 return immediately.
            (vu-pair (b initialize-gif-buffers) (nop)) ;; #x000
            (vu-pair (nop) (nop)) ;; #x001
            (vu-pair (b finish-vu-entry) (nop)) ;; #x002
            (vu-pair (xtop input-bank) (nop)) ;; #x003
            (vu-pair (b render-raw-stream) (nop)) ;; #x004
            (vu-pair (xtop input-bank) (nop)) ;; #x005
            (vu-pair (b render-base-stream) (nop)) ;; #x006
            (vu-pair (xtop input-bank) (nop)) ;; #x007
            (vu-pair (b morph-level0-crossing) (nop)) ;; #x008
            (vu-pair (xtop input-bank) (nop)) ;; #x009
            (vu-pair (b morph-level0) (nop)) ;; #x00a
            (vu-pair (xtop input-bank) (nop)) ;; #x00b
            (vu-pair (b render-base-stream-alt) (nop)) ;; #x00c
            (vu-pair (xtop input-bank) (nop)) ;; #x00d
            (vu-pair (b morph-level1-crossing) (nop)) ;; #x00e
            (vu-pair (xtop input-bank) (nop)) ;; #x00f
            (vu-pair (b morph-level1) (nop)) ;; #x010
            (vu-pair (xtop input-bank) (nop)) ;; #x011
            (vu-pair (b morph-level1-near) (nop)) ;; #x012
            (vu-pair (xtop input-bank) (nop)) ;; #x013
            (vu-pair (b render-base-stream-alt-2) (nop)) ;; #x014
            (vu-pair (xtop input-bank) (nop)) ;; #x015
            (vu-pair (b finish-vu-entry) (nop)) ;; #x016
            (vu-pair (xtop input-bank) (nop)) ;; #x017
            (vu-pair (b finish-vu-entry) (nop)) ;; #x018
            (vu-pair (xtop input-bank) (nop)) ;; #x019
            (label render-raw-stream)
            (vu-pair (b render-raw-bank0) (nop)) ;; #x01a
            (vu-pair (nop) (nop)) ;; #x01b
            (label render-base-stream)
            (vu-pair (b render-raw-clipped-bank0) (nop)) ;; #x01c
            (vu-pair (nop) (nop)) ;; #x01d
            (label morph-level0-crossing)
            (vu-pair (bal subroutine-link transform-base-points) (nop)) ;; #x01e
            (vu-pair (nop) (nop)) ;; #x01f
            (vu-pair (bal subroutine-link collapse-level0-points) (nop)) ;; #x020
            (vu-pair (nop) (nop)) ;; #x021
            (vu-pair (bal subroutine-link collapse-shared-level0-points) (nop)) ;; #x022
            (vu-pair (nop) (nop)) ;; #x023
            (vu-pair (b render-morphed-bank0) (nop)) ;; #x024
            (vu-pair (nop) (nop)) ;; #x025
            (label morph-level0)
            (vu-pair (bal subroutine-link transform-base-points) (nop)) ;; #x026
            (vu-pair (nop) (nop)) ;; #x027
            (vu-pair (bal subroutine-link morph-level0-points) (nop)) ;; #x028
            (vu-pair (nop) (nop)) ;; #x029
            (vu-pair (b render-morphed-bank0) (nop)) ;; #x02a
            (vu-pair (nop) (nop)) ;; #x02b
            (label render-base-stream-alt)
            (vu-pair (b render-raw-clipped-bank0) (nop)) ;; #x02c
            (vu-pair (nop) (nop)) ;; #x02d
            (label morph-level1-crossing)
            (vu-pair (bal subroutine-link transform-base-points) (nop)) ;; #x02e
            (vu-pair (nop) (nop)) ;; #x02f
            (vu-pair (bal subroutine-link morph-level0-points) (nop)) ;; #x030
            (vu-pair (nop) (nop)) ;; #x031
            (vu-pair (bal subroutine-link collapse-level1-points) (nop)) ;; #x032
            (vu-pair (nop) (nop)) ;; #x033
            (vu-pair (bal subroutine-link collapse-shared-level1-points) (nop)) ;; #x034
            (vu-pair (nop) (nop)) ;; #x035
            (vu-pair (b render-morphed-bank0) (nop)) ;; #x036
            (vu-pair (nop) (nop)) ;; #x037
            (label morph-level1)
            (vu-pair (bal subroutine-link transform-base-and-level0-points) (nop)) ;; #x038
            (vu-pair (nop) (nop)) ;; #x039
            (vu-pair (bal subroutine-link morph-level1-points) (nop)) ;; #x03a
            (vu-pair (nop) (nop)) ;; #x03b
            (vu-pair (b render-morphed-bank0) (nop)) ;; #x03c
            (vu-pair (nop) (nop)) ;; #x03d
            (label morph-level1-near)
            (vu-pair (bal subroutine-link transform-base-and-level0-points) (nop)) ;; #x03e
            (vu-pair (nop) (nop)) ;; #x03f
            (vu-pair (bal subroutine-link morph-level1-points) (nop)) ;; #x040
            (vu-pair (nop) (nop)) ;; #x041
            (vu-pair (b render-morphed-clipped-bank0) (nop)) ;; #x042
            (vu-pair (nop) (nop)) ;; #x043
            (label render-base-stream-alt-2)
            (vu-pair (b render-raw-clipped-bank0) (nop)) ;; #x044
            (vu-pair (nop) (nop)) ;; #x045
            (label finish-vu-entry)
            (vu-pair (lq.xyzw vf04 vi00 TFRAG-VU-AMBIENT) (nop :e)) ;; #x046
            (vu-pair (nop) (nop))) ;; #x047
          ;; vi14 and vi01 are GIF buffer addresses in this block rather than the input bank and a
          ;; scratch count, so it keeps physical register names.
          ;; Initialize both GIF buffers with their fixed header locations and leave the first one active.
          (label initialize-gif-buffers)
          (vu-pair (iaddiu vi14 vi00 TFRAG-VU-GIF-BUF-0) (nop)) ;; #x048
          (vu-pair (iaddiu vi01 vi00 TFRAG-VU-GIF-BUF-1) (nop)) ;; #x049
          (vu-pair (mfir.x vf03 vi14) (nop)) ;; #x04a
          (vu-pair (mfir.y vf03 vi01) (nop)) ;; #x04b
          (vu-pair (mfir.z vf03 vi14) (nop)) ;; #x04c
          (vu-pair (mfir.w vf03 vi01) (nop :e)) ;; #x04d
          (vu-pair (lq.xyzw vf04 vi00 TFRAG-VU-AMBIENT) (nop)) ;; #x04e
          (rlet ((input-bank :reg vi14)                                  ;; VIF TOP: 0 or TFRAG-VU-BANK-1
                 (subroutine-link :reg vi15)                             ;; bal link, or a resume address loaded by hand
                 (fog :reg vf01))                                        ;; TFRAG-VU-FOG; never holds anything else
            (rlet ((points-left :reg vi02)                               ;; how many points still to transform
                   (base-count :reg vi04)
                   (level1-count :reg vi01)
                   (load-cursor :reg vi05)                               ;; walks the vertex array
                   (store-cursor :reg vi06)                              ;; trails it by three vertices
                   (val :reg vf02)
                   (cam-row-x :reg vf05)
                   (cam-row-y :reg vf06)
                   (cam-row-z :reg vf07)
                   (cam-trans :reg vf08)
                   (pos-0 :reg vf12)
                   (pos-1 :reg vf13)
                   (pos-2 :reg vf14)
                   (pos-3 :reg vf15)
                   (color-0 :reg vf16)                                   ;; colors only get an itof
                   (color-1 :reg vf17)
                   (color-2 :reg vf18)
                   (color-3 :reg vf19))
              ;; Transform a prefix of the vertex array: the points that have no edge to slide along, and so are not
              ;; going to be transformed by a blend loop later. Three variants, differing only in how long the prefix
              ;; is - num-base-points, num-base-points plus num-level0-points, or (reachable from nothing in this
              ;; program) all three counts. Whatever is past the prefix belongs to a blend loop, which transforms
              ;; each of its vertices as it loads it; there is no pass over the whole array.
              ;;
              ;; Straight through the array with lqi/sqi rather than through the records, because the prefix is
              ;; contiguous and the records are not needed to find it. A vertex is two quadwords, packed integer
              ;; position and packed color; only the position needs the matrix, so the four colors ride along in the
              ;; top half of the register file getting nothing but an itof while the accumulator does the real work.
              (label transform-base-points)
              (vu-pair (ilw.z load-cursor input-bank 1) (nop)) ;; #x04f
              (vu-pair (b transform-points) (nop)) ;; #x050
              (vu-pair (ilwr.x points-left input-bank) (nop)) ;; #x051
              (label transform-base-and-level0-points)
              (vu-pair (ilwr.z points-left input-bank) (nop)) ;; #x052
              (vu-pair (ilwr.x base-count input-bank) (nop)) ;; #x053
              (vu-pair (ilw.z load-cursor input-bank 1) (nop)) ;; #x054
              (vu-pair (b transform-points) (nop)) ;; #x055
              (vu-pair (iadd points-left points-left base-count) (nop)) ;; #x056
              (vu-pair (ilwr.z points-left input-bank) (nop)) ;; #x057
              (vu-pair (ilw.x level1-count input-bank 1) (nop)) ;; #x058
              (vu-pair (ilwr.x base-count input-bank) (nop)) ;; #x059
              (vu-pair (ilw.z load-cursor input-bank 1) (nop)) ;; #x05a
              (vu-pair (iadd points-left points-left base-count) (nop)) ;; #x05b
              (vu-pair (iadd points-left points-left level1-count) (nop)) ;; #x05c
              (label transform-points)
              (vu-pair (iadd load-cursor load-cursor input-bank) (nop)) ;; #x05d
              (vu-pair (lqi.xyzw pos-0 load-cursor) (nop)) ;; #x05e
              (vu-pair (lqi.xyzw color-0 load-cursor) (nop)) ;; #x05f
              (vu-pair (lq.xyzw fog vi00 TFRAG-VU-FOG) (nop)) ;; #x060
              (vu-pair (lq.xyzw val vi00 TFRAG-VU-VAL) (nop)) ;; #x061
              (vu-pair (lq.xyzw cam-row-x input-bank TFRAG-VU-CAMERA) (itof0.xyzw pos-0 pos-0)) ;; #x062
              (vu-pair (lq.xyzw cam-trans input-bank (+ TFRAG-VU-CAMERA 3)) (itof0.xyzw color-0 color-0)) ;; #x063
              (vu-pair (lqi.xyzw pos-1 load-cursor) (nop)) ;; #x064
              (vu-pair (lqi.xyzw color-1 load-cursor) (nop)) ;; #x065
              (vu-pair (nop) (nop)) ;; #x066
              (vu-pair (lq.xyzw cam-row-y input-bank (+ TFRAG-VU-CAMERA 1)) (mulaw.xyzw ACC cam-trans vf00)) ;; #x067
              (vu-pair (lq.xyzw cam-row-z input-bank (+ TFRAG-VU-CAMERA 2)) (itof0.xyzw pos-1 pos-1)) ;; #x068
              (vu-pair (nop) (itof0.xyzw color-1 color-1)) ;; #x069
              (vu-pair (lqi.xyzw pos-2 load-cursor) (maddax.xyzw ACC cam-row-x pos-0)) ;; #x06a
              (vu-pair (lqi.xyzw color-2 load-cursor) (madday.xyzw ACC cam-row-y pos-0)) ;; #x06b
              (vu-pair (nop) (maddz.xyzw pos-0 cam-row-z pos-0)) ;; #x06c
              (vu-pair (nop) (mulaw.xyzw ACC cam-trans vf00)) ;; #x06d
              (vu-pair (nop) (itof0.xyzw pos-2 pos-2)) ;; #x06e
              (vu-pair (iaddi store-cursor load-cursor -0x6) (itof0.xyzw color-2 color-2)) ;; #x06f
              (label transform-points-loop)
              (vu-pair (lqi.xyzw pos-3 load-cursor) (maddax.xyzw ACC cam-row-x pos-1)) ;; #x070
              (vu-pair (lqi.xyzw color-3 load-cursor) (madday.xyzw ACC cam-row-y pos-1)) ;; #x071
              (vu-pair (iaddi points-left points-left -0x1) (maddz.xyzw pos-1 cam-row-z pos-1)) ;; #x072
              (vu-pair (sqi.xyzw pos-0 store-cursor) (mulaw.xyzw ACC cam-trans vf00)) ;; #x073
              (vu-pair (ibeq vi00 points-left transform-points-done) (itof0.xyzw pos-3 pos-3)) ;; #x074
              (vu-pair (sqi.xyzw color-0 store-cursor) (itof0.xyzw color-3 color-3)) ;; #x075
              (vu-pair (lqi.xyzw pos-0 load-cursor) (maddax.xyzw ACC cam-row-x pos-2)) ;; #x076
              (vu-pair (lqi.xyzw color-0 load-cursor) (madday.xyzw ACC cam-row-y pos-2)) ;; #x077
              (vu-pair (iaddi points-left points-left -0x1) (maddz.xyzw pos-2 cam-row-z pos-2)) ;; #x078
              (vu-pair (sqi.xyzw pos-1 store-cursor) (mulaw.xyzw ACC cam-trans vf00)) ;; #x079
              (vu-pair (ibeq vi00 points-left transform-points-done) (itof0.xyzw pos-0 pos-0)) ;; #x07a
              (vu-pair (sqi.xyzw color-1 store-cursor) (itof0.xyzw color-0 color-0)) ;; #x07b
              (vu-pair (lqi.xyzw pos-1 load-cursor) (maddax.xyzw ACC cam-row-x pos-3)) ;; #x07c
              (vu-pair (lqi.xyzw color-1 load-cursor) (madday.xyzw ACC cam-row-y pos-3)) ;; #x07d
              (vu-pair (iaddi points-left points-left -0x1) (maddz.xyzw pos-3 cam-row-z pos-3)) ;; #x07e
              (vu-pair (sqi.xyzw pos-2 store-cursor) (mulaw.xyzw ACC cam-trans vf00)) ;; #x07f
              (vu-pair (ibeq vi00 points-left transform-points-done) (itof0.xyzw pos-1 pos-1)) ;; #x080
              (vu-pair (sqi.xyzw color-2 store-cursor) (itof0.xyzw color-1 color-1)) ;; #x081
              (vu-pair (lqi.xyzw pos-2 load-cursor) (maddax.xyzw ACC cam-row-x pos-0)) ;; #x082
              (vu-pair (lqi.xyzw color-2 load-cursor) (madday.xyzw ACC cam-row-y pos-0)) ;; #x083
              (vu-pair (iaddi points-left points-left -0x1) (maddz.xyzw pos-0 cam-row-z pos-0)) ;; #x084
              (vu-pair (sqi.xyzw pos-3 store-cursor) (mulaw.xyzw ACC cam-trans vf00)) ;; #x085
              (vu-pair (ibne vi00 points-left transform-points-loop) (itof0.xyzw pos-2 pos-2)) ;; #x086
              (vu-pair (sqi.xyzw color-3 store-cursor) (itof0.xyzw color-2 color-2)) ;; #x087
              (label transform-points-done)
              (vu-pair (jr subroutine-link) (nop)) ;; #x088
              (vu-pair (nop) (nop))) ;; #x089
            (rlet ((points-left :reg vi02)
                   (point-cursor :reg vi03)                              ;; this level's point records
                   (endpoint-cursor :reg vi04)                               ;; walks the level's endpoint table, four addresses per quadword
                   (own-vertex-0 :reg vi05)
                   (own-vertex-1 :reg vi06)
                   (parent-record :reg vi07)
                   (parent-b-vertex :reg vi08)
                   (parent-a-vertex :reg vi09)
                   (store-vertex :reg vi10)
                   (val :reg vf02)                                       ;; (0.5, 1.0, 2048.0, 0.0)
                   (cam-row-x :reg vf05)
                   (cam-row-y :reg vf06)
                   (cam-row-z :reg vf07)
                   (cam-trans :reg vf08)
                   (pos-0 :reg vf12)
                   (pos-1 :reg vf13)
                   (color-0 :reg vf14)
                   (color-1 :reg vf15)
                   (weight-0 :reg vf16)
                   (weight-1 :reg vf17)
                   (k0 :reg vf18)                                        ;; slope pair for this level
                   (k1 :reg vf19)                                        ;; intercept pair
                   (parent-b-pos :reg vf20)
                   (parent-b-color :reg vf21)
                   (parent-a-pos :reg vf22)
                   (parent-a-color :reg vf23)
                   (parent-sum-pos :reg vf25)
                   (parent-sum-color :reg vf26)
                   (packed-pos :reg vf27))
              ;; Unwind one subdivision level. Every point of a detail level splits an edge between two coarser points,
              ;; and the place it has to end up is the midpoint of that edge:
              ;;
              ;;   weight.xy = k1.xy + k0.xy * pos.w        clamped to [0, 1] and [0, 0.5]
              ;;   pos       = pos   * weight.y + (parent-a + parent-b) * weight.x
              ;;   color     = color * weight.y + (parent-a + parent-b) * weight.x
              ;;
              ;; Writing t for the fraction of the level's distance band, set-tfrag-dists! makes weight.y = 1 - t and
              ;; weight.x = t/2, so this is a straight lerp from the authored position to the midpoint of the parents:
              ;; the factor of two that turns the parent sum into their midpoint is folded into weight.x, and the VU
              ;; never has to halve anything. The mini against val (0.5, 1.0, ...) and the max against vf0.x are the
              ;; reason the far endpoint is trustworthy: whatever the per-frame coefficients say, weight.x cannot exceed
              ;; one half and weight.y cannot go below zero, so a point can never be pushed past the midpoint or turned
              ;; inside out. That the two limits are reached at the same distance is set-tfrag-dists!'s doing, not the
              ;; clamp's - both affine maps there are built from the same pair of band boundaries.
              ;;
              ;; pos.w is this point's own depth and k0/k1 are per-frame globals with no patch in them, so two patches
              ;; that share a boundary point compute the same weight for it. Whether they also agree on its two parents
              ;; is the exporter's business, not this code's. The texture coordinate needs no blend at all: the exporter
              ;; already stores the exact edge midpoint, so a strip through the split point interpolates STQ to the same
              ;; values the unsplit edge would.
              ;;
              ;; A point's parents are always at a strictly coarser level - level-0 points hang off two base points and
              ;; level-1 points off base and level-0 points, never off another level-1 point - so this loop never chases
              ;; a target that is itself still moving, and the coarser level is unwound first.
              ;;
              ;; Two points are in flight at a time, alternating registers, so the dependent endpoint loads and the
              ;; accumulator chain overlap.
              ;;
              ;; morph-level1-points and morph-level0-points are preambles, not two loops: each loads its own count,
              ;; point cursor, endpoint table and coefficient pair, then enters the shared morph-points-bank0. The
              ;; retiring pair further down is built the same way. Each body also has a bank-1 copy for the second
              ;; VIF buffer.
              (label morph-level1-points)
              (vu-pair (ilw.x points-left input-bank 1) (nop)) ;; #x08a
              (vu-pair (ilw.w point-cursor input-bank 2) (nop)) ;; #x08b
              (vu-pair (ilw.x endpoint-cursor input-bank 4) (nop)) ;; #x08c
              (vu-pair (lq.xyzw fog vi00 TFRAG-VU-FOG) (nop)) ;; #x08d
              (vu-pair (ibeq vi00 points-left morph-points-done) (nop)) ;; #x08e
              (vu-pair (lq.xyzw val vi00 TFRAG-VU-VAL) (nop)) ;; #x08f
              (vu-pair (lq.xy k0 vi00 TFRAG-VU-K0-LEVEL1) (nop)) ;; #x090
              (vu-pair (b morph-points-bank0) (nop)) ;; #x091
              (vu-pair (lq.xy k1 vi00 TFRAG-VU-K1-LEVEL1) (nop)) ;; #x092
              (label morph-level0-points)
              (vu-pair (ilwr.z points-left input-bank) (nop)) ;; #x093

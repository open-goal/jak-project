            (vu-pair (sq.xyzw vf17 clip-work 33) (itof0.xyzw vf21 vf21)) ;; #x2d5
            (vu-pair (sq.xyzw vf18 clip-work 36) (itof0.xyzw vf22 vf29)) ;; #x2d6
            (vu-pair (sq.xyzw vf14 clip-work 41) (nop)) ;; #x2d7
            (vu-pair (sq.xyzw vf20 clip-work 29) (nop)) ;; #x2d8
            (vu-pair (sq.xyzw vf21 clip-work 32) (nop)) ;; #x2d9
            (vu-pair (sq.xyzw vf22 clip-work 35) (nop)) ;; #x2da
            (vu-pair (iaddi vi14 clip-work 0x1) (nop)) ;; #x2db
            (vu-pair (lq.xyzw vf31 vi00 TNEAR-VU-INVH-SCALE) (nop)) ;; #x2dc
            (vu-pair (isw.x vi15 vi00 TNEAR-VU-SAVED-STATE) (nop)) ;; #x2dd
            (vu-pair (iaddi fan-verts vi00 0x0) (nop)) ;; #x2de
            (vu-pair (bal vi15 clip-polygon) (nop)) ;; #x2df
            (vu-pair (iaddiu prev-vertex clip-work 0x1c) (nop)) ;; #x2e0
            (vu-pair (bal vi15 clip-polygon) (nop)) ;; #x2e1
            (vu-pair (iaddiu prev-vertex clip-work 0x1f) (nop)) ;; #x2e2
            (vu-pair (bal vi15 clip-polygon) (nop)) ;; #x2e3
            (vu-pair (iaddiu prev-vertex clip-work 0x22) (nop)) ;; #x2e4
            (vu-pair (b close-polygon) (nop)) ;; #x2e5
            (vu-pair (nop) (nop)) ;; #x2e6
            (label clip-polygon)
            ;; Each plane owns a seven-qword record beginning at 974. Walk the current polygon edges, keep
            ;; vertices on the inside, and emit an interpolated vertex whenever an edge changes side.
            (vu-pair (iaddiu plane-record vi00 TNEAR-VU-CLIP-PLANES) (nop)) ;; #x2e7
            (label begin-clip-plane)
            (vu-pair (iaddi deferred-depth vi00 0x0) (nop)) ;; #x2e8
            (label clip-edge-loop)
            (vu-pair (isubiu vi01 plane-record TNEAR-VU-CLIP-PLANES-END) (nop)) ;; #x2e9
            (vu-pair (ilwr.y next-vertex plane-record) (nop)) ;; #x2ea
            (vu-pair (ibeq vi00 vi01 emit-final-clip-vertex) (nop)) ;; #x2eb
            (vu-pair (ilwr.z plane-distance-fn plane-record) (nop)) ;; #x2ec
            (vu-pair (lq.xyzw vf13 prev-vertex 0) (nop)) ;; #x2ed
            (vu-pair (lq.xyzw vf12 next-vertex 0) (nop)) ;; #x2ee
            (vu-pair (ibne vi00 next-vertex classify-clip-edge) (nop)) ;; #x2ef
            (vu-pair (iswr.y prev-vertex plane-record) (nop)) ;; #x2f0
            (vu-pair (jalr callback-link plane-distance-fn) (nop)) ;; #x2f1
            (vu-pair (iswr.x prev-vertex plane-record) (nop)) ;; #x2f2
            (vu-pair (nop) (nop)) ;; #x2f3
            (vu-pair (nop) (nop)) ;; #x2f4
            (vu-pair (nop) (nop)) ;; #x2f5
            (vu-pair (fsand vi13 0x2) (nop)) ;; #x2f6
            (vu-pair (ibne vi00 vi13 resume-deferred-edge) (nop)) ;; #x2f7
            (vu-pair (nop) (nop)) ;; #x2f8
            (vu-pair (b clip-edge-loop) (nop)) ;; #x2f9
            (vu-pair (iaddi plane-record plane-record 0x7) (nop)) ;; #x2fa
            (label classify-clip-edge)
            (vu-pair (jalr callback-link plane-distance-fn) (nop)) ;; #x2fb
            (vu-pair (lq.xyzw vf20 next-vertex 1) (nop)) ;; #x2fc
            (vu-pair (lq.xyzw vf21 prev-vertex 1) (nop)) ;; #x2fd
            (vu-pair (lq.xyzw vf16 next-vertex 2) (nop)) ;; #x2fe
            (vu-pair (fsand vi01 0x2) (nop)) ;; #x2ff
            (vu-pair (fsand vi13 0x2) (subw.w vf30 vf29 vf30)) ;; #x300
            (vu-pair (ibne vi00 vi01 emit-leaving-intersection) (nop)) ;; #x301
            (vu-pair (lq.xyzw vf17 prev-vertex 2) (nop)) ;; #x302
            (vu-pair (ibne vi00 vi13 emit-entering-intersection) (nop)) ;; #x303
            (vu-pair (div Q vf29.w vf30.w) (nop)) ;; #x304
            (vu-pair (b clip-edge-loop) (nop)) ;; #x305
            (vu-pair (iaddi plane-record plane-record 0x7) (nop)) ;; #x306
            (label emit-entering-intersection)
            (vu-pair (bal callback-link interpolate-clip-vertex) (nop)) ;; #x307
            (vu-pair (iaddi prev-vertex plane-record 0x1) (nop)) ;; #x308
            (vu-pair (sq.xyzw vf14 plane-record 1) (nop)) ;; #x309
            (vu-pair (sq.xyzw vf22 plane-record 2) (nop)) ;; #x30a
            (vu-pair (sq.xyzw vf18 plane-record 3) (nop)) ;; #x30b
            (vu-pair (b clip-edge-loop) (nop)) ;; #x30c
            (vu-pair (iaddi plane-record plane-record 0x7) (nop)) ;; #x30d
            (label emit-leaving-intersection)
            (vu-pair (ibne vi00 vi13 resume-deferred-edge) (nop)) ;; #x30e
            (vu-pair (div Q vf29.w vf30.w) (nop)) ;; #x30f
            (vu-pair (bal callback-link interpolate-clip-vertex) (nop)) ;; #x310
            (vu-pair (nop) (nop)) ;; #x311
            (vu-pair (sq.xyzw vf14 plane-record 4) (nop)) ;; #x312
            (vu-pair (sq.xyzw vf22 plane-record 5) (nop)) ;; #x313
            (vu-pair (sq.xyzw vf18 plane-record 6) (nop)) ;; #x314
            (vu-pair (iaddi plane-record plane-record 0x7) (nop)) ;; #x315
            (vu-pair (isw.x plane-record deferred-depth TNEAR-VU-CLIP-DEFER-STACK) (nop)) ;; #x316
            (vu-pair (isw.y prev-vertex deferred-depth TNEAR-VU-CLIP-DEFER-STACK) (nop)) ;; #x317
            (vu-pair (iaddi deferred-depth deferred-depth 0x1) (nop)) ;; #x318
            (vu-pair (b clip-edge-loop) (nop)) ;; #x319
            (vu-pair (iaddi prev-vertex plane-record -0x3) (nop)) ;; #x31a
            (label emit-final-clip-vertex)
            (vu-pair (lq.xyzw vf12 prev-vertex 0) (nop)) ;; #x31b
            (vu-pair (lq.xyzw vf20 prev-vertex 1) (nop)) ;; #x31c
            (vu-pair (lq.xyzw vf16 prev-vertex 2) (nop)) ;; #x31d
            (vu-pair (iaddi fan-verts fan-verts 0x1) (nop)) ;; #x31e
            (vu-pair (nop) (nop)) ;; #x31f
            (vu-pair (div Q vf00.w vf12.w) (mul.xyzw vf12 vf12 vf31)) ;; #x320
            (vu-pair (nop) (ftoi0.xyzw vf20 vf20)) ;; #x321
            (vu-pair (nop) (nop)) ;; #x322
            (vu-pair (iaddi vi14 vi14 0x3) (nop)) ;; #x323
            (vu-pair (waitq) (mul.xyz vf16 vf16 Q)) ;; #x324
            (vu-pair (sq.xyzw vf20 vi14 -2) (mul.xyz vf12 vf12 Q)) ;; #x325
            (vu-pair (nop) (add.xyzw vf12 vf12 vf10)) ;; #x326
            (vu-pair (nop) (maxy.w vf12 vf12 vf01)) ;; #x327
            (vu-pair (nop) (miniz.w vf12 vf12 vf01)) ;; #x328
            (vu-pair (sq.xyzw vf16 vi14 -3) (ftoi4.xyzw vf12 vf12)) ;; #x329
            (vu-pair (sq.xyzw vf12 vi14 -1) (nop)) ;; #x32a
            (label resume-deferred-edge)
            (vu-pair (iblez deferred-depth finish-clip-plane) (nop)) ;; #x32b
            (vu-pair (nop) (nop)) ;; #x32c
            (vu-pair (ilw.x plane-record deferred-depth (+ TNEAR-VU-CLIP-DEFER-STACK -1)) (nop)) ;; #x32d
            (vu-pair (ilw.y prev-vertex deferred-depth (+ TNEAR-VU-CLIP-DEFER-STACK -1)) (nop)) ;; #x32e
            (vu-pair (b clip-edge-loop) (nop)) ;; #x32f
            (vu-pair (iaddi deferred-depth deferred-depth -0x1) (nop)) ;; #x330
            (label finish-clip-plane)
            (vu-pair (jr vi15) (nop)) ;; #x331
            (vu-pair (nop) (nop)) ;; #x332
            (label close-polygon)
            ;; Close the last edge against the first vertex for every plane, terminate each generated list,
            ;; and flag an empty final polygon so the caller can omit the clipped fan.
            (vu-pair (iaddiu plane-record vi00 TNEAR-VU-CLIP-PLANES) (nop)) ;; #x333
            (label close-plane-loop)
            (vu-pair (ilwr.x next-vertex plane-record) (nop)) ;; #x334
            (vu-pair (ilwr.y prev-vertex plane-record) (nop)) ;; #x335
            (vu-pair (ilwr.z plane-distance-fn plane-record) (nop)) ;; #x336
            (vu-pair (nop) (nop)) ;; #x337
            (vu-pair (ibeq vi00 next-vertex advance-clip-plane) (nop)) ;; #x338
            (vu-pair (lq.xyzw vf12 prev-vertex 0) (nop)) ;; #x339
            (vu-pair (ibeq prev-vertex next-vertex advance-clip-plane) (nop)) ;; #x33a
            (vu-pair (lq.xyzw vf13 next-vertex 0) (nop)) ;; #x33b
            (vu-pair (jalr callback-link plane-distance-fn) (nop)) ;; #x33c
            (vu-pair (lq.xyzw vf20 prev-vertex 1) (nop)) ;; #x33d
            (vu-pair (lq.xyzw vf21 next-vertex 1) (nop)) ;; #x33e
            (vu-pair (lq.xyzw vf16 prev-vertex 2) (nop)) ;; #x33f
            (vu-pair (fsand vi01 0x2) (nop)) ;; #x340
            (vu-pair (fsand vi13 0x2) (subw.w vf30 vf29 vf30)) ;; #x341
            (vu-pair (ibeq vi13 vi01 advance-clip-plane) (nop)) ;; #x342
            (vu-pair (lq.xyzw vf17 next-vertex 2) (nop)) ;; #x343
            (vu-pair (ibeq vi00 vi01 close-with-entering-intersection) (nop)) ;; #x344
            (vu-pair (div Q vf29.w vf30.w) (nop)) ;; #x345
            (vu-pair (bal callback-link interpolate-clip-vertex) (nop)) ;; #x346
            (vu-pair (nop) (nop)) ;; #x347
            (vu-pair (sq.xyzw vf14 plane-record 4) (nop)) ;; #x348
            (vu-pair (sq.xyzw vf22 plane-record 5) (nop)) ;; #x349
            (vu-pair (sq.xyzw vf18 plane-record 6) (nop)) ;; #x34a
            (vu-pair (iaddi prev-vertex plane-record 0x4) (nop)) ;; #x34b
            (vu-pair (ior vi12 plane-record vi00) (nop)) ;; #x34c
            (vu-pair (bal vi15 begin-clip-plane) (nop)) ;; #x34d
            (vu-pair (iaddi plane-record plane-record 0x7) (nop)) ;; #x34e
            (vu-pair (b advance-clip-plane) (nop)) ;; #x34f
            (vu-pair (ior plane-record vi12 vi00) (nop)) ;; #x350
            (label close-with-entering-intersection)
            (vu-pair (bal callback-link interpolate-clip-vertex) (nop)) ;; #x351
            (vu-pair (nop) (nop)) ;; #x352
            (vu-pair (sq.xyzw vf14 plane-record 1) (nop)) ;; #x353
            (vu-pair (sq.xyzw vf22 plane-record 2) (nop)) ;; #x354
            (vu-pair (sq.xyzw vf18 plane-record 3) (nop)) ;; #x355
            (vu-pair (iaddi prev-vertex plane-record 0x1) (nop)) ;; #x356
            (vu-pair (ior vi12 plane-record vi00) (nop)) ;; #x357
            (vu-pair (bal vi15 begin-clip-plane) (nop)) ;; #x358
            (vu-pair (iaddi plane-record plane-record 0x7) (nop)) ;; #x359
            (vu-pair (ior plane-record vi12 vi00) (nop)) ;; #x35a
            (label advance-clip-plane)
            (vu-pair (isubiu vi01 plane-record 0x3f1) (nop)) ;; #x35b
            (vu-pair (iswr.x vi00 plane-record) (nop)) ;; #x35c
            (vu-pair (iswr.y vi00 plane-record) (nop)) ;; #x35d
            (vu-pair (ibltz vi01 close-plane-loop) (nop)) ;; #x35e
            (vu-pair (iaddi plane-record plane-record 0x7) (nop)) ;; #x35f
            (vu-pair (ibeq vi00 fan-verts restore-after-polygon-clip) (nop)) ;; #x360
            (vu-pair (nop) (nop)) ;; #x361
            (vu-pair (iaddiu fan-verts fan-verts 0x4000) (nop)) ;; #x362
            (vu-pair (iaddiu fan-verts fan-verts 0x4000) (nop)) ;; #x363
            (vu-pair (iswr.x fan-verts clip-work) (nop))) ;; #x364
          (label restore-after-polygon-clip)
          (vu-pair (ilw.x vi15 vi00 TNEAR-VU-SAVED-STATE) (nop)) ;; #x365
          (vu-pair (lq.xyzw vf29 vi11 37) (nop)) ;; #x366
          (vu-pair (lq.xyzw vf30 vi11 38) (nop)) ;; #x367
          (vu-pair (lq.xyzw vf12 vi11 39) (nop)) ;; #x368
          (vu-pair (lq.xyzw vf13 vi11 40) (nop)) ;; #x369
          (vu-pair (lq.xyzw vf14 vi11 41) (nop)) ;; #x36a
          (vu-pair (lq.xyzw vf20 vi11 42) (nop)) ;; #x36b
          (vu-pair (lq.xyzw vf21 vi11 43) (nop)) ;; #x36c
          (vu-pair (lq.xyzw vf22 vi11 44) (nop)) ;; #x36d
          (vu-pair (lq.xyzw vf16 vi11 45) (nop)) ;; #x36e
          (vu-pair (lq.xyzw vf17 vi11 46) (nop)) ;; #x36f
          (vu-pair (lq.xyzw vf18 vi11 47) (nop)) ;; #x370
          (vu-pair (jr vi15) (nop)) ;; #x371
          (vu-pair (lq.xyzw vf31 vi11 48) (nop)) ;; #x372
          ;; Six two-instruction subroutines, one per half-space, and the shared interpolator. Each computes the
          ;; homogeneous distance of both edge endpoints at once - w + x for +X, w - x for -X and so on - leaving
          ;; them in the w lanes of dist-a and dist-b, which the caller turns into the edge parameter with
          ;; d0 / (d0 - d1). Their addresses are what TNEAR-VU-INIT writes into the plane records.
          (rlet ((callback-link :reg vi10)
                 (dist-a :reg vf29)                                        ;; signed distance of edge vertex A from the plane, in w
                 (dist-b :reg vf30)                                        ;; and of vertex B; then d0 - d1 for the divide
                 (pos-a :reg vf12)
                 (pos-b :reg vf13)
                 (color-a :reg vf20)
                 (color-b :reg vf21)
                 (stq-a :reg vf16)
                 (stq-b :reg vf17)
                 (clip-pos :reg vf14)
                 (clip-color :reg vf22)
                 (clip-stq :reg vf18))
            (label positive-x-distance)
            (vu-pair (jr callback-link) (addx.w dist-a pos-a pos-a)) ;; #x373
            (vu-pair (nop) (addx.w dist-b pos-b pos-b)) ;; #x374
            (label negative-x-distance)
            (vu-pair (jr callback-link) (subx.w dist-a pos-a pos-a)) ;; #x375
            (vu-pair (nop) (subx.w dist-b pos-b pos-b)) ;; #x376
            (label positive-y-distance)
            (vu-pair (jr callback-link) (addy.w dist-a pos-a pos-a)) ;; #x377
            (vu-pair (nop) (addy.w dist-b pos-b pos-b)) ;; #x378
            (label negative-y-distance)
            (vu-pair (jr callback-link) (suby.w dist-a pos-a pos-a)) ;; #x379
            (vu-pair (nop) (suby.w dist-b pos-b pos-b)) ;; #x37a
            (label positive-z-distance)
            (vu-pair (jr callback-link) (addz.w dist-a pos-a pos-a)) ;; #x37b
            (vu-pair (nop) (addz.w dist-b pos-b pos-b)) ;; #x37c
            (label negative-z-distance)
            (vu-pair (jr callback-link) (subz.w dist-a pos-a pos-a)) ;; #x37d
            (vu-pair (nop) (subz.w dist-b pos-b pos-b)) ;; #x37e
            (label interpolate-clip-vertex)
            ;; Interpolate all three vertex attributes at a plane crossing using Q = d0 / (d0 - d1).
            (vu-pair (nop) (sub.xyzw clip-pos pos-b pos-a)) ;; #x37f
            (vu-pair (nop) (sub.xyzw clip-color color-b color-a)) ;; #x380
            (vu-pair (nop) (sub.xyzw clip-stq stq-b stq-a)) ;; #x381
            (vu-pair (waitq) (mul.xyzw clip-pos clip-pos Q)) ;; #x382
            (vu-pair (nop) (mul.xyzw clip-color clip-color Q)) ;; #x383
            (vu-pair (nop) (mul.xyzw clip-stq clip-stq Q)) ;; #x384
            (vu-pair (nop) (add.xyzw clip-pos pos-a clip-pos)) ;; #x385
            (vu-pair (jr callback-link) (add.xyzw clip-color color-a clip-color)) ;; #x386
            (vu-pair (nop) (add.xyzw clip-stq stq-a clip-stq))) ;; #x387
          ))

(defun-debug tfrag-details ((fragment tfragment))
  "Disassemble a tfragment's common, base, level-zero, and level-one VIF streams. The level-zero
   view pairs dma-qwc[3] with the raw word at offset 40, the final dma-chain slot; that unusual
   pairing may come from an older tfragment debug layout."
  (format 0 "id = ~d~%" (-> fragment id))
  (format 0 "common:~%")
  (let ((common-qwc (-> fragment dma-qwc 0))
        (common-data (-> fragment dma-common)))
    (format 0 "qwc = ~d, ref = ~x~%" common-qwc common-data)
    (disasm-vif-tag (the-as (pointer vif-tag) common-data) (the-as int (* common-qwc 4)) (the-as symbol 0) #t))
  (format 0 "base:~%")
  (let ((base-qwc (-> fragment dma-qwc 1))
        (base-data (-> fragment dma-base)))
    (format 0 "qwc = ~d, ref = ~x~%" base-qwc base-data)
    (disasm-vif-tag (the-as (pointer vif-tag) base-data) (the-as int (* base-qwc 4)) (the-as symbol 0) #t))
  (format 0 "level-0:~%")
  ;; The level-zero debug view uses the final dma-chain word with the fourth cumulative QWC
  ;; boundary. It differs from the named dma-level-0 overlay and may describe an older layout.
  (let ((level-0-qwc (-> fragment dma-qwc 3))
        (level-0-data (-> (the-as (pointer uint32) fragment) 10)))
    (format 0 "qwc = ~d, ref = ~x~%" level-0-qwc level-0-data)
    (disasm-vif-tag (the-as (pointer vif-tag) level-0-data) (the-as int (* level-0-qwc 4)) (the-as symbol 0) #t))
  (format 0 "level-1:~%")
  (let ((level-1-qwc (-> fragment dma-qwc 2))
        (level-1-data (-> fragment dma-level-1)))
    (format 0 "qwc = ~d, ref = ~x~%" level-1-qwc level-1-data)
    (disasm-vif-tag (the-as (pointer vif-tag) level-1-data) (the-as int (* level-1-qwc 4)) (the-as symbol 0) #t))
  (none))

(defun-debug clip-restore ()
  "Move the debug camera to a captured Sandover pose used to inspect near-terrain clipping."
  (let ((camera-position (new-stack-vector0))
        (camera-rotation (new-stack-matrix0)))
    (set! (-> camera-position x) 92648.22)
    (set! (-> camera-position y) 238025.03)
    (set! (-> camera-position z) 199836.31)
    (set! (-> camera-position w) 1.0)
    (set! (-> camera-rotation vector 0 x) -0.9283)
    (set! (-> camera-rotation vector 0 y) 0.0)
    (set! (-> camera-rotation vector 0 z) 0.3716)
    (set! (-> camera-rotation vector 0 w) 0.0)
    (set! (-> camera-rotation vector 1 x) -0.2257)
    (set! (-> camera-rotation vector 1 y) 0.7945)
    (set! (-> camera-rotation vector 1 z) -0.5637)
    (set! (-> camera-rotation vector 1 w) 0.0)
    (set! (-> camera-rotation vector 2 x) -0.2952)
    (set! (-> camera-rotation vector 2 y) -0.6072)
    (set! (-> camera-rotation vector 2 z) -0.7375)
    (set! (-> camera-rotation vector 2 w) 0.0)
    (set! (-> camera-rotation vector 3 x) 0.0)
    (set! (-> camera-rotation vector 3 y) 0.0)
    (set! (-> camera-rotation vector 3 z) 0.0)
    (set! (-> camera-rotation vector 3 w) 1.0)
    (debug-set-camera-pos-rot! camera-position camera-rotation))
  (none))

;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/math/vector-h.gc")
(require "engine/gfx/tfrag/tfrag-h.gc")
(require "engine/math/matrix-h.gc")
(require "engine/camera/cam-debug-h.gc")

;; TFRAG-NEAR renders tfrags with clipping for triangles that intersect the view frustum.
;; This is unused on PC where OpenGL handles clipping in the normal path.
(#when PC_PORT
  (define tnear-vu1-block (new 'static 'vu-function :length #x0 :qlength #x0)))

;; VU1 data memory for the near-terrain program. The two input banks and the shared frame constants sit
;; where the far program puts them, because both are fed by the same add-tfrag-mtx-0/1 and add-tfrag-data.
(defconstant TNEAR-VU-BANK-1 328)
(defconstant TNEAR-VU-CAMERA 5)          ;; camera transform, four rows, bank relative
(defconstant TNEAR-VU-FOG 656)
(defconstant TNEAR-VU-VAL 657)
(defconstant TNEAR-VU-STRGIF 658)
(defconstant TNEAR-VU-FANGIF 659)        ;; the clipped output is a fan, not a strip
(defconstant TNEAR-VU-ADGIF 660)
(defconstant TNEAR-VU-HVDF-OFFSET 661)
(defconstant TNEAR-VU-HMGE-SCALE 662)
(defconstant TNEAR-VU-INVH-SCALE 663)
(defconstant TNEAR-VU-AMBIENT 664)
(defconstant TNEAR-VU-GUARD 665)

;; Its GIF buffers are smaller than the far program's, because the clipper needs the top of memory.
(defconstant TNEAR-VU-GIF-BUF-0 672)
(defconstant TNEAR-VU-GIF-BUF-1 823)

;; Six seven-quadword clip-plane records, then the deferred-edge stack and the saved outer link.
(defconstant TNEAR-VU-CLIP-PLANES 974)
(defconstant TNEAR-VU-CLIP-PLANES-END 1016)
(defconstant TNEAR-VU-CLIP-DEFER-STACK 1016)
;; One quadword shared by two unrelated saves: x is the clipper's outer return address, y is where the
;; strip pipeline parks its shader cursor across a kick.
(defconstant TNEAR-VU-SAVED-STATE 1022)

;; Entry addresses, as draw-inline-array-tfrag-near spells them in its MSCAL immediates. There is only
;; one drawing entry: near terrain never selects a detail level.
(defconstant TNEAR-VU-INIT 0)
(defconstant TNEAR-VU-DRAW 2)
(defconstant TNEAR-VU-DONE 4)

(#unless PC_PORT
  ;; The near-terrain microprogram. It has no LOD machinery at all: draw-inline-array-tfrag-near
  ;; always uploads the finest stream a patch owns and calls TNEAR-VU-DRAW, because a patch that has come
  ;; this close should never be losing detail. What it has instead, and the far program does not, is a
  ;; real six-plane polygon clipper for triangles that cross the camera guard volume.
  ;;
  ;; TNEAR-VU-INIT initializes the two GIF output buffers and six homogeneous clip-plane work records.
  ;; TNEAR-VU-DRAW renders the VIF TOP input bank, and TNEAR-VU-DONE is the short terminator used after the
  ;; buffered draw calls.
  ;;
  ;; VU memory is divided into two 328-quadword input banks at 0 and 328. Their camera matrices begin
  ;; at 5 and 333. Shared frame constants occupy 656 through 669: fog, strip/fan/adgif templates,
  ;; screen and homogeneous scales, ambient color, guard-band scale, and distance coefficients. GIF
  ;; output alternates between 672..822 and 823..973. The six-plane polygon clipper uses 974..1015,
  ;; with its deferred-edge stack and saved pipeline state in 1016..1023.
  ;;
  ;; vi3 and vi9 walk the vertex- and draw-address books, vi4 addresses packed position/color pairs,
  ;; vi8 is the adgif base, and vi13 walks the selected five-qword adgif. vi6 writes the current GIF
  ;; buffer, vi5 marks its end, vi10 remembers the current strip header, and vi12 carries the encoded
  ;; vertex count. vf4/vf7/vf8 and vf9 are the camera rotation and translation; vf12..vf15 are the
  ;; four-way position pipeline, vf16..vf19 its homogeneous positions, vf20..vf23 its colors, and
  ;; vf24..vf27 its STQ values.
  (defvu1 tnear-vu1-block
          (vu-pair (b initialize-clip-work) (nop)) ;; #x000
          (vu-pair (nop) (nop)) ;; #x001
          (vu-pair (b render-input-bank) (nop)) ;; #x002
          (vu-pair (xtop vi14) (nop)) ;; #x003
          (vu-pair (b finish-entry) (nop)) ;; #x004
          (vu-pair (xtop vi14) (nop)) ;; #x005
          (label finish-entry)
          (vu-pair (lq.xyzw vf04 vi00 TNEAR-VU-AMBIENT) (nop :e)) ;; #x006
          (vu-pair (nop) (nop)) ;; #x007
          (label initialize-clip-work)
          ;; Alternate between the two 151-qword GIF buffers. Each seven-qword clip record starts empty and
          ;; stores the callback address for one of +X, -X, +Y, -Y, +Z, and -Z.
          (vu-pair (iaddiu vi14 vi00 TNEAR-VU-GIF-BUF-0) (nop)) ;; #x008
          (vu-pair (iaddiu vi01 vi00 TNEAR-VU-GIF-BUF-1) (nop)) ;; #x009
          (vu-pair (mfir.x vf03 vi14) (nop)) ;; #x00a
          (vu-pair (mfir.y vf03 vi01) (nop)) ;; #x00b
          (vu-pair (mfir.z vf03 vi14) (nop)) ;; #x00c
          (vu-pair (mfir.w vf03 vi01) (nop)) ;; #x00d
          (vu-pair (lq.xyzw vf04 vi00 TNEAR-VU-AMBIENT) (nop)) ;; #x00e
          (vu-pair (iaddiu vi14 vi00 TNEAR-VU-CLIP-PLANES) (nop)) ;; #x00f
          (vu-pair (sq.xyzw vf00 vi14 0) (nop)) ;; #x010
          (vu-pair (sq.xyzw vf00 vi14 7) (nop)) ;; #x011
          (vu-pair (sq.xyzw vf00 vi14 14) (nop)) ;; #x012
          (vu-pair (sq.xyzw vf00 vi14 21) (nop)) ;; #x013
          (vu-pair (sq.xyzw vf00 vi14 28) (nop)) ;; #x014
          (vu-pair (sq.xyzw vf00 vi14 35) (nop)) ;; #x015
          (vu-pair (iaddiu vi01 vi00 (vu-label positive-x-distance)) (nop)) ;; #x016
          (vu-pair (iswr.z vi01 vi14) (nop)) ;; #x017
          (vu-pair (iaddiu vi01 vi00 (vu-label negative-x-distance)) (nop)) ;; #x018
          (vu-pair (isw.z vi01 vi14 7) (nop)) ;; #x019
          (vu-pair (iaddiu vi01 vi00 (vu-label positive-y-distance)) (nop)) ;; #x01a
          (vu-pair (isw.z vi01 vi14 14) (nop)) ;; #x01b
          (vu-pair (iaddiu vi01 vi00 (vu-label negative-y-distance)) (nop)) ;; #x01c
          (vu-pair (isw.z vi01 vi14 21) (nop)) ;; #x01d
          (vu-pair (iaddiu vi01 vi00 (vu-label positive-z-distance)) (nop)) ;; #x01e
          (vu-pair (isw.z vi01 vi14 28) (nop)) ;; #x01f
          (vu-pair (iaddiu vi01 vi00 (vu-label negative-z-distance)) (nop :e)) ;; #x020
          (vu-pair (isw.z vi01 vi14 35) (nop)) ;; #x021
          (label finish-gif-chunk)
          (vu-pair (iaddi vi07 vi00 -0x1) (nop)) ;; #x022
          (vu-pair (iblez vi12 begin-next-draw) (nop)) ;; #x023
          (vu-pair (iaddi vi09 vi09 0x1) (nop)) ;; #x024
          (vu-pair (ior vi10 vi06 vi00) (nop)) ;; #x025
          (vu-pair (iadd vi01 vi12 vi12) (nop)) ;; #x026
          (vu-pair (iadd vi01 vi01 vi12) (nop)) ;; #x027
          (vu-pair (iadd vi05 vi06 vi01) (nop)) ;; #x028
          (vu-pair (sqi.xyzw vf06 vi06) (nop)) ;; #x029
          (vu-pair (isw.x vi12 vi06 -1) (nop)) ;; #x02a
          (vu-pair (jr vi15) (nop)) ;; #x02b
          (vu-pair (ilwr.x vi12 vi09) (nop)) ;; #x02c
          (label begin-next-draw)
          (vu-pair (ilw.y vi01 vi09 -1) (nop)) ;; #x02d
          (vu-pair (ilw.z vi13 vi09 -1) (nop)) ;; #x02e
          (vu-pair (ibeq vi00 vi12 finish-render) (nop)) ;; #x02f
          (vu-pair (ilwr.x vi14 vi10) (nop)) ;; #x030
          (vu-pair (ibltz vi01 kick-reusing-shader) (nop)) ;; #x031
          (vu-pair (iaddiu vi12 vi12 0x80) (nop)) ;; #x032
          (vu-pair (iadd vi13 vi13 vi08) (nop)) ;; #x033
          (vu-pair (lqi.xyzw vf29 vi13) (nop)) ;; #x034
          (vu-pair (lqi.xyzw vf30 vi13) (nop)) ;; #x035
          (vu-pair (lqi.xyzw vf31 vi13) (nop)) ;; #x036
          (vu-pair (sqi.xyzw vf05 vi06) (nop)) ;; #x037
          (vu-pair (sqi.xyzw vf29 vi06) (nop)) ;; #x038
          (vu-pair (sqi.xyzw vf30 vi06) (nop)) ;; #x039
          (vu-pair (sqi.xyzw vf31 vi06) (nop)) ;; #x03a
          (vu-pair (lqi.xyzw vf29 vi13) (nop)) ;; #x03b
          (vu-pair (lqi.xyzw vf30 vi13) (nop)) ;; #x03c
          (vu-pair (iadd vi01 vi12 vi12) (nop)) ;; #x03d
          (vu-pair (iadd vi01 vi01 vi12) (nop)) ;; #x03e
          (vu-pair (sqi.xyzw vf29 vi06) (nop)) ;; #x03f
          (vu-pair (sqi.xyzw vf30 vi06) (nop)) ;; #x040
          (vu-pair (ior vi10 vi06 vi00) (nop)) ;; #x041
          (vu-pair (iadd vi05 vi06 vi01) (nop)) ;; #x042
          (vu-pair (sqi.xyzw vf06 vi06) (nop)) ;; #x043
          (vu-pair (isw.x vi12 vi06 -1) (nop)) ;; #x044
          (vu-pair (jr vi15) (nop)) ;; #x045
          (vu-pair (ilwr.x vi12 vi09) (nop)) ;; #x046
          (label kick-reusing-shader)
          (vu-pair (mtir vi01 vf24.w) (nop)) ;; #x047
          (vu-pair (mtir vi06 vf03.y) (nop)) ;; #x048
          (vu-pair (mr32.xyzw vf03 vf03) (nop)) ;; #x049
          (vu-pair (iadd vi14 vi14 vi11) (nop)) ;; #x04a
          (vu-pair (ibgez vi13 kick-and-load-shader) (nop)) ;; #x04b
          (vu-pair (iswr.x vi14 vi10) (nop)) ;; #x04c
          (vu-pair (xgkick vi01) (nop)) ;; #x04d
          (vu-pair (ior vi10 vi06 vi00) (nop)) ;; #x04e
          (vu-pair (mfir.w vf24 vi06) (nop)) ;; #x04f
          (vu-pair (iadd vi01 vi12 vi12) (nop)) ;; #x050
          (vu-pair (iadd vi01 vi01 vi12) (nop)) ;; #x051
          (vu-pair (iadd vi05 vi06 vi01) (nop)) ;; #x052
          (vu-pair (sqi.xyzw vf06 vi06) (nop)) ;; #x053
          (vu-pair (isw.x vi12 vi06 -1) (nop)) ;; #x054
          (vu-pair (jr vi15) (nop)) ;; #x055
          (vu-pair (ilwr.x vi12 vi09) (nop)) ;; #x056
          (label kick-and-load-shader)
          (vu-pair (iadd vi13 vi13 vi08) (nop)) ;; #x057
          (vu-pair (xgkick vi01) (nop)) ;; #x058
          (vu-pair (lqi.xyzw vf29 vi13) (nop)) ;; #x059
          (vu-pair (lqi.xyzw vf30 vi13) (nop)) ;; #x05a
          (vu-pair (lqi.xyzw vf31 vi13) (nop)) ;; #x05b
          (vu-pair (mfir.w vf24 vi06) (nop)) ;; #x05c
          (vu-pair (sqi.xyzw vf05 vi06) (nop)) ;; #x05d
          (vu-pair (sqi.xyzw vf29 vi06) (nop)) ;; #x05e
          (vu-pair (sqi.xyzw vf30 vi06) (nop)) ;; #x05f
          (vu-pair (sqi.xyzw vf31 vi06) (nop)) ;; #x060
          (vu-pair (lqi.xyzw vf29 vi13) (nop)) ;; #x061
          (vu-pair (lqi.xyzw vf30 vi13) (nop)) ;; #x062
          (vu-pair (iadd vi01 vi12 vi12) (nop)) ;; #x063
          (vu-pair (iadd vi01 vi01 vi12) (nop)) ;; #x064
          (vu-pair (sqi.xyzw vf29 vi06) (nop)) ;; #x065
          (vu-pair (sqi.xyzw vf30 vi06) (nop)) ;; #x066
          (vu-pair (nop) (nop)) ;; #x067
          (vu-pair (ior vi10 vi06 vi00) (nop)) ;; #x068
          (vu-pair (iadd vi05 vi06 vi01) (nop)) ;; #x069
          (vu-pair (sqi.xyzw vf06 vi06) (nop)) ;; #x06a
          (vu-pair (isw.x vi12 vi06 -1) (nop)) ;; #x06b
          (vu-pair (jr vi15) (nop)) ;; #x06c
          (vu-pair (ilwr.x vi12 vi09) (nop)) ;; #x06d
          (label finish-render)
          (vu-pair (mtir vi01 vf24.w) (nop)) ;; #x06e
          (vu-pair (mr32.xyzw vf03 vf03) (nop)) ;; #x06f
          (vu-pair (iadd vi14 vi14 vi11) (nop)) ;; #x070
          (vu-pair (iswr.x vi14 vi10) (nop)) ;; #x071
          (vu-pair (lq.xyzw vf04 vi00 TNEAR-VU-AMBIENT) (nop)) ;; #x072
          (vu-pair (xgkick vi01) (nop)) ;; #x073
          (vu-pair (nop) (nop :e)) ;; #x074
          (vu-pair (nop) (nop)) ;; #x075
          (label render-input-bank)
          ;; TOP selects either packed input bank. Load its address books and matrix, then transform four
          ;; vertices in parallel while producing ST, RGBAQ, and XYZF2 triples in the active GIF buffer.
          ;; Homogeneous W supplies Q for perspective correction and the fog value is clamped before ftoi4.
          (vu-pair (ilw.w vi08 vi14 4) (nop)) ;; #x076
          (vu-pair (lq.xyzw vf02 vi00 TNEAR-VU-GUARD) (addw.z vf28 vf00 vf00)) ;; #x077
          (vu-pair (lq.xyzw vf05 vi00 TNEAR-VU-ADGIF) (nop)) ;; #x078
          (vu-pair (lq.xyzw vf06 vi00 TNEAR-VU-STRGIF) (nop)) ;; #x079
          (vu-pair (iadd vi08 vi08 vi14) (nop)) ;; #x07a
          (vu-pair (lq.xyzw vf11 vi00 TNEAR-VU-HMGE-SCALE) (nop)) ;; #x07b
          (vu-pair (lq.w vf29 vi08 1) (nop)) ;; #x07c
          (vu-pair (lq.xyzw vf10 vi00 TNEAR-VU-HVDF-OFFSET) (nop)) ;; #x07d
          (vu-pair (ilw.z vi09 vi14 4) (nop)) ;; #x07e
          (vu-pair (ilw.y vi03 vi14 3) (nop)) ;; #x07f
          (vu-pair (nop) (addy.w vf25 vf29 vf00)) ;; #x080
          (vu-pair (iaddi vi07 vi00 -0x1) (addw.z vf28 vf28 vf29)) ;; #x081
          (vu-pair (lq.xyzw vf04 vi14 5) (mulw.xyzw vf16 vf00 vf00)) ;; #x082
          (vu-pair (lq.xyzw vf07 vi14 6) (mulw.xyzw vf17 vf00 vf00)) ;; #x083
          (vu-pair (ibne vi00 vi14 render-bank1) (mulw.xyzw vf18 vf00 vf00)) ;; #x084
          (vu-pair (lq.xyzw vf08 vi14 7) (mulw.xyzw vf19 vf00 vf00)) ;; #x085
          (vu-pair (ilwr.x vi02 vi03) (nop)) ;; #x086
          (vu-pair (lq.xyzw vf09 vi14 8) (nop)) ;; #x087
          (vu-pair (lq.xyzw vf01 vi00 TNEAR-VU-FOG) (nop)) ;; #x088
          (vu-pair (iadd vi09 vi09 vi14) (nop)) ;; #x089
          (vu-pair (lq.xyw vf28 vi02 0) (nop)) ;; #x08a
          (vu-pair (mtir vi06 vf03.x) (nop)) ;; #x08b
          (vu-pair (ilwr.x vi12 vi09) (nop)) ;; #x08c
          (vu-pair (ilwr.z vi13 vi09) (nop)) ;; #x08d
          (vu-pair (mtir vi04 vf28.w) (subw.xyz vf24 vf28 vf25)) ;; #x08e
          (vu-pair (iaddiu vi11 vi00 0x4000) (nop)) ;; #x08f
          (vu-pair (iaddiu vi11 vi11 0x4000) (nop)) ;; #x090
          (vu-pair (ilwr.y vi02 vi03) (nop)) ;; #x091
          (vu-pair (lq.xyzw vf12 vi04 0) (nop)) ;; #x092
          (vu-pair (lq.xyzw vf20 vi04 1) (nop)) ;; #x093
          (vu-pair (iaddiu vi12 vi12 0x80) (nop)) ;; #x094
          (vu-pair (iadd vi13 vi13 vi08) (nop)) ;; #x095
          (vu-pair (lq.xyw vf28 vi02 0) (itof0.xyzw vf12 vf12)) ;; #x096
          (vu-pair (mfir.w vf24 vi06) (nop)) ;; #x097
          (vu-pair (lqi.xyzw vf29 vi13) (nop)) ;; #x098
          (vu-pair (lqi.xyzw vf30 vi13) (nop)) ;; #x099
          (vu-pair (lqi.xyzw vf31 vi13) (nop)) ;; #x09a
          (vu-pair (sqi.xyzw vf05 vi06) (subw.xyz vf25 vf28 vf25)) ;; #x09b
          (vu-pair (sqi.xyzw vf29 vi06) (mulaw.xyzw ACC vf09 vf00)) ;; #x09c
          (vu-pair (mtir vi04 vf28.w) (nop)) ;; #x09d
          (vu-pair (sqi.xyzw vf30 vi06) (maddax.xyzw ACC vf04 vf12)) ;; #x09e
          (vu-pair (sqi.xyzw vf31 vi06) (nop)) ;; #x09f
          (vu-pair (ilwr.z vi02 vi03) (nop)) ;; #x0a0
          (vu-pair (lq.xyzw vf13 vi04 0) (madday.xyzw ACC vf07 vf12)) ;; #x0a1
          (vu-pair (lq.xyzw vf21 vi04 1) (maddz.xyzw vf12 vf08 vf12)) ;; #x0a2
          (vu-pair (lqi.xyzw vf29 vi13) (nop)) ;; #x0a3
          (vu-pair (lqi.xyzw vf30 vi13) (nop)) ;; #x0a4
          (vu-pair (lq.xyw vf28 vi02 0) (itof0.xyzw vf13 vf13)) ;; #x0a5
          (vu-pair (div Q vf01.x vf12.w) (mul.xyzw vf16 vf12 vf11)) ;; #x0a6
          (vu-pair (sqi.xyzw vf29 vi06) (nop)) ;; #x0a7
          (vu-pair (sqi.xyzw vf30 vi06) (nop)) ;; #x0a8
          (vu-pair (iadd vi01 vi12 vi12) (subw.xyz vf26 vf28 vf25)) ;; #x0a9
          (vu-pair (iadd vi01 vi01 vi12) (mulaw.xyzw ACC vf09 vf00)) ;; #x0aa
          (vu-pair (mtir vi04 vf28.w) (nop)) ;; #x0ab
          (vu-pair (iadd vi05 vi06 vi01) (maddax.xyzw ACC vf04 vf13)) ;; #x0ac
          (vu-pair (ior vi10 vi06 vi00) (mul.xyz vf12 vf12 Q)) ;; #x0ad
          (vu-pair (ilwr.w vi02 vi03) (mul.xyz vf24 vf24 Q)) ;; #x0ae
          (vu-pair (lq.xyzw vf14 vi04 0) (madday.xyzw ACC vf07 vf13)) ;; #x0af
          (vu-pair (lq.xyzw vf22 vi04 1) (maddz.xyzw vf13 vf08 vf13)) ;; #x0b0
          (vu-pair (sqi.xyzw vf06 vi06) (add.xyzw vf12 vf12 vf10)) ;; #x0b1
          (vu-pair (isw.x vi12 vi06 -1) (nop)) ;; #x0b2
          (vu-pair (lq.xyw vf28 vi02 0) (itof0.xyzw vf14 vf14)) ;; #x0b3
          (vu-pair (div Q vf01.x vf13.w) (mul.xyzw vf17 vf13 vf11)) ;; #x0b4
          (vu-pair (iaddi vi09 vi09 0x1) (miniz.w vf12 vf12 vf01)) ;; #x0b5
          (vu-pair (ilwr.x vi12 vi09) (clipw.xyz vf16 vf16)) ;; #x0b6
          (label bank0-pipeline-0)
          (vu-pair (iaddi vi03 vi03 0x1) (subw.xyz vf27 vf28 vf25)) ;; #x0b7
          (vu-pair (iaddi vi07 vi07 0x1) (mulaw.xyzw ACC vf09 vf00)) ;; #x0b8
          (vu-pair (mtir vi04 vf28.w) (maxy.w vf12 vf12 vf01)) ;; #x0b9
          (vu-pair (fcand vi01 0x3ffff) (maddax.xyzw ACC vf04 vf14)) ;; #x0ba
          (vu-pair (ibne vi00 vi01 clip-bank0-triangle-0) (mul.xyz vf13 vf13 Q)) ;; #x0bb
          (vu-pair (ilwr.x vi02 vi03) (mul.xyz vf25 vf25 Q)) ;; #x0bc
          (label bank0-pipeline-1)
          (vu-pair (lq.xyzw vf15 vi04 0) (madday.xyzw ACC vf07 vf14)) ;; #x0bd
          (vu-pair (lq.xyzw vf23 vi04 1) (maddz.xyzw vf14 vf08 vf14)) ;; #x0be
          (vu-pair (sqi.xyz vf24 vi06) (add.xyzw vf13 vf13 vf10)) ;; #x0bf
          (vu-pair (sqi.xyzw vf20 vi06) (ftoi4.xyzw vf12 vf12)) ;; #x0c0
          (vu-pair (lq.xyw vf28 vi02 0) (itof0.xyzw vf15 vf15)) ;; #x0c1
          (vu-pair (div Q vf01.x vf14.w) (mul.xyzw vf18 vf14 vf11)) ;; #x0c2
          (vu-pair (ibeq vi05 vi06 bank0-kick-before-1) (miniz.w vf13 vf13 vf01)) ;; #x0c3
          (vu-pair (sqi.xyzw vf12 vi06) (clipw.xyz vf17 vf17)) ;; #x0c4
          (vu-pair (nop) (subw.xyz vf24 vf28 vf25)) ;; #x0c5
          (vu-pair (iaddi vi07 vi07 0x1) (mulaw.xyzw ACC vf09 vf00)) ;; #x0c6
          (vu-pair (mtir vi04 vf28.w) (maxy.w vf13 vf13 vf01)) ;; #x0c7
          (vu-pair (fcand vi01 0x3ffff) (maddax.xyzw ACC vf04 vf15)) ;; #x0c8
          (vu-pair (ibne vi00 vi01 clip-bank0-triangle-1) (mul.xyz vf14 vf14 Q)) ;; #x0c9
          (vu-pair (ilwr.y vi02 vi03) (mul.xyz vf26 vf26 Q)) ;; #x0ca
          (label bank0-pipeline-2)
          (vu-pair (lq.xyzw vf12 vi04 0) (madday.xyzw ACC vf07 vf15)) ;; #x0cb
          (vu-pair (lq.xyzw vf20 vi04 1) (maddz.xyzw vf15 vf08 vf15)) ;; #x0cc
          (vu-pair (sqi.xyzw vf25 vi06) (add.xyzw vf14 vf14 vf10)) ;; #x0cd
          (vu-pair (sqi.xyzw vf21 vi06) (ftoi4.xyzw vf13 vf13)) ;; #x0ce
          (vu-pair (lq.xyw vf28 vi02 0) (itof0.xyzw vf12 vf12)) ;; #x0cf
          (vu-pair (div Q vf01.x vf15.w) (mul.xyzw vf19 vf15 vf11)) ;; #x0d0
          (vu-pair (ibeq vi05 vi06 bank0-kick-before-2) (miniz.w vf14 vf14 vf01)) ;; #x0d1
          (vu-pair (sqi.xyzw vf13 vi06) (clipw.xyz vf18 vf18)) ;; #x0d2
          (vu-pair (nop) (subw.xyz vf25 vf28 vf25)) ;; #x0d3
          (vu-pair (iaddi vi07 vi07 0x1) (mulaw.xyzw ACC vf09 vf00)) ;; #x0d4
          (vu-pair (mtir vi04 vf28.w) (maxy.w vf14 vf14 vf01)) ;; #x0d5
          (vu-pair (fcand vi01 0x3ffff) (maddax.xyzw ACC vf04 vf12)) ;; #x0d6
          (vu-pair (ibne vi00 vi01 clip-bank0-triangle-2) (mul.xyz vf15 vf15 Q)) ;; #x0d7
          (vu-pair (ilwr.z vi02 vi03) (mul.xyz vf27 vf27 Q)) ;; #x0d8
          (label bank0-pipeline-3)
          (vu-pair (lq.xyzw vf13 vi04 0) (madday.xyzw ACC vf07 vf12)) ;; #x0d9

;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/gfx/sprite/sparticle/sparticle.gc")
(require "engine/gfx/mood/mood.gc")

;; DECOMP BEGINS

(defmethod asize-of ((this time-of-day-palette))
  "Return the palette header plus width times height packed RGBA entries."
  (the-as int (+ (-> this type size) (* (* (-> this height) (-> this width)) 4))))

;; Optional hook run immediately before the time-of-day particles and sky are updated.
(define-extern time-of-day-effect (function none))

;; Leave the hook callable when nothing has installed an effect.
(if (zero? time-of-day-effect) (set! time-of-day-effect nothing))

(defbehavior time-of-day-update time-of-day-proc ()
  "Run the time-of-day effect hook, maintain the nighttime stars and the two time-windowed sun particle
   groups, and update the sky renderer. Stars are emitted only when a sky is active and the blended
   mood requests more than 45; obsolete particles are expired or killed before their count resets."
  (time-of-day-effect)
  ;; Spawn or kill stars as the night blend crosses its threshold.
  (cond
    ((and (or (>= (-> self hour) 19) (>= 5 (-> self hour)))
          (and (< 45.0 (-> *time-of-day-context* num-stars)) (-> *time-of-day-context* sky)))
     (when (and *dproc* (< (-> self star-count) (the int (-> *time-of-day-context* num-stars))))
       (spawn (-> self stars) (math-camera-pos))
       (+! (-> self star-count) 1)))
    ((> (-> self star-count) 0)
     (forall-particles-with-key (-> self stars)
                                (lambda ((system sparticle-system) (particle sparticle-cpuinfo))
                                  (if (< (the-as uint #x493e0) (-> particle next-time))
                                    (set! (-> particle next-time) (the-as uint 5))
                                    (sparticle-kill-it system particle))
                                  (none))
                                #t
                                #t)
     (set! (-> self star-count) 0)
     0))
  ;; The ordinary and green suns have separate authored visibility windows.
  (cond
    ((and (>= (-> self time-of-day) 6.25) (< (-> self time-of-day) 18.75) (!= (-> *time-of-day-context* sun-fade) 0.0))
     (when (and *dproc* (zero? (-> self sun-count)))
       (spawn (-> self sun) (math-camera-pos))
       (+! (-> self sun-count) 1)))
    ((> (-> self sun-count) 0) (kill-and-free-particles (-> self sun)) (set! (-> self sun-count) 0) 0))
  (cond
    ((and (or (>= (-> self time-of-day) 21.75) (>= 10.25 (-> self time-of-day)))
          (!= (-> *time-of-day-context* sun-fade) 0.0))
     (when (and *dproc* (zero? (-> self green-sun-count)))
       (spawn (-> self green-sun) (math-camera-pos))
       (+! (-> self green-sun-count) 1)))
    ((> (-> self green-sun-count) 0) (kill-and-free-particles (-> self green-sun)) (set! (-> self green-sun-count) 0) 0))
  (update-sky-tng-data (-> self time-of-day))
  0
  (none))

;; Advance the calendar clock and publish its fractional hour to the mood system.
(defstate time-of-day-tick (time-of-day-proc)
  :code
    (behavior ()
      (loop
        (+! (-> self frame) (the int (* (-> self time-ratio) (-> *display* time-adjust-ratio))))
        (when (>= (-> self frame) 300)
          ;; 300 ticks/second
          (while (>= (-> self frame) 300)
            (+! (-> self frame) -300)
            (+! (-> self second) 1))
          (when (>= (-> self second) 60)
            (while (>= (-> self second) 60)
              (+! (-> self second) -60)
              (+! (-> self minute) 1))
            (when (>= (-> self minute) 60)
              (while (>= (-> self minute) 60)
                (+! (-> self minute) -60)
                (+! (-> self hour) 1))
              (when (>= (-> self hour) 24)
                (while (>= (-> self hour) 24)
                  (+! (-> self hour) -24)
                  (+! (-> self day) 1))
                (when (>= (-> self day) 7)
                  (while (>= (-> self day) 7)
                    (+! (-> self day) -7)
                    (+! (-> self week) 1))
                  (when (>= (-> self week) 4)
                    (while (>= (-> self week) 4)
                      (+! (-> self week) -4)
                      (+! (-> self month) 1))
                    (when (>= (-> self month) 12)
                      (while (>= (-> self month) 12)
                        (+! (-> self month) -12)
                        (+! (-> self year) 1)))))))))
        (let* ((fractional-frames (the float (-> self frame)))
               (fractional-seconds (+ (/ fractional-frames 300) (the float (-> self second))))
               (fractional-minutes (+ (/ fractional-seconds 60) (the float (-> self minute))))
               (fractional-hours (+ (/ fractional-minutes 60) (the float (-> self hour)))))
          (set! (-> self time-of-day) fractional-hours)
          (set! (-> *time-of-day-context* time) fractional-hours))
        (suspend)))
  :post time-of-day-update)

(defbehavior init-time-of-day time-of-day-proc ()
  "Initialize the calendar clock and star, ordinary-sun, and green-sun launch controls, then enter
   time-of-day-tick. Before display-rate adjustment, the normal clock advances by 300 subsecond
   units per update and the fast clock advances by 18000."
  (stack-size-set! (-> self main-thread) 128)
  (set! (-> self year) 0)
  (set! (-> self month) 0)
  (set! (-> self week) 0)
  (set! (-> self day) 0)
  (set! (-> self hour) 0)
  (set! (-> self minute) 0)
  (set! (-> self second) 0)
  (set! (-> self frame) 0)
  (set! (-> self time-of-day) 0.0)
  (if *time-of-day-fast* (set! (-> self time-ratio) 18000.0) (set! (-> self time-ratio) 300.0))
  (set! (-> self star-count) 0)
  (set! (-> self stars) (create-launch-control group-stars self))
  (set! (-> self sun) (create-launch-control group-sun self))
  (set! (-> self green-sun) (create-launch-control group-green-sun self))
  (go time-of-day-tick)
  (none))

(defun start-time-of-day ()
  "Replace any active time-of-day process with a newly initialized clock."
  (kill-by-name 'time-of-day-proc *active-pool*)
  (set! *time-of-day-proc* (process-spawn time-of-day-proc :init init-time-of-day))
  (none))

(defun time-of-day-setup ((toggle symbol))
  "Return whether the clock is advancing. When toggle is true, switch between the normal or fast
   clock and a frozen noon, updating the debug-menu mode to match."
  (when toggle
    (cond
      ((= (-> *time-of-day-proc* 0 time-ratio) 0.0)
       (if *time-of-day-fast* (set! (-> *time-of-day-proc* 0 time-ratio) 18000.0) (set! (-> *time-of-day-proc* 0 time-ratio) 300.0))
       (set! *time-of-day-mode* 8))
      (else
       (set! (-> *time-of-day-proc* 0 time-ratio) 0.0)
       (set! *time-of-day-mode* 4)
       (set! (-> *time-of-day-proc* 0 hour) 12)
       (set! (-> *time-of-day-proc* 0 minute) 0)
       0)))
  (if (= (-> *time-of-day-proc* 0 time-ratio) 0.0) #f #t))

(defun set-time-of-day ((hour float))
  "Set the clock from a fractional hour, splitting its fractional parts into minutes and seconds."
  (let ((clock *time-of-day-proc*))
    (set! (-> clock 0 hour) (the int hour))
    (let ((minutes (* 60.0 (- hour (the float (the int hour))))))
      (set! (-> clock 0 minute) (the int minutes))
      (set! (-> clock 0 second) (the int (* 60.0 (- minutes (the float (the int minutes))))))))
  0
  (none))

;; Every palette color has eight RGBA samples, one for each time key selected by mood-context.itimes.
;; The EE blends those samples with four packed MMI multiply-adds. Each scratchpad input page is
;; exactly 32 colors (1024 bytes), while each output page is 32 packed RGBA words (128 bytes).
;; Processing a fixed page size keeps the DMA and inner loop branch-free. Consequently the final
;; input transfer may read beyond palette.height and the final output contains the complete rounded
;; block; the resource storage and work buffers are deliberately large enough for those extra colors.
(#unless PC_PORT
  (asm-data
    (label time-of-day-color-maxima)
    ;; Saturate the four 16-bit lanes to R=255, G=255, B=255, A=128.
    (word #x00ff00ff #x008000ff))

  (defun time-of-day-interp-colors-scratch ((data (pointer rgba))
                                            (palette time-of-day-palette)
                                            (context mood-context))
    "Blend each palette color's eight authored RGBA samples with context's packed 4.6 time-of-day
     weights, writing directly to scratchpad data. Double-buffer 32-color input pages, shift the
     accumulated products down six bits, and clamp RGB to 255 and alpha to 128. The last input DMA
     may read as many as 31 colors past the nominal palette, and data receives the complete rounded
     block; callers leave that storage accessible and ignore colors beyond height."
    (declare (asm-func none))
    (rlet ((input-bank)
           (next-input-bank)
           (palette-data)
           (colors-left)
           (dma-to-spr)
           (dma-state)
           (clamp-limits :class i128)
           (weight01 :class i128)
           (weight23 :class i128)
           (weight45 :class i128)
           (weight67 :class i128)
           (samples03 :class i128)
           (samples47 :class i128)
           (expanded :class i128)
           (product :class i128)
           (output-end))
      ;; This entry nop is present in the original function before the scratchpad setup.
      (nop!)
      (m! input-bank #x70000810)
      (lea.field palette-data palette (data))
      (l.d clamp-limits fp time-of-day-color-maxima)
      (m! dma-to-spr #x1000d400)
      (l.w.field colors-left palette (height))
      (l.q.field weight01 context (itimes 0))
      (add.i colors-left colors-left 31)
      (l.q.field weight23 context (itimes 1))
      (sra colors-left colors-left 5)
      (l.q.field weight45 context (itimes 2))
      (sll colors-left colors-left 5)
      (l.q.field weight67 context (itimes 3))

      ;; Start the first 1024-byte palette-to-scratchpad transfer.
      (asm-block start-first-input-page
        (label wait-first-input-channel)
        (l.w dma-state dma-to-spr)
        (nop! :count 3)
        (and.i dma-state dma-state #x100)
        (nop!)
        (b.nz dma-state wait-first-input-channel :delay (nop!))
        (s.w palette-data dma-to-spr 16)
        (add.i colors-left colors-left -32)
        (s.w input-bank dma-to-spr 128)
        (add.i dma-state r0 64)
        (s.w dma-state dma-to-spr 32)
        (add.i dma-state r0 #x100)
        (s.w dma-state dma-to-spr)
        (add.i palette-data palette-data 1024))

      ;; Alternate the two 1024-byte input banks. A following page starts while the current page is
      ;; blended; for the last page, only wait for the transfer already in flight.
      (asm-block acquire-input-page
        (label input-page-loop)
        (m next-input-bank input-bank)
        (xor.i input-bank input-bank 1024)
        (b.le colors-left r0 wait-last-input-page :delay (add.i colors-left colors-left -32))

        (label wait-reusable-input-bank)
        (l.w dma-state dma-to-spr)
        (nop! :count 3)
        (and.i dma-state dma-state #x100)
        (nop!)
        (b.z dma-state launch-next-input-page :delay (nop!))
        (nop! :count 10)
        (b wait-reusable-input-bank :delay (nop!))

        (label launch-next-input-page)
        (s.w palette-data dma-to-spr 16)
        (nop!)
        (s.w input-bank dma-to-spr 128)
        (add.i dma-state r0 64)
        (s.w dma-state dma-to-spr 32)
        (add.i dma-state r0 #x100)
        (s.w dma-state dma-to-spr)
        (add.i palette-data palette-data 1024)
        (b blend-input-page :delay (nop!))

        (label wait-last-input-page)
        (l.w dma-state dma-to-spr)
        (nop! :count 3)
        (and.i dma-state dma-state #x100)
        (nop!)
        (b.z dma-state blend-input-page :delay (nop!))
        (nop! :count 10)
        (b wait-last-input-page :delay (nop!)))

      ;; Each color occupies two quadwords containing eight packed RGBA samples. Unpack four samples
      ;; at a time to halfwords and accumulate sample*weight in the MMI HI/LO accumulator. The low
      ;; and high halves are then folded together, converted from 4.6 fixed point, saturated, and
      ;; repacked into one RGBA word.
      (asm-block blend-input-page
        (label blend-input-page)
        ;; GOAL object pointers are biased by four bytes, so offsets 12 and 28 address the two
        ;; naturally aligned quadwords at physical offsets 16 and 32 in the scratch page.
        (l.q samples03 next-input-bank 12)
        (add.i output-end data 128)
        (l.q samples47 next-input-bank 28)
        (nop!)
        (pextlb expanded r0 samples03)
        (mmi-nop!)
        (pextub samples03 r0 samples03)
        (mmi-nop!)
        (pmulth r0 expanded weight01)
        (mmi-nop!)
        (pextlb expanded r0 samples47)
        (mmi-nop!)
        (pmaddh r0 samples03 weight23)
        (mmi-nop!)
        (pextub samples47 r0 samples47)
        (mmi-nop!)
        (pmaddh r0 expanded weight45)
        (l.q expanded next-input-bank 44)
        (add.i next-input-bank next-input-bank 32)
        (nop!)
        (pmaddh r0 samples47 weight67)
        (l.q samples47 next-input-bank 28)
        (pextlb samples03 r0 expanded)
        (mmi-nop!)

        (label blend-color)
        (pextub expanded r0 expanded)
        (mmi-nop!)
        (pmfhl.lh product)
        (mmi-nop!)
        (pmulth r0 samples03 weight01)
        (mmi-nop!)
        (srl.h samples03 product 6)
        (mmi-nop!)
        (pcpyud product samples03 samples03)
        (mmi-nop!)
        (add.h samples03 product samples03)
        (mmi-nop!)
        (pminh samples03 samples03 clamp-limits)
        (mmi-nop!)
        (ppacb product r0 samples03)
        (mmi-nop!)
        (pextlb samples03 r0 samples47)
        (mmi-nop!)
        (pmaddh r0 expanded weight23)
        (s.w product data)
        (pextub samples47 r0 samples47)
        (mmi-nop!)
        (pmaddh r0 samples03 weight45)
        (l.q expanded next-input-bank 44)
        (add.i next-input-bank next-input-bank 32)
        (add.i data data 4)
        (pmaddh r0 samples47 weight67)
        (l.q samples47 next-input-bank 28)
        (b.ne data output-end blend-color :delay (pextlb samples03 r0 expanded))
        (b.ge colors-left r0 input-page-loop :delay (nop!)))
      (none)))

  (defun time-of-day-interp-colors ((data (pointer rgba))
                                    (palette time-of-day-palette)
                                    (context mood-context))
    "Blend each palette color's eight authored RGBA samples with context's packed 4.6 time-of-day
     weights. Process 32 colors per input page, clamp RGB to 255 and alpha to 128, and DMA completed
     output batches from the two scratchpad output banks into data. The final input DMA reads a full
     page past the palette's nominal height, and data receives the complete rounded block; callers
     provide accessible resource storage and a roomy work buffer, then ignore the extra colors."
    (declare (asm-func none) (allow-saved-regs))
    (rlet ((input-bank)
           (next-input-bank)
           (output-bank)
           (next-output-bank)
           (palette-data)
           (colors-left)
           (output-qwc)
           (dma-to-spr)
           (dma-from-spr)
           (dma-state)
           (clamp-limits :class i128)
           (weight01 :class i128)
           (weight23 :class i128)
           (weight45 :class i128)
           (weight67 :class i128)
           (samples03 :class i128)
           (samples47 :class i128)
           (expanded :class i128)
           (product :class i128)
           (output-end))
      ;; Output banks occupy the first two scratchpad kilobytes; palette input uses the following
      ;; two. output-qwc counts 16-byte units accumulated in the current output bank.
      (nop! :count 2)
      (l.d clamp-limits fp time-of-day-color-maxima)
      (m! output-bank #x70000010)
      (m! dma-to-spr #x1000d400)
      (m! dma-from-spr #x1000d000)
      (m! output-qwc 0)
      (l.w.field colors-left palette (height))
      (m next-output-bank output-bank)
      (l.q.field weight01 context (itimes 0))
      (lea.field palette-data palette (data))
      (l.q.field weight23 context (itimes 1))
      (add.i colors-left colors-left 31)
      (l.q.field weight45 context (itimes 2))
      (sra colors-left colors-left 5)
      (l.q.field weight67 context (itimes 3))
      (sll colors-left colors-left 5)
      (m! input-bank #x70000810)

      (asm-block start-first-input-page
        (label wait-first-input-channel)
        (l.w dma-state dma-to-spr)
        (nop! :count 3)
        (and.i dma-state dma-state #x100)
        (nop!)
        (b.nz dma-state wait-first-input-channel :delay (nop!))
        (s.w palette-data dma-to-spr 16)
        (add.i colors-left colors-left -32)
        (s.w input-bank dma-to-spr 128)
        (add.i dma-state r0 64)
        (s.w dma-state dma-to-spr 32)
        (add.i dma-state r0 #x100)
        (s.w dma-state dma-to-spr)
        (add.i palette-data palette-data 1024))

      (asm-block acquire-input-page
        (label input-page-loop)
        (m next-input-bank input-bank)
        (xor.i input-bank input-bank 1024)
        (b.le colors-left r0 wait-last-input-page :delay (add.i colors-left colors-left -32))

        (label wait-reusable-input-bank)
        (l.w dma-state dma-to-spr)
        (nop! :count 3)
        (and.i dma-state dma-state #x100)
        (nop!)
        (b.z dma-state launch-next-input-page :delay (nop!))
        (nop! :count 10)
        (b wait-reusable-input-bank :delay (nop!))

        (label launch-next-input-page)
        (s.w palette-data dma-to-spr 16)
        (nop!)
        (s.w input-bank dma-to-spr 128)
        (add.i dma-state r0 64)
        (s.w dma-state dma-to-spr 32)
        (add.i dma-state r0 #x100)
        (s.w dma-state dma-to-spr)
        (add.i palette-data palette-data 1024)
        (b blend-input-page-to-output-bank :delay (nop!))

        (label wait-last-input-page)
        (l.w dma-state dma-to-spr)
        (nop! :count 3)
        (and.i dma-state dma-state #x100)
        (nop!)
        (b.z dma-state blend-input-page-to-output-bank :delay (nop!))
        (nop! :count 10)
        (b wait-last-input-page :delay (nop!)))

      ;; Blend one 32-color page into the active output bank. Eight qwc are produced per input page,
      ;; so a 64-qwc output DMA begins after eight pages (256 colors).
      (asm-block blend-input-page
        (label blend-input-page-to-output-bank)
        (l.q samples03 next-input-bank 12)
        (add.i output-end next-output-bank 128)
        (l.q samples47 next-input-bank 28)
        (add.i output-qwc output-qwc 8)
        (pextlb expanded r0 samples03)
        (mmi-nop!)
        (pextub samples03 r0 samples03)
        (mmi-nop!)
        (pmulth r0 expanded weight01)
        (mmi-nop!)
        (pextlb expanded r0 samples47)
        (mmi-nop!)
        (pmaddh r0 samples03 weight23)
        (mmi-nop!)
        (pextub samples47 r0 samples47)
        (mmi-nop!)
        (pmaddh r0 expanded weight45)
        (l.q expanded next-input-bank 44)
        (add.i next-input-bank next-input-bank 32)
        (nop!)
        (pmaddh r0 samples47 weight67)
        (l.q samples47 next-input-bank 28)
        (pextlb samples03 r0 expanded)
        (mmi-nop!)

        (label blend-color)
        (pextub expanded r0 expanded)
        (mmi-nop!)
        (pmfhl.lh product)
        (mmi-nop!)
        (pmulth r0 samples03 weight01)
        (mmi-nop!)
        (srl.h samples03 product 6)
        (mmi-nop!)
        (pcpyud product samples03 samples03)
        (mmi-nop!)
        (add.h samples03 product samples03)
        (mmi-nop!)
        (pminh samples03 samples03 clamp-limits)
        (mmi-nop!)
        (ppacb product r0 samples03)
        (mmi-nop!)
        (pextlb samples03 r0 samples47)
        (mmi-nop!)
        (pmaddh r0 expanded weight23)
        (s.w product next-output-bank)
        (pextub samples47 r0 samples47)
        (mmi-nop!)
        (pmaddh r0 samples03 weight45)
        (l.q expanded next-input-bank 44)
        (add.i next-input-bank next-input-bank 32)
        (add.i next-output-bank next-output-bank 4)
        (pmaddh r0 samples47 weight67)
        (l.q samples47 next-input-bank 28)
        (b.ne next-output-bank output-end blend-color :delay (pextlb samples03 r0 expanded)))

      ;; Flush a full 1024-byte output bank to main memory and immediately switch to its partner,
      ;; allowing the next colors to be blended while the previous bank is copied out.
      (asm-block flush-full-output-bank
        (add.i dma-state output-qwc -64)
        (nop!)
        (b.nz dma-state continue-input-pages :delay (nop!))
        (label wait-output-channel)
        (l.w dma-state dma-from-spr)
        (nop! :count 3)
        (and.i dma-state dma-state #x100)
        (nop!)
        (b.z dma-state start-full-output-dma :delay (nop!))
        (nop! :count 10)
        (b wait-output-channel :delay (nop!))

        (label start-full-output-dma)
        (s.w output-bank dma-from-spr 128)
        (xor.i output-bank output-bank 1024)
        (s.w data dma-from-spr 16)
        (sll dma-state output-qwc 4)
        (add data data dma-state)
        (m next-output-bank output-bank)
        (s.w output-qwc dma-from-spr 32)
        (add.i dma-state r0 #x100)
        (s.w dma-state dma-from-spr)
        (m! output-qwc 0)

        (label continue-input-pages)
        (b.ge colors-left r0 input-page-loop :delay (nop!)))

      ;; A partial final bank uses its exact qwc count. Then wait for the last output DMA before
      ;; returning so the caller can consume the complete palette immediately.
      (asm-block flush-final-output
        (b.z output-qwc wait-final-output :delay (nop!))
        (label wait-tail-output-channel)
        (l.w dma-state dma-from-spr)
        (nop! :count 3)
        (and.i dma-state dma-state #x100)
        (nop!)
        (b.z dma-state start-tail-output-dma :delay (nop!))
        (nop! :count 10)
        (b wait-tail-output-channel :delay (nop!))

        (label start-tail-output-dma)
        (s.w output-bank dma-from-spr 128)
        (xor.i next-output-bank output-bank 1024)
        (s.w data dma-from-spr 16)
        (sll dma-state output-qwc 4)
        (add data data dma-state)
        (m data next-output-bank)
        (s.w output-qwc dma-from-spr 32)
        (add.i data r0 #x100)
        (s.w data dma-from-spr)
        (m! data 0)

        (label wait-final-output)
        (nop! :count 10)
        (l.w dma-state dma-from-spr)
        (nop! :count 3)
        (and.i dma-state dma-state #x100)
        (nop!)
        (b.z dma-state output-complete :delay (nop!))
        (b wait-final-output :delay (nop!))
        (label output-complete))
      (none))))

(defun init-time-of-day-context ((context time-of-day-context))
  "Initialize the fixed title-screen directional and ambient light colors and enable their levels."
  (set-vector! (-> context title-light-group dir0 color) 0.82 0.82 0.82 1.0)
  (set-vector! (-> context title-light-group dir1 color) 2.0 2.0 2.0 1.0)
  (set-vector! (-> context title-light-group ambi color) 0.5 0.5 0.5 1.0)
  (set! (-> context title-light-group dir0 levels x) 1.0)
  (set! (-> context title-light-group dir1 levels x) 1.0)
  (set! (-> context title-light-group ambi levels x) 1.0)
  (none))

(defun update-time-of-day ((context time-of-day-context))
  "Evaluate the two loaded level moods and blend their fog, sky, particles, shadows, stars, sun,
   and nine light groups according to level distance. Approach boundary changes over about five
   seconds, publish the final fog and erase colors, blend the target's selected light group and
   constrained shadow direction, then clear this frame's external palette-fade requests."
  ;; Begin with no sky or target-light override. Actors can request a target-light blend later in
  ;; the frame, after the level moods have established their base light groups.
  (set! (-> context sky) #f)
  (set! (-> context target-interp) 0.0)
  (when *target*
    (set! (-> *target* draw light-index) (the-as uint 0))
    (when (-> *target* sidekick)
      (set! (-> *target* sidekick 0 draw light-index) (the-as uint 0))
      0))
  ;; Any active level with sky geometry enables the shared sky renderer.
  (dotimes (i (-> *level* length))
    (let ((lev (-> *level* level i)))
      (when (= (-> lev status) 'active)
        (if (-> lev info sky) (set! (-> context sky) #t)))))

  (let ((level-distances (the-as (array float) (new 'stack 'boxed-array float 2))))
    ;; Keep the explicit initialization used by the PC port. The decompiler only retains the
    ;; boxed-array expression's trailing zero value, which does not prove both elements are clear.
    (set! (-> level-distances 0) 0.0)
    (set! (-> level-distances 1) 0.0)
    0.0
    (let ((active-sky-count 0)
          (current-blend (-> context current-interp)))
      (set! *lightning-frame-done* #f)
      (set! *lightning-realtime-done* #f)

      ;; Update the two simultaneously loaded level moods and remember their camera-boundary
      ;; distances. An inactive slot receives a default mood and an effectively infinite distance.
      (dotimes (level-index 2)
        (let ((lev (-> *level* level level-index)))
          (cond
            ((!= (-> lev status) 'inactive)
             (set! (-> level-distances level-index) (-> lev level-distance))
             (set! (-> context moods level-index) (-> lev mood))
             ((-> lev mood-func) (-> lev mood) (-> context time) level-index)
             (if (and (= (-> lev status) 'active) (-> lev info sky)) (+! active-sky-count 1)))
            (else
             ;; 4095996000 GOAL units is about one million meters and serves as the missing-level
             ;; sentinel in the blend selection below.
             (set! (-> level-distances level-index) 4095996000.0)
             (set! (-> context moods level-index) *default-mood*)
             (update-mood-default *default-mood* (-> context time) 0)))))

      ;; Distance zero selects that level's mood. Between boundaries, the nearer level receives the
      ;; larger share. The village2/sunken override keeps the village mood above the water plane.
      (let* ((level0-distance (-> level-distances 0))
             (level1-distance (-> level-distances 1))
             (target-blend (cond
                             ((= level1-distance 4095996000.0) 0.0)
                             ((= level0-distance 4095996000.0) 1.0)
                             ((= level0-distance level1-distance) 0.5)
                             ((and (< 0.0 (-> *math-camera* trans y))
                                   (= (-> *level* level0 name) 'village2)
                                   (= (-> *level* level1 name) 'sunken))
                              0.0)
                             ((and (< 0.0 (-> *math-camera* trans y))
                                   (= (-> *level* level0 name) 'sunken)
                                   (= (-> *level* level1 name) 'village2))
                              1.0)
                             (else (/ level0-distance (+ level0-distance level1-distance))))))
        ;; Teleports snap immediately. Otherwise the PAL and NTSC steps both produce an
        ;; approximately five-second full crossfade at their respective frame rates.
        (if *teleport* (set! current-blend target-blend))
        (when (not (or (paused?) (= target-blend current-blend)))
          (let ((blend-error (- current-blend target-blend)))
            (set! current-blend
                  (cond
                    ((= (-> *setting-control* current video-mode) 'pal)
                     (cond
                       ((< (fabs blend-error) 0.00396) target-blend)
                       ((< blend-error 0.0) (+ 0.00396 current-blend))
                       (else (+ -0.00396 current-blend))))
                    ((< (fabs blend-error) 0.0033) target-blend)
                    ((< blend-error 0.0) (+ 0.0033 current-blend))
                    (else (+ -0.0033 current-blend))))))
        (set! (-> context active-count) (the-as uint active-sky-count))
        ;; interp is the geometric target; current-interp is the smoothed value actually rendered.
        (set! (-> context interp) target-blend))

      (set! (-> context current-interp) current-blend)
      (set! *sky-drawn* #f)
      (set! *cloud-drawn* #f)
      (let ((current-fog (-> context current-fog)))
        (cond
          ;; Exact endpoints can copy the complete mood directly.
          ((= current-blend 0.0)
           (let ((level0-fog (-> context moods 0 current-fog)))
             (vector-copy! (-> current-fog fog-color) (-> level0-fog fog-color))
             (vector-copy! (-> current-fog fog-dists) (-> level0-fog fog-dists))
             (vector-copy! (-> current-fog erase-color) (-> level0-fog erase-color)))
           (vector-copy! (-> context current-prt-color) (-> context moods 0 current-prt-color))
           (vector-copy! (-> context current-sun sun-color) (-> context moods 0 current-sun sun-color))
           (vector-copy! (-> context current-sun env-color) (-> context moods 0 current-sun env-color))
           (vector-copy! (-> context current-shadow) (-> context moods 0 current-shadow))
           (vector-copy! (-> context current-shadow-color) (-> context moods 0 current-shadow-color))
           (dotimes (group-index 8)
             (quad-copy! (the-as pointer (-> context light-group group-index))
                         (the-as pointer (-> context moods 0 light-group group-index))
                         12))
           (set! (-> context num-stars) (-> context moods 0 num-stars))
           (set! (-> context sun-fade) (-> *level* level0 info sun-fade)))
          ((= current-blend 1.0)
           (let ((level1-fog (-> context moods 1 current-fog)))
             (vector-copy! (-> current-fog fog-color) (-> level1-fog fog-color))
             (vector-copy! (-> current-fog fog-dists) (-> level1-fog fog-dists))
             (vector-copy! (-> current-fog erase-color) (-> level1-fog erase-color)))
           (vector-copy! (-> context current-prt-color) (-> context moods 1 current-prt-color))
           (vector-copy! (-> context current-sun sun-color) (-> context moods 1 current-sun sun-color))
           (vector-copy! (-> context current-sun env-color) (-> context moods 1 current-sun env-color))
           (vector-copy! (-> context current-shadow) (-> context moods 1 current-shadow))
           (vector-copy! (-> context current-shadow-color) (-> context moods 1 current-shadow-color))
           (dotimes (group-index 8)
             (quad-copy! (the-as pointer (-> context light-group group-index))
                         (the-as pointer (-> context moods 1 light-group group-index))
                         12))
           (set! (-> context num-stars) (-> context moods 1 num-stars))
           (set! (-> context sun-fade) (-> *level* level1 info sun-fade)))
          (else
           (let ((level0-fog (-> context moods 0 current-fog))
                 (level1-fog (-> context moods 1 current-fog)))
             (vector4-lerp! (-> current-fog fog-color) (-> level0-fog fog-color) (-> level1-fog fog-color) current-blend)
             (vector4-lerp! (-> current-fog fog-dists) (-> level0-fog fog-dists) (-> level1-fog fog-dists) current-blend)
             (vector4-lerp! (-> current-fog erase-color) (-> level0-fog erase-color) (-> level1-fog erase-color) current-blend))
           (vector4-lerp! (-> context current-prt-color)
                          (-> context moods 0 current-prt-color)
                          (-> context moods 1 current-prt-color)
                          current-blend)
           (vector4-lerp! (-> context current-sun sun-color)
                          (-> context moods 0 current-sun sun-color)
                          (-> context moods 1 current-sun sun-color)
                          current-blend)
           (vector4-lerp! (-> context current-sun env-color)
                          (-> context moods 0 current-sun env-color)
                          (-> context moods 1 current-sun env-color)
                          current-blend)
           (vector4-lerp! (-> context current-shadow)
                          (-> context moods 0 current-shadow)
                          (-> context moods 1 current-shadow)
                          current-blend)
           (vector4-lerp! (-> context current-shadow-color)
                          (-> context moods 0 current-shadow-color)
                          (-> context moods 1 current-shadow-color)
                          current-blend)

           ;; A light-group contains three directional lights and one ambient light. The raw base
           ;; offset 156 is the logical field offset 160 adjusted by GOAL's four-byte basic-pointer
           ;; bias; each light is 48 bytes and each complete group is 192 bytes.
           (dotimes (group-index 8)
             (dotimes (light-index 3)
               (let ((dst-light (+ (+ (* 48 light-index) 156 (* 192 group-index)) (the-as int context))))
                 (let ((level0-light (+ (+ (* 48 light-index) 156 (* 192 group-index)) (the-as int (-> context moods 0))))
                       (level1-light (+ (+ (* 48 light-index) 156 (* 192 group-index)) (the-as int (-> context moods 1)))))
                   (vector4-lerp! (the-as vector (+ dst-light 0))
                                  (the-as vector (+ level0-light 0))
                                  (the-as vector (+ level1-light 0))
                                  current-blend)
                   (vector4-lerp! (the-as vector (+ dst-light 16))
                                  (the-as vector (+ level0-light 16))
                                  (the-as vector (+ level1-light 16))
                                  current-blend)
                   (vector4-lerp! (the-as vector (+ dst-light 32))
                                  (the-as vector (+ level0-light 32))
                                  (the-as vector (+ level1-light 32))
                                  current-blend))
                 (vector-normalize! (the-as vector (+ dst-light 0)) 1.0)))
             (let ((dst-ambient (+ (the-as uint (-> context light-group 0 ambi)) (* 192 group-index)))
                   (level0-ambient (+ (the-as uint (-> context moods 0 light-group 0 ambi)) (* 192 group-index)))
                   (level1-ambient (+ (the-as uint (-> context moods 1 light-group 0 ambi)) (* 192 group-index))))
               (vector4-lerp! (the-as vector (+ dst-ambient 0))
                              (the-as vector (+ level0-ambient 0))
                              (the-as vector (+ level1-ambient 0))
                              current-blend)
               (vector4-lerp! (the-as vector (+ dst-ambient 16))
                              (the-as vector (+ level0-ambient 16))
                              (the-as vector (+ level1-ambient 16))
                              current-blend)
               (vector4-lerp! (the-as vector (+ dst-ambient 32))
                              (the-as vector (+ level0-ambient 32))
                              (the-as vector (+ level1-ambient 32))
                              current-blend)))
           (set! (-> context num-stars)
                 (+ (-> context moods 0 num-stars)
                    (* (- (-> context moods 1 num-stars) (-> context moods 0 num-stars)) current-blend)))
           (let ((level0-sun-fade (-> *level* level0 info sun-fade)))
             (set! (-> context sun-fade)
                   (+ level0-sun-fade (* current-blend (- (-> *level* level1 info sun-fade) level0-sun-fade)))))))

        ;; Generate both interpolated sky texture sets, then make the base sky polygon ring match
        ;; the current erase color so it meets the clear without a seam.
        (dotimes (i 2)
          (make-sky-textures context i))
        (vector-copy! (-> sky-base-polygons 0 col) (-> current-fog erase-color))
        (vector-copy! (-> sky-base-polygons 1 col) (-> current-fog erase-color))
        (vector-copy! (-> sky-base-polygons 2 col) (-> current-fog erase-color))
        (vector-copy! (-> sky-base-polygons 3 col) (-> current-fog erase-color))
        (vector-copy! (-> sky-base-polygons 4 col) (-> current-fog erase-color))
        (vector-copy! (-> sky-base-polygons 5 col) (-> current-fog erase-color))
        (vector-copy! (-> sky-base-polygons 6 col) (-> current-fog erase-color))
        (vector-copy! (-> sky-base-polygons 7 col) (-> current-fog erase-color))
        (vector-copy! (-> sky-base-polygons 8 col) (-> current-fog erase-color))
        (vector-copy! (-> sky-base-polygons 9 col) (-> current-fog erase-color))
        (vector-copy! (-> sky-base-polygons 10 col) (-> current-fog erase-color))
        (vector-copy! (-> sky-base-polygons 11 col) (-> current-fog erase-color)))))

  ;; The GS treats 128 as a 1.0 texture-modulation component. Convert the authored 0..255
  ;; environment color into that scale before it is packed for rendering.
  (set! (-> context current-sun env-color x) (* 0.5019608 (-> context current-sun env-color x)))
  (set! (-> context current-sun env-color y) (* 0.5019608 (-> context current-sun env-color y)))
  (set! (-> context current-sun env-color z) (* 0.5019608 (-> context current-sun env-color z)))
  (set! (-> context current-sun env-color w) (* 0.5019608 (-> context current-sun env-color w)))
  (let ((current-fog (-> context current-fog)))
    (set! *fog-color*
          (new 'static
               'rgba
               :r
               (the int (-> current-fog fog-color x))
               :g
               (the int (-> current-fog fog-color y))
               :b
               (the int (-> current-fog fog-color z)))))
  (let ((erase-color (-> context current-fog erase-color)))
    (set! (-> context erase-color)
          (new 'static
               'rgba
               :a #x80
               :b
               (the int (-> erase-color z))
               :g
               (the int (-> erase-color y))
               :r
               (the int (-> erase-color x)))))
  (set! (-> *math-camera* fog-start) (-> context current-fog fog-dists x))
  (set! (-> *math-camera* fog-end) (-> context current-fog fog-dists y))
  (set! (-> *math-camera* fog-max) (-> context current-fog fog-dists z))
  (set! (-> *math-camera* fog-min) (-> context current-fog fog-dists w))

  ;; interp target lights. (note: added check here.)
  (let* ((target-light-index (if *target* (-> *target* draw light-index) 0))
         (target-light-blend (-> context target-interp))
         (base-light-group (-> context light-group))
         (target-light-group (-> context light-group target-light-index)))
    (when (nonzero? target-light-index)
      (cond
        ((= target-light-blend 1.0))
        ((= target-light-blend 0.0)
         (quad-copy! (the-as pointer (-> context light-group target-light-index)) (the-as pointer (-> context light-group)) 12))
        (else
         (dotimes (light-index 4)
           (vector4-lerp! (the-as vector (+ (the-as uint (-> target-light-group dir0)) (* 48 light-index)))
                          (the-as vector (+ (the-as uint (-> base-light-group 0)) (* 48 light-index)))
                          (the-as vector (+ (the-as uint (-> target-light-group dir0)) (* 48 light-index)))
                          target-light-blend)
           (vector4-lerp! (the-as vector (+ (the-as uint (-> target-light-group dir0 color)) (* 48 light-index)))
                          (the-as vector (+ (the-as uint (-> base-light-group 0 dir0 color)) (* 48 light-index)))
                          (the-as vector (+ (the-as uint (-> target-light-group dir0 color)) (* 48 light-index)))
                          target-light-blend)
           (vector4-lerp! (the-as vector (+ (the-as uint (-> target-light-group dir0 levels)) (* 48 light-index)))
                          (the-as vector (+ (the-as uint (-> base-light-group 0 dir0 levels)) (* 48 light-index)))
                          (the-as vector (+ (the-as uint (-> target-light-group dir0 levels)) (* 48 light-index)))
                          target-light-blend)
           (vector-normalize! (the-as vector (+ (the-as uint (-> target-light-group dir0)) (* 48 light-index))) 1.0))))

      ;; Shadows travel opposite the primary light. When that direction would lie more than
      ;; 25 degrees from straight down, keep the horizontal bearing but clamp it to the 25-degree
      ;; cone: cos(25)=0.9063 vertically and sin(25)=0.4226 in the horizontal plane.
      (let ((shadow-direction (new 'stack-no-clear 'vector)))
        (set! (-> shadow-direction x) (- (-> target-light-group dir0 direction x)))
        (set! (-> shadow-direction y) (- (-> target-light-group dir0 direction y)))
        (set! (-> shadow-direction z) (- (-> target-light-group dir0 direction z)))
        (when (< (-> target-light-group dir0 direction y) 0.9063)
          (let ((horizontal-scale (/ 0.4226 (sqrtf (+ (square (-> shadow-direction x)) (square (-> shadow-direction z)))))))
            (set! (-> shadow-direction x) (* (-> shadow-direction x) horizontal-scale))
            (set! (-> shadow-direction y) -0.9063)
            (set! (-> shadow-direction z) (* (-> shadow-direction z) horizontal-scale))))
        (vector4-lerp! (-> context current-shadow) (-> context current-shadow) shadow-direction target-light-blend))
      (vector-normalize! (-> context current-shadow) 1.0)))
  (reset! *palette-fade-controls*)
  0
  (none))

(defmethod set-fade! ((this palette-fade-controls) (index int) (fade float) (actor-distance float) (trans vector))
  "Submit fade for slot index. Keep it only when actor-distance is nearer than the
   request already stored this frame; clamp fade to 0 through 1.993 and optionally
   copy trans for distance falloff."
  (cond
    ((and (>= index 0) (< index 8))
     (let ((control (-> this control index)))
       (when (< actor-distance (-> control actor-dist))
         (if trans (vector-copy! (-> control trans) trans))
         (set! (-> control fade) (fmax 0.0 (fmin 1.993 fade)))
         (set! (-> control actor-dist) actor-distance))))
    (else (format 0 "ERROR: Bogus palette-fade-control index!~%"))))

(defmethod reset! ((this palette-fade-controls))
  "Clear all eight fade requests and restore their nearest-actor distances."
  (countdown (i 8)
    (let ((control (-> this control i))) (set! (-> control fade) 0.0) (set! (-> control actor-dist) 4096000000.0)))
  #f)

;; start the time of day process!!
(start-time-of-day)

(defun check-drop-level-rain ((system sparticle-system) (particle sparticle-cpuinfo) (particle-transform vector))
  "Kill a rain particle after its position falls below particle's user-float impact height, then
   launch a splash and expanding water ring at that height."
  (when (< (-> particle-transform y) (-> particle user-float))
    (let ((splash-position (new 'stack-no-clear 'vector)))
      (sp-kill-particle system particle)
      (set-vector! splash-position (-> particle-transform x) (-> particle user-float) (-> particle-transform z) 1.0)
      (launch-particles (-> *part-id-table* 39) splash-position :rate 1.0)
      (launch-particles :system *sp-particle-system-3d* (-> *part-id-table* 40) splash-position :rate 1.0)))
  (none))

(defun update-rain ((target target))
  "Launch rain around target and compensate each streak's width and height for camera pitch, making
   long narrow streaks near a horizontal view and shorter wider streaks near a vertical view. A
   sufficiently positive vertical camera-axis component also sends the camera a ten-second
   screen-droplet effect with pitch-controlled amount and fall speed."
  (let ((horizontal-velocity (new 'stack-no-clear 'vector)))
    (set! (-> horizontal-velocity x) (-> target control transv x))
    (set! (-> horizontal-velocity y) 0.0)
    (set! (-> horizontal-velocity z) (-> target control transv z))
    (set! (-> horizontal-velocity w) 1.0)
    (let ((spawn-position (vector+float*! (new 'stack-no-clear 'vector) (-> target control trans) horizontal-velocity 0.0)))
      (let* ((camera-local-to-world (matrix-local->world #f #f))
             (drop-width (lerp-scale 122.88 245.76 (fabs (-> camera-local-to-world vector 2 y)) 0.0 0.7))
             (drop-height (lerp-scale 2048.0 245.76 (fabs (-> camera-local-to-world vector 2 y)) 0.0 0.7)))
        (let ((screen-drip-amount (lerp-scale 0.0 0.1 (-> camera-local-to-world vector 2 y) 0.3 0.7))
              (screen-drip-speed (lerp-scale 1.0 0.1 (-> camera-local-to-world vector 2 y) 0.3 0.7)))
          (if (< 0.0 screen-drip-amount) (send-event *camera* 'part-water-drip screen-drip-amount screen-drip-speed)))
        (set! (-> *part-id-table* 37 init-specs 4 initial-valuef) drop-width)
        (set! (-> *part-id-table* 37 init-specs 4 random-rangef) drop-width)
        (set! (-> *part-id-table* 38 init-specs 4 initial-valuef) drop-width)
        (set! (-> *part-id-table* 38 init-specs 4 random-rangef) drop-width)
        (set! (-> *part-id-table* 37 init-specs 5 initial-valuef) drop-height)
        (set! (-> *part-id-table* 37 init-specs 5 random-rangef) drop-height)
        (set! (-> *part-id-table* 38 init-specs 5 initial-valuef) drop-height)
        (set! (-> *part-id-table* 38 init-specs 5 random-rangef) drop-height))
      (launch-particles (-> *part-id-table* 37) spawn-position)
      (launch-particles (-> *part-id-table* 38) spawn-position)))
  0
  (none))

(defbehavior cam-master-effect camera-master ()
  "Drive the camera-space rain droplets for ten seconds after a part-water-drip event. Apply the
   event's amount to both droplet sizes, scale their downward acceleration by its speed, and spawn
   the camera's water-drip launch control."
  (when (< (+ (current-time) (seconds -10)) (-> self water-drip-time))
    (set! (-> *part-id-table* 21 init-specs 1 initial-valuef) (-> self water-drip-mult))
    (set! (-> *part-id-table* 18 init-specs 1 initial-valuef) (* 0.9 (-> self water-drip-mult)))
    (set! (-> *part-id-table* 22 init-specs 11 initial-valuef) (* -2.7306666 (-> self water-drip-speed)))
    (set! (-> *part-id-table* 23 init-specs 8 initial-valuef) (* -2.7306666 (-> self water-drip-speed)))
    (set! (-> *part-id-table* 19 init-specs 11 initial-valuef) (* -2.7306666 (-> self water-drip-speed)))
    (set! (-> *part-id-table* 20 init-specs 8 initial-valuef) (* -2.7306666 (-> self water-drip-speed)))
    (spawn (-> self water-drip) *zero-vector*))
  0
  (none))

(defun sparticle-track-sun ((system sparticle-system) (particle sparticle-cpuinfo) (particle-data matrix))
  "Place one sun sprite at the selected sky sun relative to the camera. particle's user-float
   selects sun zero or one and its core or halo layer; normal-sun layers take the current
   time-of-day sun color, with quarter-brightness halos, while green-sun layers retain their
   authored colors. Scale nonzero alpha by the current sun fade."
  (-> particle key)
  (let ((layer-index (the int (-> particle user-float))))
    (let* ((camera-position (math-camera-pos))
           (sun-data (-> *sky-parms* upload-data sun (/ layer-index 4)))
           (world-position (vector+float*! (new 'stack-no-clear 'vector) camera-position (-> sun-data pos) 4096.0)))
      (set! (-> particle-data vector 0 x) (-> world-position x))
      (set! (-> particle-data vector 0 y) (-> world-position y))
      (set! (-> particle-data vector 0 z) (-> world-position z)))
    (if (!= (-> particle-data vector 2 w) 0.0)
      (set! (-> particle-data vector 2 w) (* 128.0 (-> *time-of-day-context* sun-fade))))
    (cond
      ((zero? layer-index)
       (set! (-> particle-data vector 2 x) (-> *time-of-day-context* current-sun sun-color x))
       (set! (-> particle-data vector 2 y) (-> *time-of-day-context* current-sun sun-color y))
       (set! (-> particle-data vector 2 z) (-> *time-of-day-context* current-sun sun-color z)))
      ((or (= layer-index 1) (= layer-index 2))
       (set! (-> particle-data vector 2 x) (/ (-> *time-of-day-context* current-sun sun-color x) 4))
       (set! (-> particle-data vector 2 y) (/ (-> *time-of-day-context* current-sun sun-color y) 4))
       (set! (-> particle-data vector 2 z) (/ (-> *time-of-day-context* current-sun sun-color z) 4)))))
  0
  (none))


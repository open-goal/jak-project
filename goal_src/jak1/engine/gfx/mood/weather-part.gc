(defun update-snow ((target target))
  "Launch snow around target. As target speed rises from 2048 to 40960, crossfade from the
   low-speed snow emitter to four fast flakes and turn the fast emitter a half-turn from the
   target's horizontal velocity heading."
  (let ((target-position (-> target control trans)))
    (let ((speed-blend (lerp-scale 0.0 1.0 (vector-length (-> target control transv)) 2048.0 40960.0)))
      (set! (-> *part-id-table* 34 init-specs 1 initial-valuef) (- 1.0 speed-blend))
      (set! (-> *part-id-table* 33 init-specs 1 initial-valuef) (* 4.0 speed-blend)))
    (set! (-> *part-id-table* 33 init-specs 19 initial-valuef) (+ 32768.0 (vector-y-angle (-> target control transv))))
    (launch-particles (-> *part-id-table* 34) target-position)
    (launch-particles (-> *part-id-table* 33) target-position))
  0
  (none))


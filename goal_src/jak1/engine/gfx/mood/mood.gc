(defun update-mood-rolling ((context mood-context) (hour float) (level-index int))
  "Update Precursor Basin's mood and target lighting near its rolling hazards. Each authored
   vector stores a center in xyz and radius in w; the five-entry light2 group uses the four matrix
   rows and color slot of a light-ellipse as contiguous vector storage."
  (update-mood-fog context hour)
  (update-mood-sky-texture context hour)
  (clear-mood-times context)
  (update-mood-palette context hour level-index)
  (when *time-of-day-effects*
    (update-mood-light context 4 0 4 0.875 0.25 hour 32)
    (update-mood-light context 5 1 4 0.875 0.25 hour 0)
    (update-mood-light context 6 2 4 0.875 0.25 hour 96)
    (update-mood-light context 7 3 4 0.875 0.25 hour 64)
    (if (not (paused?)) (+! (-> context state 4) 1))
    (update-mood-lightning context 2 2 5 2 0.5 #t))
  (let ((group (-> context light-group 1))) (update-light-kit group (-> context light-group 0 ambi) 1.0))
  (dotimes (i 4)
    (let ((group (-> context light-group (+ i 2))))

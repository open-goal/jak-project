(deftype snow-states (structure)
  ((flames   flames-state :inline)
   (light    light-state :inline)
   (time     light-time-state :inline)
   (one-shot uint8)
   (interp   float)))

(defun update-mood-snow ((context mood-context) (hour float) (level-index int))
  "Update Snowy Mountain's mood, lightning, fortress lighting transition, and local target light."
  (update-mood-fog context hour)
  (update-mood-sky-texture context hour)
  (clear-mood-times context)
  (update-mood-palette context hour level-index)
  (when *time-of-day-effects*
    (update-mood-flames context 4 3 0 0.45 0.001953125 1.0)
    (let ((mood-state (the-as snow-states (-> context state))))
      (let ((egg-top-reminder (get-reminder (get-task-control (game-task snow-eggtop)) 4))
            (transition-time (-> mood-state one-shot)))
        (cond
          ((and (= egg-top-reminder 2) (nonzero? transition-time))
           (if (< (the-as uint 60) transition-time)
             (set! (-> context times 7 w) 2.0)
             (set! (-> context times 7 w) (* 0.033333335 (the float transition-time))))
           (if (not (paused?)) (set! (-> mood-state one-shot) (+ transition-time -1))))
          ((and (nonzero? egg-top-reminder) (!= transition-time 180))
           (set! (-> context state 6) (the-as uint 0))
           (update-mood-light context 7 4 5 0.875 0.25 20.0 32)
           (if (not (paused?)) (+! (-> context state 5) 1)))
          (else
           (set! (-> context state 6) (the-as uint 180))
           (set! (-> context state 5) (the-as uint 0))
           (set! (-> context state 4) (the-as uint 255)))))
      (let ((weather-blend (-> mood-state interp)))
        (when (not (paused?))
          (let ((next-weather-blend (if *weather-off* (+ 0.1 weather-blend) (+ -0.1 weather-blend))))
            (set! weather-blend (fmax 0.0 (fmin 1.0 next-weather-blend))))
          (set! (-> mood-state interp) weather-blend))
        (vector4-lerp! (-> context current-sun env-color)
                       (-> context current-sun env-color)
                       (-> context mood-sun-table data 6 env-color)
                       weather-blend))))
  (update-mood-itimes context)
  0
  (none))


;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/game/game-info.gc")
(require "engine/gfx/mood/time-of-day-h.gc")
(require "engine/gfx/foreground/bones-h.gc")
(require "engine/gfx/mood/mood-tables.gc")

;; note: modified for high fps

;; DECOMP BEGINS

(defun clear-mood-times ((context mood-context))
  "Clear the eight time-of-day palette weights in context."
  (dotimes (i 8)
    (set! (-> context times i w) 0.0))
  #f)

(defun update-light-kit ((group light-group) (source-light light) (level float))
  "Copy source-light's color into group's ambient light and apply level to its intensity."
  (set! (-> group ambi color quad) (-> source-light color quad))
  (set! (-> group ambi levels x) (* (-> source-light levels x) level))
  (none))

(defun set-target-light-index ((light-index int))
  "Select the target and sidekick light group, when they exist."
  (when *target*
    (set! (-> *target* draw light-index) (the-as uint light-index))
    (when (-> *target* sidekick)
      (set! (-> *target* sidekick 0 draw light-index) (the-as uint light-index))
      light-index)))

(#when PC_PORT
  (defun update-mood-itimes ((context mood-context))
    "Convert the eight floating palette weights into the packed values used by time-of-day palette
     interpolation. Each times vector has one in xyz and its weight in w, so multiplying xyz by w
     broadcasts the weight. Conversion to 20.12 fixed point followed by a six-bit arithmetic shift
     produces 4.6 values; packing pairs of 32-bit lanes into high halfwords stores all eight weights
     in four itimes quadwords."
    (local-vars
      (slot0-raw uint128)
      (slot0-fixed uint128)
      (packed01 uint128)
      (packed45 uint128)
      (slot1-raw uint128)
      (slot1-fixed uint128)
      (packed23 uint128)
      (packed67 uint128)
      (slot2-raw uint128)
      (slot2-fixed uint128)
      (slot3-raw uint128)
      (slot3-fixed uint128)
      (slot4-raw uint128)
      (slot4-fixed uint128)
      (slot5-raw uint128)
      (slot5-fixed uint128)
      (slot6-raw uint128)
      (slot6-fixed uint128)
      (slot7-raw uint128)
      (slot7-fixed uint128))
    ;; og:preserve-this pc mood debug
    (with-pc
      (case *mood-override-debug*
        (('copy #t) (dotimes (mti 8) (set! (-> context times mti w) (-> *mood-override-table* mti))))
        (('mult) (dotimes (mti 8) (*! (-> context times mti w) (-> *mood-override-table* mti))))))
    (rlet ((vf1 :class vf)
           (vf2 :class vf)
           (vf3 :class vf)
           (vf4 :class vf)
           (vf5 :class vf)
           (vf6 :class vf)
           (vf7 :class vf)
           (vf8 :class vf))
      (nop!)
      (nop!)
      (.lvf vf1 (&-> context times 0 quad))
      (nop!)
      (.lvf vf2 (&-> context times 1 quad))
      (.mul.w.vf.xyz vf1 vf1 vf1)
      (.lvf vf3 (&-> context times 2 quad))
      (.mul.w.vf.xyz vf2 vf2 vf2)
      (.lvf vf4 (&-> context times 3 quad))
      (.mul.w.vf.xyz vf3 vf3 vf3)
      (.lvf vf5 (&-> context times 4 quad))
      (.mul.w.vf.xyz vf4 vf4 vf4)
      (.lvf vf6 (&-> context times 5 quad))
      (.mul.w.vf.xyz vf5 vf5 vf5)
      (.lvf vf7 (&-> context times 6 quad))
      (.mul.w.vf.xyz vf6 vf6 vf6)
      (.lvf vf8 (&-> context times 7 quad))
      (.mul.w.vf.xyz vf7 vf7 vf7)
      (nop!)
      (.mul.w.vf.xyz vf8 vf8 vf8)
      (nop!)
      (vftoi12.xyzw vf1 vf1)
      (nop!)
      (vftoi12.xyzw vf2 vf2)
      (nop!)
      (vftoi12.xyzw vf3 vf3)
      (nop!)
      (vftoi12.xyzw vf4 vf4)
      (nop!)
      (vftoi12.xyzw vf5 vf5)
      (nop!)
      (vftoi12.xyzw vf6 vf6)
      (nop!)
      (vftoi12.xyzw vf7 vf7)
      (nop!)
      (vftoi12.xyzw vf8 vf8)
      (nop!)
      (.mov slot0-raw vf1)
      (nop!)
      (.mov slot1-raw vf2)
      (nop!)
      (.mov slot2-raw vf3)
      (.pw.sra slot0-fixed slot0-raw 6)
      (.mov slot3-raw vf4)
      (.pw.sra slot1-fixed slot1-raw 6)
      (.mov slot4-raw vf5)
      (.pw.sra slot2-fixed slot2-raw 6)
      (.mov slot5-raw vf6)
      (.pw.sra slot3-fixed slot3-raw 6)
      (.mov slot6-raw vf7)
      (.pw.sra slot4-fixed slot4-raw 6)
      (.mov slot7-raw vf8)
      (.pw.sra slot5-fixed slot5-raw 6)
      (.pw.sra slot6-fixed slot6-raw 6)
      (nop!)
      (.pw.sra slot7-fixed slot7-raw 6)
      (nop!)
      (.ppach packed01 slot1-fixed slot0-fixed)
      (nop!)
      (.ppach packed23 slot3-fixed slot2-fixed)
      (set! (-> context itimes 0 quad) packed01)
      (.ppach packed45 slot5-fixed slot4-fixed)
      (set! (-> context itimes 1 quad) packed23)
      (.ppach packed67 slot7-fixed slot6-fixed)
      (set! (-> context itimes 2 quad) packed45)
      (nop!)
      (set! (-> context itimes 3 quad) packed67)
      0
      (none))))

(#unless PC_PORT
  (defun update-mood-itimes ((context mood-context))
    "Convert the eight floating palette weights into the packed values used by time-of-day palette
     interpolation. Each times vector has one in xyz and its weight in w, so multiplying xyz by w
     broadcasts the weight. Conversion to 20.12 fixed point followed by a six-bit arithmetic shift
     produces 4.6 values; packing pairs of 32-bit lanes into high halfwords stores all eight weights
     in four itimes quadwords."
    (rlet ((time-data (&-> context times 0 quad))
           (itime-data (&-> context itimes 0 quad))
           (time0 :reg vf1)
           (time1 :reg vf2)
           (time2 :reg vf3)
           (time3 :reg vf4)
           (time4 :reg vf5)
           (time5 :reg vf6)
           (time6 :reg vf7)
           (time7 :reg vf8)
           (slot0-raw :class i128)
           (slot0-fixed :class i128)
           (packed01 :class i128)
           (packed45 :class i128)
           (slot1-raw :class i128)
           (slot1-fixed :class i128)
           (packed23 :class i128)
           (packed67 :class i128)
           (slot2-raw :class i128)
           (slot2-fixed :class i128)
           (slot3-raw :class i128)
           (slot3-fixed :class i128)
           (slot4-raw :class i128)
           (slot4-fixed :class i128)
           (slot5-raw :class i128)
           (slot5-fixed :class i128)
           (slot6-raw :class i128)
           (slot6-fixed :class i128)
           (slot7-raw :class i128)
           (slot7-fixed :class i128))
      (nop!)
      (nop!)
      (l.vf time0 time-data)
      (nop!)
      (l.vf time1 time-data 16)
      (mul.w.vf.xyz time0 time0 time0)
      (l.vf time2 time-data 32)
      (mul.w.vf.xyz time1 time1 time1)
      (l.vf time3 time-data 48)
      (mul.w.vf.xyz time2 time2 time2)
      (l.vf time4 time-data 64)
      (mul.w.vf.xyz time3 time3 time3)
      (l.vf time5 time-data 80)
      (mul.w.vf.xyz time4 time4 time4)
      (l.vf time6 time-data 96)
      (mul.w.vf.xyz time5 time5 time5)
      (l.vf time7 time-data 112)
      (mul.w.vf.xyz time6 time6 time6)
      (nop!)
      (mul.w.vf.xyz time7 time7 time7)
      (nop!)
      (ftoi.vf time0 time0 :fixed 12)
      (nop!)
      (ftoi.vf time1 time1 :fixed 12)
      (nop!)
      (ftoi.vf time2 time2 :fixed 12)
      (nop!)
      (ftoi.vf time3 time3 :fixed 12)
      (nop!)
      (ftoi.vf time4 time4 :fixed 12)
      (nop!)
      (ftoi.vf time5 time5 :fixed 12)
      (nop!)
      (ftoi.vf time6 time6 :fixed 12)
      (nop!)
      (ftoi.vf time7 time7 :fixed 12)
      (nop!)
      (m slot0-raw time0)
      (nop!)
      (m slot1-raw time1)
      (nop!)
      (m slot2-raw time2)
      (sra.w slot0-fixed slot0-raw 6)
      (m slot3-raw time3)
      (sra.w slot1-fixed slot1-raw 6)
      (m slot4-raw time4)
      (sra.w slot2-fixed slot2-raw 6)
      (m slot5-raw time5)
      (sra.w slot3-fixed slot3-raw 6)
      (m slot6-raw time6)
      (sra.w slot4-fixed slot4-raw 6)
      (m slot7-raw time7)
      (sra.w slot5-fixed slot5-raw 6)
      (sra.w slot6-fixed slot6-raw 6)
      (mmi-nop!)
      (sra.w slot7-fixed slot7-raw 6)
      (mmi-nop!)
      (ppach packed01 slot1-fixed slot0-fixed)
      (mmi-nop!)
      (ppach packed23 slot3-fixed slot2-fixed)
      (s.q packed01 itime-data)
      (ppach packed45 slot5-fixed slot4-fixed)
      (s.q packed23 itime-data 16)
      (ppach packed67 slot7-fixed slot6-fixed)
      (s.q packed45 itime-data 32)
      (nop!)
      (s.q packed67 itime-data 48)
      0
      (none))))

(defun update-mood-prt-color ((context mood-context))
  "Derive a missing particle tint from seventy-five percent ambient light and twenty-five percent
   blended directional light, then copy it to the current shadow color."
  (let* ((groups (-> context light-group))
         (ambient-color (-> groups 0 ambi color))
         (directional-color (new 'stack-no-clear 'vector)))
    (vector4-lerp! directional-color (-> groups 0 dir0 color) (-> groups 0 dir1 color) (-> groups 0 dir1 levels x))
    (set! (-> context current-prt-color x)
          (* 0.5 (+ (-> ambient-color x) (* 0.5 (+ (-> ambient-color x) (-> directional-color x))))))
    (set! (-> context current-prt-color y)
          (* 0.5 (+ (-> ambient-color y) (* 0.5 (+ (-> ambient-color y) (-> directional-color y))))))
    (set! (-> context current-prt-color z)
          (* 0.5 (+ (-> ambient-color z) (* 0.5 (+ (-> ambient-color z) (-> directional-color z))))))
    (set! (-> context current-prt-color w)
          (* 0.5 (+ (-> ambient-color w) (* 0.5 (+ (-> ambient-color w) (-> directional-color w)))))))
  (let ((shadow-color (-> context current-shadow-color)))
    (set! (-> shadow-color quad) (-> context current-prt-color quad))
    shadow-color))

(defun update-mood-palette ((context mood-context) (hour float) (level-index int))
  "Interpolate context's particle, shadow, ambient, and directional lighting for hour. The two
   selected palette weights are quantized to sixty-fourths, and level-index selects the active
   level's light-mask entries."
  (let ((groups (-> context light-group)))
    (set! (-> groups 0 dir0 levels x) 0.0)
    (set! (-> groups 0 dir1 levels x) 0.0)
    (set! (-> groups 0 dir2 levels x) 0.0))
  0
  0
  0.0
  (let* ((groups (-> context light-group))
         (whole-hour (the int hour))
         (hour-fraction (- hour (the float whole-hour)))
         (inverse-hour-fraction (- 1.0 hour-fraction))
         (day (/ whole-hour 24))
         (hour-entry (-> context palette-interp hour (- whole-hour (* 24 day))))
         (snapshot-a-index (-> hour-entry snapshot1))
         (snapshot-b-index (-> hour-entry snapshot2))
         (blend (+ (* inverse-hour-fraction (-> hour-entry morph-start)) (* hour-fraction (-> hour-entry morph-end)))))
    (cond
      ((= snapshot-a-index snapshot-b-index)
       (let ((snapshot (-> context mood-lights-table data snapshot-a-index)))
         (set! (-> context times snapshot-a-index w) 1.0)
         (set! (-> context current-prt-color quad) (-> snapshot prt-color quad))
         (set! (-> groups 0 ambi color quad) (-> snapshot amb-color quad))
         (set! (-> groups 0 ambi levels x) 1.0)
         (set! (-> context current-shadow quad) (-> snapshot shadow quad))
         (let ((color-level (+ (* 2.0 (-> snapshot lgt-color x)) (* 4.0 (-> snapshot lgt-color y)) (-> snapshot lgt-color z))))
           (set! (-> groups 0 dir0 direction quad) (-> snapshot direction quad))
           (set! (-> groups 0 dir0 color quad) (-> snapshot lgt-color quad))
           (set! (-> groups 0 dir0 levels x) 1.0)
           (set! (-> groups 0 dir0 levels y) color-level)))
       (set! (-> *time-of-day-context* light-masks-0 level-index) (the-as uint (ash 1 snapshot-a-index)))
       (set! (-> *time-of-day-context* light-masks-1 level-index) (the-as uint 0))
       (set! (-> *time-of-day-context* light-interp level-index) 0.0))
      (else
       (let ((snapshot-a (-> context mood-lights-table data snapshot-a-index))
             (snapshot-b (-> context mood-lights-table data snapshot-b-index)))
         (let ((quantized-blend (the int (+ 0.5 (* 64.0 blend)))))
           (set! (-> context times snapshot-a-index w) (* 0.015625 (the float (- 64 quantized-blend))))
           (set! (-> context times snapshot-b-index w) (* 0.015625 (the float quantized-blend))))
         (vector4-lerp! (-> context current-prt-color) (-> snapshot-a prt-color) (-> snapshot-b prt-color) blend)
         (vector4-lerp! (-> groups 0 ambi color) (-> snapshot-a amb-color) (-> snapshot-b amb-color) blend)
         (set! (-> groups 0 ambi levels x) 1.0)
         (vector4-lerp! (-> context current-shadow) (-> snapshot-a shadow) (-> snapshot-b shadow) blend)
         (let ((color-level-a (* (+ (* 2.0 (-> snapshot-a lgt-color x)) (* 4.0 (-> snapshot-a lgt-color y)) (-> snapshot-a lgt-color z))
                                 (- 1.0 blend)))
               (color-level-b (* (+ (* 2.0 (-> snapshot-b lgt-color x)) (* 4.0 (-> snapshot-b lgt-color y)) (-> snapshot-b lgt-color z)) blend)))
           (set! (-> groups 0 dir0 direction quad) (-> snapshot-a direction quad))
           (set! (-> groups 0 dir0 color quad) (-> snapshot-a lgt-color quad))
           (set! (-> groups 0 dir0 levels x) (- 1.0 blend))
           (set! (-> groups 0 dir0 levels y) color-level-a)
           (set! (-> groups 0 dir1 direction quad) (-> snapshot-b direction quad))
           (set! (-> groups 0 dir1 color quad) (-> snapshot-b lgt-color quad))
           (set! (-> groups 0 dir1 levels x) blend)
           (set! (-> groups 0 dir1 levels y) color-level-b)))
       (set! (-> *time-of-day-context* light-masks-0 level-index) (the-as uint (ash 1 snapshot-a-index)))
       (set! (-> *time-of-day-context* light-masks-1 level-index) (the-as uint (ash 1 snapshot-b-index)))
       (set! (-> *time-of-day-context* light-interp level-index) blend)))
    (if (and (= (-> context current-prt-color x) 0.0)
             (= (-> context current-prt-color y) 0.0)
             (= (-> context current-prt-color z) 0.0))
      (update-mood-prt-color context))
    blend))

(defun update-mood-sky-texture ((context mood-context) (hour float))
  "Interpolate the current sun and environment colors and set the eight sky-texture weights from
   context's hourly sky schedule."
  (dotimes (i 8)
    (set! (-> context sky-times i) 0.0))
  0
  0
  0.0
  (let* ((whole-hour (the int hour))
         (hour-fraction (- hour (the float whole-hour)))
         (inverse-hour-fraction (- 1.0 hour-fraction))
         (day (/ whole-hour 24))
         (hour-entry (-> context sky-texture-interp hour (- whole-hour (* 24 day))))
         (snapshot-a-index (-> hour-entry snapshot1))
         (snapshot-b-index (-> hour-entry snapshot2))
         (blend (+ (* inverse-hour-fraction (-> hour-entry morph-start)) (* hour-fraction (-> hour-entry morph-end)))))
    (cond
      ((= snapshot-a-index snapshot-b-index)
       (set! (-> context sky-times snapshot-a-index) 1.0)
       (set! (-> context current-sun sun-color quad) (-> context mood-sun-table data snapshot-a-index sun-color quad))
       (let ((environment-color (-> context current-sun env-color)))
         (set! (-> environment-color quad)
               (-> (the-as (pointer uint128) (+ (the-as uint (-> context mood-sun-table data 0 env-color)) (* snapshot-a-index 32)))))
         environment-color))
      (else
       (set! (-> context sky-times snapshot-a-index) (- 1.0 blend))
       (set! (-> context sky-times snapshot-b-index) blend)
       (vector4-lerp! (-> context current-sun sun-color)
                      (-> context mood-sun-table data snapshot-a-index sun-color)
                      (-> context mood-sun-table data snapshot-b-index sun-color)
                      blend)
       (vector4-lerp! (-> context current-sun env-color)
                      (the-as vector (+ (the-as uint (-> context mood-sun-table data 0 env-color)) (* snapshot-a-index 32)))
                      (the-as vector (+ (the-as uint (-> context mood-sun-table data 0 env-color)) (* snapshot-b-index 32)))
                      blend)))))

(defun update-mood-fog ((context mood-context) (hour float))
  "Interpolate the current fog colors and distances from context's hourly fog schedule."
  0
  0
  0.0
  (let* ((whole-hour (the int hour))
         (hour-fraction (- hour (the float whole-hour)))
         (inverse-hour-fraction (- 1.0 hour-fraction))
         (day (/ whole-hour 24))
         (hour-entry (-> context fog-interp hour (- whole-hour (* 24 day))))
         (snapshot-a-index (-> hour-entry snapshot1))
         (snapshot-b-index (-> hour-entry snapshot2))
         (blend (+ (* inverse-hour-fraction (-> hour-entry morph-start)) (* hour-fraction (-> hour-entry morph-end))))
         (current-fog (-> context current-fog))
         (snapshot-a (-> context mood-fog-table data snapshot-a-index))
         (snapshot-b (-> context mood-fog-table data snapshot-b-index)))
    (vector4-lerp! (-> current-fog fog-color) (-> snapshot-a fog-color) (-> snapshot-b fog-color) blend)
    (vector4-lerp! (-> current-fog fog-dists) (-> snapshot-a fog-dists) (-> snapshot-b fog-dists) blend)
    (vector4-lerp! (-> current-fog erase-color) (-> snapshot-a erase-color) (-> snapshot-b erase-color) blend)))

(defun update-mood-quick ((context mood-context) (fog-index int) (sky-index int) (light-index int) (level-index int))
  "Select fog, sky, and lighting snapshots directly, without hourly interpolation. fog-index,
   sky-index, and light-index select their respective tables; level-index selects the active
   level's time-of-day mask."
  (let ((groups (-> context light-group)))
    (set! (-> context current-fog fog-color quad) (-> context mood-fog-table data fog-index fog-color quad))
    (set! (-> context current-fog fog-dists quad)
          (-> (the-as (pointer uint128) (+ (the-as uint (-> context mood-fog-table data 0 fog-dists)) (* 48 fog-index)))))
    (set! (-> context current-fog erase-color quad)
          (-> (the-as (pointer uint128) (+ (the-as uint (-> context mood-fog-table data 0 erase-color)) (* 48 fog-index)))))
    (set! (-> context current-prt-color quad)
          (-> (the-as (pointer uint128) (+ (the-as uint (-> context mood-lights-table data 0 prt-color)) (* 80 light-index)))))
    (set! (-> context current-sun sun-color quad) (-> context mood-sun-table data sky-index sun-color quad))
    (set! (-> context current-sun env-color quad)
          (-> (the-as (pointer uint128) (+ (the-as uint (-> context mood-sun-table data 0 env-color)) (* sky-index 32)))))
    (set! (-> context current-shadow quad)
          (-> (the-as (pointer uint128) (+ (the-as uint (-> context mood-lights-table data 0 shadow)) (* 80 light-index)))))
    (let ((snapshot (-> context mood-lights-table data light-index)))
      (let ((color-level (+ (* 2.0 (-> snapshot lgt-color x)) (* 4.0 (-> snapshot lgt-color y)) (-> snapshot lgt-color z))))
        (set! (-> groups 0 dir0 direction quad) (-> snapshot direction quad))
        (set! (-> groups 0 dir0 color quad) (-> snapshot lgt-color quad))
        (set! (-> groups 0 dir0 levels x) 1.0)
        (set! (-> groups 0 dir0 levels y) color-level))
      (set! (-> groups 0 dir1 levels x) 0.0)
      (set! (-> groups 0 dir2 levels x) 0.0)
      (set! (-> groups 0 ambi color quad) (-> snapshot amb-color quad)))
    (set! (-> groups 0 ambi levels x) 1.0))
  (set! (-> *time-of-day-context* light-masks-0 level-index) (the-as uint (ash 1 light-index)))
  (set! (-> *time-of-day-context* light-masks-1 level-index) (the-as uint 0))
  (set! (-> *time-of-day-context* light-interp level-index) 0.0)
  (if (and (= (-> context current-prt-color x) 0.0)
           (= (-> context current-prt-color y) 0.0)
           (= (-> context current-prt-color z) 0.0))
    (update-mood-prt-color context)))

(defun update-mood-interp ((result mood-context) (context-a mood-context) (context-b mood-context) (blend float))
  "Blend the current fog, sun, shadow, and complete light kit from context-a to context-b by blend,
   writing result. Exact endpoints are copied directly."
  (cond
    ((= blend 0.0)
     (set! (-> result current-fog fog-color quad) (-> context-a current-fog fog-color quad))
     (set! (-> result current-fog fog-dists quad) (-> context-a current-fog fog-dists quad))
     (set! (-> result current-fog erase-color quad) (-> context-a current-fog erase-color quad))
     (set! (-> result current-prt-color quad) (-> context-a current-prt-color quad))
     (set! (-> result current-sun sun-color quad) (-> context-a current-sun sun-color quad))
     (set! (-> result current-sun env-color quad) (-> context-a current-sun env-color quad))
     (set! (-> result current-shadow quad) (-> context-a current-shadow quad))
     (set! (-> result current-shadow-color quad) (-> context-a current-shadow-color quad))
     (quad-copy! (the-as pointer (-> result light-group)) (the-as pointer (-> context-a light-group)) 12))
    ((= blend 1.0)
     (set! (-> result current-fog fog-color quad) (-> context-b current-fog fog-color quad))
     (set! (-> result current-fog fog-dists quad) (-> context-b current-fog fog-dists quad))
     (set! (-> result current-fog erase-color quad) (-> context-b current-fog erase-color quad))
     (set! (-> result current-prt-color quad) (-> context-b current-prt-color quad))
     (set! (-> result current-sun sun-color quad) (-> context-b current-sun sun-color quad))
     (set! (-> result current-sun env-color quad) (-> context-b current-sun env-color quad))
     (set! (-> result current-shadow quad) (-> context-b current-shadow quad))
     (set! (-> result current-shadow-color quad) (-> context-b current-shadow-color quad))
     (quad-copy! (the-as pointer (-> result light-group)) (the-as pointer (-> context-b light-group)) 12))
    (else
     (vector4-lerp! (-> result current-fog fog-color)
                    (-> context-a current-fog fog-color)
                    (-> context-b current-fog fog-color)
                    blend)
     (vector4-lerp! (-> result current-fog fog-dists)
                    (-> context-a current-fog fog-dists)
                    (-> context-b current-fog fog-dists)
                    blend)
     (vector4-lerp! (-> result current-fog erase-color)
                    (-> context-a current-fog erase-color)
                    (-> context-b current-fog erase-color)
                    blend)
     (vector4-lerp! (-> result current-prt-color) (-> context-a current-prt-color) (-> context-b current-prt-color) blend)
     (vector4-lerp! (-> result current-sun sun-color)
                    (-> context-a current-sun sun-color)
                    (-> context-b current-sun sun-color)
                    blend)
     (vector4-lerp! (-> result current-sun env-color)
                    (-> context-a current-sun env-color)
                    (-> context-b current-sun env-color)
                    blend)
     (vector4-lerp! (-> result current-shadow) (-> context-a current-shadow) (-> context-b current-shadow) blend)
     (vector4-lerp! (-> result current-shadow-color)
                    (-> context-a current-shadow-color)
                    (-> context-b current-shadow-color)
                    blend)
     (dotimes (i 3)
       (let ((result-light (-> result light-group 0 lights i)))
         (let ((light-a (-> context-a light-group 0 lights i))
               (light-b (-> context-b light-group 0 lights i)))
           (vector4-lerp! (-> result-light direction) (-> light-a direction) (-> light-b direction) blend)
           (vector4-lerp! (-> result-light color) (-> light-a color) (-> light-b color) blend)
           (vector4-lerp! (-> result-light levels) (-> light-a levels) (-> light-b levels) blend))
         (vector-normalize! (-> result-light direction) 1.0)))
     (vector4-lerp! (-> result light-group 0 ambi color)
                    (-> context-a light-group 0 ambi color)
                    (-> context-b light-group 0 ambi color)
                    blend)
     (vector4-lerp! (-> result light-group 0 ambi levels)
                    (-> context-a light-group 0 ambi levels)
                    (-> context-b light-group 0 ambi levels)
                    blend)))
  (none))

(deftype flames-state (structure)
  ((index  uint8)
   (time   uint8)
   (length uint8)
   (height uint8)))

(defun update-mood-flames ((context mood-context)
        (first-slot int)
        (slot-count int)
        (state-offset int)
        (base-weight float)
        (amplitude float)
        (duration-scale float))
  "Animate slot-count flame palette slots beginning at first-slot. state-offset selects the
   flames-state in context; base-weight, amplitude, and duration-scale control each randomized
   half-sine flicker."
  (let* ((effect-state (the-as flames-state (&-> context state state-offset)))
         (active-slot (+ (-> effect-state index) first-slot))
         (time (-> effect-state time))
         (length (-> effect-state length))
         (height (-> effect-state height)))
    (dotimes (i slot-count)
      (set! (-> context times (+ first-slot i) w) base-weight))
    (cond
      ((>= time length)
       (set! (-> effect-state index) (the-as uint (the int (rand-vu-float-range 0.0 (+ -0.01 (the float slot-count))))))
       (set! (-> effect-state time) (the-as uint 0))
       (set! (-> effect-state length) (the-as uint (the int (* (rand-vu-float-range 7.0 15.0) duration-scale))))
       (set! (-> effect-state height) (the-as uint (the int (rand-vu-float-range 0.0 255.0))))
       (set! (-> context times active-slot w) base-weight))
      (else
       (let ((envelope (sin (* 32768.0 (/ (the float time) (the float length))))))
         (set! (-> context times active-slot w) (+ (* (the float height) envelope amplitude) base-weight)))
       (if (not (paused?)) (+! (-> effect-state time) 1)))))
  (none))

(define *flash0* (new 'static 'boxed-array :type float 1.0 0.0 0.5 1.0 0.5 0.0 0.5 0.35 0.4 0.35 0.25 0.1 0.04))

(define *flash1* (new 'static 'boxed-array :type float 1.0 0.8 0.0 1.0 0.5 1.0 0.4 0.2 0.1))

(define *flash2* (new 'static 'boxed-array :type float 1.0 0.9 0.8 0.7 0.0 0.0 1.0 0.0 1.0 0.5))

(define *flash3* (new 'static 'boxed-array :type float 0.5 0.0 1.0 0.9 1.0 0.8 0.3 0.0 0.0 0.5 0.1 0.5 0.35))

(define *flash4*
  (new 'static 'boxed-array :type float 1.0 0.0 1.0 0.0 1.0 0.9 0.8 0.7 0.6 0.5 0.4 0.3 0.2 0.5 0.4 0.3 0.2 0.1))

(define *flash5*
  (new 'static
       'boxed-array
       :type
       float
       1.0
       0.0
       1.0
       0.0
       1.0
       0.95
       0.9
       0.85
       0.8
       0.75
       0.7
       0.65
       0.6
       0.55
       0.5
       0.45
       0.4
       0.35
       0.3
       0.25
       0.2
       0.5
       0.45
       0.4
       0.35
       0.3
       0.25
       0.2
       0.15
       0.1
       0.05))

(define *flash6* (new 'static 'boxed-array :type float 1.0 0.0 1.0 0.0 0.5 0.0 0.5 0.35 0.0 0.0 1.0 0.0 0.2 0.1))

(define *flash7* (new 'static 'boxed-array :type float 1.0 0.8 0.3 0.0 0.6 0.5 0.4 0.3 0.2 0.5 0.4 0.3 0.2 0.1))

(define *lightning-index* 0)

(define *lightning-time* 0)

(define *lightning-time2* 0)

(define *lightning-frame-done* #f)

(define *lightning-realtime-done* #f)

(define *thunder-id0* (new-sound-id))

(define *thunder-id1* (new-sound-id))

(define *thunder-id2* (new-sound-id))

(define *thunder-id* (new 'static 'sound-id))

(define *thunder-count* 0)

(deftype lightning-state (structure)
  ((val uint8))
  :pack-me)

(defun update-mood-lightning ((context mood-context)
        (first-sky-slot int)
        (sky-count int)
        (state-offset int)
        (first-light-slot int)
        (strength float)
        (distant? symbol))
  "Animate lightning across sky-count sky slots beginning at first-sky-slot. state-offset selects
   the flash pattern byte, first-light-slot selects the matching lighting slots, strength scales
   the flash, and distant? selects the quieter, less frequent thunder."
  (local-vars (flash (array float)))
  (with-pp
    (set! (-> context light-group 0 dir2 levels x) 0.0)
    (let* ((effect-state (&-> context state state-offset))
           (sky-slot (+ *lightning-index* first-sky-slot))
           (light-slot (+ *lightning-index* first-light-slot))
           (flash-index (-> effect-state 0))
           (flash-frame (/ *lightning-time* 2)))
      (cond
        ((zero? *lightning-time2*)
         (cond
           ((zero? flash-index) (set! flash *flash0*))
           ((= flash-index 1) (set! flash *flash1*))
           ((= flash-index 2) (set! flash *flash2*))
           ((= flash-index 3) (set! flash *flash3*))
           ((= flash-index 4) (set! flash *flash4*))
           ((= flash-index 5) (set! flash *flash5*))
           ((= flash-index 6) (set! flash *flash6*))
           (else (set! flash *flash7*)))
         (cond
           ((< flash-frame (-> flash length))
            (let ((brightness (-> flash flash-frame)))
              (set! (-> context sky-times sky-slot) brightness)
              (when (not distant?)
                (set! (-> context times light-slot w) brightness)
                (when (not *lightning-realtime-done*)
                  (let* ((snapshot (-> context mood-lights-table data light-slot))
                         (directional (-> context light-group 0 dir2))
                         (color-level (* (+ (* 2.0 (-> snapshot lgt-color x)) (* 4.0 (-> snapshot lgt-color y)) (-> snapshot lgt-color z)) brightness)))
                    (set! (-> directional direction quad) (-> snapshot direction quad))
                    (set! (-> directional color quad) (-> snapshot lgt-color quad))
                    (set! (-> directional levels x) brightness)
                    (set! (-> directional levels y) color-level))
                  (set! *lightning-realtime-done* #t))))
            (if (not (or (paused?) *lightning-frame-done*)) (set! *lightning-time* (+ *lightning-time* 1))))
           (distant? (set! *lightning-time2* (the int (rand-vu-float-range 360.0 960.0))))
           (else (set! *lightning-time2* (the int (rand-vu-float-range 180.0 480.0))))))
        (else
         (when (not (or (paused?) *lightning-frame-done*))
           (set! *lightning-time2* (+ *lightning-time2* -1))
           (when (zero? *lightning-time2*)
             (set! *lightning-index* (mod (+ *lightning-index* 1) sky-count))
             (set! (-> effect-state 0) (logand (rand-uint31-gen *random-generator*) 7))
             (set! *lightning-time* 0)
             (let ((thunder-index *thunder-count*))
               (cond
                 ((zero? thunder-index) (set! *thunder-id* *thunder-id0*) (set! *thunder-count* 1))
                 ((= thunder-index 1) (set! *thunder-id* *thunder-id1*) (set! *thunder-count* 2))
                 (else (set! *thunder-id* *thunder-id2*) (set! *thunder-count* 0) 0)))
             (when (>= (-> *math-camera* trans y) -81920.0)
               (if distant?
                 (sound-play "thunder" :id *thunder-id* :vol (rand-vu-float-range 25.0 75.0) :pitch (rand-vu-float-range -1.0 1.0))
                 (sound-play "thunder" :id *thunder-id* :vol (rand-vu-float-range 200.0 400.0) :pitch (rand-vu-float-range -1.0 1.0)))))))))
    (when (not *lightning-frame-done*)
      (let ((rpc-command (the-as sound-rpc-set-param (get-sound-buffer-entry))))
        (set! (-> rpc-command command) (sound-command set-param))
        (set! (-> rpc-command id) *thunder-id0*)
        (let ((sound-position (camera-pos)))
          (let ((drawable-process pp))
            (when (= sound-position #t)
              (if (and drawable-process
                       (type-type? (-> drawable-process type) process-drawable)
                       (nonzero? (-> (the-as process-drawable drawable-process) root)))
                (set! sound-position (-> (the-as process-drawable drawable-process) root trans))
                (set! sound-position (the-as vector #f)))))
          (sound-trans-convert (-> rpc-command parms trans) sound-position))
        (set! (-> rpc-command parms mask) (sound-mask trans))
        (-> rpc-command id))
      (let ((rpc-command (the-as sound-rpc-set-param (get-sound-buffer-entry))))
        (set! (-> rpc-command command) (sound-command set-param))
        (set! (-> rpc-command id) *thunder-id1*)
        (let ((sound-position (camera-pos)))
          (let ((drawable-process pp))
            (when (= sound-position #t)
              (if (and drawable-process
                       (type-type? (-> drawable-process type) process-drawable)
                       (nonzero? (-> (the-as process-drawable drawable-process) root)))
                (set! sound-position (-> (the-as process-drawable drawable-process) root trans))
                (set! sound-position (the-as vector #f)))))
          (sound-trans-convert (-> rpc-command parms trans) sound-position))
        (set! (-> rpc-command parms mask) (sound-mask trans))
        (-> rpc-command id))
      (let ((rpc-command (the-as sound-rpc-set-param (get-sound-buffer-entry))))
        (set! (-> rpc-command command) (sound-command set-param))
        (set! (-> rpc-command id) *thunder-id2*)
        (let ((sound-position (camera-pos)))
          (let ((drawable-process pp))
            (when (= sound-position #t)
              (if (and drawable-process
                       (type-type? (-> drawable-process type) process-drawable)
                       (nonzero? (-> (the-as process-drawable drawable-process) root)))
                (set! sound-position (-> (the-as process-drawable drawable-process) root trans))
                (set! sound-position (the-as vector #f)))))
          (sound-trans-convert (-> rpc-command parms trans) sound-position))
        (set! (-> rpc-command parms mask) (sound-mask trans))
        (-> rpc-command id)))
    (set! *lightning-frame-done* #t)
    (none)))

(deftype light-time-state (structure)
  ((time uint8))
  :pack-me)

(deftype light-state (structure)
  ((fade uint8))
  :pack-me)

(defun update-mood-light ((context mood-context)
        (slot int)
        (fade-state-offset int)
        (phase-state-offset int)
        (base-weight float)
        (amplitude float)
        (hour float)
        (phase-offset int))
  "Animate one palette slot as a night light. fade-state-offset and phase-state-offset select
   bytes in context state; base-weight and amplitude set its cosine flicker, hour controls its
   day/night fade, and phase-offset offsets the flicker phase."
  (let* ((fade-state (&-> context state fade-state-offset))
         (phase (the float (* (logand (+ (-> context state phase-state-offset) phase-offset) 255) 512)))
         (weight (+ base-weight (* (cos phase) amplitude)))
         (fade (* 0.003921569 (the float (-> fade-state 0)))))
    (cond
      ((or (< 19.0 hour) (< hour 7.0))
       (cond
         ((and (= fade 0.0) (= weight (- base-weight amplitude)))
          (set! (-> context times slot w) weight)
          (set! (-> fade-state 0) (the-as uint 255)))
         ((= fade 1.0) (set! (-> context times slot w) weight))))
      ((= fade 1.0)
       (cond
         ((= weight (+ base-weight amplitude))
          (set! (-> context times slot w) weight)
          (set! (-> fade-state 0) (the-as uint 254)))
         (else (set! (-> context times slot w) weight))))
      ((and (!= fade 1.0) (!= fade 0.0))
       (set! (-> context times slot w) fade)
       (when (not (paused?))
         (if (< 0.75 fade) (+! (-> fade-state 0) -3) (+! (-> fade-state 0) -1))))
      (else (set! (-> context state phase-state-offset) (the-as uint 0)) 0)))
  (none))

(deftype lava-state (structure)
  ((scale      float 4)
   (time       uint8)
   (last-index uint8))
  :pack-me)

(define *lava-time* (the-as float 0))

(defun update-mood-lava ((context mood-context) (first-slot int) (state-offset int) (update-slots? symbol))
  "Animate four lava palette slots beginning at first-slot, using the lava-state at state-offset.
   When update-slots? is false, only the downward orange light is updated."
  (let* ((effect-state (the-as lava-state (&-> context state state-offset)))
         (time (-> effect-state time))
         (last-index (-> effect-state last-index)))
    (when (not (paused?))
      (set! (-> effect-state time) (+ time 4))
      (set! *lava-time* (+ *lava-time* (rand-vu-float-range 64.0 2048.0))))
    (let ((down-light (-> context light-group 0 dir2))
          (light-level (+ 0.875 (* 0.125 (sin *lava-time*)))))
      (set-vector! (-> down-light direction) 0.0 -1.0 0.0 0.0)
      (set-vector! (-> down-light color) 1.0 0.364 0.0 1.0)
      (set! (-> down-light levels x) light-level))
    (let ((slot-index (shr time 6))
          (blend (* 0.015625 (the float (logand time 63)))))
      (when (!= slot-index last-index)
        (set! (-> effect-state scale slot-index) (the float (the int (rand-vu-float-range 128.0 255.0))))
        (set! (-> effect-state last-index) slot-index))
      (when update-slots?
        (let* ((previous-index (logand (+ slot-index -1) 3))
               (scale (/ (-> effect-state scale slot-index) 128))
               (previous-scale (/ (-> effect-state scale previous-index) 128)))
          (set! (-> context times (+ first-slot slot-index) w) (* blend scale))
          (set! (-> context times (+ first-slot previous-index) w) (* (- 1.0 blend) previous-scale))))))
  (none))

(defun update-mood-caustics ((context mood-context) (first-slot int) (state-offset int))
  "Crossfade four caustic palette slots beginning at first-slot. The byte at state-offset encodes
   the current slot in bits 3-4 and its eighth-step interpolation in bits 0-2."
  (let* ((effect-state (-> context state state-offset))
         (slot-index (logand (shr effect-state 3) 3))
         (blend (* 0.125 (the float (logand effect-state 7)))))
    (let ((previous-index (logand (+ slot-index -1) 3)))
      (set! (-> context times (+ first-slot previous-index) w) (- 1.0 blend)))
    (set! (-> context times (+ first-slot slot-index) w) blend))
  (none))

(defun update-mood-default ((context mood-context) (hour float) (level-index int))
  "Update the ordinary hourly fog, sky, lighting palette, and packed palette weights."
  (update-mood-fog context hour)
  (update-mood-sky-texture context hour)
  (clear-mood-times context)
  (update-mood-palette context hour level-index)
  (update-mood-itimes context)
  0
  (none))

(deftype misty-states (structure)
  ((flames flames-state :inline)
   (light0 light-state :inline)
   (light1 light-state :inline)
   (time0  light-time-state :inline)
   (time1  light-time-state :inline)))

(defun update-mood-misty ((context mood-context) (hour float) (level-index int))
  "Update Misty's hourly mood, warehouse flame and night lights, and secondary light kit."
  (update-mood-fog context hour)
  (update-mood-sky-texture context hour)
  (clear-mood-times context)
  (update-mood-palette context hour level-index)
  (when *time-of-day-effects*
    (update-mood-flames context 2 4 0 0.333 0.001953125 1.0)
    (let* ((warehouse-control (get-task-control (game-task misty-warehouse)))
           (target-position (target-pos 0))
           (warehouse-position (new 'static 'vector :x -808960.0 :y 110592.0 :z 3928064.0))
           (warehouse-distance (vector-vector-xz-distance target-position warehouse-position))
           (reminder (get-reminder warehouse-control 0)))
      (cond
        ((or (logtest? reminder 3) (and (< warehouse-distance 180224.0) (< (-> target-position y) 118784.0)))
         (when (or (logtest? reminder 1) (and (< warehouse-distance 180224.0) (< (-> target-position y) 118784.0)))
           (update-mood-light context 6 4 6 0.875 0.25 20.0 32)
           (save-reminder warehouse-control (logior reminder 1) 0)
           (if (not (paused?)) (+! (-> context state 6) 1)))
         (when (logtest? reminder 2)
           (update-mood-light context 7 5 7 0.875 0.25 20.0 32)
           (if (not (paused?)) (+! (-> context state 7) 1))))
        (else
         (set! (-> context state 6) (the-as uint 0))
         (set! (-> context state 7) (the-as uint 0))
         (set! (-> context state 4) (the-as uint 255))
         (set! (-> context state 5) (the-as uint 255))))))
  (let ((secondary-group (-> context light-group 1)))
    (update-light-kit secondary-group (-> context light-group 0 ambi) 0.6)
    (set! (-> secondary-group dir0 levels x) (+ 1.0 (* 0.333 (-> context times 2 w)))))
  (update-mood-itimes context)
  0
  (none))

(deftype swamp-village2-states (structure)
  ((flames    flames-state :inline)
   (lightning lightning-state :inline)))

(defun update-mood-village2 ((context mood-context) (hour float) (level-index int))
  "Update Village 2's hourly mood, flame and lightning effects, local light kits, and target
   lighting transitions."
  (update-mood-fog context hour)
  (update-mood-sky-texture context hour)
  (clear-mood-times context)
  (update-mood-palette context hour level-index)
  (when *time-of-day-effects*
    (update-mood-flames context 4 4 0 0.333 0.001953125 1.0)
    (update-mood-lightning context 2 2 4 2 0.5 #f))
  (let ((group (-> context light-group 1))) (update-light-kit group (-> context light-group 0 ambi) 0.9))
  (let ((group (-> context light-group 2)))
    (update-light-kit group (-> context light-group 0 ambi) 1.0)
    (set! (-> group dir2 direction quad) (-> context light-group 0 dir2 direction quad))
    (set! (-> group dir2 color quad) (-> context light-group 0 dir2 color quad))
    (set! (-> group dir2 levels x) (-> context light-group 0 dir2 levels x)))
  (let ((group (-> context light-group 3)))
    (update-light-kit group (-> context light-group 0 ambi) 1.0)
    (set! (-> group dir0 levels x) (+ 0.666 (* 0.333 (-> context times 4 w)))))
  (let ((group (-> context light-group 4)))
    (update-light-kit group (-> context light-group 0 ambi) 1.0)
    (set! (-> group dir0 levels x) (+ 0.666 (* 0.333 (-> context times 4 w)))))
  (let ((group (-> context light-group 5)))
    (update-light-kit group (-> context light-group 0 ambi) 0.5)
    (+! (-> group ambi color x) 0.25)
    (set! (-> group dir0 levels x) 1.0))
  (let ((local-group (-> context light-group 6))
        (direction (new 'stack-no-clear 'vector))
        (target-position (target-joint-pos)))
    (update-light-kit local-group (-> context light-group 0 ambi) 1.0)
    (set-vector! direction 1212416.0 110592.0 -6680576.0 0.0)
    (vector-! direction direction target-position)
    (vector-normalize! direction 1.0)
    (set! (-> local-group dir0 direction quad) (-> direction quad))
    (set! (-> local-group dir0 levels x) (+ 0.666 (* 0.333 (-> context times 4 w))))
    (set-vector! direction 1384448.0 (-> target-position y) -6688768.0 0.0)
    (let ((distance (vector-vector-distance direction target-position)))
      (vector-! direction direction target-position)
      (vector-normalize! direction 1.0)
      (set! (-> local-group dir1 direction quad) (-> direction quad))
      (when (< distance 180224.0)
        (new 'stack-no-clear 'vector)
        (let ((fade (* 0.0000110973015 (+ -90112.0 distance))))
          (set! (-> local-group dir1 levels x) (- 1.0 (fmax 0.0 (fmin 1.0 fade)))))))
    (set-vector! direction 1212416.0 (-> target-position y) -6680576.0 0.0)
    (let ((distance (vector-vector-distance direction target-position)))
      (when (< distance 61440.0)
        (let ((fire-color (new 'stack-no-clear 'vector))
              (normalized-distance (/ distance (meters 15))))
          (set-vector! fire-color 1.0 0.5 0.0 1.0)
          (let ((fire-level (* 0.5 (- 1.0 (fmax 0.0 (fmin 1.0 normalized-distance))))))
            (vector+float*! (-> local-group ambi color) (-> local-group ambi color) fire-color fire-level))))))
  (let ((landmark-position (new 'stack-no-clear 'vector))
        (target-position (target-joint-pos)))
    0.0
    (set-vector! landmark-position 1570816.0 98304.0 -6322176.0 1.0)
    (let ((distance (vector-vector-distance landmark-position target-position)))
      (when (< distance 49152.0)
        (let ((fade (* 0.000061035156 (+ -32768.0 distance))))
          (cond
            ((movie?) (set-target-light-index 1) (set! (-> *time-of-day-context* target-interp) 1.0))
            (else (set-target-light-index 1) (set! (-> *time-of-day-context* target-interp) (- 1.0 (fmax 0.0 (fmin 1.0 fade)))))))))
    (set-vector! landmark-position 1169408.0 61440.0 -6676480.0 1.0)
    (let ((distance (vector-vector-distance landmark-position target-position)))
      (when (< distance 167936.0)
        (let ((fade (* 0.000024414063 (+ -126976.0 distance))))
          (cond
            ((movie?) (set-target-light-index 6) (set! (-> *time-of-day-context* target-interp) 1.0))
            (else (set-target-light-index 6) (set! (-> *time-of-day-context* target-interp) (- 1.0 (fmax 0.0 (fmin 1.0 fade))))))))))
  (update-mood-itimes context)
  0
  (none))

(defun update-mood-swamp ((context mood-context) (hour float) (level-index int))
  "Update the swamp's hourly mood and storm effects, brightening the fog when the camera looks
   upward."
  (update-mood-fog context hour)
  (update-mood-sky-texture context hour)
  (clear-mood-times context)
  (update-mood-palette context hour level-index)
  (when *time-of-day-effects*
    (update-mood-flames context 4 4 0 0.333 0.001953125 1.0)
    (update-mood-lightning context 2 2 4 2 0.5 #f))
  (let ((upward-view (fmax 0.0 (-> *math-camera* camera-rot vector 1 z))))
    (let ((bright-fog-color (new 'stack-no-clear 'vector)))
      (set-vector! bright-fog-color 0.0 32.0 48.0 128.0)
      (vector4-lerp! (-> context current-fog fog-color) (-> context current-fog fog-color) bright-fog-color (/ upward-view 2)))
    (let ((fog-alpha (-> context current-fog fog-dists w))
          (full-alpha 255.0))
      (set! (-> context current-fog fog-dists w) (+ fog-alpha (* 0.666 upward-view (- full-alpha fog-alpha))))))
  (update-mood-itimes context)
  0
  (none))

(deftype village1-states (structure)
  ((flames flames-state :inline)))

(defun update-mood-village1 ((context mood-context) (hour float) (level-index int))
  "Update Village 1's hourly mood, chimney flame, light kits, and target lighting transitions near
   authored landmarks."
  (update-mood-fog context hour)
  (update-mood-sky-texture context hour)
  (clear-mood-times context)
  (update-mood-palette context hour level-index)

(deftype jungle-states (structure)
  ((light    light-state :inline)
   (time     light-time-state :inline)
   (one-shot uint8)))

(defun update-mood-jungle ((context mood-context) (hour float) (level-index int))
  "Update the jungle's hourly mood and enable the egg-top night light after its task completes."
  (update-mood-fog context hour)
  (update-mood-sky-texture context hour)
  (clear-mood-times context)
  (update-mood-palette context hour level-index)
  (when *time-of-day-effects*
    (cond
      ((task-complete? *game-info* (game-task jungle-eggtop))
       (update-mood-light context 5 0 1 0.875 0.25 20.0 32)
       (if (not (paused?)) (+! (-> context state 1) 1)))
      (else (set! (-> context state 1) (the-as uint 0)) (set! (-> context state 0) (the-as uint 255)))))
  (update-mood-itimes context)
  0
  (none))

(defun update-mood-jungleb-blue ((context mood-context) (hour float) (level-index int))
  "Apply Jungle B's blue fog and light transition, then update its packed palette weights."
  (update-mood-light context 5 0 1 0.875 0.25 20.0 32)
  (+! (-> context state 1) 1)
  (let ((fog-snapshot (-> context mood-fog-table data)))
    (set! (-> fog-snapshot 0 fog-color x) 0.0)
    (set! (-> fog-snapshot 0 fog-color y) 16.0)
    (set! (-> fog-snapshot 0 fog-color z) 64.0)
    (set! (-> fog-snapshot 0 fog-color w) 128.0))
  (set! (-> context mood-fog-table data 0 fog-dists x) 196608.0)
  (set-vector! (-> context mood-fog-table data 0 erase-color) 0.0 0.0 0.0 128.0)
  (let ((sun-snapshot (-> context mood-sun-table data)))
    (set! (-> sun-snapshot 0 sun-color x) 0.0)
    (set! (-> sun-snapshot 0 sun-color y) 0.0)
    (set! (-> sun-snapshot 0 sun-color z) 0.0)
    (set! (-> sun-snapshot 0 sun-color w) 0.0))
  (set-vector! (-> context mood-sun-table data 0 env-color) 64.0 80.0 255.0 255.0)
  (let ((light-snapshot (-> context mood-lights-table data)))
    (set! (-> light-snapshot 0 direction x) 0.0)
    (set! (-> light-snapshot 0 direction y) -1.0)
    (set! (-> light-snapshot 0 direction z) 0.0)
    (set! (-> light-snapshot 0 direction w) 0.0))
  (set-vector! (-> context mood-lights-table data 0 lgt-color) 0.0 0.0 (* 1.5 (-> context times 5 w)) 1.0)
  (set-vector! (-> context mood-lights-table data 0 amb-color) 0.4 0.433 0.7 1.0)
  (set-vector! (-> context mood-lights-table data 0 prt-color) 0.2 0.216 (+ 0.35 (* 0.375 (-> context times 5 w))) 1.0)
  (set-vector! (-> context mood-lights-table data 0 shadow) 0.0 -1.0 0.0 0.0)
  (none))

(defun update-mood-jungleb ((context mood-context) (hour float) (level-index int))
  "Update Jungle B's mood, lightning, local fire and platform lighting, and blue-fog transition."
  (update-mood-sky-texture context hour)
  (clear-mood-times context)
  (set! (-> context times 0 w) 1.0)
  (when *time-of-day-effects*
    (let ((egg-top-reminder (get-reminder (get-task-control (game-task jungle-eggtop)) 0))
          (blue-transition-time (-> context state 2)))
      (cond
        ((and (= egg-top-reminder 2) (nonzero? blue-transition-time))
         (if (< (the-as uint 60) blue-transition-time)
           (set! (-> context times 2 w) 2.0)
           (set! (-> context times 2 w) (* 0.033333335 (the float blue-transition-time))))
         (if (not (paused?)) (set! (-> context state 2) (+ blue-transition-time -1)))
         (set! (-> context times 1 w) 1.0)
         (update-mood-jungleb-blue context hour level-index))
        ((and (nonzero? egg-top-reminder) (!= blue-transition-time 180))
         (set! (-> context state 2) (the-as uint 0))
         (set! (-> context times 1 w) 1.0)
         (update-mood-jungleb-blue context hour level-index))
        (else
         (set! (-> context state 2) (the-as uint 180))
         (set! (-> context state 1) (the-as uint 0))
         (set! (-> context state 0) (the-as uint 255))
         (let ((fog-snapshot (-> context mood-fog-table data)))
           (set! (-> fog-snapshot 0 fog-color x) 0.0)
           (set! (-> fog-snapshot 0 fog-color y) 0.0)
           (set! (-> fog-snapshot 0 fog-color z) 0.0)
           (set! (-> fog-snapshot 0 fog-color w) 128.0))
         (set! (-> context mood-fog-table data 0 fog-dists x) 98304.0)
         (set-vector! (-> context mood-fog-table data 0 erase-color) 0.0 0.0 0.0 128.0)
         (let ((sun-snapshot (-> context mood-sun-table data)))
           (set! (-> sun-snapshot 0 sun-color x) 0.0)
           (set! (-> sun-snapshot 0 sun-color y) 0.0)
           (set! (-> sun-snapshot 0 sun-color z) 0.0)
           (set! (-> sun-snapshot 0 sun-color w) 0.0))
         (set-vector! (-> context mood-sun-table data 0 env-color) 48.0 60.0 96.0 255.0)
         (let ((light-snapshot (-> context mood-lights-table data)))
           (set! (-> light-snapshot 0 direction x) 0.0)
           (set! (-> light-snapshot 0 direction y) 1.0)
           (set! (-> light-snapshot 0 direction z) 0.0)
           (set! (-> light-snapshot 0 direction w) 0.0))
         (set-vector! (-> context mood-lights-table data 0 lgt-color) 0.287 0.283 0.4 1.0)
         (set-vector! (-> context mood-lights-table data 0 amb-color) 0.166125 0.2125 0.4 1.0)
         (set-vector! (-> context mood-lights-table data 0 prt-color) 0.14235 0.1645 0.2875 1.0)
         (set-vector! (-> context mood-lights-table data 0 shadow) 0.0 -1.0 0.0 0.0)))))
  (update-mood-quick context 0 0 0 level-index)
  (let ((group (-> context light-group 1)))
    (quad-copy! (the-as pointer group) (the-as pointer (-> context light-group)) 12)
    (set! (-> group dir2 color quad) (the-as uint128 0))
    (set! (-> group dir2 levels x) 0.0))
  (let ((group (-> context light-group 2)))
    (quad-copy! (the-as pointer group) (the-as pointer (-> context light-group)) 12)
    (let ((down-light (-> group dir2)))
      (set! (-> down-light direction x) 0.0)
      (set! (-> down-light direction y) 1.0)
      (set! (-> down-light direction z) 0.0)
      (set! (-> down-light direction w) 0.0))
    (set-vector! (-> group dir2 color) 0.0 0.5 0.75 1.0)
    (set! (-> group dir2 levels x) 1.0))
  (let ((jungle-group (-> *jungle-mood* light-group 1))
        (group (-> context light-group 3)))
    (let ((ambient-offset (new 'stack-no-clear 'vector)))
      (quad-copy! (the-as pointer group) (the-as pointer (-> context light-group)) 12)
      (let ((down-light (-> group dir2)))
        (set! (-> down-light direction x) 0.0)
        (set! (-> down-light direction y) 1.0)
        (set! (-> down-light direction z) 0.0)
        (set! (-> down-light direction w) 0.0))
      (set-vector! (-> group dir2 color) 0.4 0.25 0.1 1.0)
      (set! (-> group dir2 levels x) 1.0)
      (set-vector! ambient-offset 0.25 0.25 0.25 0.0)
      (vector+! (the-as vector (-> group ambi color)) (the-as vector (-> group ambi color)) ambient-offset))
    (quad-copy! (the-as pointer jungle-group) (the-as pointer group) 12))
  (let ((landmark-position (new 'stack-no-clear 'vector))
        (target-position (target-joint-pos)))
    (set-vector! landmark-position 1482752.0 (-> target-position y) -985088.0 1.0)
    (let ((distance (vector-vector-distance landmark-position target-position)))
      (when (< distance 81920.0)
        (let ((horizontal-fade (* 0.000034877234 (+ -53248.0 distance)))
              (bright-ambient (new 'stack-no-clear 'vector))
              (groups (-> context light-group))
              (jungle-groups (-> *jungle-mood* light-group))
              (height-fade (* 0.0000030517579 (+ 163840.0 (-> target-position y)))))
          (set! *teleport* #t)
          (let* ((height-level (- 1.0 (fmax 0.0 (fmin 1.0 height-fade))))
                 (fire-level (* (- 1.0 (fmax 0.0 (fmin 1.0 horizontal-fade))) height-level)))
            (let ((down-light (-> groups 0 dir2)))
              (set! (-> down-light direction x) 0.0)
              (set! (-> down-light direction y) 1.0)
              (set! (-> down-light direction z) 0.0)
              (set! (-> down-light direction w) 0.0))
            (set-vector! (-> groups 0 dir2 color) 0.4 0.25 0.1 1.0)
            (set! (-> groups 0 dir2 levels x) fire-level)
            (let ((down-light (-> jungle-groups 0 dir2)))
              (set! (-> down-light direction x) 0.0)
              (set! (-> down-light direction y) 1.0)
              (set! (-> down-light direction z) 0.0)
              (set! (-> down-light direction w) 0.0))
            (set-vector! (-> jungle-groups 0 dir2 color) 0.4 0.25 0.1 1.0)
            (set! (-> jungle-groups 0 dir2 levels x) fire-level)
            (set-vector! bright-ambient 0.25 0.25 0.25 0.0)
            (vector+! bright-ambient bright-ambient (the-as vector (-> groups 0 ambi color)))
            (vector4-lerp! (-> groups 0 ambi color) (-> groups 0 ambi color) bright-ambient fire-level)))))
    (set-vector! landmark-position 1146880.0 (-> target-position y) -1232896.0 1.0)
    (if (< (vector-vector-distance landmark-position target-position) 10240.0) (set! *teleport* #t))
    (set-vector! landmark-position 1781760.0 -163840.0 -1038336.0 1.0)
    (let ((distance (vector-vector-distance landmark-position target-position)))
      (when (< distance 147456.0)
        (let ((fade (* 0.000030517578 (+ -114688.0 distance))))
          (set-target-light-index 2)
          (set! (-> *time-of-day-context* target-interp) (- 1.0 (fmax 0.0 (fmin 1.0 fade)))))))
    (set-vector! landmark-position 1105920.0 -188416.0 -1204224.0 1.0)
    (let ((distance (vector-vector-distance landmark-position target-position)))
      (when (< distance 106496.0)
        (let ((fade (* 0.000030517578 (+ -73728.0 distance))))
          (set-target-light-index 2)
          (set! (-> *time-of-day-context* target-interp) (- 1.0 (fmax 0.0 (fmin 1.0 fade))))))))
  (update-mood-itimes context)
  0
  (none))

(deftype sunken-states (structure)
  ((light light-state :inline)
   (time  light-time-state :inline)))

(set! (-> *sunken-mood* state 0) (the-as uint 255))

(defun update-mood-sunken ((context mood-context) (hour float) (level-index int))
  "Update Sunken Precursor City's mood, caustics, chamber light groups, and local target lighting."
  (when (not (paused?))
    (update-mood-fog context hour)
    (update-mood-sky-texture context hour)
    (if (not (paused?)) (+! (-> context state 1) 1))
    (let ((palette-blend (update-mood-palette context hour level-index))
          (depth-blend (/ (-> *math-camera* trans y) (meters -440)))
          (groups (-> context light-group)))
      (when *time-of-day-effects*
        (update-mood-light context 2 0 1 0.875 0.25 20.0 32)
        (update-mood-caustics context 4 1)
        (set! (-> context times 3 w) (-> *palette-fade-controls* control 3 fade))
        (let ((dir1-shallow (new 'static 'vector :x 0.192 :y 0.192 :z 0.24))
              (dir1-deep (new 'static 'vector :x 0.124 :y 0.124 :z 0.156))
              (dir0-shallow (new 'static 'vector :x 0.192 :y 0.192 :z 0.24))
              (dir0-deep (new 'static 'vector :x 0.181 :y 0.181 :z 0.226)))
          (let ((primary-group (-> groups 0)))
            (set! (-> primary-group dir0 direction x) 0.0)
            (set! (-> primary-group dir0 direction y) 1.0)
            (set! (-> primary-group dir0 direction z) 0.0)
            (set! (-> primary-group dir0 direction w) 1.0))
          (vector4-lerp! (-> groups 0 dir1 color) dir1-shallow dir1-deep depth-blend)
          (let ((dir1 (-> groups 0 dir1)))
            (set! (-> dir1 direction x) 0.0)
            (set! (-> dir1 direction y) 1.0)
            (set! (-> dir1 direction z) 0.0)
            (set! (-> dir1 direction w) 1.0))
          (vector4-lerp! (-> groups 0 dir0 color) dir0-shallow dir0-deep depth-blend))
        (let ((ambient-a-shallow (new 'static 'vector :x 0.104 :y 0.587 :z 1.074))
              (ambient-a-deep (new 'static 'vector :x 0.228 :y 0.3 :z 0.52))
              (ambient-b-shallow (new 'static 'vector :x 0.101 :y 0.392 :z 1.064))
              (ambient-b-deep (new 'static 'vector :x 0.132 :y 0.22 :z 0.52))
              (ambient-a (new 'stack-no-clear 'vector))
              (ambient-b (new 'stack-no-clear 'vector)))
          (vector4-lerp! ambient-a ambient-a-shallow ambient-a-deep depth-blend)
          (vector4-lerp! ambient-b ambient-b-shallow ambient-b-deep depth-blend)
          (vector4-lerp! (-> groups 0 ambi color) ambient-b ambient-a palette-blend))
        (let ((dir2-a-shallow (new 'static 'vector :x 0.193 :y 0.432 :z 0.721))
              (dir2-a-deep (new 'static 'vector :x 0.193 :y 0.338 :z 0.603))
              (dir2-b-shallow (new 'static 'vector :x 0.193 :y 0.336 :z 0.721))
              (dir2-b-deep (new 'static 'vector :x 0.215 :y 0.309 :z 0.674))
              (dir2-a (new 'stack-no-clear 'vector))
              (dir2-b (new 'stack-no-clear 'vector))
              (caustic-level (+ 0.75
                                (* 0.0625 (cos (the float (* 4000 (-> *display* integral-frame-counter)))))
                                (* 0.0625 (cos (the float (shl (-> *display* integral-frame-counter) 11))))
                                (* 0.125 (cos (the float (* 1500 (-> *display* integral-frame-counter))))))))
          (vector4-lerp! dir2-a dir2-a-shallow dir2-a-deep depth-blend)
          (vector4-lerp! dir2-b dir2-b-shallow dir2-b-deep depth-blend)
          (let ((dir2 (-> groups 0 dir2)))
            (set! (-> dir2 direction x) 0.0)
            (set! (-> dir2 direction y) 0.999)
            (set! (-> dir2 direction z) 0.011)
            (set! (-> dir2 direction w) 1.0))
          (vector4-lerp! (-> groups 0 dir2 color) dir2-b dir2-a palette-blend)
          (set! (-> groups 0 dir2 levels x) caustic-level))))
    (update-mood-itimes context))
  0
  (none))


(defun update-mood-darkcave ((context mood-context) (hour float) (level-index int))
  "Update Dark Eco Plant's mood, lava glow, and proximity-based local lighting."
  (when (not (paused?))
    (clear-mood-times context)
    (set! (-> context times 0 w) 1.0)
    (set-vector! (-> context mood-lights-table data 0 prt-color) 0.0 0.0 0.0 0.0)
    (when *time-of-day-effects*
      (let ((strongest-light 0.0)
            (light-direction (new 'stack-no-clear 'vector)))
        (let ((offset (new 'stack-no-clear 'vector)))
          0.0
          0.0
          (set-vector! light-direction 0.0 -1.0 0.0 0.0)
          (let ((i 1)
                (last-index 7))
            (while (>= last-index i)
              (let ((control-fade (-> *palette-fade-controls* control i fade)))
                (set! (-> context times i w) control-fade)
                (vector-! offset (-> *palette-fade-controls* control i trans) (-> *target* control trans))
                (let* ((distance (vector-length offset))
                       (local-strength (* control-fade (fmax 0.0 (fmin 1.0 (- 1.0 (/ distance (meters 20))))))))
                  (vector-normalize! offset local-strength)
                  (if (< strongest-light local-strength) (set! strongest-light local-strength))))
              (vector+! light-direction light-direction offset)
              (+! i 1))))
        (let ((ambient-blend (fmin 1.0 strongest-light))
              (warm-ambient (new 'static 'vector :y 1.0 :z 0.5 :w 1.0))
              (base-ambient (new 'static 'vector :x 0.3 :y 0.4 :z 0.5 :w 1.0)))
          (vector-lerp! (-> context mood-lights-table data 0 amb-color) base-ambient warm-ambient ambient-blend))
        (set! (-> context mood-lights-table data 0 prt-color quad) (-> context mood-lights-table data 0 amb-color quad))
        (vector-normalize! light-direction 1.0)
        (let ((shadow-direction (-> context mood-lights-table data 0 shadow)))
          (set! (-> shadow-direction x) (- (-> light-direction x)))
          (set! (-> shadow-direction y) (- (-> light-direction y)))
          (set! (-> shadow-direction z) (- (-> light-direction z)))
          (when (< (-> light-direction y) 0.9063)
            (let ((horizontal-scale (/ 0.4226 (sqrtf (+ (square (-> shadow-direction x)) (square (-> shadow-direction z)))))))
              (set! (-> shadow-direction x) (* (-> shadow-direction x) horizontal-scale))
              (set! (-> shadow-direction y) -0.9063)
              (set! (-> shadow-direction z) (* (-> shadow-direction z) horizontal-scale)))))))
    (set! *teleport* #t)
    (update-mood-quick context 0 0 0 level-index)
    (set-vector! (-> context current-shadow-color) 0.25 0.25 0.25 1.0)
    (update-mood-itimes context))
  0
  (none))


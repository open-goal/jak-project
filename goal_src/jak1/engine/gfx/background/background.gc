;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/gfx/hw/display.gc")
(require "engine/gfx/tie/generic-tie-h.gc")
(require "engine/gfx/tie/tie-h.gc")
(require "engine/gfx/mood/time-of-day-h.gc")
(require "engine/gfx/background/background-h.gc")
(require "engine/gfx/tfrag/tfrag-h.gc")
(require "engine/gfx/background/subdivide-h.gc")
(require "engine/gfx/shrub/shrubbery-h.gc")
(require "engine/ps2/vu1-macros.gc")

;; The "background" is a collection of renderers.
;; The recursive draw call through the drawable trees will add drawables to various lists.
;; After this, (finish-background) is called to finalize DMA lists.
;;
;; TFRAG -- terrain, smooth cave walls, etc. Not instanced. Detail is a nested
;; vertex array (base points, then level-0 additions, then level-1 additions).
;; To simplify, it moves a vertex to the midpoint of a parent edge, creating a degenerate triangle
;; that can be removed.
;; To avoid t-junctions, morph weights are calculated per _vertex_ meaning that points appearing in
;; multiple fragments are computed the same way in both fragments.
;; Colors come from one time-of-day palette per tree, indexed per fragment. There are
;; several categories: ordinary, translucent, dirt, ice, and low-resolution versions of the first
;; two. These share the same renderer but have different ordering and blending settings.
;; Geometry that reaches the camera goes to TFRAG-NEAR, which clips. There is no generic fallback,
;; the generic field is never populated and there's no renderer.
;;
;; TIE -- background models placed repeatedly, typically rocks, trees, roof tiles, etc.
;; TIE can handle very small objects placed many times, or very complicated objects placed few times
;; quite well.
;; A prototype's geometry is uploaded to VU1 once and then every placement that chose it
;; streams through as a 64-byte instance record. The whole instance is drawn at one level, with one morph
;; weight for the entire placement -- there is no per-vertex evaluation and no seam problem, because
;; every fragment of a prototype is always at the same level. One time-of-day palette per prototype,
;; shared by all its instances; each index has its own palette *index* per vertex, so the
;; same prototype have different lighting per instance. Instances near the camera go to TIE-NEAR,
;; which clips. Prototypes needing an environment map leave the VU1 path entirely and go through
;; GENERIC-TIE. On PC, we send those to ETIE instead of taking the slower generic path.
;;
;; SHRUB -- small vegetation, instanced like TIE but with no LOD morph. Turns into billboard or fades
;; out at long distance. Each instance is "lit" by a single time-of-day color.
;;
;; The original design has all background renderers share the VU0 program uploaded by background-upload-vu0 below,
;; the scratchpad terrain-context, and the convention that vf16..vf31 hold camera state for the whole background pass.
;; However, the final versions of these renderers set up their own conventions.

(define *background-work* (new 'global 'background-work))

;; The setup entry stores the camera state in VU0 data memory:
;;   0..3   clipping-plane matrix
;;   4..7   camera rotation (includes translation)
;;   8..11  camera temporary matrix (camera with perspective)
;;   12..15 each camera-rotation row's z coefficient broadcast across all lanes
;;          used for distance-from-camera testing to select level of detail
;;
;; Entries 16, 25, and 29 reload the clipping planes and either depth or full rotation constants.
;; Entry 33 transforms one point to plane distances and camera depth. Entry 42 additionally applies
;; camera-temp and returns the full camera-space result. vf2 is the input point; vf4 is the plane
;; result, vf5 is camera-temp times the point, vf6 is camera rotation times the point, and vi1
;; receives the selected MAC sign flags. The shrub matrix remains live in vf20..vf23.
(#when PC_PORT
  (define background-vu0-block (new 'static 'vu-function :length #x0 :qlength #x0)))

(#unless PC_PORT
  (defvu0 background-vu0-block
          ;; Entry 0: cache all camera constants. The depth rows are formed here so the hot point
          ;; transforms can calculate a broadcast camera-space z with four multiply-adds.
          (vu-pair (sq.xyzw vf24 vi00 4) (maxw.xyzw vf01 vf00 vf00)) ;; #x000
          (vu-pair (sq.xyzw vf25 vi00 5) (nop)) ;; #x001
          (vu-pair (sq.xyzw vf26 vi00 6) (nop)) ;; #x002
          (vu-pair (sq.xyzw vf27 vi00 7) (nop)) ;; #x003
          (vu-pair (sq.xyzw vf16 vi00 0) (mulz.xyzw vf24 vf01 vf24)) ;; #x004
          (vu-pair (sq.xyzw vf17 vi00 1) (mulz.xyzw vf25 vf01 vf25)) ;; #x005
          (vu-pair (sq.xyzw vf18 vi00 2) (mulz.xyzw vf26 vf01 vf26)) ;; #x006
          (vu-pair (sq.xyzw vf19 vi00 3) (mulz.xyzw vf27 vf01 vf27)) ;; #x007
          (vu-pair (sq.xyzw vf24 vi00 12) (nop)) ;; #x008
          (vu-pair (sq.xyzw vf25 vi00 13) (nop)) ;; #x009
          (vu-pair (sq.xyzw vf26 vi00 14) (nop)) ;; #x00a
          (vu-pair (sq.xyzw vf27 vi00 15) (nop)) ;; #x00b
          (vu-pair (sq.xyzw vf28 vi00 8) (nop)) ;; #x00c
          (vu-pair (sq.xyzw vf29 vi00 9) (nop)) ;; #x00d
          (vu-pair (sq.xyzw vf30 vi00 10) (nop)) ;; #x00e
          (vu-pair (sq.xyzw vf31 vi00 11) (nop :e)) ;; #x00f
          ;; Entry 16: load clipping planes and the broadcast depth coefficients. vi2 selects the
          ;; four MAC sign flags produced by the point entries.
          (label load-planes-and-depth)
          (vu-pair (iaddiu vi02 vi00 0xf0) (nop)) ;; #x010
          (vu-pair (lq.xyzw vf16 vi00 0) (nop)) ;; #x011
          (vu-pair (lq.xyzw vf17 vi00 1) (nop)) ;; #x012
          (vu-pair (lq.xyzw vf18 vi00 2) (nop)) ;; #x013
          (vu-pair (lq.xyzw vf19 vi00 3) (nop)) ;; #x014
          (vu-pair (lq.xyzw vf24 vi00 12) (nop)) ;; #x015
          (vu-pair (lq.xyzw vf25 vi00 13) (nop)) ;; #x016
          (vu-pair (lq.xyzw vf26 vi00 14) (nop :e)) ;; #x017
          (vu-pair (lq.xyzw vf27 vi00 15) (nop)) ;; #x018
          ;; Entry 25: reload only the clipping planes.
          (label load-planes)
          (vu-pair (lq.xyzw vf16 vi00 0) (nop)) ;; #x019
          (vu-pair (lq.xyzw vf17 vi00 1) (nop)) ;; #x01a
          (vu-pair (lq.xyzw vf18 vi00 2) (nop :e)) ;; #x01b
          (vu-pair (lq.xyzw vf19 vi00 3) (nop)) ;; #x01c
          ;; Entry 29: reload the full camera-rotation rows.
          (label load-camera-rotation)
          (vu-pair (lq.xyzw vf24 vi00 4) (nop)) ;; #x01d
          (vu-pair (lq.xyzw vf25 vi00 5) (nop)) ;; #x01e
          (vu-pair (lq.xyzw vf26 vi00 6) (nop :e)) ;; #x01f
          (vu-pair (lq.xyzw vf27 vi00 7) (nop)) ;; #x020
          ;; Entry 33: calculate the signed plane distances in vf4 and camera-space depth in vf6.
          ;; Subtracting the fourth plane row makes the plane constants agree with the culling tests.
          (label transform-plane-and-depth)
          (vu-pair (lq.xyzw vf24 vi00 12) (mulax.xyzw ACC vf16 vf02)) ;; #x021
          (vu-pair (lq.xyzw vf25 vi00 13) (madday.xyzw ACC vf17 vf02)) ;; #x022
          (vu-pair (lq.xyzw vf26 vi00 14) (maddaz.xyzw ACC vf18 vf02)) ;; #x023
          (vu-pair (lq.xyzw vf27 vi00 15) (msubaw.xyzw ACC vf19 vf00)) ;; #x024
          (vu-pair (nop) (maddw.xyzw vf04 vf01 vf02)) ;; #x025
          (vu-pair (nop) (mulax.xyzw ACC vf24 vf02)) ;; #x026
          (vu-pair (nop) (madday.xyzw ACC vf25 vf02)) ;; #x027
          (vu-pair (nop) (maddaz.xyzw ACC vf26 vf02 :e)) ;; #x028
          (vu-pair (fmand vi01 vi02) (maddw.xyzw vf06 vf27 vf00)) ;; #x029
          ;; Entry 42: calculate plane distances plus both full camera transforms.
          (label transform-point)
          (vu-pair (lq.xyzw vf16 vi00 0) (nop)) ;; #x02a
          (vu-pair (lq.xyzw vf17 vi00 1) (nop)) ;; #x02b
          (vu-pair (lq.xyzw vf18 vi00 2) (nop)) ;; #x02c
          (vu-pair (lq.xyzw vf19 vi00 3) (nop)) ;; #x02d
          (vu-pair (lq.xyzw vf28 vi00 8) (mulax.xyzw ACC vf16 vf02)) ;; #x02e
          (vu-pair (lq.xyzw vf29 vi00 9) (madday.xyzw ACC vf17 vf02)) ;; #x02f
          (vu-pair (lq.xyzw vf30 vi00 10) (maddaz.xyzw ACC vf18 vf02)) ;; #x030
          (vu-pair (lq.xyzw vf31 vi00 11) (msubaw.xyzw ACC vf19 vf00)) ;; #x031
          (vu-pair (lq.xyzw vf24 vi00 4) (maddw.xyzw vf04 vf01 vf02)) ;; #x032
          (vu-pair (lq.xyzw vf25 vi00 5) (mulax.xyzw ACC vf28 vf02)) ;; #x033
          (vu-pair (lq.xyzw vf26 vi00 6) (madday.xyzw ACC vf29 vf02)) ;; #x034
          (vu-pair (lq.xyzw vf27 vi00 7) (maddaz.xyzw ACC vf30 vf02)) ;; #x035
          (vu-pair (fmand vi01 vi02) (maddw.xyzw vf05 vf31 vf00)) ;; #x036
          (vu-pair (nop) (mulax.xyzw ACC vf24 vf02)) ;; #x037
          (vu-pair (nop) (madday.xyzw ACC vf25 vf02)) ;; #x038
          (vu-pair (nop) (maddaz.xyzw ACC vf26 vf02 :e)) ;; #x039
          (vu-pair (nop) (maddw.xyzw vf06 vf27 vf00)) ;; #x03a
          ))

(#unless PC_PORT
  (defun background-upload-vu0 ()
    "Upload the shared background VU0 program and cache the camera clipping planes and transforms in
     VU0 data memory. wait-to-vu0 counts polls spent waiting for an earlier VIF0 transfer before the
     initialization entry point runs."
    (add.i sp sp -16)
    (s.d ra sp)
    (rlet ((upload-proc :reg t9)
           (program :reg a0)
           (work :reg v1)
           (wait-counter :reg a1))
      (m! upload-proc upload-vu0-program)
      (m! program background-vu0-block)
      (m! work *background-work*)
      (add.i wait-counter work 576)
      (jalr ra upload-proc :delay (sll v0 ra 0)))
    (rlet ((camera :reg v1))
      (m! camera *math-camera*)
      (l.vf vf16 camera 860)
      (l.vf vf17 camera 876)
      (l.vf vf18 camera 892)
      (l.vf vf19 camera 908)
      (l.vf vf20 camera 988)
      (l.vf vf21 camera 1004)
      (l.vf vf22 camera 1020)
      (l.vf vf23 camera 1036)
      (l.vf vf24 camera 364)
      (l.vf vf25 camera 380)
      (l.vf vf26 camera 396)
      (l.vf vf27 camera 412)
      (l.vf vf28 camera 572)
      (l.vf vf29 camera 588)
      (l.vf vf30 camera 604)
      (l.vf vf31 camera 620)
      (l.vf vf31 camera 620))
    (rlet ((vif0-chcr :reg v1)
           (wait-counter :reg a0)
           (wait-count :reg a1)
           (vif0-busy :reg a2))
      (lui vif0-chcr #x1000)
      (ori vif0-chcr vif0-chcr #x8000)
      (m! wait-counter *background-work*)
      (add.i wait-counter wait-counter 576)
      (l.w wait-count vif0-chcr)
      (and.i wait-count wait-count #x100)
      (b.z wait-count start-vu0 :delay (at-label poll-vif0 (l.w wait-count wait-counter)))
      (nop!)
      (l.w vif0-busy vif0-chcr)
      (nop!)
      (and.i vif0-busy vif0-busy #x100)
      (add.i wait-count wait-count 1)
      (b.nz vif0-busy poll-vif0 :delay (s.w wait-count wait-counter))
      (label start-vu0)
      (m v1 r0)
      (callms 0)
      (m v0 r0))
    (l.d ra sp)
    (jr ra :delay (add.i sp sp 16))))

(#when PC_PORT
  (defun background-upload-vu0 ()
    "Upload the shared background VU0 program and cache the camera clipping planes and transforms in
     VU0 data memory. wait-to-vu0 counts polls spent waiting for an earlier VIF0 transfer before the
     initialization entry point runs."
    ;; PC draw functions consume the camera registers directly, so no VIF0 upload or VU0 call is
    ;; needed here.
    (let ((camera *math-camera*))
      (with-vf (vf16 vf17 vf18 vf19 vf20 vf21 vf22 vf23 vf24 vf25 vf26 vf27 vf28 vf29 vf30 vf31)
        :rw 'write
        (.lvf vf16 (&-> camera plane 0 quad))
        (.lvf vf17 (&-> camera plane 1 quad))
        (.lvf vf18 (&-> camera plane 2 quad))
        (.lvf vf19 (&-> camera plane 3 quad))
        (.lvf vf20 (&-> camera shrub-mat vector 0 quad))
        (.lvf vf21 (&-> camera shrub-mat vector 1 quad))
        (.lvf vf22 (&-> camera shrub-mat vector 2 quad))
        (.lvf vf23 (&-> camera shrub-mat vector 3 quad))
        (.lvf vf24 (&-> camera camera-rot vector 0 quad))
        (.lvf vf25 (&-> camera camera-rot vector 1 quad))
        (.lvf vf26 (&-> camera camera-rot vector 2 quad))
        (.lvf vf27 (&-> camera camera-rot vector 3 quad))
        (.lvf vf28 (&-> camera camera-temp vector 0 quad))
        (.lvf vf29 (&-> camera camera-temp vector 1 quad))
        (.lvf vf30 (&-> camera camera-temp vector 2 quad))
        (.lvf vf31 (&-> camera camera-temp vector 3 quad))))))

(defun init-background ()
  "Clear the frame-local background tree queues, counts, and VU0 wait counter."
  (dotimes (i 8)
    (set! (-> *background-work* tfrag-trees i) #f)
    (set! (-> *background-work* trans-tfrag-trees i) #f)
    (set! (-> *background-work* dirt-tfrag-trees i) #f)
    (set! (-> *background-work* ice-tfrag-trees i) #f)
    (set! (-> *background-work* lowres-tfrag-trees i) #f)
    (set! (-> *background-work* lowres-trans-tfrag-trees i) #f))
  (set! (-> *background-work* tfrag-tree-count) 0)
  (set! (-> *background-work* trans-tfrag-tree-count) 0)
  (set! (-> *background-work* dirt-tfrag-tree-count) 0)
  (set! (-> *background-work* ice-tfrag-tree-count) 0)
  (set! (-> *background-work* lowres-tfrag-tree-count) 0)
  (set! (-> *background-work* lowres-trans-tfrag-tree-count) 0)
  (set! (-> *background-work* shrub-tree-count) 0)
  (set! (-> *background-work* tie-tree-count) 0)
  (set! (-> *background-work* wait-to-vu0) (the-as uint 0))
  0
  (none))

(defun upload-vis-bits ((lev level) (previous-lev level) (bsp bsp-header))
  "Copy lev's visibility bit list to the terrain scratchpad. When artist visibility inversion is
   enabled, xor it with bsp's all-visible list so only drawable bits are flipped. previous-lev is
   retained by the calling convention but is not read."
  (let ((qwc (/ (+ (-> bsp visible-list-length) 15) 16)))
    (let ((lev-vis-bits (the-as (pointer uint128) (-> lev vis-bits)))
          (all-visible-bits (the-as (pointer uint128) (-> bsp all-visible-list)))
          ;;(spad-vis (the-as (pointer uint128) (+ #x38b0 #x70000000)))
          (spad-vis-bits (scratchpad-ptr uint128 :offset VISIBLE_LIST_SCRATCHPAD)))
      (b! (not *artist-flip-visible*) cfg-5 :delay (nop!))
      (nop!)
      (nop!)
      (label cfg-2)
      ;; flip visible is selected. unfortunately this code is wrong and uses a 64-bit xor.
      (let ((lev-mask (-> lev-vis-bits 0)))
        (set! lev-vis-bits (&-> lev-vis-bits 1))
        (let ((all-visible-mask (-> all-visible-bits 0)))
          (set! all-visible-bits (&-> all-visible-bits 1))
          (nop!)
          (nop!)
          ;; xor with all visible to flip the bits of the things that exist.
          (let ((flipped-mask (logxor lev-mask (the-as uint all-visible-mask))))
            (+! qwc -1)
            (set! (-> spad-vis-bits 0) flipped-mask))))
      (set! spad-vis-bits (&-> spad-vis-bits 1))
      (b! (> qwc 0) cfg-2 :delay (nop!))
      0
      (b! #t cfg-8 :delay (nop!))
      ;; flip visible isn't selected, just copy to scratchpad.
      (nop!)
      (label cfg-5)
      (nop!)
      (nop!)
      (label cfg-6)
      (let ((vis-mask (-> lev-vis-bits 0)))
        (set! lev-vis-bits (&-> lev-vis-bits 1))
        (nop!)
        (+! qwc -1)
        (set! (-> spad-vis-bits 0) vis-mask))
      (set! spad-vis-bits (&-> spad-vis-bits 1)))
    (b! (> qwc 0) cfg-6 :delay (nop!)))
  0
  (label cfg-8)
  (none))

(#when PC_PORT
  (defun add-pc-port-background-data ((dma-buf dma-buffer))
    "Append each streamed level's visibility mask to the tfrag-0 bucket for the PC renderers. An
     active level contributes all 128 mask quadwords; an inactive slot contributes one zero
     quadword so the two level positions remain explicit."
    (dotimes (lev-index 2)
      (let ((lev (-> *level* level lev-index))
            (dma-start (-> dma-buf base)))
        (cond
          ((= (-> lev status) 'active)
           (let ((packet (the-as dma-packet (-> dma-buf base))))
             (set! (-> packet dma) (new 'static 'dma-tag :id (dma-tag-id cnt) :qwc 128))
             (set! (-> packet vif0) (new 'static 'vif-tag))
             (set! (-> packet vif1) (new 'static 'vif-tag :cmd (vif-cmd pc-port)))
             (set! (-> dma-buf base) (the pointer (&+ packet 16))))
           (quad-copy! (-> dma-buf base) (-> lev vis-bits) 128)
           (&+! (-> dma-buf base) (* 16 128)))
          (else
           (let ((packet (the-as dma-packet (-> dma-buf base))))
             (set! (-> packet dma) (new 'static 'dma-tag :id (dma-tag-id cnt) :qwc 1))
             (set! (-> packet vif0) (new 'static 'vif-tag))
             (set! (-> packet vif1) (new 'static 'vif-tag :cmd (vif-cmd pc-port)))
             (set! (-> dma-buf base) (the pointer (&+ packet 16))))
           (set! (-> (the (pointer uint128) (-> dma-buf base))) (the uint128 0))
           (&+! (-> dma-buf base) (* 16 1))))
        (let ((dma-end-tag (-> dma-buf base)))
          (let ((end-packet (the-as dma-packet (-> dma-buf base))))
            (set! (-> end-packet dma) (new 'static 'dma-tag :id (dma-tag-id next)))
            (set! (-> end-packet vif0) (new 'static 'vif-tag))
            (set! (-> end-packet vif1) (new 'static 'vif-tag))
            (set! (-> dma-buf base) (&+ (the-as pointer end-packet) 16)))
          (dma-bucket-insert-tag (-> *display* frames (-> *display* on-screen) frame bucket-group)
                                 (bucket-id tfrag-0)
                                 dma-start
                                 (the-as (pointer dma-tag) dma-end-tag)))))))

(define *use-etie* #t)

(defun finish-background ()
  "Consume the background trees collected during drawable traversal. This draws shrubbery and each
   terrain category with the owning level's visibility and mood state, records nearest terrain
   distances, draws TIE instances, and appends any fallback generic-TIE output to its foreground
   bucket."
  ;; set up common VU0 stuff for background.
  (background-upload-vu0)
  (#when PC_PORT
    (add-pc-port-background-data (-> *display* frames (-> *display* on-screen) frame global-buf)))
  ;;;;;;;;;;;;;;;;
  ;; shrubbery
  ;;;;;;;;;;;;;;;;
  (set! (-> *instance-shrub-work* paused) (paused?))  
  (when (nonzero? (-> *background-work* shrub-tree-count))
    (add-profile-frame! #x40 0 #x40 #x80 'draw)
    (dotimes (i (-> *background-work* shrub-tree-count))
      (set! (-> (scratchpad-object terrain-context) bsp lev-index) (-> *background-work* shrub-levels i index))
      (flush-cache 0)
      (let ((shrub-tree (-> *background-work* shrub-trees i))
            (shrub-lev (-> *background-work* shrub-levels i)))
        ;; og:perserve-this - shrub colors computed in C++ now
        ;; (if (nonzero? (-> shrub-tree colors-added))
        ;;     (time-of-day-interp-colors (-> *instance-shrub-work* colors) (-> shrub-tree colors-added) (-> shrub-lev mood)))
        (draw-drawable-tree-instance-shrub shrub-tree shrub-lev)))
    (add-profile-frame! #x40 #x60 #x80 #x80 'draw))
      
  (let ((previous-lev (the-as level #f)))
    (when (or (nonzero? (-> *background-work* tfrag-tree-count))
              (nonzero? (-> *background-work* trans-tfrag-tree-count))
              (nonzero? (-> *background-work* dirt-tfrag-tree-count))
              (nonzero? (-> *background-work* ice-tfrag-tree-count))
              (nonzero? (-> *background-work* lowres-tfrag-tree-count))
              (nonzero? (-> *background-work* lowres-trans-tfrag-tree-count)))
      ;; Entry 0 broadcasts vf24..vf27's z lanes while caching the depth rows. Restore the full
      ;; background register convention before the draw functions use those registers.
      (let ((camera *math-camera*))
        (with-vf (vf16 vf17 vf18 vf19 vf20 vf21 vf22 vf23 vf24 vf25 vf26 vf27 vf28 vf29 vf30 vf31)
          :rw 'write
          (.lvf vf16 (&-> camera plane 0 quad))
          (.lvf vf17 (&-> camera plane 1 quad))
          (.lvf vf18 (&-> camera plane 2 quad))
          (.lvf vf19 (&-> camera plane 3 quad))
          (.lvf vf20 (&-> camera shrub-mat vector 0 quad))
          (.lvf vf21 (&-> camera shrub-mat vector 1 quad))
          (.lvf vf22 (&-> camera shrub-mat vector 2 quad))
          (.lvf vf23 (&-> camera shrub-mat vector 3 quad))
          (.lvf vf24 (&-> camera camera-rot vector 0 quad))
          (.lvf vf25 (&-> camera camera-rot vector 1 quad))
          (.lvf vf26 (&-> camera camera-rot vector 2 quad))
          (.lvf vf27 (&-> camera camera-rot vector 3 quad))
          (.lvf vf28 (&-> camera camera-temp vector 0 quad))
          (.lvf vf29 (&-> camera camera-temp vector 1 quad))
          (.lvf vf30 (&-> camera camera-temp vector 2 quad))
          (.lvf vf31 (&-> camera camera-temp vector 3 quad))
          (.lvf vf31 (&-> camera camera-temp vector 3 quad))))
      ;; TFRAG
      (let* ((highres-tree-count (max (-> *background-work* tfrag-tree-count) (-> *background-work* trans-tfrag-tree-count)))
             (previous-palette (the-as time-of-day-palette #f))
             (tfrag-tree-count (max (max highres-tree-count (-> *background-work* lowres-tfrag-tree-count))
                                    (-> *background-work* lowres-trans-tfrag-tree-count))))
        (add-profile-frame! #x40 0 #x40 #x80 'draw)
        ;; loop over all tfrag trees
        (dotimes (i tfrag-tree-count)
          ;;;;;;;;;;;;;; Normal TFRAG
          (let ((tfrag-tree (-> *background-work* tfrag-trees i)))
            (when tfrag-tree
              (let ((tfrag-lev (-> *background-work* tfrag-levels i)))
                (let ((tfrag-bsp (-> tfrag-lev bsp))
                      (tfrag-palette (-> tfrag-tree time-of-day-pal)))
                  ;; load visibility data
                  (upload-vis-bits tfrag-lev previous-lev tfrag-bsp)
                  ;; update colors, but only if needed
                  (when (not (or (zero? tfrag-palette) (= previous-palette tfrag-palette)))
                    (flush-cache 0)
                    ;;(time-of-day-interp-colors-scratch (scratchpad-ptr rgba :offset 6160) tfrag-palette (-> tfrag-lev mood))
                    ;; remember the previous colors
                    (set! previous-palette tfrag-palette)))
                ;; set the level.
                (set! (-> (scratchpad-object terrain-context) bsp lev-index) (-> tfrag-lev index))
                (set! (-> *tfrag-work* min-dist z) 4095996000.0)
                ;; draw!
                (draw-drawable-tree-tfrag tfrag-tree tfrag-lev))
              ;; remember closest.
              (set! (-> *level* level (-> (scratchpad-object terrain-context) bsp lev-index) closest-object 0)
                    (-> *tfrag-work* min-dist z))))
          ;;;;;;;;;;;;;; Trans TFRAG
          (let ((trans-tfrag-tree (-> *background-work* trans-tfrag-trees i)))
            (when trans-tfrag-tree
              (let ((trans-tfrag-lev (-> *background-work* trans-tfrag-levels i)))
                (let ((trans-tfrag-bsp (-> trans-tfrag-lev bsp))
                      (trans-tfrag-palette (-> trans-tfrag-tree time-of-day-pal)))
                  (upload-vis-bits trans-tfrag-lev previous-lev trans-tfrag-bsp)
                  (when (not (or (zero? trans-tfrag-palette) (= previous-palette trans-tfrag-palette)))
                    (flush-cache 0)
                    ;;(time-of-day-interp-colors-scratch (scratchpad-ptr rgba :offset 6160) trans-tfrag-palette (-> trans-tfrag-lev mood))
                    (set! previous-palette trans-tfrag-palette)))
                (set! (-> (scratchpad-object terrain-context) bsp lev-index) (-> trans-tfrag-lev index))
                (set! (-> *tfrag-work* min-dist z) 4095996000.0)
                (draw-drawable-tree-trans-tfrag trans-tfrag-tree trans-tfrag-lev))
              (set! (-> *level* level (-> (scratchpad-object terrain-context) bsp lev-index) closest-object 3)
                    (-> *tfrag-work* min-dist z))))
          ;;;;;;;;;;;;;; DIRT TFRAG
          (let ((dirt-tfrag-tree (-> *background-work* dirt-tfrag-trees i)))
            (when dirt-tfrag-tree
              (let ((dirt-tfrag-lev (-> *background-work* dirt-tfrag-levels i)))
                (let ((dirt-tfrag-bsp (-> dirt-tfrag-lev bsp))
                      (dirt-tfrag-palette (-> dirt-tfrag-tree time-of-day-pal)))
                  (upload-vis-bits dirt-tfrag-lev previous-lev dirt-tfrag-bsp)
                  (when (not (or (zero? dirt-tfrag-palette) (= previous-palette dirt-tfrag-palette)))
                    (flush-cache 0)
                    ;;(time-of-day-interp-colors-scratch (scratchpad-ptr rgba :offset 6160) dirt-tfrag-palette (-> dirt-tfrag-lev mood))
                    (set! previous-palette dirt-tfrag-palette)))
                (set! (-> (scratchpad-object terrain-context) bsp lev-index) (-> dirt-tfrag-lev index))
                (set! (-> *tfrag-work* min-dist z) 4095996000.0)
                (draw-drawable-tree-dirt-tfrag dirt-tfrag-tree dirt-tfrag-lev))
              (set! (-> *level* level (-> (scratchpad-object terrain-context) bsp lev-index) closest-object 3)
                    (fmin (-> *level* level (-> (scratchpad-object terrain-context) bsp lev-index) closest-object 3)
                          (-> *tfrag-work* min-dist z)))))
          ;;;;;;;;;;;;;; ICE TFRAG
          (let ((ice-tfrag-tree (-> *background-work* ice-tfrag-trees i)))
            (when ice-tfrag-tree
              (let ((ice-tfrag-lev (-> *background-work* ice-tfrag-levels i)))
                (let ((ice-tfrag-bsp (-> ice-tfrag-lev bsp))
                      (ice-tfrag-palette (-> ice-tfrag-tree time-of-day-pal)))
                  (upload-vis-bits ice-tfrag-lev previous-lev ice-tfrag-bsp)
                  (when (not (or (zero? ice-tfrag-palette) (= previous-palette ice-tfrag-palette)))
                    (flush-cache 0)
                    ;;(time-of-day-interp-colors-scratch (scratchpad-ptr rgba :offset 6160) ice-tfrag-palette (-> ice-tfrag-lev mood))
                    (set! previous-palette ice-tfrag-palette)))
                (set! (-> (scratchpad-object terrain-context) bsp lev-index) (-> ice-tfrag-lev index))
                (set! (-> *tfrag-work* min-dist z) 4095996000.0)
                (draw-drawable-tree-ice-tfrag ice-tfrag-tree ice-tfrag-lev))
              (set! (-> *level* level (-> (scratchpad-object terrain-context) bsp lev-index) closest-object 3)
                    (fmin (-> *level* level (-> (scratchpad-object terrain-context) bsp lev-index) closest-object 3)
                          (-> *tfrag-work* min-dist z)))))
          ;;;;;;;;;;;;;; LOWRES TFRAG
          (let ((lowres-tfrag-tree (-> *background-work* lowres-tfrag-trees i)))
            (when lowres-tfrag-tree
              (let ((lowres-tfrag-lev (-> *background-work* lowres-tfrag-levels i)))
                (let ((lowres-tfrag-bsp (-> lowres-tfrag-lev bsp))
                      (lowres-tfrag-palette (-> lowres-tfrag-tree time-of-day-pal)))
                  (upload-vis-bits lowres-tfrag-lev previous-lev lowres-tfrag-bsp)
                  (when (not (or (zero? lowres-tfrag-palette) (= previous-palette lowres-tfrag-palette)))
                    (flush-cache 0)
                    ;;(time-of-day-interp-colors-scratch (scratchpad-ptr rgba :offset 6160) lowres-tfrag-palette (-> lowres-tfrag-lev mood))
                    (set! previous-palette lowres-tfrag-palette)))
                (set! (-> (scratchpad-object terrain-context) bsp lev-index) (-> lowres-tfrag-lev index))
                ;;(format 0 "draw ~A~%" lowres-tfrag-tree)
                (draw-drawable-tree-tfrag lowres-tfrag-tree lowres-tfrag-lev))))
          ;;;;;;;;;;;;;; LOWRES TRANS TFRAG
          (let ((lowres-trans-tfrag-tree (-> *background-work* lowres-trans-tfrag-trees i)))
            (when lowres-trans-tfrag-tree
              (let ((lowres-trans-tfrag-lev (-> *background-work* lowres-trans-tfrag-levels i)))
                (let ((lowres-trans-tfrag-bsp (-> lowres-trans-tfrag-lev bsp))
                      (lowres-trans-tfrag-palette (-> lowres-trans-tfrag-tree time-of-day-pal)))
                  (upload-vis-bits lowres-trans-tfrag-lev previous-lev lowres-trans-tfrag-bsp)
                  (when (not (or (zero? lowres-trans-tfrag-palette) (= previous-palette lowres-trans-tfrag-palette)))
                    (flush-cache 0)
                    ;;(time-of-day-interp-colors-scratch (scratchpad-ptr rgba :offset 6160) lowres-trans-tfrag-palette (-> lowres-trans-tfrag-lev mood))
                    (set! previous-palette lowres-trans-tfrag-palette)))
                (set! (-> (scratchpad-object terrain-context) bsp lev-index) (-> lowres-trans-tfrag-lev index))
                (set! (-> *tfrag-work* min-dist z) 4095996000.0)
                (draw-drawable-tree-trans-tfrag lowres-trans-tfrag-tree lowres-trans-tfrag-lev))
              (set! (-> *level* level (-> (scratchpad-object terrain-context) bsp lev-index) closest-object 3)
                    (fmin (-> *level* level (-> (scratchpad-object terrain-context) bsp lev-index) closest-object 3)
                          (-> *tfrag-work* min-dist z)))))))
      (add-profile-frame! #x40 #x80 #x60 #x80 'draw))
    ;;;;;;;;;; TIE (TFRAG Instance Engine)
    ;; common setup
    (set! (-> *instance-tie-work* paused) (paused?))
    (when (nonzero? (-> *background-work* tie-tree-count))
      (tie-near-make-perspective-matrix (-> *instance-tie-work* tie-near-perspective-matrix))
      (add-profile-frame! #x40 0 #x40 #x80 'draw)
      ;;;;;;;;;; Normal TIE
      (dotimes (i (-> *background-work* tie-tree-count))
        (let ((tie-lev (-> *background-work* tie-levels i)))
          (let ((tie-bsp (-> tie-lev bsp)))
            (when (!= tie-lev previous-lev)
              (set! (-> *instance-tie-work* min-dist x) 4095996000.0)
              (upload-vis-bits tie-lev previous-lev tie-bsp)
              (set! previous-lev tie-lev)))
          (set! (-> (scratchpad-object terrain-context) bsp lev-index) (-> tie-lev index))
          (set! (-> (scratchpad-object terrain-context) bsp mood) (-> tie-lev mood))
          (draw-drawable-tree-instance-tie (-> *background-work* tie-trees i) tie-lev))
        (set! (-> *background-work* tie-generic i) (the-as basic (-> *instance-tie-work* first-generic-prototype))))
      (add-profile-frame! #x80 #x20 #x60 #x80 'draw)
      
      ;; TIE Generic
      (when (not *use-etie*)
        (dotimes (i (-> *background-work* tie-tree-count))
          (when (nonzero? (-> *background-work* tie-generic i))
            ;; send to the generic foreground with tfrag textures bucket for this level
            (let* ((generic-sink (-> *background-work* tie-levels i tfrag-tex-foreground-sink-group generic-sink))
                   (dma-buf (-> *display* frames (-> *display* on-screen) frame global-buf))
                   (dma-start (-> dma-buf base)))
              (generic-tie-execute generic-sink dma-buf (-> *background-work* tie-generic i))
              (let ((dma-end-tag (-> dma-buf base)))
                (let ((end-packet (the-as dma-packet (-> dma-buf base))))
                  (set! (-> end-packet dma) (new 'static 'dma-tag :id (dma-tag-id next)))
                  (set! (-> end-packet vif0) (new 'static 'vif-tag))
                  (set! (-> end-packet vif1) (new 'static 'vif-tag))
                  (set! (-> dma-buf base) (&+ (the-as pointer end-packet) 16)))
                (dma-bucket-insert-tag (-> *display* frames (-> *display* on-screen) frame bucket-group)
                                       (-> generic-sink bucket)
                                       dma-start
                                       (the-as (pointer dma-tag) dma-end-tag)))))))))
  0
  (none))

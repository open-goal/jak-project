;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/gfx/background/wind-h.gc")
(require "engine/gfx/hw/display-h.gc")

;; note: modified for high fps

;; definition for symbol *wind-work*, type wind-work
(define *wind-work* (new 'global 'wind-work))

;; definition for function update-wind
;; INFO: Return type mismatch int vs none.
(defun update-wind ((work wind-work) (gust-table (array uint8)))
  "Advance the shared procedural wind. Random-walk the ground-plane heading, then linearly
   interpolate the cyclic gust table over 120 effective ticks per entry and multiply that envelope
   by a fresh random amplitude. Store the resulting scalar force and direction in the current slot
   of the 64-sample ring. work must be *wind-work*, and gust-table must not be empty. The PC time
   ratio adjusts gust/ring progression and output magnitude for custom frame rates."
  ;; Keep the heading bounded by removing whole turns, then rebuild its xz unit direction.
  (let* ((unwrapped-heading (+ (-> work wind-normal w) (rand-vu-float-range -1024.0 1024.0)))
         (heading (- unwrapped-heading (* (the float (the int (/ unwrapped-heading 65536.0))) 65536.0))))
    (set! (-> work wind-normal w) heading)
    (set! (-> work wind-normal x) (cos heading))
    (set! (-> work wind-normal z) (sin heading)))
  (+! (-> work wind-time) 1)
  (let* ((ring-index (logand (the int (* (-> *display* time-adjust-ratio) (-> work wind-time))) 63)) ;; og:preserve-this changed for high fps
         (random-amplitude (rand-vu-float-range 0.0 100.0))
         (gust-index (/ (* (-> *display* time-adjust-ratio) (-> work wind-time)) (the-as uint 120))) ;; og:preserve-this changed for high fps
         (gust-interpolation (* 0.008333334
                                (the float (mod (the uint (* (-> *display* time-adjust-ratio) (-> work wind-time))) (the-as uint 120))) ;; og:preserve-this changed for high fps
                                ))
         (gust-start (* 0.0625 (the float (-> gust-table (mod (the-as int gust-index) (-> gust-table length))))))
         (force (* (+ (* (- (* 0.0625 (the float (-> gust-table (mod (the-as int (+ gust-index 1)) (-> gust-table length))))) gust-start)
                         gust-interpolation)
                      gust-start)
                   random-amplitude)))
    ;; Each byte is a gust-envelope sample in sixteenths; adjacent samples wrap cyclically.
    (set! (-> *wind-work* wind-force ring-index) (* (-> *display* time-adjust-ratio) force)) ;; changed for high fps
    (vector-float*! (-> *wind-work* wind-array ring-index) (-> work wind-normal) (* (-> *display* time-adjust-ratio) force)) ;; changed for high fps
    )
  0
  (none))

;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/common-obs/generic-obs.gc")

;; DECOMP BEGINS

;; Particle effects for target (Jak): hit flashes, red-eco attack bursts, per-material
;; landing/footstep/slide dust poofs and footprint decals, death effects (dark eco, lava,
;; burning), the ice-skating frost spray, and the first-person look-mode HUD parts.
;; The defun/defbehavior code here consists of spawn-time callbacks (birth-func / :func hooks
;; run by the sparticle system to orient or position particles relative to Jak) plus the burn
;; death color-flash behavior. The groups are triggered from target states, target-handler
;; events, and animation effect events (see effect-control.gc).

;; Particle birth callback: rotates a newly spawned particle's initial velocity and acceleration
;; by Jak's current yaw (minus 90 degrees), so a velocity authored along the x/z axes comes out
;; relative to the direction Jak is facing. Used by the smack-surface dust parts.
(defun birth-func-copy-target-y-rot ((particle-system sparticle-system) (particle sparticle-cpuinfo) (launch-info sparticle-launchinfo))
  "Rotate a new particle's velocity and acceleration from target-local xz axes into the target's
   current yaw frame. The authored direction is offset by -90 degrees before it is transformed."
  (let ((target-process *target*))
    (when target-process
      (let ((rotation (new-stack-matrix0)))
        (let ((target-yaw (+ -16384.0 (y-angle (-> target-process control))))) (matrix-rotate-y! rotation target-yaw))
        (vector3s-rotate*! (the-as vector3s (-> particle vel-sxvel)) (the-as vector3s (-> particle vel-sxvel)) rotation)
        (vector3s-rotate*! (the-as vector3s (-> particle acc)) (the-as vector3s (-> particle acc)) rotation))))
  0
  (none))

;; Particle birth callback: probes the collide cache straight down from the spawn point (starting
;; 1m above it, probing 5m down) and, on a hit, folds a rotation into the launch cone so the
;; particle lies flat on the ground polygon: a tilt from world-up to the surface normal, combined
;; with Jak's yaw plus 180 degrees. The final sign branch just picks the quaternion of matching
;; handedness (q and -q are the same rotation) before accumulating its vector part into conerot.
(defun birth-func-ground-orient ((particle-system sparticle-system) (particle sparticle-cpuinfo) (launch-info sparticle-launchinfo))
  "Probe downward from a new particle and add an orientation that lays it on the hit surface.
   The probe begins one meter above the launch position, reaches five meters downward, and ignores
   the particle when there is no current target or no accepted surface. The surface tilt is combined
   with the target's yaw plus 180 degrees."
  (local-vars (negative-result float) (positive-result float))
  (rlet ((vf0 :class vf)
         (vf1 :class vf)
         (vf2 :class vf))
    (init-vf0-vector)
    (let ((probe-position (new 'stack-no-clear 'vector)))
      (set! (-> probe-position quad) (-> launch-info launchrot quad))
      (let ((hit (new 'stack-no-clear 'collide-tri-result))
            (target-process *target*))
        (+! (-> probe-position y) 4096.0)
        ;; og:preserve-this added *target* check here.
        (when (and target-process
                   (>= (fill-and-probe-using-y-probe *collide-cache*
                                                     probe-position
                                                     (the-as float 20480.0)
                                                     (collide-kind background cak-1 cak-2 cak-3 water powerup crate enemy wall-object ground-object mother-spider)
                                                     target-process
                                                     hit
                                                     (new 'static 'pat-surface :noentity #x1))
                       0.0))
          (let ((tilt-axis (new 'stack-no-clear 'vector))
                (orientation (new 'stack-no-clear 'quaternion)))
            (set! (-> tilt-axis x) (-> hit normal z))
            (set! (-> tilt-axis y) 0.0)
            (set! (-> tilt-axis z) (- (-> hit normal x)))
            (vector-normalize! tilt-axis (the-as float 1.0))
            (quaternion-vector-angle! orientation tilt-axis (acos (-> hit normal y)))
            (let ((yaw-rotation (new 'stack-no-clear 'quaternion)))
              (quaternion-vector-angle! yaw-rotation *up-vector* (+ 32768.0 (y-angle (-> target-process control))))
              (quaternion-normalize! (quaternion*! orientation yaw-rotation orientation)))
            (cond
              ((< (-> orientation w) 0.0)
               (.lvf vf1 (&-> launch-info conerot quad))
               (.lvf vf2 (&-> orientation vec quad))
               (.sub.vf.xyz vf1 vf0 vf2)
               (.svf (&-> launch-info conerot quad) vf1)
               (.mov negative-result vf1))
              (else
               (.lvf vf1 (&-> launch-info conerot quad))
               (.lvf vf2 (&-> orientation vec quad))
               (.add.vf.xyz vf1 vf0 vf2)
               (.svf (&-> launch-info conerot quad) vf1)
               (.mov positive-result vf1)))))))
    0
    (none)))

;; Particle birth callback: like birth-func-ground-orient, but instead of probing it uses Jak's
;; current ground contact normal (control local-normal) and adds the part's :userdata value
;; (user-float, in rotation units) as an extra yaw offset. Lays footprint decals and the ice
;; frost spray flat on whatever Jak is standing on, facing the way he faces.
(defun birth-func-target-orient ((particle-system sparticle-system) (particle sparticle-cpuinfo) (launch-info sparticle-launchinfo))
  "Lay a new particle on the target's current contact plane. The launcher's user-float supplies an
   additional yaw in GOAL angle units; the result also includes the target's yaw plus 180 degrees.
   Do nothing when no target exists."
  (local-vars (negative-result float) (positive-result float))
  (rlet ((vf0 :class vf)
         (vf1 :class vf)
         (vf2 :class vf))
    (init-vf0-vector)
    (let ((target-process *target*)
          (tilt-axis (new 'stack-no-clear 'vector)))
      ;; og:preserve-this added check here
      (if (not target-process) (return #f))
      (new 'stack-no-clear 'vector)
      (let ((orientation (new 'stack-no-clear 'quaternion)))
        (let ((ground-normal (-> target-process control local-normal)))
          (set! (-> tilt-axis x) (-> ground-normal z))
          (set! (-> tilt-axis y) 0.0)
          (set! (-> tilt-axis z) (- (-> ground-normal x)))
          (vector-normalize! tilt-axis (the-as float 1.0))
          (quaternion-vector-angle! orientation tilt-axis (acos (-> ground-normal y))))
        (let ((yaw-rotation (new 'stack-no-clear 'quaternion)))
          (quaternion-vector-angle! yaw-rotation
                                    *up-vector*
                                    (+ 32768.0 (-> particle user-float) (y-angle (-> target-process control))))
          (quaternion-normalize! (quaternion*! orientation orientation yaw-rotation)))
        (cond
          ((< (-> orientation w) 0.0)
           (.lvf vf1 (&-> launch-info conerot quad))
           (.lvf vf2 (&-> orientation vec quad))
           (.sub.vf.xyz vf1 vf0 vf2)
           (.svf (&-> launch-info conerot quad) vf1)
           (.mov negative-result vf1))
          (else
           (.lvf vf1 (&-> launch-info conerot quad))
           (.lvf vf2 (&-> orientation vec quad))
           (.add.vf.xyz vf1 vf0 vf2)
           (.svf (&-> launch-info conerot quad) vf1)
           (.mov positive-result vf1)))))
    0
    (none)))

;; Particle birth callback: like the orient functions above, but tilts the particle onto an
;; arbitrary normal supplied by the launcher through user-float (reinterpreted as a pointer to
;; vector data) instead of the ground under Jak, with no yaw term. Does nothing if no vector was
;; provided (user-float is zero).
(defun birth-func-vector-orient ((particle-system sparticle-system) (particle sparticle-cpuinfo) (launch-info sparticle-launchinfo))
  "Lay a new particle on the normal addressed by its user-float. The normal is supplied as
   sprite-vec-data-2d storage and no orientation is added when the pointer is null."
  (local-vars (negative-result float) (positive-result float))
  (rlet ((vf0 :class vf)
         (vf1 :class vf)
         (vf2 :class vf))
    (init-vf0-vector)
    *target*
    (let ((tilt-axis (new 'stack-no-clear 'vector)))
      (new 'stack-no-clear 'vector)
      (let ((orientation (new 'stack-no-clear 'quaternion))
            (normal-data (the-as object (-> particle user-float))))
        (when (nonzero? (the-as float normal-data))
          (set! (-> tilt-axis x) (-> (the-as sprite-vec-data-2d normal-data) z))
          (set! (-> tilt-axis y) 0.0)
          (set! (-> tilt-axis z) (- (-> (the-as sprite-vec-data-2d normal-data) x)))
          (vector-normalize! tilt-axis (the-as float 1.0))
          (quaternion-vector-angle! orientation tilt-axis (acos (-> (the-as sprite-vec-data-2d normal-data) y)))
          (cond
            ((< (-> orientation w) 0.0)
             (.lvf vf1 (&-> launch-info conerot quad))
             (.lvf vf2 (&-> orientation vec quad))
             (.sub.vf.xyz vf1 vf0 vf2)
             (.svf (&-> launch-info conerot quad) vf1)
             (.mov negative-result vf1))
            (else
             (.lvf vf1 (&-> launch-info conerot quad))
             (.lvf vf2 (&-> orientation vec quad))
             (.add.vf.xyz vf1 vf0 vf2)
             (.svf (&-> launch-info conerot quad) vf1)
             (.mov positive-result vf1))))))
    0
    (none)))

;; Per-frame particle :func hook: pins the particle to the world position of one of Jak's joints,
;; with the joint index taken from user-float (set via :userdata on the part). Used by the
;; smack-surface tracker part (72, joint 8) so the bound dizzy-star particles orbit Jak's head.
(defun part-tracker-track-target-joint ((particle-system sparticle-system) (particle sparticle-cpuinfo) (sprite sprite-vec-data-2d))
  "Move a live 2D particle to the target joint selected by its integer user-float. The joint is
   converted from camera space to world space. Do nothing when no target exists."
  ;; og:preserve-this added this check
  (if (not *target*) (return #f))
  (let* ((target-process *target*)
         (joint-position (vector<-cspace! (new 'stack-no-clear 'vector) (-> target-process node-list data (the int (-> particle user-float))))))
    (set! (-> sprite x) (-> joint-position x))
    (set! (-> sprite y) (-> joint-position y))
    (set! (-> sprite z) (-> joint-position z)))
  0
  (none))

;; Jak taking damage: white streak ring + star flash (triggered from target-hit / target-handler).
(defpartgroup group-target-hit
  :id 1
  :duration (seconds 0.017)
  :flags (use-local-clock)
  :bounds (static-bspherem 0 0 0 12)
  :parts ((sp-item 56) (sp-item 57)))

;; target-hit: expanding streak ring (fades in, then out via 58).
(defpart 56
  :init-specs
  ((:texture (middot effects))
   (:num 32.0)
   (:scale-x (meters 3) (meters 1))
   (:rot-x 4)
   (:rot-z (degrees 0) (degrees 360))
   (:scale-y (meters 0.06))
   (:r 128.0)
   (:g 128.0)
   (:b 128.0)
   (:a 0.0)
   (:scalevel-x (meters 0.16))
   (:rotvel-z (degrees -0.15) (degrees 0.3))
   (:fade-a 6.4)
   (:timer (seconds 0.5))
   (:flags (die-when-faded glow))
   (:next-time (seconds 0.035))
   (:next-launcher 58)))

;; stage 2 of part 56: fade out.
(defpart 58
  :init-specs ((:fade-a -0.64)))

;; target-hit: large star flash.
(defpart 57
  :init-specs
  ((:texture (starflash effects))
   (:num 1.0)
   (:scale-x (meters 12))
   (:rot-z (degrees 0))
   (:scale-y :copy scale-x)
   (:r 128.0)
   (:g 128.0)
   (:b 128.0)
   (:a 64.0)
   (:rotvel-z (degrees -0.4))
   (:fade-a -1.4222221)
   (:timer (seconds 0.14))
   (:flags (die-when-faded glow))))


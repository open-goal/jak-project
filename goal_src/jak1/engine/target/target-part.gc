;; Burn ("get-burned") visual: spawned as a temporary child function-process of target by
;; target-death.gc (with a 4-second duration) when Jak dies by fire. Each frame until the
;; duration elapses, it lerps the parent's draw color-mult from its original color toward black
;; (t ramps 0 -> 0.5 over the first half, then back down over the second, so the model is darkest
;; at the midpoint) and launches a dark smoke puff (part 2002) from a random point on the body.
;; Restores the original color when finished.
(defbehavior process-drawable-burn-effect target ((duration time-frame))
  "Play the burn sound and darken the parent drawable toward black during the first half of duration,
   then restore its color during the second half. Launch one smoke particle per frame from a random
   point on the drawable and restore the exact original color before returning."
  (sound-play "get-burned")
  (let ((original-color (new 'stack 'rgbaf))
        (start-time (current-time))
        (parent (-> self parent)))
    (set! (-> original-color quad) (-> (the-as process-drawable (-> parent 0)) draw color-mult quad))
    (let ((black (vector-float*! (the-as vector (new 'stack 'rgbaf)) (the-as vector original-color) 0.0)))
      (while (not (time-elapsed? start-time duration))
        (let ((elapsed (- (current-time) start-time)))
          (if (< elapsed (/ duration 2))
            (vector-lerp! (-> (the-as process-drawable (-> parent 0)) draw color-mult)
                          original-color
                          black
                          (/ (the float elapsed) (the float duration)))
            (vector-lerp! (-> (the-as process-drawable (-> parent 0)) draw color-mult)
                          original-color
                          black
                          (- 1.0 (/ (the float elapsed) (the float duration))))))
        (let ((spawn-position (process-drawable-random-point! (the-as process-drawable (ppointer->process parent)) (new 'stack-no-clear 'vector))))
          (launch-particles (-> *part-id-table* 2002) spawn-position :rate (the-as float 1.0)))
        (suspend)
        0))
    (set! (-> (the-as process-drawable (-> parent 0)) draw color-mult quad) (-> original-color quad)))
  (none))


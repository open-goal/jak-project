;; creaky-wood dust motes: fade in, hold (90), then fade out (91).
(defpart 84
  :init-specs
  ((:texture (bigpuff effects))
   (:num 8.0 16.0)
   (:y (meters -1))
   (:scale-x (meters 1) (meters 0.5))
   (:scale-y :copy scale-x)
   (:r 64.0 32.0)
   (:g 64.0)
   (:b 0.0 32.0)
   (:a 0.0)
   (:vel-y (meters 0) (meters -0.0033333334))
   (:scalevel-x (meters 0.0016666667))
   (:scalevel-y :copy scalevel-x)
   (:fade-a 0.16)
   (:accel-y (meters -0.00006666667))
   (:timer (seconds 3))
   (:flags (die-when-faded use-time-of-day-color no-fog))
   (:next-time (seconds 0.25) (seconds 0.247))
   (:next-launcher 90)
   (:conerot-x (degrees 90))
   (:conerot-y (degrees 0) (degrees 360))
   (:conerot-radius (meters 0) (meters 3))))

;; stage 2 of part 84: hold alpha, then chain to 91.
(defpart 90
  :init-specs ((:fade-a 0.0) (:next-time (seconds 0.5) (seconds 0.497)) (:next-launcher 91)))

;; stage 3 of part 84: fade out.
(defpart 91
  :init-specs ((:fade-a -0.08)))


;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/common-obs/process-drawable.gc")
(require "engine/target/target-util.gc")

;; DECOMP BEGINS

;; Target animations with directional variants share the sidekick's simpler clips. Edge grabs and
;; poles provide alternate clips for the animation remapper to select with the shared animation seed.
(define *sidekick-remap*
  '(("run-to-stance-left" "run-to-stance")
   ("run-to-stance-loop-left" "run-to-stance-loop")
   ("stance-loop-left" "stance-loop")
   ("run-to-stance-right" "run-to-stance")
   ("run-to-stance-loop-right" "run-to-stance-loop")
   ("stance-loop-right" "stance-loop")
   ("run-to-stance-up" "run-to-stance")
   ("run-to-stance-loop-up" "run-to-stance-loop")
   ("stance-loop-up" "stance-loop")
   ("run-to-stance-down" "run-to-stance")
   ("run-to-stance-loop-down" "run-to-stance-loop")
   ("stance-loop-down" "stance-loop")
   ("run-right" "run")
   ("run-left" "run")
   ("walk-right" "walk")
   ("walk-left" "walk")
   ("edge-grab-stance1" "edge-grab-stance1" "edge-grab-stance1-alt")
   ("pole-cycle" "pole-cycle" "pole-cycle2")))

(defun cspace<-cspace+quaternion! ((dst cspace) (src cspace) (orientation quaternion))
  "Build dst's bone transform from orientation and src's homogeneous translation. The result has
   unit scale, a translation divided by its source w, and a final translation w of one."
  (rlet ((Q :class vf)
         (vf0 :class vf)
         (unit-scale :class vf)
         (translation :class vf)
         (basis-x :class vf)
         (basis-y :class vf)
         (basis-z :class vf))
    (init-vf0-vector)
    (let ((transform (-> dst bone transform)))
      (quaternion->matrix transform orientation)
      (.lvf unit-scale (&-> (new 'static 'vector :x 1.0 :y 1.0 :z 1.0 :w 1.0) quad))
      (.lvf translation (&-> (-> src bone) transform vector 3 quad))
      (.lvf basis-x (&-> transform vector 0 quad))
      (.lvf basis-y (&-> transform vector 1 quad))
      (.lvf basis-z (&-> transform vector 2 quad))

      ;; Convert the source's homogeneous translation to an ordinary point. The basis keeps the
      ;; general scale-by-axis construction, with unit scale for this attachment.
      (.div.vf Q vf0 translation :fsf #b11 :ftf #b11)
      (.wait.vf)
      (.mul.vf.xyz translation translation Q)
      (.mov.vf.w translation vf0)
      (.mul.x.vf basis-x basis-x unit-scale)
      (.mul.y.vf basis-y basis-y unit-scale)
      (.mul.z.vf basis-z basis-z unit-scale)
      (.svf (&-> transform vector 3 quad) translation)
      (.svf (&-> transform vector 0 quad) basis-x)
      (.svf (&-> transform vector 1 quad) basis-y)
      (.svf (&-> transform vector 2 quad) basis-z)
      transform)))

;; Mirror the target's animation onto the sidekick skeleton. The matrix event switches the root
;; callback between the target root, a full cspace copy, and the shoulder attachment; shadow and
;; blend-shape events control the two corresponding render features. Each post copies pose,
;; animation seed, visibility, colors, and interpolation from the target, remaps target animation
;; names through *sidekick-remap*, evaluates the sidekick joints, and advances effects, blend shapes,
;; and eye animation. The shadow is enabled only during a movie when shadow-in-movie? is set.
(defstate sidekick-clone (sidekick)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (local-vars (result object))
      (case message
        (('matrix)
         (case (-> block param 0)
           (('play-anim)
            (set! result (-> self node-list data))
            (set! (-> (the-as (inline-array cspace) result) 0 param0) cspace<-cspace+quaternion!)
            (set! (-> (the-as (inline-array cspace) result) 0 param1) (the-as basic (-> self parent-override 0 node-list data)))
            (set! (-> (the-as (inline-array cspace) result) 0 param2) (the-as basic (-> self parent-override 0 control quat))))
           (('copy-parent)
            (set! result (-> self node-list data))
            (set! (-> (the-as (inline-array cspace) result) 0 param0) cspace<-cspace!)
            (set! (-> (the-as (inline-array cspace) result) 0 param1) (the-as basic (-> self parent-override 0 node-list data)))
            (set! (-> (the-as (inline-array cspace) result) 0 param2) #f))
           (else
            (set! result (-> self node-list data))
            (set! (-> (the-as (inline-array cspace) result) 0 param0) cspace<-cspace+quaternion!)
            (set! (-> (the-as (inline-array cspace) result) 0 param1)
                  (the-as basic (-> self parent-override 0 control sidekick-root parent)))
            (set! (-> (the-as (inline-array cspace) result) 0 param2) (the-as basic (-> self parent-override 0 control quat)))))
         result)
        (('shadow) (set! result (-> block param 0)) (set! (-> self shadow-in-movie?) (the-as symbol result)) result)
        (('blend-shape)
         (cond
           ((-> block param 0)
            (set! result (logior (-> self skel status) (janim-status blerc)))
            (set! (-> self skel status) (the-as janim-status result)))
           (else
            (set! result (logclear (-> self skel status) (janim-status blerc)))
            (set! (-> self skel status) (the-as janim-status result))))
         result)))
  :code looping-code
  :post
    (behavior ()
      (let ((art-error-state 'process-drawable-art-error)
            (parent (-> self parent-override)))
        (when (!= (-> (if parent (-> parent 0 self-override)) next-state name) art-error-state)
          (quaternion-copy! (-> self root quat) (-> self parent-override 0 control quat))
          (set! (-> self anim-seed) (-> self parent-override 0 anim-seed))
          (set! (-> self draw status) (-> self parent-override 0 draw status))
          (joint-control-copy! (-> self skel) (-> self parent-override 0 skel))
          (joint-control-remap! (-> self skel)
                                (-> self draw art-group)
                                (-> self parent-override 0 draw art-group)
                                *sidekick-remap*
                                (the-as int (-> self anim-seed))
                                "")
          (let ((color-mult (-> self parent-override 0 draw color-mult quad))) (set! (-> self draw color-mult quad) color-mult))
          (with-pc
            ;; Tint Daxter blue when the sidekick-blue cheat is enabled.
            (when (pc-cheats? (-> *pc-settings* cheats) sidekick-blue)
              (set! (-> self draw color-mult x) (set! (-> self draw color-mult y) 0.1))))
          (let ((color-emissive (-> self parent-override 0 draw color-emissive quad)))
            (set! (-> self draw color-emissive quad) color-emissive))
          (set! (-> self draw secondary-interp) (-> self parent-override 0 draw secondary-interp))
          (if *debug-segment*
            (add-frame (-> *display* frames (-> *display* on-screen) frame profile-bar 0)
                       'draw
                       (new 'static 'rgba :r #x40 :b #x40 :a #x80)))
          (do-joint-math! self)
          (if *debug-segment*
            (add-frame (-> *display* frames (-> *display* on-screen) frame profile-bar 0) 'draw (new 'static 'rgba :r #x80 :a #x80)))
          (vector<-cspace! (-> self draw origin) (-> self node-list data (-> self draw origin-joint-index)))))
      (when *display-sidekick-stats*
        (format *stdcon* "~%")
        (debug-print-channels (-> self skel) (the-as symbol *stdcon*))
        (add-debug-sphere *display-sidekick-stats*
                          (bucket-id debug-no-zbuf)
                          (-> self parent-override 0 control sidekick-root parent bone transform vector 3)
                          409.6
                          (new 'static 'rgba :g #xff :a #x80))
        (add-debug-sphere *display-sidekick-stats*
                          (bucket-id debug-no-zbuf)
                          (-> self node-list data 3 bone transform vector 3)
                          409.6
                          (new 'static 'rgba :r #xff :g #xff :a #x80))
        (add-debug-sphere *display-sidekick-stats*
                          (bucket-id debug-no-zbuf)
                          (-> self draw origin)
                          409.6
                          (new 'static 'rgba :r #xff :g #x80 :a #x80)))
      (set! (-> self draw shadow) (the-as shadow-geo (if (and (movie?) (-> self shadow-in-movie?)) sidekick-shadow-mg)))
      (let ((effects (-> self skel effect))) (if effects (update-effects effects)))
      (if (logtest? (-> self skel status) (janim-status blerc blerc-done)) (merc-blend-shape self))
      (if (logtest? (-> self skel status) (janim-status eye-done eye)) (merc-eye-anim self))))

(defskelgroup *sidekick-sg*
  sidekick
  sidekick-lod0-jg
  -1
  ((sidekick-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 3)
  :longest-edge (meters 1)
  :shadow sidekick-shadow-mg
  :texture-level 2
  :sort 1)

(defbehavior init-sidekick sidekick ()
  "Initialize the sidekick drawable, skeleton, shadow, eye animation, and root-cspace callback,
   repair any blend-shape state left in persistent PC render data, then enter sidekick-clone."
  (logior! (-> self mask) (process-mask sidekick))
  (set! (-> self root) (new 'process 'trsqv))
  (vector-identity! (-> self root scale))
  (quaternion-identity! (-> self root quat))
  (initialize-skeleton self *sidekick-sg* '())
  (set! (-> self draw origin-joint-index) (the-as uint 6))
  (set! (-> self draw shadow-joint-index) (the-as uint 6))
  (set! (-> self draw shadow-ctrl) *target-shadow-control*)
  (logior! (-> self skel status) (janim-status eye))
  (#when PC_PORT
    ;; Blend-shape edits can remain in persistent MERC data when Daxter is destroyed mid-animation.
    ;; Mark the blend complete so the first rendered frame reapplies zero weights and clears them.
    (logior! (-> self skel status) (janim-status blerc-done)))
  (let ((nodes (-> self node-list data)))
    (set! (-> nodes 0 param0) cspace<-cspace+quaternion!)
    (set! (-> nodes 0 param1) (the-as basic (-> self parent-override 0 control sidekick-root parent)))
    (set! (-> nodes 0 param2) (the-as basic (-> self parent-override 0 control quat))))
  (set! (-> self shadow-in-movie?) #t)
  (go sidekick-clone)
  (none))

(defun starts ()
  "Ask the target event handler to activate the sidekick."
  (send-event *target* 'sidekick #t))

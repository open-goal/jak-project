;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/anim/aligner-h.gc")
(require "engine/anim/joint-mod-h.gc")
(require "engine/level/level.gc")
(require "engine/target/collide-reaction-target.gc")
(require "engine/common-obs/process-drawable.gc")
(require "engine/common-obs/water-h.gc")
(require "engine/target/target-util.gc")

;; Keep the invulnerability flicker cadence stable when the display runs above 60 Hz.
;; The PC kernel uses a different stack size, so start explicitly selects *kernel-dram-stack*.

;; DECOMP BEGINS

(defbehavior build-conversions target ((world-velocity vector))
  "Combine the movement-state and ground surfaces, apply the blue-eco running bonus, build the
   character-to-world and world-to-character frames, and convert world velocity into the local
   working velocity."
  (surface-mult! (-> self control current-surface) (-> self control mod-surface) (-> self control surf))
  (when (and (and (= (-> self fact eco-type) (pickup-type eco-blue)) (>= (-> self fact eco-level) 1.0))
             (or (= (-> self control mod-surface name) 'run) (= (-> self control mod-surface name) 'jump)))
    (+! (-> self control current-surface target-speed) 20480.0)
    (+! (-> self control current-surface transv-max) 20480.0))
  (let ((forward (new-stack-vector0)))
    (vector-z-quaternion! forward (-> self control quat-for-control))
    (when (logtest? (-> self control mod-surface flags) (surface-flags dive))
      (vector-flatten! forward forward (-> self control dynam gravity-normal))
      (vector-normalize! forward 1.0))
    (forward-up-nopitch->inv-matrix (-> self control c-R-w) forward (-> self control local-normal)))
  (matrix-transpose! (-> self control w-R-c) (-> self control c-R-w))
  (vector-matrix*! (-> self control transv-ctrl) world-velocity (-> self control w-R-c))
  (vector-copy! (-> self control last-gravity-normal) (-> self control gravity-normal))
  (let ((gravity-normal (-> self control gravity-normal)))
    (vector-copy! gravity-normal (-> self control dynam gravity-normal))
    gravity-normal))

(defbehavior vector-turn-to target ((new-direction vector))
  "Immediately face the supplied world direction without rate limiting, preserve the current up
   axis, and rebuild the movement coordinate conversions."
  (let ((make-facing forward-up-nopitch->quaternion)
        (desired-facing (-> self control dir-targ))
        (normalize vector-normalize!)
        (direction (new-stack-vector0)))
    (set! (-> direction quad) (-> new-direction quad))
    (make-facing desired-facing
                 (normalize direction 1.0)
                 (vector-y-quaternion! (new-stack-vector0) (-> self control dir-targ))))
  (set-quaternion! (-> self control) (-> self control dir-targ))
  (build-conversions (-> self control transv)))

(defbehavior reverse-conversions target ((world-velocity vector))
  "Convert the local working velocity back to world space, cache horizontal speed, and move the
   current collision status into old-status for the next tick."
  (set! (-> self control ctrl-xz-vel) (vector-xz-length (-> self control transv-ctrl)))
  (vector-matrix*! world-velocity (-> self control transv-ctrl) (-> self control c-R-w))
  (set! (-> self control old-status) (-> self control status))
  (none))

(defun-debug draw-history ((control control-info))
  "Draw the 128-entry collision-history path, velocity vectors, contacts, and surface normals.
   L3 cycles preset display masks and L2 plus L3 selects the full history display."
  (when (nonzero? *display-collide-history*)
    (when (cpad-pressed? 0 l3)
      (set! (-> control history-length) (mod (+ (-> control history-length) 1) 3))
      (if (cpad-hold? 0 l2) (set! (-> control history-length) 1000)))
    (let* ((history-length (-> control history-length))
           (draw-mask (cond
                        ((zero? history-length) 35)
                        ((= history-length 1) 39)
                        ((= history-length 2) 43)
                        (else 256)))
           (previous-record (-> control history-data (-> control history-data-idx)))
           (previous-contact (-> control history-data (-> control history-data-idx)))
           (i 1)
           (last-index 127))
      (while (>= last-index i)
        (let ((record (-> control history-data (logand (+ (-> control history-data-idx) i) 127))))
          (add-debug-line (logtest? draw-mask 2)
                          (bucket-id debug-no-zbuf)
                          (-> previous-record trans)
                          (-> record trans)
                          (the-as rgba (+ #xffff00 (shl i 24)))
                          #f
                          (the-as rgba -1))
          (add-debug-vector (logtest? draw-mask 4)
                            (bucket-id debug-no-zbuf)
                            (-> record trans)
                            (-> record transv)
                            (meters 0.000024414063)
                            (the-as rgba (+ #x408040 (shl i 24))))
          (when (not (logtest? (-> record status) (collide-status no-touch)))
            (add-debug-line (logtest? draw-mask 1)
                            (bucket-id debug-no-zbuf)
                            (-> previous-contact intersect)
                            (-> record intersect)
                            (the-as rgba (+ #xffffff (shl i 24)))
                            #f
                            (the-as rgba -1))
            (let ((contact-color (logand (the-as int (-> *pat-mode-info* (-> record pat mode) hilite-color)) (the-as uint #xffffffff00ffffff))))
              (add-debug-vector (logtest? draw-mask 32)
                                (bucket-id debug-no-zbuf)
                                (-> record intersect)
                                (-> record surface-normal)
                                (meters 1)
                                (the-as rgba (+ contact-color (shl i 24))))
              (add-debug-vector (logtest? draw-mask 16)
                                (bucket-id debug-no-zbuf)
                                (-> record intersect)
                                (-> record local-normal)
                                (meters 1)
                                (the-as rgba (+ contact-color (shl i 24)))))
            (add-debug-vector (logtest? draw-mask 8)
                              (bucket-id debug-no-zbuf)
                              (-> record trans)
                              (-> record transv-out)
                              (meters 0.000024414063)
                              (the-as rgba (+ #x404080 (shl i 24))))
            (set! previous-contact record))
          (set! previous-record record))
        (+! i 1)))
    #f))

(defun-debug print-history ((control control-info))
  "Print all 128 collision-history entries, including compact reaction-flag letters, positions,
   contact points, input and output velocities, and contact normals."
  ;; The first two format blocks render reaction-flags as single ASCII letters:
  ;;   col1 wall-by-pat: 'g'/'W'      col2 wall-by-angle: 'g'/'W'
  ;;   col3: 'G'(on-ground) / 'g'(no hit-wall) / 'W'(hit-wall)
  ;;   col4: 'B'(vertical-edge) / 'L'(low-coverage edge) / 'c'
  ;;   col5 glancing: 'n'/'B'(edge)          col6 air-mode: 'g'/'A'(air/jump)
  ;;   col7 no-grab-edge: '_'/'N'     col8: 'L'(edge-grab-ledge) / 'C'(corner-slide) / 'l'(ledge-candidate) / '_'
  (dotimes (i 128)
    (let ((record (-> control history-data (logand (+ (-> control history-data-idx) i) 127))))
      (let ((reaction-flags (-> record reaction-flag)))
        (format #t
                "~6D ~8S #x~8X "
                (-> record time)
                (if (logtest? (-> record status) (collide-status no-touch)) "air" (-> *pat-mode-info* (-> record pat mode) name))
                (-> record status))
        (format #t
                "~C~C~C~C~C~C"
                (if (not (logtest? reaction-flags (cshape-reaction-flags wall-by-pat))) 103 87)
                (if (not (logtest? reaction-flags (cshape-reaction-flags wall-by-angle))) 103 87)
                (cond
                  ((logtest? reaction-flags (cshape-reaction-flags on-ground)) 71)
                  ((not (logtest? reaction-flags (cshape-reaction-flags hit-wall))) 103)
                  (else 87))
                (cond
                  ((logtest? reaction-flags (cshape-reaction-flags vertical-edge)) 66)
                  ((logtest? reaction-flags (cshape-reaction-flags low-coverage)) 76)
                  (else 99))
                (if (not (logtest? reaction-flags (cshape-reaction-flags glancing))) 110 66)
                (if (not (logtest? reaction-flags (cshape-reaction-flags air-mode))) 103 65))
        (format #t
                "~C~C "
                (if (logtest? reaction-flags (cshape-reaction-flags no-grab-edge)) 78 95)
                (cond
                  ((logtest? reaction-flags (cshape-reaction-flags edge-grab-ledge)) 76)
                  ((logtest? reaction-flags (cshape-reaction-flags corner-slide)) 67)
                  ((logtest? reaction-flags (cshape-reaction-flags ledge-candidate)) 108)
                  (else 95))))
      (format #t "trans: ~6,,2m ~6,,2m ~6,,2m  " (-> record trans x) (-> record trans y) (-> record trans z))
      (format #t "int: ~6,,2m ~6,,2m ~6,,2m " (-> record intersect x) (-> record intersect y) (-> record intersect z))
      (format #t "vel: ~6,,2m ~6,,2m ~6,,2m " (-> record transv x) (-> record transv y) (-> record transv z))
      (format #t "vel-out: ~6,,2m ~6,,2m ~6,,2m " (-> record transv-out x) (-> record transv-out y) (-> record transv-out z))
      (format #t
              "normal: ~6,,2f ~6,,2f ~6,,2f "
              (-> record surface-normal x)
              (-> record surface-normal y)
              (-> record surface-normal z)))
    (format #t "~%"))
  0
  (none))

(defun-debug target-print-stats ((player target) (output symbol))
  "Print the target's collision materials and flags, water state, slopes, position and velocity,
   jump-height bookkeeping, gravity bend, and animation channels to output. Also draw the collision
   history when its display option is enabled."
  (when (and *display-ground-stats* player)
    (format output
            "~0kpoly:~6X  mode:~-8S  material:~-10S  event:~S~%"
            (-> player control poly-pat)
            (pat-mode->string (-> player control poly-pat))
            (pat-material->string (-> player control poly-pat))
            (pat-event->string (-> player control poly-pat)))
    (format output
            "~0kgrnd:~6X  mode:~-8S  material:~-10S  event:~S~%"
            (-> player control ground-pat)
            (pat-mode->string (-> player control ground-pat))
            (pat-material->string (-> player control ground-pat))
            (pat-event->string (-> player control ground-pat)))
    (format output
            "~0kwall:~6X  mode:~-8S  material:~-10S  event:~S~%"
            (-> player control wall-pat)
            (pat-mode->string (-> player control wall-pat))
            (pat-material->string (-> player control wall-pat))
            (pat-event->string (-> player control wall-pat))))
  (when (and *stats-target* player)
    (format output
            "~0ks: ~M ~X/~X ~A ~A ~A~%"
            (-> player control ctrl-xz-vel)
            (-> player control status)
            (-> player control prev-status)
            (-> player state name)
            (-> player control surf name)
            (-> player control mod-surface name))
    (format output
            "~0k~9S ~9S ~9S ~9S ~9S ~9S~%"
            (if (logtest? (-> player control status) (collide-status on-surface)) "on-surface" "")
            (if (logtest? (-> player control status) (collide-status on-ground)) "on-ground" "")
            (if (logtest? (-> player control status) (collide-status touch-surface)) "t-surface" "")
            (if (logtest? (-> player control status) (collide-status touch-wall)) "t-wall" "")
            (if (logtest? (-> player control status) (collide-status touch-actor)) "t-act" "")
            (cond
              ((logtest? (-> player control status) (collide-status touch-ceiling)) "t-ceil")
              ((logtest? (-> player control status) (collide-status on-water)) "on-water")
              (else "")))
    (let ((water-process (handle->process (-> player water volume))))
      (when water-process
        (format output
                "in water ~A at ~M ~5S ~5S ~5S ~5S "
                (-> water-process name)
                (-> player water height)
                (if (logtest? (-> player water flag) (water-flag touch-water)) "water" "")
                (if (logtest? (-> player water flag) (water-flag wading)) "wade" "")
                (if (logtest? (-> player water flag) (water-flag swimming)) "swim" "")
                (if (logtest? (-> player water flag) (water-flag under-water)) "under" ""))
        (format output "~2S~%" (if (logtest? (-> player water flag) (water-flag swim-ground)) "sg" ""))))
    (format output
            "~0kan:~,,3f su:~,,3f ti:~,,3f to:~,,3f pa:~,,3f~%"
            (-> player control surface-angle)
            (-> player control local-slope-z)
            (-> player control local-slope-x)
            (-> player control touch-angle)
            (-> player control poly-angle))
    (let ((position (-> player control trans)))
      (format output "pos: ~6,,2m ~6,,2m ~6,,2m  " (-> position x) (-> position y) (-> position z)))
    (format output
            "~0kpol:~X/~S/~S/~S~%"
            (-> player control poly-pat)
            (pat-mode->string (-> player control poly-pat))
            (pat-material->string (-> player control poly-pat))
            (pat-event->string (-> player control poly-pat)))
    (format output
            "~0kcur:~X/~S/~S/~S   "
            (-> player control cur-pat)
            (pat-mode->string (-> player control cur-pat))
            (pat-material->string (-> player control cur-pat))
            (pat-event->string (-> player control cur-pat)))
    (format output
            "~0kgnd:~X/~S/~S/~S~%"
            (-> player control ground-pat)
            (pat-mode->string (-> player control ground-pat))
            (pat-material->string (-> player control ground-pat))
            (pat-event->string (-> player control ground-pat)))
    (let ((print-values format)
          (output-copy output)
          (velocity-format "~0kvel: x:~M  y:~M  z:~M   yv:~M  xzv:~M~%")
          (velocity-x (-> player control transv x))
          (velocity-y (-> player control transv y))
          (velocity-z (-> player control transv z))
          (gravity-velocity (vector-dot (-> player control dynam gravity-normal) (-> player control transv)))
          (lateral-velocity (new-stack-vector0)))
      (let ((gravity-velocity-copy (vector-dot (-> player control dynam gravity-normal) (-> player control transv))))
        0.0
        (vector-! lateral-velocity
                  (-> player control transv)
                  (vector-float*! lateral-velocity (-> player control dynam gravity-normal) gravity-velocity-copy)))
      (let ((lateral-speed (vector-length lateral-velocity)))
        lateral-speed
        (print-values output-copy velocity-format velocity-x velocity-y velocity-z gravity-velocity lateral-speed)))
    (format output
            "~0ky:~,,2M t:~d cy: ~,,2M my: ~,,2M impv:~,,2M "
            (-> player control last-trans-any-surf y)
            (- (current-time) (-> player control last-time-on-surface))
            (- (-> player control trans y) (-> player control last-trans-any-surf y))
            (- (-> player control highest-jump-mark y) (-> player control last-trans-leaving-surf y))
            (-> player control ground-impact-vel))
    (format output
            "~0k~Tcd: ~,,2M md:~,,2M~%"
            (vector-xz-length (vector-! (new-stack-vector0) (-> player control trans) (-> player control last-trans-any-surf)))
            (vector-xz-length (vector-! (new-stack-vector0) (-> player control highest-jump-mark) (-> player control last-trans-leaving-surf))))
    (format output
            "~0kbend b:~F t:~F s:~F~%"
            (-> player control bend-amount)
            (-> player control bend-target)
            (-> player control bend-speed))
    (debug-print-channels (-> player skel) output))
  (draw-history (-> player control))
  #f)

(defbehavior read-pad target ((direction-out vector))
  "Read the movement stick into a camera-relative world XZ direction, cache the current and previous
   direction and magnitude once per display frame, and return the direction in the supplied vector."
  (when (!= (-> self control time-of-last-pad-read) (-> *display* real-frame-counter))
    (vector-copy! (-> self control last-pad-xz-dir) (-> self control pad-xz-dir))
    (set! (-> self control last-pad-magnitude) (-> self control pad-magnitude))
    (set! (-> self control time-of-last-pad-read) (-> *display* real-frame-counter)))
  (set! (-> direction-out x) (sin (-> self control cpad stick0-dir)))
  (set! (-> direction-out y) 0.0)
  (set! (-> direction-out z) (cos (-> self control cpad stick0-dir)))
  (set! (-> direction-out w) 0.0)
  (vector-copy! (-> self control pad-xz-dir) direction-out)
  (set! (-> self control pad-magnitude) (-> self control cpad stick0-speed))
  (vector-matrix*! direction-out direction-out (matrix-local->world #t #f)))

(defun warp-vector-into-surface! ((dst vector) (src vector) (surface-normal vector))
  "Rotate src by the transform that carries the camera up axis to surface-normal and write the
   result to dst, bending camera-relative input into the surface plane."
  (let ((rotation (matrix-from-two-vectors! (new-stack-matrix0) (-> (matrix-local->world #t #f) vector 1) surface-normal)))
    (vector-matrix*! dst src rotation)))

(defbehavior vector<-pad-in-surface! target ((dst vector) (scale? symbol))
  "Read the movement stick into dst and bend it into the current surface plane. Scale the direction
   by stick magnitude when scale? is true."
  (let ((pad-direction (read-pad (new-stack-vector0))))
    (warp-vector-into-surface! dst pad-direction (-> self control local-normal)))
  (if scale? (vector-float*! dst dst (-> self control pad-magnitude)))
  dst)

(defbehavior local-pad-angle target ()
  "Return the cosine between the surface-warped stick direction and the current facing: one is
   forward, zero is sideways, and minus one is backward."
  (let ((pad-direction (vector<-pad-in-surface! (new-stack-vector0) #f)))
    (vector-dot (vector-normalize! pad-direction 1.0)
                (vector-z-quaternion! (new-stack-vector0) (-> self control quat-for-control)))))

(defbehavior turn-around? target ()
  "Maintain sixteen frames of movement history and request the hard turn-around state only when the
   target is moving quickly on a surface and the stick is strongly reversed, outside recent actor
   and low-coverage contacts."
  (let* ((pad-direction (vector<-pad-in-surface! (new-stack-vector0) #f))
         (normalized-pad (vector-normalize! pad-direction 1.0))
         (normalize vector-normalize!)
         (velocity-copy (new-stack-vector0)))
    (set! (-> velocity-copy quad) (-> self control transv quad))
    (let ((direction-dot (vector-dot normalized-pad (normalize velocity-copy 1.0)))
          (velocity-history (-> self control transv-history))
          (fastest-speed -1000.0)
          (speed-sum 0.0)
          (fastest-index -1)
          (blocked-time (new 'static 'array uint64 1 #x0)))
      (countdown (i 15)
        (let ((history-entry (-> velocity-history i quad))) (set! (-> velocity-history (+ i 1) quad) history-entry)))
      (set! (-> velocity-history 0 quad) (-> self control transv quad))
      (set! (-> velocity-history 0 w) (-> self control ctrl-xz-vel))
      (dotimes (j 16)
        (+! speed-sum (-> velocity-history j w))
        (when (< fastest-speed (-> velocity-history j w))
          (set! fastest-index j)
          (set! fastest-speed (-> velocity-history j w))))
      (let ((average-speed (/ speed-sum 16)))
        (set! (-> self control idx-of-fastest-xz-vel) fastest-index)
        (set! (-> self control average-xz-vel) average-speed)
        (if (logtest? (-> self control current-surface flags) (surface-flags no-turn-around))
          (set! (-> blocked-time 0) (the-as uint (current-time))))
        (and (>= (the-as uint (- (current-time) (the-as int (-> blocked-time 0)))) (the-as uint 300))
             (< direction-dot 0.0)
             (< 32768.0 average-speed)
             (< 0.7 (-> self control pad-magnitude))
             (time-elapsed? (-> self control last-time-touching-actor) (seconds 0.3))
             (time-elapsed? (-> self control time-of-last-lc) (seconds 0.3))
             (logtest? (-> self control status) (collide-status on-surface))
             (and (< 0.7 (-> self control surface-angle)) #t))))))

(defbehavior target-move-dist target ((time-window time-frame))
  "Average recent collision-history positions inside time-window and return their mean distance
   from the centroid, measuring actual displacement independently of reported velocity."
  (let ((centroid (new-stack-vector0))
        (distance-sum 0.0)
        (sample-count 0))
    (let* ((history-offset 127)
           (record (-> self control history-data (logand (+ (-> self control history-data-idx) history-offset) 127))))
      (while (and (not (time-elapsed? (-> record time) time-window)) (> history-offset 0))
        (vector+! centroid centroid (-> record trans))
        (+! sample-count 1)
        (+! history-offset -1)
        (set! record (-> self control history-data (logand (+ (-> self control history-data-idx) history-offset) 127)))))
    (vector-float/! centroid centroid (the float sample-count))
    (let ((i (- 128 sample-count)))
      (while (< i 128)
        (let ((sample (-> self control history-data (logand (+ (-> self control history-data-idx) i) 127))))
          (+! distance-sum (vector-vector-distance centroid (-> sample trans))))
        (+! i 1)))
    (/ distance-sum (the float sample-count))))

(defbehavior turn-to-vector target ((heading vector) (magnitude float))
  "Project a world heading into the active surface, record its turn angle and magnitude, and set the
   desired velocity to heading times stick magnitude times the surface target speed."
  (let ((surface-heading (new-stack-vector0)))
    (warp-vector-into-surface! surface-heading heading (-> self control local-normal))
    (set! (-> self control last-turn-to-magnitude) (-> self control turn-to-magnitude))
    (set! (-> self control last-turn-to-angle) (-> self control turn-to-angle))
    (vector-copy! (-> self control last-to-target-pt-xz) (-> self control to-target-pt-xz))
    (vector-copy! (-> self control last-turn-to-target) (-> self control turn-to-target))
    (vector-float*! (-> self control turn-to-target) surface-heading magnitude)
    (if (< 0.0 magnitude) (warp-vector-into-surface! (-> self control to-target-pt-xz) heading *up-vector*))
    ;; push the newest turn direction (in the control frame) onto the 8-entry rolling turn history.
    (dotimes (i 7)
      (vector-copy! (-> self control turn-history-ctrl (+ i 1)) (-> self control turn-history-ctrl i)))
    (vector-copy! (-> self control turn-history-ctrl 0) (vector-matrix*! surface-heading surface-heading (-> self control w-R-c)))
    (let ((turn-angle (atan (-> surface-heading x) (-> surface-heading z))))
      (set! (-> self control turn-to-magnitude) magnitude)
      (set! (-> self control turn-to-angle) turn-angle))
    (let ((target-speed (* magnitude (-> self control current-surface target-speed))))
      (vector-copy! (-> self control target-transv) (vector-normalize! surface-heading target-speed))))
  (let ((mark-position (new-stack-vector0)))
    (vector-matrix*! mark-position (-> self control target-transv) (-> self control c-R-w))
    (vector-float*! mark-position mark-position 0.5)
    (vector+! mark-position mark-position (-> self control trans))
    (add-debug-text-sphere *display-target-marks*
                           (bucket-id debug-no-zbuf)
                           mark-position
                           819.2
                           "target"
                           (new 'static 'rgba :r #xff :g #xff :a #x80))))

(defbehavior add-thrust target ()
  "Accelerate the local working velocity toward the desired velocity. Apply downhill slide, uphill
   traction and speed loss, direction-dependent seek rates, nonlinear braking, airborne assistance,
   blocker correction, and the short wall-lip boost without overshooting the requested velocity."
  (let ((desired-velocity (-> self control target-transv))
        (velocity (-> self control transv-ctrl)))
    (let ((original-target (new 'stack-no-clear 'vector)))
      (vector-copy! original-target (-> self control target-transv))
      ;; downhill-local = the downhill direction of the standing surface (down = negated gravity
      ;; normal, flattened into the surface plane), in the control frame; its length encodes how
      ;; steep the slope is (zero on flat ground).
      (let* ((downhill-world (vector-flatten! (new 'stack-no-clear 'vector)
                                              (vector-negate! (new-stack-vector0) (-> self control dynam gravity-normal))
                                              (-> self control local-normal)))
             (downhill-local (vector-matrix*! (new 'stack-no-clear 'vector) downhill-world (-> self control w-R-c)))
             (downhill-direction (vector-normalize-copy! (new 'stack-no-clear 'vector) downhill-local 1.0)))
        ;; slide-factor injects a constant downhill push (e.g. the slide-down state pins it to 12m/s).
        (vector+float*! desired-velocity desired-velocity downhill-local (-> self control current-surface slide-factor))
        ;; slope-up-traction (< 1.0 on slippery surfaces): scale down the component of the desired
        ;; velocity that points against the low-coverage tangent (i.e. back up over an edge/slope).
        (let ((low-coverage-tangent (-> self control low-coverage-across-edge-dir)))
          (when (not (or (= (- 1.0 (-> self control current-surface slope-up-traction)) 0.0) (< (vector-length downhill-local) 0.1)))
            (let* ((tangent-local (vector-matrix*! (new 'stack-no-clear 'vector) low-coverage-tangent (-> self control w-R-c)))
                   (perpendicular (new-stack-vector0))
                   (along-tangent (vector-dot tangent-local desired-velocity)))
              0.0
              (vector-! perpendicular desired-velocity (vector-float*! perpendicular tangent-local along-tangent))
              (let* ((perpendicular-length (vector-length perpendicular))
                     (perpendicular-length-copy perpendicular-length))
                (if (< along-tangent 0.0) (set! along-tangent (* along-tangent (-> self control current-surface slope-up-traction))))
                (let ((adjusted-tangent-speed (+ along-tangent (-> self control current-surface slope-down-factor))))
                  (vector+! desired-velocity
                            (vector-float*! desired-velocity tangent-local adjusted-tangent-speed)
                            (vector-float*! perpendicular perpendicular (/ perpendicular-length perpendicular-length-copy))))))))
        ;; scale desired XZ speed by slope direction: moving uphill costs speed (squared falloff via
        ;; slope-up-factor), moving downhill gains it (linear via slope-down-factor).
        (let ((normalize-xz vector-xz-normalize!)
              (desired-velocity-copy (new-stack-vector0)))
          (set! (-> desired-velocity-copy quad) (-> desired-velocity quad))
          (let ((desired-direction-copy (normalize-xz desired-velocity-copy 1.0)))
            (set! (-> desired-direction-copy y) 0.0)
            (let ((downhill-dot (vector-dot downhill-direction desired-direction-copy))
                  (desired-speed (vector-xz-length desired-velocity)))
              (if (< 0.0 downhill-dot)
                (vector-xz-normalize! desired-velocity
                                      (+ desired-speed (* downhill-dot (-> self control current-surface slope-down-factor))))
                (vector-xz-normalize! desired-velocity
                                      (- desired-speed (* (square downhill-dot) (-> self control current-surface slope-up-factor)))))))))
      (let ((normalize-desired-xz vector-xz-normalize!)
            (desired-xz-copy (new-stack-vector0)))
        (set! (-> desired-xz-copy quad) (-> desired-velocity quad))
        (let ((desired-xz-direction (normalize-desired-xz desired-xz-copy 1.0)))
          (let ((normalize-velocity-xz vector-xz-normalize!)
                (velocity-xz-copy (new-stack-vector0)))
            (set! (-> velocity-xz-copy quad) (-> velocity quad))
            (let ((velocity-xz-direction (normalize-velocity-xz velocity-xz-copy 1.0)))
              (set! (-> desired-xz-direction y) 0.0)
              (set! (-> velocity-xz-direction y) 0.0)))
          ;; pick the seek rate: already at/above the desired speed -> friction brakes instead
          ;; (harder past nonlin-fric-dist); otherwise blend seek0/seek90/seek180 by how much the
          ;; desired direction agrees with the current facing (desired-z is its forward component).
          (let* ((desired-forward (-> desired-xz-direction z))
                 (seek-rate (cond
                              ((>= (vector-xz-length velocity) (vector-xz-length desired-velocity))
                               (* (-> self control current-surface fric)
                                  (fmax 1.0 (/ (vector-xz-length velocity) (-> self control current-surface nonlin-fric-dist)))))
                              ((>= desired-forward 0.0)
                               (+ (* desired-forward (-> self control current-surface seek0))
                                  (* (- 1.0 desired-forward) (-> self control current-surface seek90))))
                              (else
                               (+ (* (fabs desired-forward) (-> self control current-surface seek180))
                                  (* (+ 1.0 desired-forward) (-> self control current-surface seek90)))))))
            ;; btransv is the thrust accumulator: clamp each component between 0 and the original
            ;; target (in the control frame) so accumulated thrust can never overshoot what the
            ;; stick asked for; when pushed by a blocker, chase the target directly at 30m/s^2.
            (let* ((blocked-velocity (-> self control btransv))
                   (blocked-velocity-local (vector-matrix*! (new 'stack-no-clear 'vector) blocked-velocity (-> self control w-R-c))))
              (if (< (-> original-target x) 0.0)
                (set! (-> blocked-velocity-local x) (fmax (fmin 0.0 (-> blocked-velocity-local x)) (-> original-target x)))
                (set! (-> blocked-velocity-local x) (fmax 0.0 (fmin (-> blocked-velocity-local x) (-> original-target x)))))
              (if (< (-> original-target y) 0.0)
                (set! (-> blocked-velocity-local y) (fmax (fmin 0.0 (-> blocked-velocity-local y)) (-> original-target y)))
                (set! (-> blocked-velocity-local y) (fmax 0.0 (fmin (-> blocked-velocity-local y) (-> original-target y)))))
              (if (< (-> original-target z) 0.0)
                (set! (-> blocked-velocity-local z) (fmax (fmin 0.0 (-> blocked-velocity-local z)) (-> original-target z)))
                (set! (-> blocked-velocity-local z) (fmax 0.0 (fmin (-> blocked-velocity-local z) (-> original-target z)))))
              (if (< 0.2 (-> self control blocked-factor))
                (vector-seek! blocked-velocity-local original-target (* 122880.0 (seconds-per-frame))))
              (vector-matrix*! blocked-velocity blocked-velocity-local (-> self control c-R-w))
              ;; airborne assist: while not touching any surface and slower than the thrust
              ;; accumulator, add up to 40m/s^2 of extra seek (doubled when pulling backward) so
              ;; air control can actually catch up to the wanted velocity.
              (let ((blocked-velocity-gap (vector-vector-xz-distance blocked-velocity-local original-target)))
                (when (and (not (logtest? (-> self control status) (collide-status touch-surface)))
                           (< (vector-xz-length velocity) (vector-xz-length blocked-velocity-local)))
                  (let ((air-assist (lerp-scale 163840.0 0.0 blocked-velocity-gap 0.0 20480.0)))
                    (if (and (< blocked-velocity-gap 20480.0) (< (-> original-target z) 0.0)) (set! air-assist (* 2.0 air-assist)))
                    (+! seek-rate air-assist)))))
            ;; wall-lip pop: the frame a rising jump stops touching a wall while now being above the
            ;; wall contact point (checked against the chest sphere), stamp the time...
            (if (and (not (logtest? (-> self control status) (collide-status touch-wall)))
                     (logtest? (-> self control old-status) (collide-status touch-wall))
                     (logtest? (-> self control mod-surface flags) (surface-flags jump))
                     (< 0.0 (-> velocity y))
                     (< 0.0
                        (vector-dot (-> self control dynam gravity-normal)
                                    (vector-! (new 'stack-no-clear 'vector)
                                              (-> self control collision-spheres 1 prim-core world-sphere)
                                              (-> self control wall-contact-pt)))))
              (set-time! (-> self control time-of-last-clear-wall-in-jump)))
            ;; ...and for the next 0.2s add a huge (+50m/s^2) seek boost, snapping Jak forward onto
            ;; the ledge he just cleared instead of leaving him hovering at the lip.
            (if (not (time-elapsed? (-> self control time-of-last-clear-wall-in-jump) (seconds 0.2)))
              (set! seek-rate (+ 204800.0 seek-rate)))
            ;; also kill any backward drift the wall slide left behind when clearing it in a jump.
            (if (and (not (logtest? (-> self control status) (collide-status touch-wall)))
                     (and (logtest? (-> self control old-status) (collide-status touch-wall))
                          (logtest? (-> self control mod-surface flags) (surface-flags jump))
                          (< 0.0 (-> velocity y))
                          (< (-> velocity z) 0.0)))
              (set! (-> velocity z) 0.0))
            ;; commit: step the working velocity toward the desired velocity in the XZ plane, moving
            ;; at most seek-rate * dt this tick.
            (let ((velocity-step (vector-! (new-stack-vector0) desired-velocity velocity)))
              (let ((max-step (* seek-rate (seconds-per-frame))))
                (set! (-> velocity-step y) 0.0)
                (if (< max-step (vector-xz-length velocity-step)) (vector-xz-normalize! velocity-step max-step)))
              (vector+! velocity velocity velocity-step))))))
    (set! (-> self control velocity-after-thrust) (vector-length velocity)))
  (let ((mark-position (new-stack-vector0)))
    (vector-matrix*! mark-position (-> self control transv-ctrl) (-> self control c-R-w))
    (vector-float*! mark-position mark-position 0.5)
    (vector+! mark-position mark-position (-> self control trans))
    (add-debug-text-sphere *display-target-marks*
                           (bucket-id debug-no-zbuf)
                           mark-position
                           819.2
                           "ltransv"
                           (new 'static 'rgba :g #xff :a #x80))
    (set! (-> mark-position quad) (-> self control btransv quad))
    (vector-float*! mark-position mark-position 0.5)
    (vector+! mark-position mark-position (-> self control trans))
    (add-debug-text-sphere *display-target-marks*
                           (bucket-id debug-no-zbuf)
                           mark-position
                           819.2
                           "btransv"
                           (new 'static 'rgba :r #xff :g #xff :b #xff :a #x80))))

(defbehavior add-gravity target ()
  "Integrate gravity through the active surface slip factor, convert it to the local movement frame,
   and clamp only the gravity-axis component to terminal speed while preserving lateral velocity."
  (let ((gravity-acceleration (new-stack-vector0))
        (gravity-acceleration-local (new-stack-vector0)))
    (compute-acc-due-to-gravity (-> self control) gravity-acceleration (-> self control current-surface slip-factor))
    (vector-matrix*! gravity-acceleration-local gravity-acceleration (-> self control w-R-c))
    (vector-v++! (-> self control transv-ctrl) gravity-acceleration-local))
  (let* ((up-local (vector-matrix*! (new-stack-vector0) (-> self control dynam gravity-normal) (-> self control w-R-c)))
         (lateral-velocity (new-stack-vector0))
         (velocity-along-gravity (vector-dot up-local (-> self control transv-ctrl))))
    0.0
    (vector-! lateral-velocity
              (-> self control transv-ctrl)
              (vector-float*! lateral-velocity up-local velocity-along-gravity))
    (let* ((lateral-speed (vector-length lateral-velocity))
           (lateral-speed-copy lateral-speed))
      (if (< lateral-speed 0.00004096) (set! lateral-speed 0.0))
      (if (< velocity-along-gravity (- (-> self control dynam gravity-max)))
        (set! velocity-along-gravity (- (-> self control dynam gravity-max))))
      (vector+! (-> self control transv-ctrl)
                (vector-float*! (-> self control transv-ctrl) up-local velocity-along-gravity)
                (vector-float*! lateral-velocity lateral-velocity (/ lateral-speed lateral-speed-copy))))))

(defbehavior target-compute-slopes target ((up vector))
  "Build a no-pitch frame from the current facing and supplied up axis, then measure forward and
   sideways slopes against both the contact normal and the locally smoothed normal."
  (let ((axis (new-stack-vector0)))
    (let ((forward (new-stack-vector0))
          (frame (new 'stack-no-clear 'matrix)))
      (set! (-> forward quad) (-> self control c-R-w vector 2 quad))
      (forward-up-nopitch->inv-matrix frame forward up)
      (set-vector! axis 0.0 0.0 1.0 1.0)
      (vector-matrix*! axis axis frame)
      (set! (-> self control surface-slope-z) (- (vector-dot (-> self control surface-normal) axis)))
      (set! (-> self control local-slope-z) (- (vector-dot (-> self control local-normal) axis)))
      (set-vector! axis 1.0 0.0 0.0 1.0)
      (vector-matrix*! axis axis frame))
    (set! (-> self control surface-slope-x) (- (vector-dot (-> self control surface-normal) axis)))
    (set! (-> self control local-slope-x) (- (vector-dot (-> self control local-normal) axis))))
  0)

(defbehavior do-rotations1 target ()
  "Apply the active surface's tilt rate to the target orientation before input-driven turning."
  (rotate-toward-orientation! (-> self control) (-> self control dir-targ) 0.0 (-> self control current-surface tiltv)))

(defbehavior do-rotations2 target ()
  "Turn the desired facing toward input or actual motion at the surface turnvv rate, turn the body
   toward that desired facing at turnv, blend the override quaternion, and recompute surface slopes."
  (let ((current-forward (vector-z-quaternion! (new-stack-vector0) (-> self control dir-targ)))
        (desired-direction (if (and (or (not (logtest? (logior (-> self control status) (-> self control old-status)) (collide-status on-surface touch-surface)))
                                        (not (time-elapsed? (-> self control last-time-touching-actor) (seconds 0.5)))
                                        (!= (-> self next-state name) 'target-walk)
                                        (not (time-elapsed? (-> self state-time) (seconds 0.5)))
                                        (not (time-elapsed? (-> self control time-of-last-lc) (seconds 0.5)))
                                        (logtest? (-> self control current-surface flags) (surface-flags no-rotate-toward-transv))
                                        (!= (-> self control force-turn-to-strength) 0.0))
                                    (not (logtest? (-> self control current-surface flags) (surface-flags always-rotate-toward-transv))))
                             (-> self control to-target-pt-xz)
                             (-> self control transv))))
    (let* ((up (-> self control bent-gravity-normal))
           (current-quaternion (forward-up-nopitch->quaternion (new-stack-quaternion0) current-forward up))
           (desired-quaternion (forward-up-nopitch->quaternion (new-stack-quaternion0) desired-direction up))
           (angle-difference (acos (vector-dot current-forward desired-direction)))
           (max-step (* (-> self control current-surface turnvv) (seconds-per-frame))))
      (quaternion-slerp! (-> self control dir-targ)
                         current-quaternion
                         desired-quaternion
                         (cond
                           ((>= 0.0 (-> self control turn-to-magnitude)) 0.0)
                           ((< angle-difference max-step) 1.0)
                           (else (/ max-step angle-difference)))))
    (add-debug-vector *display-target-marks*
                      (bucket-id debug-no-zbuf)
                      (-> self control trans)
                      current-forward
                      (meters 2)
                      (new 'static 'rgba :r #xff :g #xff :b #xff :a #x80))
    (add-debug-vector *display-target-marks*
                      (bucket-id debug-no-zbuf)
                      (-> self control trans)
                      desired-direction
                      (meters 2)
                      (new 'static 'rgba :r #xff :a #x80)))
  (add-debug-vector *display-target-marks*
                    (bucket-id debug-no-zbuf)
                    (-> self control trans)
                    (-> self control c-R-w vector 2)
                    (meters 2)
                    (new 'static 'rgba :r #xff :b #xff :a #x80))
  (rotate-toward-orientation! (-> self control) (-> self control dir-targ) (-> self control current-surface turnv) 0.0)
  (quaternion-slerp! (-> self control quat)
                     (-> self control quat-for-control)
                     (-> self control override-quat)
                     (-> self control override-quat-alpha))
  (target-compute-slopes (-> self control dynam gravity-normal)))

(defbehavior level-setup target ()
  "Refresh the level containing the target, accumulate its per-level play time, and send a
   level-enter event when the containing level changes."
  (let ((previous-level (-> self current-level)))
    (set! (-> self current-level) (level-get-target-inside *level*))
    (if (and (-> self current-level) (>= (-> *level-task-data-remap* length) (-> self current-level info index)))
      (+! (-> *game-info* in-level-time (-> *level-task-data-remap* (+ (-> self current-level info index) -1)))
          (- (current-time) (-> *display* old-base-frame-counter))))
    (if (and (or (not previous-level) (!= (-> previous-level name) (-> self current-level name))) (-> self current-level))
      (send-event self 'level-enter (-> self current-level name))))
  0
  (none))

(defbehavior flag-setup target ()
  "Perform start-of-tick surface bookkeeping, maintain safe-ground and jump-apex positions, run
   surface hooks, handle look-around and debug flight input, arm eligible edge grabs, and trigger an
   endless-fall death below the level floor."
  (level-setup)
  (vector-copy! (-> self control last-transv) (-> self control transv))
  ((-> self control current-surface active-hook))
  (cond
    ((logtest? (-> self control status) (collide-status on-surface))
     (set-time! (-> self control last-time-on-surface))
     (vector-copy! (-> self control last-trans-any-surf) (-> self control trans))
     (if (and (>= (-> self control coverage) 1.0)
              (not (logtest? (-> self control status) (collide-status touch-actor on-water)))
              (logtest? (-> self control status) (collide-status on-ground)))
       (vector-copy! (-> self control last-known-safe-ground) (-> self control trans)))
     ((-> self control current-surface touch-hook)))
    (else
     (let ((position (-> self control trans)))
       (when (logtest? (-> self control old-status) (collide-status on-surface))
         (vector-copy! (-> self control last-trans-leaving-surf) (-> self control last-trans-any-surf))
         (vector-copy! (-> self control highest-jump-mark) (-> self control last-trans-any-surf)))
       ;; track the apex: xz always follows Jak; y only moves up (reset if he got above the mark).
       (set! (-> self control highest-jump-mark x) (-> position x))
       (set! (-> self control highest-jump-mark z) (-> position z))
       (if (< (vector-dot (-> self control dynam gravity-normal)
                          (vector-! (new 'stack-no-clear 'vector) (-> self control highest-jump-mark) position))
              0.0)
         (set! (-> self control highest-jump-mark y) (-> position y))))))
  (when (and (cpad-pressed? (-> self control cpad number) triangle)
             (zero? (-> self control remaining-ctrl-iterations))
             (not (logtest? (-> *kernel-context* prevent-from-run) (process-mask movie))))
    (if (and (= (-> self cam-user-mode) 'normal)
             (logtest? (-> self control mod-surface flags) (surface-flags allow-look-around))
             (not (logtest? (-> self control root-prim prim-core action)
                            (collide-action edgegrab-cam swingpole-active racer snowball tube flut)))
             (-> *setting-control* current allow-look-around)
             (time-elapsed? (-> self no-look-around-wait) (seconds 0.05))
             (not (and (= (-> self control ground-pat material) (pat-material ice)) (< 4096.0 (-> self control ctrl-xz-vel)))))
      (send-event self 'change-mode 'look-around)))
  ;; debug FLY cheat: while holding R2 in debug mode, force the falling state, zero the vertical
  ;; velocity, and hoist Jak 0.125m per tick, so he floats upward under player control.
  (when (and (= *cheat-mode* 'debug)
             (cpad-hold? (-> self control cpad number) r2)
             (not *pause-lock*)
             (not (logtest? (-> self state-flags) (state-flags grabbed first-person-mode))))
    (if (!= (-> self next-state name) 'target-falling) (send-event self 'change-mode 'falling))
    (let ((lateral-velocity (new-stack-vector0)))
      (let ((vertical-speed (vector-dot (-> self control dynam gravity-normal) (-> self control transv))))
        0.0
        (vector-! lateral-velocity
                  (-> self control transv)
                  (vector-float*! lateral-velocity (-> self control dynam gravity-normal) vertical-speed)))
      (let* ((lateral-speed (vector-length lateral-velocity))
             (lateral-speed-copy lateral-speed)
             (zero-vertical-speed 0.0))
        (vector+! (-> self control transv)
                  (vector-float*! (-> self control transv) (-> self control dynam gravity-normal) zero-vertical-speed)
                  (vector-float*! lateral-velocity lateral-velocity (/ lateral-speed lateral-speed-copy)))))
    (let ((flight-position (new 'stack-no-clear 'vector)))
      (vector-copy! flight-position (-> self control trans))
      (let ((lateral-position (new-stack-vector0))
            (height (vector-dot (-> self control dynam gravity-normal) flight-position)))
        0.0
        (vector-! lateral-position
                  flight-position
                  (vector-float*! lateral-position (-> self control dynam gravity-normal) height))
        (let* ((lateral-distance (vector-length lateral-position))
               (lateral-distance-copy lateral-distance)
               (raised-height (+ 512.0 height)))
          (vector+! flight-position
                    (vector-float*! flight-position (-> self control dynam gravity-normal) raised-height)
                    (vector-float*! lateral-position lateral-position (/ lateral-distance lateral-distance-copy)))))
      (move-to-point! (-> self control) flight-position))
    (send-event *camera* 'reset-follow)
    (set! (-> self control surf) *standard-ground-surface*))
  (let ((edge-grab-velocity (vector-dot (-> self control dynam gravity-normal) (-> self control transv))))
    (if (and (or (logtest? (-> self control current-surface flags) (surface-flags allow-edge-grab))
                 (and (= (-> self next-state name) 'target-walk) (not (logtest? (-> self control status) (collide-status on-surface)))))
             (< edge-grab-velocity 0.0)
             (or (not (and (= *cheat-mode* 'debug) (cpad-hold? (-> self control cpad number) r2))) *pause-lock*)
             (and (>= (vector-dot (-> self control dynam gravity-normal)
                                  (vector-! (new 'stack-no-clear 'vector) (-> self control trans) (-> self control shadow-pos)))
                      9420.8)
                  (not (logtest? (-> self control root-prim prim-core action) (collide-action racer flut)))
                  #t))
      ;; This eligibility test has no lasting effect here because the bit is cleared immediately
      ;; after being set. Movement states can still arm edgegrab-possible later, before collision.
      (logior! (-> self control root-prim prim-core action) (collide-action edgegrab-possible))
      (logclear! (-> self control root-prim prim-core action) (collide-action edgegrab-possible))))
  (let ((current-level (-> self current-level)))
    (if (and (time-elapsed? (-> self control last-time-on-surface) (seconds 2))
             (and current-level
                  (< (-> self control trans y) (-> current-level info bottom-height))
                  (not (and (= *cheat-mode* 'debug) (cpad-hold? (-> self control cpad number) r2)))))
      (send-event self 'attack-invinc #f (static-attack-info ((mode 'endlessfall))))))
  0
  (none))

(defbehavior post-flag-setup target ()
  "Refresh recent actor-contact time, update timed-invulnerability flicker and expiration, and clear
   the one-tick jump-kind marker after collision processing."
  (if (logtest? (-> self control status) (collide-status touch-wall touch-actor))
    (set-time! (-> self control last-time-touching-actor)))
  (when (logtest? (-> self state-flags) (state-flags timed-invulnerable))
    ;; og:preserve-this changed for high fps. This fixes the flicker speed when damaged
    (if (< (logand (- (current-time) (-> self control invulnerable-start-time)) 3) (/ 1.0 (-> *display* time-adjust-ratio)))
      (logior! (-> self draw status) (draw-status hidden))
      (logclear! (-> self draw status) (draw-status hidden)))
    (if (time-elapsed? (-> self control invulnerable-start-time) (-> self control invulnerable-duration))
      (target-timed-invulnerable-off self)))
  (set! (-> self control jump-kind) #f)
  0
  (none))

(defbehavior bend-gravity target ()
  "Ease the gravity-bend amount toward its target and rotate working gravity toward the supporting
   polygon normal, allowing the target's up direction to follow slopes. Airborne wall contact
   cancels the bend."
  (set! (-> self control bend-speed) (if (logtest? (-> self control status) (collide-status on-surface)) 32.0 2.0))
  (let ((bend-target (if (and (logtest? (-> self control status) (collide-status touch-wall))
                              (not (logtest? (-> self control status) (collide-status on-surface))))
                       0.0
                       (-> self control bend-target))))
    (seek! (-> self control bend-amount) bend-target (* (-> self control bend-speed) (seconds-per-frame))))
  (vector-deg-slerp (-> self control dynam gravity-normal)
                    (-> self control standard-dynamics gravity-normal)
                    (-> self control ground-poly-normal)
                    (-> self control bend-amount))
  (vector-float*! (-> self control dynam gravity)
                  (-> self control dynam gravity-normal)
                  (the-as float (-> self control dynam gravity-length)))
  (vector-copy! (-> self control dynam gravity-normal) (-> self control standard-dynamics gravity-normal))
  (vector-float*! (-> self control dynam gravity)
                  (-> self control dynam gravity-normal)
                  (the-as float (-> self control dynam gravity-length)))
  (vector-deg-slerp (-> self control bent-gravity-normal)
                    (-> self control standard-dynamics gravity-normal)
                    (-> self control ground-poly-normal)
                    (-> self control bend-amount))
  (add-debug-vector *display-target-marks*
                    (bucket-id debug-no-zbuf)
                    (-> self control trans)
                    (-> self control ground-poly-normal)
                    (meters 2)
                    (new 'static 'rgba :b #xff :a #x80))
  (add-debug-vector *display-target-marks*
                    (bucket-id debug-no-zbuf)
                    (-> self control trans)
                    (-> self control local-normal)
                    (meters 2)
                    (new 'static 'rgba :b #xff :a #x80))
  (add-debug-vector *display-target-marks*
                    (bucket-id debug-no-zbuf)
                    (-> self control trans)
                    (-> self control standard-dynamics gravity-normal)
                    (meters 2.5)
                    (new 'static 'rgba :r #xff :a #x80))
  (add-debug-vector *display-target-marks*
                    (bucket-id debug-no-zbuf)
                    (-> self control trans)
                    (-> self control dynam gravity-normal)
                    (meters 3)
                    (new 'static 'rgba :r #xff :b #xff :a #x80)))

(defbehavior target-compute-edge target ()
  "Revalidate the active ledge, rebuild its along-edge and across-edge frame, pull the midpoint of
   the hands toward the hold point with timeout and per-tick limits, face across the ledge, and
   record the motion for moving-platform riding."
  (let ((edge-info *edge-grab-info*))
    (if (not (update-and-validate! edge-info)) (send-event self 'end-mode))
    (if *display-edge-collision-marks* (debug-draw edge-info))
    (set! (-> self control ground-pat) (-> edge-info edge-tri-pat))
    (vector-normalize! (vector-! (-> self control edge-grab-edge-dir) (-> edge-info world-vertex 0) (-> edge-info world-vertex 1))
                       1.0)
    (let ((facing-direction (vector-cross! (-> self control edge-grab-across-edge-dir)
                                           (-> self control edge-grab-edge-dir)
                                           (-> self control dynam gravity-normal))))
      (let ((to-hold (vector-! (new-stack-vector0) (-> edge-info center-hold) (-> self control midpoint-of-hands))))
        (set! (-> self control hand-to-edge-dist) (vector-length to-hold))
        (cond
          ((and (< 819.2 (-> self control hand-to-edge-dist))
                (time-elapsed? (-> self control last-successful-compute-edge-time) (seconds 0.2)))
           (vector-normalize! to-hold 1228.8)
           (move-by-vector! (-> self control) to-hold)
           (vector-float*! (-> self control rider-last-move) to-hold (-> *display* frames-per-second))
           (set-time! (-> self control rider-time))
           (if (and (time-elapsed? (-> self control edge-grab-start-time) (seconds 0.5))
                    (time-elapsed? (-> self control last-successful-compute-edge-time) (seconds 0.5)))
             (send-event self 'end-mode)))
          (else
           (let ((hands-position (new 'stack-no-clear 'vector)))
             (vector-! hands-position (-> edge-info center-hold) (-> self control ctrl-to-hands-offset))
             (vector-float*! (-> self control rider-last-move) to-hold (-> *display* frames-per-second))
             (set-time! (-> self control rider-time))
             (move-to-point! (-> self control) hands-position))
           (set! (-> self control hand-to-edge-dist) 0.0)
           (vector-copy! (-> self control last-trans-any-surf) (-> self control trans))
           (set-time! (-> self control last-successful-compute-edge-time)))))
      (forward-up-nopitch->quaternion (-> self control dir-targ) facing-direction (-> self control dynam gravity-normal))))
  (set-quaternion! (-> self control) (-> self control dir-targ))
  (do-joint-math! self)
  (none))

(defbehavior target-compute-edge-rider target ()
  "Update a moving ledge and translate the target by the hold point's frame-to-frame motion so the
   hands continue to ride the same point."
  (let ((edge-info *edge-grab-info*))
    (if (not (update-and-validate! edge-info)) (send-event self 'end-mode))
    (if *display-edge-collision-marks* (debug-draw edge-info))
    (vector-normalize! (vector-! (-> self control edge-grab-edge-dir) (-> edge-info world-vertex 0) (-> edge-info world-vertex 1))
                       1.0)
    (vector-cross! (-> self control edge-grab-across-edge-dir)
                   (-> self control edge-grab-edge-dir)
                   (-> self control dynam gravity-normal))
    (let ((hold-motion (vector-! (new-stack-vector0) (-> edge-info center-hold) (-> edge-info center-hold-old))))
      (vector-float*! (-> self control rider-last-move) hold-motion (-> *display* frames-per-second))
      (set-time! (-> self control rider-time))
      (move-by-vector! (-> self control) hold-motion)))
  (set! (-> self control hand-to-edge-dist) 0.0)
  (do-joint-math! self)
  (none))

(defbehavior target-compute-pole target ()
  "Find the closest point on the active swing pole, draw the hands toward it until contact and then
   hold them exactly there, ease the camera below the pole center, and face perpendicular to the
   pole while preserving the approached side."
  (let* ((pole-process (handle->process (-> self control swingpole-handle)))
         (pole-direction (-> (the-as swingpole pole-process) dir)))
    (vector-copy! (-> self control edge-grab-edge-dir) pole-direction)
    (let ((closest-point (new 'stack-no-clear 'vector)))
      (let ((end-a (vector+float*! (new 'stack-no-clear 'vector)
                                   (-> (the-as swingpole pole-process) root trans)
                                   pole-direction
                                   (-> (the-as swingpole pole-process) edge-length)))
            (end-b (vector+float*! (new 'stack-no-clear 'vector)
                                   (-> (the-as swingpole pole-process) root trans)
                                   pole-direction
                                   (- (-> (the-as swingpole pole-process) edge-length)))))
        (let ((camera-target (new 'stack-no-clear 'vector)))
          (vector+! camera-target end-a end-b)
          (vector-float*! camera-target camera-target 0.5)
          (+! (-> camera-target y) -6144.0)
          (send-event *camera* 'ease-in 0.5 camera-target))
        (vector-segment-distance-point! (-> self control midpoint-of-hands) end-a end-b closest-point)
        (when *display-edge-collision-marks*
          (add-debug-vector #t
                            (bucket-id debug-no-zbuf)
                            (-> (the-as swingpole pole-process) root trans)
                            (the-as vector (&-> pole-process stack 16))
                            (meters 3)
                            (new 'static 'rgba :r #xff :b #xff :a #x80))
          (add-debug-sphere #t
                            (bucket-id debug-no-zbuf)
                            (-> (the-as swingpole pole-process) root trans)
                            (-> (the-as swingpole pole-process) range)
                            (new 'static 'rgba :r #xff :g #xff :a #x80))
          (add-debug-sphere #t (bucket-id debug) (-> self control midpoint-of-hands) 819.2 (new 'static 'rgba :r #xff :a #x80))
          (add-debug-sphere #t (bucket-id debug-no-zbuf) end-a 819.2 (new 'static 'rgba :g #xff :a #x80))
          (add-debug-sphere #t (bucket-id debug-no-zbuf) end-b 819.2 (new 'static 'rgba :g #xff :b #x40 :a #x80))
          (add-debug-sphere #t (bucket-id debug-no-zbuf) closest-point 819.2 (new 'static 'rgba :b #xff :a #x80))))
      (let ((to-pole (vector-! (new-stack-vector0) closest-point (-> self control midpoint-of-hands))))
        (cond
          ((and (< 2457.6 (vector-length to-pole)) (not (-> self control did-move-to-pole-or-max-jump-height)))
           (move-by-vector! (-> self control) (vector-normalize! to-pole 2457.6)))
          (else
           (set! (-> self control did-move-to-pole-or-max-jump-height) (the-as int #t))
           (move-to-point! (-> self control)
                           (vector-! (new 'stack-no-clear 'vector) closest-point (-> self control ctrl-to-hands-offset)))
           (vector-copy! (-> self control last-trans-any-surf) (-> self control trans))))))
    (let ((facing-direction (vector-cross! (-> self control edge-grab-across-edge-dir) pole-direction (-> self control dynam gravity-normal))))
      ;; Pick the pole perpendicular on the same side as the current facing. When the first direction
      ;; already agrees, the conditional and unconditional negations cancel; otherwise the final
      ;; negation flips it to the agreeing side.
      (if (>= 0.0
              (vector-dot facing-direction (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> self control quat-for-control))))
        (vector-negate! facing-direction facing-direction))
      (forward-up-nopitch->quaternion (-> self control dir-targ) facing-direction (-> self control dynam gravity-normal))))
  (set-quaternion! (-> self control) (-> self control dir-targ))
  (do-joint-math! self)
  (update-transforms! (-> self control))
  (none))

(defbehavior target-calc-camera-pos target ()
  "Select the camera tracking point from the animated clone joint, water surface, mud height,
   control position, tube shadow, or skeleton root according to the current movement mode."
  (let ((clone-position (new 'stack-no-clear 'vector)))
    (cond
      ((and (= (-> self next-state name) 'target-clone-anim)
            (not (logtest? (-> self draw status) (draw-status hidden)))
            (begin
              (vector<-cspace! clone-position (joint-node eichar-lod0-jg main))
              (+! (-> clone-position y) -5896.192)
              (< (fabs (- (-> clone-position y) (-> self control trans y))) 8192.0)))
       (vector-copy! (-> self control camera-pos) clone-position))
      (else
       (let ((water-flags (-> self water flags)))
         (cond
           ((and (logtest? water-flags (water-flag touch-water)) (logtest? water-flags (water-flag swimming under-water)))
            (vector<-cspace! (-> self control camera-pos) (-> self node-list data 0))
            (if (not (and (logtest? (-> self water flags) (water-flag under-water))
                          (not (logtest? (-> self water flags) (water-flag swim-ground)))))
              (set! (-> self control camera-pos y) (- (-> self water base-height) (-> self water swim-height))))
            (-> self control camera-pos))
           ((and (logtest? (-> self water flags) (water-flag touch-water)) (logtest? (water-flag mud) (-> self water flags)))
            (vector<-cspace! (-> self control camera-pos) (-> self node-list data 0))
            (set! (-> self control camera-pos y) (-> self water base-height)))
           ((logtest? (-> self control root-prim prim-core action) (collide-action racer))
            (vector-copy! (-> self control camera-pos) (-> self control trans)))
           ((logtest? (-> self control root-prim prim-core action) (collide-action tube))
            (vector-copy! (-> self control camera-pos) (-> self control shadow-pos)))
           ((logtest? (-> self draw status) (draw-status hidden no-anim))
            (vector-copy! (-> self control camera-pos) (-> self control trans)))
           (else (vector<-cspace! (-> self control camera-pos) (-> self node-list data 0))))))))
  0
  (none))

(defbehavior joint-points target ()
  "Choose the movement surface for wading, swimming, or mud; refresh head, sidekick, and hand points
   from the evaluated skeleton; update active edge or pole holds; select the camera point; and clear
   one-tick prevention and tongue state."
  (let ((neck-mod (-> self neck))) (set! (-> neck-mod blend) 0.0))
  (cond
    ((logtest? (-> self control root-prim prim-core action) (collide-action racer tube)))
    ((logtest? (-> self water flags) (water-flag wading))
     (let ((wade-depth (- (- (-> self control trans y) (- (-> self water height) (-> self water wade-height))))))
       (set! (-> *wade-surface* alignv)
             (lerp-scale 1.0 0.5 wade-depth 0.0 (- (-> self water swim-height) (-> self water wade-height))))
       (set! (-> *wade-surface* align-speed) (-> *wade-surface* alignv))
       (let ((wade-speed (lerp-scale 0.8 0.6 wade-depth 0.0 (- (-> self water swim-height) (-> self water wade-height)))))
         (set! (-> *wade-surface* target-speed) wade-speed)
         (set! (-> *wade-surface* transv-max) wade-speed)))
     (set! (-> self control surf) *wade-surface*))
    ((logtest? (-> self water flags) (water-flag swimming)) (set! (-> self control surf) *swim-surface*))
    ((and (logtest? (-> self water flags) (water-flag touch-water)) (logtest? (water-flag mud) (-> self water flags)))
     (set! (-> self control surf) *quicksand-surface*)))
  (let ((orientation (matrix<-no-trans-transformq! (-> self control root-orientation) (the-as transformq (-> self control trans)))))
    (vector-matrix*! (-> self control ctrl-to-head-offset) (-> *TARGET-bank* head-offset) orientation))
  (vector<-cspace! (the-as vector (&-> self control sidekick-root bone)) (-> self control sidekick-root parent))
  (let ((left-hand-position (new-stack-vector0))
        (right-hand-position (new-stack-vector0)))
    (vector<-cspace! left-hand-position (-> self control hand-cspaces parent))
    (vector<-cspace! right-hand-position (the-as cspace (-> self control hand-cspaces joint)))
    (vector-average! (-> self control midpoint-of-hands) left-hand-position right-hand-position))
  (vector-! (-> self control ctrl-to-hands-offset) (-> self control midpoint-of-hands) (-> self control trans))
  (cond
    ((logtest? (-> self control root-prim prim-core action) (collide-action edgegrab-cam)) (target-compute-edge))
    ((logtest? (-> self control root-prim prim-core action) (collide-action swingpole-active)) (target-compute-pole)))
  (target-calc-camera-pos)
  (when (logtest? (-> self state-flags) (state-flags remove-prevents))
    (logclear! (-> self state-flags) (state-flags prevent-attack prevent-duck remove-prevents))
    (set! (-> self control force-turn-to-strength) 0.0))
  (set! (-> self control tongue-counter) 0)
  0
  (none))

(defbehavior target-real-post target ()
  "Run the complete fixed-step target movement pipeline: status setup, coordinate conversion, pad
   filtering and forced heading, thrust, gravity, facing, collision integration, and gravity bend.
   Multiple physics ticks are processed when the display time ratio requires them."
  (let ((time-ratio (the int (-> *display* time-ratio))))
    (set-time-ratios *display* 1.0)
    (countdown (ticks-remaining time-ratio)
      (set! (-> self control remaining-ctrl-iterations) ticks-remaining)
      (flag-setup)
      ;; negative force-turn-to-strength means "let go of the stick to be steered": strength grows
      ;; as the stick relaxes, so the scripted direction takes over only when the player isn't pushing.
      (if (< (-> self control force-turn-to-strength) 0.0)
        (set! (-> self control force-turn-to-strength) (- 1.0 (-> self control cpad stick0-speed))))
      (build-conversions (-> self control transv))
      (do-rotations1)
      (let ((stick-direction (new-stack-vector0)))
        (read-pad stick-direction)
        (let ((stick-magnitude (-> self control pad-magnitude)))
          ;; jitter reject: a quick direction flip at partial deflection (< 0.7) is squashed to zero
          ;; so an accidental stick flick doesn't nudge Jak.
          (if (and (< 0.0 stick-magnitude)
                   (< 0.3 (-> self control pad-magnitude))
                   (< (vector-dot (-> self control pad-xz-dir) (-> self control last-pad-xz-dir)) 0.2)
                   (< stick-magnitude 0.7))
            (set! stick-magnitude 0.0))
          ;; force-turn-to: blend the stick input toward the commanded direction/speed by strength.
          (when (!= (-> self control force-turn-to-strength) 0.0)
            (let ((force-strength (fmin 1.0 (-> self control force-turn-to-strength))))
              (set! (-> self control force-turn-to-strength) force-strength)
              (let ((stick-vector (vector-float*! (new 'stack-no-clear 'vector) (if (= stick-magnitude 0.0) *zero-vector* stick-direction) stick-magnitude))
                    (forced-vector (vector-float*! (new 'stack-no-clear 'vector)
                                                   (-> self control force-turn-to-direction)
                                                   (-> self control force-turn-to-magnitude))))
                (vector-lerp! stick-direction stick-vector forced-vector force-strength)))
            (set! stick-magnitude (vector-length stick-direction))
            (vector-normalize! stick-direction 1.0))
          (turn-to-vector stick-direction stick-magnitude)))
      (add-thrust)
      (add-gravity)
      (do-rotations2)
      (reverse-conversions (-> self control transv))
      (if *debug-segment*
        (add-frame (-> *display* frames (-> *display* on-screen) frame profile-bar 0)
                   'draw
                   (new 'static 'rgba :r #x40 :b #x40 :a #x80)))
      (set! (-> self control reaction) target-collision-reaction)
      (fill-cache-integrate-and-collide! (-> self control) (-> self control transv) (-> self control root-prim collide-with))
      (if (logtest? (-> self control root-prim prim-core action) (collide-action edgegrab-possible))
        (find-edge-grabs! *target* *collide-cache*))
      (if *debug-segment*
        (add-frame (-> *display* frames (-> *display* on-screen) frame profile-bar 0)
                   'draw
                   (new 'static 'rgba :r #x80 :g #x60 :b #x40 :a #x80)))
      (bend-gravity)
      (post-flag-setup))
    (set-time-ratios *display* (the float time-ratio)))
  (if *debug-segment*
    (add-frame (-> *display* frames (-> *display* on-screen) frame profile-bar 0)
               'draw
               (new 'static 'rgba :r #x40 :b #x40 :a #x80)))
  (ja-post)
  (if *debug-segment*
    (add-frame (-> *display* frames (-> *display* on-screen) frame profile-bar 0) 'draw (new 'static 'rgba :r #x80 :a #x80)))
  (joint-points)
  (do-target-shadow)
  (target-powerup-process)
  (none))

(defbehavior target-post target ()
  "Run the standard complete movement post-processing pipeline."
  (target-real-post)
  (none))

(defbehavior target-swim-post target ()
  "Run swimming movement without stick-flick rejection, forced-heading blending, or gravity bending,
   keeping water movement aligned to true gravity."
  (let ((time-ratio (the int (-> *display* time-ratio))))
    (set-time-ratios *display* 1.0)
    (countdown (ticks-remaining time-ratio)
      (set! (-> self control remaining-ctrl-iterations) ticks-remaining)
      (flag-setup)
      (build-conversions (-> self control transv))
      (do-rotations1)
      (let ((stick-direction (new-stack-vector0)))
        (read-pad stick-direction)
        (turn-to-vector stick-direction (-> self control pad-magnitude)))
      (add-thrust)
      (add-gravity)
      (do-rotations2)
      (reverse-conversions (-> self control transv))
      (if *debug-segment*
        (add-frame (-> *display* frames (-> *display* on-screen) frame profile-bar 0)
                   'draw
                   (new 'static 'rgba :r #x40 :b #x40 :a #x80)))
      (fill-cache-integrate-and-collide! (-> self control) (-> self control transv) (-> self control root-prim collide-with))
      (if (logtest? (-> self control root-prim prim-core action) (collide-action edgegrab-possible))
        (find-edge-grabs! *target* *collide-cache*))
      (if *debug-segment*
        (add-frame (-> *display* frames (-> *display* on-screen) frame profile-bar 0)
                   'draw
                   (new 'static 'rgba :r #x80 :g #x60 :b #x40 :a #x80)))
      (post-flag-setup))
    (set-time-ratios *display* (the float time-ratio)))
  (if *debug-segment*
    (add-frame (-> *display* frames (-> *display* on-screen) frame profile-bar 0)
               'draw
               (new 'static 'rgba :r #x40 :b #x40 :a #x80)))
  (ja-post)
  (if *debug-segment*
    (add-frame (-> *display* frames (-> *display* on-screen) frame profile-bar 0) 'draw (new 'static 'rgba :r #x80 :a #x80)))
  (joint-points)
  (do-target-shadow)
  (target-powerup-process)
  (none))


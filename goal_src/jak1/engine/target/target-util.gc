;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/anim/joint.gc")
(require "engine/collide/collide-shape.gc")
(require "engine/gfx/shadow/shadow-cpu-h.gc")
(require "engine/common-obs/process-drawable-h.gc")
(define-extern target-collide-set! (function symbol float int :behavior target))

;; Shared target movement, collision, attack, invulnerability, ground-animation,
;; and camera-focus utilities.

;; DECOMP BEGINS

(defskelgroup *jchar-sg*
  eichar
  eichar-lod0-jg
  -1
  ((eichar-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 2 0 3)
  :longest-edge (meters 1)
  :shadow eichar-shadow-mg
  :texture-level 2
  :sort 1)

(define *target-shadow-control*
  (new 'static
       'shadow-control
       :settings
       (new 'static
            'shadow-settings
            :flags (shadow-flags disable-fade)
            :shadow-dir
            (new 'static 'vector :x -0.4226 :y -0.9063 :w 409600.0)
            :bot-plane
            (new 'static 'plane :y 1.0 :w 37683.2)
            :top-plane
            (new 'static 'plane :y 1.0 :w 4096.0))))

;; Movement and collision tuning for every target stance, jump, attack, and
;; transition.
(deftype target-bank (basic)
  ((jump-collide-offset          meters)
   (jump-height-min              meters)
   (jump-height-max              meters)
   (double-jump-height-min       meters)
   (double-jump-height-max       meters)
   (flip-jump-height-min         meters)
   (flip-jump-height-max         meters)
   (duck-jump-height-min         meters)
   (duck-jump-height-max         meters)
   (flop-jump-height-min         meters)
   (flop-jump-height-max         meters)
   (attack-jump-height-min       meters)
   (attack-jump-height-max       meters)
   (edge-grab-jump-height-min    meters)
   (edge-grab-jump-height-max    meters)
   (swim-jump-height-min         meters)
   (swim-jump-height-max         meters)
   (tube-jump-height-min         meters)
   (tube-jump-height-max         meters)
   (wheel-duration               time-frame)
   (wheel-jump-pre-window        time-frame)
   (wheel-jump-post-window       time-frame)
   (wheel-timeout                time-frame)
   (wheel-speed-min              meters)
   (wheel-speed-inc              meters)
   (wheel-flip-duration          time-frame)
   (wheel-flip-height            meters)
   (wheel-flip-dist              meters)
   (wheel-flip-art-height        meters)
   (wheel-flip-art-dist          meters)
   (duck-slide-distance          meters)
   (fall-far                     meters)
   (fall-far-inc                 meters)
   (attack-timeout               time-frame)
   (ground-timeout               time-frame)
   (slide-down-timeout           time-frame)
   (fall-timeout                 time-frame)
   (fall-stumble-threshold       meters)
   (yellow-projectile-speed      meters)
   (hit-invulnerable-timeout     time-frame)
   (run-cycle-length             float)
   (walk-cycle-dist              meters)
   (walk-up-cycle-dist           meters)
   (walk-down-cycle-dist         meters)
   (walk-side-cycle-dist         meters)
   (run-cycle-dist               meters)
   (run-up-cycle-dist            meters)
   (run-down-cycle-dist          meters)
   (run-side-cycle-dist          meters)
   (run-wall-cycle-dist          meters)
   (duck-walk-cycle-dist         meters)
   (wade-shallow-walk-cycle-dist meters)
   (wade-deep-walk-cycle-dist    meters)
   (smack-surface-dist           meters)
   (smack-surface-height         meters)
   (min-dive-depth               meters)
   (root-radius                  meters)
   (root-offset                  vector :inline)
   (body-radius                  meters)
   (edge-radius                  meters)
   (edge-offset                  vector :inline)
   (head-radius                  meters)
   (head-height                  meters)
   (head-offset                  vector :inline)
   (spin-radius                  meters)
   (spin-offset                  vector :inline)
   (duck-spin-radius             meters)
   (duck-spin-offset             vector :inline)
   (punch-radius                 meters)
   (punch-offset                 vector :inline)
   (uppercut-radius              meters)
   (uppercut0-offset             vector :inline)
   (uppercut1-offset             vector :inline)
   (flop-radius                  meters)
   (flop0-offset                 vector :inline)
   (flop1-offset                 vector :inline)
   (stuck-time                   seconds)
   (stuck-timeout                seconds)
   (stuck-distance               meters)
   (tongue-pull-speed-min        float)
   (tongue-pull-speed-max        float)
   (yellow-attack-timeout        time-frame)))

(define *TARGET-bank*
  (new 'static
       'target-bank
       :jump-collide-offset (meters 0.7)
       :jump-height-min (meters 1.01)
       :jump-height-max (meters 3.5)
       :double-jump-height-min (meters 1)
       :double-jump-height-max (meters 2.5)
       :flip-jump-height-min (meters 5)
       :flip-jump-height-max (meters 7)
       :duck-jump-height-min (meters 5)
       :duck-jump-height-max (meters 7)
       :flop-jump-height-min (meters 5)
       :flop-jump-height-max (meters 7)
       :attack-jump-height-min (meters 4)
       :attack-jump-height-max (meters 5.5)
       :edge-grab-jump-height-min (meters 1.7)
       :edge-grab-jump-height-max (meters 1.7)
       :swim-jump-height-min (meters 5)
       :swim-jump-height-max (meters 5)
       :tube-jump-height-min (meters 1.75)
       :tube-jump-height-max (meters 2.5)
       :wheel-duration (seconds 0.5)
       :wheel-jump-pre-window (seconds 1)
       :wheel-jump-post-window (seconds 0.1)
       :wheel-speed-min (meters 11.5)
       :wheel-speed-inc (meters 1.5)
       :wheel-flip-duration (seconds 0.7)
       :wheel-flip-height (meters 3.52)
       :wheel-flip-dist (meters 17.3)
       :wheel-flip-art-height (meters 3.2969)
       :wheel-flip-art-dist (meters 12.5)
       :duck-slide-distance (meters 5.75)
       :fall-far (meters 30)
       :fall-far-inc (meters 20)
       :attack-timeout (seconds 0.3)
       :ground-timeout (seconds 0.2)
       :slide-down-timeout (seconds 0.2)
       :fall-timeout (seconds 1)
       :fall-stumble-threshold (meters 39.9)
       :yellow-projectile-speed (meters 60)
       :hit-invulnerable-timeout (seconds 3)
       :run-cycle-length 60.0
       :walk-cycle-dist (meters 2.8)
       :walk-up-cycle-dist (meters 2.8)
       :walk-down-cycle-dist (meters 2.8)
       :walk-side-cycle-dist (meters 2.8)
       :run-cycle-dist (meters 6.25)
       :run-up-cycle-dist (meters 5)
       :run-down-cycle-dist (meters 5)
       :run-side-cycle-dist (meters 6.25)
       :run-wall-cycle-dist (meters 2.8)
       :duck-walk-cycle-dist (meters 3.25)
       :wade-shallow-walk-cycle-dist (meters 6)
       :wade-deep-walk-cycle-dist (meters 6)
       :smack-surface-dist (meters 1.25)
       :min-dive-depth (meters 2)
       :root-radius (meters 2.2)
       :root-offset
       (new 'static 'vector :y 4915.2 :w 1.0)
       :body-radius (meters 0.7)
       :edge-radius (meters 0.35)
       :edge-offset
       (new 'static 'vector :y 4915.2 :z 4096.0 :w 1.0)
       :head-radius (meters 0.7)
       :head-height (meters 1.4)
       :head-offset
       (new 'static 'vector :y 4915.2 :w 1.0)
       :spin-radius (meters 2.2)
       :spin-offset
       (new 'static 'vector :y 6553.6 :w 1.0)
       :duck-spin-radius (meters 1.2)
       :duck-spin-offset
       (new 'static 'vector :y 4096.0 :w 1.0)
       :punch-radius (meters 1.3)
       :punch-offset
       (new 'static 'vector :y 5324.8 :w 1.0)
       :uppercut-radius (meters 1)
       :uppercut0-offset
       (new 'static 'vector :y 3276.8 :w 1.0)
       :uppercut1-offset
       (new 'static 'vector :y 9011.2 :w 1.0)
       :flop-radius (meters 1.4)
       :flop0-offset
       (new 'static 'vector :y 3276.8 :w 1.0)
       :flop1-offset
       (new 'static 'vector :y 9011.2 :w 1.0)
       :stuck-time (seconds 0.3)
       :stuck-timeout (seconds 2)
       :stuck-distance (meters 0.05)
       :tongue-pull-speed-min 0.15
       :tongue-pull-speed-max 0.22
       :yellow-attack-timeout (seconds 0.2)))

(defbehavior target-start-attack target ()
  "Begin a distinct attack by incrementing its ID and clearing the number of objects hit."
  (+! (-> self control target-attack-id) 1)
  (set! (-> self control attack-count) 0)
  0
  (none))

(defbehavior target-danger-set! target ((mode symbol) (enlarge? symbol))
  "Configure the target's attack spheres for mode, reset inactive spheres, and update the dangerous
   state flag. enlarge? applies the red-eco radius scale, except that the airborne flop is not enlarged
   and flop-down uses a slightly larger scale."
  (let ((sphere0 (-> self control danger-sphere0))
        (sphere1 (-> self control danger-sphere1))
        (sphere2 (-> self control danger-sphere2))
        (radius-scale (if enlarge? 2.0 1.0)))
    ;; Restore the body spheres and detach every attack sphere before installing
    ;; the selected attack shape.
    (dotimes (i 3)
      (set! (-> self control collision-spheres i prim-core offense) (collide-offense normal-attack)))
    (sphere<-vector+r! (the-as sphere (-> self control root-prim local-sphere))
                       (-> *TARGET-bank* root-offset)
                       (-> *TARGET-bank* root-radius))
    (set! (-> self control danger-mode) mode)
    (logclear! (-> self state-flags) (state-flags dangerous))
    (set! (-> sphere0 transform-index) -2)
    (set! (-> sphere0 prim-core collide-as) (collide-kind))
    (set! (-> sphere0 collide-with) (collide-kind))
    (set! (-> sphere0 local-sphere w) 0.0)
    (set! (-> sphere0 prim-core offense) (collide-offense no-offense))
    (set! (-> sphere1 transform-index) -2)
    (set! (-> sphere1 prim-core collide-as) (collide-kind))
    (set! (-> sphere1 collide-with) (collide-kind))
    (set! (-> sphere1 local-sphere w) 0.0)
    (set! (-> sphere1 prim-core offense) (collide-offense no-offense))
    (set! (-> sphere2 transform-index) -2)
    (set! (-> sphere2 prim-core collide-as) (collide-kind))
    (set! (-> sphere2 collide-with) (collide-kind))
    (set! (-> sphere2 local-sphere w) 0.0)
    (set! (-> sphere2 prim-core offense) (collide-offense no-offense))
    (case mode
      (('harmless #f)
       (set! (-> self control danger-mode) #f)
       (target-collide-set! (-> self control collide-mode) (-> self control collide-mode-transition)))
      (('spin 'spin-air)
       ;; One root-relative sphere covers the full spin.
       (sphere<-vector+r! (the-as sphere (-> self control root-prim local-sphere)) (new 'static 'vector :y 6553.6 :w 1.0) 9830.4)
       (logior! (-> self state-flags) (state-flags dangerous))
       (set! (-> sphere0 prim-core collide-as) (collide-kind target target-attack))
       (set! (-> sphere0 collide-with)
             (collide-kind cak-1 cak-2 cak-3 powerup crate enemy wall-object ground-object mother-spider))
       (sphere<-vector+r! (the-as sphere (-> sphere0 local-sphere))
                          (-> *TARGET-bank* spin-offset)
                          (-> *TARGET-bank* spin-radius)))
      (('duck-spin)
       ;; Combine a root-relative low sphere with a joint-tracking sphere.
       (sphere<-vector+r! (the-as sphere (-> self control root-prim local-sphere))
                          (new 'static 'vector :y 6553.6 :w 1.0)
                          10649.6)
       (logior! (-> self state-flags) (state-flags dangerous))
       (set! (-> sphere0 prim-core collide-as) (collide-kind target target-attack))
       (set! (-> sphere0 collide-with)
             (collide-kind cak-1 cak-2 cak-3 powerup crate enemy wall-object ground-object mother-spider))
       (sphere<-vector+r! (the-as sphere (-> sphere0 local-sphere))
                          (-> *TARGET-bank* duck-spin-offset)
                          (-> *TARGET-bank* duck-spin-radius))
       (set! (-> sphere1 prim-core collide-as) (collide-kind target target-attack))
       (set! (-> sphere1 collide-with)
             (collide-kind cak-1 cak-2 cak-3 powerup crate enemy wall-object ground-object mother-spider))
       (sphere<-vector+r! (the-as sphere (-> sphere1 local-sphere)) *null-vector* (-> *TARGET-bank* duck-spin-radius))
       (set! (-> sphere1 transform-index) 32))
      (('duck-slide)
       (logior! (-> self state-flags) (state-flags dangerous))
       (set! (-> sphere0 prim-core collide-as) (collide-kind target target-attack))
       (set! (-> sphere0 collide-with)
             (collide-kind cak-1 cak-2 cak-3 powerup crate enemy wall-object ground-object mother-spider))
       (sphere<-vector+r! (the-as sphere (-> sphere0 local-sphere))
                          (-> *TARGET-bank* duck-spin-offset)
                          (-> *TARGET-bank* duck-spin-radius))
       (set! (-> sphere1 prim-core collide-as) (collide-kind target target-attack))
       (set! (-> sphere1 collide-with)
             (collide-kind cak-1 cak-2 cak-3 powerup crate enemy wall-object ground-object mother-spider))
       (sphere<-vector+r! (the-as sphere (-> sphere1 local-sphere)) *null-vector* (-> *TARGET-bank* duck-spin-radius))
       (set! (-> sphere1 transform-index) 28))
      (('wheel-solid)
       ;; During a roll, the body spheres become touch-only and the separate
       ;; attack spheres provide damage.
       (logior! (-> self state-flags) (state-flags dangerous))
       (set! (-> sphere0 prim-core collide-as) (collide-kind target target-attack))
       (set! (-> sphere0 collide-with)
             (collide-kind cak-1 cak-2 cak-3 powerup crate enemy wall-object ground-object mother-spider))
       (dotimes (i 3)
         (set! (-> self control collision-spheres i prim-core offense) (collide-offense touch)))
       (sphere<-vector+r! (the-as sphere (-> sphere0 local-sphere))
                          (-> *TARGET-bank* duck-spin-offset)
                          (+ 819.2 (-> *TARGET-bank* duck-spin-radius)))
       (set! (-> sphere1 prim-core collide-as) (collide-kind target target-attack))
       (set! (-> sphere1 collide-with)
             (collide-kind cak-1 cak-2 cak-3 powerup crate enemy wall-object ground-object mother-spider))
       (sphere<-vector+r! (the-as sphere (-> sphere1 local-sphere)) *null-vector* (-> *TARGET-bank* duck-spin-radius))
       (set! (-> sphere1 transform-index) 7)
       (set! (-> self control danger-mode) 'roll))
      (('flip)
       (logior! (-> self state-flags) (state-flags dangerous))
       (set! (-> sphere0 prim-core collide-as) (collide-kind target target-attack))
       (set! (-> sphere0 collide-with)
             (collide-kind cak-1 cak-2 cak-3 powerup crate enemy wall-object ground-object mother-spider))
       (dotimes (i 3)
         (set! (-> self control collision-spheres i prim-core offense) (collide-offense touch)))
       (sphere<-vector+r! (the-as sphere (-> sphere0 local-sphere))
                          (-> *TARGET-bank* duck-spin-offset)
                          (+ 819.2 (-> *TARGET-bank* duck-spin-radius)))
       (set! (-> sphere1 prim-core collide-as) (collide-kind target target-attack))
       (set! (-> sphere1 collide-with)
             (collide-kind cak-1 cak-2 cak-3 powerup crate enemy wall-object ground-object mother-spider))
       (sphere<-vector+r! (the-as sphere (-> sphere1 local-sphere)) *null-vector* (-> *TARGET-bank* duck-spin-radius))
       (set! (-> sphere1 transform-index) 7)
       (set! (-> self control danger-mode) 'flip))
      (('punch)
       (sphere<-vector+r! (the-as sphere (-> self control root-prim local-sphere))
                          (new 'static 'vector :y 6553.6 :w 1.0)
                          11878.4)
       (logior! (-> self state-flags) (state-flags dangerous))
       (set! (-> sphere0 prim-core collide-as) (collide-kind target target-attack))
       (set! (-> sphere0 collide-with)
             (collide-kind cak-1 cak-2 cak-3 powerup crate enemy wall-object ground-object mother-spider))
       (sphere<-vector+r! (the-as sphere (-> sphere0 local-sphere))
                          (-> *TARGET-bank* punch-offset)
                          (-> *TARGET-bank* punch-radius))
       (set! (-> sphere1 prim-core collide-as) (collide-kind target target-attack))
       (set! (-> sphere1 collide-with)
             (collide-kind cak-1 cak-2 cak-3 powerup crate enemy wall-object ground-object mother-spider))
       (sphere<-vector+r! (the-as sphere (-> sphere1 local-sphere)) *null-vector* (-> *TARGET-bank* punch-radius))
       (set! (-> sphere1 transform-index) 22))
      (('uppercut)
       ;; Uppercut is the only mode that uses all three attack spheres.
       (sphere<-vector+r! (the-as sphere (-> self control root-prim local-sphere))
                          (new 'static 'vector :y 6553.6 :w 1.0)
                          11878.4)
       (logior! (-> self state-flags) (state-flags dangerous))
       (set! (-> sphere0 prim-core collide-as) (collide-kind target target-attack))
       (set! (-> sphere0 collide-with)
             (collide-kind cak-1 cak-2 cak-3 powerup crate enemy wall-object ground-object mother-spider))
       (sphere<-vector+r! (the-as sphere (-> sphere0 local-sphere))
                          (-> *TARGET-bank* uppercut0-offset)
                          (-> *TARGET-bank* uppercut-radius))
       (set! (-> sphere1 prim-core collide-as) (collide-kind target target-attack))
       (set! (-> sphere1 collide-with)
             (collide-kind cak-1 cak-2 cak-3 powerup crate enemy wall-object ground-object mother-spider))
       (sphere<-vector+r! (the-as sphere (-> sphere1 local-sphere)) *null-vector* (-> *TARGET-bank* uppercut-radius))
       (set! (-> sphere1 transform-index) 22)
       (set! (-> sphere2 prim-core collide-as) (collide-kind target target-attack))
       (set! (-> sphere2 collide-with)
             (collide-kind cak-1 cak-2 cak-3 powerup crate enemy wall-object ground-object mother-spider))
       (sphere<-vector+r! (the-as sphere (-> sphere2 local-sphere))
                          (-> *TARGET-bank* uppercut1-offset)
                          (-> *TARGET-bank* uppercut-radius)))
      (('flop)
       ;; The airborne ground pound does not receive red-eco enlargement.
       (logior! (-> self state-flags) (state-flags dangerous))
       (set! (-> sphere0 prim-core collide-as) (collide-kind target target-attack))
       (set! (-> sphere0 collide-with)
             (collide-kind cak-1 cak-2 cak-3 powerup crate enemy wall-object ground-object mother-spider))
       (dotimes (i 3)
         (set! (-> self control collision-spheres i prim-core offense) (collide-offense strong-attack)))
       (sphere<-vector+r! (the-as sphere (-> sphere0 local-sphere))
                          (-> *TARGET-bank* flop0-offset)
                          (-> *TARGET-bank* flop-radius))
       (set! radius-scale 1.0)
       (set! (-> self control danger-mode) 'flop))
      (('flop-down)
       ;; The descending ground pound adds its upper sphere and uses a 2.1x
       ;; red-eco radius.
       (logior! (-> self state-flags) (state-flags dangerous))
       (set! (-> sphere0 prim-core collide-as) (collide-kind target target-attack))
       (set! (-> sphere0 collide-with)
             (collide-kind cak-1 cak-2 cak-3 powerup crate enemy wall-object ground-object mother-spider))
       (dotimes (i 3)
         (set! (-> self control collision-spheres i prim-core offense) (collide-offense strong-attack)))
       (sphere<-vector+r! (the-as sphere (-> sphere0 local-sphere))
                          (-> *TARGET-bank* flop0-offset)
                          (-> *TARGET-bank* flop-radius))
       (set! (-> sphere1 prim-core collide-as) (collide-kind target target-attack))
       (set! (-> sphere1 collide-with)
             (collide-kind cak-1 cak-2 cak-3 powerup crate enemy wall-object ground-object mother-spider))
       (sphere<-vector+r! (the-as sphere (-> sphere1 local-sphere))
                          (-> *TARGET-bank* flop1-offset)
                          (-> *TARGET-bank* flop-radius))
       (if (!= radius-scale 1.0) (set! radius-scale 2.1))
       (set! (-> self control danger-mode) 'flop))
      (('flut-attack)
       (sphere<-vector+r! (the-as sphere (-> self control root-prim local-sphere))
                          (new 'static 'vector :y 6553.6 :w 1.0)
                          12288.0)
       (logior! (-> self state-flags) (state-flags dangerous))
       (set! (-> sphere0 prim-core collide-as) (collide-kind target target-attack))
       (set! (-> sphere0 collide-with)
             (collide-kind cak-1 cak-2 cak-3 powerup crate enemy wall-object ground-object mother-spider))
       (sphere<-vector+r! (the-as sphere (-> sphere0 local-sphere))
                          (-> *TARGET-bank* spin-offset)
                          (+ 2048.0 (-> *TARGET-bank* punch-radius)))
       (set! (-> sphere1 prim-core collide-as) (collide-kind target target-attack))
       (set! (-> sphere1 collide-with)
             (collide-kind cak-1 cak-2 cak-3 powerup crate enemy wall-object ground-object mother-spider))
       (sphere<-vector+r! (the-as sphere (-> sphere1 local-sphere)) *null-vector* (+ 1228.8 (-> *TARGET-bank* punch-radius)))
       (set! (-> sphere1 transform-index) 37)
       (dotimes (i 3)
         (set! (-> self control collision-spheres i prim-core offense) (collide-offense strong-attack))))
      (else (format 0 "ERROR: ~A unknown danger mode ~A" self mode)))
    ;; Red eco enlarges both the root bounds and every active attack sphere.
    (when (and (!= radius-scale 1.0) (not (or (= mode 'harmless) (= mode #f))))
      (set! (-> self control root-prim local-sphere w) (* (-> self control root-prim local-sphere w) radius-scale))
      (set! (-> sphere0 local-sphere w) (* (-> sphere0 local-sphere w) radius-scale))
      (set! (-> sphere1 local-sphere w) (* (-> sphere1 local-sphere w) radius-scale))
      (set! (-> sphere2 local-sphere w) (* (-> sphere2 local-sphere w) radius-scale)))))

(defbehavior target-collide-set! target ((mode symbol) (transition float))
  "Configure the target's root bounds and three body spheres for mode. Pole pins the spheres to
   joints; racer and flut install vehicle bounds; duck and tube collapse the vertical stack according
   to transition; the default restores standing bounds. Save mode and transition so harmless danger
   mode can restore the current pose."
  (let ((control (-> self control)))
    (set! (-> self control collide-mode) mode)
    (set! (-> self control collide-mode-transition) transition)
    (dotimes (i 3)
      (set! (-> control collision-spheres i prim-core offense) (collide-offense touch))
      (set! (-> control collision-spheres i transform-index) -2))
    (case mode
      (('pole)
       ;; Pin compact spheres to the three joints used while swinging.
       (set-vector! (-> control collision-spheres 0 local-sphere) 0.0 0.0 0.0 (-> *TARGET-bank* body-radius))
       (set-vector! (-> control collision-spheres 1 local-sphere) 0.0 0.0 0.0 (-> *TARGET-bank* body-radius))
       (set-vector! (-> control collision-spheres 2 local-sphere) 0.0 0.0 0.0 (-> *TARGET-bank* body-radius))
       (set! (-> control collision-spheres 0 transform-index) 28)
       (set! (-> control collision-spheres 1 transform-index) 26)
       (set! (-> control collision-spheres 2 transform-index) 7))
      (('racer)
       ;; The zoomer raises the drawable and uses large, damaging vehicle
       ;; bounds.
       (set! (-> control draw-offset y) 4096.0)
       (sphere<-vector+r! (the-as sphere (-> control root-prim local-sphere)) (new 'static 'vector :y 8192.0 :w 1.0) 16384.0)
       (set-vector! (-> control collision-spheres 0 local-sphere) 0.0 6553.6 0.0 6553.6)
       (set-vector! (-> control collision-spheres 1 local-sphere) 0.0 9420.8 0.0 6553.6)
       (set-vector! (-> control collision-spheres 2 local-sphere) 0.0 12288.0 0.0 6553.6)
       (dotimes (i 3)
         (set! (-> control collision-spheres i prim-core offense) (collide-offense strong-attack))))
      (('flut)
       (sphere<-vector+r! (the-as sphere (-> control root-prim local-sphere)) (new 'static 'vector :y 8192.0 :w 1.0) 12288.0)
       (set-vector! (-> control collision-spheres 0 local-sphere) 0.0 4915.2 0.0 4915.2)
       (set-vector! (-> control collision-spheres 1 local-sphere) 0.0 7782.4004 0.0 4915.2)
       (set-vector! (-> control collision-spheres 2 local-sphere) 0.0 10649.6 0.0 4915.2))
      (('duck)
       (set! (-> self control duck-tube-transition) transition)
       (let ((duck-upright-fraction (- 1.0 transition)))
         (set! (-> control draw-offset y) 0.0)
         (sphere<-vector+r! (the-as sphere (-> control root-prim local-sphere))
                            (-> *TARGET-bank* root-offset)
                            (-> *TARGET-bank* root-radius))
         ;; Sink the upper two spheres toward the bottom sphere as the duck
         ;; completes.
         (set-vector! (-> control collision-spheres 0 local-sphere)
                      0.0
                      (-> *TARGET-bank* body-radius)
                      (* 0.0 duck-upright-fraction)
                      (-> *TARGET-bank* body-radius))
         (set-vector! (-> control collision-spheres 1 local-sphere)
                      0.0
                      (+ (-> *TARGET-bank* body-radius) (* 2867.2 duck-upright-fraction))
                      0.0
                      (-> *TARGET-bank* body-radius))
         (set-vector! (-> control collision-spheres 2 local-sphere)
                      0.0
                      (+ (-> *TARGET-bank* body-radius) (* 5734.4 duck-upright-fraction))
                      0.0
                      (-> *TARGET-bank* body-radius))))
      (('tube)
       ;; Tube uses the same collapsing stack as duck, but its body spheres
       ;; count as strong attacks.
       (set! (-> self control duck-tube-transition) transition)
       (let ((tube-upright-fraction (- 1.0 transition)))
         (set! (-> control draw-offset y) 0.0)
         (sphere<-vector+r! (the-as sphere (-> control root-prim local-sphere))
                            (-> *TARGET-bank* root-offset)
                            (-> *TARGET-bank* root-radius))
         (set-vector! (-> control collision-spheres 0 local-sphere)
                      0.0
                      (-> *TARGET-bank* body-radius)
                      (* 0.0 tube-upright-fraction)
                      (-> *TARGET-bank* body-radius))
         (set-vector! (-> control collision-spheres 1 local-sphere)
                      0.0
                      (+ (-> *TARGET-bank* body-radius) (* 2867.2 tube-upright-fraction))
                      0.0
                      (-> *TARGET-bank* body-radius))
         (set-vector! (-> control collision-spheres 2 local-sphere)
                      0.0
                      (+ (-> *TARGET-bank* body-radius) (* 5734.4 tube-upright-fraction))
                      0.0
                      (-> *TARGET-bank* body-radius)))
       (dotimes (i 3)
         (set! (-> control collision-spheres i prim-core offense) (collide-offense strong-attack))))
      (else
       (set! (-> self control duck-tube-transition) 0.0)
       (set! (-> control draw-offset y) 0.0)
       (sphere<-vector+r! (the-as sphere (-> control root-prim local-sphere))
                          (-> *TARGET-bank* root-offset)
                          (-> *TARGET-bank* root-radius))
       (set-vector! (-> control collision-spheres 0 local-sphere)
                    0.0
                    (-> *TARGET-bank* body-radius)
                    0.0
                    (-> *TARGET-bank* body-radius))
       (set-vector! (-> control collision-spheres 1 local-sphere)
                    0.0
                    (+ 2867.2 (-> *TARGET-bank* body-radius))
                    0.0
                    (-> *TARGET-bank* body-radius))
       (set-vector! (-> control collision-spheres 2 local-sphere)
                    0.0
                    (+ 5734.4 (-> *TARGET-bank* body-radius))
                    0.0
                    (-> *TARGET-bank* body-radius)))))
  0)

(defmethod get-quaternion ((this control-info))
  "Return the transform's quaternion storage."
  (-> this quat-for-control))

(defbehavior target-align-vel-z-adjust target ((velocity-z float))
  "Scale a requested control-space forward velocity by the current surface alignment. Uphill
   motion additionally fades by one minus the local forward slope."
  (let ((slope-z (-> self control local-slope-z)))
    (* velocity-z
       (if (< 0.0 slope-z) (* (- 1.0 slope-z) (-> self control current-surface alignv)) (-> self control current-surface alignv)))))

(defmethod apply-alignment ((this target) (options align-opts) (alignment-transform transformq) (scale vector))
  "Apply the requested animation-root alignment to this drawable. Selected local velocity
   components are rebuilt from animation translation, per-axis scale, frame rate, and gravity; the
   rotation option postmultiplies and normalizes the root quaternion."
  (let ((velocity-scale (new 'stack-no-clear 'vector)))
    (vector-copy! velocity-scale scale)
    (set! (-> velocity-scale z) (target-align-vel-z-adjust (-> velocity-scale z)))
    (when (logtest? options (align-opts adjust-x-vel adjust-y-vel adjust-xz-vel))
      (let* ((control-to-world (-> this control c-R-w))
             (world-to-control (-> this control w-R-c))
             (gravity-control (vector-matrix*! (new 'stack-no-clear 'vector) (-> this control dynam gravity) world-to-control))
             (velocity-control (vector-matrix*! (new 'stack-no-clear 'vector) (-> this control transv) world-to-control)))
        (if (logtest? options (align-opts no-gravity)) (set-vector! gravity-control 0.0 0.0 0.0 1.0))
        (when (logtest? options (align-opts adjust-x-vel))
          (set! (-> velocity-control x)
                (+ (* (-> alignment-transform trans x) (-> velocity-scale x) (-> *display* frames-per-second))
                   (* (-> gravity-control x) (seconds-per-frame))))
          (if (not (logtest? options (align-opts adjust-xz-vel keep-other-velocities))) (set! (-> velocity-control z) 0.0)))
        (if (and (logtest? options (align-opts adjust-y-vel))
                 (not (and (logtest? options (align-opts ignore-y-if-zero)) (= (-> alignment-transform trans y) 0.0))))
          (set! (-> velocity-control y)
                (+ (* (-> alignment-transform trans y) (-> velocity-scale y) (-> *display* frames-per-second))
                   (* (-> gravity-control y) (seconds-per-frame)))))
        (when (logtest? options (align-opts adjust-xz-vel))
          (set! (-> velocity-control z)
                (+ (* (-> alignment-transform trans z) (-> velocity-scale z) (-> *display* frames-per-second))
                   (* (-> gravity-control z) (seconds-per-frame))))
          (if (not (logtest? options (align-opts adjust-x-vel keep-other-velocities))) (set! (-> velocity-control x) 0.0)))
        (vector-matrix*! (-> this control transv) velocity-control control-to-world))))
  (if (logtest? options (align-opts adjust-quat))
    (quaternion-normalize! (quaternion*! (-> this control quat-for-control) (-> this control quat-for-control) (-> alignment-transform quat))))
  (the-as collide-shape (-> this control)))

(defun average-turn-angle ((target-process target))
  "Return the mean absolute angle in degrees between straight ahead and the eight buffered turn
   directions."
  (let ((angle-sum 0.0))
    (dotimes (i 8)
      (+! angle-sum
          (fabs (deg-diff (atan (-> target-process control turn-history-ctrl i x) (-> target-process control turn-history-ctrl i z))
                          0.0))))
    (/ angle-sum 8)))

(defbehavior can-play-stance-amibent? target ()
  "Return whether the idle stance animation may play after thirty seconds without speech,
   spooling, a movie, a hint, actor contact, or water contact. The amibent spelling is original."
  (and (time-elapsed? (-> self state-time) (seconds 30))
       (not (-> *setting-control* current talking))
       (not (-> *setting-control* current spooling))
       (not (-> *setting-control* current movie))
       (not (-> *setting-control* current hint))
       (not (logtest? (-> self control status) (collide-status touch-actor)))
       (not (logtest? (-> self water flags) (water-flag touch-water)))))

(defbehavior can-jump? target ((jump-state symbol))
  "Return whether the target may jump from a surface or during the post-surface grace interval,
   subject to surface and state prevent flags. Wheel flips additionally reject steep forward slopes."
  (and (or (logtest? (-> self control status) (collide-status on-surface))
           (not (time-elapsed? (-> self control last-time-on-surface) (-> *TARGET-bank* ground-timeout)))
           (and (logtest? (-> self control status) (collide-status on-surface)) (< 0.866 (-> self control surface-angle))))
       (and (not (logtest? (-> self control current-surface flags) (surface-flags prevent-jump)))
            (not (logtest? (-> self state-flags) (state-flags prevent-jump)))
            (case jump-state
              (('target-wheel-flip) (>= 0.5 (-> self control local-slope-z)))
              (else #t)))))

(defbehavior move-legs? target ()
  "Return whether the target's movement stick has any nonzero magnitude."
  (!= (-> *cpad-list* cpads (-> self control cpad number) stick0-speed) 0.0))

(defbehavior target-height-above-ground target ()
  "Return the target root's vertical distance above the ground point found by its shadow probe."
  (- (-> self control trans y) (-> self control shadow-pos y)))

(defbehavior fall-test target ()
  "Enter target-falling after the target has left a surface beyond the grace interval and is moving
   with gravity. Preserve recent moving-platform velocity; punch animations delay falling while close
   to the ground."
  (when (and (not (logtest? (-> self control status) (collide-status on-surface)))
             (time-elapsed? (-> self control last-time-on-surface) (-> *TARGET-bank* ground-timeout))
             (>= 0.0 (vector-dot (-> self control dynam gravity-normal) (-> self control transv)))
             (let ((animation-group (ja-group)))
               (or (not (or (= animation-group eichar-attack-punch-ja)
                            (= animation-group eichar-attack-punch-end-ja)
                            (= animation-group eichar-attack-punch-alt-end-ja)))
                   (< 4096.0 (target-height-above-ground)))))
    (when (and (not (time-elapsed? (-> self control rider-time) (-> *TARGET-bank* ground-timeout)))
               (logtest? (-> self control current-surface flags) (surface-flags moving-ground)))
      (+! (-> self control transv x) (-> self control rider-last-move x))
      (+! (-> self control transv z) (-> self control rider-last-move z)))
    (go target-falling #f))
  (none))

(defbehavior slide-down-test target ()
  "Enter target-slide-down when the target is no longer standing or edge-grabbing, is beyond the
   surface grace interval, and still touches terrain too steep to stand on."
  (if (and (not (logtest? (-> self control status) (collide-status on-surface touch-edge)))
           (time-elapsed? (-> self control last-time-on-surface) (-> *TARGET-bank* ground-timeout))
           (logtest? (-> self control status) (collide-status touch-surface))
           (< 0.5 (-> self control surface-angle)))
    (go target-slide-down))
  (none))

(defbehavior smack-surface? target ((include-actors? symbol))
  "Return whether the target struck a steep wall while lacking a significant standable contact.
   When include-actors? is false, reject contact caused only by another actor."
  (and (< 0.7 (-> self control touch-angle))
       (and (< (-> self control surface-angle) 0.3)
            (logtest? (-> self control status) (collide-status touch-wall))
            (or include-actors? (not (logtest? (-> self control status) (collide-status touch-actor)))))))

(defbehavior can-wheel? target ()
  "Return whether the target may roll: it must stand on a surface, avoid a near-head-on wall,
   remain below the forward-slope limit, and lack the prevent-duck state flag."
  (and (logtest? (-> self control status) (collide-status on-surface))
       (or (not (logtest? (-> self control status) (collide-status touch-wall))) (>= 0.7 (-> self control touch-angle)))
       (and (< (-> self control local-slope-z) 0.7) (not (logtest? (-> self state-flags) (state-flags prevent-duck))))))

(defbehavior can-duck? target ()
  "Return whether the target may duck on sufficiently flat ground while not swimming, underwater,
   prevented from ducking, or too deep below the wading line."
  (and (logtest? (-> self control status) (collide-status on-surface))
       (>= (-> self control ground-local-norm-dot-grav) 0.7)
       (not (logtest? (-> self water flags) (water-flag swimming under-water)))
       (not (logtest? (-> self state-flags) (state-flags prevent-duck)))
       (or (not (logtest? (-> self water flags) (water-flag wading)))
           (< (- (- (-> self control trans y) (- (-> self water base-height) (-> self water wade-height)))) 2457.6))))

(defbehavior can-exit-duck? target ()
  "Probe two standing-height body spheres and return whether no solid collision prevents the target
   from standing up."
  (let ((params (new 'stack-no-clear 'collide-using-spheres-params)))
    (let ((spheres (new 'stack-no-clear 'inline-array 'sphere 2)))
      (dotimes (i 2)
        ((method-of-type sphere new) (the-as symbol (-> spheres i)) sphere))
      (set! (-> spheres 0 quad) (-> self control trans quad))
      (set! (-> spheres 0 y) (+ 5734.4 (-> *TARGET-bank* body-radius) (-> spheres 0 y)))
      (set! (-> spheres 0 w) (-> *TARGET-bank* body-radius))
      (set! (-> spheres 1 quad) (-> self control trans quad))
      (set! (-> spheres 1 y) (+ 2867.2 (-> *TARGET-bank* body-radius) (-> spheres 1 y)))
      (set! (-> spheres 1 w) (-> *TARGET-bank* body-radius))
      (set! (-> params spheres) spheres))
    (set! (-> params num-spheres) (the-as uint 2))
    (set! (-> params collide-with) (-> self control root-prim collide-with))
    (set! (-> params proc) #f)
    (set! (-> params ignore-pat) (new 'static 'pat-surface :noentity #x1))
    (set! (-> params solid-only) #t)
    (if (fill-and-probe-using-spheres *collide-cache* params) #f #t)))

(defbehavior can-hands? target ((require-ground? symbol))
  "Return whether a square-button hand attack may begin. Enforce state and surface restrictions,
   optional recent-ground and slope requirements, and the running-attack cooldown; powered yellow eco
   can override removable prevention and uses the shorter cooldown. Record a blocked cooldown attempt
   for input buffering."
  (cond
    ((or (not (cpad-pressed? (-> self control cpad number) square))
         (or (and (logtest? (-> self state-flags) (state-flags prevent-attack))
                  (or (not (logtest? (-> self state-flags) (state-flags remove-prevents)))
                      (not (and (= (-> self fact eco-type) (pickup-type eco-yellow)) (>= (-> self fact eco-level) 1.0)))))
             (logtest? (-> self control current-surface flags)
                       (surface-flags prevent-attacks-during-launch-jump prevent-hand-attack))))
     #f)
    ((and (or (not require-ground?)
              (and (not (time-elapsed? (-> self control last-time-on-surface) (-> *TARGET-bank* ground-timeout)))
                   (< (-> self control local-slope-z) 0.7)))
          (time-elapsed? (if (and (= (-> self fact eco-type) (pickup-type eco-yellow)) (>= (-> self fact eco-level) 1.0))
                           (-> *TARGET-bank* yellow-attack-timeout)
                           (-> *TARGET-bank* attack-timeout))
                         (-> self control last-running-attack-end-time)))
     #t)
    (else (set-time! (-> self control last-hands-attempt-time)) #f)))

(defbehavior can-feet? target ()
  "Return whether a feet attack may begin after state, surface, and attack-cooldown checks. Record a
   blocked cooldown attempt for input buffering."
  (cond
    ((or (logtest? (-> self state-flags) (state-flags prevent-attack))
         (logtest? (-> self control current-surface flags)
                   (surface-flags prevent-attacks-during-launch-jump prevent-feet-attack)))
     #f)
    ((time-elapsed? (-> *TARGET-bank* attack-timeout) (-> self control last-attack-end-time)) #t)
    (else (set-time! (-> self control last-feet-attempt-time)) #f)))

(defbehavior vector-local+! target ((destination vector) (local-vector vector))
  "Transform local-vector from target control space to world space, add it to destination, and
   return destination."
  (let ((world-vector (new-stack-vector0)))
    (vector-matrix*! world-vector local-vector (-> self control c-R-w))
    (vector+! destination destination world-vector)))

(defbehavior move-forward target ((speed float))
  "Add speed along the target's local forward axis to its world velocity."
  (let ((local-velocity (new-stack-vector0))
        (world-velocity (new-stack-vector0)))
    (set-vector! local-velocity 0.0 0.0 speed 1.0)
    (vector-matrix*! world-velocity local-velocity (-> self control c-R-w))
    (vector+! (-> self control transv) (-> self control transv) world-velocity)))

(defbehavior set-forward-vel target ((speed float))
  "Replace local forward velocity with speed, clear local sideways velocity, and preserve the
   vertical component."
  (let ((local-velocity (new-stack-vector0)))
    (vector-matrix*! local-velocity (-> self control transv) (-> self control w-R-c))
    (set! (-> local-velocity z) speed)
    (set! (-> local-velocity x) 0.0)
    (vector-matrix*! (-> self control transv) local-velocity (-> self control c-R-w))))

(defbehavior delete-back-vel target ()
  "Clamp the velocity component opposite the target's facing to zero while retaining forward and
   sideways motion."
  (let ((facing (new-stack-vector0)))
    (vector-z-quaternion! facing (-> self control dir-targ))
    (let ((side-velocity (new-stack-vector0))
          (forward-speed (vector-dot facing (-> self control transv))))
      0.0
      (vector-! side-velocity (-> self control transv) (vector-float*! side-velocity facing forward-speed))
      (let* ((side-length (vector-length side-velocity))
             (side-length-copy side-length))
        ;; This ratio retains the original sideways magnitude; both values come
        ;; from the same length calculation.
        (if (< forward-speed 0.0) (set! forward-speed 0.0))
        (vector+! (-> self control transv)
                  (vector-float*! (-> self control transv) facing forward-speed)
                  (vector-float*! side-velocity side-velocity (/ side-length side-length-copy))))))
  0
  (none))

(defbehavior set-side-vel target ((speed float))
  "Replace local sideways velocity with speed, clear local forward velocity, and preserve the
   vertical component."
  (let ((local-velocity (new-stack-vector0)))
    (vector-matrix*! local-velocity (-> self control transv) (-> self control w-R-c))
    (set! (-> local-velocity x) speed)
    (set! (-> local-velocity z) 0.0)
    (vector-matrix*! (-> self control transv) local-velocity (-> self control c-R-w))))

(defun target-timed-invulnerable ((duration time-frame) (target-process target))
  "Start timed invulnerability for target-process, save its start and duration, and remove
   target-attack from the body spheres' accepted collision kinds."
  (logior! (-> target-process state-flags) (state-flags timed-invulnerable))
  (set-time! (-> target-process control invulnerable-start-time))
  (set! (-> target-process control invulnerable-duration) duration)
  (set-collide-kinds (-> target-process control) 2 (collide-kind target-attack) (collide-kind))
  0
  (none))

(defun target-timed-invulnerable-off ((target-process target))
  "End timed invulnerability, ensure the target is visible, and restore target-attack collision."
  (logclear! (-> target-process draw status) (draw-status hidden))
  (logclear! (-> target-process state-flags) (state-flags timed-invulnerable))
  (set-collide-kinds (-> target-process control) 2 (collide-kind) (collide-kind target-attack))
  0
  (none))

(defmethod combine! ((this attack-info) (incoming attack-info))
  "Merge fields selected by incoming.mask. Derive a missing knockback vector from the attacker
   to the current process; when a vector is supplied, use it to default shove-back and shove-up.
   Default dist to the absolute shove-back distance."
  (with-pp
    (let ((mask (-> incoming mask)))
      (set! (-> this mask) (-> incoming mask))
      (if (logtest? mask (attack-mask attacker)) (set! (-> this attacker) (-> incoming attacker)))
      (if (logtest? mask (attack-mask mode)) (set! (-> this mode) (-> incoming mode)))
      (if (logtest? mask (attack-mask angle)) (set! (-> this angle) (-> incoming angle)))
      (if (logtest? mask (attack-mask dist)) (set! (-> this dist) (-> incoming dist)))
      (if (logtest? mask (attack-mask control)) (set! (-> this control) (-> incoming control)))
      (if (logtest? mask (attack-mask speed)) (set! (-> this speed) (-> incoming speed)))
      (if (logtest? mask (attack-mask shove-back)) (set! (-> this shove-back) (-> incoming shove-back)))
      (if (logtest? mask (attack-mask shove-up)) (set! (-> this shove-up) (-> incoming shove-up)))
      (if (logtest? mask (attack-mask invinc-time)) (set! (-> this invinc-time) (-> incoming invinc-time)))
      (if (logtest? mask (attack-mask rotate-to)) (set! (-> this rotate-to) (-> incoming rotate-to)))
      (if (logtest? mask (attack-mask intersection)) (vector-copy! (-> this intersection) (-> incoming intersection)))
      (cond
        ((not (logtest? mask (attack-mask vector)))
         ;; Derive knockback from the attacker toward the process being hit.
         (let* ((receiver-process pp)
                (attacker-process (handle->process (-> this attacker)))
                (attacker-drawable (if (and (nonzero? attacker-process) (type-type? (-> attacker-process type) process-drawable)) attacker-process)))
           (when attacker-drawable
             (vector-copy! (-> this trans) (-> (the-as process-drawable attacker-drawable) root trans))
             (vector-! (-> this vector)
                       (-> (the-as process-drawable receiver-process) root trans)
                       (-> (the-as process-drawable attacker-drawable) root trans))
             (logior! (-> this mask) (attack-mask vector)))))
        (else
         ;; A supplied vector provides defaults for any omitted shove fields.
         (let* ((supplied-attacker-process (handle->process (-> this attacker)))
                (supplied-attacker-drawable (if (and (nonzero? supplied-attacker-process) (type-type? (-> supplied-attacker-process type) process-drawable))
                                              supplied-attacker-process)))
           (if supplied-attacker-drawable
             (vector-copy! (-> this trans) (-> (the-as process-drawable supplied-attacker-drawable) root trans))))
         (vector-copy! (-> this vector) (-> incoming vector))
         (if (not (logtest? mask (attack-mask shove-back))) (set! (-> this shove-back) (vector-xz-length (-> this vector))))
         (if (not (logtest? mask (attack-mask shove-up))) (set! (-> this shove-up) (-> this vector y)))))
      (if (not (logtest? (-> this mask) (attack-mask dist))) (set! (-> this dist) (fabs (-> this shove-back))))
      (if (logtest? mask (attack-mask trans)) (vector-copy! (-> this trans) (-> incoming trans))))
    (none)))

(defbehavior ground-tween-initialize target ((info ground-tween-info)
              (base-channel uint)
              (flat-group uint)
              (up-group uint)
              (down-group uint)
              (left-group uint)
              (right-group uint))
  "Configure three animation channels for a flat ground animation plus uphill, downhill, left, and
   right slope blends. base-channel selects the first channel and the next two hold the directional
   layers."
  (set! (-> info group 0) flat-group)
  (set! (-> info group 1) up-group)
  (set! (-> info group 2) down-group)
  (set! (-> info group 3) left-group)
  (set! (-> info group 4) right-group)
  (dotimes (i 3)
    (set! (-> info chan i) (+ base-channel i))
    (ja :chan (-> info chan i) :group! flat-group :num! min :frame-interp (fabs (-> info blend i))))
  info)

(defbehavior ground-tween-update target ((info ground-tween-info) (slope-z float) (slope-x float))
  "Update the ground-animation forward and sideways blends from local slope. Clamp their targets,
   ease each by a distance-dependent 0.05-to-0.2 step, and select the positive or negative directional
   animation group for each layer."
  (let ((forward-target (fmax -1.0 (fmin 1.0 (* 2.0 slope-z))))
        (side-target (fmax -1.0 (fmin 1.0 (* 1.6 slope-x)))))
    (let ((forward-difference (fabs (- forward-target (the-as float (-> info blend 1))))))
      (set! (-> info blend 1)
            (seek (the-as float (-> info blend 1)) forward-target (fmax 0.05 (fmin 0.2 (/ forward-difference 4))))))
    (let ((side-difference (fabs (- side-target (the-as float (-> info blend 2))))))
      (set! (-> info blend 2)
            (seek (the-as float (-> info blend 2)) side-target (fmax 0.05 (fmin 0.2 (/ side-difference 4)))))))
  (if (>= (-> info blend 1) 0.0)
    (ja :chan (-> info chan 1) :group! (-> info group 1) :frame-interp (fabs (-> info blend 1)))
    (ja :chan (-> info chan 1) :group! (-> info group 2) :frame-interp (fabs (-> info blend 1))))
  (if (>= (-> info blend 2) 0.0)
    (ja :chan (-> info chan 2) :group! (-> info group 4) :frame-interp (fabs (-> info blend 2)))
    (ja :chan (-> info chan 2) :group! (-> info group 3) :frame-interp (fabs (-> info blend 2))))
  0
  (none))

(defun target-pos ((joint-index int))
  "Return the target root position for joint-index zero or the selected joint translation
   otherwise. Fall back to the camera position when no target exists."
  (let ((target-process *target*))
    (cond
      (target-process
       (if (zero? joint-index)
         (-> target-process control trans)
         (vector<-cspace! (new 'static 'vector) (-> target-process node-list data joint-index))))
      (else (camera-pos)))))

(defun target-cam-pos ()
  "Return the point the camera should follow. Use the target's alternate point for explicit or
   saved-position overrides; while falling into dark eco, clamp the ordinary camera point above that
   alternate height. Fall back to the camera position when no target exists."
  (let ((target-process *target*))
    (cond
      ((not target-process) (camera-pos))
      ((logtest? (-> target-process state-flags) (state-flags use-alt-cam-pos))
       (add-debug-sphere *display-camera-marks*
                         (bucket-id debug-no-zbuf)
                         (-> target-process alt-cam-pos)
                         819.2
                         (new 'static 'rgba :r #xff :a #x80))
       (-> target-process alt-cam-pos))
      ((logtest? (state-flags has-saved-position) (-> target-process state-flags))
       (add-debug-sphere *display-camera-marks*
                         (bucket-id debug-no-zbuf)
                         (-> target-process alt-cam-pos)
                         819.2
                         (new 'static 'rgba :r #xff :a #x80))
       (-> target-process alt-cam-pos))
      ((logtest? (state-flags falling-into-pool-of-bad) (-> target-process state-flags))
       (let ((position (new 'static 'vector)))
         (vector-copy! position (-> target-process control camera-pos))
         (set! (-> position y) (fmax (-> position y) (-> target-process alt-cam-pos y)))
         (add-debug-sphere *display-camera-marks* (bucket-id debug-no-zbuf) position 819.2 (new 'static 'rgba :r #xff :a #x80))
         position))
      (else
       (add-debug-sphere *display-camera-marks*
                         (bucket-id debug-no-zbuf)
                         (-> target-process control camera-pos)
                         819.2
                         (new 'static 'rgba :r #xff :a #x80))
       (-> target-process control camera-pos)))))

(defun target-joint-pos ()
  "Return the target draw-origin joint position, or the camera position when no target exists."
  (let ((target-process *target*))
    (if target-process
      (vector<-cspace! (new 'static 'vector) (-> target-process node-list data (-> target-process draw origin-joint-index)))
      (camera-pos))))

(defun target-rot ()
  "Return the target's control quaternion, or the identity quaternion when no target exists."
  (let ((target-process *target*)) (if target-process (-> target-process control quat-for-control) *unity-quaternion*)))

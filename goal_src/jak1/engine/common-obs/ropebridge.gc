(defskelgroup *vil3-bridge-36-sg*
  vil3-bridge-36
  vil3-bridge-36-lod0-jg
  vil3-bridge-36-idle-ja
  ((vil3-bridge-36-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 4)
  :longest-edge (meters 3.6))

;; Each board is the segment between two spring points. Bonks and unique flop attacks push both
;; endpoints of the struck board, while sticky riders add their weight to the endpoints under
;; them. Physics advances only the interior points; the two ends stay anchored. The post-bind
;; callback turns the resulting chain into board transforms before collision and riders update.
(defstate ropebridge-idle (ropebridge)
  :event
    (behavior ((source process) (argc int) (message symbol) (block event-message-block))
      (let ((impact-strength -1.0))
        (cond
          ((= message 'bonk)
           (when (time-elapsed? (-> self bonk-time-stamp) (seconds 0.2))
             (set-time! (-> self bonk-time-stamp))
             (set! impact-strength (the-as float (-> block param 1)))
             (if (>= impact-strength (-> self tuning rider-bonk-max)) (set! impact-strength (-> self tuning rider-bonk-max)))))
          ((and (= message 'attack) (= (-> block param 1) 'flop))
           (let ((attack-id (-> block param 2)))
             (when (!= attack-id (-> self player-attack-id))
               (set! (-> self player-attack-id) attack-id)
               (set-time! (-> self attack-flop-time-stamp))
               (set! impact-strength (* 1.1 (-> self tuning rider-bonk-max)))))))
        (when (and (>= impact-strength (-> self tuning rider-bonk-min)) (-> block param 0))
          (set-time! (-> self agitated-time-stamp))
          (let* ((impact-force (/ (* (- impact-strength (-> self tuning rider-bonk-min)) (-> self tuning rider-bonk-force))
                                  (- (-> self tuning rider-bonk-max) (-> self tuning rider-bonk-min))))
                 (touch-entry (the-as object (-> block param 0)))
                 (touching-prims (-> (the-as touching-shapes-entry touch-entry) head))
                 (bridge-shape (-> self root))
                 (touched-board (get-touched-prim touching-prims bridge-shape (the-as touching-shapes-entry touch-entry)))
                 (impact-shape ((method-of-type touching-shapes-entry get-touched-shape) (the-as touching-shapes-entry touch-entry) bridge-shape))
                 (impact-local-position (new 'stack-no-clear 'vector)))
            (vector-matrix*! impact-local-position (-> impact-shape trans) (-> self inv-world-matrix))
            (let ((board-index (-> touched-board prim-id)))
              (let ((board-point (-> self spring-point board-index))) (new 'stack-no-clear 'vector) (&+ board-point 48))
              (set-vel-from-impact self board-index impact-local-position -1 impact-force)
              (set-vel-from-impact self (+ board-index 1) impact-local-position 1 impact-force))))))
  :code
    (behavior ()
      (loop
        (suspend)
        (detect-riders! (-> self root))
        (when (-> self do-physics?)
          (clear-spring-forces self)
          (set-vel-from-riders self)
          ;; original
          ;; (do-integration self)
          ;; og:preserve-this modified to try to fix crazy bridges
          ;; instead of doing one big step when lagging, do multiple small steps.
          ;; temporarily change time ratio to 1.0 (like we are 60 fps)
          (let ((old-time-ratio (the int (-> *display* time-ratio))))
            (set-time-ratios *display* 1.0)
            ;; then do multiple steps to simulate the same amount of time, but without longer timesteps
            (dotimes (i old-time-ratio)
              (do-integration self))
            (set-time-ratios *display* (the float old-time-ratio))))))
  :post
    (behavior ()
      (ja-post)
      (let ((bridge-shape (-> self root)))
        (update-transforms! bridge-shape)
        (when (-> self do-physics?)
          (pull-riders! bridge-shape)
          (do-push-aways! bridge-shape)))
      0))

;; WARN: Function (method 20 ropebridge) has a return type of none, but the expression builder found a return statement.
(defmethod set-vel-from-impact ((this ropebridge) (spring-index uint) (impact-position vector) (step int) (impulse float))
  "Starting at spring-index and walking by step, apply a downward velocity impulse to spring
   points within max-bonk-influence-dist along the bridge span. Attenuate the impulse by
   1 / (1 + 8 * distance / max-distance), and stop at the first point outside the range or
   array."
  (loop
    (let ((span-distance (fabs (- (-> impact-position z) (-> this spring-point (the-as int spring-index) local-pos z)))))
      (if (< (-> this tuning max-bonk-influence-dist) span-distance) (return #f))
      (let* ((scaled-distance (/ (* 8.0 span-distance) (-> this tuning max-bonk-influence-dist)))
             (attenuation-denominator (+ 1.0 scaled-distance))
             (attenuation (/ 1.0 attenuation-denominator)))
        (set! (-> this spring-point (the-as int spring-index) vel y)
              (- (-> this spring-point (the-as int spring-index) vel y) (* attenuation impulse)))))
    (set! spring-index (+ spring-index step))
    (if (or (< (the-as int spring-index) 0) (>= (the-as int spring-index) (-> this tuning num-spring-points))) (return #f)))
  (none))

(defmethod clear-spring-forces ((this ropebridge))
  "Clear the per-step external force on every spring point."
  (let ((spring-point (the-as ropebridge-spring-point (-> this spring-point))))
    (countdown (i (-> this tuning num-spring-points))
      (set! (-> spring-point extra-force quad) (the-as uint128 0))
      (nop!)
      (nop!)
      (&+! spring-point 48)))
  (none))

(defmethod set-vel-from-riders ((this ropebridge))
  "Transform every valid sticky rider into bridge-local coordinates and add its weight to the
   two spring points adjoining the ridden collision board. Mark the bridge agitated."
  (let ((rider-list (-> this root riders)))
    (when rider-list
      (let ((rider (the-as collide-sticky-rider (-> rider-list rider))))
        (countdown (i (-> rider-list num-riders))
          (let ((rider-process (handle->process (-> rider rider-handle))))
            (when rider-process
              (let ((rider-root (-> (the-as process-drawable rider-process) root))
                    (sticky-board (-> rider sticky-prim)))
                (when sticky-board
                  (let ((rider-local-position (new 'stack-no-clear 'vector)))
                    (vector-matrix*! rider-local-position (-> rider-root trans) (-> this inv-world-matrix))
                    (let ((board-index (-> sticky-board prim-id)))
                      (set-vel-from-rider this board-index rider-local-position -1)
                      (set-vel-from-rider this (+ board-index 1) rider-local-position 1)))
                  (set-time! (-> this agitated-time-stamp))))))
          (&+! rider 32)))))
  (none))

;; WARN: Function (method 22 ropebridge) has a return type of none, but the expression builder found a return statement.
(defmethod set-vel-from-rider ((this ropebridge) (spring-index uint) (rider-position vector) (step int))
  "Starting at spring-index and walking by step, add the rider's attenuated downward force to
   spring points within max-influence-dist. Stop at the first point outside the range or array."
  (loop
    (let ((distance (vector-vector-distance rider-position (-> this spring-point (the-as int spring-index) local-pos))))
      (if (< (-> this tuning max-influence-dist) distance) (return #f))
      (let* ((scaled-distance (/ (* 8.0 distance) (-> this tuning max-influence-dist)))
             (attenuation-denominator (+ 1.0 scaled-distance))
             (attenuation (/ 1.0 attenuation-denominator)))
        (+! (-> this spring-point (the-as int spring-index) extra-force y) (* attenuation (-> this tuning rider-max-gravity)))))
    (+! spring-index step)
    (if (or (< (the-as int spring-index) 0) (>= (the-as int spring-index) (-> this tuning num-spring-points))) (return #f)))
  (none))

(defmethod do-integration ((this ropebridge))
  "Integrate every non-endpoint spring point. Combine rider force and gravity, add tension from
   each overstretched neighboring segment using the original squared-length response, divide
   by spring mass, damp velocity by friction, then advance local positions by seconds-per-frame.
   The two endpoint positions remain fixed."
  (local-vars (previous-length-squared float) (next-length-squared float))
  (rlet ((Q :class vf)
         (vf0 :class vf)
         (force :class vf)
         (tension :class vf)
         (velocity :class vf)
         (friction :class vf)
         (delta-time :class vf)
         (inverse-mass :class vf)
         (acceleration :class vf)
         (previous-position :class vf)
         (position :class vf)
         (next-position :class vf)
         (previous-delta :class vf)
         (next-delta :class vf)
         (previous-length-squared-v :class vf)
         (next-length-squared-v :class vf)
         (gravity :class vf))
    (init-vf0-vector)
    ;; Build XYZ vectors from the scalar tuning values.
    (let ((gravity-scalar (-> this tuning gravity))) (.mov gravity gravity-scalar))
    (.add.x.vf.y gravity vf0 gravity)
    (.mov.vf.xzw gravity vf0)
    0
    (let ((friction-scalar (-> this tuning friction))) (.mov friction friction-scalar))
    (.add.x.vf.y friction vf0 friction)
    (.add.x.vf.z friction vf0 friction)
    0
    (let ((inverse-mass-scalar (/ 1.0 (-> this tuning spring-mass)))) (.mov inverse-mass inverse-mass-scalar))
    (.add.x.vf.y inverse-mass vf0 inverse-mass)
    (.add.x.vf.z inverse-mass vf0 inverse-mass)
    0
    ;; Accumulate tension from the segments on both sides of each interior spring point. The
    ;; response deliberately uses squared segment length and its reciprocal without taking a
    ;; square root; desired-spring-len is tuned for this expression rather than a conventional
    ;; Hooke-law distance.
    (let ((force-point-count (+ (-> this tuning num-spring-points) -2)))
      (let* ((spring-points (-> this spring-point))
             (spring-point (-> spring-points 1)))
        (.lvf previous-position (&-> spring-points 0 local-pos quad))
        (label integrate-force)
        (.lvf force (&-> spring-point extra-force quad))
        (.lvf position (&-> spring-point local-pos quad))
        (.add.vf.xyz force force gravity)
        (.sub.vf previous-delta previous-position position)
        (.mul.vf.xyz previous-length-squared-v previous-delta previous-delta)
        (.add.y.vf.x previous-length-squared-v previous-length-squared-v previous-length-squared-v)
        (.add.z.vf.x previous-length-squared-v previous-length-squared-v previous-length-squared-v)
        (.mov previous-length-squared previous-length-squared-v)
        (let ((previous-extension (- previous-length-squared (-> this tuning desired-spring-len))))
          (when (< 0.0 previous-extension)
            (.div.vf Q vf0 previous-length-squared-v :fsf #b11 :ftf #b0)
            (.wait.vf)
            (.mul.vf previous-delta previous-delta Q)
            (let ((previous-tension (* previous-extension (-> this tuning spring-coefficient)))) (.mov tension previous-tension))
            (.mul.x.vf.xyz tension previous-delta tension)
            (.add.vf.xyz force force tension)
            0))
        (let ((next-spring-point (&+ spring-point 48)))
          (.lvf next-position (&-> next-spring-point local-pos quad))
          (.sub.vf next-delta next-position position)
          (.mul.vf.xyz next-length-squared-v next-delta next-delta)
          (.add.y.vf.x next-length-squared-v next-length-squared-v next-length-squared-v)
          (.add.z.vf.x next-length-squared-v next-length-squared-v next-length-squared-v)
          (.mov next-length-squared next-length-squared-v)
          (let ((next-extension (- next-length-squared (-> this tuning desired-spring-len))))
            (when (< 0.0 next-extension)
              (.div.vf Q vf0 next-length-squared-v :fsf #b11 :ftf #b0)
              (.wait.vf)
              (.mul.vf next-delta next-delta Q)
              (let ((next-tension (* next-extension (-> this tuning spring-coefficient)))) (.mov tension next-tension))
              (.mul.x.vf.xyz tension next-delta tension)
              (.add.vf.xyz force force tension)
              0))
          (.mul.vf.xyz acceleration force inverse-mass)
          (.lvf velocity (&-> spring-point vel quad))
          (.add.vf.xyz velocity velocity acceleration)
          (.mul.vf.xyz velocity velocity friction)
          (.svf (&-> spring-point vel quad) velocity)
          (set! spring-point next-spring-point)))
      (.mov.vf previous-position position)
      (.mov.vf position next-position)
      (+! force-point-count -1)
      (b! (> force-point-count 0) integrate-force :delay (nop!)))
    ;; Advance the interior positions. Keeping this as a second pass makes both neighboring force
    ;; calculations use positions from the same simulation step.
    (let ((delta-time-scalar (seconds-per-frame))) (.mov delta-time delta-time-scalar))
    (.add.x.vf.y delta-time vf0 delta-time)
    (.add.x.vf.z delta-time vf0 delta-time)
    0
    (let ((position-point-count (+ (-> this tuning num-spring-points) -2)))
      (let ((position-cursor (the-as object (&-> this stack 320))))
        (label integrate-position)
        (.lvf velocity (&-> (the-as (inline-array vector) position-cursor) 1 quad))
        (.lvf position (&-> (the-as (inline-array vector) position-cursor) 0 quad))
        (.mul.vf.xyz velocity velocity delta-time)
        (.add.vf.xyz position position velocity)
        (.svf (&-> (the-as (inline-array vector) position-cursor) 0 quad) position)
        (set! position-cursor (-> (the-as (inline-array vector) position-cursor) 3)))
      (+! position-point-count -1)
      (b! (> position-point-count 0) integrate-position :delay (nop!)))
    0
    (none)))

(defmethod debug-draw ((this ropebridge))
  "Draw every spring point as a translucent white sphere after transforming it to world space."
  (let ((bridge-transform (-> this node-list data 0 bone transform))
        (spring-point (the-as ropebridge-spring-point (-> this spring-point)))
        (world-position (new 'stack-no-clear 'vector)))
    (countdown (i (-> this tuning num-spring-points))
      (vector-matrix*! world-position (-> spring-point local-pos) bridge-transform)
      (add-debug-sphere #t (bucket-id debug) world-position 2048.0 (new 'static 'rgba :r #xff :g #xff :b #xff :a #x40))
      (&+! spring-point 48)))
  (none))

(defmethod set-to-rest-state ((this ropebridge))
  "Initialize spring positions and velocities from the variant's packed rest-state table. Each
   table vector supplies local Y/Z and velocity Y/Z for the next point after the fixed zero
   endpoint. Without a table, initialize a straight chain with 8192-unit point spacing."
  (local-vars (i int))
  (rlet ((vf0 :class vf)
         (vf1 :class vf)
         (vf2 :class vf))
    (init-vf0-vector)
    (let ((rest-state (the-as structure (-> this tuning rest-state))))
      (cond
        ((the-as symbol rest-state)
         (let ((spring-point (the-as ropebridge-spring-point (-> this spring-point)))
               (packed-rest-point (the-as vector (-> (the-as vector rest-state) x))))
           (.svf (&-> spring-point local-pos quad) vf0)
           (.svf (&-> spring-point vel quad) vf0)
           (set! i (+ (-> this tuning num-spring-points) -1))
           (while (nonzero? i)
             (+! i -1)
             (&+! spring-point 48)
             (.svf (&-> spring-point local-pos quad) vf0)
             (.svf (&-> spring-point vel quad) vf0)
             (set! (-> spring-point local-pos y) (-> packed-rest-point x))
             (set! (-> spring-point local-pos z) (-> packed-rest-point y))
             (set! (-> spring-point vel y) (-> packed-rest-point z))
             (set! (-> spring-point vel z) (-> packed-rest-point w))
             (&+! packed-rest-point 16))))
        (else
         (let ((point-spacing 8192.0))
           (.mov.vf vf1 vf0)
           (let ((straight-point (the-as ropebridge-spring-point (-> this spring-point))))
             (.mov vf2 point-spacing)
             (.add.x.vf vf2 vf0 vf2)
             (.mov.vf.xyw vf2 vf0)
             (set! i (-> this tuning num-spring-points))
             (while (nonzero? i)
               (+! i -1)
               (.svf (&-> straight-point local-pos quad) vf1)
               (.svf (&-> straight-point vel quad) vf0)
               (.add.vf.xyz vf1 vf1 vf2)
               (&+! straight-point 48)))))))
    (none)))

(defun ropebridge-joint-callback ((bridge ropebridge))
  "Build one skeleton transform per bridge board from adjacent spring points, append the final
   endpoint transform, then convert every generated transform from bridge-local to world space."
  (let ((base-transform (-> bridge node-list data 3 bone transform)))
    (matrix-identity! base-transform)
    (set-vector! (-> base-transform vector 3) 0.0 0.0 (- (-> bridge tuning normal-board-len)) 1.0))
  (let* ((current-point (-> bridge spring-point))
         (next-point (the-as object current-point))
         (i 0))
    (while (< i (-> bridge tuning num-springs))
      (set! next-point (&+ (the-as ropebridge-spring-point next-point) 48))
      (let ((board-direction (new 'stack-no-clear 'vector)))
        (vector-! board-direction (-> (the-as ropebridge-spring-point next-point) local-pos) (-> current-point 0 local-pos))
        (let ((board-pitch (- (atan (-> board-direction y) (-> board-direction z))))
              (board-transform (-> bridge node-list data (+ i 4) bone transform)))
          (matrix-rotate-x! board-transform board-pitch)
          (set! (-> board-transform vector 3 quad) (-> current-point 0 local-pos quad))))
      (set! current-point (the-as (inline-array ropebridge-spring-point) (the-as ropebridge-spring-point next-point)))
      (+! i 1))
    (let ((endpoint-transform (-> bridge node-list data (+ i 4) bone transform)))
      (matrix-identity! endpoint-transform)
      (set! (-> endpoint-transform vector 3 quad) (-> current-point 0 local-pos quad)))
    (set! i 0)
    (while (< i (+ (-> bridge tuning num-springs) 2))
      (let ((transform (-> bridge node-list data (+ i 3) bone transform)))
        (matrix*! transform transform (-> bridge world-matrix)))
      (+! i 1)))
  0
  (none))

(defmethod add-collision-meshes ((this ropebridge))
  "Create the bridge collision group and one sticky indestructible mesh per board. Select each
   board's mesh from col-mesh-indexes, attach it to skeleton transform index + 4, and use the
   middle board transform for the root bound."
  (let* ((collision (-> this root))
         (tuning (-> this tuning))
         (primitive-group (new 'process 'collide-shape-prim-group collision (the-as uint (-> tuning num-springs)) 0)))
    (set! (-> primitive-group prim-core collide-as) (collide-kind ground-object))
    (set! (-> primitive-group collide-with) (collide-kind target))
    (set-vector! (-> primitive-group local-sphere) 0.0 0.0 0.0 (-> tuning root-prim-radius))
    (set! (-> primitive-group transform-index) (+ (/ (-> tuning num-springs) 2) 4))
    (set! (-> primitive-group prim-core action) (collide-action solid rider-plat-sticky))
    (set-root-prim! collision primitive-group)
    (let ((mesh-indexes (-> this tuning col-mesh-indexes)))
      (dotimes (i (-> this tuning num-springs))
        (let* ((mesh-index (-> mesh-indexes i))
               (board-mesh (new 'process 'collide-shape-prim-mesh collision mesh-index (the-as uint i))))
          (set! (-> board-mesh prim-core action) (collide-action solid rider-plat-sticky))
          (set! (-> board-mesh prim-core collide-as) (collide-kind ground-object))
          (set! (-> board-mesh collide-with) (collide-kind target))
          (set! (-> board-mesh prim-core offense) (collide-offense indestructible))
          (set-vector! (-> board-mesh local-sphere) 0.0 6144.0 4096.0 18022.4)
          (set! (-> board-mesh transform-index) (+ i 4))
          (append-prim primitive-group board-mesh)))))
  (none))

(defmethod run-logic? ((this ropebridge))
  "Keep updating while actor pause is disabled, for five seconds after the bridge was last
   agitated, while the camera is within sleep-dist, while a skeleton blend is active, or while
   the drawable explicitly requests skeleton updates."
  (or (not (logtest? (-> this mask) (process-mask actor-pause)))
      (not (time-elapsed? (-> this agitated-time-stamp) (seconds 5)))
      (or (>= (-> this sleep-dist) (vector-vector-distance (-> this root trans) (math-camera-pos)))
          (and (nonzero? (-> this skel)) (!= (-> this skel root-channel 0) (-> this skel channel)))
          (and (nonzero? (-> this draw)) (logtest? (-> this draw status) (draw-status no-skeleton-update))))))

(defmethod ropebridge-stub-28 ((this ropebridge))
  "Reserved ropebridge method slot; the base implementation does nothing."
  0
  (none))

(defmethod init-from-entity! ((this ropebridge) (source-entity entity-actor))
  "Select the bridge art and matching tuning from art-name, create collision and skeleton
   state, initialize the fixed-size spring array, build local/world transforms, and enter idle.
   The supported variants use at most 35 springs and 36 spring points; print an error if a
   tuning exceeds those inline capacities."
  (let ((art-name (res-lump-struct (-> this entity) 'art-name structure)))
    (if (not art-name) (set! art-name "ropebridge-32"))
    (if (= (-> (the-as symbol art-name) type) symbol) (set! art-name (symbol->string (the-as symbol art-name))))
    (set! (-> this subtype-name) (the-as string art-name))
    (set! (-> this subtype)
          (the-as uint
                  (cond
                    ((string= (the-as string art-name) "ropebridge-32") 0)
                    ((string= (the-as string art-name) "ropebridge-36") 1)
                    ((string= (the-as string art-name) "ropebridge-52") 2)
                    ((string= (the-as string art-name) "ropebridge-70") 3)
                    ((string= (the-as string art-name) "snow-bridge-36") 4)
                    ((string= (the-as string art-name) "vil3-bridge-36") 5)
                    (else 0)))))
  (set! (-> this tuning) (-> *ropebridge-tunings* (the-as int (-> this subtype))))
  (set-time! (-> this agitated-time-stamp))
  (set-time! (-> this bonk-time-stamp))
  (set-time! (-> this attack-flop-time-stamp))
  (set-vector! (-> this extra-trans) 0.0 0.0 (- (/ (-> this tuning bridge-end-to-end-len) 2)) 1.0)
  (set! (-> this do-physics?) #t)
  (let ((collision (new 'process 'collide-shape this (collide-list-enum hit-by-player))))
    (set! (-> this root) collision)
    (alloc-riders collision 3))
  (add-collision-meshes this)
  (process-drawable-from-entity! this source-entity)
  (initialize-skeleton-by-name this (-> this subtype-name) '())
  (logior! (-> this skel status) (janim-status inited))
  (let ((tuning (-> this tuning)))
    (set! (-> this draw bounds w) (-> tuning view-frustum-radius))
    (set! (-> this sleep-dist) (+ 40960.0 (/ (-> tuning bridge-end-to-end-len) 2)))
    (if (or (< 35 (-> tuning num-springs)) (< 36 (-> tuning num-spring-points)))
      (format 0 "ERROR: ##########~%Exceeded max # of springs in ropebridge!  Stomping memory!~%##########~%")))
  (set! (-> this skel postbind-function) ropebridge-joint-callback)
  (matrix<-transformq+trans! (-> this world-matrix) (the-as transformq (-> this root trans)) (-> this extra-trans))
  (matrix-4x4-inverse! (-> this inv-world-matrix) (-> this world-matrix))
  (set-to-rest-state this)
  (go ropebridge-idle)
  (none))

;;-*-Lisp-*-
(in-package goal)
(bundles "GAME.CGO")
(require "engine/common-obs/nav-enemy.gc")

;; DECOMP BEGINS

(deftype babak (nav-enemy) ()
  (:states
   babak-run-to-cannon))

(defskelgroup *babak-sg*
  babak
  babak-lod0-jg
  -1
  ((babak-lod0-mg (meters 20)) (babak-lod1-mg (meters 40)) (babak-lod2-mg (meters 999999)))
  :bounds (static-spherem 0 2 0 3)
  :longest-edge (meters 1)
  :shadow babak-shadow-mg)

;; Resume walking from frame 12 after the give-up hop so the two animations join cleanly.
(defstate nav-enemy-patrol (babak)
  :virtual #t
  :code
    (behavior ()
      (cond
        ((ja-group? babak-give-up-hop-ja)
         (ja-channel-push! 1 (seconds 0.15))
         (ja-play :group! babak-walk-ja :num! (seek!) :frame-num (ja-aframe 12.0 0)))
        (else (ja-channel-push! 1 (seconds 0.2))))
      ((the-as (function none) (-> (method-of-type nav-enemy nav-enemy-patrol) code)))))

(defstate nav-enemy-chase (babak)
  :virtual #t
  :code
    (behavior ()
      ;; Blend the landing pose into a fresh run cycle; otherwise start the run directly.
      (let ((animation-speed (nav-enemy-rnd-float-range 0.9 1.1)))
        (cond
          ((ja-group? babak-jump-land-ja)
           (ja-no-eval :num! (seek!))
           (ja-channel-push! 1 (seconds 0.17))
           (ja-play :group!
                    (-> self draw art-group data (-> self nav-info run-anim))
                    :num! (seek! max animation-speed)
                    :frame-num 0.0
                    (ja-blend-eval)))
          (else
           (ja-channel-push! 1 (seconds 0.2))
           (ja :group! (-> self draw art-group data (-> self nav-info run-anim)))
           (ja :num-func num-func-identity :frame-num 0.0)))
        (loop
          (suspend)
          (ja :num! (loop! animation-speed))))))

;; Face the player, idle, and celebrate after a landed attack or occasional vulnerable opening.
(defstate nav-enemy-stare (babak)
  :virtual #t
  :code
    (behavior ()
      (set! (-> self turn-time) (seconds 0.2))
      (let ((animation-speed (nav-enemy-rnd-float-range 0.8 1.2)))
        (when (or (logtest? (-> self nav-enemy-flags) (nav-enemy-flags attack-landed))
                  (and (nav-enemy-player-vulnerable?) (nav-enemy-rnd-percent? 0.5)))
          (ja-channel-push! 1 (seconds 0.1))
          (ja-play :group! babak-win-ja :num! (seek! (ja-aframe 68.0 0) animation-speed) :frame-num 0.0))
        (loop
          (when (not (nav-enemy-facing-player? 2730.6667))
            (logior! (-> self nav-enemy-flags) (nav-enemy-flags enable-travel))
            (ja-no-eval :num! (loop!))
            (ja-channel-push! 1 (seconds 0.2))
            (ja :group! babak-turn-ja)
            (ja :num-func num-func-identity :frame-num 0.0)
            (until (nav-enemy-facing-player? 1820.4445)
              (ja-blend-eval)
              (suspend)
              (ja :num! (loop! 0.75)))
            (logclear! (-> self nav-enemy-flags) (nav-enemy-flags enable-travel)))
          (if (not (ja-group? babak-idle-ja)) (ja-channel-push! 1 (seconds 0.2)))
          (ja-play :group! babak-idle-ja :num! (seek! max animation-speed) :frame-num 0.0)
          (when (nav-enemy-rnd-percent? 0.3)
            (ja-channel-push! 1 (seconds 0.1))
            (ja-play :group! babak-win-ja :num! (seek! (ja-aframe 68.0 0) animation-speed) :frame-num 0.0))))))

(defstate nav-enemy-give-up (babak)
  :virtual #t
  :code
    (behavior ()
      (set! (-> self rotate-speed) 218453.33)
      (set! (-> self turn-time) (seconds 0.5))
      (ja-channel-push! 1 (seconds 0.15))
      ;; Only play the give-up gesture when the player is within 70 degrees of Babak's facing.
      (let ((collision (-> self collide-info))
            (player-position (target-pos 0)))
        (if (< (fabs (deg-diff (y-angle collision)
                               (vector-y-angle (vector-! (new 'stack-no-clear 'vector) player-position (-> collision trans)))))
               12743.111)
          (ja-play :group! babak-give-up-ja :num! (seek!) :frame-num 0.0)))
      (logclear! (-> self nav flags) (nav-control-flags blocked reached-destination))
      (nav-enemy-get-new-patrol-point)
      (ja-play :group!
               babak-give-up-hop-ja
               :num! (seek!)
               :frame-num 0.0
               (seek-to-point-toward-point! (-> self collide-info)
                                            (-> self nav destination-pos)
                                            (-> self rotate-speed)
                                            (-> self turn-time)))
      (go-virtual nav-enemy-patrol)))

;; Blend the first 32 landing frames at half speed, then hand control back to the chase.
(defstate nav-enemy-jump-land (babak)
  :virtual #t
  :code
    (behavior ()
      (ja-no-eval :num! (seek!))
      (ja-channel-push! 1 (seconds 0.075))
      (ja-play :group!
               (-> self draw art-group data (-> self nav-info jump-land-anim))
               :num!
               (seek! (ja-aframe 32.0 0) 0.5)
               :frame-num 0.0
               (ja-blend-eval))
      (go-virtual nav-enemy-chase)))

(define *babak-nav-enemy-info*
  (new 'static
       'nav-enemy-info
       :idle-anim 5
       :walk-anim 6
       :turn-anim 16
       :notice-anim 7
       :run-anim 8
       :jump-anim 13
       :jump-land-anim 14
       :victory-anim 11
       :taunt-anim 11
       :die-anim 12
       :neck-joint 5
       :player-look-at-joint 5
       :run-travel-speed (meters 6)
       :run-rotate-speed (degrees 2880)
       :run-acceleration (meters 1)
       :run-turn-time (seconds 0.1)
       :walk-travel-speed (meters 3)
       :walk-rotate-speed (degrees 720)
       :walk-acceleration (meters 1)
       :walk-turn-time (seconds 0.5)
       :attack-shove-back (meters 3)
       :attack-shove-up (meters 2)
       :shadow-size (meters 2)
       :notice-nav-radius (meters 2)
       :nav-nearest-y-threshold (meters 10)
       :notice-distance (meters 30)
       :proximity-notice-distance (meters 20)
       :stop-chase-distance (meters 40)
       :frustration-distance (meters 8)
       :frustration-time (seconds 4)
       :die-anim-hold-frame 24.0
       :jump-anim-start-frame 10.0
       :jump-land-anim-end-frame 10000000000.0
       :jump-height-min (meters 3)
       :jump-height-factor 0.5
       :jump-start-anim-speed 1.0
       :shadow-max-y (meters 1)
       :shadow-min-y (meters -1)
       :shadow-locus-dist (meters 150)
       :use-align #t
       :draw-shadow #t
       :move-to-ground #t
       :hover-if-no-ground #f
       :use-momentum #f
       :use-flee #t
       :use-proximity-notice #t
       :use-jump-blocked #t
       :use-jump-patrol #f
       :gnd-collide-with (collide-kind background)
       :debug-draw-neck #f
       :debug-draw-jump #f))

(defmethod initialize-collision ((this babak))
  "Create Babak's moving collision shape: a three-metre root bound, lower and upper 0.75-metre
   touch spheres, and a 0.5-metre normal-attack sphere attached to skeleton transform 6. Set a
   1.5-metre navigation radius and allow at most two collision iterations."
  (let ((collision (new 'process 'collide-shape-moving this (collide-list-enum usually-hit-by-player))))
    (set! (-> collision dynam) (copy *standard-dynamics* 'process))
    (set! (-> collision reaction) default-collision-reaction)
    (set! (-> collision no-reaction)
          (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (let ((primitive-group (new 'process 'collide-shape-prim-group collision (the-as uint 3) 0)))
      (set! (-> primitive-group prim-core collide-as) (collide-kind enemy))
      (set! (-> primitive-group collide-with) (collide-kind target))
      (set! (-> primitive-group prim-core action) (collide-action solid))
      (set-vector! (-> primitive-group local-sphere) 0.0 8192.0 0.0 12288.0)
      (set-root-prim! collision primitive-group)
      (let ((lower-touch-sphere (new 'process 'collide-shape-prim-sphere collision (the-as uint 3))))
        (set! (-> lower-touch-sphere prim-core collide-as) (collide-kind enemy))
        (set! (-> lower-touch-sphere collide-with) (collide-kind target))
        (set! (-> lower-touch-sphere prim-core action) (collide-action solid))
        (set! (-> lower-touch-sphere prim-core offense) (collide-offense touch))
        (set-vector! (-> lower-touch-sphere local-sphere) 0.0 4096.0 0.0 3072.0)
        (append-prim primitive-group lower-touch-sphere))
      (let ((upper-touch-sphere (new 'process 'collide-shape-prim-sphere collision (the-as uint 3))))
        (set! (-> upper-touch-sphere prim-core collide-as) (collide-kind enemy))
        (set! (-> upper-touch-sphere collide-with) (collide-kind target))
        (set! (-> upper-touch-sphere prim-core action) (collide-action solid))
        (set! (-> upper-touch-sphere prim-core offense) (collide-offense touch))
        (set-vector! (-> upper-touch-sphere local-sphere) 0.0 9830.4 0.0 3072.0)
        (append-prim primitive-group upper-touch-sphere))
      (let ((attack-sphere (new 'process 'collide-shape-prim-sphere collision (the-as uint 1))))
        (set! (-> attack-sphere prim-core collide-as) (collide-kind enemy))
        (set! (-> attack-sphere collide-with) (collide-kind target))
        (set! (-> attack-sphere prim-core offense) (collide-offense normal-attack))
        (set! (-> attack-sphere transform-index) 6)
        (set-vector! (-> attack-sphere local-sphere) 0.0 0.0 0.0 2048.0)
        (append-prim primitive-group attack-sphere)))
    (set! (-> collision nav-radius) 6144.0)
    (backup-collide-with-as collision)
    (set! (-> collision max-iteration-count) (the-as uint 2))
    (set! (-> this collide-info) collision))
  0
  (none))

(defmethod post-init-setup! ((this babak))
  "Initialize the Babak skeleton and navigation defaults, then configure neck modifier axes
   0, 1, and 2 as up, nose, and ear."
  (initialize-skeleton this *babak-sg* '())
  (init-defaults! this *babak-nav-enemy-info*)
  (set! (-> this neck up) (the-as uint 0))
  (set! (-> this neck nose) (the-as uint 1))
  (set! (-> this neck ear) (the-as uint 2))
  0
  (none))

(defmethod go-initial-state! ((this babak))
  "Enter fuel-cell behavior when a placed Babak carrying a power cell is already complete;
   otherwise honor start-wait-for-cue, or enter the ordinary idle state."
  (cond
    ((and (and (-> this entity) (logtest? (-> this entity extra perm status) (entity-perm-status complete)))
          (logtest? (-> this enemy-info options) (fact-options has-power-cell)))
     (go (method-of-object this nav-enemy-fuel-cell)))
    ((logtest? (-> this enemy-info options) (fact-options start-wait-for-cue))
     (go (method-of-object this nav-enemy-wait-for-cue)))
    (else (go (method-of-object this nav-enemy-idle))))
  0
  (none))

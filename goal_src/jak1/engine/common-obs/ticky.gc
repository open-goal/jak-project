;;-*-Lisp-*-
(in-package goal)
(bundles "GAME.CGO")
(require "engine/sound/gsound.gc")

;; DECOMP BEGINS

(deftype ticky (structure)
  ((delay-til-ramp    time-frame)
   (delay-til-timeout time-frame)
   (starting-time     time-frame)
   (last-tick-time    time-frame))
  (:methods
   (sleep (_type_ time-frame) none)
   (reached-delay? (_type_ time-frame) symbol)
   (completed? (_type_) symbol)))

(defmethod sleep ((this ticky) (duration time-frame))
  "Start a countdown lasting duration. Begin the accelerating stopwatch ticks during its final
   four seconds, or immediately when duration is shorter."
  (set-time! (-> this starting-time))
  (set! (-> this delay-til-timeout) duration)
  (set! (-> this delay-til-ramp) (max 0 (+ duration (seconds -4))))
  (set! (-> this last-tick-time) 0)
  0
  (none))

(defmethod completed? ((this ticky))
  "Return true once the countdown duration has elapsed. Before completion, play the stopwatch
   sound at intervals that shrink linearly from 105 ticks to 41 ticks over the final four
   seconds."
  (let ((complete? #f))
    (let ((elapsed (- (current-time) (-> this starting-time))))
      (cond
        ((>= elapsed (-> this delay-til-timeout)) (set! complete? #t))
        (else
         (let* ((ramp-progress (fmin 1.0
                                     (/ (the float (max 0 (- elapsed (-> this delay-til-ramp))))
                                        (the float (- (-> this delay-til-timeout) (-> this delay-til-ramp))))))
                (tick-interval (the int (lerp 105.0 41.0 ramp-progress))))
           (when (time-elapsed? (-> this last-tick-time) tick-interval)
             (set-time! (-> this last-tick-time))
             (sound-play "stopwatch"))))))
    complete?))

(defmethod reached-delay? ((this ticky) (delay time-frame))
  "Return true once delay has elapsed since the countdown started."
  (time-elapsed? (-> this starting-time) delay))

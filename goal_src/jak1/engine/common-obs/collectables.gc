(defmethod animate ((this eco-pill))
  "Spawn the idle pill particles at the collision sphere and update the optional ambient
   sound."
  (let ((particles (-> this part))
        (root-prim (-> this root root-prim prim-core)))
    (spawn particles (-> root-prim world-sphere)))
  (if (nonzero? (-> this sound)) (update! (-> this sound)))
  0
  (none))

(defmethod init-from-entity! ((this eco-pill) (source-entity entity-actor))

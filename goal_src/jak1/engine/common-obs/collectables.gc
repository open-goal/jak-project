(defmethod deactivate ((this eco-pill))
  "Remove this pill from the live-pill count, then perform ordinary eco-collectable
   deactivation."
  (set! *eco-pill-count* (+ *eco-pill-count* -1))
  ((method-of-type eco-collectable deactivate) this)
  (none))

(defmethod initialize ((this eco-pill))
  "Count this live pill, allocate its enlarged blue-eco collision sphere and fact information,
   and prepare it for shared eco initialization."
  (set! *eco-pill-count* (+ *eco-pill-count* 1))
  (stack-size-set! (-> this main-thread) 192) ;; og:preserve-this hack increased from 128
  (logior! (-> this mask) (process-mask actor-pause))
  (set! (-> this actor-pause) #t)
  (set! (-> this notify-parent) #f)
  (let ((collision-shape (new 'process 'collide-shape-moving this (collide-list-enum hit-by-player))))
    (set! (-> collision-shape dynam) (copy *standard-dynamics* 'process))
    (set! (-> collision-shape reaction) default-collision-reaction)
    (set! (-> collision-shape no-reaction)
          (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (let ((collision-sphere (new 'process 'collide-shape-prim-sphere collision-shape (the-as uint 0))))
      (set! (-> collision-sphere prim-core collide-as) (collide-kind powerup blue-eco-suck))
      (set! (-> collision-sphere collide-with) (collide-kind target))
      (set-vector! (-> collision-sphere local-sphere) 0.0 3276.8 0.0 8192.0)
      (set-root-prim! collision-shape collision-sphere))
    (set! (-> collision-shape nav-radius) (* 0.75 (-> collision-shape root-prim local-sphere w)))
    (backup-collide-with-as collision-shape)
    (set! (-> this root) collision-shape))
  (set! (-> this fact) (new 'process 'fact-info this (-> this pickup-type) (-> this pickup-amount)))
  this)

(defskelgroup *money-sg*
  money
  money-lod0-jg
  money-idle-ja
  ((money-lod0-mg (meters 20)) (money-lod1-mg (meters 40)) (money-lod2-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 0.6)
  :texture-level 2)

(defskelgroup *fuel-cell-sg*
  fuel-cell
  fuel-cell-lod0-jg
  fuel-cell-idle-ja
  ((fuel-cell-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 1 0 1.6)
  :texture-level 2)

(deftype money (eco-collectable) ())

(defmethod run-logic? ((this money))
  "Keep updating money while unpaused, nearby and recently drawn, changing skeleton channels,
   or explicitly requesting skeleton updates."
  (or (not (logtest? (-> this mask) (process-mask actor-pause)))
      (or (and (nonzero? (-> this draw))
               (logtest? (-> this draw status) (draw-status was-drawn))
               (>= (+ (-> *ACTOR-bank* pause-dist) (-> this root pause-adjust-distance))
                   (vector-vector-distance (-> this root trans) (math-camera-pos))))
          (and (nonzero? (-> this skel)) (!= (-> this skel root-channel 0) (-> this skel channel)))
          (and (nonzero? (-> this draw)) (logtest? (-> this draw status) (draw-status no-skeleton-update))))))

(defmethod deactivate ((this money))
  "Mark money killed during pickup as dead before performing ordinary eco-collectable
   deactivation."
  (when (= (-> this next-state name) 'pickup)
    (if (not (and (-> this entity) (logtest? (-> this entity extra perm status) (entity-perm-status dead))))
      (format #t "money ~A was killed in pickup~%"))
    (process-entity-status! this (entity-perm-status dead) #t))
  ((method-of-type eco-collectable deactivate) this)
  (none))

(defstate wait (money)
  :virtual #t
  :code
    (behavior ()
      (loop
        (quaternion-rotate-y! (-> self root quat) (-> self root quat) (* 40049.777 (seconds-per-frame)))
        (let ((bob-amount (-> self bob-amount)))
          (when (< 0.0 bob-amount)
            (set! (-> self root trans y)
                  (+ (-> self base y)
                     (-> self suck-y-offset)
                     (* bob-amount
                        (sin (* 109.22667 (the float (mod (+ (- (current-time) (-> self birth-time)) (-> self bob-offset)) 600)))))))
            (update-transforms! (-> self root))))
        (ja-post)
        ;; og:preserve-this added particle!
        (with-pc
          (if (-> *pc-settings* money-starburst?) (spawn (-> self part) (-> self root root-prim world-sphere))))
        (suspend))))

(defstate notice-blue (money)
  :virtual #t
  :code
    (behavior ((target-handle handle))
      (loop
        (quaternion-rotate-y! (-> self root quat) (-> self root quat) (* 91022.22 (seconds-per-frame)))
        (vector-copy! (-> self root trans) (-> self base))
        (add-blue-motion #t #t #t #f)
        (let ((bob-amount (-> self bob-amount)))
          (if (< 0.0 bob-amount)
            (set! (-> self root trans y)
                  (+ (-> self base y)
                     (-> self suck-y-offset)
                     (* bob-amount
                        (sin (* 109.22667 (the float (mod (+ (- (current-time) (-> self birth-time)) (-> self bob-offset)) 600)))))))))
        (transform-post)
        ;; og:preserve-this added particle!
        (with-pc
          (if (-> *pc-settings* money-starburst?) (spawn (-> self part) (-> self root root-prim world-sphere))))
        (suspend))))

(defstate pickup (money)
  :virtual #t
  :code
    (behavior ((pickup-mode object) (collector-handle handle))
      ;; og:preserve-this added
      (if (nonzero? (-> self part)) (kill-and-free-particles (-> self part)))
      (logclear! (-> self mask) (process-mask actor-pause))
      (clear-collide-with-as (-> self root))
      (process-entity-status! self (entity-perm-status dead) #t)
      (convert-to-hud-object self (the-as hud (ppointer->process (-> *hud-parts* money))))))

(defmethod initialize ((this money))
  "Allocate the money collision shape, skeleton, fact information, and optional PC starburst
   particles; connect entity-backed money to the navigation mesh."
  (stack-size-set! (-> this main-thread) 192) ;; og:preserve-this hack increased from 128
  (let ((collision-shape (new 'process 'collide-shape-moving this (collide-list-enum hit-by-player))))
    (set! (-> collision-shape dynam) (copy *standard-dynamics* 'process))
    (set! (-> collision-shape reaction) default-collision-reaction)
    (set! (-> collision-shape no-reaction)
          (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (let ((collision-sphere (new 'process 'collide-shape-prim-sphere collision-shape (the-as uint 0))))
      (set! (-> collision-sphere prim-core collide-as) (collide-kind powerup blue-eco-suck))
      (set! (-> collision-sphere collide-with) (collide-kind target))
      (set-vector! (-> collision-sphere local-sphere) 0.0 2048.0 0.0 4915.2)
      (set-root-prim! collision-shape collision-sphere))
    (set! (-> collision-shape nav-radius) (* 0.75 (-> collision-shape root-prim local-sphere w)))
    (backup-collide-with-as collision-shape)
    (set! (-> this root) collision-shape))
  (logior! (-> this mask) (process-mask actor-pause))
  (set! (-> this actor-pause) #t)
  (set! (-> this notify-parent) #f)
  (set! (-> this fact) (new 'process 'fact-info this (pickup-type money) (the-as float 1.0)))
  (let ((entity-record (-> this entity)))
    (if (when entity-record
          (let ((task-id (-> entity-record extra perm task))) (if task-id (= task-id (game-task none)))))
      (set! (-> this entity extra perm task) (game-task complete))))
  (initialize-skeleton this *money-sg* '())
  (if (-> this entity) (nav-mesh-connect this (-> this root) (the-as nav-control #f)))
  (set-vector! (-> this draw color-mult) 0.8 0.8 0.8 1.0)
  (set-vector! (-> this draw color-emissive) 0.2 0.2 0.2 1.0)
  ;; og:preserve-this added money starburst
  (set! (-> this part) (create-launch-control group-money-starburst this))
  this)

(defmethod init-from-entity! ((this money) (source-entity entity-actor))
  "Initialize entity-backed money at its authored transform and enter the wait state."
  (initialize this)
  (process-drawable-from-entity! this (-> this entity))
  (initialize-params this 0 (the-as float 1024.0))
  (update-transforms! (-> this root))
  (go (method-of-object this wait))
  (none))

(defbehavior money-init-by-other money ((position vector) (velocity vector) (pickup-info fact-info) (source-entity entity-actor))
  "Initialize pooled money at position with velocity and values copied from pickup-info. Preserve
   its source entity and options, enable parent notification, and enter wait with normal bobbing."
  (let ((kind (-> pickup-info pickup-type))
        (amount (-> pickup-info pickup-spawn-amount)))
    (set! (-> self entity) source-entity)
    (set! (-> self pickup-type) kind)
    (set! (-> self pickup-amount) amount)
    (initialize self)
    (set! (-> self fact pickup-type) kind)
    (set! (-> self fact pickup-amount) amount))
  (set! (-> self fact options) (-> pickup-info options))
  (set! (-> self notify-parent) #t)
  (vector-copy! (-> self root trans) position)
  (quaternion-identity! (-> self root quat))
  (vector-identity! (-> self root scale))
  (vector-copy! (-> self root transv) velocity)
  (initialize-params self (seconds 15) (the-as float 1024.0))
  (update-transforms! (-> self root))
  (set! (-> self event-hook) (-> (method-of-object self wait) event))
  (go-virtual wait)
  (none))

(defbehavior money-init-by-other-no-bob money ((position vector) (velocity vector) (kind pickup-type) (amount float) (source-entity entity-actor))
  "Initialize pooled money at position with velocity, explicit kind and amount, and source entity.
   Disable bobbing and blue-eco attraction, enable parent notification, and enter wait."
  (set! (-> self entity) source-entity)
  (set! (-> self pickup-type) kind)
  (set! (-> self pickup-amount) amount)
  (initialize self)
  (set! (-> self fact pickup-type) kind)
  (set! (-> self fact pickup-amount) amount)
  (set! (-> self notify-parent) #t)
  (vector-copy! (-> self root trans) position)
  (quaternion-identity! (-> self root quat))
  (vector-identity! (-> self root scale))
  (vector-copy! (-> self root transv) velocity)
  (initialize-params self (seconds 15) (the-as float 0.0))
  (logior! (-> self flags) (collectable-flags ignore-blue))
  (update-transforms! (-> self root))
  (set! (-> self event-hook) (-> (method-of-object self wait) event))
  (go-virtual wait)
  (none))

(define *fuel-cell-tune-pos* (new 'static 'vector :w 1000000000.0))

(deftype fuel-cell (eco-collectable)
  ((victory-anim spool-anim)
   (state-object symbol))
  (:states (fuel-cell-clone-anim handle)
   (fuel-cell-spline-slider handle float float)))

(defun fuel-cell-pick-anim ((pickup process-drawable))
  "Choose a fuel-cell victory animation from the pickup entity's XZ position. Skip variations
   masked by movie-mask; racer and flut target actions select their dedicated animations."
  (let* ((entity-position (-> pickup entity extra trans))
         (movie-mask (res-lump-value (-> pickup entity) 'movie-mask uint128 :time (the-as float -1000000000.0)))
         (variation-count 8)
         (coordinate-seed (abs (the int (+ (/ (-> entity-position x) METER_LENGTH) (/ (-> entity-position z) METER_LENGTH)))))
         (variation (mod coordinate-seed variation-count)))
    (while (logtest? movie-mask (ash 1 variation))
      (set! variation (mod (+ variation 1) variation-count)))
    (when *target*
      (cond
        ((logtest? (-> *target* control root-prim prim-core action) (collide-action racer)) (set! variation 16))
        ((logtest? (-> *target* control root-prim prim-core action) (collide-action flut)) (set! variation 32))))
    (cond
      ((zero? variation) (new 'static 'spool-anim :name "fuel-cell-victory" :index 3 :parts 2 :command-list '()))
      ((= variation 1) (new 'static 'spool-anim :name "fuel-cell-victory-2" :index 4 :parts 2 :command-list '()))
      ((= variation 2) (new 'static 'spool-anim :name "fuel-cell-victory-3" :index 5 :parts 2 :command-list '()))
      ((= variation 3) (new 'static 'spool-anim :name "fuel-cell-victory-4" :index 6 :parts 2 :command-list '()))
      ((= variation 4) (new 'static 'spool-anim :name "fuel-cell-victory-5" :index 7 :parts 2 :command-list '()))
      ((= variation 5) (new 'static 'spool-anim :name "fuel-cell-victory-6" :index 8 :parts 2 :command-list '()))
      ((= variation 6) (new 'static 'spool-anim :name "fuel-cell-victory-7" :index 9 :parts 2 :command-list '()))
      ((= variation 7) (new 'static 'spool-anim :name "fuel-cell-victory-8" :index 10 :parts 2 :command-list '()))
      ((= variation 16) (new 'static 'spool-anim :name "fuel-cell-racer-victory-1" :index 40 :parts 2 :command-list '()))
      ((= variation 32) (new 'static 'spool-anim :name "fuel-cell-flut-victory-1" :index 44 :parts 2 :command-list '()))
      (else (new 'static 'spool-anim :name "fuel-cell-victory-3" :index 5 :parts 2 :command-list '())))))

(defbehavior fuel-cell-animate fuel-cell ()
  "Keep the selected victory animation spooled, update visible idle particles and ambient sound at
   the collision shape, and apply the fuel cell's half diffuse, half emissive color."
  (let* ((pickup self)
         (fuel-cell-pickup (if (and (nonzero? pickup) (type-type? (-> pickup type) fuel-cell)) pickup)))
    (cond
      (fuel-cell-pickup
       (set! (-> fuel-cell-pickup victory-anim) (fuel-cell-pick-anim fuel-cell-pickup))
       (spool-push *art-control* (-> fuel-cell-pickup victory-anim name) 0 self (the-as float -99.0)))
      (else
       (let ((victory-anim (fuel-cell-pick-anim self)))
         (spool-push *art-control* (-> victory-anim name) 0 self (the-as float -99.0))))))
  (when (nonzero? (-> self part))
    (cond
      ((logtest? (-> self draw status) (draw-status hidden no-anim))
       (kill-and-free-particles (-> self part))
       (if (nonzero? (-> self sound)) (kill-and-free-particles (-> self part))))
      (else
       (let* ((pickup-root (-> self root))
              (collision-shape (if (and (nonzero? pickup-root) (type-type? (-> pickup-root type) collide-shape)) pickup-root))
              (effect-position (if collision-shape (-> collision-shape root-prim prim-core) (-> self root trans))))
         (spawn (-> self part) (the-as vector effect-position))
         (when (nonzero? (-> self sound))
           (update-trans! (-> self sound) (the-as vector effect-position))
           (update! (-> self sound)))))))
  (set-vector! (-> self draw color-mult) 0.5 0.5 0.5 1.0)
  (set-vector! (-> self draw color-emissive) 0.5 0.5 0.5 1.0)
  0
  (none))

(method-set! fuel-cell 29 fuel-cell-animate)

(defstate wait (fuel-cell)
  :virtual #t
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (local-vars (result object))
      (when (and (or (= message 'touch) (= message 'attack))
                 (and (logtest? (-> self flags) (collectable-flags can-collect))
                      (time-elapsed? (-> self birth-time) (-> self collect-timeout))
                      (and (not (handle->process (-> *game-info* other-camera-handle)))
                           (not *progress-process*)
                           (!= (-> self next-state name) 'pickup)
                           *target*
                           (not (logtest? (-> *target* state-flags) (state-flags grabbed dying))))))
        (add-setting! 'allow-progress #f 0.0 0)
        (apply-settings *setting-control*)
        (logclear! (-> self mask) (process-mask actor-pause))
        (go-virtual pickup #f (process->handle proc)))
      (cond
        ((= message 'trans)
         (vector-copy! (-> self root trans) (the-as vector (-> block param 0)))
         (vector-copy! (-> self base) (-> self root trans))
         (update-transforms! (-> self root)))
        ((= message 'pickup)
         (when (!= (-> self next-state name) 'pickup)
           (if (and (> argc 0) (-> block param 0)) (move-to-point! (-> self root) (the-as vector (-> block param 0))))
           (logclear! (-> self mask) (process-mask actor-pause))
           (go-virtual pickup #f (process->handle *target*))))
        ((= message 'collide-shape)
         (if (-> block param 0) (restore-collide-with-as (-> self root)) (clear-collide-with-as (-> self root))))
        ((= message 'movie-pos) (set! result (-> block param 0)) (set! (-> self movie-pos-index) (the-as int result)) result)
        ((= message 'anim)
         (cond
           ((-> block param 0)
            (set! result (logclear (-> self flags) (collectable-flags anim)))
            (set! (-> self flags) (the-as collectable-flags result)))
           (else
            (set! result (logior (-> self flags) (collectable-flags anim)))
            (set! (-> self flags) (the-as collectable-flags result))))
         result)))
  :code
    (behavior ()
      0.5
      (let ((bob-phase 0.0))
        (ja :group! fuel-cell-idle-ja)
        (loop
          (let ((target-distance (vector-vector-distance (-> self base) (target-pos 0))))
            (set! bob-phase
                  (if (and (< target-distance (-> *FACT-bank* suck-suck-dist)) (not (logtest? (-> self flags) (collectable-flags anim))))
                    (seek bob-phase (the-as float 16384.0) (* 3072.0 (seconds-per-frame)))
                    (seek bob-phase (the-as float 0.0) (* 3072.0 (seconds-per-frame)))))
            (set! (-> self root trans y) (+ (-> self base y) (* 2867.2 (sin bob-phase))))
            (let ((playback-speed (lerp-scale (the-as float 0.6) (the-as float 0.5) target-distance (the-as float 8192.0) (-> *FACT-bank* suck-suck-dist))))
              (transform-post)
              (fuel-cell-animate)
              (suspend)
              (ja :num! (loop! playback-speed))))))))

(defstate pickup (fuel-cell)
  :virtual #t
  :enter
    (behavior ((pickup-mode object) (collector-handle handle))
      (set-time! (-> self state-time))
      (set! (-> self state-object) #t)
      (let ((parent-enter (-> (the-as (state eco-collectable) (find-parent-state)) enter))) (if parent-enter (parent-enter))))
  :trans
    (behavior ()
      (let ((hide-frame (the-as float
                                (cond
                                  ((string= (-> self victory-anim name) "fuel-cell-victory") 97.0)
                                  ((string= (-> self victory-anim name) "fuel-cell-victory-2") 97.0)
                                  ((string= (-> self victory-anim name) "fuel-cell-victory-3") 97.0)
                                  ((string= (-> self victory-anim name) "fuel-cell-victory-4") 97.0)
                                  ((string= (-> self victory-anim name) "fuel-cell-victory-5") 77.0)
                                  ((string= (-> self victory-anim name) "fuel-cell-victory-6") 97.0)
                                  ((string= (-> self victory-anim name) "fuel-cell-victory-7") 97.0)
                                  ((string= (-> self victory-anim name) "fuel-cell-victory-8") 97.0)
                                  ((string= (-> self victory-anim name) "fuel-cell-racer-victory-1") 88.0)
                                  ((string= (-> self victory-anim name) "fuel-cell-flut-victory-1") 150.0)
                                  (else 5000.0)))))
        (when (and (logtest? (-> self skel status) (janim-status spool))
                   (and (>= (ja-aframe-num 0) hide-frame) (-> self state-object)))
          (set! (-> self state-object) #f)
          (kill-and-free-particles (-> self part))
          (logior! (-> self draw status) (draw-status skip-bones))
          (if (not (or (logtest? (res-lump-value (-> self entity) 'options fact-options :time (the-as float -1000000000.0))
                                 (fact-options powerup))
                       (and *target* (logtest? (-> *target* control root-prim prim-core action) (collide-action racer)))))
            (send-event *camera* 'teleport-to-other-start-string)))))
  :code
    (behavior ((pickup-mode object) (collector-handle handle))
      (sound-play "pu-powercell")
      (clear-collide-with-as (-> self root))
      (logclear! (-> self mask) (process-mask actor-pause))
      (logclear! (-> self draw status) (draw-status hidden))
      (process-entity-status! self (entity-perm-status dead) #t)
      (stop! (-> self sound))
      (while (handle->process (-> *game-info* other-camera-handle))
        (format #t
                "WARNING: fuel-cell stall ~D ~A ~A~%"
                (current-time)
                (handle->process (-> *game-info* other-camera-handle))
                (-> *level* loading-level))
        (spool-push *art-control* (-> self victory-anim name) 0 self (the-as float -99.0))
        (suspend))
      (while (not (send-event *target* 'clone-anim self))
        (spool-push *art-control* (-> self victory-anim name) 0 self (the-as float -99.0))
        (format #t "WARNING: fuel-cell stall on not cloning.~%")
        (suspend))
      (let* ((movie-position-tag (new 'static 'res-tag))
             (movie-positions (res-lump-data (-> self entity)
                                             'movie-pos
                                             (inline-array vector)
                                             :tag-ptr (& movie-position-tag)
                                             :time
                                             (the-as float -1000000000.0)))
             (movie-position (if (and movie-positions (< (-> self movie-pos-index) (the-as int (-> movie-position-tag elt-count))))
                               (-> movie-positions (-> self movie-pos-index))
                               (the-as vector #f))))
        (cond
          ((and *debug-segment* (< (-> *fuel-cell-tune-pos* w) 1000000000.0))
           (move-to-point! (-> self root) *fuel-cell-tune-pos*)
           (set-yaw-angle-clear-roll-pitch! (-> self root) (-> *fuel-cell-tune-pos* w)))
          ((= (-> self movie-pos-index) -1))
          (movie-position
           (move-to-point! (-> self root) movie-position)
           (set-yaw-angle-clear-roll-pitch! (-> self root) (-> movie-position w)))
          (else
           (move-to-point! (-> self root) (-> *target* control trans))
           (set-yaw-angle-clear-roll-pitch! (-> self root) (y-angle (-> *target* control)))
           (move-to-ground (-> self root) (the-as float 40960.0) (the-as float 40960.0) #f (collide-kind background)))))
      (spool-push *art-control* (-> self victory-anim name) 0 self (the-as float -99.0))
      (send-event *target* 'get-pickup (-> self fact pickup-type) (-> self fact pickup-amount))
      (set! (-> self draw bounds w) 32768.0)
      (logior! (-> self skel status) (janim-status inited))
      (send-event *target* 'blend-shape #t)
      (add-setting! 'music-volume 'rel (-> *setting-control* current music-volume-movie) 0)
      (add-setting! 'sfx-volume 'rel (-> *setting-control* current sfx-volume-movie) 0)
      (add-setting! 'ambient-volume 'rel (-> *setting-control* current ambient-volume-movie) 0)
      (process-spawn othercam self 10 #f #t :to self)
      (auto-save-command 'auto-save 0 0 *default-pool*)
      (ja-play-spooled-anim (-> self victory-anim)
                            (the-as art-joint-anim fuel-cell-idle-ja)
                            (the-as art-joint-anim #f)
                            (the-as (function process-drawable symbol) false-func))
      (remove-setting! 'music-volume)
      (remove-setting! 'sfx-volume)
      (remove-setting! 'ambient-volume)
      (send-event *target* 'blend-shape #f)
      (send-event *target* 'end-mode)
      (send-event *camera* 'no-intro)
      (send-event *camera* 'clear-entity)
      (ja-channel-set! 0)
      (suspend)
      (suspend)
      (process-spawn-function process
        (lambda :behavior collectable ((task-id game-task))
          (while (or (-> *setting-control* current ambient)
                     (-> *setting-control* current movie)
                     (-> *setting-control* current hint)
                     (str-is-playing?))
            (suspend))
          (cond
            ((= task-id (game-task training-buzzer))
             (level-hint-spawn (text-id training-buzzer-resolution) "asstvb45" (the-as entity #f) *entity-pool* (game-task none)))
            ((= task-id (game-task training-door))
             (level-hint-spawn (text-id training-eco-opened-door) "sagevb25" (the-as entity #f) *entity-pool* (game-task none)))
            ((= task-id (game-task beach-ecorocks))
             (level-hint-spawn (text-id beach-ecorocks-resolution) "sagevb01" (the-as entity #f) *entity-pool* (game-task none)))
            ((= task-id (game-task misty-cannon))
             (level-hint-spawn (text-id misty-cannon-resolution) "sagevb02" (the-as entity #f) *entity-pool* (game-task none)))
            ((= task-id (game-task misty-bike))
             (level-hint-spawn (text-id misty-bike-resolution) "asstvb03" (the-as entity #f) *entity-pool* (game-task none)))
            ((= task-id (game-task firecanyon-end))
             (level-hint-spawn (text-id firecanyon-end-resolution) "sksp0095" (the-as entity #f) *entity-pool* (game-task none)))
            ((= task-id (game-task rolling-robbers))
             (level-hint-spawn (text-id rolling-robbers-resolution) "asstvb20" (the-as entity #f) *entity-pool* (game-task none)))
            ((= task-id (game-task rolling-plants))
             (level-hint-spawn (text-id rolling-plants-resolution) "sagevb03" (the-as entity #f) *entity-pool* (game-task none)))
            ((= task-id (game-task swamp-flutflut))
             (level-hint-spawn (text-id swamp-flutflut-resolution) "asstvb21" (the-as entity #f) *entity-pool* (game-task none)))
            ((= task-id (game-task ogre-boss))
             (level-hint-spawn (text-id ogre-boss-resolution) "asstvb23" (the-as entity #f) *entity-pool* (game-task none)))
            ((= task-id (game-task ogre-end))
             (level-hint-spawn (text-id ogre-race-resolution) "asstvb25" (the-as entity #f) *entity-pool* (game-task none)))
            ((= task-id (game-task beach-buzzer))
             (level-hint-spawn (text-id sidekick-buzzer-resolution) "sksp009k" (the-as entity #f) *entity-pool* (game-task none)))
            ((= task-id (game-task jungle-buzzer))
             (level-hint-spawn (text-id sidekick-buzzer-resolution) "sksp009k" (the-as entity #f) *entity-pool* (game-task none)))
            ((= task-id (game-task misty-buzzer))
             (level-hint-spawn (text-id sidekick-buzzer-resolution) "sksp009k" (the-as entity #f) *entity-pool* (game-task none)))
            ((= task-id (game-task firecanyon-buzzer))
             (level-hint-spawn (text-id sidekick-buzzer-resolution) "sksp009k" (the-as entity #f) *entity-pool* (game-task none)))
            ((= task-id (game-task rolling-buzzer))
             (level-hint-spawn (text-id sidekick-buzzer-resolution) "sksp009k" (the-as entity #f) *entity-pool* (game-task none)))
            ((= task-id (game-task sunken-buzzer))
             (level-hint-spawn (text-id sidekick-buzzer-resolution) "sksp009k" (the-as entity #f) *entity-pool* (game-task none)))
            ((= task-id (game-task swamp-buzzer))
             (level-hint-spawn (text-id sidekick-buzzer-resolution) "sksp009k" (the-as entity #f) *entity-pool* (game-task none)))
            ((= task-id (game-task ogre-buzzer))
             (level-hint-spawn (text-id sidekick-buzzer-resolution) "sksp009k" (the-as entity #f) *entity-pool* (game-task none)))
            ((= task-id (game-task cave-buzzer))
             (level-hint-spawn (text-id sidekick-buzzer-resolution) "sksp009k" (the-as entity #f) *entity-pool* (game-task none)))
            ((= task-id (game-task snow-buzzer))
             (level-hint-spawn (text-id sidekick-buzzer-resolution) "sksp009k" (the-as entity #f) *entity-pool* (game-task none)))
            ((= task-id (game-task lavatube-buzzer))
             (level-hint-spawn (text-id sidekick-buzzer-resolution) "sksp009k" (the-as entity #f) *entity-pool* (game-task none)))
            ((= task-id (game-task citadel-buzzer))
             (level-hint-spawn (text-id sidekick-buzzer-resolution) "sksp009k" (the-as entity #f) *entity-pool* (game-task none)))
            ((= task-id (game-task village1-buzzer))
             (level-hint-spawn (text-id sidekick-buzzer-resolution) "sksp009k" (the-as entity #f) *entity-pool* (game-task none)))
            ((= task-id (game-task village2-buzzer))
             (level-hint-spawn (text-id sidekick-buzzer-resolution) "sksp009k" (the-as entity #f) *entity-pool* (game-task none)))
            ((= task-id (game-task village3-buzzer))
             (level-hint-spawn (text-id sidekick-buzzer-resolution) "sksp009k" (the-as entity #f) *entity-pool* (game-task none))))
          (none))
        (the int (-> self fact pickup-amount))
        :to
        self)
      (case (the int (-> self fact pickup-amount))
        (((game-task citadel-sage-blue)) (send-event (process-by-name "blue-sagecage-1" *active-pool*) 'play-anim))
        (((game-task citadel-sage-red)) (send-event (process-by-name "red-sagecage-1" *active-pool*) 'play-anim))
        (((game-task citadel-sage-yellow)) (send-event (process-by-name "yellow-sagecage-1" *active-pool*) 'play-anim))
        (((game-task citadel-sage-green)) (send-event (process-by-name "green-sagecage-1" *active-pool*) 'play-anim))
        (((game-task jungle-eggtop) (game-task snow-eggtop) (game-task snow-ball) (game-task sunken-slide)))
        (else (send-event (ppointer->process (-> *hud-parts* fuel-cell)) 'show)))
      (convert-to-hud-object self (the-as hud (ppointer->process (-> *hud-parts* fuel-cell)))))
  :post
    (behavior ()
      (transform-post)
      (if (-> self state-object) (spawn (-> self part) (-> self root root-prim prim-core world-sphere)))))

(defmethod initialize ((this fuel-cell))
  "Allocate the fuel-cell collision shape, skeleton, idle particles and sound, and choose its
   victory animation."
  (stack-size-set! (-> this main-thread) 512)
  (let ((collision-shape (new 'process 'collide-shape-moving this (collide-list-enum hit-by-player))))
    (set! (-> collision-shape dynam) (copy *standard-dynamics* 'process))
    (set! (-> collision-shape reaction) default-collision-reaction)
    (set! (-> collision-shape no-reaction)
          (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (let ((collision-sphere (new 'process 'collide-shape-prim-sphere collision-shape (the-as uint 0))))
      (set! (-> collision-sphere prim-core collide-as) (collide-kind powerup))
      (set! (-> collision-sphere collide-with) (collide-kind target))
      (set! (-> collision-sphere transform-index) 3)
      (set-vector! (-> collision-sphere local-sphere) 0.0 0.0 0.0 4915.2)
      (set-root-prim! collision-shape collision-sphere))
    (set! (-> collision-shape nav-radius) (* 0.75 (-> collision-shape root-prim local-sphere w)))
    (backup-collide-with-as collision-shape)
    (set! (-> this root) collision-shape))
  (logior! (-> this mask) (process-mask actor-pause))
  (set! (-> this actor-pause) #t)
  (set! (-> this notify-parent) #f)
  (set! (-> this fact) (new 'process 'fact-info this (pickup-type fuel-cell) (the-as float 0.0)))
  (initialize-skeleton this *fuel-cell-sg* '())
  (vector-copy! (-> this base) (-> this root trans))
  (vector-copy! (-> this old-base) (-> this root trans))
  (set! (-> this part) (create-launch-control group-fuel-cell-starburst this))
  (set! (-> this sound) (new 'process 'ambient-sound (static-sound-spec "powercell-idle" :fo-max 40) (-> this root trans)))
  (set! (-> this victory-anim) (fuel-cell-pick-anim this))
  this)

(defmethod init-from-entity! ((this fuel-cell) (source-entity entity-actor))
  "Initialize an entity-backed fuel cell at its authored transform, disable immediate
   collection, and enter the wait state."
  (initialize this)
  (process-drawable-from-entity! this (-> this entity))
  (initialize-params this 0 (the-as float 1024.0))
  (logclear! (-> this fact options) (fact-options can-collect))
  (update-transforms! (-> this root))
  (go (method-of-object this wait))
  (none))

(defbehavior fuel-cell-init-by-other fuel-cell ((position vector) (velocity vector) (pickup-info fact-info) (source-entity entity-actor))
  "Initialize a pooled fuel cell at position with velocity and values copied from pickup-info.
   Preserve its source entity and options, disable immediate collection, and use an authored or debug
   movie position for the optional jump before entering wait."
  (let ((kind (-> pickup-info pickup-type))
        (amount (-> pickup-info pickup-spawn-amount)))
    (set! (-> self entity) source-entity)
    (set! (-> self pickup-type) kind)
    (set! (-> self pickup-amount) amount)
    (initialize self)
    (set! (-> self fact pickup-type) kind)
    (set! (-> self fact pickup-amount) amount))
  (set! (-> self fact options) (-> pickup-info options))
  (set! (-> self notify-parent) #t)
  (vector-copy! (-> self root trans) position)
  (quaternion-identity! (-> self root quat))
  (vector-identity! (-> self root scale))
  (vector-copy! (-> self root transv) velocity)
  (initialize-params self 0 (the-as float 1024.0))
  (logclear! (-> self fact options) (fact-options can-collect))
  (update-transforms! (-> self root))
  (let ((movie-position (res-lump-struct (-> self entity) 'movie-pos structure :time (the-as float -1000000000.0))))
    (cond
      ((and *debug-segment* (< (-> *fuel-cell-tune-pos* w) 1000000000.0))
       (vector-copy! (-> self jump-pos) *fuel-cell-tune-pos*)
       (+! (-> self jump-pos y) 4096.0)
       (go-virtual jump))
      ((and movie-position
            (not (logtest? (res-lump-value (-> self entity) 'options fact-options :time (the-as float -1000000000.0))
                           (fact-options skip-jump-anim)))
            (not (logtest? (-> self fact options) (fact-options skip-jump-anim))))
       (vector-copy! (-> self jump-pos) (the-as vector movie-position))
       (+! (-> self jump-pos y) 4096.0)
       (go-virtual jump))))
  (set! (-> self event-hook) (-> (method-of-object self wait) event))
  (go-virtual wait)
  (none))

(defstate fuel-cell-clone-anim (fuel-cell)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('pickup)
         (when (!= (-> self next-state name) 'pickup)
           (if (and (> argc 0) (-> block param 0)) (move-to-point! (-> self root) (the-as vector (-> block param 0))))
           (logclear! (-> self mask) (process-mask actor-pause))
           (go-virtual pickup #f (the-as handle #f))))
        (('trans)
         (vector-copy! (-> self root trans) (the-as vector (-> block param 0)))
         (vector-copy! (-> self base) (-> self root trans))
         (update-transforms! (-> self root)))
        (('stop-cloning 'notify)
         (vector-copy! (-> self root trans) (-> self draw origin))
         (vector-copy! (-> self base) (-> self root trans))
         (ja-channel-set! 1)
         (ja :group! fuel-cell-idle-ja)
         (logclear! (-> self draw status) (draw-status hidden))
         (vector-reset! (-> self draw origin))
         (go-virtual wait))))
  :exit
    (behavior ()
      (if (-> self actor-pause) (logior! (-> self mask) (process-mask actor-pause)))
      (logclear! (-> self skel status) (janim-status spool)))
  :code
    (behavior ((source-handle handle))
      (logclear! (-> self mask) (process-mask actor-pause))
      (clone-anim source-handle 3 #t "")
      (format #t "ERROR<GMJ>: clone-anim returned in fuel-cell~%")
      (deactivate self))
  :post
    (behavior ()
      (update-transforms! (-> self root))
      (animate self)))

(defbehavior fuel-cell-init-as-clone fuel-cell ((source-handle handle) (amount int))
  "Initialize a fuel cell cloned from source-handle, set its pickup amount, disable pause handling,
   play the prize sound, and enter fuel-cell-clone-anim."
  (initialize self)
  (set! (-> self fact pickup-type) (pickup-type fuel-cell))
  (set! (-> self fact pickup-amount) (the float amount))
  (initialize-params self 0 (the-as float 1024.0))
  (logclear! (-> self mask) (process-mask actor-pause))
  (set! (-> self actor-pause) #f)
  (sound-play "cell-prize")
  (go fuel-cell-clone-anim source-handle)
  (none))

(defskelgroup *buzzer-sg*
  buzzer
  buzzer-lod0-jg
  buzzer-idle-ja
  ((buzzer-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 1 0 1.6)
  :texture-level 2)

(deftype buzzer (eco-collectable)
  ((victory-anim spool-anim)))

(defmethod animate ((this buzzer))
  "Spin and animate the buzzer, orient and launch its wing particles from joint 15, update its
   sound, and keep the selected victory animation spooled once six buzzers have been collected."
  (quaternion-rotate-y! (-> this root quat) (-> this root quat) (* 40049.777 (seconds-per-frame)))
  (let ((root-channel (-> this skel root-channel 0)))
    (set! (-> root-channel param 0) 1.0)
    (joint-control-channel-group-eval! root-channel (the-as art-joint-anim #f) num-func-loop!))
  (let ((yaw (y-angle (-> this root))))
    (set! (-> *part-id-table* 239 init-specs 4 initial-valuef) (+ 16384.0 yaw))
    (set! (-> *part-id-table* 240 init-specs 4 initial-valuef) (+ 16384.0 yaw)))
  (spawn (-> this part) (vector<-cspace! (new 'stack-no-clear 'vector) (-> this node-list data 15)))
  (if (nonzero? (-> this sound)) (update! (-> this sound)))
  (if (and *target* (>= (-> *target* fact buzzer) 6.0))
    (spool-push *art-control* (-> this victory-anim name) 0 this (the-as float -99.0)))
  0
  (none))

(defstate wait (buzzer)
  :virtual #t
  :code
    (behavior ()
      (case (get-reminder (get-task-control (the-as game-task (logand (the int (-> self fact pickup-amount)) #xffff))) 0)
        ((127) (go-virtual pickup #t (the-as handle #f))))
      (loop
        (transform-post)
        (animate self)
        (suspend))))

(defstate pickup (buzzer)
  :virtual #t
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('notify) (process-entity-status! self (entity-perm-status dead) #t))))
  :enter
    (behavior ((pickup-mode object) (collector-handle handle))
      (set! (-> self pickup-handle) collector-handle)
      (logclear! (-> self mask) (process-mask actor-pause)))
  :code
    (behavior ((pickup-mode object) (collector-handle handle))
      (logclear! (-> self mask) (process-mask actor-pause))
      (process-entity-status! self (entity-perm-status complete) #t)
      (sound-play "buzzer-pickup")
      (case (-> (level-get-target-inside *level*) name)
        (('training)
         (level-hint-spawn (text-id training-buzzer-hint) "asstvb44" (the-as entity #f) *entity-pool* (game-task none)))
        (('firecanyon)
         (level-hint-spawn (text-id firecanyon-buzzer-hint) "sksp0096" (the-as entity #f) *entity-pool* (game-task none)))
        (else (level-hint-spawn (text-id sidekick-hint-buzzer3) "sksp009j" (the-as entity #f) *entity-pool* (game-task none))))
      (ja-channel-set! 0)
      (clear-collide-with-as (-> self root))
      (if (nonzero? (-> self sound)) (stop! (-> self sound)))
      (when (not pickup-mode)
        (let ((hud-copy (manipy-spawn (-> self root trans) #f *buzzer-sg* #f :to *entity-pool*)))
          (send-event (ppointer->process hud-copy) 'become-hud-object (ppointer->process (-> *hud-parts* buzzers)))))
      (let* ((task-id (logand (the int (-> self fact pickup-amount)) #xffff))
             (task-info (get-task-control (the-as game-task task-id))))
        (if (nonzero? task-id) (close-specific-task! (the-as game-task task-id) (task-status need-hint)))
        (when (and (= (get-reminder task-info 0) 127)
                   (and (-> self entity) (not (task-complete? *game-info* (the-as game-task task-id)))))
          (if (and *target*
                   (logtest? (-> *target* control root-prim prim-core action) (collide-action racer snowball tube flut))
                   (not pickup-mode))
            (logior! (-> self fact options) (fact-options instant-collect skip-jump-anim)))
          (let ((fuel-cell-pointer (birth-pickup-at-point (vector+! (new 'stack-no-clear 'vector) (-> self root trans) (new 'static 'vector :y 4096.0 :w 1.0))
                                                          (pickup-type fuel-cell)
                                                          (the float task-id)
                                                          #f
                                                          self
                                                          (-> self fact))))
            (when fuel-cell-pointer
              (send-event (ppointer->process fuel-cell-pointer) 'movie-pos (-> self movie-pos-index))
              (ja-channel-set! 0)
              (clear-collide-with-as (-> self root))
              (ja-post)
              (while (-> self child)
                (suspend))))))
      (when (-> self notify-parent)
        (let ((notification (new 'stack-no-clear 'event-message-block)))
          (set! (-> notification from) self)
          (set! (-> notification num-params) 1)
          (set! (-> notification message) 'notify)
          (set! (-> notification param 0) (the-as uint 'pickup))
          (let ((send-event-fn send-event-function)
                (parent-process (ppointer->process (-> self parent))))
            (send-event-fn (if (and (nonzero? parent-process) (type-type? (-> parent-process type) process)) parent-process)
                           notification))))))

(defmethod initialize ((this buzzer))
  "Allocate the buzzer collision shape, skeleton, wing particles and sound, and choose the
   victory animation used by the reward fuel cell."
  (let ((collision-shape (new 'process 'collide-shape-moving this (collide-list-enum hit-by-player))))
    (set! (-> collision-shape dynam) (copy *standard-dynamics* 'process))
    (set! (-> collision-shape reaction) default-collision-reaction)
    (set! (-> collision-shape no-reaction)
          (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (let ((collision-sphere (new 'process 'collide-shape-prim-sphere collision-shape (the-as uint 0))))
      (set! (-> collision-sphere prim-core collide-as) (collide-kind powerup blue-eco-suck))
      (set! (-> collision-sphere collide-with) (collide-kind target))
      (set-vector! (-> collision-sphere local-sphere) 0.0 2457.6 0.0 4915.2)
      (set-root-prim! collision-shape collision-sphere))
    (set! (-> collision-shape nav-radius) (* 0.75 (-> collision-shape root-prim local-sphere w)))
    (backup-collide-with-as collision-shape)
    (set! (-> this root) collision-shape))
  (logior! (-> this mask) (process-mask actor-pause))
  (set! (-> this actor-pause) #t)
  (set! (-> this notify-parent) #f)
  (set! (-> this fact) (new 'process 'fact-info this (pickup-type buzzer) (the-as float 0.0)))
  (initialize-skeleton this *buzzer-sg* '())
  (set! (-> this part) (create-launch-control group-buzzer-effect this))
  (set! (-> this sound) (new 'process 'ambient-sound (static-sound-spec "buzzer" :fo-max 40) (-> this root trans)))
  (set! (-> this victory-anim) (fuel-cell-pick-anim this))
  this)

(defmethod init-from-entity! ((this buzzer) (source-entity entity-actor))
  "Initialize an entity-backed buzzer. Completed buzzers wait for contact; incomplete buzzers
   enter pickup immediately to present their task."
  (initialize this)
  (process-drawable-from-entity! this (-> this entity))
  (initialize-params this 0 (the-as float 1024.0))
  (set! (-> this collect-timeout) (seconds 2))
  (update-transforms! (-> this root))
  (update-trans! (-> this sound) (-> this root trans))
  (if (and (-> this entity) (logtest? (-> this entity extra perm status) (entity-perm-status complete)))
    (go (method-of-object this wait))
    (go (method-of-object this pickup) #t (the-as handle #f)))
  (none))

(defbehavior buzzer-init-by-other buzzer ((position vector) (velocity vector) (pickup-info fact-info) (source-entity entity-actor))
  "Initialize a pooled buzzer at position with velocity and values copied from pickup-info.
   Preserve its source entity and options, enable parent notification, and enter wait."
  (let ((kind (-> pickup-info pickup-type))
        (amount (-> pickup-info pickup-spawn-amount)))
    (set! (-> self entity) source-entity)
    (set! (-> self pickup-type) kind)
    (set! (-> self pickup-amount) amount)
    (initialize self)
    (set! (-> self fact pickup-type) kind)
    (set! (-> self fact pickup-amount) amount))
  (set! (-> self fact options) (-> pickup-info options))
  (set! (-> self notify-parent) #t)
  (vector-copy! (-> self root trans) position)
  (quaternion-identity! (-> self root quat))
  (vector-identity! (-> self root scale))
  (vector-copy! (-> self root transv) velocity)
  (initialize-params self 0 (the-as float 1024.0))
  (update-transforms! (-> self root))
  (update-trans! (-> self sound) (-> self root trans))
  (set! (-> self event-hook) (-> (method-of-object self wait) event))
  (go-virtual wait)
  (none))

(defmethod init-from-entity! ((this eco) (source-entity entity-actor))
  "Read eco-info from the source entity, change this process to the matching concrete pickup
   type, and dispatch that type's entity initializer."
  (let ((kind (res-lump-value (-> this entity) 'eco-info pickup-type :time (the-as float -1000000000.0))))
    (set! (-> this type)
          (cond
            ((= kind (pickup-type eco-blue)) eco-blue)
            ((= kind (pickup-type eco-red)) eco-red)
            ((= kind (pickup-type eco-yellow)) eco-yellow)
            ((= kind (pickup-type eco-green)) health)
            ((= kind (pickup-type money)) money)
            ((= kind (pickup-type fuel-cell)) fuel-cell)
            ((= kind (pickup-type buzzer)) buzzer)
            (else eco-pill))))
  (init-from-entity! this source-entity)
  (none))

(defbehavior birth-pickup-at-point process ((position vector)
              (kind pickup-type)
              (amount float)
              (radial-velocity? symbol)
              (destination-pool process-tree)
              (pickup-info fact-info))
  "Spawn amount pickups of kind from the dead pickup pool at position. Copy source options when
   pickup-info is supplied, use its pickup-radius resource when available, and optionally distribute
   launch velocities radially. Fuel cells and buzzers spawn once and carry the full amount. Return the
   last spawned process pointer, or false when allocation fails."
  (local-vars
    (has-source-process? basic)
    (yellow-result symbol)
    (red-result symbol)
    (blue-result symbol)
    (health-result symbol)
    (pill-result symbol)
    (money-result symbol)
    (fuel-cell-result symbol)
    (buzzer-result symbol))
  (let ((source-info pickup-info)
        (launch-velocity (new-stack-vector0))
        (get-radius-fn (method-of-type res-lump get-property-value-float)))
    (let ((source-info-check source-info))
      (b! (not source-info-check) cfg-3 :likely-delay (set! has-source-process? source-info)))
    (set! has-source-process? (nonzero? (-> source-info process)))
    (label cfg-3)
    (let ((pickup-radius (get-radius-fn (if has-source-process? (-> source-info process entity))
                                        'pickup-radius
                                        'interp
                                        (the-as float -1000000000.0)
                                        (the-as float
                                                (cond
                                                  ((= kind (pickup-type buzzer)) 0.0)
                                                  ((= amount 1.0) 409.6)
                                                  (else 8192.0)))
                                        (the-as (pointer res-tag) #f)
                                        *res-static-buf*))
          (spawned-process-pointer (the-as (pointer process) #f)))
      (let ((pickups-left (the int amount))
            (spawn-info (new 'static 'fact-info)))
        (set! (-> spawn-info options) (fact-options))
        (if source-info (mem-copy! (&-> spawn-info type) (&-> source-info type) 40))
        (set! (-> spawn-info pickup-type) kind)
        (set! (-> spawn-info pickup-spawn-amount) 1.0)
        (while (> pickups-left 0)
          (+! pickups-left -1)
          (when radial-velocity?
            (set-vector! launch-velocity 0.0 57001.605 pickup-radius 1.0)
            (vector-rotate-around-y! launch-velocity launch-velocity (/ (* 65536.0 (the float pickups-left)) amount)))
          (let ((current-kind kind))
            (cond
              ((= current-kind (pickup-type eco-yellow))
               (let ((yellow-pickup (get-process *pickup-dead-pool* eco-yellow #x4000)))
                 (set! yellow-result
                       (when yellow-pickup
                         (set! spawned-process-pointer (the-as (pointer process) yellow-result))
                         ((method-of-type eco-yellow activate)
                          (the-as eco-yellow yellow-pickup)
                          destination-pool
                          'eco-yellow
                          (the-as pointer #x70004000))
                         (run-now-in-process yellow-pickup initialize-eco-by-other position launch-velocity spawn-info)
                         (set! spawned-process-pointer (-> yellow-pickup ppointer))
                         yellow-result)))
               spawned-process-pointer)
              ((= current-kind (pickup-type eco-red))
               (let ((red-pickup (get-process *pickup-dead-pool* eco-red #x4000)))
                 (set! red-result
                       (when red-pickup
                         (set! spawned-process-pointer (the-as (pointer process) red-result))
                         ((method-of-type eco-red activate) (the-as eco-red red-pickup) destination-pool 'eco-red (the-as pointer #x70004000))
                         (run-now-in-process red-pickup initialize-eco-by-other position launch-velocity spawn-info)
                         (set! spawned-process-pointer (-> red-pickup ppointer))
                         red-result)))
               (level-hint-spawn (text-id misty-eco-red-hint) "sksp0071" (the-as entity #f) *entity-pool* (game-task none)))
              ((= current-kind (pickup-type eco-blue))
               (let ((blue-pickup (get-process *pickup-dead-pool* eco-blue #x4000)))
                 (set! blue-result
                       (when blue-pickup
                         (set! spawned-process-pointer (the-as (pointer process) blue-result))
                         ((method-of-type eco-blue activate) (the-as eco-blue blue-pickup) destination-pool 'eco-blue (the-as pointer #x70004000))
                         (run-now-in-process blue-pickup initialize-eco-by-other position launch-velocity spawn-info)
                         (set! spawned-process-pointer (-> blue-pickup ppointer))
                         blue-result)))
               spawned-process-pointer)
              ((= current-kind (pickup-type eco-green))
               (let ((health-pickup (get-process *pickup-dead-pool* health #x4000)))
                 (set! health-result
                       (when health-pickup
                         (set! spawned-process-pointer (the-as (pointer process) health-result))
                         ((method-of-type health activate) (the-as health health-pickup) destination-pool 'health (the-as pointer #x70004000))
                         (run-now-in-process health-pickup initialize-eco-by-other position launch-velocity spawn-info)
                         (set! spawned-process-pointer (-> health-pickup ppointer))
                         health-result)))
               spawned-process-pointer)
              ((= current-kind (pickup-type eco-pill))
               (let ((pill-pickup (get-process *pickup-dead-pool* eco-pill #x4000)))
                 (set! pill-result
                       (when pill-pickup
                         (set! spawned-process-pointer (the-as (pointer process) pill-result))
                         ((method-of-type eco-pill activate) (the-as eco-pill pill-pickup) destination-pool 'eco-pill (the-as pointer #x70004000))
                         (run-now-in-process pill-pickup initialize-eco-by-other position launch-velocity spawn-info)
                         (set! spawned-process-pointer (-> pill-pickup ppointer))
                         pill-result)))
               spawned-process-pointer)
              ((= current-kind (pickup-type money))
               (let ((money-pickup (get-process *pickup-dead-pool* money #x4000)))
                 (set! money-result
                       (when money-pickup
                         (set! spawned-process-pointer (the-as (pointer process) money-result))
                         ((method-of-type money activate) (the-as money money-pickup) destination-pool 'money (the-as pointer #x70004000))
                         (run-now-in-process money-pickup money-init-by-other position launch-velocity spawn-info (-> self entity))
                         (set! spawned-process-pointer (-> money-pickup ppointer))
                         money-result)))
               spawned-process-pointer)
              ((= current-kind (pickup-type fuel-cell))
               (set! (-> spawn-info pickup-spawn-amount) amount)
               (let ((fuel-cell-pickup (get-process *pickup-dead-pool* fuel-cell #x4000)))
                 (set! fuel-cell-result
                       (when fuel-cell-pickup
                         (set! spawned-process-pointer (the-as (pointer process) fuel-cell-result))
                         ((method-of-type fuel-cell activate)
                          (the-as fuel-cell fuel-cell-pickup)
                          destination-pool
                          'fuel-cell
                          (the-as pointer #x70004000))
                         (run-now-in-process fuel-cell-pickup fuel-cell-init-by-other position launch-velocity spawn-info (-> self entity))
                         (set! spawned-process-pointer (-> fuel-cell-pickup ppointer))
                         fuel-cell-result)))
               (set! pickups-left 0)
               pickups-left)
              ((= current-kind (pickup-type buzzer))
               (set! (-> spawn-info pickup-spawn-amount) amount)
               (let ((buzzer-pickup (get-process *pickup-dead-pool* buzzer #x4000)))
                 (set! buzzer-result
                       (when buzzer-pickup
                         (set! spawned-process-pointer (the-as (pointer process) buzzer-result))
                         ((method-of-type buzzer activate) (the-as buzzer buzzer-pickup) destination-pool 'buzzer (the-as pointer #x70004000))
                         (run-now-in-process buzzer-pickup buzzer-init-by-other position launch-velocity spawn-info (-> self entity))
                         (set! spawned-process-pointer (-> buzzer-pickup ppointer))
                         buzzer-result)))
               (set! pickups-left 0)
               pickups-left)
              (else (format 0 "ERROR: unknown type of eco ~d~%" kind) #f)))))
      spawned-process-pointer)))

(defmethod drop-pickup ((this fact-info) (radial-velocity? symbol) (destination-pool process-tree) (spawn-info fact-info) (amount-bonus int))
  "Choose and spawn this pickup drop. Random eco-pill drops use death count, player health, the
   live pill count, and amount-bonus to select health or an adjusted pill amount. Probe downward from
   the owning process for a ground position, raise fuel cells, and return the last spawned process.
   radial-velocity? distributes multiple pickups around the Y axis; destination-pool owns them, and
   spawn-info is retained for the caller interface but is not read."
  (let ((kind (-> this pickup-type))
        (amount (-> this pickup-amount)))
    (when (= kind (pickup-type eco-pill-random))
      amount
      (let ((death-count (get-death-count *game-info* #f)))
        (set! kind (pickup-type eco-pill))
        (set! amount
              (cond
                ((and (= death-count 1) *target* (and (>= 1.0 (-> *target* fact health)) (rand-vu-percent? (the-as float 0.1))))
                 (set! kind (pickup-type eco-green))
                 1.0)
                ((and (< 1 death-count) *target* (and (>= 2.0 (-> *target* fact health)) (rand-vu-percent? (the-as float 0.05))))
                 (set! kind (pickup-type eco-green))
                 1.0)
                ((< 20 *eco-pill-count*) (return (the-as (pointer process) #f)) amount)
                ((< 10 *eco-pill-count*) 1.0)
                ((type-type? (-> this type) fact-info-enemy)
                 (+ (rand-vu-float-range (the-as float 3.0) (+ 5.0 amount)) (the float amount-bonus)))
                (else (+ (rand-vu-float-range (the-as float 2.0) (+ 3.0 amount)) (the float amount-bonus)))))))
    (let ((spawn-position (new 'stack-no-clear 'vector)))
      (vector-copy! spawn-position (-> this process root trans))
      (+! (-> spawn-position y) 12288.0)
      (let ((ground-hit (new 'stack-no-clear 'collide-tri-result)))
        (if (>= (fill-and-probe-using-y-probe *collide-cache*
                                              spawn-position
                                              (the-as float 81920.0)
                                              (collide-kind background)
                                              (the-as process-drawable #f)
                                              ground-hit
                                              (new 'static 'pat-surface :noentity #x1))
                0.0)
          (vector-copy! spawn-position (-> ground-hit intersect))
          (vector-copy! spawn-position (-> this process root trans))))
      (if (= (the-as int kind) 6) (+! (-> spawn-position y) 6144.0))
      (birth-pickup-at-point spawn-position (the-as pickup-type kind) amount radial-velocity? destination-pool this))))

(deftype ecovalve (process-drawable)
  ((root          collide-shape-moving :override)
   (offset        vector :inline)
   (offset-target vector :inline)
   (block-func    (function vent symbol)))
  (:states
   ecovalve-idle))

(defskelgroup *ecovalve-sg*
  ecovalve
  ecovalve-geo-jg
  ecovalve-idle-ja
  ((ecovalve-geo-mg (meters 999999)))
  :bounds (static-spherem 0 1 0 1.6)
  :texture-level 2)

(defstate ecovalve-idle (ecovalve)
  :code
    (behavior ()
      (transform-post)
      (suspend)
      (transform-post)
      (loop
        (if (not ((-> self block-func) (the-as vent (ppointer->process (-> self parent)))))
          (set-vector! (-> self offset-target) 0.0 0.0 0.0 1.0))
        (when (!= (-> self offset-target y) (-> self offset y))
          (vector-seek! (-> self offset) (-> self offset-target) (* 4096.0 (seconds-per-frame)))
          (move-to-point! (-> self root)
                          (vector+! (new 'stack-no-clear 'vector) (-> (the-as process-drawable (-> self parent 0)) root trans) (-> self offset)))
          (transform-post))
        (suspend))))

(defbehavior ecovalve-init-by-other ecovalve ((block-fn (function vent symbol)))
  "Initialize the animated valve attached to a vent. Build its solid moving mesh, copy block-fn,
   place the valve at its open or lowered offset, and enter its tracking state."
  (stack-size-set! (-> self main-thread) 128)
  (let ((collision-shape (new 'process 'collide-shape-moving self (collide-list-enum hit-by-player))))
    (set! (-> collision-shape dynam) (copy *standard-dynamics* 'process))
    (set! (-> collision-shape reaction) default-collision-reaction)
    (set! (-> collision-shape no-reaction)
          (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (let ((collision-mesh (new 'process 'collide-shape-prim-mesh collision-shape (the-as uint 0) (the-as uint 0))))
      (set! (-> collision-mesh prim-core collide-as) (collide-kind enemy))
      (set! (-> collision-mesh collide-with) (collide-kind target))
      (set! (-> collision-mesh prim-core action) (collide-action solid))
      (set! (-> collision-mesh prim-core offense) (collide-offense touch))
      (set! (-> collision-mesh transform-index) 3)
      (set-vector! (-> collision-mesh local-sphere) 0.0 3686.4 0.0 6144.0)
      (set-root-prim! collision-shape collision-mesh))
    (set! (-> collision-shape nav-radius) (* 0.75 (-> collision-shape root-prim local-sphere w)))
    (backup-collide-with-as collision-shape)
    (set! (-> self root) collision-shape))
  (if (and *target* (logtest? (-> *target* control root-prim prim-core action) (collide-action racer)))
    (clear-collide-with-as (-> self root)))
  (set! (-> self block-func) block-fn)
  (vector-copy! (-> self root trans) (-> (the-as process-drawable (-> self parent 0)) root trans))
  (set-vector! (-> self offset-target) 0.0 -2252.8 0.0 1.0)
  (if (not ((-> self block-func) (the-as vent (ppointer->process (-> self parent)))))
    (set-vector! (-> self offset-target) 0.0 0.0 0.0 1.0))
  (vector-copy! (-> self offset) (-> self offset-target))
  (initialize-skeleton self *ecovalve-sg* '())
  (move-to-point! (-> self root)
                  (vector+! (new 'stack-no-clear 'vector) (-> (the-as process-drawable (-> self parent 0)) root trans) (-> self offset)))
  (go ecovalve-idle)
  (none))

(deftype vent (process-drawable)
  ((root                collide-shape :override)
   (show-particles      symbol)
   (collect-effect      sparticle-launch-group)
   (collect-effect2     sparticle-launch-group)
   (collect-effect-time time-frame)
   (blocker             entity-actor)
   (block-func          (function vent symbol))
   (pickup-handle       handle))
  (:methods
   (initialize (_type_ entity-actor pickup-type) none))
  (:states
   vent-blocked
   (vent-pickup handle)
   vent-wait-for-touch))

(defmethod initialize ((this vent) (source-entity entity-actor) (kind pickup-type))
  "Initialize an eco vent at the source entity. Configure its collision volume, active
   particles, collection effects, ambient sound, and optional blocker or animated valve, then enter
   blocked or wait-for-touch."
  (stack-size-set! (-> this main-thread) 128)
  (logior! (-> this mask) (process-mask actor-pause))
  (let ((collision-shape (new 'process 'collide-shape this (collide-list-enum hit-by-player))))
    (let ((collision-sphere (new 'process 'collide-shape-prim-sphere collision-shape (the-as uint 0))))
      (set! (-> collision-sphere prim-core collide-as) (collide-kind powerup))
      (set! (-> collision-sphere collide-with) (collide-kind target))
      (set-vector! (-> collision-sphere local-sphere) 0.0 4915.2 0.0 6553.6)
      (set-root-prim! collision-shape collision-sphere))
    (set! (-> collision-shape nav-radius) (* 0.75 (-> collision-shape root-prim local-sphere w)))
    (backup-collide-with-as collision-shape)
    (set! (-> this root) collision-shape))
  (vector-copy! (-> this root trans) (-> source-entity extra trans))
  (update-transforms! (-> this root))
  (set! (-> this root pause-adjust-distance) 409600.0)
  (set! (-> this fact) (new 'process 'fact-info this kind (-> *FACT-bank* eco-full-inc)))
  (set! (-> this block-func) (the-as (function vent symbol) true-func))
  (case (-> this fact pickup-type)
    (((pickup-type eco-blue))
     (set! (-> this part) (create-launch-control group-part-vent-blue-active this))
     (set! (-> this collect-effect) group-blue-collect)
     (set! (-> this collect-effect2) group-eco-blue-collect)
     (set! (-> this sound) (new 'process 'ambient-sound 'eco-bg-blue (-> this root trans))))
    (((pickup-type eco-red))
     (set! (-> this part) (create-launch-control group-part-vent-red-active this))
     (set! (-> this collect-effect) group-red-collect)
     (set! (-> this collect-effect2) group-eco-red-collect)
     (set! (-> this sound) (new 'process 'ambient-sound 'eco-bg-red (-> this root trans))))
    (((pickup-type eco-green))
     (set! (-> this part) (create-launch-control group-part-vent-green-active this))
     (set! (-> this collect-effect) group-green-collect)
     (set! (-> this collect-effect2) group-eco-green-collect)
     (set! (-> this sound) (new 'process 'ambient-sound 'eco-bg-green (-> this root trans))))
    (((pickup-type eco-yellow))
     (set! (-> this part) (create-launch-control group-part-vent-yellow-active this))
     (set! (-> this collect-effect) group-yellow-collect)
     (set! (-> this collect-effect2) group-eco-yellow-collect)
     (set! (-> this sound) (new 'process 'ambient-sound 'eco-bg-yellow (-> this root trans)))))
  (set! (-> this blocker) (entity-actor-lookup (-> this entity) 'alt-actor 0))
  (when (-> this blocker)
    (logior! (-> this fact options) (fact-options vent-blocked))
    (set! (-> this block-func)
          (lambda ((vent-process vent))
            (not (logtest? (-> vent-process blocker extra perm status) (entity-perm-status complete))))))
  (set! (-> this show-particles) #t)
  (when (logtest? (-> this fact options) (fact-options vent-blocked))
    (when (logtest? (-> this fact options) (fact-options vent-valve))
      (case (-> this fact pickup-type)
        (((pickup-type eco-blue))
         (set! (-> this block-func)
               (the-as (function vent symbol) (lambda () (not (task-complete? *game-info* (game-task jungle-eggtop)))))))
        (((pickup-type eco-red))
         (set! (-> this block-func)
               (the-as (function vent symbol) (lambda () (not (task-complete? *game-info* (game-task red-eggtop)))))))
        (((pickup-type eco-yellow))
         (set! (-> this block-func)
               (the-as (function vent symbol) (lambda () (not (task-complete? *game-info* (game-task snow-eggtop))))))))
      (process-spawn ecovalve (-> this block-func) :from *pickup-dead-pool* :to this))
    (if ((-> this block-func) this) (go vent-blocked)))
  (go vent-wait-for-touch)
  (none))

(defbehavior vent-standard-event-handler vent ((source process) (argc int) (message symbol) (block event-message-block))
  "Handle shared vent control messages. show-particles updates visible particle emission, and hide
   installs an always-blocked predicate before entering vent-blocked."
  (case message
    (('show-particles)
     (let ((show-particles? (the-as object (-> block param 0))))
       (set! (-> self show-particles) (the-as symbol show-particles?))
       show-particles?))
    (('hide) (set! (-> self block-func) (the-as (function vent symbol) true-func)) (go vent-blocked))))

(defstate vent-wait-for-touch (vent)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (if (and (or (= message 'touch) (= message 'attack))
               (let ((pickup-event (new 'stack-no-clear 'event-message-block)))
                 (set! (-> pickup-event from) self)
                 (set! (-> pickup-event num-params) 2)
                 (set! (-> pickup-event message) 'get-pickup)
                 (set! (-> pickup-event param 0) (the-as uint (-> self fact pickup-type)))
                 (set! (-> pickup-event param 1) (the-as uint (-> self fact pickup-amount)))
                 (and (= (send-event-function proc pickup-event) #t)
                      (or (logtest? (-> self fact options) (fact-options powerup)) (send-event proc 'powerup)))))
        (go vent-pickup (process->handle proc)))
      (vent-standard-event-handler proc argc message block))
  :code
    (behavior ()
      (loop
        (let ((particles (-> self part))
              (position (-> self root trans))
              (ambient (-> self sound)))
          (if (and (nonzero? particles) (-> self show-particles)) (spawn particles position))
          (if (nonzero? ambient) (update! ambient)))
        (suspend))))

(defstate vent-blocked (vent)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('show) (go vent-wait-for-touch))))
  :code
    (behavior ()
      (loop
        (if (not ((-> self block-func) self)) (go vent-wait-for-touch))
        (suspend))))

(defstate vent-pickup (vent)
  :event vent-standard-event-handler
  :code
    (behavior ((collector-handle handle))
      (when (-> self show-particles)
        (when (nonzero? (-> self collect-effect))
          (let* ((collector-process (handle->process collector-handle))
                 (collector-drawable (if (and (nonzero? collector-process) (type-type? (-> collector-process type) process-drawable)) collector-process)))
            (when collector-drawable
              (let* ((collector-root (-> (the-as process-drawable collector-drawable) root))
                     (collector-shape (if (and (nonzero? collector-root) (type-type? (-> collector-root type) collide-shape)) collector-root)))
                (when collector-shape
                  (process-spawn part-tracker
                                 :init
                                 part-tracker-init
                                 (-> self collect-effect)
                                 -1
                                 part-tracker-track-target
                                 #f
                                 #f
                                 (-> (the-as collide-shape collector-shape) root-prim prim-core)
                                 :to
                                 collector-drawable)
                  (process-spawn part-tracker
                                 :init
                                 part-tracker-init
                                 (-> self collect-effect2)
                                 -1
                                 part-tracker-move-to-target
                                 #f
                                 #f
                                 (-> self root root-prim prim-core)
                                 :to
                                 self)))))))
      (go vent-wait-for-touch)))

(deftype ventyellow (vent) ())

(defmethod init-from-entity! ((this ventyellow) (source-entity entity-actor))
  "Initialize a yellow-eco vent from the source entity."
  (initialize this source-entity (pickup-type eco-yellow))
  (none))

(deftype ventred (vent) ())

(defmethod init-from-entity! ((this ventred) (source-entity entity-actor))
  "Initialize a red-eco vent from the source entity."
  (initialize this source-entity (pickup-type eco-red))
  (none))

(deftype ventblue (vent) ())

(defmethod init-from-entity! ((this ventblue) (source-entity entity-actor))
  "Initialize a blue-eco vent from the source entity."
  (initialize this source-entity (pickup-type eco-blue))
  (none))

(deftype ecovent (vent) ())

(defmethod init-from-entity! ((this ecovent) (source-entity entity-actor))
  "Initialize the generic eco-vent entity as a blue-eco vent."
  (initialize this source-entity (pickup-type eco-blue))
  (none))

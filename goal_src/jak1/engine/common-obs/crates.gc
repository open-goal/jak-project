(defbehavior crate-standard-event-handler crate ((proc process) (argc int) (message symbol) (block event-message-block))
  "Handle attacks, contact, bonks, wakeups, and blue-eco attraction. Break vulnerable crates,
   reject attacks that do not meet iron or steel requirements, play contextual hints and impact
   feedback, and enter notice-blue only while the crate is resting and eligible."
  (case message
    (('attack)
     (let ((attack-id (-> block param 2))
           (amount-bonus (-> block param 3)))
       (case (-> self defense)
         (('iron)
          (case (-> block param 1)
            (('flop 'uppercut 'explode 'darkeco 'eco-yellow 'bonk 'racer 'tube 'flut-bonk 'flut-attack)
             (if (and (logtest? (-> self fact options) (fact-options require-zoomer))
                      *target*
                      (not (logtest? (-> *target* control root-prim prim-core action) (collide-action racer))))
               (return #f))
             (increment-success-for-hint (text-id sidekick-hint-crate-iron))
             (increment-success-for-hint (text-id training-ironcrate))
             (send-event proc 'get-attack-count 1)
             (go-virtual die #f (the-as int amount-bonus)))
            (else
             (when (and (!= attack-id (-> self incomming-attack-id)) (= (-> self root trans y) (-> self base y)))
               (if (not (and (!= *kernel-boot-message* 'play) (= (-> *setting-control* current language) (language-enum japanese))))
                 (level-hint-spawn (text-id training-ironcrate) "sagevb36" (the-as entity #f) *entity-pool* (game-task none)))
               (case (-> (level-get-target-inside *level*) name)
                 (('training)
                  (if (and (can-hint-be-played? (text-id zero) (the-as entity #f) (the-as string #f)) (rand-vu-percent? 0.2))
                    (clear-text-seen! *game-info* (text-id sidekick-hint-crate-iron)))))
               (level-hint-spawn (text-id sidekick-hint-crate-iron) "sksp0005" (the-as entity #f) *entity-pool* (game-task none))
               (set! (-> self incomming-attack-id) attack-id)
               (if (not (!= (-> self smush amp) 0.0)) (sound-play "icrate-nobreak"))
               (activate! (-> self smush) 0.1 90 150 1.0 1.0)
               (go-virtual bounce-on))
             #f)))
         (('steel)
          (case (-> block param 1)
            (('explode 'darkeco 'eco-yellow 'bonk 'tube 'flut-bonk 'flut-attack 'racer)
             (send-event proc 'get-attack-count 1)
             (when (logtest? (-> self draw status) (draw-status was-drawn))
               (increment-success-for-hint (text-id sidekick-hint-crate-steel))
               (level-hint-spawn (text-id sidekick-hint-crate-steel-break1)
                                 "sksp0004"
                                 (the-as entity #f)
                                 *entity-pool*
                                 (game-task none))
               (level-hint-spawn (text-id sidekick-hint-crate-steel-break2)
                                 "sksp009b"
                                 (the-as entity #f)
                                 *entity-pool*
                                 (game-task none)))
             (go-virtual die #f (the-as int amount-bonus)))
            (else
             (when (and (!= attack-id (-> self incomming-attack-id)) (= (-> self root trans y) (-> self base y)))
               (level-hint-spawn (text-id sidekick-hint-crate-steel) "sksp0006" (the-as entity #f) *entity-pool* (game-task none))
               (set! (-> self incomming-attack-id) attack-id)
               (if (not (!= (-> self smush amp) 0.0)) (sound-play "scrate-nobreak"))
               (activate! (-> self smush) 0.1 90 150 1.0 1.0)
               (go-virtual bounce-on))
             #f)))
         (('darkeco)
          (send-event proc 'attack (-> block param 0) (static-attack-info ((mode 'darkeco))))
          (when (= (-> proc type) target)
            (level-hint-spawn (text-id sidekick-hint-crate-darkeco2) "sksp009c" (the-as entity #f) *entity-pool* (game-task none))
            (level-hint-spawn (text-id sidekick-hint-crate-darkeco1) "sksp0002" (the-as entity #f) *entity-pool* (game-task none))
            (case (-> (level-get-target-inside *level*) name)
              (('rolling)
               (level-hint-spawn (text-id sidekick-hint-crate-darkeco-rolling)
                                 "sksp0110"
                                 (the-as entity #f)
                                 *entity-pool*
                                 (game-task none)))
              (('firecanyon)
               (level-hint-spawn (text-id firecanyon-crate-darkeco2) "sksp0082" (the-as entity #f) *entity-pool* (game-task none))
               (level-hint-spawn (text-id firecanyon-crate-darkeco1) "sksp0081" (the-as entity #f) *entity-pool* (game-task none)))))
          (go-virtual die #f (the-as int amount-bonus)))
         (else (send-event proc 'get-attack-count 1) (go-virtual die #f (the-as int amount-bonus))))))
    (('touch)
     (case (-> self defense)
       (('darkeco) (send-event proc 'attack (-> block param 0) (static-attack-info ((mode 'darkeco)))) (go-virtual die #f 0))))
    (('bonk)
     (when (= (-> self root trans y) (-> self base y))
       (activate! (-> self smush) -0.1 75 150 1.0 1.0)
       (go-virtual bounce-on)))
    (('wake)
     (let ((awake-mask (the-as object (logclear (-> self mask) (process-mask sleep)))))
       (set! (-> self mask) (the-as process-mask awake-mask))
       awake-mask))
    (('eco-blue)
     (if (not (or (= (-> self defense) 'darkeco)
                  (or (= (-> self next-state name) 'notice-blue) (= (-> self next-state name) 'die))
                  (!= (-> self root trans y) (-> self base y))))
       (go-virtual notice-blue (process->handle proc))))))

(defstate wait (crate)
  :virtual #t
  :event crate-standard-event-handler
  :code
    (behavior ()
      (suspend)
      (update-transforms! (-> self root))
      (logior! (-> self mask) (process-mask sleep))
      (loop
        (suspend)))
  :post ja-post)

(defstate bounce-on (crate)
  :virtual #t
  :event crate-standard-event-handler
  :code
    (behavior ()
      (while (!= (-> self smush amp) 0.0)
        (suspend))
      (go-virtual wait))
  :post crate-post)

;; Blue eco makes a resting crate twitch more strongly as the target approaches. Once the target
;; reaches the suck distance, the crate breaks with collectable contents; the pickup code handles
;; their remaining motion.
(defstate notice-blue (crate)
  :virtual #t
  :event crate-standard-event-handler
  :trans
    (behavior ()
      (cond
        ((not (send-event *target* 'query 'powerup (pickup-type eco-blue)))
         (logior! (-> self mask) (process-mask sleep-code))
         (if (not (!= (-> self smush amp) 0.0)) (go-virtual wait)))
        (else (logclear! (-> self mask) (process-mask sleep-code)))))
  :code
    (behavior ((target-handle handle))
      (set! (-> self target) target-handle)
      (loop
        (let* ((target-process (handle->process (-> self target)))
               (target-drawable (if (and (nonzero? target-process) (type-type? (-> target-process type) process-drawable)) target-process)))
          (when target-drawable
            (let* ((target-root (-> (the-as process-drawable target-drawable) root))
                   (target-shape (if (and (nonzero? target-root) (type-type? (-> target-root type) collide-shape)) target-root)))
              (when target-shape
                (let* ((crate-core (-> self root root-prim prim-core))
                       (target-core (-> (the-as collide-shape target-shape) root-prim prim-core))
                       (target-distance (vector-vector-distance (-> crate-core world-sphere) (-> target-core world-sphere))))
                  (when (and (< target-distance (-> *FACT-bank* suck-suck-dist)) (!= (-> self defense) 'steel))
                    (logior! (-> self fact options) (fact-options can-collect))
                    (go-virtual die #f 0))
                  (when (rand-vu-percent? 0.5)
                    (let ((glow-position (new 'stack-no-clear 'vector)))
                      (vector-copy! glow-position (-> crate-core world-sphere))
                      (dotimes (i 3)
                        (+! (-> glow-position data i) (rand-vu-float-range -5324.8 5324.8)))
                      (eco-blue-glow glow-position)))
                  (activate! (-> self smush)
                             (lerp-scale (rand-vu-float-range 0.1 0.3)
                                         (rand-vu-float-range 0.0 0.02)
                                         target-distance
                                         (-> *FACT-bank* suck-suck-dist)
                                         (-> *FACT-bank* suck-bounce-dist))
                             60
                             60
                             1.0
                             1.0))))))
        (suspend)))
  :post crate-post)

(defstate die (crate)
  :virtual #t
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('touched)
         (case (-> self defense)
           (('darkeco)
            (cond
              ((= (-> proc type) target) (send-event proc 'attack (-> block param 0) (static-attack-info ((mode 'darkeco)))))
              (else
               (let ((forwarded-attack (new 'stack-no-clear 'event-message-block)))
                 (set! (-> forwarded-attack from) self)
                 (set! (-> forwarded-attack num-params) 4)
                 (set! (-> forwarded-attack message) 'attack)
                 (set! (-> forwarded-attack param 0) (-> block param 0))
                 (set! (-> forwarded-attack param 1) (the-as uint 'darkeco))
                 (let ((attack-id (+ *global-attack-id* 1)))
                   (set! *global-attack-id* attack-id)
                   (set! (-> forwarded-attack param 2) (the-as uint attack-id)))
                 (set! (-> forwarded-attack param 3) (the-as uint 0))
                 (send-event-function proc forwarded-attack)))))))))
  :trans
    (behavior ()
      (case (-> self type)
        ((crate-buzzer)
         (if (and *target* (>= (-> *target* fact buzzer) 6.0)) (spool-push *art-control* (-> self victory-anim name) 0 self -99.0)))))
  :code
    (behavior ((skip-break-effects? symbol) (amount-bonus int))
      (clear-collide-with-as (-> self root))
      (if (nonzero? (-> self sound)) (stop! (-> self sound)))
      (if (and *target*
               (and (logtest? (-> *target* control root-prim prim-core action) (collide-action racer snowball tube flut))
                    (!= (-> self fact pickup-type) 6)
                    (not skip-break-effects?)))
        (logior! (-> self fact options) (fact-options instant-collect)))
      (when (not skip-break-effects?)
        (suspend-for (seconds 0.04))
        (logior! (-> self draw status) (draw-status hidden))
        (case (-> self look)
          (('iron) (sound-play "icrate-break"))
          (('steel) (sound-play "scrate-break"))
          (('darkeco) (sound-play "dcrate-break"))
          (else (sound-play "wcrate-break")))
        (case (-> self defense)
          (('darkeco)
           (let ((dark-eco-buzz-scale (lerp-scale 1.0 0.0 (vector-vector-distance (-> self root trans) (target-pos 0)) 8192.0 40960.0)))
             (cpad-set-buzz! (-> *cpad-list* cpads 0) 1 (the int (* 255.0 dark-eco-buzz-scale)) (seconds 0.3)))
           (process-spawn touch-tracker
                          :init
                          touch-tracker-init
                          (-> self root trans)
                          (-> *CRATE-bank* DARKECO_EXPLODE_RADIUS)
                          30
                          :to
                          self)))
        (case (-> self look)
          (('darkeco)
           (process-spawn part-tracker
                          :init
                          part-tracker-init
                          group-dark-eco-box-explosion
                          -1
                          #f
                          #f
                          #f
                          (-> self root trans)
                          :to
                          *entity-pool*))
          (('steel 'iron)
           (process-spawn part-tracker
                          :init
                          part-tracker-init
                          group-crate-steel-explode
                          -1
                          #f
                          #f
                          #f
                          (-> self root trans)
                          :to
                          *entity-pool*))
          (else
           (process-spawn part-tracker
                          :init
                          part-tracker-init
                          group-crate-explode
                          -1
                          #f
                          #f
                          #f
                          (-> self root trans)
                          :to
                          *entity-pool*))))
      (case (-> self fact pickup-type)
        (((pickup-type money)
          (pickup-type buzzer)
          (pickup-type eco-blue)
          (pickup-type eco-yellow)
          (pickup-type eco-red)
          (pickup-type fuel-cell))
         (go-virtual special-contents-die)))
      (drop-pickup (-> self fact) #t *entity-pool* (the-as fact-info #f) amount-bonus)
      (process-entity-status! self (entity-perm-status dead) #t)
      (process-entity-status! self (entity-perm-status complete) #t)
      (suspend-for (seconds 5))))

;; Spawn special contents as children so each pickup can be saved independently. user-int8[1]
;; counts collected children and is subtracted from the next spawn after a reload.
(defstate special-contents-die (crate)
  :virtual #t
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('notify)
         (case (-> block param 0)
           (('pickup)
            (let ((persistent (-> self entity extra perm)))
              (logior! (-> persistent status) (entity-perm-status user-set-from-cstage))
              (set! (-> persistent user-int8 1) (min 127 (+ (-> persistent user-int8 1) 1)))
              (+! (-> self child-count) -1)
              (when (<= (-> self child-count) 0)
                (if (or (= (-> self defense) 'iron) (= (-> self defense) 'steel))
                  (process-entity-status! self (entity-perm-status respawn-on-reload) #f))
                (process-entity-status! self (entity-perm-status dead) #t)
                (process-entity-status! self (entity-perm-status complete) #t)
                (set! (-> persistent user-int8 0) 2)
                (let ((awake-mask (logclear (-> self mask) (process-mask sleep)))) (set! (-> self mask) awake-mask) awake-mask))))))))
  :trans
    (-> (method-of-type crate die)
        trans)
  :code
    (behavior ()
      (when (or (= (-> self fact pickup-type) (pickup-type money)) (= (-> self defense) 'iron) (= (-> self defense) 'steel))
        (let ((entity-record (-> self entity)))
          (if (when entity-record
                (let ((task (-> entity-record extra perm task))) (if task (= task (game-task none)))))
            (set! (-> self entity extra perm task) (game-task complete)))))
      (clear-collide-with-as (-> self root))
      (logior! (-> self draw status) (draw-status hidden))
      (drop-pickup (-> self fact) #t self (the-as fact-info #f) 0)
      (set! (-> self child-count) (+ (process-count self) -1))
      (process-entity-status! self (entity-perm-status respawn-on-reload) #t)
      (let ((persistent (-> self entity extra perm)))
        (logior! (-> persistent status) (entity-perm-status user-set-from-cstage))
        (set! (-> persistent user-int8 0) 1))
      (when (-> self child)
        (logior! (-> self mask) (process-mask sleep))
        (suspend)
        (while (-> self child)
          (suspend)))))

(defbehavior crate-init-by-other crate ((entity-record entity) (position vector) (crate-type symbol))
  "Initialize a spawned crate from entity, place it at position, use crate-type for both its look
   and defense, initialize its art, and enter its saved-dead or ordinary wait state."
  (params-init self entity-record)
  (vector-copy! (-> self root trans) position)
  (set! (-> self look) crate-type)
  (set! (-> self defense) crate-type)
  (art-init self)
  (check-dead self)
  (none))

(defmethod init-from-entity! ((this crate) (entity-record entity-actor))
  "Initialize this crate from its entity resources, select and connect its art, then enter the
   saved-dead or ordinary wait state."
  (params-init this entity-record)
  (art-init this)
  (check-dead this)
  (none))

(defmethod params-init ((this crate) (entity-record entity))
  "Build the moving collision shape, pickup data, and entity-derived drawable state. Restore
   collected pickup count, read crate-type into look and defense, and select crate-buzzer when the
   pickup contents require it."
  (stack-size-set! (-> this main-thread) 128)
  (logior! (-> this mask) (process-mask crate))
  (let ((moving-shape (new 'process 'collide-shape-moving this (collide-list-enum usually-hit-by-player))))
    (set! (-> moving-shape dynam) (copy *standard-dynamics* 'process))
    (set! (-> moving-shape reaction) default-collision-reaction)
    (set! (-> moving-shape no-reaction)
          (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (alloc-riders moving-shape 1)
    (let ((mesh-prim (new 'process 'collide-shape-prim-mesh moving-shape (the-as uint 0) (the-as uint 0))))
      (set! (-> mesh-prim prim-core collide-as) (collide-kind crate blue-eco-suck))
      (set! (-> mesh-prim collide-with) (collide-kind target))
      (set! (-> mesh-prim prim-core action) (collide-action solid rider-plat-sticky))
      (set! (-> mesh-prim prim-core offense) (collide-offense touch))
      (set! (-> mesh-prim transform-index) 3)
      (set-vector! (-> mesh-prim local-sphere) 0.0 3072.0 0.0 6963.2)
      (set-root-prim! moving-shape mesh-prim))
    (set! (-> moving-shape nav-radius) (* 0.75 (-> moving-shape root-prim local-sphere w)))
    (backup-collide-with-as moving-shape)
    (set! (-> this root) moving-shape))
  (set! (-> this fact) (new 'process 'fact-info this (pickup-type eco-pill-random) (-> *FACT-bank* default-pill-inc)))
  (let ((persistent (-> this entity extra perm)))
    (set! (-> this fact pickup-amount) (fmax 0.0 (- (-> this fact pickup-amount) (the float (-> persistent user-int8 1))))))
  (when (and (-> this entity) (logtest? (-> this entity extra perm status) (entity-perm-status complete)))
    (set! (-> this fact pickup-type) (pickup-type eco-pill-random))
    (set! (-> this fact pickup-amount) 0.0))
  (when entity-record
    (process-drawable-from-entity! this (the-as entity-actor entity-record))
    (logclear! (-> this mask) (process-mask actor-pause)))
  (let ((crate-type ((method-of-type res-lump get-property-struct)
                     (-> this entity)
                     'crate-type
                     'interp
                     -1000000000.0
                     'wood
                     (the-as (pointer res-tag) #f)
                     *res-static-buf*)))
    (set! (-> this look) (the-as symbol crate-type))
    (set! (-> this defense) (the-as symbol crate-type)))
  (case (-> this fact pickup-type)
    (((pickup-type buzzer))
     (set! (-> this type) crate-buzzer)
     (when (= (-> this look) 'wood)
       (set! (-> this look) 'iron)
       (set! (-> this defense) 'iron)))
    (else (when (= (-> this look) 'iron) (set! (-> this look) 'wood) (set! (-> this defense) 'wood))))
  (none))

(defmethod art-init ((this crate))
  "Select the skeleton and base collision offense from look, apply any pickup-option offense
   override, save the resting position, update the crate once, and connect it to the navigation
   mesh."
  (case (-> this look)
    (('iron)
     (set! (-> this root root-prim prim-core offense) (collide-offense normal-attack))
     (initialize-skeleton this *crate-iron-sg* '()))
    (('steel)
     (set! (-> this root root-prim prim-core offense) (collide-offense indestructible))
     (initialize-skeleton this *crate-steel-sg* '()))
    (('darkeco)
     (when (= (-> this fact pickup-type) (pickup-type eco-pill-random))
       (set! (-> this fact pickup-type) (pickup-type none))
       (set! (-> this fact pickup-amount) 0.0))
     (initialize-skeleton this *crate-darkeco-sg* '())
     (set-vector! (-> this draw color-mult) 0.8 0.8 0.8 1.0)
     (set-vector! (-> this draw color-emissive) 0.2 0.2 0.2 1.0))
    (('barrel) (initialize-skeleton this *crate-barrel-sg* '()))
    (('bucket)
     (when (= (-> this fact pickup-type) (pickup-type eco-pill-random))
       (set! (-> this fact pickup-type) (pickup-type none))
       (set! (-> this fact pickup-amount) 0.0))
     (initialize-skeleton this *crate-bucket-sg* '()))
    (('none) (initialize-skeleton this *crate-wood-sg* '()) (logior! (-> this draw status) (draw-status hidden)))
    (else (initialize-skeleton this *crate-wood-sg* '())))
  (cond
    ((logtest? (fact-options indestructible) (-> this fact options))
     (set! (-> this root root-prim prim-core offense) (collide-offense indestructible)))
    ((logtest? (-> this fact options) (fact-options strong-attack))
     (set! (-> this root root-prim prim-core offense) (collide-offense strong-attack)))
    ((logtest? (-> this fact options) (fact-options normal-attack))
     (set! (-> this root root-prim prim-core offense) (collide-offense normal-attack)))
    ((logtest? (-> this fact options) (fact-options touch))
     (set! (-> this root root-prim prim-core offense) (collide-offense touch))))
  (vector-copy! (-> this base) (-> this root trans))
  (crate-post)
  (nav-mesh-connect this (-> this root) (the-as nav-control #f))
  this)

(defmethod params-set! ((this crate) (look symbol) (defense symbol))
  "Replace look and defense when the corresponding optional symbol is non-false."
  (if look (set! (-> this look) look))
  (if defense (set! (-> this defense) defense))
  (none))

(defmethod check-dead ((this crate))
  "Enter the silent die state when this entity's saved crate marker is set; otherwise enter the
   ordinary wait state."
  (if (>= (-> this entity extra perm user-int8 0) 1) (go (method-of-object this die) #t 0))
  0
  (go (method-of-object this wait))
  0
  (none))

(defmethod smush-update! ((this crate))
  "Update the smush controller and scale the crate taller by its amplitude while narrowing X and Z
   by half that amount."
  (let ((smush-amount (update! (-> this smush))))
    (set! (-> this root scale x) (+ 1.0 (/ smush-amount -2)))
    (set! (-> this root scale y) (+ 1.0 smush-amount))
    (set! (-> this root scale z) (+ 1.0 (/ smush-amount -2))))
  0
  (none))

(deftype barrel (crate) ())

(defmethod params-init ((this barrel) (entity-record entity))
  "Run the base crate parameter setup, then select barrel art while retaining the resolved defense."
  (let ((base-params-init (method-of-type crate params-init))) (base-params-init this entity-record))
  (set! (-> this look) 'barrel)
  (none))

(deftype bucket (crate) ())

(defmethod params-init ((this bucket) (entity-record entity))
  "Run the base crate parameter setup, then select bucket art while retaining the resolved defense."
  (let ((base-params-init (method-of-type crate params-init))) (base-params-init this entity-record))
  (set! (-> this look) 'bucket)
  (none))

(defpartgroup group-buzzer-crate
  :id 74
  :duration (seconds 0.017)
  :linger-duration (seconds 1.5)
  :bounds (static-bspherem 0 0 0 2)
  :parts ((sp-item 302)))

(defpart 302
  :init-specs
  ((:texture (bigpuff effects))
   (:num 1.0)
   (:scale-x (meters 1) (meters 1))
   (:rot-z (degrees 0) (degrees 360))
   (:scale-y :copy scale-x)
   (:r 128.0)
   (:g 96.0 32.0)
   (:b 64.0 32.0)
   (:a 16.0 32.0)
   (:vel-y (meters 0.02) (meters 0.01))
   (:scalevel-x (meters 0.0033333334))
   (:rotvel-z (degrees -0.2) (degrees 0.4))
   (:scalevel-y :copy scalevel-x)
   (:fade-a -0.16)
   (:accel-y (meters -0.00033333333))
   (:friction 0.95)
   (:timer (seconds 1))
   (:flags (die-when-faded use-time-of-day-color no-fog))
   (:conerot-x (degrees 60) (degrees 30))
   (:conerot-y (degrees 0) (degrees 360))))

(deftype crate-buzzer (crate) ())

(defmethod art-init ((this crate-buzzer))
  "Initialize the base crate art, then create the buzzer smoke launcher and ambient sound and
   choose the streamed victory animation used after the sixth buzzer."
  (let ((base-art-init (method-of-type crate art-init))) (base-art-init this))
  (set! (-> this part) (create-launch-control group-buzzer-crate this))
  (set! (-> this sound)
        (new 'process 'ambient-sound (static-sound-spec "buzzer" :pitch-mod -762 :fo-max 40) (-> this root trans)))
  (set! (-> this victory-anim) (fuel-cell-pick-anim this))
  (the-as crate this))

;; A nearby buzzer crate occasionally hops after its idle delay. Integrate a vertical velocity
;; under gravity and halve it at each floor hit until the bounce is too small to continue.
(defstate wait (crate-buzzer)
  :virtual #t
  :trans
    (behavior ()
      (when (and (and *target* (>= 327680.0 (vector-vector-distance (-> self root trans) (-> *target* control trans))))
                 (time-elapsed? (-> self state-time) (seconds 1.5))
                 (rand-vu-percent? 0.03))
        (spawn (-> self part) (-> self root trans))
        (activate! (-> self smush) 0.2 90 150 1.0 1.0)
        (logclear! (-> self mask) (process-mask sleep-code)))
      (if (nonzero? (-> self sound)) (update! (-> self sound)))
      (if (and *target* (>= (-> *target* fact buzzer) 6.0)) (spool-push *art-control* (-> self victory-anim name) 0 self -99.0)))
  :code
    (behavior ()
      (set-time! (-> self state-time))
      (suspend)
      (update-transforms! (-> self root))
      (loop
        (set-time! (-> self state-time))
        (ja-post)
        (logior! (-> self mask) (process-mask sleep-code))
        (suspend)
        (let ((vertical-speed 57001.605))
          (sound-play "crate-jump")
          (while (or (!= (-> self smush amp) 0.0) (!= vertical-speed 0.0))
            (+! vertical-speed (* -245760.0 (seconds-per-frame)))
            (+! (-> self root trans y) (* vertical-speed (seconds-per-frame)))
            (when (< (-> self root trans y) (-> self base y))
              (set! (-> self root trans y) (-> self base y))
              (set! vertical-speed (/ vertical-speed -2))
              (if (< (fabs vertical-speed) 16384.0) (set! vertical-speed 0.0)))
            (crate-post)
            (ja-post)
            (suspend)))
        (set! (-> self root trans y) (-> self base y))))
  :post #f)

(defstate bounce-on (crate-buzzer)
  :virtual #t
  :code
    (behavior ()
      (while (!= (-> self smush amp) 0.0)
        (spawn (-> self part) (-> self root trans))
        (suspend))
      (go-virtual wait)))

(deftype pickup-spawner (crate)
  ((blocker entity-actor)))

(defmethod params-init ((this pickup-spawner) (entity-record entity))
  "Run the base crate parameter setup, hide the crate art, and resolve the optional alternate actor
   that blocks a vent-controlled pickup spawner."
  (let ((base-params-init (method-of-type crate params-init))) (base-params-init this entity-record))
  (set! (-> this look) 'none)
  (set! (-> this blocker) #f)
  (if (logtest? (-> this fact options) (fact-options vent-blocked))
    (set! (-> this blocker) (entity-actor-lookup (-> this entity) 'alt-actor 0)))
  (none))

(defmethod check-dead ((this pickup-spawner))
  "Always enter the pickup-spawner wait state, regardless of the saved crate marker."
  (go (method-of-object this wait))
  0
  (none))

;; Vent-controlled spawners break invisibly as soon as their alternate blocker is complete, or
;; immediately when no blocker was configured.
(defstate wait (pickup-spawner)
  :virtual #t
  :code
    (behavior ()
      (loop
        (if (or (not (-> self blocker)) (logtest? (-> self blocker extra perm status) (entity-perm-status complete)))
          (go-virtual die #t 0))
        (suspend))))

;;-*-Lisp-*-
(in-package goal)
(bundles "GAME.CGO")
(require "engine/common-obs/nav-enemy.gc")
(require "engine/common-obs/water.gc")

;; DECOMP BEGINS

(defpartgroup group-sharkey-splash
  :id 106
  :duration (seconds 0.4)
  :linger-duration (seconds 2.6)
  :flags (use-local-clock)
  :bounds (static-bspherem 0 -12 0 14)
  :parts
  ((sp-item 124 :flags (3d) :period (seconds 3) :length (seconds 0.21))
   (sp-item 125 :period (seconds 3) :length (seconds 0.05))
   (sp-item 126 :flags (3d) :period (seconds 3) :length (seconds 0.05))
   (sp-item 127 :flags (3d) :period (seconds 3) :length (seconds 0.05))
   (sp-item 128 :period (seconds 3) :length (seconds 0.035) :binding 129)
   (sp-item 129 :flags (child) :period (seconds 3) :length (seconds 0.4))
   (sp-item 129 :flags (child) :period (seconds 3) :length (seconds 0.4))
   (sp-item 129 :flags (child) :period (seconds 3) :length (seconds 0.4))
   (sp-item 129 :flags (child) :period (seconds 3) :length (seconds 0.4))
   (sp-item 129 :flags (child) :period (seconds 3) :length (seconds 0.4))
   (sp-item 129 :flags (child) :period (seconds 3) :length (seconds 0.4))
   (sp-item 129 :flags (child) :period (seconds 3) :length (seconds 0.4))
   (sp-item 129 :flags (child) :period (seconds 3) :length (seconds 0.4))
   (sp-item 129 :flags (child) :period (seconds 3) :length (seconds 0.4))
   (sp-item 129 :flags (child) :period (seconds 3) :length (seconds 0.4))
   (sp-item 129 :flags (child) :period (seconds 3) :length (seconds 0.4))))

(deftype sharkey (nav-enemy)
  ((dir               vector :inline)
   (spawn-point       vector :inline)
   (scale             float)
   (anim-speed        float)
   (y-max             meters)
   (y-min             meters)
   (attack-time       float)
   (player-water-time time-frame)
   (player-in-water   basic)
   (last-y            float)
   (spawn-distance    meters)
   (chase-speed       meters)
   (y-speed           meters)
   (sound-id          sound-id)
   (enable-patrol     basic)))

(defskelgroup *sharkey-sg*
  sharkey
  sharkey-lod0-jg
  sharkey-idle-ja
  ((sharkey-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 6))

(defmethod touch-handler ((this sharkey) (arg0 process) (arg1 event-message-block))
  "Accept touch events without applying the ordinary nav-enemy contact attack."
  #t)

(defmethod attack-handler ((this sharkey) (arg0 process) (arg1 event-message-block))
  "Accept incoming attack events without damaging the Sharkey or starting a counterattack."
  #t)

nav-enemy-default-event-handler

(defmethod run-logic? ((this sharkey))
  "Continue logic when actor pausing is disabled, the Sharkey is within its adjusted pause
   distance, its skeleton is blending between channels, or its drawable requests skeleton
   processing despite the normal update policy."
  (or (not (logtest? (-> this mask) (process-mask actor-pause)))
      (or (>= (+ (-> *ACTOR-bank* pause-dist) (-> this collide-info pause-adjust-distance))
              (vector-vector-distance (-> this collide-info trans) (math-camera-pos)))
          (and (nonzero? (-> this skel)) (!= (-> this skel root-channel 0) (-> this skel channel)))
          (and (nonzero? (-> this draw)) (logtest? (-> this draw status) (draw-status no-skeleton-update))))))

(defmethod update-nav-target! ((this sharkey))
  "Navigate toward target-pos, then add a vertical travel component toward the lesser of the
   target height and y-max. Scale that climb or dive by four times the vertical-to-horizontal
   displacement ratio so horizontal travel still controls the overall approach."
  (navigate! (-> this nav) (-> this nav target-pos))
  (let* ((horizontal-distance (vector-vector-xz-distance (-> this collide-info trans) (-> this nav target-pos)))
         (climb-ratio (/ (- (fmin (-> this y-max) (-> this nav target-pos y)) (-> this collide-info trans y)) horizontal-distance)))
    (set! (-> this nav travel y) (* 4.0 (vector-length (-> this nav travel)) climb-ratio)))
  0
  (none))

(defmethod turn-toward-travel! ((this sharkey))
  "When the travel vector is longer than two metres, turn dir toward its normalized heading at
   one revolution per second and rebuild the collision quaternion."
  (let ((travel-direction (new 'stack-no-clear 'vector)))
    (when (< 8192.0 (vector-length (-> this nav travel)))
      (vector-normalize-copy! travel-direction (-> this nav travel) 1.0)
      (vector-deg-seek (-> this dir) (-> this dir) travel-direction (* 65536.0 (seconds-per-frame)))
      (vector-normalize! (-> this dir) 1.0)
      (forward-up->quaternion (-> this collide-info quat) (-> this dir) *up-vector*)))
  0
  (none))

(defmethod compute-travel-velocity! ((this sharkey))
  "Ramp momentum-speed toward target-speed by at most acceleration per frame. Convert the
   navigation travel vector to velocity, capped by both scaled momentum and the distance that
   remains along the travel vector in one frame."
  (let* ((speed-error (- (-> this target-speed) (-> this momentum-speed)))
         (speed-step (fmin (* (-> this acceleration) (seconds-per-frame)) (fabs speed-error))))
    (if (< speed-error 0.0)
      (set! (-> this momentum-speed) (- (-> this momentum-speed) speed-step))
      (+! (-> this momentum-speed) speed-step)))
  (let ((travel-speed (fmin (* (-> this speed-scale) (-> this momentum-speed))
                            (* (vector-length (-> this nav travel)) (-> *display* frames-per-second)))))
    (vector-normalize-copy! (-> this collide-info transv) (-> this nav travel) travel-speed))
  0
  (none))

(defmethod common-post ((this sharkey))
  "Fade the Sharkey from white at nine metres below world zero to black at twelve metres below,
   update its water control, and make a splash whenever its position crosses the water surface.
   Save the new height for the next crossing test, then run the ordinary nav-enemy post work."
  (let ((water-height (-> this water height))
        (splash-position (new 'stack-no-clear 'vector)))
    (let* ((depth-below-fade (- -36864.0 (-> this collide-info trans y)))
           (color-scale (fmax 0.0 (fmin 1.0 (- 1.0 (/ depth-below-fade (meters 3)))))))
      (set-vector! (-> this draw color-mult) color-scale color-scale color-scale 1.0))
    (update-water-state! (-> this water))
    (let ((current-y (-> this collide-info trans y)))
      (when (or (and (< water-height current-y) (>= water-height (-> this last-y)))
                (and (>= water-height current-y) (< water-height (-> this last-y))))
        (vector-copy! splash-position (-> this collide-info trans))
        (set! (-> splash-position y) water-height)
        (create-splash (-> this water) 1.0 splash-position 1 (-> this collide-info transv)))
      (set! (-> this last-y) current-y)))
  (call-parent-method this)
  0
  (none))

(defbehavior sharkey-notice-player? sharkey ()
  "Return true when the target is below the Sharkey's maximum swimming height, is not in racer
   mode, and is close enough to this Sharkey's navigation mesh."
  (if *target*
    (and (< (- (-> *target* control trans y) (-> self y-max)) 0.0)
         (let ((gp-0 'racer)) (!= gp-0 (send-event *target* 'query 'mode)))
         (nav-enemy-test-point-near-nav-mesh? (-> *target* control shadow-pos)))))

(defun sharkey-get-player-position ((destination vector))
  "Copy the player target point at joint slot 5 into destination."
  (vector-copy! destination (target-pos 5))
  0
  (none))

(defbehavior sharkey-reset-position sharkey ()
  "Restore the Sharkey's position from its entity transform."
  (vector-copy! (-> self collide-info trans) (-> self entity extra trans))
  0
  (none))

(defbehavior sharkey-move-to-attack-position sharkey ()
  "Sample each integer control-vertex parameter on the Sharkey's path and find the sample nearest
   the player in XZ. Face from that path point toward the player, choose a point spawn-distance
   behind the player, project it onto the navigation mesh, and save it at the hidden idle depth as
   the new spawn point before teleporting there."
  (let ((closest-path-position (new 'stack-no-clear 'vector))
        (candidate-position (new 'stack-no-clear 'vector))
        (desired-spawn-position (new 'stack-no-clear 'vector)))
    (let ((player-position (-> *target* control trans)))
      (let ((best-distance 4096000.0))
        (vector-copy! candidate-position (-> self entity extra trans))
        (vector-copy! closest-path-position (-> self collide-info trans))
        (dotimes (i (-> self path curve num-cverts))
          (eval-path-curve-div! (-> self path) candidate-position (the float i) 'interp)
          (let ((candidate-distance (vector-vector-xz-distance player-position candidate-position)))
            (when (< candidate-distance best-distance)
              (set! best-distance candidate-distance)
              (vector-copy! closest-path-position candidate-position)))))
      (vector-! (-> self dir) player-position closest-path-position)
      (vector-normalize! (-> self dir) 1.0)
      (vector+*! desired-spawn-position player-position (-> self dir) (- (-> self spawn-distance))))
    (project-onto-nav-mesh (-> self nav) desired-spawn-position desired-spawn-position)
    (set! (-> desired-spawn-position y) (-> self y-min))
    (vector-copy! (-> self spawn-point) desired-spawn-position))
  (vector-copy! (-> self collide-info trans) (-> self spawn-point))
  (forward-up->quaternion (-> self collide-info quat) (-> self dir) *up-vector*)
  (set! (-> self momentum-speed) 0.0))

(defstate nav-enemy-idle (sharkey)
  :virtual #t
  :event nav-enemy-default-event-handler
  :enter
    (behavior ()
      (set-time! (-> self state-time))
      (logclear! (-> self nav-enemy-flags) (nav-enemy-flags notice-pending)))
  :exit
    (behavior ()
      (logclear! (-> self draw status) (draw-status hidden)))
  :trans
    (behavior ()
      (cond
        ((-> self enable-patrol)
         (if (and (and *target*
                       (>= (-> self enemy-info idle-distance)
                           (vector-vector-distance (-> self collide-info trans) (-> *target* control trans))))
                  (time-elapsed? (-> self state-time) (-> self state-timeout)))
           (go-virtual nav-enemy-patrol)))
        ((sharkey-notice-player?)
         (when (not (logtest? (-> self nav-enemy-flags) (nav-enemy-flags notice-pending)))
           (logior! (-> self nav-enemy-flags) (nav-enemy-flags notice-pending))
           (set-time! (-> self notice-time)))
         (let ((target-poly (find-poly-fast-from-world (-> self nav) (-> *target* control trans))))
           (when (or (and target-poly (logtest? (-> target-poly pat) 2))
                     (and (logtest? (-> self draw status) (draw-status hidden))
                          (time-elapsed? (-> self notice-time) (-> self reaction-time))))
             (sharkey-move-to-attack-position)
             (set! (-> self player-in-water) #t)
             (go-virtual nav-enemy-chase))))
        (else
         (if (time-elapsed? (-> self notice-time) (seconds 10))
           (logclear! (-> self nav-enemy-flags) (nav-enemy-flags notice-pending))))))
  :code
    (behavior ()
      (ja-channel-push! 1 (seconds 0.075))
      (ja :group! (-> self draw art-group data (-> self nav-info idle-anim)))
      (ja :num-func num-func-identity :frame-num 0.0)
      (until (= (-> self collide-info trans y) (-> self y-min))
        (ja :num! (loop! (-> self anim-speed)))
        (seek! (-> self anim-speed) 1.0 0.05)
        (seek! (-> self collide-info trans y) (-> self y-min) (* (-> self y-speed) (seconds-per-frame)))
        (update-water-state! (-> self water))
        (ja-post)
        (suspend))
      (logior! (-> self draw status) (draw-status hidden))
      (anim-loop))
  :post #f)

(defstate nav-enemy-patrol (sharkey)
  :virtual #t
  :event nav-enemy-default-event-handler
  :trans
    (behavior ()
      (if (sharkey-notice-player?) (go-virtual nav-enemy-chase)))
  :code
    (behavior ()
      (ja-channel-push! 1 (seconds 0.075))
      (set! (-> self nav target-pos quad) (-> self spawn-point quad))
      (loop
        (ja-play :group!
                 (-> self draw art-group data (-> self nav-info walk-anim))
                 :num!
                 (seek! max (-> self anim-speed))
                 :frame-num 0.0
                 (seek! (-> self anim-speed) 1.0 0.05)
                 (cond
                   ((-> self enable-patrol)
                    (seek! (-> self collide-info trans y) (-> self y-max) (* (-> self y-speed) (seconds-per-frame))))
                   (else (if (< (- (-> self collide-info trans y) (-> self y-min)) 409.6) (go-virtual nav-enemy-idle)))))))
  :post
    (behavior ()
      (nav-enemy-travel-post)))

(defstate nav-enemy-notice (sharkey)
  :virtual #t
  :event nav-enemy-default-event-handler
  :enter
    (behavior ()
      (go-virtual nav-enemy-chase))
  :code
    (behavior ()
      (go-virtual nav-enemy-chase)))

(defbehavior sharkey-follow-trajectory sharkey ((trajectory-time float))
  "Evaluate the chomp trajectory at time into the Sharkey's position and velocity, then face along
   the resulting velocity."
  (let ((trajectory (-> self jump-trajectory)))
    (eval-position! trajectory trajectory-time (-> self collide-info trans))
    (eval-velocity! trajectory trajectory-time (-> self collide-info transv)))
  (vector-normalize-copy! (-> self dir) (-> self collide-info transv) 1.0)
  (forward-up->quaternion (-> self collide-info quat) (-> self dir) *up-vector*))

(defstate nav-enemy-attack (sharkey)
  :virtual #t
  :event nav-enemy-default-event-handler
  :code
    (behavior ()
      (let ((attack-start-position (new 'stack-no-clear 'vector))
            (player-position (new 'stack-no-clear 'vector)))
        (current-time)
        (sound-play "bigshark-bite")
        (set-time! (-> self state-time))
        (vector-copy! attack-start-position (-> self collide-info trans))
        (ja-channel-push! 1 (seconds 0.1))
        (ja-play :group!
                 sharkey-chomp-ja
                 :num!
                 (seek! (ja-aframe 3.0 0) 2.0)
                 :frame-num 0.0
                 (sharkey-get-player-position player-position)
                 (setup-from-to-duration! (-> self jump-trajectory) attack-start-position player-position 3.0 -291.27112)
                 (set! (-> self attack-time) (ja-aframe-num 0))
                 (sharkey-follow-trajectory (-> self attack-time))))
      (when (send-event *target* 'attack-invinc #f (static-attack-info ((mode 'sharkey))))
        (logclear! (-> self mask) (process-mask enemy))
        (vector-float*! (-> self collide-info transv) (-> self collide-info transv) 8.0)
        (set-time! (-> self state-time))
        (let ((gravity -409600.0)
              (vertical-speed (-> self collide-info transv y))
              (vertical-position (-> self collide-info trans y)))
          (until (time-elapsed? (-> self state-time) (seconds 3))
            (ja-play :group!
                     sharkey-chomp-ja
                     :num! (seek!)
                     :frame-num
                     (ja-aframe 3.0 0)
                     (+! vertical-speed (* gravity (seconds-per-frame)))
                     (+! vertical-position (* vertical-speed (seconds-per-frame)))
                     (set! (-> self collide-info transv y) vertical-speed)
                     (when (< (-> self collide-info trans y) (-> self water height))
                       (set! vertical-speed (* 0.9 vertical-speed))
                       (vector-float*! (-> self collide-info transv) (-> self collide-info transv) 0.9))
                     (vector-normalize-copy! (-> self dir) (-> self collide-info transv) 1.0)
                     (forward-up->quaternion (-> self collide-info quat) (-> self dir) *up-vector*)
                     (integrate-for-enemy-with-move-to-ground! (-> self collide-info)
                                                               (-> self collide-info transv)
                                                               (collide-kind background)
                                                               8192.0
                                                               #t
                                                               #f
                                                               #f)
                     (set! (-> self collide-info trans y) vertical-position))))
        (send-event *target* 'end-mode)
        (logior! (-> self mask) (process-mask enemy)))
      (sharkey-reset-position)
      (logior! (-> self draw status) (draw-status hidden))
      (go-virtual nav-enemy-idle))
  :post
    (behavior ()
      (nav-enemy-simple-post)))

(defstate nav-enemy-chase (sharkey)
  :virtual #t
  :event nav-enemy-default-event-handler
  :exit
    (behavior ()
      (sound-stop (-> self sound-id)))
  :trans
    (behavior ()
      (if (not *target*) (go-virtual nav-enemy-patrol))
      (let ((player-position (-> *target* control trans)))
        (let ((target-near-nav? (nav-enemy-test-point-near-nav-mesh? (-> *target* control shadow-pos)))
              (racer-mode 'racer)
              (query-block (new 'stack-no-clear 'event-message-block)))
          (set! (-> query-block from) self)
          (set! (-> query-block num-params) 1)
          (set! (-> query-block message) 'query)
          (set! (-> query-block param 0) (the-as uint 'mode))
          (if (or (= racer-mode (send-event-function *target* query-block)) (not target-near-nav?)) (go-virtual nav-enemy-patrol)))
        (when (logtest? (-> *target* control status) (collide-status on-ground))
          (set! (-> self player-in-water) (logtest? (-> *target* control status) (collide-status on-water)))
          (if (-> self player-in-water) (set-time! (-> self player-water-time))))
        (if (and *target* (>= 8192.0 (vector-vector-distance (-> self collide-info trans) (-> *target* control trans))))
          (go-virtual nav-enemy-attack))
        (cond
          ((-> self player-in-water)
           (set-time! (-> self free-time))
           (if (and (< (fabs (- (-> player-position y) (-> self collide-info trans y))) 40960.0)
                    (< (vector-vector-xz-distance player-position (-> self collide-info trans)) 24576.0))
             (go-virtual nav-enemy-attack)))
          (else (if (time-elapsed? (-> self free-time) (seconds 3)) (go-virtual nav-enemy-patrol)))))
      (let ((target-poly (-> self nav target-poly)))
        (if (and target-poly (logtest? (-> target-poly pat) 2))
          (set! (-> self target-speed) (* 2.0 (-> self chase-speed)))
          (set! (-> self target-speed) (-> self chase-speed)))))
  :code
    (behavior ()
      (set-time! (-> self player-water-time))
      (ja-channel-push! 1 (seconds 0.17))
      (sound-play "bigshark-idle")
      (loop
        (ja-play :group!
                 (-> self draw art-group data (-> self nav-info run-anim))
                 :num!
                 (seek! max (-> self anim-speed))
                 :frame-num 0.0
                 (seek! (-> self anim-speed) 1.0 (* 3.0 (seconds-per-frame))))))
  :post
    (behavior ()
      (sharkey-get-player-position (-> self nav target-pos))
      (nav-enemy-travel-post)
      (let* ((distance-to-player (vector-vector-distance (-> self collide-info trans) (-> self nav target-pos)))
             (proximity (fmax 0.0 (fmin 1.0 (- 1.0 (/ (+ -24576.0 distance-to-player) (+ -24576.0 (-> self spawn-distance)))))))
             (pitch (+ 0.5 (* 1.5 proximity))))
        (sound-play "bigshark-alert" :id (-> self sound-id) :pitch pitch :position (the-as symbol (-> self collide-info trans))))))

(defstate nav-enemy-stop-chase (sharkey)
  :virtual #t
  :event nav-enemy-default-event-handler
  :code
    (behavior ()
      (ja-channel-push! 1 (seconds 0.17))
      (loop
        (ja-play :group!
                 (-> self draw art-group data (-> self nav-info walk-anim))
                 :num!
                 (seek! max (-> self anim-speed))
                 :frame-num 0.0
                 (seek! (-> self anim-speed) 1.0 0.05)
                 (seek! (-> self collide-info trans y) (-> self y-max) (* (-> self y-speed) (seconds-per-frame)))))))

(defstate nav-enemy-stare (sharkey)
  :virtual #t
  :event nav-enemy-default-event-handler
  :trans
    (behavior ()
      (if (target-in-range? self (-> self nav-info notice-distance)) (go-virtual nav-enemy-chase))
      (if (time-elapsed? (-> self state-time) (-> self state-timeout)) (go-virtual nav-enemy-patrol)))
  :code
    (behavior ()
      (ja-channel-push! 1 (seconds 0.17))
      (ja :group! (-> self draw art-group data (-> self nav-info idle-anim)))
      (ja :num-func num-func-identity :frame-num 0.0)
      (loop
        (ja :num! (loop! (-> self anim-speed)))
        (seek! (-> self anim-speed) 1.0 0.05)
        (seek! (-> self collide-info trans y) (-> self y-max) (* (-> self y-speed) (seconds-per-frame)))
        (suspend))))

(defstate nav-enemy-victory (sharkey)
  :virtual #t
  :event nav-enemy-default-event-handler
  :code
    (behavior ()
      (ja-channel-push! 1 (seconds 0.075))
      (dotimes (i 3)
        (ja-play :group!
                 (-> self draw art-group data (-> self nav-info victory-anim))
                 :num!
                 (seek! max (-> self anim-speed))
                 :frame-num 0.0))
      (go-virtual nav-enemy-stare)))


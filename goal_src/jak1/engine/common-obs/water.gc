   (:next-time (seconds 0.5))
   (:next-launcher 109)))

(defpart 109
  :init-specs ((:fade-a -0.2)))

(defun birth-func-y->userdata ((system sparticle-system) (cpuinfo sparticle-cpuinfo) (launch-transform matrix))
  "Add the launch transform's world Y coordinate to the particle's user-float, converting its
   relative surface offset to a world-space height."
  (+! (-> cpuinfo user-float) (-> launch-transform vector 0 y))
  0
  (none))

(defun birth-func-ocean-height ((system sparticle-system) (cpuinfo sparticle-cpuinfo) (launch-transform matrix))
  "Place the launch transform at the ocean height sampled at its position, plus the particle's
   user-float vertical offset."
  (set! (-> launch-transform vector 0 y) (+ (ocean-get-height (-> launch-transform vector 0)) (-> cpuinfo user-float)))
  0
  (none))

(defun check-water-level-drop ((system sparticle-system) (cpuinfo sparticle-cpuinfo) (position vector))
  "When a descending particle crosses the world-space water height in user-float, kill it, play the
   water-drop sound, and launch a surface ring at the crossing position."
  (when (and (< (-> position y) (-> cpuinfo user-float)) (< (-> cpuinfo vel-sxvel y) 0.0))
    (let ((surface-position (new 'stack-no-clear 'vector)))
      (sp-kill-particle system cpuinfo)
      (set-vector! surface-position (-> position x) (-> cpuinfo user-float) (-> position z) 1.0)
      (sound-play "water-drop" :position (the-as symbol surface-position))
      (launch-particles :system *sp-particle-system-3d* (-> *part-id-table* 108) surface-position)))
  0
  (none))

(defun check-water-level-drop-and-die ((system sparticle-system) (cpuinfo sparticle-cpuinfo) (position vector))
  "Kill a descending particle after it falls below the world-space water height in user-float."
  (if (and (< (-> position y) (-> cpuinfo user-float)) (< (-> cpuinfo vel-sxvel y) 0.0)) (sp-kill-particle system cpuinfo))
  (none))

(defun check-water-level-above-and-die ((system sparticle-system) (cpuinfo sparticle-cpuinfo) (position vector))
  "Kill a particle once it reaches or rises above the world-space water height in user-float."
  (if (>= (-> position y) (-> cpuinfo user-float)) (sp-kill-particle system cpuinfo))
  (none))


   (:timer (seconds 1))
   (:flags (die-when-faded glow))
   (:userdata 0.0)
   (:func 'check-water-level-drop-and-die)
   (:next-time (seconds 0.75))
   (:next-launcher 114)))

(defmethod water-control-init-extra! ((this water-control))
  "Perform subtype-specific water-control initialization. The base
   implementation is empty."
  0
  (none))

(defmethod update-water-state! ((this water-control))
  "Refresh the tracked root, top point, and moving surface, then derive the
   touching, head-submerged, wading, swimming, and under-water states. Send the owner's water events,
   apply surface motion and tar effects, and drive wakes, splashes, and post-water drips. The
   classification height uses the smoothed ocean or ripple offset, while surface-height retains the
   raw sampled surface for particles."
  (with-pp
    (let ((old-flags (-> this flag)))
      (cond
        ((not (logtest? (-> this flag) (water-flag active)))
         (logclear! (-> this flag) (water-flag touch-water wading swimming under-water head-under-water bouncing jump-out)))
        ((and (logtest? (water-flag no-grab-sound) (-> this flag))
              (logtest? (-> this process state-flags) (state-flags grabbed)))
         (logior! (-> this flag) (water-flag jump-out)))
        ((begin
           ;; Track the root and selected top joint, retaining last frame's positions for surface
           ;; crossings.
           (vector-copy! (-> this top 1) (-> this top 0))
           (vector<-cspace! (-> this top 0) (-> this process node-list data (-> this joint-index)))
           (+! (-> this top 0 y) (-> this top-y-offset))
           (vector-copy! (-> this bottom 1) (-> this bottom 0))
           (vector-copy! (-> this bottom 0) (-> this process root trans))
           (logclear! (-> this flag) (water-flag wading swimming under-water head-under-water bouncing))
           (set! (-> this bob-offset) (update! (-> this bob)))
           ;; Keep the raw sample for particles, but smooth the classification surface while the
           ;; owner is already touching the water.
           (cond
             ((and (logtest? (-> this flag) (water-flag use-ocean))
                   (not (logtest? (-> (the-as collide-shape-moving (-> this process root)) root-prim prim-core action) (collide-action racer))))
              (set! (-> this real-ocean-offset) (- (ocean-get-height (-> this bottom 0)) (-> this base-height)))
              (if (not (logtest? (-> this flag) (water-flag touch-water)))
                (set! (-> this ocean-offset) (-> this real-ocean-offset))
                (set! (-> this ocean-offset) (lerp (-> this ocean-offset) (-> this real-ocean-offset) 0.2))))
             ((logtest? (water-flag use-ripple-offset) (-> this flag))
              (let* ((volume-process (-> this volume process 0))
                     (ripple-height (ripple-find-height (the-as process-drawable volume-process) 0 (-> this bottom 0))))
                (set! (-> this real-ocean-offset) (- ripple-height (-> this base-height)))
                (if (not (logtest? (-> this flag) (water-flag touch-water)))
                  (set! (-> this ocean-offset) (-> this real-ocean-offset))
                  (set! (-> this ocean-offset) (lerp (-> this ocean-offset) (-> this real-ocean-offset) 0.2)))
                ;; TODO: ripple-position is prepared here but not consumed.
                (let ((ripple-position (new 'stack-no-clear 'vector)))
                  (vector-copy! ripple-position (-> this bottom 0))
                  (set! (-> ripple-position y) ripple-height))))
             (else (set! (-> this real-ocean-offset) 0.0) (set! (-> this ocean-offset) 0.0)))
           (if (logtest? (-> (the-as collide-shape-moving (-> this process root)) root-prim prim-core action) (collide-action racer))
             (set! (-> this bob-offset) 0.0))
           (set! (-> this height) (+ (-> this base-height) (-> this ocean-offset) (-> this bob-offset) (-> this align-offset)))
           (set! (-> this surface-height) (+ (-> this base-height) (-> this real-ocean-offset)))
           (set! (-> this swim-depth) (fmax 0.0 (- (- (-> this surface-height) (-> this swim-height)) (-> this bottom 0 y))))
           (>= (-> this height) (-> this bottom 0 y)))
         (if (logtest? (-> (the-as collide-shape-moving (-> this process root)) status) (collide-status on-water))
           (set-time! (-> this on-water-time)))
         (set! (-> this drip-wetness) 1.0)
         (set! (-> this drip-height) (fmax (- (-> this surface-height) (-> this bottom 0 y)) (-> this drip-height)))
         (set! (-> this drip-speed) 15.0)
         (if (not (logtest? (-> this flag) (water-flag touch-water))) (enter-water! this))
         ;; A visible full-LOD owner emits a directional wake while its top point remains above
         ;; water. Crossing upward through the surface creates a small splash.
         (cond
           ((>= (-> this top 0 y) (-> this height))
            (let ((surface-position (new 'stack-no-clear 'vector)))
              (vector-copy! surface-position (-> this bottom 0))
              (vector-xz-length (-> this process root transv))
              (set! (-> surface-position y) (-> this surface-height))
              (when (and (logtest? (-> this process draw status) (draw-status was-drawn))
                         (zero? (-> this process draw cur-lod))
                         (logtest? (water-flag part-rings) (-> this flag))
                         (logtest? (water-flag part-water) (-> this flag)))
                (let ((heading (y-angle (-> this process root)))
                      (xz-speed (vector-xz-length (-> this process root transv))))
                  (set! (-> *part-id-table* 118 init-specs 4 initial-valuef) (+ 24576.0 heading))
                  (set! (-> *part-id-table* 118 init-specs 19 initial-valuef) (+ 49152.0 heading))
                  (set! (-> *part-id-table* 118 init-specs 1 initial-valuef) (* 0.0000036621095 xz-speed))
                  (set! (-> *part-id-table* 118 init-specs 2 initial-valuef) (/ xz-speed 10))
                  (set! (-> *part-id-table* 118 init-specs 13 initial-valuef) 0.7111111)
                  (launch-particles :system *sp-particle-system-3d* (-> *part-id-table* 118) surface-position)
                  (set! (-> *part-id-table* 121 init-specs 1 initial-valuef) (* 0.000004150391 xz-speed))
                  (set! (-> *part-id-table* 121 init-specs 18 initial-valuef) heading)
                  (launch-particles :system *sp-particle-system-3d* (-> *part-id-table* 121) surface-position)
                  (when (< xz-speed 4096.0)
                    (set! (-> *part-id-table* 112 init-specs 4 random-rangef) (-> this ripple-size))
                    (launch-particles :system *sp-particle-system-3d* (-> *part-id-table* 112) surface-position)
                    (launch-particles :system *sp-particle-system-3d* (-> *part-id-table* 115) surface-position))))
              (if (< (-> this top 1 y) (-> this height)) (create-splash this 0.2 surface-position 1 (-> this process root transv)))))
           (else (logior! (-> this flag) (water-flag head-under-water))))
         (when (and (logtest? (-> this flag) (water-flag part-splash)) (logtest? (water-flag part-water) (-> this flag)))
           ;; Spray falls from a random articulated joint. Its rate fades after entry and increases
           ;; with horizontal speed.
           (let* ((spray-joint-index (rand-vu-int-range 3 (+ (-> this process node-list length) -1)))
                  (spray-position (vector<-cspace! (new 'stack-no-clear 'vector) (-> this process node-list data spray-joint-index))))
             (set! (-> *part-id-table* 110 init-specs 16 initial-valuef) (-> this surface-height))
             (set! (-> *part-id-table* 110 init-specs 1 initial-valuef)
                   (+ (lerp-scale 12.0 0.4 (the float (- (current-time) (-> this enter-water-time))) 0.0 600.0)
                      (* 0.00012207031 (vector-xz-length (-> this process root transv)))))
             (launch-particles (-> *part-id-table* 110) spray-position)
             (set! (-> *part-id-table* 111 init-specs 16 initial-valuef) (-> this surface-height))
             (launch-particles (-> *part-id-table* 111) spray-position)))
         ;; Classify the root against the effective swim line. Existing swimming has a small depth
         ;; hysteresis; a new swim also requires speed, recent entry, or sufficient depth after
         ;; discounting the moving-surface offsets.
         (let ((swim-line-y (- (+ (-> this base-height) (-> this ocean-offset) (-> this bob-offset) (-> this align-offset)) (-> this swim-height))))
           (let* ((owner-root (-> this process root))
                  (root-control (if (and (nonzero? owner-root) (type-type? (-> owner-root type) control-info)) owner-root))
                  (recent-surface? (and root-control (not (time-elapsed? (-> (the-as control-info root-control) last-time-on-surface) (seconds 0.5))))))
             (if (and (logtest? (-> this flag) (water-flag swim-ground))
                      (and recent-surface?
                           (not (logtest? (-> (the-as collide-shape-moving (-> this process root)) status) (collide-status on-water)))))
               (set! (-> this bob amp) (* 0.8 (-> this bob amp))))
             (cond
               ((and (logtest? (-> this flag) (water-flag can-swim))
                     (or (logtest? (-> (the-as collide-shape-moving (-> this process root)) status) (collide-status on-water))
                         (>= swim-line-y (-> this bottom 0 y))
                         (and (logtest? old-flags (water-flag swimming))
                              (logtest? (-> (the-as collide-shape-moving (-> this process root)) status) (collide-status touch-surface))
                              (not (logtest? (-> (the-as collide-shape-moving (-> this process root)) status) (collide-status on-surface)))
                              (>= (+ 204.8 swim-line-y) (-> this bottom 0 y))))
                     (or (logtest? old-flags (water-flag swimming))
                         (< 12288.0 (vector-xz-length (-> this process root transv)))
                         (< (+ (current-time) (seconds -0.2)) (-> this enter-water-time))
                         (>= (+ (- 204.8 (fmin 6144.0 (+ (-> this ocean-offset) (-> this bob-offset) (-> this align-offset)))) swim-line-y)
                             (-> this bottom 0 y))))
                (set-time! (-> this swim-time))
                (send-event (-> this process) 'swim)
                (logior! (-> this flag) (water-flag swimming))
                (if (not (logtest? old-flags (water-flag swimming))) (set-time! (-> this enter-swim-time)))
                (cond
                  ((and (logtest? (-> this flag) (water-flag swim-ground))
                        (logtest? (-> (the-as collide-shape-moving (-> this process root)) status) (collide-status touch-surface))
                        (not (logtest? (water-flag jump-out) (-> this flag))))
                   (let ((float-position (new 'stack-no-clear 'vector)))
                     (vector-copy! float-position (-> this bottom 0))
                     (set! (-> float-position y) (- (-> this height) (-> this swim-height)))
                     (let ((floating-shape (-> this process root)))
                       (when (and (not (logtest? (-> (the-as collide-shape-moving floating-shape) status) (collide-status touch-background)))
                                  (logtest? (-> this flag) (water-flag swimming))
                                  (not (logtest? (-> (the-as collide-shape-moving floating-shape) root-prim prim-core action) (collide-action racer))))
                         (let ((to-line-velocity (vector-! (new 'stack-no-clear 'vector) float-position (-> floating-shape trans))))
                           (vector-float*! to-line-velocity to-line-velocity (-> *display* frames-per-second))
                           (integrate-and-collide! (the-as collide-shape-moving floating-shape) to-line-velocity))
                         (logior! (-> (the-as collide-shape-moving floating-shape) status)
                                  (collide-status on-surface on-ground touch-surface on-water))))))
                  ((and (< (-> this bottom 0 y) swim-line-y) (not (logtest? (water-flag jump-out) (-> this flag))))
                   (logior! (-> this flag) (water-flag under-water)))))
               ((begin
                  ;; Reuse the recent-contact value for the complete wading predicate.
                  (set! recent-surface?
                        (and (logtest? (-> this flag) (water-flag can-wade))
                             (or (not (!= (-> this bob amp) 0.0)) (time-elapsed? (-> this swim-time) (seconds 0.05)))
                             (and (>= (- (-> this height) (-> this wade-height)) (-> this bottom 0 y)) recent-surface?)))
                  recent-surface?)
                (set-time! (-> this wade-time))
                (send-event (-> this process) 'wade)
                (logior! (-> this flag) (water-flag wading)))))
           ;; Catch an under-water swimmer that crossed upward through the swim line. Preserve the
           ;; impact velocity so this correction does not look like a landing.
           (when (and (logtest? (-> this flag) (water-flag can-swim))
                      (< (-> this bottom 1 y) swim-line-y)
                      (and (< swim-line-y (-> this bottom 0 y)) (logtest? old-flags (water-flag under-water))))
             (logior! (-> this flag) (water-flag swimming))
             (let ((snap-position (new 'stack-no-clear 'vector)))
               (vector-copy! snap-position (-> this bottom 0))
               (let ((surfacing-shape (-> this process root)))
                 (set! (-> snap-position y) swim-line-y)
                 (when (not (logtest? (-> (the-as collide-shape-moving surfacing-shape) root-prim prim-core action) (collide-action racer)))
                   (let ((saved-impact-velocity (-> (the-as collide-shape-moving surfacing-shape) ground-impact-vel)))
                     (move-to-ground-point! (the-as collide-shape-moving surfacing-shape)
                                            snap-position
                                            (-> surfacing-shape transv)
                                            *up-vector*)
                     (logior! (-> (the-as collide-shape-moving surfacing-shape) status) (collide-status on-water))
                     (set! (-> (the-as collide-shape-moving surfacing-shape) ground-impact-vel) saved-impact-velocity)))))))
         ;; Tar holds the target on a tar surface, applies its attack below the sink line, and
         ;; gradually increases the swim depth from the entry value toward 1.8 meters.
         (when (and (logtest? (water-flag tar) (-> this flag)) (= (-> this process type) target))
           (when (and (logtest? (-> (the-as collide-shape-moving (-> this process root)) status) (collide-status on-surface on-water))
                      (not (logtest? (-> (the-as collide-shape-moving (-> this process root)) root-prim prim-core action) (collide-action racer))))
             (when (< (-> this process root trans y) -409.6)
               (send-event (-> this process) 'no-look-around (seconds 1.5))
               (when (not (logtest? (-> (the-as collide-shape-moving (-> this process root)) root-prim prim-core action) (collide-action flut)))
                 (cond
                   ((= (-> this process type) target)
                    (send-event (-> this process)
                                'attack
                                #f
                                (static-attack-info ((shove-up (meters 0.5)) (shove-back (meters 0)) (mode 'tar)))))
                   (else
                    (let ((attack-message (new 'stack-no-clear 'event-message-block)))
                      (set! (-> attack-message from) pp)
                      (set! (-> attack-message num-params) 4)
                      (set! (-> attack-message message) 'attack)
                      (set! (-> attack-message param 0) (the-as uint #f))
                      (set! (-> attack-message param 1) (the-as uint 'tar))
                      (let ((attack-id (+ *global-attack-id* 1)))
                        (set! *global-attack-id* attack-id)
                        (set! (-> attack-message param 2) (the-as uint attack-id)))
                      (set! (-> attack-message param 3) (the-as uint 0))
                      (send-event-function (-> this process) attack-message)))))
               (let ((owner-process (-> this process)))
                 (set! (-> (the-as collide-shape-moving (-> owner-process root)) surf) *tar-surface*)
                 (set! (-> (the-as collide-shape-moving (-> owner-process root)) ground-pat material) 4)))
             (set! (-> this swim-height) (lerp (-> this swim-height) 7372.8 0.05)))))
        (else (if (logtest? (-> this flag) (water-flag touch-water)) (exit-water! this)))))
    ;; Alternate between selecting a joint that was submerged and emitting a drip from its current
    ;; position. Each drip reduces wetness and increases the interval before the next one.
    (when (not (or (not (logtest? (-> this flag) (water-flag part-drip)))
                   (not (logtest? (water-flag part-water) (-> this flag)))
                   (= (-> this drip-wetness) 0.0)))
      (cond
        ((logtest? (-> this flag) (water-flag spawn-drip))
         (let ((drip-position (vector<-cspace! (new 'stack-no-clear 'vector) (-> this process node-list data (-> this drip-joint-index)))))
           (set! (-> *part-id-table* 145 init-specs 16 initial-valuef) (fmax (-> this surface-height) (-> this bottom 0 y)))
           (set! (-> *part-id-table* 145 init-specs 8 initial-valuef) (* 0.05 (- (-> drip-position x) (-> this drip-old-pos x))))
           (set! (-> *part-id-table* 145 init-specs 9 initial-valuef) (* 0.05 (- (-> drip-position y) (-> this drip-old-pos y))))
           (set! (-> *part-id-table* 145 init-specs 10 initial-valuef) (* 0.05 (- (-> drip-position z) (-> this drip-old-pos z))))
           (launch-particles (-> *part-id-table* 145) drip-position))
         (set-time! (-> this drip-time))
         (logclear! (-> this flag) (water-flag spawn-drip))
         (seek! (-> this drip-wetness) 0.0 (/ (-> this drip-speed) 1000))
         (set! (-> this drip-speed) (* 1.05 (-> this drip-speed)))
         (if (= (-> this drip-wetness) 0.0) (set! (-> this drip-height) 0.0)))
        ;; drip-mult intentionally divides the saved time stamp rather than the interval.
        ((time-elapsed? (the-as time-frame (the int (/ (the float (-> this drip-time)) (-> this drip-mult))))
                        (the int (-> this drip-speed)))
         (let* ((candidate-joint-index (rand-vu-int-range 3 (+ (-> this process node-list length) -1)))
                (candidate-position (vector<-cspace! (new 'stack-no-clear 'vector) (-> this process node-list data candidate-joint-index))))
           (when (and (< (- (-> candidate-position y) (-> this process root trans y)) (-> this drip-height))
                      (< (-> this height) (-> candidate-position y)))
             (set! (-> this drip-joint-index) candidate-joint-index)
             (vector-copy! (-> this drip-old-pos) candidate-position)
             (logior! (-> this flag) (water-flag spawn-drip)))))))
    0
    (none)))

(defmethod start-bobbing! ((this water-control) (amplitude float) (period-ticks int) (duration-ticks int))
  "Ask the bob smush-control to start a water-line waveform with the negative of
   amplitude, subject to its restart guard. period-ticks and duration-ticks are game-time ticks; the
   amplitude decays by 0.9 after each period."
  (activate! (-> this bob) (- amplitude) period-ticks duration-ticks 0.9 1.0)
  0
  (none))

(defun part-water-splash-callback ((tracker part-tracker))
  "Configure the shared splash particle definitions from the tracker's surface height and scale.
   This adjusts droplet kill heights plus the launch counts, positions, velocities, and ring sizes."
  (let ((surface-y (-> tracker root trans y))
        (splash-scale (the-as float (-> tracker userdata))))
    (set! (-> *part-id-table* 128 init-specs 16 initial-valuef) surface-y)
    (set! (-> *part-id-table* 132 init-specs 18 initial-valuef) surface-y)
    (set! (-> *part-id-table* 125 init-specs 16 initial-valuef) surface-y)
    (set! (-> *part-id-table* 129 init-specs 15 initial-valuef) surface-y)
    (set! (-> *part-id-table* 133 init-specs 15 initial-valuef) surface-y)
    (set! (-> *part-id-table* 129 init-specs 12 initial-valuef) (* 13.653334 (* -0.15 splash-scale)))
    (set! (-> *part-id-table* 129 init-specs 12 random-rangef) (* 13.653334 (* -0.075 splash-scale)))
    (set! (-> *part-id-table* 133 init-specs 12 initial-valuef) (* 13.653334 (* -0.15 splash-scale)))
    (set! (-> *part-id-table* 133 init-specs 12 random-rangef) (* 13.653334 (* -0.075 splash-scale)))
    (set! (-> *part-id-table* 131 init-specs 2 initial-valuef) (* 4096.0 (/ splash-scale 10)))
    (set! (-> *part-id-table* 131 init-specs 2 random-rangef) (* 4096.0 (* 0.4 splash-scale)))
    (set! (-> *part-id-table* 131 init-specs 4 initial-valuef) (* 4096.0 (/ splash-scale 10)))
    (set! (-> *part-id-table* 131 init-specs 4 random-rangef) (* 4096.0 (* 0.4 splash-scale)))
    (set! (-> *part-id-table* 131 init-specs 9 initial-valuef) (* 13.653334 (* 1.5 splash-scale)))
    (set! (-> *part-id-table* 131 init-specs 9 random-rangef) (* 13.653334 (* 3.4 splash-scale)))
    (set! (-> *part-id-table* 131 init-specs 10 initial-valuef) (* 13.653334 (* 1.5 splash-scale)))
    (set! (-> *part-id-table* 131 init-specs 10 random-rangef) (* 13.653334 (* 3.4 splash-scale)))
    (set! (-> *part-id-table* 126 init-specs 2 initial-valuef) (* 4096.0 (* 3.0 splash-scale)))
    (set! (-> *part-id-table* 126 init-specs 2 random-rangef) (* 4096.0 (* 2.0 splash-scale)))
    (set! (-> *part-id-table* 126 init-specs 4 initial-valuef) (* 4096.0 (* 3.0 splash-scale)))
    (set! (-> *part-id-table* 126 init-specs 4 random-rangef) (* 4096.0 (* 2.0 splash-scale)))
    (set! (-> *part-id-table* 126 init-specs 9 initial-valuef) (* 13.653334 (* 1.5 splash-scale)))
    (set! (-> *part-id-table* 126 init-specs 9 random-rangef) (* 13.653334 (* 1.4 splash-scale)))
    (set! (-> *part-id-table* 126 init-specs 10 initial-valuef) (* 13.653334 (* 1.5 splash-scale)))
    (set! (-> *part-id-table* 126 init-specs 10 random-rangef) (* 13.653334 (* 1.4 splash-scale)))
    (set! (-> *part-id-table* 127 init-specs 2 initial-valuef) (* 4096.0 (/ splash-scale -2)))
    (set! (-> *part-id-table* 127 init-specs 2 random-rangef) (* 4096.0 splash-scale))
    (set! (-> *part-id-table* 127 init-specs 3 initial-valuef) (* 4096.0 (/ splash-scale -2)))
    (set! (-> *part-id-table* 127 init-specs 3 random-rangef) (* 4096.0 splash-scale))
    (set! (-> *part-id-table* 127 init-specs 4 initial-valuef) (* 4096.0 (/ splash-scale 2)))
    (set! (-> *part-id-table* 127 init-specs 4 random-rangef) (* 4096.0 splash-scale))
    (set! (-> *part-id-table* 127 init-specs 6 initial-valuef) (* 4096.0 (/ splash-scale 2)))
    (set! (-> *part-id-table* 127 init-specs 6 random-rangef) (* 4096.0 splash-scale))
    (set! (-> *part-id-table* 127 init-specs 11 initial-valuef) (* 13.653334 (* 1.5 splash-scale)))
    (set! (-> *part-id-table* 127 init-specs 11 random-rangef) (* 13.653334 splash-scale))
    (set! (-> *part-id-table* 127 init-specs 12 initial-valuef) (* 13.653334 (* 1.5 splash-scale)))
    (set! (-> *part-id-table* 127 init-specs 12 random-rangef) (* 13.653334 splash-scale))
    (set! (-> *part-id-table* 132 init-specs 1 initial-valuef) (* 4.0 splash-scale))
    (set! (-> *part-id-table* 132 init-specs 2 initial-valuef) (* 4096.0 (/ splash-scale -4)))
    (set! (-> *part-id-table* 132 init-specs 2 random-rangef) (* 4096.0 (/ splash-scale 2)))
    (set! (-> *part-id-table* 132 init-specs 3 initial-valuef) (* 4096.0 (/ splash-scale -4)))
    (set! (-> *part-id-table* 132 init-specs 3 random-rangef) (* 4096.0 (/ splash-scale 2)))
    (set! (-> *part-id-table* 132 init-specs 10 initial-valuef) (* 13.653334 (* -0.75 splash-scale)))
    (set! (-> *part-id-table* 132 init-specs 10 random-rangef) (* 13.653334 (* 1.5 splash-scale)))
    (set! (-> *part-id-table* 132 init-specs 12 initial-valuef) (* 13.653334 (* -0.75 splash-scale)))
    (set! (-> *part-id-table* 132 init-specs 12 random-rangef) (* 13.653334 (* 1.5 splash-scale)))
    (set! (-> *part-id-table* 132 init-specs 11 initial-valuef) (* 13.653334 (* 7.0 splash-scale)))
    (set! (-> *part-id-table* 132 init-specs 11 random-rangef) (* 13.653334 (* 2.0 splash-scale)))
    (set! (-> *part-id-table* 132 init-specs 15 initial-valuef) (* 13.653334 (* -0.3 splash-scale)))
    (set! (-> *part-id-table* 132 init-specs 15 random-rangef) (* 13.653334 (* -0.075 splash-scale)))
    (set! (-> *part-id-table* 128 init-specs 1 initial-valuef) (* 4.0 splash-scale))
    (set! (-> *part-id-table* 128 init-specs 2 initial-valuef) (* 1.2 splash-scale))
    (set! (-> *part-id-table* 128 init-specs 9 initial-valuef) (* 13.653334 splash-scale))
    (set! (-> *part-id-table* 128 init-specs 9 random-rangef) (* 13.653334 (* 2.0 splash-scale)))
    (set! (-> *part-id-table* 128 init-specs 10 initial-valuef) (* 13.653334 (* 6.0 splash-scale)))
    (set! (-> *part-id-table* 128 init-specs 10 random-rangef) (* 13.653334 (* 2.0 splash-scale)))
    (set! (-> *part-id-table* 128 init-specs 13 initial-valuef) (* 13.653334 (* -0.3 splash-scale)))
    (set! (-> *part-id-table* 128 init-specs 13 random-rangef) (* 13.653334 (* -0.075 splash-scale)))
    (set! (-> *part-id-table* 128 init-specs 9 initial-valuef) (* 13.653334 splash-scale))
    (set! (-> *part-id-table* 128 init-specs 9 random-rangef) (* 13.653334 (* 2.0 splash-scale)))
    (set! (-> *part-id-table* 128 init-specs 10 initial-valuef) (* 13.653334 (* 6.0 splash-scale)))
    (set! (-> *part-id-table* 128 init-specs 10 random-rangef) (* 13.653334 (* 2.0 splash-scale)))
    (set! (-> *part-id-table* 128 init-specs 13 initial-valuef) (* 13.653334 (* -0.3 splash-scale)))
    (set! (-> *part-id-table* 128 init-specs 13 random-rangef) (* 13.653334 (* -0.075 splash-scale)))
    (set! (-> *part-id-table* 125 init-specs 1 initial-valuef) (* 8.0 splash-scale))
    (set! (-> *part-id-table* 125 init-specs 2 initial-valuef) (* 4096.0 splash-scale))
    (set! (-> *part-id-table* 125 init-specs 9 initial-valuef) (* 13.653334 splash-scale))
    (set! (-> *part-id-table* 125 init-specs 9 random-rangef) (* 13.653334 (* 2.0 splash-scale)))
    (set! (-> *part-id-table* 125 init-specs 10 initial-valuef) (* 13.653334 (* 6.0 splash-scale)))
    (set! (-> *part-id-table* 125 init-specs 10 random-rangef) (* 13.653334 (* 2.0 splash-scale)))
    (set! (-> *part-id-table* 125 init-specs 13 initial-valuef) (* 13.653334 (* -0.3 splash-scale)))
    (set! (-> *part-id-table* 125 init-specs 13 random-rangef) (* 13.653334 (* -0.075 splash-scale)))
    (set! (-> *part-id-table* 124 init-specs 2 initial-valuef) (* 4096.0 (* 1.2 splash-scale)))
    (set! (-> *part-id-table* 124 init-specs 2 random-rangef) (* 4096.0 (/ splash-scale 5)))
    (set! (-> *part-id-table* 124 init-specs 3 initial-valuef) (* 4096.0 (* 0.4 splash-scale)))
    (set! (-> *part-id-table* 124 init-specs 3 random-rangef) (* 4096.0 (* 1.2 splash-scale)))
    (set! (-> *part-id-table* 124 init-specs 7 initial-valuef) (* 4096.0 (/ splash-scale 5)))
    (set! (-> *part-id-table* 124 init-specs 7 random-rangef) (* 4096.0 (* 2.2 splash-scale)))
    (set! (-> *part-id-table* 130 init-specs 2 initial-valuef) (* 4096.0 (* 0.3 splash-scale)))
    (set! (-> *part-id-table* 130 init-specs 2 random-rangef) (* 4096.0 (* 0.9 splash-scale)))
    (set! (-> *part-id-table* 130 init-specs 6 initial-valuef) (* 4096.0 splash-scale))
    (set! (-> *part-id-table* 130 init-specs 6 random-rangef) (* 4096.0 (* 2.2 splash-scale))))
  0
  (none))

(defmethod enter-water! ((this water-control))
  "Record first contact with the surface and clear jump-out. When particles are
   enabled, query the owner for ground-height, map values from 2,048 through 24,576 to splash scales
   from 0.3 through 1, play the swim-stroke effect, and create the entry splash. Restore tar's initial
   swim depth."
  (with-pp
    (logior! (-> this flag) (water-flag touch-water))
    (logclear! (-> this flag) (water-flag jump-out))
    (set-time! (-> this enter-water-time))
    (set-vector! (-> this enter-water-pos) (-> this bottom 0 x) (-> this surface-height) (-> this bottom 0 z) 1.0)
    (when (and (logtest? (-> this flag) (water-flag part-splash)) (logtest? (water-flag part-water) (-> this flag)))
      (let ((query-message (new 'stack-no-clear 'event-message-block)))
        (set! (-> query-message from) pp)
        (set! (-> query-message num-params) 1)
        (set! (-> query-message message) 'query)
        (set! (-> query-message param 0) (the-as uint 'ground-height))
        (let* ((ground-height (the-as float (send-event-function (-> this process) query-message)))
               (splash-scale (lerp-scale 0.3 1.0 ground-height 2048.0 24576.0)))
          (if (nonzero? (-> this process skel effect)) (do-effect (-> this process skel effect) 'swim-stroke 0.0 -1))
          (create-splash this splash-scale (-> this enter-water-pos) 1 (-> this process root transv)))))
    (if (logtest? (water-flag tar) (-> this flag)) (set! (-> this swim-height) 2867.2))
    0
    (none)))

(defmethod exit-water! ((this water-control))
  "Clear the touch-water state, stop surface bobbing, and restore tar's initial swim
   depth when the process leaves the water."
  (logclear! (-> this flag) (water-flag touch-water))
  (set-zero! (-> this bob))
  (if (logtest? (water-flag tar) (-> this flag)) (set! (-> this swim-height) 2867.2))
  0
  (none))

(defun splash-spawn ((scale basic) (position basic) (size int))
  "Spawn a splash tracker at position with scale stored as its callback userdata. size zero selects
   the small splash group; other values select the full group."
  (process-spawn part-tracker
                 :init
                 part-tracker-init
                 (if (zero? size) group-part-water-splash-small group-part-water-splash)
                 -1
                 part-water-splash-callback
                 scale
                 #f
                 position
                 :to
                 *entity-pool*)
  0
  (none))

(defmethod create-splash ((this water-control) (scale float) (position vector) (size int) (velocity vector))
  "Create a splash at position, led by five percent of velocity and pinned to the
   raw surface height. size zero selects the small particle group; other values select the full group.
   The control's splash and master water-particle flags must both be enabled."
  (when (and (logtest? (-> this flag) (water-flag part-splash)) (logtest? (water-flag part-water) (-> this flag)))
    (let ((splash-position (vector+float*! (new 'stack-no-clear 'vector) position velocity 0.05)))
      (set! (-> splash-position y) (-> this surface-height))
      (splash-spawn (the-as basic scale) (the-as basic splash-position) size)))
  0
  (none))

(defmethod on-exit-water ((this water-vol))
  "Clear the volume-supplied state from the claimed target, unlink both handles,
   notify other water volumes so an overlap can claim it immediately, and release this process's
   no-kill status."
  (when (handle->process (-> this target))
    (let ((target-water (-> (the-as target (-> this target process 0)) water)))
      (logclear! (-> target-water flag)
                 (water-flag active
                             can-wade
                             can-swim
                             use-ocean
                             tar
                             mud
                             deadly
                             use-ripple-offset
                             no-grab-sound
                             part-water
                             dark-eco
                             lava
                             wt26))
      (set! (-> target-water volume) (the-as handle #f)))
    (set! (-> this target) (the-as handle #f))
    (iterate-process-tree *entity-pool*
                          (lambda ((other-volume water-vol))
                            (with-pp
                              (if (and (type-type? (-> other-volume type) water-vol) (!= other-volume pp)) (send-event other-volume 'update))))
                          *null-kernel-context*)
    (process-entity-status! this (entity-perm-status no-kill) #f))
  0
  (none))

(defmethod update! ((this water-vol))
  "Release the claimed target after it leaves the volume, or apply the configured damage
   while it remains in deadly water. When unclaimed, acquire the global target on entry, copy this
   volume's flags and available depth thresholds into its water-control, and retain this process until
   the claim is released."
  (cond
    ((handle->process (-> this target))
     (cond
       ((not (point-in-vol? (-> this vol) (-> (the-as target (-> this target process 0)) control trans))) (on-exit-water this))
       (else
        (let ((claimed-water (-> (the-as target (-> this target process 0)) water)))
          (when (and (logtest? (water-flag deadly) (-> this flag))
                     (logtest? (-> claimed-water flag) (water-flag touch-water))
                     (>= (-> claimed-water surface-height) (-> claimed-water bottom 0 y)))
            (let ((attack-event (-> this attack-event)))
              (case attack-event
                ((#f))
                (('heat) (send-event (handle->process (-> this target)) 'heat (* 10.0 (seconds-per-frame))))
                (('drown-death 'lava 'dark-eco-pool)
                 (if (send-event (handle->process (-> this target)) 'attack-invinc #f (static-attack-info ((mode attack-event))))
                   (send-event this 'notify 'attack)))
                (else
                 (if (send-event (handle->process (-> this target)) 'attack #f (static-attack-info ((mode attack-event))))
                   (send-event this 'notify 'attack))))))))))
    ((and *target*
          (and (not (handle->process (-> *target* water volume))) (point-in-vol? (-> this vol) (-> *target* control trans))))
     (let ((candidate-water (-> *target* water)))
       (process-entity-status! this (entity-perm-status no-kill) #t)
       (set! (-> candidate-water volume) (process->handle this))
       (set! (-> this target) (process->handle *target*))
       (logior! (-> candidate-water flag) (water-flag active))
       (set! (-> candidate-water base-height) (-> this water-height))
       (set! (-> candidate-water ocean-offset) 0.0)
       (logior! (-> candidate-water flag) (-> this flag))
       (if (< 0.0 (-> this wade-height)) (set! (-> candidate-water wade-height) (-> this wade-height)))
       (if (< 0.0 (-> this swim-height)) (set! (-> candidate-water swim-height) (-> this swim-height)))
       (if (< 0.0 (-> this bottom-height)) (set! (-> candidate-water bottom-height) (-> this bottom-height)))
       (set-zero! (-> candidate-water bob)))))
  0
  (none))

(defstate water-vol-startup (water-vol)
  :virtual #t
  :code
    (behavior ()
      (go-virtual water-vol-idle)))

(defstate water-vol-idle (water-vol)
  :virtual #t
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('update) (update! self))))
  :exit
    (behavior ()
      (on-exit-water self))
  :trans
    (behavior ()
      (update! self))
  :code anim-loop)

(defmethod set-stack-size! ((this water-vol))
  "Use a 128-byte stack for the volume's small state thread."
  (stack-size-set! (-> this main-thread) 128)
  (none))

(defmethod reset-root! ((this water-vol))
  "Install a plain transform root; containment is tested with the separate volume
   control."
  (set! (-> this root) (new 'process 'trsqv))
  (none))

(defmethod setup-from-res! ((this water-vol))
  "Apply subtype-specific resource setup before water setup. Specialized
   volumes use this hook for resource look, translation offset, and rotation offset; the base
   implementation is empty."
  0
  (none))

(defmethod init! ((this water-vol))
  "Build the volume from its entity. Read attack-event with drown as the default, create
   the volume control, and read water-height as surface, wade depth, swim depth, optional flags, and
   optional bottom depth. Enable ordinary water particles after loading the data."
  (set! (-> this attack-event)
        (the-as symbol
                ((method-of-type res-lump get-property-struct)
                 (-> this entity)
                 'attack-event
                 'interp
                 -1000000000.0
                 'drown
                 (the-as (pointer res-tag) #f)
                 *res-static-buf*)))
  (process-drawable-from-entity! this (-> this entity))
  (logclear! (-> this mask) (process-mask actor-pause))
  (set! (-> this vol) (new 'process 'vol-control this))
  (logior! (-> this vol flags) (vol-flags display-marks debug-alloc))
  (set! (-> this bottom-height) 32768.0)
  (set! (-> this target) (the-as handle #f))
  (let* ((water-height-tag (new 'static 'res-tag))
         (heights (the-as (pointer float)
                          ((method-of-type res-lump get-property-data)
                           (-> this entity)
                           'water-height
                           'exact
                           -1000000000.0
                           (the-as pointer #f)
                           (& water-height-tag)
                           *res-static-buf*))))
    (when heights
      (set! (-> this water-height) (-> heights 0))
      (set! (-> this wade-height) (-> heights 1))
      (set! (-> this swim-height) (-> heights 2))
      (if (>= (-> water-height-tag elt-count) (the-as uint 4)) (set! (-> this flag) (the-as water-flag (the int (-> heights 3)))))
      (if (>= (-> water-height-tag elt-count) (the-as uint 5)) (set! (-> this bottom-height) (-> heights 4)))))
  (logior! (-> this flag) (water-flag part-water))
  ;; part-water is already set, so this fallback cannot currently derive the capability flags.
  (cond
    ((zero? (-> this flag))
     (if (< 0.0 (-> this wade-height)) (logior! (-> this flag) (water-flag can-wade)))
     (if (< 0.0 (-> this swim-height)) (logior! (-> this flag) (water-flag can-swim))))
    (else))
  (none))

(defmethod setup-water! ((this water-vol))
  "Perform subtype-specific water setup. Animated and specialized volumes install
   their skeleton, animation, ambient sound, ripple, or tint state here; the base implementation is
   empty."
  0
  (none))

(defbehavior water-vol-init-by-other water-vol ((source-entity entity-actor))
  "Initialize a water volume spawned by another process. Install source-entity, build the root and
   resource state, run both subtype setup hooks, and enter the startup state."
  (set! (-> self entity) source-entity)
  (set-stack-size! self)
  (reset-root! self)
  (init! self)
  (setup-from-res! self)
  (setup-water! self)
  (go-virtual water-vol-startup)
  (none))

(defmethod init-from-entity! ((this water-vol) (source-entity entity-actor))
  "Finish initialization after the entity system has installed this volume's entity. Build the
   root and resource state, run both subtype setup hooks, and enter the startup state. The supplied
   entity argument is not read by this implementation."
  (set-stack-size! this)
  (reset-root! this)
  (init! this)
  (setup-from-res! this)
  (setup-water! this)
  (go (method-of-object this water-vol-startup))
  (none))

;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/camera/camera.gc")
(require "engine/common-obs/process-drawable.gc")
(require "engine/game/settings.gc")

;; DECOMP BEGINS

;; Camera companion for the animated speaker. It uses the ordinary cam-string controls and remains
;; active only while the camera master is tracking a drawable target.
(deftype camera-voicebox (camera-slave) ()
  (:states
   cam-voicebox))

;; The speaker has its own drawable but is parented beneath camera-voicebox. blend is zero at the
;; camera-side endpoint and one at Jak's backpack; seeker eases between those endpoints, and twist
;; asks the camera child to choose a clear side.
(deftype voicebox (process-drawable)
  ((parent-override (pointer camera-voicebox) :overlay-at parent)
   (base-trans      vector :inline)
   (seeker          cam-float-seeker :inline)
   (blend           float)
   (twist           float)
   (hint            handle))
  (:state-methods
   enter
   idle
   exit))

;; Park the camera child here after the speaker has closed.
(defstate empty-state (process)
  :code nothing)

(defskelgroup *voicebox-sg*
  speaker
  speaker-lod0-jg
  speaker-idle-ja
  ((speaker-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 4))

(defbehavior voicebox-track voicebox ()
  "Place the speaker along its blend path between the camera slave and the target's backpack, add a
   slow vertical bob, face the target's mouth, steer the camera toward an unblocked side, and scale
   the model from full size to zero as it enters the backpack."
  (let ((camera-position (new 'stack-no-clear 'vector))
        (target-position (new 'stack-no-clear 'vector)))
    (set! (-> camera-position quad) (-> self parent-override 0 trans quad))
    (set! (-> target-position quad) (-> (target-pos (joint-node-index eichar-lod0-jg packStrapMid)) quad))
    (when *target*
      (let ((target-forward (vector-z-quaternion! (new-stack-vector0) (-> *target* control quat-for-control))))
        ;; The offset vanishes at both endpoints: blend ignores the target position at zero, and the
        ;; offset itself reaches zero at one. Between them it bows the flight path behind Jak.
        (vector+float*! target-position target-position target-forward (* -16384.0 (- 1.0 (-> self blend))))))
    (vector-lerp! (-> self root trans) camera-position target-position (-> self blend)))
  ;; Bob by 0.4 meters on a 1200-tick cycle.
  (+! (-> self root trans y) (* 1638.4 (sin (* 54.613335 (the float (mod (current-time) 1200))))))
  (let ((facing (new 'stack-no-clear 'quaternion)))
    (forward-up->quaternion facing
                            (vector-normalize! (vector-! (new 'stack-no-clear 'vector)
                                                        (target-pos (joint-node-index eichar-lod0-jg mouth))
                                                        (-> self root trans))
                                               1.0)
                            (new 'static 'vector :y 1.0 :w 1.0))
    (rotate-toward-orientation! (-> self root) facing 65536.0 5461.3335))
  (when *target*
    (let* ((target-control (-> *target* control))
           (voicebox-position (-> self root trans))
           (side-angle (deg-diff (y-angle target-control)
                                 (vector-y-angle (vector-! (new 'stack-no-clear 'vector) voicebox-position (-> target-control trans))))))
      (if (< 0.0 side-angle)
        (seek! (-> self twist) -0.4 (* 0.3 (seconds-per-frame)))
        (seek! (-> self twist) 0.4 (* 0.3 (seconds-per-frame)))))
    (let ((blocked-side-query (new 'stack-no-clear 'event-message-block)))
      (set! (-> blocked-side-query from) self)
      (set! (-> blocked-side-query num-params) 0)
      (set! (-> blocked-side-query message) 'blocked-side?)
      (case (send-event-function (ppointer->process (-> self parent-override)) blocked-side-query)
        ((1) (set! (-> self twist) 0.5))
        ((2) (set! (-> self twist) -0.5))
        ((3) (set! (-> self twist) 0.0))))
    (send-event (ppointer->process (-> self parent-override)) 'joystick (-> self twist) -1.0))
  ;; Stay full-sized through most of the path, then shrink from one to zero while blend crosses
  ;; 0.8..1.0 at the backpack.
  (set! (-> self root scale x) (lerp-scale 1.0 0.0 (-> self blend) 0.8 1.0))
  (set! (-> self root scale y) (-> self root scale x))
  (set! (-> self root scale z) (-> self root scale x))
  0
  (none))

;; Open the speaker from the backpack endpoint to the camera endpoint. The camera child uses tighter
;; distance settings while Jak is riding the racer, and the assistant music flavor remains requested
;; until exit begins.
(defstate enter (voicebox)
  :virtual #t
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('die) (go-virtual exit))))
  :trans
    (behavior ()
      (voicebox-track)
      (if (< 0.1 (-> self blend)) (point-toward-point-clear-roll-pitch! (-> self root) (target-pos 0))))
  :code
    (behavior ()
      (set-setting! 'sound-flava #f 20.0 (music-flava assistant))
      (if (and *target* (logtest? (-> *target* control root-prim prim-core action) (collide-action racer)))
        (send-event (ppointer->process (-> self parent-override))
                    'set-dist
                    (new 'static 'vector :z 8192.0 :w 1.0)
                    (new 'static 'vector :y 20480.0 :z 12288.0 :w 1.0))
        (send-event (ppointer->process (-> self parent-override))
                    'set-dist
                    (new 'static 'vector :z 16384.0 :w 1.0)
                    (new 'static 'vector :y 20480.0 :z 40960.0 :w 1.0)))
      (init-cam-float-seeker (-> self seeker) 1.0 0.01 0.022222223 0.1)
      (set! (-> self seeker target) 0.0)
      (while (< 0.0001 (-> self blend))
        (update! (-> self seeker) 0.0)
        (set! (-> self blend) (-> self seeker value))
        (suspend))
      (set! (-> self blend) 0.0)
      (go-virtual idle))
  :post ja-post)

;; Hold the camera-side endpoint and loop the speaker's idle animation.
(defstate idle (voicebox)
  :virtual #t
  :event
    (-> (method-of-type voicebox enter)
        event)
  :trans voicebox-track
  :code
    (behavior ()
      (loop
        (suspend)
        (ja :num! (loop!))))
  :post ja-post)

;; Close the speaker back into the backpack and release the assistant music flavor. If the owning
;; hint process has already disappeared, the close may finish immediately after a short grace period;
;; the camera child is then parked in empty-state.
(defstate exit (voicebox)
  :virtual #t
  :trans voicebox-track
  :code
    (behavior ()
      (remove-setting! 'sound-flava)
      (set-time! (-> self state-time))
      (set! (-> self seeker target) 1.0)
      (while (and (< (-> self blend) 0.9999)
                  (not (and (not (handle->process (-> self hint)))
                            (time-elapsed? (-> self state-time) (seconds 0.05))
                            (-> *setting-control* current hint))))
        (update! (-> self seeker) 0.0)
        (set! (-> self blend) (-> self seeker value))
        (suspend))
      (set! (-> self blend) 1.0)
      (send-event (ppointer->process (-> self parent-override)) 'go empty-state)
      (suspend)
      0)
  :post ja-post)

(defbehavior voicebox-init-by-other voicebox ((position vector) (hint handle))
  "Create the root transform at position, remember the owning hint process handle, initialize the
   speaker skeleton with blend at the target-side endpoint, and enter the appearance state."
  (set! (-> self root) (new 'process 'trsqv))
  (set! (-> self hint) hint)
  (set! (-> self root trans quad) (-> position quad))
  (set! (-> self base-trans quad) (-> position quad))
  (initialize-skeleton self *voicebox-sg* '())
  (set! (-> self blend) 1.0)
  (go-virtual enter)
  (none))

;; Reuse cam-string's controls and deactivate when drawable-target tracking is no longer active.
(defstate cam-voicebox (camera-voicebox)
  :event
    (-> cam-string
        event)
  :enter
    (-> cam-string
        enter)
  :trans
    (behavior ()
      (if (not (logtest? (-> *camera* master-options) 2)) (deactivate self)))
  :code
    (-> cam-string
        code))

(defun voicebox-spawn ((owner process) (position vector))
  "Spawn a camera-voicebox under owner and a voicebox drawable under that camera slave at position.
   Pass the calling process's handle to the drawable so its exit can detect when the hint owner is
   gone. Return the voicebox process pointer, or false if either allocation fails."
  (with-pp
    (let ((camera-child (process-spawn camera-voicebox :init cam-slave-init cam-voicebox #f :from *camera-dead-pool* :to owner)))
      (if camera-child (process-spawn voicebox position (process->handle pp) :to (ppointer->process camera-child))))))

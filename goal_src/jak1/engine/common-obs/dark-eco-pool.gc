;; Query a sparse set of rendered vertices for particle attachment, occasionally emit a surface
;; effect at one of the returned positions, and pulse ripple displacement and normal strength.
(defstate water-vol-idle (dark-eco-pool)
  :virtual #t
  :trans
    (behavior ()
      (let ((parent-transition (-> (method-of-type water-anim water-vol-idle) trans)))
        (if parent-transition (parent-transition)))
      (let* ((ripple-ctrl (-> self draw ripple))
             (time-phase (the float (logand (current-time) #xffff)))
             (ripple-pulse (square (cos (* 5.0 time-phase)))))
        (let ((ripple-query (-> self draw ripple query)))
          (set! (-> self draw ripple send-query) #t)
          (set! (-> ripple-query start-vertex) (rand-vu-int-range 0 255))
          (set! (-> ripple-query vertex-skip) 256)
          (when (zero? (rand-vu-int-range 0 15))
            (when (and (nonzero? (-> ripple-query vertex-count)) (< #x32000 (memory-free *nk-dead-pool*)))
              (let ((vertex-index (rand-vu-int-range 0 (+ (-> ripple-query vertex-count) -1))))
                (process-spawn part-tracker
                               :init
                               part-tracker-init
                               group-dark-eco-pool-nasty
                               -1
                               #f
                               #f
                               #f
                               (-> ripple-query data vertex-index)
                               :to
                               *entity-pool*)))))
        (case (-> self look)
          (((water-look water-anim-misty-dark-eco-pool))
           (set! (-> ripple-ctrl global-scale) (* 4096.0 (* 1.5 (+ 1.0 ripple-pulse))))
           (set! (-> ripple-ctrl individual-normal-scale) (+ 0.5 (/ ripple-pulse 2))))
          (else
           (set! (-> ripple-ctrl global-scale) (* 4096.0 (* 3.0 (+ 1.0 ripple-pulse))))
           (set! (-> ripple-ctrl individual-normal-scale) (+ 0.5 (/ ripple-pulse 2))))))))

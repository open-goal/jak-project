;;-*-Lisp-*-
(in-package goal)
(bundles "GAME.CGO")
(require "engine/nav/navigate.gc")
(require "engine/common-obs/process-taskable.gc")
(require "engine/anim/aligner.gc")
(require "engine/geometry/path.gc")
(require "engine/common-obs/nav-enemy-h.gc")
(declare-type battlecontroller process-drawable)

;; Shared ground-enemy navigation, notice, chase, contact combat, death, and ballistic-jump
;; behavior. Concrete enemy types provide nav-enemy-info tuning and override selected slots.

;; DECOMP BEGINS

(defun nav-enemy-rnd-float ()
  "Return the next float from the global VU random stream."
  (rand-vu))

(defun nav-enemy-rnd-percent? ((chance float))
  "Return true with the supplied probability using the global VU random stream."
  (>= chance (rand-vu)))

(defun nav-enemy-rnd-float-range ((minimum float) (maximum float))
  "Return a random float in the half-open interval from minimum to maximum using the global VU
   random stream."
  (+ minimum (* (rand-vu) (- maximum minimum))))

(defun nav-enemy-rnd-int-count ((count int))
  "Return a random integer from zero through count minus one using the global VU random stream."
  (the int (* (rand-vu) (the float count))))

(defun nav-enemy-rnd-int-range ((minimum int) (maximum int))
  "Return a random integer from minimum through maximum, inclusive, using the global VU random
   stream."
  (+ minimum (the int (* (rand-vu) (the float (+ (- 1 minimum) maximum))))))

(defun nav-enemy-rnd-go-idle? ((base-chance float))
  "Test a random idle-break chance that rises from base-chance toward one as the previous frame's
   run time exceeds 7000 cycles."
  (let* ((frame-run-time (-> *display* frames (-> *display* last-screen) frame run-time))
         (load-factor (fmax 0.0 (fmin 1.0 (* 0.001 (+ -7000.0 (the float frame-run-time)))))))
    (>= (+ base-chance (* load-factor (- 1.0 base-chance))) (rand-vu))))

(defmethod eval-position! ((this trajectory) (elapsed-time float) (result vector))
  "Evaluate position after elapsed-time game-time ticks into result. Vertical motion includes one
   half gravity times time squared; evaluation is not clamped to the solved flight duration."
  (vector+float*! result (-> this initial-position) (-> this initial-velocity) elapsed-time)
  (+! (-> result y) (* (/ elapsed-time 2) elapsed-time (-> this gravity)))
  result)

(defmethod relocate ((this nav-enemy) (offset int))
  "Relocate the process-heap neck controller and random generator when present, then relocate the
   process through the parent method."
  (if (nonzero? (-> this neck)) (set! (-> this neck) (the-as joint-mod (+ (the-as int (-> this neck)) offset))))
  (if (nonzero? (-> this rand-gen))
    (set! (-> this rand-gen) (the-as random-generator (+ (the-as int (-> this rand-gen)) offset))))
  (call-parent-method this offset))

(defmethod new-patrol-point! ((this nav-enemy))
  "Choose a random path vertex for destination-pos, retrying up to three times for a point more than
   one meter away. Keep the final choice if every attempt is nearby."
  (local-vars (found-far-point symbol))
  (if (<= (-> this path curve num-cverts) 0) (go process-drawable-art-error "no path"))
  (let ((tries-left 3))
    0
    (let ((destination (-> this nav destination-pos)))
      (until (or found-far-point (<= tries-left 0))
        (let ((vertex-index (nav-enemy-rnd-int-count (-> this path curve num-cverts))))
          (eval-path-curve-div! (-> this path) destination (the float vertex-index) 'interp))
        (+! tries-left -1)
        (set! found-far-point (< 4096.0 (vector-vector-xz-distance destination (-> this collide-info trans)))))))
  0)

(defmethod common-post ((this nav-enemy))
  "Rearm contact offense after a landed attack, update shadow and player/enemy look-at state, draw
   neck debug information when requested, and post joint animation."
  (when (and (logtest? (-> this nav-enemy-flags) (nav-enemy-flags attack-landed))
             (or (not *target*)
                 (and (not (logtest? (-> *target* state-flags)
                                     (state-flags being-attacked invulnerable timed-invulnerable invuln-powerup do-not-notice dying)))
                      (time-elapsed? (-> this touch-time) (seconds 0.05)))))
    (set-collide-offense (-> this collide-info) 2 (collide-offense touch))
    (logclear! (-> this nav-enemy-flags) (nav-enemy-flags attack-landed)))
  (update-direction-from-time-of-day (-> this draw shadow-ctrl))
  (when *target*
    (if *target*
      (look-at-enemy! (-> *target* neck)
                      (-> this collide-info root-prim prim-core world-sphere)
                      (if (logtest? (-> this nav-enemy-flags) (nav-enemy-flags hostile)) 'attacking)
                      this))
    (if (and (nonzero? (-> this neck)) (logtest? (-> this nav-enemy-flags) (nav-enemy-flags neck-active)))
      (set-target! (-> this neck) (target-pos (-> this nav-info player-look-at-joint)))))
  (when (-> this nav-info debug-draw-neck)
    (if (nonzero? (-> this neck)) (joint-mod-debug-draw (-> this neck))))
  (ja-post)
  0
  (none))

(defmethod touch-handler ((this nav-enemy) (source process) (block event-message-block))
  "When contact attacks are enabled and an offensive primitive is touching, send the configured
   generic attack to the other process."
  (if (and (logtest? (-> this nav-enemy-flags) (nav-enemy-flags attack-enabled))
           ((method-of-type touching-shapes-entry prims-touching?)
            (the-as touching-shapes-entry (-> block param 0))
            (-> this collide-info)
            (the-as uint 1)))
    (nav-enemy-send-attack source (the-as touching-shapes-entry (-> block param 0)) 'generic)))

(defmethod nav-enemy-touch-handler ((this nav-enemy) (source process) (block event-message-block))
  "Handle contact during jump states through a separately overridable slot."
  (if (and (logtest? (-> this nav-enemy-flags) (nav-enemy-flags attack-enabled))
           ((method-of-type touching-shapes-entry prims-touching?)
            (the-as touching-shapes-entry (-> block param 0))
            (-> this collide-info)
            (the-as uint 1)))
    (nav-enemy-send-attack source (the-as touching-shapes-entry (-> block param 0)) 'generic)))

(defmethod nav-enemy-attack-handler ((this nav-enemy) (source process) (block event-message-block))
  "Handle an attack during a jump by crediting the attacker and entering the death state
   unconditionally."
  (send-event source 'get-attack-count 1)
  (logclear! (-> this mask) (process-mask actor-pause attackable))
  (go (method-of-object this nav-enemy-die))
  'die)

(defmethod attack-handler ((this nav-enemy) (source process) (block event-message-block))
  "On an incoming attack, die and credit the attacker while vulnerable; otherwise treat the
   contact as a counterattack opportunity."
  (cond
    ((logtest? (-> this nav-enemy-flags) (nav-enemy-flags vulnerable))
     (send-event source 'get-attack-count 1)
     (logclear! (-> this mask) (process-mask actor-pause attackable))
     (go (method-of-object this nav-enemy-die)))
    (else (touch-handler this source block))))

(defbehavior nav-enemy-send-attack nav-enemy ((target process) (touch-entry touching-shapes-entry) (mode symbol))
  "Send an attack with this enemy's shove settings. On a successful hit, disable further collision
   offense, mark attack-landed, and return true."
  (when (send-event target
                    'attack
                    touch-entry
                    (static-attack-info ((shove-back (-> self nav-info attack-shove-back)) (shove-up (-> self nav-info attack-shove-up)) (mode mode))))
    (set-collide-offense (-> self collide-info) 2 (collide-offense no-offense))
    (logior! (-> self nav-enemy-flags) (nav-enemy-flags attack-landed))
    #t))

(defbehavior nav-enemy-default-event-handler nav-enemy ((source process) (argc int) (message symbol) (block event-message-block))
  "Route touch and attack events, immediate death, scripted jump cues, and forced chase, patrol, or
   waiting states."
  (case message
    (('touch) (set-time! (-> self touch-time)) (touch-handler self source block))
    (('attack) (nav-enemy-set-hit-from-direction source) (attack-handler self source block))
    (('instant-death)
     (let ((hit-direction (-> self hit-from-dir)))
       (vector-z-quaternion! hit-direction (-> self collide-info quat))
       (vector-float*! hit-direction hit-direction -1.0)
       (vector-normalize! hit-direction 1.0))
     (logclear! (-> self mask) (process-mask actor-pause attackable))
     (go-virtual nav-enemy-die))
    (('jump)
     (when (!= (-> self next-state name) 'nav-enemy-jump-land)
       (set! (-> self event-param-point quad) (-> (the-as vector (-> block param 0)) quad))
       (set! (-> self nav user-poly) (the-as nav-poly (-> block param 1)))
       (set! (-> self jump-return-state) (the-as (state process) (-> self state)))
       (go-virtual nav-enemy-jump)))
    (('cue-jump-to-point)
     (when (logtest? (-> self nav-enemy-flags) (nav-enemy-flags waiting-for-cue))
       (set! (-> self event-param-point quad) (-> (the-as vector (-> block param 0)) quad))
       (let ((new-flags (the-as object (logclear (-> self nav-enemy-flags) (nav-enemy-flags waiting-for-cue)))))
         (set! (-> self nav-enemy-flags) (the-as nav-enemy-flags new-flags))
         new-flags)))
    (('cue-chase) (go-virtual nav-enemy-chase))
    (('cue-patrol) (go-virtual nav-enemy-patrol))
    (('go-wait-for-cue) (go-virtual nav-enemy-wait-for-cue))))

(defbehavior nav-enemy-jump-event-handler nav-enemy ((source process) (argc int) (message symbol) (block event-message-block))
  "During airborne states, handle only touch and attack events so the jump cannot be retriggered or
   redirected."
  (case message
    (('touch) (set-time! (-> self touch-time)) (nav-enemy-touch-handler self source block))
    (('attack) (nav-enemy-set-hit-from-direction source) (nav-enemy-attack-handler self source block))))

(defbehavior process-drawable-death-event-handler process-drawable ((source process) (argc int) (message symbol) (block event-message-block))
  "Drop the drawable's configured pickups at death-start and hide it at death-end."
  (case message
    (('death-start) (drop-pickup (-> self fact) #t *entity-pool* (-> self fact) 0))
    (('death-end)
     (let ((new-status (the-as object (logior (-> self draw status) (draw-status hidden)))))
       (set! (-> self draw status) (the-as draw-status new-status))
       new-status))))

nav-enemy-default-event-handler

(defbehavior nav-enemy-common-post nav-enemy ()
  "Behavior wrapper for the enemy's common-post method."
  (common-post self)
  (none))

(defbehavior nav-enemy-simple-post nav-enemy ()
  "Post alignment, shared enemy housekeeping, and collision transforms without navigation travel
   or integration."
  (compute-alignment! (-> self align))
  (nav-enemy-common-post)
  (update-transforms! (-> self collide-info))
  0
  (none))

(defmethod update-nav-target! ((this nav-enemy))
  "Update the navigation controller's travel vector toward its current target position."
  (navigate! (-> this nav) (-> this nav target-pos))
  0
  (none))

(defmethod compute-travel-velocity! ((this nav-enemy))
  "Convert the navigation travel vector into translation velocity, applying alignment or momentum
   acceleration and adding gravity when ground following is enabled."
  (cond
    ((-> this nav-info use-align)
     (align-vel-and-quat-only! (-> this align)
                               (align-opts adjust-xz-vel)
                               (-> this nav travel)
                               (the-as int 1.0)
                               1.0
                               (* (-> this enemy-info speed) (-> this speed-scale))))
    (else
     (cond
       ((-> this nav-info use-momentum)
        (let* ((speed-error (- (-> this target-speed) (-> this momentum-speed)))
               (speed-step (fmin (* (-> this acceleration) (seconds-per-frame)) (fabs speed-error))))
          (if (< speed-error 0.0)
            (set! (-> this momentum-speed) (- (-> this momentum-speed) speed-step))
            (+! (-> this momentum-speed) speed-step))))
       (else (set! (-> this momentum-speed) (-> this target-speed))))
     (let* ((travel-speed (fmin (* (-> this speed-scale) (-> this momentum-speed))
                                (* (vector-length (-> this nav travel)) (-> *display* frames-per-second))))
            (travel-velocity (vector-normalize-copy! (new 'stack-no-clear 'vector) (-> this nav travel) travel-speed)))
       (set! (-> this collide-info transv x) (-> travel-velocity x))
       (set! (-> this collide-info transv z) (-> travel-velocity z)))))
  (if (-> this nav-info move-to-ground)
    (vector-v++! (-> this collide-info transv) (compute-acc-due-to-gravity (-> this collide-info) (new-stack-vector0) 0.0)))
  0
  (none))

(defmethod turn-toward-travel! ((this nav-enemy))
  "When travel is enabled, steer toward target-pos when face-target-point or the navigation
   controller requests it; otherwise steer toward the current travel heading."
  (when (logtest? (-> this nav-enemy-flags) (nav-enemy-flags enable-travel))
    (if (or (logtest? (-> this nav-enemy-flags) (nav-enemy-flags face-target-point))
            (logtest? (nav-control-flags reached-destination) (-> this nav flags)))
      (seek-to-point-toward-point! (-> this collide-info) (-> this nav target-pos) (-> this rotate-speed) (-> this turn-time))
      (seek-toward-heading-vec! (-> this collide-info) (-> this nav travel) (-> this rotate-speed) (-> this turn-time))))
  0
  (none))

(defmethod integrate-and-collide! ((this nav-enemy))
  "Integrate the current translation velocity. Ground-following enemies use the configured ground
   collision mask, hover behavior, and optional ambush probe; others use moving collision directly."
  (if (-> this nav-info move-to-ground)
    (integrate-for-enemy-with-move-to-ground! (-> this collide-info)
                                              (-> this collide-info transv)
                                              (-> this nav-info gnd-collide-with)
                                              8192.0
                                              #f
                                              (-> this nav-info hover-if-no-ground)
                                              (logtest? (-> this nav-enemy-flags) (nav-enemy-flags misty-ambush-ground-probe)))
    (integrate-and-revert-if-blocked! (-> this collide-info) (-> this collide-info transv)))
  0
  (none))

(defbehavior nav-enemy-travel-post nav-enemy ()
  "Run the complete alignment, navigation, velocity, steering, collision, and common-post pipeline
   while enable-rotate is set; otherwise use the stationary post."
  (cond
    ((logtest? (-> self nav-enemy-flags) (nav-enemy-flags enable-rotate))
     (compute-alignment! (-> self align))
     (update-nav-target! self)
     (compute-travel-velocity! self)
     (turn-toward-travel! self)
     (integrate-and-collide! self)
     (nav-enemy-common-post))
    (else
     (if *debug-segment*
       (add-frame (-> *display* frames (-> *display* on-screen) frame profile-bar 0)
                  'draw
                  (new 'static 'rgba :r #x40 :b #x40 :a #x80)))
     (nav-enemy-simple-post)
     (if *debug-segment*
       (add-frame (-> *display* frames (-> *display* on-screen) frame profile-bar 0)
                  'draw
                  (new 'static 'rgba :r #xff :b #xff :a #x80)))))
  0
  (none))

(defbehavior nav-enemy-patrol-post nav-enemy ()
  "Choose another patrol destination after arrival or prolonged blocking, update gradual steering,
   and run the ordinary travel post."
  (when (or (logtest? (nav-control-flags reached-destination) (-> self nav flags)) (< 2.0 (-> self nav block-count)))
    (set! (-> self nav block-count) 2.0)
    (logior! (-> self nav flags) (nav-control-flags gradual-turn-to-target))
    (nav-enemy-get-new-patrol-point))
  (steer-toward-point (-> self nav)
                      (-> self nav target-pos)
                      (-> self collide-info)
                      (-> self nav destination-pos)
                      (-> self rotate-speed))
  (if (logtest? (nav-control-flags heading-aligned) (-> self nav flags))
    (logclear! (-> self nav flags) (nav-control-flags gradual-turn-to-target)))
  (nav-enemy-travel-post)
  0
  (none))

(defbehavior nav-enemy-chase-post nav-enemy ()
  "Retarget navigation at the player's current position and run the ordinary travel post."
  (set! (-> self nav target-pos quad) (-> (target-pos 0) quad))
  (nav-enemy-travel-post)
  0
  (none))

(defbehavior nav-enemy-flee-post nav-enemy ()
  "Build a long travel vector away from the player, clip it to the navigation mesh, and run the
   ordinary travel post."
  (let ((away-direction (vector-! (new 'stack-no-clear 'vector) (-> self collide-info trans) (target-pos 0))))
    (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> self collide-info quat))
    0.0
    0.0
    (set! (-> away-direction y) 0.0)
    (set! (-> self nav travel quad) (-> away-direction quad)))
  (vector-normalize! (-> self nav travel) 409600.0)
  (clip-travel-to-mesh (-> self nav) 204.8 (the-as clip-travel-vector-to-mesh-return-info #f))
  (vector+! (-> self nav target-pos) (-> self collide-info trans) (-> self nav travel))
  (nav-enemy-travel-post)
  0
  (none))

(defbehavior nav-enemy-face-player-post nav-enemy ()
  "Turn toward the player while travel is enabled, then use the stationary post."
  (if (and *target* (logtest? (-> self nav-enemy-flags) (nav-enemy-flags enable-travel)))
    (seek-to-point-toward-point! (-> self collide-info) (target-pos 0) (-> self rotate-speed) (-> self turn-time)))
  (nav-enemy-simple-post)
  0
  (none))

(defbehavior nav-enemy-falling-post nav-enemy ()
  "Apply gravity, integrate with full collision, and run common enemy postprocessing."
  (vector-v++! (-> self collide-info transv) (compute-acc-due-to-gravity (-> self collide-info) (new-stack-vector0) 0.0))
  (fill-cache-integrate-and-collide! (-> self collide-info)
                                     (-> self collide-info transv)
                                     (-> self collide-info root-prim collide-with))
  (nav-enemy-common-post)
  0
  (none))

(defbehavior nav-enemy-death-post nav-enemy ()
  "Apply gravity, integrate the dying body without collision, and run common enemy postprocessing."
  (vector-v++! (-> self collide-info transv) (compute-acc-due-to-gravity (-> self collide-info) (new-stack-vector0) 0.0))
  (integrate-no-collide! (-> self collide-info) (-> self collide-info transv))
  (nav-enemy-common-post)
  0
  (none))

(defbehavior nav-enemy-neck-control-look-at nav-enemy ()
  "Enable the neck joint modifier and place it in look-at mode."
  (logior! (-> self nav-enemy-flags) (nav-enemy-flags neck-active))
  (if (nonzero? (-> self neck)) (set-mode! (-> self neck) (joint-mod-handler-mode look-at)))
  0
  (none))

(defbehavior nav-enemy-neck-control-inactive nav-enemy ()
  "Disable the active neck joint modifier and clear neck-active."
  (when (and (nonzero? (-> self neck)) (logtest? (-> self nav-enemy-flags) (nav-enemy-flags neck-active)))
    (logclear! (-> self nav-enemy-flags) (nav-enemy-flags neck-active))
    (shut-down! (-> self neck)))
  0
  (none))

(defun nav-enemy-player-vulnerable? ()
  "Return true when the player exists and is not being attacked, invulnerable, hidden from notice,
   or dying."
  (the-as symbol
          (and *target*
               (not (logtest? (-> *target* state-flags)
                              (state-flags being-attacked invulnerable timed-invulnerable invuln-powerup do-not-notice dying))))))

(defmethod target-in-range? ((this nav-enemy) (maximum-distance float))
  "Return true when the player is vulnerable, satisfies the optional distance limit, and is close
   enough to this enemy's navigation mesh to be reachable."
  (and *target*
       (not (logtest? (-> *target* state-flags)
                      (state-flags being-attacked invulnerable timed-invulnerable invuln-powerup do-not-notice dying)))
       (and (or (not (logtest? (-> this nav-enemy-flags) (nav-enemy-flags use-notice-distance)))
                (< (vector-vector-distance (target-pos 0) (-> this collide-info trans)) maximum-distance))
            (nav-enemy-test-point-near-nav-mesh? (-> *target* control shadow-pos)))))

(defbehavior nav-enemy-notice-player? nav-enemy ()
  "Implement the two-phase notice delay. Enter notice-pending when the player reaches a configured
   notice range, then return true after reaction-time elapses."
  (let ((noticed? #f))
    (cond
      ((logtest? (-> self nav-enemy-flags) (nav-enemy-flags notice-pending))
       (when (time-elapsed? (-> self notice-time) (-> self reaction-time))
         (set! noticed? #t)
         (logclear! (-> self nav-enemy-flags) (nav-enemy-flags notice-pending))))
      (else
       (when (or (target-in-range? self (-> self nav-info notice-distance))
                 (and (-> self nav-info use-proximity-notice)
                      *target*
                      (>= (-> self nav-info proximity-notice-distance)
                          (vector-vector-distance (-> self collide-info trans) (-> *target* control trans)))))
         (logior! (-> self nav-enemy-flags) (nav-enemy-flags notice-pending))
         (set-time! (-> self notice-time)))))
    noticed?))

(defbehavior nav-enemy-facing-direction? nav-enemy ((direction vector) (angle-tolerance float))
  "Return true when the enemy's horizontal facing is within angle-tolerance of direction."
  (let ((facing-direction (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> self collide-info quat)))
        (test-direction (new 'stack-no-clear 'vector)))
    (set! (-> test-direction quad) (-> direction quad))
    (set! (-> test-direction y) 0.0)
    (vector-normalize! test-direction 1.0)
    (>= (vector-dot facing-direction test-direction) (cos angle-tolerance))))

(defbehavior nav-enemy-facing-point? nav-enemy ((point vector) (angle-tolerance float))
  "Return true when the enemy's horizontal facing is within angle-tolerance of point."
  (let ((to-point (vector-! (new 'stack-no-clear 'vector) point (-> self collide-info trans))))
    (nav-enemy-facing-direction? to-point angle-tolerance)))

(defun nav-enemy-facing-player? ((angle-tolerance float))
  "Return true when the enemy faces the player within angle-tolerance."
  (nav-enemy-facing-point? (target-pos 0) angle-tolerance))

(defbehavior nav-enemy-test-nav-mesh-intersection-xz? nav-enemy ((point vector))
  "Return the navigation polygon beneath point in the horizontal plane, or false."
  (the-as symbol (find-poly-fast-from-world (-> self nav) point)))

(defbehavior nav-enemy-test-point-in-nav-mesh? nav-enemy ((point vector))
  "Return true when point lies over this enemy's navigation mesh and below its upper notice limit."
  (the-as symbol
          (and (find-poly-fast-from-world (-> self nav) point)
               (< (-> point y) (+ (-> self collide-info trans y) (-> self enemy-info notice-top))))))

(defbehavior nav-enemy-test-point-near-nav-mesh? nav-enemy ((point vector))
  "Return true when a point is within notice-nav-radius of the navigation mesh and below the
   enemy's upper notice limit."
  (and (is-in-mesh? (-> self nav) point (-> self nav-info notice-nav-radius))
       (< (-> point y) (+ (-> self collide-info trans y) (-> self enemy-info notice-top)))))

(defbehavior nav-enemy-get-new-patrol-point nav-enemy ()
  "Select a new patrol point through the enemy's overridable patrol-point method."
  (new-patrol-point! self)
  0)

(defbehavior nav-enemy-set-base-collide-sphere-collide-with nav-enemy ((collide-with uint))
  "Set collide-with on the root primitive and, for a primitive group, on the lowest base sphere
   selected by transform index and local height."
  (let ((root-prim (-> self collide-info root-prim)))
    (set! (-> root-prim collide-with) (the-as collide-kind collide-with))
    (let ((prim-group (if (and (nonzero? root-prim) (type-type? (-> root-prim type) collide-shape-prim-group)) root-prim))
          (base-sphere (the-as collide-shape-prim #f)))
      (when prim-group
        (dotimes (i (-> (the-as collide-shape-prim-group prim-group) num-prims))
          (let* ((prim (-> (the-as collide-shape-prim-group (+ (* i 4) (the-as int prim-group))) prims 0))
                 (sphere (if (and (nonzero? prim) (type-type? (-> prim type) collide-shape-prim-sphere)) prim)))
            (when sphere
              (if (or (not base-sphere)
                      (< (-> (the-as collide-shape-prim-sphere sphere) transform-index)
                         (-> (the-as collide-shape-prim-group base-sphere) transform-index))
                      (and (= (-> (the-as collide-shape-prim-sphere sphere) transform-index)
                              (-> (the-as collide-shape-prim-group base-sphere) transform-index))
                           (< (-> (the-as collide-shape-prim-sphere sphere) local-sphere y)
                              (-> (the-as collide-shape-prim-group base-sphere) local-sphere y))))
                (set! base-sphere sphere)))))
        (if base-sphere (set! (-> base-sphere collide-with) (the-as collide-kind collide-with))))))
  0
  (none))

(defbehavior nav-enemy-set-hit-from-direction nav-enemy ((source process))
  "Record a horizontal unit vector from the attacking drawable toward this enemy, or zero when the
   source is not drawable."
  (let* ((hit-direction (-> self hit-from-dir))
         (attacker-process source)
         (attacker (if (and (nonzero? attacker-process) (type-type? (-> attacker-process type) process-drawable)) attacker-process)))
    (set! (-> hit-direction quad) (-> *null-vector* quad))
    (when attacker
      (vector-! hit-direction (-> self collide-info trans) (-> (the-as process-drawable attacker) root trans))
      (set! (-> hit-direction y) 0.0)
      (vector-xz-normalize! hit-direction 1.0)))
  0
  (none))

(defbehavior nav-enemy-fall-and-play-death-anim nav-enemy ((animation art-joint-anim) (align-scale float) (animation-speed float) (unused-hold-frame float) (unused-timeout int))
  "Launch the enemy upward and drive it away from hit-from-dir while the death animation plays.
   Horizontal speed follows aligned root motion when available, otherwise a fixed fallback. The
   final two parameters are retained but unused."
  (local-vars (knockback-speed float))
  (nav-enemy-neck-control-inactive)
  (logclear! (-> self mask) (process-mask actor-pause))
  (set! (-> self skel root-channel 0 frame-group) animation)
  (let ((alignment-done? #f)
        (moving-shape (-> self collide-info)))
    (when (if (and (nonzero? moving-shape) (type-type? (-> moving-shape type) collide-shape-moving)) moving-shape)
      (when (= (vector-xz-length-squared (-> self hit-from-dir)) 0.0)
        (vector-z-quaternion! (-> self hit-from-dir) (-> self collide-info quat))
        (vector-negate-in-place! (-> self hit-from-dir))
        (set! (-> self hit-from-dir y) 0.0)
        (vector-xz-normalize! (-> self hit-from-dir) 1.0))
      (set! (-> self collide-info transv y) 65502.96)
      (ja :num-func num-func-identity :frame-num 0.0)
      (set-time! (-> self state-time))
      (logclear! (-> self collide-info status) (collide-status on-surface on-ground touch-surface))
      (until (ja-done? 0)
        (cond
          ((nonzero? (-> self align))
           (when (not alignment-done?)
             (compute-alignment! (-> self align))
             (align! (-> self align) (align-opts adjust-y-vel ignore-y-if-zero) 1.0 align-scale 1.0)
             (when (not (logtest? (-> self align flags) (align-flags disabled)))
               (set! knockback-speed (* (- (-> self align delta trans z)) (-> *display* frames-per-second)))
               (set! (-> self collide-info transv x) (* (-> self hit-from-dir x) knockback-speed))
               (set! (-> self collide-info transv z) (* (-> self hit-from-dir z) knockback-speed)))))
          (else
           (set! knockback-speed 20480.0)
           (set! (-> self collide-info transv x) (* (-> self hit-from-dir x) knockback-speed))
           (set! (-> self collide-info transv z) (* (-> self hit-from-dir z) knockback-speed))))
        (suspend)
        (ja :num! (seek! max animation-speed)))))
  0
  (none))

(defbehavior nav-enemy-turn-to-face-dir nav-enemy ((direction vector) (angle-tolerance float))
  "Play the turn animation and rotate toward a horizontal direction until within angle-tolerance,
   with a ten-second fail-safe, then snap to the requested facing."
  (local-vars (done-turning? symbol))
  (let ((start-time (current-time)))
    (ja :group! (-> self draw art-group data (-> self nav-info turn-anim)))
    (ja :num-func num-func-identity :frame-num 0.0)
    (until done-turning?
      (seek-toward-heading-vec! (-> self collide-info) direction (-> self rotate-speed) (-> self turn-time))
      (suspend)
      (ja :num! (loop! 0.75))
      (set! done-turning?
            (or (time-elapsed? start-time (seconds 10)) (nav-enemy-facing-direction? direction angle-tolerance)))))
  (forward-up->quaternion (-> self collide-info quat) direction *y-vector*)
  0
  (none))

(defbehavior nav-enemy-turn-to-face-point nav-enemy ((point vector) (angle-tolerance float))
  "Turn in place toward point until within angle-tolerance, using the configured turn animation."
  (let ((direction-to-point (vector-! (new 'stack-no-clear 'vector) point (-> self collide-info trans))))
    (set! (-> direction-to-point y) 0.0)
    (when (< 0.0 (vector-length direction-to-point))
      (vector-normalize! direction-to-point 1.0)
      (nav-enemy-turn-to-face-dir direction-to-point angle-tolerance)))
  0
  (none))

(defmethod run-logic? ((this nav-enemy))
  "Run logic while actor pausing is disabled; while the enemy is near the camera and was recently
   drawn or is leaving idle; while skeleton channels are blending; or while the drawable
   explicitly requires skeleton updates."
  (or (not (logtest? (-> this mask) (process-mask actor-pause)))
      (or (and (nonzero? (-> this draw))
               (and (>= (+ (-> *ACTOR-bank* pause-dist) (-> this collide-info pause-adjust-distance))
                        (vector-vector-distance (-> this collide-info trans) (camera-pos)))
                    (or (logtest? (-> this draw status) (draw-status was-drawn)) (!= (-> this next-state name) 'nav-enemy-idle))))
          (and (nonzero? (-> this skel)) (!= (-> this skel root-channel 0) (-> this skel channel)))
          (and (nonzero? (-> this draw)) (logtest? (-> this draw status) (draw-status no-skeleton-update))))))

;; The dormant home state does no navigation or collision work. It wakes only after the enemy has
;; been drawn, the player is close enough, and the one-second settling period has elapsed.
(defstate nav-enemy-idle (nav-enemy)
  :virtual #t
  :event nav-enemy-default-event-handler
  :enter
    (behavior ()
      (nav-enemy-neck-control-inactive)
      (set-time! (-> self state-time))
      (if (-> self nav-info move-to-ground)
        (move-to-ground (-> self collide-info) 40960.0 40960.0 #t (-> self nav-info gnd-collide-with)))
      (logclear! (-> self nav-enemy-flags) (nav-enemy-flags noticed-before hostile))
      (set! (-> self state-timeout) (seconds 1)))
  :trans
    (behavior ()
      (if (and (and *target*
                    (>= (-> self enemy-info idle-distance)
                        (vector-vector-distance (-> self collide-info trans) (-> *target* control trans))))
               (time-elapsed? (-> self state-time) (-> self state-timeout))
               (nonzero? (-> self draw))
               (logtest? (-> self draw status) (draw-status was-drawn)))
        (go-virtual nav-enemy-patrol)))
  :code
    (behavior ()
      (ja-channel-push! 1 (seconds 0.075))
      (ja :group! (-> self draw art-group data (-> self nav-info idle-anim)))
      (ja :num-func num-func-identity :frame-num 0.0)
      (let ((anim-speed (nav-enemy-rnd-float-range 0.75 1.25))) (loop (suspend) (ja :num! (loop! anim-speed)))))
  :post ja-post)

;; Wander at walk speed and periodically stop for one or more idle cycles. Clearing enable-rotate
;; during an idle break also disables the patrol movement post, so the enemy stands still until
;; the walk animation blends back in.
(defstate nav-enemy-patrol (nav-enemy)
  :virtual #t
  :event nav-enemy-default-event-handler
  :enter
    (behavior ()
      (set-time! (-> self state-time))
      (set! (-> self nav flags)
            (the-as nav-control-flags (the-as int (logior (nav-control-flags reached-destination) (-> self nav flags)))))
      (logclear! (-> self nav-enemy-flags) (nav-enemy-flags hostile))
      (logior! (-> self nav-enemy-flags) (nav-enemy-flags enable-rotate))
      (set! (-> self state-timeout) (seconds 1))
      (set! (-> self target-speed) (-> self nav-info walk-travel-speed))
      (set! (-> self acceleration) (-> self nav-info walk-acceleration))
      (set! (-> self rotate-speed) (-> self nav-info walk-rotate-speed))
      (set! (-> self turn-time) (-> self nav-info walk-turn-time)))
  :exit
    (behavior ()
      (logior! (-> self nav-enemy-flags) (nav-enemy-flags enable-rotate)))
  :trans
    (behavior ()
      (when (time-elapsed? (-> self state-time) (seconds 0.1))
        (when (time-elapsed? (-> self state-time) (-> self state-timeout))
          (if (and (nonzero? (-> self draw)) (logtest? (-> self draw status) (draw-status was-drawn)))
            (set-time! (-> self free-time)))
          (if (or (or (not *target*)
                      (< (-> self enemy-info idle-distance) (vector-vector-distance (-> self collide-info trans) (-> *target* control trans))))
                  (time-elapsed? (-> self free-time) (seconds 2)))
            (go-virtual nav-enemy-idle)))
        (if (and (-> self nav-info use-flee)
                 (and (and *target*
                           (>= (-> self nav-info notice-distance)
                               (vector-vector-distance (-> self collide-info trans) (-> *target* control trans))))
                      (let ((racer-mode 'racer)) (= racer-mode (send-event *target* 'query 'mode)))))
          (go-virtual nav-enemy-flee))
        (if (nav-enemy-notice-player?) (go-virtual nav-enemy-notice))))
  :code
    (behavior ()
      (let ((anim-speed (nav-enemy-rnd-float-range 0.9 1.1)))
        (loop
          (ja-play :group! (-> self draw art-group data (-> self nav-info walk-anim)) :num! (seek! max anim-speed) :frame-num 0.0)
          (when (nav-enemy-rnd-go-idle? 0.2)
            (ja-no-eval :num! (loop!))
            (ja-channel-push! 1 (seconds 0.6))
            (logclear! (-> self nav-enemy-flags) (nav-enemy-flags enable-rotate))
            (ja-play :group!
                     (-> self draw art-group data (-> self nav-info idle-anim))
                     :num! (seek! max anim-speed)
                     :frame-num 0.0
                     (ja-blend-eval))
            (until (not (nav-enemy-rnd-go-idle? 0.2))
              (ja-play :group! (-> self draw art-group data (-> self nav-info idle-anim)) :num! (seek! max anim-speed) :frame-num 0.0))
            (logior! (-> self nav-enemy-flags) (nav-enemy-flags enable-rotate))
            (ja-no-eval :num! (loop!))
            (ja-channel-push! 1 (seconds 0.6))
            (ja-play :group!
                     (-> self draw art-group data (-> self nav-info walk-anim))
                     :num! (seek! max anim-speed)
                     :frame-num 0.0
                     (ja-blend-eval))))))
  :post nav-enemy-patrol-post)

;; Play the one-time notice reaction while turning toward the first path to the player. An enemy
;; that has already noticed the player during this engagement skips directly to chase.
(defstate nav-enemy-notice (nav-enemy)
  :virtual #t
  :event nav-enemy-default-event-handler
  :enter
    (behavior ()
      (logior! (-> self nav-enemy-flags) (nav-enemy-flags hostile))
      (nav-enemy-neck-control-look-at)
      (if (logtest? (-> self nav-enemy-flags) (nav-enemy-flags noticed-before)) (go-virtual nav-enemy-chase))
      (logior! (-> self nav-enemy-flags) (nav-enemy-flags noticed-before))
      (let ((nav (-> self nav))
            (player-position (target-pos 0)))
        (set! (-> nav target-pos quad) (-> player-position quad)))
      (navigate! (-> self nav) (-> self nav target-pos))
      (set! (-> self rotate-speed) (-> self nav-info run-rotate-speed))
      (set! (-> self turn-time) (-> self nav-info run-turn-time)))
  :code
    (behavior ()
      (ja-channel-push! 1 (seconds 0.075))
      (let ((anim-speed (nav-enemy-rnd-float-range 0.8 1.2)))
        (ja-play :group!
                 (-> self draw art-group data (-> self nav-info notice-anim))
                 :num! (seek! max anim-speed)
                 :frame-num 0.0
                 (seek-toward-heading-vec! (-> self collide-info) (-> self nav travel) (-> self rotate-speed) (-> self turn-time))))
      (go-virtual nav-enemy-chase))
  :post nav-enemy-simple-post)

(defbehavior ja-group-index? nav-enemy ((arg0 int))
  "Return true when the current joint-animation group is the art-group entry at index."
  (ja-group? (-> self draw art-group data arg0)))

;; Enemies configured to fear the player's vehicle use this reaction instead of notice. The base
;; behavior stands and faces the player; it returns to patrol after the vehicle leaves or retreats.
(defstate nav-enemy-flee (nav-enemy)
  :virtual #t
  :event nav-enemy-default-event-handler
  :enter
    (behavior ()
      (set-time! (-> self state-time)))
  :trans
    (behavior ()
      (when (time-elapsed? (-> self state-time) (-> self reaction-time))
        (if (or (or (not *target*)
                    (< (-> self nav-info stop-chase-distance)
                       (vector-vector-distance (-> self collide-info trans) (-> *target* control trans))))
                (let ((racer-mode 'racer)) (!= racer-mode (send-event *target* 'query 'mode))))
          (go-virtual nav-enemy-patrol))))
  :code
    (behavior ()
      (let ((anim-speed (nav-enemy-rnd-float-range 0.9 1.1)))
        (ja-channel-push! 1 (seconds 0.2))
        (ja-play :group!
                 (-> self draw art-group data (-> self nav-info notice-anim))
                 :num! (seek! max anim-speed)
                 :frame-num 0.0)
        (ja-channel-push! 1 (seconds 0.2))
        (loop
          (ja-play :group! (-> self draw art-group data (-> self nav-info idle-anim)) :num! (seek! max anim-speed) :frame-num 0.0))))
  :post nav-enemy-face-player-post)

;; Frustration keeps an enemy from running forever at a stationary player it cannot reach. Moving
;; the player or making enough progress toward them resets both the sampled point and the timer.
(defbehavior nav-enemy-reset-frustration nav-enemy ()
  "Clear frustrated, record the player's current shadow position, and restart the frustration
   timer."
  (logclear! (-> self nav-enemy-flags) (nav-enemy-flags frustrated))
  (if *target* (set! (-> self frustration-point quad) (-> *target* control shadow-pos quad)))
  (set-time! (-> self frustration-time))
  0
  (none))

(defbehavior nav-enemy-player-at-frustration-point? nav-enemy ()
  "Return true when the player remains within one and a half meters of frustration-point."
  (if *target* (< (vector-vector-distance (-> *target* control shadow-pos) (-> self frustration-point)) 6144.0)))

(defbehavior nav-enemy-frustrated? nav-enemy ()
  "Return true while the enemy is frustrated and the player remains near the position that caused
   it."
  (and (logtest? (-> self nav-enemy-flags) (nav-enemy-flags frustrated)) (nav-enemy-player-at-frustration-point?)))

;; Pursue the player at run speed. A stationary player the enemy cannot close on eventually trips
;; frustration; a continuously blocked path returns the enemy to patrol after one second.
(defstate nav-enemy-chase (nav-enemy)
  :virtual #t
  :event nav-enemy-default-event-handler
  :enter
    (behavior ()
      (nav-enemy-neck-control-look-at)
      (set-time! (-> self state-time))
      (set-time! (-> self free-time))
      (logior! (-> self nav-enemy-flags) (nav-enemy-flags hostile))
      (set! (-> self target-speed) (-> self nav-info run-travel-speed))
      (set! (-> self acceleration) (-> self nav-info run-acceleration))
      (set! (-> self rotate-speed) (-> self nav-info run-rotate-speed))
      (set! (-> self turn-time) (-> self nav-info run-turn-time))
      (nav-enemy-reset-frustration))
  :trans
    (behavior ()
      (if (logtest? (-> *target* state-flags) (state-flags do-not-notice)) (go-virtual nav-enemy-patrol))
      (if (logtest? (-> self nav-enemy-flags) (nav-enemy-flags attack-landed)) (go-virtual nav-enemy-victory))
      (if (or (not (nav-enemy-player-at-frustration-point?))
              (< (-> self nav-info frustration-distance) (vector-vector-xz-distance (target-pos 0) (-> self collide-info trans))))
        (nav-enemy-reset-frustration))
      (when (time-elapsed? (-> self state-time) (-> self reaction-time))
        (if (time-elapsed? (-> self frustration-time) (+ (-> self reaction-time) (-> self nav-info frustration-time)))
          (logior! (-> self nav-enemy-flags) (nav-enemy-flags frustrated)))
        (if (or (not (target-in-range? self (-> self nav-info stop-chase-distance)))
                (logtest? (-> self nav-enemy-flags) (nav-enemy-flags frustrated)))
          (go-virtual nav-enemy-stop-chase))
        (cond
          ((logtest? (nav-control-flags blocked) (-> self nav flags))
           (if (time-elapsed? (-> self free-time) (seconds 1)) (go-virtual nav-enemy-patrol)))
          (else (set-time! (-> self free-time))))))
  :code
    (behavior ()
      (ja-channel-push! 1 (seconds 0.2))
      (ja :group! (-> self draw art-group data (-> self nav-info run-anim)))
      (ja :num-func num-func-identity :frame-num 0.0)
      (let ((anim-speed (nav-enemy-rnd-float-range 0.9 1.1))) (loop (suspend) (ja :num! (loop! anim-speed)))))
  :post nav-enemy-chase-post)

;; Ease out of a chase at walk speed before stopping completely. The follow interval is randomized
;; from roughly two to six seconds according to distance, with close enemies proceeding to stare
;; immediately.
(defstate nav-enemy-stop-chase (nav-enemy)
  :virtual #t
  :event nav-enemy-default-event-handler
  :enter
    (behavior ()
      (set-time! (-> self state-time))
      (let* ((distance-to-player (vector-vector-distance (-> self collide-info trans) (target-pos 0)))
             (follow-timeout (the int (+ (lerp-scale 600.0 1800.0 distance-to-player 32768.0 122880.0) (nav-enemy-rnd-float-range 0.0 30.0)))))
        (if (< distance-to-player 40960.0) (go-virtual nav-enemy-stare))
        (set! (-> self state-timeout) (the-as time-frame follow-timeout)))
      (set! (-> self target-speed) (-> self nav-info walk-travel-speed))
      (set! (-> self acceleration) (-> self nav-info walk-acceleration))
      (set! (-> self rotate-speed) (-> self nav-info walk-rotate-speed))
      (set! (-> self turn-time) (-> self nav-info walk-turn-time)))
  :trans
    (behavior ()
      (when (time-elapsed? (-> self state-time) (seconds 0.1))
        (if (logtest? (-> *target* state-flags) (state-flags do-not-notice)) (go-virtual nav-enemy-patrol))
        (if (and (target-in-range? self (-> self nav-info notice-distance)) (not (nav-enemy-frustrated?)))
          (go-virtual nav-enemy-chase))
        (if (or (or (not *target*)
                    (< (-> self enemy-info idle-distance) (vector-vector-distance (-> self collide-info trans) (-> *target* control trans))))
                (logtest? (nav-control-flags blocked) (-> self nav flags))
                (time-elapsed? (-> self state-time) (-> self state-timeout)))
          (go-virtual nav-enemy-stare))))
  :code
    (behavior ()
      (ja-channel-push! 1 (seconds 0.1))
      (ja :group! (-> self draw art-group data (-> self nav-info walk-anim)))
      (ja :num-func num-func-identity :frame-num 0.0)
      (let ((anim-speed (nav-enemy-rnd-float-range 0.8 1.2))) (loop (suspend) (ja :num! (loop! anim-speed)))))
  :post nav-enemy-chase-post)

;; Stand in place and face the player. Nearby movement restarts pursuit; otherwise the enemy waits
;; for a distance-scaled timeout before giving up, with a nearer player holding its attention longer.
(defstate nav-enemy-stare (nav-enemy)
  :virtual #t
  :event nav-enemy-default-event-handler
  :enter
    (behavior ()
      (set-time! (-> self state-time))
      (logclear! (-> self nav-enemy-flags) (nav-enemy-flags enable-travel))
      (let ((distance-to-player (vector-vector-distance (-> self collide-info trans) (target-pos 0))))
        (set! (-> self state-timeout)
              (the-as time-frame
                      (the int (+ (lerp-scale 3000.0 0.0 distance-to-player 12288.0 122880.0) (nav-enemy-rnd-float-range 0.0 900.0))))))
      (set! (-> self rotate-speed) (-> self nav-info run-rotate-speed))
      (set! (-> self turn-time) (-> self nav-info run-turn-time))
      (set! (-> self collide-info transv quad) (-> *null-vector* quad)))
  :exit
    (behavior ()
      (logior! (-> self nav-enemy-flags) (nav-enemy-flags enable-travel)))
  :trans
    (behavior ()
      (when (time-elapsed? (-> self state-time) (seconds 0.1))
        (if (logtest? (-> *target* state-flags) (state-flags do-not-notice)) (go-virtual nav-enemy-patrol))
        (cond
          ((target-in-range? self (-> self nav-info notice-distance))
           (if (and (time-elapsed? (-> self notice-time) (-> self reaction-time)) (not (nav-enemy-frustrated?)))
             (go-virtual nav-enemy-chase)))
          (else (set-time! (-> self notice-time))))
        (when (not (or (and *target* (>= 40960.0 (vector-vector-distance (-> self collide-info trans) (-> *target* control trans))))
                       (and (-> self nav-info use-proximity-notice)
                            *target*
                            (>= (-> self nav-info proximity-notice-distance)
                                (vector-vector-distance (-> self collide-info trans) (-> *target* control trans))))))
          (logclear! (-> self nav-enemy-flags) (nav-enemy-flags hostile))
          (if (time-elapsed? (-> self state-time) (-> self state-timeout)) (go-virtual nav-enemy-give-up)))
        (if (or (or (not *target*)
                    (< (-> self enemy-info idle-distance) (vector-vector-distance (-> self collide-info trans) (-> *target* control trans))))
                (logtest? (nav-control-flags blocked) (-> self nav flags)))
          (go-virtual nav-enemy-give-up))))
  :code
    (behavior ()
      (go-virtual nav-enemy-give-up))
  :post nav-enemy-face-player-post)

;; Drop hostility and return to patrol, allowing one final short opportunity to reacquire the player.
(defstate nav-enemy-give-up (nav-enemy)
  :virtual #t
  :event nav-enemy-default-event-handler
  :enter
    (behavior ()
      (set-time! (-> self state-time))
      (nav-enemy-neck-control-inactive)
      (logclear! (-> self nav-enemy-flags) (nav-enemy-flags hostile)))
  :trans
    (behavior ()
      (when (time-elapsed? (-> self state-time) (seconds 0.1))
        (if (target-in-range? self (-> self nav-info notice-distance)) (go-virtual nav-enemy-chase))))
  :code
    (behavior ()
      (go-virtual nav-enemy-patrol))
  :post nav-enemy-simple-post)

;; The base class attacks through touch events. Concrete enemies with active attack moves override
;; this state; the base advances directly to its post-hit celebration.
(defstate nav-enemy-attack (nav-enemy)
  :virtual #t
  :event nav-enemy-default-event-handler
  :code
    (behavior ()
      (go-virtual nav-enemy-victory))
  :post nav-enemy-simple-post)

;; Stop after a successful touch attack, play the victory animation once, then watch the player.
(defstate nav-enemy-victory (nav-enemy)
  :virtual #t
  :event nav-enemy-default-event-handler
  :enter
    (behavior ()
      (set! (-> self collide-info transv quad) (-> *null-vector* quad)))
  :code
    (behavior ()
      (ja-channel-push! 1 (seconds 0.075))
      (let ((anim-speed (nav-enemy-rnd-float-range 0.8 1.2)))
        (ja-play :group!
                 (-> self draw art-group data (-> self nav-info victory-anim))
                 :num! (seek! max anim-speed)
                 :frame-num 0.0))
      (go-virtual nav-enemy-stare))
  :post nav-enemy-simple-post)

;; Remove collision, play the falling death, distribute pickups, notify the parent, and either
;; produce the guarded fuel cell or wait for children before cleaning up.
(defstate nav-enemy-die (nav-enemy)
  :virtual #t
  :event process-drawable-death-event-handler
  :enter
    (behavior ()
      (send-event (ppointer->process (-> self parent)) 'child-die))
  :code
    (behavior ()
      (ja-channel-push! 1 (seconds 0.075))
      (clear-collide-with-as (-> self collide-info))
      (nav-enemy-fall-and-play-death-anim (the-as art-joint-anim (-> self draw art-group data (-> self nav-info die-anim)))
                                          1.0
                                          1.0
                                          1000000000000000.0
                                          600)
      (send-event self 'death-end)
      (if (logtest? (-> self enemy-info options) (fact-options has-power-cell)) (go-virtual nav-enemy-fuel-cell))
      (while (-> self child)
        (suspend))
      (cleanup-for-death self))
  :post nav-enemy-death-post)

;; Complete the entity and keep attempting to spawn its fuel cell until the pickup becomes a child.
(defstate nav-enemy-fuel-cell (nav-enemy)
  :virtual #t
  :event process-drawable-fuel-cell-handler
  :code
    (behavior ()
      (ja-channel-set! 0)
      (clear-collide-with-as (-> self collide-info))
      (ja-post)
      (process-entity-status! self (entity-perm-status complete) #t)
      (when (not (task-complete? *game-info* (-> self entity extra perm task)))
        (label cfg-1)
        (birth-pickup-at-point (-> self collide-info trans)
                               (pickup-type fuel-cell)
                               (the float (the-as int (-> self entity extra perm task)))
                               #f
                               self
                               (the-as fact-info #f))
        (when (not (-> self child))
          (suspend)
          (goto cfg-1))
        (while (-> self child)
          (suspend)))
      (cleanup-for-death self)))

;; Airborne motion comes directly from the solved trajectory rather than collision integration.
;; enable-travel controls turning toward the landing point; enable-rotate controls when trajectory
;; playback begins, allowing a standing jump to remain planted during its windup.
(defbehavior nav-enemy-jump-post nav-enemy ()
  "Turn toward the landing point while travel is enabled. While rotation is enabled, evaluate the
   solved trajectory at elapsed jump time and write its absolute position and velocity, then post
   common enemy state."
  (if (logtest? (-> self nav-enemy-flags) (nav-enemy-flags enable-travel))
    (seek-to-point-toward-point! (-> self collide-info) (-> self jump-dest) (-> self rotate-speed) (-> self turn-time)))
  (when (logtest? (-> self nav-enemy-flags) (nav-enemy-flags enable-rotate))
    (let ((air-time (the float (- (current-time) (-> self jump-time)))))
      (let ((new-position (eval-position! (-> self jump-trajectory) air-time (new 'stack-no-clear 'vector))))
        (set! (-> self collide-info trans quad) (-> new-position quad)))
      (eval-velocity! (-> self jump-trajectory) air-time (-> self collide-info transv))))
  (nav-enemy-simple-post)
  0
  (none))

;; Build a ballistic arc whose height is the larger of minimum-height and height-factor times
;; horizontal distance. A slow or poorly aligned enemy uses a standing windup. A short hop or a
;; destination well below the start is classified as a drop and may use the fixed half-meter arc.
;; The destination becomes an extra navigation sphere so another enemy does not occupy the landing
;; point while this one is airborne.
(defbehavior nav-enemy-initialize-custom-jump nav-enemy ((destination vector) (use-drop-arc? symbol) (minimum-height float) (height-factor float) (gravity float))
  "Solve a ballistic jump to destination from minimum height, distance height factor, and gravity.
   Classify standing and drop jumps and reserve the destination as an extra navigation sphere."
  (set! (-> self jump-dest quad) (-> destination quad))
  (let* ((start-position (-> self collide-info trans))
         (horizontal-distance (vector-vector-xz-distance start-position destination))
         (arc-height (fmax minimum-height (* height-factor horizontal-distance))))
    (let ((vertical-distance (- (-> destination y) (-> start-position y))))
      (let ((current-speed (vector-length (-> self collide-info transv)))
            (facing-direction (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> self collide-info quat)))
            (destination-direction (vector-! (new 'stack-no-clear 'vector) destination start-position)))
        (set! (-> facing-direction y) 0.0)
        (set! (-> destination-direction y) 0.0)
        (vector-xz-normalize! facing-direction 1.0)
        (vector-xz-normalize! destination-direction 1.0)
        (logclear! (-> self nav-enemy-flags) (nav-enemy-flags standing-jump drop-jump))
        (if (or (>= (/ (-> self nav-info run-travel-speed) 2) current-speed)
                (>= (cos 3640.889) (vector-dot facing-direction destination-direction)))
          (logior! (-> self nav-enemy-flags) (nav-enemy-flags standing-jump))))
      (if (or (and (< vertical-distance 0.0) (< horizontal-distance (fabs vertical-distance)))
              (and (< (fabs vertical-distance) 12288.0) (< horizontal-distance 20480.0)))
        (logior! (-> self nav-enemy-flags) (nav-enemy-flags drop-jump))))
    (when (and use-drop-arc? (logtest? (-> self nav-enemy-flags) (nav-enemy-flags drop-jump)))
      (logclear! (-> self nav-enemy-flags) (nav-enemy-flags standing-jump))
      (set! arc-height 2048.0))
    (setup-from-to-height! (-> self jump-trajectory) start-position destination arc-height (/ gravity 90000)))
  (set! (-> self nav extra-nav-sphere quad) (-> destination quad))
  (set! (-> self nav extra-nav-sphere w) (-> self collide-info nav-radius))
  (logior! (-> self collide-info nav-flags) (nav-flags avoid-extra-sphere))
  0
  (none))

(defbehavior nav-enemy-initialize-jump nav-enemy ((destination vector))
  "Solve a jump to destination using the enemy type's minimum height and distance height factor."
  (nav-enemy-initialize-custom-jump destination
                                    #t
                                    (-> self nav-info jump-height-min)
                                    (-> self nav-info jump-height-factor)
                                    -409600.0)
  0
  (none))

;; A standing jump plays through launch-frame before trajectory playback is enabled. At launch the
;; enemy becomes airborne and selects either the run animation for a drop or the jump animation for
;; a normal arc. The final position is snapped to the destination to avoid accumulated timing error.
(defbehavior nav-enemy-execute-custom-jump nav-enemy ((jump-animation int) (launch-frame float) (animation-speed float))
  "Optionally play a standing windup, execute the solved ballistic jump while advancing animation,
   then place the body at its destination and release its reserved navigation sphere."
  (when (logtest? (-> self nav-enemy-flags) (nav-enemy-flags standing-jump))
    (ja-no-eval :num! (loop!))
    (ja-channel-push! 1 (seconds 0.1))
    (logclear! (-> self nav-enemy-flags) (nav-enemy-flags enable-rotate))
    (ja-play :group! (-> self draw art-group data jump-animation)
             :num!
             (seek! (ja-aframe launch-frame 0) animation-speed)
             :frame-num 0.0
             (ja-blend-eval)))
  (logclear! (-> self collide-info status) (collide-status on-surface on-ground touch-surface))
  (set-time! (-> self jump-time))
  (logior! (-> self nav-enemy-flags) (nav-enemy-flags enable-rotate))
  (cond
    ((logtest? (-> self nav-enemy-flags) (nav-enemy-flags drop-jump))
     (cond
       ((ja-group? (-> self draw art-group data (-> self nav-info run-anim))))
       (else
        (ja-no-eval :num! (loop!))
        (ja-channel-push! 1 (seconds 0.1))
        (ja :group! (-> self draw art-group data (-> self nav-info run-anim)))
        (ja :num-func num-func-identity :frame-num 0.0))))
    (else
     (ja-no-eval :num! (loop!))
     (ja-channel-push! 1 (seconds 0.1))
     (ja :group! (-> self draw art-group data jump-animation))
     (ja :num-func num-func-identity :frame-num (ja-aframe launch-frame 0))))
  (while (< (the float (- (current-time) (-> self jump-time))) (-> self jump-trajectory time))
    (suspend)
    (ja :num! (seek!))
    (ja-blend-eval))
  (set! (-> self collide-info trans quad) (-> self jump-dest quad))
  (set! (-> self collide-info transv y) 0.0)
  (logclear! (-> self collide-info nav-flags) (nav-flags avoid-extra-sphere))
  0
  (none))

(defbehavior nav-enemy-execute-jump nav-enemy ()
  "Play and execute the previously solved jump using this enemy type's jump animation settings."
  (nav-enemy-execute-custom-jump (-> self nav-info jump-anim)
                                 (-> self nav-info jump-anim-start-frame)
                                 (-> self nav-info jump-start-anim-speed))
  0
  (none))

(defbehavior nav-enemy-jump-land-anim nav-enemy ()
  "Play the configured landing animation through its authored end frame."
  (ja-no-eval :num! (seek!))
  (ja-channel-push! 1 (seconds 0.075))
  (ja-play :group!
           (-> self draw art-group data (-> self nav-info jump-land-anim))
           :num! (seek!)
           :frame-num 0.0
           (ja-blend-eval))
  0
  (none))

;; Cross a navigation gap. The event handler supplies both the far polygon and the state to resume;
;; enemies configured to respect occupied landing points can refuse the jump before launching.
(defstate nav-enemy-jump (nav-enemy)
  :virtual #t
  :event nav-enemy-jump-event-handler
  :enter
    (behavior ()
      (set-time! (-> self state-time))
      (if (and (-> self nav-info use-jump-blocked) (jump-dest-blocked? self (-> self event-param-point)))
        (go-virtual nav-enemy-jump-blocked))
      (nav-enemy-initialize-jump (-> self event-param-point)))
  :exit
    (behavior ()
      (logior! (-> self nav-enemy-flags) (nav-enemy-flags enable-rotate enable-travel)))
  :code
    (behavior ()
      (nav-enemy-execute-jump)
      (let ((destination-poly (-> self nav user-poly)))
        (if (not destination-poly) (set! destination-poly (find-poly-fast-from-world (-> self nav) (-> self jump-dest))))
        (if destination-poly (set-current-poly! (-> self nav) destination-poly)))
      (go-virtual nav-enemy-jump-land))
  :post nav-enemy-jump-post)

;; Landing recovery accelerates toward run speed, steers along the current path, applies gravity,
;; and follows the ground so movement blends smoothly back into an ordinary chase.
(defbehavior nav-enemy-jump-land-post nav-enemy ()
  "Accelerate out of a landing toward the navigation target, steer, apply gravity, integrate with
   ground following, and update common enemy state."
  (compute-alignment! (-> self align))
  (navigate! (-> self nav) (-> self nav target-pos))
  (seek! (-> self target-speed) (-> self nav-info run-travel-speed) 2048.0)
  (set! (-> self momentum-speed) (-> self target-speed))
  (let* ((travel-speed (fmin (* (-> self speed-scale) (-> self momentum-speed))
                             (* (vector-length (-> self nav travel)) (-> *display* frames-per-second))))
         (travel-velocity (vector-normalize-copy! (new 'stack-no-clear 'vector) (-> self nav travel) travel-speed)))
    (set! (-> self collide-info transv x) (-> travel-velocity x))
    (set! (-> self collide-info transv z) (-> travel-velocity z)))
  (if (or (logtest? (-> self nav-enemy-flags) (nav-enemy-flags face-target-point))
          (logtest? (nav-control-flags reached-destination) (-> self nav flags)))
    (seek-to-point-toward-point! (-> self collide-info) (-> self nav target-pos) (-> self rotate-speed) (-> self turn-time))
    (seek-toward-heading-vec! (-> self collide-info) (-> self nav travel) (-> self rotate-speed) (-> self turn-time)))
  (vector-v++! (-> self collide-info transv) (compute-acc-due-to-gravity (-> self collide-info) (new-stack-vector0) 0.0))
  (integrate-for-enemy-with-move-to-ground! (-> self collide-info)
                                            (-> self collide-info transv)
                                            (-> self nav-info gnd-collide-with)
                                            8192.0
                                            #f
                                            (-> self nav-info hover-if-no-ground)
                                            #f)
  (nav-enemy-common-post)
  (none))

;; Continue four meters along the horizontal landing velocity while the landing animation plays.
;; The enemy returns to its saved state unless it has already recovered into the chase.
(defstate nav-enemy-jump-land (nav-enemy)
  :virtual #t
  :event nav-enemy-default-event-handler
  :enter
    (behavior ()
      (set-time! (-> self state-time))
      (logclear! (-> self nav flags) (nav-control-flags reached-destination))
      (let ((flat-velocity (new 'stack-no-clear 'vector)))
        (set! (-> flat-velocity quad) (-> self collide-info transv quad))
        (set! (-> flat-velocity y) 0.0)
        (set! (-> self target-speed) (vector-length flat-velocity))
        (set! (-> self momentum-speed) (-> self target-speed))
        (vector-xz-normalize! flat-velocity 16384.0)
        (vector+! (-> self nav target-pos) (-> self collide-info trans) flat-velocity)))
  :trans
    (behavior ()
      (if (or (time-elapsed? (-> self state-time) (seconds 0.5))
              (logtest? (nav-control-flags reached-destination) (-> self nav flags)))
        (go-virtual nav-enemy-chase)))
  :code
    (behavior ()
      (nav-enemy-jump-land-anim)
      (go (-> self jump-return-state)))
  :post nav-enemy-jump-land-post)

;; Wait half a second after refusing an occupied landing point, then return to the saved state and
;; let navigation choose again. A random idle frame and speed keep groups from synchronizing.
(defstate nav-enemy-jump-blocked (nav-enemy)
  :virtual #t
  :event nav-enemy-default-event-handler
  :enter
    (behavior ()
      (set-time! (-> self state-time)))
  :trans
    (behavior ()
      (if (time-elapsed? (-> self state-time) (seconds 0.5)) (go (-> self jump-return-state))))
  :code
    (behavior ()
      (when (not (ja-group? (-> self draw art-group data (-> self nav-info idle-anim))))
        (ja-channel-push! 1 (seconds 0.2))
        (ja :group!
            (-> self draw art-group data (-> self nav-info idle-anim))
            :num!
            (identity (rand-vu-float-range 0.0 (the float (+ (-> (ja-group) data 0 length) -1))))))
      (let ((anim-speed (nav-enemy-rnd-float-range 0.75 1.25))) (loop (suspend) (ja :num! (loop! anim-speed)))))
  :post nav-enemy-simple-post)

;; Battle-controlled enemies wait here until cue-jump-to-point clears waiting-for-cue. They face
;; the supplied point and pause for a random half-second interval so a wave does not launch in sync.
(defstate nav-enemy-wait-for-cue (nav-enemy)
  :virtual #t
  :event nav-enemy-default-event-handler
  :code
    (behavior ()
      (set-time! (-> self state-time))
      (logior! (-> self nav-enemy-flags) (nav-enemy-flags waiting-for-cue))
      (ja-channel-push! 1 (seconds 0.1))
      (let ((anim-speed (nav-enemy-rnd-float-range 0.8 1.2)))
        (ja :group! (-> self draw art-group data (-> self nav-info idle-anim)))
        (ja :num-func num-func-identity :frame-num 0.0)
        (while (logtest? (-> self nav-enemy-flags) (nav-enemy-flags waiting-for-cue))
          (suspend)
          (ja :num! (loop! anim-speed)))
        (ja-channel-push! 1 (seconds 0.1))
        (nav-enemy-turn-to-face-point (-> self event-param-point) 910.2222)
        (let ((delay (nav-enemy-rnd-int-range 0 150))) (suspend-for delay (ja :num! (loop! anim-speed)))))
      (go-virtual nav-enemy-jump-to-point))
  :post nav-enemy-simple-post)

;; Execute a battle-controller cue jump, turning toward the landing point first when necessary, then
;; return to the cue state for the next instruction.
(defstate nav-enemy-jump-to-point (nav-enemy)
  :virtual #t
  :event nav-enemy-jump-event-handler
  :exit
    (behavior ()
      (logior! (-> self nav-enemy-flags) (nav-enemy-flags enable-rotate enable-travel)))
  :trans
    (behavior ()
      0)
  :code
    (behavior ()
      (set-time! (-> self state-time))
      (nav-enemy-initialize-jump (-> self event-param-point))
      (nav-enemy-neck-control-look-at)
      (logior! (-> self nav-enemy-flags) (nav-enemy-flags enable-travel))
      (logclear! (-> self nav-enemy-flags) (nav-enemy-flags enable-rotate))
      (when (not (nav-enemy-facing-point? (-> self jump-dest) 5461.3335))
        (ja-channel-push! 1 (seconds 0.2))
        (nav-enemy-turn-to-face-point (-> self jump-dest) 1820.4445))
      (logclear! (-> self nav-enemy-flags) (nav-enemy-flags enable-travel))
      (nav-enemy-execute-jump)
      (logclear! (-> self nav-enemy-flags) (nav-enemy-flags enable-rotate))
      (nav-enemy-jump-land-anim)
      (go-virtual nav-enemy-wait-for-cue))
  :post nav-enemy-jump-post)

;; Shared non-rendering shadow settings for enemies whose art has no shadow.
(define *nav-enemy-dummy-shadow-control*
  (new 'static
       'shadow-control
       :settings
       (new 'static
            'shadow-settings
            :flags (shadow-flags scissor-top disable-draw)
            :shadow-dir
            (new 'static 'vector :y -1.0 :w 614400.0)
            :bot-plane
            (new 'static 'plane :y 1.0 :w 4096.0)
            :top-plane
            (new 'static 'plane :y 1.0 :w -4096.0))))

(defmethod init-defaults! ((this nav-enemy) (info nav-enemy-info))
  "Install per-type navigation tuning, movement speeds, fact and shadow settings, control flags,
   and random state."
  (set! (-> this rand-gen) (new 'process 'random-generator))
  (set! (-> this rand-gen seed) (the-as uint #x666edd1e))
  (set! (-> this mask) (the-as process-mask (logior (process-mask enemy) (-> this mask))))
  (init-jm! this info)
  (if (-> this draw shadow)
    (set! (-> this draw shadow-ctrl)
          (new 'process
               'shadow-control
               (-> this nav-info shadow-min-y)
               (-> this nav-info shadow-max-y)
               (-> this nav-info shadow-locus-dist)
               (the-as float 17)
               245760.0))
    (set! (-> this draw shadow-ctrl) *nav-enemy-dummy-shadow-control*))
  (set! (-> this align) (new 'process 'align-control this))
  (set! (-> this nav) (new 'process 'nav-control (-> this collide-info) 16 (-> info nav-nearest-y-threshold)))
  (logior! (-> this nav flags)
           (nav-control-flags display-marks display-polys display-active-polys display-travel display-spheres))
  (set! (-> this nav gap-event) 'jump)
  (post-relocalize-hook (-> this nav))
  (set! (-> this path) (new 'process 'path-control this 'path 0.0))
  (logior! (-> this path flags) (path-control-flag display draw-line draw-point draw-text))
  (set! (-> this enemy-info)
        (new 'process 'fact-info-enemy this (pickup-type eco-pill-random) (-> *FACT-bank* default-pill-inc)))
  (set! (-> this reaction-time) (nav-enemy-rnd-int-range (seconds 0.1) (seconds 0.8)))
  (set! (-> this speed-scale) 1.0)
  (logior! (-> this nav-enemy-flags)
           (nav-enemy-flags enable-rotate enable-travel vulnerable attack-enabled use-notice-distance))
  0
  (none))

(defmethod init-jm! ((this nav-enemy) (info nav-enemy-info))
  "Adopt the navigation tuning and configure the optional neck joint modifier with default
   walk-turn settings, twist limits, orientation axes, and tracking range."
  (set! (-> this nav-info) info)
  (set! (-> this rotate-speed) (-> this nav-info walk-rotate-speed))
  (set! (-> this turn-time) (-> this nav-info walk-turn-time))
  (when (and (!= (-> this nav-info neck-joint) -1) (zero? (-> this neck)))
    (set! (-> this neck) (new 'process 'joint-mod (joint-mod-handler-mode flex-blend) this (-> this nav-info neck-joint)))
    (set-vector! (-> this neck twist-max) 8192.0 8192.0 0.0 1.0)
    (set! (-> this neck up) (the-as uint 1))
    (set! (-> this neck nose) (the-as uint 2))
    (set! (-> this neck ear) (the-as uint 0))
    (set! (-> this neck max-dist) 102400.0)
    (set! (-> this neck ignore-angle) 16384.0)))

(defbehavior nav-enemy-init-by-other nav-enemy ((controller battlecontroller) (spawn-position vector) (cue-point vector))
  "Initialize an enemy spawned by a battle controller at spawn-position, face cue-point, disable
   normal notice-distance gating, and enter the controller cue state."
  (initialize-collision self)
  (logior! (-> self mask) (process-mask actor-pause))
  (set! (-> self collide-info trans quad) (-> spawn-position quad))
  (set! (-> self event-param-point quad) (-> cue-point quad))
  (let ((facing-direction (vector-! (new 'stack-no-clear 'vector) cue-point spawn-position)))
    (set! (-> facing-direction y) 0.0)
    (vector-normalize! facing-direction 1.0)
    (forward-up->quaternion (-> self collide-info quat) facing-direction *up-vector*))
  (vector-identity! (-> self collide-info scale))
  (set! (-> self entity) (-> controller entity))
  (post-init-setup! self)
  (logclear! (-> self nav-enemy-flags) (nav-enemy-flags use-notice-distance))
  (logior! (-> self nav-enemy-flags) (nav-enemy-flags noticed-before))
  (go-virtual nav-enemy-wait-for-cue)
  (none))

(defmethod initialize-collision ((this nav-enemy))
  "Create this subtype's moving collision shape. The base hook does nothing."
  0
  (none))

(defmethod post-init-setup! ((this nav-enemy))
  "Finish subtype-specific initialization after collision and drawable transforms are ready.
   The base hook does nothing."
  0
  (none))

(defmethod go-initial-state! ((this nav-enemy))
  "Enter this subtype's initial state. The base enters nav-enemy-idle."
  (go (method-of-object this nav-enemy-idle))
  0
  (none))

(defmethod init-from-entity! ((this nav-enemy) (actor entity-actor))
  "Create collision and drawable state from the entity, run subtype setup, and enter the
   subtype's initial state."
  (initialize-collision this)
  (process-drawable-from-entity! this actor)
  (post-init-setup! this)
  (go-initial-state! this)
  0
  (none))

(defmethod jump-dest-blocked? ((this nav-enemy) (point vector))
  "Return true when a proposed jump destination lies inside an occupied navigation sphere
   relative to this enemy."
  (let ((saved-position (new 'stack-no-clear 'vector)))
    (set! (-> saved-position quad) (-> this collide-info trans quad))
    (set! (-> this collide-info trans quad) (-> point quad))
    (let ((navigation (-> this nav)))
      (gather-nav-spheres! navigation (the-as collide-kind -1))
      (set! (-> this collide-info trans quad) (-> saved-position quad))
      (let* ((mesh-origin (-> navigation mesh origin))
             (point-offset-x (- (-> point x) (-> mesh-origin x)))
             (point-offset-z (- (-> point z) (-> mesh-origin z))))
        (countdown (sphere-index (-> navigation num-spheres))
          (let* ((sphere (-> navigation sphere sphere-index))
                 (sphere-offset-x (- (-> sphere x) point-offset-x))
                 (sphere-offset-z (- (-> sphere z) point-offset-z)))
            (if (>= (square (-> sphere w)) (+ (square sphere-offset-x) (square sphere-offset-z))) (return #t)))))))
  #f)

(defbehavior cam-launcher-joystick camera-slave ()
  "Orbit the short-fall launcher camera's position about its tracked target from horizontal
   right-stick input."
  (when *camera-read-analog*
    (let ((yaw-rotation (new-stack-matrix0))
          (camera-offset (vector-reset! (new 'stack-no-clear 'vector))))
      ;; og:preserve-this changed for pc port
      (let* ((stick-input (analog-input-horizontal-third (the-as int (+ (-> *cpad-list* cpads 0 rightx) -128)) 0.0 48.0 110.0 -1.0))
             (unclamped-yaw (* -546.13336 stick-input))
             (yaw-step (fmin 546.13336 (fmax -546.13336 unclamped-yaw))))
        (matrix-axis-angle! yaw-rotation (-> *camera* local-down) yaw-step))
      (vector-! camera-offset (-> self trans) (-> *camera* tpos-curr))
      (vector-matrix*! camera-offset camera-offset yaw-rotation)
      (vector+! (-> self trans) camera-offset (-> *camera* tpos-curr)))))

;; The short launcher camera sits seven meters opposite local-down. Its forward
;; direction is flattened about local-down, then pitched slightly toward the
;; landing area. Hold that offset through the fall and blend back to the base
;; camera once the target has been grounded for at least one second.
(defstate cam-launcher-shortfall (camera-slave)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('teleport) #f)
        (else (cam-standard-event-handler proc argc message block))))
  :enter
    (behavior ()
      (when (not (-> self enter-has-run))
        (let ((level-forward (new 'stack-no-clear 'vector)))
          (vector--float*! (-> self trans) (-> *camera* tpos-curr) (-> *camera* local-down) 28672.0)
          (vector-flatten! level-forward (-> self tracking inv-mat vector 2) (-> *camera* local-down))
          (vector-normalize! level-forward 1.0)
          (set! (-> self pivot-pt quad) (-> level-forward quad))
          (vector+float*! level-forward level-forward (-> *camera* local-down) 1000.0)
          (vector-normalize-copy! (-> self tracking inv-mat vector 2) level-forward 1.0))
        (vector-cross! (-> self tracking inv-mat vector 1)
                       (-> self tracking inv-mat vector 2)
                       (the-as vector (-> self tracking)))
        (set! (-> self blend-from-type) (the-as uint 0))
        (set! (-> self blend-to-type) (the-as uint 0))
        0))
  :trans
    (behavior ()
      (if (not (logtest? (-> *camera* master-options) 2)) (cam-slave-go cam-free-floating)))
  :code
    (behavior ()
      (let ((start-time (current-time)))
        (loop
          (when (not (paused?))
            (vector--float*! (-> self trans) (-> *camera* tpos-curr) (-> *camera* local-down) 28672.0)
            (send-event *camera* 'teleport)
            (if (and (-> *camera* on-ground) (time-elapsed? start-time (seconds 1)))
              (send-event *camera* 'change-state *camera-base-mode* (seconds 0.5))))
          (suspend)))))

;; og:preserve-this
;; blue eco launcher cam (not used for enclosed launchers like in jungle temple)
(defbehavior cam-launcher-long-joystick camera-slave ()
  "Yaw the long-fall camera's one-meter horizontal view offset from right-stick input."
  (when *camera-read-analog*
    (let ((yaw-rotation (new-stack-matrix0)))
      ;; og:preserve-this changed for pc port
      (let* ((stick-input (analog-input-horizontal-third (the-as int (+ (-> *cpad-list* cpads 0 rightx) -128)) 0.0 48.0 110.0 -1.0))
             (unclamped-yaw (* -546.13336 stick-input))
             (yaw-step (fmin 546.13336 (fmax -546.13336 unclamped-yaw))))
        ;; og:preserve-this changed for high fps
        (matrix-axis-angle! yaw-rotation (-> *camera* local-down) (* DISPLAY_FPS_RATIO yaw-step)))
      (vector-matrix*! (-> self view-flat) (-> self view-flat) yaw-rotation))
    (vector-normalize! (-> self view-flat) 4096.0)))

;; The long launcher camera follows the target from seven meters opposite
;; local-down plus a one-meter horizontal view offset. Vertical speed decays
;; each frame; small height errors are corrected without overshoot, while
;; errors beyond five meters ease toward the excess and are capped at nine
;; percent per frame. Lateral correction and target motion are applied
;; separately so the view can orbit without disturbing vertical tracking.
(defstate cam-launcher-longfall (camera-slave)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('teleport) #f)
        (else (cam-standard-event-handler proc argc message block))))
  :enter
    (behavior ()
      (when (not (-> self enter-has-run))
        (new 'stack-no-clear 'vector)
        (vector-negate! (-> self view-flat) (-> self tracking inv-mat vector 2))
        (vector-normalize! (-> self view-flat) 4096.0)
        (vector--float*! (-> self trans) (-> *camera* tpos-curr) (-> *camera* local-down) 28672.0)
        (vector+! (-> self trans) (-> self trans) (-> self view-flat))
        (set! (-> self blend-from-type) (the-as uint 0))
        (set! (-> self blend-to-type) (the-as uint 0))
        (cam-calc-follow! (-> self tracking) (-> self trans) #f)
        (slave-set-rotation! (-> self tracking) (-> self trans) (the-as float (-> self options)) (-> self fov) #f)))
  :trans
    (behavior ()
      (if (not (logtest? (-> *camera* master-options) 2)) (cam-slave-go cam-free-floating))
      (cam-launcher-long-joystick))
  :code
    (behavior ()
      (let ((start-time (current-time)))
        (loop
          (when (not (paused?))
            (let ((target-offset (new 'stack-no-clear 'vector))
                  (lateral-offset (new 'stack-no-clear 'vector)))
              0.0
              0.0
              0.0
              (send-event *camera* 'teleport)
              (let* ((vertical-speed (vector-dot (-> self velocity) (-> *camera* local-down)))
                     (next-vertical-speed (* 0.975 vertical-speed)))
                (vector--float*! target-offset (-> *camera* tpos-curr) (-> *camera* local-down) 28672.0)
                (vector-! target-offset target-offset (-> self trans))
                (let ((vertical-error (vector-dot target-offset (-> *camera* local-down))))
                  (vector--float*! lateral-offset target-offset (-> *camera* local-down) vertical-error)
                  (cond
                    ((< vertical-error next-vertical-speed) (set! next-vertical-speed vertical-error))
                    ((< 20480.0 vertical-error)
                     (let ((excess-error (+ -20480.0 vertical-error)))
                       (let ((eased-speed (lerp next-vertical-speed excess-error 0.005)))
                         (if (< next-vertical-speed eased-speed) (set! next-vertical-speed eased-speed)))
                       (if (< (* 0.09 excess-error) next-vertical-speed) (set! next-vertical-speed (* 0.09 excess-error)))))))
                (vector+float*! (-> self velocity) lateral-offset (-> *camera* local-down) next-vertical-speed)))
            (vector+! (-> self trans) (-> self trans) (-> self velocity))
            (set! (-> self trans x) (-> *camera* tpos-curr x))
            (set! (-> self trans z) (-> *camera* tpos-curr z))
            (vector+! (-> self trans) (-> self trans) (-> self view-flat))
            (if (and (-> *camera* on-ground) (time-elapsed? start-time (seconds 1)))
              (send-event *camera* 'change-state *camera-base-mode* (seconds 0.5))))
          (vector-reset! (-> self tracking follow-off))
          (vector+! (-> self tracking follow-pt) (-> *camera* tpos-curr-adj) (-> self tracking follow-off))
          (vector--float*! (-> self tracking follow-pt)
                           (-> self tracking follow-pt)
                           (-> *camera* local-down)
                           (-> *camera* target-height))
          (slave-set-rotation! (-> self tracking) (-> self trans) (the-as float (-> self options)) (-> self fov) #f)
          (suspend)))))

;; An idle launcher waits for a nearby target carrying blue eco. If the target
;; is already in launch mode without eco, end that mode; at close range the
;; sidekick may offer the launcher hint.
(defstate launcher-idle (launcher)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('instant-death) (go launcher-deactivated))
        (('trans) (move-to-point! (-> self root) (the-as vector (-> block param 0))) (update-transforms! (-> self root)))))
  :trans
    (behavior ()
      (when (and *target* (>= (-> self active-distance) (vector-vector-distance (-> self root trans) (-> *target* control trans))))
        (cond
          ((send-event *target* 'query 'powerup (pickup-type eco-blue)) (go launcher-active))
          (else
           (let ((launch-mode 'target-launch)) (if (= (send-event *target* 'query 'mode) launch-mode) (send-event *target* 'end-mode)))))
        (if (and (and *target* (>= 32768.0 (vector-vector-distance (-> self root trans) (-> *target* control trans))))
                 (not (send-event *target* 'query 'powerup (pickup-type eco-blue))))
          (level-hint-spawn (text-id sidekick-hint-launcher) "sksp0035" (the-as entity #f) *entity-pool* (game-task none)))))
  :code anim-loop)

;; The active launcher keeps its plume and idle sound alive while blue eco and
;; range conditions hold. Touch and attack events launch their sender
;; immediately; proximity also keeps launching the main target during the
;; first half second. Leaving the state fades the persistent sound.
(defstate launcher-active (launcher)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (when (or (= message 'touch) (= message 'attack))
        (set-time! (-> self state-time))
        (send-event proc 'launch (-> self spring-height) (-> self camera) (-> self dest) (-> self seek-time)))
      (cond
        ((= message 'instant-death) (go launcher-deactivated))
        ((= message 'trans)
         (move-to-point! (-> self root) (the-as vector (-> block param 0)))
         (update-transforms! (-> self root)))))
  :exit
    (behavior ()
      (let ((sound-command (the-as sound-rpc-set-param (get-sound-buffer-entry))))
        (set! (-> sound-command command) (sound-command set-param))
        (set! (-> sound-command id) (-> self sound-id))
        (set! (-> sound-command parms volume) -4)
        (set! (-> sound-command auto-time) 120)
        (set! (-> sound-command auto-from) 2)
        (set! (-> sound-command parms mask) (sound-mask volume time))
        (-> sound-command id)))
  :trans
    (behavior ()
      (if (or (or (not *target*)
                  (< (-> self active-distance) (vector-vector-distance (-> self root trans) (-> *target* control trans))))
              (not (send-event *target* 'query 'powerup (pickup-type eco-blue))))
        (go launcher-idle))
      (spawn (-> self part) (-> self root trans))
      (sound-play "launch-idle" :id (-> self sound-id))
      (if (and (and *target*
                    (>= (+ 2867.2 (-> self root root-prim prim-core world-sphere w))
                        (vector-vector-distance (-> self root trans) (-> *target* control trans))))
               (not (time-elapsed? (-> self state-time) (seconds 0.5))))
        (send-event *target* 'launch (-> self spring-height) (-> self camera) (-> self dest) (-> self seek-time))))
  :code
    (behavior ()
      (sound-play "launch-start")
      (anim-loop)))

(defstate launcher-deactivated (launcher)
  :code anim-loop)

;; The low byte of mode selects the fall camera: zero uses the short camera,
;; one uses the long camera, and two leaves camera control unchanged.
;; alt-vector.xyz is the destination and alt-vector.w is travel time in
;; seconds, converted to the engine's 300-Hz clock.
(defmethod init-from-entity! ((this launcher) (source-entity entity-actor))
  "Build this launcher's collision sphere and drawable data, load its spring height, particle
   group, camera mode, optional destination and seek time, then enter the idle state."
  (stack-size-set! (-> this main-thread) 128)
  (let ((root-shape (new 'process 'collide-shape this (collide-list-enum hit-by-player))))
    (let ((trigger-sphere (new 'process 'collide-shape-prim-sphere root-shape (the-as uint 0))))
      (set! (-> trigger-sphere prim-core collide-as) (collide-kind enemy))
      (set! (-> trigger-sphere collide-with) (collide-kind target))
      (set-vector! (-> trigger-sphere local-sphere) 0.0 0.0 0.0 12288.0)
      (set-root-prim! root-shape trigger-sphere))
    (set! (-> root-shape nav-radius) 13926.4)
    (backup-collide-with-as root-shape)
    (set! (-> this root) root-shape))
  (process-drawable-from-entity! this source-entity)
  (update-transforms! (-> this root))
  (set! (-> this active-distance) 409600.0)
  (set! (-> this spring-height) (res-lump-float source-entity 'spring-height :default 163840.0))
  (let ((packed-mode (res-lump-value source-entity 'mode uint128)))
    (let ((level-name (-> this entity extra level name)))
      (set! (-> this part)
            (create-launch-control (cond
                                     ((= level-name 'beach) group-beach-launcher)
                                     ((= level-name 'swamp) group-swamp-launcher)
                                     (else group-jungle-launcher))
                                   this)))
    (let ((camera-mode (logand (the-as int packed-mode) 255)))
      (cond
        ((= (the-as uint camera-mode) 1) (set! (-> this camera) cam-launcher-longfall))
        ((= (the-as uint camera-mode) 2) (set! (-> this camera) #f))
        (else (set! (-> this camera) cam-launcher-shortfall)))))
  (let ((destination-spec (res-lump-struct source-entity 'alt-vector vector)))
    (when destination-spec
      (set-vector! (-> this dest) (-> destination-spec x) (-> destination-spec y) (-> destination-spec z) 1.0)
      (set! (-> this seek-time) (the-as time-frame (the int (* 300.0 (-> destination-spec w)))))))
  (set! (-> this sound-id) (new-sound-id))
  (nav-mesh-connect this (-> this root) (the-as nav-control #f))
  (go launcher-idle)
  (none))

(defbehavior launcher-init-by-other launcher ((position vector) (spring-height float) (packed-mode int) (active-distance float))
  "Create a launcher at position with spring-height, packed camera mode, and active-distance,
   selecting the level's particle group and any destination stored on its entity."
  (stack-size-set! (-> self main-thread) 128)
  (let ((root-shape (new 'process 'collide-shape self (collide-list-enum hit-by-player))))
    (let ((trigger-sphere (new 'process 'collide-shape-prim-sphere root-shape (the-as uint 0))))
      (set! (-> trigger-sphere prim-core collide-as) (collide-kind enemy))
      (set! (-> trigger-sphere collide-with) (collide-kind target))
      (set-vector! (-> trigger-sphere local-sphere) 0.0 0.0 0.0 12288.0)
      (set-root-prim! root-shape trigger-sphere))
    (set! (-> root-shape nav-radius) (* 0.75 (-> root-shape root-prim local-sphere w)))
    (backup-collide-with-as root-shape)
    (set! (-> self root) root-shape))
  (set! (-> self root trans quad) (-> position quad))
  (set-vector! (-> self root scale) 1.0 1.0 1.0 1.0)
  (set-vector! (-> self root quat) 0.0 0.0 0.0 1.0)
  (update-transforms! (-> self root))
  (set! (-> self spring-height) spring-height)
  (set! (-> self active-distance) active-distance)
  (let ((level-name (-> self entity extra level name)))
    (set! (-> self part)
          (create-launch-control (cond
                                   ((= level-name 'beach) group-beach-launcher)
                                   ((= level-name 'swamp) group-swamp-launcher)
                                   (else group-jungle-launcher))
                                 self)))
  (case (logand packed-mode 255)
    ((1) (set! (-> self camera) cam-launcher-longfall))
    ((2) (set! (-> self camera) #f))
    (else (set! (-> self camera) cam-launcher-shortfall)))
  (let ((destination-spec (res-lump-struct (-> self entity) 'alt-vector vector)))
    (when destination-spec
      (set-vector! (-> self dest) (-> destination-spec x) (-> destination-spec y) (-> destination-spec z) 1.0)
      (set! (-> self seek-time) (the-as time-frame (the int (* 300.0 (-> destination-spec w)))))))
  (set! (-> self sound-id) (new-sound-id))
  (go launcher-idle)
  (none))

;; Track optional moving collision geometry and test it against the touching
;; list until run-function becomes false. Touches ignore the owner. Attack
;; events retain or allocate attack IDs as appropriate; a configured ordinary
;; event uses the owner as sender, and an unconfigured tracker forwards the
;; original message block to its owner.
(defstate touch-tracker-idle (touch-tracker)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (local-vars (value object))
      (case message
        (('touched)
         (let ((owner (ppointer->process (-> self parent))))
           (when (!= owner proc)
             (cond
               ((= (-> self event) 'attack)
                (cond
                  ((= (-> proc type) target)
                   (send-event proc (-> self event) :from (the-as process owner) #f (static-attack-info ((mode (-> self event-mode))))))
                  ((= (-> owner type) target)
                   (send-event proc
                               (-> self event)
                               :from (the-as process owner)
                               #f
                               (-> self event-mode)
                               (-> *target* control target-attack-id)
                               (-> *target* control attack-count)))
                  (else
                   (let ((attack-message (new 'stack-no-clear 'event-message-block)))
                     (set! (-> attack-message from) (the-as process owner))
                     (set! (-> attack-message num-params) 4)
                     (set! (-> attack-message message) (-> self event))
                     (set! (-> attack-message param 0) (the-as uint #f))
                     (set! (-> attack-message param 1) (the-as uint (-> self event-mode)))
                     (let ((attack-id (+ *global-attack-id* 1)))
                       (set! *global-attack-id* attack-id)
                       (set! (-> attack-message param 2) (the-as uint attack-id)))
                     (set! (-> attack-message param 3) (the-as uint 0))
                     (send-event-function proc attack-message)))))
               ((-> self event) (send-event proc (-> self event) :from (the-as process owner)))
               (else
                (let ((forwarded-message (new 'stack-no-clear 'event-message-block)))
                  (set! (-> forwarded-message from) proc)
                  (set! (-> forwarded-message num-params) argc)
                  (set! (-> forwarded-message message) message)
                  (set! (-> forwarded-message param 0) (-> block param 0))
                  (set! (-> forwarded-message param 1) (-> block param 1))
                  (set! (-> forwarded-message param 2) (-> block param 2))
                  (set! (-> forwarded-message param 3) (-> block param 3))
                  (set! (-> forwarded-message param 4) (-> block param 4))
                  (set! (-> forwarded-message param 5) (-> block param 5))
                  (set! (-> forwarded-message param 6) (-> block param 6))
                  (send-event-function owner forwarded-message)))))))
        (('target)
         (set! value (process->handle (the-as process (-> block param 0))))
         (set! (-> self target) (the-as handle value))
         value)
        (('event)
         (set! (-> self event) (the-as symbol (-> block param 0)))
         (set! value (-> block param 1))
         (set! (-> self event-mode) (the-as symbol value))
         value)
        (('exit) (set! value (-> block param 0)) (set! (-> self run-function) (the-as (function object) value)) value)
        (('eval) ((the-as (function touch-tracker none) (-> block param 0)) self))
        (('function)
         (set! value (-> block param 0))
         (set! (-> self callback) (the-as (function touch-tracker none) value))
         value)))
  :code
    (behavior ()
      (set-time! (-> self state-time))
      (while ((-> self run-function))
        (let* ((target-process (handle->process (-> self target)))
               (target-drawable (if (and (nonzero? target-process) (type-type? (-> target-process type) process-drawable)) target-process)))
          (when target-drawable
            (let* ((target-root (-> (the-as process-drawable target-drawable) root))
                   (target-shape (if (and (nonzero? target-root) (type-type? (-> target-root type) collide-shape)) target-root)))
              (if target-shape
                (set! (-> self root trans quad) (-> (the-as collide-shape target-shape) root-prim prim-core world-sphere quad))))))
        (if (-> self callback) ((-> self callback) self))
        (update-transforms! (-> self root))
        (let ((overlap-params (new 'stack-no-clear 'overlaps-others-params)))
          (set! (-> overlap-params options) (overlaps-others-options accept-root-sphere-overlap))
          (set! (-> overlap-params tlist) *touching-list*)
          (find-overlapping-shapes (-> self root) overlap-params))
        (suspend))
      (clear-collide-with-as (-> self root))
      (suspend)
      0))

(defbehavior touch-tracker-init touch-tracker ((position vector) (radius float) (duration time-frame))
  "Create a moving collision sphere at position with radius and keep it active for duration. Events
   can later choose a target to follow, forwarded touch event, callback, and early-exit predicate."
  (let ((tracker-shape (new 'process 'collide-shape-moving self (collide-list-enum hit-by-player))))
    (set! (-> tracker-shape dynam) (copy *standard-dynamics* 'process))
    (set! (-> tracker-shape reaction) default-collision-reaction)
    (set! (-> tracker-shape no-reaction)
          (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (let ((trigger-sphere (new 'process 'collide-shape-prim-sphere tracker-shape (the-as uint 0))))
      (set! (-> trigger-sphere prim-core collide-as) (collide-kind target enemy))
      (set! (-> trigger-sphere collide-with) (collide-kind cak-1 cak-2 cak-3 powerup crate enemy wall-object ground-object))
      (set! (-> trigger-sphere prim-core offense) (collide-offense indestructible))
      (set-vector! (-> trigger-sphere local-sphere) 0.0 0.0 0.0 radius)
      (set-root-prim! tracker-shape trigger-sphere))
    (set! (-> tracker-shape nav-radius) (* 0.75 (-> tracker-shape root-prim local-sphere w)))
    (backup-collide-with-as tracker-shape)
    (set! (-> tracker-shape event-self) 'touched)
    (set! (-> self root) tracker-shape))
  (set! (-> self root trans quad) (-> position quad))
  (set! (-> self duration) duration)
  (set! (-> self target) (the-as handle #f))
  (set! (-> self event) #f)
  (set! (-> self callback) #f)
  (set! (-> self run-function)
        (lambda :behavior touch-tracker ()
          (not (time-elapsed? (-> self state-time) (-> self duration)))))
  (set! (-> self event-hook) (-> touch-tracker-idle event))
  (go touch-tracker-idle)
  (none))

(defun process-drawable-random-point! ((drawable process-drawable) (result vector))
  "Write a random point associated with drawable into result. When eligible joints exist, select
   one from indices 3 through the final node and use its translation. Otherwise sample a random
   direction and radius inside the drawable's collision sphere or root-centered draw bounds; this
   fallback is neither a uniform surface nor a uniform-volume sample."
  (let ((node-count (-> drawable node-list length))
        (root (-> drawable root)))
    (cond
      ((>= node-count 7)
       (let ((node-index (rand-vu-int-range 3 (+ node-count -1))))
         (vector<-cspace! result (-> drawable node-list data node-index))))
      ((and (nonzero? root) (type-type? (-> root type) collide-shape))
       (vector+! result
                 (-> (the-as collide-shape root) root-prim prim-core world-sphere)
                 (rand-vu-sphere-point! result (-> (the-as collide-shape root) root-prim prim-core world-sphere w))))
      (else (vector+! result (-> drawable root trans) (rand-vu-sphere-point! result (-> drawable draw bounds w))))))
  result)

(defun process-drawable-pair-random-point! ((first process-drawable) (second process-drawable) (result vector) (amount float))
  "Choose one random point on each drawable and interpolate between them by amount into result."
  (let ((first-point (new-stack-vector0))
        (second-point (new-stack-vector0)))
    (process-drawable-random-point! first first-point)
    (process-drawable-random-point! second second-point)
    (vector-lerp! result first-point second-point amount)))

(define *particle-quat* (new 'static 'quaternion :w 1.0))

(defun birth-func-set-quat ((particle-system sparticle-system) (cpuinfo sparticle-cpuinfo) (launch-info sparticle-launchinfo))
  "Install the shared beam orientation in this sprite's packed cone-rotation field. The sprite
   format reconstructs a nonnegative quaternion w, so negate xyz when the shared quaternion lies in
   the negative-w hemisphere; preserve the existing cone-rotation w."
  (local-vars (negative-orientation-x float) (positive-orientation-x float))
  (rlet ((vf0 :class vf)
         (vf1 :class vf)
         (vf2 :class vf))
    (init-vf0-vector)
    (let ((launch-info launch-info)
          (beam-orientation *particle-quat*))
      (cond
        ((< (-> beam-orientation w) 0.0)
         (.lvf vf1 (&-> launch-info conerot quad))
         (.lvf vf2 (&-> beam-orientation vec quad))
         (.sub.vf.xyz vf1 vf0 vf2)
         (.svf (&-> launch-info conerot quad) vf1)
         (.mov negative-orientation-x vf1))
        (else
         (.lvf vf1 (&-> launch-info conerot quad))
         (.lvf vf2 (&-> beam-orientation vec quad))
         (.add.vf.xyz vf1 vf0 vf2)
         (.svf (&-> launch-info conerot quad) vf1)
         (.mov positive-orientation-x vf1))))
    0
    (none)))

(defpart 2528
  :init-specs
  ((:texture (citadel-shield effects))
   (:birth-func 'birth-func-set-quat)
   (:num 1.0)
   (:scale-x (meters 2) (meters 0.5))
   (:scale-y (meters 5.6))
   (:r 0.0 44.0)
   (:g 0.0 64.0)
   (:b 128.0 32.0)
   (:a 128.0)
   (:timer (seconds 0.017))
   (:flags (die-when-faded glow no-fog left-multiply-quat))))

(defun draw-eco-beam ((start vector) (end vector))
  "When the segment from start to end is visible, place a shield particle at its midpoint, scale
   it to the beam length, and orient it along the segment. Launch three crossed planes, rolling the
   orientation by 60 degrees between launches, to give the beam visible volume."
  (when (line-in-view-frustum? start end)
    (let ((displacement (vector-! (new 'stack-no-clear 'vector) end start))
          (midpoint (new 'stack-no-clear 'vector))
          (direction (new 'stack-no-clear 'vector))
          (orientation (new 'stack-no-clear 'quaternion)))
      (vector+*! midpoint start displacement 0.5)
      (vector-normalize-copy! direction displacement 1.0)
      (set! (-> *part-id-table* 2528 init-specs 4 initial-valuef) (vector-length displacement))
      (forward-up->quaternion orientation direction *y-vector*)
      (dotimes (i 3)
        (quaternion-rotate-local-z! orientation orientation 10922.667)
        (quaternion-copy! *particle-quat* orientation)
        (launch-particles :system *sp-particle-system-3d* (-> *part-id-table* 2528) midpoint))))
  0
  (none))

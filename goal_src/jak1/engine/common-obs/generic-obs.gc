;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/common-obs/process-drawable.gc")
(require "engine/nav/navigate-h.gc")
(require "pc/util/pc-anim-util.gc")
(require "engine/level/level.gc")
(require "engine/camera/camera.gc")

;; note: changed for high fps

(define-extern convert-to-hud-object (function process-drawable hud none :behavior process-drawable))

;; TODO - temporary

(define-extern process-drawable-from-entity! (function process-drawable entity-actor none))

(declare-type beach-part part-spawner)

(define-extern beach-part-grotto-1 (state beach-part))

(defmacro manipy-spawn (trans entity skel arg &key (from *default-dead-pool*) &key (to *default-pool*) &key (name #f) &key (stack-size #x4000) &key (stack *scratch-memory-top*))
  `(process-spawn manipy
                 :init
                 manipy-init
                 ,trans
                 ,entity
                 ,skel
                 ,arg
                 :from ,from
                 :to ,to
                 :name ,name
                 :stack-size ,stack-size
                 :stack ,stack))

;; DECOMP BEGINS

(defbehavior clone-anim-once process-drawable ((source-handle handle) (origin-joint-index int) (copy-transform? symbol) (prefix string))
  "Copy and remap one animation pose from source-handle. Optionally copy its transform, update joint
   math and effects, and place this drawable's origin at origin-joint-index when nonnegative."
  (logclear! (-> self skel status) (janim-status spool))
  (let ((source (handle->process source-handle)))
    (if (the-as process-drawable source) (joint-control-copy! (-> self skel) (-> (the-as process-drawable source) skel)))
    (cond
      ((and (the-as process-drawable source)
            (joint-control-remap! (-> self skel)
                                  (-> self draw art-group)
                                  (-> (the-as process-drawable source) draw art-group)
                                  '()
                                  0
                                  prefix))
       (when copy-transform?
         (let* ((root (-> self root))
                (collision-root (if (and (nonzero? root) (type-type? (-> root type) collide-shape)) (the-as collide-shape root))))
           (if collision-root
             (move-to-point! collision-root (-> (the-as process-drawable source) root trans))
             (set! (-> self root trans quad) (-> (the-as process-drawable source) root trans quad))))
         (quaternion-copy! (-> self root quat) (-> (the-as process-drawable source) root quat)))
       (if (logtest? (-> (the-as process-drawable source) skel status) (janim-status spool))
         (logior! (-> self skel status) (janim-status spool)))
       (logclear! (-> self draw status) (draw-status hidden no-anim))
       (if (not (-> self skel root-channel 0 frame-group)) (logior! (-> self draw status) (draw-status no-anim)))
       (let* ((drawable-self self)
              (manipy-self (if (and (nonzero? drawable-self) (type-type? (-> drawable-self type) manipy)) drawable-self)))
         (if (and manipy (not (-> (the-as manipy manipy-self) draw?))) (logior! (-> self draw status) (draw-status no-anim))))
       (do-joint-math! self)
       (let ((effects (-> self skel effect))) (if effects (update-effects effects)))
       (if (logtest? (-> self skel status) (janim-status blerc blerc-done)) (merc-blend-shape self))
       (if (logtest? (-> self skel status) (janim-status eye-done eye)) (merc-eye-anim self)))
      (else (logior! (-> self draw status) (draw-status hidden)) (ja-post))))
  (if (>= origin-joint-index 0) (vector<-cspace! (-> self draw origin) (-> self node-list data origin-joint-index)))
  0
  (none))

(defbehavior clone-anim process-drawable ((source-handle handle) (origin-joint-index int) (unused-copy-transform? symbol) (prefix string))
  "Copy a remapped animation pose from source-handle once per frame until the source process
   disappears, then clear this drawable's spooling status."
  (ja-post)
  (while (handle->process source-handle)
    (clone-anim-once source-handle origin-joint-index #t prefix)
    (suspend))
  (logclear! (-> self skel status) (janim-status spool))
  0
  (none))

;; Offer the pole when Jak's hand midpoint is close enough, below the upper
;; half of the grab volume, and his collision action permits an edge grab.
;; Once occupied, wait for his control handle to release the pole before
;; making it available again.
(defstate swingpole-stance (swingpole)
  :code
    (behavior ()
      (loop
        (when (and *target*
                   (< (vector-vector-distance (-> self root trans) (-> *target* control midpoint-of-hands)) (-> self range))
                   (logtest? (-> *target* control root-prim prim-core action) (collide-action edgegrab-possible))
                   (< (-> *target* control midpoint-of-hands y) (+ (-> self root trans y) (/ (-> self range) 2))))
          (if (send-event *target* 'pole-grab self) (go swingpole-active)))
        (suspend))))

(defstate swingpole-active (swingpole)
  :code
    (behavior ()
      (suspend)
      (while (and *target* (= (handle->process (-> *target* control swingpole-handle)) self))
        (suspend))
      (suspend-for (seconds 0.5))
      (go swingpole-stance)))

(defmethod init-from-entity! ((this swingpole) (source-entity entity-actor))
  "Initialize the pole transform and horizontal facing from entity, install its grab range,
   and begin waiting for a nearby edge-grab-capable target."
  "Copy defaults from the entity."
  (stack-size-set! (-> this main-thread) 128)
  (logior! (-> this mask) (process-mask actor-pause))
  (set! (-> this root) (new 'process 'trsq))
  (set! (-> this root trans quad) (-> source-entity extra trans quad))
  (quaternion-copy! (-> this root quat) (-> source-entity quat))
  (vector-identity! (-> this root scale))
  (vector-y-quaternion! (-> this dir) (-> this root quat))
  (set! (-> this dir y) 0.0)
  (vector-normalize! (-> this dir) 1.0)
  (set! (-> this range) 12288.0)
  (set! (-> this edge-length) 8192.0)
  (go swingpole-stance)
  (none))

(defstate die (process-hidden)
  :virtual #t
  :code nothing)

(defmethod init-from-entity! ((this process-hidden) (source-entity entity-actor))
  "Mark the source entity dead and enter this hidden process's virtual die state."
  "Copy defaults from the entity."
  (process-entity-status! this (entity-perm-status dead) #t)
  (go (method-of-object this die))
  (none))

(deftype target-start (process-hidden) ())

(deftype camera-start (process-hidden) ())

;; Manipys are small script-controlled drawables. Events select animation and
;; cloning modes, replace frame hooks, attach the drawable to another process,
;; move or rotate it, and control visibility. Hook changes take effect in the
;; transition phase; the code phase then evaluates animation and post hooks.
(defstate manipy-idle (manipy)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (local-vars (result object))
      (case message
        (('attackable)
         (cond
           ((-> block param 0)
            (set! result (logior (process-mask attackable) (-> self mask)))
            (set! (-> self mask) (the-as process-mask result)))
           (else
            (set! result (logclear (-> self mask) (process-mask attackable)))
            (set! (-> self mask) (the-as process-mask result))))
         result)
        (('blend-shape)
         (cond
           ((-> block param 0)
            (set! result (logior (-> self skel status) (janim-status blerc eye)))
            (set! (-> self skel status) (the-as janim-status result)))
           (else
            (set! result (logclear (-> self skel status) (janim-status blerc eye)))
            (set! (-> self skel status) (the-as janim-status result))))
         result)
        (('shadow)
         (cond
           ((-> block param 0)
            (set! result (-> self shadow-backup))
            (set! (-> self draw shadow) (the-as shadow-geo result))
            result)
           (else (set! (-> self draw shadow) #f) #f)))
        (('trans-hook) (set! result (-> block param 0)) (set! (-> self new-trans-hook) (the-as (function none) result)) result)
        (('post-hook) (set! result (-> block param 0)) (set! (-> self new-post-hook) (the-as (function none) result)) result)
        (('eval) ((the-as (function manipy none) (-> block param 0)) self))
        (('become-hud-object) (convert-to-hud-object self (the-as hud (-> block param 0))))
        (('event-hook) (set! result (-> block param 0)) (set! (-> self cur-event-hook) (the-as (function none) result)) result)
        (('art-joint-anim)
         (set! (-> self new-joint-anim)
               (the-as art-joint-anim (lookup-art (-> self draw art-group) (the-as string (-> block param 0)) art-joint-anim)))
         (set! result (-> block param 1))
         (set! (-> self new-joint-anim-blend) (the-as uint result))
         result)
        (('anim-mode)
         (when (nonzero? (-> self skel))
           (set! (-> self anim-mode) (the-as symbol (-> block param 0)))
           (if (= (-> self anim-mode) 'clone-anim) (ja-post))
           (-> self anim-mode)))
        (('origin-joint-index 'center-joint)
         (set! (-> self draw origin-joint-index) (-> block param 0))
         (set! result (-> block param 0))
         (set! (-> self draw shadow-joint-index) (the-as uint result))
         result)
        (('max-vis-dist) (set! (-> self draw lod-set lod (-> self draw lod-set max-lod) dist) (the-as float (-> block param 0))))
        (('grab)
         (set! (-> self cur-grab-handle) (process->handle (the-as process (-> block param 0))))
         (let ((grabbed-process (handle->process (-> self cur-grab-handle))))
           (when grabbed-process
             (set! result (-> self old-grab-pos))
             (set! (-> (the-as vector result) quad) (-> (the-as process-drawable grabbed-process) root trans quad))
             result)))
        (('target)
         (set! result (process->handle (the-as process (-> block param 0))))
         (set! (-> self cur-target-handle) (the-as handle result))
         result)
        (('trans)
         (cond
           ((type-type? (-> self root type) collide-shape)
            (move-to-point! (the-as collide-shape (-> self root)) (the-as vector (-> block param 0))))
           (else
            (set! result (-> self root trans))
            (set! (-> (the-as vector result) quad) (-> (the-as vector (-> block param 0)) quad))
            result)))
        (('rot)
         (let ((rotation-matrix (new 'stack-no-clear 'matrix)))
           (matrix-rotate-y! rotation-matrix (the-as float (-> block param 0)))
           (matrix->quaternion (-> self root quat) rotation-matrix)))
        (('rot-quat) (quaternion-copy! (-> self root quat) (the-as quaternion (-> block param 0))))
        (('clone-copy-trans) (set! result (-> block param 0)) (set! (-> self clone-copy-trans) (the-as symbol result)) result)
        (('release) (set! (-> self cur-grab-handle) (the-as handle #f)) #f)
        (('draw)
         (set! (-> self draw?) (the-as symbol (-> block param 0)))
         (cond
           ((-> block param 0)
            (let ((was-hidden? (logtest? (-> self draw status) (draw-status hidden))))
              (logclear! (-> self draw status) (draw-status hidden))
              (when was-hidden?
                (cond
                  ((nonzero? (-> self skel))
                   (let ((saved-skeleton-status (-> self skel status)))
                     (logior! (-> self skel status) (janim-status inited))
                     (set! result (ja-post))
                     (set! (-> self skel status) saved-skeleton-status))
                   result)
                  (else (ja-post))))))
           (else
            (set! result (logior (-> self draw status) (draw-status hidden)))
            (set! (-> self draw status) (the-as draw-status result))
            result)))
        (('query)
         (case (-> block param 0)
           (('grab) (handle->process (-> self cur-grab-handle)))
           (('done)
            (case (-> self anim-mode)
              (('play1 'play) (>= (ja-frame-num 0) (the float (+ (-> (ja-group) data 0 length) -2))))))))
        (('set-frame-num)
         (let ((root-channel (-> self skel root-channel 0)))
           (set! (-> root-channel num-func) num-func-identity)
           (set! (-> root-channel frame-num) (the-as float (-> block param 0)))))
        (else (if (-> self cur-event-hook) ((-> self cur-event-hook))))))
  :trans
    (behavior ()
      (if (!= (-> self cur-trans-hook) (-> self new-trans-hook)) (set! (-> self cur-trans-hook) (-> self new-trans-hook)))
      (if (!= (-> self cur-post-hook) (-> self new-post-hook)) (set! (-> self cur-post-hook) (-> self new-post-hook)))
      (when (and (-> self new-joint-anim)
                 (nonzero? (-> self skel))
                 (and (!= (ja-group) (-> self new-joint-anim)) (!= (-> self anim-mode) 'clone-anim)))
        (ja-channel-push! 1 (the-as time-frame (-> self new-joint-anim-blend)))
        (ja :group! (-> self new-joint-anim) :num! min))
      (let ((grabbed-process (handle->process (-> self cur-grab-handle))))
        (when grabbed-process
          (let ((grabbed-position (-> (the-as process-drawable grabbed-process) root trans)))
            (if (type-type? (-> self root type) collide-shape)
              (move-by-vector! (the-as collide-shape (-> self root))
                               (vector-! (new 'stack-no-clear 'vector) grabbed-position (-> self old-grab-pos)))
              (vector+! (-> self root trans)
                        (-> self root trans)
                        (vector-! (new 'stack-no-clear 'vector) grabbed-position (-> self old-grab-pos))))
            (set! (-> self old-grab-pos quad) (-> grabbed-position quad)))))
      ((-> self cur-trans-hook)))
  :code
    (behavior ()
      (logclear! (-> self mask) (process-mask heap-shrunk))
      (loop
        ((-> self cur-post-hook))
        (if (!= (-> self anim-mode) 'clone-anim) (ja-post))
        (suspend)
        (case (-> self anim-mode)
          (('loop) (ja :num! (loop!)))
          (('play) (ja :num! (seek!)))
          (('copy-parent)
           (ja :num-func
               num-func-identity
               :frame-num
               (-> (the-as process-drawable (ppointer->process (-> self parent))) skel root-channel 0 frame-num)))
          (('clone-parent)
           (let ((parent-drawable (ppointer->process (-> self parent))))
             (set! (-> self post-hook) #f)
             (joint-control-copy! (-> self skel) (-> (the-as process-drawable parent-drawable) skel))
             (joint-control-remap! (-> self skel)
                                   (-> self draw art-group)
                                   (-> (the-as process-drawable parent-drawable) draw art-group)
                                   '()
                                   0
                                   ""))
           (do-joint-math! self))
          (('clone-anim)
           (clone-anim-once (if (handle->process (-> self cur-target-handle))
                              (the-as handle (-> self cur-target-handle))
                              (ppointer->handle (-> self parent)))
                            (the-as int (-> self draw origin-joint-index))
                            (-> self clone-copy-trans)
                            ""))
          (('still))
          (('play1) (ja :num! (seek!)) (if (ja-done? 0) (deactivate self)))))))

(defbehavior manipy-init manipy ((position vector) (source-entity entity-actor) (skel-group skeleton-group) (collision-option vector))
  "Initialize a manipy drawable at position with skeleton. collision-option selects an ordinary
   transform when false, a collectable collision sphere when it is a vector, or moving collision when
   it is collide-shape-moving; then enter the event-driven animation state."
  ;; og:preserve-this increased from 128
  (stack-size-set! (-> self main-thread) 256)
  (logior! (-> self mask) (process-mask heap-shrunk))
  (set! (-> self entity) source-entity)
  (cond
    ((= collision-option 'collide-shape-moving)
     (let ((moving-root (new 'process 'collide-shape-moving self (collide-list-enum hit-by-player))))
       (set! (-> moving-root dynam) (copy *standard-dynamics* 'process))
       (set! (-> moving-root reaction) default-collision-reaction)
       (set! (-> moving-root no-reaction)
             (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
       (let ((moving-sphere (new 'process 'collide-shape-prim-sphere moving-root (the-as uint 0))))
         (set-vector! (-> moving-sphere local-sphere) 0.0 0.0 0.0 4096.0)
         (set-root-prim! moving-root moving-sphere))
       (set! (-> moving-root nav-radius) (* 0.75 (-> moving-root root-prim local-sphere w)))
       (backup-collide-with-as moving-root)
       (set! (-> self root) moving-root)))
    (collision-option
     (let ((collectable-root (new 'process 'collide-shape self (collide-list-enum hit-by-player))))
       (let ((collectable-sphere (new 'process 'collide-shape-prim-sphere collectable-root (the-as uint 0))))
         (set! (-> collectable-sphere prim-core collide-as) (collide-kind powerup blue-eco-suck))
         (set! (-> collectable-sphere collide-with) (collide-kind target))
         (set-vector! (-> collectable-sphere local-sphere)
                      (-> collision-option x)
                      (-> collision-option y)
                      (-> collision-option z)
                      (-> collision-option w))
         (set-root-prim! collectable-root collectable-sphere))
       (set! (-> collectable-root nav-radius) (* 0.75 (-> collectable-root root-prim local-sphere w)))
       (backup-collide-with-as collectable-root)
       (set! (-> self root) collectable-root)))
    (else (set! (-> self root) (new 'process 'trsqv))))
  (set! (-> self root trans quad) (-> position quad))
  (initialize-skeleton self skel-group '())
  (if (type-type? (-> self root type) collide-shape) (update-transforms! (the-as collide-shape (-> self root))))
  (set! (-> self shadow-backup) (-> self draw shadow))
  (set! (-> self new-trans-hook) nothing)
  (set! (-> self cur-trans-hook) nothing)
  (set! (-> self new-post-hook) nothing)
  (set! (-> self cur-post-hook) nothing)
  (set! (-> self cur-event-hook) #f)
  (set! (-> self cur-grab-handle) (the-as handle #f))
  (set! (-> self cur-target-handle) (the-as handle #f))
  (set! (-> self clone-copy-trans) #t)
  (set! (-> self draw?) #t)
  (cond
    ((nonzero? (-> self skel))
     (set! (-> self new-joint-anim) (ja-group))
     (set! (-> self anim-mode) 'loop)
     ;; og:preserve-this
     (#when PC_PORT
       (set! (-> self skel postbind-function) process-drawable-joint-callback-pc)))
    (else (set! (-> self anim-mode) 'still)))
  (set! (-> self event-hook) (-> manipy-idle event))
  (go manipy-idle)
  (none))

(defmethod deactivate ((this part-tracker))
  "Kill this tracker's live particles before performing ordinary process deactivation."
  (if (nonzero? (-> this part)) (kill-and-free-particles (-> this part)))
  ((method-of-type process deactivate) this)
  (none))

(defbehavior part-tracker-notify part-tracker ()
  "Send the parent process a notify event whose first parameter is die."
  (let ((notification (new 'stack-no-clear 'event-message-block)))
    (set! (-> notification from) self)
    (set! (-> notification num-params) 1)
    (set! (-> notification message) 'notify)
    (set! (-> notification param 0) (the-as uint 'die))
    (let ((send-event-fn send-event-function)
          (parent-process (ppointer->process (-> self parent))))
      (send-event-fn (if (and (nonzero? parent-process) (type-type? (-> parent-process type) process)) parent-process)
                     notification))))

;; Follow the target for the active duration and emit at the resulting
;; position. The optional frame callback may adjust the launch control before
;; each spawn. Afterward, keep invoking the linger callback through the
;; particle group's linger interval, notify the parent, and stop.
(defstate part-tracker-process (part-tracker)
  :code
    (behavior ()
      (set-time! (-> self start-time))
      (while (not (time-elapsed? (-> self start-time) (-> self duration)))
        (let ((target-process (handle->process (-> self target))))
          (when target-process
            (if (and target-process
                     (type-type? (-> target-process type) process-drawable)
                     (nonzero? (-> (the-as process-drawable target-process) root)))
              (vector+! (-> self root trans) (-> (the-as process-drawable target-process) root trans) (-> self offset)))))
        (let ((emission-position (-> self root trans)))
          (if (-> self callback) ((-> self callback) self))
          (spawn (-> self part) emission-position))
        (suspend))
      (suspend-for (-> self linger-duration)
        (if (-> self linger-callback) ((-> self linger-callback) self)))
      (if (-> self linger-callback) ((-> self linger-callback) self))
      (part-tracker-notify)
      (suspend)
      0))

(defbehavior part-tracker-init part-tracker ((launch-group sparticle-launch-group)
              (duration time-frame)
              (frame-callback (function part-tracker none))
              (userdata (pointer process-drawable))
              (target-process process)
              (origin collide-prim-core))
  "Initialize a particle tracker at source-prim. Follow target for duration, or use the particle
   group's duration when duration is not positive, invoking callback each frame when supplied."
  (stack-size-set! (-> self main-thread) 128)
  (set! (-> self root) (new 'process 'trsqv))
  (set! (-> self root trans quad) (-> origin world-sphere quad))
  (set! (-> self offset quad) (-> origin world-sphere quad))
  (set! (-> self callback) (the-as (function part-tracker vector) frame-callback))
  (set! (-> self linger-callback) #f)
  (set! (-> self userdata) (the-as uint userdata))
  (set! (-> self target) (process->handle target-process))
  (set! duration
        (cond
          ((> duration 0) (empty) duration)
          (else (the-as time-frame (-> launch-group duration)))))
  (set! (-> self duration) (the-as time-frame duration))
  (set! (-> self linger-duration) (the-as time-frame (-> launch-group linger-duration)))
  (set! (-> self part) (create-launch-control launch-group self))
  (go part-tracker-process)
  (none))

(defbehavior command-get-process camera-tracker ((process-spec object) (default-process process))
  "Resolve selector to a process. Selectors may be processes, target, sidekick, parent, camera, a
   named entity string, or a camera tracker's work, grab, look-at, pov, and anim handles. Return false
   for a recognized handle that is no longer valid, or fallback for an unsupported selector."
  (the-as process
          (cond
            ((null? process-spec) (empty) default-process)
            ((type-type? (rtype-of process-spec) process) (the-as process process-spec))
            ((= process-spec 'target) *target*)
            ((= process-spec 'sidekick)
             (when *target*
               (let ((sidekick-pointer (-> *target* sidekick))) (if sidekick-pointer (the-as process (-> sidekick-pointer 0 self))))))
            ((= process-spec 'parent)
             (let ((parent-pointer (-> self parent))) (if parent-pointer (the-as process (-> parent-pointer 0 self)))))
            ((= process-spec 'camera) *camera*)
            ((type-type? (rtype-of process-spec) string) (process-by-ename (the-as string process-spec)))
            ((type-type? (-> self type) camera-tracker)
             (let ((tracker self))
               (cond
                 ((= process-spec 'work) (handle->process (-> tracker work-process)))
                 ((= process-spec 'grab) (handle->process (-> tracker grab-target)))
                 ((= process-spec 'look-at) (handle->process (-> tracker look-at-target)))
                 ((= process-spec 'pov) (handle->process (-> tracker pov-target)))
                 ((= process-spec 'anim) (handle->process (-> tracker anim-process)))
                 (else (empty) default-process))))
            (else (empty) default-process))))

(defun command-get-camera ((camera-spec object) (default-camera state))
  "Resolve selector to a camera state or named camera entity, returning fallback for an unsupported
   selector. The base, string, and fixed symbols select their standard camera states."
  (cond
    ((null? camera-spec) (empty) default-camera)
    ((= camera-spec 'base) *camera-base-mode*)
    ((= camera-spec 'string) cam-string)
    ((= camera-spec 'fixed) cam-fixed)
    ((type-type? (rtype-of camera-spec) symbol) (the-as state (-> (the-as symbol camera-spec) value)))
    ((type-type? (rtype-of camera-spec) string) (the-as state camera-spec))
    ((type-type? (rtype-of camera-spec) state) (the-as state camera-spec))
    (else (empty) default-camera)))

(defun command-get-trans ((position-spec object) (default-position vector))
  "Resolve a camera-script position. Accept null for fallback, the null and target symbols, or a
   (process-selector joint-index) pair naming one joint's translation."
  (cond
    ((null? position-spec) (empty) default-position)
    ((= position-spec 'null) *null-vector*)
    ((= position-spec 'target) (target-pos 0))
    ((pair? position-spec)
     (let ((target-process (command-get-process (car position-spec) *target*))
           (joint-index (command-get-int (car (cdr position-spec)) 0)))
       (cond
         (target-process (-> (the-as target target-process) node-list data joint-index bone transform vector 3))
         (else (empty) default-position))))
    (else (empty) default-position)))

(defbehavior process-grab? camera-tracker ((target-spec process))
  "Resolve target-process, remember it when called by a camera tracker, and ask it to enter grab
   mode. Return the target's response, or false when it cannot be resolved."
  (let ((target-process (command-get-process target-spec *target*)))
    (the-as symbol
            (when target-process
              (if (type-type? (-> self type) camera-tracker) (set! (-> self grab-target) (process->handle target-process)))
              (send-event target-process 'change-mode 'grab)))))

(defbehavior process-release? process ((target-spec process))
  "Resolve target-process and query its current mode. If the query returns any truthy value, send
   end-mode and return that response; otherwise return true."
  (let ((target-process (command-get-process target-spec *target*)))
    (the-as symbol
            (if (and target-process (send-event target-process 'query 'mode) 'target-grab) (send-event target-process 'end-mode) #t))))

(defun camera-change-to ((camera-spec object) (transition-time int) (blend-from-fixed? symbol))
  "Resolve camera-selector and change the master camera to the named entity or state, blending for
   blend-time 300-Hz ticks. When fixed-blend? is true, request a fixed-source blend. Return false when
   the selector cannot be resolved."
  (let ((camera-selection (command-get-camera camera-spec *camera-base-mode*)))
    (cond
      ((not camera-selection) #f)
      ((type-type? (rtype-of camera-selection) string) (send-event *camera* 'change-to-entity-by-name camera-selection) #t)
      ((type-type? (rtype-of camera-selection) state)
       (send-event *camera* 'change-state camera-selection transition-time)
       (if blend-from-fixed? (send-event *camera* 'blend-from-as-fixed))
       #t))))

(defbehavior camera-look-at camera-tracker ((target-spec object) (joint-index uint))
  "Resolve target-selector, remember it when called by a camera tracker, and make the master camera
   look at its joint-index. Return the resolved process or false."
  (let ((target-process (command-get-process target-spec *target*)))
    (when target-process
      (if (type-type? (-> self type) camera-tracker) (set! (-> self look-at-target) (process->handle target-process)))
      (send-event *camera* 'change-target target-process joint-index))
    target-process))

(defun ja-anim-done? ((target-spec process))
  "Resolve target-process and return whether its current animation is finished. Manipys answer
   through their query event; other drawables use channel zero's joint-animation state."
  (with-pp
    (let ((target-process (command-get-process target-spec *target*)))
      (the-as symbol
              (when target-process
                (cond
                  ((type-type? (-> target-process type) manipy) (send-event target-process 'query 'done))
                  ((type-type? (-> target-process type) process-drawable)
                   (when (not (logtest? (-> (the-as process-drawable target-process) skel status) (janim-status done)))
                     (let ((saved-pp pp)) (set! pp target-process) (let ((done? (the-as object (ja-done? 0)))) (set! pp saved-pp) done?))))))))))

(defbehavior camera-pov-from camera-tracker ((target-spec object) (joint-index int))
  "Resolve target-selector and make the master camera use joint-index as its point of view. A joint
   index of -10 selects the model's camera joint when present. Return the resolved process or false."
  (let ((target-process (command-get-process target-spec *target*)))
    (when target-process
      (if (type-type? (-> self type) camera-tracker) (set! (-> self pov-target) (process->handle target-process)))
      (when (= joint-index -10)
        (set! joint-index 0)
        (when (> (-> (the-as process-drawable target-process) skel active-channels) 0)
          (let ((camera-joint (lookup-art (-> (the-as process-drawable target-process) draw jgeo) "camera" (the-as type #f))))
            (if camera-joint (set! joint-index (+ (-> camera-joint number) 1))))))
      (send-event *camera* 'change-pov target-process joint-index))
    target-process))

(defbehavior camera-anim camera-tracker ((camera-skeleton skeleton-group) (animation-name string) (position vector))
  "Spawn a one-shot manipy using skeleton at position, select animation, and remember its handle.
   Return the new process pointer or false when no manipy is available."
  (set! (-> self anim-process) (the-as handle #f))
  (let* ((helper-process (get-process *default-dead-pool* manipy #x4000))
         (helper-pointer (when helper-process
                           (let ((activate-helper (method-of-type manipy activate)))
                             (activate-helper (the-as manipy helper-process) self 'manipy (the-as pointer #x70004000)))
                           ((the-as (function process function object object object object object) run-function-in-process)
                            helper-process
                            manipy-init
                            position
                            #f
                            camera-skeleton
                            #f)
                           (-> helper-process ppointer))))
    (when helper-pointer
      (send-event (-> helper-pointer 0 self) 'anim-mode 'play1)
      (send-event (-> helper-pointer 0 self) 'art-joint-anim animation-name)
      (set! (-> self anim-process) (ppointer->handle helper-pointer)))
    helper-pointer))

(defmethod eval ((this camera-tracker) (command pair))
  "Evaluate one (command-name . arguments) camera script command and return its command-specific
   result. Commands can wait, loop, exchange events, grab and release actors, control drawing and
   camera targets, and launch camera animation."
  (with-pp
    (let ((result (the-as object #f)))
      (cond
        ((null? command))
        ((pair? command)
         (let ((command-name (car command))
               (command-args (cdr command)))
           (case command-name
             (('print)
              (set! result (car command-args))
              (if (pair? result) (set! result (eval this (the-as pair result))))
              (format #t "~A MESSAGE (~D): ~A~%" this (current-time) result))
             (('while)
              (let ((while-condition (car command-args)))
                (while (eval this (the-as pair while-condition))
                  (let* ((while-body (cdr command-args))
                         (while-command (car while-body)))
                    (while (not (null? while-body))
                      (set! result (eval this (the-as pair while-command)))
                      (set! while-body (cdr while-body))
                      (set! while-command (car while-body)))))))
             (('until)
              (let ((until-condition (car command-args)))
                (while (not (eval this (the-as pair until-condition)))
                  (let* ((until-body (cdr command-args))
                         (until-command (car until-body)))
                    (while (not (null? until-body))
                      (set! result (eval this (the-as pair until-command)))
                      (set! until-body (cdr until-body))
                      (set! until-command (car until-body)))))))
             (('not) (set! result (not (eval this (the-as pair (car command-args))))))
             (('wait-for 'wait 'suspend) (let ((wait-time (command-get-time (car command-args) 1))) (suspend-for wait-time)))
             (('message?) (when (= (-> this message) (car command-args)) (set! result (-> this message)) (set! (-> this message) #f)))
             (('send-event)
              (let ((recipient-process (command-get-process (car command-args) *target*))
                    (event-name (car (cdr command-args)))
                    (event-params (cdr (cdr command-args))))
                (when (and recipient-process (not (null? event-name)))
                  (let ((event-block (new 'stack-no-clear 'event-message-block)))
                    (set! (-> event-block from) pp)
                    ;; Camera scripts may supply at most three event parameters.
                    (let ((params-to-count event-params))
                      (set! (-> event-block num-params) ((method-of-type (rtype-of params-to-count) length) params-to-count)))
                    (set! (-> event-block message) (the-as symbol event-name))
                    (set! (-> event-block param 0) (the-as uint (command-get-param (car event-params) #f)))
                    (set! (-> event-block param 1) (the-as uint (command-get-param (car (cdr event-params)) #f)))
                    (set! (-> event-block param 2) (the-as uint (command-get-param (car (cdr (cdr event-params))) #f)))
                    (set! result (send-event-function recipient-process event-block))))))
             (('eval)
              (let ((callback (car command-args)))
                (if (and callback (type-type? (-> (the-as basic callback) type) function))
                  (set! result ((the-as (function camera-tracker symbol) callback) this)))))
             (('work-set!)
              (set! result (process->handle (eval this (the-as pair (car command-args)))))
              (set! (-> this work-process) (the-as handle result)))
             (('grab)
              (let ((grab-target (command-get-process (car command-args) *target*))) (set! result (process-grab? grab-target))))
             (('release) (set! result (process-release? (handle->process (-> this grab-target)))))
             (('alive?) (set! result (command-get-process (car command-args) *target*)))
             (('draw)
              (set! result (command-get-process (car command-args) *target*))
              (when (the-as target result)
                (if (car (cdr command-args))
                  (logclear! (-> (the-as target result) skel status) (janim-status drawn))
                  (logior! (-> (the-as target result) skel status) (janim-status drawn)))))
             (('camera-change-to 'camera)
              (set! result (camera-change-to (car command-args) (command-get-time (car (cdr command-args)) 0) #f)))
             (('intro-done?)
              (let ((camera-event-block (new 'stack-no-clear 'event-message-block)))
                (set! (-> camera-event-block from) pp)
                (set! (-> camera-event-block num-params) 0)
                (set! (-> camera-event-block message) 'intro-done?)
                (set! result (send-event-function *camera* camera-event-block))))
             (('camera-look-at 'look-at)
              (set! result (camera-look-at (car command-args) (the-as uint (command-get-int (car (cdr command-args)) 0)))))
             (('pov) (set! result (camera-pov-from (car command-args) (command-get-int (car (cdr command-args)) 0))))
             (('camera-anim)
              (let ((art-name (car command-args))
                    (animation-name (car (cdr command-args)))
                    (position (command-get-trans (car (cdr (cdr command-args))) *null-vector*))
                    (intern-symbol string->symbol))
                (format (clear *temp-string*) "*~S-sg*" art-name)
                (let ((camera-skeleton (-> (intern-symbol *temp-string*) value)))
                  (when (type-type? (rtype-of camera-skeleton) skeleton-group)
                    (set! (-> this anim-process) (the-as handle #f))
                    (let ((helper-process (get-process *default-dead-pool* manipy #x4000)))
                      (set! result
                            (when helper-process
                              (let ((activate-helper (method-of-type manipy activate)))
                                (activate-helper (the-as manipy helper-process) this 'manipy (the-as pointer #x70004000)))
                              (run-now-in-process helper-process manipy-init position #f camera-skeleton #f)
                              (-> helper-process ppointer))))
                    (send-event (-> (the-as (pointer process) result) 0 self) 'anim-mode 'play1)
                    (send-event (-> (the-as (pointer process) result) 0 self) 'art-joint-anim animation-name)
                    (set! (-> this anim-process) (ppointer->handle (the-as (pointer process) result)))))))
             (else (format 0 "ERROR: camera-tracker does not know script line command ~A.~%" command-name)))))
        (else (format 0 "ERROR: camera-tracker requires a pair as a script line, not ~A.~%" command)))
      (the-as process result))))

;; Camera trackers run a list of camera commands, or a callback, with the
;; ordinary movie process groups masked out. They also own the temporary
;; handles created by look-at, point-of-view, grab, and camera-animation
;; commands. A false border value adds the default border request; a supplied
;; value leaves the caller's border setup alone.
(defstate camera-tracker-process (camera-tracker)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (local-vars (event-value uint))
      (case message
        (('message) (set! event-value (-> block param 0)) (set! (-> self message) (the-as basic event-value)) event-value)
        (('mask)
         (set! event-value (-> block param 0))
         (set! (-> self mask-to-clear) (the-as process-mask event-value))
         event-value)
        (('border) (set! event-value (-> block param 0)) (set! (-> self border-value) (the-as basic event-value)) event-value)))
  :enter
    (behavior ()
      (if (-> self entity) (set-or-clear-status! (-> self entity) (entity-perm-status no-kill) #t))
      (if (not (-> self border-value)) (add-setting! 'border-mode (-> self border-value) 0.0 0))
      (add-setting! 'process-mask 'set 0.0 (-> self mask-to-clear))
      (add-setting! 'movie (process->ppointer self) 0.0 0)
      (hide-hud-quick))
  :exit
    (behavior ()
      (if (-> self entity) (set-or-clear-status! (-> self entity) (entity-perm-status no-kill) #f))
      (send-event *camera* 'clear-entity))
  :code
    (behavior ()
      (cond
        ((-> self script-func) ((-> self script-func)))
        (else
         (while (not (null? (-> self script-line)))
           (eval self (the-as pair (-> self script-line car)))
           (set! (-> self script-line) (the-as pair (-> self script-line cdr))))))
      (remove-setting! 'process-mask)
      (send-event *camera* 'clear-entity)
      (suspend)
      (suspend)
      (suspend)
      0))

(defbehavior camera-tracker-init camera-tracker ((script-or-function object))
  "Initialize a camera tracker from a command-list or a no-argument script function, inherit the
   parent's entity, install movie settings and event handling, and begin evaluating the script."
  (stack-size-set! (-> self main-thread) 512)
  (logclear! (-> self mask) (process-mask actor-pause movie enemy platform projectile))
  (set! (-> self mask-to-clear) (process-mask movie enemy platform projectile))
  (set! (-> self grab-target) (the-as handle #f))
  (set! (-> self grab-event) 'grab)
  (set! (-> self release-event) 'end-mode)
  (set! (-> self look-at-target) (the-as handle #f))
  (set! (-> self pov-target) (the-as handle #f))
  (set! (-> self callback) #f)
  (set! (-> self userdata) #f)
  (set-time! (-> self start-time))
  (set! (-> self script) '())
  (set! (-> self script-line) '())
  (set! (-> self script-func) #f)
  (set! (-> self message) #f)
  (set! (-> self border-value) #f)
  (cond
    ((pair? script-or-function)
     (set! (-> self script) (the-as pair script-or-function))
     (set! (-> self script-line) (the-as pair script-or-function)))
    ((type-type? (rtype-of script-or-function) function)
     (set! (-> self script-func) (the-as (function none) script-or-function)))
    (else (format 0 "ERROR: camera-tracker requires a pair as a script, not ~A.~%" script-or-function)))
  (let* ((parent-process (ppointer->process (-> self parent)))
         (valid-parent-process (if (and (nonzero? parent-process) (type-type? (-> parent-process type) process)) parent-process)))
    (if valid-parent-process (set! (-> self entity) (-> (the-as process valid-parent-process) entity))))
  (set! (-> self event-hook) (-> camera-tracker-process event))
  (go camera-tracker-process))

(deftype med-res-level (process-drawable)
  ((level     symbol)
   (part-mode basic)
   (index     int32))
  (:states
   med-res-level-idle))

;; Display this medium-resolution stand-in until its high-resolution level is
;; active. Special display modes force it visible; Fire Canyon additionally
;; hides the stand-in below its camera-height cutoff. Visible stand-ins keep
;; their animation and optional ambient particle group alive.
(defstate med-res-level-idle (med-res-level)
  :code
    (behavior ()
      (local-vars (bounds-x float))
      (rlet ((vf0 :class vf)
             (vf16 :class vf)
             (vf17 :class vf))
        (init-vf0-vector)
        (loop
          (let ((loaded-level (level-get *level* (-> self level)))
                (continue-level (-> *game-info* current-continue level)))
            (cond
              ((and loaded-level (or (= (-> loaded-level display?) 'special) (= (-> loaded-level display?) 'special-vis)))
               (logclear! (-> self draw status) (draw-status hidden))
               (if (nonzero? (-> self skel)) (ja :num! (loop!))))
              ((or (and loaded-level (= (-> loaded-level status) 'active)) (= continue-level 'firecanyon))
               (logior! (-> self draw status) (draw-status hidden)))
              ((and (= (-> self level) 'firecanyon) (< (-> (camera-pos) y) 327680.0))
               (logior! (-> self draw status) (draw-status hidden)))
              (else
               (logclear! (-> self draw status) (draw-status hidden))
               (if (nonzero? (-> self part)) (spawn (-> self part) (-> self root trans)))
               (if (nonzero? (-> self skel)) (ja :num! (loop!))))))
          (when (not (logtest? (-> self draw status) (draw-status hidden)))
            (let ((draw-control (-> self draw))
                  (bounds-vector (new 'stack-no-clear 'vector)))
              (.lvf vf16 (&-> draw-control origin quad))
              (.lvf vf17 (&-> draw-control bounds quad))
              (.mul.x.vf.w vf16 vf16 vf0)
              (.add.vf vf16 vf16 vf17)
              (.svf (&-> bounds-vector quad) vf16))
            (.mov bounds-x vf16))
          (suspend)
          ;; og:preserve-this
          (init-vf0-vector))))
  :post ja-post)

(define *lev-string* (new 'global 'string 64 (the-as string #f)))

(defmethod init-from-entity! ((this med-res-level) (source-entity entity-actor))
  "Initialize a medium-resolution level object from entity. Resolve an optional particle
   group, construct the med-res-level skeleton name from its level and index properties, and make the
   object persist across ordinary actor culling."
  (local-vars (art-name-tag res-tag))
  (stack-size-set! (-> this main-thread) 128)
  "#f"
  (let ((part-group-slot (the-as (pointer sparticle-launch-group) #f)))
    (set! art-name-tag (new 'static 'res-tag))
    (let* ((art-name-slot (res-lump-data source-entity 'art-name (pointer symbol) :tag-ptr (& art-name-tag)))
           (art-name (-> art-name-slot 0)))
      (cond
        ((not art-name-slot))
        ((part-group-pointer? (the-as pointer art-name))
         (set! part-group-slot (the-as (pointer sparticle-launch-group) (-> art-name-slot 0))))
        ((= (-> art-name type) string)
         (set! part-group-slot (lookup-part-group-pointer-by-name (the-as string art-name)))
         (if part-group-slot (set! (-> art-name-slot 0) (the-as symbol part-group-slot))))
        ((= (-> art-name type) symbol)
         (let ((part-group-name (symbol->string art-name)))
           (set! part-group-slot (lookup-part-group-pointer-by-name part-group-name)))
         (if part-group-slot (set! (-> art-name-slot 0) (the-as symbol part-group-slot))))))
    (when (the-as object part-group-slot)
      (let ((part-group (-> part-group-slot 0)))
        (if (and (nonzero? part-group) (= (-> part-group type) sparticle-launch-group))
          (set! (-> this part) (create-launch-control part-group this))))))
  (process-entity-status! this (entity-perm-status force-birth) #t)
  (let ((level-name (res-lump-struct (-> this entity) 'level structure))
        (model-index (res-lump-value (-> this entity) 'index uint128)))
    (when level-name
      (set! (-> this level) (the-as symbol level-name))
      (set! (-> this index) (the-as int model-index))
      (set! (-> this root) (new 'process 'trsqv))
      (process-drawable-from-entity! this source-entity)
      (logclear! (-> this mask) (process-mask actor-pause))
      (format (clear *lev-string*) "med-res-~S~S" level-name (if (zero? model-index) "" (* model-index 8)))
      (initialize-skeleton-by-name this *lev-string* '())
      (logior! (-> this draw status) (draw-status do-not-check-distance))
      (if (nonzero? (-> this draw)) (go med-res-level-idle))))
  (none))

(defmethod is-visible? ((this part-spawner))
  "Update the world-space visibility sphere and return whether it intersects the view frustum."
  (sphere<-vector+r! (-> this world-sphere) (-> this root trans) (-> this radius))
  (sphere-in-view-frustum? (-> this world-sphere)))

;; Stop and start preserve the choice in the entity completion bit. A trans
;; event moves the source; while enabled it emits its cached particle group and
;; refreshes its positional ambient sound every frame.
(defstate part-spawner-active (part-spawner)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('stop) (process-entity-status! self (entity-perm-status complete) #t) (set! (-> self enable) #f) #t)
        (('start) (process-entity-status! self (entity-perm-status complete) #f) (set! (-> self enable) #t) #t)
        (('trans)
         (let ((position-quad (the-as object (-> (the-as vector (-> block param 0)) quad))))
           (set! (-> self root trans quad) (the-as uint128 position-quad))
           position-quad))))
  :code
    (behavior ()
      (loop
        (when (-> self enable)
          (spawn (-> self part) (-> self root trans))
          (if (nonzero? (-> self sound)) (update! (-> self sound))))
        (suspend))))

(defmethod init-from-entity! ((this part-spawner) (source-entity entity-actor))
  "Initialize the particle source, ambient sound, and visibility radius. Resolve art-name from a
   cached particle-group pointer, string, or symbol; the beach-grotto group uses a larger radius and
   special state. The source entity's completion flag determines whether spawning begins enabled."
  (local-vars (art-name-tag res-tag))
  (stack-size-set! (-> this main-thread) 128)
  (logior! (-> this mask) (process-mask ambient))
  (set! (-> this root) (new 'process 'trsqv))
  (process-drawable-from-entity! this source-entity)
  (logclear! (-> this mask) (process-mask actor-pause))
  (set! (-> this radius) 12288.0)
  (set! (-> this enable)
        (not (and (-> this entity) (logtest? (-> this entity extra perm status) (entity-perm-status complete)))))
  (set! (-> this sound) (new 'process 'ambient-sound (-> this entity) (-> this root trans)))
  (let ((part-group-name (the-as object "#f")))
    (let ((part-group-slot (the-as (pointer sparticle-launch-group) #f)))
      (set! art-name-tag (new 'static 'res-tag))
      (let* ((art-name-slot (res-lump-data source-entity 'art-name (pointer (pointer sparticle-launch-group)) :tag-ptr (& art-name-tag)))
             (art-name (-> art-name-slot 0)))
        (cond
          ((part-group-pointer? art-name) (set! part-group-slot (-> art-name-slot 0)))
          ((= (-> art-name -1) string)
           (when (string= (the-as string art-name) "group-beach-grotto-1")
             (set! (-> this radius) 61440.0)
             (go beach-part-grotto-1))
           (set! part-group-name art-name)
           (set! part-group-slot (lookup-part-group-pointer-by-name (the-as string part-group-name)))
           (if part-group-slot (set! (-> art-name-slot 0) part-group-slot)))
          ((= (-> art-name -1) symbol)
           ;; og:preserve-this
           (set! part-group-name (symbol->string (the-as symbol art-name)))
           (set! part-group-slot (lookup-part-group-pointer-by-name (the-as string part-group-name)))
           (if part-group-slot (set! (-> art-name-slot 0) part-group-slot)))
          (else (go process-drawable-art-error (the-as string art-name)))))
      (set! (-> this mode) part-group-slot)
      (when part-group-slot
        (let ((part-group (-> part-group-slot 0)))
          (when (and (nonzero? part-group) (= (-> part-group type) sparticle-launch-group))
            (set! (-> this part) (create-launch-control part-group this))
            (go part-spawner-active)))))
    (go process-drawable-art-error (the-as string part-group-name)))
  (none))

(deftype launcher (process-drawable)
  ((root            collide-shape :override)
   (spring-height   meters)
   (camera          state)
   (active-distance float)
   (seek-time       time-frame)
   (dest            vector :inline)
   (sound-id        sound-id))
  (:states
   launcher-active
   launcher-deactivated
   launcher-idle))

(defpartgroup group-beach-launcher
  :id 37
  :bounds (static-bspherem 0 3 0 5)
  :parts
  ((sp-item 45 :fade-after (meters 100) :falloff-to (meters 100))
   (sp-item 46 :fade-after (meters 70) :falloff-to (meters 100) :flags (is-3d))
   (sp-item 47 :fade-after (meters 70) :falloff-to (meters 100) :flags (is-3d))
   (sp-item 48 :fade-after (meters 50) :falloff-to (meters 80))
   (sp-item 49 :fade-after (meters 70) :falloff-to (meters 100))))

(defpart 45
  :init-specs
  ((:num 1.5)
   (:x (meters 1.5))
   (:y (meters -0.5))
   (:rot-x 5)
   (:r 4096.0)
   (:g 2867.2)

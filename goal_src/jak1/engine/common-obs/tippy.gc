;;-*-Lisp-*-
(in-package goal)
(bundles "GAME.CGO")
(require "engine/math/quaternion.gc")
(require "engine/game/game-h.gc")

;; DECOMP BEGINS

(deftype tippy (structure)
  ((axis       vector :inline)
   (angle      float)
   (orig       quaternion :inline)
   (dist-ratio float)
   (damping    float)
   (1-damping  float))
  (:methods
   (reset! (_type_ process-drawable float float) none)
   (update-tip! (_type_ process-drawable vector) symbol)))

(defmethod reset! ((this tippy) (owner-proc process-drawable) (distance-ratio float) (damping float))
  "Reset the tip controller from owner-proc's current root orientation. distance-ratio converts
   horizontal distance to a tilt angle; damping is the per-update weight for new values."
  (set-vector! (-> this axis) 0.0 0.0 0.0 1.0)
  (set! (-> this angle) 0.0)
  (quaternion-copy! (-> this orig) (-> owner-proc root quat))
  (set! (-> this dist-ratio) distance-ratio)
  (set! (-> this damping) damping)
  (set! (-> this 1-damping) (- 1.0 damping))
  0
  (none))

(defmethod update-tip! ((this tippy) (owner-proc process-drawable) (target-position vector))
  "Update owner-proc's tipped orientation. With a target, form the horizontal rotation axis
   perpendicular to the target direction, scale target distance into an angle, and blend both
   toward their new values. Without a target, decay the angle to zero and report false once it
   falls below one degree. Always apply the resulting tip relative to the saved orientation."
  (let ((active? #t))
    (cond
      (target-position
       (let ((tilt-axis (new 'stack-no-clear 'vector)))
         0.0
         (set! (-> tilt-axis x) (- (-> target-position z) (-> owner-proc root trans z)))
         (set! (-> tilt-axis y) 0.0)
         (set! (-> tilt-axis z) (- (-> owner-proc root trans x) (-> target-position x)))
         (let ((target-distance (vector-length tilt-axis)))
           (vector-float*! tilt-axis tilt-axis (/ 1.0 target-distance))
           (let ((target-angle (* target-distance (-> this dist-ratio))))
             (set! (-> this axis x) (+ (* (-> this 1-damping) (-> this axis x)) (* (-> this damping) (-> tilt-axis x))))
             (set! (-> this axis y) 0.0)
             (set! (-> this axis z) (+ (* (-> this 1-damping) (-> this axis z)) (* (-> this damping) (-> tilt-axis z))))
             (vector-normalize! (-> this axis) 1.0)
             (set! (-> this angle) (+ (* (-> this 1-damping) (-> this angle)) (* (-> this damping) target-angle)))))))
      (else
       (set! (-> this angle) (* (-> this 1-damping) (-> this angle)))
       (when (< (-> this angle) 182.04445)
         (set! (-> this angle) 0.0)
         (set! active? #f))))
    (quaternion-vector-angle! (-> owner-proc root quat) (-> this axis) (-> this angle))
    (quaternion*! (-> owner-proc root quat) (-> owner-proc root quat) (-> this orig))
    active?))

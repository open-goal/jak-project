;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "kernel-defs.gc")

;; The sync-info types keep gameplay objects like platforms in sync.
;; Platforms may spawn and despawn during gameplay, and determine their
;; momvement phase from the global clock.
;;
;; This file also contains small randomized and spring-like motion controls that
;; do not use the synchronization clock.

;; DECOMP BEGINS

;; The base clock produces a sawtooth phase from 0 to 1 over each period. Its
;; mirrored versions produces a triangular phase from 0 to 1 and back to 0 over the
;; same period.
(deftype sync-info (structure)
  (;; Phase offset stored in game-time ticks rather than normalized phase.
   (offset float)
   ;; Cycle duration in 300 Hz game-time ticks.
   (period uint32))
  :pack-me
  (:methods
   (get-current-value (_type_ float) float)
   (get-current-phase-no-mod (_type_) float)
   (get-current-phase (_type_) float)
   (get-current-value-with-mirror (_type_ float) float)
   (get-current-phase-with-mirror (_type_) float)
   (setup-params! (_type_ uint float float float) none)
   (load-params! (_type_ process uint float float float) symbol)
   (sync-now! (_type_ float) float)
   (get-phase-offset (_type_) float)))

;; A synchronized triangular phase with a smooth start and stop on each leg.
;; tlo and thi bound a piecewise quadratic-linear-quadratic curve. ylo is the
;; value at the first boundary, m2 is the final quadratic's coefficient, and yend
;; normalizes the curve to end at 1. The pieces meet with matching slopes and
;; reach zero slope at both endpoints.
(deftype sync-info-eased (sync-info)
  ((tlo  float)
   (thi  float)
   (ylo  float)
   (m2   float)
   (yend float))
  :allow-misaligned)

;; A synchronized phase that can wait at either endpoint. pause-after-out is the
;; fraction of the complete cycle held at 1 after the outward leg;
;; pause-after-in is the fraction held at 0 after the return leg. LPC whirlpools
;; and the pushers in Snowy's yellow-eco room use this form.
(deftype sync-info-paused (sync-info)
  ((pause-after-out float)
   (pause-after-in  float))
  :pack-me)

;; Holds one value for a random duration, then chooses another uniformly from
;; -max-val through max-val.
(deftype delayed-rand-float (structure)
  ((min-time   int32)
   (max-time   int32)
   (max-val    float)
   (timer      int32)
   (start-time time-frame)
   (value      float))
  :pack-me
  (:methods
   (set-params! (_type_ int int float) float)
   (update! (_type_) float)))

;; A damped discrete spring. update! accelerates value toward target plus an
;; optional offset, clamps velocity, retains the damping fraction, and integrates
;; value with the display time adjustment.
(deftype oscillating-float (structure)
  ((value   float)
   (target  float)
   (vel     float)
   (max-vel float)
   (damping float)
   (accel   float))
  :pack-me
  (:methods
   (set-params! (_type_ float float float float) float)
   (update! (_type_ float) float)))

;; A damped spring constrained between a floor and ceiling. Crossing an endpoint
;; clamps the value and reflects outward velocity by elasticity; state records
;; which endpoint the latest update struck.
(defenum bouncing-float-state
  :type int32
  :bitfield #f
  (at-minimum -1)
  (free 0)
  (at-maximum 1))

(deftype bouncing-float (structure)
  ((osc        oscillating-float :inline)
   (max-value  float)
   (min-value  float)
   (elasticity float)
   (state      bouncing-float-state))
  :pack-me
  (:methods
   (set-params! (_type_ float float float float float float float) float)
   (update! (_type_ float) float)
   (at-min? (_type_) symbol)
   (at-max? (_type_) symbol)))

;; Vector counterpart to delayed-rand-float.
(deftype delayed-rand-vector (structure)
  ((min-time   int32)
   (max-time   int32)
   (xz-max     float)
   (y-max      float)
   (timer      int32)
   (start-time time-frame)
   (value      vector :inline))
  (:methods
   (set-params! (_type_ int int float float) vector)
   (update-now! (_type_) vector)
   (update-with-delay! (_type_) vector)
   (update-with-delay-or-reset! (_type_) vector)))

;; Vector counterpart to oscillating-float. Velocity is limited by vector length,
;; so the direction of motion is preserved when it reaches max-vel.
(deftype oscillating-vector (structure)
  ((value   vector :inline)
   (target  vector :inline)
   (vel     vector :inline)
   (max-vel float)
   (damping float)
   (accel   float))
  (:methods
   (set-params! (_type_ vector float float float) vector)
   (update! (_type_ vector) vector)))

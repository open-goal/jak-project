;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/math/vector-h.gc")
(require "engine/geometry/bounding-box-h.gc")

;; A bounding-box is a pair of vectors holding the low and high corner. Every method here works on
;; whole quadwords, so the w lanes take part in the arithmetic whether or not they mean anything.
;; set-from-point-offset!, set-from-point-offset-pad! and set-from-sphere! write w = 1.0 explicitly;
;; add-point! and add-box! do not, and leave w as the min or max of the two inputs' w. That is
;; harmless when both are boxes, and it is why the point methods are declared to take vector3s but
;; must be handed something with sixteen readable bytes: the load is a quadword load regardless.
;;
;; The multi-sphere methods below expand a sphere into its own bounding box with the same trick used
;; throughout: (.sub.w.vf.xyz out in in) subtracts a sphere's w, its radius, from each of its xyz
;; lanes at once, and the .add form gives the high corner. No separate radius broadcast is needed.

;; DECOMP BEGINS

(defun box-vector-enside? ((box bounding-box) (pt vector))
  "Return true when pt is strictly inside box; points on a face are excluded.
   Only xyz is tested. This is the strict counterpart of box-vector-inside?, which accepts the
   faces; the two differ only in that boundary, so a point on a face satisfies exactly one of them."
  (and (< (-> box min x) (-> pt x))
       (< (-> box min y) (-> pt y))
       (< (-> box min z) (-> pt z))
       (< (-> pt x) (-> box max x))
       (< (-> pt y) (-> box max y))
       (< (-> pt z) (-> box max z))))

(defun box-vector-inside? ((box bounding-box) (pt vector))
  "Return true when pt is inside box or on one of its faces. Only xyz is tested."
  (and (>= (-> pt x) (-> box min x))
       (>= (-> pt y) (-> box min y))
       (>= (-> pt z) (-> box min z))
       (>= (-> box max x) (-> pt x))
       (>= (-> box max y) (-> pt y))
       (>= (-> box max z) (-> pt z))))

(defmethod set-from-point-offset! ((this bounding-box) (point vector3s) (offset vector3s))
  "Set this to the smallest box containing point and point plus offset. offset may point any
   direction; the min and max sort themselves out. Both corners get w = 1.0. Returns 0."
  (rlet ((vf0 :class vf)
         (box-min :class vf)
         (box-max :class vf)
         (offset-vf :class vf)
         (near-point :class vf)
         (far-point :class vf))
    (init-vf0-vector)
    (.lvf offset-vf offset)
    (.lvf near-point point)
    (.add.vf far-point near-point offset-vf)
    (.min.vf box-min near-point far-point)
    (.max.vf box-max near-point far-point)
    (.mov.vf.w box-min vf0)
    (.mov.vf.w box-max vf0)
    (.svf (&-> this min quad) box-min)
    (.svf (&-> this max quad) box-max)
    0))

(defmethod add-point! ((this bounding-box) (point vector3s))
  "Expand this box as needed to contain point. The min and max are four-lane operations and no w is
   written afterwards, so point's fourth word ends up folded into the box's w lanes as well. Pass a
   point whose w is 1.0 to keep the convention. Returns 0."
  (rlet ((box-min :class vf)
         (box-max :class vf)
         (new-point :class vf))
    (.lvf box-min (&-> this min quad))
    (.lvf box-max (&-> this max quad))
    (.lvf new-point point)
    (.min.vf box-min box-min new-point)
    (.max.vf box-max box-max new-point)
    (.svf (&-> this min quad) box-min)
    (.svf (&-> this max quad) box-max)
    0))

(defmethod add-box! ((this bounding-box) (other-box bounding-box))
  "Expand this box as needed to contain other-box. this may be other-box, which leaves it unchanged.
   No w is written, so the result's w lanes are the min and max of the two boxes' w. Returns 0."
  (rlet ((box-min :class vf)
         (box-max :class vf)
         (other-min :class vf)
         (other-max :class vf))
    (.lvf box-min (&-> this min quad))
    (.lvf box-max (&-> this max quad))
    (.lvf other-min (&-> other-box min quad))
    (.lvf other-max (&-> other-box max quad))
    (.min.vf box-min box-min other-min)
    (.max.vf box-max box-max other-max)
    (.svf (&-> this min quad) box-min)
    (.svf (&-> this max quad) box-max)
    0))

(defmethod set-from-point-offset-pad! ((this bounding-box) (point vector3s) (offset vector3s) (padding float))
  "Set this around point and point plus offset, expanded by padding in xyz. padding is a world
   distance added to each face, so the box grows by twice it in every dimension; a negative padding
   shrinks it and can invert it. Both corners get w = 1.0. Returns 0."
  (rlet ((vf0 :class vf)
         (pad :class vf)
         (box-min :class vf)
         (box-max :class vf)
         (offset-vf :class vf)
         (near-point :class vf)
         (far-point :class vf))
    (init-vf0-vector)
    (.lvf offset-vf offset)
    (.lvf near-point point)
    ;; padding crosses from the FPU into lane x, and the .x forms broadcast it from there.
    (.mov pad padding)
    (.add.vf far-point near-point offset-vf)
    (.min.vf box-min near-point far-point)
    (.max.vf box-max near-point far-point)
    (.add.x.vf.xyz box-max box-max pad)
    (.sub.x.vf.xyz box-min box-min pad)
    (.mov.vf.w box-min vf0)
    (.mov.vf.w box-max vf0)
    (.svf (&-> this min quad) box-min)
    (.svf (&-> this max quad) box-max)
    0))

(defmethod set-from-sphere! ((this bounding-box) (source-sphere sphere))
  "Set this to the axis-aligned box enclosing source-sphere, replacing whatever it held. The radius
   is the sphere's w, so a negative radius produces an inverted box. Both corners get w = 1.0.
   Returns 0."
  (rlet ((vf0 :class vf)
         (center :class vf)
         (box-min :class vf)
         (box-max :class vf))
    (init-vf0-vector)
    ;; Keep the direct structure load used by the PC port.
    (.lvf center source-sphere)
    (.sub.w.vf.xyz box-min center center)
    (.add.w.vf.xyz box-max center center)
    (.mov.vf.w box-min vf0)
    (.mov.vf.w box-max vf0)
    (.svf this box-min)
    (.svf this box-max :offset 16)
    0))

;;;;;;;;;;;;;;;;;;;;;;;;;
;; multi-sphere methods
;;;;;;;;;;;;;;;;;;;;;;;;;

;; these are used in the collision system to build bounding boxes around collision geometries, so they are quite optimized.

(defmethod add-spheres! ((this bounding-box) (spheres (inline-array sphere)) (count int))
  "Expand this box to contain count spheres. A count of zero leaves the box untouched. The min and
   max are masked to xyz, so the box's existing w lanes survive. Returns 0."
  (#unless PC_PORT
    ;; Four-way unrolling overlaps sphere loads, bounds calculation, and VU min/max.
    ;; The early-exit branches retain their useful max operation in the delay slot.
    (rlet ((sphere-cursor :reg a1)
           (remaining :reg a2)
           (current-min :reg vf1)
           (current-max :reg vf2)
           (sphere0 :reg vf3)
           (sphere1 :reg vf4)
           (sphere2 :reg vf5)
           (sphere3 :reg vf6)
           (sphere0-min :reg vf7)
           (sphere0-max :reg vf8)
           (sphere1-min :reg vf9)
           (sphere1-max :reg vf10)
           (sphere2-min :reg vf11)
           (sphere2-max :reg vf12)
           (sphere3-min :reg vf13)
           (sphere3-max :reg vf14)
           (next-count))
      (nop!)
      (b.z remaining add-spheres-done :delay (.lvf sphere0 sphere-cursor))
      (nop!)
      (.lvf sphere1 sphere-cursor 16)
      (nop!)
      (.lvf sphere2 sphere-cursor 32)
      (nop!)
      (.lvf sphere3 sphere-cursor 48)
      (nop!)
      (.lvf current-min this)
      (nop!)
      (.lvf current-max this 16)
      add-spheres-loop
      (.sub.w.vf.xyz sphere0-min sphere0 sphere0)
      (&+! sphere-cursor 64)
      (.add.w.vf.xyz sphere0-max sphere0 sphere0)
      (nop!)
      (.sub.w.vf.xyz sphere1-min sphere1 sphere1)
      (nop!)
      (.add.w.vf.xyz sphere1-max sphere1 sphere1)
      (.lvf sphere0 sphere-cursor)
      (set! next-count (- remaining 1))
      (.min.vf.xyz current-min current-min sphere0-min)
      (b.z next-count add-spheres-store :delay (.max.vf.xyz current-max current-max sphere0-max))
      (.sub.w.vf.xyz sphere2-min sphere2 sphere2)
      (.lvf sphere1 sphere-cursor 16)
      (.add.w.vf.xyz sphere2-max sphere2 sphere2)
      (nop!)
      (-! next-count 1)
      (.min.vf.xyz current-min current-min sphere1-min)
      (b.z next-count add-spheres-store :delay (.max.vf.xyz current-max current-max sphere1-max))
      (.sub.w.vf.xyz sphere3-min sphere3 sphere3)
      (.lvf sphere2 sphere-cursor 32)
      (.add.w.vf.xyz sphere3-max sphere3 sphere3)
      (nop!)
      (-! next-count 1)
      (.min.vf.xyz current-min current-min sphere2-min)
      (b.z next-count add-spheres-store :delay (.max.vf.xyz current-max current-max sphere2-max))
      (nop!)
      (.lvf sphere3 sphere-cursor 48)
      (set! remaining (- next-count 1))
      (.min.vf.xyz current-min current-min sphere3-min)
      (b.nz remaining add-spheres-loop :delay (.max.vf.xyz current-max current-max sphere3-max))
      add-spheres-store
      (.svf this current-min)
      (.svf this current-max :offset 16)
      add-spheres-done
      (m! v0 0)
      (j ra :delay (m sp sp))
      (nop!)
      (nop!)
      (nop!)))
  (#when PC_PORT
    (rlet ((current-min :class vf)
           (current-max :class vf)
           (sphere-min :class vf)
           (sphere-max :class vf)
           (source-sphere :class vf))
      (when (nonzero? count)
        (.lvf current-min (-> this min))
        (.lvf current-max (-> this max))
        (dotimes (i count)
          (.lvf source-sphere (-> spheres i))
          (.sub.w.vf.xyz sphere-min source-sphere source-sphere)
          (.add.w.vf.xyz sphere-max source-sphere source-sphere)
          (.min.vf.xyz current-min current-min sphere-min)
          (.max.vf.xyz current-max current-max sphere-max))
        (.svf (-> this min) current-min)
        (.svf (-> this max) current-max))))
  0)

(defmethod set-from-spheres! ((this bounding-box) (spheres (inline-array sphere)) (count int))
  "Replace this with the box enclosing count spheres, or the zero box when count is zero. Unlike
   add-spheres! this ignores the box's previous contents. Returns 0."
  (#unless PC_PORT
    ;; Seven-way unrolling keeps the VU pipelines occupied. Loads beyond the logical
    ;; end are speculative; each result is consumed only after its count check.
    (rlet ((sphere-cursor :reg a1)
           (remaining :reg a2)
           (current-min :reg vf1)
           (current-max :reg vf2)
           (sphere0 :reg vf3)
           (sphere1 :reg vf4)
           (sphere2 :reg vf5)
           (sphere3 :reg vf6)
           (sphere4 :reg vf7)
           (sphere5 :reg vf8)
           (sphere6 :reg vf9)
           (sphere0-min :reg vf10)
           (sphere0-max :reg vf11)
           (sphere1-min :reg vf12)
           (sphere1-max :reg vf13)
           (sphere2-min :reg vf14)
           (sphere2-max :reg vf15)
           (sphere3-min :reg vf16)
           (sphere3-max :reg vf17)
           (sphere4-min :reg vf18)
           (sphere4-max :reg vf19)
           (sphere5-min :reg vf20)
           (sphere5-max :reg vf21)
           (sphere6-min :reg vf22)
           (sphere6-max :reg vf23)
           (next-count))
      (nop!)
      (.mov.vf current-min vf0)
      (.lvf sphere0 sphere-cursor)
      (.mov.vf current-max vf0)
      (.lvf sphere1 sphere-cursor 16)
      (b.z remaining set-spheres-store :delay (.lvf sphere2 sphere-cursor 32))
      (set! next-count (- remaining 1))
      (.lvf sphere3 sphere-cursor 48)
      (.sub.w.vf.xyz current-min sphere0 sphere0)
      (.lvf sphere4 sphere-cursor 64)
      (.add.w.vf.xyz current-max sphere0 sphere0)
      (.lvf sphere5 sphere-cursor 80)
      (b.z next-count set-spheres-store :delay (.lvf sphere6 sphere-cursor 96))
      set-spheres-loop
      (.sub.w.vf.xyz sphere1-min sphere1 sphere1)
      (&+! sphere-cursor 112)
      (.add.w.vf.xyz sphere1-max sphere1 sphere1)
      (.lvf sphere0 sphere-cursor)
      (.sub.w.vf.xyz sphere2-min sphere2 sphere2)
      (.lvf sphere1 sphere-cursor 16)
      (.add.w.vf.xyz sphere2-max sphere2 sphere2)
      (nop!)
      (-! next-count 1)
      (.min.vf.xyz current-min current-min sphere1-min)
      (b.z next-count set-spheres-store :delay (.max.vf.xyz current-max current-max sphere1-max))
      (-! next-count 1)
      (.min.vf.xyz current-min current-min sphere2-min)
      (b.z next-count set-spheres-store :delay (.max.vf.xyz current-max current-max sphere2-max))
      (.sub.w.vf.xyz sphere3-min sphere3 sphere3)
      (.lvf sphere2 sphere-cursor 32)
      (.add.w.vf.xyz sphere3-max sphere3 sphere3)
      (nop!)
      (.sub.w.vf.xyz sphere4-min sphere4 sphere4)
      (.lvf sphere3 sphere-cursor 48)
      (.add.w.vf.xyz sphere4-max sphere4 sphere4)
      (nop!)
      (-! next-count 1)
      (.min.vf.xyz current-min current-min sphere3-min)
      (b.z next-count set-spheres-store :delay (.max.vf.xyz current-max current-max sphere3-max))
      (-! next-count 1)
      (.min.vf.xyz current-min current-min sphere4-min)
      (b.z next-count set-spheres-store :delay (.max.vf.xyz current-max current-max sphere4-max))
      (.sub.w.vf.xyz sphere5-min sphere5 sphere5)
      (.lvf sphere4 sphere-cursor 64)
      (.add.w.vf.xyz sphere5-max sphere5 sphere5)
      (nop!)
      (.sub.w.vf.xyz sphere6-min sphere6 sphere6)
      (.lvf sphere5 sphere-cursor 80)
      (.add.w.vf.xyz sphere6-max sphere6 sphere6)
      (nop!)
      (-! next-count 1)
      (.min.vf.xyz current-min current-min sphere5-min)
      (b.z next-count set-spheres-store :delay (.max.vf.xyz current-max current-max sphere5-max))
      (-! next-count 1)
      (.min.vf.xyz current-min current-min sphere6-min)
      (b.z next-count set-spheres-store :delay (.max.vf.xyz current-max current-max sphere6-max))
      (.sub.w.vf.xyz sphere0-min sphere0 sphere0)
      (.lvf sphere6 sphere-cursor 96)
      (.add.w.vf.xyz sphere0-max sphere0 sphere0)
      (nop!)
      (-! next-count 1)
      (.min.vf.xyz current-min current-min sphere0-min)
      (b.nz next-count set-spheres-loop :delay (.max.vf.xyz current-max current-max sphere0-max))
      set-spheres-store
      (.svf this current-min)
      (.svf this current-max :offset 16)
      (m! v0 0)
      (j ra :delay (m sp sp))
      (nop!)
      (nop!)
      (nop!)))
  (#when PC_PORT
    (rlet ((vf0 :class vf)
           (current-min :class vf)
           (current-max :class vf)
           (sphere-min :class vf)
           (sphere-max :class vf)
           (source-sphere :class vf))
      (init-vf0-vector)
      ;; An empty input produces min=max=(0,0,0,1).
      (set! current-min vf0)
      (set! current-max vf0)
      (dotimes (i count)
        (.lvf source-sphere (-> spheres i))
        (.sub.w.vf.xyz sphere-min source-sphere source-sphere)
        (.add.w.vf.xyz sphere-max source-sphere source-sphere)
        (cond
          ((zero? i) (set! current-min sphere-min) (set! current-max sphere-max))
          (else (.min.vf.xyz current-min current-min sphere-min) (.max.vf.xyz current-max current-max sphere-max))))
      (.svf (-> this min) current-min)
      (.svf (-> this max) current-max)))
  0)

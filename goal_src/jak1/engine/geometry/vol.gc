;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/debug/debug-h.gc")
(require "engine/geometry/vol-h.gc")
(require "engine/geometry/cylinder.gc")

;; A plane-volume is a convex region given as a set of outward half-spaces: a point is inside when
;; n . p <= d for every plane, with the plane's abc in xyz and its d in w. Nothing stores the volume's
;; faces, edges or vertices, so init-vol! below recovers the edges from the planes alone when the
;; debug display asks for them.
;;
;; A vol-control groups the volumes authored on one process. The positive ones union together and the
;; cutout ones subtract, so a point counts as inside when some positive volume contains it and no
;; cutout volume does.
;;
;; first-point and first-normal are (pointer vector) but stride four bytes per index, because an
;; array of reference types is an array of pointers. So an index of 4 advances one vector and 8
;; advances two, which is how debug-draw walks the point list in pairs.

;; DECOMP BEGINS

(defun plane-volume-intersect-dist ((plane-data vector) (origin vector) (direction vector))
  "Return how many multiples of direction reach plane-data from origin, or (meters 100000) when
   direction is within one part in a hundred thousand of parallel to the plane. plane-data is read as
   ax + by + cz = d with d in w; its scale cancels, so the normal need not be unit as long as d
   matches it. The result is a distance only when direction is unit, and it is signed, so a negative
   value means the plane is behind origin."
  (let ((origin-distance (vector-dot origin plane-data))
        (direction-dot (vector-dot direction plane-data)))
    (if (< 0.00001 (fabs direction-dot)) (/ (- (-> plane-data w) origin-distance) direction-dot) (meters 100000))))

(defmethod init-vol! ((this plane-volume) (volume-type symbol) (point-array vector-array) (normal-array vector-array))
  "Recover this volume's edges from its planes and append them to point-array as endpoint pairs, plus
   one face centroid and its plane to normal-array per face that produced any edges. volume-type is
   recorded on the volume and later selects the debug color. The two arrays are appended to and their
   length fields advanced, and the volume records where its own run starts and how long it is, so
   several volumes can share one array. Returns #f, always.

   Every plane's normal must be unit length and must point out of the volume, and the volume must
   actually be closed; an open or inconsistently wound set of planes yields edges that go nowhere.
   Overflowing either array prints an error and drops the remaining geometry rather than growing it."
  ;; There is no topology to work from, so the edges are found by brute force: every ordered pair of
  ;; distinct planes defines a line, and that line is an edge of the volume exactly where it survives
  ;; clipping by all the other half-spaces. For planes i and j the line direction is the cross product
  ;; of their normals, and a point on it is found by starting from a point on plane j and walking
  ;; along the in-plane-j direction that heads toward plane i.
  ;;
  ;; The clipping walk keeps a start point and a signed span. The first clipping plane encountered
  ;; moves the start onto itself and opens the span wide; later planes either pull the start forward
  ;; again or shorten the span, depending on whether the step runs into or away from the plane
  ;; already recorded. A start point that ends up more than a meter outside any other half-space is
  ;; rejected, which is what discards the pairs of planes whose line misses the volume entirely.
  ;;
  ;; The pair loop runs both orders, so each edge is produced twice, once for each of the two faces
  ;; that share it. That is deliberate: the second copy is what lets each face accumulate its own
  ;; centroid from the endpoints lying on it.
  (set! (-> this volume-type) volume-type)
  (set! (-> this point-count) 0)
  (set! (-> this first-point) (&-> point-array data (-> point-array length)))
  (set! (-> this normal-count) 0)
  (set! (-> this first-normal) (&-> normal-array data (-> normal-array length)))
  (dotimes (plane-index (-> this num-planes))
    (let ((plane-point (new-stack-vector0))
          (edge-direction (new-stack-vector0))
          (toward-face (new-stack-vector0))
          (edge-end (new-stack-vector0)))
      0.0
      0.0
      0.0
      (set! (-> (new 'stack-no-clear 'vector) quad) (the-as uint128 0))
      (let ((centroid-sum (new-stack-vector0))
            (endpoint-count 0)
            (planes (-> this plane)))
        (let ((other-index 0))
          (while (< other-index (-> this num-planes))
            (when (!= plane-index other-index)
              (vector-float*! plane-point (the-as vector (-> planes other-index)) (-> planes other-index w))
              (vector-cross! edge-direction (the-as vector (-> planes other-index)) (the-as vector (-> planes plane-index)))
              (vector-normalize! edge-direction 1.0)
              (vector-cross! toward-face edge-direction (the-as vector (-> planes other-index)))
              (vector-normalize! toward-face 1.0)
              (let ((to-face-distance (plane-volume-intersect-dist (-> planes plane-index) plane-point toward-face)))
                (when (!= to-face-distance 409600000.0)
                  (vector+float*! edge-end plane-point toward-face to-face-distance)
                  (let ((edge-start (new-stack-vector0))
                        (edge-span 0.0)
                        (clip-count 0))
                    (let ((clip-plane (new-stack-vector0)))
                      (set! (-> edge-start quad) (-> edge-end quad))
                      (let ((clip-index 0))
                        (while (< clip-index (-> this num-planes))
                          (when (and (!= clip-index plane-index) (!= clip-index other-index))
                            (let ((clip-distance (plane-volume-intersect-dist (-> planes clip-index) edge-start edge-direction)))
                              (cond
                                ((= clip-distance 409600000.0))
                                ((zero? clip-count)
                                 (vector+float*! edge-start edge-start edge-direction clip-distance)
                                 (set! (-> clip-plane quad) (-> planes clip-index quad))
                                 (set! edge-span 8192000.0)
                                 (set! clip-count 1))
                                ((begin (vector-float*! edge-end edge-direction clip-distance) (>= (vector-dot edge-end clip-plane) 0.0)))
                                ((>= (vector-dot edge-end (the-as vector (-> planes clip-index))) 0.0)
                                 (when (< (fabs clip-distance) (fabs edge-span))
                                   (set! edge-span clip-distance)
                                   (+! clip-count 1)))
                                (else
                                 (vector+float*! edge-start edge-start edge-direction clip-distance)
                                 (set! (-> clip-plane quad) (-> planes clip-index quad))
                                 (+! clip-count 1)
                                 (set! edge-span (if (< (fabs clip-distance) (fabs edge-span)) (- edge-span clip-distance) 0.0))))))
                          (+! clip-index 1))))
                    (cond
                      ((zero? clip-count))
                      ((= edge-span 0.0))
                      (else
                       (dotimes (check-index (-> this num-planes))
                         (when (and (!= check-index plane-index) (!= check-index other-index))
                           (if (< 4096.0 (- (vector-dot edge-start (the-as vector (-> planes check-index))) (the-as float (-> planes check-index w))))
                               (goto cfg-42))))
                       (vector+float*! edge-end edge-start edge-direction edge-span)
                       (cond
                         ((< (-> point-array allocated-length) (+ (-> point-array length) 2))
                          (format 0 "ERROR <AG>: vol-control #x~X out of volume points~%" this))
                         (else
                          (set! (-> point-array data (-> point-array length) quad) (-> edge-start quad))
                          (set! (-> point-array data (+ (-> point-array length) 1) quad) (-> edge-end quad))
                          (+! (-> point-array length) 2)
                          (+! (-> this point-count) 2)))
                       (vector+! centroid-sum centroid-sum edge-start)
                       (vector+! centroid-sum centroid-sum edge-end)
                       (+! endpoint-count 2)))))))
            (label cfg-42)
            (+! other-index 1)))
        (when (nonzero? endpoint-count)
          (vector-float*! centroid-sum centroid-sum (/ 1.0 (the float endpoint-count)))
          (cond
            ((< (-> normal-array allocated-length) (+ (-> normal-array length) 2))
             (format 0 "ERROR <AG>: vol-control #x~X out of volume normals~%" this))
            (else
             (vector-copy! (-> normal-array data (-> normal-array length)) centroid-sum)
             (vector-copy! (-> normal-array data (+ (-> normal-array length) 1)) (-> planes plane-index))
             (+! (-> normal-array length) 2)
             (set! (-> this normal-count) (+ (-> this normal-count) 2))))))))
  #f)

(defmethod debug-draw ((this plane-volume))
  "Draw the edge list init-vol! recovered for this volume, one line per consecutive pair of points.
   The color comes from volume-type: green for vol, grey for pvol and red for anything else, all at
   half alpha. Nothing is drawn when init-vol! has not run, since point-count is then zero."
  (let* ((volume-type (-> this volume-type))
         (line-color (cond
                       ((= volume-type 'vol) (the-as uint #x8000c000))
                       ((= volume-type 'pvol) (the-as uint #x80808080))
                       (else (the-as uint #x800000c0))))
         (point-cursor (-> this first-point)))
    (dotimes (i (/ (-> this point-count) 2))
      (add-debug-line #t
                      (bucket-id debug-no-zbuf)
                      (the-as vector point-cursor)
                      (the-as vector (&-> point-cursor 4))
                      (the-as rgba line-color)
                      #f
                      (the-as rgba -1))
      (set! point-cursor (&-> point-cursor 8))))
  0
  (none))

(defmethod point-in-vol? ((this plane-volume) (point vector) (tolerance float))
  "Return whether point is inside every one of this volume's half-spaces, with tolerance added to
   each plane's distance. A positive tolerance grows the volume by that much along each plane normal,
   which is not the same as growing it uniformly unless the normals are unit. point's w is ignored.
   A volume with no planes reports true."
  (dotimes (i (-> this num-planes))
    (if (< tolerance (- (vector-dot point (the-as vector (-> this plane i))) (the-as float (-> this plane i w)))) (return #f)))
  #t)

(defmethod init! ((this vol-control))
  "Build the derived edge geometry the first time it is needed and draw every volume in this control.
   Despite the name this runs each frame the debug display is on, and it does nothing at all unless
   both the global volume-mark switch and this control's own display-marks and debug-alloc flags are
   set. The point and normal arrays are allocated from the debug heap on first use, sized at ten
   vectors per plane, and are charged to the owning process rather than to whoever is running.
   Returns 0."
  ;; Both the positive and the cutout volumes are initialized with 'vol, so the cutouts draw in the
  ;; positive color rather than in one of their own.
  (with-pp
    (let ((control this))
      (when (and (and *display-vol-marks* (logtest? (-> control flags) (vol-flags display-marks)))
                 (logtest? (-> this flags) (vol-flags debug-alloc)))
        (when (zero? (-> this debug-point))
          (let ((saved-pp pp))
            ;; Charge the debug allocation to the process that owns the volumes.
            (set! pp (-> this process))
            (let ((plane-total 0))
              (dotimes (positive-count-index (-> this pos-vol-count))
                (+! plane-total (-> this pos-vol positive-count-index num-planes)))
              (dotimes (cutout-count-index (-> this neg-vol-count))
                (+! plane-total (-> this neg-vol cutout-count-index num-planes)))
              (set! (-> this debug-point) (new 'debug 'vector-array (* 10 plane-total)))
              (set! (-> this debug-normal) (new 'debug 'vector-array (* 10 plane-total))))
            (set! pp saved-pp))
          (set! (-> this debug-point length) 0)
          (set! (-> this debug-normal length) 0)
          (dotimes (positive-init-index (-> this pos-vol-count))
            (init-vol! (-> this pos-vol positive-init-index) 'vol (-> this debug-point) (-> this debug-normal)))
          (dotimes (cutout-init-index (-> this neg-vol-count))
            (init-vol! (-> this neg-vol cutout-init-index) 'vol (-> this debug-point) (-> this debug-normal))))
        (dotimes (positive-draw-index (-> this pos-vol-count))
          (debug-draw (-> this pos-vol positive-draw-index)))
        (dotimes (cutout-draw-index (-> this neg-vol-count))
          (debug-draw (-> this neg-vol cutout-draw-index)))))
    (the-as symbol 0)))

(defmethod point-in-vol? ((this vol-control) (point vector))
  "Return whether point is inside this control's authored region: inside at least one positive volume
   and outside every cutout volume. Cutouts win, so a point inside both is outside. Tests use a zero
   tolerance, which puts a point exactly on a face inside. A control with no positive volumes always
   reports false."
  (dotimes (cutout-index (-> this neg-vol-count))
    (if (point-in-vol? (-> this neg-vol cutout-index) point 0.0) (return #f)))
  (dotimes (positive-index (-> this pos-vol-count))
    (if (point-in-vol? (-> this pos-vol positive-index) point 0.0) (return #t)))
  #f)

;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/entity/res.gc")
(require "kernel/gstate.gc")
(require "engine/draw/drawable-h.gc")
(require "engine/game/main-h.gc")
(require "engine/entity/entity-h.gc")
(require "engine/game/game-h.gc")
(defenum vol-flags
  :bitfield #t
  :type uint32
  (display-marks 0) ;; include this control when global volume marks are enabled
  (debug-alloc 1) ;; allocate and rebuild the derived edge and normal geometry
  (volf02)
  (volf03)
  (volf04)
  (volf05)
  (volf06)
  (volf07)
  (volf08)
  (volf09)
  (volf10)
  (volf11)
  (volf12)
  (volf13)
  (volf14)
  (volf15)
  (volf16)
  (volf17)
  (volf18)
  (volf19)
  (volf20)
  (volf21)
  (volf22)
  (volf23)
  (volf24)
  (volf25)
  (volf26)
  (volf27)
  (volf28)
  (volf29)
  (volf30)
  (volf31))

;; DECOMP BEGINS

(deftype plane-volume (structure)
  "One convex volume represented as half-space planes. The point and normal
debug ranges are generated from those planes when volume marks are enabled."
  ((volume-type symbol)
   (point-count int16)
   (normal-count int16)
   (first-point (inline-array vector))
   (first-normal (inline-array vector))
   (num-planes int32)
   (plane (inline-array plane)))
  :pack-me
  (:methods
   (init-vol! (_type_ symbol vector-array vector-array) symbol)
   (debug-draw (_type_) none)
   (point-in-vol? (_type_ vector float) symbol)))

(deftype vol-control (basic)
  "The positive and cutout convex volumes authored on one drawable process.
Point tests accept a point in any positive volume unless a cutout volume contains it."
  ((flags vol-flags)
   (process process-drawable)
   (pos-vol-count int32)
   (pos-vol plane-volume 32 :inline)
   (neg-vol-count int32)
   (neg-vol plane-volume 32 :inline)
   (debug-point vector-array)
   (debug-normal vector-array))
  (:methods
   (new (symbol type process-drawable) _type_)
   (init! (_type_) symbol)
   (point-in-vol? (_type_ vector) symbol)
   (should-display? (_type_) symbol)))

(defmethod new vol-control ((allocation symbol) (type-to-make type) (owner process-drawable))
  "Allocate a volume control for owner and load consecutive vol and cutoutvol plane
   properties from its entity resource. Each category has room for 32 volume records."
  (let ((this (the-as object (object-new allocation type-to-make (the-as int (-> type-to-make size))))))
    (when (zero? (the-as vol-control this))
      (go process-drawable-art-error "memory")
      (set! this 0)
      (goto cfg-13))
    (set! (-> (the-as vol-control this) process) owner)
    (let* ((resource (the-as res-lump (-> (the-as vol-control this) process entity)))
           (first-tag-index (-> ((method-of-type res-lump lookup-tag-idx) (the-as entity-actor resource) 'vol 'exact 0.0) lo)))
      (when (>= (the-as int first-tag-index) 0)
        (let ((tag-index (the-as int first-tag-index))
              (tag (-> resource tag first-tag-index)))
          0
          (while (= (-> tag name) (-> resource tag first-tag-index name))
            (let ((plane-data (make-property-data resource 0.0 (the-as res-tag-pair tag-index) (the-as pointer #f)))
                  (volume-record (-> (the-as vol-control this) pos-vol (-> (the-as vol-control this) pos-vol-count))))
              (set! (-> volume-record num-planes) (the-as int (-> tag elt-count)))
              (set! (-> volume-record plane) (the-as (inline-array plane) plane-data)))
            (+! (-> (the-as vol-control this) pos-vol-count) 1)
            (+! tag-index 1)
            (set! tag (-> resource tag tag-index))))))
    (let* ((resource (the-as res-lump (-> (the-as vol-control this) process entity)))
           (first-tag-index (-> ((method-of-type res-lump lookup-tag-idx) (the-as entity-actor resource) 'cutoutvol 'exact 0.0) lo)))
      (when (>= (the-as int first-tag-index) 0)
        (let ((tag-index (the-as int first-tag-index))
              (tag (-> resource tag first-tag-index)))
          0
          (while (= (-> tag name) (-> resource tag first-tag-index name))
            (let ((plane-data (make-property-data resource 0.0 (the-as res-tag-pair tag-index) (the-as pointer #f)))
                  (volume-record (-> (the-as vol-control this) neg-vol (-> (the-as vol-control this) neg-vol-count))))
              (set! (-> volume-record num-planes) (the-as int (-> tag elt-count)))
              (set! (-> volume-record plane) (the-as (inline-array plane) plane-data)))
            (+! (-> (the-as vol-control this) neg-vol-count) 1)
            (+! tag-index 1)
            (set! tag (-> resource tag tag-index))))))
    (label cfg-13)
    (the-as vol-control this)))

(defmethod should-display? ((this vol-control))
  "Return whether global volume-mark display and this control's display flag
   are both enabled."
  (and *display-vol-marks* (logtest? (-> this flags) (vol-flags display-marks))))

;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/collide/collide-func.gc")
(require "engine/camera/cam-debug-h.gc")
(require "engine/math/matrix.gc")

;; Note: "cylinder" refers to a capsule, "cylinder-flat" refers to a real cylinder with end caps.

;; Both shapes are stored the same way: origin is one end of the centerline, axis is a unit
;; direction, length is the centerline length, and radius is the distance from the centerline. So the
;; far end is origin + axis * length, and a capsule extends radius beyond each end while a flat
;; cylinder does not.
;;
;; The intersect methods take a finite probe: the segment from probe-origin to
;; probe-origin + probe-displacement. They return the fraction of that displacement at which the
;; earliest contact happens, always between zero and one, or COLLISION_MISS. Compare a returned
;; fraction against zero before using it, since COLLISION_MISS is a large negative number rather
;; than a distinguished type.
;;
;; The debug-draw methods build one longitudinal outline, rotate it a sixteenth of a revolution at a
;; time, and draw both the rotated copy and the segment joining it to the previous one. The rotation
;; matrix has its translation row patched so it turns about the shape's own axis rather than the
;; world origin, which is what lets the same matrix be reapplied sixteen times.

;; DECOMP BEGINS

(defmethod ray-capsule-intersect ((this cylinder) (probe-origin vector) (probe-displacement vector))
  "Test the finite probe origin + fraction * displacement against the cylindrical wall and both
   hemispherical ends. Return the earliest zero-to-one fraction, or COLLISION_MISS.
   The wall test's axis-point output is computed into a stack vector and discarded, so this method
   reports when the capsule is hit but not where."
  (let ((axis-point (new 'stack-no-clear 'vector))
        (end-center (new 'stack-no-clear 'vector)))
    0.0
    0.0
    ;; Test the wall first, then keep either spherical-cap contact when it is earlier.
    ;; A negative wall fraction means the wall was missed, so the first cap contact replaces it
    ;; outright; after that the comparison is a genuine "is this one earlier".
    (let ((contact-fraction (ray-cylinder-intersect probe-origin
                                                    probe-displacement
                                                    (-> this origin)
                                                    (-> this axis)
                                                    (-> this radius)
                                                    (-> this length)
                                                    axis-point)))
      (let ((origin-cap-fraction (ray-sphere-intersect probe-origin probe-displacement (-> this origin) (-> this radius))))
        (if (and (>= origin-cap-fraction 0.0) (or (< contact-fraction 0.0) (< origin-cap-fraction contact-fraction)))
          (set! contact-fraction origin-cap-fraction)))
      (vector+float*! end-center (-> this origin) (-> this axis) (-> this length))
      (let ((end-cap-fraction (ray-sphere-intersect probe-origin probe-displacement end-center (-> this radius))))
        (if (and (>= end-cap-fraction 0.0) (or (< contact-fraction 0.0) (< end-cap-fraction contact-fraction)))
          (set! contact-fraction end-cap-fraction)))
      contact-fraction)))

;; This is used to hold vertices for debug-drawing cylinders.
(deftype cylinder-verts (structure)
  ((vert vector 24 :inline)))

(defmethod debug-draw ((this cylinder) (color vector4w))
  "Draw a 16-sided wireframe capsule in color. Build one 24-point longitudinal strip, rotate
   it around the capsule axis, and submit each connecting segment individually.
   The strip is vertices 0 through 7 for the origin hemisphere, 8 through 15 up the wall, and 16
   through 23 for the far hemisphere, so the joining lines run continuously from one pole to the
   other. Draws only; nothing is returned and the cylinder is not modified."
  (local-vars (i int))
  (rlet ((vf0 :class vf)
         (axis-origin :class vf)
         (turned-origin :class vf)
         (recentering :class vf))
    (init-vf0-vector)
    ;; Any direction perpendicular to the axis will do for the outline, so cross the axis with a
    ;; world axis -- with +z instead of +y when the cylinder is close to vertical, since crossing
    ;; against a nearly parallel vector loses all its precision.
    (let ((radial (new 'stack-no-clear 'vector))
          (axis-step (new 'stack-no-clear 'vector)))
      (if (< 0.999 (fabs (-> this axis y)))
        (vector-cross! radial (-> this axis) (new 'static 'vector :z 1.0))
        (vector-cross! radial (-> this axis) (new 'static 'vector :y 1.0)))
      (vector-normalize! radial (-> this radius))
      (vector-float*! axis-step (-> this axis) (/ (-> this length) 8))
      (let ((vertices (new 'stack-no-clear 'cylinder-verts))
            (rotated-vertices (new 'stack-no-clear 'cylinder-verts))
            (rotation-matrix (new 'stack-no-clear 'matrix)))
        (matrix-axis-angle! rotation-matrix (-> this axis) (degrees 22.5))
        ;; Rotate around the cylinder axis through origin rather than around the world origin.
        ;; The translation that puts origin back where it started is origin minus its own rotated
        ;; image, so it is obtained by rotating origin once and subtracting.
        (let ((rotated-origin (new 'stack-no-clear 'matrix)))
          (vector-matrix*! (the-as vector rotated-origin) (-> this origin) rotation-matrix)
          (let ((rotation-translation (-> rotation-matrix vector 3)))
            (.lvf axis-origin (&-> (-> this origin) quad))
            (.lvf turned-origin (&-> rotated-origin vector 0 quad))
            (.mov.vf.w recentering vf0)
            (.sub.vf.xyz recentering axis-origin turned-origin)
            (.svf (&-> rotation-translation quad) recentering)))
        (set! i 0)
        (while (< i 8)
          (vector+! (-> vertices vert (+ i 8)) (-> this origin) radial)
          (vector+float*! (-> vertices vert (+ i 8)) (-> vertices vert (+ i 8)) axis-step (the float i))
          (+! i 1))
        ;; The two hemispheres walk eight steps of an eighth of a quarter revolution. radial already
        ;; carries the radius, so the cosine scales it directly and the sine walks along the axis.
        (dotimes (cap-index 8)
          (vector+float*! (-> vertices vert cap-index) (-> this origin) radial (cos (* (degrees 11.25) (the float (- 7 cap-index)))))
          (vector+float*! (-> vertices vert cap-index)
                          (-> vertices vert cap-index)
                          (-> this axis)
                          (* (- (-> this radius)) (sin (* (degrees 11.25) (the float (- 7 cap-index))))))
          (vector+float*! (-> vertices vert (+ cap-index 16)) (-> this origin) radial (cos (* (degrees 11.25) (the float cap-index))))
          (vector+float*! (-> vertices vert (+ cap-index 16))
                          (-> vertices vert (+ cap-index 16))
                          (-> this axis)
                          (+ (-> this length) (* (-> this radius) (sin (* (degrees 11.25) (the float cap-index)))))))
        (dotimes (rotation-index 16)
          (dotimes (vertex-index 24)
            (vector-matrix*! (-> rotated-vertices vert vertex-index) (-> vertices vert vertex-index) rotation-matrix)
            (camera-line (-> vertices vert vertex-index) (-> rotated-vertices vert vertex-index) color)
            (if (nonzero? vertex-index) (camera-line (-> vertices vert vertex-index) (-> vertices vert (+ vertex-index -1)) color)))
          (let ((swap vertices)) (set! vertices rotated-vertices) (set! rotated-vertices swap)))))
    0
    (none)))

(defun ray-arbitrary-circle-intersect ((probe-origin vector) (probe-displacement vector) (circle-origin vector) (circle-normal vector) (radius float))
  "Intersect the finite probe origin + fraction * displacement with the filled disk centered at
   circle-origin in circle-normal's plane. Return a zero-to-one fraction only when the plane contact
   lies strictly inside radius; return COLLISION_MISS otherwise.
   circle-normal need not be unit, since it appears in both halves of the ratio, but it must not be
   perpendicular to probe-displacement: a displacement parallel to the plane divides by zero and the
   resulting fraction is compared without any special case. A point exactly on the rim counts as a
   miss, and the disk is two-sided."
  ;; The membership test squares both sides rather than taking a square root of the radial offset.
  (let* ((center-offset (vector-! (new 'stack-no-clear 'vector) circle-origin probe-origin))
         (contact-fraction (/ (vector-dot center-offset circle-normal) (vector-dot probe-displacement circle-normal))))
    (cond
      ((or (< 1.0 contact-fraction) (< contact-fraction 0.0)) COLLISION_MISS)
      ((let ((radial-offset (new 'stack-no-clear 'vector)))
         (vector-float*! radial-offset probe-displacement contact-fraction)
         (vector-! radial-offset radial-offset center-offset)
         (< (vector-dot radial-offset radial-offset) (* radius radius)))
       contact-fraction)
      (else COLLISION_MISS))))

(defmethod ray-flat-cyl-intersect ((this cylinder-flat) (probe-origin vector) (probe-displacement vector))
  "Test the finite probe origin + fraction * displacement against the cylindrical wall and both
   filled end caps. Return the earliest zero-to-one fraction, or COLLISION_MISS.
   Unlike ray-capsule-intersect this keeps a contact position in a stack vector, overwriting it with
   the relevant cap center when a cap wins, but that vector is local and is discarded on return."
  (let ((axis-point (new 'stack-no-clear 'vector))
        (end-center (new 'stack-no-clear 'vector)))
    0.0
    0.0
    ;; Test the wall first, then keep either filled-cap contact when it is earlier.
    (let ((contact-fraction (ray-cylinder-intersect probe-origin
                                                    probe-displacement
                                                    (-> this origin)
                                                    (-> this axis)
                                                    (-> this radius)
                                                    (-> this length)
                                                    axis-point)))
      (let ((origin-cap-fraction (ray-arbitrary-circle-intersect probe-origin probe-displacement (-> this origin) (-> this axis) (-> this radius))))
        (when (and (>= origin-cap-fraction 0.0) (or (< contact-fraction 0.0) (< origin-cap-fraction contact-fraction)))
          (set! contact-fraction origin-cap-fraction)
          (set! (-> axis-point quad) (-> this origin quad))))
      (vector+float*! end-center (-> this origin) (-> this axis) (-> this length))
      (let ((end-cap-fraction (ray-arbitrary-circle-intersect probe-origin probe-displacement end-center (-> this axis) (-> this radius))))
        (when (and (>= end-cap-fraction 0.0) (or (< contact-fraction 0.0) (< end-cap-fraction contact-fraction)))
          (set! contact-fraction end-cap-fraction)
          (set! (-> axis-point quad) (-> end-center quad))))
      contact-fraction)))

;; debug draw for cylinder flat.
(deftype cylinder-flat-verts (structure)
  ((vert vector 10 :inline)))

(defmethod debug-draw ((this cylinder-flat) (color vector4w))
  "Draw a 16-sided wireframe flat-ended cylinder in color. Build one longitudinal strip from
   the two cap centers and eight wall points, rotate it around the axis, and submit each connecting
   segment individually.
   Vertex 0 is the origin cap center, 1 through 8 run up the wall, and 9 is the far cap center, so
   the joining lines also draw both cap spokes. Draws only; nothing is returned."
  (local-vars (i int))
  (rlet ((vf0 :class vf)
         (axis-origin :class vf)
         (turned-origin :class vf)
         (recentering :class vf))
    (init-vf0-vector)
    ;; Eight wall points over seven steps, so both ends of the wall land exactly on a cap.
    (let ((radial (new 'stack-no-clear 'vector))
          (axis-step (new 'stack-no-clear 'vector)))
      (if (< 0.999 (fabs (-> this axis y)))
        (vector-cross! radial (-> this axis) (new 'static 'vector :z 1.0))
        (vector-cross! radial (-> this axis) (new 'static 'vector :y 1.0)))
      (vector-normalize! radial (-> this radius))
      (vector-float*! axis-step (-> this axis) (/ (-> this length) 7))
      (let ((vertices (new 'stack-no-clear 'cylinder-flat-verts))
            (rotated-vertices (new 'stack-no-clear 'cylinder-flat-verts))
            (rotation-matrix (new 'stack-no-clear 'matrix)))
        (matrix-axis-angle! rotation-matrix (-> this axis) (degrees 22.5))
        ;; Rotate around the cylinder axis through origin rather than around the world origin.
        (let ((rotated-origin (new 'stack-no-clear 'vector)))
          (vector-matrix*! rotated-origin (-> this origin) rotation-matrix)
          (let ((rotation-translation (-> rotation-matrix vector 3)))
            (.lvf axis-origin (&-> (-> this origin) quad))
            (.lvf turned-origin (&-> rotated-origin quad))
            (.mov.vf.w recentering vf0)
            (.sub.vf.xyz recentering axis-origin turned-origin)
            (.svf (&-> rotation-translation quad) recentering)))
        (set! i 0)
        (while (< i 8)
          (vector+! (-> vertices vert (+ i 1)) (-> this origin) radial)
          (vector+float*! (-> vertices vert (+ i 1)) (-> vertices vert (+ i 1)) axis-step (the float i))
          (+! i 1))
        (set! (-> vertices vert 0 quad) (-> this origin quad))
        (vector+float*! (-> vertices vert 9) (-> this origin) (-> this axis) (-> this length))
        (dotimes (rotation-index 16)
          (dotimes (vertex-index 10)
            (vector-matrix*! (-> rotated-vertices vert vertex-index) (-> vertices vert vertex-index) rotation-matrix)
            (camera-line (-> vertices vert vertex-index) (-> rotated-vertices vert vertex-index) color)
            (if (nonzero? vertex-index) (camera-line (-> vertices vert vertex-index) (-> vertices vert (+ vertex-index -1)) color)))
          (let ((swap vertices)) (set! vertices rotated-vertices) (set! rotated-vertices swap)))))
    0
    (none)))

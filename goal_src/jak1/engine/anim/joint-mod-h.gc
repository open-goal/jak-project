(deftype joint-mod-blend-local (basic)
  ((transform       transformq :inline)
   (blend-transform transformq :inline)
   (node-index      int32)
   (blend           float)
   (enable          basic))
  (:methods
   (new (symbol type process-drawable int basic) _type_)))

(defun joint-mod-blend-local-callback ((node cspace) (local-transform transformq))
  "Blend the animated local transform toward the configured override when enabled."
  (let ((gp-0 (the-as joint-mod-blend-local (-> node param1))))
    (cond
      ((-> gp-0 enable)
       (vector-lerp! (-> gp-0 blend-transform trans) (-> local-transform trans) (-> gp-0 transform trans) (-> gp-0 blend))
       (vector-lerp! (-> gp-0 blend-transform scale) (-> local-transform scale) (-> gp-0 transform scale) (-> gp-0 blend))
       (quaternion-slerp! (-> gp-0 blend-transform quat) (-> local-transform quat) (-> gp-0 transform quat) (-> gp-0 blend))
       (cspace<-parented-transformq-joint! node (-> gp-0 blend-transform)))
      (else (cspace<-parented-transformq-joint! node local-transform))))
  (none))

(defmethod new joint-mod-blend-local ((allocation symbol) (type-to-make type) (process process-drawable) (joint-index int) (enable basic))
  "Attach a local-transform override that blends with the animated joint transform."
  (let ((v0-0 (object-new allocation type-to-make (the-as int (-> type-to-make size)))))
    (set! (-> v0-0 node-index) joint-index)
    (set! (-> v0-0 enable) enable)
    (set! (-> v0-0 blend) 0.0)
    (set! (-> v0-0 transform trans quad) (-> *null-vector* quad))
    (set! (-> v0-0 transform quat vec quad) (-> *null-vector* quad))
    (set! (-> v0-0 transform scale quad) (-> *identity-vector* quad))
    (let ((v1-7 (-> process node-list data joint-index)))
      (set! (-> v1-7 param0) joint-mod-blend-local-callback)
      (set! (-> v1-7 param1) v0-0))
    v0-0))

(deftype joint-mod-spinner (basic)
  ((spin-axis vector :inline)
   (angle     float)
   (spin-rate float)
   (enable    basic))
  (:methods
   (new (symbol type process-drawable int vector float) _type_)))

(defun joint-mod-spinner-callback ((node cspace) (local-transform transformq))
  "Advance the spin angle and apply it to the joint's local rotation when enabled."
  (let ((gp-0 (the-as joint-mod-spinner (-> node param1))))
    (when (-> gp-0 enable)
      (let ((f30-0 (+ (-> gp-0 angle) (* (-> gp-0 spin-rate) (seconds-per-frame)))))
        (if (< 32768.0 f30-0) (set! f30-0 (+ -65536.0 f30-0)))
        (if (< f30-0 -32768.0) (set! f30-0 (+ 65536.0 f30-0)))
        (quaternion-vector-angle! (-> local-transform quat) (-> gp-0 spin-axis) f30-0)
        (set! (-> gp-0 angle) f30-0))))
  (cspace<-parented-transformq-joint! node local-transform)
  (none))

(defmethod new joint-mod-spinner ((allocation symbol)
            (type-to-make type)
            (process process-drawable)
            (joint-index int)
            (spin-axis vector)
            (spin-rate float))
  "Attach a continuously rotating local transform to one joint."
  (let ((v0-0 (object-new allocation type-to-make (the-as int (-> type-to-make size)))))
    (set! (-> v0-0 spin-axis quad) (-> spin-axis quad))
    (set! (-> v0-0 spin-rate) spin-rate)
    (set! (-> v0-0 enable) #t)
    (set! (-> v0-0 angle) 0.0)
    (let ((v1-6 (-> process node-list data joint-index)))
      (set! (-> v1-6 param0) joint-mod-spinner-callback)
      (set! (-> v1-6 param1) v0-0))
    v0-0))

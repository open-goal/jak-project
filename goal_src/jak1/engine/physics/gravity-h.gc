;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/util/types-h.gc")

;; Default gravity magnitude: 60 meters per second squared. Dynamics stores the
;; positive up-axis vector and negates it when applying gravitational acceleration.
(defconstant GRAVITY_AMOUNT (meters 60))

;; Default terminal fall speed: 40 meters per second.
(defconstant GRAVITY_MAX (meters 40))

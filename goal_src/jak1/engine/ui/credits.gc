;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/ui/text.gc")

;; DECOMP BEGINS

(defun set-credits-font-color ((brightness float))
  "Set the RGB channels of all four variants in credits color slot 32. Each channel is 64 times
   brightness, clamped to a minimum of 128; the alpha channels are unchanged."
  255.0
  (dotimes (i 4)
    (let ((red-value (* 64.0 brightness)))
      (if (< 128.0 red-value) (set! red-value 128.0))
      (set! (-> *font-work* color-table 32 color i r) (the int red-value)))
    (let ((green-value (* 64.0 brightness)))
      (if (< 128.0 green-value) (set! green-value 128.0))
      (set! (-> *font-work* color-table 32 color i g) (the int green-value)))
    (let ((blue-value (* 64.0 brightness)))
      (if (< 128.0 blue-value) (set! blue-value 128.0))
      (set! (-> *font-work* color-table 32 color i b) (the int blue-value))))
  0
  (none))

(define *title-credits-scale* (new 'static 'boxed-array :type float 0.9 0.9 0.6 0.6 1.0 0.9 1.1 0.9))

(define *title-credits-spacing* (new 'static 'boxed-array :type int32 15 20 15 15 20 15 20 15))

(defun draw-title-credits ((credit-progress float))
  "Draw the opening title credits for a normalized time from 0 to 1. The timeline advances through
   three-line cards: each card waits, fades in, holds at half opacity, and fades out. Per-line scale
   and spacing come from the title-credit tables, with territory-specific company text on the first
   card."
  (when (>= 1.0 credit-progress)
    (let* ((timeline-length 11)
           (timeline-position (* credit-progress (the float (+ timeline-length -2))))
           (timeline-index (the int timeline-position))
           (font (new 'stack 'font-context *font-default-matrix* 0 0 0.0 (font-color default) (font-flags shadow kerning))))
      1.0
      (set-width! font 600)
      (set-height! font 10)
      (set-flags! font (font-flags kerning middle large))
      (let* ((group-start (- timeline-index (mod timeline-index 3)))
             (group-phase (- timeline-position (the float group-start))))
        (when (and (>= group-start 0) (< group-start timeline-length))
          (let ((opacity (cond
                           ((< group-phase 0.8) 0.0)
                           ((< group-phase 1.6) (* 160.0 (+ -0.8 group-phase)))
                           ((< group-phase 2.2) 128.0)
                           (else (* 128.0 (- 1.0 (* 1.25 (+ -2.2 group-phase))))))))
            (set! (-> font origin x) -44.0)
            (set! (-> font origin y) 90.0)
            (dotimes (i 3)
              (let* ((text-index (+ i 3840 group-start))
                     (text (lookup-text! *common-text* (the-as text-id text-index) #t)))
                (when (= text-index 3841)
                  (case (scf-get-territory)
                    ((GAME_TERRITORY_SCEE) (set! text (lookup-text! *common-text* (text-id europe) #t)))
                    ((GAME_TERRITORY_SCEI) (set! text (lookup-text! *common-text* (text-id inc) #t)))))
                (when text
                  (set-scale! font (-> *title-credits-scale* (+ group-start i)))
                  (print-game-text text font #f (the int opacity) 22)))
              (+! (-> font origin y) (the float (-> *title-credits-spacing* (+ group-start i))))))))))
  0
  (none))

(defun draw-end-credits ((scroll-offset int))
  "Scroll the end-credit text upward by the given pixel offset. Lines above the screen are measured
   without drawing, visible lines are drawn through the bottom edge, and missing text entries take
   25 pixels. Returns true after the final text ID; on PC the credits use the current audio language
   and restore automatic level-text loading when finished."
  (local-vars (draw-line-height int))
  (#when PC_PORT
    ;; og:preserve-this change text language during credits
    ;; disable the automatic text loading for now
    (disable-level-text-file-loading)
    (protect ((-> *pc-settings* text-language))
      ;; swap language and load new text files
      (set! (-> *pc-settings* text-language) (the pc-language (-> *setting-control* current language)))
      (load-level-text-files 0)))
  (let ((y (+ (- scroll-offset) (the int (* 1.5 (the float (-> *video-parms* screen-sy))))))
        (text-index 2815)
        (skip-line-height 0)
        (first-line? #t)
        (font (new 'stack 'font-context *font-default-matrix* 31 0 0.0 (font-color default) (font-flags shadow kerning))))
    (set-width! font 450)
    (set-height! font 10)
    (set-scale! font 1.0)
    (set-flags! font (font-flags shadow kerning middle large))
    (while (or first-line? (and (< y (- skip-line-height)) (< (the-as uint text-index) (the-as uint 3262))))
      (+! y skip-line-height)
      (+! text-index 1)
      (let ((skip-text (lookup-text! *common-text* (the-as text-id text-index) #t)))
        (if skip-text
          (set! skip-line-height (the int (+ 5.0 (print-game-text skip-text font #t 128 20))))
          (set! skip-line-height 25)))
      (set! first-line? #f))
    (cond
      ((>= (the-as uint text-index) (the-as uint 3262))
       (#when PC_PORT
         ;; credits are over - re-enable automatic text loading
         (enable-level-text-file-loading))
       #t)
      (else
       (set! (-> font origin y) (the float y))
       (while (< (-> font origin y) (the float (-> *video-parms* screen-sy)))
         (let ((draw-text (lookup-text! *common-text* (the-as text-id text-index) #t)))
           (if draw-text
             (set! draw-line-height (the int (+ 5.0 (print-game-text draw-text font #f 128 20))))
             (set! draw-line-height 25)))
         (+! (-> font origin y) (the float draw-line-height))
         (+! text-index 1))
       #f))))

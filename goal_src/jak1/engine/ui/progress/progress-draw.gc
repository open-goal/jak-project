  (set-width! font 360)
  (set-height! font 60)
  (print-game-text-scaled (lookup-text! *common-text* (text-id autosave-disabled-msg) #f)
                          (-> this transition-percentage-invert)
                          font
                          128)
  (set-scale! font 0.65)
  (set! (-> font origin y) 160.0)
  (set-height! font 60)
  (print-game-text-scaled (lookup-text! *common-text* (text-id continue?) #f)
                          (-> this transition-percentage-invert)
                          font
                          128)
  0
  (none))


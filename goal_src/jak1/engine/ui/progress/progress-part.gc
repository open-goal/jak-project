;; DECOMP BEGINS

(defun part-progress-hud-left-func ((system sparticle-system) (particle sparticle-cpuinfo) (matrix-out matrix))
  "Apply the current nonuniform scale to the progress screen's left side panel."
  (let ((progress-menu *progress-process*))
    (set! (-> matrix-out vector 0 w) (-> progress-menu 0 left-side-x-scale))
    (set! (-> matrix-out vector 1 w) (-> progress-menu 0 left-side-y-scale)))
  (none))

(defun part-progress-hud-right-func ((system sparticle-system) (particle sparticle-cpuinfo) (matrix-out matrix))
  "Apply the current nonuniform scale to the progress screen's right side panel."
  (let ((progress-menu *progress-process*))
    (set! (-> matrix-out vector 0 w) (-> progress-menu 0 right-side-x-scale))
    (set! (-> matrix-out vector 1 w) (-> progress-menu 0 right-side-y-scale)))
  (none))

(defun part-progress-hud-orb-func ((system sparticle-system) (particle sparticle-cpuinfo) (matrix-out matrix))
  "Scale the small orb icon against the horizontal side-panel scale so it retains its intended
   proportions. The custom-aspect PC path leaves the port's existing sprite scale in place."
  ;; og:preserve-this
  (#cond
    (PC_PORT
     (unless (and *pc-settings* (not (-> *pc-settings* use-vis?)))
       (set! (-> matrix-out vector 0 w) (/ 5324.8 (-> *progress-process* 0 sides-x-scale)))
       (set! (-> matrix-out vector 1 w) (/ 5324.8 (-> *progress-process* 0 sides-x-scale)))))
    (#t
     (set! (-> matrix-out vector 0 w) (/ 5324.8 (-> *progress-process* 0 sides-x-scale)))
     (set! (-> matrix-out vector 1 w) (/ 5324.8 (-> *progress-process* 0 sides-x-scale)))))
  (none))

(defun part-progress-hud-buzzer-func ((system sparticle-system) (particle sparticle-cpuinfo) (matrix-out matrix))
  "Scale the scout-fly icon against the horizontal side-panel scale so it retains its intended
   proportions. The custom-aspect PC path leaves the port's existing sprite scale in place."
  ;; og:preserve-this
  (#cond
    (PC_PORT
     (unless (and *pc-settings* (not (-> *pc-settings* use-vis?)))
       (set! (-> matrix-out vector 0 w) (/ 6144.0 (-> *progress-process* 0 sides-x-scale)))
       (set! (-> matrix-out vector 1 w) (/ 6144.0 (-> *progress-process* 0 sides-x-scale)))))
    (#t
     (set! (-> matrix-out vector 0 w) (/ 6144.0 (-> *progress-process* 0 sides-x-scale)))
     (set! (-> matrix-out vector 1 w) (/ 6144.0 (-> *progress-process* 0 sides-x-scale)))))
  (none))

(defun part-progress-hud-button-func ((system sparticle-system) (particle sparticle-cpuinfo) (matrix-out matrix))
  "Scale a progress navigation button against the horizontal side-panel scale so it retains its
   intended proportions. The custom-aspect PC path leaves the port's existing sprite scale."
  ;; og:preserve-this
  (#cond
    (PC_PORT
     (unless (and *pc-settings* (not (-> *pc-settings* use-vis?)))
       (set! (-> matrix-out vector 0 w) (/ 6553.6 (-> *progress-process* 0 sides-x-scale)))
       (set! (-> matrix-out vector 1 w) (/ 6553.6 (-> *progress-process* 0 sides-x-scale)))))
    (#t
     (set! (-> matrix-out vector 0 w) (/ 6553.6 (-> *progress-process* 0 sides-x-scale)))
     (set! (-> matrix-out vector 1 w) (/ 6553.6 (-> *progress-process* 0 sides-x-scale)))))
  (none))

(defun part-progress-hud-tint-func ((system sparticle-system) (particle sparticle-cpuinfo) (matrix-out matrix))
  "Fade the full-screen tint from the progress screen's slide position. On custom PC aspects,
   widen it to cover the complete display."
  (set! (-> matrix-out vector 2 w) (the float (- 64 (sar (* 63 (-> *progress-process* 0 in-out-position)) 12))))
  ;; og:preserve-this
  (#when PC_PORT
    (if (and *pc-settings* (not (-> *pc-settings* use-vis?)))
      (set! (-> matrix-out vector 0 w) (* (meters 15) (-> *pc-settings* aspect-ratio-scale)))))
  0
  (none))

(defun part-progress-card-slot-01-func ((system sparticle-system) (particle sparticle-cpuinfo) (matrix-out matrix))
  "Highlight memory-card slot zero, apply the common slot height, and widen the card on custom
   PC aspects."
  (set! (-> matrix-out vector 2 w) (if (zero? (-> *progress-process* 0 option-index)) 64.0 32.0))
  (set! (-> matrix-out vector 1 w) (-> *progress-process* 0 slot-scale))
  ;; og:preserve-this added memcard width scaling for custom-aspects
  (when (not (-> *pc-settings* use-vis?))
    (set! (-> matrix-out vector 0 w) (* (meters 9.2) (-> *video-parms* relative-x-scale-reciprical))))
  0
  (none))

(defun part-progress-card-slot-02-func ((system sparticle-system) (particle sparticle-cpuinfo) (matrix-out matrix))
  "Highlight memory-card slot one, apply the common slot height, and widen the card on custom
   PC aspects."
  (set! (-> matrix-out vector 2 w) (if (= (-> *progress-process* 0 option-index) 1) 64.0 32.0))
  (set! (-> matrix-out vector 1 w) (-> *progress-process* 0 slot-scale))
  ;; og:preserve-this added memcard width scaling for custom-aspects
  (when (not (-> *pc-settings* use-vis?))
    (set! (-> matrix-out vector 0 w) (* (meters 9.2) (-> *video-parms* relative-x-scale-reciprical))))
  0
  (none))


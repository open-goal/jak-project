   PC aspects."
  (set! (-> matrix-out vector 2 w) (if (= (-> *progress-process* 0 option-index) 3) 64.0 32.0))
  (set! (-> matrix-out vector 1 w) (-> *progress-process* 0 slot-scale))
  ;; og:preserve-this added memcard width scaling for custom-aspects
  (when (not (-> *pc-settings* use-vis?))
    (set! (-> matrix-out vector 0 w) (* (meters 9.2) (-> *video-parms* relative-x-scale-reciprical))))
  0
  (none))

(defun part-progress-card-cell-func ((system sparticle-system) (particle sparticle-cpuinfo) (matrix-out matrix))
  "Fade a memory-card file cell during the latter half of the inverted screen transition."
  (let ((opacity (* 2.0 (+ -0.5 (-> *progress-process* 0 transition-percentage-invert)))))
    (if (< opacity 0.0) (set! opacity 0.0))
    (set! (-> matrix-out vector 2 w) (* 128.0 opacity)))
  0
  (none))

(defun part-progress-save-icon-func ((system sparticle-system) (particle sparticle-cpuinfo) (matrix-out matrix))
  "Shrink the save-status icon with the inverted screen-transition percentage."
  (let ((scale (* 6144.0 (-> *progress-process* 0 transition-percentage-invert))))
    (set! (-> matrix-out vector 0 w) scale)
    (set! (-> matrix-out vector 1 w) scale))
  0
  (none))

(defun fuel-cell-progress-hud-orbit-callback ((system sparticle-system) (particle sparticle-cpuinfo) (matrix-out matrix))
  "Place one power-cell model particle at its selected model joint relative to the center joint.
   Hide inactive particle-state entries offscreen; joint index three instead controls alpha."
  (let* ((launcher (-> particle key))
         (progress-menu (the-as progress (-> launcher proc)))
         (joint-index (the int (the-as float (-> particle user-float))))
         (particle-index -1))
    (let ((slot-index 0))
      (dotimes (scan-count (-> *progress-process* 0 nb-of-particles))
        (if (= (-> launcher matrix) (-> progress-menu particles slot-index part matrix)) (set! particle-index slot-index))
        (+! slot-index 1)))
    (cond
      ((= joint-index 3)
       (if (= (-> progress-menu particle-state particle-index) 1)
         (set! (-> matrix-out vector 2 w) 42.0)
         (set! (-> matrix-out vector 2 w) 128.0))
       0)
      (else
       (let ((joint-position (new 'stack-no-clear 'vector))
             (center-position (new 'stack-no-clear 'vector)))
         (cond
           ((or (= particle-index -1)
                (= (-> progress-menu particle-state particle-index) 2)
                (= (-> progress-menu particle-state particle-index) 1))
            (set! (-> matrix-out vector 0 x) 245760.0))
           ((= joint-index -1) (set! (-> matrix-out vector 0 x) 0.0) (set! (-> matrix-out vector 0 y) 0.0))
           (else
            (vector<-cspace! joint-position (-> progress-menu icons (logand particle-index 3) icon 0 node-list data joint-index))
            (vector<-cspace! center-position (-> progress-menu icons (logand particle-index 3) icon 0 node-list data 3))
            (vector-! joint-position joint-position center-position)
            ;; og:preserve-this
            (#when PC_PORT
              (when (not (-> *pc-settings* use-vis?))
                (*! (-> joint-position x) (-> *video-parms* relative-x-scale))))
            (set! (-> matrix-out vector 0 x) (* 48.0 (-> joint-position x)))
            (set! (-> matrix-out vector 0 y) (* 60.0 (-> joint-position y)))
            (set! (-> matrix-out vector 0 z) (* 32.0 (-> joint-position z))))))
       0)))
  0
  (none))


(deftype hud-pickups (hud) ())

(defmethod draw-hud ((this hud-pickups))
  "Draw the pickup particles, then print the displayed eco-pill count."
  (let ((base-draw (method-of-type hud draw-hud))) (base-draw this))
  (let* ((buf (-> *display* frames (-> *display* on-screen) frame global-buf))
         (bucket-start (-> buf base)))
    (let ((draw-text draw-string-xy))
      (format (clear *temp-string*) "~D" (-> this value))
      (draw-text *temp-string*
                 buf
                 (+ (-> this text-x) (* (-> this x-sgn) (-> this offset)))
                 (/ (* (+ (-> this text-y) (* (-> this y-sgn) (-> this offset)) (-> this y-offset))
                       (the int (-> *video-parms* relative-y-scale)))
                    2)
                 (font-color green)
                 (font-flags shadow kerning large)))
    (let ((bucket-end (-> buf base)))
      (let ((packet (the-as object (-> buf base))))
        (set! (-> (the-as (pointer int64) packet)) #x20000000)
        (set! (-> (the-as dma-packet packet) vif0) (new 'static 'vif-tag))
        (set! (-> (the-as dma-packet packet) vif1) (new 'static 'vif-tag))
        (set! (-> buf base) (&+ (the-as pointer packet) 16)))
      (dma-bucket-insert-tag (-> *display* frames (-> *display* on-screen) frame bucket-group)
                             (bucket-id debug)
                             bucket-start
                             (the-as (pointer dma-tag) bucket-end))))
  0
  (none))

(defmethod hud-update ((this hud-pickups))
  "Tally the displayed pickup count toward Jak's current eco-pill count."
  (if *target* (tally-value this (the int (+ 0.5 (-> *target* fact eco-pill))) 0))
  0
  (none))

(defmethod init-particles! ((this hud-pickups) (init-value int))
  "Create the pickup icon particle, allocate its sprite matrix, and position its count text."
  (when (< (-> this nb-of-particles) (-> this max-nb-of-particles))
    (let ((particle-index (-> this nb-of-particles)))
      (set! (-> this particles particle-index) (new 'static 'hud-particle))
      (set! (-> this particles particle-index part) (create-launch-control group-part-hud-pickup this))
      (set! (-> this particles particle-index init-pos x) 110.0)
      (set! (-> this particles particle-index init-pos y) 55.0)
      (set! (-> this particles particle-index init-pos z) 1.0)
      (set! (-> this particles particle-index part matrix) -1))
    (+! (-> this nb-of-particles) 1))
  (dotimes (i (-> this nb-of-particles))
    (if (= (-> this particles i part matrix) -1) (set! (-> this particles i part matrix) (sprite-allocate-user-hvdf))))
  (set! (-> this text-x) 118)
  (set! (-> this text-y) 45)
  (set! (-> this x-sgn) -1)
  (set! (-> this y-sgn) -1)
  (set! (-> this friend) 3)
  0
  (none))


(deftype hud-buzzers (hud)
  ((scale         float)
   (text-y-offset int32)))

(defun part-hud-buzzer-func ((system sparticle-system) (particle sparticle-cpuinfo) (matrix-out matrix))
  "Apply the display-dependent scale to the scout-fly HUD particle."
  (let ((scale (-> *hud-parts* buzzers 0 scale)))
    (set! (-> matrix-out vector 0 w) scale)
    (set! (-> matrix-out vector 1 w) scale))
  (none))

(defmethod draw-hud ((this hud-buzzers))
  "Draw the scout-fly particle and count. The PC collectable view can show the original
   current-level count, game-wide totals, or current-level totals."
  (let ((base-draw (method-of-type hud draw-hud))) (base-draw this))
  (set! (-> this text-y) (+ (if (nonzero? (-> this next-y-offset)) (-> this text-y-offset) 0) 362))
  (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug))
    (let* ((string-x (+ (-> this text-x) (* (-> this x-sgn) (-> this offset))))
           (string-y (/ (* (+ (-> this text-y) (* (-> this y-sgn) (-> this offset)) (-> this y-offset))
                           (the int (-> *video-parms* relative-y-scale)))
                        2)))
      (case *hud-collectable-view*
        (((hud-collectable-view game-totals))
         ;; show flies collected/total across entire game
         (draw-string-xy-scaled (string-format " ~D~% /~D"
                                               (the int (-> *game-info* buzzer-total))
                                               112 ;; (-> (the progress (-> *progress-process* 0)) total-nb-of-buzzers)
                                               )
                                buf
                                string-x
                                (- string-y 5)
                                (font-color yellow)
                                (font-flags shadow kerning large)
                                0.8))
        (((hud-collectable-view level-totals))
         (let ((level-index (-> *level-task-data-remap* (+ (-> *target* current-level info index) -1))))
           ;; show flies collected/total this level
           (draw-string-xy-scaled (string-format " ~D~% /~D"
                                                 (buzzer-count *game-info*
                                                               (-> *level-task-data* level-index task-info (-> *level-task-data* level-index buzzer-task-index) task-id))
                                                 (-> *game-counts* data level-index buzzer-count))
                                  buf
                                  string-x
                                  (- string-y 5)
                                  (font-color yellow)
                                  (font-flags shadow kerning large)
                                  0.8)))
        (((hud-collectable-view original))
         ;; show original (flies collected this level)
         (draw-string-xy (string-format " ~D" (-> this value))
                         buf
                         string-x
                         string-y
                         (font-color yellow)
                         (font-flags shadow kerning large))))))
  0
  (none))

(defmethod hud-update ((this hud-buzzers))
  "Tally the displayed count toward Jak's current scout-fly count."
  (if *target* (tally-value this (the int (+ 0.5 (-> *target* fact buzzer))) 0))
  0
  (none))

(defmethod init-particles! ((this hud-buzzers) (init-value int))
  "Create the scout-fly particle, allocate its sprite matrix, and position its count text."
  (when (< (-> this nb-of-particles) (-> this max-nb-of-particles))
    (let ((particle-index (-> this nb-of-particles)))
      (set! (-> this particles particle-index) (new 'static 'hud-particle))
      (set! (-> this particles particle-index part) (create-launch-control group-part-hud-buzzer this))
      (set! (-> this particles particle-index init-pos x) 60.0)
      (set! (-> this particles particle-index init-pos y) 380.0)
      (set! (-> this particles particle-index init-pos z) 1.0)
      (set! (-> this particles particle-index part matrix) -1))
    (+! (-> this nb-of-particles) 1))
  (dotimes (i (-> this nb-of-particles))
    (if (= (-> this particles i part matrix) -1) (set! (-> this particles i part matrix) (sprite-allocate-user-hvdf))))
  (set-pos-and-scale this (= (get-aspect-ratio) 'aspect16x9) (= (get-video-mode) 'pal))
  (set! (-> this text-x) 85)
  (set! (-> this text-y) 362)
  (set! (-> this x-sgn) -1)
  (set! (-> this y-sgn) 1)
  (set! (-> this text-y-offset) 0)
  (set! (-> this increment-on-event) #t)
  0
  (none))

(defmethod get-icon-pos-x ((this hud-buzzers))
  "Return the scout-fly icon's screen X position for collectable flight."
  (-> this text-x))

(defmethod get-icon-pos-y ((this hud-buzzers))
  "Return the scout-fly icon's screen Y position for collectable flight."
  (+ (if (= (-> *setting-control* current video-mode) 'pal) (+ (-> this text-y) 120) (+ (-> this text-y) 50))
     (-> this next-y-offset)))

(defmethod get-icon-scale-x ((this hud-buzzers))
  "Return the scout-fly collectable's destination X scale."
  0.008)

(defmethod get-icon-scale-y ((this hud-buzzers))
  "Return the scout-fly collectable's destination Y scale."
  -0.008)

(defmethod set-pos-and-scale ((this hud-buzzers) (widescreen? symbol) (pal? symbol))
  "Select the scout-fly particle scale and text offset for widescreen output."
  (cond
    (widescreen? (set! (-> this scale) 6553.6) (set! (-> this text-y-offset) -40))
    (else (set! (-> this scale) 7372.8) (set! (-> this text-y-offset) 0) 0))
  0
  (none))


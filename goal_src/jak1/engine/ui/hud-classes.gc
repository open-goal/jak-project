(deftype hud-power (hud)
  ((scale-timer   float)
   (scale-backing float)
   (scale-blue    float)))

(defun calculate-rotation-and-color-for-slice ((slice-index int) (fraction float) (red int) (green int) (blue int) (matrix-out matrix))
  "Rotate one of the eco meter's three fill slices to match fraction and write its RGB color.
   Empty slices are moved out of view; the last fifth of the meter flashes by alternating green."
  (cond
    ((>= 0.0 fraction) (set! (-> matrix-out vector 1 z) -16566.045))
    (else
     (let ((slice slice-index))
       (cond
         ((zero? slice)
          (if (< 1.0 fraction)
            (set! (-> matrix-out vector 1 z) 910.2222)
            (set! (-> matrix-out vector 1 z) (* 182.04445 (+ 5.0 (* 263.0 (- 1.0 fraction)))))))
         ((= slice 1)
          (if (< 0.6666667 fraction)
            (set! (-> matrix-out vector 1 z) 17294.223)
            (set! (-> matrix-out vector 1 z) (* 182.04445 (+ 95.0 (* 173.0 (- 1.0 (* 1.5 fraction))))))))
         ((= slice 2)
          (if (< 0.33333334 fraction)
            (set! (-> matrix-out vector 1 z) 33678.223)
            (set! (-> matrix-out vector 1 z) (* 182.04445 (+ 185.0 (* 83.0 (- 1.0 (* 3.0 fraction))))))))))))
  ;; low eco flashing
  ;; og:preserve-this modified to support high fps
  (if (and (< 0.0 fraction)
           (and (< fraction 0.2) (zero? (logand (the int (* DISPLAY_FPS_RATIO (-> *display* integral-frame-counter))) 4))))
    (set! green (* green 2)))
  (set! (-> matrix-out vector 2 x) (the float red))
  (set! (-> matrix-out vector 2 y) (the float green))
  (set! (-> matrix-out vector 2 z) (the float blue))
  0
  (none))

(defun part-hud-eco-timer-01-func ((system sparticle-system) (particle sparticle-cpuinfo) (matrix-out matrix))
  "Color and rotate the first eco-meter fill slice for the active eco type and remaining time."
  (let ((fraction (/ (the float
                          (the-as uint
                                  (- (-> *target* fact eco-timeout)
                                     (the-as uint (- (-> *display* game-frame-counter) (-> *target* fact eco-pickup-time))))))
                     (the float (the-as uint (-> *FACT-bank* eco-full-timeout)))))
        (red 0)
        (green 64)
        (blue 128))
    (case (-> *target* fact eco-type)
      (((pickup-type eco-yellow)) (set! red 128) (set! green 96) (set! blue 0))
      (((pickup-type eco-red)) (set! red 128) (set! green 32) (set! blue 0))
      (((pickup-type eco-green)) (set! red 0) (set! green 128) (set! blue 32)))
    (calculate-rotation-and-color-for-slice 0 fraction red green blue matrix-out))
  (let ((scale (-> *hud-parts* power 0 scale-blue)))
    (set! (-> matrix-out vector 0 w) scale)
    (set! (-> matrix-out vector 1 w) scale))
  0
  (none))

(defun part-hud-eco-timer-02-func ((system sparticle-system) (particle sparticle-cpuinfo) (matrix-out matrix))
  "Color and rotate the second eco-meter fill slice for the active eco type and remaining time."
  (let ((fraction (/ (the float
                          (the-as uint
                                  (- (-> *target* fact eco-timeout)
                                     (the-as uint (- (-> *display* game-frame-counter) (-> *target* fact eco-pickup-time))))))
                     (the float (the-as uint (-> *FACT-bank* eco-full-timeout)))))
        (red 0)
        (green 64)
        (blue 128))
    (case (-> *target* fact eco-type)
      (((pickup-type eco-yellow)) (set! red 128) (set! green 96) (set! blue 0))
      (((pickup-type eco-red)) (set! red 128) (set! green 32) (set! blue 0))
      (((pickup-type eco-green)) (set! red 0) (set! green 128) (set! blue 32)))
    (calculate-rotation-and-color-for-slice 1 fraction red green blue matrix-out))
  (let ((scale (-> *hud-parts* power 0 scale-blue)))
    (set! (-> matrix-out vector 0 w) scale)
    (set! (-> matrix-out vector 1 w) scale))
  0
  (none))

(defun part-hud-eco-timer-03-func ((system sparticle-system) (particle sparticle-cpuinfo) (matrix-out matrix))
  "Color and rotate the third eco-meter fill slice for the active eco type and remaining time."
  (let ((fraction (/ (the float
                          (the-as uint
                                  (- (-> *target* fact eco-timeout)
                                     (the-as uint (- (-> *display* game-frame-counter) (-> *target* fact eco-pickup-time))))))
                     (the float (the-as uint (-> *FACT-bank* eco-full-timeout)))))
        (red 0)
        (green 64)
        (blue 128))
    (case (-> *target* fact eco-type)
      (((pickup-type eco-yellow)) (set! red 128) (set! green 96) (set! blue 0))
      (((pickup-type eco-red)) (set! red 128) (set! green 32) (set! blue 0))
      (((pickup-type eco-green)) (set! red 0) (set! green 128) (set! blue 32)))
    (calculate-rotation-and-color-for-slice 2 fraction red green blue matrix-out))
  (let ((scale (-> *hud-parts* power 0 scale-blue)))
    (set! (-> matrix-out vector 0 w) scale)
    (set! (-> matrix-out vector 1 w) scale))
  0
  (none))

(defun part-hud-eco-timer-backing-func ((system sparticle-system) (particle sparticle-cpuinfo) (matrix-out matrix))
  "Apply the display-dependent scale to the eco meter's backing particle."
  (let ((scale (-> *hud-parts* power 0 scale-backing)))
    (set! (-> matrix-out vector 0 w) scale)
    (set! (-> matrix-out vector 1 w) scale))
  0
  (none))

(defun part-hud-eco-timer-func ((system sparticle-system) (particle sparticle-cpuinfo) (matrix-out matrix))
  "Apply the display-dependent scale to the eco meter's timer particle."
  (let ((scale (-> *hud-parts* power 0 scale-timer)))
    (set! (-> matrix-out vector 0 w) scale)
    (set! (-> matrix-out vector 1 w) scale))
  0
  (none))

(defmethod hud-update ((this hud-power))
  "Tally the eco meter toward the remaining pickup time, clamped between zero and the active
   eco timeout."
  (if *target*
    (tally-value this
                 (max 0
                      (min (the-as int
                                   (- (-> *target* fact eco-timeout)
                                      (the-as uint (- (-> *display* game-frame-counter) (-> *target* fact eco-pickup-time)))))
                           (the-as int (-> *target* fact eco-timeout))))
                 (the-as int (-> *target* fact eco-timeout))))
  0
  (none))

(defmethod init-particles! ((this hud-power) (init-value int))
  "Create the eco meter's backing, three-slice fill, and timer particles and allocate their
   sprite matrices."
  (local-vars (particle-index int))
  (when (< (-> this nb-of-particles) (-> this max-nb-of-particles))
    (set! particle-index (-> this nb-of-particles))
    (set! (-> this particles particle-index) (new 'static 'hud-particle))
    (set! (-> this particles particle-index part) (create-launch-control group-part-hud-eco-timer-backing this))
    (set! (-> this particles particle-index init-pos x) 435.0)
    (set! (-> this particles particle-index init-pos y) 370.0)
    (set! (-> this particles particle-index init-pos z) 10.0)
    (set! (-> this particles particle-index part matrix) -1)
    (+! (-> this nb-of-particles) 1))
  (when (< (-> this nb-of-particles) (-> this max-nb-of-particles))
    (set! particle-index (-> this nb-of-particles))
    (set! (-> this particles particle-index) (new 'static 'hud-particle))
    (set! (-> this particles particle-index part) (create-launch-control group-part-hud-timer-blue this))
    (set! (-> this particles particle-index init-pos x) 432.0)
    (set! (-> this particles particle-index init-pos y) 368.0)
    (set! (-> this particles particle-index init-pos z) 3.0)
    (set! (-> this particles particle-index part matrix) -1)
    (+! (-> this nb-of-particles) 1))
  (when (< (-> this nb-of-particles) (-> this max-nb-of-particles))
    (set! particle-index (-> this nb-of-particles))
    (set! (-> this particles particle-index) (new 'static 'hud-particle))
    (set! (-> this particles particle-index part) (create-launch-control group-part-hud-eco-timer this))
    (set! (-> this particles particle-index init-pos x) 435.0)
    (set! (-> this particles particle-index init-pos y) 370.0)
    (set! (-> this particles particle-index init-pos z) 2.0)
    (set! (-> this particles particle-index part matrix) -1)
    (+! (-> this nb-of-particles) 1))
  (dotimes (i (-> this nb-of-particles))
    (if (= (-> this particles i part matrix) -1) (set! (-> this particles i part matrix) (sprite-allocate-user-hvdf))))
  (set-pos-and-scale this (= (get-aspect-ratio) 'aspect16x9) (= (get-video-mode) 'pal))
  (set! (-> this x-sgn) 1)
  (set! (-> this y-sgn) 1)
  0
  (none))

(defmethod set-pos-and-scale ((this hud-power) (widescreen? symbol) (pal? symbol))
  "Select the eco meter scales for widescreen output. The PC path also adjusts horizontal
   placement when VIS is disabled."
  (cond
    (widescreen?
     (set! (-> this scale-blue) 7168.0)
     (set! (-> this scale-timer) 11468.8)
     (set! (-> this scale-backing) 8960.0))
    (else (set! (-> this scale-blue) 8192.0) (set! (-> this scale-timer) 13107.2) (set! (-> this scale-backing) 10240.0)))
  ;; og:preserve-this
  (#when PC_PORT
    (let ((base-x (-> this particles 2 init-pos x)))
      (+! base-x (* (- 512.0 base-x) (- 1.0 (-> *pc-settings* aspect-ratio-reciprocal))))
      (set! (-> this particles 0 init-pos x) 435.0)
      (set! (-> this particles 1 init-pos x) 432.0)
      (set! (-> this particles 2 init-pos x) 435.0)
      (when (not (-> *pc-settings* use-vis?))
        (dotimes (i (-> this nb-of-particles))
          (set! (-> this particles i init-pos x)
                (+ base-x (* (-> *pc-settings* aspect-ratio-reciprocal) (- (-> this particles i init-pos x) base-x))))))))
  0
  (none))

(defun activate-hud ((parent process))
  "Create the six standard HUD processes under parent and clear the three optional HUD entries."
  (set! (-> *hud-parts* pickups) (process-spawn hud-pickups :init hud-init-by-other 0 :to parent))
  (set! (-> *hud-parts* money) (process-spawn hud-money :init hud-init-by-other 0 :to parent))
  (set! (-> *hud-parts* fuel-cell) (process-spawn hud-fuel-cell :init hud-init-by-other 0 :to parent))
  (set! (-> *hud-parts* health) (process-spawn hud-health :init hud-init-by-other 0 :to parent))
  (set! (-> *hud-parts* buzzers) (process-spawn hud-buzzers :init hud-init-by-other 0 :to parent))
  (set! (-> *hud-parts* power) (process-spawn hud-power :init hud-init-by-other 0 :to parent))
  (set! (-> *hud-parts* bike-speed) (the-as (pointer hud-bike-speed) #f))
  (set! (-> *hud-parts* bike-heat) (the-as (pointer hud-bike-heat) #f))
  (set! (-> *hud-parts* money-all) (the-as (pointer hud-money-all) #f))
  0
  (none))

(defun hide-hud ()
  "Ask every active HUD entry to hide."
  (when *target*
    (dotimes (i 9)
      (if (-> *hud-parts* parts i) (send-event (ppointer->process (-> *hud-parts* parts i)) 'hide))))
  0
  (none))

(defun hide-bottom-hud ()
  "Ask the buzzers, eco meter, bike speed, and bike heat HUD entries to hide."
  (when *target*
    (dotimes (i 4)
      (if (-> *hud-parts* parts (+ i 4)) (send-event (ppointer->process (-> *hud-parts* parts (+ i 4))) 'hide))))
  0
  (none))

(defun disable-hud ((keep-visible int))
  "Hide every HUD entry except keep-visible, then disable every other entry. The exception is
   also hidden when its displayed value is zero."
  (when *target*
    (dotimes (i 9)
      (when (-> *hud-parts* parts i)
        (if (or (!= (-> *hud-parts* parts i) keep-visible) (zero? (-> (the-as (pointer hud) (-> *hud-parts* parts i)) 0 value)))
          (send-event (ppointer->process (-> *hud-parts* parts i)) 'hide))
        (if (!= (-> *hud-parts* parts i) keep-visible) (send-event (ppointer->process (-> *hud-parts* parts i)) 'disable)))))
  0
  (none))

(defun enable-hud ()
  "Enable every active HUD entry."
  (when *target*
    (dotimes (i 9)
      (if (-> *hud-parts* parts i) (send-event (ppointer->process (-> *hud-parts* parts i)) 'enable))))
  0
  (none))

(defun hide-hud-quick ()
  "Immediately hide every active HUD entry."
  (when *target*
    (dotimes (i 9)
      (if (-> *hud-parts* parts i) (send-event (ppointer->process (-> *hud-parts* parts i)) 'hide-quick))))
  0
  (none))

(defun show-hud ()
  "Show every active HUD entry when gameplay is active and the progress screen is absent or hidden."
  (when (and *target* (or (not *progress-process*) (hidden? (-> *progress-process* 0))))
    (dotimes (i 9)
      (if (-> *hud-parts* parts i) (send-event (ppointer->process (-> *hud-parts* parts i)) 'show))))
  0
  (none))

(defun set-hud-aspect-ratio ((aspect-ratio symbol) (video-mode symbol))
  "Update every active HUD entry for the selected aspect ratio and video mode."
  (let ((widescreen? (= aspect-ratio 'aspect16x9))
        (pal? (= video-mode 'pal)))
    (when *target*
      (dotimes (i 9)
        (if (-> *hud-parts* parts i) (set-pos-and-scale (-> (the-as (pointer hud) (-> *hud-parts* parts i)) 0) widescreen? pal?)))))
  0
  (none))

(defun hud-hidden? ()
  "Return true when every HUD entry is absent or hidden."
  (local-vars (all-hidden? symbol))
  (cond
    (*target*
     (set! all-hidden? #t)
     (dotimes (i 9)
       (when (-> *hud-parts* parts i)
         (if (not (hidden? (-> (the-as (pointer hud) (-> *hud-parts* parts i)) 0))) (set! all-hidden? #f)))))
    (else (set! all-hidden? #t)))
  all-hidden?)

(defun bottom-hud-hidden? ()
  "Return true when the four lower HUD entries are absent or hidden."
  (local-vars (all-hidden? symbol))
  (cond
    (*target*
     (set! all-hidden? #t)
     (dotimes (i 4)
       (when (-> *hud-parts* parts (+ i 4))
         (if (not (hidden? (-> (the-as (pointer hud) (-> *hud-parts* parts (+ i 4))) 0))) (set! all-hidden? #f)))))
    (else (set! all-hidden? #t)))
  all-hidden?)

(defun activate-orb-all ((level-index int))
  "Create the all-orbs summary HUD for level-index if it is not already active."
  (if (not (-> *hud-parts* money-all))
    (set! (-> *hud-parts* money-all) (process-spawn hud-money-all :init hud-init-by-other level-index :to *target*)))
  0)

(defbehavior convert-to-hud-object process-drawable ((drawable process-drawable) (hud-element hud))
  "Move this drawable from its projected world position into HUD coordinates, scale it for
   hud-element, and send it toward that HUD as a collected object."
  (when hud-element
    (logclear! (-> drawable mask) (process-mask actor-pause))
    (let ((screen-position (new 'stack-no-clear 'vector)))
      (transform-point-vector-scale! screen-position (-> drawable root trans))
      (set! (-> drawable root trans x) (+ -2048.0 (-> screen-position x)))
      (set! (-> drawable root trans y) (* 2.0 (+ -2048.0 (-> screen-position y)))))
    (set! (-> drawable root trans z) 9999999.0)
    (set! (-> drawable root trans w) 1.0)
    (set-vector! (-> drawable root scale)
                 (get-icon-scale-x hud-element)
                 (get-icon-scale-y hud-element)
                 (get-icon-scale-x hud-element)
                 1.0)
    (set! (-> drawable draw dma-add-func) dma-add-process-drawable-hud)
    (go hud-collecting (process->handle hud-element)))
  0
  (none))

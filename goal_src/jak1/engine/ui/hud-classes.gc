(deftype hud-health (hud)
  ((scale float)))

(defun part-hud-health-01-func ((system sparticle-system) (particle sparticle-cpuinfo) (matrix-out matrix))
  "Set the first health cell's scale and fade it when Jak has less than one health. At exactly one
   health, flash its color to warn that the next hit is fatal."
  (let ((scale (-> *hud-parts* health 0 scale)))
    (set! (-> matrix-out vector 0 w) scale)
    (set! (-> matrix-out vector 1 w) scale))
  (cond
    ((and *target* (< (-> *target* fact health) 1.0)) (set! (-> matrix-out vector 2 w) 32.0))
    (else
     (let ((brightness 128.0))
       ;; low health flashing
       ;; og:preserve-this modified to support high fps
       (when (and *target* (= (-> *target* fact health) 1.0))
         (let* ((scaled-frame-counter (the int (* DISPLAY_FPS_RATIO (-> *display* integral-frame-counter))))
                (flash-frame (logand scaled-frame-counter 7)))
           (set! brightness
                 (if (not (logtest? scaled-frame-counter 8))
                   (+ 128.0 (* 18.142857 (the float flash-frame)))
                   (- 255.0 (* 18.142857 (the float flash-frame)))))))
       (set! (-> matrix-out vector 2 x) brightness)
       (set! (-> matrix-out vector 2 y) brightness)
       (set! (-> matrix-out vector 2 z) brightness))
     (set! (-> matrix-out vector 2 w) 128.0)))
  0
  (none))

(defun part-hud-health-02-func ((system sparticle-system) (particle sparticle-cpuinfo) (matrix-out matrix))
  "Set the second health cell's scale and fade it when Jak has less than two health."
  (let ((scale (-> *hud-parts* health 0 scale)))
    (set! (-> matrix-out vector 0 w) scale)
    (set! (-> matrix-out vector 1 w) scale))
  (if (and *target* (< (-> *target* fact health) 2.0))
    (set! (-> matrix-out vector 2 w) 32.0)
    (set! (-> matrix-out vector 2 w) 128.0))
  0
  (none))

(defun part-hud-health-03-func ((system sparticle-system) (particle sparticle-cpuinfo) (matrix-out matrix))
  "Set the third health cell's scale and fade it when Jak has less than three health."
  (let ((scale (-> *hud-parts* health 0 scale)))
    (set! (-> matrix-out vector 0 w) scale)
    (set! (-> matrix-out vector 1 w) scale))
  (if (and *target* (< (-> *target* fact health) 3.0))
    (set! (-> matrix-out vector 2 w) 32.0)
    (set! (-> matrix-out vector 2 w) 128.0))
  0
  (none))

(defmethod draw-hud ((this hud-health))
  "Draw the three health-cell particles."
  ((method-of-type hud draw-hud) this)
  0
  (none))

(defmethod hud-update ((this hud-health))
  "Tally the displayed health and the time of the most recent health pickup."
  (if *target* (tally-value this (the int (-> *target* fact health)) (the-as int (-> *target* fact health-pickup-time))))
  0
  (none))

(defmethod init-particles! ((this hud-health) (init-value int))
  "Create and position the three health-cell particles and allocate their sprite matrices."
  (local-vars (particle-index int))
  (when (< (-> this nb-of-particles) (-> this max-nb-of-particles))
    (set! particle-index (-> this nb-of-particles))
    (set! (-> this particles particle-index) (new 'static 'hud-particle))
    (set! (-> this particles particle-index part) (create-launch-control group-part-hud-health-1 this))
    (set! (-> this particles particle-index init-pos x) 61.0)
    (set! (-> this particles particle-index init-pos y) 55.0)
    (set! (-> this particles particle-index init-pos z) 5.0)
    (set! (-> this particles particle-index part matrix) -1)
    (+! (-> this nb-of-particles) 1))
  (when (< (-> this nb-of-particles) (-> this max-nb-of-particles))
    (set! particle-index (-> this nb-of-particles))
    (set! (-> this particles particle-index) (new 'static 'hud-particle))
    (set! (-> this particles particle-index part) (create-launch-control group-part-hud-health-2 this))
    (set! (-> this particles particle-index init-pos x) 98.0)
    (set! (-> this particles particle-index init-pos y) 55.0)
    (set! (-> this particles particle-index init-pos z) 5.0)
    (set! (-> this particles particle-index part matrix) -1)
    (+! (-> this nb-of-particles) 1))
  (when (< (-> this nb-of-particles) (-> this max-nb-of-particles))
    (set! particle-index (-> this nb-of-particles))
    (set! (-> this particles particle-index) (new 'static 'hud-particle))
    (set! (-> this particles particle-index part) (create-launch-control group-part-hud-health-3 this))
    (set! (-> this particles particle-index init-pos x) 70.0)
    (set! (-> this particles particle-index init-pos y) 76.0)
    (set! (-> this particles particle-index init-pos z) 5.0)
    (set! (-> this particles particle-index part matrix) -1)
    (+! (-> this nb-of-particles) 1))
  (dotimes (i (-> this nb-of-particles))
    (if (= (-> this particles i part matrix) -1) (set! (-> this particles i part matrix) (sprite-allocate-user-hvdf))))
  (set-pos-and-scale this (= (get-aspect-ratio) 'aspect16x9) (= (get-video-mode) 'pal))
  (set! (-> this x-sgn) -1)
  (set! (-> this y-sgn) -1)
  (set! (-> this friend) 0)
  0
  (none))

(defmethod set-pos-and-scale ((this hud-health) (widescreen? symbol) (pal? symbol))
  "Select the health-cell positions and scale for widescreen and PAL output. The PC path
   also adjusts horizontal placement when VIS is disabled."
  (cond
    (widescreen?
     (set! (-> this particles 0 init-pos x) 65.0)
     (set! (-> this particles 0 init-pos y) 55.0)
     (set! (-> this particles 1 init-pos x) 98.0)
     (set! (-> this particles 1 init-pos y) 55.0)
     (set! (-> this particles 2 init-pos x) 73.0)
     (set! (-> this particles 2 init-pos y) 80.0)
     (set! (-> this scale) 6144.0))
    (else
     (set! (-> this particles 0 init-pos x) 61.0)
     (set! (-> this particles 0 init-pos y) 55.0)
     (set! (-> this particles 1 init-pos x) 98.0)
     (set! (-> this particles 1 init-pos y) 55.0)
     (set! (-> this particles 2 init-pos x) 70.0)
     (set! (-> this particles 2 init-pos y) 76.0)
     (set! (-> this scale) 6963.2)
     (with-pc
       (when (not (-> *pc-settings* use-vis?))
         (let ((base-x (-> this particles 0 init-pos x)))
           (set! (-> this particles 1 init-pos x)
                 (+ base-x (* (-> *pc-settings* aspect-ratio-reciprocal) (- (-> this particles 1 init-pos x) base-x))))
           (set! (-> this particles 2 init-pos x)
                 (+ base-x (* (-> *pc-settings* aspect-ratio-reciprocal) (- (-> this particles 2 init-pos x) base-x)))))))))
  0
  (none))

(defpartgroup group-part-hud-orb-all
  :id 705
  :flags (screen-space)
  :bounds (static-bspherem 0 0 0 100)
  :parts ((sp-item 2964 :flags (one-shot))))

(defpart 2964
  :init-specs
  ((:texture (hud-egg effects))
   (:num 1.0)
   (:scale-x (meters 2.4))
   (:scale-y :copy scale-x)
   (:r 128.0)
   (:g 128.0)
   (:b 128.0)
   (:a 128.0)
   (:timer (seconds -0.005))
   (:flags (die-when-faded write-depth))))

(deftype hud-money-all (hud)
  ((x-scale     float)
   (y-scale     float)
   (y-pos       int32)
   (total-orbs  int32)
   (level-index int32)
   (start-time  time-frame)))

(defmethod draw-hud ((this hud-money-all))
  "Draw the all-orbs icon and count. When level-index is valid, also print that level's name."
  (let ((base-draw (method-of-type hud draw-hud))) (base-draw this))
  0
  (let ((line-y-offset 0))
    (when (>= (-> this level-index) 0)
      (let ((level-name-context (new 'stack
                                     'font-context
                                     *font-default-matrix*
                                     (+ (* (-> this x-sgn) (-> this offset)) -60 (-> this text-x))
                                     (+ (/ (* (+ (-> this text-y) (* (-> this y-sgn) (-> this offset)) (-> this y-offset))
                                              (the int (-> *video-parms* relative-y-scale)))
                                           2)
                                        -17)
                                     0.0
                                     (font-color red)
                                     (font-flags shadow kerning))))
        (set-width! level-name-context 228)
        (set-height! level-name-context 45)
        (set-scale! level-name-context 0.6)
        (set-flags! level-name-context (font-flags shadow kerning middle middle-vert large))
        (print-game-text (lookup-text! *common-text* (-> *level-task-data* (-> this level-index) level-name-id) #f)
                         level-name-context
                         #f
                         128
                         18))
      (set! line-y-offset 13))
    (let* ((text-x-offset 50)
           (buf (-> *display* frames (-> *display* on-screen) frame global-buf))
           (bucket-start (-> buf base)))
      (let ((draw-text draw-string-xy))
        (format (clear *temp-string*) "~D/~D" (-> this total-orbs) (-> this total-orbs))
        (draw-text *temp-string*
                   buf
                   (+ (-> this text-x) (* (-> this x-sgn) (-> this offset)) text-x-offset)
                   (+ (/ (* (+ (-> this text-y) (* (-> this y-sgn) (-> this offset)) (-> this y-offset))
                            (the int (-> *video-parms* relative-y-scale)))
                         2)
                      line-y-offset)
                   (font-color yellow)
                   (font-flags shadow kerning middle large)))
      (let ((bucket-end (-> buf base)))
        (let ((packet (the-as dma-packet (-> buf base))))
          (set! (-> packet dma) (new 'static 'dma-tag :id (dma-tag-id next)))
          (set! (-> packet vif0) (new 'static 'vif-tag))
          (set! (-> packet vif1) (new 'static 'vif-tag))
          (set! (-> buf base) (&+ (the-as pointer packet) 16)))
        (dma-bucket-insert-tag (-> *display* frames (-> *display* on-screen) frame bucket-group)
                               (bucket-id debug)
                               bucket-start
                               (the-as (pointer dma-tag) bucket-end)))))
  0
  (none))

(defmethod hud-update ((this hud-money-all))
  "Rotate the orb icon and keep the summary visible for five seconds, then let it deactivate
   after it finishes hiding."
  (when *target*
    (hide-bottom-hud)
    (when (!= *master-mode* 'pause)
      (when (and (!= (-> this icons 0) 0) (-> this icons 0 icon))
        (set! (-> this icons 0 scale-x) (-> this x-scale))
        (set! (-> this icons 0 scale-y) (-> this y-scale))
        (set! (-> this icons 0 icon-y) (* (-> this y-pos) (the int (-> *video-parms* relative-y-scale))))
        (let ((root (-> this icons 0 icon 0 root)))
          (set-yaw-angle-clear-roll-pitch! root (- (y-angle root) (* 182.04445 (* 4.0 (-> *display* time-adjust-ratio))))))))
    (if (>= (+ (current-time) (seconds -5)) (-> this start-time))
      (set! (-> this deactivate-when-hidden) #t)
      (tally-value this (the-as int (current-time)) 0)))
  0
  (none))

(defmethod init-particles! ((this hud-money-all) (level-index int))
  "Create the all-orbs icon and particle, total the level-task orb counts, select the requested
   level when appropriate, hide the lower HUD, and start the five-second display."
  (when (< (-> this nb-of-icons) 6)
    (let ((icon-index (-> this nb-of-icons)))
      (set! (-> this icons icon-index) (new 'static 'hud-icon))
      (let ((icon (manipy-spawn (new 'static 'vector :w 1.0) #f *money-sg* #f :to this)))
        (when icon
          (set! (-> (the-as process-drawable (-> icon 0)) draw dma-add-func) dma-add-process-drawable-hud)
          (set-vector! (-> (the-as process-drawable (-> icon 0)) root trans) 0.0 0.0 0.0 1.0)
          (set-vector! (-> (the-as process-drawable (-> icon 0)) root scale) 0.0095 -0.011 0.0095 1.0)
          (if #f (send-event (ppointer->process icon) 'trans-hook #f)))
        (set! (-> this icons icon-index icon) (the-as (pointer manipy) icon))
        (when icon
          (logior! (-> icon 0 mask) (process-mask pause))
          (logclear! (-> icon 0 mask) (process-mask menu progress))
          (set! (-> (the-as process-drawable (-> icon 0)) root trans z) 1024.0)
          (set! (-> this icons icon-index icon-x) 170)
          (set! (-> this icons icon-index icon-y) 0)
          (set! (-> this icons icon-index icon-z) 0)
          (set! (-> this icons icon-index scale-x) 0.0095)
          (set! (-> this icons icon-index scale-y) -0.011))))
    (+! (-> this nb-of-icons) 1))
  (when (< (-> this nb-of-particles) (-> this max-nb-of-particles))
    (let ((particle-index (-> this nb-of-particles)))
      (set! (-> this particles particle-index) (new 'static 'hud-particle))
      (set! (-> this particles particle-index part) (create-launch-control group-part-hud-orb-all this))
      (set! (-> this particles particle-index init-pos x) 172.0)
      (set! (-> this particles particle-index init-pos y) 330.0)
      (set! (-> this particles particle-index init-pos z) 2.0)
      (set! (-> this particles particle-index part matrix) -1))
    (+! (-> this nb-of-particles) 1))
  (set-pos-and-scale this (= (get-aspect-ratio) 'aspect16x9) (= (get-video-mode) 'pal))
  (dotimes (i (-> this nb-of-particles))
    (if (= (-> this particles i part matrix) -1) (set! (-> this particles i part matrix) (sprite-allocate-user-hvdf))))
  (set! (-> this text-x) 251)
  (set! (-> this text-y) 305)
  (set! (-> this x-sgn) 0)
  (set! (-> this y-sgn) 1)
  (hide-bottom-hud)
  (let ((collected-orb-count 0)
        (available-orb-count 0)
        (level-orb-count 0))
    (dotimes (i (length *level-task-data*))
      (let ((level-data (-> *level-task-data* i)))
        (when (!= level-data #f)
          (when (or (= *kernel-boot-message* 'play) (= (-> level-data level-name-id) (text-id misty-level-name)))
            (if (= i level-index) (set! level-orb-count (the-as int (-> *game-info* money-per-level i))))
            (+! available-orb-count (-> *game-info* money-per-level i))
            (+! collected-orb-count (-> (get-game-count i) money-count))))))
    (cond
      ((= available-orb-count collected-orb-count)
       (set! (-> this total-orbs) collected-orb-count)
       (set! (-> this total-orbs) collected-orb-count)
       (set! (-> this level-index) -1))
      ((begin
         (set! (-> this total-orbs) level-orb-count)
         (< level-index (length *level-task-data*)))
       (set! (-> this level-index) level-index))
      (else (set! (-> this level-index) -1))))
  (set-time! (-> this start-time))
  (sound-play "get-all-orbs")
  0
  (none))

(defmethod set-pos-and-scale ((this hud-money-all) (widescreen? symbol) (pal? symbol))
  "Select the all-orbs icon position and nonuniform scale for widescreen and PAL output."
  (cond
    (widescreen?
     (set! (-> this x-scale) 0.01845)
     (set! (-> this y-scale) -0.02175)
     (set! (-> this y-pos) (if pal? 374 373)))
    (else (set! (-> this x-scale) 0.013499999) (set! (-> this y-scale) -0.01575) (set! (-> this y-pos) 361)))
  (when pal?
    (set! (-> this x-scale) (* 1.02 (-> this x-scale)))
    (set! (-> this y-scale) (* 1.2 (-> this y-scale)))
    (set! (-> this y-pos) (the int (* 1.21 (the float (-> this y-pos))))))
  0
  (none))


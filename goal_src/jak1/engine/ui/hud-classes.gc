(deftype hud-fuel-cell (hud)
  ((scale-starburst-3-x float)
   (scale-starburst-3-y float)
   (scale-starburst-4-x float)
   (scale-starburst-4-y float)
   (scale-icon          float)
   (scale-center        float)
   (icon-pos-y          int32)))

(defmethod draw-hud ((this hud-fuel-cell))
  "Draw the power-cell HUD and its count. The PC collectable view can show the original
   game-wide count, game-wide collected and available totals, or current-level task totals."
  (let ((base-draw (method-of-type hud draw-hud))) (base-draw this))
  (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug))
    (let* ((string-x (+ (-> this text-x) (* (-> this x-sgn) (-> this offset))))
           (string-y (/ (* (+ (-> this text-y) (* (-> this y-sgn) (-> this offset)) (-> this y-offset))
                           (the int (-> *video-parms* relative-y-scale)))
                        2)))
      (case *hud-collectable-view*
        (((hud-collectable-view game-totals))
         ;; show cells collected/total across entire game
         (draw-string-xy-scaled (string-format "~D~%/~D"
                                               (the int (-> *game-info* fuel))
                                               101 ;;(-> (the progress (-> *progress-process* 0)) total-nb-of-power-cells)
                                               )
                                buf
                                string-x
                                (- string-y 5)
                                (font-color yellow)
                                (font-flags shadow kerning large)
                                0.8))
        (((hud-collectable-view level-totals))
         (let ((level-index (-> *level-task-data-remap* (+ (-> *target* current-level info index) -1)))
               (completed-task-count 0))
           ;; determine number of cells collected in this level
           (dotimes (i (-> *level-task-data* level-index nb-of-tasks))
             (if (= (get-task-status (-> *level-task-data* level-index task-info i task-id)) (task-status invalid))
               (+! completed-task-count 1)))
           ;; show cells/total collected this level
           (draw-string-xy-scaled (string-format "~D~%/~D" completed-task-count (-> *level-task-data* level-index nb-of-tasks))
                                  buf
                                  string-x
                                  (- string-y 5)
                                  (font-color yellow)
                                  (font-flags shadow kerning large)
                                  0.8)))
        (((hud-collectable-view original))
         ;; show original (cells collected across entire game)
         (draw-string-xy (string-format "~D" (-> this value))
                         buf
                         string-x
                         string-y
                         (font-color yellow)
                         (font-flags shadow kerning large))))))
  0
  (none))

(defun fuel-cell-hud-orbit-callback ((system sparticle-system) (particle sparticle-cpuinfo) (matrix-out matrix))
  "Place an orbit particle at the model joint selected by its user value, relative to the
   power-cell center joint."
  (let ((hud-element (-> particle key proc))
        (joint-index (the int (-> particle user-float)))
        (joint-position (new 'stack-no-clear 'vector)))
    (let ((center-position (new 'stack-no-clear 'vector)))
      (vector<-cspace! joint-position (-> (the-as hud-fuel-cell hud-element) icons 0 icon 0 node-list data joint-index))
      (vector<-cspace! center-position (-> (the-as hud-fuel-cell hud-element) icons 0 icon 0 node-list data 3))
      (vector-! joint-position joint-position center-position))
    (set! (-> matrix-out vector 0 x) (* 60.0 (-> joint-position x)))
    (set! (-> matrix-out vector 0 y) (* 60.0 (-> joint-position y)))
    (set! (-> matrix-out vector 0 z) (* 1024.0 (-> joint-position z))))
  0
  (none))

(defun fuel-cell-hud-starburst-3-callback ((system sparticle-system) (particle sparticle-cpuinfo) (matrix-out matrix))
  "Apply the third power-cell starburst's display-dependent X and Y scales."
  (set! (-> matrix-out vector 0 w) (-> *hud-parts* fuel-cell 0 scale-starburst-3-x))
  (set! (-> matrix-out vector 1 w) (-> *hud-parts* fuel-cell 0 scale-starburst-3-y))
  0
  (none))

(defun fuel-cell-hud-starburst-4-callback ((system sparticle-system) (particle sparticle-cpuinfo) (matrix-out matrix))
  "Apply the fourth power-cell starburst's display-dependent X and Y scales."
  (set! (-> matrix-out vector 0 w) (-> *hud-parts* fuel-cell 0 scale-starburst-4-x))
  (set! (-> matrix-out vector 1 w) (-> *hud-parts* fuel-cell 0 scale-starburst-4-y))
  0
  (none))

(defun fuel-cell-hud-center-callback ((system sparticle-system) (particle sparticle-cpuinfo) (matrix-out matrix))
  "Apply the display-dependent scale to the power-cell model and its center particle."
  (let ((icon-scale (-> *hud-parts* fuel-cell 0 scale-icon))
        (center-scale (-> *hud-parts* fuel-cell 0 scale-center)))
    (set-vector! (-> *hud-parts* fuel-cell 0 icons 0 icon 0 root scale) icon-scale icon-scale icon-scale 1.0)
    (set! (-> matrix-out vector 0 w) center-scale)
    (set! (-> matrix-out vector 1 w) center-scale))
  0
  (none))

(defmethod hud-update ((this hud-fuel-cell))
  "Rotate the power-cell model, tally Jak's fuel count, and anchor the surrounding particles
   to the model's center joint."
  (when *target*
    (when (!= *master-mode* 'pause)
      (let ((root (-> this icons 0 icon 0 root)))
        (set-yaw-angle-clear-roll-pitch! root (+ (y-angle root) (* 182.04445 (/ (-> *display* time-adjust-ratio) 2))))))
    (set! (-> this icons 0 icon-y) (-> this icon-pos-y))
    (tally-value this (the int (+ 0.5 (-> *target* game fuel))) 0)
    (let ((center-position (new 'stack-no-clear 'vector)))
      (vector<-cspace! center-position (-> this icons 0 icon 0 node-list data 3))
      (set! (-> this particles 0 pos x) (-> center-position x))
      (set! (-> this particles 0 pos y) (/ (-> center-position y) 2))
      (set! (-> this particles 0 pos z) (+ 2.0 (* 0.05 (+ -2048.0 (-> center-position z)))))))
  0
  (none))

(defmethod init-particles! ((this hud-fuel-cell) (init-value int))
  "Create the power-cell model and surrounding particle group, allocate its sprite matrix,
   and turn the model to face the camera."
  (when (< (-> this nb-of-particles) (-> this max-nb-of-particles))
    (let ((particle-index (-> this nb-of-particles)))
      (set! (-> this particles particle-index) (new 'static 'hud-particle))
      (set! (-> this particles particle-index part) (create-launch-control group-part-hud-power-cell-whole this))
      (set! (-> this particles particle-index init-pos x) 256.0)
      (set! (-> this particles particle-index init-pos y) 224.0)
      (set! (-> this particles particle-index init-pos z) 1.0)
      (set! (-> this particles particle-index part matrix) -1))
    (+! (-> this nb-of-particles) 1))
  (dotimes (i (-> this nb-of-particles))
    (if (= (-> this particles i part matrix) -1) (set! (-> this particles i part matrix) (sprite-allocate-user-hvdf))))
  (when (< (-> this nb-of-icons) 6)
    (let ((icon-index (-> this nb-of-icons)))
      (set! (-> this icons icon-index) (new 'static 'hud-icon))
      (let ((icon (manipy-spawn (new 'static 'vector :w 1.0) #f *fuelcell-naked-sg* #f :to this)))
        (when icon
          (set! (-> (the-as process-drawable (-> icon 0)) draw dma-add-func) dma-add-process-drawable-hud)
          (set-vector! (-> (the-as process-drawable (-> icon 0)) root trans) 0.0 0.0 0.0 1.0)
          (set-vector! (-> (the-as process-drawable (-> icon 0)) root scale) 0.009 0.009 0.009 1.0)
          (if #f (send-event (ppointer->process icon) 'trans-hook #f)))
        (set! (-> this icons icon-index icon) (the-as (pointer manipy) icon))
        (when icon
          (logior! (-> icon 0 mask) (process-mask pause))
          (logclear! (-> icon 0 mask) (process-mask menu progress))
          (set! (-> (the-as process-drawable (-> icon 0)) root trans z) 2048.0)
          (set! (-> this icons icon-index icon-x) 256)
          (set! (-> this icons icon-index icon-y) 62)
          (set! (-> this icons icon-index icon-z) 0)
          (set! (-> this icons icon-index scale-x) 0.009)
          (set! (-> this icons icon-index scale-y) 0.009))))
    (+! (-> this nb-of-icons) 1))
  (set! (-> this text-x) 276)
  (set! (-> this text-y) 45)
  (set! (-> this x-sgn) 0)
  (set! (-> this y-sgn) -1)
  (set! (-> this increment-on-event) #t)
  (set! (-> this skip-particle) -2)
  (set-pos-and-scale this (= (get-aspect-ratio) 'aspect16x9) (= (get-video-mode) 'pal))
  (let ((turn-around (new 'stack-no-clear 'quaternion)))
    (quaternion-axis-angle! turn-around 0.0 1.0 0.0 16384.0)
    (quaternion*! (-> this icons 0 icon 0 root quat) turn-around (-> this icons 0 icon 0 root quat)))
  0
  (none))

(defmethod set-pos-and-scale ((this hud-fuel-cell) (widescreen? symbol) (pal? symbol))
  "Select the power-cell model, center, and starburst scales for widescreen and PAL output."
  (cond
    (widescreen?
     (set! (-> this scale-starburst-3-x) 10240.0)
     (set! (-> this scale-starburst-3-y) 9420.8)
     (set! (-> this scale-starburst-4-x) 9420.8)
     (set! (-> this scale-starburst-4-y) 8192.0)
     (set! (-> this scale-icon) 0.007)
     (set! (-> this scale-center) 6144.0)
     (set! (-> this icon-pos-y) 62))
    (else
     (set! (-> this scale-starburst-3-x) 12288.0)
     (set! (-> this scale-starburst-3-y) 10240.0)
     (set! (-> this scale-starburst-4-x) 12288.0)
     (set! (-> this scale-starburst-4-y) 10240.0)
     (set! (-> this scale-icon) 0.009)
     (set! (-> this scale-center) 7372.8)
     (set! (-> this icon-pos-y) 62)))
  (if pal? (set! (-> this icon-pos-y) (the int (* (the float (-> this icon-pos-y)) (if widescreen? 1.1 1.14)))))
  0
  (none))


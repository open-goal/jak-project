(deftype hud-money (hud)
  ((x-scale float)
   (y-scale float)
   (y-pos   int32)))

;; og:preserve-this
(define-extern *game-counts* game-count-info)

(defmethod draw-hud ((this hud-money))
  "Draw the orb HUD and its count. The PC collectable view can show the original unspent
   count, the game-wide collected and available totals, or the current level's totals."
  (let ((base-draw (method-of-type hud draw-hud))) (base-draw this))
  (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug))
    (let* ((string-x (+ (-> this text-x) (* (-> this x-sgn) (-> this offset))))
           (string-y (/ (* (+ (-> this text-y) (* (-> this y-sgn) (-> this offset)) (-> this y-offset))
                           (the int (-> *video-parms* relative-y-scale)))
                        2)))
      (case *hud-collectable-view*
        (((hud-collectable-view game-totals))
         ;; show orbs collected/total across entire game
         (draw-string-xy-scaled (string-format "~D~%/~D"
                                               (the int (-> *game-info* money-total))
                                               2000 ;;(-> (the progress (-> *progress-process* 0)) total-nb-of-orbs)
                                               )
                                buf
                                string-x
                                (- string-y 5)
                                (font-color yellow)
                                (font-flags shadow kerning large)
                                0.8))
        (((hud-collectable-view level-totals))
         (let ((level-index (-> *level-task-data-remap* (+ (-> *target* current-level info index) -1))))
           ;; show orbs collected/total this level
           (draw-string-xy-scaled (string-format "~D~%/~D" (-> *game-info* money-per-level level-index) (-> *game-counts* data level-index money-count))
                                  buf
                                  string-x
                                  (- string-y 5)
                                  (font-color yellow)
                                  (font-flags shadow kerning large)
                                  0.8)))
        (((hud-collectable-view original))
         ;; show original (total collected, unspent orbs)
         (draw-string-xy (string-format "~D" (-> this value))
                         buf
                         string-x
                         string-y
                         (font-color yellow)
                         (font-flags shadow kerning large))))))
  0
  (none))

(defmethod hud-update ((this hud-money))
  "Rotate the orb icon while unpaused and tally the displayed value toward Jak's money count."
  (when *target*
    (when (!= *master-mode* 'pause)
      (when (and (!= (-> this icons 0) 0) (-> this icons 0 icon))
        (set! (-> this icons 0 scale-x) (-> this x-scale))
        (set! (-> this icons 0 scale-y) (-> this y-scale))
        (set! (-> this icons 0 icon-y) (* (-> this y-pos) (the int (-> *video-parms* relative-y-scale))))
        (let ((root (-> this icons 0 icon 0 root)))
          (set-yaw-angle-clear-roll-pitch! root (- (y-angle root) (* 182.04445 (* 4.0 (-> *display* time-adjust-ratio))))))))
    (tally-value this (the int (+ 0.5 (-> *target* game money))) 0))
  0
  (none))

(defmethod init-particles! ((this hud-money) (init-value int))
  "Create the orb model and particle, allocate its sprite matrix, and position its count text."
  (when (< (-> this nb-of-icons) 6)
    (let ((icon-index (-> this nb-of-icons)))
      (set! (-> this icons icon-index) (new 'static 'hud-icon))
      (let ((icon (manipy-spawn (new 'static 'vector :w 1.0) #f *money-sg* #f :to this)))
        (when icon
          (set! (-> (the-as process-drawable (-> icon 0)) draw dma-add-func) dma-add-process-drawable-hud)
          (set-vector! (-> (the-as process-drawable (-> icon 0)) root trans) 0.0 0.0 0.0 1.0)
          (set-vector! (-> (the-as process-drawable (-> icon 0)) root scale) 0.0095 -0.011 0.0095 1.0)
          (if #f (send-event (ppointer->process icon) 'trans-hook #f)))
        (set! (-> this icons icon-index icon) (the-as (pointer manipy) icon))
        (when icon
          (logior! (-> icon 0 mask) (process-mask pause))
          (logclear! (-> icon 0 mask) (process-mask menu progress))
          (set! (-> (the-as process-drawable (-> icon 0)) root trans z) 1024.0)
          (set! (-> this icons icon-index icon-x) 399)
          (set! (-> this icons icon-index icon-y) 79)
          (set! (-> this icons icon-index icon-z) 0)
          (set! (-> this icons icon-index scale-x) 0.0095)
          (set! (-> this icons icon-index scale-y) -0.011))))
    (+! (-> this nb-of-icons) 1))
  (when (< (-> this nb-of-particles) (-> this max-nb-of-particles))
    (let ((particle-index (-> this nb-of-particles)))
      (set! (-> this particles particle-index) (new 'static 'hud-particle))
      (set! (-> this particles particle-index part) (create-launch-control group-part-hud-orb this))
      (set! (-> this particles particle-index init-pos x) 400.0)
      (set! (-> this particles particle-index init-pos y) 58.0)
      (set! (-> this particles particle-index init-pos z) 2.0)
      (set! (-> this particles particle-index part matrix) -1))
    (+! (-> this nb-of-particles) 1))
  (set-pos-and-scale this (= (get-aspect-ratio) 'aspect16x9) (= (get-video-mode) 'pal))
  (dotimes (i (-> this nb-of-particles))
    (if (= (-> this particles i part matrix) -1) (set! (-> this particles i part matrix) (sprite-allocate-user-hvdf))))
  (set! (-> this text-x) 420)
  (set! (-> this text-y) 45)
  (set! (-> this x-sgn) 1)
  (set! (-> this y-sgn) -1)
  (set! (-> this increment-on-event) #t)
  0
  (none))

(defmethod set-pos-and-scale ((this hud-money) (widescreen? symbol) (pal? symbol))
  "Select the orb icon position and nonuniform scale for widescreen and PAL output."
  (cond
    (widescreen? (set! (-> this x-scale) 0.0123) (set! (-> this y-scale) -0.0145) (set! (-> this y-pos) 86))
    (else (set! (-> this x-scale) 0.0095) (set! (-> this y-scale) -0.011) (set! (-> this y-pos) 79)))
  (when pal?
    (set! (-> this x-scale) (* 1.1 (-> this x-scale)))
    (set! (-> this y-scale) (* 1.2 (-> this y-scale)))
    (set! (-> this y-pos) (the int (* (the float (-> this y-pos)) (if widescreen? 0.95 0.9)))))
  0
  (none))

(defmethod get-icon-pos-x ((this hud-money))
  "Return the orb icon's screen X position for collectable flight."
  (-> this icons 0 icon-x))

(defmethod get-icon-pos-y ((this hud-money))
  "Return the orb icon's screen Y position for collectable flight."
  (-> this icons 0 icon-y))

(defmethod get-icon-scale-x ((this hud-money))
  "Return the orb collectable's destination X scale."
  0.01)

(defmethod get-icon-scale-y ((this hud-money))
  "Return the orb collectable's destination Y scale."
  -0.011)


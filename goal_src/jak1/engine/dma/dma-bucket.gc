;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/dma/dma-buffer.gc")

;; DMA buckets let renderers build chains in any order while the final transfer visits them in a
;; fixed draw order. Each 16-byte header owns no payload. A NEXT tag transfers QWC quadwords stored
;; immediately after itself, then fetches the following DMA tag from the address in ADDR.
;; A NEXT with QWC zero transfers nothing and acts only as a pointer to the DMA tag in ADDR.
;;
;; last points to a QWC-zero NEXT tag whose ADDR has not yet been linked onward. An empty bucket uses
;; its header NEXT tag as this tail. Every added chain must also end in a QWC-zero NEXT tag. Insertion
;; patches the old tail's ADDR to the first tag in the new chain, then records the new chain's
;; terminal NEXT tag as the bucket's new tail.
;;
;; Empty headers are reserved consecutively in the calculation buffer. Renderers append chains to
;; individual buckets, then dma-buffer-patch-buckets splices every tail to the next header. The
;; address just after the last header is the continuation following the bucket sequence.

(defun dma-buffer-add-buckets ((buffer dma-buffer) (count int))
  "Reserve and initialize count consecutive DMA bucket headers at the buffer's write cursor."
  (let* ((first-bucket (the-as dma-bucket (-> buffer base)))
         (bucket first-bucket))
    (dotimes (i count)
      ;; An empty bucket's tail is its own header, so inserting its first chain patches this tag.
      (set! (-> bucket tag) (new 'static 'dma-tag :id (dma-tag-id next) :addr (the-as int (&+ (the-as pointer bucket) 16))))
      (set! (-> bucket last) (the-as (pointer dma-tag) bucket))
      (&+! bucket 16))
    (set! (-> buffer base) (the-as pointer bucket))
    (the (inline-array dma-bucket) first-bucket)))

(defun dma-buffer-patch-buckets ((buckets (inline-array dma-bucket)) (count int))
  "Splice each bucket tail to the following bucket header and return the address just after the
   patched headers."
  (when (nonzero? buckets)
    (dotimes (i count)
      (set! (-> buckets 0 last 0 addr) (the-as int (the-as pointer (-> buckets 1))))
      (set! (-> buckets 0 last) (the-as (pointer dma-tag) 0))
      (set! buckets (&-> buckets 1))))
  buckets)

(defun dma-bucket-insert-tag ((buckets (inline-array dma-bucket)) (bucket-index bucket-id) (tag-start pointer) (tag-end (pointer dma-tag)))
  "Append a DMA chain to one bucket by patching its previous tail and recording the new tail."
  (let ((bucket (-> buckets bucket-index)))
    ;; next aliases the ADDR field in the previous QWC-zero NEXT tag.
    (set! (-> (the-as dma-bucket (-> bucket last)) next) (the-as uint tag-start))
    (set! (-> bucket last) tag-end))
  tag-start)

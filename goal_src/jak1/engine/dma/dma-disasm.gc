;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/dma/dma-buffer.gc")

;; Debug decoder for DMA source chains and their embedded VIF command streams.

;; DECOMP BEGINS

;; this file is debug only
(declare-file (debug))

(deftype vif-disasm-element (structure)
  ((mask    uint32)
   (tag     vif-cmd-32)
   (val     uint32)
   (print   uint32)
   (string1 string)
   (string2 string)))

;; Command masks ignore IRQ and, for UNPACK entries, the masked-write bit. val is the payload-byte
;; stride this decoder assumes for one UNPACK element, and print selects the command-specific
;; formatting rule.
(define *vif-disasm-table*
  (new 'static
       'boxed-array
       :type
       vif-disasm-element
       :length 34
       (new 'static 'vif-disasm-element :mask #x7f :string1 "nop")
       (new 'static 'vif-disasm-element :mask #x7f :tag (vif-cmd-32 stcycl) :print #x2 :string1 "stcycl")
       (new 'static 'vif-disasm-element :mask #x7f :tag (vif-cmd-32 offset) :print #x1 :string1 "offset" :string2 "offset")
       (new 'static 'vif-disasm-element :mask #x7f :tag (vif-cmd-32 base) :print #x1 :string1 "base" :string2 "base")
       (new 'static 'vif-disasm-element :mask #x7f :tag (vif-cmd-32 itop) :print #x1 :string1 "itop" :string2 "addr")
       (new 'static 'vif-disasm-element :mask #x7f :tag (vif-cmd-32 stmod) :print #x1 :string1 "stmod" :string2 "mode")
       (new 'static 'vif-disasm-element :mask #x7f :tag (vif-cmd-32 mskpath3) :print #x1 :string1 "mskpath3" :string2 "mask")
       (new 'static 'vif-disasm-element :mask #x7f :tag (vif-cmd-32 mark) :print #x1 :string1 "mark" :string2 "mark")
       (new 'static 'vif-disasm-element :mask #x7f :tag (vif-cmd-32 flushe) :string1 "flushe")
       (new 'static 'vif-disasm-element :mask #x7f :tag (vif-cmd-32 flush) :string1 "flush")
       (new 'static 'vif-disasm-element :mask #x7f :tag (vif-cmd-32 flusha) :string1 "flusha")
       (new 'static 'vif-disasm-element :mask #x7f :tag (vif-cmd-32 mscal) :print #x1 :string1 "mscal" :string2 "addr")
       (new 'static 'vif-disasm-element :mask #x7f :tag (vif-cmd-32 mscnt) :string1 "mscnt")
       (new 'static 'vif-disasm-element :mask #x7f :tag (vif-cmd-32 mscalf) :print #x1 :string1 "mscalf" :string2 "addr")
       (new 'static 'vif-disasm-element :mask #x7f :tag (vif-cmd-32 stmask) :print #x3 :string1 "stmask" :string2 "mask")
       (new 'static 'vif-disasm-element :mask #x7f :tag (vif-cmd-32 strow) :print #x4 :string1 "strow" :string2 "row")
       (new 'static 'vif-disasm-element :mask #x7f :tag (vif-cmd-32 stcol) :print #x4 :string1 "stcol" :string2 "col")
       (new 'static 'vif-disasm-element :mask #x7f :tag (vif-cmd-32 mpg) :print #x5 :string1 "mpg")
       (new 'static 'vif-disasm-element :mask #x7f :tag (vif-cmd-32 direct) :print #x6 :string1 "direct")
       (new 'static 'vif-disasm-element :mask #x7f :tag (vif-cmd-32 directhl) :print #x6 :string1 "directhl")
       (new 'static 'vif-disasm-element :mask #x6f :tag (vif-cmd-32 unpack-s-32) :val #x10 :print #x7 :string1 "unpack-s-32")
       (new 'static 'vif-disasm-element :mask #x6f :tag (vif-cmd-32 unpack-s-16) :val #x8 :print #x7 :string1 "unpack-s-16")
       (new 'static 'vif-disasm-element :mask #x6f :tag (vif-cmd-32 unpack-s-8) :val #x4 :print #x7 :string1 "unpack-s-8")
       (new 'static 'vif-disasm-element :mask #x6f :tag (vif-cmd-32 unpack-v2-32) :val #x8 :print #x7 :string1 "unpack-v2-32")
       (new 'static 'vif-disasm-element :mask #x6f :tag (vif-cmd-32 unpack-v2-16) :val #x4 :print #x7 :string1 "unpack-v2-16")
       (new 'static 'vif-disasm-element :mask #x6f :tag (vif-cmd-32 unpack-v2-8) :val #x2 :print #x7 :string1 "unpack-v2-8")
       (new 'static 'vif-disasm-element :mask #x6f :tag (vif-cmd-32 unpack-v3-32) :val #xc :print #x7 :string1 "unpack-v3-32")
       (new 'static 'vif-disasm-element :mask #x6f :tag (vif-cmd-32 unpack-v3-16) :val #x6 :print #x7 :string1 "unpack-v3-16")
       (new 'static 'vif-disasm-element :mask #x6f :tag (vif-cmd-32 unpack-v3-8) :val #x3 :print #x7 :string1 "unpack-v3-8")
       (new 'static 'vif-disasm-element :mask #x6f :tag (vif-cmd-32 unpack-v4-32) :val #x10 :print #x7 :string1 "unpack-v4-32")
       (new 'static 'vif-disasm-element :mask #x6f :tag (vif-cmd-32 unpack-v4-16) :val #x8 :print #x7 :string1 "unpack-v4-16")
       (new 'static 'vif-disasm-element :mask #x6f :tag (vif-cmd-32 unpack-v4-8) :val #x4 :print #x7 :string1 "unpack-v4-8")
       (new 'static 'vif-disasm-element :mask #x6f :tag (vif-cmd-32 unpack-v4-5) :val #x2 :print #x7 :string1 "unpack-v4-5")
       (new 'static 'vif-disasm-element :print #x8)))

(defun disasm-vif-details ((stream symbol) (packet (pointer uint8)) (command vif-cmd) (element-count int))
  "Print element data for the supported VIF UNPACK formats."
  (let ((element-count-2 element-count))
    (cond
      ((= command (vif-cmd unpack-v4-8))
       (let ((payload (&-> packet 4)))
         (dotimes (i element-count-2)
           (format stream
                   "  #x~X:    #x~2X #x~2X #x~2X #x~2X~%"
                   (+ (+ (* i 4) 4) (the-as int packet))
                   (-> payload (* i 4))
                   (-> payload (+ (* i 4) 1))
                   (-> payload (+ (* i 4) 2))
                   (-> payload (+ (* i 4) 3))))))
      ((= command (vif-cmd unpack-s-8))
       (let ((payload (&-> packet 4)))
         (dotimes (i element-count-2)
           ;; FIXME: this diagnostic passes element-count instead of the loaded byte. The two
           ;; three-byte-stride reads are also discarded.
           (format stream "  #x~X:    #x~2x~%" (+ (+ i 4) (the-as int packet)) element-count)
           (-> payload (* 3 i))
           (-> payload (+ (* 3 i) 1)))))
      ((= command (vif-cmd unpack-v4-32))
       (let ((payload (the-as (pointer uint32) (&-> packet 4))))
         (dotimes (i element-count-2)
           (format stream
                   "  #x~X:    #x~8x #x~8x #x~8x #x~8x~%"
                   (+ (+ (* i 16) 4) (the-as int packet))
                   (-> payload (* i 4))
                   (-> payload (+ (* i 4) 1))
                   (-> payload (+ (* i 4) 2))
                   (-> payload (+ (* i 4) 3))))))
      ((= command (vif-cmd unpack-v4-16))
       (let ((payload (the-as (pointer uint16) (&-> packet 4))))
         (dotimes (i element-count-2)
           (format stream
                   "  #x~X:    #x~4x #x~4x #x~4x #x~4x~%"
                   (+ (+ (* i 8) 4) (the-as int packet))
                   (-> payload (* i 4))
                   (-> payload (+ (* i 4) 1))
                   (-> payload (+ (* i 4) 2))
                   (-> payload (+ (* i 4) 3))))))
      ((= command (vif-cmd unpack-v3-32))
       (let ((payload (the-as (pointer uint32) (&-> packet 4))))
         (dotimes (i element-count-2)
           (format stream
                   "  #x~X:    #x~8x #x~8x #x~8x~%"
                   (+ (+ (* 12 i) 4) (the-as int packet))
                   (-> (&+ payload (* 12 i)) 0)
                   (-> payload (+ (* 3 i) 1))
                   (-> payload (+ (* 3 i) 2))))))
      ((= command (vif-cmd unpack-v3-16))
       (let ((payload (the-as (pointer uint16) (&-> packet 4))))
         (dotimes (i element-count-2)
           (format stream
                   "  #x~X:    #x~4x #x~4x #x~4x~%"
                   (+ (+ (* 6 i) 4) (the-as int packet))
                   (-> (&+ payload (* 6 i)) 0)
                   (-> payload (+ (* 3 i) 1))
                   (-> payload (+ (* 3 i) 2))))))
      ((= command (vif-cmd unpack-v2-16))
       (let ((payload (the-as (pointer uint16) (&-> packet 4))))
         (dotimes (i element-count-2)
           ;; FIXME: the displayed address advances four bytes per element, but both loads advance
           ;; six. This looks like the v3-16 indexing was copied here unchanged.
           (format stream
                   "  #x~X:    #x~4x #x~4x~%"
                   (+ (+ (* i 4) 4) (the-as int packet))
                   (-> (&+ payload (* 6 i)) 0)
                   (-> payload (+ (* 3 i) 1))))))
      (else (format stream "  #x~X:    Data format #b~b not yet supported, add it for yourself!~%" (&-> packet 4) command))))
  #f)

(defun disasm-vif-tag ((packet (pointer vif-tag)) (word-count int) (stream symbol) (details? symbol))
  "Decode VIF commands from word-count words, optionally print supported payload formats, and return
   the number of bytes consumed past the requested boundary."
  (local-vars (cmd vif-cmd) (payload (pointer vif-tag)) (i int))
  (let ((bytes-consumed 0))
    (while (< bytes-consumed (* word-count 4))
      (let ((packet-bytes 4))
        (let ((tag (-> packet 0)))
          (format stream "  #x~X:" packet)
          (dotimes (template-index (-> *vif-disasm-table* length))
            (set! cmd (-> tag cmd))
            (when (= (logand cmd (-> *vif-disasm-table* template-index mask)) (-> *vif-disasm-table* template-index tag))
              (let ((print-kind (-> *vif-disasm-table* template-index print)))
                (cond
                  ((zero? print-kind) (format stream "  (~s :irq ~D)~%" (-> *vif-disasm-table* template-index string1) (-> tag irq)))
                  ((= print-kind 1)
                   (format stream
                           "  (~s :irq ~D :~s #x~X)~%"
                           (-> *vif-disasm-table* template-index string1)
                           (-> tag irq)
                           (-> *vif-disasm-table* template-index string2)
                           (-> tag imm)))
                  ((= print-kind 2)
                   (let ((stcycl-imm (the-as vif-stcycl-imm (-> tag imm))))
                     (format stream
                             "  (~s :irq ~D :wl ~D :cl ~D)~%"
                             (-> *vif-disasm-table* template-index string1)
                             (-> tag irq)
                             (-> stcycl-imm wl)
                             (-> stcycl-imm cl))))
                  ((= print-kind 3)
                   (set! packet-bytes 8)
                   (format stream
                           "  (~s :irq ~D :~s #x~X)~%"
                           (-> *vif-disasm-table* template-index string1)
                           (-> tag irq)
                           (-> *vif-disasm-table* template-index string2)
                           (-> packet 1)))
                  ((= print-kind 4)
                   (set! packet-bytes 20)
                   (format stream
                           "  (~s :irq ~D :~s "
                           (-> *vif-disasm-table* template-index string1)
                           (-> tag irq)
                           (-> *vif-disasm-table* template-index string2))
                   (format stream "#x~X #x~X #x~X #x~X)~%" (-> packet 1) (-> packet 2) (-> packet 3) (-> packet 4)))
                  ((= print-kind 5)
                   (format stream
                           "  (~s :irq ~D :instructions #x~D :addr #x~X)~%"
                           (-> *vif-disasm-table* template-index string1)
                           (-> tag irq)
                           (-> tag num)
                           (-> tag imm)))
                  ((= print-kind 6)
                   ;; FIXME: IMM is tested as a GOAL truth value, so normal numeric values take the
                   ;; #x100000 fallback. This likely meant to test the zero encoding explicitly.
                   (if (-> tag imm) (set! packet-bytes #x100000) (set! packet-bytes (the-as int (* (-> tag imm) 16))))
                   (format stream "  (~s :irq ~D :qwc #x~D)~%" (-> *vif-disasm-table* template-index string1) (-> tag irq) (-> tag imm))
                   (set! payload (&-> packet 1))
                   (set! i 0)
                   (while (< i (the-as int (-> tag imm)))
                     (format stream
                             "  #x~X:    #x~8x #x~8x #x~8x #x~8x~%"
                             (+ (+ (* i 16) 4) (the-as int packet))
                             (-> payload (* i 4))
                             (-> payload (+ (* i 4) 1))
                             (-> payload (+ (* i 4) 2))
                             (-> payload (+ (* i 4) 3)))
                     (+! i 1))
                   #f)
                  ((= print-kind 7)
                   (set! packet-bytes (the-as int (+ (logand -4 (+ (* (-> *vif-disasm-table* template-index val) (-> tag num)) 3)) 4)))
                   (let ((unpack-imm (the-as vif-unpack-imm (-> tag imm))))
                     (format stream
                             "  (~s :irq ~D :num ~D :addr #x~X "
                             (-> *vif-disasm-table* template-index string1)
                             (-> tag irq)
                             (-> tag num)
                             (-> unpack-imm addr))
                     (format stream
                             ":msk ~D :flg ~D :usn ~D [skip ~d])~%"
                             (-> tag msk)
                             (-> unpack-imm flg)
                             (-> unpack-imm usn)
                             (the-as uint packet-bytes)))
                   (if details?
                     (disasm-vif-details stream (the-as (pointer uint8) packet) (logand cmd (vif-cmd cmd-mask)) (the-as int (-> tag num)))))
                  ((= print-kind 8) (format stream "  (*unknown* vif-tag #x~X)~%" (-> tag cmd)))))
              (set! template-index (-> *vif-disasm-table* length)))))
        (+! bytes-consumed packet-bytes)
        (&+! packet packet-bytes)))
    (- bytes-consumed (* word-count 4))))

(defun disasm-dma-tag ((tag dma-tag) (stream symbol))
  "Print one DMA tag in constructor-style notation, omitting zero-valued optional fields."
  (format stream "(dma-tag ")
  (format stream "~s" (enum->string dma-tag-id (-> tag id)))
  (if (> (the-as uint (-> tag addr)) 0) (format stream " :addr #x~8x" (-> tag addr)))
  (if (> (the-as uint (-> tag qwc)) 0) (format stream " :qwc ~d" (-> tag qwc)))
  (if (> (the-as uint (-> tag spr)) 0) (format stream " :spr ~d" (-> tag spr)))
  (if (> (the-as uint (-> tag irq)) 0) (format stream " :irq ~d" (-> tag irq)))
  (if (> (the-as uint (-> tag pce)) 0) (format stream " :pce ~d" (-> tag pce)))
  (format stream ")~%")
  (none))

;; Master switch retained for interactive DMA diagnostics.
(define *dma-disasm* #t)

(defmacro disasm-dma-buffer (buffer)
  "Decode one DMA buffer with VIF payload details enabled."
  `(disasm-dma-list (the dma-packet (-> ,buffer data-buffer)) 'details #t #t 0))

(defun disasm-dma-list ((start-packet dma-packet) (vif-mode symbol) (verbose? symbol) (stream symbol) (tag-limit int))
  "Validate and print a DMA source chain, optionally decoding its VIF commands. Return false after
   an invalid pointer, reserved tag bits, unknown command, or self-loop."
  (local-vars
    (transfer-data object)
    (packet dma-packet)
    (quadword-count int)
    (return-address-0 object)
    (return-address-1 object)
    (call-depth int)
    (tag dma-tag))
  (set! packet start-packet)
  (let ((active-vif-mode vif-mode)
        (active-verbose? verbose?)
        (output stream)
        (active-tag-limit tag-limit))
    (if active-verbose? (format output "~%--- ~X -----------------------------~%" packet))
    (let ((end-condition #f))
      (let ((total-quadwords 0)
            (total-tags 0))
        (set! transfer-data 0)
        (set! quadword-count 0)
        ;; The source-chain CALL stack is only two entries deep.
        (set! return-address-0 0)
        (set! return-address-1 1)
        (set! call-depth -1)
        (set! tag (new 'static 'dma-tag))
        (while (not end-condition)
          (cond
            ((not (valid? packet (the-as type #f) "dma-list tag pointer" #t output))
             (format output "ERROR: dma-list tag pointer invalid~%")
             (set! end-condition 'error))
            (else
             (set! tag (-> packet dma))
             ;; transfer-data is unset before the first tag.
             (when (not (or (zero? total-tags) (valid? transfer-data (the-as type #f) "dma-list data pointer" #t output)))
               (format output "ERROR: dma-list data pointer invalid~%")
               (set! end-condition 'error))
             (when (logtest? (the-as dma-tag #x3ff0000) tag)
               (format output "ERROR: dma tag has data in reserved bits ~X~%")
               (set! end-condition 'error))))
          (when (or active-verbose? (= end-condition 'error))
            (format output "#x~8x: " packet)
            (cond
              ((zero? call-depth) (format output "  "))
              ((= call-depth 1) (format output "    ")))
            (disasm-dma-tag tag output))
          (cond
            (end-condition)
            ;; REF, REFS, and REFE transfer QWC quadwords from ADDR. The next tag follows this tag
            ;; in memory; REFE ends the chain after its transfer.
            ((or (= (-> tag id) (dma-tag-id ref)) (= (-> tag id) (dma-tag-id refs)) (zero? (-> tag id)))
             (set! transfer-data (-> tag addr))
             (set! quadword-count (the-as int (-> tag qwc)))
             (when active-vif-mode
               ;; TTE contributes the two VIF words in the tag before the referenced payload. A
               ;; command crossing that boundary resumes at the corresponding byte in ADDR.
               (let ((tte-overshoot-bytes (disasm-vif-tag (&-> packet vif0) 2 output (= active-vif-mode 'details))))
                 (disasm-vif-tag (the-as (pointer vif-tag) (+ (the-as uint transfer-data) tte-overshoot-bytes))
                                 (the-as int (- (* (the-as uint quadword-count) 4) (the-as uint (/ tte-overshoot-bytes 4))))
                                 output
                                 (= active-vif-mode 'details))))
             (set! packet (the-as dma-packet (&-> (the-as (pointer uint64) packet) 2)))
             (if (= (-> tag id) (dma-tag-id refe)) (set! end-condition #t)))
            ;; CNT transfers the inline payload after the tag and continues sequentially after it.
            ((= (-> tag id) (dma-tag-id cnt))
             (set! transfer-data (&-> (the-as (pointer uint64) packet) 2))
             (set! quadword-count (the-as int (-> tag qwc)))
             (if active-vif-mode
               (disasm-vif-tag (the-as (pointer vif-tag) (&-> (the-as (pointer uint64) packet) 1))
                               (the-as int (+ (* (the-as uint quadword-count) 4) 2))
                               output
                               (= active-vif-mode 'details)))
             (set! packet (the-as dma-packet (+ (the-as uint packet) (* (+ (the-as uint quadword-count) 1) 16))))
             packet)
            ;; NEXT transfers the same inline payload as CNT, then fetches the next tag from ADDR.
            ((= (-> tag id) (dma-tag-id next))
             (set! transfer-data (&-> (the-as (pointer uint64) packet) 2))
             (set! quadword-count (the-as int (-> tag qwc)))
             (if active-vif-mode
               (disasm-vif-tag (the-as (pointer vif-tag) (&-> (the-as (pointer uint64) packet) 1))
                               (the-as int (+ (* (the-as uint quadword-count) 4) 2))
                               output
                               (= active-vif-mode 'details)))
             (when (= packet (-> tag addr))
               (format output "ERROR: next tag creates infinite loop.~%")
               (set! end-condition 'error))
             (set! packet (the-as dma-packet (-> tag addr)))
             packet)
            ;; CALL transfers inline data, saves a return address, and jumps to ADDR.
            ((= (-> tag id) (dma-tag-id call))
             (set! transfer-data (&-> (the-as (pointer uint64) packet) 2))
             (set! quadword-count (the-as int (-> tag qwc)))
             (if active-vif-mode
               (disasm-vif-tag (the-as (pointer vif-tag) (&-> (the-as (pointer uint64) packet) 1))
                               (the-as int (+ (* (the-as uint quadword-count) 4) 2))
                               output
                               (= active-vif-mode 'details)))
             (set! packet (the-as dma-packet (-> tag addr)))
             (+! call-depth 1)
             ;; FIXME: quadword-count is added directly to the byte address. A nonempty CALL would
             ;; normally resume after quadword-count * 16 bytes.
             (cond
               ((zero? call-depth)
                (set! return-address-0 (&+ (the-as (pointer uint64) transfer-data) (the-as uint quadword-count)))
                (the-as (pointer uint64) (the-as (pointer uint64) return-address-0)))
               (else
                (set! return-address-1 (&+ (the-as (pointer uint64) transfer-data) (the-as uint quadword-count)))
                (the-as (pointer uint64) (the-as (pointer uint64) return-address-1)))))
            ;; RET transfers inline data and resumes at the most recent CALL continuation.
            ((= (-> tag id) (dma-tag-id ret))
             (set! transfer-data (&-> (the-as (pointer uint64) packet) 2))
             (set! quadword-count (the-as int (-> tag qwc)))
             (if active-vif-mode
               (disasm-vif-tag (the-as (pointer vif-tag) (&-> (the-as (pointer uint64) packet) 1))
                               (the-as int (+ (* (the-as uint quadword-count) 4) 2))
                               output
                               (= active-vif-mode 'details)))
             (let ((return-depth call-depth))
               (cond
                 ((zero? return-depth) (set! packet (the-as dma-packet return-address-0)) packet)
                 ((= return-depth 1) (set! packet (the-as dma-packet return-address-1)) packet)
                 (else (set! end-condition #t))))
             (+! call-depth -1)
             call-depth)
            ;; END transfers its inline payload and terminates the chain.
            ((= (-> tag id) (dma-tag-id end))
             (set! transfer-data (&-> (the-as (pointer uint64) packet) 2))
             (set! quadword-count (the-as int (-> tag qwc)))
             (set! end-condition #t)
             (if active-vif-mode
               (disasm-vif-tag (the-as (pointer vif-tag) (&-> (the-as (pointer uint64) packet) 1))
                               (the-as int (+ (* (the-as uint quadword-count) 4) 2))
                               output
                               (= active-vif-mode 'details))))
            (else (format output "ERROR: Unknown DMA TAG command.~%") (set! end-condition 'error)))
          (+! total-quadwords quadword-count)
          (+! total-tags 1)
          (if (and (>= active-tag-limit 0) (>= total-tags active-tag-limit)) (set! end-condition #t)))
        (when (or active-verbose? (= end-condition 'error))
          (format output "NOTICE: Total tags: ~d~%" total-tags)
          (format output "NOTICE: Total QWC: ~d~%" total-quadwords)
          (format output "--------------------------------~%~%")))
      (!= end-condition 'error))))

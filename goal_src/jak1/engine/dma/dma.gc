  (set! (-> bank chcr) (new 'static 'dma-chcr :str 1))
  (.sync.l)
  (if wait-for-completion? (dma-sync (the-as pointer bank) 0 0))
  (none))

(defun dma-send-from-spr-no-flush ((memory-address uint) (scratchpad-address uint) (quadword-count uint) (wait-for-completion? symbol))
  "Transfer quadwords from scratchpad to main memory without flushing the data cache, optionally
   waiting for completion."
  (local-vars (bank dma-bank-spr))
  (#when PC_PORT
    (return 0))
  (set! bank SPR_FROM_BANK)
  (dma-sync (the-as pointer bank) 0 0)
  (.sync.l)
  (set! (-> bank madr) (logand #xfffffff (the-as int memory-address)))
  (set! (-> bank sadr) (logand #xfffffff (the-as int scratchpad-address)))
  (set! (-> bank qwc) quadword-count)
  (.sync.l)
  (set! (-> bank chcr) (new 'static 'dma-chcr :str 1))
  (.sync.l)
  (if wait-for-completion? (dma-sync (the-as pointer bank) 0 0))
  (none))

(defun dma-initialize ()
  "Due to a bug in the PS2 hardware, you must always disable the DMAtag mismatch
   error. This is done here."
  (#when PC_PORT
    (return 0))
  (set! (-> (the-as vif-bank #x10003800) err me0) 1)
  (set! (-> (the-as vif-bank #x10003c00) err me0) 1)
  (none))

(defun clear-vu0-mem ()
  "Fill all 4 KiB of VU0 data memory with #xabadbeef through the EE memory map."
  (#when PC_PORT
    (return 0))
  (let ((memory VU0_DATA_MEM_MAP)) 
    (dotimes (i 1024) (set! (-> memory i) #xabadbeef)))
  (none))

(defun clear-vu1-mem ()
  "Fill all 16 KiB of VU1 data memory with #xabadbeef through the EE memory map."
  (#when PC_PORT
    (return 0))
  (let ((memory VU1_DATA_MEM_MAP))
    (dotimes (i 4096) (set! (-> memory i) #xabadbeef)))
  (none))

(defun dump-vu1-mem ()
  "Print all 1024 quadwords of VU1 data memory as hexadecimal words and floats."
  (let ((memory (the-as (pointer uint32) #x1100c000)))
    (dotimes (i 1024)
      (format 0
              "~4,'0X: ~8,'0X ~8,'0X ~8,'0X ~8,'0X"
              i
              (-> memory (* i 4))
              (-> memory (+ (* i 4) 1))
              (-> memory (+ (* i 4) 2))
              (-> memory (+ (* i 4) 3)))
      (format 0
              "      ~F ~F ~F ~F ~%"
              (-> memory (* i 4))
              (-> memory (+ (* i 4) 1))
              (-> memory (+ (* i 4) 2))
              (-> memory (+ (* i 4) 3)))))
  (none))

(defun dump-vu1-range ((start-quadword uint) (quadword-count uint))
  "Print a range of VU1 data-memory quadwords as hexadecimal words and floats."
  (let ((memory (the-as (pointer uint32) #x1100c000)))
    (dotimes (i (the-as int quadword-count))
      (let ((quadword-index (+ i start-quadword)))
        (format 0
                "~4,'0X: ~8x ~8x ~8x ~8x"
                quadword-index
                (-> memory (* quadword-index 4))
                (-> memory (+ (* quadword-index 4) 1))
                (-> memory (+ (* quadword-index 4) 2))
                (-> memory (+ (* quadword-index 4) 3)))
        (format 0
                "      ~F ~F ~F ~F ~%"
                (-> memory (* quadword-index 4))
                (-> memory (+ (* quadword-index 4) 1))
                (-> memory (+ (* quadword-index 4) 2))
                (-> memory (+ (* quadword-index 4) 3))))))
  #f)

;; if we send junk DMA data due to an engine bug, the PS2 will eventually time out the transfer.
;; in this case, the main loop will attempt to reset everything to hopefully recover.
;; The game uses a sony-provided C library function to reset, which needs a parameter
;; to pick between PAL/NTSC, stored below
(define *video-reset-parm* 2)

(defun reset-vif1-path ()
  "Print the VIF1 register state and reset the VIF1 and GS paths after a stalled transfer."
  (#when PC_PORT
    (return 0))
  ((method-of-type dma-bank-vif inspect) VIF1_DMA_BANK)
  ((method-of-type vif-bank inspect) VIF1_BANK)
  ;; sceGsResetPath
  (reset-path)
  ;; sceGsResetGraph
  (reset-graph 1 1 *video-reset-parm* 1)
  (format 0 "gkernel: vif1 path reset!~%")
  (none))

(defun ultimate-memcpy ((dst pointer) (src pointer) (byte-count uint))
  "Copy a multiple of sixteen bytes in ascending order using the 4 KiB scratchpad as a DMA staging
   buffer. Transfers are split into at most 1024 quadwords so each pass fits in scratchpad."
  (#cond
    (PC_PORT
     ;; og:preserve-this on PC Port, just call C mem-move, it's the fastest.
     (__mem-move dst src byte-count))
    (else
     ;; Staging through scratchpad is faster than an EE copy for large transfers.
     (let ((spr-to-bank (the-as dma-bank-spr #x1000d400))
           (spr-from-bank (the-as dma-bank-spr #x1000d000))
           (quadwords-remaining (shr byte-count 4)))
       ;; DMA bypasses the data cache.
       (flush-cache 0)
       (dma-sync (the-as pointer spr-to-bank) 0 0)
       (dma-sync (the-as pointer spr-from-bank) 0 0)
       (while (> quadwords-remaining 0)
         (let ((transfer-quadwords (the-as int quadwords-remaining)))
           (if (< (the-as uint 1024) (the-as uint transfer-quadwords)) (set! transfer-quadwords 1024))
           (set! quadwords-remaining (- quadwords-remaining (the-as uint transfer-quadwords)))
           (.sync.l)
           (set! (-> spr-to-bank madr) (the-as uint src))
           (set! (-> spr-to-bank sadr) (the-as uint 0))
           (set! (-> spr-to-bank qwc) (the-as uint transfer-quadwords))
           (.sync.l)
           (set! (-> spr-to-bank chcr) (new 'static 'dma-chcr :str #x1))
           (.sync.l)
           (dma-sync (the-as pointer spr-to-bank) 0 0)
           (&+! src (shl transfer-quadwords 4))
           (set! (-> spr-from-bank madr) (the-as uint dst))
           (set! (-> spr-from-bank sadr) (the-as uint 0))
           (set! (-> spr-from-bank qwc) (the-as uint transfer-quadwords))
           (.sync.l)
           (set! (-> spr-from-bank chcr) (new 'static 'dma-chcr :str #x1))
           (.sync.l)
           (dma-sync (the-as pointer spr-from-bank) 0 0)
           (&+! dst (shl transfer-quadwords 4)))))))
  (none))

(#unless PC_PORT
  (defun symlink2 ((object-data pointer) (link-object pointer) (relocation-table (pointer uint8)))
    "Apply one version-2 symbol-relocation run to object data and return the next relocation-table
     byte. Each variable-length table entry advances the object cursor and patches one word."
    (rlet ((symbol-offset (- link-object s7))
           (upper-mask #xffff0000)
           (offset-mask #xfffffffc)
           (absolute-marker #xffffffff)
           (encoded-offset)
           (more-bytes)
           (next-byte)
           (object-word)
           (adjusted-word))
      (l.bu encoded-offset relocation-table)
      (&+! relocation-table 1)
      (label next-relocation)
      (set! more-bytes (logand encoded-offset 3))
      (l.bu next-byte relocation-table)
      (b.z more-bytes offset-ready :delay (sll next-byte next-byte 8))
      (logior! encoded-offset next-byte)
      (&+! relocation-table 1)
      (set! more-bytes (logand encoded-offset 2))
      (l.bu next-byte relocation-table)
      (b.z more-bytes offset-ready :delay (sll next-byte next-byte 16))
      (logior! encoded-offset next-byte)
      (&+! relocation-table 1)
      (set! more-bytes (logand encoded-offset 1))
      (l.bu next-byte relocation-table)
      (b.z more-bytes offset-ready :delay (sll next-byte next-byte 24))
      (logior! encoded-offset next-byte)
      (&+! relocation-table 1)
      (label offset-ready)
      (logand! encoded-offset offset-mask)
      ;; This byte terminates the relocation run and seeds the next encoded offset.
      (l.bu next-byte relocation-table)
      (&+! object-data encoded-offset)
      (&+! relocation-table 1)
      (l.w object-word object-data)
      (nop!)
      ;; An all-ones word is an absolute pointer relocation. The likely branch ensures the store
      ;; occurs only on this path.
      (b.eql object-word absolute-marker relocation-patched :delay (s.w link-object object-data))
      ;; Other words preserve their instruction's upper half and relocate the lower immediate.
      (set! adjusted-word (+ object-word symbol-offset))
      (logand! object-word upper-mask)
      (logand! adjusted-word #xffff)
      (nop!)
      (logior! object-word adjusted-word)
      (l.bu next-byte relocation-table -1)
      (s.w object-word object-data)
      (nop!)
      (label relocation-patched)
      (b.nz next-byte next-relocation :delay (m encoded-offset next-byte))
      (j ra :delay (m v0 relocation-table)))))

(#when PC_PORT
  (defun symlink2 ((object-data pointer) (link-object pointer) (relocation-table (pointer uint8)))
    "Apply one version-2 symbol-relocation run. The PC linker supplies its own implementation."
    (segfault)
    relocation-table))

(#unless PC_PORT
  (defun symlink3 ((object-data pointer) (link-object pointer) (relocation-table (pointer uint8)))
    "Apply one version-3 symbol-relocation run to object data and return the next relocation-table
     byte. Table bytes encode word deltas, with #xff reserved as an extended skip marker."
    (rlet ((symbol-offset (- link-object s7))
           (upper-mask #xffff0000)
           (skip-marker 1020)
           (absolute-marker #xffffffff)
           (word-delta)
           (continuation)
           (object-word)
           (adjusted-word))
      (label next-relocation)
      (l.bu word-delta relocation-table)
      (&+! relocation-table 1)
      (sll word-delta word-delta 2)
      (nop!)
      ;; A #xff byte advances by 1020 bytes and continues without applying a relocation.
      (b.eq word-delta skip-marker next-relocation :delay (&+! object-data word-delta))
      (l.w object-word object-data)
      (l.bu continuation relocation-table)
      (b.eql object-word absolute-marker relocation-patched :delay (s.w link-object object-data))
      (set! adjusted-word (+ object-word symbol-offset))
      (logand! object-word upper-mask)
      (logand! adjusted-word #xffff)
      (nop!)
      (logior! object-word adjusted-word)
      (l.bu continuation relocation-table)
      (s.w object-word object-data)
      (nop!)
      (label relocation-patched)
      (b.nz continuation next-relocation :delay (nop!))
      (j ra :delay (m! v0 (&+ relocation-table 1))))))

(#when PC_PORT
  (defun symlink3 ((object-data pointer) (link-object pointer) (relocation-table (pointer uint8)))
    "Apply one version-3 symbol-relocation run. The PC linker supplies its own implementation."
    (segfault)
    relocation-table))

;; Mask the VIF DMAtag mismatch error required by the EE hardware workaround.
(dma-initialize)

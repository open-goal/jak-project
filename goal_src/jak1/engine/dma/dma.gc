;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/dma/dma-h.gc")
(require "engine/ps2/vif-h.gc")

;; DMA send and sync functions:
;; These functions transfer existing DMA chains and buffers.
;; In general, there are two types:
;;  - plain transfer of a buffer (like, src, dst, size)
;;  - chain, a data structure the PS2 DMA hardware can traverse, just give it a starting address.

;; PC renderers consume DMA buffers before they reach these hardware helpers. The transfer,
;; register-debug, and reset routines therefore return without touching EE addresses on PC.

(#unless PC_PORT
  (defun dma-sync-hang ((bank dma-bank))
    "Wait indefinitely for a DMA channel to finish. This tight polling loop is slower than
     dma-sync-fast because its register reads contend with the transfer for the main bus. This
     function is unused."
    (rlet ((status))
      (label poll)
      (l.w status bank)
      (logand! status #x100)
      (nop!)
      (nop!)
      (nop!)
      (nop!)
      (b.nz status poll :delay (nop!)))
    (none)))

(#when PC_PORT
  (defun dma-sync-hang ((bank dma-bank))
    "Wait indefinitely for a DMA channel to finish. DMA submission is synchronous on PC."
    (none)))

(defun dma-sync-crash ((bank dma-bank))
  "Wait up to five million polls for a DMA channel to finish, then crash. This function is unused."
  (#when PC_PORT
    (return 0))
  (let ((polls-remaining 5000000))
    (while (nonzero? (-> bank chcr str))
      (if (zero? polls-remaining) (crash!) (+! polls-remaining -1)))
    (none)))

(defmacro make-madr-addr (addr)
  "Convert an address to one suitable for MADR.
   This works with Main RAM (all mappings) and for spad"
  `(let ((int-addr (the-as int ,addr)))
    (logior (logand #xfffffff int-addr) ;; mask off spad/mapping bits
            (if (= (logand #x70000000 int-addr) #x70000000)
              #x80000000 ;; if we're in spad, set high bit.
              0 ;; otherwise nothing.
              ))))

(defun dma-send ((bank dma-bank) (memory-address uint) (quadword-count uint))
  "Wait for a channel, flush the cache, and start a normal-mode DMA transfer. The source may be in
   main memory or scratchpad."
  (#when PC_PORT
    (return 0))
  (dma-sync (the-as pointer bank) 0 0)
  (flush-cache 0)
  (.sync.l)
  (set! (-> bank madr) (make-madr-addr memory-address))
  (set! (-> bank qwc) quadword-count)
  (.sync.l)
  (set! (-> bank chcr) (new 'static 'dma-chcr :str 1))
  (.sync.l)
  (none))

(defun dma-send-chain ((bank dma-bank-source) (tag-address uint))
  "Wait for a channel, flush the cache, and start a source-chain DMA with tag transfer enabled. The
   tag list may be in main memory or scratchpad."
  (#when PC_PORT
    (return 0))
  (dma-sync (the-as pointer bank) 0 0)
  (flush-cache 0)
  (.sync.l)
  (set! (-> bank qwc) 0)
  (set! (-> bank tadr) (make-madr-addr tag-address))
  (.sync.l)
  (set! (-> bank chcr)
        (new 'static
             'dma-chcr
             :dir 1
             ;; from memory
             :mod 1
             ;; source chain
             :tte 1
             ;; send tags
             :str 1) ;; go!
        )
  (.sync.l)
  (none))

(defun dma-send-chain-no-tte ((bank dma-bank-source) (tag-address uint))
  "Wait for a channel, flush the cache, and start a source-chain DMA without transferring its tags.
   This function is unused."
  (#when PC_PORT
    (return 0))
  (dma-sync (the-as pointer bank) 0 0)
  (flush-cache 0)
  (.sync.l)
  (set! (-> bank qwc) 0)
  (set! (-> bank tadr) (make-madr-addr tag-address))
  (.sync.l)
  (set! (-> bank chcr)
        (new 'static
             'dma-chcr
             :dir 1
             ;; from memory
             :mod 1
             ;; source chain
             :tte 0
             ;; no tags
             :str 1) ;; go!
        )
  (.sync.l)
  (none))

(defun dma-send-chain-no-flush ((bank dma-bank-source) (tag-address uint))
  "Wait for a channel and start a source-chain DMA with tag transfer enabled without first flushing
   the data cache."
  (#when PC_PORT
    (return 0))
  (dma-sync (the-as pointer bank) 0 0)
  (.sync.l)
  (set! (-> bank qwc) 0)
  (set! (-> bank tadr) (make-madr-addr tag-address))
  (.sync.l)
  (set! (-> bank chcr) (new 'static 'dma-chcr :dir 1 :mod 1 :tte 1 :str 1))
  (.sync.l)
  (none))

(defun dma-send-to-spr ((scratchpad-address uint) (memory-address uint) (quadword-count uint) (wait-for-completion? symbol))
  "Transfer quadwords from main memory to scratchpad, optionally waiting for completion."
  (local-vars (bank dma-bank-spr))
  (#when PC_PORT
    (return 0))
  (set! bank SPR_TO_BANK)
  (dma-sync (the-as pointer bank) 0 0)
  (flush-cache 0)
  (.sync.l)
  (set! (-> bank madr) (logand #xfffffff (the-as int memory-address)))
  (set! (-> bank sadr) (logand #xfffffff (the-as int scratchpad-address)))
  (set! (-> bank qwc) quadword-count)
  (.sync.l)
  (set! (-> bank chcr) (new 'static 'dma-chcr :str 1))
  (.sync.l)
  (if wait-for-completion? (dma-sync (the-as pointer bank) 0 0))
  (none))

(defun dma-send-to-spr-no-flush ((scratchpad-address uint) (memory-address uint) (quadword-count uint) (wait-for-completion? symbol))
  "Transfer quadwords from main memory to scratchpad without flushing the data cache, optionally
   waiting for completion."
  (local-vars (bank dma-bank-spr))
  (#when PC_PORT
    (return 0))
  (set! bank SPR_TO_BANK)
  (dma-sync (the-as pointer bank) 0 0)
  (.sync.l)
  (set! (-> bank madr) (logand #xfffffff (the-as int memory-address)))
  (set! (-> bank sadr) (logand #xfffffff (the-as int scratchpad-address)))
  (set! (-> bank qwc) quadword-count)
  (.sync.l)
  (set! (-> bank chcr) (new 'static 'dma-chcr :str 1))
  (.sync.l)
  (if wait-for-completion? (dma-sync (the-as pointer bank) 0 0))
  (none))

(defun dma-send-from-spr ((memory-address uint) (scratchpad-address uint) (quadword-count uint) (wait-for-completion? symbol))
  "Transfer quadwords from scratchpad to main memory, optionally waiting for completion."
  (local-vars (bank dma-bank-spr))
  (#when PC_PORT

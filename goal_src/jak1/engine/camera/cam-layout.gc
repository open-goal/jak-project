(defbehavior clmf-save-single cam-layout ((camera entity-camera) (print? symbol) (named-file? symbol))
  "Write one camera definition and its editable offset tags. print? also describes effective values
   on the console; named-file? chooses the camera's .cam path instead of the garbage preview file."
  (clear *temp-string*)
  (if named-file?
      (format *temp-string* "dd_next/caminfo/~s.cam" (res-lump-struct camera 'name structure))
      (format *temp-string* "dd_next/caminfo/garbage"))
  (let ((output (new 'stack 'file-stream *temp-string* 'write)))
    (if print?
        (format #t "---------camera '~S'------------~%" (res-lump-struct camera 'name structure)))
    (format output "#include /next/config_data/standard.m2d~%")
    (format output "camera ~s {~%" (res-lump-struct camera 'name structure))
    (cam-layout-save-cam-rot print? (the-as string output) (the-as entity-actor camera))
    (cam-layout-save-cam-trans print? (the-as string output) (the-as entity-actor camera))
    (cam-layout-save-pivot print? (the-as string output) (the-as entity-actor camera))
    (cam-layout-save-align print? (the-as string output) (the-as entity-actor camera))
    (cam-layout-save-interesting print? (the-as string output) (the-as entity-actor camera))
    (cam-layout-save-fov print? (the-as string output) (the-as entity-actor camera))
    (cam-layout-save-focalpull print? (the-as string output) (the-as entity-actor camera))
    (cam-layout-save-flags print? (the-as string output) (the-as entity-actor camera))
    (cam-layout-save-introsplinetime print? (the-as string output) (the-as entity-actor camera))
    (cam-layout-save-introsplineexitval print? (the-as string output) (the-as entity-actor camera))
    (cam-layout-save-interptime print? (the-as string output) (the-as entity-actor camera))
    (cam-layout-save-splineoffset print? (the-as string output) (the-as entity-actor camera))
    (cam-layout-save-spline-follow-dist-offset print? (the-as string output) (the-as entity-actor camera))
    (cam-layout-save-campointsoffset print? (the-as string output) (the-as entity-actor camera))
    (cam-layout-save-tiltAdjust print? (the-as string output) (the-as entity-actor camera))
    (cam-layout-save-stringMinLength print? (the-as string output) (the-as entity-actor camera))
    (cam-layout-save-stringMaxLength print? (the-as string output) (the-as entity-actor camera))
    (cam-layout-save-stringMinHeight print? (the-as string output) (the-as entity-actor camera))
    (cam-layout-save-stringMaxHeight print? (the-as string output) (the-as entity-actor camera))
    (cam-layout-save-stringCliffHeight print? (the-as string output) (the-as entity-actor camera))
    (cam-layout-save-maxAngle print? (the-as string output) (the-as entity-actor camera))
    (cam-layout-save-campoints-flags print? (the-as string output) (the-as entity-actor camera))
    (cam-layout-save-focalpull-flags print? (the-as string output) (the-as entity-actor camera))
    (format output "}~%")
    (file-stream-close output)))

(defbehavior clmf-save-one cam-layout ((options symbol))
  "Save the selected camera. Options bit three prints diagnostics and bit four writes the named
   camera file instead of the garbage preview file."
  (let ((print? (logtest? (the-as int options) 8))
        (named-file? (logtest? (the-as int options) 16)))
    (if print?
        (format #t "~%~%~%=================================~%"))
    (clmf-save-single (-> self cam-entity) print? named-file?)
    (if print?
        (format #t "===============================~%~%~%~%"))
    (if named-file?
        (format #t "'~S' save completed~%" (res-lump-struct (-> self cam-entity) 'name structure))))
  #t)

(defbehavior clmf-save-all cam-layout ((options symbol))
  "Save every live camera. Options bit three prints diagnostics and bit four writes named files."
  (let ((print? (logtest? (the-as int options) 8))
        (named-file? (logtest? (the-as int options) 16)))
    (if print?
        (format #t "~%~%~%=================================~%"))
    (iterate-engine-connections (node *camera-engine*)
      (let ((camera (-> node param1)))
        (clmf-save-single (the-as entity-camera camera) print? named-file?)))
    (if print?
        (format #t "===============================~%~%~%~%"))
    (if named-file?
        (format #t "camera save all completed~%")))
  #t)

(deftype clmf-cam-flag-toggle-info (structure)
  ((key       float)
   (force-on  int32)
   (force-off int32)))


(defbehavior clmf-cam-flag-toggle cam-layout ((scaled-bit-mask int) (property int))
  "Divide scaled-bit-mask by eight, then cycle that camera flag through forced off, forced on, and
   inherited. Volume keys are translated into the corresponding vol, pvol, or cutoutvol property
   array."
  (let ((bit (/ scaled-bit-mask 8))
        (info (new 'stack 'clmf-cam-flag-toggle-info)))
    (set! (-> info key) (-> self res-key))
    (cond
      ((and (= property 'vol-flags) (>= (-> self res-key) (the float (-> self first-cutoutvol))))
       (set! (-> info key) (- (-> info key) (the float (-> self first-cutoutvol))))
       (set! property (the-as int 'cutoutvol-flags)))
      ((and (= property 'vol-flags) (>= (-> self res-key) (the float (-> self first-pvol))))
       (set! (-> info key) (- (-> info key) (the float (-> self first-pvol))))
       (set! property (the-as int 'pvol-flags))))
    (let ((get-property-value (method-of-type res-lump get-property-value))
          (on-property-owner (-> self cam-entity)))
      (format (clear *res-key-string*) "~S~S" (the-as object property) '-on)
      (set! (-> info force-on)
            (the-as int
                    (get-property-value on-property-owner
                                        (string->symbol *res-key-string*)
                                        'exact
                                        (-> info key)
                                        (the-as uint128 0)
                                        (the-as (pointer res-tag) #f)
                                        *res-static-buf*))))
    (let ((get-property-value (method-of-type res-lump get-property-value))
          (off-property-owner (-> self cam-entity)))
      (format (clear *res-key-string*) "~S~S" (the-as object property) '-off)
      (set! (-> info force-off)
            (the-as int
                    (get-property-value off-property-owner
                                        (string->symbol *res-key-string*)
                                        'exact
                                        (-> info key)
                                        (the-as uint128 0)
                                        (the-as (pointer res-tag) #f)
                                        *res-static-buf*))))
    (cond
      ((logtest? (-> info force-off) bit)
       (logclear! (-> info force-off) bit)
       (logior! (-> info force-on) bit)
       (let* ((s4-1 (-> self cam-entity))
              (s3-2 (method-of-object s4-1 add-32bit-data!))
              (s2-2 (logior (shl #x10000 32) (shr (shl (the-as int int32) 32) 32)))
              (s1-2 (shl (the-as int (-> info key)) 32)))
         (format (clear *res-key-string*) "~S~S" (the-as object property) '-off)
         (s3-2 s4-1
               (the-as res-tag (make-u128 s2-2 (logior s1-2 (shr (shl (the-as int (string->symbol *res-key-string*)) 32) 32))))
               (-> info force-off)))
       (let* ((s4-2 (-> self cam-entity))
              (s3-3 (method-of-object s4-2 add-32bit-data!))
              (s2-3 (logior (shl #x10000 32) (shr (shl (the-as int int32) 32) 32)))
              (s1-3 (shl (the-as int (-> info key)) 32)))
         (format (clear *res-key-string*) "~S~S" (the-as object property) '-on)
         (s3-3 s4-2
               (the-as res-tag (make-u128 s2-3 (logior s1-3 (shr (shl (the-as int (string->symbol *res-key-string*)) 32) 32))))
               (-> info force-on))))
      ((logtest? (-> info force-on) bit)
       (logclear! (-> info force-on) bit)
       (let* ((s4-3 (-> self cam-entity))
              (s3-4 (method-of-object s4-3 add-32bit-data!))
              (s2-4 (logior (shl #x10000 32) (shr (shl (the-as int int32) 32) 32)))
              (s1-4 (shl (the-as int (-> info key)) 32)))
         (format (clear *res-key-string*) "~S~S" (the-as object property) '-on)
         (s3-4 s4-3
               (the-as res-tag (make-u128 s2-4 (logior s1-4 (shr (shl (the-as int (string->symbol *res-key-string*)) 32) 32))))
               (-> info force-on))))
      (else
       (logior! (-> info force-off) bit)
       (let* ((s4-4 (-> self cam-entity))
              (s3-5 (method-of-object s4-4 add-32bit-data!))
              (s2-5 (logior (shl #x10000 32) (shr (shl (the-as int int32) 32) 32)))
              (s1-5 (shl (the-as int (-> info key)) 32)))
         (format (clear *res-key-string*) "~S~S" (the-as object property) '-off)
         (s3-5 s4-4
               (the-as res-tag (make-u128 s2-5 (logior s1-5 (shr (shl (the-as int (string->symbol *res-key-string*)) 32) 32))))
               (-> info force-off))))))
  #t)

(defbehavior clmf-cam-flag cam-layout ((text string) (scaled-bit-mask uint) (property uint))
  "Divide scaled-bit-mask by eight and append that flag's effective state to text, distinguishing
   explicit on/off overrides from the inherited Maya value."
  (let ((bit (/ (the-as int scaled-bit-mask) 8))
        (key (-> self res-key)))
    (cond
      ((and (= property 'vol-flags) (>= (-> self res-key) (the float (-> self first-cutoutvol))))
       (set! key (- key (the float (-> self first-cutoutvol))))
       (set! property (the-as uint 'cutoutvol-flags)))
      ((and (= property 'vol-flags) (>= (-> self res-key) (the float (-> self first-pvol))))
       (set! key (- key (the float (-> self first-pvol))))
       (set! property (the-as uint 'pvol-flags))))
    (let ((get-property-value (method-of-type res-lump get-property-value))
          (off-property-owner (-> self cam-entity)))
      (format (clear *res-key-string*) "~S~S" (the-as object property) '-off)
      (cond
        ((logtest? (get-property-value off-property-owner
                                       (string->symbol *res-key-string*)
                                       'exact
                                       key
                                       (the-as uint128 0)
                                       (the-as (pointer res-tag) #f)
                                       *res-static-buf*)
                   bit)
         (format text ": off"))
        ((let ((get-property-value (method-of-type res-lump get-property-value))
               (on-property-owner (-> self cam-entity)))
           (format (clear *res-key-string*) "~S~S" (the-as object property) '-on)
           (logtest? (get-property-value on-property-owner
                                         (string->symbol *res-key-string*)
                                         'exact
                                         key
                                         (the-as uint128 0)
                                         (the-as (pointer res-tag) #f)
                                         *res-static-buf*)
                     bit))
         (format text ": on"))
        ((not (logtest? ((method-of-type res-lump get-property-value)
                         (-> self cam-entity)
                         (the-as symbol property)
                         'exact
                         key
                         (the-as uint128 0)
                         (the-as (pointer res-tag) #f)
                         *res-static-buf*)
                        bit))
         (format text ": off(maya)"))
        (else
         (format text ": on(maya)")))))
  #t)

(defbehavior clmf-cam-float-adjust cam-layout ((property symbol) (scale-pointer (pointer float)))
  "Adjust one float offset with the left stick and write it back as an exact default-frame resource
   value. A zero scale parameter means unit scale."
  (cam-layout-print 16 *camera-layout-message-ypos* "left stick adjusts value")
  (set! *camera-layout-message-ypos* (+ *camera-layout-message-ypos* 8))
  (let ((current-value (res-lump-float (-> self cam-entity) property))
        (scale (-> scale-pointer 0)))
    (if (= scale 0.0)
        (set! scale 1.0))
    (let ((new-value (+ current-value (analog-input (the-as int (-> *cpad-list* cpads 0 leftx)) 128.0 48.0 110.0 scale))))
      (add-32bit-data! (-> self cam-entity)
                       (new 'static 'res-tag :name property :key-frame -1000000000.0 :elt-count #x1 :elt-type float)
                       new-value)))
  (set! *camera-read-analog* #f)
  #t)

(defbehavior clmf-cam-meters cam-layout ((text meters) (property symbol))
  "Append a named camera float to text in meters."
  (let ((value (cam-slave-get-float (-> self cam-entity) property 0.0)))
    (format text ": ~M" value))
  #t)

(defbehavior clmf-cam-fov cam-layout ((text degrees) (unused symbol))
  "Append the selected camera's field of view to text in degrees."
  (format text ": ~R" (cam-slave-get-fov (-> self cam-entity)))
  #t)

(defbehavior clmf-cam-deg cam-layout ((text degrees) (property symbol))
  "Append a named camera float to text in degrees."
  (format text ": ~R" (cam-slave-get-float (-> self cam-entity) property 0.0))
  #t)

(defbehavior clmf-cam-intro-time cam-layout ((text float) (unused symbol))
  "Append the selected camera's intro duration to text and update the intro preview step."
  (let ((intro-step (cam-slave-get-intro-step (-> self cam-entity))))
    (format text ": ~f" (/ 0.016666668 intro-step))
    (set! (-> *CAM_LAYOUT-bank* intro-step) intro-step))
  #t)

(defbehavior clmf-cam-interp-time cam-layout ((text float) (unused symbol))
  "Append the selected camera's interpolation time to text."
  (format text ": ~f" (cam-slave-get-interp-time (-> self cam-entity)))
  #t)

(defbehavior clmf-cam-float cam-layout ((text float) (property symbol))
  "Append a named camera float to text."
  (format text ": ~f" (cam-slave-get-float (-> self cam-entity) property 0.0))
  #t)

(defbehavior clmf-cam-string cam-layout ((text string) (property symbol))
  "Append every symbol in a named camera resource array to text."
  (format text ":")
  (let* ((tag (new 'static 'res-tag))
         (values (res-lump-data (-> self cam-entity) property pointer :tag-ptr (& tag))))
    (when values
      (dotimes (i (the-as int (-> tag elt-count)))
        (format text " ~S" (-> (the-as (pointer uint32) (&+ values (* i 4))))))))
  #t)


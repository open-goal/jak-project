;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/gfx/tie/tie-h.gc")
(require "engine/level/bsp-h.gc")
(require "engine/gfx/math-camera.gc")
(require "engine/load/decomp.gc")
(require "engine/gfx/shrub/shrubbery-h.gc")
(require "engine/physics/dynamics-h.gc")
(require "engine/math/vector.gc")
(require "engine/gfx/background/wind.gc")
(require "engine/math/quaternion.gc")

;; Once the camera's position and orientation has been calculated,
;; the camera and visibility outputs are updated in this file.

;; DECOMP BEGINS

;; The four side planes are stored transposed for parallel point tests:
;; planes[0] contains the four x coefficients, planes[1] the four y
;; coefficients, planes[2] the four z coefficients, and planes[3] the
;; four constants.  plane-index therefore selects one lane in each vector.
(defun plane-from-points ((planes (inline-array plane)) (edge-a vector) (edge-b vector) (point vector) (plane-index int))
  "Construct a normalized plane from two in-plane edge directions and
   a point on the plane. Store its four coefficients at plane-index in the coefficient-transposed
   four-plane array."
  (let ((normal (new 'stack-no-clear 'vector)))
    (vector-cross! normal edge-a edge-b)
    (vector-normalize! normal 1.0)
    (set! (-> normal w) (vector-dot normal point))
    (set! (-> (&-> planes 0 data plane-index) 0) (-> normal x))
    (set! (-> (&-> planes 0 data plane-index) 4) (-> normal y))
    (set! (-> (&-> planes 0 data plane-index) 8) (-> normal z))
    (set! (-> (&-> planes 0 data plane-index) 12) (-> normal w)))
  (none))

(defun set-point ((point vector) (x float) (y float) (z float))
  "Set point's xyz coordinates and set w to one."
  (set! (-> point x) x)
  (set! (-> point y) y)
  (set! (-> point z) z)
  (set! (-> point w) 1.0)
  (none))

(defun update-view-planes ((camera math-camera) (planes (inline-array plane)) (scale float))
  "Build the camera's four side clipping planes. Construct near and
   far frustum corners at scale, rotate them into world space, form rays from the camera to the four
   far corners, and write the resulting planes in coefficient-transposed form. scale widens the side
   planes without changing the near and far distances."
  (when (not *artist-fix-frustum*)
    (let ((frustum (new 'stack 'view-frustum)))
      (let ((near-half-width (* scale (-> camera x-ratio) (-> camera d)))
            (near-half-height (* scale (-> camera y-ratio) (-> camera d)))
            (far-half-width (* scale (-> camera x-ratio) (-> camera f)))
            (far-half-height (* scale (-> camera y-ratio) (-> camera f))))
        (set-point (-> frustum hither-top-left) (- near-half-width) near-half-height (-> camera d))
        (set-point (-> frustum hither-top-right) near-half-width near-half-height (-> camera d))
        (set-point (-> frustum hither-bottom-left) (- near-half-width) (- near-half-height) (-> camera d))
        (set-point (-> frustum hither-bottom-right) near-half-width (- near-half-height) (-> camera d))
        (set-point (-> frustum yon-top-left) (- far-half-width) far-half-height (-> camera f))
        (set-point (-> frustum yon-top-right) far-half-width far-half-height (-> camera f))
        (set-point (-> frustum yon-bottom-left) (- far-half-width) (- far-half-height) (-> camera f))
        (set-point (-> frustum yon-bottom-right) far-half-width (- far-half-height) (-> camera f)))
      (vector-matrix*! (-> frustum hither-top-left) (-> frustum hither-top-left) (-> camera inv-camera-rot))
      (vector-matrix*! (-> frustum hither-top-right) (-> frustum hither-top-right) (-> camera inv-camera-rot))
      (vector-matrix*! (-> frustum hither-bottom-left) (-> frustum hither-bottom-left) (-> camera inv-camera-rot))
      (vector-matrix*! (-> frustum hither-bottom-right) (-> frustum hither-bottom-right) (-> camera inv-camera-rot))
      (vector-matrix*! (-> frustum yon-top-left) (-> frustum yon-top-left) (-> camera inv-camera-rot))
      (vector-matrix*! (-> frustum yon-top-right) (-> frustum yon-top-right) (-> camera inv-camera-rot))
      (vector-matrix*! (-> frustum yon-bottom-left) (-> frustum yon-bottom-left) (-> camera inv-camera-rot))
      (vector-matrix*! (-> frustum yon-bottom-right) (-> frustum yon-bottom-right) (-> camera inv-camera-rot))
      ;; The side planes all pass through the camera.  Their normals come
      ;; from pairs of rays through the far corners.  The complete near and
      ;; far corner set is transformed even though this calculation needs
      ;; only the four far corners.
      (let ((far-top-left-ray (new-stack-vector0))
            (far-top-right-ray (new-stack-vector0))
            (far-bottom-left-ray (new-stack-vector0))
            (far-bottom-right-ray (new-stack-vector0)))
        (set! (-> (new 'stack-no-clear 'vector) quad) (the-as uint128 0))
        (let ((camera-position (new 'stack-no-clear 'vector)))
          (set! (-> camera-position quad) (the-as uint128 0))
          (set! (-> camera-position quad) (-> camera inv-camera-rot vector 3 quad))
          (vector-! far-top-left-ray (-> frustum yon-top-left) camera-position)
          (vector-! far-top-right-ray (-> frustum yon-top-right) camera-position)
          (vector-! far-bottom-left-ray (-> frustum yon-bottom-left) camera-position)
          (vector-! far-bottom-right-ray (-> frustum yon-bottom-right) camera-position)
          (plane-from-points planes far-top-left-ray far-bottom-left-ray camera-position 0)
          (plane-from-points planes far-bottom-right-ray far-top-right-ray camera-position 1)
          (plane-from-points planes far-top-right-ray far-top-left-ray camera-position 2)
          (plane-from-points planes far-bottom-left-ray far-bottom-right-ray camera-position 3)))))
  (none))

;; If we should still attempt vis updates when outside of the BSP's boxes.
(define *update-leaf-when-outside-bsp* #t)

(defun update-visible ((camera math-camera))
  "Select the current BSP leaf and visibility string for every active
   level. Prefer valid self visibility, then adjacent-level visibility; retain the previous bits while
   data is loading and fall back to all-visible when no usable string exists. Return false."
  (local-vars (use-adjacent? symbol) (adjacent-vis level-vis-info) (self-vis level-vis-info))
  (when (not *artist-fix-visible*)
    ;; First determine the current BSP leaf for each active level.
    (dotimes (i (-> *level* length))
      (let ((active-level (-> *level* level i)))
        (when (= (-> active-level status) 'active)
          (if (and (nonzero? (-> active-level bsp nodes)) (or *update-leaf-when-outside-bsp* (-> active-level inside-boxes?)))
            ;; bsp-camera-asm stores the result in current-leaf-idx.
            (bsp-camera-asm (-> active-level bsp) (-> camera trans))))))
    ;; Then select or update the visibility string for each level.
    (dotimes (i (-> *level* length))
      (let ((active-level (-> *level* level i)))
        (when (= (-> active-level status) 'active)
          (let ((quad-count (/ (+ (-> active-level bsp visible-list-length) 15) 16)))
            ;; Begin with a truthy state.  A usable visibility string below
            ;; clears this, while 'loading preserves the last good bits.
            (set! (-> active-level all-visible?) (if (-> active-level all-visible?) (-> active-level all-visible?) #t))
            (cond
              ((or (not (-> active-level force-all-visible?)) (-> active-level inside-boxes?))
               (cond
                 ((or *artist-all-visible* (zero? (-> active-level bsp nodes)))
                  (quad-copy! (-> active-level vis-bits) (-> active-level bsp all-visible-list) quad-count))
                 ((begin
                    ;; Prefer visibility authored by this level.  Slot 7
                    ;; conventionally yields #f when there is no adjacent level.
                    (set! self-vis (-> active-level vis-info (-> active-level vis-self-index)))
                    (set! adjacent-vis (-> active-level vis-info (-> active-level vis-adj-index)))
                    (let ((use-self? #f))
                      (set! use-adjacent? #f)
                      (when self-vis
                        (set! use-self? (logtest? (vis-info-flag using-this-as-only-vis) (-> self-vis flags)))
                        ;; A stale leaf index can occur while mismatched level
                        ;; data is loaded, so never index beyond the string table.
                        (if (< (-> self-vis length) (-> self-vis from-bsp current-leaf-idx)) (set! use-self? #f)))
                      (when adjacent-vis
                        (set! use-adjacent? (logtest? (vis-info-flag using-this-as-only-vis) (-> adjacent-vis flags)))
                        (if (< (-> adjacent-vis length) (-> adjacent-vis from-bsp current-leaf-idx)) (set! use-adjacent? #f)))
                      use-self?))
                  (if (!= (-> active-level all-visible?) 'loading) (set! (-> active-level all-visible?) #f))
                  (when (update-vis! active-level self-vis (-> self-vis ramdisk) (-> self-vis string-block))
                    ;; A successful update makes every other cached string stale.
                    (countdown (i 8)
                      (let ((vis-info (-> active-level vis-info i)))
                        (when vis-info
                          (if (!= vis-info self-vis) (set! (-> vis-info current-vis-string) (the-as uint -1))))))
                    (set! (-> active-level all-visible?) #f)))
                 (use-adjacent?
                  (if (!= (-> active-level all-visible?) 'loading) (set! (-> active-level all-visible?) #f))
                  (when (update-vis! active-level adjacent-vis (-> adjacent-vis ramdisk) (-> adjacent-vis string-block))
                    ;; The adjacent string follows the same cache rules.
                    (countdown (i 8)
                      (let ((vis-info (-> active-level vis-info i)))
                        (when vis-info
                          (if (!= vis-info adjacent-vis) (set! (-> vis-info current-vis-string) (the-as uint -1))))))
                    (set! (-> active-level all-visible?) #f)))
                 ;; Keep the old visibility bits while the next string loads
                 ;; during play, avoiding an all-visible flash between strings.
                 ((and (= (-> active-level all-visible?) 'loading) (-> *level* play?)))
                 ;; No usable visibility data: draw the complete level.
                 (else (quad-copy! (-> active-level vis-bits) (-> active-level bsp all-visible-list) quad-count))))
              ;; Outside the level boxes with force-all-visible enabled.
              (else (quad-copy! (-> active-level vis-bits) (-> active-level bsp all-visible-list) quad-count))))
          (if (and *stats-bsp* (= *master-mode* 'game))
            (format *stdcon* "~0kleaf-index = ~d~%" (-> active-level bsp current-leaf-idx))))))
    #f))

(define *save-camera-inv-rot* (new 'global 'matrix))

(matrix-identity! *save-camera-inv-rot*)

(defun move-camera-from-pad ((camera math-camera))
  "Apply the selected external-camera controller to camera.
   Preserve an upright basis relative to gravity unless allow-z is enabled, accumulate orientation in
   *save-camera-inv-rot*, copy that basis to the math camera, and return camera."
  (let ((mode *external-cam-mode*)
        (controller-index 0))
    (cond
      ((= mode 'locked) (set! mode #f))
      ((= mode 'pad-1) (set! controller-index 1))
      ((not *camera-combiner*) (set! mode 'pad-0)))
    (when mode
      ;; Gravity supplies the camera's down direction.  Passing #f for up
      ;; allows a fully free orientation, including roll.
      (let ((up (vector-negate-in-place! (vector-normalize-copy! (new-stack-vector0) (-> *standard-dynamics* gravity) 1.0))))
        (if (= (vector-length up) 0.0) (set! (-> up y) -1.0))
        (if (logtest? *external-cam-options* (external-cam-option allow-z)) (set! up (the-as vector #f)))
        (cam-free-floating-move *save-camera-inv-rot* (-> camera trans) up controller-index))))
  (let* ((destination-matrix (-> *math-camera* inv-camera-rot))
         (source-matrix *save-camera-inv-rot*)
         (row-0 (-> source-matrix vector 0 quad))
         (row-1 (-> source-matrix vector 1 quad))
         (row-2 (-> source-matrix vector 2 quad))
         (row-3 (-> source-matrix vector 3 quad)))
    (set! (-> destination-matrix vector 0 quad) row-0)
    (set! (-> destination-matrix vector 1 quad) row-1)
    (set! (-> destination-matrix vector 2 quad) row-2)
    (set! (-> destination-matrix vector 3 quad) row-3))
  camera)

;; og:preserve-this PAL patch here (moved from cam-debug)
(defun external-cam-reset! ()
  "Reset the external math camera to the current combiner transform,
   or to identity at the origin when the combiner is unavailable."
  (vector-reset! (-> *math-camera* trans))
  (matrix-identity! (-> *math-camera* inv-camera-rot))
  (when *camera-combiner*
    (let* ((destination-matrix (-> *math-camera* inv-camera-rot))
           (source-matrix (-> *camera-combiner* inv-camera-rot))
           (row-0 (-> source-matrix vector 0 quad))
           (row-1 (-> source-matrix vector 1 quad))
           (row-2 (-> source-matrix vector 2 quad))
           (row-3 (-> source-matrix vector 3 quad)))
      (set! (-> destination-matrix vector 0 quad) row-0)
      (set! (-> destination-matrix vector 1 quad) row-1)
      (set! (-> destination-matrix vector 2 quad) row-2)
      (set! (-> destination-matrix vector 3 quad) row-3))
    (set! (-> *math-camera* trans quad) (-> *camera-combiner* trans quad)))
  0
  (none))

(define *start-timer* (the-as int #f))

(define *timer-value* 0)

(define *start-pos* (new 'global 'vector))

;; The camera orientation is kept in both directions.  inv-camera-rot is
;; camera-local to world and carries the camera position in its fourth row.
;; camera-rot is its transpose with (-camera-position * rotation) in the
;; fourth row, making it the world-to-camera view matrix.  camera-temp is
;; the view matrix multiplied by perspective; prev-camera-temp retains the
;; previous frame for effects that need temporal camera motion.
;;
;; TIE and shrub rendering consume camera-derived constants directly.
;; hmge-d combines the fog interval with each renderer's homogeneous near
;; threshold, hvdf-offset is the GS screen-space offset, and billboard-const
;; converts shrub sizes into projected pixel extents.  These values depend
;; on the current near distance, aspect ratio, FOV, fog, and video setup, so
;; they are rebuilt whenever the camera is updated.
(defun update-camera ()
  "Choose the gameplay, alternate, or controller-driven camera for this
   frame; update the math camera's view, inverse-view, view-projection, smoothed rotation, fog and
   field-of-view factors; publish camera constants and guard planes to TIE and shrub rendering; update
   BSP visibility and wind; and return false."
  ;; Measure horizontal travel between frames 180 and 480.  World
  ;; coordinates use 4096 units per meter.
  (when *start-timer*
    (when (= *timer-value* 180)
      (format #t
              "Player pos = ~F ~F ~F~%"
              (-> *target* control trans x)
              (-> *target* control trans y)
              (-> *target* control trans z))
      (set! (-> *start-pos* quad) (-> *target* control trans quad)))
    (when (= *timer-value* 480)
      (format #t
              "Player pos = ~F ~F ~F~%"
              (-> *target* control trans x)
              (-> *target* control trans y)
              (-> *target* control trans z))
      (format #t "Dist = ~F~%" (* 0.00024414062 (vector-vector-xz-distance (-> *target* control trans) *start-pos*)))
      (set! *start-timer* (the-as int #f)))
    (if (< 179 *timer-value*) (format *stdcon* "~%~%Time = ~D~%" *timer-value*))
    (set! *timer-value* (+ *timer-value* 1)))
  (when (not *start-timer*)
    (set! *timer-value* 0)
    0)
  ;; Only the two resident level slots need a camera-to-bounds distance.
  (dotimes (i 2)
    (let ((active-level (-> *level* level i)))
      (when (!= (-> active-level status) 'inactive)
        (let ((camera-to-level (new-stack-vector0)))
          (vector-! camera-to-level (the-as vector (-> active-level info bsphere)) (-> *math-camera* trans))
          (set! (-> active-level level-distance) (fmax 0.0 (- (vector-length camera-to-level) (-> active-level info bsphere w)))))
        (when *display-level-spheres*
          (add-debug-sphere #t
                            (bucket-id debug-no-zbuf)
                            (-> active-level info bsphere)
                            (-> active-level info bsphere w)
                            (new 'static 'rgba :r #xff :a #x80))
          (format *stdcon*
                  "~f ~f ~f ~f~%"
                  (/ (-> active-level info bsphere x) METER_LENGTH)
                  (/ (-> active-level info bsphere y) METER_LENGTH)
                  (/ (-> active-level info bsphere z) METER_LENGTH)
                  (/ (-> active-level info bsphere w) METER_LENGTH))))))
  ;; Refresh projection and display constants before choosing this frame's
  ;; pose.  Camera smush adds its vertical correction to gameplay poses.
  (update-math-camera *math-camera* (-> *setting-control* current video-mode) (-> *setting-control* current aspect-ratio))
  (update! *camera-smush-control*)
  (cond
    ((or (= *master-mode* 'pause) (= *master-mode* 'progress) *progress-process*))
    ((>= *camera-look-through-other* 2) (set! *camera-look-through-other* 1))
    ((and (= *camera-look-through-other* 1) (!= *master-mode* 'menu)) (set! *camera-look-through-other* 0) 0))
  ;; Priority is external control, the alternate/debug camera, the gameplay
  ;; combiner, then the controller fallback.  Alternate and gameplay poses
  ;; also refresh the saved external orientation to avoid a jump on entry.
  (cond
    (*external-cam-mode* (move-camera-from-pad *math-camera*))
    ((nonzero? *camera-look-through-other*)
     (set! (-> *math-camera* fov) (-> *camera-other-fov* data))
     (set! (-> *math-camera* trans quad) (-> *camera-other-trans* quad))
     (+! (-> *math-camera* trans y) (get-no-update *camera-smush-control*))
     (let* ((destination-matrix (-> *math-camera* inv-camera-rot))
            (source-matrix *camera-other-matrix*)
            (row-0 (-> source-matrix vector 0 quad))
            (row-1 (-> source-matrix vector 1 quad))
            (row-2 (-> source-matrix vector 2 quad))
            (row-3 (-> source-matrix vector 3 quad)))
       (set! (-> destination-matrix vector 0 quad) row-0)
       (set! (-> destination-matrix vector 1 quad) row-1)
       (set! (-> destination-matrix vector 2 quad) row-2)
       (set! (-> destination-matrix vector 3 quad) row-3))
     (let* ((destination-matrix *save-camera-inv-rot*)
            (source-matrix *camera-other-matrix*)
            (row-0 (-> source-matrix vector 0 quad))
            (row-1 (-> source-matrix vector 1 quad))
            (row-2 (-> source-matrix vector 2 quad))
            (row-3 (-> source-matrix vector 3 quad)))
       (set! (-> destination-matrix vector 0 quad) row-0)
       (set! (-> destination-matrix vector 1 quad) row-1)
       (set! (-> destination-matrix vector 2 quad) row-2)
       (set! (-> destination-matrix vector 3 quad) row-3)))
    ((and *camera-combiner* (not *external-cam-mode*))
     (set! (-> *math-camera* fov) (-> *camera-combiner* fov))
     (set! (-> *math-camera* trans quad) (-> *camera-combiner* trans quad))
     (+! (-> *math-camera* trans y) (get-no-update *camera-smush-control*))
     (let* ((destination-matrix (-> *math-camera* inv-camera-rot))
            (source-matrix (-> *camera-combiner* inv-camera-rot))
            (row-0 (-> source-matrix vector 0 quad))
            (row-1 (-> source-matrix vector 1 quad))
            (row-2 (-> source-matrix vector 2 quad))
            (row-3 (-> source-matrix vector 3 quad)))
       (set! (-> destination-matrix vector 0 quad) row-0)
       (set! (-> destination-matrix vector 1 quad) row-1)
       (set! (-> destination-matrix vector 2 quad) row-2)
       (set! (-> destination-matrix vector 3 quad) row-3))
     (let* ((destination-matrix *save-camera-inv-rot*)
            (source-matrix (-> *camera-combiner* inv-camera-rot))
            (row-0 (-> source-matrix vector 0 quad))
            (row-1 (-> source-matrix vector 1 quad))
            (row-2 (-> source-matrix vector 2 quad))
            (row-3 (-> source-matrix vector 3 quad)))
       (set! (-> destination-matrix vector 0 quad) row-0)
       (set! (-> destination-matrix vector 1 quad) row-1)
       (set! (-> destination-matrix vector 2 quad) row-2)
       (set! (-> destination-matrix vector 3 quad) row-3)))
    (else (move-camera-from-pad *math-camera*)))
  (matrix-transpose! (-> *math-camera* camera-rot) (-> *math-camera* inv-camera-rot))
  ;; 11650.845 GOAL angle units is 64 degrees.  Narrower fields of view
  ;; reduce the mip factor so zoomed views do not choose overly coarse mips;
  ;; wider views are capped at one.
  (cond
    (*camera-no-mip-correction* (set! (-> *math-camera* fov-correction-factor) 1.0))
    (else
     (let ((mip-fov (fmin 11650.845 (-> *math-camera* fov))))
       (set! (-> *math-camera* fov-correction-factor) (* 0.00008583069 mip-fov)))))
  ;; Blend from the saved orientation toward the current pose while smooth-t
  ;; decays.  Once complete, keep an exact copy of the current orientation.
  (if (< 0.0 (-> *math-camera* smooth-t))
    (set! (-> *math-camera* smooth-t) (- (-> *math-camera* smooth-t) (-> *math-camera* smooth-step))))
  (cond
    ((< 0.0 (-> *math-camera* smooth-t))
     (let ((smooth-rotation (new-stack-quaternion0)))
       (matrix->quaternion smooth-rotation (-> *math-camera* inv-camera-rot))
       (quaternion-slerp! smooth-rotation
                          smooth-rotation
                          (-> *math-camera* inv-camera-rot-smooth-from)
                          (-> *math-camera* smooth-t))
       (quaternion->matrix (-> *math-camera* inv-camera-rot-smooth) smooth-rotation)))
    (else
     (let* ((destination-matrix (-> *math-camera* inv-camera-rot-smooth))
            (source-matrix (-> *math-camera* inv-camera-rot))
            (row-0 (-> source-matrix vector 0 quad))
            (row-1 (-> source-matrix vector 1 quad))
            (row-2 (-> source-matrix vector 2 quad))
            (row-3 (-> source-matrix vector 3 quad)))
       (set! (-> destination-matrix vector 0 quad) row-0)
       (set! (-> destination-matrix vector 1 quad) row-1)
       (set! (-> destination-matrix vector 2 quad) row-2)
       (set! (-> destination-matrix vector 3 quad) row-3))))
  (if (and (!= *master-mode* 'menu) *display-camera-info*)
    (format *stdcon* "cam pos ~M ~M ~M~%" (-> *math-camera* trans x) (-> *math-camera* trans y) (-> *math-camera* trans z)))
  ;; Preserve the old view-projection before rebuilding it.  A reset instead
  ;; copies the new matrix afterward, suppressing one frame of camera motion.
  (when (zero? (-> *math-camera* reset))
    (let* ((previous-view-projection (-> *math-camera* prev-camera-temp))
           (view-projection (-> *math-camera* camera-temp))
           (row-0 (-> view-projection vector 0 quad))
           (row-1 (-> view-projection vector 1 quad))
           (row-2 (-> view-projection vector 2 quad))
           (row-3 (-> view-projection vector 3 quad)))
      (set! (-> previous-view-projection vector 0 quad) row-0)
      (set! (-> previous-view-projection vector 1 quad) row-1)
      (set! (-> previous-view-projection vector 2 quad) row-2)
      (set! (-> previous-view-projection vector 3 quad) row-3)))
  (let ((view-projection (-> *math-camera* camera-temp))
        (view-matrix (-> *math-camera* camera-rot))
        (inverse-view-matrix (-> *math-camera* inv-camera-rot))
        (camera-position (-> *math-camera* trans)))
    ;; Rigid inverse translation is -C transformed by the transposed
    ;; orientation.  The inverse view keeps C directly in its fourth row.
    (let ((negative-camera-position (new-stack-vector0)))
      (set! (-> negative-camera-position x) (- (-> camera-position x)))
      (set! (-> negative-camera-position y) (- (-> camera-position y)))
      (set! (-> negative-camera-position z) (- (-> camera-position z)))
      (set! (-> negative-camera-position w) 1.0)
      (vector-matrix*! negative-camera-position negative-camera-position view-matrix)
      (set! (-> view-matrix vector 3 quad) (-> negative-camera-position quad)))
    (matrix*! view-projection view-matrix (-> *math-camera* perspective))
    (set! (-> inverse-view-matrix vector 3 quad) (-> camera-position quad)))
  (when (nonzero? (-> *math-camera* reset))
    (let* ((previous-view-projection (-> *math-camera* prev-camera-temp))
           (view-projection (-> *math-camera* camera-temp))
           (row-0 (-> view-projection vector 0 quad))
           (row-1 (-> view-projection vector 1 quad))
           (row-2 (-> view-projection vector 2 quad))
           (row-3 (-> view-projection vector 3 quad)))
      (set! (-> previous-view-projection vector 0 quad) row-0)
      (set! (-> previous-view-projection vector 1 quad) row-1)
      (set! (-> previous-view-projection vector 2 quad) row-2)
      (set! (-> previous-view-projection vector 3 quad) row-3))
    (set! (-> *math-camera* reset) 0)
    0)
  ;; Publish the per-frame fog, homogeneous clipping, screen-offset, and
  ;; billboard projection constants used by the instance renderers.
  (let ((fog-min (-> *math-camera* fog-min))
        (fog-max (-> *math-camera* fog-max)))
    (let ((near-distance (-> *math-camera* d)))
      (set! (-> *instance-tie-work* hmge-d x) fog-min)
      (set! (-> *instance-tie-work* hmge-d y) fog-max)
      (set! (-> *instance-tie-work* hmge-d z) (* 32.0 near-distance))
      (set! (-> *instance-tie-work* hmge-d w) (* near-distance (-> *math-camera* hmge-scale w)))
      (let ((hvdf-offset (-> *math-camera* hvdf-off quad))) (set! (-> *instance-tie-work* hvdf-offset quad) hvdf-offset))
      (set! (-> *instance-shrub-work* hmge-d x) fog-min)
      (set! (-> *instance-shrub-work* hmge-d y) fog-max)
      (set! (-> *instance-shrub-work* hmge-d z) (* 3.0 near-distance))
      (set! (-> *instance-shrub-work* hmge-d w) (* near-distance (-> *math-camera* hmge-scale w)))
      (set! (-> *instance-shrub-work* billboard-const x)
            (/ (-> *math-camera* x-pix) (* near-distance (-> *math-camera* x-ratio))))
      (set! (-> *instance-shrub-work* billboard-const y)
            (/ (-> *math-camera* y-pix) (* near-distance (-> *math-camera* y-ratio)))))
    (set! (-> *instance-shrub-work* billboard-const z) fog-min)
    (set! (-> *instance-shrub-work* billboard-const w) fog-max))
  (set! (-> *instance-shrub-work* constants w) (the-as float (-> *math-camera* vis-gifs 0 fog0)))
  (let ((hvdf-offset (-> *math-camera* hvdf-off quad))) (set! (-> *instance-shrub-work* hvdf-offset quad) hvdf-offset))
  ;; The ordinary side planes cull the view frustum.  The four-times-wider
  ;; guard planes give TIE and shrub generation room around the visible area.
  (update-view-planes *math-camera* (-> *math-camera* plane) 1.0)
  (update-view-planes *math-camera* (-> *math-camera* guard-plane) 4.0)
  (set! (-> *instance-shrub-work* guard-plane 0 quad) (-> *math-camera* guard-plane 0 quad))
  (set! (-> *instance-shrub-work* guard-plane 1 quad) (-> *math-camera* guard-plane 1 quad))
  (set! (-> *instance-shrub-work* guard-plane 2 quad) (-> *math-camera* guard-plane 2 quad))
  (set! (-> *instance-shrub-work* guard-plane 3 quad) (-> *math-camera* guard-plane 3 quad))
  (set! (-> *instance-tie-work* guard-plane 0 quad) (-> *math-camera* guard-plane 0 quad))
  (set! (-> *instance-tie-work* guard-plane 1 quad) (-> *math-camera* guard-plane 1 quad))
  (set! (-> *instance-tie-work* guard-plane 2 quad) (-> *math-camera* guard-plane 2 quad))
  (set! (-> *instance-tie-work* guard-plane 3 quad) (-> *math-camera* guard-plane 3 quad))
  (update-visible *math-camera*)
  (if (not (paused?)) (update-wind *wind-work* *wind-scales*))
  #f)

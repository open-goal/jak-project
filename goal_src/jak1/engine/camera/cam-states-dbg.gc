;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/camera/camera.gc")
(require "pc/pckernel-impl.gc")

;; DECOMP BEGINS

(deftype cam-point-watch-bank (basic)
  ((speed     float)
   (rot-speed degrees)))

(define *CAM_POINT_WATCH-bank* (new 'static 'cam-point-watch-bank :speed 1600.0 :rot-speed (degrees 0.6)))

;; Point-watch keeps the camera at pivot-rad along the inverse viewing basis. Right stick turns that
;; basis around its local horizontal axis and world down; left stick y changes the radius, with R2
;; selecting the slower adjustment rate. Left stick x is read into the temporary translation but is
;; overwritten before placement and has no effect here. Rebuilding the inverse matrix from forward
;; and world down prevents roll from accumulating while the camera is being turned.
(defstate cam-point-watch (camera-slave)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('teleport) #f)
        (else
         (cam-standard-event-handler proc argc message block))))
  :enter
    (behavior ()
      (when (not (-> self enter-has-run))
        (set! (-> self pivot-rad) 40960.0)
        (set! (-> self blend-from-type) (camera-blend-to-type slave-controlled))
        (set! (-> self blend-to-type) (camera-blend-to-type slave-controlled))))
  :code
    (behavior ()
      (loop
        (let ((rotation-delta (new-stack-vector0))
              (translation-delta (new-stack-vector0)))
          (when *camera-read-analog*
            (let ((left-x-input (analog-input (the-as int (-> *cpad-list* cpads 0 leftx)) 128.0 48.0 110.0 -1.0))
                  (left-y-input (analog-input (the-as int (-> *cpad-list* cpads 0 lefty)) 128.0 48.0 110.0 -1.0))
                  (right-x-input (analog-input (the-as int (-> *cpad-list* cpads 0 rightx)) 128.0 48.0 110.0 -1.0))
                  (right-y-input (analog-input (the-as int (-> *cpad-list* cpads 0 righty)) 128.0 48.0 110.0 -1.0)))
              (cond
                ((cpad-hold? (-> *CAMERA-bank* joypad) r2)
                 (set! (-> rotation-delta y) (- (-> rotation-delta y) (* (/ (-> *CAM_POINT_WATCH-bank* rot-speed) 5) (- right-x-input))))
                 (set! (-> rotation-delta x) (- (-> rotation-delta x) (* (/ (-> *CAM_POINT_WATCH-bank* rot-speed) 5) (- right-y-input))))
                 (+! (-> translation-delta x) (* (/ (-> *CAM_POINT_WATCH-bank* speed) 5) left-x-input))
                 (+! (-> translation-delta z) (* (/ (-> *CAM_POINT_WATCH-bank* speed) 5) left-y-input)))
                (else
                 (set! (-> rotation-delta y) (- (-> rotation-delta y) (* 2.0 (-> *CAM_POINT_WATCH-bank* rot-speed) (- right-x-input))))
                 (set! (-> rotation-delta x) (- (-> rotation-delta x) (* 2.0 (-> *CAM_POINT_WATCH-bank* rot-speed) (- right-y-input))))
                 (+! (-> translation-delta x) (* 2.0 (-> *CAM_POINT_WATCH-bank* speed) left-x-input))
                 (+! (-> translation-delta z) (* 2.0 (-> *CAM_POINT_WATCH-bank* speed) left-y-input)))))
            (let ((forward (new-stack-vector0)))
              (let ((rotation-matrix (new-stack-matrix0)))
                (matrix-axis-angle! rotation-matrix (-> self tracking inv-mat vector 0) (- (-> rotation-delta x)))
                (vector-matrix*! forward (-> self tracking inv-mat vector 2) rotation-matrix)
                (matrix-axis-angle! rotation-matrix (-> *camera* local-down) (- (-> rotation-delta y)))
                (vector-matrix*! forward forward rotation-matrix))
              (forward-down->inv-matrix (-> self tracking inv-mat) forward (-> *camera* local-down)))
            (set! (-> self pivot-rad) (- (-> self pivot-rad) (-> translation-delta z)))
            (if (< (-> self pivot-rad) 4096.0)
                (set! (-> self pivot-rad) 4096.0))
            (set-vector! translation-delta 0.0 0.0 (- (-> self pivot-rad)) 1.0)
            (vector-matrix*! (-> self trans) translation-delta (-> self tracking inv-mat))))
        (suspend)
        0)))

(deftype cam-free-bank (basic)
  ((speed     float)
   (rot-speed degrees)))

(define *CAM_FREE-bank* (new 'static 'cam-free-bank :speed 1600.0 :rot-speed (degrees 0.6)))

;; Free-camera controls are accumulated in camera-local coordinates. X/Triangle pitch, Square/Circle
;; yaw, and—when roll is allowed—L2/R2 roll. The d-pad translates laterally and forward/backward;
;; L1/R1 translate vertically when *cam-free-move-along-z* is enabled. The sticks combine left-stick
;; translation with right-stick pitch/yaw. Holding R2 selects fine motion, while L2 uses right-stick
;; y as vertical translation instead of pitch. Button pressure is added to the base digital rate so
;; the controls remain useful with either digital or pressure-sensitive pads.
(defun cam-free-floating-input ((rotation-delta vector) (translation-delta vector) (allow-roll? symbol) (controller-index int))
  "Accumulate one frame of free-camera rotation and local
   translation from controller-index. Buttons provide digital motion with pressure-sensitive speed,
   while the sticks provide simultaneous translation and rotation. allow-roll? enables L2 and R2
   roll; the load-boundary display may also accept translation from controller one. Scale both
   outputs by the display time adjustment before returning."
  (when (and (!= *master-mode* 'menu) (not *cam-layout*))
    (when *camera-read-buttons*
      (if (cpad-hold? controller-index x)
        (set! (-> rotation-delta x)
              (- (-> rotation-delta x)
                 (+ (-> *CAM_FREE-bank* rot-speed)
                    (analog-input (the-as int (-> *cpad-list* cpads controller-index abutton (abutton-idx x))) ;; og:preserve-this abutton indexing
                                  0.0
                                  32.0
                                  230.0
                                  (-> *CAM_FREE-bank* rot-speed)))))))
    (when *camera-read-buttons*
      (if (cpad-hold? controller-index triangle)
        (+! (-> rotation-delta x)
            (+ (-> *CAM_FREE-bank* rot-speed)
               (analog-input (the-as int (-> *cpad-list* cpads controller-index abutton (abutton-idx triangle))) ;; og:preserve-this abutton indexing
                             0.0
                             32.0
                             230.0
                             (-> *CAM_FREE-bank* rot-speed))))))
    (when *camera-read-buttons*
      (if (cpad-hold? controller-index square)
        (+! (-> rotation-delta y)
            (+ (-> *CAM_FREE-bank* rot-speed)
               (analog-input (the-as int (-> *cpad-list* cpads controller-index abutton (abutton-idx square))) ;; og:preserve-this abutton indexing
                             0.0
                             32.0
                             230.0
                             (-> *CAM_FREE-bank* rot-speed))))))
    (when *camera-read-buttons*
      (if (cpad-hold? controller-index circle)
        (set! (-> rotation-delta y)
              (- (-> rotation-delta y)
                 (+ (-> *CAM_FREE-bank* rot-speed)
                    (analog-input (the-as int (-> *cpad-list* cpads controller-index abutton (abutton-idx circle))) ;; og:preserve-this abutton indexing
                                  0.0
                                  32.0
                                  230.0
                                  (-> *CAM_FREE-bank* rot-speed))))))))
  (when allow-roll?
    (when *camera-read-buttons*
      (if (cpad-hold? controller-index l2)
        (+! (-> rotation-delta z)
            (+ (-> *CAM_FREE-bank* rot-speed)
               (analog-input (the-as int (-> *cpad-list* cpads controller-index abutton (abutton-idx l2))) ;; og:preserve-this abutton indexing
                             0.0
                             32.0
                             230.0
                             (-> *CAM_FREE-bank* rot-speed))))))
    (when *camera-read-buttons*
      (if (cpad-hold? controller-index r2)
        (set! (-> rotation-delta z)
              (- (-> rotation-delta z)
                 (+ (-> *CAM_FREE-bank* rot-speed)
                    (analog-input (the-as int (-> *cpad-list* cpads controller-index abutton (abutton-idx r2))) ;; og:preserve-this abutton indexing
                                  0.0
                                  32.0
                                  230.0
                                  (-> *CAM_FREE-bank* rot-speed))))))))
  (cond
    ((not *cam-free-move-along-z*))
    ((not *camera-read-analog*))
    ((cpad-hold? controller-index r2)
     (when *camera-read-buttons*
       (if (cpad-hold? controller-index r1)
         (+! (-> translation-delta y)
             (+ (/ (-> *CAM_FREE-bank* speed) 5)
                (analog-input (the-as int (-> *cpad-list* cpads controller-index abutton (abutton-idx r1))) ;; og:preserve-this abutton indexing
                              0.0
                              32.0
                              230.0
                              (/ (-> *CAM_FREE-bank* speed) 5))))))
     (when *camera-read-buttons*
       (if (cpad-hold? controller-index l1)
         (set! (-> translation-delta y)
               (- (-> translation-delta y)
                  (+ (/ (-> *CAM_FREE-bank* speed) 5)
                     (analog-input (the-as int (-> *cpad-list* cpads controller-index abutton (abutton-idx l1))) ;; og:preserve-this abutton indexing
                                   0.0
                                   32.0
                                   230.0
                                   (/ (-> *CAM_FREE-bank* speed) 5))))))))
    (else
     (when *camera-read-buttons*
       (if (cpad-hold? controller-index r1)
         (+! (-> translation-delta y)
             (+ (-> *CAM_FREE-bank* speed)
                (analog-input (the-as int (-> *cpad-list* cpads controller-index abutton (abutton-idx r1))) ;; og:preserve-this abutton indexing
                              0.0
                              32.0
                              230.0
                              (-> *CAM_FREE-bank* speed))))))
     (when *camera-read-buttons*
       (if (cpad-hold? controller-index l1)
         (set! (-> translation-delta y)
               (- (-> translation-delta y)
                  (+ (-> *CAM_FREE-bank* speed)
                     (analog-input (the-as int (-> *cpad-list* cpads controller-index abutton (abutton-idx l1))) ;; og:preserve-this abutton indexing
                                   0.0
                                   32.0
                                   230.0
                                   (-> *CAM_FREE-bank* speed)))))))))
  (when (and (!= *master-mode* 'menu) (not *cam-layout*))
    (when *camera-read-buttons*
      (if (cpad-hold? controller-index left)
        (+! (-> translation-delta x)
            (+ (-> *CAM_FREE-bank* speed)
               (analog-input (the-as int (-> *cpad-list* cpads controller-index abutton (abutton-idx left))) ;; og:preserve-this abutton indexing
                             0.0
                             32.0
                             230.0
                             (-> *CAM_FREE-bank* speed))))))
    (when *camera-read-buttons*
      (if (cpad-hold? controller-index right)
        (set! (-> translation-delta x)
              (- (-> translation-delta x)
                 (+ (-> *CAM_FREE-bank* speed)
                    (analog-input (the-as int (-> *cpad-list* cpads controller-index abutton (abutton-idx right))) ;; og:preserve-this abutton indexing
                                  0.0
                                  32.0
                                  230.0
                                  (-> *CAM_FREE-bank* speed)))))))
    (when *camera-read-buttons*
      (if (cpad-hold? controller-index up)
        (+! (-> translation-delta z)
            (+ (-> *CAM_FREE-bank* speed)
               (analog-input (the-as int (-> *cpad-list* cpads controller-index abutton (abutton-idx up))) ;; og:preserve-this abutton indexing
                             0.0
                             32.0
                             230.0
                             (-> *CAM_FREE-bank* speed))))))
    (when *camera-read-buttons*
      (if (cpad-hold? controller-index down)
        (set! (-> translation-delta z)
              (- (-> translation-delta z)
                 (+ (-> *CAM_FREE-bank* speed)
                    (analog-input (the-as int (-> *cpad-list* cpads controller-index abutton (abutton-idx down))) ;; og:preserve-this abutton indexing
                                  0.0
                                  32.0
                                  230.0
                                  (-> *CAM_FREE-bank* speed))))))))
  (when *camera-read-analog*
    (let ((left-x-input (analog-input (the-as int (-> *cpad-list* cpads controller-index leftx)) 128.0 48.0 110.0 -1.0))
          (left-y-input (analog-input (the-as int (-> *cpad-list* cpads controller-index lefty)) 128.0 48.0 110.0 -1.0))
          (right-x-input (analog-input-horizontal-first (the-as int (-> *cpad-list* cpads controller-index rightx)) 128.0 48.0 110.0 -1.0)) ;; og:preserve-this changed for pc port
          (right-y-input (analog-input-vertical-first (the-as int (-> *cpad-list* cpads controller-index righty)) 128.0 48.0 110.0 -1.0)) ;; og:preserve-this changed for pc port
          )
      (when *display-load-boundaries*
        (when (and (!= controller-index 1)
                   (not (cpad-hold? 1 x))
                   (not (cpad-hold? 1 r1))
                   (not (logtest? (-> *cpad-list* cpads 1 button0-abs 0) (pad-buttons r2))))
          (+! left-x-input (analog-input (the-as int (-> *cpad-list* cpads 1 leftx)) 128.0 48.0 110.0 -1.0))
          (+! left-y-input (analog-input (the-as int (-> *cpad-list* cpads 1 lefty)) 128.0 48.0 110.0 -1.0))
          (+! right-x-input (analog-input (the-as int (-> *cpad-list* cpads 1 rightx)) 128.0 48.0 110.0 -1.0))
          (+! right-y-input (analog-input (the-as int (-> *cpad-list* cpads 1 righty)) 128.0 48.0 110.0 -1.0))))
      (cond
        ((cpad-hold? controller-index r2)
         (cond
           ((cpad-hold? controller-index l2)
            (set! (-> rotation-delta y) (- (-> rotation-delta y) (* (/ (-> *CAM_FREE-bank* rot-speed) 2) (- right-x-input))))
            (set! (-> rotation-delta x) (- (-> rotation-delta x) (* (/ (-> *CAM_FREE-bank* rot-speed) 2) (- right-y-input)))))
           (else
            (set! (-> rotation-delta y) (- (-> rotation-delta y) (* (- right-x-input) (-> *CAM_FREE-bank* rot-speed))))
            (set! (-> rotation-delta x) (- (-> rotation-delta x) (* (- right-y-input) (-> *CAM_FREE-bank* rot-speed))))))
         (+! (-> translation-delta x) (* (/ (-> *CAM_FREE-bank* speed) 5) left-x-input))
         (+! (-> translation-delta z) (* (/ (-> *CAM_FREE-bank* speed) 5) left-y-input)))
        ((cpad-hold? controller-index l2)
         (+! (-> translation-delta x) (* left-x-input (-> *CAM_FREE-bank* speed)))
         (+! (-> translation-delta y) (* right-y-input (-> *CAM_FREE-bank* speed)))
         (+! (-> translation-delta z) (* left-y-input (-> *CAM_FREE-bank* speed))))
        (else
         (set! (-> rotation-delta y) (- (-> rotation-delta y) (* 2.0 (-> *CAM_FREE-bank* rot-speed) (- right-x-input))))
         (set! (-> rotation-delta x) (- (-> rotation-delta x) (* 2.0 (-> *CAM_FREE-bank* rot-speed) (- right-y-input))))
         (+! (-> translation-delta x) (* 2.0 (-> *CAM_FREE-bank* speed) left-x-input))
         (+! (-> translation-delta z) (* 2.0 (-> *CAM_FREE-bank* speed) left-y-input))))))
  (vector-float*! rotation-delta rotation-delta (-> *display* time-adjust-ratio))
  (vector-float*! translation-delta translation-delta (-> *display* time-adjust-ratio)))

(deftype camera-free-floating-move-info (structure)
  ((rv vector :inline)
   (tv vector :inline)
   (up vector :inline)
   (tm matrix :inline)))

;; With an up vector, yaw is performed about that fixed axis and the basis is rebuilt after crossing
;; its pole so the camera stays upright. Without one, yaw is around the camera's own up axis and roll
;; remains free. Pitch and roll always follow in local space, then the accumulated local translation
;; is transformed by the finished basis.
(defun cam-free-floating-move ((camera-matrix matrix) (camera-position vector) (up vector) (controller-index int))
  "Apply free-camera input to a camera matrix and position.
   Preserve the chosen up direction while yawing when one is supplied; otherwise allow unrestricted
   yaw. Pitch and roll are then applied in camera-local axes before the local translation is rotated
   into world space. Return false when the controller is invalid or menus own the camera."
  (if (logtest? (-> *cpad-list* cpads controller-index valid) 128)
      (return (the-as vector #f)))
  (if (= *master-mode* 'menu)
      (return (the-as vector #f)))
  (let ((move-info (new 'stack 'camera-free-floating-move-info)))
    (cam-free-floating-input (-> move-info rv) (-> move-info tv) (not up) controller-index)
    (cond
      (up
       (matrix-axis-angle! (-> move-info tm) up (-> move-info rv y))
       (matrix*! camera-matrix camera-matrix (-> move-info tm))
       (cond
         ((< (vector-dot (-> camera-matrix vector 1) up) 0.0)
          (forward-down->inv-matrix camera-matrix (-> camera-matrix vector 2) up))
         (else
          (vector-negate! (-> move-info up) up)
          (forward-down->inv-matrix camera-matrix (-> camera-matrix vector 2) (-> move-info up)))))
      (else
       (matrix-axis-angle! (-> move-info tm) (-> camera-matrix vector 1) (- (-> move-info rv y)))
       (matrix*! camera-matrix camera-matrix (-> move-info tm))))
    (matrix-axis-angle! (-> move-info tm) (-> camera-matrix vector 0) (- (-> move-info rv x)))
    (matrix*! camera-matrix camera-matrix (-> move-info tm))
    (matrix-axis-angle! (-> move-info tm) (-> camera-matrix vector 2) (- (-> move-info rv z)))
    (matrix*! camera-matrix camera-matrix (-> move-info tm))
    (vector-matrix*! (-> move-info tv) (-> move-info tv) camera-matrix)
    (vector+! camera-position camera-position (-> move-info tv))))

;; The free-floating slave normally uses world down as its upright constraint. Option bit 3 removes
;; that constraint, allowing cam-free-floating-input's L2/R2 roll controls and unrestricted tumbling.
;; Entering this state also stops the combiner's target tracking so the matrix and translation remain
;; entirely under the pad.
(defstate cam-free-floating (camera-slave)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('teleport) #f)
        (else
         (cam-standard-event-handler proc argc message block))))
  :enter
    (behavior ()
      (when (not (-> self enter-has-run))
        (set! (-> self blend-from-type) (camera-blend-to-type slave-controlled))
        (set! (-> self blend-to-type) (camera-blend-to-type slave-controlled))
        (send-event *camera-combiner* 'stop-tracking)))
  :code
    (behavior ()
      (loop
        (let ((up (-> *camera* local-down)))
          (if (logtest? (-> self options) (cam-slave-options ALLOW_Z_ROT))
              (set! up (the-as vector #f)))
          (cam-free-floating-move (-> self tracking inv-mat) (-> self trans) up (the-as int (-> *CAMERA-bank* joypad))))
        (suspend))))

(deftype camera-orbit-info (structure)
  ((radius      float)
   (rot         float)
   (target-off  vector :inline)
   (orbit-off   vector :inline)
   (radius-lerp float)))


(deftype CAM_ORBIT-bank (basic)
  ((RADIUS_MAX        float)
   (RADIUS_MIN        float)
   (TARGET_OFF_ADJUST float)
   (ORBIT_OFF_ADJUST  float)))


(define *CAM_ORBIT-bank*
  (new 'static 'CAM_ORBIT-bank :RADIUS_MAX 61440.0 :RADIUS_MIN 409.6 :TARGET_OFF_ADJUST 81.92 :ORBIT_OFF_ADJUST 81.92))

(define *camera-orbit-info* (new 'static 'camera-orbit-info))

(set! (-> *camera-orbit-info* radius-lerp) 0.45)

(set! (-> *camera-orbit-info* target-off y) 4096.0)

(set! (-> *camera-orbit-info* orbit-off y) 4096.0)

;; Orbit places the camera at a controllable radius and heading around *camera-orbit-target*. Right
;; stick y changes a normalized radius parameter, clamped to [0, 1] before interpolation between the
;; bank limits; right stick x turns at up to 120 degrees per second. L1/R1 adjust the camera's own
;; vertical offset, or the tracked look-point offset while L2 is held. The final basis looks from the
;; offset camera position toward the independently offset target point and deliberately carries no
;; roll. Losing the target returns control to the free-floating camera.
(defstate cam-orbit (camera-slave)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('teleport) #f)
        (else
         (cam-standard-event-handler proc argc message block))))
  :enter
    (behavior ()
      (when (not (-> self enter-has-run))
        (if (not *camera-orbit-target*)
            (cam-slave-go cam-free-floating))
        (let ((target-to-camera (new-stack-vector0)))
          (vector-! target-to-camera (-> self trans) (-> *camera-orbit-target* 0 root trans))
          (set! (-> *camera-orbit-info* rot) (atan (-> target-to-camera x) (-> target-to-camera z))))
        (set! (-> self blend-from-type) (camera-blend-to-type slave-controlled))
        (set! (-> self blend-to-type) (camera-blend-to-type slave-controlled))))
  :exit
    (behavior ()
      '())
  :code
    (behavior ()
      (loop
        (if (not *camera-orbit-target*)
            (cam-slave-go cam-free-floating))
        (when *camera-read-analog*
          (let ((zoom-input (analog-input (the-as int (-> *cpad-list* cpads 0 righty)) 128.0 32.0 110.0 0.05)))
            (cond
              ((< (* 0.05 (- 1.0 (-> *camera-orbit-info* radius-lerp))) zoom-input)
               (+! (-> *camera-orbit-info* radius-lerp) (* 0.05 (- 1.0 (-> *camera-orbit-info* radius-lerp)))))
              ((< zoom-input (* 0.05 (- (-> *camera-orbit-info* radius-lerp))))
               (+! (-> *camera-orbit-info* radius-lerp) (* 0.05 (- (-> *camera-orbit-info* radius-lerp)))))
              (else
               (+! (-> *camera-orbit-info* radius-lerp) zoom-input))))
          (set! (-> *camera-orbit-info* radius)
                (lerp (-> *CAM_ORBIT-bank* RADIUS_MIN) (-> *CAM_ORBIT-bank* RADIUS_MAX) (-> *camera-orbit-info* radius-lerp))))
        (cond
          ((cpad-hold? 0 l2)
           (if (cpad-hold? 0 l1)
               (set! (-> *camera-orbit-info* target-off y)
                     (- (-> *camera-orbit-info* target-off y) (-> *CAM_ORBIT-bank* TARGET_OFF_ADJUST))))
           (if (cpad-hold? 0 r1)
               (+! (-> *camera-orbit-info* target-off y) (-> *CAM_ORBIT-bank* TARGET_OFF_ADJUST))))
          (else
           (if (cpad-hold? 0 l1)
               (set! (-> *camera-orbit-info* orbit-off y)
                     (- (-> *camera-orbit-info* orbit-off y) (-> *CAM_ORBIT-bank* ORBIT_OFF_ADJUST))))
           (if (cpad-hold? 0 r1)
               (+! (-> *camera-orbit-info* orbit-off y) (-> *CAM_ORBIT-bank* ORBIT_OFF_ADJUST)))))
        (when *camera-read-analog*
          (let ((orbit-input (analog-input (the-as int (-> *cpad-list* cpads 0 rightx)) 128.0 32.0 110.0 (* 21845.334 (seconds-per-frame)))))
            (set! (-> *camera-orbit-info* rot) (the float (sar (shl (the int (+ (-> *camera-orbit-info* rot) orbit-input)) 48) 48)))))
        (let ((camera-angles (new-stack-vector0)))
          (let ((target-to-camera (new-stack-vector0)))
            (set-vector! (-> self trans)
                         (+ (-> *camera-orbit-target* 0 root trans x) (* (sin (-> *camera-orbit-info* rot)) (-> *camera-orbit-info* radius)))
                         (-> *camera-orbit-target* 0 root trans y)
                         (+ (-> *camera-orbit-target* 0 root trans z) (* (cos (-> *camera-orbit-info* rot)) (-> *camera-orbit-info* radius)))
                         1.0)
            (vector+! (-> self trans) (-> self trans) (-> *camera-orbit-info* orbit-off))
            (vector+! (-> self tracking follow-pt) (-> *camera-orbit-target* 0 root trans) (-> *camera-orbit-info* target-off))
            (vector-! target-to-camera (-> self trans) (-> self tracking follow-pt))
            (set! (-> camera-angles y)
                  (the float (sar (shl (the int (+ 32768.0 (atan (-> target-to-camera x) (-> target-to-camera z)))) 48) 48)))
            (set! (-> camera-angles x) (atan (-> target-to-camera y) (vector-xz-length target-to-camera))))
          (set! (-> camera-angles z) 0.0)
          (matrix-rotate-zxy! (-> self tracking inv-mat) camera-angles))
        (suspend))))

;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/game/game-h.gc")
(defenum pov-camera-flag
  :bitfield #t
  :type int32
  ;; Notify the owner with abort-request when playback is interrupted.
  (notify-of-abort 0)
  ;; Allow check-for-abort to finish playback without waiting for controller input.
  (allow-abort 1)
  ;; Start with the owner's orientation instead of the identity orientation.
  (inherit-orientation 2))

(declare-type pov-camera process-drawable)

(define-extern pov-camera-init-by-other
  "Initialize a point-of-view camera with a resident or streamed animation, abort and orientation
   flags, an owner for notifications, and an optional timed command list."
  (function vector skeleton-group basic pov-camera-flag process-drawable pair none :behavior pov-camera))

;; DECOMP BEGINS

;; A pov-camera plays the short camera animations used for noninteractive views,
;; such as introducing a collectible or showing the route to a new area. It
;; temporarily takes control of the target and view, applies movie audio levels
;; and process masks, and restores normal play when the animation ends.
;;
;; String animations are loaded from the camera skeleton's art group and may run
;; a timed command list alongside playback. A spool-anim instead describes a
;; streamed animation. The broad basic type on anim-name is required to hold
;; either form.
(deftype pov-camera (process-drawable)
  (;; The animated camera's cspace nodes occupy the drawable root storage.
   (cspace-array        cspace-array :overlay-at root)
   (flags               pov-camera-flag)
   ;; Controller aborts are ignored briefly after playback begins.
   (debounce-start-time time-frame)
   ;; Owner notified when playback aborts or completes.
   (notify-handle       handle)
   ;; A camera animation name or a spool-anim.
   (anim-name           basic)
   ;; Timed commands accompanying an in-memory animation.
   (command-list        pair)
   ;; Processes suppressed while othercam owns the view.
   (mask-to-clear       process-mask)
   ;; Relative movie-mode audio levels, expressed as percentages.
   (music-volume-movie  float)
   (sfx-volume-movie    float))
  (:state-methods
   pov-camera-abort
   pov-camera-done-playing
   pov-camera-playing
   pov-camera-start-playing
   pov-camera-startup)
  (:methods
   (check-for-abort "Consume an allowed abort and notify the owner when requested." (_type_) symbol)
   (target-grabbed? "Return whether the target has yielded control to this camera." (_type_) symbol)
   (pre-startup-callback "Run subtype setup immediately before startup." (_type_) none)
   (target-released? "Return whether the target has resumed normal control." (_type_) symbol)
   (set-stack-size! "Let a subtype select its process stack size." (_type_) none)))

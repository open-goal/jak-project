;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "kernel-defs.gc")

;; DECOMP BEGINS

;; GOAL uses the convention or row-major matrices, but row-vector points

;;  [ Xx  Xy  Xz  0 ]   local X basis row
;;  [ Yx  Yy  Yz  0 ]   local Y basis row
;;  [ Zx  Zy  Zz  0 ]   local Z basis row
;;  [ Tx  Ty  Tz  1 ]   translation row

;; with pt' = pt * M

;; A row-major 4x4 matrix. Some operations require an affine transform, and the
;; fastest inverse operations additionally require rotation without scale or shear.
(deftype matrix (structure)
  ((vector vector 4 :inline :offset 0)
   (quad   uint128 4 :overlay-at vector)
   (data   float 16 :overlay-at vector))
  (:methods
   (transform-vectors! (_type_ (inline-array vector) (inline-array vector) int) none)))

;; A row-major 3x3 matrix stored as three padded four-float rows.
(deftype matrix3 (structure)
  ((data   float 12)
   (vector vector 3 :inline :overlay-at (-> data 0))
   (quad   uint128 3 :overlay-at (-> data 0))))

;; A 4x4 matrix packed into signed halfwords. Producers such as tie and shrub use
;; a different fixed-point scale for the affine translation row, so consumers must
;; know the packing convention before converting it to floats.
(deftype matrix4h (structure)
  ((data     int16 16)
   (vector4h vector4h 4 :inline :overlay-at (-> data 0))
   (long     int64 4 :overlay-at (-> data 0))))

(defun matrix-copy! ((dst matrix) (src matrix))
  "Copy all four aligned rows from src to dst and return dst."
  (declare (inline))
  (let ((row0 (-> src vector 0 quad))
        (row1 (-> src vector 1 quad))
        (row2 (-> src vector 2 quad))
        (row3 (-> src vector 3 quad)))
    (set! (-> dst vector 0 quad) row0)
    (set! (-> dst vector 1 quad) row1)
    (set! (-> dst vector 2 quad) row2)
    (set! (-> dst vector 3 quad) row3))
  dst)

(defmacro new-stack-matrix0 ()
  "Allocate a zeroed matrix on the stack without calling the constructor."
  (with-gensyms (value)
    `(let ((,value (new 'stack-no-clear 'matrix)))
      (set! (-> ,value quad 0) (the-as uint128 0))
      (set! (-> ,value quad 1) (the-as uint128 0))
      (set! (-> ,value quad 2) (the-as uint128 0))
      (set! (-> ,value quad 3) (the-as uint128 0))
      ,value)))

;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/math/quaternion-h.gc")
(require "engine/math/matrix.gc")

;; DECOMP BEGINS

(defmethod inspect ((this quaternion))
  "Print a quaternion. Prints the values and axis-angle"
  (format #t "[~8x] quaternion~%" this)
  (format #t "~T[~F] [~F] [~F] [~F]~%" (-> this x) (-> this y) (-> this z) (-> this w))
  (let ((f0-5 (/ 1.0 (sqrtf (+ (* (-> this x) (-> this x)) (* (-> this y) (-> this y)) (* (-> this z) (-> this z)))))))
    (format #t "~Taxis: ~F ~F ~F" (* f0-5 (-> this x)) (* f0-5 (-> this y)) (* f0-5 (-> this z))))
  (let ((f0-9 (* 2.0 (acos (-> this w))))) (format #t "~T~Tangle: (deg ~R)~%" f0-9))
  this)

(defun quaternion-axis-angle! ((dst quaternion) (x float) (y float) (z float) (angle float))
  "Construct a quaternion from an axis and angle. The axis should be normalized."
  (let* ((half-angle (* 0.5 angle))
         (sin-half-angle (sin half-angle))
         (cos-half-angle (cos half-angle)))
    (set! (-> dst x) (* x sin-half-angle))
    (set! (-> dst y) (* y sin-half-angle))
    (set! (-> dst z) (* z sin-half-angle))
    (set! (-> dst w) cos-half-angle))
  dst)

(defun quaternion-vector-angle! ((dst quaternion) (axis vector) (angle float))
  "Construct a quaternion from an axis and angle. The axis should be normalized."
  (let* ((half-angle (* 0.5 angle))
         (sin-half-angle (sin half-angle))
         (cos-half-angle (cos half-angle)))
    (set! (-> dst x) (* (-> axis x) sin-half-angle))
    (set! (-> dst y) (* (-> axis y) sin-half-angle))
    (set! (-> dst z) (* (-> axis z) sin-half-angle))
    (set! (-> dst w) cos-half-angle))
  dst)

(defun vector-angle<-quaternion! ((dst vector) (src quaternion))
  "Convert normalized src to an axis in dst.xyz and a radian angle in dst.w. Identity rotations make the axis normalization singular."
  (let* ((f0-0 1.0)
         (f1-0 1.0)
         (f2-0 (-> src w))
         (inverse-axis-length (/ f0-0 (sqrtf (- f1-0 (* f2-0 f2-0)))))
         (angle-rad (* 2.0 (acos-rad (-> src w)))))
    (set! (-> dst x) (* (-> src x) inverse-axis-length))
    (set! (-> dst y) (* (-> src y) inverse-axis-length))
    (set! (-> dst z) (* (-> src z) inverse-axis-length))
    (set! (-> dst w) angle-rad))
  dst)

(defun quaternion-zero! ((dst quaternion))
  "Set all four components of dst to zero."
  (set! (-> dst vec quad) (the-as uint128 0))
  dst)

(defun quaternion-identity! ((dst quaternion))
  "Set dst to the identity quaternion (0, 0, 0, 1)."
  (set! (-> dst vec quad) (the-as uint128 0))
  (set! (-> dst w) 1.0)
  dst)

(defun quaternion-i! ((dst quaternion))
  "Set dst to the unit i quaternion."
  (set! (-> dst vec quad) (the-as uint128 0))
  (set! (-> dst x) 1.0)
  dst)

(defun quaternion-j! ((dst quaternion))
  "Create unit j quaternion."
  (set! (-> dst vec quad) (the-as uint128 0))
  (set! (-> dst y) 1.0)
  dst)

(defun quaternion-k! ((dst quaternion))
  "Set dst to the unit k quaternion."
  (set! (-> dst vec quad) (the-as uint128 0))
  (set! (-> dst z) 1.0)
  dst)

(defun quaternion-copy! ((dst quaternion) (src quaternion))
  "Copy src to dst."
  (set! (-> dst vec quad) (-> src vec quad))
  dst)

(defun quaternion-set! ((dst quaternion) (x float) (y float) (z float) (w float))
  "Set the four components of dst."
  (set! (-> dst x) x)
  (set! (-> dst y) y)
  (set! (-> dst z) z)
  (set! (-> dst w) w)
  dst)

(defun quaternion+! ((dst quaternion) (a quaternion) (b quaternion))
  "Add quaternions as vectors."
  (rlet ((vf1 :class vf)
         (vf2 :class vf))
    (.lvf vf1 (&-> a vec quad))
    (.lvf vf2 (&-> b vec quad))
    (.add.vf vf1 vf1 vf2)
    (.svf (&-> dst vec quad) vf1)
    dst))

(defun quaternion-! ((dst quaternion) (a quaternion) (b quaternion))
  "Subtract quaternions as vectors."
  (rlet ((vf1 :class vf)
         (vf2 :class vf))
    (.lvf vf1 (&-> a vec quad))
    (.lvf vf2 (&-> b vec quad))
    (.sub.vf vf1 vf1 vf2)
    (.svf (&-> dst vec quad) vf1)
    dst))

(defun quaternion-negate! ((dst quaternion) (src quaternion))
  "Set dst = -src."
  (rlet ((vf1 :class vf)
         (vf2 :class vf))
    (.lvf vf1 (&-> src vec quad))
    ;; og:preserve-this
    ;; A subtract cannot reliably make zero on the host when a stale lane is NaN.
    (.xor.vf vf2 vf2 vf2)
    (.sub.vf vf1 vf2 vf1)
    (.svf (&-> dst vec quad) vf1)
    dst))

(defun quaternion-conjugate! ((dst quaternion) (src quaternion))
  "Conjugate src into dst by negating xyz. For a unit quaternion this is its inverse rotation."
  (rlet ((vf1 :class vf)
         (vf2 :class vf))
    (.lvf vf1 (&-> src vec quad))
    ;; og:preserve-this
    ;; Clear with XOR so stale host SIMD NaNs cannot survive a subtract-from-self.
    (.xor.vf vf2 vf2 vf2)
    (.sub.vf.xyz vf2 vf2 vf1)
    (.add.vf.w vf2 vf2 vf1)
    (.svf (&-> dst vec quad) vf2)
    dst))

(defun quaternion-float*! ((dst quaternion) (src quaternion) (scalar float))
  "Multiply every component of src by scalar into dst."
  (rlet ((vf1 :class vf)
         (vf2 :class vf))
    (.lvf vf1 (&-> src vec quad))
    (.mov vf2 scalar)
    (.mul.x.vf vf1 vf1 vf2)
    (.svf (&-> dst vec quad) vf1)
    dst))

(defun quaternion-float/! ((dst quaternion) (src quaternion) (divisor float))
  "Divide every component of src by divisor into dst."
  (let ((f0-1 (/ 1.0 divisor))) (quaternion-float*! dst src f0-1))
  dst)

(defun quaternion-norm2 ((q quaternion))
  "Return the squared four-dimensional norm of q."
  (local-vars (v0-0 float))
  (rlet ((acc :class vf)
         (vf0 :class vf)
         (vf1 :class vf))
    (init-vf0-vector)
    (.lvf vf1 (&-> q vec quad))
    (.mul.vf vf1 vf1 vf1)
    (.add.z.vf.w acc vf1 vf1)
    (.add.mul.y.vf.w acc vf0 vf1 acc)
    (.add.mul.x.vf.w vf1 vf0 vf1 acc)
    (.add.w.vf vf1 vf0 vf1)
    (.mov v0-0 vf1)
    v0-0))

(defun quaternion-norm ((q quaternion))
  "Return the four-dimensional norm of q."
  (local-vars (v1-1 float))
  (rlet ((acc :class vf)
         (vf0 :class vf)
         (vf1 :class vf))
    (init-vf0-vector)
    (.lvf vf1 (&-> q vec quad))
    (.mul.vf vf1 vf1 vf1)
    (.add.z.vf.w acc vf1 vf1)
    (.add.mul.y.vf.w acc vf0 vf1 acc)
    (.add.mul.x.vf.w vf1 vf0 vf1 acc)
    (.add.w.vf vf1 vf0 vf1)
    (.mov v1-1 vf1)
    (sqrtf v1-1)))

(defun quaternion-normalize! ((q quaternion))
  "Normalize q in place. A zero quaternion is invalid input."
  (rlet ((acc :class vf)
         (Q :class vf)
         (vf0 :class vf)
         (vf1 :class vf)
         (vf2 :class vf))
    (init-vf0-vector)
    (.lvf vf1 (&-> q vec quad))
    (.mul.vf vf2 vf1 vf1)
    (.add.z.vf.w acc vf2 vf2)
    (.add.mul.y.vf.w acc vf0 vf2 acc)
    (.add.mul.x.vf.w vf2 vf0 vf2 acc)
    (.isqrt.vf Q vf0 vf2 :fsf #b11 :ftf #b11)
    ;;(.wait.vf)
    (.mul.vf vf2 vf1 Q)
    ;;(.nop.vf)
    ;;(.nop.vf)
    (.svf (&-> q vec quad) vf2)
    q))

(defun quaternion-inverse! ((dst quaternion) (src quaternion))
  "Invert a quaternion. The inverse will satisfy q * q^-1 = identity, even if q is not normalized.
   If your quaternion is normalized, it is faster/more accurate to do quaternion-conjugate!"
  (rlet ((acc :class vf)
         (Q :class vf)
         (vf0 :class vf)
         (vf1 :class vf)
         (vf2 :class vf)
         (vf3 :class vf))
    (init-vf0-vector)
    (.lvf vf1 (&-> src vec quad))
    (.mul.vf vf2 vf1 vf1)
    ;; og:preserve-this
    ;; Clear with XOR so stale host SIMD NaNs cannot survive a subtract-from-self.
    (.xor.vf vf3 vf3 vf3)
    (.add.z.vf.w acc vf2 vf2)
    (.add.mul.y.vf.w acc vf0 vf2 acc)
    (.add.mul.x.vf.w vf2 vf0 vf2 acc)
    (.sub.vf.xyz vf3 vf3 vf1)
    (.div.vf Q vf0 vf2 :fsf #b11 :ftf #b11)
    (.add.vf.w vf3 vf3 vf1)
    (.wait.vf)
    (.mul.vf vf3 vf3 Q)
    (.nop.vf)
    (.nop.vf)
    (.svf (&-> dst vec quad) vf3)
    dst))

(defun quaternion-dot ((a quaternion) (b quaternion))
  "Treat quaternions as vectors and take the dot product."
  (local-vars (v0-0 float))
  (rlet ((acc :class vf)
         (vf0 :class vf)
         (vf1 :class vf)
         (vf2 :class vf))
    (init-vf0-vector)
    (.lvf vf1 (&-> a vec quad))
    (.lvf vf2 (&-> b vec quad))
    (.mul.vf vf1 vf1 vf2)
    (.add.z.vf.w acc vf1 vf1)
    (.add.mul.y.vf.w acc vf0 vf1 acc)
    (.add.mul.x.vf.w vf1 vf0 vf1 acc)
    (.add.w.vf vf1 vf0 vf1)
    (.mov v0-0 vf1)
    v0-0))

(defun quaternion*! ((dst quaternion) (a quaternion) (b quaternion))
  "Set dst to the Hamilton product a * b."
  (rlet ((acc :class vf)
         (vf0 :class vf)
         (vf1 :class vf)
         (vf2 :class vf)
         (vf3 :class vf)
         (vf4 :class vf))
    (init-vf0-vector)
    (.lvf vf1 (&-> a vec quad))
    (.lvf vf2 (&-> b vec quad))
    (.sub.vf.w vf4 vf0 vf0)
    (.mul.vf vf3 vf1 vf2)
    (.outer.product.a.vf acc vf1 vf2)
    (.outer.product.b.vf vf4 vf2 vf1 acc)
    (.mul.w.vf acc vf1 vf2)
    (.add.mul.w.vf acc vf2 vf1 acc)
    (.sub.mul.w.vf.w acc vf0 vf3 acc)
    (.sub.mul.z.vf.w acc vf0 vf3 acc)
    (.sub.mul.y.vf.w acc vf0 vf3 acc)
    (.sub.mul.x.vf.w acc vf0 vf3 acc)
    (.add.mul.w.vf vf1 vf4 vf0 acc)
    (.svf (&-> dst vec quad) vf1)
    dst))

(defun quaternion-right-mult-matrix! ((dst-mat matrix) (q quaternion))
  "Place quaternion coefficients into a matrix.
   You can convert a quaternion to a matrix by taking the product of this
   right-mult and left-mult matrix, but this method is not used.
   Instead, quaternion->matrix is a more efficient implementation."
  (let ((f3-0 (-> q x))
        (f2-0 (-> q y))
        (f1-0 (-> q z))
        (f0-0 (-> q w)))
    (set! (-> dst-mat vector 0 x) f0-0)
    (set! (-> dst-mat vector 0 y) f1-0)
    (set! (-> dst-mat vector 0 z) (- f2-0))
    (set! (-> dst-mat vector 0 w) f3-0)
    (set! (-> dst-mat vector 1 x) (- f1-0))
    (set! (-> dst-mat vector 1 y) f0-0)
    (set! (-> dst-mat vector 1 z) f3-0)
    (set! (-> dst-mat vector 1 w) f2-0)
    (set! (-> dst-mat vector 2 x) f2-0)
    (set! (-> dst-mat vector 2 y) (- f3-0))
    (set! (-> dst-mat vector 2 z) f0-0)
    (set! (-> dst-mat vector 2 w) f1-0)
    (set! (-> dst-mat vector 3 x) (- f3-0))
    (set! (-> dst-mat vector 3 y) (- f2-0))
    (set! (-> dst-mat vector 3 z) (- f1-0))
    (set! (-> dst-mat vector 3 w) f0-0))
  dst-mat)

(defun quaternion-left-mult-matrix! ((dst-mat matrix) (q quaternion))
  "Place quaternion coefficients into a matrix. Unused."
  (let ((f2-0 (-> q x))
        (f1-0 (-> q y))
        (f0-0 (-> q z)))
    (let ((f3-0 (-> q w)))
      (set! (-> dst-mat vector 0 x) f2-0)
      (set! (-> dst-mat vector 0 y) f3-0)
      (set! (-> dst-mat vector 0 z) (- f0-0))
      (set! (-> dst-mat vector 0 w) f1-0)
      (set! (-> dst-mat vector 1 x) f1-0)
      (set! (-> dst-mat vector 1 y) f0-0)
      (set! (-> dst-mat vector 1 z) f3-0)
      (set! (-> dst-mat vector 1 w) (- f3-0))
      (set! (-> dst-mat vector 2 x) f0-0)
      (set! (-> dst-mat vector 2 y) (- f1-0))
      (set! (-> dst-mat vector 2 z) f2-0)
      (set! (-> dst-mat vector 2 w) f3-0)
      (set! (-> dst-mat vector 3 x) f3-0))
    (set! (-> dst-mat vector 3 y) (- f2-0))
    (set! (-> dst-mat vector 3 z) (- f1-0))
    (set! (-> dst-mat vector 3 w) (- f0-0)))
  dst-mat)

(defun quaternion->matrix ((dst-mat matrix) (q quaternion))
  "Convert quaternion to matrix."
  (rlet ((acc :class vf)
         (vf0 :class vf)
         (vf1 :class vf)
         (vf2 :class vf)
         (vf3 :class vf)
         (vf4 :class vf)
         (vf5 :class vf))
    (init-vf0-vector)
    (.lvf vf1 (&-> q vec quad))
    (.add.vf vf5 vf1 vf1)
    (.add.w.vf.x vf2 vf0 vf1)
    (.add.z.vf.y vf2 vf0 vf1)
    (.sub.y.vf.z vf2 vf0 vf1)
    (.sub.w.vf.w vf2 vf0 vf0)
    (.sub.z.vf.x vf3 vf0 vf1)
    (.add.w.vf.y vf3 vf0 vf1)
    (.add.x.vf.z vf3 vf0 vf1)
    (.sub.w.vf.w vf3 vf0 vf0)
    (.add.y.vf.x vf4 vf0 vf1)
    (.sub.x.vf.y vf4 vf0 vf1)
    (.add.w.vf.z vf4 vf0 vf1)
    (.sub.w.vf.w vf4 vf0 vf0)
    (.outer.product.a.vf acc vf5 vf2)
    (.outer.product.b.vf vf2 vf2 vf5 acc)
    (.outer.product.a.vf acc vf5 vf3)
    (.outer.product.b.vf vf3 vf3 vf5 acc)
    (.outer.product.a.vf acc vf5 vf4)
    (.outer.product.b.vf vf4 vf4 vf5 acc)
    (.add.w.vf.x vf2 vf2 vf0)
    (.add.w.vf.y vf3 vf3 vf0)
    (.add.w.vf.z vf4 vf4 vf0)
    (.svf (&-> dst-mat vector 3 quad) vf0)
    (.svf (&-> dst-mat vector 0 quad) vf2)
    (.svf (&-> dst-mat vector 1 quad) vf3)
    (.svf (&-> dst-mat vector 2 quad) vf4)
    dst-mat))

(defun matrix->quaternion ((dst quaternion) (src-mat matrix))
  "Convert the upper 3x3 rotation of src-mat to dst, choosing its largest diagonal component for numerical stability."
  (let ((trace (+ (-> src-mat vector 0 x) (-> src-mat vector 1 y) (-> src-mat vector 2 z))))
    (cond
      ((< 0.0 trace)
       (let ((f0-4 (sqrtf (+ 1.0 trace))))
         (set! (-> dst w) (* 0.5 f0-4))
         (let ((f0-5 (/ 0.5 f0-4)))
           (set! (-> dst x) (* f0-5 (- (-> src-mat vector 1 z) (-> src-mat vector 2 y))))
           (set! (-> dst y) (* f0-5 (- (-> src-mat vector 2 x) (-> src-mat vector 0 z))))
           (set! (-> dst z) (* f0-5 (- (-> src-mat vector 0 y) (-> src-mat vector 1 x)))))))
      (else
       (let ((largest-axis 0)
             (next-axis 1)
             (previous-axis 2))
         (when (< (-> src-mat vector 0 x) (-> src-mat vector 1 y))
           (set! largest-axis 1)
           (set! next-axis 2)
           (set! previous-axis 0))
         (when (< (-> (the-as (pointer float) (+ (+ (* largest-axis 4) (* largest-axis 16)) (the-as int src-mat))))
                  (-> src-mat vector 2 z))
           (set! largest-axis 2)
           (set! next-axis 0)
           (set! previous-axis 1))
         (let ((diagonal-root (sqrtf (+ (- 1.0
                                           (+ (-> (the-as (pointer float) (+ (+ (* next-axis 4) (* next-axis 16)) (the-as int src-mat))))
                                              (-> (the-as (pointer float) (+ (+ (* previous-axis 4) (* previous-axis 16)) (the-as int src-mat))))))
                                        (-> (the-as (pointer float) (+ (+ (* largest-axis 4) (* largest-axis 16)) (the-as int src-mat))))))))
           (set! (-> dst data largest-axis) (* 0.5 diagonal-root))
           (if (!= diagonal-root 0.0) (set! diagonal-root (/ 0.5 diagonal-root)))
           (set! (-> dst w)
                 (* (- (-> (the-as (pointer float) (+ (+ (* previous-axis 4) (* next-axis 16)) (the-as int src-mat))))
                       (-> (the-as (pointer float) (+ (+ (* next-axis 4) (* previous-axis 16)) (the-as int src-mat)))))
                    diagonal-root))
           (set! (-> dst data next-axis)
                 (* (+ (-> (the-as (pointer float) (+ (+ (* next-axis 4) (* largest-axis 16)) (the-as int src-mat))))
                       (-> (the-as (pointer float) (+ (+ (* largest-axis 4) (* next-axis 16)) (the-as int src-mat)))))
                    diagonal-root))
           (set! (-> dst data previous-axis)
                 (* (+ (-> (the-as (pointer float) (+ (+ (* previous-axis 4) (* largest-axis 16)) (the-as int src-mat))))
                       (-> (the-as (pointer float) (+ (+ (* largest-axis 4) (* previous-axis 16)) (the-as int src-mat)))))
                    diagonal-root)))))))
  dst)

(defun matrix-with-scale->quaternion ((dst quaternion) (src-mat matrix))
  "Remove independent row scale from src-mat and convert the remaining rotation to dst."
  (rlet ((vf1 :class vf)
         (vf2 :class vf)
         (vf3 :class vf)
         (vf4 :class vf)
         (vf5 :class vf)
         (vf6 :class vf)
         (vf7 :class vf))
    (let ((rotation-mat (new-stack-matrix0)))
      ;; compute norm of rows of rotation matrix (vector-dot does only xyz)
      (let ((row0-norm2 (vector-dot (-> src-mat vector 0) (-> src-mat vector 0))))
        (let ((row1-norm2 (vector-dot (-> src-mat vector 1) (-> src-mat vector 1))))
          (let* ((row2-norm2 (vector-dot (-> src-mat vector 2) (-> src-mat vector 2)))
                 ;; compute scaling factors.
                 (inverse-row0-length (/ 1.0 (sqrtf row0-norm2)))
                 (inverse-row1-length (/ 1.0 (sqrtf row1-norm2)))
                 (inverse-row2-length (/ 1.0 (sqrtf row2-norm2))))
            ;; load the origin matrix.
            (.lvf vf1 (&-> src-mat vector 0 quad))
            (.lvf vf2 (&-> src-mat vector 1 quad))
            (.lvf vf3 (&-> src-mat vector 2 quad))
            (.lvf vf4 (&-> src-mat vector 3 quad))
            ;; move scaling factors into vector regs
            (let ((a1-1 inverse-row0-length)) (.mov vf5 a1-1))
            (let ((a1-2 inverse-row1-length)) (.mov vf6 a1-2))
            (let ((a1-3 inverse-row2-length)) (.mov vf7 a1-3)))))
      ;; scale!
      (.mul.x.vf vf1 vf1 vf5)
      (.mul.x.vf vf2 vf2 vf6)
      (.mul.x.vf vf3 vf3 vf7)
      ;; store in temp matrix
      (.svf (&-> rotation-mat vector 0 quad) vf1)
      (.svf (&-> rotation-mat vector 1 quad) vf2)
      (.svf (&-> rotation-mat vector 2 quad) vf3)
      (.svf (&-> rotation-mat vector 3 quad) vf4)
      ;; and convert!
      (matrix->quaternion dst rotation-mat))))

(defun quaternion-vector-len ((q quaternion))
  "Assuming quaternion is normalized, get the length of the xyz part."
  (let ((f0-0 1.0)
        (f1-0 (-> q w)))
    ;; sqrt(1 - w^2) = sqrt(x^2 + y^2 + z^2) = length
    (sqrtf (- f0-0 (* f1-0 f1-0)))))

(defun quaternion-log! ((dst quaternion) (src quaternion))
  "Store the vector part of the logarithm of unit src in dst.xyz. Unused in Jak 1."
  (cond
    ((= (-> src w) 0.0)
     (set! (-> dst x) (* 1.5707963 (-> src x)))
     (set! (-> dst y) (* 1.5707963 (-> src y)))
     (set! (-> dst z) (* 1.5707963 (-> src z))))
    (else
     (let* ((imaginary-length (quaternion-vector-len src))
            (angle-scale (/ (atan2-rad (-> src w) imaginary-length) imaginary-length)))
       (set! (-> dst x) (* (-> src x) angle-scale))
       (set! (-> dst y) (* (-> src y) angle-scale))
       (set! (-> dst z) (* (-> src z) angle-scale)))))
  dst)

(defun quaternion-exp! ((dst quaternion) (src quaternion))
  "Exponentiate a pure-vector quaternion src into unit dst. Unused in Jak 1."
  (let ((imaginary-length (vector-length (the-as vector src))))
    (cond
      ((= imaginary-length 0.0) (set! (-> dst x) 0.0) (set! (-> dst y) 0.0) (set! (-> dst z) 0.0) (set! (-> dst w) 1.0))
      (else
       (let ((sincos (new 'stack-no-clear 'vector)))
         (sincos-rad! (the-as (pointer float) sincos) imaginary-length)
         (let ((sin-over-length (/ (-> sincos x) imaginary-length)))
           (set! (-> dst x) (* (-> src x) sin-over-length))
           (set! (-> dst y) (* (-> src y) sin-over-length))
           (set! (-> dst z) (* (-> src z) sin-over-length)))
         (set! (-> dst w) (-> sincos y))))))
  dst)

(defun quaternion-slerp! ((dst quaternion) (a quaternion) (b quaternion) (alpha float))
  "Spherically interpolate from a to b, selecting the shortest quaternion hemisphere and using normalized lerp near zero angle."
  (local-vars (v1-7 float))
  (rlet ((acc :class vf)
         (vf1 :class vf)
         (vf2 :class vf)
         (vf3 :class vf)
         (vf4 :class vf))
    (let ((cos-angle (quaternion-dot a b))
          (hemisphere-sign 1.0))
      (when (< cos-angle 0.0)
        (set! cos-angle (- cos-angle))
        (set! hemisphere-sign -1.0))
      (cond
        ((< (- 1.0 cos-angle) 0.0001)
         (let ((a-weight (- 1.0 alpha))) (.mov vf1 a-weight))
         (let ((b-weight (* alpha hemisphere-sign))) (.mov vf2 b-weight))
         (.lvf vf3 (&-> a vec quad))
         (.lvf vf4 (&-> b vec quad))
         (.mul.x.vf acc vf3 vf1)
         (.add.mul.x.vf vf3 vf4 vf2 acc)
         (.svf (&-> dst vec quad) vf3)
         (quaternion-normalize! dst))
        (else
         ;; Recover theta without a full acos. For c=cos(theta) and
         ;; s=sqrt(1-c^2), (s-c)/(s+c)=tan(theta-pi/4); atan-series-rad
         ;; folds the pi/4 offset into its result. Dividing the two sine
         ;; weights by s gives the standard constant-angular-speed slerp.
         (let* ((f1-4 1.0)
                (f2-1 cos-angle)
                (sin-angle (sqrtf (- f1-4 (* f2-1 f2-1))))
                (atan-argument (/ (- sin-angle cos-angle) (+ sin-angle cos-angle)))
                (inverse-sin-angle (/ 1.0 sin-angle)))
           (let ((angle-rad (atan-series-rad atan-argument))
                 (blend-angles (new 'stack-no-clear 'vector)))
             (set! (-> blend-angles x) (* (- 1.0 alpha) angle-rad))
             (set! (-> blend-angles y) (* alpha angle-rad hemisphere-sign))
             (vector-sin-rad! blend-angles blend-angles)
             (.lvf vf1 (&-> blend-angles quad)))
           (let ((v1-6 inverse-sin-angle)) (.mov vf2 v1-6)))
         (.mul.x.vf vf1 vf1 vf2)
         (.lvf vf3 (&-> a vec quad))
         (.lvf vf4 (&-> b vec quad))
         (.mul.x.vf acc vf3 vf1)
         (.add.mul.y.vf vf3 vf4 vf1 acc)
         (.svf (&-> dst vec quad) vf3)
         (.mov v1-7 vf3))))
    dst))

(defun quaternion-pseudo-slerp! ((dst quaternion) (a quaternion) (b quaternion) (alpha float))
  "Normalized linear interpolation with hemisphere correction. It is not constant-speed and degenerates for antipodal rotations; unused in Jak 1."
  (rlet ((acc :class vf)
         (vf1 :class vf)
         (vf2 :class vf)
         (vf3 :class vf)
         (vf4 :class vf))
    (let ((cos-angle (quaternion-dot a b))
          (hemisphere-sign 1.0))
      (when (< cos-angle 0.0)
        ;; The original computes and discards the absolute dot; only the sign is
        ;; needed to choose the equivalent endpoint in the nearer hemisphere.
        (- cos-angle)
        (set! hemisphere-sign -1.0))
      (let ((a-weight (- 1.0 alpha))) (.mov vf1 a-weight))
      (let ((b-weight (* alpha hemisphere-sign))) (.mov vf2 b-weight)))
    (.lvf vf3 (&-> a vec quad))
    (.lvf vf4 (&-> b vec quad))
    (.mul.x.vf acc vf3 vf1)
    (.add.mul.x.vf vf3 vf4 vf2 acc)
    (.svf (&-> dst vec quad) vf3)
    (quaternion-normalize! dst)
    dst))

(defmacro quaternion-vompula-hack (vf-out vf-in)
  ;; Compute yz, zx, and xy through memory on hosts without the VU outer-product instruction.
  `(let ((in-vec (new 'stack-no-clear 'vector))
        (out-vec (new 'stack-no-clear 'vector)))
    (.svf (&-> in-vec quad) ,vf-in)
    (set! (-> out-vec x) (* (-> in-vec y) (-> in-vec z)))
    (set! (-> out-vec y) (* (-> in-vec z) (-> in-vec x)))
    (set! (-> out-vec z) (* (-> in-vec x) (-> in-vec y)))
    ;;(set! (-> out-vec w) (-> in-vec w))
    (.lvf ,vf-out (&-> out-vec quad))))

(defun quaternion-zxy! ((dst quaternion) (angles vector))
  "Build dst from Z, then X, then Y rotations stored in angles."
  (rlet ((acc :class vf)
         (vf0 :class vf)
         (vf1 :class vf)
         (vf2 :class vf)
         (vf3 :class vf)
         (vf4 :class vf)
         (vf5 :class vf)
         (vf6 :class vf)
         (vf7 :class vf))
    (init-vf0-vector)
    (let ((half-angles-rad (new 'stack-no-clear 'vector))
          (sin-angles (new 'stack-no-clear 'vector))
          (cos-angles (new 'stack-no-clear 'vector)))
      (vector-rad<-vector-deg/2! half-angles-rad angles)
      (vector-sincos-rad! sin-angles cos-angles half-angles-rad)
      (.lvf vf1 (&-> sin-angles quad))
      (.lvf vf2 (&-> cos-angles quad)))
    (.mul.x.vf.w vf4 vf0 vf1)
    (.add.vf.xyz vf4 vf0 vf2)
    (.sub.vf.yz vf4 vf0 vf4)
    (.add.vf.xyz vf3 vf0 vf1)
    (.mul.x.vf.w vf3 vf0 vf2)
    (.outer.product.a.vf acc vf1 vf1)
    (.outer.product.b.vf vf6 vf0 vf0 acc)
    (.outer.product.a.vf acc vf2 vf2)
    (.outer.product.b.vf vf5 vf0 vf0 acc)
    (.mul.x.vf.w vf6 vf0 vf6)
    (.mul.x.vf.w vf5 vf0 vf5)
    (.mul.vf acc vf6 vf4)
    (.add.mul.vf vf7 vf5 vf3 acc)
    (.svf (&-> dst vec quad) vf7)
    dst))

(defun vector-x-quaternion! ((dst vector) (q quaternion))
  "Store q's world-space local X axis in dst."
  (let ((rotation-mat (new-stack-matrix0)))
    (quaternion->matrix rotation-mat q)
    (set! (-> dst quad) (-> (the-as (pointer uint128) (-> rotation-mat vector)) 0)))
  dst)

(defun vector-y-quaternion! ((dst vector) (q quaternion))
  "Store q's world-space local Y axis in dst."
  (let ((rotation-mat (new-stack-matrix0)))
    (quaternion->matrix rotation-mat q)
    (set! (-> dst quad) (-> (the-as (pointer uint128) (-> rotation-mat vector 1)) 0)))
  dst)

(defun vector-z-quaternion! ((dst vector) (q quaternion))
  "Store q's world-space local Z (forward) axis in dst."
  (let ((rotation-mat (new-stack-matrix0)))
    (quaternion->matrix rotation-mat q)
    (set! (-> dst quad) (-> (the-as (pointer uint128) (-> rotation-mat vector 2)) 0)))
  dst)

(defun quaternion-y-angle ((q quaternion))
  "Return the yaw of q's forward axis in rotation units."
  (let ((forward (vector-z-quaternion! (new 'stack-no-clear 'vector) q))) (atan (-> forward x) (-> forward z))))

(defun quaternion-vector-y-angle ((q quaternion) (direction vector))
  "Return the signed yaw error from q's forward axis to direction in the XZ plane."
  (let ((facing-angle (quaternion-y-angle q))
        (target-angle (atan (-> direction x) (-> direction z))))
    (deg-diff facing-angle target-angle)))

(defun quaternion-rotate-local-x! ((dst quaternion) (src quaternion) (angle float))
  "Post-multiply src by a local X rotation and normalize into dst."
  (let ((increment (quaternion-vector-angle! (new-stack-quaternion0) (new 'static 'vector :x 1.0 :w 1.0) angle)))
    (quaternion-normalize! (quaternion*! dst src increment))))

(defun quaternion-rotate-local-y! ((dst quaternion) (src quaternion) (angle float))
  "Post-multiply src by a local Y rotation and normalize into dst."
  (let ((increment (quaternion-vector-angle! (new-stack-quaternion0) (new 'static 'vector :y 1.0 :w 1.0) angle)))
    (quaternion-normalize! (quaternion*! dst src increment))))

(defun quaternion-rotate-local-z! ((dst quaternion) (src quaternion) (angle float))
  "Post-multiply src by a local Z rotation and normalize into dst."
  (let ((increment (quaternion-vector-angle! (new-stack-quaternion0) (new 'static 'vector :z 1.0 :w 1.0) angle)))
    (quaternion-normalize! (quaternion*! dst src increment))))

(defun quaternion-rotate-y! ((dst quaternion) (src quaternion) (angle float))
  "Pre-multiply src by a world Y rotation and normalize into dst."
  (let ((increment (quaternion-vector-angle! (new-stack-quaternion0) (new 'static 'vector :y 1.0 :w 1.0) angle)))
    (quaternion-normalize! (quaternion*! dst increment src))))

(defun quaternion-rotate-x! ((dst quaternion) (src quaternion) (angle float))
  "Rotate src about its current world-space X axis and normalize into dst."
  (let ((increment (quaternion-vector-angle! (new-stack-quaternion0) (vector-x-quaternion! (new-stack-vector0) src) angle)))
    (quaternion-normalize! (quaternion*! dst increment src))))

(defun quaternion-rotate-z! ((dst quaternion) (src quaternion) (angle float))
  "Rotate src about its current world-space Z axis and normalize into dst."
  (let ((increment (quaternion-vector-angle! (new-stack-quaternion0) (vector-z-quaternion! (new-stack-vector0) src) angle)))
    (quaternion-normalize! (quaternion*! dst increment src))))

(defun quaternion-delta-y ((a quaternion) (b quaternion))
  "Return the unsigned angle between the two forward axes. Despite the name, pitch also affects the result."
  (acos (vector-dot (vector-z-quaternion! (new 'stack-no-clear 'vector) a) (vector-z-quaternion! (new 'stack-no-clear 'vector) b))))

(defun quaternion-rotate-y-to-vector! ((dst quaternion) (src quaternion) (direction vector) (max-angle float))
  "Turn src's forward axis toward direction projected onto XZ, capped by max-angle, and normalize into dst."
  (let ((delta (new 'stack-no-clear 'quaternion)))
    (let ((normalize-xz-fn vector-xz-normalize!)
          (flat-direction (new 'stack-no-clear 'vector)))
      (set! (-> flat-direction x) (-> direction x))
      (set! (-> flat-direction y) 0.0)
      (set! (-> flat-direction z) (-> direction z))
      (set! (-> flat-direction w) 1.0)
      (let ((target-direction (normalize-xz-fn flat-direction 1.0)))
        (quaternion-from-two-vectors-max-angle! delta
                                                (vector-z-quaternion! (new 'stack-no-clear 'vector) src)
                                                target-direction
                                                max-angle)))
    (quaternion-normalize! (quaternion*! dst delta src))))

(defun vector-rotate-y! ((dst vector) (src vector) (angle float))
  "Rotate src about world Y into dst through a temporary quaternion and matrix."
  (let ((rotation (quaternion-vector-angle! (new 'stack-no-clear 'quaternion) (new 'static 'vector :y 1.0 :w 1.0) angle))
        (rotation-mat (new 'stack-no-clear 'matrix)))
    (quaternion->matrix rotation-mat rotation)
    (vector-matrix*! dst src rotation-mat)))

;; Heading helpers assume yaw remains meaningful. At a 180-degree pitch the
;; projected forward direction is singular.

(defun vector-y-angle ((vec vector))
  "Return vec's yaw in rotation units from its XZ projection."
  (atan (-> vec x) (-> vec z)))

(defun vector-x-angle ((vec vector))
  "Return vec's pitch in rotation units."
  (atan (-> vec y) (vector-xz-length vec)))

(defun quaterion<-rotate-y-vector ((dst quaternion) (direction vector))
  "Build a pure-yaw quaternion facing direction. The function name retains its original misspelling."
  (quaternion-vector-angle! dst (new 'static 'vector :y 1.0 :w 1.0) (vector-y-angle direction)))

(defun-debug quaternion-validate ((q quaternion))
  "Verify that a quaternion is valid, print an error if not."
  (with-pp
    (let ((magnitude (quaternion-norm q)))
      (when (or (< 1.01 magnitude) (< magnitude 0.99))
        (format #t "WARNING: bad quaternion (magnitude ~F) process is " magnitude)
        (if (and pp (type-type? (-> pp type) process-tree)) (format #t "~A~%" (-> pp name)) (format #t "#f~%"))))
    0
    (none)))

(defun quaternion-xz-angle ((q quaternion))
  "Return q's yaw by rotating a temporary forward vector through a temporary matrix."
  (let ((rotation-mat (new 'stack-no-clear 'matrix))
        (forward (new 'stack-no-clear 'vector)))
    (quaternion->matrix rotation-mat q)
    (set-vector! forward 0.0 0.0 1.0 1.0)
    (vector-matrix*! forward forward rotation-mat)
    (vector-y-angle forward)))

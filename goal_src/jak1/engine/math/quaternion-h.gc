;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "kernel-defs.gc")

;; DECOMP BEGINS

;; Quaternion orientation stored as vector part xyz followed by scalar part w.
;; It is compact, avoids Euler-angle singularities, and composes efficiently.
(deftype quaternion (structure)
  ((x    float)
   (y    float)
   (z    float)
   (w    float)
   (data float 4 :overlay-at x)
   (vec  vector :inline :overlay-at x)
   (quad uint128 :overlay-at x)))

(define *unity-quaternion* (new 'static 'quaternion :x 0.0 :y 0.0 :z 0.0 :w 1.0))

(define-extern matrix->quaternion (function quaternion matrix quaternion))

(define-extern vector-y-angle (function vector float))

(defmacro new-stack-quaternion0 ()
  "Allocate a zeroed quaternion on the stack without calling the constructor."
  (with-gensyms (value)
    `(let ((,value (new 'stack-no-clear 'quaternion))) (set! (-> ,value quad) (the-as uint128 0)) ,value)))

;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/math/vector-h.gc")

;; DECOMP BEGINS

;; Shoemake's Euler-angle conversion lookup tables select the inner, middle, and
;; outer axes from a packed order code.
(define EulSafe (new 'static 'boxed-array :type int32 :length 4 0 1 2 0))

(define EulNext (new 'static 'boxed-array :type int32 :length 4 1 2 0 1))

;; xyz hold the three angles. w holds Shoemake's integer order code as a float,
;; encoding the inner axis, parity, repeated-axis choice, and frame convention.
;; These conversions are used mainly by camera debugging.
(deftype euler-angles (vector) ())

;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/anim/aligner-h.gc")
(require "engine/anim/joint-mod-h.gc")
(require "engine/common-obs/generic-obs-h.gc")
(require "engine/geometry/vol-h.gc")
(require "engine/camera/camera-h.gc")
(require "engine/geometry/path-h.gc")
(require "engine/gfx/sprite/sparticle/sparticle.gc")
(require "engine/nav/navigate-h.gc")
(require "engine/data/art-h.gc")
(require "engine/common-obs/water-h.gc")

;; note: the while loop in this is changed to include a cast to basic.

;; DECOMP BEGINS

(defmethod relocate ((this process) (offset int))
  "Move this process allocation by offset. Patch internal pointers, connections, heap objects,
   threads, and heap bounds, copy the complete allocation in an overlap-safe direction, and
   return its new address."
  (let ((context *kernel-context*))
    (set! (-> context relocating-process) this)
    (set! (-> context relocating-min) (the-as int (&-> this type)))
    (set! (-> context relocating-max)
          (the-as int (+ (+ (-> this allocated-length) -4 (-> process size)) (the-as int this))))
    (set! (-> context relocating-offset) offset))
  (&+! (-> this ppointer 0) offset)
  (let ((owner-entity (-> this entity)))
    (if (and owner-entity (= (-> owner-entity extra process) this)) (&+! (-> owner-entity extra process) offset)))
  (let ((conn (-> this connection-list next1)))
    (while (the-as connection conn)
      (let ((previous-link (-> conn prev1)))
        (if (and (>= (the-as int previous-link) (-> *kernel-context* relocating-min))
                 (< (the-as int previous-link) (-> *kernel-context* relocating-max)))
          (&+! (-> conn prev1) offset)))
      (let ((param1-value (-> (the-as connection conn) param1)))
        (if (and (>= param1-value (-> *kernel-context* relocating-min)) (< param1-value (-> *kernel-context* relocating-max)))
          (+! (-> (the-as connection conn) param1) offset)))
      (let ((param2-value (-> (the-as connection conn) param2)))
        (if (and (>= param2-value (-> *kernel-context* relocating-min)) (< param2-value (-> *kernel-context* relocating-max)))
          (+! (-> (the-as connection conn) param2) offset)))
      (let ((param3-value (-> (the-as connection conn) param3)))
        (if (and (>= param3-value (-> *kernel-context* relocating-min)) (< param3-value (-> *kernel-context* relocating-max)))
          (+! (-> (the-as connection conn) param3) offset)))
      (set! conn (-> (the-as connection conn) next1))))
  (let ((self-pointer (-> this self)))
    (if (and (>= (the-as int self-pointer) (-> *kernel-context* relocating-min))
             (< (the-as int self-pointer) (-> *kernel-context* relocating-max)))
      (&+! (-> this self) offset)))
  (let ((parent-pointer (-> this ppointer)))
    (if (and (>= (the-as int parent-pointer) (-> *kernel-context* relocating-min))
             (< (the-as int parent-pointer) (-> *kernel-context* relocating-max)))
      (&+! (-> this ppointer) offset)))
  ;; og:preserve-this
  (let ((heap-object (the basic (&+ (-> this heap-base) 4))))
    (while (< (the-as int heap-object) (the-as int (-> this heap-cur)))
      (relocate heap-object offset)
      (&+! heap-object (logand -16 (+ (asize-of heap-object) 15)))))
  (&+! (-> this main-thread) offset)
  (&+! (-> this top-thread) offset)
  (&+! (-> this heap-base) offset)
  (&+! (-> this heap-cur) offset)
  (&+! (-> this heap-top) offset)
  (let ((allocation-size (asize-of this))
        (allocation-start (&-> this type)))
    (cond
      ((>= offset 0) (qmem-copy->! (&+ allocation-start offset) allocation-start allocation-size))
      ((< allocation-size 2560) (qmem-copy<-! (&+ allocation-start offset) allocation-start allocation-size))
      (else (ultimate-memcpy (&+ allocation-start offset) allocation-start (the-as uint allocation-size)))))
  (set! (-> *kernel-context* relocating-process) #f)
  (&+ this offset))

(defmethod relocate ((this cpu-thread) (offset int))
  "Adjust this thread's owning-process pointer after the process allocation moves."
  (&+! (-> this process) offset)
  this)

(defmethod relocate ((this process-drawable) (offset int))
  "Adjust every optional drawable controller owned by this process, then relocate the process
   allocation."
  (let ((context *kernel-context*))
    (set! (-> context relocating-process) this)
    (set! (-> context relocating-min) (the-as int (&-> this type)))
    (set! (-> context relocating-max)
          (the-as int (+ (+ (-> this allocated-length) -4 (-> process size)) (the-as int this))))
    (set! (-> context relocating-offset) offset))
  (if (nonzero? (-> this root)) (&+! (-> this root) offset))
  (if (nonzero? (-> this node-list)) (&+! (-> this node-list) offset))
  (if (nonzero? (-> this draw)) (&+! (-> this draw) offset))
  (if (nonzero? (-> this skel)) (&+! (-> this skel) offset))
  (if (nonzero? (-> this nav)) (&+! (-> this nav) offset))
  (if (nonzero? (-> this align)) (&+! (-> this align) offset))
  (if (nonzero? (-> this path)) (&+! (-> this path) offset))
  (if (nonzero? (-> this vol)) (&+! (-> this vol) offset))
  (if (nonzero? (-> this fact)) (&+! (-> this fact) offset))
  (if (nonzero? (-> this link)) (&+! (-> this link) offset))
  (if (nonzero? (-> this part)) (&+! (-> this part) offset))
  (if (nonzero? (-> this water)) (&+! (-> this water) offset))
  (if (nonzero? (-> this sound)) (&+! (-> this sound) offset))
  (the-as process-drawable ((method-of-type process relocate) this offset)))

(defmethod relocate ((this collide-shape) (offset int))
  "Adjust the owning process, root primitive, and optional sticky-rider group after the process
   heap moves."
  (&+! (-> this process) offset)
  (&+! (-> this root-prim) offset)
  (if (-> this riders) (&+! (-> this riders) offset))
  this)

(defmethod relocate ((this collide-shape-moving) (offset int))
  "Adjust the optional dynamics pointer, then relocate the base collision shape."
  (if (-> this dynam) (&+! (-> this dynam) offset))
  (the-as collide-shape-moving ((method-of-type collide-shape relocate) this offset)))

(defmethod relocate ((this collide-sticky-rider-group) (offset int))
  "Adjust every active rider's cached sticky-primitive pointer after the owning process heap
   moves."
  (countdown (i (-> this num-riders))
    (let ((rider (-> this rider i))) (if (-> rider sticky-prim) (&+! (-> rider sticky-prim) offset))))
  this)

(defmethod relocate ((this collide-shape-prim) (offset int))
  "Adjust this primitive's owning collision-shape pointer after the process heap moves."
  (&+! (-> this cshape) offset)
  this)

(defmethod relocate ((this collide-shape-prim-group) (offset int))
  "Adjust the owning collision-shape pointer and every active child primitive pointer after the
   process heap moves."
  (&+! (-> this cshape) offset)
  (countdown (i (-> this num-prims))
    (&+! (-> this prims i) offset))
  this)

(defmethod relocate ((this fact-info) (offset int))
  "Adjust the owning process pointer after its process heap moves."
  (&+! (-> this process) offset)
  this)

(defmethod relocate ((this draw-control) (offset int))
  "Adjust the skeleton, owner process, ripple state, and any heap-local shadow control after
   the owning process moves."
  (&+! (-> this skeleton) offset)
  (&+! (-> this process) offset)
  (when (-> this ripple)
    (if (-> this ripple query) (&+! (-> this ripple query) offset))
    (&+! (-> this ripple) offset))
  (let ((shadow-ctrl (-> this shadow-ctrl)))
    (if (and (>= (the-as int shadow-ctrl) (-> *kernel-context* relocating-min))
             (< (the-as int shadow-ctrl) (-> *kernel-context* relocating-max)))
      (&+! (-> this shadow-ctrl) offset)))
  this)

(defmethod relocate ((this joint-control) (offset int))
  "Adjust the optional effect controller, root-channel array, and every allocated channel's
   parent pointer after the owning process heap moves."
  (if (-> this effect) (&+! (-> this effect) offset))
  (set! (-> this root-channel) (the-as (inline-array joint-control-channel) (&+ (-> this root-channel) offset)))
  (countdown (i (-> this allocated-length))
    (&+! (-> this channel i parent) offset))
  this)

(defmethod relocate ((this cspace-array) (offset int))
  "Adjust each node's parent and bone pointers after its process heap moves, together with
   param1 and param2 when they point inside that heap."
  (countdown (i (-> this length))
    (let ((space (-> this data i)))
      (if (-> space parent) (&+! (-> space parent) offset))
      (&+! (-> space bone) offset)
      (let ((param1-value (-> space param1)))
        (if (and (>= (the-as int param1-value) (-> *kernel-context* relocating-min))
                 (< (the-as int param1-value) (-> *kernel-context* relocating-max)))
          (&+! (-> space param1) offset)))
      (let ((param2-value (-> space param2)))
        (if (and (>= (the-as int param2-value) (-> *kernel-context* relocating-min))
                 (< (the-as int param2-value) (-> *kernel-context* relocating-max)))
          (&+! (-> space param2) offset)))))
  this)

(defmethod relocate ((this nav-control) (offset int))
  "Adjust the owning process and collision-shape pointers after the process heap moves."
  (&+! (-> this process) offset)
  (&+! (-> this shape) offset)
  this)

(defmethod relocate ((this path-control) (offset int))
  "Adjust the owning process pointer after its process heap moves."
  (&+! (-> this process) offset)
  this)

(defmethod relocate ((this vol-control) (offset int))
  "Adjust the owning process pointer after its process heap moves."
  (&+! (-> this process) offset)
  this)

(defmethod relocate ((this water-control) (offset int))
  "Adjust the owning process pointer after its process heap moves."
  (&+! (-> this process) offset)
  this)

(defmethod relocate ((this actor-link-info) (offset int))
  "Adjust the owning process pointer after its process heap moves."
  (&+! (-> this process) offset)
  this)

(defmethod relocate ((this align-control) (offset int))
  "Adjust the owning process pointer after its process heap moves."
  (&+! (-> this process) offset)
  this)

(defmethod relocate ((this joint-mod) (offset int))
  "Adjust the owning process and controlled joint pointers after the process heap moves."
  (&+! (-> this process) offset)
  (&+! (-> this joint) offset)
  this)

(defmethod relocate ((this joint-mod-wheel) (offset int))
  "Adjust the owning process pointer after its process heap moves."
  (&+! (-> this process) offset)
  this)

(defmethod relocate ((this effect-control) (offset int))
  "Adjust the owning process pointer after its process heap moves."
  (&+! (-> this process) offset)
  this)

(defmethod relocate ((this sparticle-launch-control) (offset int))
  "Adjust the owner process and heap-local launch origins, then update the key and binding
   pointers of every live particle owned by this control."
  (&+! (-> this proc) offset)
  (countdown (i (-> this length))
    (let* ((launch-state (-> this data i))
           (origin-pointer (-> launch-state origin)))
      (if (and (>= (the-as int origin-pointer) (-> *kernel-context* relocating-min))
               (< (the-as int origin-pointer) (-> *kernel-context* relocating-max)))
        (&+! (-> launch-state origin) offset))))
  (forall-particles-with-key this
                             (lambda ((particle-system sparticle-system) (cpuinfo sparticle-cpuinfo))
                               (let ((relocation-offset (-> *kernel-context* relocating-offset)))
                                 (set! (-> cpuinfo key) (the-as sparticle-launch-control (+ (the-as int (-> cpuinfo key)) relocation-offset)))
                                 (if (-> cpuinfo binding)
                                   (set! (-> cpuinfo binding) (the-as sparticle-launch-state (+ (the-as int (-> cpuinfo binding)) relocation-offset)))))
                               0
                               (none))
                             #t
                             #t)
  this)

(defmethod relocate ((this camera-master) (offset int))
  "Adjust the optional water-drip particle control, then relocate the camera process."
  (if (nonzero? (-> this water-drip)) (&+! (-> this water-drip) offset))
  (the-as camera-master ((method-of-type process relocate) this offset)))

(defmethod relocate ((this time-of-day-proc) (offset int))
  "Adjust the four optional celestial particle controls, then relocate the process allocation."
  (if (nonzero? (-> this stars)) (&+! (-> this stars) offset))
  (if (nonzero? (-> this sun)) (&+! (-> this sun) offset))
  (if (nonzero? (-> this green-sun)) (&+! (-> this green-sun) offset))
  (if (nonzero? (-> this moon)) (&+! (-> this moon) offset))
  (the-as time-of-day-proc ((method-of-type process relocate) this offset)))

(defmethod relocate ((this swingpole) (offset int))
  "Adjust the optional root transform, then relocate the process."
  (if (nonzero? (-> this root)) (&+! (-> this root) offset))
  (the-as swingpole ((method-of-type process relocate) this offset)))

(defmethod relocate ((this part-tracker) (offset int))
  "Adjust the optional root transform and particle control, then relocate the process."
  (if (nonzero? (-> this root)) (&+! (-> this root) offset))
  (if (nonzero? (-> this part)) (&+! (-> this part) offset))
  (the-as part-tracker ((method-of-type process relocate) this offset)))

(defmethod relocate ((this manipy) (offset int))
  "Adjust all four optional joint modifiers, then relocate this drawable process."
  (if (nonzero? (-> this joint 0)) (&+! (-> this joint 0) offset))
  (if (nonzero? (-> this joint 1)) (&+! (-> this joint 1) offset))
  (if (nonzero? (-> this joint 2)) (&+! (-> this joint 2) offset))
  (if (nonzero? (-> this joint 3)) (&+! (-> this joint 3) offset))
  (the-as manipy ((method-of-type process-drawable relocate) this offset)))

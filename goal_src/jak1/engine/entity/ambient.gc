;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/level/bsp.gc")
(require "engine/ui/text.gc")
(require "engine/game/task/hint-control.gc")
(require "engine/game/settings.gc")
(define-extern level-hint-init-by-other (function text-id string entity none :behavior level-hint))

(define-extern ambient-hint-init-by-other (function string vector symbol none :behavior level-hint))

;; DECOMP BEGINS

(defmethod mem-usage ((this drawable-ambient) (usage memory-usage-block) (flags int))
  "Account for this wrapper and its referenced ambient entity in the ambient memory category."
  (set! (-> usage length) (max 50 (-> usage length)))
  (set! (-> usage data 49 name) "ambient")
  (+! (-> usage data 49 count) 1)
  (let ((object-size (asize-of this)))
    (+! (-> usage data 49 used) object-size)
    (+! (-> usage data 49 total) (logand -16 (+ object-size 15))))
  (mem-usage (-> this ambient) usage (logior flags 128))
  (the-as drawable-ambient 0))

(defmethod mem-usage ((this drawable-inline-array-ambient) (usage memory-usage-block) (flags int))
  "Account for this array header and each inline ambient wrapper it contains."
  (set! (-> usage length) (max 1 (-> usage length)))
  (set! (-> usage data 0 name) (symbol->string 'drawable-group))
  (+! (-> usage data 0 count) 1)
  (let ((header-size 32))
    (+! (-> usage data 0 used) header-size)
    (+! (-> usage data 0 total) (logand -16 (+ header-size 15))))
  (dotimes (i (-> this length))
    (mem-usage (-> this data i) usage flags))
  (the-as drawable-inline-array-ambient 0))

(define *hint-semaphore* (the-as (pointer level-hint) #f))

(defun level-hint-process-cmd ((commands (pointer int32)) (command-index int) (command-count int))
  "Execute the hint command at command-index using the following word as its task ID. Return the
   following command index, or -1 when a conditional command fails."
  (let ((command (-> commands command-index))
        (next-index (+ command-index 1)))
    (cond
      ((< next-index command-count)
       (let ((task (-> commands next-index))
             (selected-command command))
         (cond
           ((zero? selected-command) (if (task-known? (the-as game-task task)) (set! next-index -1)))
           ((= selected-command 1) (if (not (task-known? (the-as game-task task))) (set! next-index -1)))
           ((= selected-command 2) (if (nonzero? (get-task-status (the-as game-task task))) (set! next-index -1)))
           ((= selected-command 3)
            (if (!= (get-task-status (the-as game-task task)) (task-status need-introduction)) (set! next-index -1)))
           ((= selected-command 4)
            (if (!= (get-task-status (the-as game-task task)) (task-status need-reminder)) (set! next-index -1)))
           ((= selected-command 5)
            (if (!= (get-task-status (the-as game-task task)) (task-status need-reminder-a)) (set! next-index -1)))
           ((= selected-command 13)
            (let ((status (get-task-status (the-as game-task task))))
              (if (or (< (the-as int status) 2) (< 4 (the-as int status))) (set! next-index -1))))
           ((= selected-command 6)
            (if (!= (get-task-status (the-as game-task task)) (task-status need-reward-speech)) (set! next-index -1)))
           ((= selected-command 7) (close-specific-task! (the-as game-task task) (task-status need-hint)))
           ((= selected-command 8) (close-specific-task! (the-as game-task task) (task-status need-introduction)))
           ((= selected-command 9) (close-specific-task! (the-as game-task task) (task-status need-reminder)))
           ((= selected-command 10) (close-specific-task! (the-as game-task task) (task-status need-reminder-a)))
           ((= selected-command 11) (close-specific-task! (the-as game-task task) (task-status need-reward-speech)))
           ((= selected-command 12) (close-specific-task! (the-as game-task task) (task-status need-resolution)))
           (else (format #t "Unknown hint command ~D~%" command)))))
      (else
       (format #t
               "Missing task ID for hint command ~S~%"
               (cond
                 ((= command 13) "if-at-most-need-reminder-a")
                 ((= command 12) "close-need-resolution")
                 ((= command 11) "close-need-reward-speech")
                 ((= command 10) "close-need-reminder-a")
                 ((= command 9) "close-need-reminder")
                 ((= command 8) "close-need-introduction")
                 ((= command 7) "close-need-hint")
                 ((= command 6) "if-need-reward-speech")
                 ((= command 5) "if-need-reminder-a")
                 ((= command 4) "if-need-reminder")
                 ((= command 3) "if-need-introduction")
                 ((= command 2) "if-resolved")
                 ((= command 1) "if-known")
                 ((zero? command) "if-unknown")
                 (else "*unknown*")))))
    next-index))

(defun level-hint-task-process ((owner-entity entity) (default-text-id uint128) (text string))
  "Resolve owner's text-id, check whether the hint may play, and execute its pairs of hint commands.
   Return the resolved text ID when every command passes, or -1 when policy or a conditional command
   rejects it."
  (local-vars (commands-tag res-tag))
  (let ((resolved-text-id (res-lump-value owner-entity 'text-id int :default default-text-id))
        (command-index 0))
    (cond
      ((can-hint-be-played? (the-as text-id resolved-text-id) owner-entity text)
       (set! commands-tag (new 'static 'res-tag))
       (let ((commands ((method-of-type res-lump get-property-data)
                        owner-entity
                        'cmds
                        'exact
                        -1000000000.0
                        (the-as pointer #f)
                        (& commands-tag)
                        *res-static-buf*)))
         (when commands
           (while (and (>= command-index 0) (< command-index (the-as int (-> commands-tag elt-count))))
             (set! command-index
                   (level-hint-process-cmd (the-as (pointer int32) commands) command-index (the-as int (-> commands-tag elt-count))))
             (if (>= command-index 0) (set! command-index (+ command-index 1))))))
       0)
      (else (set! command-index -1)))
    (cond
      ((>= command-index 0) (empty) resolved-text-id)
      (else -1))))

(defun level-hint-surpress! ()
  "Restart the global delay that prevents another level hint from playing."
  (set-time! (-> *game-info* hint-play-time))
  0
  (none))

(defun can-grab-display? ((requester process))
  "Let requester claim the shared hint display when it is free, already owned by requester, or
   stale for one tenth of a second, provided normal gameplay can show text."
  (let ((current-owner (handle->process (-> *game-info* display-text-handle))))
    (when (and (or (not current-owner) (= current-owner requester) (time-elapsed? (-> *game-info* display-text-time) (seconds 0.1)))
               (and *target*
                    (!= (-> *target* next-state name) 'target-look-around)
                    (not (logtest? (-> *target* state-flags) (state-flags being-attacked dying)))
                    (= *master-mode* 'game)))
      (set! (-> *game-info* display-text-handle) (process->handle requester))
      (set-time! (-> *game-info* display-text-time))
      #t)))

(defun level-hint-displayed? ()
  "Return true while the active text hint is in its normal display state and has not appeared for
   five seconds."
  (let* ((hint-pointer *hint-semaphore*)
         (active-hint (the-as level-hint (if hint-pointer (the-as level-hint (-> hint-pointer 0 self))))))
    (the-as symbol
            (and active-hint
                 (and (= (-> active-hint next-state name) 'level-hint-normal) (not (appeared-for-long-enough? active-hint)))))))

(defun level-hint-spawn ((hint-text-id text-id) (stream-name string) (owner-entity entity) (parent-process-tree process-tree) (task game-task))
  "Advance task to need-hint when supplied, apply owner's hint command list, replace the active
   hint, and spawn a text hint under process-tree. Do nothing when policy or a command rejects it."
  (if (< (the-as uint 1) (the-as uint task)) (close-specific-task! task (task-status need-hint)))
  (let ((resolved-text-id (level-hint-task-process owner-entity (the-as uint128 hint-text-id) stream-name)))
    (when (!= resolved-text-id -1)
      (kill-current-level-hint '() '() 'exit)
      (process-spawn level-hint resolved-text-id stream-name owner-entity :to parent-process-tree)))
  0
  (none))

(defun ambient-hint-spawn ((stream-name string) (position vector) (parent-process-tree process-tree) (mode symbol))
  "Spawn a positional ambient, camera, or stinger hint under process-tree when no hint is active.
   Camera hints first dismiss the current hint."
  (case mode
    (('camera) (kill-current-level-hint '() '() 'exit)))
  (and (not *hint-semaphore*)
       (process-spawn level-hint :init ambient-hint-init-by-other stream-name position mode :to parent-process-tree)))

(defun kill-current-level-hint ((include-modes pair) (exclude-modes pair) (event-name symbol))
  "Send event to the active level hint when its mode is present in include-modes, or when the
   include list is empty, and is absent from exclude-modes."
  (when *hint-semaphore*
    (let ((active-hint (ppointer->process *hint-semaphore*)))
      (if (and (or (null? include-modes) (member (-> (the-as level-hint active-hint) mode) include-modes))
               (not (member (-> (the-as level-hint active-hint) mode) exclude-modes)))
        (send-event (the-as level-hint active-hint) event-name))))
  0
  (none))

;; og:preserve-this
(#when PC_PORT
  (define *level-hint-spool-name* (the string #f)))

(defbehavior level-hint-init-by-other level-hint ((hint-text-id text-id) (default-stream-name string) (owner-entity entity))
  "Initialize a resource-backed text hint, mark its text as seen, claim the hint semaphore, and
   select text, sidekick speech, or voicebox playback from the owner's play-mode properties."
  (mark-text-as-seen *game-info* hint-text-id)
  (set! (-> self text-id-to-display) hint-text-id)
  (set! (-> self sound-to-play) default-stream-name)
  (set! (-> self total-time) 0)
  (set! (-> self total-off-time) 0)
  (set-time! (-> self last-time))
  (set! *hint-semaphore* (the-as (pointer level-hint) (process->ppointer self)))
  (add-setting! 'hint (process->ppointer self) 0.0 0)
  (set! (-> self voicebox) (the-as handle #f))
  (let ((play-mode (res-lump-struct owner-entity 'play-mode structure))
        (resolved-stream-name (the-as string
                                      ((method-of-type res-lump get-property-struct)
                                       owner-entity
                                       'sound-name
                                       'interp
                                       -1000000000.0
                                       (-> self sound-to-play)
                                       (the-as (pointer res-tag) #f)
                                       *res-static-buf*))))
    (if (and (not play-mode) resolved-stream-name)
      (set! play-mode
            (if (or (and (= (-> resolved-stream-name data 0) 115) (= (-> resolved-stream-name data 1) 97))
                    (and (= (-> resolved-stream-name data 0) 97) (= (-> resolved-stream-name data 1) 115)))
              'voicebox
              'sidekick)))
    (set! (-> self mode) (the-as symbol play-mode))
    (if (or (= play-mode 'sidekick) (= play-mode 'voicebox)) (go level-hint-sidekick resolved-stream-name)))
  (go level-hint-normal)
  0
  (none))

(defbehavior ambient-hint-init-by-other level-hint ((stream-name string) (position vector) (mode symbol))
  "Initialize a positional ambient, camera, or stinger sound hint, claim the hint semaphore, and
   install cleanup for exit and death events."
  (set! (-> self sound-to-play) stream-name)
  (set! (-> self total-time) 0)
  (set! (-> self total-off-time) 0)
  (set-time! (-> self last-time))
  (set! (-> self trans) position)
  (set! *hint-semaphore* (the-as (pointer level-hint) (process->ppointer self)))
  (add-setting! 'hint (process->ppointer self) 0.0 0)
  (set! (-> self mode) mode)
  (if (or (= mode 'camera) (= mode 'ambient) (= mode 'stinger)) (add-setting! 'ambient (process->ppointer self) 0.0 0))
  (apply-settings *setting-control*)
  (set! (-> self event-hook)
        (lambda :behavior level-hint ((sender process) (unused-param int) (event-name symbol) (message event-message-block))
          (case event-name
            (('die 'exit)
             (if (= (ppointer->process *hint-semaphore*) self) (set! *hint-semaphore* (the-as (pointer level-hint) #f)))
             (deactivate self)))))
  (go level-hint-ambient-sound stream-name)
  0
  (none))

(defmethod print-text ((this level-hint))
  "Draw this hint's localized text in the bottom-center hint region."
  (when (!= *common-text* #f)
    (let ((text-context (new 'stack 'font-context *font-default-matrix* 56 160 0.0 (font-color default) (font-flags shadow kerning))))
      (set-width! text-context 400)
      (set-height! text-context 96)
      (set! (-> text-context flags) (font-flags shadow kerning middle large))
      (print-game-text (lookup-text! *common-text* (-> this text-id-to-display) #f) text-context #f 128 22)))
  0
  (none))

(defmethod appeared-for-long-enough? ((this level-hint))
  "Return true after a non-sidekick hint has remained active for more than five seconds."
  (and (!= (-> this next-state name) 'level-hint-sidekick) (< (seconds 5) (-> this total-time))))

;; Show a text hint for up to eight active seconds. Time spent behind menus, movies, or an occupied
;; HUD is tracked separately so a hint that cannot regain the display eventually gives up.
(defstate level-hint-normal (level-hint)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('exit) (go level-hint-exit))
        (('die) (deactivate self))))
  :exit
    (behavior ()
      (if (= (ppointer->process *hint-semaphore*) self) (set! *hint-semaphore* (the-as (pointer level-hint) #f))))
  :code
    (behavior ()
      (cond
        ((= (-> self text-id-to-display) (text-id zero)) (if *debug-segment* (go level-hint-error "UNKNOWN TEXT ID" "")))
        (else
         (while (>= (seconds 8) (-> self total-time))
           (hide-bottom-hud)
           (suspend)
           (cond
             ((and (bottom-hud-hidden?)
                   (not (paused?))
                   (not (movie?))
                   (= *master-mode* 'game)
                   (or (not *target*) (!= (-> *target* cam-user-mode) 'look-around))
                   (not (-> *hud-parts* money-all)))
              (print-text self)
              (+! (-> self total-time) (- (current-time) (-> self last-time)))
              (set-time! (-> self last-time)))
             (else
              (+! (-> self total-off-time) (- (current-time) (-> self last-time)))
              (if (or (< (seconds 6) (-> self total-time)) (< (seconds 10) (-> self total-off-time))) (go level-hint-exit))))
           (set-time! (-> self last-time)))))
      (go level-hint-exit)))

;; Play a streamed sidekick line, optionally creating its voicebox. The movie volume settings stay
;; active until the stream ends, stalls for three seconds, or reaches the one-minute safety limit.
(defstate level-hint-sidekick (level-hint)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('exit)
         (when (nonzero? (-> self sound-id))
           (sound-stop (-> self sound-id))
           (set! (-> self sound-id) (new 'static 'sound-id))
           0)
         (go level-hint-exit))
        (('die) (deactivate self))))
  :exit
    (behavior ()
      ;; og:preserve-this
      (#when PC_PORT
        (set! *level-hint-spool-name* #f))
      (if (nonzero? (-> self sound-id)) (sound-stop (-> self sound-id)))
      (remove-setting! 'music-volume)
      (remove-setting! 'sfx-volume)
      (remove-setting! 'dialog-volume)
      (if (= (ppointer->process *hint-semaphore*) self) (set! *hint-semaphore* (the-as (pointer level-hint) #f)))
      (send-event (handle->process (-> self voicebox)) 'die))
  :code
    (behavior ((stream-name string))
      ;; og:preserve-this
      (#when PC_PORT
        (set! *level-hint-spool-name* stream-name))
      (when (and (-> *setting-control* current play-hints) (< 0.0 (-> *setting-control* current dialog-volume)))
        (case (-> self mode)
          (('voicebox) (if *target* (set! (-> self voicebox) (ppointer->handle (voicebox-spawn *target* (target-pos 0)))))))
        (while (handle->process (-> *game-info* auto-save-proc))
          (suspend))
        (while (not *sound-player-enable*)
          (suspend))
        (let ((play-sound sound-play-by-name)
              (convert-sound-name string->sound-name))
          (format (clear *temp-string*) "spool-~S" stream-name)
          (let ((playing-sound-id (play-sound (convert-sound-name *temp-string*) (new-sound-id) 1024 0 0 (sound-group sfx) #t)))
            (set! (-> self sound-id) playing-sound-id)
            (let ((load-start-time (current-time)))
              (while (and (!= (current-str-id) playing-sound-id) (not (time-elapsed? load-start-time (seconds 5))))
                (suspend)))
            (cond
              ((= (current-str-id) playing-sound-id)
               (add-setting! 'music-volume 'rel (-> *setting-control* current music-volume-movie) 0)
               (add-setting! 'sfx-volume 'rel (-> *setting-control* current sfx-volume-movie) 0)
               (add-setting! 'dialog-volume 'rel (-> *setting-control* current dialog-volume-hint) 0)
               ;; og:preserve-this PAL patch here
               (let ((last-stream-position -1)
                     (last-progress-time (current-time))
                     (playback-start-time (current-time)))
                 (label cfg-27)
                 (let ((stream-position (current-str-pos playing-sound-id)))
                   (when (< last-stream-position stream-position)
                     (if (> stream-position 0) (set! last-stream-position stream-position))
                     (set! last-progress-time (-> *display* base-frame-counter)))
                   (when (not (and (or (< stream-position 0)
                                       (time-elapsed? last-progress-time (seconds 3))
                                       (time-elapsed? playback-start-time (seconds 60)))
                                   *sound-player-enable*))
                     (suspend)
                     (goto cfg-27)))))
              (else (go level-hint-error "NO SOUND " stream-name))))))
      (go level-hint-exit)))

;; Play a positional ambient line or a global camera/stinger line. Camera and stinger playback
;; temporarily use movie sound levels; the same progress and safety limits prevent a stuck stream
;; from holding those settings indefinitely.
(defstate level-hint-ambient-sound (level-hint)
  :event
    (-> level-hint-sidekick
        event)
  :exit
    (behavior ()
      (if (nonzero? (-> self sound-id)) (sound-stop (-> self sound-id)))
      (remove-setting! 'music-volume)
      (remove-setting! 'sfx-volume)
      (if (= (ppointer->process *hint-semaphore*) self) (set! *hint-semaphore* (the-as (pointer level-hint) #f))))
  :code
    (behavior ((stream-name string))
      (while (not *sound-player-enable*)
        (suspend))
      (cond
        ((-> self trans)
         (let ((play-positional-sound sound-play-by-name)
               (convert-positional-sound-name string->sound-name))
           (format (clear *temp-string*) "spool-~S" stream-name)
           (set! (-> self sound-id)
                 (play-positional-sound (convert-positional-sound-name *temp-string*)
                                        (new-sound-id)
                                        1024
                                        1
                                        0
                                        (sound-group sfx)
                                        (the-as symbol (-> self trans))))))
        (else
         (let ((play-global-sound sound-play-by-name)
               (convert-global-sound-name string->sound-name))
           (format (clear *temp-string*) "spool-~S" stream-name)
           (set! (-> self sound-id)
                 (play-global-sound (convert-global-sound-name *temp-string*) (new-sound-id) 1024 0 0 (sound-group sfx) #t)))))
      (let ((load-start-time (current-time)))
        (while (and (!= (current-str-id) (-> self sound-id)) (not (time-elapsed? load-start-time (seconds 5))))
          (suspend)))
      (cond
        ((= (current-str-id) (-> self sound-id))
         (when (or (= (-> self mode) 'stinger) (= (-> self mode) 'camera))
           (add-setting! 'music-volume 'rel (-> *setting-control* current music-volume-movie) 0)
           (add-setting! 'sfx-volume 'rel (-> *setting-control* current sfx-volume-movie) 0))
         ;; og:preserve-this PAL patch here
         (let ((last-stream-position -1)
               (last-progress-frame (-> *display* base-frame-counter))
               (playback-start-frame (-> *display* base-frame-counter)))
           (label cfg-19)
           (let ((stream-position (current-str-pos (-> self sound-id))))
             (when (< last-stream-position stream-position)
               (if (> stream-position 0) (set! last-stream-position stream-position))
               (set! last-progress-frame (-> *display* base-frame-counter)))
             (when (not (and (or (< stream-position 0)
                                 (>= (- (-> *display* base-frame-counter) last-progress-frame) (seconds 3))
                                 (>= (- (-> *display* base-frame-counter) playback-start-frame) (seconds 60)))
                             *sound-player-enable*))
               (suspend)
               (goto cfg-19)))))
        (else (go level-hint-error "NO SOUND " stream-name)))
      (go level-hint-exit)))

;; Display an art/debug error for one second in the normal hint area.
(defstate level-hint-error (level-hint)
  :event
    (-> level-hint-normal
        event)
  :code
    (behavior ((prefix string) (suffix string))
      (remove-setting! 'hint)
      (suspend-for (seconds 1)
        (when (and *debug-segment* (not (paused?)) (not (str-is-playing?)) (bottom-hud-hidden?))
          (let ((text-context (new 'stack 'font-context *font-default-matrix* 56 160 0.0 (font-color default) (font-flags shadow kerning))))
            (set-width! text-context 400)
            (set-height! text-context 96)
            (set! (-> text-context flags) (font-flags shadow kerning middle))
            (let ((draw-text print-game-text))
              (format (clear *temp-string*) "~S~S" prefix suffix)
              (draw-text *temp-string* text-context #f 128 22)))))
      (go level-hint-exit)))

;; Release the hint semaphore before the process is deactivated.
(defstate level-hint-exit (level-hint)
  :code
    (behavior ()
      (if (= (ppointer->process *hint-semaphore*) self) (set! *hint-semaphore* (the-as (pointer level-hint) #f)))))

(defun ambient-type-error ((ambient-drawable drawable-ambient) (query-position vector))
  "Draw a red editor error label for an ambient whose properties could not select a valid effect."
  (when *display-entity-errors*
    (let ((ambient-entity (-> ambient-drawable ambient)))
      (format (clear *temp-string*)
              "~2j~s art error for ~s ~s"
              (res-lump-struct ambient-entity 'effect-name structure :time 0.0)
              (res-lump-struct ambient-entity 'type structure)
              (res-lump-struct ambient-entity 'name structure)))
    *temp-string*
    (add-debug-text-3d #t
                       (bucket-id debug-no-zbuf)
                       *temp-string*
                       (-> ambient-drawable bsphere)
                       (font-color red)
                       (the-as vector2h #f)))
  0
  (none))

(defun ambient-type-poi ((ambient-drawable drawable-ambient) (query-position vector))
  "Perform the per-frame step for a point-of-interest ambient; this type needs no additional
   action after it has been collected."
  0
  (none))

(defun ambient-type-hint ((ambient-drawable drawable-ambient) (query-position vector))
  "Apply this ambient's hint policy and spawn its level hint, or display the missing-ID diagnostic
   in debug builds."
  (with-pp
    (let ((resolved-text-id (level-hint-task-process (-> ambient-drawable ambient) (the-as uint128 0) (the-as string #f))))
      (cond
        ((zero? resolved-text-id)
         (when (and *debug-segment* (not (paused?)) (not (str-is-playing?)) (bottom-hud-hidden?))
           (let ((text-context (new 'stack 'font-context *font-default-matrix* 56 160 0.0 (font-color default) (font-flags shadow kerning))))
             (set-width! text-context 400)
             (set-height! text-context 96)
             (set! (-> text-context flags) (font-flags shadow kerning middle large))
             (print-game-text "AS: UNKNOWN ID" text-context #f 128 22))))
        ((!= resolved-text-id -1)
         (kill-current-level-hint '() '() 'exit)
         (process-spawn level-hint resolved-text-id #f (-> ambient-drawable ambient) :to pp))))
    0
    (none)))

(defun ambient-type-sound ((ambient-drawable drawable-ambient) (query-position vector))
  "At the ambient's randomized cycle interval, choose an effect-name variant and play it at the
   ambient sphere with its effect parameters and a small random bend."
  (local-vars (effect-sound-name string) (effect-param-tag res-tag))
  (let* ((ambient-entity (-> ambient-drawable ambient))
         (scheduled-time (-> ambient-entity ambient-data user-uint64 0)))
    (when (>= (current-time) (the-as time-frame scheduled-time))
      (let ((cycle-speed (res-lump-data ambient-entity 'cycle-speed pointer)))
        (set! (-> ambient-entity ambient-data user-uint64 0)
              (the-as uint
                      (+ (current-time)
                         (the int (* 300.0 (-> (the-as (pointer float) cycle-speed) 0)))
                         (rand-vu-int-count (the int (* 300.0 (-> (the-as (pointer float) cycle-speed) 1))))))))
      (when (< (the-as uint (- (current-time) (the-as int scheduled-time))) (the-as uint 300))
        (let ((effect-index (the float (rand-vu-int-count (the-as int (-> ambient-entity ambient-data user-float 2))))))
          (set! effect-sound-name (symbol->string (res-lump-struct ambient-entity 'effect-name symbol :time effect-index)))
          (let ((spec (new 'stack 'sound-spec)))
            (set! (-> spec sound-name) (string->sound-name effect-sound-name))
            (logior! (-> spec mask) (sound-mask volume))
            (set! (-> spec volume) 1024)
            (logior! (-> spec mask) (sound-mask bend))
            (set! (-> spec bend) (the int (* 327.66998 (rand-vu-float-range -100.0 100.0))))
            (set! effect-param-tag (new 'static 'res-tag))
            (let ((effect-params ((method-of-type res-lump get-property-data)
                                  ambient-entity
                                  'effect-param
                                  'exact
                                  effect-index
                                  (the-as pointer #f)
                                  (& effect-param-tag)
                                  *res-static-buf*)))
              (if effect-params
                (effect-param->sound-spec spec (the-as (pointer float) effect-params) (the-as int (-> effect-param-tag elt-count)))))
            (when *debug-effect-control*
              (format #t "(~5D) effect sound ~A ~S " (current-time) (res-lump-struct ambient-entity 'name structure) effect-sound-name)
              (format #t
                      "volume: ~f  pitch-mod: ~f~%"
                      (* 0.09765625 (the float (-> spec volume)))
                      (* 0.000656168 (the float (-> spec pitch-mod)))))
            (sound-play-by-spec spec (new-sound-id) (-> ambient-drawable bsphere)))))))
  0
  (none))

(defun ambient-type-sound-loop ((ambient-drawable drawable-ambient) (query-position vector))
  "Refresh the ambient's persistent looping sound at its sphere using the properties cached at
   birth."
  (let* ((ambient-entity (-> ambient-drawable ambient))
         (effect-sound-name (symbol->string (the-as symbol (-> ambient-entity ambient-data user-float 2))))
         (effect-param-tag (the-as object (-> ambient-entity ambient-data user-float 1)))
         (spec (new 'stack 'sound-spec)))
    (set! (-> spec sound-name) (string->sound-name effect-sound-name))
    (logior! (-> spec mask) (sound-mask volume))
    (set! (-> spec volume) 1024)
    (when (the-as (pointer res-tag) effect-param-tag)
      (let ((apply-effect-params effect-param->sound-spec)
            (sound-spec-arg spec)
            (effect-entity (-> ambient-drawable ambient))
            (effect-param (-> (the-as (pointer res-tag) effect-param-tag) 0)))
        (apply-effect-params sound-spec-arg
                             (the-as (pointer float) (&+ (-> effect-entity data-base) (-> effect-param data-offset)))
                             (the-as int (-> (the-as (pointer res-tag) effect-param-tag) 0 elt-count)))))
    (sound-play-by-spec spec (the-as sound-id (-> ambient-entity ambient-data user-float 0)) (-> ambient-drawable bsphere)))
  0
  (none))

(defun ambient-type-light ((ambient-drawable drawable-ambient) (query-position vector))
  "Test query-position against this ambient's convex volumes. The light type has no additional
   per-frame action after a containing volume is found."
  (when *target*
    (let ((ambient-entity (-> ambient-drawable ambient))
          (inside? #t))
      (let ((first-volume-tag-index (-> ((method-of-type res-lump lookup-tag-idx) ambient-entity 'vol 'exact 0.0) lo)))
        (when (>= (the-as int first-volume-tag-index) 0)
          (let ((volume-tag-index (the-as int first-volume-tag-index))
                (volume-tag (-> ambient-entity tag first-volume-tag-index)))
            0
            (while (= (-> volume-tag name) (-> ambient-entity tag first-volume-tag-index name))
              (let ((planes (the-as object (make-property-data ambient-entity 0.0 (the-as res-tag-pair volume-tag-index) (the-as pointer #f)))))
                (set! inside? #t)
                (countdown (i (-> volume-tag elt-count))
                  (when (< (-> query-position w)
                           (- (vector-dot query-position (-> (the-as (inline-array vector) planes) i))
                              (-> (the-as (inline-array vector) planes) i w)))
                    (set! inside? #f)
                    (goto cfg-9))))
              (label cfg-9)
              (if inside? (goto cfg-15))
              (+! volume-tag-index 1)
              (set! volume-tag (-> ambient-entity tag volume-tag-index))))))
      (label cfg-15)
      (when inside?)))
  0
  (none))

(defun ambient-type-dark ((ambient-drawable drawable-ambient) (query-position vector))
  "Set the target's secondary draw interpolation to full when query-position lies within any of
   this ambient's convex volumes."
  (when *target*
    (let ((ambient-entity (-> ambient-drawable ambient))
          (inside? #t))
      (let ((first-volume-tag-index (-> ((method-of-type res-lump lookup-tag-idx) ambient-entity 'vol 'exact 0.0) lo)))
        (when (>= (the-as int first-volume-tag-index) 0)
          (let ((volume-tag-index (the-as int first-volume-tag-index))
                (volume-tag (-> ambient-entity tag first-volume-tag-index)))
            0
            (while (= (-> volume-tag name) (-> ambient-entity tag first-volume-tag-index name))
              (let ((planes (the-as object (make-property-data ambient-entity 0.0 (the-as res-tag-pair volume-tag-index) (the-as pointer #f)))))
                (set! inside? #t)
                (countdown (i (-> volume-tag elt-count))
                  (when (< (-> query-position w)
                           (- (vector-dot query-position (-> (the-as (inline-array vector) planes) i))
                              (-> (the-as (inline-array vector) planes) i w)))
                    (set! inside? #f)
                    (goto cfg-9))))
              (label cfg-9)
              (if inside? (goto cfg-15))
              (+! volume-tag-index 1)
              (set! volume-tag (-> ambient-entity tag volume-tag-index))))))
      (label cfg-15)
      (if inside? (set! (-> *target* draw secondary-interp) 1.0))))
  0
  (none))

(defun ambient-type-weather-off ((ambient-drawable drawable-ambient) (query-position vector))
  "Disable weather when query-position lies within any of this ambient's convex volumes."
  (when *target*
    (let ((ambient-entity (-> ambient-drawable ambient))
          (inside? #t))
      (let ((first-volume-tag-index (-> ((method-of-type res-lump lookup-tag-idx) ambient-entity 'vol 'exact 0.0) lo)))
        (when (>= (the-as int first-volume-tag-index) 0)
          (let ((volume-tag-index (the-as int first-volume-tag-index))
                (volume-tag (-> ambient-entity tag first-volume-tag-index)))
            0
            (while (= (-> volume-tag name) (-> ambient-entity tag first-volume-tag-index name))
              (let ((planes (the-as object (make-property-data ambient-entity 0.0 (the-as res-tag-pair volume-tag-index) (the-as pointer #f)))))
                (set! inside? #t)
                (countdown (i (-> volume-tag elt-count))
                  (when (< (-> query-position w)
                           (- (vector-dot query-position (-> (the-as (inline-array vector) planes) i))
                              (-> (the-as (inline-array vector) planes) i w)))
                    (set! inside? #f)
                    (goto cfg-9))))
              (label cfg-9)
              (if inside? (goto cfg-15))
              (+! volume-tag-index 1)
              (set! volume-tag (-> ambient-entity tag volume-tag-index))))))
      (label cfg-15)
      (if inside? (set! *weather-off* #t))))
  0
  (none))

(defun ambient-type-ocean-off ((ambient-drawable drawable-ambient) (query-position vector))
  "Disable the full ocean pass while this already-collected ambient is active."
  (set! *ocean-off* #t)
  0
  (none))

(defun ambient-type-ocean-near-off ((ambient-drawable drawable-ambient) (query-position vector))
  "Disable nearby ocean geometry while this already-collected ambient is active."
  (set! *ocean-near-off* #t)
  0
  (none))

(defun ambient-type-music ((ambient-drawable drawable-ambient) (query-position vector))
  "Apply this ambient's default music and, when its priority wins, its sound-flavor selection."
  (let ((ambient-entity (-> ambient-drawable ambient)))
    (if (-> ambient-entity ambient-data user-float 0)
      (set! (-> *setting-control* default music) (the-as symbol (-> ambient-entity ambient-data user-float 0))))
    (when (nonzero? (-> ambient-entity ambient-data user-float 1))
      (let ((priority (res-lump-float ambient-entity 'priority :default 10.0)))
        (when (>= priority (-> *setting-control* default sound-flava-priority))
          ;; og:preserve-this TODO this following form has been manually modified to work
          (set! (-> *setting-control* default sound-flava) (the-as uint (-> ambient-entity ambient-data user-int32 1)))
          (set! (-> *setting-control* default sound-flava-priority) priority)))))
  0
  (none))

(defmethod collect-ambients ((this drawable-ambient) (query-sphere sphere) (count int) (result ambient-list))
  "Traverse count contiguous siblings beginning at this and append ambient
   objects overlapping query-sphere to result."
  (dotimes (i count)
    (when (spheres-overlap? query-sphere (the-as sphere (-> this bsphere)))
      (set! (-> result items (-> result num-items)) this)
      (+! (-> result num-items) 1))
    (&+! this 32))
  0
  (none))

(defmethod collect-ambients ((this drawable-inline-array-ambient) (query-sphere sphere) (count int) (result ambient-list))
  "Traverse count contiguous siblings beginning at this and append ambient
   objects overlapping query-sphere to result."
  (collect-ambients (the-as drawable-ambient (-> this data)) query-sphere (-> this length) result)
  0
  (none))

(defmethod collect-ambients ((this drawable-tree-ambient) (query-sphere sphere) (count int) (result ambient-list))
  "Traverse count contiguous siblings beginning at this and append ambient
   objects overlapping query-sphere to result."
  (collect-ambients (-> this data 0) query-sphere (-> this length) result)
  0
  (none))

(defmethod birth-ambient! ((this entity-ambient))
  "Decode this entity's resource properties into the compact ambient-data payload and select
   the function that applies its ambient effect."
  (set! (-> this ambient-data quad) (the-as uint128 0))
  (set! (-> this ambient-data function) ambient-type-error)
  (case (res-lump-struct this 'type structure)
    (('sound)
     (let ((effect-name (res-lump-struct this 'effect-name structure :time 0.0))
           (cycle-speed (res-lump-data this 'cycle-speed pointer)))
       (when (and effect-name cycle-speed)
         (cond
           ((>= (-> (the-as (pointer float) cycle-speed)) 0.0)
            (set! (-> this ambient-data function) ambient-type-sound)
            (set! (-> this ambient-data user-float 2) (the-as float 0))
            (let ((first-effect-tag-index (-> ((method-of-type res-lump lookup-tag-idx) this 'effect-name 'exact 0.0) lo)))
              (when (>= (the-as int first-effect-tag-index) 0)
                (let ((effect-tag-index (the-as int first-effect-tag-index))
                      (effect-tag (-> this tag first-effect-tag-index)))
                  0
                  (while (= (-> effect-tag name) (-> this tag first-effect-tag-index name))
                    (make-property-data this 0.0 (the-as res-tag-pair effect-tag-index) (the-as pointer #f))
                    (set! (-> this ambient-data user-float 2) (the-as float (+ (the-as int (-> this ambient-data user-float 2)) 1)))
                    (+! effect-tag-index 1)
                    (set! effect-tag (-> this tag effect-tag-index)))))))
           (else
            (set! (-> this ambient-data user-float 0) (the-as float (new-sound-id)))
            (let ((effect-param-tag ((method-of-type res-lump lookup-tag-idx) this 'effect-param 'exact 0.0)))
              (set! (-> this ambient-data user-float 1)
                    (the-as float
                            (if (< (the-as int effect-param-tag) 0) (the-as (pointer res-tag) #f) (&-> this tag (-> effect-param-tag lo))))))
            (set! (-> this ambient-data user-float 2) (the-as float effect-name))
            (set! (-> this ambient-data function) ambient-type-sound-loop))))))
    (('poi)
     (let ((poi-effect-name (res-lump-struct this 'effect-name structure :time 0.0)))
       (when (res-lump-value this 'loc-name-id uint128)
         (set! (-> this ambient-data user-float 2) (the-as float poi-effect-name))
         (set! (-> this ambient-data function) ambient-type-poi))))
    (('hint)
     (let ((hint-effect-name (res-lump-struct this 'effect-name structure :time 0.0)))
       (when (res-lump-value this 'text-id uint128)
         (set! (-> this ambient-data user-float 2) (the-as float hint-effect-name))
         (set! (-> this ambient-data function) ambient-type-hint))))
    (('light)
     (set! (-> this ambient-data user-float 2) (res-lump-struct this 'effect-name float :time 0.0))
     (set! (-> this ambient-data function) ambient-type-light))
    (('dark)
     (set! (-> this ambient-data user-float 2) (res-lump-struct this 'effect-name float :time 0.0))
     (set! (-> this ambient-data function) ambient-type-dark))
    (('weather-off)
     (set! (-> this ambient-data user-float 2) (res-lump-struct this 'effect-name float :time 0.0))
     (set! (-> this ambient-data function) ambient-type-weather-off))
    (('ocean-off)
     (set! (-> this ambient-data user-float 2) (res-lump-struct this 'effect-name float :time 0.0))
     (set! (-> this ambient-data function) ambient-type-ocean-off))
    (('ocean-near-off)
     (set! (-> this ambient-data user-float 2) (res-lump-struct this 'effect-name float :time 0.0))
     (set! (-> this ambient-data function) ambient-type-ocean-near-off))
    (('music)
     (set! (-> this ambient-data user-float 2) (res-lump-struct this 'effect-name float :time 0.0))
     (set! (-> this ambient-data user-float 0) (res-lump-struct this 'music float))
     (set! (-> this ambient-data user-float 1) (res-lump-value this 'flava float))
     (set! (-> this ambient-data function) ambient-type-music)))
  (none))

(define *execute-ambients* #t)

(defmethod execute-ambient ((this drawable-ambient) (query-position vector))
  "Invoke the referenced ambient entity's handler at query-position."
  ((-> this ambient ambient-data function) this query-position)
  0
  (none))

(defmethod draw-debug ((this entity-ambient))
  "Draw this ambient's enabled editor marker, label, type, and resource-specific annotation."
  (let ((position (-> this trans))
        (ambient-type (res-lump-struct this 'type symbol))
        (draw-marker? #f))
    (cond
      ((= ambient-type 'sound)
       (when *display-ambient-sound-marks*
         (add-debug-text-3d #t
                            (bucket-id debug-no-zbuf)
                            (symbol->string (res-lump-struct this 'effect-name symbol :time 0.0))
                            position
                            (font-color white)
                            (new 'static 'vector2h :y 24))
         (set! draw-marker? #t)))
      ((= ambient-type 'hint)
       (when *display-ambient-hint-marks*
         (let ((hint-text-id (res-lump-value this 'text-id uint128))
               (draw-text add-debug-text-3d)
               (debug-enabled? #t)
               (debug-bucket 68))
           (format (clear *temp-string*) "TEXT ID #x~X" hint-text-id)
           (draw-text debug-enabled?
                      (the-as bucket-id debug-bucket)
                      *temp-string*
                      position
                      (font-color white)
                      (new 'static 'vector2h :y 24)))
         (set! draw-marker? #t)))
      ((= ambient-type 'poi)
       (when *display-ambient-poi-marks*
         (let ((location-text-id (res-lump-value this 'loc-name-id uint128)))
           (when (and (nonzero? location-text-id) *common-text*)
             (add-debug-text-3d #t
                                (bucket-id debug-no-zbuf)
                                (lookup-text! *common-text* (the-as text-id location-text-id) #f)
                                position
                                (font-color white)
                                (new 'static 'vector2h :y 24))
             (set! draw-marker? #t)))))
      ((= ambient-type 'light) (if *display-ambient-light-marks* (set! draw-marker? #t)))
      ((= ambient-type 'dark) (if *display-ambient-dark-marks* (set! draw-marker? #t)))
      ((= ambient-type 'weather-off) (if *display-ambient-weather-off-marks* (set! draw-marker? #t)))
      ((= ambient-type 'ocean-off) (if *display-ambient-ocean-off-marks* (set! draw-marker? #t)))
      ((= ambient-type 'ocean-near-off) (if *display-ambient-ocean-near-off-marks* (set! draw-marker? #t)))
      ((= ambient-type 'music) (if *display-ambient-music-marks* (set! draw-marker? #t))))
    (when draw-marker?
      (let ((draw-sphere add-debug-sphere)
            (sphere-debug-enabled? #t)
            (sphere-bucket 67)
            (sphere-position position)
            (sphere-radius (-> position w))
            (marker-type ambient-type))
        (draw-sphere sphere-debug-enabled?
                     (the-as bucket-id sphere-bucket)
                     sphere-position
                     sphere-radius
                     (cond
                       ((= marker-type 'sound) (new 'static 'rgba :r #xff :g #xff :a #x80))
                       ((= marker-type 'poi) (new 'static 'rgba :g #x80 :b #xff :a #x80))
                       (else (new 'static 'rgba :r #xff :a #x80)))))
      (add-debug-text-3d #t
                         (bucket-id debug-no-zbuf)
                         (res-lump-struct this 'name string)
                         position
                         (font-color white)
                         (new 'static 'vector2h :y 8))
      (add-debug-text-3d #t
                         (bucket-id debug-no-zbuf)
                         (symbol->string ambient-type)
                         position
                         (font-color white)
                         (new 'static 'vector2h :y 16))))
  0
  (none))

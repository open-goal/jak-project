;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/entity/res.gc")
(require "kernel/gstate.gc")
(require "engine/entity/entity-h.gc")
(require "engine/game/game-h.gc")

;; Actors can have references to other actors.
;; This file has utilities for resolving those references.

;; DECOMP BEGINS

(defun entity-actor-lookup ((lump res-lump) (name symbol) (idx int))
  "Resolve actor reference idx from a named resource entry. String entries use
   entity-by-name and integer entries use entity-by-aid; return false when the
   entry or index is absent."
  (let* ((sv-16 (new 'static 'res-tag))
         (refs (res-lump-data lump name (pointer uint32) :tag-ptr (& sv-16))))
    (the-as entity-actor
            (when (and refs (< idx (the-as int (-> sv-16 elt-count))))
              (if (= (-> sv-16 elt-type) string)
                (entity-by-name (-> (the-as (pointer string) refs) idx))
                (entity-by-aid (-> (the-as (pointer uint32) refs) idx)))))))

(defun entity-actor-count ((res res-lump) (name symbol))
  "Return the number of actor references in the named resource entry, or zero
   when it is absent."
  (let ((tag (new 'static 'res-tag)))
    (if (res-lump-data res name pointer :tag-ptr (& tag)) (the-as int (-> tag elt-count)) 0)))

;; Actors can also be in a linked list of actors. Each actor in the list
;; stores the next and previous in an element name `next-actor` or `prev-actor`.
;; actor-link-info is a cache of the actor lookup, however the cached result is
;; not always used.

(deftype actor-link-info (basic)
  ((process process)
   (next    entity-actor)
   (prev    entity-actor))
  (:methods
   (new (symbol type process) _type_)
   (get-matching-actor-type-mask (_type_ type) int)
   (actor-count-before (_type_) int)
   (link-to-next-and-prev-actor (_type_) entity-actor)
   (get-next (_type_) entity-actor)
   (get-prev (_type_) entity-actor)
   (get-next-process (_type_) process)
   (get-prev-process (_type_) process)
   (apply-function-forward (_type_ (function entity-actor object object) object) int)
   (apply-function-reverse (_type_ (function entity-actor object object) object) int)
   (apply-all (_type_ (function entity-actor object object) object) int)
   (send-to-all (_type_ symbol) none)
   (send-to-all-after (_type_ symbol) object)
   (send-to-all-before (_type_ symbol) object)
   (send-to-next-and-prev (_type_ symbol) none)
   (send-to-next (_type_ symbol) none)
   (send-to-prev (_type_ symbol) none)
   (actor-count (_type_) int)))

;;;;;;;;;;;;;;;;
;; Link Setup
;;;;;;;;;;;;;;;;

(defmethod next-actor ((this entity-actor))
  "Resolve the first next-actor reference from this actor's resource data."
  (declare (inline))
  (entity-actor-lookup this 'next-actor 0))

(defmethod prev-actor ((this entity-actor))
  "Resolve the first prev-actor reference from this actor's resource data."
  (declare (inline))
  (entity-actor-lookup this 'prev-actor 0))

(defmethod new actor-link-info ((allocation symbol) (type-to-make type) (proc process))
  "Create links for proc from the first next-actor and prev-actor references on
   its entity."
  (let ((this (object-new allocation type-to-make (the-as int (-> type-to-make size)))))
    (set! (-> this process) proc)
    (set! (-> this next) (next-actor (-> proc entity)))
    (set! (-> this prev) (prev-actor (-> proc entity)))
    this))

;;;;;;;;;;;;;;;;;;;;
;; Access
;;;;;;;;;;;;;;;;;;;;

;; These accessors use the immediate neighbors cached at construction time.
(defmethod get-next ((this actor-link-info))
  "Return the cached next actor."
  (-> this next))

(defmethod get-prev ((this actor-link-info))
  "Return the cached previous actor."
  (-> this prev))

(defmethod get-next-process ((this actor-link-info))
  "Return the live process attached to the next actor, or false if either is
   absent."
  (the-as process (and (-> this next) (-> this next extra process))))

(defmethod get-prev-process ((this actor-link-info))
  "Return the live process attached to the previous actor, or false if either
   is absent."
  (the-as process (and (-> this prev) (-> this prev extra process))))

(defmethod link-to-next-and-prev-actor ((this actor-link-info))
  "Refresh the cached neighbors from the process entity's resource data and
   return the next actor."
  (set! (-> this next) (next-actor (-> this process entity)))
  (set! (-> this prev) (prev-actor (-> this process entity)))
  (-> this next))

(defmethod apply-function-forward ((this actor-link-info) (callback (function entity-actor object object)) (context object))
  "Call callback on actors after this one in forward order. Stop and return
   false when it returns true; return 0 after visiting the remainder."
  (let ((actor (-> this next)))
    (while actor
      (if (callback actor context) (return (the-as int #f)))
      (set! actor (next-actor actor))))
  0)

(defmethod apply-function-reverse ((this actor-link-info) (callback (function entity-actor object object)) (context object))
  "Call callback on actors before this one in reverse order. Stop and return
   false when it returns true; return 0 after visiting the remainder."
  (let ((actor (-> this prev)))
    (while actor
      (if (callback actor context) (return (the-as int #f)))
      (set! actor (prev-actor actor))))
  0)

(defmethod apply-all ((this actor-link-info) (callback (function entity-actor object object)) (context object))
  "Walk from the first actor through the complete list, including this actor.
   Stop and return false when callback returns true; return 0 after visiting
   all actors."
  (let ((actor (-> this process entity)))
    ;; This performs the previous-link lookup twice per step.
    (while (prev-actor actor)
      (set! actor (prev-actor actor)))
    (while actor
      (if (callback actor context) (return (the-as int #f)))
      (set! actor (next-actor actor))))
  0)

(defmethod send-to-all-after ((this actor-link-info) (message symbol))
  "Send a parameterless message to each live process after this actor and
   return the most recent truthy event result."
  (let ((iter (-> this next))
        (result (the object #f)))
    (while iter
      (let ((proc (-> iter extra process)))
        (when proc
          (set! result (or (send-event proc message) result)))
        (set! iter (next-actor iter))))
    result))

(defmethod send-to-all-before ((this actor-link-info) (message symbol))
  "Send a parameterless message to each live process before this actor and
   return the most recent truthy event result."
  (let ((iter (-> this prev))
        (result (the object #f)))
    (while iter
      (let ((proc (-> iter extra process)))
        (when proc
          (set! result (or (send-event proc message) result)))
        (set! iter (prev-actor iter))))
    result))

(defmethod send-to-next ((this actor-link-info) (message symbol))
  "Send a parameterless message to the next actor's live process when present."
  (let ((actor (-> this next)))
    (when actor
      (let ((proc (-> actor extra process))) (when proc (send-event proc message)))))
  (none))

(defmethod send-to-prev ((this actor-link-info) (message symbol))
  "Send a parameterless message to the previous actor's live process when
   present."
  (let ((actor (-> this prev)))
    (when actor
      (let ((proc (-> actor extra process))) (when proc (send-event proc message)))))
  (none))

(defmethod send-to-next-and-prev ((this actor-link-info) (message symbol))
  "Send a parameterless message to the next and previous actors' live
   processes."
  (send-to-next this message)
  (send-to-prev this message)
  (none))

(defmethod send-to-all ((this actor-link-info) (message symbol))
  "Send a parameterless message to the processes of every actor before and
   after this one."
  (send-to-all-after this message)
  (send-to-all-before this message)
  (none))

(defmethod actor-count ((this actor-link-info))
  "Count all actors in the complete linked list, including this actor."
  (let ((actor (-> this process entity))
        (count 0))
    ;; get back to the beginning.
    (while (prev-actor actor)
      (set! actor (prev-actor actor)))
    ;; iterate and set the count
    (while actor
      (+! count 1)
      (set! actor (next-actor actor)))
    count))

(defmethod get-matching-actor-type-mask ((this actor-link-info) (matching-type type))
  "Return a mask whose nth bit is set when the nth actor in the complete linked
   list has matching-type."
  (let ((actor (the-as entity-actor (-> this process entity)))
        (mask 0))
    (let ((current-bit 1))
      ;; seek to beginning
      (while (prev-actor actor)
        (set! actor (prev-actor actor)))
      ;; loop over actors
      (while actor
        ;; if we match, set the bit
        (if (= (-> actor etype) matching-type) (set! mask (logior mask current-bit)))
        ;; next
        (set! actor (next-actor actor))
        ;; next bit
        (set! current-bit (ash current-bit 1))))
    mask))

(defmethod actor-count-before ((this actor-link-info))
  "Count the actors preceding this actor in the complete linked list."
  (let* ((this-actor (-> this process entity))
         (actor this-actor)
         (count 0))
    ;; go to beginning (why not count here???)
    (while (prev-actor actor)
      (set! actor (prev-actor actor)))
    ;; go forward, until we hit this actor
    (while (!= actor this-actor)
      (+! count 1)
      (set! actor (next-actor actor)))
    count))

(defun actor-link-subtask-complete-hook ((actor entity-actor) (result (pointer symbol)))
  "Set result to whether actor is complete and return false to stop traversal
   when it is."
  (cond
    ((logtest? (-> actor extra perm status) (entity-perm-status complete)) (set! (-> result 0) #t) #f)
    (else (set! (-> result 0) #f) #t)))

(defun actor-link-dead-hook ((actor entity-actor) (result (pointer symbol)))
  "Set result to whether actor is dead and return false to stop traversal when
   it is."
  (cond
    ((logtest? (-> actor extra perm status) (entity-perm-status dead)) (set! (-> result 0) #t) #f)
    (else (set! (-> result 0) #f) #t)))

(defun alt-actor-list-subtask-incomplete-count ((proc process-drawable))
  "Count missing or incomplete actors referenced by proc's alt-actor resource
   entry."
  (let ((alt-actor-count (entity-actor-count (the-as res-lump (-> proc entity)) 'alt-actor))
        (incomplete-count 0))
    (dotimes (i alt-actor-count)
      (let ((alt-actor (entity-actor-lookup (the-as res-lump (-> proc entity)) 'alt-actor i)))
        (if (or (not alt-actor) (zero? (logand (-> alt-actor extra perm status) (entity-perm-status complete))))
          (+! incomplete-count 1))))
    incomplete-count))

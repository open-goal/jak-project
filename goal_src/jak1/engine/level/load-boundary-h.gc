;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/math/vector-h.gc")
(require "engine/game/game-info-h.gc")

;; Load Boundary
;; This system is responsible for more than just the load boundaries - it also processes the commands
;; from cutscenes to kill/birth certain objects.

;; It also manages the "load state", which manages what levels are loading.
;; Crossing load boundaries will change this state.
;; Cutscene playback can also change this state.

;; DECOMP BEGINS

;; Boundary coordinates and the byte-sized links used while triangulating a closed polygon.
;; v0/v1/v2 are previous/next/active in *triangulation-buffer*, then triangle vertex indices in
;; load-boundary.data[0..tri-cnt). ix is the original vertex index.
(deftype lbvtx (structure)
  ((x    float)
   (y    float)
   (z    float)
   (v0   uint8)
   (v1   uint8)
   (v2   uint8)
   (ix   uint8)
   (quad uint128 :overlay-at x)
   (v    vector :inline :overlay-at x)))

;; Commands applied when a camera or player path crosses a load boundary.
(defenum load-boundary-cmd
  :type uint8
  (invalid 0) ;; No command.
  (load 1) ;; Replace the desired pair of loaded levels.
  (cmd2 2) ;; Unused
  (display 3) ;; Set a loaded level's display mode.
  (vis 4) ;; Select the active visibility nickname.
  (force-vis 5) ;; Bypass BSP visibility outside this level's inside boxes.
  (checkpt 6) ;; Select a continue point.
  )

;; Command to execute when crossing.
(deftype load-boundary-crossing-command (structure)
  ((cmd        load-boundary-cmd)
   (bparm      uint8 3)
   (parm       uint32 2)
   (lev0       basic :overlay-at (-> parm 0))
   (lev1       basic :overlay-at (-> parm 1))
   (displev    symbol :overlay-at (-> parm 0))
   (dispcmd    symbol :overlay-at (-> parm 1))
   (nick       symbol :overlay-at (-> parm 0))
   (forcelev   symbol :overlay-at (-> parm 0))
   (forceonoff symbol :overlay-at (-> parm 1))
   (checkname  basic :overlay-at (-> parm 0)))
  :pack-me)

(defenum load-boundary-flags
  :type uint8
  :bitfield #t
  (closed 0) ;; Use a filled horizontal polygon at top-plane instead of an open vertical wall.
  (player 1) ;; Test player movement instead of camera movement.
  )

(defenum load-boundary-crossing-result
  (none 0)
  (forward 1)
  (backward 2))

;; Boundary vertices follow the fixed header in memory. rejector.xyz holds the center of the XZ
;; bounding box and rejector.w holds half its diagonal for the cheap crossing reject.
(deftype load-boundary (basic)
  ((num-points uint16)
   (flags      load-boundary-flags)
   (top-plane  float)
   (bot-plane  float)
   (tri-cnt    int32)
   (next       load-boundary)
   (cmd-fwd    load-boundary-crossing-command :inline)
   (cmd-bwd    load-boundary-crossing-command :inline)
   (rejector   vector :inline)
   (data       lbvtx 1 :inline)
   (data2      lbvtx :inline :dynamic :overlay-at (-> data 0)))
  (:methods
   (new (symbol type int symbol symbol) _type_)))

;; linked list of all boundaries (gets set up in load-boundary-data)
(define *load-boundary-list* (the-as load-boundary #f))

;; current tri/quad
(define *load-boundary-target* (the-as (inline-array lbvtx) (malloc 'global 64)))

(defmethod new load-boundary ((allocation symbol) (type-to-make type) (vertex-count int) (closed? symbol) (add-to-list? symbol))
  "Allocate a load boundary with room for vertex-count vertices. Set the closed flag when
   closed? is true, initialize the vertical limits, vertex indices, rejector, and crossing
   commands, and prepend it to *load-boundary-list* when add-to-list? is true."
  ;; The fixed type already includes data[0], so only the remaining vertex-count - 1 records extend
  ;; the allocation.
  (let ((boundary (object-new allocation type-to-make (the-as int (+ (-> type-to-make size) (* (+ vertex-count -1) 16))))))
    (set! (-> boundary num-points) (the-as uint vertex-count))
    (cond
      (closed? (set! (-> boundary flags) (load-boundary-flags closed)))
      (else (set! (-> boundary flags) (load-boundary-flags)) 0))
    (set! (-> boundary top-plane) 524288.0)
    (set! (-> boundary bot-plane) -524288.0)
    (dotimes (i vertex-count)
      (set! (-> boundary data i quad) (the-as uint128 0))
      (set! (-> boundary data i ix) (the-as uint i)))
    (set! (-> boundary tri-cnt) 0)
    (set-vector! (-> boundary rejector) 0.0 0.0 0.0 268435460.0)
    (set! (-> boundary cmd-fwd cmd) (load-boundary-cmd invalid))
    (set! (-> boundary cmd-bwd cmd) (load-boundary-cmd invalid))
    (when add-to-list?
      (set! (-> boundary next) *load-boundary-list*)
      (set! *load-boundary-list* boundary))
    (if (not add-to-list?) (set! (-> boundary next) #f))
    boundary))

(define-extern *load-state* load-state)

;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/draw/drawable-ambient-h.gc")
(require "engine/game/game-save.gc")
(require "engine/level/load-boundary-h.gc")
(require "engine/gfx/sky/sky-tng.gc")
(require "engine/game/settings.gc")

;; DECOMP BEGINS

;; the editor state
(deftype lb-editor-parms (basic)
  ((boundary load-boundary)
   (vertex   int32)
   (x-origin float)
   (z-origin float)))

(define *lb-editor-parms* (new 'global 'lb-editor-parms))

(set! (-> *lb-editor-parms* boundary) #f)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Editor Rendering
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define-extern triangulate-boundary (function load-boundary int))

(define-extern find-bounding-circle (function load-boundary none))

(define-extern check-boundary (function load-boundary none))

(define-extern split-monotone-polygon (function load-boundary int none))

(define-extern fix-boundary-normals (function load-boundary none))

;; The editor uses the same system as sky for drawing large polygons.

;; The PC renderer keeps the persistent VU0 state in the MIPS2C context.
(#when PC_PORT
  (def-mips2c init-boundary-regs (function none)))

(defun-debug add-boundary-shader ((shader-texture texture-id) (dma-buf dma-buffer))
  "Append the fixed five-register ADGIF shader used by
   load-boundary polygons to dma-buf, initialize it from shader-texture, disable texture filtering, and
   advance the buffer cursor."
  (let* ((buffer dma-buf)
         (giftag (the-as object (-> buffer base))))
    (set! (-> (the-as gs-gif-tag giftag) tag) (new 'static 'gif-tag64 :nloop #x1 :nreg #x5))
    (set! (-> (the-as gs-gif-tag giftag) regs)
          (new 'static
               'gif-tag-regs
               :regs0 (gif-reg-id a+d)
               :regs1 (gif-reg-id a+d)
               :regs2 (gif-reg-id a+d)
               :regs3 (gif-reg-id a+d)
               :regs4 (gif-reg-id a+d)))
    (set! (-> buffer base) (&+ (the-as pointer giftag) 16)))
  (let ((shader (the-as adgif-shader (-> dma-buf base))))
    (adgif-shader<-texture-simple! shader (lookup-texture-by-id shader-texture))
    (set! (-> shader alpha) (new 'static 'gs-alpha :b #x1 :d #x1))
    (set! (-> shader tex0 tfx) 0)
    (set! (-> shader tex1 mmag) 0)
    (set! (-> shader clamp) (new 'static 'gs-clamp)))
  0
  (&+! (-> dma-buf base) 80)
  (none))

;; The polygon conversion and both entry points use that same context on PC.
(#when PC_PORT
  (def-mips2c draw-boundary-polygon function)
  (def-mips2c render-boundary-quad (function lbvtx dma-buffer none))
  (def-mips2c render-boundary-tri (function lbvtx dma-buffer none)))

;; Boundary faces use the sky clipper's closed 48-byte polygon records:
;;
;;   +0x00  homogeneous position
;;   +0x10  perspective texture coordinates
;;   +0x20  floating-point RGBA
;;
;; The input uses three consecutive lbvtx values for each logical vertex.  The first two logical
;; colors hold the forward- and backward-facing display colors; the remaining vertices reuse the
;; selected color.  Triangles become records 0, 1, 2, 0 and quads become 0, 1, 2, 3, 0 in the
;; #x70003000 scratch page.  draw-boundary-polygon alternates that page with #x70003800 while the
;; sky clippers apply x <= w, y <= w, x >= -w, and y >= -w.
(#unless PC_PORT
  (asm-data (label boundary-fog-ceiling) (word #x453ff000)) ;; 3071.0
  (defun init-boundary-regs ()
    "Load the camera, homogeneous projection, fog range, and zero texture phase used by boundary
     drawing. Unlike the sky path, vf25 keeps the camera's ordinary homogeneous screen offset."
    (declare (asm-func none))
    (rlet ((camera :reg v1 :type math-camera)
           (fog-data :reg a0 :type sky-tng-data)
           (function-base :reg fp)
           (result :reg v0)
           (camera-x :reg vf31)
           (camera-y :reg vf30)
           (camera-z :reg vf29)
           (camera-w :reg vf28)
           (homogeneous-scale :reg vf14)
           (inverse-homogeneous-scale :reg vf26)
           (screen-offset :reg vf25)
           (texture-offset :reg vf24)
           (fog-range :reg vf13))
      (add.i sp sp -16)
      (s.d function-base sp 8)
      (m function-base t9)
      (m! camera *math-camera*)
      (m! fog-data *sky-tng-data*)
      (lea.field fog-data fog-data (fog))
      ;; Keep fog parameters resident in vf13 so the packet loop needs no scalar camera loads.
      (l.s.field f0 camera (pfog0))
      (s.s f0 fog-data)
      (l.s.field f0 camera (fog-min))
      (s.s f0 fog-data 4)
      (l.s.field f0 camera (fog-max))
      (s.s f0 fog-data 8)
      (l.s f0 function-base boundary-fog-ceiling)
      (s.s f0 fog-data 12)
      (asm-block load-boundary-camera-state
                 (l.vf.field camera-x camera (camera-temp vector 0 quad))
                 (l.vf.field camera-y camera (camera-temp vector 1 quad))
                 (l.vf.field camera-z camera (camera-temp vector 2 quad))
                 (l.vf.field camera-w camera (camera-temp vector 3 quad))
                 (l.vf.field homogeneous-scale camera (hmge-scale quad))
                 (l.vf.field inverse-homogeneous-scale camera (inv-hmge-scale quad))
                 (l.vf.field screen-offset camera (hvdf-off quad))
                 (rlet ((sky-data :reg v1 :type sky-tng-data))
                   ;; Load the packed fog limits after the last camera field access.
                   (m! sky-data *sky-tng-data*)
                   (l.vf.field fog-range sky-data (fog)))
                 (mul.vf camera-x camera-x homogeneous-scale)
                 (mul.vf camera-y camera-y homogeneous-scale)
                 (mul.vf camera-z camera-z homogeneous-scale)
                 (mul.vf camera-w camera-w homogeneous-scale)
                 (vmove.xyzw texture-offset vf0))
      ;; Mirror the cleared texture phase in the EE register file.
      (rlet ((texture-offset-bits :reg v1)) (m texture-offset-bits texture-offset))
      (m result r0)
      (l.d function-base sp 8)
      (jr ra :delay (add.i sp sp 16))
      (nop! :count 2)))
  (defun draw-boundary-polygon ()
    "Clip a closed boundary polygon against the four side planes and append ST/RGBAQ/XYZF records.
     The private calling convention carries the vertex count in t0, DMA buffer in a1, and scratch
     pages in t4 and t5. Return #f when clipping removes every vertex."
    (declare (asm-func none))
    (rlet ((dma-buf :reg a1 :type dma-buffer)
           (input-page :reg a2)
           (output :reg a3)
           (page-a :reg t4)
           (page-b :reg t5)
           (vertex-count :reg t0)
           (component :reg t2)
           (clip-function :reg t9)
           (position :reg vf1)
           (stq :reg vf2)
           (color :reg vf3)
           (gif-tag :reg vf27)
           (inverse-homogeneous-scale :reg vf26)
           (screen-offset :reg vf25)
           (texture-offset :reg vf24)
           (fog-range :reg vf13)
           (result :reg v0))
      (nop!)
      (add.i sp sp -8)
      (nop!)
      (s.d ra sp)
      ;; Each pass streams into the other scratch page. component points at x for the first and
      ;; third passes and y for the second and fourth.
      (asm-block clip-boundary-side-planes
                 (m! clip-function clip-polygon-against-positive-hyperplane)
                 (m input-page page-a)
                 (m output page-b)
                 (jalr ra clip-function :delay (add component input-page r0))
                 (b.z vertex-count boundary-polygon-clipped-away :delay (nop!))
                 (m input-page page-b)
                 (m output page-a)
                 (jalr ra clip-function :delay (add.i component input-page 4))
                 (b.z vertex-count boundary-polygon-clipped-away :delay (m! clip-function clip-polygon-against-negative-hyperplane))
                 (m input-page page-a)
                 (m output page-b)
                 (jalr ra clip-function :delay (add component input-page r0))
                 (b.z vertex-count boundary-polygon-clipped-away :delay (nop!))
                 (m input-page page-b)
                 (m output page-a)
                 (jalr ra clip-function :delay (add.i component input-page 4))
                 (b.z vertex-count boundary-polygon-clipped-away :delay (l.w.field output dma-buf (base))))
      ;; vf27 supplies the fixed GIF tag. The clipped count replaces its first word before emitting
      ;; one three-qword GS vertex for every remaining polygon point.
      (m input-page page-a)
      (nop!)
      (s.vf gif-tag output)
      (add.i output output 16)
      (s.w vertex-count output -16)
      (nop!)
      (label emit-boundary-vertices)
      (asm-block project-boundary-vertex
                 (l.vf position input-page)
                 (nop!)
                 (l.vf stq input-page 16)
                 (nop!)
                 (l.vf color input-page 32)
                 (div.w.w Q vf0 position)
                 (mul.vf position position inverse-homogeneous-scale)
                 (nop!)
                 (ftoi.vf color color)
                 (nop!)
                 (add.vf stq stq texture-offset)
                 (nop!)
                 (waitq)
                 (nop!)
                 (mulq.vf.xyz position position Q)
                 (s.vf color output 16)
                 (mulq.vf stq stq Q)
                 (add.i input-page input-page 48)
                 (add.vf position position screen-offset)
                 (add.i output output 48)
                 ;; Boundary geometry keeps projected depth instead of using the sky layer value.
                 ;; Clamp z to the near side of the GS range, and fog between fog-min and fog-max.
                 (max.z.vf.z position position vf0)
                 (nop!)
                 (min.z.vf.w position position fog-range)
                 (nop!)
                 (max.y.vf.w position position fog-range)
                 (nop!)
                 (s.vf stq output -48)
                 (add.i vertex-count vertex-count -1)
                 (ftoi.vf position position :fixed 4)
                 (nop!)
                 (b.nz vertex-count emit-boundary-vertices :delay (s.vf position output -16)))
      (s.w.field output dma-buf (base))
      (nop!)
      (l.d ra sp)
      (add.i result s7 8)
      (jr ra :delay (add.i sp sp 8))
      (label boundary-polygon-clipped-away)
      (l.d ra sp)
      (m result s7)
      (jr ra :delay (add.i sp sp 8))
      (jr ra :delay (add sp sp r0))
      (nop! :count 2)))
  (defun render-boundary-quad ((vertices lbvtx) (dma-buf dma-buffer))
    "Transform four boundary vertices into a closed scratch polygon, select the forward or backward
     display color from its camera-facing sign, and tail-call draw-boundary-polygon."
    (declare (asm-func none))
    (rlet ((vertex-data :reg a0)
           (input-copy :reg v1)
           (output :reg a3)
           (page-a :reg t4)
           (page-b :reg t5)
           (vertex-count :reg t0)
           (draw-function :reg t9)
           (facing-bits :reg v0)
           (point-0 :reg vf1)
           (tex-0 :reg vf2)
           (forward-color :reg vf3)
           (point-1 :reg vf4)
           (tex-1 :reg vf5)
           (backward-color :reg vf6)
           (point-2 :reg vf7)
           (tex-2 :reg vf8)
           (point-3-and-facing :reg vf10)
           (tex-3 :reg vf11)
           (camera-x :reg vf31)
           (camera-y :reg vf30)
           (camera-z :reg vf29)
           (camera-w :reg vf28)
           (homogeneous-scale :reg vf14))
      (m input-copy vertex-data)
      (rlet ((camera :reg v1 :type math-camera))
        (m! camera *math-camera*)
        ;; Refresh the homogeneous scale with the rest of the boundary camera state.
        (l.vf.field homogeneous-scale camera (hmge-scale quad)))
      (lui page-a #x7000)
      (ori page-a page-a #x3000)
      (lui page-b #x7000)
      (ori page-b page-b #x3800)
      (m output page-a)
      ;; Each logical input record is position, STQ, and color. Only the first two colors are
      ;; loaded: forward-color is installed provisionally, then replaced when the face points the
      ;; other way.
      (asm-block transform-boundary-quad
                 (nop!)
                 (l.vf point-0 vertex-data)
                 (add.i vertex-count r0 4)
                 (l.vf tex-0 vertex-data 16)
                 (nop!)
                 (l.vf forward-color vertex-data 32)
                 (mula.x.vf camera-x point-0)
                 (l.vf point-1 vertex-data 48)
                 (madda.y.vf camera-y point-0)
                 (l.vf tex-1 vertex-data 64)
                 (madda.z.vf camera-z point-0)
                 (l.vf backward-color vertex-data 80)
                 (madd.w.vf point-0 camera-w point-0)
                 (l.vf point-2 vertex-data 96)
                 (nop!)
                 (l.vf tex-2 vertex-data 112)
                 (mula.x.vf camera-x point-1)
                 (nop!)
                 (madda.y.vf camera-y point-1)
                 (l.vf point-3-and-facing vertex-data 144)
                 (madda.z.vf camera-z point-1)
                 (l.vf tex-3 vertex-data 160)
                 (madd.w.vf point-1 camera-w point-1)
                 (nop! :count 2)
                 (s.vf tex-0 output 16)
                 (mula.x.vf camera-x point-2)
                 (s.vf forward-color output 32)
                 (madda.y.vf camera-y point-2)
                 (s.vf tex-1 output 64)
                 (madda.z.vf camera-z point-2)
                 (s.vf forward-color output 80)
                 (madd.w.vf point-2 camera-w point-2)
                 (s.vf tex-2 output 112)
                 (nop!)
                 (s.vf forward-color output 128)
                 (mula.x.vf camera-x point-3-and-facing)
                 (s.vf tex-3 output 160)
                 (madda.y.vf camera-y point-3-and-facing)
                 (s.vf forward-color output 176)
                 (madda.z.vf camera-z point-3-and-facing)
                 (s.vf tex-0 output 208)
                 (madd.w.vf point-3-and-facing camera-w point-3-and-facing)
                 (s.vf forward-color output 224)
                 (nop!)
                 (s.vf point-0 output)
                 (nop!)
                 (s.vf point-0 output 192)
                 (nop!)
                 (s.vf point-1 output 48)
                 (nop!)
                 (s.vf point-2 output 96)
                 (nop!)
                 (s.vf point-3-and-facing output 144))
      ;; The scalar triple product dot(cross(p1-p0, p2-p0), p0) determines which side faces the
      ;; camera origin after transformation. The sum is placed in vf10.y; moving the low 64 bits
      ;; into v0 makes that lane's sign available to the integer branch.
      (asm-block choose-boundary-quad-color
                 (m! draw-function draw-boundary-polygon)
                 (sub.vf point-1 point-1 point-0)
                 (nop!)
                 (sub.vf point-2 point-2 point-0)
                 (nop!)
                 (outer.product.a.vf acc point-1 point-2)
                 (nop!)
                 (outer.product.b.vf point-3-and-facing point-2 point-1 acc)
                 (nop!)
                 (mul.vf point-3-and-facing point-3-and-facing point-0)
                 (nop!)
                 (add.x.vf.y point-3-and-facing point-3-and-facing point-3-and-facing)
                 (nop!)
                 (add.z.vf.y point-3-and-facing point-3-and-facing point-3-and-facing)
                 (nop!)
                 (m facing-bits point-3-and-facing)
                 (nop!)
                 (b.ge facing-bits r0 use-backward-quad-color :delay (nop!))
                 (jr draw-function :delay (nop!)))
      (label use-backward-quad-color)
      ;; Recolor only the four distinct records. The duplicate closure retains the provisional
      ;; color, which also participates in interpolation if clipping crosses the final edge.
      (s.vf backward-color output 32)
      (nop!)
      (s.vf backward-color output 80)
      (nop!)
      (s.vf backward-color output 128)
      (nop!)
      (s.vf backward-color output 176)
      (nop!)
      (jr draw-function :delay (nop!))
      (jr ra :delay (add sp sp r0))
      (nop! :count 2)))
  (defun render-boundary-tri ((vertices lbvtx) (dma-buf dma-buffer))
    "Transform three boundary vertices into a closed scratch polygon, select the forward or backward
     display color from its camera-facing sign, and tail-call draw-boundary-polygon."
    (declare (asm-func none))
    (rlet ((vertex-data :reg a0)
           (input-copy :reg v1)
           (output :reg a3)
           (page-a :reg t4)
           (page-b :reg t5)
           (vertex-count :reg t0)
           (draw-function :reg t9)
           (facing-bits :reg v0)
           (point-0 :reg vf1)
           (tex-0 :reg vf2)
           (forward-color :reg vf3)
           (point-1 :reg vf4)
           (tex-1 :reg vf5)
           (backward-color :reg vf6)
           (point-2 :reg vf7)
           (tex-2 :reg vf8)
           (facing :reg vf10)
           (camera-x :reg vf31)
           (camera-y :reg vf30)
           (camera-z :reg vf29)
           (camera-w :reg vf28))
      (m input-copy vertex-data)
      (lui page-a #x7000)
      (ori page-a page-a #x3000)
      (lui page-b #x7000)
      (ori page-b page-b #x3800)
      (m output page-a)
      (asm-block transform-boundary-triangle
                 (nop!)
                 (l.vf point-0 vertex-data)
                 (add.i vertex-count r0 3)
                 (l.vf tex-0 vertex-data 16)
                 (nop!)
                 (l.vf forward-color vertex-data 32)
                 (mula.x.vf camera-x point-0)
                 (l.vf point-1 vertex-data 48)
                 (madda.y.vf camera-y point-0)
                 (l.vf tex-1 vertex-data 64)
                 (madda.z.vf camera-z point-0)
                 (l.vf backward-color vertex-data 80)
                 (madd.w.vf point-0 camera-w point-0)
                 (l.vf point-2 vertex-data 96)
                 (nop!)
                 (l.vf tex-2 vertex-data 112)
                 (mula.x.vf camera-x point-1)
                 (nop!)
                 (madda.y.vf camera-y point-1)
                 (s.vf tex-0 output 16)
                 (madda.z.vf camera-z point-1)
                 (s.vf forward-color output 32)
                 (madd.w.vf point-1 camera-w point-1)
                 (s.vf tex-1 output 64)
                 (nop!)
                 (s.vf forward-color output 80)
                 (mula.x.vf camera-x point-2)
                 (s.vf tex-2 output 112)
                 (madda.y.vf camera-y point-2)
                 (s.vf forward-color output 128)
                 (madda.z.vf camera-z point-2)
                 (s.vf tex-0 output 160)
                 (madd.w.vf point-2 camera-w point-2)
                 (s.vf forward-color output 176)
                 (nop!)
                 (s.vf point-0 output)
                 (nop!)
                 (s.vf point-0 output 144)
                 (nop!)
                 (s.vf point-1 output 48)
                 (nop!)
                 (s.vf point-2 output 96))
      (asm-block choose-boundary-triangle-color
                 (m! draw-function draw-boundary-polygon)
                 (sub.vf point-1 point-1 point-0)
                 (nop!)
                 (sub.vf point-2 point-2 point-0)
                 (nop!)
                 (outer.product.a.vf acc point-1 point-2)
                 (nop!)
                 (outer.product.b.vf facing point-2 point-1 acc)
                 (nop!)
                 (mul.vf facing facing point-0)
                 (nop!)
                 (add.x.vf.y facing facing facing)
                 (nop!)
                 (add.z.vf.y facing facing facing)
                 (nop!)
                 (m facing-bits facing)
                 (nop!)
                 (b.ge facing-bits r0 use-backward-triangle-color :delay (nop!))
                 (jr draw-function :delay (nop!)))
      (label use-backward-triangle-color)
      ;; The fourth record repeats point zero, so it receives the selected color as well.
      (s.vf backward-color output 32)
      (nop!)
      (s.vf backward-color output 80)
      (nop!)
      (s.vf backward-color output 128)
      (nop!)
      (s.vf backward-color output 176)
      (nop!)
      (jr draw-function :delay (nop!))
      (jr ra :delay (add sp sp r0))
      (nop! :count 2))))

;; the polygon curently rendering.
(define *boundary-polygon*
  (new 'static
       'inline-array
       lbvtx
       12
       (new 'static 'lbvtx)
       (new 'static 'lbvtx)
       (new 'static 'lbvtx)
       (new 'static 'lbvtx)
       (new 'static 'lbvtx)
       (new 'static 'lbvtx)
       (new 'static 'lbvtx)
       (new 'static 'lbvtx)
       (new 'static 'lbvtx)
       (new 'static 'lbvtx)
       (new 'static 'lbvtx)
       (new 'static 'lbvtx)))

(defun-debug draw-boundary-side ((boundary load-boundary) (start-index integer) (end-index integer) (dma-buf dma-buffer) (uv-phase? symbol))
  "Build and draw the vertical quad joining two boundary vertices
   between bot-plane and top-plane. uv-phase? selects the alternate UV orientation used to flash the
   selected boundary."
  (rlet ((vf27 :class vf))
    (let ((start (-> boundary data start-index)))
      (let ((end (-> boundary data end-index)))
        (let ((polygon-pos (-> *boundary-polygon* 0)))
          (set! (-> polygon-pos x) (-> start x))
          (set! (-> polygon-pos y) (-> boundary bot-plane))
          (set! (-> polygon-pos z) (-> start z))
          (set! (-> polygon-pos v w) 1.0))
        (let ((polygon-pos (-> *boundary-polygon* 3)))
          (set! (-> polygon-pos x) (-> end x))
          (set! (-> polygon-pos y) (-> boundary bot-plane))
          (set! (-> polygon-pos z) (-> end z))
          (set! (-> polygon-pos v w) 1.0))
        (let ((polygon-pos (-> *boundary-polygon* 6)))
          (set! (-> polygon-pos x) (-> end x))
          (set! (-> polygon-pos y) (-> boundary top-plane))
          (set! (-> polygon-pos z) (-> end z))
          (set! (-> polygon-pos v w) 1.0)))
      (let ((polygon-pos (-> *boundary-polygon* 9)))
        (set! (-> polygon-pos x) (-> start x))
        (set! (-> polygon-pos y) (-> boundary top-plane))
        (set! (-> polygon-pos z) (-> start z))
        (set! (-> polygon-pos v w) 1.0)))
    (cond
      (uv-phase?
       (let ((polygon-uv (-> *boundary-polygon* 1)))
         (set! (-> polygon-uv x) 0.0)
         (set! (-> polygon-uv y) 0.0)
         (set! (-> polygon-uv z) 1.0)
         (set! (-> polygon-uv v w) 1.0))
       (let ((polygon-uv (-> *boundary-polygon* 4)))
         (set! (-> polygon-uv x) 1.0)
         (set! (-> polygon-uv y) 0.0)
         (set! (-> polygon-uv z) 1.0)
         (set! (-> polygon-uv v w) 1.0))
       (let ((polygon-uv (-> *boundary-polygon* 7)))
         (set! (-> polygon-uv x) 1.0)
         (set! (-> polygon-uv y) 8.0)
         (set! (-> polygon-uv z) 1.0)
         (set! (-> polygon-uv v w) 1.0))
       (let ((polygon-uv (-> *boundary-polygon* 10)))
         (set! (-> polygon-uv x) 0.0)
         (set! (-> polygon-uv y) 8.0)
         (set! (-> polygon-uv z) 1.0)
         (set! (-> polygon-uv v w) 1.0)))
      (else
       (let ((polygon-uv (-> *boundary-polygon* 1)))
         (set! (-> polygon-uv x) 1.0)
         (set! (-> polygon-uv y) 0.0)
         (set! (-> polygon-uv z) 1.0)
         (set! (-> polygon-uv v w) 1.0))
       (let ((polygon-uv (-> *boundary-polygon* 4)))
         (set! (-> polygon-uv x) 0.0)
         (set! (-> polygon-uv y) 0.0)
         (set! (-> polygon-uv z) 1.0)
         (set! (-> polygon-uv v w) 1.0))
       (let ((polygon-uv (-> *boundary-polygon* 7)))
         (set! (-> polygon-uv x) 0.0)
         (set! (-> polygon-uv y) 8.0)
         (set! (-> polygon-uv z) 1.0)
         (set! (-> polygon-uv v w) 1.0))
       (let ((polygon-uv (-> *boundary-polygon* 10)))
         (set! (-> polygon-uv x) 1.0)
         (set! (-> polygon-uv y) 8.0)
         (set! (-> polygon-uv z) 1.0)
         (set! (-> polygon-uv v w) 1.0))))
    (init-boundary-regs)
    (#unless PC_PORT
      (.lvf vf27 (&-> *sky-tng-data* giftag-roof qword)))
    (#when PC_PORT
      (set-sky-vf27 (&-> *sky-tng-data* giftag-roof qword)))
    (render-boundary-quad (-> *boundary-polygon* 0) dma-buf)
    0
    (none)))

(defun-debug draw-boundary-cap ((boundary load-boundary) (plane-y float) (dma-buf dma-buffer) (uv-phase? symbol))
  "Draw every cached triangle of a closed boundary at plane-y.
   uv-phase? selects the alternate UV orientation used to flash the selected boundary."
  (rlet ((vf27 :class vf))
    (dotimes (i (-> boundary tri-cnt))
      (let ((v0 (-> boundary data (-> boundary data i v0)))
            (v1 (-> boundary data (-> boundary data i v1)))
            (v2 (-> boundary data (-> boundary data i v2))))
        (let ((polygon-pos (-> *boundary-polygon* 0)))
          (set! (-> polygon-pos x) (-> v0 x))
          (set! (-> polygon-pos y) plane-y)
          (set! (-> polygon-pos z) (-> v0 z))
          (set! (-> polygon-pos v w) 1.0))
        (let ((polygon-pos (-> *boundary-polygon* 3)))
          (set! (-> polygon-pos x) (-> v1 x))
          (set! (-> polygon-pos y) plane-y)
          (set! (-> polygon-pos z) (-> v1 z))
          (set! (-> polygon-pos v w) 1.0))
        (let ((polygon-pos (-> *boundary-polygon* 6)))
          (set! (-> polygon-pos x) (-> v2 x))
          (set! (-> polygon-pos y) plane-y)
          (set! (-> polygon-pos z) (-> v2 z))
          (set! (-> polygon-pos v w) 1.0)))
      (cond
        (uv-phase?
         (let ((polygon-uv (-> *boundary-polygon* 1)))
           (set! (-> polygon-uv x) 0.0)
           (set! (-> polygon-uv y) 0.0)
           (set! (-> polygon-uv z) 1.0)
           (set! (-> polygon-uv v w) 1.0))
         (let ((polygon-uv (-> *boundary-polygon* 4)))
           (set! (-> polygon-uv x) 0.0)
           (set! (-> polygon-uv y) 1.0)
           (set! (-> polygon-uv z) 1.0)
           (set! (-> polygon-uv v w) 1.0))
         (let ((polygon-uv (-> *boundary-polygon* 7)))
           (set! (-> polygon-uv x) 1.0)
           (set! (-> polygon-uv y) 0.0)
           (set! (-> polygon-uv z) 1.0)
           (set! (-> polygon-uv v w) 1.0)))
        (else
         (let ((polygon-uv (-> *boundary-polygon* 1)))
           (set! (-> polygon-uv x) 1.0)
           (set! (-> polygon-uv y) 0.0)
           (set! (-> polygon-uv z) 1.0)
           (set! (-> polygon-uv v w) 1.0))
         (let ((polygon-uv (-> *boundary-polygon* 4)))
           (set! (-> polygon-uv x) 1.0)
           (set! (-> polygon-uv y) 1.0)
           (set! (-> polygon-uv z) 1.0)
           (set! (-> polygon-uv v w) 1.0))
         (let ((polygon-uv (-> *boundary-polygon* 7)))
           (set! (-> polygon-uv x) 0.0)
           (set! (-> polygon-uv y) 0.0)
           (set! (-> polygon-uv z) 1.0)
           (set! (-> polygon-uv v w) 1.0))))
      (init-boundary-regs)
      (#unless PC_PORT
        (.lvf vf27 (&-> *sky-tng-data* giftag-roof qword)))
      (#when PC_PORT
        (set-sky-vf27 (&-> *sky-tng-data* giftag-roof qword)))
      (render-boundary-tri (-> *boundary-polygon* 0) dma-buf))
    0
    (none)))

(defun-debug boundary-set-color ((color-vertex lbvtx) (command load-boundary-crossing-command))
  "Set a debug polygon color from command's load-boundary command
   kind: load, display, visibility, checkpoint, or the default/unknown color."
  (case (-> command cmd)
    (((load-boundary-cmd load))
     (let ((color color-vertex))
       (set! (-> color x) 128.0)
       (set! (-> color y) 128.0)
       (set! (-> color z) 128.0)
       (set! (-> color v w) 128.0)))
    (((load-boundary-cmd cmd2))
     (let ((color color-vertex))
       (set! (-> color x) 0.0)
       (set! (-> color y) 0.0)
       (set! (-> color z) 0.0)
       (set! (-> color v w) 128.0)))
    (((load-boundary-cmd display))
     (cond
       ((-> command lev1)
        (let ((color color-vertex))
          (set! (-> color x) 128.0)
          (set! (-> color y) 128.0)
          (set! (-> color z) 0.0)
          (set! (-> color v w) 128.0)))
       (else
        (let ((color color-vertex))
          (set! (-> color x) 64.0)
          (set! (-> color y) 64.0)
          (set! (-> color z) 0.0)
          (set! (-> color v w) 128.0)))))
    (((load-boundary-cmd vis))
     (let ((color color-vertex))
       (set! (-> color x) 128.0)
       (set! (-> color y) 0.0)
       (set! (-> color z) 0.0)
       (set! (-> color v w) 128.0)))
    (((load-boundary-cmd checkpt))
     (let ((color color-vertex))
       (set! (-> color x) 0.0)
       (set! (-> color y) 128.0)
       (set! (-> color z) 128.0)
       (set! (-> color v w) 128.0)))
    (else
     (let ((color color-vertex))
       (set! (-> color x) 64.0)
       (set! (-> color y) 64.0)
       (set! (-> color z) 64.0)
       (set! (-> color v w) 128.0))))
  0
  (none))

(#unless PC_PORT
  (defun-debug render-boundary ((boundary load-boundary))
    "Append debug rendering for boundary to the debug DMA bucket. Closed
     boundaries draw their triangulated top cap; open boundaries draw vertical side quads. The selected
     boundary alternates UV phase to flash."
    (let* ((uv-phase? (or (!= boundary (-> *lb-editor-parms* boundary)) (logtest? (-> *display* real-actual-frame-counter) 4)))
           (dma-buf (-> *display* frames (-> *display* on-screen) frame global-buf))
           (packet-start (-> dma-buf base)))
      (let* ((buffer dma-buf)
             (cnt-tag (the-as object (-> buffer base))))
        (set! (-> (the-as dma-packet cnt-tag) dma) (new 'static 'dma-tag :qwc #x4 :id (dma-tag-id cnt)))
        (set! (-> (the-as dma-packet cnt-tag) vif0) (new 'static 'vif-tag))
        (set! (-> (the-as dma-packet cnt-tag) vif1) (new 'static 'vif-tag :imm #x4 :cmd (vif-cmd direct) :msk #x1))
        (set! (-> buffer base) (&+ (the-as pointer cnt-tag) 16)))
      (let* ((buffer dma-buf)
             (giftag (the-as object (-> buffer base))))
        (set! (-> (the-as gs-gif-tag giftag) tag) (new 'static 'gif-tag64 :nloop #x1 :eop #x1 :nreg #x3))
        (set! (-> (the-as gs-gif-tag giftag) regs) GIF_REGS_ALL_AD)
        (set! (-> buffer base) (&+ (the-as pointer giftag) 16)))
      (let* ((buffer dma-buf)
             (gs-state (-> buffer base)))
        (set! (-> (the-as (pointer gs-zbuf) gs-state) 0) (new 'static 'gs-zbuf :zbp #x1c0 :psm (gs-psm ct24)))
        (set! (-> (the-as (pointer gs-reg64) gs-state) 1) (gs-reg64 zbuf-1))
        (set! (-> (the-as (pointer gs-test) gs-state) 2)
              (new 'static 'gs-test :ate #x1 :atst (gs-atest greater-equal) :aref #x26 :zte #x1 :ztst (gs-ztest greater-equal)))
        (set! (-> (the-as (pointer gs-reg64) gs-state) 3) (gs-reg64 test-1))
        (set! (-> (the-as (pointer gs-alpha) gs-state) 4) (new 'static 'gs-alpha :b #x1 :d #x1))
        (set! (-> (the-as (pointer gs-reg64) gs-state) 5) (gs-reg64 alpha-1))
        (set! (-> buffer base) (&+ gs-state 48)))
      (boundary-set-color (-> *boundary-polygon* 2) (-> boundary cmd-fwd))
      (boundary-set-color (-> *boundary-polygon* 5) (-> boundary cmd-bwd))
      (let ((vif-block (the-as object (-> dma-buf base))))
        (&+! (-> dma-buf base) 16)
        (add-boundary-shader (new 'static 'texture-id :index #x33 :page #x2) dma-buf)
        (cond
          ((logtest? (-> boundary flags) (load-boundary-flags closed))
           (draw-boundary-cap boundary (-> boundary top-plane) dma-buf uv-phase?))
          (else
           (dotimes (i (the-as int (+ (-> boundary num-points) -1)))
             (draw-boundary-side boundary i (+ i 1) dma-buf uv-phase?))))
        (close-sky-buffer dma-buf)
        (let ((block-qwc (/ (the-as int (+ (- -16 (the-as int vif-block)) (the-as int (-> dma-buf base)))) 16)))
          (set! (-> (the-as dma-packet vif-block) dma) (new 'static 'dma-tag :id (dma-tag-id cnt) :qwc block-qwc))
          (set! (-> (the-as dma-packet vif-block) vif0) (new 'static 'vif-tag))
          (set! (-> (the-as dma-packet vif-block) vif1) (new 'static 'vif-tag :cmd (vif-cmd direct) :msk #x1 :imm block-qwc))))
      (let ((packet-end (-> dma-buf base)))
        (let ((next-tag (the-as object (-> dma-buf base))))
          (set! (-> (the-as dma-packet next-tag) dma) (new 'static 'dma-tag :id (dma-tag-id next)))
          (set! (-> (the-as dma-packet next-tag) vif0) (new 'static 'vif-tag))
          (set! (-> (the-as dma-packet next-tag) vif1) (new 'static 'vif-tag))
          (set! (-> dma-buf base) (&+ (the-as pointer next-tag) 16)))
        (dma-bucket-insert-tag (-> *display* frames (-> *display* on-screen) frame bucket-group)
                               (bucket-id debug)
                               packet-start
                               (the-as (pointer dma-tag) packet-end))))
    0
    (none)))

(#when PC_PORT
  (defun-debug render-boundary ((boundary load-boundary))
    "Append debug rendering for boundary to the debug DMA bucket. Closed boundaries draw their
     triangulated top cap; open boundaries draw vertical side quads. The selected boundary
     alternates UV phase to flash."
    (let ((uv-phase? (or (!= boundary (-> *lb-editor-parms* boundary)) (logtest? (-> *display* real-actual-frame-counter) 4))))
      (with-dma-buffer-add-bucket ((dma-buf (-> (current-frame) global-buf)) (bucket-id debug))
        (dma-buffer-add-gs-set-flusha dma-buf
                                      (zbuf-1 (new 'static 'gs-zbuf :zbp #x1c0 :psm (gs-psm ct24)))
                                      (test-1 (new 'static 'gs-test :ate #x1 :atst (gs-atest greater-equal) :aref #x26 :zte #x1 :ztst (gs-ztest greater-equal)))
                                      (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1)))
        (boundary-set-color (-> *boundary-polygon* 2) (-> boundary cmd-fwd))
        (boundary-set-color (-> *boundary-polygon* 5) (-> boundary cmd-bwd))
        (with-cnt-vif-block-qwc (dma-buf)
                                (add-boundary-shader (new 'static 'texture-id :index #x33 :page #x2) dma-buf)
                                (cond
                                  ((logtest? (-> boundary flags) (load-boundary-flags closed))
                                   (draw-boundary-cap boundary (-> boundary top-plane) dma-buf uv-phase?))
                                  (else
                                   (dotimes (i (the-as int (+ (-> boundary num-points) -1)))
                                     (draw-boundary-side boundary i (+ i 1) dma-buf uv-phase?))))
                                (close-sky-buffer dma-buf))))
    0
    (none)))

;;;;;;;;;;;;;;;;;;;;;;;;;
;; Load Boundary File
;;;;;;;;;;;;;;;;;;;;;;;;;

;; the load-boundary-data.gc file can be re-generated after editing load boundaries.

(defmacro static-lb-list (&rest lbs)
  `(new 'static 'boxed-array :type array :length ,(length lbs) :allocated-length ,(length lbs) ,@(reverse lbs)))

(defmacro static-load-boundary (&key flags &key top &key bot &key points &key (fwd (invalid #f #f)) &key (bwd (invalid #f #f)))
  `(new 'static
       'boxed-array
       :type
       object
       :length 4
       :allocated-length 4
       (the binteger (load-boundary-flags ,@flags))
       (new 'static
            'boxed-array
            :type
            float
            :length
            ,(+ 2 (length points))
            :allocated-length
            ,(+ 2 (length points))
            ,top
            ,bot
            ,@points)
       '((the binteger (load-boundary-cmd ,(first fwd))) ,(second fwd) ,(third fwd))
       '((the binteger (load-boundary-cmd ,(first bwd))) ,(second bwd) ,(third bwd))))

(defun-debug format-boundary-cmd ((command load-boundary-crossing-command))
  "Print a concise editor description of command and its parameters
   to the standard console."
  (case (-> command cmd)
    (((load-boundary-cmd load)) (format *stdcon* "    LOAD(~A,~A)~%" (-> command lev0) (-> command lev1)))
    (((load-boundary-cmd cmd2)))
    (((load-boundary-cmd display))
     (if (-> command lev1)
       (format *stdcon* "    DISPLAY(~A,~A)~%" (-> command lev0) (-> command lev1))
       (format *stdcon* "    DISPLAY(~A,OFF)~%" (-> command lev0))))
    (((load-boundary-cmd vis)) (format *stdcon* "   VIS(~A)~%" (-> command lev0)))
    (((load-boundary-cmd checkpt)) (format *stdcon* "   CHECKPT(~A)~%" (-> command lev0))))
  0
  (none))

(defun-debug edit-load-boundaries ()
  "Run the controller-two load-boundary editor: print the
   selection, highlight the selected vertex, move vertices or height planes in camera-relative axes,
   and cycle boundaries and vertices. Moving geometry invalidates cached triangulation."
  (let* ((editor *lb-editor-parms*)
         (boundary (-> editor boundary)))
    (format *stdcon* "~3L")
    (cond
      ((not boundary) (format *stdcon* "No load boundary selected - use Player 2 pad to select~%"))
      (else
       (format *stdcon* "Selected load boundary ~X~%" boundary)
       (if (logtest? (-> boundary flags) (load-boundary-flags player))
         (format *stdcon* "PLAYER activated~%")
         (format *stdcon* "CAMERA activated~%"))
       (when (nonzero? (-> boundary cmd-fwd cmd))
         (format *stdcon* "in->out~%")
         (format-boundary-cmd (-> boundary cmd-fwd)))
       (when (nonzero? (-> boundary cmd-bwd cmd))
         (format *stdcon* "out->in~%")
         (format-boundary-cmd (-> boundary cmd-bwd)))))
    (format *stdcon* "~0L")
    (let ((camera-right (new 'stack-no-clear 'vector))
          (camera-forward (new 'stack-no-clear 'vector)))
      (set! (-> camera-right quad) (-> *math-camera* inv-camera-rot vector 0 quad))
      (set! (-> camera-forward quad) (-> *math-camera* inv-camera-rot vector 1 quad))
      (set! (-> camera-right y) 0.0)
      (set! (-> camera-forward y) 0.0)
      (when (and boundary (!= -1 (-> editor vertex)))
        (let ((selected-pos (new 'stack-no-clear 'vector)))
          (set! (-> selected-pos quad) (-> boundary data (-> editor vertex) quad))
          (set! (-> selected-pos y) (-> boundary top-plane))
          (add-debug-sphere #t (bucket-id debug-no-zbuf) selected-pos 8192.0 (new 'static 'rgba :a #x80))
          (when (not (logtest? (-> boundary flags) (load-boundary-flags closed)))
            (set! (-> selected-pos y) (-> boundary bot-plane))
            (add-debug-sphere #t (bucket-id debug-no-zbuf) selected-pos 8192.0 (new 'static 'rgba :a #x80)))))
      (let* ((coarse-x (* 4096.0 (analog-input (the-as int (-> *cpad-list* cpads 1 leftx)) 128.0 48.0 110.0 -1.0)))
             (coarse-z (* 4096.0 (analog-input (the-as int (-> *cpad-list* cpads 1 lefty)) 128.0 48.0 110.0 -1.0)))
             (move-x (+ coarse-x (* 409.6 (analog-input (the-as int (-> *cpad-list* cpads 1 rightx)) 128.0 48.0 110.0 -1.0))))
             (move-z (+ coarse-z (* 409.6 (analog-input (the-as int (-> *cpad-list* cpads 1 righty)) 128.0 48.0 110.0 -1.0)))))
        (cond
          ((cpad-hold? 1 x)
           (cond
             ((= (-> editor vertex) -1)
              (dotimes (i (the-as int (-> boundary num-points)))
                (+! (-> boundary data i x) (* move-x (-> camera-right x)))
                (+! (-> boundary data i z) (* move-x (-> camera-right z)))
                (+! (-> boundary data i x) (* move-z (-> camera-forward x)))
                (+! (-> boundary data i z) (* move-z (-> camera-forward z)))))
             (else
              (+! (-> boundary data (-> editor vertex) x) (* move-x (-> camera-right x)))
              (+! (-> boundary data (-> editor vertex) z) (* move-x (-> camera-right z)))
              (+! (-> boundary data (-> editor vertex) x) (* move-z (-> camera-forward x)))
              (+! (-> boundary data (-> editor vertex) z) (* move-z (-> camera-forward z)))))
           (set! (-> boundary tri-cnt) 0)
           0)
          ((cpad-hold? 1 r1) (if boundary (+! (-> boundary top-plane) move-z)))
          ((cpad-hold? 1 r2) (if boundary (+! (-> boundary bot-plane) move-z)))
          ((cpad-pressed? 1 up)
           (if boundary (set! boundary (-> boundary next)) (set! boundary *load-boundary-list*))
           (set! (-> editor vertex) -1))
          ((cpad-pressed? 1 down)
           (cond
             ((= boundary *load-boundary-list*) (set! boundary (the-as load-boundary #f)))
             (else
              (let ((previous *load-boundary-list*))
                (while previous
                  (when (= boundary (-> previous next))
                    (set! boundary previous)
                    (set! previous (the-as load-boundary #f)))
                  (if previous (set! previous (-> previous next)))))))
           (set! (-> editor vertex) -1))
          ((cpad-pressed? 1 right)
           (+! (-> editor vertex) 1)
           (if (= (-> editor vertex) (-> boundary num-points)) (set! (-> editor vertex) -1)))
          ((cpad-pressed? 1 left)
           (+! (-> editor vertex) -1)
           (if (= (-> editor vertex) -2) (set! (-> editor vertex) (the-as int (+ (-> boundary num-points) -1))))))))
    (set! (-> editor boundary) boundary))
  0
  (none))

(defun-debug copy-load-command! ((dst load-boundary-crossing-command) (src load-boundary-crossing-command))
  "Copy the complete twelve-byte crossing command, including its
   command byte, reserved bytes, and two object parameters, from src to dst."
  (set! (-> dst cmd) (-> src cmd))
  (dotimes (i 3)
    (set! (-> dst bparm i) (-> src bparm i)))
  (dotimes (i 2)
    (set! (-> dst parm i) (-> src parm i)))
  0
  (none))

(defun-debug copy-load-boundary! ((dst load-boundary) (src load-boundary))
  "Copy flags, vertical planes, and both crossing commands from src
   to dst, and invalidate dst's cached triangulation. Vertex storage and list links are not copied."
  (set! (-> dst flags) (-> src flags))
  (set! (-> dst top-plane) (-> src top-plane))
  (set! (-> dst bot-plane) (-> src bot-plane))
  (set! (-> dst tri-cnt) 0)
  (copy-load-command! (-> dst cmd-fwd) (-> src cmd-fwd))
  (copy-load-command! (-> dst cmd-bwd) (-> src cmd-bwd))
  0
  (none))

(defun-debug replace-load-boundary ((old-boundary load-boundary) (new-boundary load-boundary))
  "Replace old-boundary in the global linked list with
   new-boundary, preserving its successor and editor selection. Print an error if old-boundary is not
   present."
  (set! (-> new-boundary next) (-> old-boundary next))
  (if (= (-> *lb-editor-parms* boundary) old-boundary) (set! (-> *lb-editor-parms* boundary) new-boundary))
  (when (= old-boundary *load-boundary-list*)
    (set! *load-boundary-list* new-boundary)
    (return 0))
  (let ((previous *load-boundary-list*))
    (while (and previous (!= (-> previous next) old-boundary))
      (set! previous (-> previous next)))
    (when previous
      (set! (-> previous next) new-boundary)
      (return 0)))
  (format 0 "ERROR: Couldn't find old boundary in list!!!!~%")
  0
  (none))

(defun-debug lb-del ()
  "Remove the selected editor boundary from the global list and clear the
   selection. Report when nothing is selected or the boundary cannot be found."
  (let ((selected (-> *lb-editor-parms* boundary)))
    (set! (-> *lb-editor-parms* boundary) #f)
    (when (not selected)
      (format 0 "No boundary selected~%")
      (return 0))
    (when (= selected *load-boundary-list*)
      (set! *load-boundary-list* (-> selected next))
      (return 0))
    (let ((previous *load-boundary-list*))
      (while (and previous (!= (-> previous next) selected))
        (set! previous (-> previous next)))
      (when previous
        (set! (-> previous next) (-> selected next))
        (return 0))))
  (format 0 "ERROR: Couldn't find old boundary in list!!!!~%")
  0
  (none))

(defun-debug lb-add-vtx-before ()
  "Replace the selected boundary with a one-vertex-larger copy and
   insert a vertex before the selection at the midpoint of its neighboring edge, wrapping across the
   closing edge."
  (let* ((editor *lb-editor-parms*)
         (boundary (-> editor boundary))
         (selected-index (-> editor vertex)))
    (when (not boundary)
      (format 0 "No boundary selected~%")
      (return 0))
    (when (= selected-index -1)
      (format 0 "No vertex selected~%")
      (return 0))
    (let ((new-boundary (new 'global 'load-boundary (the-as int (+ (-> boundary num-points) 1)) #f #f)))
      (copy-load-boundary! new-boundary boundary)
      (let ((i 0))
        (while (< i selected-index)
          (set! (-> new-boundary data i quad) (-> boundary data i quad))
          (+! i 1))
        (cond
          ((zero? selected-index)
           (set! (-> new-boundary data i x)
                 (* 0.5 (+ (-> boundary data 0 x) (-> boundary data (+ (-> boundary num-points) -1) x))))
           (set! (-> new-boundary data i z)
                 (* 0.5 (+ (-> boundary data 0 z) (-> boundary data (+ (-> boundary num-points) -1) z)))))
          (else
           (set! (-> new-boundary data i x)
                 (* 0.5 (+ (-> boundary data (+ selected-index -1) x) (-> boundary data selected-index x))))
           (set! (-> new-boundary data i z)
                 (* 0.5 (+ (-> boundary data (+ selected-index -1) z) (-> boundary data selected-index z))))))
        (let ((dst-index (+ i 1)))
          (while (>= (the-as int (-> boundary num-points)) dst-index)
            (set! (-> new-boundary data dst-index quad) (-> boundary data (+ dst-index -1) quad))
            (+! dst-index 1))))
      (replace-load-boundary boundary new-boundary)))
  0
  (none))

(defun-debug lb-add-vtx-after ()
  "Replace the selected boundary with a one-vertex-larger copy and
   insert a vertex after the selection at the midpoint of its neighboring edge, wrapping across the
   closing edge. Advance the editor selection to the new vertex."
  (let ((editor *lb-editor-parms*))
    (let ((boundary (-> editor boundary))
          (selected-index (-> editor vertex)))
      (when (not boundary)
        (format 0 "No boundary selected~%")
        (return 0))
      (when (= selected-index -1)
        (format 0 "No vertex selected~%")
        (return 0))
      (let ((new-boundary (new 'global 'load-boundary (the-as int (+ (-> boundary num-points) 1)) #f #f)))
        (copy-load-boundary! new-boundary boundary)
        (let ((i 0))
          (while (>= selected-index i)
            (set! (-> new-boundary data i quad) (-> boundary data i quad))
            (+! i 1))
          (cond
            ((= selected-index (+ (-> boundary num-points) -1))
             (set! (-> new-boundary data i x)
                   (* 0.5 (+ (-> boundary data 0 x) (-> boundary data (+ (-> boundary num-points) -1) x))))
             (set! (-> new-boundary data i z)
                   (* 0.5 (+ (-> boundary data 0 z) (-> boundary data (+ (-> boundary num-points) -1) z)))))
            (else
             (set! (-> new-boundary data i x)
                   (* 0.5 (+ (-> boundary data (+ selected-index 1) x) (-> boundary data selected-index x))))
             (set! (-> new-boundary data i z)
                   (* 0.5 (+ (-> boundary data (+ selected-index 1) z) (-> boundary data selected-index z))))))
          (let ((dst-index (+ i 1)))
            (while (>= (the-as int (-> boundary num-points)) dst-index)
              (set! (-> new-boundary data dst-index quad) (-> boundary data (+ dst-index -1) quad))
              (+! dst-index 1))))
        (replace-load-boundary boundary new-boundary)))
    (+! (-> editor vertex) 1))
  0
  (none))

(defun-debug lb-del-vtx ()
  "Replace the selected boundary with a one-vertex-smaller copy that omits
   the selected vertex. Clear the vertex selection when the removed vertex was last."
  (let* ((editor *lb-editor-parms*)
         (boundary (-> editor boundary)))
    (let ((selected-index (-> editor vertex)))
      (when (not boundary)
        (format 0 "No boundary selected~%")
        (return 0))
      (when (= selected-index -1)
        (format 0 "No vertex selected~%")
        (return 0))
      (let ((new-boundary (new 'global 'load-boundary (the-as int (+ (-> boundary num-points) -1)) #f #f)))
        (copy-load-boundary! new-boundary boundary)
        (let ((i 0))
          (while (< i selected-index)
            (set! (-> new-boundary data i quad) (-> boundary data i quad))
            (+! i 1))
          (let ((src-index (+ i 1)))
            (while (< src-index (the-as int (-> boundary num-points)))
              (set! (-> new-boundary data (+ src-index -1) quad) (-> boundary data src-index quad))
              (+! src-index 1))))
        (replace-load-boundary boundary new-boundary)))
    (if (= (-> editor vertex) (+ (-> boundary num-points) -1)) (set! (-> editor vertex) -1)))
  0
  (none))

(defun-debug save-boundary-cmd ((command load-boundary-crossing-command) (key-name string) (stream object))
  "Write command as a static-load-boundary keyword clause to stream.
   key-name is normally fwd or bwd; invalid and cmd2 commands emit nothing."
  (case (-> command cmd)
    (((load-boundary-cmd load)) (format stream "  :~S (load ~A ~A)~%" key-name (-> command lev0) (-> command lev1)))
    (((load-boundary-cmd cmd2)))
    (((load-boundary-cmd display)) (format stream "  :~S (display ~A ~A)~%" key-name (-> command lev0) (-> command lev1)))
    (((load-boundary-cmd vis)) (format stream "  :~S (vis ~A #f)~%" key-name (-> command lev0)))
    (((load-boundary-cmd force-vis))
     (format stream "  :~S (force-vis ~A ~A)~%" key-name (-> command lev0) (-> command lev1)))
    (((load-boundary-cmd checkpt)) (format stream "  :~S (checkpt ~A #f)~%" key-name (-> command lev0))))
  0
  (none))

(defun load-boundary-from-template ((template (array object)))
  "Instantiate and prepend a runtime load boundary from a
   four-element static template containing flags, top/bottom plus XZ points, and forward/backward
   command lists."
  (let* ((point-data (the-as (array float) (-> template 1)))
         (vertex-count (+ (/ (-> point-data length) 2) -1))
         (boundary (new 'global 'load-boundary vertex-count #f #t)))
    (set! (-> boundary flags) (the-as load-boundary-flags (/ (the-as int (-> template 0)) 8)))
    (set! (-> boundary top-plane) (-> point-data 0))
    (set! (-> boundary bot-plane) (-> point-data 1))
    (let ((i 2))
      (while (< i (-> point-data length))
        (let ((vertex (-> boundary data (+ (/ i 2) -1))))
          (set! (-> vertex x) (-> point-data i))
          (set! (-> vertex z) (-> point-data (+ i 1))))
        (+! i 2)))
    (let ((command (-> boundary cmd-fwd))
          (command-template (-> template 2)))
      (set! (-> command cmd) (the-as load-boundary-cmd (/ (the-as int (car (the-as pair command-template))) 8)))
      (set! (-> command lev0) (the-as basic (car (cdr command-template))))
      (set! (-> command lev1) (the-as basic (car (cdr (cdr command-template))))))
    (let ((command (-> boundary cmd-bwd))
          (command-template (-> template 3)))
      (set! (-> command cmd) (the-as load-boundary-cmd (/ (the-as int (car (the-as pair command-template))) 8)))
      (set! (-> command lev0) (the-as basic (car (cdr command-template))))
      (set! (-> command lev1) (the-as basic (car (cdr (cdr command-template)))))))
  (none))

(defun-debug ---lb-save ()
  "Rewrite game/load-boundary-data.gc from the current linked list,
   serializing flags, planes, XZ points, and both crossing commands."
  (clear *temp-string*)
  (format *temp-string* "game/load-boundary-data.gc")
  (let ((stream (new 'stack 'file-stream *temp-string* 'write)))
    (format stream ";;-*-Lisp-*-~%")
    (format stream "(in-package goal)~%")
    (format stream "(bundles ~S ~S)~%" "ENGINE.CGO" "GAME.CGO")
    (format stream "(require ~S)~%~%" "engine/level/load-boundary.gc")
    (format stream ";; this file is (mostly) generated. see ---lb-save~%~%")
    (format stream ";; reset boundary in editor~%")
    (format stream "(set! (-> *lb-editor-parms* boundary) #f)~%~%")
    (format stream ";; reset all existing load boundaries~%")
    (format stream "(set! *load-boundary-list* (the-as load-boundary #f))~%~%")
    (format stream "(define *static-load-boundary-list*~%  (static-lb-list~%")
    (let ((boundary *load-boundary-list*))
      (while boundary
        (format stream
                "(static-load-boundary :flags (~S~S)~%"
                (if (logtest? (-> boundary flags) (load-boundary-flags closed)) "closed " "")
                (if (logtest? (-> boundary flags) (load-boundary-flags player)) "player " ""))
        (format stream "  :top ~f  :bot ~f~%" (-> boundary top-plane) (-> boundary bot-plane))
        (format stream "  :points (")
        (dotimes (i (the-as int (-> boundary num-points)))
          (format stream "  ~f ~f " (-> boundary data i x) (-> boundary data i z)))
        (format stream ")~%")
        (save-boundary-cmd (-> boundary cmd-fwd) "fwd" stream)
        (save-boundary-cmd (-> boundary cmd-bwd) "bwd" stream)
        (format stream "  )~%~%")
        (set! boundary (-> boundary next))))
    (format stream "))~%~%(doarray (i *static-load-boundary-list*) (load-boundary-from-template (the-as (array object) i)))~%")
    (file-stream-close stream))
  (format 0 "Written ~S~%" *temp-string*)
  0
  (none))

(defun-debug lb-add ()
  "Create and select an open two-point boundary beginning at the camera and
   extending 50 meters along positive Z."
  (let ((boundary (new 'global 'load-boundary 2 #f #t)))
    (let ((camera-position (camera-pos)))
      (set! (-> boundary data 0 x) (-> camera-position x))
      (set! (-> boundary data 0 z) (-> camera-position z))
      (set! (-> boundary data2 1 x) (-> camera-position x))
      (set! (-> boundary data2 1 z) (+ 204800.0 (-> camera-position z))))
    (set! (-> *lb-editor-parms* boundary) boundary)
    (set! (-> *lb-editor-parms* vertex) -1)
    boundary))

(defun-debug lb-add-plane ()
  "Create and select a closed 50-by-50-meter boundary whose first corner
   is at the camera."
  (let ((boundary (new 'global 'load-boundary 4 #t #t)))
    (let ((camera-position (camera-pos)))
      (set! (-> boundary data 0 x) (-> camera-position x))
      (set! (-> boundary data 0 z) (-> camera-position z))
      (set! (-> boundary data2 1 x) (-> camera-position x))
      (set! (-> boundary data2 1 z) (+ 204800.0 (-> camera-position z)))
      (set! (-> boundary data2 2 x) (+ 204800.0 (-> camera-position x)))
      (set! (-> boundary data2 2 z) (+ 204800.0 (-> camera-position z)))
      (set! (-> boundary data2 3 x) (+ 204800.0 (-> camera-position x)))
      (set! (-> boundary data2 3 z) (-> camera-position z)))
    (set! (-> *lb-editor-parms* boundary) boundary)
    (set! (-> *lb-editor-parms* vertex) -1)
    boundary))

(defun-debug lb-add-load ((level0 symbol) (level1 symbol))
  "Create an open boundary and assign a forward load command requesting
   level0 and level1."
  (let ((boundary (lb-add)))
    (set! (-> boundary cmd-fwd cmd) (load-boundary-cmd load))
    (set! (-> boundary cmd-fwd lev0) level0)
    (set! (-> boundary cmd-fwd lev1) level1))
  0
  (none))

(defun-debug lb-add-load-plane ((level0 symbol) (level1 symbol))
  "Create a closed boundary and assign a forward load command
   requesting level0 and level1."
  (let ((boundary (lb-add-plane)))
    (set! (-> boundary cmd-fwd cmd) (load-boundary-cmd load))
    (set! (-> boundary cmd-fwd lev0) level0)
    (set! (-> boundary cmd-fwd lev1) level1))
  0
  (none))

(defun lb-flip ()
  "Swap the selected boundary's forward and backward crossing commands."
  (let ((boundary (-> *lb-editor-parms* boundary)))
    (when (not boundary)
      (format 0 "No boundary selected~%")
      (return 0))
    (let ((temp-command (new 'stack 'load-boundary-crossing-command)))
      (copy-load-command! temp-command (-> boundary cmd-fwd))
      (copy-load-command! (-> boundary cmd-fwd) (-> boundary cmd-bwd))
      (copy-load-command! (-> boundary cmd-bwd) temp-command)))
  (none))

(defun lb-set-camera ()
  "Make the selected boundary react to camera crossings by clearing its
   player flag."
  (let ((boundary (-> *lb-editor-parms* boundary)))
    (when (not boundary)
      (format 0 "No boundary selected~%")
      (return 0))
    (logclear! (-> boundary flags) (load-boundary-flags player)))
  0
  (none))

(defun lb-set-player ()
  "Make the selected boundary react to player crossings by setting its
   player flag."
  (let ((boundary (-> *lb-editor-parms* boundary)))
    (when (not boundary)
      (format 0 "No boundary selected~%")
      (return 0))
    (logior! (-> boundary flags) (load-boundary-flags player)))
  0
  (none))

(defun-debug lb-copy ()
  "Duplicate the selected boundary, including every vertex and both commands,
   prepend the copy to the boundary list, and select it."
  (let ((source (-> *lb-editor-parms* boundary)))
    (when (not source)
      (format 0 "No boundary selected~%")
      (return 0))
    (let ((copy (new 'global 'load-boundary (the-as int (-> source num-points)) #f #t)))
      (copy-load-boundary! copy source)
      (dotimes (i (the-as int (-> source num-points)))
        (set! (-> copy data i quad) (-> source data i quad)))
      (set! (-> *lb-editor-parms* boundary) copy)))
  0
  (none))

;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Main Load Render Hook
;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun render-boundaries ()
  "Once per frame, retain previous camera/player positions, capture
   current positions, lazily triangulate and bound each boundary, optionally draw it, and execute any
   detected crossings. Run the editor when boundary display is enabled."
  (when (-> *level* border?)
    (set! (-> *load-boundary-target* 2 quad) (-> *load-boundary-target* 0 quad))
    (set! (-> *load-boundary-target* 3 quad) (-> *load-boundary-target* 1 quad))
    (set! (-> *load-boundary-target* 0 quad) (-> (camera-pos) quad))
    (set! (-> *load-boundary-target* 1 quad) (-> (target-pos 0) quad))
    (let ((boundary *load-boundary-list*))
      (while boundary
        (when (zero? (-> boundary tri-cnt))
          (triangulate-boundary boundary)
          (find-bounding-circle boundary))
        (if *display-load-boundaries* (render-boundary boundary))
        (check-boundary boundary)
        (set! boundary (-> boundary next)))))
  (if *display-load-boundaries* (edit-load-boundaries))
  0
  (none))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; The Math Stuff
;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun find-bounding-circle ((boundary load-boundary))
  "Store an XZ rejection circle centered on boundary's
   axis-aligned bounding box, with radius equal to the box half-diagonal."
  (let ((min-x 268435460.0)
        (max-x -268435460.0)
        (min-z 268435460.0)
        (max-z -268435460.0))
    (dotimes (i (the-as int (-> boundary num-points)))
      (if (< (-> boundary data i x) min-x) (set! min-x (-> boundary data i x)))
      (if (< max-x (-> boundary data i x)) (set! max-x (-> boundary data i x)))
      (if (< (-> boundary data i z) min-z) (set! min-z (-> boundary data i z)))
      (if (< max-z (-> boundary data i z)) (set! max-z (-> boundary data i z))))
    (let* ((center-x (* 0.5 (+ min-x max-x)))
           (center-z (* 0.5 (+ min-z max-z)))
           (half-width (- center-x min-x))
           (half-depth (- center-z min-z))
           (radius (sqrtf (+ (square half-width) (square half-depth)))))
      (set-vector! (-> boundary rejector) center-x 0.0 center-z radius)))
  0
  (none))

(define *triangulation-buffer* (the-as (inline-array lbvtx) (malloc 'global 4096)))

;; Closed caps keep their polygon vertices and output triangle indices in the same allocation.
;; Triangulation first copies the polygon to this 256-record work buffer, using v0/v1 as circular
;; previous/next links and v2 as an active flag. It starts at the lowest-Z, then lowest-X, vertex,
;; reverses all links when needed to establish one winding, and cuts temporary diagonals until each
;; remaining piece is Z-monotone. split-monotone-polygon then clips convex ears into the original
;; boundary's v0/v1/v2 bytes.
;;
;; The predecessor walk has a ten-link escape for malformed topology. Closed boundaries have at
;; most eight vertices; this is not intended as a general large-polygon triangulator.
(defun triangulate-boundary ((boundary load-boundary))
  "Triangulate a closed XZ boundary into index triples stored in
   its vertex records. Build circular previous/next links in the global work buffer, normalize
   winding, split non-monotone sections, triangulate each monotone polygon, and fix triangle winding.
   Open boundaries only mark their cache initialized."
  (when (not (logtest? (-> boundary flags) (load-boundary-flags closed)))
    (set! (-> boundary tri-cnt) 1)
    (return 0))
  (let ((work *triangulation-buffer*))
    (new 'stack 'lbvtx)
    (let ((vertex-count (-> boundary num-points)))
      (set! (-> boundary tri-cnt) 0)
      (dotimes (i (the-as int vertex-count))
        (let ((vertex-bits (-> boundary data i quad))) (set! (-> work i quad) vertex-bits))
        (if (zero? i) (set! (-> work i v0) (+ vertex-count -1)) (set! (-> work i v0) (the-as uint (+ i -1))))
        (cond
          ((= i (+ vertex-count -1)) (set! (-> work i v1) (the-as uint 0)) 0)
          (else (set! (-> work i v1) (the-as uint (+ i 1)))))
        (set! (-> work i v2) (the-as uint 1)))
      (loop
        (let ((lowest-index -1))
          (let ((lowest-z 268435460.0))
            (dotimes (i (the-as int vertex-count))
              (when (nonzero? (-> work i v2))
                (when (or (< (-> work i z) lowest-z) (and (= (-> work i z) lowest-z) (< (-> work i x) (-> work lowest-index x))))
                  (set! lowest-z (-> work i z))
                  (set! lowest-index i)))))
          (let* ((lowest (-> work lowest-index))
                 (previous (-> work (-> lowest v0)))
                 (next (-> work (-> lowest v1)))
                 (prev-dx (- (-> lowest x) (-> previous x)))
                 (prev-dz (- (-> lowest z) (-> previous z)))
                 (next-dx (- (-> next x) (-> lowest x))))
            (when (< (- (* prev-dx (- (-> next z) (-> lowest z))) (* next-dx prev-dz)) 0.0)
              (dotimes (i (the-as int vertex-count))
                (let ((old-prev (-> work i v0))) (set! (-> work i v0) (-> work i v1)) (set! (-> work i v1) old-prev)))))
          (let ((chain-prev lowest-index)
                (prev-index (-> work lowest-index v0))
                (next-index (-> work lowest-index v1)))
            (let ((walk-count 0))
              (while (>= (-> work prev-index z) (-> work chain-prev z))
                (set! chain-prev (the-as int prev-index))
                (set! prev-index (-> work (the-as uint chain-prev) v0))
                (+! walk-count 1)
                (when (= walk-count 10)
                  (break!)
                  0)))
            (while (and (!= chain-prev lowest-index) (>= (-> work chain-prev z) (-> work prev-index z)))
              (set! chain-prev (the-as int prev-index))
              (set! prev-index (-> work (the-as uint chain-prev) v0)))
            (when (= chain-prev lowest-index)
              (split-monotone-polygon boundary lowest-index)
              (fix-boundary-normals boundary)
              (return 0))
            (let ((chain-next lowest-index))
              (while (and (>= (-> work next-index z) (-> work chain-next z)) (>= (-> work chain-prev z) (-> work next-index z)))
                (set! chain-next (the-as int next-index))
                (set! next-index (-> work (the-as uint chain-next) v1)))
              (let ((saved-prev (-> work chain-prev v0))
                    (saved-next (-> work chain-next v1)))
                (set! (-> work chain-prev v0) (the-as uint chain-next))
                (set! (-> work chain-next v1) (the-as uint chain-prev))
                (let ((i (-> work chain-prev v1)))
                  (while (!= i chain-next)
                    (set! (-> work i v2) (the-as uint 0))
                    (set! i (-> work i v1))))
                (split-monotone-polygon boundary lowest-index)
                (set! (-> work chain-prev v0) saved-prev)
                (set! (-> work chain-next v1) saved-next))
              (set! (-> work chain-next v0) (the-as uint chain-prev))
              (set! (-> work chain-prev v1) (the-as uint chain-next))))))))
  0)

(defun try-corner ((boundary load-boundary) (corner-index int))
  "Return true when the candidate corner's diagonal leaves every remaining
   polygon vertex on the valid side, making the corner safe to clip during triangulation."
  (let* ((work *triangulation-buffer*)
         (prev-index (-> work corner-index v0))
         (next-index (-> work corner-index v1))
         (diagonal-dx (- (-> work prev-index x) (-> work next-index x)))
         (diagonal-dz (- (-> work prev-index z) (-> work next-index z)))
         (test-index (-> work next-index v1)))
    (while (!= test-index prev-index)
      (let ((test-dx (- (-> work test-index x) (-> work next-index x)))
            (test-dz (- (-> work test-index z) (-> work next-index z))))
        (if (< (- (* test-dx diagonal-dz) (* diagonal-dx test-dz)) 0.0) (return #f)))
      (set! test-index (-> work test-index v1))))
  #t)

(defun split-monotone-polygon ((boundary load-boundary) (start-index int))
  "Ear-clip one monotone polygon from the work-buffer links,
   append each triangle's original vertex indices to boundary, and remove accepted corners until one
   triangle remains."
  (let ((work *triangulation-buffer*))
    (loop
      (when (= (-> work (-> work (-> work start-index v0) v0) v0) start-index)
        (let ((triangle-index (-> boundary tri-cnt)))
          (set! (-> boundary data triangle-index v0) (the-as uint start-index))
          (set! (-> boundary data triangle-index v1) (-> work start-index v0))
          (set! (-> boundary data triangle-index v2) (-> work (-> work start-index v0) v0)))
        (+! (-> boundary tri-cnt) 1)
        (return 0))
      (let ((corner-index start-index))
        (while (not (try-corner boundary corner-index))
          (set! corner-index (the-as int (-> work corner-index v1)))
          (when (= (the-as uint corner-index) start-index)))
        (let ((triangle-index (-> boundary tri-cnt)))
          (set! start-index (the-as int (-> work corner-index v0)))
          (let ((next-index (-> work corner-index v1)))
            (set! (-> boundary data triangle-index v0) (the-as uint start-index))
            (set! (-> boundary data triangle-index v1) (the-as uint corner-index))
            (set! (-> boundary data triangle-index v2) next-index)
            (+! (-> boundary tri-cnt) 1)
            (set! (-> work (the-as uint start-index) v1) next-index)
            (set! (-> work next-index v0) (the-as uint start-index)))))))
  0
  (none))

(defun fix-boundary-normals ((boundary load-boundary))
  "Check that each cached cap triangle lies in the XZ plane and
   swap its first two indices when necessary so every triangle faces upward."
  (dotimes (i (-> boundary tri-cnt))
    (let ((v0 (-> boundary data (-> boundary data i v0)))
          (v1 (-> boundary data (-> boundary data i v1)))
          (v2 (-> boundary data (-> boundary data i v2)))
          (normal (new 'stack-no-clear 'vector)))
      (normal-of-plane normal (-> v0 v) (-> v1 v) (-> v2 v))
      (if (or (!= (-> normal x) 0.0) (!= (-> normal z) 0.0)) (format 0 "ERROR in the load-boundary code : tell Eddie!!!~%"))
      (when (< (-> normal y) 0.0)
        (let ((temp-index (-> boundary data i v0)))
          (set! (-> boundary data i v0) (-> boundary data i v1))
          (set! (-> boundary data i v1) temp-index)))))
  0
  (none))

(defun point-in-polygon ((boundary load-boundary) (point vector))
  "Return true when point's XZ coordinates lie inside any cached
   boundary triangle, including points on triangle edges."
  (dotimes (i (-> boundary tri-cnt))
    (let* ((v0 (-> boundary data (-> boundary data i v0)))
           (v1 (-> boundary data (-> boundary data i v1)))
           (v2 (-> boundary data (-> boundary data i v2)))
           (edge20-dx (- (-> v1 x) (-> v2 x)))
           (edge20-dz (- (-> v1 z) (-> v2 z)))
           (point1-dx (- (-> v1 x) (-> point x)))
           (point1-dz (- (-> v1 z) (-> point z))))
      (when (>= (- (* point1-dx edge20-dz) (* edge20-dx point1-dz)) 0.0)
        (let ((point1-dx (- (-> v1 x) (-> point x)))
              (point1-dz (- (-> v1 z) (-> point z)))
              (edge10-dx (- (-> v1 x) (-> v0 x)))
              (edge10-dz (- (-> v1 z) (-> v0 z))))
          (when (>= (- (* edge10-dx point1-dz) (* point1-dx edge10-dz)) 0.0)
            (let ((point2-dx (- (-> point x) (-> v2 x)))
                  (point2-dz (- (-> point z) (-> v2 z)))
                  (edge20-dx (- (-> point x) (-> v0 x)))
                  (edge20-dz (- (-> point z) (-> v0 z))))
              (if (>= (- (* edge20-dx point2-dz) (* point2-dx edge20-dz)) 0.0) (return #t))))))))
  #f)

(defun check-closed-boundary ((boundary load-boundary) (current-pos lbvtx) (previous-pos lbvtx))
  "Test whether movement crossed the closed boundary's top plane
   inside its triangulated cap. The XZ sample uses vertical-motion divided by previous-to-plane
   distance, so it is generally extrapolated beyond current-pos rather than placed on the plane.
   Return none, forward, or backward according to the crossing direction."
  (if (and (< (-> boundary top-plane) (-> current-pos y)) (< (-> boundary top-plane) (-> previous-pos y)))
    (return (load-boundary-crossing-result none)))
  (if (and (< (-> current-pos y) (-> boundary top-plane)) (< (-> previous-pos y) (-> boundary top-plane)))
    (return (load-boundary-crossing-result none)))
  (let ((plane-scale (/ (- (-> current-pos y) (-> previous-pos y)) (- (-> boundary top-plane) (-> previous-pos y))))
        (crossing-point (new 'stack-no-clear 'vector)))
    (set! (-> crossing-point x) (+ (-> previous-pos x) (* plane-scale (- (-> current-pos x) (-> previous-pos x)))))
    (set! (-> crossing-point y) (+ (-> previous-pos y) (* plane-scale (- (-> current-pos y) (-> previous-pos y)))))
    (set! (-> crossing-point z) (+ (-> previous-pos z) (* plane-scale (- (-> current-pos z) (-> previous-pos z)))))
    (when (point-in-polygon boundary crossing-point)
      (if (< (-> boundary top-plane) (-> current-pos y)) (return (load-boundary-crossing-result backward)))
      (return (load-boundary-crossing-result forward))))
  (the-as load-boundary-crossing-result 0))

(defun check-open-boundary ((boundary load-boundary) (current-pos lbvtx) (previous-pos lbvtx))
  "Intersect the previous-to-current XZ segment with every open
   boundary edge, accept intersections within the boundary's vertical range, and accumulate oriented
   crossings. Return forward for positive net crossings, backward for negative, or none."
  (let ((move-start-x (-> previous-pos x))
        (move-start-z (-> previous-pos z))
        (move-end-x (-> current-pos x))
        (move-end-z (-> current-pos z))
        (edge-start-x (-> boundary data 0 x))
        (edge-start-z (-> boundary data 0 z))
        (edge-index 1)
        (net-crossings 0))
    (if (and (= move-start-x move-end-x) (= move-start-z move-end-z)) (return (load-boundary-crossing-result none)))
    (let ((move-dx (- move-end-x move-start-x))
          (move-dz (- move-end-z move-start-z)))
      (while (< edge-index (the-as int (-> boundary num-points)))
        (let ((edge-end-x (-> boundary data edge-index x))
              (edge-end-z (-> boundary data edge-index z)))
          (let ((move-numerator (- (* (- edge-start-z move-start-z) move-dx) (* (- edge-start-x move-start-x) move-dz)))
                (edge-numerator (- (* (- edge-start-z move-start-z) (- edge-end-x edge-start-x))
                                   (* (- edge-start-x move-start-x) (- edge-end-z edge-start-z))))
                (denominator (- (* (- edge-end-x edge-start-x) move-dz) (* (- edge-end-z edge-start-z) move-dx))))
            (when (!= denominator 0.0)
              (let ((move-t (/ move-numerator denominator))
                    (edge-t (/ edge-numerator denominator)))
                (if (and (>= move-t 0.0) (>= 1.0 move-t)) 0)
                (when (and (>= move-t 0.0) (>= 1.0 move-t) (< 0.0 edge-t) (>= 1.0 edge-t))
                  (let ((crossing-y (+ (-> previous-pos y) (* move-t (- (-> current-pos y) (-> previous-pos y))))))
                    (when (and (>= crossing-y (-> boundary bot-plane)) (>= (-> boundary top-plane) crossing-y))
                      (let ((side (- (* (- move-end-x edge-start-x) (- edge-end-z edge-start-z))
                                     (* (- move-end-z edge-start-z) (- edge-end-x edge-start-x)))))
                        (if (< 0.0 side) (+! net-crossings 1) (+! net-crossings -1)))))))))
          (set! edge-start-x edge-end-x)
          (set! edge-start-z edge-end-z))
        (+! edge-index 1)))
    (if (> net-crossings 0) (return (load-boundary-crossing-result forward)))
    (if (< net-crossings 0) (return (load-boundary-crossing-result backward))))
  (the-as load-boundary-crossing-result 0))

;;;;;;;;;;;;;;;;;;;;;;;;
;; Load Commands
;;;;;;;;;;;;;;;;;;;;;;;;

(defun command-get-int ((value object) (default int))
  "Return value as an integer when it is a boxed integer or float;
   return default for false or unsupported values."
  (cond
    ((null? value) (empty) default)
    ((type-type? (rtype-of value) binteger) (/ (the-as int value) 8))
    ((type-type? (rtype-of value) bfloat) (the int (-> (the-as bfloat value) data)))
    (else (empty) default)))

(defun command-get-float ((value object) (default float))
  "Return value as a float when it is a boxed integer or float;
   return default for false or unsupported values."
  (cond
    ((null? value) (empty) default)
    ((type-type? (rtype-of value) binteger) (the float (/ (the-as int value) 8)))
    ((type-type? (rtype-of value) bfloat) (-> (the-as bfloat value) data))
    (else (empty) default)))

(defun command-get-time ((value object) (default int))
  "Convert (seconds n) to 300-Hz animation frames, otherwise convert a
   boxed number to an integer; return default when conversion is unavailable."
  (cond
    ((null? value) (empty) default)
    ((and (pair? value) (= (car value) 'seconds)) (the int (* 300.0 (command-get-float (car (cdr value)) 0.0))))
    ((type-type? (rtype-of value) binteger) (/ (the-as int value) 8))
    ((type-type? (rtype-of value) bfloat) (the int (-> (the-as bfloat value) data)))
    (else (empty) default)))

(defun command-get-param ((value object) (default object))
  "Decode a command parameter: seconds to 300-Hz frames, meters to
   4096-unit world coordinates, degrees to 65536-unit turns, and static-vectorm to a permanently
   allocated scaled vector. Unrecognized values pass through; false uses default."
  (cond
    ((null? value) default)
    ((and (pair? value) (= (car value) 'seconds)) (the int (* 300.0 (command-get-float (car (cdr value)) 0.0))))
    ((and (pair? value) (= (car value) 'meters)) (* 4096.0 (command-get-float (car (cdr value)) 0.0)))
    ((and (pair? value) (= (car value) 'deg)) (* 182.04445 (command-get-float (car (cdr value)) 0.0)))
    ((and (pair? value) (= (car value) 'static-vectorm))
     (let ((result-vector (the-as object (new 'static 'vector))))
       (set-vector! (the-as vector result-vector)
                    (* 4096.0 (command-get-float (car (cdr value)) 0.0))
                    (* 4096.0 (command-get-float (car (cdr (cdr value))) 0.0))
                    (* 4096.0 (command-get-float (car (cdr (cdr (cdr value)))) 0.0))
                    1.0)
       result-vector))
    ((type-type? (rtype-of value) binteger) (/ (the-as int value) 8))
    ((type-type? (rtype-of value) bfloat) (-> (the-as bfloat value) data))
    (else value)))

(defun command-get-quoted-param ((value object) (default object))
  "Decode a command parameter after removing one outer
   (quote value) wrapper."
  (if (and (pair? value) (= (car value) 'quote))
    (command-get-param (car (cdr value)) default)
    (command-get-param value default)))

(defmethod reset! ((this load-state))
  "Clear both requested-level slots, the pending command list, and all 256 temporary
   entity-state records, then return this."
  (set! (-> this want 0 name) #f)
  (set! (-> this want 0 display?) #f)
  (set! (-> this want 0 force-vis?) #f)
  (set! (-> this want 0 force-inside?) #f)
  (set! (-> this want 1 name) #f)
  (set! (-> this want 1 display?) #f)
  (set! (-> this want 1 force-vis?) #f)
  (set! (-> this want 1 force-inside?) #f)
  (set! (-> this command-list) '())
  (dotimes (i 256)
    (set! (-> this object-name i) #f)
    (set! (-> this object-status i) (the-as basic 0)))
  this)

(defmethod want-levels ((this load-state) (level0 symbol) (level1 symbol))
  "Make the two request slots contain level0 and level1 while preserving matching
   slots and their display/visibility options. Clear unmatched slots and reset the
   options of newly assigned slots."
  (dotimes (i 2)
    (cond
      ((= (-> this want i name) level0) (set! level0 #f))
      ((= (-> this want i name) level1) (set! level1 #f))
      (else (set! (-> this want i name) #f))))
  (when level0
    (dotimes (slot 2)
      (when (not (-> this want slot name))
        (set! (-> this want slot name) level0)
        (set! (-> this want slot display?) #f)
        (set! (-> this want slot force-vis?) #f)
        (set! (-> this want slot force-inside?) #f)
        (set! slot 2))))
  (when level1
    (dotimes (slot 2)
      (when (not (-> this want slot name))
        (set! (-> this want slot name) level1)
        (set! (-> this want slot display?) #f)
        (set! (-> this want slot force-vis?) #f)
        (set! (-> this want slot force-inside?) #f)
        (set! slot 2))))
  0)

(defmethod want-display-level ((this load-state) (level-name symbol) (display-mode symbol))
  "Set display-mode for a requested level. Enabling display for a level not
   present in either request slot reports an error; disabling an absent level
   is silent."
  (dotimes (i 2)
    (when (= (-> this want i name) level-name)
      (set! (-> this want i display?) display-mode)
      (return 0)))
  (if display-mode (format 0 "ERROR: can't display ~A because it isn't loaded~%" level-name))
  0)

(defmethod want-vis ((this load-state) (vis-nick symbol))
  "Select the visibility nickname requested by this load state."
  (set! (-> this vis-nick) vis-nick)
  0)

(defmethod want-force-vis ((this load-state) (level-name symbol) (enabled? symbol))
  "Set forced visibility for a requested level, or report an error when the level
   is absent."
  (dotimes (i 2)
    (when (= (-> this want i name) level-name)
      (set! (-> this want i force-vis?) enabled?)
      (return 0)))
  (format 0 "ERROR: can't force vis on ~A because it isn't loaded~%" level-name)
  0)

(defmethod set-force-inside! ((this load-state) (level-name symbol) (enabled? symbol))
  "Set forced-inside behavior for a requested level, or report an error when
   the level is absent."
  (dotimes (i 2)
    (when (= (-> this want i name) level-name)
      (set! (-> this want i force-inside?) enabled?)
      (return 0)))
  (format 0 "ERROR: can't force inside on ~A because it isn't loaded~%" level-name)
  0
  (none))

(defun load-state-want-levels ((level0 symbol) (level1 symbol))
  "Apply want-levels to the global load state."
  (want-levels *load-state* level0 level1))

(defun load-state-want-display-level ((level-name symbol) (display-mode symbol))
  "Apply want-display-level to the global load state."
  (want-display-level *load-state* level-name display-mode))

(defun load-state-want-vis ((vis-nick symbol))
  "Apply want-vis to the global load state."
  (want-vis *load-state* vis-nick))

(defun load-state-want-force-vis ((level-name symbol) (enabled? symbol))
  "Apply want-force-vis to the global load state."
  (want-force-vis *load-state* level-name enabled?))

(define *display-load-commands* #f)

(define *backup-load-state* (new 'global 'load-state))

(defmethod backup-load-state-and-set-cmds ((this load-state) (command-list pair))
  "Discard stale temporary entity records after warning, snapshot
   this into the global backup, clear the backup command list, and
   install command-list for temporary cutscene or camera playback."
  (dotimes (i 256)
    (when (-> this object-name i)
      (format 0 "WARNING: load state somehow aquired object command ~A~%" (-> this object-name i))
      (set! (-> this object-name i) #f)))
  (mem-copy! (&-> *backup-load-state* type) (&-> this type) 2092)
  (set! (-> *backup-load-state* command-list) '())
  (set! (-> this command-list) command-list)
  0)

(defmethod restore-load-state-and-cleanup ((this load-state))
  "Execute all remaining temporary commands, restore every tracked
   entity's permanent status and kill any live temporary process,
   then restore the saved load-state snapshot."
  (execute-commands-up-to this 100000.0)
  (dotimes (i 256)
    (when (-> this object-name i)
      (let ((tracked-entity (entity-by-name (-> this object-name i))))
        (set! (-> tracked-entity extra perm status) (the-as entity-perm-status (-> this object-status i)))
        (if (-> tracked-entity extra process) (kill! tracked-entity)))
      (set! (-> this object-name i) #f)))
  (mem-copy! (&-> this type) (&-> *backup-load-state* type) 2092)
  0)

(defmethod restore-load-state ((this load-state))
  "Discard temporary entity tracking without undoing the entities, then
   restore the saved load-state snapshot."
  (dotimes (i 256)
    (if (-> this object-name i) (set! (-> this object-name i) #f)))
  (mem-copy! (&-> this type) (&-> *backup-load-state* type) 2092)
  0)

(defun command-list-get-process ((value object))
  "Resolve a command target to a process. Accept an existing
   process, target, sidekick, self, parent, camera, an entity/process name string, or a child
   drawable's art-group name; return false if unresolved."
  (with-pp
    (set! value
          (cond
            ((null? value) #f)
            ((type-type? (rtype-of value) process) (empty) value)
            ((= value 'target) *target*)
            ((= value 'sidekick) (if *target* (ppointer->process (-> *target* sidekick))))
            ((= value 'self) pp)
            ((= value 'parent) (ppointer->process (-> pp parent)))
            ((= value 'camera) *camera*)
            ((type-type? (rtype-of value) string)
             (let ((named-process (process-by-ename (the-as string value))))
               (cond
                 (named-process (empty) named-process)
                 (else
                  (let ((child (ppointer->process (-> pp child))))
                    (while child
                      (let* ((child-process child)
                             (drawable-child (if (and (nonzero? child-process) (type-type? (-> child-process type) process-drawable)) child-process)))
                        (when (and drawable-child
                                   (nonzero? (-> (the-as process-drawable drawable-child) draw))
                                   (nonzero? (-> (the-as process-drawable drawable-child) draw art-group))
                                   (string= (the-as string value) (-> (the-as process-drawable drawable-child) draw art-group name)))
                          (set! value drawable-child)
                          (goto cfg-56)))
                      (set! child (ppointer->process (-> child brother)))))
                  (the-as process #f)))))
            (else #f)))
    (label cfg-56)
    (the-as process value)))

(defmethod execute-commands-up-to ((this load-state) (frame float))
  "Consume scheduled command-list entries whose timestamp is no later
   than frame. Each entry may hold one command or a list of commands; the
   first future entry remains pending."
  (while (not (null? (-> this command-list)))
    (let ((scheduled-frame (command-get-float (car (car (-> this command-list))) 0.0))
          (commands (cdr (car (-> this command-list)))))
      (if (< frame scheduled-frame) (return (the-as int #f)))
      (if *display-load-commands* (format 0 "NOTICE: ~D: ~f: execute command ~A~%" (current-time) scheduled-frame commands))
      (cond
        ((pair? (car commands))
         (let ((command (car commands)))
           (while (not (null? commands))
             (execute-command this (the-as pair command))
             (set! commands (cdr commands))
             (set! command (car commands)))))
        (else (execute-command this commands))))
    (set! (-> this command-list) (cdr (-> this command-list))))
  0)

;; Command vocabulary:
;;   set!, eval
;;   want-vis, want-levels, display-level, want-force-vis, want-force-inside
;;   alive, dead, kill, special, active
;;   part-tracker, auto-save, shadow, time-of-day, save
;;   setting-reset, setting-unset, blackout, teleport, joint, ambient, send-event
;;
;; alive and kill reserve one of the 256 object-state slots before changing an entity. dead removes
;; a matching reservation and restores its permanent status. Temporary command playback can
;; therefore finish by restoring the same entity state that was visible when playback began.
(defmethod execute-command ((this load-state) (command pair))
  "Execute one load or cutscene command. Commands may alter load requests,
   symbols, entities, particles, settings, saves, time of day, camera state, or
   events. Entity birth and kill commands save permanent state in one of 256
   slots so temporary playback can be cleaned up."
  (local-vars (saved-slot int))
  (with-pp
    (cond
      ((null? command))
      ((pair? command)
       (let ((v1-4 (car command))
             (gp-0 (cdr command)))
         (cond
           ((= v1-4 'set!)
            (let ((destination (command-get-param (car gp-0) #f)))
              (if destination (set! (-> (the-as symbol destination) value) (command-get-param (car (cdr gp-0)) #f)))))
           ((= v1-4 'eval) ((the-as (function int) (command-get-param (car gp-0) #f))))
           ((= v1-4 'want-vis) (want-vis this (the-as symbol (command-get-param (car gp-0) #f))))
           ((= v1-4 'want-levels)
            (want-levels this
                         (the-as symbol (command-get-param (car gp-0) #f))
                         (the-as symbol (command-get-param (car (cdr gp-0)) #f))))
           ((= v1-4 'display-level)
            (want-display-level this
                                (the-as symbol (command-get-param (car gp-0) #f))
                                (the-as symbol (command-get-param (car (cdr gp-0)) #f))))
           ((= v1-4 'want-force-vis)
            (want-force-vis this
                            (the-as symbol (command-get-param (car gp-0) #f))
                            (the-as symbol (command-get-param (car (cdr gp-0)) #f))))
           ((= v1-4 'want-force-inside)
            (set-force-inside! this
                               (the-as symbol (command-get-param (car gp-0) #f))
                               (the-as symbol (command-get-param (car (cdr gp-0)) #f))))
           ((= v1-4 'alive)
            (let ((entity-name (command-get-param (car gp-0) #f)))
              (when entity-name
                (let ((target-entity (entity-by-name (the-as string entity-name))))
                  (when target-entity
                    (dotimes (slot 256)
                      (when (not (-> this object-name slot))
                        (set! (-> this object-name slot) (the-as string entity-name))
                        (set! (-> this object-status slot) (the-as basic (-> target-entity extra perm status)))
                        (set! saved-slot slot)
                        (goto cfg-29)))
                    (set! saved-slot -1)
                    (label cfg-29)
                    (when (>= saved-slot 0)
                      (entity-birth-no-kill target-entity)
                      (let ((entity-process (-> target-entity extra process)))
                        (when entity-process
                          (logclear! (-> entity-process mask) (process-mask actor-pause))
                          (logclear! (-> entity-process mask) (-> *kernel-context* prevent-from-run))))))))))
           ((= v1-4 'dead)
            (let ((entity-name (command-get-param (car gp-0) #f)))
              (when entity-name
                (let ((target-entity (entity-by-name (the-as string entity-name))))
                  (when target-entity
                    (dotimes (slot 256)
                      (when (string= (-> this object-name slot) (the-as string entity-name))
                        (set! (-> target-entity extra perm status) (the-as entity-perm-status (-> this object-status slot)))
                        (if (-> target-entity extra process) (kill! target-entity))
                        (set! (-> this object-name slot) #f)
                        (goto cfg-45)))))))
            (label cfg-45))
           ((= v1-4 'kill)
            (let ((entity-name (command-get-param (car gp-0) #f)))
              (when entity-name
                (let ((target-entity (entity-by-name (the-as string entity-name))))
                  (when target-entity
                    (dotimes (slot 256)
                      (when (not (-> this object-name slot))
                        (set! (-> this object-name slot) (the-as string entity-name))
                        (set! (-> this object-status slot) (the-as basic (-> target-entity extra perm status)))
                        (set! saved-slot slot)
                        (goto cfg-56)))
                    (set! saved-slot -1)
                    (label cfg-56)
                    (when (>= saved-slot 0)
                      (if (-> target-entity extra process) (kill! target-entity))
                      (logior! (-> target-entity extra perm status) (entity-perm-status dead))))))))
           ((= v1-4 'special)
            (let ((entity-name (command-get-param (car gp-0) #f)))
              (when entity-name
                (let ((target-entity (entity-by-name (the-as string entity-name))))
                  (if target-entity
                    (set-or-clear-status! (the-as entity-actor target-entity)
                                          (entity-perm-status force-birth)
                                          (the-as symbol (command-get-param (car (cdr gp-0)) #f))))))))
           ((= v1-4 'active)
            (let ((level-name (command-get-param (car gp-0) #f)))
              (while (!= (level-status *level* (the-as symbol level-name)) 'active)
                (suspend))))
           ((= v1-4 'part-tracker)
            (let* ((group-name (command-get-param (car gp-0) #f))
                   (entity-name (command-get-param (car (cdr gp-0)) #f))
                   (target-entity (entity-by-name (the-as string entity-name)))
                   (group (lookup-part-group-by-name (symbol->string (the-as symbol group-name))))
                   (launch-group (if (and (nonzero? group) (type-type? (-> group type) sparticle-launch-group)) group)))
              (when (and target-entity launch-group)
                (let* ((entity-process (-> target-entity extra process))
                       (entity-drawable (if (and (nonzero? entity-process) (type-type? (-> entity-process type) process-drawable))
                                          (the-as process-drawable entity-process)))
                       (tracker (get-process *default-dead-pool* part-tracker #x4000)))
                  (when tracker
                    (let* ((activate (method-of-type part-tracker activate))
                           (tracker tracker)
                           (parent-pool (ppointer->process (-> *setting-control* current movie))))
                      (set! parent-pool
                            (cond
                              (parent-pool (empty) parent-pool)
                              (else *entity-pool*)))
                      (activate (the-as part-tracker tracker) parent-pool 'part-tracker (the-as pointer #x70004000)))
                    (run-now-in-process tracker
                                        part-tracker-init
                                        launch-group
                                        -1
                                        #f
                                        #f
                                        #f
                                        (if entity-drawable (-> entity-drawable root trans) (-> target-entity extra trans)))
                    (-> tracker ppointer))))))
           ((= v1-4 'auto-save) (auto-save-command (the-as symbol (command-get-param (car gp-0) #f)) 0 0 *default-pool*))
           ((= v1-4 'shadow)
            (let ((target-process (command-list-get-process (car gp-0)))
                  (shadow-value (command-get-quoted-param (car (cdr gp-0)) #f)))
              (send-event target-process 'shadow shadow-value)))
           ((= v1-4 'time-of-day)
            (when *time-of-day-proc*
              (let ((hour (command-get-int (car gp-0) 0)))
                (cond
                  ((< hour 0) (set! (-> *time-of-day-proc* 0 time-ratio) 300.0))
                  (else
                   (set! (-> *time-of-day-proc* 0 hour) hour)
                   (set! (-> *time-of-day-proc* 0 minute) 0)
                   (set! (-> *time-of-day-proc* 0 frame) 0)
                   (set! (-> *time-of-day-proc* 0 time-ratio) 0.0))))))
           ((= v1-4 'save)
            (mem-copy! (&-> *backup-load-state* type) (&-> this type) 2092)
            (set! (-> *backup-load-state* command-list) '())
            (dotimes (i 256)
              (if (-> *backup-load-state* object-name i) (set! (-> *backup-load-state* object-name i) #f))))
           ((= v1-4 'setting-reset)
            (set-setting! (the-as symbol (command-get-param (car gp-0) #f)) (command-get-param (car (cdr gp-0)) #f) 0.0 0))
           ((= v1-4 'setting-unset) (remove-setting! (the-as symbol (command-get-param (car gp-0) #f))))
           ;; og:preserve-this PAL patch here
           ((= v1-4 'sfx-volume)
            (set-setting! 'sfx-volume (command-get-param (car gp-0) #f) (command-get-float (car (cdr gp-0)) 0.0) 0))
           ((= v1-4 'blackout)
            (set-blackout-frames (the-as time-frame (the int (* 5.0000005 (the float (command-get-int (car gp-0) 0)))))))
           ((= v1-4 'teleport) (set! *teleport* #t))
           ((= v1-4 'joint)
            (send-event (ppointer->process (-> *setting-control* current movie)) 'joint (command-get-param (car gp-0) #f))
            (set! *teleport-count* 2))
           ((= v1-4 'ambient)
            (ambient-hint-spawn (the-as string (command-get-param (car (cdr gp-0)) #f))
                                (the-as vector #f)
                                *entity-pool*
                                (the-as symbol (command-get-param (car gp-0) #f))))
           ((= v1-4 'send-event)
            (let ((target-process (command-list-get-process (car gp-0)))
                  (message (command-get-quoted-param (car (cdr gp-0)) #f))
                  (params (cdr (cdr gp-0))))
              (when (and target-process (not (null? message)))
                (let ((event
                        (new 'stack-no-clear 'event-message-block)))
                  (set! (-> event from) pp)
                  (let ((param-list params)) (set! (-> event num-params) ((method-of-type (rtype-of param-list) length) param-list)))
                  (set! (-> event message) (the-as symbol message))
                  (set! (-> event param 0) (the-as uint (command-get-quoted-param (car params) #f)))
                  (set! (-> event param 1) (the-as uint (command-get-quoted-param (car (cdr params)) #f)))
                  (set! (-> event param 2) (the-as uint (command-get-quoted-param (car (cdr (cdr params))) #f)))
                  (send-event-function target-process event)))))))))
    0
    (none)))

;; The cheap reject tests only the current XZ position. Crossing checks therefore rely on the
;; camera and player advancing by less than a boundary's rejection radius in one update.
(defun check-boundary ((boundary load-boundary))
  "Reject distant movement using boundary's cached circle, test the
   camera or player segment according to its flags, select the forward/backward command, and apply
   load, display, visibility, forced-visibility, or checkpoint state changes."
  (local-vars (crossing int))
  (let ((current-pos (if (logtest? (-> boundary flags) (load-boundary-flags player)) (-> *load-boundary-target* 1) (-> *load-boundary-target* 0)))
        (previous-pos (if (logtest? (-> boundary flags) (load-boundary-flags player)) (-> *load-boundary-target* 3) (-> *load-boundary-target* 2))))
    0
    (let ((dx (- (-> current-pos x) (-> boundary rejector x)))
          (dz (- (-> current-pos z) (-> boundary rejector z))))
      (cond
        ((< (+ (square dx) (square dz)) (* (-> boundary rejector w) (-> boundary rejector w)))
         (if (logtest? (-> boundary flags) (load-boundary-flags closed))
           (set! crossing (the-as int (check-closed-boundary boundary current-pos previous-pos)))
           (set! crossing (the-as int (check-open-boundary boundary current-pos previous-pos)))))
        (else (set! crossing 0) (goto cfg-28)))))
  (let ((command (the-as load-boundary-crossing-command #f)))
    (if (= (the-as load-boundary-crossing-result crossing) (load-boundary-crossing-result forward))
      (set! command (-> boundary cmd-fwd)))
    (if (= (the-as load-boundary-crossing-result crossing) (load-boundary-crossing-result backward))
      (set! command (-> boundary cmd-bwd)))
    (when command
      (cond
        ((= (-> command cmd) (load-boundary-cmd vis)) (load-state-want-vis (the-as symbol (-> command lev0))))
        ((= (-> command cmd) (load-boundary-cmd load))
         (load-state-want-levels (the-as symbol (-> command lev0)) (the-as symbol (-> command lev1))))
        ((= (-> command cmd) (load-boundary-cmd display))
         (load-state-want-display-level (the-as symbol (-> command lev0)) (the-as symbol (-> command lev1))))
        ((= (-> command cmd) (load-boundary-cmd force-vis))
         (load-state-want-force-vis (the-as symbol (-> command lev0)) (the-as symbol (-> command lev1))))
        ((= (-> command cmd) (load-boundary-cmd checkpt))
         (format 0 "Setting continue to ~A~%" (-> command lev0))
         (set-continue! *game-info* (-> command lev0))))))
  (label cfg-28)
  (none))

(define-perm *load-state* load-state (new 'global 'load-state))

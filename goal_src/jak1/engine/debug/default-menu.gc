(defun dm-task-get-money ((id int) (msg debug-menu-msg))
  "Give the player the money one task rewards, and report whether they already hold that much."
  (if (= msg (debug-menu-msg press)) (send-event *target* 'get-pickup (pickup-type money) (-> *GAME-bank* money-task-inc)))
  (>= (the-as float (send-event *target* 'query 'pickup (pickup-type money))) (-> *GAME-bank* money-task-inc)))

(defun dm-give-all-cells ((id int) (msg debug-menu-msg))
  "Give the player every fuel cell and close the need-resolution stage of all 100 tasks. Reports
   whether they are all closed already."
  (when (= msg (debug-menu-msg press))
    (dotimes (i 100)
      (send-event *target* 'get-pickup (pickup-type fuel-cell) (the float (+ i 2)))
      (close-specific-task! (the-as game-task (+ i 2)) (task-status need-resolution))))
  (dotimes (i 100)
    (if (not (task-closed? (the-as game-task (+ i 2)) (task-status need-resolution))) (return #f)))
  #t)

(defun dm-give-cell ((task game-task))
  "Give the player the fuel cell for task and close its need-resolution stage."
  (send-event *target* 'get-pickup (pickup-type fuel-cell) (the float task))
  (close-specific-task! task (task-status need-resolution))
  (none))

(defun dm-levitator-ready ((id int) (msg debug-menu-msg))
  "Set up the state the village2 levitator task expects: close its introduction and first reminder,
   and hand out every cell up to sunken-sharks. Reports whether the task is waiting on its reward
   speech."
  (when (= msg (debug-menu-msg press))
    (close-specific-task! (game-task village2-levitator) (task-status need-introduction))
    (close-specific-task! (game-task village2-levitator) (task-status need-reminder-a))
    (dm-give-cell (game-task jungle-eggtop))

;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/camera/cam-update.gc")
(require "engine/game/task/task-control.gc")
(require "engine/draw/drawable.gc")
(require "engine/math/euler.gc")
(require "engine/entity/entity.gc")
(require "engine/debug/memory-usage.gc")
(require "engine/debug/menu.gc")

;; This file is the content of the debug menu: the tree of pages and items, and the callbacks that
;; read and write the setting behind each item. engine/debug/menu.gc owns the types, the rendering
;; and the pad handling; nothing here draws.
;;
;; Two trees are built when the file loads. *debug-menu-context* is the full menu reached from the
;; pause screen, *popup-menu-context* is the short list reached by holding L3 while paused.
;; menu-respond-to-pause activates one of them and *menu-hook* runs both once per frame.
;;
;; Declaring a page
;; ----------------
;; A page is a debug-menu. Items are appended with debug-menu-append-item and the page is reached
;; from its parent through a debug-menu-item-submenu. Most pages are written as a static template
;; and expanded by debug-menu-make-from-template:
;;
;;   (menu "Stats"
;;         (flag      "Poly" *stats-poly* dm-boolean-toggle-pick-func)
;;         (function  "List Sounds" #f ,(lambda () (list-sounds)))
;;         (float-var "Subdiv Close" close dm-subdiv-float 10 1 #t 1 200 1)
;;         (menu "Ambient Marks" ...))
;;
;; Every entry is (kind label id callback . extra). The label is what the menu draws, the id is
;; handed to the callback unchanged, and the callback is either a function or a symbol whose value
;; is one. A page that is too large or too dynamic for a template is built by hand instead - the
;; camera, shader, instance and task pages - and build-shader-list, build-instance-list and
;; build-continue-menu fill pages whose contents are only known at run time.
;;
;; Numbers inside a template are boxed, so every value the template reader consumes arrives
;; multiplied by 8 and is divided by 8 on the way out. The item id is not divided: a callback that
;; wants the number the template author wrote has to divide by 8 itself, and the hand-built pages
;; therefore pass ids already multiplied by 8 when they share such a callback. vu1-renderer-mask is
;; defined in that shifted form on purpose - its first bit is 3 - so the render page can pass mask
;; values straight through.
;;
;; The callback contract
;; ---------------------
;; flag item, (function object debug-menu-msg object)
;;   Called with the item id and a message. press means the user selected the item, so toggle or
;;   apply the setting; update and activate mean the menu is refreshing, so only read. The result
;;   is stored in is-on and picks the item colour: #f off, #t on, and any other value - the task
;;   pages return 'invalid - draws the item as unavailable. Flag items refresh every 23 frames.
;;
;; function item, (function object object)
;;   Called with the item id on press only. The result is not stored; a true value flashes the item
;;   blue and a false value flashes it red, so a callback that returns none picks a colour from
;;   whatever was left in the result register.
;;
;; variable item, (function int debug-menu-msg X X X)
;;   Called with the item id, a message, a proposed value, and the value the item is showing. On
;;   press write the proposed value and return what was actually taken; on update ignore the
;;   proposal and return the live value. When the setting it edits does not exist the callback
;;   returns its fourth argument, which leaves the display alone. Integer and float items keep
;;   their value in the same field, so a callback has to match the kind the item was set up with.

;; Forward declarations for stuff we haven't written yet:
(define-extern *edit-instance* string)

;; Necessary forward declarations

;; DECOMP BEGINS

;; this file is debug only
(declare-file (debug))

(define *debug-menu-context* (new 'debug 'debug-menu-context))

(define *dm-cam-mode-interpolation* 0)

(defun dm-cam-mode-func ((mode (state camera-slave)) (msg debug-menu-msg))
  "Camera mode flag. On press, ask *camera* to enter the slave state mode, interpolating over
   *dm-cam-mode-interpolation* frames. Reports whether that state is running. mode #f is the Off
   entry: it changes nothing and reports true while no slave state is active."
  (if (and (= msg (debug-menu-msg press)) mode) (send-event *camera* 'change-state mode *dm-cam-mode-interpolation*))
  (if *camera* (send-event *camera* 'query-state mode) (not mode)))

(defun dm-cam-settings-func ((option int) (msg debug-menu-msg))
  "Camera option flags. option indexes the Camera/Settings page and selects one cam-slave-options
   bit, one of two camera-master option bits, or the free-camera reset. On press the selected bit
   is toggled; the result reports it. master-options bit 0 stops the camera from following
   regions and bit 2 restricts region changes to when the target is on the ground. option 6 is
   the Reset Free entry, which is a function item and so arrives here without a message."
  (when (and (= msg (debug-menu-msg press)) *camera*)
    (cond
      ((zero? option) (send-event *camera* 'toggle-slave-option (cam-slave-options BUTT_CAM)))
      ((= option 13) (send-event *camera* 'toggle-slave-option (cam-slave-options BLOCK_SHIFT_BUTTONS)))
      ((= option 1) (send-event *camera* 'toggle-slave-option (cam-slave-options SAME_SIDE)))
      ((= option 2) (send-event *camera* 'toggle-slave-option (cam-slave-options MOVE_SPHERICAL)))
      ((= option 3) (send-event *camera* 'toggle-slave-option (cam-slave-options DRAG)))
      ((= option 4) (send-event *camera* 'toggle-slave-option (cam-slave-options ALLOW_Z_ROT)))
      ((= option 7) (send-event *camera* 'toggle-slave-option (cam-slave-options JUMP_PITCHES)))
      ((= option 8) (send-event *camera* 'toggle-slave-option (cam-slave-options FIND_HIDDEN_TARGET)))
      ((= option 6) (send-event *camera* 'reset-root))
      ((= option 9) (logxor! (-> *camera* master-options) 1))
      ((= option 10) (logxor! (-> *camera* master-options) 4))
      ((= option 11) (send-event *camera* 'toggle-slave-option (cam-slave-options COLLIDE)))
      ((= option 12) (send-event *camera* 'toggle-slave-option (cam-slave-options LINE_OF_SIGHT)))
      ((= option 14) (send-event *camera* 'toggle-slave-option (cam-slave-options NO_ROTATE)))
      ((= option 15) (send-event *camera* 'toggle-slave-option (cam-slave-options STICKY_ANGLE)))))
  (cond
    (*camera*
     (cond
       ((zero? option) (logtest? (-> *camera* slave-options) (cam-slave-options BUTT_CAM)))
       ((= option 13) (logtest? (-> *camera* slave-options) (cam-slave-options BLOCK_SHIFT_BUTTONS)))
       ((= option 1) (logtest? (-> *camera* slave-options) (cam-slave-options SAME_SIDE)))
       ((= option 2) (logtest? (-> *camera* slave-options) (cam-slave-options MOVE_SPHERICAL)))
       ((= option 3) (logtest? (-> *camera* slave-options) (cam-slave-options DRAG)))
       ((= option 4) (logtest? (-> *camera* slave-options) (cam-slave-options ALLOW_Z_ROT)))
       ((= option 7) (logtest? (-> *camera* slave-options) (cam-slave-options JUMP_PITCHES)))
       ((= option 8) (logtest? (-> *camera* slave-options) (cam-slave-options FIND_HIDDEN_TARGET)))
       ((= option 11) (logtest? (-> *camera* slave-options) (cam-slave-options COLLIDE)))
       ((= option 12) (logtest? (-> *camera* slave-options) (cam-slave-options LINE_OF_SIGHT)))
       ((= option 14) (logtest? (-> *camera* slave-options) (cam-slave-options NO_ROTATE)))
       ((= option 15) (logtest? (cam-slave-options STICKY_ANGLE) (-> *camera* slave-options)))
       ((= option 9) (logtest? (-> *camera* master-options) 1))
       ((= option 10) (logtest? (-> *camera* master-options) 4))
       (else #f)))
    (else #f)))

(defun dm-cam-settings-func-int ((id int) (msg debug-menu-msg) (value int) (fallback int))
  "Interp Frms variable. Sets the number of frames the debug menu asks the camera to interpolate
   over when changing mode. Only id 40 belongs to this item; anything else returns fallback."
  (when (and (= msg (debug-menu-msg press)) *camera*)
    (if (= (/ id 8) 5) (set! *dm-cam-mode-interpolation* value)))
  (cond
    (*camera* (if (= (/ id 8) 5) *dm-cam-mode-interpolation* fallback))
    (else fallback)))

(defun dm-cam-externalize ((mode symbol) (msg debug-menu-msg))
  "External camera control. reset re-seats the external camera at the current view unless it is
   locked, allow-z toggles the z-rotation option, and any other value selects that external mode,
   deselecting it if it was already current. Reports whether mode is selected."
  (when (= msg (debug-menu-msg press))
    (cond
      ((= mode 'reset) (if (!= *external-cam-mode* 'locked) (external-cam-reset!)))
      ((= mode 'allow-z) (set! *external-cam-options* (logxor *external-cam-options* (external-cam-option allow-z))))
      ((= *external-cam-mode* mode) (set! *external-cam-mode* #f))
      (else (if (not *external-cam-mode*) (external-cam-reset!)) (set! *external-cam-mode* mode))))
  (if (= mode 'allow-z) (logtest? *external-cam-options* (external-cam-option allow-z)) (= *external-cam-mode* mode)))

(defun dm-cam-render-float ((id int) (msg debug-menu-msg) (value float) (fallback float))
  "Field of view in degrees. id 0 writes *math-camera* and rebuilds its projection; id 8 asks
   *camera* to change fov. Returns the live fov in degrees, or fallback when the object it edits
   is missing."
  (when (= msg (debug-menu-msg press))
    (cond
      ((zero? (/ id 8))
       (when *math-camera*
         (set! (-> *math-camera* fov) (* 182.04445 value))
         (update-math-camera *math-camera* (-> *setting-control* current video-mode) (-> *setting-control* current aspect-ratio))))
      ((= (/ id 8) 1) (if *camera* (send-event *camera* 'set-fov (* 182.04445 value))))))
  (cond
    ((zero? (/ id 8))
     (cond
       (*math-camera* (* 0.005493164 (-> *math-camera* fov)))
       (else (empty) fallback)))
    ((= (/ id 8) 1)
     (cond
       (*camera* (let ((units-to-degrees 0.005493164)) (* units-to-degrees (the-as float (send-event *camera* 'query-fov)))))
       (else (empty) fallback)))
    (else (empty) fallback)))

(defun dm-subdiv-float ((setting symbol) (msg debug-menu-msg) (value float) (fallback float))
  "Subdivision distance in meters. setting picks close or far, and the value goes into profile 3 of
   *subdivide-settings*, which is the profile the artist menu overrides. Returns fallback when the
   camera or settings are not loaded."
  (when (= msg (debug-menu-msg press))
    (case setting
      (('close) (if (and *math-camera* *subdivide-settings*) (set! (-> *subdivide-settings* close 3) (meters value))))
      (('far) (if (and *math-camera* *subdivide-settings*) (set! (-> *subdivide-settings* far 3) (meters value))))))
  (case setting
    (('close) (if (and *math-camera* *subdivide-settings*) (/ (-> *subdivide-settings* close 3) METER_LENGTH) fallback))
    (('far) (if (and *math-camera* *subdivide-settings*) (/ (-> *subdivide-settings* far 3) METER_LENGTH) fallback))
    (else fallback)))

(defun dm-subdiv-int ((setting symbol) (msg debug-menu-msg) (value int) (fallback int))
  "Anim Tester playback speed. setting is anim-speed; writes and reads the speed of the running
   tester, or returns fallback when no tester is running."
  (when (= msg (debug-menu-msg press))
    (case setting
      (('anim-speed) (if *anim-tester* (set! (-> *anim-tester* 0 speed) value)))))
  (case setting
    (('anim-speed) (if *anim-tester* (-> *anim-tester* 0 speed) fallback))
    (else fallback)))

(defun dm-setting-language ((id int) (msg debug-menu-msg))
  "Language flag. Writes the default language setting from id / 8 and reports whether it is the
   current one."
  (if (= msg (debug-menu-msg press)) (set! (-> *setting-control* default language) (the-as language-enum (/ id 8))))
  (= (-> *setting-control* default language) (/ id 8)))

(defun dm-current-continue ((continue-name string) (msg debug-menu-msg))
  "Continue point flag. On press, restart the player at the named continue point. Reports whether
   it is the continue point the game would resume from."
  (if (= msg (debug-menu-msg press)) (start 'play (get-continue-by-name *game-info* continue-name)))
  (string= (-> (get-or-create-continue! *game-info*) name) continue-name))

(defun dm-subdiv-draw-func ((id int) (msg debug-menu-msg))
  "Terrain subdivision draw mode flag: 0 textured, 1 outline, 2 gouraud, 3 hack, from id / 8."
  (if (= msg (debug-menu-msg press)) (set! *subdivide-draw-mode* (/ id 8)))
  (= (/ id 8) *subdivide-draw-mode*))

(defun dm-ocean-subdiv-draw-func ((id int) (msg debug-menu-msg))
  "Ocean subdivision draw mode flag: 0 textured, 1 outline, 2 gouraud, from id / 8."
  (if (= msg (debug-menu-msg press)) (set! *ocean-subdivide-draw-mode* (/ id 8)))
  (= (/ id 8) *ocean-subdivide-draw-mode*))

(defun dm-time-of-day-func ((id int) (msg debug-menu-msg))
  "Time of day flag. Modes 0 through 7 freeze the clock at a fixed hour; mode 8 starts it running
   at the normal or fast rate. Reports whether id / 8 is the current mode."
  (when (= msg (debug-menu-msg press))
    (set! *time-of-day-mode* (/ id 8))
    (set! (-> *time-of-day-proc* 0 minute) 0)
    (cond
      ((zero? (/ id 8)) (set! (-> *time-of-day-proc* 0 time-ratio) 0.0) (set! (-> *time-of-day-proc* 0 hour) 7))
      ((= (/ id 8) 1) (set! (-> *time-of-day-proc* 0 time-ratio) 0.0) (set! (-> *time-of-day-proc* 0 hour) 9))
      ((= (/ id 8) 2) (set! (-> *time-of-day-proc* 0 time-ratio) 0.0) (set! (-> *time-of-day-proc* 0 hour) 12))
      ((= (/ id 8) 3) (set! (-> *time-of-day-proc* 0 time-ratio) 0.0) (set! (-> *time-of-day-proc* 0 hour) 15))
      ((= (/ id 8) 4) (set! (-> *time-of-day-proc* 0 time-ratio) 0.0) (set! (-> *time-of-day-proc* 0 hour) 18))
      ((= (/ id 8) 5) (set! (-> *time-of-day-proc* 0 time-ratio) 0.0) (set! (-> *time-of-day-proc* 0 hour) 19))
      ((= (/ id 8) 6) (set! (-> *time-of-day-proc* 0 time-ratio) 0.0) (set! (-> *time-of-day-proc* 0 hour) 23))
      ((= (/ id 8) 7) (set! (-> *time-of-day-proc* 0 time-ratio) 0.0) (set! (-> *time-of-day-proc* 0 hour) 4))
      ((= (/ id 8) 8)
       (if *time-of-day-fast* (set! (-> *time-of-day-proc* 0 time-ratio) 18000.0) (set! (-> *time-of-day-proc* 0 time-ratio) 300.0)))))
  (= (/ id 8) *time-of-day-mode*))

(defun dm-time-of-day-func2 ((setting (pointer symbol)) (msg debug-menu-msg))
  "Fast clock flag. Toggles the boolean held by setting, then re-applies the normal or fast time
   ratio if the clock is already running."
  (when (= msg (debug-menu-msg press))
    (set! (-> setting 0) (not (-> setting 0)))
    (when (!= (-> *time-of-day-proc* 0 time-ratio) 0.0)
      (if *time-of-day-fast* (set! (-> *time-of-day-proc* 0 time-ratio) 18000.0) (set! (-> *time-of-day-proc* 0 time-ratio) 300.0))))
  (-> setting 0))

(defun dm-boolean-toggle-pick-func ((setting (pointer symbol)) (msg debug-menu-msg))
  "The flag callback behind most items in this file: toggle the boolean held by the symbol setting
   on press, and report its value."
  (if (= msg (debug-menu-msg press)) (set! (-> setting 0) (not (-> setting 0))))
  (-> setting 0))

(defun dm-time-of-day-pick-func ((id symbol) (msg debug-menu-msg))
  "Time of day flag that starts or stops the clock through time-of-day-setup. It returns nothing,
   so the item's displayed state is whatever the call left in the result register."
  (time-of-day-setup (= msg (debug-menu-msg press)))
  (none))

(defun dm-actor-marks-pick-func ((mode symbol) (msg debug-menu-msg))
  "*display-actor-marks* selector: #f, #t, full or process."
  (if (= msg (debug-menu-msg press)) (set! *display-actor-marks* mode))
  (= *display-actor-marks* mode))

(defun dm-compact-actor-pick-func ((mode symbol) (msg debug-menu-msg))
  "*compact-actors* selector: #f, #t or debug."
  (if (= msg (debug-menu-msg press)) (set! *compact-actors* mode))
  (= *compact-actors* mode))

(defun dm-actor-vis-pick-func ((mode symbol) (msg debug-menu-msg))
  "*display-actor-vis* selector: #f, box, sphere or #t."
  (if (= msg (debug-menu-msg press)) (set! *display-actor-vis* mode))
  (= *display-actor-vis* mode))

(defun dm-game-mode-pick-func ((mode symbol) (msg debug-menu-msg))
  "Game mode selector: play or debug."
  (if (= msg (debug-menu-msg press)) (set! (-> *game-info* mode) mode))
  (= (-> *game-info* mode) mode))

(defun dm-vu1-user-toggle-pick-func ((mask vu1-renderer-mask) (msg debug-menu-msg))
  "Toggle one renderer in *vu1-enable-user-menu*. vu1-renderer-mask starts at bit 3 so that the
   boxed template values pass through unshifted."
  (if (= msg (debug-menu-msg press)) (set! *vu1-enable-user-menu* (logxor *vu1-enable-user-menu* (the-as uint mask))))
  (logtest? *vu1-enable-user-menu* mask))

(defun dm-vu1-user-set-pick-func ((mask vu1-renderer-mask) (msg debug-menu-msg))
  "Replace *vu1-enable-user-menu* outright, for the all on and all off entries. all off keeps the
   two unread high bits set."
  (if (= msg (debug-menu-msg press)) (set! *vu1-enable-user-menu* mask))
  (= *vu1-enable-user-menu* mask))

(defun dm-texture-user-toggle-pick-func ((mask int) (msg debug-menu-msg))
  "Toggle one texture category in *texture-enable-user-menu*. The Render page passes boxed values
   that are never divided by 8, so every entry reaches the bit three positions above the one its
   label names."
  (if (= msg (debug-menu-msg press)) (set! *texture-enable-user-menu* (logxor *texture-enable-user-menu* mask)))
  (logtest? *texture-enable-user-menu* mask))

(defun dm-texture-user-set-pick-func ((mask int) (msg debug-menu-msg))
  "Replace *texture-enable-user-menu* outright, for the all textures on and off entries. Shifted
   the same way as dm-texture-user-toggle-pick-func, so all textures on leaves the tfrag, pris and
   shrub bits clear."
  (if (= msg (debug-menu-msg press)) (set! *texture-enable-user-menu* mask))
  (= *texture-enable-user-menu* mask))

(defun dm-strip-lines-toggle-pick-func ((id int) (msg debug-menu-msg))
  "Toggle one *display-strip-lines* edge category, id / 8."
  (if (= msg (debug-menu-msg press)) (set! *display-strip-lines* (logxor *display-strip-lines* (/ id 8))))
  (logtest? *display-strip-lines* (/ id 8)))

(defun dm-strip-lines-set-pick-func ((id int) (msg debug-menu-msg))
  "Set *display-strip-lines* to a whole preset, id / 8."
  (if (= msg (debug-menu-msg press)) (set! *display-strip-lines* (/ id 8)))
  (= *display-strip-lines* (/ id 8)))

(defun dm-edit-instance-toggle-pick-func ((mask int) (msg debug-menu-msg))
  "Toggle prototype flag bits on the instance named by *edit-instance*. Reports #f when no instance
   is selected or the name is not loaded."
  (let ((proto (find-instance-by-name *edit-instance*)))
    (when proto
      (if (= msg (debug-menu-msg press)) (logxor! (-> proto flags) (the-as uint mask)))
      (logtest? (-> proto flags) mask))))


(defun debug-menu-make-instance-menu ((context debug-menu-context))
  "Build the Instance page and return the item that opens it."
  (let* ((menu (new 'debug 'debug-menu context "Instance menu"))
         (instance-item (new 'debug 'debug-menu-item-submenu "Instance" menu)))
    (let ((shrub-menu (new 'debug 'debug-menu context "Instance shrub menu")))
      (set! *instance-shrub-menu* shrub-menu)
      (let ((item (new 'debug 'debug-menu-item-submenu "Pick Shrub" shrub-menu))) (debug-menu-append-item menu item)))
    (let ((tie-menu (new 'debug 'debug-menu context "Instance tie menu")))
      (set! *instance-tie-menu* tie-menu)
      (let ((item (new 'debug 'debug-menu-item-submenu "Pick Tie" tie-menu))) (debug-menu-append-item menu item)))
    (let ((item (new 'debug 'debug-menu-item-function "Refresh" #f build-instance-list))) (debug-menu-append-item menu item))
    (let ((near-item (new 'debug 'debug-menu-item-var "near" (the-as int '*edit-instance*) 80)))
      (debug-menu-item-var-make-float near-item
                                      (the-as (function int debug-menu-msg float float float)
                                              (lambda ((id debug-menu) (msg debug-menu-msg) (value float) (fallback float))
                                                (let ((proto (find-instance-by-name (-> id name))))
                                                  (cond
                                                    (proto
                                                     (when (= msg (debug-menu-msg press))
                                                       (set! (-> proto dists x) (meters value))
                                                       (prototype-bucket-recalc-fields proto))
                                                     (/ (-> proto dists x) METER_LENGTH))
                                                    (else (empty) fallback)))))
                                      (the-as float 1.0)
                                      #t
                                      (the-as float 10.0)
                                      (the-as float 250.0)
                                      1)
      (debug-menu-append-item menu near-item))
    (let ((far-item (new 'debug 'debug-menu-item-var "far" (the-as int '*edit-instance*) 80)))
      (debug-menu-item-var-make-float far-item
                                      (the-as (function int debug-menu-msg float float float)
                                              (lambda ((id debug-menu) (msg debug-menu-msg) (value float) (fallback float))
                                                (let ((proto (find-instance-by-name (-> id name))))
                                                  (cond
                                                    (proto
                                                     (when (= msg (debug-menu-msg press))
                                                       (set! (-> proto dists w) (meters value))
                                                       (prototype-bucket-recalc-fields proto))
                                                     (/ (-> proto dists w) METER_LENGTH))
                                                    (else (empty) fallback)))))
                                      (the-as float 1.0)
                                      #t
                                      (the-as float 10.0)
                                      (the-as float 250.0)
                                      1)
      (debug-menu-append-item menu far-item))
    (let ((item (new 'debug 'debug-menu-item-flag "invisible" 1 dm-edit-instance-toggle-pick-func)))
      (debug-menu-append-item menu item))
    (let ((enable-menu (new 'debug 'debug-menu context "Enable Instance Tie Menu")))
      (set! *enable-instance-tie-menu* enable-menu)
      (let ((item (new 'debug 'debug-menu-item-submenu "Enable Tie" enable-menu))) (debug-menu-append-item menu item)))
    (let ((item (new 'debug 'debug-menu-item-flag "Instance Info" '*display-instance-info* dm-boolean-toggle-pick-func)))
      (debug-menu-append-item menu item))
    instance-item))

;; One flag callback per task stage. All seven take the task from id / 8, report 'invalid for a
;; task that has no such stage, and close the stage on press.
(defun dm-task-unknown ((id int) (msg debug-menu-msg))
  "Close the unknown stage of the task id / 8. Returns 'invalid when the task has no such stage,
   which draws the entry as unavailable."
  (let ((task (/ id 8)))
    (if (not (task-exists? (the-as game-task task) (task-status unknown))) (return 'invalid))
    (if (= msg (debug-menu-msg press)) (close-specific-task! (the-as game-task task) (task-status unknown)))
    (task-closed? (the-as game-task task) (task-status unknown))))

(defun dm-task-hint ((id int) (msg debug-menu-msg))
  "Close the need-hint stage of the task id / 8, or return 'invalid when it has none."
  (let ((task (/ id 8)))
    (if (not (task-exists? (the-as game-task task) (task-status need-hint))) (return 'invalid))
    (if (= msg (debug-menu-msg press)) (close-specific-task! (the-as game-task task) (task-status need-hint)))
    (task-closed? (the-as game-task task) (task-status need-hint))))

(defun dm-task-introduction ((id int) (msg debug-menu-msg))
  "Close the need-introduction stage of the task id / 8, or return 'invalid when it has none."
  (let ((task (/ id 8)))
    (if (not (task-exists? (the-as game-task task) (task-status need-introduction))) (return 'invalid))
    (if (= msg (debug-menu-msg press)) (close-specific-task! (the-as game-task task) (task-status need-introduction)))
    (task-closed? (the-as game-task task) (task-status need-introduction))))

(defun dm-task-reminder-a ((id int) (msg debug-menu-msg))
  "Close the need-reminder-a stage of the task id / 8, or return 'invalid when it has none."
  (let ((task (/ id 8)))
    (if (not (task-exists? (the-as game-task task) (task-status need-reminder-a))) (return 'invalid))
    (if (= msg (debug-menu-msg press)) (close-specific-task! (the-as game-task task) (task-status need-reminder-a)))
    (task-closed? (the-as game-task task) (task-status need-reminder-a))))

(defun dm-task-reminder ((id int) (msg debug-menu-msg))
  "Close the need-reminder stage of the task id / 8, or return 'invalid when it has none."
  (let ((task (/ id 8)))
    (if (not (task-exists? (the-as game-task task) (task-status need-reminder))) (return 'invalid))
    (if (= msg (debug-menu-msg press)) (close-specific-task! (the-as game-task task) (task-status need-reminder)))
    (task-closed? (the-as game-task task) (task-status need-reminder))))

(defun dm-task-reward-speech ((id int) (msg debug-menu-msg))
  "Close the need-reward-speech stage of the task id / 8, or return 'invalid when it has none."
  (let ((task (/ id 8)))
    (if (not (task-exists? (the-as game-task task) (task-status need-reward-speech))) (return 'invalid))
    (if (= msg (debug-menu-msg press)) (close-specific-task! (the-as game-task task) (task-status need-reward-speech)))
    (task-closed? (the-as game-task task) (task-status need-reward-speech))))

(defun dm-task-resolution ((id int) (msg debug-menu-msg))
  "Give the player the fuel cell for the task id / 8 and close its need-resolution stage, or return
   'invalid when it has none."
  (let ((task (/ id 8)))
    (if (not (task-exists? (the-as game-task task) (task-status need-resolution))) (return 'invalid))
    (when (= msg (debug-menu-msg press))
      (send-event *target* 'get-pickup (pickup-type fuel-cell) (the float task))
      (close-specific-task! (the-as game-task task) (task-status need-resolution)))
    (task-closed? (the-as game-task task) (task-status need-resolution))))

;; One page per task stage, each listing every task that has that stage. The task numbers in these
;; templates have to be written out: a static list holds boxed numbers, not compile-time constants,
;; so the game-task names survive only as the item labels.

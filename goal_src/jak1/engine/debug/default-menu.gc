(defun debug-menu-node<? ((left debug-menu-node) (right debug-menu-node))
  "Order two menu nodes by name, for sorting a page's item list."
  (string<=? (-> left name) (-> right name)))

(defun dm-shader-pick-func ((tex-id texture-id) (msg debug-menu-msg))
  "Select tex-id as *edit-shader* if its page is loaded and the texture has a shader link. Reports
   whether it is the current selection."
  (if (and (= msg (debug-menu-msg press))
           *texture-page-dir*
           (-> *texture-page-dir* entries (-> tex-id page) page)
           (-> *texture-page-dir* entries (-> tex-id page) link)
           (nonzero? (-> *texture-page-dir* entries (-> tex-id page) link next (-> tex-id index))))
    (set! *edit-shader* tex-id))
  (and (nonzero? *edit-shader*) (= tex-id *edit-shader*)))

(define *shader-pick-menu* (the-as debug-menu #f))

(defun build-shader-list ()
  "Rebuild the Pick Shader page with one entry per loaded texture that has a shader link, sorted by
   name. Each entry's id packs the texture index and page index into a texture-id."
  (debug-menu-remove-all-items *shader-pick-menu*)
  (when *texture-page-dir*
    (dotimes (page-index (-> *texture-page-dir* length))
      (let ((page (-> *texture-page-dir* entries page-index page))
            (page-link (-> *texture-page-dir* entries page-index link)))
        (when (and page page-link)
          (dotimes (tex-index (-> page length))
            (when (and (-> page data tex-index) (nonzero? (-> page-link next tex-index)))
              (let ((item (new 'debug
                               'debug-menu-item-flag
                               (-> page data tex-index name)
                               (logior (shr (shl tex-index 52) 44) (shr (shl page-index 52) 32))
                               dm-shader-pick-func)))
                (debug-menu-append-item *shader-pick-menu* item))))))))
  (set! (-> *shader-pick-menu* items) (sort (-> *shader-pick-menu* items) debug-menu-node<?))
  (none))

(defun dm-instance-pick-func ((name string) (msg debug-menu-msg))
  "Select the named instance prototype as *edit-instance*, clearing the selection when no loaded
   level has that prototype."
  (when (= msg (debug-menu-msg press))
    (if (find-instance-by-name name) (set! *edit-instance* name) (set! *edit-instance* #f)))
  (and *edit-instance* (string= name *edit-instance*)))

(defun dm-enable-instance-func ((name string) (msg debug-menu-msg))
  "Visibility flag for one tie prototype. Toggles its invisible bit and reports the bit inverted,
   so the item reads as enabled when the prototype draws."
  (let ((proto (find-instance-by-name name)))
    (cond
      (proto (if (= msg (debug-menu-msg press)) (logxor! (-> proto flags) 1)) (not (logtest? (-> proto flags) 1)))
      (else #f))))

(define *instance-shrub-menu* (the-as debug-menu #f))

(define *instance-tie-menu* (the-as debug-menu #f))

(define *enable-instance-tie-menu* (the-as debug-menu #f))

(defun build-instance-list ((id object))
  "Rebuild the shrub and tie prototype pages from the prototypes of every active level, sorted by
   name. Clears *display-instance-info* because the previous selection no longer applies."
  (debug-menu-remove-all-items *instance-shrub-menu*)
  (debug-menu-remove-all-items *instance-tie-menu*)
  (debug-menu-remove-all-items *enable-instance-tie-menu*)
  (set! *display-instance-info* #f)
  (dotimes (level-index (-> *level* length))
    (let ((active-level (-> *level* level level-index)))
      (when (= (-> active-level status) 'active)
        (let ((trees (-> active-level bsp drawable-trees)))
          (dotimes (tree-index (-> trees length))
            (let ((tree (-> trees trees tree-index)))
              (case (-> tree type)
                ((drawable-tree-instance-shrub)
                 (let ((shrub-protos (-> (the-as drawable-tree-instance-shrub tree) info prototype-inline-array-shrub)))
                   (dotimes (shrub-index (-> shrub-protos length))
                     ;; og:preserve-this
                     (let ((item (new 'debug
                                      'debug-menu-item-flag
                                      (-> shrub-protos data shrub-index name)
                                      (-> shrub-protos data shrub-index name)
                                      dm-instance-pick-func)))
                       (debug-menu-append-item *instance-shrub-menu* item)))))
                ((drawable-tree-instance-tie)
                 (let ((tie-protos (-> (the-as drawable-tree-instance-tie tree) prototypes prototype-array-tie)))
                   (dotimes (tie-index (-> tie-protos length))
                     (let ((pick-item (new 'debug
                                           'debug-menu-item-flag
                                           (-> tie-protos array-data tie-index name)
                                           (-> tie-protos array-data tie-index name)
                                           dm-instance-pick-func)))
                       (debug-menu-append-item *instance-tie-menu* pick-item))
                     (let ((enable-item (new 'debug
                                             'debug-menu-item-flag
                                             (-> tie-protos array-data tie-index name)
                                             (-> tie-protos array-data tie-index name)
                                             dm-enable-instance-func)))
                       (set! (-> enable-item is-on) #t)
                       (debug-menu-append-item *enable-instance-tie-menu* enable-item))))))))))))
  (set! (-> *instance-shrub-menu* items)
        (sort (-> *instance-shrub-menu* items)
              (lambda ((left debug-menu) (right debug-menu))
                (string<=? (-> left name) (-> right name)))))
  (set! (-> *instance-tie-menu* items)
        (sort (-> *instance-tie-menu* items)
              (lambda ((left debug-menu) (right debug-menu))
                (string<=? (-> left name) (-> right name)))))
  (set! (-> *enable-instance-tie-menu* items)
        (sort (-> *enable-instance-tie-menu* items)
              (lambda ((left debug-menu) (right debug-menu))
                (string<=? (-> left name) (-> right name)))))
  0
  (none))

(defun debug-create-cam-restore ()
  "Print a cam-restore function to the listener that reproduces the current camera position,
   orientation, fov and level, together with the profile times, tfrag memory total and polygon
   statistics needed to compare a later frame against this one."
  (cond
    (*math-camera*
     (format #t "(defun-debug cam-restore ()~%")
     (format #t " ;;this function is a hack, don't use it as an example~%")
     (format #t " (let ((pos (new 'stack 'vector))~%")
     (format #t "       (rot (new 'stack 'matrix)))~%")
     (format #t "  (set! (-> pos x) ~12F)~%" (-> *math-camera* trans x))
     (format #t "  (set! (-> pos y) ~12F)~%" (-> *math-camera* trans y))
     (format #t "  (set! (-> pos z) ~12F)~%" (-> *math-camera* trans z))
     (format #t "  (set! (-> pos w) 1.0)~%")
     (format #t "  (set! (-> rot data  0) ~12F)~%" (-> *math-camera* inv-camera-rot vector 0 x))
     (format #t "  (set! (-> rot data  1) ~12F)~%" (-> *math-camera* inv-camera-rot vector 0 y))
     (format #t "  (set! (-> rot data  2) ~12F)~%" (-> *math-camera* inv-camera-rot vector 0 z))
     (format #t "  (set! (-> rot data  3) ~12F)~%" (-> *math-camera* inv-camera-rot vector 0 w))
     (format #t "  (set! (-> rot data  4) ~12F)~%" (-> *math-camera* inv-camera-rot vector 1 x))
     (format #t "  (set! (-> rot data  5) ~12F)~%" (-> *math-camera* inv-camera-rot vector 1 y))
     (format #t "  (set! (-> rot data  6) ~12F)~%" (-> *math-camera* inv-camera-rot vector 1 z))
     (format #t "  (set! (-> rot data  7) ~12F)~%" (-> *math-camera* inv-camera-rot vector 1 w))
     (format #t "  (set! (-> rot data  8) ~12F)~%" (-> *math-camera* inv-camera-rot vector 2 x))
     (format #t "  (set! (-> rot data  9) ~12F)~%" (-> *math-camera* inv-camera-rot vector 2 y))
     (format #t "  (set! (-> rot data 10) ~12F)~%" (-> *math-camera* inv-camera-rot vector 2 z))
     (format #t "  (set! (-> rot data 11) ~12F)~%" (-> *math-camera* inv-camera-rot vector 2 w))
     (format #t "  (set! (-> rot data 12) ~12F)~%" 0.0)
     (format #t "  (set! (-> rot data 13) ~12F)~%" 0.0)
     (format #t "  (set! (-> rot data 14) ~12F)~%" 0.0)
     (format #t "  (set! (-> rot data 15) ~12F)~%" 1.0)
     (let ((angles (new 'stack-no-clear 'euler-angles)))
       (matrix->eul angles (-> *math-camera* inv-camera-rot) 21)
       (format #t "  ;; euler angles (xyz order degrees) x ~R y ~R z ~R~%" (-> angles x) (-> angles y) (-> angles z))
       (format #t
               "  ;; MAYA euler angles (xyz order degrees) x ~R y ~R z ~R~%"
               (-> angles x)
               (- 32768.0 (-> angles y))
               (-> angles z)))
     (format #t "  (debug-set-camera-pos-rot! pos rot)~%")
     (format #t "  (send-event *camera* 'set-fov (deg ~f))~%" (* 0.005493164 (-> *math-camera* fov)))
     (format #t "  (clear *camera-old-level*)~%")
     (format #t "  (format *camera-old-level* \"~A\")~%" (-> *level* level0 name))
     (let ((format-fn format)
           (format-dest #t)
           (format-string "  (set! *camera-old-cpu* ~D)~%")
           (cpu-bar (-> *display* frames (-> *display* last-screen) frame profile-bar 0)))
       (format-fn format-dest format-string (-> cpu-bar data (+ (-> cpu-bar profile-frame-count) -2) time-stamp)))
     (let ((format-fn format)
           (format-dest #t)
           (format-string "  (set! *camera-old-vu*  ~D)~%")
           (vu-bar (-> *display* frames (-> *display* last-screen) frame profile-bar 1)))
       (format-fn format-dest format-string (-> vu-bar data (+ (-> vu-bar profile-frame-count) -2) time-stamp)))
     (compute-memory-usage (-> *level* level0) #f)
     (format #t
             "   (set! *camera-old-tfrag-bytes* ~D)~%"
             (+ (-> *level* level0 mem-usage-block data 1 total)
                (-> *level* level0 mem-usage-block data 2 total)
                (-> *level* level0 mem-usage-block data 3 total)
                (-> *level* level0 mem-usage-block data 4 total)
                (-> *level* level0 mem-usage-block data 5 total)
                (-> *level* level0 mem-usage-block data 6 total)
                (-> *level* level0 mem-usage-block data 7 total)
                (-> *level* level0 mem-usage-block data 8 total)))
     (format #t "   (clear *camera-old-stat-string-tfrag*)~%")
     (format #t "   (clear *camera-old-stat-string-tfrag-near*)~%")
     (format #t "   (clear *camera-old-stat-string-total*)~%")
     (when *stats-poly*
       (format #t "   (format *camera-old-stat-string-tfrag*      \"~S\")~%" *stat-string-tfrag*)
       (format #t "   (format *camera-old-stat-string-tfrag-near* \"~S\")~%" *stat-string-tfrag-near*)
       (format #t "   (format *camera-old-stat-string-total*      \"~S\")~%" *stat-string-total*))
     (format #t "   (set! *display-camera-old-stats* #t)~%")
     (format #t "  )~%")
     (format #t " )~%"))
    (else (format #t "camera save failed~%")))
  (none))

(defun debug-menu-make-camera-mode-menu ((menu debug-menu) (mode-menu debug-menu))
  "Fill mode-menu with one entry per camera slave state and attach it to menu."
  ;; the result of this one is thrown away; all it does is reparent menu, and a menu's parent is
  ;; never read.
  (new 'debug 'debug-menu-item-submenu "Camera" menu)
  (let ((item (new 'debug 'debug-menu-item-submenu "Mode" mode-menu))) (debug-menu-append-item menu item))
  (let ((item (new 'debug 'debug-menu-item-flag "Off" #f dm-cam-mode-func))) (debug-menu-append-item mode-menu item))
  (let ((item (new 'debug 'debug-menu-item-flag "Free-floating" cam-free-floating dm-cam-mode-func)))
    (debug-menu-append-item mode-menu item))
  (let ((item (new 'debug 'debug-menu-item-flag "Fixed" cam-fixed dm-cam-mode-func)))
    (debug-menu-append-item mode-menu item))
  (let ((item (new 'debug 'debug-menu-item-flag "Pov" cam-pov dm-cam-mode-func))) (debug-menu-append-item mode-menu item))
  (let ((item (new 'debug 'debug-menu-item-flag "Pov180" cam-pov180 dm-cam-mode-func)))
    (debug-menu-append-item mode-menu item))
  (let ((item (new 'debug 'debug-menu-item-flag "Billy" cam-billy dm-cam-mode-func)))
    (debug-menu-append-item mode-menu item))
  (let ((item (new 'debug 'debug-menu-item-flag "Pov-track" cam-pov-track dm-cam-mode-func)))
    (debug-menu-append-item mode-menu item))
  (let ((item (new 'debug 'debug-menu-item-flag "Decel" cam-decel dm-cam-mode-func)))
    (debug-menu-append-item mode-menu item))
  (let ((item (new 'debug 'debug-menu-item-flag "Endless fall" cam-endlessfall dm-cam-mode-func)))
    (debug-menu-append-item mode-menu item))
  (let ((item (new 'debug 'debug-menu-item-flag "Eye" cam-eye dm-cam-mode-func))) (debug-menu-append-item mode-menu item))
  (let ((item (new 'debug 'debug-menu-item-flag "Stick" cam-stick dm-cam-mode-func)))
    (debug-menu-append-item mode-menu item))
  (let ((item (new 'debug 'debug-menu-item-flag "String" cam-string dm-cam-mode-func)))
    (debug-menu-append-item mode-menu item))
  (let ((item (new 'debug 'debug-menu-item-flag "Standoff" cam-standoff dm-cam-mode-func)))
    (debug-menu-append-item mode-menu item))
  (let ((item (new 'debug 'debug-menu-item-flag "Circular" cam-circular dm-cam-mode-func)))
    (debug-menu-append-item mode-menu item))
  (let ((item (new 'debug 'debug-menu-item-flag "Look At" cam-lookat dm-cam-mode-func)))
    (debug-menu-append-item mode-menu item))
  (let ((item (new 'debug 'debug-menu-item-flag "Center of world" cam-point-watch dm-cam-mode-func)))
    (debug-menu-append-item mode-menu item))
  (let ((item (new 'debug 'debug-menu-item-flag "Spline" cam-spline dm-cam-mode-func)))
    (debug-menu-append-item mode-menu item))
  (let ((item (new 'debug 'debug-menu-item-flag "Bike" cam-bike dm-cam-mode-func))) (debug-menu-append-item mode-menu item))
  (let ((item (new 'debug 'debug-menu-item-flag "Robotboss" cam-robotboss dm-cam-mode-func)))
    (debug-menu-append-item mode-menu item))
  (let ((item (new 'debug 'debug-menu-item-function "Reset Free" 6 (the-as (function object object) dm-cam-settings-func))))
    (debug-menu-append-item mode-menu item))
  (none))

(defun debug-menu-make-camera-menu ((context debug-menu-context))
  "Build the Camera page and return the item that opens it."
  (let* ((menu (new 'debug 'debug-menu context "Camera menu"))
         (camera-item (new 'debug 'debug-menu-item-submenu "Camera" menu)))
    (let ((mode-menu (new 'debug 'debug-menu context "Camera mode menu"))) (debug-menu-make-camera-mode-menu menu mode-menu))
    (let ((external-menu (new 'debug 'debug-menu context "Camera externalize menu")))
      (let ((item (new 'debug 'debug-menu-item-submenu "External" external-menu))) (debug-menu-append-item menu item))
      (let ((item (new 'debug 'debug-menu-item-flag "CPad 0" 'pad-0 dm-cam-externalize)))
        (debug-menu-append-item external-menu item))
      (let ((item (new 'debug 'debug-menu-item-flag "CPad 1" 'pad-1 dm-cam-externalize)))
        (debug-menu-append-item external-menu item))
      (let ((item (new 'debug 'debug-menu-item-flag "Lock" 'locked dm-cam-externalize)))
        (debug-menu-append-item external-menu item))
      (let ((item (new 'debug 'debug-menu-item-flag "Reset" 'reset dm-cam-externalize)))
        (debug-menu-append-item external-menu item))
      (let ((item (new 'debug 'debug-menu-item-flag "Allow z rot" 'allow-z dm-cam-externalize)))
        (debug-menu-append-item external-menu item))
      (let ((fov-item (new 'debug 'debug-menu-item-var "Fov" 0 80)))
        (debug-menu-item-var-make-float fov-item
                                        dm-cam-render-float
                                        (the-as float 1.0)
                                        #t
                                        (the-as float 15.0)
                                        (the-as float 180.0)
                                        1)
        (debug-menu-append-item external-menu fov-item)))
    (let ((collision-menu (new 'debug 'debug-menu context "Camera collision menu")))
      (let ((item (new 'debug 'debug-menu-item-submenu "Collision" collision-menu))) (debug-menu-append-item menu item))
      (let ((item (new 'debug 'debug-menu-item-flag "Record" '*record-cam-collide-history* dm-boolean-toggle-pick-func)))
        (debug-menu-append-item collision-menu item))
      (let ((item (new 'debug 'debug-menu-item-flag "Display" '*display-cam-collide-history* dm-boolean-toggle-pick-func)))
        (debug-menu-append-item collision-menu item)))
    (let ((settings-menu (new 'debug 'debug-menu context "Camera settings menu")))
      (let ((item (new 'debug 'debug-menu-item-submenu "Settings" settings-menu))) (debug-menu-append-item menu item))
      (let ((item (new 'debug 'debug-menu-item-flag "Butt cam" 0 dm-cam-settings-func)))
        (debug-menu-append-item settings-menu item))
      (let ((item (new 'debug 'debug-menu-item-flag "Block shift buttons" 13 dm-cam-settings-func)))
        (debug-menu-append-item settings-menu item))
      (let ((item (new 'debug 'debug-menu-item-flag "Same side" 1 dm-cam-settings-func)))
        (debug-menu-append-item settings-menu item))
      (let ((item (new 'debug 'debug-menu-item-flag "Move spherical" 2 dm-cam-settings-func)))
        (debug-menu-append-item settings-menu item))
      (let ((item (new 'debug 'debug-menu-item-flag "Drag" 3 dm-cam-settings-func)))
        (debug-menu-append-item settings-menu item))
      (let ((item (new 'debug 'debug-menu-item-flag "Allow Z rot" 4 dm-cam-settings-func)))
        (debug-menu-append-item settings-menu item))
      (let ((item (new 'debug 'debug-menu-item-flag "Pitch for jump" 7 dm-cam-settings-func)))
        (debug-menu-append-item settings-menu item))
      (let ((item (new 'debug 'debug-menu-item-flag "Find hidden target" 8 dm-cam-settings-func)))
        (debug-menu-append-item settings-menu item))
      (let ((item (new 'debug 'debug-menu-item-flag "Move along camera Z" '*cam-free-move-along-z* dm-boolean-toggle-pick-func)))
        (debug-menu-append-item settings-menu item))
      (let ((item (new 'debug 'debug-menu-item-flag "Ignore regions" 9 dm-cam-settings-func)))
        (debug-menu-append-item settings-menu item))
      (let ((item (new 'debug 'debug-menu-item-flag "Switch only on ground" 10 dm-cam-settings-func)))
        (debug-menu-append-item settings-menu item))
      (let ((item (new 'debug 'debug-menu-item-flag "Collide" 11 dm-cam-settings-func)))
        (debug-menu-append-item settings-menu item))
      (let ((item (new 'debug 'debug-menu-item-flag "Line of Sight" 12 dm-cam-settings-func)))
        (debug-menu-append-item settings-menu item))
      (let ((item (new 'debug 'debug-menu-item-flag "No Rotate" 14 dm-cam-settings-func)))
        (debug-menu-append-item settings-menu item))
      (let ((item (new 'debug 'debug-menu-item-flag "Sticky Angle" 15 dm-cam-settings-func)))
        (debug-menu-append-item settings-menu item))
      (let ((interp-item (new 'debug 'debug-menu-item-var "Interp Frms" 40 80)))
        (debug-menu-item-var-make-int interp-item dm-cam-settings-func-int 1 #f 0 0 #f)
        (debug-menu-append-item settings-menu interp-item))
      (let ((fov-item (new 'debug 'debug-menu-item-var "Fov" 8 80)))
        (debug-menu-item-var-make-float fov-item
                                        dm-cam-render-float
                                        (the-as float 1.0)
                                        #t
                                        (the-as float 15.0)
                                        (the-as float 180.0)
                                        1)
        (debug-menu-append-item settings-menu fov-item))
      (let ((item (new 'debug 'debug-menu-item-flag "no mip/lod correction" '*camera-no-mip-correction* dm-boolean-toggle-pick-func)))
        (debug-menu-append-item settings-menu item))
      (let ((item (new 'debug 'debug-menu-item-flag "last attacker" '*display-camera-last-attacker* dm-boolean-toggle-pick-func)))
        (debug-menu-append-item settings-menu item))
      (let ((item (new 'debug 'debug-menu-item-flag "old stats" '*display-camera-old-stats* dm-boolean-toggle-pick-func)))
        (debug-menu-append-item settings-menu item))
      (let ((item (new 'debug 'debug-menu-item-flag "xyz axes" '*display-xyz-axes* dm-boolean-toggle-pick-func)))
        (debug-menu-append-item settings-menu item))
      (let ((item (new 'debug 'debug-menu-item-flag "Master Marks" '*display-cam-master-marks* dm-boolean-toggle-pick-func)))
        (debug-menu-append-item settings-menu item))
      (let ((item (new 'debug 'debug-menu-item-flag "Other Marks" '*display-cam-other* dm-boolean-toggle-pick-func)))
        (debug-menu-append-item settings-menu item))
      (let ((item (new 'debug 'debug-menu-item-flag "los debug" '*display-cam-los-debug* dm-boolean-toggle-pick-func)))
        (debug-menu-append-item settings-menu item))
      (let ((item (new 'debug 'debug-menu-item-flag "los info" '*display-cam-los-info* dm-boolean-toggle-pick-func)))
        (debug-menu-append-item settings-menu item))
      (let ((item (new 'debug 'debug-menu-item-flag "los Marks" '*display-cam-los-marks* dm-boolean-toggle-pick-func)))
        (debug-menu-append-item settings-menu item))
      (let ((item (new 'debug 'debug-menu-item-flag "coll Marks" '*display-cam-coll-marks* dm-boolean-toggle-pick-func)))
        (debug-menu-append-item settings-menu item))
      (let ((item (new 'debug 'debug-menu-item-flag "Camera Marks" '*display-camera-marks* dm-boolean-toggle-pick-func)))
        (debug-menu-append-item settings-menu item)))
    (let ((item (new 'debug
                     'debug-menu-item-flag
                     "Edit"
                     '*cam-layout*
                     (lambda ((setting symbol) (msg debug-menu-msg))
                       (when (= msg (debug-menu-msg press))
                         (if (-> setting value) (cam-layout-stop) (cam-layout-start)))
                       (-> setting value)))))
      (debug-menu-append-item menu item))
    (let ((item (new 'debug 'debug-menu-item-function "Save Pos" #f (the-as (function object object) debug-create-cam-restore))))
      (debug-menu-append-item menu item))
    camera-item))

(defun debug-menu-make-shader-menu ((context debug-menu-context))
  "Build the Shader page and return the item that opens it. Every variable item on the page edits
   the adgif shaders of the texture in *edit-shader*, so the page does nothing until one is
   picked from Pick Shader."
  (let* ((menu (new 'debug 'debug-menu context "Shader menu"))
         (shader-item (new 'debug 'debug-menu-item-submenu "Shader" menu)))
    (let ((pick-menu (new 'debug 'debug-menu context "Shader pick menu")))
      (set! *shader-pick-menu* pick-menu)
      (let ((item (new 'debug 'debug-menu-item-submenu "Pick Shader" pick-menu))) (debug-menu-append-item menu item)))
    (let ((item (new 'debug 'debug-menu-item-function "Refresh" #f (the-as (function object object) build-shader-list))))
      (debug-menu-append-item menu item))
    (let ((tweak-item (new 'debug 'debug-menu-item-var "tweak" (the-as int '*edit-shader*) 80)))
      (debug-menu-item-var-make-float tweak-item
                                      (the-as (function int debug-menu-msg float float float)
                                              (lambda ((id symbol) (msg debug-menu-msg) (value float) (fallback float))
                                                (set! fallback
                                                      (cond
                                                        (*texture-page-dir*
                                                         (let* ((tex-id (the-as texture-id (-> id value)))
                                                                (tex (lookup-texture-by-id (the-as texture-id tex-id)))
                                                                (page-link (-> *texture-page-dir* entries (-> tex-id page) link)))
                                                           (cond
                                                             ((and tex page-link)
                                                              (when (= msg (debug-menu-msg press))
                                                                (set! (-> tex uv-dist) value)
                                                                (let ((shader-cursor (the-as object (* (-> page-link next (-> tex-id index) shader) 16))))
                                                                  (while (nonzero? (the-as uint shader-cursor))
                                                                    (adgif-shader-update! (the-as adgif-shader shader-cursor) tex)
                                                                    (set! shader-cursor (* (-> (the-as adgif-shader shader-cursor) next shader) 16)))))
                                                              (-> tex uv-dist))
                                                             (else (empty) fallback))))
                                                        (else (empty) fallback)))
                                                (none)))
                                      (the-as float 0.1)
                                      #t
                                      (the-as float 0.1)
                                      (the-as float 30.0)
                                      1)
      (debug-menu-append-item menu tweak-item))
    (let ((item (new 'debug
                     'debug-menu-item-function
                     "all tweak+"
                     #f
                     (lambda ((id object))
                       (all-texture-tweak-adjust *texture-page-dir* (the-as float 0.1))))))
      (debug-menu-append-item menu item))
    (let ((item (new 'debug
                     'debug-menu-item-function
                     "all tweak-"
                     #f
                     (lambda ((id object))
                       (all-texture-tweak-adjust *texture-page-dir* (the-as float -0.1))))))
      (debug-menu-append-item menu item))
    ;; The rest of the page edits one field of the adgif shader registers of the picked texture.
    ;; Each item walks the page's shader link list for that texture, writes the field into every
    ;; shader on it, and displays the value read back from the first one.
    (let ((item (new 'debug 'debug-menu-item-var "l" (the-as int '*edit-shader*) 80)))
      (debug-menu-item-var-make-int item
                                    (the-as (function int debug-menu-msg int int int)
                                            (lambda ((id symbol) (msg debug-menu-msg) (value int) (fallback basic))
                                              (cond
                                                (*texture-page-dir*
                                                 (let* ((tex-id (the-as texture-id (-> id value)))
                                                        (page-link (-> *texture-page-dir* entries (-> tex-id page) link)))
                                                   (cond
                                                     (page-link
                                                      (when (= msg (debug-menu-msg press))
                                                        (let ((shader-cursor (the-as object (* (-> page-link next (-> tex-id index) shader) 16))))
                                                          (while (nonzero? (the-as uint shader-cursor))
                                                            (set! (-> (the-as adgif-shader shader-cursor) tex1 l) value)
                                                            (set! shader-cursor (* (-> (the-as adgif-shader shader-cursor) next shader) 16)))))
                                                      (let ((first-shader (the-as object (* (-> page-link next (-> tex-id index) shader) 16))))
                                                        (if (nonzero? (the-as uint first-shader)) (-> (the-as adgif-shader first-shader) tex1 l) fallback)))
                                                     (else fallback))))
                                                (else fallback))))
                                    1
                                    #t
                                    0
                                    3
                                    #f)
      (debug-menu-append-item menu item))
    (let ((item (new 'debug 'debug-menu-item-var "k" (the-as int '*edit-shader*) 80)))
      (debug-menu-item-var-make-int item
                                    (the-as (function int debug-menu-msg int int int)
                                            (lambda ((id symbol) (msg debug-menu-msg) (value int) (fallback basic))
                                              (cond
                                                (*texture-page-dir*
                                                 (let* ((tex-id (the-as texture-id (-> id value)))
                                                        (page-link (-> *texture-page-dir* entries (-> tex-id page) link)))
                                                   (cond
                                                     (page-link
                                                      (when (= msg (debug-menu-msg press))
                                                        (let ((shader-cursor (the-as object (* (-> page-link next (-> tex-id index) shader) 16))))
                                                          (while (nonzero? (the-as uint shader-cursor))
                                                            (set! (-> (the-as adgif-shader shader-cursor) tex1 k) value)
                                                            (set! shader-cursor (* (-> (the-as adgif-shader shader-cursor) next shader) 16)))))
                                                      (let ((first-shader (the-as object (* (-> page-link next (-> tex-id index) shader) 16))))
                                                        (if (nonzero? (the-as uint first-shader)) (-> (the-as adgif-shader first-shader) tex1 k) fallback)))
                                                     (else fallback))))
                                                (else fallback))))
                                    1
                                    #t
                                    -2048

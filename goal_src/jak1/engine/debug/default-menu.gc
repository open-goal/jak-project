(defun debug-menu-make-task-menu ((context debug-menu-context))
  "Build the Task page and return the item that opens it."
  (let* ((menu (new 'debug 'debug-menu context "Task menu"))
         (task-item (new 'debug 'debug-menu-item-submenu "Task" menu)))
    (debug-menu-append-item menu (new 'debug 'debug-menu-item-flag "enough money" #f dm-task-get-money))
    (debug-menu-append-item menu (new 'debug 'debug-menu-item-flag "levitator ready" #f dm-levitator-ready))
    (debug-menu-append-item menu (new 'debug 'debug-menu-item-flag "lavabike ready" #f dm-lavabike-ready))
    (debug-menu-append-item menu (new 'debug 'debug-menu-item-flag "all cells" #f dm-give-all-cells))
    (debug-menu-make-task-unknown-menu menu context)
    (debug-menu-make-task-need-hint-menu menu context)
    (debug-menu-make-task-need-introduction-menu menu context)
    (debug-menu-make-task-need-reminder-a-menu menu context)
    (debug-menu-make-task-need-reminder-menu menu context)
    (debug-menu-make-task-need-reward-speech-menu menu context)
    (debug-menu-make-task-need-resolution-menu menu context)
    task-item))

(defun dm-anim-tester-flag-func ((id symbol) (msg debug-menu-msg))
  "Anim Tester flags. Toggles apply-align or show-joint-info on the running tester and reports the
   bit, or reports #f when no tester is running."
  (when *anim-tester*
    (case id
      (('at-apply-align)
       (if (= msg (debug-menu-msg press)) (logxor! (-> *anim-tester* 0 flags) (anim-tester-flags at-apply-align)))
       (return (logtest? (-> *anim-tester* 0 flags) (anim-tester-flags at-apply-align))))
      (('at-show-joint-info)
       (if (= msg (debug-menu-msg press)) (logxor! (-> *anim-tester* 0 flags) (anim-tester-flags at-show-joint-info)))
       (return (logtest? (-> *anim-tester* 0 flags) (anim-tester-flags at-show-joint-info))))))
  #f)

(defun dm-anim-tester-func ((id symbol) (msg debug-menu-msg))
  "Anim Tester commands. Starts the tester if it is not running, then forwards a pick or save
   request to it, or points the camera at it. The pick commands hide the debug menu so the tester
   can use the pad."
  (if (not *anim-tester*) (anim-tester-start))
  (when *anim-tester*
    (cond
      ((= id 'at-pick-object)
       (send-event (ppointer->process *anim-tester*) 'pick-object)
       (set! (-> *debug-menu-context* is-hidden) #t))
      ((= id 'at-pick-joint-anim)
       (send-event (ppointer->process *anim-tester*) 'pick-joint-anim)
       (set! (-> *debug-menu-context* is-hidden) #t))
      ((= id 'at-pick-sequence)
       (send-event (ppointer->process *anim-tester*) 'pick-sequence)
       (set! (-> *debug-menu-context* is-hidden) #t))
      ((= id 'at-save-sequences) (send-event (ppointer->process *anim-tester*) 'save-sequences))
      ((= id 'at-cam-stick) (set! *camera-orbit-target* *anim-tester*) (send-event *camera* 'change-state cam-orbit 0))
      ((= id 'at-cam-free-floating) (send-event *camera* 'change-state cam-free-floating 0))))
  (none))

(defun build-continue-menu ((menu debug-menu) (info game-info))
  "Fill menu with one entry per continue point of every level in *level-load-list*. info is unused."
  (let ((levels *level-load-list*))
    (while (not (null? levels))
      (let ((continues (-> (the-as level-load-info (-> (the-as symbol (car levels)) value)) continues)))
        (while (not (null? continues))
          (let* ((continue-info (the-as continue-point (car continues)))
                 (item (new 'debug 'debug-menu-item-flag (-> continue-info name) (-> continue-info name) dm-current-continue)))
            (debug-menu-append-item menu item))
          (set! continues (cdr continues))))
      (set! levels (cdr levels))))
  menu)

(defun debug-menu-context-make-default-menus ((context debug-menu-context))
  "Build the whole debug menu into context and install it as the root menu."
  (let ((menu (new 'debug 'debug-menu context "Main menu")))
    (debug-menu-context-set-root-menu context menu)
    (debug-menu-append-item menu
                            (debug-menu-make-from-template context

;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/gfx/hw/display-h.gc")
(require "engine/draw/drawable-tree-h.gc")
(require "engine/draw/drawable-inline-array-h.gc")
(declare-type entity-ambient basic)

(define-extern vector-for-ambient (function process-drawable vector vector))

;; DECOMP BEGINS

;; Ambient entities are spatial triggers for background sounds, hints, points of
;; interest, lighting, weather, and similar level effects.

;; Each ambient has a lightweight drawable containing only the entity reference.
;; The scene hierarchy uses these wrappers to collect the ambients overlapping a
;; query sphere; they are not submitted to the renderer.
(deftype drawable-ambient (drawable)
  ((ambient entity-ambient :offset 8))
  (:methods
   (execute-ambient (_type_ vector) none)))

;; a drawable-tree of all the ambients in a level.
(deftype drawable-tree-ambient (drawable-tree) ())

(deftype drawable-inline-array-ambient (drawable-inline-array)
  ((data drawable-ambient 1 :inline)
   (pad  uint32)))

(defmethod draw ((this drawable-tree-ambient) (tree drawable-tree-ambient) (frame display-frame))
  "Do nothing; ambient drawables are spatial triggers, not rendered geometry."
  0
  (none))

(defmethod unpack-vis ((this drawable-tree-ambient) (destination (pointer int8)) (source (pointer int8)))
  "Leave the visibility stream unchanged because ambient trees do not consume VIS data."
  source)

;; A level hint serializes the mutually exclusive hint presentation. Depending
;; on mode it displays localized text, plays Daxter sidekick audio, plays a
;; voicebox line, or runs an ambient/stinger sound at trans. The timing fields
;; track active and interrupted time, while voicebox owns the current speaker.
(deftype level-hint (process)
  ((text-id-to-display text-id)
   (sound-to-play      string)
   (trans              vector)
   (sound-id           sound-id)
   (mode               symbol)
   (total-time         time-frame)
   (total-off-time     time-frame)
   (last-time          time-frame)
   (voicebox           handle))
  (:methods
   (print-text (_type_) none)
   (appeared-for-long-enough? (_type_) symbol))
  (:states (level-hint-ambient-sound string)
   (level-hint-error string string)
   level-hint-exit
   level-hint-normal
   (level-hint-sidekick string)))

;; Fixed-capacity result buffer filled by collect-ambients. Items are references
;; to drawable-ambient wrappers; num-items records the occupied prefix.
(deftype ambient-list (structure)
  ((num-items int32)
   (items     drawable-ambient 2048)))

;; Process pointer for the single active level hint, or #f when none owns the
;; display/audio hint channel.
(define-extern *hint-semaphore* (pointer level-hint))

;; Start a spatial sound hint if the hint channel is free.
(define-extern ambient-hint-spawn (function string vector process-tree symbol object))

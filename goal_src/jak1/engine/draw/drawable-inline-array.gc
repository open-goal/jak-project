;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/gfx/hw/display-h.gc")
(require "engine/draw/drawable-inline-array-h.gc")

;; - All these methods are stubs

;; DECOMP BEGINS

(defmethod length ((this drawable-inline-array))
  "Return the active number of inline elements."
  (-> this length))

(defmethod login ((this drawable-inline-array))
  "Base inline arrays have no linked resources to initialize."
  this)

(defmethod draw ((this drawable-inline-array) (draw-data drawable-inline-array) (frame display-frame))
  "Base inline arrays submit no draw work; concrete array types override this method."
  0
  (none))

(defmethod collect-stats ((this drawable-inline-array))
  "Base inline arrays contribute no renderer statistics."
  0
  (none))

(defmethod debug-draw ((this drawable-inline-array) (draw-data drawable) (frame display-frame))
  "Base inline arrays submit no debug geometry."
  0
  (none))

;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/level/bsp.gc")
(require "engine/draw/draw-node-h.gc")

;; A drawable tree is the bounding-volume hierarchy for one renderer. A level usually has about ten
;; trees, including separate trees for terrain fragments, actors, and TIE instances. Each tree keeps
;; one inline array per hierarchy depth; the final array holds the renderer's leaf drawables.

;; DECOMP BEGINS

(defmethod draw ((this drawable-tree-array) (draw-data drawable-tree-array) (frame display-frame))
  "Submit each tree with its corresponding tree in draw-data for frame, unless the current
   level is hidden or uses the special or special-vis rendering path."
  (let ((level-index (-> (scratchpad-object terrain-context) bsp lev-index)))
    (case (-> *level* level level-index display?)
      (('special 'special-vis #f))
      (else (dotimes (i (-> this length)) (draw (-> this trees i) (-> draw-data trees i) frame)))))
  0
  (none))

(defmethod collect-stats ((this drawable-tree-array))
  "Collect renderer statistics from every drawable tree."
  (dotimes (i (-> this length))
    (collect-stats (-> this trees i)))
  0
  (none))

(defmethod debug-draw ((this drawable-tree-array) (draw-data drawable) (frame display-frame))
  "Submit debug geometry for every tree together with its corresponding draw-data tree."
  (dotimes (i (-> this length))
    (debug-draw (-> this trees i) (-> (the-as drawable-tree-array draw-data) trees i) frame))
  0
  (none))

;; VIS data is sparse by hierarchy depth. The stream begins with the top-level masks. At each later
;; depth it contains one byte of child bits for every visible parent and no byte for a hidden
;; parent. Node ids select byte positions in the shared expanded destination bitset.
(defmethod unpack-vis ((this drawable-tree) (destination (pointer int8)) (source (pointer int8)))
  "Expand this tree's sparse hierarchical VIS stream into destination. Copy the top masks
   directly, then consume one child-mask byte only for each visible parent at every lower depth.
   Return the source position after the final consumed byte."
  (local-vars (next-vis-byte int))
  (let* ((top-array (the-as drawable-inline-array-node (-> this data 0)))
         (top-byte-offset (/ (-> top-array data 0 id) 8))
         (top-node-count (-> top-array length))
         (destination-byte (&+ destination top-byte-offset))
         (top-byte-count (/ (+ top-node-count 7) 8)))
    (dotimes (i top-byte-count)
      (let ((vis-byte (-> source 0))) (set! source (&-> source 1)) (set! (-> destination-byte 0) vis-byte))
      (set! destination-byte (&-> destination-byte 1))))
  ;; Every entry in data except the leaf array supplies the visibility of the next depth.
  (let ((node-depth-count (+ (-> this length) -1)))
    (when (nonzero? node-depth-count)
      (dotimes (depth node-depth-count)
        (let* ((parent-array (-> this data depth))
               (child-array (-> this data (+ depth 1)))
               (parent-byte-offset (/ (-> (the-as drawable-inline-array-node parent-array) data 0 id) 8))
               (child-byte-offset (/ (-> (the-as drawable-inline-array-node child-array) data 0 id) 8))
               (parent-count (-> (the-as drawable-inline-array-node parent-array) length))
               (parent-vis (&+ destination parent-byte-offset))
               (child-vis (&+ destination child-byte-offset)))
          (while #t
            (let ((parent-mask-byte (-> parent-vis 0)))
              (set! parent-vis (&-> parent-vis 1))
              (let ((parent-bit 128))
                (label cfg-7)
                ;; The delay-slot load is safe for a hidden parent because source advances only
                ;; when its bit is set.
                (b! (zero? (logand parent-mask-byte parent-bit)) cfg-9 :delay (set! next-vis-byte (-> source 0)))
                (set! source (&-> source 1))
                (set! (-> child-vis 0) next-vis-byte)
                (label cfg-9)
                (+! parent-count -1)
                (b! (zero? parent-count) cfg-12 :delay (.sra parent-bit parent-bit 1))
                ;; The child slot advances for every parent, including the eighth bit.
                (b! (nonzero? parent-bit) cfg-7 :delay (set! child-vis (&-> child-vis 1)))))))
        (label cfg-12)
        (nop!)
        0)))
  source)

;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/draw/drawable.gc")

;; DECOMP BEGINS

(defmethod new drawable-group ((allocation symbol) (type-to-make type) (length int))
  "Allocate a variable-sized drawable group with room for length child references."
  (let ((result (object-new allocation type-to-make (the-as int (+ (-> type-to-make size) (* (+ length -1) 4))))))
    (set! (-> result length) length)
    result))

(defmethod inspect ((this drawable-group))
  (format #t "[~8x] ~A~%" this (-> this type))
  (format #t "~Tid: ~D~%" (-> this id))
  (format #t "~Tlength: ~D~%" (-> this length))
  (format #t "~Tdata[~D]: @ #x~X~%" (-> this length) (-> this data))
  (dotimes (i (-> this length))
    (format #t "~T  [~D] ~A~%" i (-> this data i)))
  this)

(defmethod print ((this drawable-group))
  (format #t "#<~A @ #x~X [~D]" (-> this type) this (-> this length))
  (dotimes (i (-> this length))
    (format #t " ~A" (-> this data i)))
  (format #t ">")
  this)

(defmethod length ((this drawable-group))
  "Return the number of child drawable references in this group."
  (-> this length))

(defmethod asize-of ((this drawable-group))
  "Return the allocation size of this variable-length drawable group."
  (the-as int (+ (-> drawable-group size) (* (+ (-> this length) -1) 4))))

(defmethod mem-usage ((this drawable-group) (usage memory-usage-block) (flags mem-usage-flags))
  "Record this group's allocation in usage, then recursively collect memory use from every
   child. flags is forwarded unchanged to each child."
  (mem-usage-add! usage drawable-group 1 (asize-of this))
  (dotimes (i (-> this length))
    (mem-usage (-> this data i) usage flags))
  this)

(defmethod login ((this drawable-group))
  "Initialize every child drawable after this group has been loaded."
  (dotimes (i (-> this length))
    (login (-> this data i)))
  this)

(defmethod draw ((this drawable-group) (draw-data drawable-group) (frame display-frame))
  "When this group passes visibility and frustum culling, submit each child together with the
   corresponding child in draw-data for frame."
  (when (vis-cull (-> this id))
    (when (sphere-cull (-> this bsphere))
      (dotimes (i (-> this length))
        (draw (-> this data i) (-> draw-data data i) frame))))
  0
  (none))

(defmethod collect-stats ((this drawable-group))
  "When this group passes visibility and frustum culling, collect renderer statistics from
   every child."
  (when (vis-cull (-> this id))
    (when (sphere-cull (-> this bsphere))
      (dotimes (i (-> this length))
        (collect-stats (-> this data i)))))
  0
  (none))

(defmethod debug-draw ((this drawable-group) (draw-data drawable) (frame display-frame))
  "When this group passes visibility and frustum culling, submit debug geometry for each child
   and its corresponding draw-data child."
  (when (vis-cull (-> this id))
    (when (sphere-cull (-> this bsphere))
      (dotimes (i (-> this length))
        (debug-draw (-> this data i) (-> (the-as drawable-group draw-data) data i) frame))))
  0
  (none))

(defmethod unpack-vis ((this drawable-group) (destination (pointer int8)) (source (pointer int8)))
  "Pass destination and the advancing visibility source through every child, then return the
   source position after the final child."
  (dotimes (i (-> this length))
    (set! source (unpack-vis (-> this data i) destination source)))
  source)

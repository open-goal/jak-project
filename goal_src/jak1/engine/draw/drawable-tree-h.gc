;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/draw/drawable-group-h.gc")

;; DECOMP BEGINS

;; Top-level grouping for one drawable category in a level BSP. Concrete trees
;; specialize this for TFRAG, TIE, shrub, actor, ambient, and collision data.
;; The inherited group storage holds references to that category's roots.
(deftype drawable-tree (drawable-group) ())

;; All category trees for one level. Trees overlays the inherited data array
;; with the more specific element type; typical levels contain roughly 5-15.
(deftype drawable-tree-array (drawable-group)
  ((trees drawable-tree 1 :overlay-at (-> data 0))))

;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/draw/drawable-h.gc")

;; Base class for reference-based drawable containers. A group is itself a
;; drawable, though it normally has no visibility ID. The trailing data array
;; contains child references; the declared first element is the start of
;; variable-sized storage allocated by the constructor.
;;
;; Groups are intended for high-level organization rather than fine-grained
;; traversal because each child access follows a reference. Subtypes may
;; specialize any drawable operation, so calling draw on a group does not by
;; itself guarantee that draw is dispatched to every child.

;; decomp begins

(deftype drawable-group (drawable)
  ((length int16 :offset 6)
   ;; One element is declared in the type; the remaining child references run
   ;; past the nominal end into the trailing storage allocated by the constructor.
   (data   drawable 1))
  (:methods
   (new (symbol type int) _type_)))

;; unused
(define *collide-nodes* 0)

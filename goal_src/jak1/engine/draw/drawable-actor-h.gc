;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/gfx/hw/display-h.gc")
(require "engine/draw/drawable-tree-h.gc")
(require "engine/draw/drawable-inline-array-h.gc")

;; Actors use the drawable containers as a compact, level-owned traversal index,
;; but they do not participate in normal scene rendering through this tree.

(declare-type entity-actor basic)

;; DECOMP BEGINS

;; Each entry is only a reference to its actor; the actor owns the behavior and
;; the remaining data.
(deftype drawable-actor (drawable)
  ((actor entity-actor :offset 8)))

;; Category marker for the actor tree in a level's drawable-tree-array.
(deftype drawable-tree-actor (drawable-tree) ())

(deftype drawable-inline-array-actor (drawable-inline-array)
  ((data drawable-actor 1 :inline)
   (pad  uint8 4)))

(defmethod draw ((this drawable-tree-actor) (tree drawable-tree-actor) (frame display-frame))
  "Do nothing; actor rendering is submitted by the live actor processes."
  0
  (none))

;; definition for method 23 of type nav-control
(defmethod check-vector-collision-with-nav-spheres ((this nav-control) (travel-direction vector) (info check-vector-collision-with-nav-spheres-info))
  "Find the nearest forward avoidance-sphere hit along
   travel-direction. Return its ray parameter and, when info is supplied, store the world-space
   intersection and outward normal."
  (let ((body-local (vector-! (new 'stack-no-clear 'vector) (-> this shape trans) (-> this mesh origin)))
        (best-hit-distance -1.0))
    (let ((best-sphere-index -1))
      (countdown (sphere-index (-> this num-spheres))
        (let* ((obstacle-sphere (-> this sphere sphere-index))
               (hit-distance (ray-circle-intersect body-local travel-direction (the-as vector (&-> obstacle-sphere x)) (-> obstacle-sphere w))))
          (when (>= hit-distance 0.0)
            (let ((to-center (new 'stack-no-clear 'vector)))
              (vector-! to-center (the-as vector (&-> obstacle-sphere x)) body-local)
              (when (>= (vector-dot to-center travel-direction) 0.0)
                (when (or (< best-hit-distance 0.0) (< hit-distance best-hit-distance))
                  (set! best-hit-distance hit-distance)
                  (set! best-sphere-index sphere-index)))))))
      (when info
        (set! (-> info u) best-hit-distance)
        (when (>= best-hit-distance 0.0)
          (vector+float*! (-> info intersect) (-> this shape trans) travel-direction best-hit-distance)
          (let ((hit-sphere (-> this sphere best-sphere-index))
                (sphere-world (new 'stack-no-clear 'vector)))
            (vector+! sphere-world (the-as vector (&-> hit-sphere x)) (-> this mesh origin))
            (vector-! (-> info normal) (-> info intersect) sphere-world))
          (set! (-> info normal w) 1.0)
          (vector-normalize! (-> info normal) 1.0))))
    best-hit-distance))

;; definition for method 33 of type nav-control
;; INFO: Used lq/sq
(defmethod avoid-spheres-and-detect-blocked ((this nav-control) (result-travel vector) (start-position vector) (desired-travel vector) (fallback-direction vector) (unused float))
  "Deflect travel around spheres. If the resulting travel is no
   longer than the original and is under five centimeters, set the blocked state, update its timer and
   count, and send block-event."
  (let ((original-length (vector-xz-length (-> this travel))))
    (when (avoid-spheres this result-travel start-position desired-travel fallback-direction original-length)
      (set! (-> this blocked-travel quad) (-> this travel quad))
      (let ((new-length (vector-xz-length (-> this travel))))
        (when (and (>= original-length new-length) (< new-length 204.8))
          (logior! (-> this flags) (nav-control-flags blocked))
          (set-time! (-> this block-time))
          (+! (-> this block-count) 1.0)
          (if (-> this block-event) (send-event (the-as process-tree (-> this process)) (the-as symbol (-> this block-event)) this))))
      #t)))


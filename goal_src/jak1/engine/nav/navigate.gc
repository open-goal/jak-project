  (none))

;; definition for method 16 of type nav-mesh
;; INFO: Used lq/sq
;; INFO: Return type mismatch int vs none.
;; Walk the requested segment through adjacent triangles. A gap ends the walk for the caller to
;; handle. At a solid boundary, either stop or subtract the into-wall component and make one more
;; pass along the wall; the 1.01 factor leaves the new ray slightly inside the legal half-space.
(defmethod clip-travel-vector-to-mesh ((this nav-mesh) (start-position vector) (poly nav-poly) (travel vector) (slide? symbol) (max-length float) (info clip-travel-vector-to-mesh-return-info))
  "Ray-walk and clip travel so it stays on the mesh. slide? selects
   boundary sliding instead of stopping; info receives boundary and gap details."
  (local-vars (walk-done symbol))
  (when info
    (set! (-> info found-boundary) #f)
    (set! (-> info gap-poly) #f))
  (let ((ray (new 'stack-no-clear 'nav-ray)))
    (let ((done (the-as symbol #f))
          (clip-count 0))
      (set! (-> ray current-poly) poly)
      (set! (-> ray current-pos quad) (-> start-position quad))
      (vector+! (-> ray dest-pos) start-position travel)
      (until done
        (let ((iteration 0))
          (init-ray ray)
          (until walk-done
            (+! iteration 1)
            (move-along-nav-ray! this ray)
            (set! walk-done (or (>= iteration 15) (or (>= (-> ray len) (fmax 20480.0 max-length)) (-> ray terminated))))))
        (cond
          ((and (-> ray hit-boundary) (and (< (-> ray len) max-length) (!= (-> ray last-edge) -1) (< clip-count 1)))
           (+! clip-count 1)
           (let* ((edge-start (-> this vertex (-> ray current-poly vertex (-> *edge-vert0-table* (-> ray last-edge)))))
                  (edge-end (-> this vertex (-> ray current-poly vertex (-> *edge-vert1-table* (-> ray last-edge)))))
                  (raw-normal-x (- (-> edge-start z) (-> edge-end z)))
                  (raw-normal-z (- (-> edge-end x) (-> edge-start x)))
                  (travel-x (-> travel x))
                  (travel-z (-> travel z))
                  (edge-length (sqrtf (+ (square raw-normal-x) (square raw-normal-z))))
                  (inverse-edge-length (/ 1.0 edge-length))
                  (edge-normal-x (* raw-normal-x inverse-edge-length))
                  (edge-normal-z (* raw-normal-z inverse-edge-length)))
             (when info
               (set! (-> info found-boundary) #t)
               (vector+! (-> info intersection) (-> ray current-pos) (-> this origin))
               (set! (-> info boundary-normal x) edge-normal-x)
               (set! (-> info boundary-normal y) 0.0)
               (set! (-> info boundary-normal z) edge-normal-z)
               (set! (-> info poly) (-> ray current-poly))
               (set! (-> info edge) (-> ray last-edge))
               (vector+! (-> info vert-0) (the-as vector edge-start) (-> this origin))
               (vector+! (-> info vert-1) (the-as vector edge-end) (-> this origin)))
             (set! (-> ray dest-pos quad) (-> ray current-pos quad))
             (cond
               (slide?
                (let* ((into-wall (* 1.01 (+ (* edge-normal-x travel-x) (* edge-normal-z travel-z))))
                       (slide-x (- travel-x (* edge-normal-x into-wall)))
                       (slide-z (- travel-z (* edge-normal-z into-wall))))
                  (+! (-> ray dest-pos x) slide-x)
                  (+! (-> ray dest-pos z) slide-z)))
               (else (set! done #t) done))))
          ((-> ray hit-gap) (if info (set! (-> info gap-poly) (-> ray next-poly))) (set! done #t) done)
          (else (set! done #t) done))))
    (vector-! travel (-> ray current-pos) start-position))
  0
  0
  (none))

;; definition for method 24 of type nav-control
;; INFO: Return type mismatch int vs none.
(defmethod clip-travel-to-mesh ((this nav-control) (max-distance float) (info clip-travel-vector-to-mesh-return-info))
  "Clip this control's travel to the mesh up to max-distance and fill
   boundary or gap details."
  (let ((body-local (new 'stack-no-clear 'vector)))
    (vector-! body-local (-> this shape trans) (-> this mesh origin))
    (clip-travel-vector-to-mesh (-> this mesh)
                                body-local
                                (-> this current-poly)
                                (-> this travel)
                                (not (logtest? (-> this flags) (nav-control-flags stop-at-boundary)))
                                max-distance
                                info))
  (when info
    (if (-> info gap-poly) (set! (-> this next-poly) (-> info gap-poly))))
  0
  (none))

;; definition for function test-xz-point-on-line-segment?
(defun test-xz-point-on-line-segment? ((point vector) (segment-start vector) (segment-end vector) (tolerance float))
  "Return whether point is within tolerance of the finite XZ segment. Endpoint proximity is tested
   first; otherwise the perpendicular projection must lie between segment-start and segment-end."
  (let ((within-tolerance (>= tolerance (fmin (vector-vector-xz-distance point segment-start) (vector-vector-xz-distance point segment-end)))))
    (when (not within-tolerance)
      (let* ((segment-x (- (-> segment-end x) (-> segment-start x)))
             (segment-z (- (-> segment-end z) (-> segment-start z)))
             (segment-length (sqrtf (+ (square segment-x) (square segment-z))))
             (nonzero-segment-length segment-length)
             (inverse-segment-length (/ 1.0 nonzero-segment-length))
             (normal-x (* inverse-segment-length (- segment-z)))
             (normal-z (* inverse-segment-length segment-x))
             (point-offset-x (- (-> point x) (-> segment-start x)))
             (point-offset-z (- (-> point z) (-> segment-start z))))
        (when (>= tolerance (fabs (+ (* point-offset-x normal-x) (* point-offset-z normal-z))))
          (let ((projection (+ (* point-offset-x segment-x) (* point-offset-z segment-z))))
            (set! within-tolerance (and (>= projection 0.0) (>= (square segment-length) projection)))))))
    within-tolerance))

;; definition for function choose-travel-portal-vertex
;; Use the current portal's perpendicular bisector to discover which way the later portal chain
;; bends. A later edge wholly on one side selects the matching current endpoint; if the chain ends,
;; the target's nearer endpoint supplies the final side test.
(defun choose-travel-portal-vertex ((mesh nav-mesh) (portal nav-route-portal) (target-poly nav-poly) (target-point vector))
  "Choose the current portal endpoint around which the remaining route bends. Walk later portals
   until both endpoints lie on one side of the current edge's perpendicular bisector; if the route
   ends first, use the endpoint nearest target-point to choose the side."
  (let ((edge-x (- (-> portal vertex 1 x) (-> portal vertex 0 x)))
        (edge-z (- (-> portal vertex 1 z) (-> portal vertex 0 z))))
    0.0
    (let ((walk-portal (new 'stack-no-clear 'nav-route-portal))
          (chosen-vertex 0))
      (let* ((done #f)
             (edge-length (sqrtf (+ (square edge-x) (square edge-z))))
             (inverse-edge-length (/ 1.0 edge-length))
             (bisector-normal-x (* edge-x inverse-edge-length))
             (bisector-normal-z (* edge-z inverse-edge-length))
             (bisector-offset (* -0.5
                                 (+ (* bisector-normal-x (-> portal vertex 0 x))
                                    (* bisector-normal-z (-> portal vertex 0 z))
                                    (+ (* bisector-normal-x (-> portal vertex 1 x)) (* bisector-normal-z (-> portal vertex 1 z)))))))
        (set! (-> walk-portal vertex 0) (-> portal vertex 0))
        (set! (-> walk-portal vertex 1) (-> portal vertex 1))
        (set! (-> walk-portal next-poly) (-> portal next-poly))
        (until done
          (setup-portal mesh (-> walk-portal next-poly) target-poly walk-portal)
          (cond
            ((-> walk-portal next-poly)
             (let ((far-side-count 0))
               (dotimes (vertex-index 2)
                 (if (< 0.0
                        (+ (* bisector-normal-x (-> walk-portal vertex vertex-index x))
                           (* bisector-normal-z (-> walk-portal vertex vertex-index z))
                           bisector-offset))
                   (+! far-side-count 1)))
               (when (= far-side-count 2)
                 (set! chosen-vertex 1)
                 (set! done #t))
               (when (zero? far-side-count)
                 (set! chosen-vertex 0)
                 (set! done #t)))
             0)
            (else
             (let ((nearer-vertex (if (< (vector-vector-xz-distance (-> walk-portal vertex 0) target-point)
                                         (vector-vector-xz-distance (-> walk-portal vertex 1) target-point))
                                    0
                                    1)))
               (set! chosen-vertex
                     (if (< 0.0
                            (+ (* bisector-normal-x (-> portal vertex nearer-vertex x))
                               (* bisector-normal-z (-> portal vertex nearer-vertex z))
                               bisector-offset))
                       1
                       0)))
             (set! done #t)
             0))))
      chosen-vertex)))

;; definition for method 13 of type nav-control
;; INFO: Used lq/sq
;; Walk the precomputed portal chain from current-poly toward target-poly while the body remains
;; within ten centimeters of each portal. Aim through the next portal or around its chosen endpoint,
;; then apply sphere avoidance and clip the result back to the mesh.
(defmethod compute-travel ((this nav-control) (destination vector) (previous-travel vector))
  "Build this frame's travel toward destination along the portal route, using
   previous-travel as the fallback direction."
  (let ((body-local (new 'stack-no-clear 'vector))
        (current-position (new 'stack-no-clear 'vector)))
    (let ((clip-poly (-> this current-poly)))
      (let ((target-point (new 'stack-no-clear 'vector))
            (portal (new 'stack-no-clear 'nav-route-portal))
            (in-corridor (the-as symbol #f)))
        (vector-! body-local (-> this shape trans) (-> this mesh origin))
        (set! (-> current-position quad) (-> body-local quad))
        (let ((target-local (new 'stack-no-clear 'vector)))
          (vector-! target-local destination (-> this mesh origin))
          (set! (-> this target-poly) (find-poly (-> this mesh) target-local (-> this nearest-y-threshold) (&-> this flags)))
          (if (not (-> this target-poly)) (set! (-> this target-poly) (-> this current-poly)))
          (project-point-into-tri-2d (-> this mesh) (-> this target-poly) target-point target-local))
        (vector-! (-> this travel) target-point body-local)
        (setup-portal (-> this mesh) (-> this current-poly) (-> this target-poly) portal)
        (cond
          ((not (-> portal next-poly)) (set! (-> this next-poly) #f) (set! (-> this portal 0) #f) (set! (-> this portal 1) #f))
          (else
           (set! (-> this next-poly) (-> portal next-poly))
           (set! (-> this portal 0) (-> portal vertex 0))
           (set! (-> this portal 1) (-> portal vertex 1))
           (set! in-corridor #t)
           (while (and in-corridor
                       (-> portal next-poly)
                       (test-xz-point-on-line-segment? body-local (-> portal vertex 0) (-> portal vertex 1) 409.59998))
             (when #t
               #t
               (vector-segment-distance-point! body-local (-> portal vertex 0) (-> portal vertex 1) current-position)
               (vector-! (-> this travel) target-point current-position)
               0)
             (cond
               ((logtest? (-> portal next-poly pat) 1)
                (vector-segment-distance-point! body-local (-> portal vertex 0) (-> portal vertex 1) target-point)
                (vector-! (-> this travel) target-point current-position)
                (set! (-> this next-poly) (-> portal next-poly))
                (set! in-corridor (the-as symbol #f)))
               ((begin
                  (set! clip-poly (-> portal next-poly))
                  (setup-portal (-> this mesh) (-> portal next-poly) (-> this target-poly) portal))
                (set! (-> this next-poly) (-> portal next-poly))
                (set! (-> this portal 0) (-> portal vertex 0))
                (set! (-> this portal 1) (-> portal vertex 1))
                0)
               (else
                (set! (-> this next-poly) #f)
                (set! (-> this portal 0) #f)
                (set! (-> this portal 1) #f)
                (set! in-corridor (the-as symbol #f)))))))
        (when in-corridor
          (when (not (ray-ccw-line-segment-intersection? current-position (-> this travel) (-> this portal 0) (-> this portal 1)))
            (let ((portal-vertex-index (choose-travel-portal-vertex (-> this mesh) portal (-> this target-poly) target-point)))
              (vector-! (-> this travel) (the-as vector (-> portal vertex portal-vertex-index)) current-position)))))
      (avoid-spheres-and-detect-blocked this (-> this travel) current-position (-> this travel) previous-travel 40960.0)
      (let ((clip-info (new 'stack-no-clear 'clip-travel-vector-to-mesh-return-info)))
        (clip-travel-vector-to-mesh (-> this mesh)
                                    current-position
                                    clip-poly
                                    (-> this travel)
                                    (not (logtest? (-> this flags) (nav-control-flags stop-at-boundary)))
                                    204.8
                                    clip-info)
        (if (-> clip-info gap-poly) (set! (-> this next-poly) (-> clip-info gap-poly)))))
    (let ((delta (new 'stack-no-clear 'vector)))
      (vector-! delta current-position body-local)
      (vector+! (-> this travel) (-> this travel) delta)))
  (set! (-> this travel y) 0.0)
  (-> this travel))

;; definition for method 12 of type nav-control
;; INFO: Used lq/sq
(defmethod find-gap-landing ((this nav-control) (gap-info nav-gap-info))
  "Find the first non-gap triangle beyond the current gap chain and fill the
   landing point. Return #t when a landing exists."
  (when (and (-> this next-poly) (logtest? (-> this next-poly pat) 1))
    (let ((poly (-> this next-poly))
          (body-local (vector-! (new 'stack-no-clear 'vector) (-> this shape trans) (-> this mesh origin))))
      (while (and poly (logtest? (-> poly pat) 1))
        (set! poly (get-adj-poly (-> this mesh) poly (-> this target-poly) #f)))
      (when (and poly (-> this gap-event))
        (let ((landing-point (-> this event-temp)))
          (closest-point-on-boundary (-> this mesh) poly landing-point body-local)
          (vector+! landing-point landing-point (-> this mesh origin))
          (set! (-> gap-info dest quad) (-> landing-point quad)))
        (set! (-> gap-info poly) poly)
        #t))))

;; definition for function start-collect-nav
(defun start-collect-nav ()
  "Begin performance-counter bucket 14 for navigation work."
  (reset! (-> *perf-stats* data 14)))

;; definition for function end-collect-nav
(defun end-collect-nav ()
  "End performance-counter bucket 14 and accumulate both selected EE counters."
  (read! (-> *perf-stats* data 14)))

;; definition for method 11 of type nav-control
;; INFO: Used lq/sq
;; Relocalize first so every later query uses the body's current triangle, rebuild dynamic
;; obstacles, and compute this frame's planar travel. Very short travel either reports the landing
;; across a gap or marks the destination reached; the obstacle pass reports blocked motion itself.
(defmethod navigate! ((this nav-control) (destination vector))
  "Update navigation toward destination: relocalize on the mesh, gather obstacle
   spheres, compute travel, and send gap or blocked events."
  (set! (-> this old-travel quad) (-> this travel quad))
  (-> this block-count)
  (seek! (-> this block-count) 0.0 0.016666668)
  (logclear! (-> this flags) (nav-control-flags current-poly-set blocked navcf18 reached-destination))
  (relocalize-in-mesh! this)
  (if (logtest? (-> this flags) (nav-control-flags enable-sphere-avoidance))
    (gather-nav-spheres! this (the-as collide-kind -1)))
  (compute-travel this destination (-> this old-travel))
  (-> this mesh)
  (vector-! (new 'stack-no-clear 'vector) (-> this shape trans) (-> this mesh origin))
  (let ((gap-info (new 'stack-no-clear 'nav-gap-info)))
    (when (< (vector-xz-length (-> this travel)) 204.8)
      (cond
        ((logtest? (nav-control-flags blocked) (-> this flags)))
        ((-> this next-poly)
         (cond
           ((find-gap-landing this gap-info)
            (set! (-> this next-poly) #f)
            (send-event (the-as process-tree (-> this process))
                        (the-as symbol (-> this gap-event))
                        (-> gap-info dest)
                        (-> gap-info poly)))
           (else)))
        (else (logior! (-> this flags) (nav-control-flags reached-destination))))))
  (-> this travel))

;; definition (debug) for function nav-sphere-from-cam
;; INFO: Return type mismatch int vs none.
(defun-debug nav-sphere-from-cam ()
  "Print the current camera position as a SPHEREM authoring form."
  (let ((camera-position (camera-pos)))
    (format #t
            "SPHEREM(~4,,1M, ~4,,1M, ~4,,1M, 1.0)~%"
            (-> camera-position x)
            (-> camera-position y)
            (-> camera-position z)))
  0
  (none))

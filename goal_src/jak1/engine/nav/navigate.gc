;; definition for method 27 of type nav-control
;; INFO: Used lq/sq
;; INFO: Return type mismatch int vs none.
(defmethod relocalize-in-mesh! ((this nav-control))
  "Update current-poly by ray-walking from the previous body position to its
   current position."
  (local-vars (done symbol))
  (cond
    ((-> this current-poly)
     (let ((mesh (-> this mesh))
           (ray (new 'stack-no-clear 'nav-ray)))
       (let ((iteration-count 0))
         (set! (-> ray current-poly) (-> this current-poly))
         (vector-! (-> ray current-pos) (-> this prev-pos) (-> mesh origin))
         (vector-! (-> ray dest-pos) (-> this shape trans) (-> mesh origin))
         (init-ray ray)
         (until done
           (+! iteration-count 1)
           (move-along-nav-ray! mesh ray)
           (set! done (or (>= iteration-count 15) (-> ray terminated)))))
       (set! (-> this current-poly) (-> ray current-poly))
       (when (-> ray reached-dest)
         (if (not (point-in-poly? mesh (-> ray current-poly) (-> ray dest-pos))) (set! (-> ray reached-dest) #f)))
       (cond
         ((-> ray reached-dest) (set! (-> this prev-pos quad) (-> this shape trans quad)))
         (else
          (set! (-> this prev-pos quad) (-> this shape trans quad))
          (set! (-> this current-poly) (find-poly this (-> this shape trans))))))
     0)
    (else
     (set! (-> this prev-pos quad) (-> this shape trans quad))
     (set! (-> this current-poly) (find-poly this (-> this shape trans)))))
  (post-relocalize-hook this)

(define *edge-vert1-table* (new 'static 'boxed-array :type int8 2 0 1))

;; definition for symbol *edge-mask-table*, type (array int8)
(define *edge-mask-table* (new 'static 'boxed-array :type int8 1 2 4))

;; definition for function inc-mod3
(defun inc-mod3 ((index int))
  "Return the next cyclic triangle-edge index for an input in the range zero through two."
  (local-vars (result int) (past-end int))
  (let ((next-index (+ index 1)))
    (let ((last-index 2)) (set-on-less-than past-end last-index next-index))
    (move-if-not-zero result 0 past-end next-index))
  result)

;; definition for function dec-mod3
(defun dec-mod3 ((index int))
  "Return the previous cyclic triangle-edge index for an input in the range zero through two."
  (local-vars (result int) (before-start int))
  (let ((previous-index (+ index -1))
        (last-index 2))
    (set-on-less-than before-start previous-index 0)
    (move-if-not-zero result last-index before-start previous-index))
  result)

;; definition for function vu-point-triangle-intersection?
(defun vu-point-triangle-intersection? ((point vector) (vertex-0 vector) (vertex-1 vector) (vertex-2 vector))
  "Return whether point lies inside the triangle in XZ by comparing its three oriented edge signs;
   Y and W are ignored."
  (local-vars
    (edge-cross-0-bits int)
    (edge-cross-0-negative int)
    (edge-cross-0-1-match int)
    (edge-cross-2-bits int)
    (edge-cross-2-negative int)
    (edge-cross-1-2-match int)
    (edge-cross-1-bits int)
    (edge-cross-1-negative int))
  (rlet ((acc :class vf)
         (vertex-0-vf :class vf)
         (vertex-1-offset-vf :class vf)
         (vertex-2-offset-vf :class vf)
         (point-vf :class vf)
         (edge-cross-0-vf :class vf)
         (edge-cross-1-vf :class vf)
         (edge-cross-2-vf :class vf)
         (vertex-1-vf :class vf)
         (vertex-2-vf :class vf)
         (edge-0-vf :class vf)
         (edge-1-vf :class vf)
         (edge-2-vf :class vf)
         (vertex-0-offset-vf :class vf))
    ;; Compare the point with each directed edge in XZ. The cross products all need the same sign
    ;; for a point inside the triangle.
    (.lvf vertex-0-vf (&-> vertex-0 quad))
    (.lvf vertex-1-vf (&-> vertex-1 quad))
    (.sub.vf.yw vertex-0-vf vertex-0-vf vertex-0-vf)
    (.lvf vertex-2-vf (&-> vertex-2 quad))
    (.sub.vf.yw vertex-1-vf vertex-1-vf vertex-1-vf)
    (.lvf point-vf (&-> point quad))
    (.sub.vf.yw vertex-2-vf vertex-2-vf vertex-2-vf)
    (.sub.vf edge-0-vf vertex-1-vf vertex-0-vf)
    (.sub.vf vertex-0-offset-vf vertex-0-vf point-vf)
    (.sub.vf edge-1-vf vertex-2-vf vertex-1-vf)
    (.sub.vf vertex-1-offset-vf vertex-1-vf point-vf)
    (.sub.vf edge-2-vf vertex-0-vf vertex-2-vf)
    (.sub.vf vertex-2-offset-vf vertex-2-vf point-vf)
    (.outer.product.a.vf acc vertex-0-offset-vf edge-0-vf)
    (.outer.product.b.vf edge-cross-0-vf edge-0-vf vertex-0-offset-vf acc)
    (.outer.product.a.vf acc vertex-1-offset-vf edge-1-vf)
    (.outer.product.b.vf edge-cross-1-vf edge-1-vf vertex-1-offset-vf acc)
    (.outer.product.a.vf acc vertex-2-offset-vf edge-2-vf)
    (.outer.product.b.vf edge-cross-2-vf edge-2-vf vertex-2-offset-vf acc)
    (.mov edge-cross-0-bits edge-cross-0-vf)
    (.mov edge-cross-1-bits edge-cross-1-vf)
    (.mov edge-cross-2-bits edge-cross-2-vf)
    (set-on-less-than edge-cross-0-negative edge-cross-0-bits 0)
    (set-on-less-than edge-cross-1-negative edge-cross-1-bits 0)
    (set-on-less-than edge-cross-2-negative edge-cross-2-bits 0)
    (let ((edge-cross-1-2-difference (logxor edge-cross-1-negative edge-cross-2-negative))
          (edge-cross-0-1-difference (logxor edge-cross-0-negative edge-cross-1-negative)))
      (set-on-less-than edge-cross-1-2-match edge-cross-1-2-difference 1)
      (set-on-less-than edge-cross-0-1-match edge-cross-0-1-difference 1))
    (logtest? edge-cross-0-1-match edge-cross-1-2-match)))

;; definition for method 21 of type nav-mesh
(defmethod point-in-poly? ((this nav-mesh) (poly nav-poly) (point vector))
  "Return whether a mesh-local point lies inside poly in the XZ plane."
  (vu-point-triangle-intersection? point
                                   (-> this vertex (-> poly vertex 0))
                                   (-> this vertex (-> poly vertex 1))
                                   (-> this vertex (-> poly vertex 2))))

;; definition for method 24 of type nav-mesh
;; INFO: Used lq/sq
(defmethod closest-point-on-boundary ((this nav-mesh) (poly nav-poly) (result vector) (point vector))
  "Store the closest point on poly's perimeter to point."
  (let ((vertices (-> this vertex))
        (candidate (new 'stack-no-clear 'vector))
        (closest-point (new 'stack-no-clear 'vector)))
    (let ((closest-distance 10000000000000000000000000000000000000.0))
      (dotimes (i 3)
        (let* ((edge-start (-> vertices (-> poly vertex i)))
               (distance (vector-segment-distance-point! point edge-start (-> vertices (-> poly vertex (mod (+ i 1) 3))) candidate)))
          (when (< distance closest-distance)
            (set! closest-distance distance)
            (set! (-> closest-point quad) (-> candidate quad))))))
    (set! (-> result quad) (-> closest-point quad)))
  result)

;; definition for method 26 of type nav-mesh
;; INFO: Used lq/sq
(defmethod project-point-into-tri-2d ((this nav-mesh) (poly nav-poly) (result vector) (point vector))
  "Store point when it lies inside poly in XZ, otherwise store the
   closest point on the perimeter."
  (if (point-in-poly? this poly point)
    (set! (-> result quad) (-> point quad))
    (closest-point-on-boundary this poly result point))
  result)

;; definition for function point-inside-rect?
(defun point-inside-rect? ((node nav-node) (point vector) (y-threshold float))
  "Return whether point lies inside node's XZ bounds and its Y interval overlaps y-threshold around
   the point."
  (and (>= (-> point x) (- (-> node center-x) (-> node radius-x)))
       (>= (+ (-> node center-x) (-> node radius-x)) (-> point x))
       (>= (-> point z) (- (-> node center-z) (-> node radius-z)))
       (>= (+ (-> node center-z) (-> node radius-z)) (-> point z))
       (>= (+ (-> point y) y-threshold) (- (-> node center-y) (-> node radius-y)))
       (>= (+ (-> node center-y) (-> node radius-y)) (- (-> point y) y-threshold))))

;; definition for function point-inside-poly?
(defun point-inside-poly? ((mesh nav-mesh) (poly-index uint) (point vector) (y-threshold float))
  "Return whether point lies inside the indexed non-gap triangle in XZ and within y-threshold of its
   average vertex height."
  (local-vars
    (edge-cross-0-bits int)
    (edge-cross-0-negative int)
    (edge-cross-0-1-match int)
    (edge-cross-2-bits int)
    (edge-cross-2-negative int)
    (edge-cross-1-2-match int)
    (edge-cross-1-bits int)
    (edge-cross-1-negative int))
  (rlet ((acc :class vf)
         (vertex-0-vf :class vf)
         (vertex-1-offset-vf :class vf)
         (vertex-2-offset-vf :class vf)
         (point-vf :class vf)
         (edge-cross-0-vf :class vf)
         (edge-cross-1-vf :class vf)
         (edge-cross-2-vf :class vf)
         (vertex-1-vf :class vf)
         (vertex-2-vf :class vf)
         (edge-0-vf :class vf)
         (edge-1-vf :class vf)
         (edge-2-vf :class vf)
         (vertex-0-offset-vf :class vf))
    (let ((poly (-> mesh poly poly-index)))
      (when (not (logtest? (-> poly pat) 1))
        (let ((vertex-0 (-> mesh vertex (-> poly vertex 0)))
              (vertex-1 (-> mesh vertex (-> poly vertex 1)))
              (vertex-2 (-> mesh vertex (-> poly vertex 2))))
          0.0
          (let ((y-distance (fabs (- (-> point y) (* 0.333333 (+ (-> vertex-0 y) (-> vertex-1 y) (-> vertex-2 y)))))))
            (when (>= y-threshold y-distance)
              ;; The scalar height rejection above avoids the VU work for triangles on another
              ;; floor. This is the same three-edge XZ sign test used by point-in-poly?.
              (.lvf vertex-0-vf (&-> vertex-0 quad))
              (.lvf vertex-1-vf (&-> vertex-1 quad))
              (.sub.vf.yw vertex-0-vf vertex-0-vf vertex-0-vf)
              (.lvf vertex-2-vf (&-> vertex-2 quad))
              (.sub.vf.yw vertex-1-vf vertex-1-vf vertex-1-vf)
              (.lvf point-vf (&-> point quad))
              (.sub.vf.yw vertex-2-vf vertex-2-vf vertex-2-vf)
              (.sub.vf edge-0-vf vertex-1-vf vertex-0-vf)
              (.sub.vf vertex-0-offset-vf vertex-0-vf point-vf)
              (.sub.vf edge-1-vf vertex-2-vf vertex-1-vf)
              (.sub.vf vertex-1-offset-vf vertex-1-vf point-vf)
              (.sub.vf edge-2-vf vertex-0-vf vertex-2-vf)
              (.sub.vf vertex-2-offset-vf vertex-2-vf point-vf)
              (.outer.product.a.vf acc vertex-0-offset-vf edge-0-vf)
              (.outer.product.b.vf edge-cross-0-vf edge-0-vf vertex-0-offset-vf acc)
              (.outer.product.a.vf acc vertex-1-offset-vf edge-1-vf)
              (.outer.product.b.vf edge-cross-1-vf edge-1-vf vertex-1-offset-vf acc)
              (.outer.product.a.vf acc vertex-2-offset-vf edge-2-vf)
              (.outer.product.b.vf edge-cross-2-vf edge-2-vf vertex-2-offset-vf acc)
              (.mov edge-cross-0-bits edge-cross-0-vf)
              (.mov edge-cross-1-bits edge-cross-1-vf)
              (.mov edge-cross-2-bits edge-cross-2-vf)
              (set-on-less-than edge-cross-0-negative edge-cross-0-bits 0)
              (set-on-less-than edge-cross-1-negative edge-cross-1-bits 0)
              (set-on-less-than edge-cross-2-negative edge-cross-2-bits 0)
              (let ((edge-cross-1-2-difference (logxor edge-cross-1-negative edge-cross-2-negative))
                    (edge-cross-0-1-difference (logxor edge-cross-0-negative edge-cross-1-negative)))
                (set-on-less-than edge-cross-1-2-match edge-cross-1-2-difference 1)
                (set-on-less-than edge-cross-0-1-match edge-cross-0-1-difference 1))
              (if (logtest? edge-cross-0-1-match edge-cross-1-2-match) (return #t)))))))
    #f))

;; definition for function recursive-inside-poly
(defun recursive-inside-poly ((mesh nav-mesh) (node nav-node) (point vector) (y-threshold float))
  "Search a navigation BVH below node for a non-gap triangle containing point within y-threshold.
   Return its triangle index or -1."
  (when (point-inside-rect? node point y-threshold)
    (cond
      ((zero? (-> node type))
       (let ((left-offset (-> node left-offset))
             (right-offset (-> node right-offset)))
         (when (>= left-offset 0)
           (let* ((left-node (the-as nav-node (&+ (the-as (pointer nav-node) (-> mesh nodes)) left-offset)))
                  (left-result (recursive-inside-poly mesh left-node point y-threshold)))
             (if (>= left-result 0) (return left-result))))
         (when (>= right-offset 0)
           (let* ((right-node (&+ (the-as (pointer nav-node) (-> mesh nodes)) right-offset))
                  (right-result (recursive-inside-poly mesh (the-as nav-node right-node) point y-threshold)))
             (if (>= right-result 0) (return right-result)))))
       (return -1))
      (else
       (let ((poly-count (-> node num-tris))
             (poly-cursor (-> node first-tris)))
         (dotimes (i (the-as int poly-count))
           (let ((poly-index (-> poly-cursor 0)))
             (if (point-inside-poly? mesh poly-index point y-threshold) (return (the-as int poly-index))))
           (set! poly-cursor (&-> poly-cursor 1))
           (if (= i 3) (set! poly-cursor (&-> poly-cursor 4)))))
       (return -1)))
    (the-as none 0))
  -1)

;; definition for method 27 of type nav-mesh
;; INFO: Used lq/sq
(defmethod find-poly-fast ((this nav-mesh) (point vector) (y-threshold meters))
  "Find the triangle containing a mesh-local point with the BVH and per-frame
   cache, returning #f when no triangle contains it within the Y threshold."
  (local-vars (cache-hit symbol) (equal-words uint128) (packed-equality uint128))
  -1
  (let ((available-cache-index -1)
        (now (current-time)))
    (when (>= (square (-> this bounds w)) (vector-length-squared point))
      (dotimes (i 4)
        (set! cache-hit
              (and (= (-> this cache i time) now)
                   (= (-> this cache i vec w) y-threshold)
                   (begin
                     (let ((cache-entry (-> this cache i))
                           (query-point point))
                       (set! cache-hit #t)
                       (let* ((xyz-mask #xffff)
                              (cached-quad (-> cache-entry vec quad))
                              (high-lane-mask (shl xyz-mask 48)))
                         (let ((point-quad (-> query-point quad))) (.pceqw equal-words cached-quad point-quad))
                         (.ppach packed-equality (the-as uint128 0) equal-words)
                         (b! (= (logior (the-as int packed-equality) high-lane-mask) -1) cfg-10 :delay (nop!))))
                     #f)))
        (label cfg-10)
        (if cache-hit (return (-> this poly (-> this cache i poly-ind))))
        (if (and (< available-cache-index 0) (!= (-> this cache i time) now)) (set! available-cache-index i)))
      (let ((poly-index (recursive-inside-poly this (-> this nodes 0) point y-threshold)))
        (when (>= poly-index 0)
          (when (>= available-cache-index 0)
            (let ((write-entry (-> this cache available-cache-index)))
              (set! (-> write-entry vec x) (-> point x))
              (set! (-> write-entry vec y) (-> point y))
              (set! (-> write-entry vec z) (-> point z))
              (set! (-> write-entry vec w) y-threshold)
              (set! (-> write-entry time) (the-as uint now))
              (set! (-> write-entry poly-ind) (the-as uint poly-index))))
          (return (-> this poly poly-index))))))
  (the-as nav-poly #f))

;; definition for function circle-triangle-intersection-proc?
(defun circle-triangle-intersection-proc? ((center vector) (radius float) (vertices (inline-array nav-vertex)))
  "Return whether the XZ circle overlaps the triangle in vertices. This is the reference version of
   circle-triangle-intersection?."
  (let ((outside-edge-mask 0))
    (dotimes (edge-index 3)
      (let* ((edge-start (-> vertices (-> *edge-vert0-table* edge-index)))
             (edge-end (-> vertices (-> *edge-vert1-table* edge-index)))
             (edge-normal-x (- (-> edge-start z) (-> edge-end z)))
             (edge-normal-z (- (-> edge-end x) (-> edge-start x)))
             (point-offset-x (- (-> center x) (-> edge-start x)))
             (point-offset-z (- (-> center z) (-> edge-start z)))
             (edge-length (sqrtf (+ (square edge-normal-x) (square edge-normal-z))))
             (inverse-edge-length (/ 1.0 edge-length))
             (unit-normal-x (* edge-normal-x inverse-edge-length))
             (unit-normal-z (* edge-normal-z inverse-edge-length))
             (signed-distance (+ (* point-offset-x unit-normal-x) (* point-offset-z unit-normal-z))))
        (cond
          ((< radius signed-distance) (return #f))
          ((< signed-distance 0.0) (+! outside-edge-mask (-> *edge-mask-table* edge-index))))))
    (if (= outside-edge-mask 7) (return #t))
    (let ((test-vertex #f)
          (selected-index 0))
      (cond
        ((= outside-edge-mask 1) (set! test-vertex #t) (set! selected-index 0))
        ((= outside-edge-mask 2) (set! test-vertex #t) (set! selected-index 1))
        ((= outside-edge-mask 4) (set! test-vertex #t) (set! selected-index 2))
        ((= outside-edge-mask 6) (set! selected-index 0))
        ((= outside-edge-mask 5) (set! selected-index 1))
        ((= outside-edge-mask 3) (set! selected-index 2)))
      (when (not test-vertex)
        (let* ((selected-edge-start (-> vertices (-> *edge-vert0-table* selected-index)))
               (selected-edge-end (the-as vector (-> vertices (-> *edge-vert1-table* selected-index))))
               (edge-x (- (-> selected-edge-end x) (-> selected-edge-start x)))
               (edge-z (- (-> selected-edge-end z) (-> selected-edge-start z)))
               (start-projection (+ (* edge-x (- (-> center x) (-> selected-edge-start x))) (* edge-z (- (-> center z) (-> selected-edge-start z)))))
               (end-projection (+ (* edge-x (- (-> center x) (-> selected-edge-end x))) (* edge-z (- (-> center z) (-> selected-edge-end z))))))
          (cond
            ((< start-projection 0.0) (set! test-vertex #t) (set! selected-index (-> *edge-vert0-table* selected-index)))
            ((< 0.0 end-projection) (set! test-vertex #t) (set! selected-index (-> *edge-vert1-table* selected-index)))
            (else (return #t)))))
      (when test-vertex
        (let* ((selected-vertex (-> vertices selected-index))
               (distance-squared (+ (square (- (-> selected-vertex x) (-> center x))) (square (- (-> selected-vertex z) (-> center z))))))
          (if (>= (square radius) distance-squared) #t))))))

;; definition for function circle-triangle-intersection?
(defun circle-triangle-intersection? ((center vector) (radius float) (vertices (inline-array nav-vertex)))
  "Return whether the XZ circle overlaps the triangle in vertices, including edge and vertex
   contact."
  (let ((outside-edge-mask 0))
    (dotimes (edge-index 3)
      (let* ((edge-start (-> vertices (-> *edge-vert0-table* edge-index)))
             (edge-end (-> vertices (-> *edge-vert1-table* edge-index)))
             (edge-normal-x (- (-> edge-start z) (-> edge-end z)))
             (edge-normal-z (- (-> edge-end x) (-> edge-start x)))
             (point-offset-x (- (-> center x) (-> edge-start x)))
             (point-offset-z (- (-> center z) (-> edge-start z)))
             (edge-length (sqrtf (+ (square edge-normal-x) (square edge-normal-z))))
             (inverse-edge-length (/ 1.0 edge-length))
             (unit-normal-x (* edge-normal-x inverse-edge-length))
             (unit-normal-z (* edge-normal-z inverse-edge-length))
             (signed-distance (+ (* point-offset-x unit-normal-x) (* point-offset-z unit-normal-z))))
        (cond
          ((< radius signed-distance) (return #f))
          ((< signed-distance 0.0) (+! outside-edge-mask (-> *edge-mask-table* edge-index))))))
    (if (= outside-edge-mask 7) (return #t))
    (let ((test-vertex #f)
          (selected-index 0))
      (cond
        ((= outside-edge-mask 1) (set! test-vertex #t) (set! selected-index 0))
        ((= outside-edge-mask 2) (set! test-vertex #t) (set! selected-index 1))
        ((= outside-edge-mask 4) (set! test-vertex #t) (set! selected-index 2))
        ((= outside-edge-mask 6) (set! selected-index 0))
        ((= outside-edge-mask 5) (set! selected-index 1))
        ((= outside-edge-mask 3) (set! selected-index 2)))
      (when (not test-vertex)
        (let* ((selected-edge-start (-> vertices (-> *edge-vert0-table* selected-index)))
               (selected-edge-end (-> vertices (-> *edge-vert1-table* selected-index)))
               (edge-x (- (-> selected-edge-end x) (-> selected-edge-start x)))
               (edge-z (- (-> selected-edge-end z) (-> selected-edge-start z)))
               (start-projection (+ (* edge-x (- (-> center x) (-> selected-edge-start x))) (* edge-z (- (-> center z) (-> selected-edge-start z)))))
               (end-projection (+ (* edge-x (- (-> center x) (-> selected-edge-end x))) (* edge-z (- (-> center z) (-> selected-edge-end z))))))
          (cond
            ((< start-projection 0.0) (set! test-vertex #t) (set! selected-index (-> *edge-vert0-table* selected-index)))
            ((< 0.0 end-projection) (set! test-vertex #t) (set! selected-index (-> *edge-vert1-table* selected-index)))
            (else (return #t)))))
      (when test-vertex
        (let* ((selected-vertex (-> vertices selected-index))
               (distance-squared (+ (square (- (-> selected-vertex x) (-> center x))) (square (- (-> selected-vertex z) (-> center z))))))
          (if (>= (square radius) distance-squared) #t))))))

;; definition for method 29 of type nav-mesh
(defmethod is-in-mesh? ((this nav-mesh) (center vector) (radius float) (y-threshold meters))
  "Return whether a mesh-local XZ circle overlaps any non-gap triangle within the Y
   threshold."
  ;; og:preserve-this float -> int
  (local-vars (average-y-bits int))
  (rlet ((minimum-vf :class vf)
         (maximum-vf :class vf)
         (vertex-0-vf :class vf)
         (vertex-1-vf :class vf)
         (vertex-2-vf :class vf)
         (center-vf :class vf)
         (average-y-vf :class vf))
    (when (>= (square (+ radius (-> this bounds w))) (vector-length-squared center))
      (let ((triangle-data (new 'stack-no-clear 'inline-array 'nav-vertex 6))
            (one-third 0.33333334))
        (countdown (poly-index (-> this poly-count))
          (set! *debug-traverse* (+ *debug-traverse* 1))
          (let ((poly (-> this poly poly-index)))
            (when (not (logtest? (-> poly pat) 1))
              ;; Space the dependent address calculations before the three quadword loads.
              (nop!)
              (let ((vertices-base (the-as object (-> this vertex))))
                (nop!)
                (let ((vertex-index-0 (-> poly vertex 0)))
                  (nop!)
                  (let* ((vertex-index-1 (-> poly vertex 1))
                         (vertex-offset-0 (* vertex-index-0 16))
                         (vertex-index-2 (-> poly vertex 2))
                         (vertex-offset-1 (* vertex-index-1 16))
                         (vertex-address-0 (+ vertex-offset-0 (the-as int vertices-base)))
                         (vertex-offset-2 (* vertex-index-2 16))
                         (vertex-address-1 (+ vertex-offset-1 (the-as int vertices-base)))
                         (vertex-address-2 (+ vertex-offset-2 (the-as int vertices-base))))
                    (.lvf vertex-0-vf vertex-address-0)
                    (let ((one-third-bits one-third)) (.mov average-y-vf one-third-bits))
                    (.lvf vertex-1-vf vertex-address-1)
                    (.lvf vertex-2-vf vertex-address-2))))
              ;; Keep the three vertices followed by their XYZ bounds in triangle-data. The height
              ;; lane computes center.y minus the triangle's average Y while the bounds are built.
              (.min.vf.xyz minimum-vf vertex-0-vf vertex-1-vf)
              (.lvf center-vf (&-> center quad))
              (.add.y.vf.y average-y-vf vertex-0-vf vertex-1-vf)
              (.svf (&-> triangle-data 0 quad) vertex-0-vf)
              (.max.vf.xyz maximum-vf vertex-0-vf vertex-1-vf)
              (.svf (&-> triangle-data 1 quad) vertex-1-vf)
              (.min.vf.xyz minimum-vf minimum-vf vertex-2-vf)
              (.svf (&-> triangle-data 2 quad) vertex-2-vf)
              (.max.vf.xyz maximum-vf maximum-vf vertex-2-vf)
              (.mul.x.vf.y average-y-vf average-y-vf average-y-vf)
              (.svf (&-> triangle-data 3 quad) minimum-vf)
              (.svf (&-> triangle-data 4 quad) maximum-vf)
              (.sub.y.vf.y average-y-vf center-vf average-y-vf)
              (.mov average-y-bits average-y-vf)
              (let ((average-y-distance (the-as number (sar (the-as int average-y-bits) 32))))
                (when (and (>= y-threshold (fabs (the-as float average-y-distance)))
                           (>= (+ (-> center x) radius) (-> triangle-data 3 x))
                           (>= (-> triangle-data 4 x) (- (-> center x) radius))
                           (>= (+ (-> center z) radius) (-> triangle-data 3 z))
                           (>= (-> triangle-data 4 z) (- (-> center z) radius)))
                  (set! *debug-tests* (+ *debug-tests* 1))
                  (if (circle-triangle-intersection? center radius triangle-data) (return #t)))))))))
    #f))

;; definition for method 14 of type nav-mesh
;; INFO: Used lq/sq
;; INFO: Return type mismatch int vs none.
(defmethod move-along-nav-ray! ((this nav-mesh) (ray nav-ray))
  "Advance ray across one triangle edge and update its termination,
   boundary, destination, or gap state."
  (local-vars (adjacent-edge-index int) (past-last-edge int))
  (let ((exit-edge -1)
        (move-x (- (-> ray dest-pos x) (-> ray current-pos x)))
        (move-z (- (-> ray dest-pos z) (-> ray current-pos z))))
    (dotimes (edge-index 3)
      (let* ((edge-start (-> this vertex (-> ray current-poly vertex (-> *edge-vert0-table* edge-index))))
             (edge-end (-> this vertex (-> ray current-poly vertex (-> *edge-vert1-table* edge-index))))
             (edge-normal-x (- (-> edge-start z) (-> edge-end z)))
             (edge-normal-z (- (-> edge-end x) (-> edge-start x)))
             (outward-projection (+ (* move-x edge-normal-x) (* move-z edge-normal-z))))
        (when (< 0.0 outward-projection)
          (let ((edge-distance (+ (* edge-normal-x (- (-> edge-start x) (-> ray current-pos x)))
                                  (* edge-normal-z (- (-> edge-start z) (-> ray current-pos z))))))
            (when (< edge-distance outward-projection)
              (set! exit-edge edge-index)
              (let ((fraction (fmax 0.0 (/ edge-distance outward-projection))))
                (set! move-x (* move-x fraction))
                (set! move-z (* move-z fraction))))))))
    (let ((advance-length (+ (* move-x (-> ray dir x)) (* move-z (-> ray dir z))))) (+! (-> ray len) advance-length))
    0
    (set! (-> ray next-poly) #f)
    (cond
      ((= exit-edge -1)
       (set! (-> ray current-pos quad) (-> ray dest-pos quad))
       (set! (-> ray reached-dest) #t)
       (set! (-> ray terminated) #t))
      (else
       (+! (-> ray current-pos x) move-x)
       (+! (-> ray current-pos z) move-z)
       (let ((next-edge-index (+ exit-edge 1)))
         (let ((last-edge-index 2)) (set-on-less-than past-last-edge last-edge-index next-edge-index))
         (move-if-not-zero adjacent-edge-index 0 past-last-edge next-edge-index))
       (let ((neighbor-index (-> ray current-poly adj-poly adjacent-edge-index)))
         (if (!= neighbor-index 255) (set! (-> ray next-poly) (-> this poly neighbor-index))))
       (cond
         ((and (-> ray next-poly) (not (logtest? (-> ray next-poly pat) 1))) (set! (-> ray current-poly) (-> ray next-poly)))
         (else
          (set! (-> ray last-edge) exit-edge)
          (if (-> ray next-poly) (set! (-> ray hit-gap) #t) (set! (-> ray hit-boundary) #t))
          (set! (-> ray terminated) #t))))))
  0
  (none))

;; definition for function init-ray
(defun init-ray ((ray nav-ray))
  "Reset ray's length and termination results, and normalize its current-to-destination XZ
   direction."
  (vector-! (-> ray dir) (-> ray dest-pos) (-> ray current-pos))
  (set! (-> ray dir y) 0.0)
  (vector-xz-normalize! (-> ray dir) 1.0)
  (set! (-> ray next-poly) #f)
  (set! (-> ray len) 0.0)
  (set! (-> ray last-edge) -1)
  (set! (-> ray terminated) #f)
  (set! (-> ray reached-dest) #f)
  (set! (-> ray hit-boundary) #f)
  (set! (-> ray hit-gap) #f)
  #f)

;; definition for function init-ray-local
;; INFO: Used lq/sq
(defun init-ray-local ((ray nav-ray) (poly nav-poly) (start-position vector) (destination vector))
  "Initialize ray at start in start-poly with a mesh-local destination."
  (set! (-> ray current-pos quad) (-> start-position quad))
  (set! (-> ray dest-pos quad) (-> destination quad))
  (set! (-> ray current-poly) poly)
  (init-ray ray))

;; definition for function init-ray-dir-local
;; INFO: Used lq/sq
(defun init-ray-dir-local ((ray nav-ray) (poly nav-poly) (start-position vector) (direction vector) (distance float))
  "Initialize ray at start in start-poly with a mesh-local direction and distance."
  (set! (-> ray current-poly) poly)
  (set! (-> ray current-pos quad) (-> start-position quad))
  (vector+*! (-> ray dest-pos) (-> ray current-pos) direction distance)
  (init-ray ray))

;; definition for method 15 of type nav-mesh
(defmethod try-move-along-ray ((this nav-mesh) (poly nav-poly) (start-position vector) (direction vector) (distance float))
  "Walk an XZ ray from start-poly toward direction for distance, stopping at
   the destination, a boundary or gap, or after fifteen triangles. Return the distance traveled."
  (local-vars (done symbol))
  (let ((ray (new 'stack-no-clear 'nav-ray)))
    (let ((iteration 0))
      (init-ray-dir-local ray poly start-position direction distance)
      (until done
        (+! iteration 1)
        (move-along-nav-ray! this ray)
        (set! done (or (>= iteration 15) (-> ray terminated)))))
    (-> ray len)))

;; definition for function nav-ray-test
(defun nav-ray-test ((mesh nav-mesh) (poly nav-poly) (start-position vector) (destination vector))
  "Convert the world-space start position to mesh-local space, then walk toward the world-space
   destination from start-poly. Return the XZ distance traveled before reaching the destination, a
   boundary, or a gap."
  (let ((start-local (vector-! (new 'stack-no-clear 'vector) start-position (-> mesh origin)))
        (direction (vector-! (new 'stack-no-clear 'vector) destination start-position)))
    0.0
    (set! (-> direction y) 0.0)
    (let ((distance (vector-vector-xz-distance start-position destination)))
      (vector-xz-normalize! direction 1.0)
      (try-move-along-ray mesh poly start-local direction distance))))

;; definition for function nav-ray-test-local?
(defun nav-ray-test-local? ((mesh nav-mesh) (poly nav-poly) (start-position vector) (destination vector))
  "Return whether a mesh-local ray from start to destination reaches its destination before a
   boundary or gap."
  (local-vars (done symbol))
  (let ((ray (new 'stack-no-clear 'nav-ray)))
    (let ((iteration 0))
      (init-ray-local ray poly start-position destination)
      (until done
        (+! iteration 1)
        (move-along-nav-ray! mesh ray)
        (set! done (or (>= iteration 15) (-> ray terminated)))))
    (-> ray reached-dest)))

;; definition for function nav-mesh-update-route-table
;; INFO: Return type mismatch int vs uint.
;; Route entries are packed four per byte. An entry from A to B is at
;; ((B + A * poly-count) * 2); values zero through two select A's next edge, and three means no
;; intermediate portal is required.
(defun nav-mesh-update-route-table ((mesh nav-mesh) (from-poly int) (to-poly int) (edge-value uint))
  "Store edge-value in the packed two-bit route entry from from-poly to to-poly. Values zero through
   two select a portal edge; three means no intermediate portal."
  (let* ((bit-position (* (+ to-poly (* from-poly (-> mesh poly-count))) 2))
         (byte-index (/ bit-position 8))
         (bit-shift (- bit-position (* byte-index 8)))
         (keep-mask (lognot (ash 3 bit-shift)))
         (new-byte (logior (ash (logand edge-value 3) bit-shift)
                           (logand keep-mask (-> (the-as (pointer uint8) (-> mesh route)) byte-index)))))
    (set! (-> (the-as (pointer uint8) (-> mesh route)) byte-index) (the-as uint new-byte))
    (the-as uint new-byte)))

;; definition for function nav-mesh-lookup-route
(defun nav-mesh-lookup-route ((mesh nav-mesh) (to-poly int) (from-poly int))
  "Return the packed two-bit route entry from from-poly to to-poly. The argument order matches the
   table's to-then-from lookup convention."
  (let ((bit-position (* (+ to-poly (* from-poly (-> mesh poly-count))) 2)))
    (logand (ash (-> (the-as (pointer uint8) (-> mesh route)) (/ bit-position 8)) (- (logand bit-position 7))) 3)))

;; definition for symbol *nav-update-route-table-ray-count*, type int
(define *nav-update-route-table-ray-count* 0)

;; definition for symbol *nav-update-route-table-route-count*, type int
(define *nav-update-route-table-route-count* 0)

;; definition for method 18 of type nav-mesh
;; INFO: Used lq/sq
;; INFO: Return type mismatch int vs none.
(defmethod build-route-table-recursive ((this nav-mesh) (from-poly int) (source-centroid vector) (current-poly int) (visited (pointer int8)) (depth int))
  "Mark current-poly as directly reachable from from-poly. With a
   positive depth budget, continue through unvisited non-gap neighbors whose centroids are visible
   from source-centroid."
  (set! (-> visited current-poly) 1)
  (nav-mesh-update-route-table this from-poly current-poly (the-as uint 3))
  (nav-mesh-update-route-table this current-poly from-poly (the-as uint 3))
  (set! *nav-update-route-table-route-count* (+ *nav-update-route-table-route-count* 1))
  (when (> depth 0)
    (let ((current-poly-data (-> this poly current-poly))
          (neighbor-centroid (new 'stack-no-clear 'vector))
          (edge-index 0))
      (while (< edge-index 3)
        (let ((neighbor-index (-> (the-as nav-poly (+ edge-index (the-as int current-poly-data))) adj-poly 0)))
          (when (and (!= neighbor-index 255) (!= 1 (-> (the-as (pointer uint8) (&+ visited neighbor-index)))))
            (set! (-> visited neighbor-index) 1)
            (when (not (logtest? (-> this poly neighbor-index pat) 1))
              (let ((visible (= (nav-mesh-lookup-route this from-poly (the-as int neighbor-index)) 3)))
                (when (not visible)
                  (tri-centroid-local this current-poly-data neighbor-centroid)
                  (set! *nav-update-route-table-ray-count* (+ *nav-update-route-table-ray-count* 1))
                  (set! visible (nav-ray-test-local? this (-> this poly from-poly) source-centroid neighbor-centroid)))
                (if visible (build-route-table-recursive this from-poly source-centroid (the-as int neighbor-index) visited (+ depth -1)))))))
        (+! edge-index 1))))
  0
  (none))

;; definition for method 17 of type nav-mesh
;; INFO: Return type mismatch int vs none.
;; The authored table already contains the longer routes. Make every directly adjacent non-gap
;; pair explicit as direct travel so path following does not introduce an unnecessary portal.
(defmethod update-route-table ((this nav-mesh))
  "Patch each directly adjacent non-gap triangle pair to use the direct-travel
   route marker in the packed route table."
  (when *nav-patch-route-table*
    (stopwatch-init *nav-timer*)
    (stopwatch-begin *nav-timer*)
    (let ((centroid (new 'stack-no-clear 'vector)))
      (new 'stack-no-clear 'vector)
      (let ((visited (new 'stack-no-clear 'array 'int8 256)))
        (set! *nav-update-route-table-ray-count* 0)
        (set! *nav-update-route-table-route-count* 0)
        (countdown (poly-index (-> this poly-count))
          (let ((poly (-> this poly poly-index)))
            (when (not (logtest? (-> poly pat) 1))
              (tri-centroid-local this poly centroid)
              (mem-set32! visited 64 0)
              (set! (-> visited poly-index) 1)
              (dotimes (edge-index 3)
                (let ((neighbor-index (-> poly adj-poly edge-index)))
                  (when (!= neighbor-index 255)
                    (if (not (logtest? (-> this poly neighbor-index pat) 1))
                      (build-route-table-recursive this poly-index centroid (the-as int neighbor-index) visited 0))))))))))
    (stopwatch-end *nav-timer*))
  0
  (none))

;; definition for function point-triangle-distance-min
;; Classify the point into the triangle's XZ Voronoi regions. The three edge signs identify the
;; interior, an edge region, or a corner region, allowing the caller's current best distance to
;; reject a triangle before the more expensive corner calculation.
(defun point-triangle-distance-min ((point vector) (max-distance float) (vertices (inline-array nav-vertex)))
  "Return point's shortest XZ distance to the triangle. Return zero inside it, the perpendicular
   edge distance or nearest corner distance outside it, and stop at max-distance when an edge
   already proves the triangle cannot improve the caller's current best."
  (let ((outside-edge-mask 0)
        (best-distance max-distance))
    (dotimes (edge-index 3)
      (let* ((edge-start (-> vertices (-> *edge-vert0-table* edge-index)))
             (edge-end (-> vertices (-> *edge-vert1-table* edge-index)))
             (edge-normal-x (- (-> edge-start z) (-> edge-end z)))
             (edge-normal-z (- (-> edge-end x) (-> edge-start x)))
             (point-offset-x (- (-> point x) (-> edge-start x)))
             (point-offset-z (- (-> point z) (-> edge-start z)))
             (edge-length (sqrtf (+ (square edge-normal-x) (square edge-normal-z))))
             (inverse-edge-length (/ 1.0 edge-length))
             (unit-normal-x (* edge-normal-x inverse-edge-length))
             (unit-normal-z (* edge-normal-z inverse-edge-length))
             (signed-distance (+ (* unit-normal-x point-offset-x) (* unit-normal-z point-offset-z))))
        (cond
          ((< max-distance signed-distance) (return max-distance))
          ((>= 0.0 signed-distance) (+! outside-edge-mask (-> *edge-mask-table* edge-index)))
          (else (set! best-distance signed-distance)))))
    (if (= outside-edge-mask 7) (return 0.0))
    (let ((corner-region #f)
          (feature-index 0))
      (cond
        ((= outside-edge-mask 1) (set! corner-region #t) (set! feature-index 0))
        ((= outside-edge-mask 2) (set! corner-region #t) (set! feature-index 1))
        ((= outside-edge-mask 4) (set! corner-region #t) (set! feature-index 2))
        ((= outside-edge-mask 6) (set! feature-index 0))
        ((= outside-edge-mask 5) (set! feature-index 1))
        ((= outside-edge-mask 3) (set! feature-index 2)))
      (when (not corner-region)
        (let* ((segment-start (-> vertices (-> *edge-vert0-table* feature-index)))
               (segment-end (-> vertices (-> *edge-vert1-table* feature-index)))
               (segment-x (- (-> segment-end x) (-> segment-start x)))
               (segment-z (- (-> segment-end z) (-> segment-start z)))
               (start-projection (+ (* segment-x (- (-> point x) (-> segment-start x))) (* segment-z (- (-> point z) (-> segment-start z)))))
               (end-projection (+ (* segment-x (- (-> point x) (-> segment-end x))) (* segment-z (- (-> point z) (-> segment-end z))))))
          (cond
            ((< start-projection 0.0) (set! corner-region #t) (set! feature-index (-> *edge-vert0-table* feature-index)))
            ((< 0.0 end-projection) (set! corner-region #t) (set! feature-index (-> *edge-vert1-table* feature-index)))
            (else (return best-distance)))))
      (when corner-region
        (let ((corner (-> vertices feature-index)))
          (set! best-distance
                (fmin (sqrtf (+ (square (- (-> corner x) (-> point x))) (square (- (-> corner z) (-> point z))))) max-distance)))))
    best-distance))

;; definition for method 28 of type nav-mesh
;; INFO: Used lq/sq
;; Prefer the BVH containment result. A point outside the mesh falls back to the closest non-gap
;; triangle within the requested height window so callers can still project it onto a boundary.
(defmethod find-poly ((this nav-mesh) (point vector) (y-threshold meters) (flags (pointer nav-control-flags)))
  "Find the triangle for a mesh-local point, falling back to the closest triangle when
   the point is outside and reporting the direct-hit flag through flags."
  (local-vars (best-poly nav-poly))
  (let ((fast-poly (find-poly-fast this point y-threshold)))
    (when fast-poly
      (if flags (logior! (-> flags 0) (nav-control-flags point-inside-mesh)))
      (set! best-poly fast-poly)
      (goto cfg-14)))
  (if flags (logclear! (-> flags 0) (nav-control-flags point-inside-mesh)))
  (let ((triangle-vertices (new 'stack-no-clear 'inline-array 'nav-vertex 3)))
    (set! best-poly (the-as nav-poly #f))
    (let ((best-distance 10000000000000000000000000000000000000.0))
      (countdown (poly-index (-> this poly-count))
        (let ((poly (-> this poly poly-index)))
          (when (not (logtest? (-> poly pat) 1))
            (set! (-> triangle-vertices 0 quad) (-> this vertex (-> poly vertex 0) quad))
            (set! (-> triangle-vertices 1 quad) (-> this vertex (-> poly vertex 1) quad))
            (set! (-> triangle-vertices 2 quad) (-> this vertex (-> poly vertex 2) quad))
            (let ((y-distance (- (-> point y) (* 0.333333 (+ (-> triangle-vertices 0 y) (-> triangle-vertices 1 y) (-> triangle-vertices 2 y))))))
              (when (>= y-threshold (fabs y-distance))
                (let ((distance (point-triangle-distance-min point best-distance triangle-vertices)))
                  (when (< distance best-distance)
                    (set! best-distance distance)
                    (set! best-poly poly))))))))))
  (label cfg-14)
  best-poly)

;; definition for method 12 of type nav-mesh
(defmethod setup-portal ((this nav-mesh) (current-poly nav-poly) (target-poly nav-poly) (portal nav-route-portal))
  "Fill portal with the next routed edge and its neighboring triangle. Leave it
   without a next triangle when current-poly can travel directly toward target-poly or has no stored
   next edge."
  (local-vars (next-vertex-slot int) (past-last-edge int))
  (set! (-> portal next-poly) #f)
  (cond
    ((and current-poly target-poly)
     (let* ((bit-position (* (+ (-> target-poly id) (* (the-as int (-> current-poly id)) (-> this poly-count))) 2))
            (route-edge (logand (ash (-> (the-as (pointer uint8) (-> this route)) (/ (the-as int bit-position) 8))
                                     (- (the-as int (logand bit-position 7))))
                                3)))
       (set! (-> portal edge-index) -1)
       (when (!= route-edge 3)
         (let ((neighbor-index (-> current-poly adj-poly route-edge)))
           (when (!= neighbor-index 255)
             (set! (-> portal edge-index) (the-as int route-edge))
             (set! (-> portal next-poly) (-> this poly neighbor-index))
             (let ((vertices (-> this vertex)))
               (let ((next-edge-index (+ route-edge 1)))
                 (let ((last-edge-index 2)) (set-on-less-than past-last-edge last-edge-index next-edge-index))
                 (move-if-not-zero next-vertex-slot 0 past-last-edge next-edge-index))
               (set! (-> portal vertex 0) (-> vertices (-> current-poly vertex next-vertex-slot))))
             (set! (-> portal vertex 1) (-> this vertex (-> current-poly vertex route-edge)))
             #t)))))
    (else 0)))

;; definition for method 11 of type nav-mesh
(defmethod get-adj-poly ((this nav-mesh) (current-poly nav-poly) (target-poly nav-poly) (vertex-pair symbol))
  "Return the next triangle selected by the route from current-poly toward
   target-poly. If vertex-pair is non-false, store the two shared vertex indices packed into its value
   field. Return #f for a direct route or missing neighbor."
  (local-vars (neighbor-index uint) (next-vertex-slot int) (past-last-edge int))
  (cond
    ((and current-poly target-poly)
     (let* ((bit-position (* (+ (-> target-poly id) (* (the-as int (-> current-poly id)) (-> this poly-count))) 2))
            (route-edge (logand (ash (-> (the-as (pointer uint8) (-> this route)) (/ (the-as int bit-position) 8))
                                     (- (the-as int (logand bit-position 7))))
                                3)))
       (if vertex-pair (set! (-> vertex-pair value) (the-as uint #xffffffff)))
       (cond
         ((= route-edge 3) (the-as nav-poly #f))
         ((begin (set! neighbor-index (-> current-poly adj-poly route-edge)) (= neighbor-index 255)) (the-as nav-poly #f))
         (else
          (when vertex-pair
            (let ((next-edge-index (+ route-edge 1)))
              (let ((last-edge-index 2)) (set-on-less-than past-last-edge last-edge-index next-edge-index))
              (move-if-not-zero next-vertex-slot 0 past-last-edge next-edge-index))
            (set! (-> vertex-pair value)
                  (logior (-> current-poly vertex next-vertex-slot) (shl (-> current-poly vertex route-edge) 16))))
          (-> this poly neighbor-index)))))
    (else (the-as nav-poly #f))))

;; definition for method 19 of type nav-mesh
;; INFO: Return type mismatch int vs none.
(defmethod compute-bounding-box ((this nav-mesh) (minimum vector) (maximum vector))
  "Store the world-space minimum and maximum vertex bounds."
  (let ((huge 10000000000000000000000000000000000000.0)
        (negative-huge -10000000000000000000000000000000000000.0))
    (set! (-> minimum x) huge)
    (set! (-> minimum y) huge)
    (set! (-> minimum z) huge)
    (set! (-> maximum x) negative-huge)
    (set! (-> maximum y) negative-huge)
    (set! (-> maximum z) negative-huge))
  (dotimes (vertex-index (-> this vertex-count))
    (let ((vertex (-> this vertex vertex-index)))
      (set! (-> minimum x) (fmin (-> minimum x) (-> vertex x)))
      (set! (-> minimum y) (fmin (-> minimum y) (-> vertex y)))
      (set! (-> minimum z) (fmin (-> minimum z) (-> vertex z)))
      (set! (-> maximum x) (fmax (-> maximum x) (-> vertex x)))
      (set! (-> maximum y) (fmax (-> maximum y) (-> vertex y)))
      (set! (-> maximum z) (fmax (-> maximum z) (-> vertex z)))))
  (vector+! minimum minimum (-> this origin))
  (vector+! maximum maximum (-> this origin))
  0
  (none))

;; definition for method 13 of type nav-mesh
;; INFO: Used lq/sq
;; INFO: Return type mismatch int vs none.
(defmethod initialize-mesh! ((this nav-mesh))
  "Validate the loaded mesh, warning about empty, degenerate, downward-facing,
   oversized, or all-gap triangle data."
  (with-pp
    (let ((normal (new 'stack-no-clear 'vector))
          (poly-count (-> this poly-count))
          (vertex-count (-> this vertex-count))
          (zero-area-count 0)
          (inverted-count 0)
          (gap-count 0)
          (warned #f))
      (let ((poly-index poly-count))
        (while (nonzero? poly-index)
          (+! poly-index -1)
          (let ((poly (-> this poly poly-index)))
            (if (logtest? (-> poly pat) 1) (+! gap-count 1))
            (let ((vertex-0 (-> this vertex (-> poly vertex 0)))
                  (vertex-1 (-> this vertex (-> poly vertex 1)))
                  (vertex-2 (-> this vertex (-> poly vertex 2))))
              (vector-3pt-cross! normal vertex-0 vertex-1 vertex-2)))
          (cond
            ((= (vector-length normal) 0.0) (+! zero-area-count 1))
            (else (vector-normalize! normal 1.0) (if (>= 0.0 (-> normal y)) (+! inverted-count 1))))))
      (when (zero? poly-count)
        (format #t "WARNING:  nav-mesh has no triangles. ")
        (set! warned #t))
      (when (> zero-area-count 0)
        (format #t "WARNING:  nav-mesh has ~D triangles with zero area (out of ~D triangles). " zero-area-count poly-count)
        (set! warned #t))
      (when (> inverted-count 0)
        (format #t
                "WARNING:  nav-mesh has ~D triangles with inverted normals (out of ~D triangles). "
                inverted-count
                poly-count)
        (set! warned #t))
      (when (< 255 poly-count)
        (format #t "WARNING:  nav-mesh has ~D triangles (only up to ~D are allowed). " poly-count 255)
        (set! warned #t))
      (when (< 255 vertex-count)
        (format #t "WARNING:  nav-mesh has ~D vertices (only up to ~D are allowed). " vertex-count 255)
        (set! warned #t))
      (when (= gap-count poly-count)
        (format #t "WARNING:  nav-mesh only contains gap triangles (~D triangles total). " poly-count)
        (set! warned #t))
      (when warned
        (if pp (format #t "current process is ~A~%" (-> pp name)) (format #t "(no current process).~%"))))
    0
    (none)))

;; definition for method 22 of type nav-mesh
(defmethod find-opposite-vertices ((this nav-mesh) (poly-a nav-poly) (poly-b nav-poly))
  "Pack the two shared-edge vertex indices of adjacent triangles, or
   #xffffffff when they do not share an oriented edge."
  (when (!= poly-a poly-b)
    (dotimes (a-index 3)
      (dotimes (b-index 3)
        (when (= (-> poly-a vertex a-index) (-> poly-b vertex b-index))
          (let ((next-vertex (-> poly-a vertex (mod (+ a-index 1) 3))))
            (dotimes (other-b-index 3)
              (if (and (!= other-b-index b-index) (= next-vertex (-> poly-b vertex other-b-index)))
                (return (logior next-vertex (shl (-> poly-a vertex a-index) 16))))))))))
  (the-as uint #xffffffff))

;; definition for function ray-ccw-line-segment-intersection?
(defun ray-ccw-line-segment-intersection? ((point vector) (direction vector) (segment-start vector) (segment-end vector))
  "Return whether the XZ ray from origin along direction crosses the directed segment from start to
   end on its counter-clockwise side."
  (let ((start-cross (- (* (-> segment-start x) (-> direction z)) (* (-> segment-start z) (-> direction x))))
        (end-cross (- (* (-> segment-end x) (-> direction z)) (* (-> segment-end z) (-> direction x))))
        (point-cross (- (* (-> point x) (-> direction z)) (* (-> point z) (-> direction x))))
        (intersects #f))
    (let ((denominator (- end-cross start-cross))
          (end-to-point (- end-cross point-cross))
          (point-to-start (- point-cross start-cross)))
      (when (and (>= (fabs denominator) (fmax (fabs point-to-start) (fabs end-to-point))) (!= denominator 0.0))
        (let ((orientation (+ (* (-> direction x) (- (-> segment-end z) (-> segment-start z)))
                              (* (-> direction z) (- (-> segment-start x) (-> segment-end x))))))
          (set! intersects (< 0.0 orientation)))))
    intersects))

;; definition for function ray-line-segment-intersection?
(defun ray-line-segment-intersection? ((point vector) (direction vector) (segment-start vector) (segment-end vector))
  "Return whether the XZ ray from origin along direction intersects the segment from start to end,
   independent of segment winding."
  (let ((start-cross (- (* (-> segment-start x) (-> direction z)) (* (-> segment-start z) (-> direction x))))
        (end-cross (- (* (-> segment-end x) (-> direction z)) (* (-> segment-end z) (-> direction x))))
        (point-cross (- (* (-> point x) (-> direction z)) (* (-> point z) (-> direction x))))
        (intersects #f))
    (let ((denominator (- end-cross start-cross))
          (end-to-point (- end-cross point-cross))
          (point-to-start (- point-cross start-cross)))
      (when (and (>= (fabs denominator) (fmax (fabs point-to-start) (fabs end-to-point))) (!= denominator 0.0))
        (let ((start-dot (+ (* (-> segment-start x) (-> direction x)) (* (-> segment-start z) (-> direction z))))
              (end-dot (+ (* (-> segment-end x) (-> direction x)) (* (-> segment-end z) (-> direction z))))
              (point-dot (+ (* (-> point x) (-> direction x)) (* (-> point z) (-> direction z)))))
          (if (>= (* (+ (* start-dot end-to-point) (* end-dot point-to-start)) (sign denominator)) (* point-dot (fabs denominator)))
            (set! intersects #t)))))
    intersects))

;; definition for symbol *debug-offset*, type vector
(define *debug-offset* (new 'static 'vector :y 4096.0 :w 1.0))

;; definition for function clip-vector-to-halfspace!
(defun clip-vector-to-halfspace! ((travel vector) (normal-x float) (normal-z float) (limit float))
  "If travel's XZ projection onto the supplied normal exceeds limit, scale its X and Z components
   uniformly so the projection equals limit. Leave Y unchanged; callers use the mutation rather
   than the incidental return value."
  (let ((projection (+ (* normal-x (-> travel x)) (* normal-z (-> travel z)))))
    (when (< limit projection)
      (let ((fraction (/ limit projection)))
        (set! (-> travel x) (* (-> travel x) fraction))
        (set! (-> travel z) (* (-> travel z) fraction))))))

;; definition for method 23 of type nav-mesh
;; INFO: Used lq/sq
(defmethod clip-travel-to-poly ((this nav-mesh) (poly nav-poly) (start-position vector) (result-travel vector) (desired-travel vector) (portal nav-route-portal))
  "Clip desired-travel against one triangle in XZ, store it in result-travel,
   and record the crossed neighbor in portal. At a boundary corner, a start point within five
   centimeters of an endpoint may continue through the adjacent edge."
  (local-vars
    (last-edge-index int)
    (wrapped-next-edge int)
    (before-first-edge int)
    (past-last-edge int)
    (wrapped-previous-edge int)
    (edge-end-vertex nav-vertex))
  (let ((vertices (-> this vertex))
        (clipped-edge -1))
    (set! (-> result-travel quad) (-> desired-travel quad))
    (dotimes (edge-index 3)
      (let* ((edge-start (-> vertices (-> poly vertex (-> *edge-vert0-table* edge-index))))
             (edge-end (-> vertices (-> poly vertex (-> *edge-vert1-table* edge-index))))
             (edge-normal-x (- (-> edge-start z) (-> edge-end z)))
             (edge-normal-z (- (-> edge-end x) (-> edge-start x)))
             (edge-distance (+ (* edge-normal-x (- (-> edge-start x) (-> start-position x)))
                               (* edge-normal-z (- (-> edge-start z) (-> start-position z)))))
             (travel-projection (+ (* (-> result-travel x) edge-normal-x) (* (-> result-travel z) edge-normal-z))))
        (when (< edge-distance travel-projection)
          (set! clipped-edge edge-index)
          (let ((fraction (/ edge-distance travel-projection)))
            (set! (-> result-travel x) (* (-> result-travel x) fraction))
            (set! (-> result-travel z) (* (-> result-travel z) fraction))))))
    (when portal
      (cond
        ((= clipped-edge -1) (set! (-> portal next-poly) #f))
        (else
         (while (!= clipped-edge -1)
           (let ((neighbor-index (-> poly adj-poly (-> *edge-vert0-table* clipped-edge))))
             (cond
               ((!= neighbor-index 255) (set! (-> portal next-poly) (-> this poly neighbor-index)) (set! clipped-edge -1))
               ((let ((edge-start-vertex (-> vertices (-> poly vertex (-> *edge-vert0-table* clipped-edge)))))
                  (set! edge-end-vertex (-> vertices (-> poly vertex (-> *edge-vert1-table* clipped-edge))))
                  (< (vector-vector-xz-distance start-position edge-start-vertex) 204.8))
                (let ((previous-edge (+ clipped-edge -1)))
                  (set! last-edge-index 2)
                  (set-on-less-than before-first-edge previous-edge 0)
                  (move-if-not-zero wrapped-previous-edge last-edge-index before-first-edge previous-edge))
                (set! clipped-edge wrapped-previous-edge))
               ((< (vector-vector-xz-distance start-position edge-end-vertex) 204.8)
                (let ((next-edge (+ clipped-edge 1)))
                  (set! last-edge-index 2)
                  (set-on-less-than past-last-edge last-edge-index next-edge)
                  (move-if-not-zero wrapped-next-edge 0 past-last-edge next-edge))
                (set! clipped-edge wrapped-next-edge))
               (else (set! (-> portal next-poly) #f) (set! clipped-edge -1)))))))))
  (set! (-> result-travel y) (-> start-position y))
  result-travel)

;; definition for method 25 of type nav-mesh
;; INFO: Used lq/sq
(defmethod project-point-into-tri-3d ((this nav-mesh) (poly nav-poly) (result vector) (point vector))
  "Project point onto poly's 3D plane and store the result."
  (let ((normal (new 'stack-no-clear 'vector))
        (triangle (new 'stack-no-clear 'matrix)))
    (dotimes (i 3)
      (set! (-> triangle vector i quad) (the-as uint128 0)))
    (set! (-> triangle vector 0 quad) (-> this vertex (-> poly vertex 0) quad))
    (set! (-> triangle vector 1 quad) (-> this vertex (-> poly vertex 1) quad))
    (set! (-> triangle vector 2 quad) (-> this vertex (-> poly vertex 2) quad))
    (normal-of-plane normal (-> triangle vector 0) (-> triangle vector 1) (-> triangle vector 2))
    (closest-pt-in-triangle result point triangle normal))
  (none))

;; definition for method 17 of type nav-control
;; INFO: Used lq/sq
(defmethod project-onto-nav-mesh ((this nav-control) (result vector) (point vector))
  "Store a world-space point projected onto the navigation mesh."
  (let* ((mesh (-> this mesh))
         (point-local (vector-! (new 'stack-no-clear 'vector) point (-> this mesh origin)))
         (find-flags 0)
         (poly (find-poly mesh point-local (-> this nearest-y-threshold) (the-as (pointer nav-control-flags) (& find-flags)))))
    (cond
      ((logtest? #x100000 find-flags) (set! (-> result quad) (-> point quad)))
      (else (closest-point-on-boundary mesh poly result point-local) (vector+! result result (-> mesh origin)))))
  result)

;; definition for method 18 of type nav-control
(defmethod find-poly ((this nav-control) (point vector))
  "Find the navigation triangle containing a world-space point."
  (find-poly (-> this mesh)
             (vector-! (new 'stack-no-clear 'vector) point (-> this mesh origin))
             (-> this nearest-y-threshold)
             (the-as (pointer nav-control-flags) #f)))

;; definition for method 20 of type nav-control
(defmethod project-point-into-tri-3d ((this nav-control) (poly nav-poly) (result vector) (point vector))
  "Project a world-space point onto poly and store the world-space
   result."
  (project-point-into-tri-3d (-> this mesh)
                             poly
                             result
                             (vector-! (new 'stack-no-clear 'vector) point (-> this mesh origin)))
  (vector+! result result (-> this mesh origin))
  result)

;; definition for method 25 of type nav-control
(defmethod is-in-mesh? ((this nav-control) (point vector) (radius float))
  "Return whether a world-space circle overlaps the navigation mesh."
  (let ((point-local (vector-! (new 'stack-no-clear 'vector) point (-> this mesh origin)))
        (mesh (-> this mesh)))
    (is-in-mesh? mesh point-local radius (-> this nearest-y-threshold))))

;; definition for method 9 of type nav-control
;; INFO: Used lq/sq
;; INFO: Return type mismatch int vs none.
(defmethod debug-draw ((this nav-control))
  "Draw the enabled mesh, route, travel, and obstacle-sphere debug layers."
  (let ((control this))
    (when (and *display-nav-marks* (logtest? (-> control flags) (nav-control-flags display-marks)))
      (let ((mesh (-> this mesh))
            (temporary-point (new 'stack-no-clear 'vector)))
        (= (-> this mesh debug-time) (logand (-> *display* actual-frame-counter) 255))
        (when #t
          (set! (-> mesh debug-time) (the-as uint (-> *display* actual-frame-counter)))
          (add-debug-sphere (logtest? (-> this flags) (nav-control-flags display-bounds-sphere))
                            (bucket-id debug)
                            (-> mesh bounds)
                            (-> mesh bounds w)
                            (new 'static 'rgba :r #xff :g #xff :a #x20))
          (add-debug-vector #t (bucket-id debug-no-zbuf) (-> mesh origin) *x-vector* (meters 1) *color-red*)
          (add-debug-vector #t (bucket-id debug-no-zbuf) (-> mesh origin) *z-vector* (meters 1) *color-blue*)
          (when (logtest? (-> this flags) (nav-control-flags display-vertices))
            (dotimes (vertex-index (-> mesh vertex-count))
              (add-debug-x #t
                           (bucket-id debug-no-zbuf)
                           (vector+! temporary-point (-> mesh origin) (the-as vector (-> mesh vertex vertex-index)))
                           *color-green*)))
          (when #f
            (dotimes (node-index (-> mesh node-count))
              (let ((node (-> mesh nodes node-index))
                    (node-center (new 'stack-no-clear 'vector))
                    (node-radius (new 'stack-no-clear 'vector))
                    (corner-0 (new 'stack-no-clear 'vector))
                    (corner-1 (new 'stack-no-clear 'vector))
                    (corner-2 (new 'stack-no-clear 'vector))
                    (corner-3 (new 'stack-no-clear 'vector))
                    (box-color (the-as uint #x80808080)))
                (set! (-> node-center quad) (-> node center quad))
                (set! (-> node-radius quad) (-> node radius quad))
                (set! (-> corner-0 w) 1.0)
                (set! (-> corner-1 w) 1.0)
                (set! (-> corner-2 w) 1.0)
                (set! (-> corner-3 w) 1.0)
                (set! (-> corner-0 x) (+ (-> node-center x) (-> node-radius x)))
                (set! (-> corner-0 y) (+ (-> node-center y) (-> node-radius y)))
                (set! (-> corner-0 z) (+ (-> node-center z) (-> node-radius z)))
                (set! (-> corner-1 x) (+ (-> node-center x) (-> node-radius x)))
                (set! (-> corner-1 y) (+ (-> node-center y) (-> node-radius y)))
                (set! (-> corner-1 z) (- (-> node-center z) (-> node-radius z)))
                (set! (-> corner-2 x) (- (-> node-center x) (-> node-radius x)))
                (set! (-> corner-2 y) (+ (-> node-center y) (-> node-radius y)))
                (set! (-> corner-2 z) (- (-> node-center z) (-> node-radius z)))
                (set! (-> corner-3 x) (- (-> node-center x) (-> node-radius x)))
                (set! (-> corner-3 y) (+ (-> node-center y) (-> node-radius y)))
                (set! (-> corner-3 z) (+ (-> node-center z) (-> node-radius z)))
                (add-debug-line #t (bucket-id debug-no-zbuf) corner-0 corner-1 (the-as rgba box-color) #f (the-as rgba -1))
                (add-debug-line #t (bucket-id debug-no-zbuf) corner-1 corner-2 (the-as rgba box-color) #f (the-as rgba -1))
                (add-debug-line #t (bucket-id debug-no-zbuf) corner-2 corner-3 (the-as rgba box-color) #f (the-as rgba -1))
                (add-debug-line #t (bucket-id debug-no-zbuf) corner-3 corner-0 (the-as rgba box-color) #f (the-as rgba -1)))))
          (when (logtest? (-> this flags) (nav-control-flags display-polys))
            (dotimes (poly-index (-> mesh poly-count))
              (let ((poly (-> mesh poly poly-index)))
                (debug-draw-poly mesh
                                 poly
                                 (cond
                                   ((logtest? (-> poly pat) 1) (new 'static 'rgba :g #x80 :b #x80 :a #x40))
                                   ((logtest? (-> poly pat) 2) (new 'static 'rgba :g #xff :b #x80 :a #x40))
                                   ((logtest? (-> poly pat) 4) (new 'static 'rgba :g #xff :b #x40 :a #x80))
                                   ((logtest? (-> poly pat) 8) (new 'static 'rgba :g #x80 :b #x40 :a #xff))
                                   ((logtest? (-> poly pat) 16) (new 'static 'rgba :g #x80 :b #x40 :a #xff))
                                   (else (new 'static 'rgba :g #x80 :b #xff :a #x80))))
                (when (logtest? (-> this flags) (nav-control-flags display-poly-ids))
                  (let ((text-function add-debug-text-3d)
                        (text-enabled #t)
                        (text-bucket 68))
                    (format (clear *temp-string*) "~D" (-> poly id))
                    (text-function text-enabled
                                   (the-as bucket-id text-bucket)
                                   *temp-string*
                                   (tri-centroid-world mesh poly temporary-point)
                                   (font-color cyan)
                                   (the-as vector2h #f)))))))
          (when (logtest? (-> this flags) (nav-control-flags display-active-polys))
            (if (-> this next-poly) (debug-draw-poly mesh (-> this next-poly) *color-cyan*))
            (if (-> this target-poly) (debug-draw-poly mesh (-> this target-poly) *color-yellow*))
            (if (-> this current-poly) (debug-draw-poly mesh (-> this current-poly) *color-red*)))
          (when (logtest? (-> this flags) (nav-control-flags display-spheres))
            (dotimes (static-sphere-index (the-as int (-> mesh static-sphere-count)))
              (let ((static-sphere (-> mesh static-sphere static-sphere-index)))
                (add-debug-sphere #t (bucket-id debug) (the-as vector static-sphere) (-> static-sphere trans w) *color-blue*)
                (let ((sphere-text-function add-debug-text-3d)
                      (sphere-text-enabled #t)
                      (sphere-text-bucket 68))
                  (format (clear *temp-string*) "~D" static-sphere-index)
                  (sphere-text-function sphere-text-enabled
                                        (the-as bucket-id sphere-text-bucket)
                                        *temp-string*
                                        (the-as vector static-sphere)
                                        (font-color cyan)
                                        (the-as vector2h #f)))))))
        (when (logtest? (-> this flags) (nav-control-flags display-travel))
          (when (and (-> this portal 0) (-> this portal 1))
            (let ((origin (-> mesh origin))
                  (portal-start (new 'stack-no-clear 'vector))
                  (portal-end (new 'stack-no-clear 'vector)))
              (add-debug-line #t
                              (bucket-id debug-no-zbuf)
                              (vector+! portal-start origin (the-as vector (-> this portal 0)))
                              (vector+! portal-end origin (the-as vector (-> this portal 1)))
                              (new 'static 'rgba :r #xff :g #x80 :b #x40 :a #x80)
                              #f
                              (the-as rgba -1))))
          (add-debug-vector #t
                            (bucket-id debug-no-zbuf)
                            (-> this shape trans)
                            (-> this travel)
                            (meters 0.00024414062)
                            *color-white*)
          (add-debug-vector #t
                            (bucket-id debug-no-zbuf)
                            (vector+! (new 'stack-no-clear 'vector) (-> this shape trans) (new 'static 'vector :y 4096.0 :w 1.0))
                            (-> this old-travel)
                            (meters 0.00024414062)
                            *color-yellow*)
          (add-debug-x #t
                       (bucket-id debug-no-zbuf)
                       (vector+! (new 'stack-no-clear 'vector) (-> this shape trans) (-> this travel))
                       (new 'static 'rgba :r #xff :g #xff :b #xff :a #x80)))
        (when (logtest? (-> this flags) (nav-control-flags display-spheres))
          (add-debug-sphere #t
                            (bucket-id debug-no-zbuf)
                            (-> this shape root-prim prim-core world-sphere)
                            (-> this shape nav-radius)
                            (new 'static 'rgba :g #xff :b #xff :a #x20))
          (dotimes (sphere-index (-> this num-spheres))
            (let ((obstacle-sphere (-> this sphere sphere-index)))
              (vector+! temporary-point (-> mesh origin) (the-as vector (&-> obstacle-sphere x)))
              (add-debug-sphere #t
                                (bucket-id debug-no-zbuf)
                                temporary-point
                                (- (-> obstacle-sphere w) (-> this shape nav-radius))
                                (new 'static 'rgba :g #xff :b #xff :a #x20))))))
      0))
  (none))

;; definition for method 8 of type nav-mesh
;; INFO: Return type mismatch int vs nav-mesh.
(defmethod mem-usage ((this nav-mesh) (usage memory-usage-block) (flags int))
  "Add the mesh object, vertex array, triangle array, and packed route
   table allocations to the navigation memory-usage bucket."
  (set! (-> usage length) (max 46 (-> usage length)))
  (set! (-> usage data 45 name) "nav-mesh")
  (+! (-> usage data 45 count) 1)
  (let ((object-bytes (asize-of this)))
    (+! (-> usage data 45 used) object-bytes)
    (+! (-> usage data 45 total) (logand -16 (+ object-bytes 15))))
  (set! (-> usage length) (max 46 (-> usage length)))
  (set! (-> usage data 45 name) "nav-mesh")
  (+! (-> usage data 45 count) 1)
  (let ((vertex-bytes (* (-> this vertex-count) 16)))
    (+! (-> usage data 45 used) vertex-bytes)
    (+! (-> usage data 45 total) (logand -16 (+ vertex-bytes 15))))
  (set! (-> usage length) (max 46 (-> usage length)))
  (set! (-> usage data 45 name) "nav-mesh")
  (+! (-> usage data 45 count) 1)
  (let ((poly-bytes (* (-> this poly-count) 8)))
    (+! (-> usage data 45 used) poly-bytes)
    (+! (-> usage data 45 total) (logand -16 (+ poly-bytes 15))))
  (set! (-> usage length) (max 46 (-> usage length)))
  (set! (-> usage data 45 name) "nav-mesh")
  (+! (-> usage data 45 count) 1)
  (let ((route-bytes (/ (* (* (-> this poly-count) (-> this poly-count)) 2) 8)))
    (+! (-> usage data 45 used) route-bytes)
    (+! (-> usage data 45 total) (logand -16 (+ route-bytes 15))))
  (the-as nav-mesh 0))

;; definition for method 14 of type nav-control
;; INFO: Return type mismatch int vs none.
(defmethod set-current-poly! ((this nav-control) (poly nav-poly))
  "Set the current triangle and mark it as explicitly supplied this frame."
  (set! (-> this current-poly) poly)
  (logior! (-> this flags) (nav-control-flags current-poly-set))
  0
  (none))

;; definition for method 30 of type nav-control
(defmethod find-deepest-sphere-along-ray ((this nav-control) (ray-origin vector) (ray-direction vector) (hit-position vector))
  "Return the avoidance sphere most deeply overlapped by the ray,
   or #f when there is no hit."
  (let ((best-sphere (the-as sphere #f)))
    (let ((best-hit-distance -0.000001))
      (countdown (sphere-index (-> this num-spheres))
        (let* ((obstacle-sphere (-> this sphere sphere-index))
               (hit-distance (ray-circle-intersect ray-origin ray-direction (the-as vector (&-> obstacle-sphere x)) (-> obstacle-sphere w))))
          (when (< best-hit-distance hit-distance)
            (set! best-sphere obstacle-sphere)
            (set! best-hit-distance hit-distance))))
      (set! (-> hit-position x) best-hit-distance))
    best-sphere))

;; definition for method 31 of type nav-control
(defmethod intersect-ray-line-segment? ((this nav-control) (point vector) (direction vector) (segment-start vector) (segment-end vector))
  "Return whether the XZ ray from point along direction intersects
   the finite segment."
  (ray-line-segment-intersection? point direction segment-start segment-end))

;; definition for function add-nav-sphere
;; INFO: Return type mismatch int vs none.
(defun add-nav-sphere ((control nav-control) (world-sphere vector))
  "Append a world-space obstacle sphere to control in mesh-local coordinates when capacity permits."
  (when (< (-> control num-spheres) (-> control max-spheres))
    (let ((destination (-> control sphere (-> control num-spheres)))
          (distance-squared (vector-vector-xz-distance-squared world-sphere (-> control shape trans)))
          (combined-radius (+ (-> world-sphere w) (-> control shape nav-radius))))
      (when (< distance-squared (square (+ 40960.0 combined-radius)))
        (vector-! (the-as vector destination) world-sphere (-> control mesh origin))
        (set! (-> destination w) combined-radius)
        (+! (-> control num-spheres) 1))))
  0
  (none))

;; definition for function add-collide-shape-spheres
;; INFO: Used lq/sq
;; INFO: Return type mismatch int vs none.
(defun add-collide-shape-spheres ((control nav-control) (shape collide-shape) (body-sphere vector))
  "Append shape's enabled body and extra navigation spheres to control, combining each radius with
   the navigating body's radius and rejecting spheres beyond the ten-meter cull range."
  (when (logtest? (-> shape nav-flags) (nav-flags avoid-body))
    (set! (-> body-sphere quad) (-> shape root-prim prim-core world-sphere quad))
    (set! (-> body-sphere w) (-> shape nav-radius))
    (let ((body-control control)
          (body-sphere-input body-sphere))
      (when (< (-> body-control num-spheres) (-> body-control max-spheres))
        (let ((body-destination (-> body-control sphere (-> body-control num-spheres)))
              (body-distance-squared (vector-vector-xz-distance-squared body-sphere-input (-> body-control shape trans)))
              (body-combined-radius (+ (-> body-sphere-input w) (-> body-control shape nav-radius))))
          (when (< body-distance-squared (square (+ 40960.0 body-combined-radius)))
            (vector-! (the-as vector body-destination) body-sphere-input (-> body-control mesh origin))
            (set! (-> body-destination w) body-combined-radius)
            (+! (-> body-control num-spheres) 1)))))
    0)
  (when (logtest? (-> shape nav-flags) (nav-flags avoid-extra-sphere))
    (let ((extra-sphere (-> shape process nav extra-nav-sphere)))
      (when (< (-> control num-spheres) (-> control max-spheres))
        (let ((extra-destination (-> control sphere (-> control num-spheres)))
              (extra-distance-squared (vector-vector-xz-distance-squared extra-sphere (-> control shape trans)))
              (extra-combined-radius (+ (-> extra-sphere w) (-> control shape nav-radius))))
          (when (< extra-distance-squared (square (+ 40960.0 extra-combined-radius)))
            (vector-! (the-as vector extra-destination) extra-sphere (-> control mesh origin))
            (set! (-> extra-destination w) extra-combined-radius)
            (+! (-> control num-spheres) 1)))))
    0)
  (none))

;; definition for method 28 of type nav-control
;; INFO: Used lq/sq
;; INFO: Return type mismatch int vs none.
;; The steering pass consumes one compact mesh-local sphere array. Rebuild it from the player,
;; authored static obstacles, and the other live navigation users, combining every obstacle radius
;; with this body's navigation radius and culling anything farther than ten meters.
(defmethod gather-nav-spheres! ((this nav-control) (collision-mask collide-kind))
  "Rebuild the mesh-local obstacle-sphere list from the player, authored
   static spheres, and other navigation users. collision-mask filters the other users' collision
   kinds."
  (set! (-> this num-spheres) 0)
  (let ((user-list (-> this mesh user-list))
        (candidate-sphere (new 'stack-no-clear 'vector)))
    (when (and *target*
               (or (logtest? (-> this flags) (nav-control-flags avoid-player))
                   (logtest? (-> *target* state-flags)
                             (state-flags being-attacked invulnerable timed-invulnerable invuln-powerup do-not-notice dying))))
      (let ((player-nav this)
            (target-control (-> *target* control)))
        (let ((player-body-sphere candidate-sphere))
          (when (logtest? (-> target-control nav-flags) (nav-flags avoid-body))
            (set! (-> player-body-sphere quad) (-> target-control root-prim prim-core world-sphere quad))
            (set! (-> player-body-sphere w) (-> target-control nav-radius))
            (let ((player-destination-control player-nav))
              (when (< (-> player-destination-control num-spheres) (-> player-destination-control max-spheres))
                (let ((player-body-destination (-> player-destination-control sphere (-> player-destination-control num-spheres)))
                      (player-body-distance-squared (vector-vector-xz-distance-squared player-body-sphere (-> player-destination-control shape trans)))
                      (player-body-combined-radius (+ (-> player-body-sphere w) (-> player-destination-control shape nav-radius))))
                  (when (< player-body-distance-squared (square (+ 40960.0 player-body-combined-radius)))
                    (vector-! (the-as vector player-body-destination) player-body-sphere (-> player-destination-control mesh origin))
                    (set! (-> player-body-destination w) player-body-combined-radius)
                    (+! (-> player-destination-control num-spheres) 1)))))
            0))
        (when (logtest? (-> target-control nav-flags) (nav-flags avoid-extra-sphere))
          (let ((player-extra-sphere (-> target-control process nav extra-nav-sphere)))
            (when (< (-> player-nav num-spheres) (-> player-nav max-spheres))
              (let ((player-extra-destination (-> player-nav sphere (-> player-nav num-spheres)))
                    (player-extra-distance-squared (vector-vector-xz-distance-squared player-extra-sphere (-> player-nav shape trans)))
                    (player-extra-combined-radius (+ (-> player-extra-sphere w) (-> player-nav shape nav-radius))))
                (when (< player-extra-distance-squared (square (+ 40960.0 player-extra-combined-radius)))
                  (vector-! (the-as vector player-extra-destination) player-extra-sphere (-> player-nav mesh origin))
                  (set! (-> player-extra-destination w) player-extra-combined-radius)
                  (+! (-> player-nav num-spheres) 1)))))
          0)))
    (when (logtest? (-> this flags) (nav-control-flags avoid-static-spheres))
      (countdown (static-sphere-index (-> this mesh static-sphere-count))
        (let ((static-destination-control this)
              (static-sphere (-> this mesh static-sphere static-sphere-index)))
          (when (< (-> static-destination-control num-spheres) (-> static-destination-control max-spheres))
            (let ((static-destination (-> static-destination-control sphere (-> static-destination-control num-spheres)))
                  (static-distance-squared (vector-vector-xz-distance-squared (the-as vector static-sphere) (-> static-destination-control shape trans)))
                  (static-combined-radius (+ (-> static-sphere trans w) (-> static-destination-control shape nav-radius))))
              (when (< static-distance-squared (square (+ 40960.0 static-combined-radius)))
                (vector-! (the-as vector static-destination) (the-as vector static-sphere) (-> static-destination-control mesh origin))
                (set! (-> static-destination w) static-combined-radius)
                (+! (-> static-destination-control num-spheres) 1)))))
        0))
    (let* ((user-connection (-> user-list alive-list next0))
           (next-connection (-> user-connection next0)))
      (while (!= user-connection (-> user-list alive-list-end))
        (let ((other-shape (the-as collide-shape (-> (the-as connection user-connection) param3))))
          (when (not (or (= other-shape (-> this shape)) (not (logtest? collision-mask (-> other-shape root-prim prim-core collide-as)))))
            (let ((other-nav this))
              (let ((sv-112 candidate-sphere))
                (when (logtest? (-> other-shape nav-flags) (nav-flags avoid-body))
                  (set! (-> sv-112 quad) (-> other-shape root-prim prim-core world-sphere quad))
                  (set! (-> sv-112 w) (-> other-shape nav-radius))
                  (let ((sv-80 other-nav))
                    (when (< (-> sv-80 num-spheres) (-> sv-80 max-spheres))
                      (let ((sv-96 (-> sv-80 sphere (-> sv-80 num-spheres)))
                            (f1-3 (vector-vector-xz-distance-squared sv-112 (-> sv-80 shape trans)))
                            (f0-9 (+ (-> sv-112 w) (-> sv-80 shape nav-radius))))
                        ;; og:preserve-this added a NaN check here. it seems like some enemies have bogus positions (maybe on their first frame?)
                        (when (and (< f1-3 (square (+ 40960.0 f0-9))) (not (is-nan? (-> sv-112 x))))
                          (vector-! (the-as vector sv-96) sv-112 (-> sv-80 mesh origin))
                          (set! (-> sv-96 w) f0-9)
                          (+! (-> sv-80 num-spheres) 1)))))
                  0))
              (when (logtest? (-> other-shape nav-flags) (nav-flags avoid-extra-sphere))
                (let ((other-extra-sphere (-> other-shape process nav extra-nav-sphere)))
                  (when (< (-> other-nav num-spheres) (-> other-nav max-spheres))
                    (let ((other-extra-destination (-> other-nav sphere (-> other-nav num-spheres)))
                          (other-extra-distance-squared (vector-vector-xz-distance-squared other-extra-sphere (-> other-nav shape trans)))
                          (other-extra-combined-radius (+ (-> other-extra-sphere w) (-> other-nav shape nav-radius))))
                      (when (< other-extra-distance-squared (square (+ 40960.0 other-extra-combined-radius)))
                        (vector-! (the-as vector other-extra-destination) other-extra-sphere (-> other-nav mesh origin))
                        (set! (-> other-extra-destination w) other-extra-combined-radius)
                        (+! (-> other-nav num-spheres) 1)))))
                0))))
        (set! user-connection next-connection)
        (set! next-connection (-> next-connection next0)))))
  0
  (none))

;; definition for method 35 of type nav-control
;; INFO: Return type mismatch symbol vs none.
(defmethod avoid-spheres-world ((this nav-control) (result-travel vector) (world-position vector) (desired-travel vector) (fallback-direction vector) (unused float))
  "Deflect travel around spheres using a world-space start position."
  (let ((local-position (new 'stack-no-clear 'vector)))
    (vector-! local-position world-position (-> this mesh origin))
    (avoid-spheres this result-travel local-position desired-travel fallback-direction unused))
  (none))

;; definition of type cfs-travel-vec
(deftype cfs-travel-vec (structure)
  ((dir         vector :inline)
   (delta-angle float)))

;; definition of type cfs-work
(deftype cfs-work (structure)
  ((desired-travel-dist float)
   (desired-angle       float)
   (max-dist            float)
   (old-angle           float)
   (modified            int32)
   (blocked-mask        uint64)
   (travel              vector :inline)
   (current             vector :inline)
   (new-travel          cfs-travel-vec 2 :inline)
   (temp-travel         cfs-travel-vec 2 :inline)
   (prev-dir            vector :inline)
   (attempt-dir         vector :inline)
   (tangent             vector 2 :inline)))

;; definition of type nav-control-cfs-work
(deftype nav-control-cfs-work (structure)
  ((in-dir              vector :inline)
   (right-dir           vector :inline)
   (best-dir            vector 2 :inline)
   (temp-dir            vector 2 :inline)
   (away-dir            vector :inline)
   (best-dir-angle      float 2)
   (ignore-mask         uint64)
   (initial-ignore-mask uint64)
   (i-sphere            int32)
   (i-first-sphere      int32)
   (i-inside-sphere     int32)
   (inside-sphere-dist  float)
   (sign                float)
   (travel-len          float)
   (dist2               float)
   (inside-dist         float)
   (rand-angle          float)
   (dir-update          basic)
   (debug-offset        vector :inline)))

;; definition for function circle-tangent-directions
;; INFO: Used lq/sq
;; The tangent direction is the sum of a component toward the center and a perpendicular component.
;; Their magnitudes are the legs of the right triangle formed by point, circle center, and tangency
;; point; changing the perpendicular sign produces the left and right candidates.
(defun circle-tangent-directions ((point vector) (circle-center vector) (result-left vector) (result-right vector))
  "Store the two unit XZ directions from point tangent to the circle whose center is circle-center's
   XYZ and whose radius is its W component. Clamp an inside point to the center distance so the
   tangent calculation remains defined."
  (let ((to-center (new 'stack-no-clear 'vector))
        (center-direction (new 'stack-no-clear 'vector))
        (perpendicular-direction (new 'stack-no-clear 'vector)))
    (vector-! to-center circle-center point)
    (set! (-> to-center y) 0.0)
    (vector-normalize-copy! center-direction to-center 1.0)
    (set! (-> perpendicular-direction quad) (-> center-direction quad))
    (set! (-> perpendicular-direction x) (-> center-direction z))
    (set! (-> perpendicular-direction z) (- (-> center-direction x)))
    (let ((radius (-> circle-center w))
          (center-distance (vector-dot center-direction to-center)))
      (if (< center-distance radius) (set! radius center-distance))
      (let* ((tangent-length (sqrtf (- (square center-distance) (square radius))))
             (inverse-distance (/ 1.0 center-distance))
             (along-fraction (* tangent-length inverse-distance))
             (perpendicular-fraction (* radius inverse-distance))
             (along-component (new 'stack-no-clear 'vector)))
        (vector-float*! along-component center-direction along-fraction)
        (vector+*! result-left along-component perpendicular-direction perpendicular-fraction)
        (vector+*! result-right along-component perpendicular-direction (- perpendicular-fraction))))))

;; definition for function find-closest-circle-ray-intersection
(defun find-closest-circle-ray-intersection ((start-position vector)
        (direction vector)
        (length float)
        (sphere-count int)
        (spheres (inline-array vector))
        (ignore-mask int))
  "Return the nearest sphere index hit by the finite XZ ray, or -1. Set bits in ignore-mask skip the
   corresponding entries in spheres."
  (let ((best-hit 1.0)
        (best-index -1))
    (let ((travel (new 'stack-no-clear 'vector)))
      (vector-float*! travel direction length)
      (dotimes (sphere-index sphere-count)
        (when (not (logtest? ignore-mask (ash 1 sphere-index)))
          (let* ((obstacle-sphere (-> spheres sphere-index))
                 (hit (ray-circle-intersect start-position travel obstacle-sphere (-> obstacle-sphere w))))
            (when (and (>= hit 0.0) (< hit best-hit))
              (set! best-hit hit)
              (set! best-index sphere-index))))))
    best-index))

;; definition for function sign-bit
(defun sign-bit ((value int))
  "Return one when value's low 32-bit signed representation is negative, otherwise zero."
  (local-vars (shifted-sign int))
  (let ((value-copy value)) (shift-arith-right-32 shifted-sign value-copy 31))
  (logand shifted-sign 1))

;; definition for function compute-dir-parm
(defun compute-dir-parm ((direction vector) (input-direction vector) (right-direction vector))
  "Return a signed turn cost for direction: one minus its dot product with input-direction, with the
   sign selected by which side of right-direction it lies on."
  (local-vars (right-dot-sign int))
  (let ((sign-selector (new 'static 'vector :x 1.0 :y -1.0)))
    (let ((right-dot-bits (vector-dot direction right-direction))) (shift-arith-right-32 right-dot-sign right-dot-bits 31))
    (* (-> sign-selector data (logand right-dot-sign 1)) (- 1.0 (vector-dot direction input-direction)))))

;; definition for method 32 of type nav-control
;; INFO: Used lq/sq
;; Follow a tangent chain on both sides of the obstacle set. Each candidate begins at the first
;; sphere on the straight path, chooses the tangent with the smaller turn from the input direction,
;; and repeats until that ray is clear. When the start lies inside a sphere, blend both candidates
;; toward an escape direction before selecting the final side. The fallback direction only breaks
;; ties when both candidates turn more than ten degrees away from the desired heading.
(defmethod avoid-spheres ((this nav-control) (result-travel vector) (start-position vector) (desired-travel vector) (fallback-direction vector) (unused float))
  "Store a travel vector that avoids the mesh-local obstacle spheres. When the
   straight path is blocked, follow tangent candidates around both sides of the obstacle chain, blend
   away from any sphere containing the start, and choose the candidate closest to the desired or
   fallback direction. Return #t when travel was deflected."
  (local-vars (deflected symbol) (hit-sphere int) (right-dot-sign int) (tangent-right-dot-sign int))
  (let ((work (new 'stack-no-clear 'nav-control-cfs-work)))
    (set! (-> work in-dir quad) (-> desired-travel quad))
    (set! (-> work in-dir y) 0.0)
    (vector-normalize! (-> work in-dir) 1.0)
    (set! (-> work travel-len) (vector-dot (-> work in-dir) desired-travel))
    (set! (-> work right-dir quad) (-> work in-dir quad))
    (set! (-> work right-dir x) (- (-> work in-dir z)))
    (set! (-> work right-dir z) (-> work in-dir x))
    (set! (-> work best-dir 0 quad) (-> work in-dir quad))
    (set! (-> work best-dir 1 quad) (-> work in-dir quad))
    (set! (-> work best-dir-angle 0) 0.0)
    (set! (-> work best-dir-angle 1) 0.0)
    (set! (-> work initial-ignore-mask) (the-as uint 0))
    (set! (-> work i-inside-sphere) -1)
    (set! (-> work inside-sphere-dist) 0.0)
    (dotimes (sphere-index (-> this num-spheres))
      (let ((obstacle-sphere (-> this sphere sphere-index)))
        (set! (-> work dist2) (vector-vector-xz-distance-squared start-position obstacle-sphere))
        (when (< (-> work dist2) (square (-> obstacle-sphere w)))
          (vector-! (-> work temp-dir 0) start-position (the-as vector obstacle-sphere))
          (set! (-> work temp-dir 0 y) 0.0)
          (if (< 0.0 (vector-dot (-> work temp-dir 0) (-> work in-dir))) (+! (-> work initial-ignore-mask) (ash 1 sphere-index)))
          (set! (-> work inside-dist) (- (-> obstacle-sphere w) (sqrtf (-> work dist2))))
          (when (< (-> work inside-sphere-dist) (-> work inside-dist))
            (set! (-> work i-inside-sphere) sphere-index)
            (set! (-> work inside-sphere-dist) (-> work inside-dist))))))
    (set! (-> work i-first-sphere)
          (find-closest-circle-ray-intersection start-position
                                                (-> work in-dir)
                                                (-> work travel-len)
                                                (-> this num-spheres)
                                                (-> this sphere)
                                                (the-as int (-> work initial-ignore-mask))))
    (when (= (-> work i-first-sphere) -1)
      (set! (-> result-travel quad) (-> desired-travel quad))
      (set! deflected #f)
      (b! #t cfg-46 :delay (nop!))
      (the-as none 0))
    (+! (-> work initial-ignore-mask) (ash 1 (-> work i-first-sphere)))
    (let ((first-obstacle-sphere (-> this sphere (-> work i-first-sphere))))
      (circle-tangent-directions start-position first-obstacle-sphere (-> work temp-dir 0) (-> work temp-dir 1)))
    (dotimes (i 2)
      (let ((right-dot-bits (vector-dot (-> work right-dir) (-> work temp-dir i))))
        (shift-arith-right-32 right-dot-sign right-dot-bits 31))
      (let ((candidate-side (logand right-dot-sign 1))
            (turn-cost (- 1.0 (vector-dot (-> work in-dir) (-> work temp-dir i)))))
        (set! (-> work best-dir candidate-side quad) (-> work temp-dir i quad))
        (set! (-> work best-dir-angle candidate-side) turn-cost)))
    0
    (set! (-> work sign) 1.0)
    (dotimes (side 2)
      (-> work i-first-sphere)
      (set! (-> work dir-update) #t)
      (set! (-> work ignore-mask) (-> work initial-ignore-mask))
      (b! #t cfg-31 :delay (nop!))
      (label cfg-22)
      (+! (-> work ignore-mask) (ash 1 hit-sphere))

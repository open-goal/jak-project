;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/entity/actor-link-h.gc")
(require "engine/draw/drawable-h.gc")
(require "engine/game/main-h.gc")
(require "engine/collide/collide-shape-h.gc")
(declare-type nav-mesh basic)

(declare-type nav-node structure)

(define-extern recursive-inside-poly (function nav-mesh nav-node vector float int))

(defenum nav-control-flags
  :bitfield #t
  :type uint32
  (display-marks 0) ;; master debug-display enable
  (display-bounds-sphere 1)
  (display-vertices 2)
  (display-polys 3)
  (display-poly-ids 4)
  (display-active-polys 5)
  (display-travel 6)
  (display-spheres 7)
  (enable-sphere-avoidance 8) ;; rebuild the obstacle-sphere list each update
  (current-poly-set 9) ;; set by set-current-poly! and cleared each update
  (gradual-turn-to-target 10)
  (avoid-player 11)
  (stop-at-boundary 12)
  (avoid-static-spheres 13)
  (blocked 17)
  (navcf18 18) ;; cleared each update
  (reached-destination 19)
  (point-inside-mesh 20)
  (heading-aligned 21))

;; DECOMP BEGINS

;; Nav mesh triangle. In jak 1, nav-poly is always a triangle.
(deftype nav-poly (structure)
  ((id uint8)
   (vertex uint8 3)    ;; index into mesh vertex table
   (adj-poly uint8 3)  ;; 255 for no neighbor
   (pat uint8))        ;; first bit set on gaps, other bits used for colors
  :pack-me)

(deftype nav-vertex (vector)
  "One mesh-local navigation vertex."
  ())

(deftype nav-sphere (structure)
  "A world-space obstacle sphere."
  ((trans sphere :inline)))

(deftype nav-ray (structure)
  "State for walking an XZ ray across adjacent triangles. The walk terminates on its destination,
a mesh boundary, or a gap triangle, recording the last edge and distance traveled."
  ((current-pos vector :inline)
   (dir vector :inline)
   (dest-pos vector :inline)
   (current-poly nav-poly)
   (next-poly nav-poly)
   (len meters)
   (last-edge int8)
   (terminated symbol)
   (reached-dest symbol)
   (hit-boundary symbol)
   (hit-gap symbol)))

(deftype nav-route-portal (structure)
  "The shared edge to cross when leaving a triangle along a precomputed route. edge-index is -1
when no intermediate portal is needed or no next edge is available."
  ((next-poly nav-poly)
   (vertex nav-vertex 2)
   (edge-index int8)))

(deftype clip-travel-vector-to-mesh-return-info (structure)
  "Boundary and gap details produced while clipping travel to the navigation mesh. The previous
and next edge fields are reserved and are not filled."
  ((found-boundary symbol)
   (intersection vector :inline)
   (boundary-normal vector :inline)
   (prev-normal vector :inline)
   (next-normal vector :inline)
   (poly nav-poly)
   (gap-poly nav-poly)
   (edge int32)
   (vert-prev vector :inline)
   (vert-0 vector :inline)
   (vert-1 vector :inline)
   (vert-next vector :inline)))

(deftype nav-node (structure)
  "One node in the navigation triangle BVH. An interior node stores byte offsets to two children;
a leaf overlays those offsets with a count and stores up to eight triangle indices split around
the scale-z field."
  ((center-x float)
   (center-y float)
   (center-z float)
   (type uint16)
   (parent-offset uint16)
   (center vector :inline :overlay-at center-x)
   (radius-x float)
   (radius-y float)
   (radius-z float)
   (left-offset uint16)
   (right-offset uint16)
   (num-tris uint32 :overlay-at left-offset)
   (radius vector :inline :overlay-at radius-x)
   (scale-x float)
   (first-tris uint8 4)
   (scale-z float)
   (last-tris uint8 4)
   (scale vector :inline :overlay-at scale-x)))

(deftype nav-lookup-elem (structure)
  "One entry in the four-slot, per-frame point-to-triangle lookup cache."
  ((vec vector :inline)
   (y-thresh float :overlay-at (-> vec w))
   (time uint32)
   (node-offset uint32)
   (lookup-type uint8)
   (poly-ind uint8)
   (dummy0 uint16)
   (dummy uint32)))

(deftype nav-mesh (basic)
  "A shared triangle navigation mesh with explicit adjacency, a triangle BVH, a four-entry lookup
cache, static obstacle spheres, and a packed all-pairs next-edge routing table. Vertices and
navigation calculations are mesh-local; origin converts between local and world space."
  ((user-list engine) ;; all processes sharing this mesh
   (poly-lookup-history uint8 2)
   (debug-time uint8)
   (static-sphere-count uint8)
   (static-sphere (inline-array nav-sphere)) ;; baked world-space obstacles
   (bounds sphere :inline) ;; world-space mesh bound
   (origin vector :inline) ;; world origin of mesh-local coordinates
   (cache nav-lookup-elem 4 :inline)
   (node-count int32)
   (nodes (inline-array nav-node)) ;; triangle BVH
   (vertex-count int32)
   (vertex (inline-array nav-vertex)) ;; mesh-local positions
   (poly-count int32)
   (poly (inline-array nav-poly)) ;; triangles with explicit adjacency
   ;; Two bits per ordered triangle pair select the next portal edge. Three means there is no
   ;; intermediate portal, so travel can aim directly at the destination.
   (route (inline-array vector4ub)))
  (:methods
   (tri-centroid-world (_type_ nav-poly vector) vector)
   (tri-centroid-local (_type_ nav-poly vector) vector)
   (get-adj-poly (_type_ nav-poly nav-poly symbol) nav-poly)
   (setup-portal (_type_ nav-poly nav-poly nav-route-portal) object)
   (initialize-mesh! (_type_) none)
   (move-along-nav-ray! (_type_ nav-ray) none)
   (try-move-along-ray (_type_ nav-poly vector vector float) meters)
   (clip-travel-vector-to-mesh (_type_ vector nav-poly vector symbol float clip-travel-vector-to-mesh-return-info) none)
   (update-route-table (_type_) none)
   (build-route-table-recursive (_type_ int vector int (pointer int8) int) none)
   (compute-bounding-box (_type_ vector vector) none)
   (debug-draw-poly (_type_ nav-poly rgba) none)
   (point-in-poly? (_type_ nav-poly vector) symbol)
   ;; Despite the old name, this packs the two vertices that are part of the shared edge.
   (find-opposite-vertices (_type_ nav-poly nav-poly) uint)
   (clip-travel-to-poly (_type_ nav-poly vector vector vector nav-route-portal) vector)
   (closest-point-on-boundary (_type_ nav-poly vector vector) vector)
   (project-point-into-tri-3d (_type_ nav-poly vector vector) none)
   (project-point-into-tri-2d (_type_ nav-poly vector vector) vector)
   (find-poly-fast (_type_ vector meters) nav-poly)
   (find-poly (_type_ vector meters (pointer nav-control-flags)) nav-poly)
   (is-in-mesh? (_type_ vector float meters) symbol)))

(define-extern *default-nav-mesh* nav-mesh)

(deftype check-vector-collision-with-nav-spheres-info (structure)
  "The nearest obstacle-sphere hit along a travel direction: ray parameter, world-space
intersection, and outward normal."
  ((u float)
   (intersect vector :inline)
   (normal vector :inline)))

(deftype nav-gap-info (structure)
  "A landing point and first non-gap triangle found across a chain of gap triangles."
  ((dest vector :inline)
   (poly nav-poly)))

(deftype nav-control (basic)
  "Per-actor pathfinding and steering state. It tracks the current route, clips travel to the mesh,
gathers obstacle spheres, and reports gap, blocked, and destination progress to its owner."
  ((flags nav-control-flags)
   (process basic) ;; owner receiving navigation events
   (shape collide-shape) ;; position and navigation radius
   (mesh nav-mesh)
   (gap-event basic)
   (block-event basic)
   (current-poly nav-poly)
   (next-poly nav-poly)
   (target-poly nav-poly)
   ;; These are the two nav-vertex pointers of the active portal edge, not portal records.
   (portal nav-vertex 2)
   (nearest-y-threshold meters) ;; vertical tolerance for triangle lookup
   (event-temp vector :inline)
   (old-travel vector :inline) ;; previous fallback direction
   (blocked-travel vector :inline) ;; travel at the last avoidance deflection
   (prev-pos vector :inline) ;; previous world-space body position
   (extra-nav-sphere vector :inline) ;; reserved space exposed to other users
   (travel vector :inline) ;; current mesh-local travel
   (target-pos vector :inline) ;; steering target
   (destination-pos vector :inline)
   (block-time time-frame)
   (block-count float)
   (user-poly nav-poly)
   (nav-cull-radius float) ;; obstacle collection radius
   (num-spheres int16)
   (max-spheres int16)
   ;; Mesh-local avoidance spheres continue beyond the nominal type size.
   (sphere sphere :inline :dynamic))
  (:methods
   (new (symbol type collide-shape int float) _type_)
   (debug-draw (_type_) none)
   (point-in-bounds? (_type_ vector) symbol)
   (navigate! (_type_ vector) vector)
   (find-gap-landing (_type_ nav-gap-info) symbol)
   (compute-travel (_type_ vector vector) vector)
   (set-current-poly! (_type_ nav-poly) none)
   (set-target-pos! (_type_ vector) none)
   (find-poly-fast-from-world (_type_ vector) nav-poly)
   (project-onto-nav-mesh (_type_ vector vector) vector)
   (find-poly (_type_ vector) nav-poly)
   (steer-toward-point (_type_ vector collide-shape-moving vector float) none)
   (project-point-into-tri-3d (_type_ nav-poly vector vector) vector)
   (find-poly-fast-at (_type_ vector) nav-poly)
   (point-on-mesh-below? (_type_ vector float) symbol)
   (check-vector-collision-with-nav-spheres (_type_ vector check-vector-collision-with-nav-spheres-info) float)
   (clip-travel-to-mesh (_type_ float clip-travel-vector-to-mesh-return-info) none)
   (is-in-mesh? (_type_ vector float) symbol)
   (post-relocalize-hook (_type_) none)
   (relocalize-in-mesh! (_type_) none)
   (gather-nav-spheres! (_type_ collide-kind) none)
   (should-display? (_type_) symbol)
   (find-deepest-sphere-along-ray (_type_ vector vector vector) sphere)
   (intersect-ray-line-segment? (_type_ vector vector vector vector) symbol)
   (avoid-spheres (_type_ vector vector vector vector float) symbol)
   (avoid-spheres-and-detect-blocked (_type_ vector vector vector vector float) symbol)
   (nav-control-method-34 () none)
   (avoid-spheres-world (_type_ vector vector vector vector float) none)))

(defbehavior nav-mesh-connect process ((proc process) (trans trsqv) (nav-cont nav-control))
  "Find and initialize proc's navigation mesh, register the process
   and optional navigation control as users, and return the shared mesh or the empty default mesh."
  ;; try to find an entity with a nav-mesh, first from the given process
  (let ((ent (-> proc entity)))
    (when (zero? (-> ent nav-mesh))
      ;; and if that doesn't have a nav-mesh, see if the res-lump specifies another entity-actor to check
      (let ((lookup-entity (entity-actor-lookup ent 'nav-mesh-actor 0)))
        (if lookup-entity
            (set! ent lookup-entity))))
    ;; try the nav-mesh from the entity
    (let ((entity-nav-mesh (-> ent nav-mesh)))
      (cond
        ((nonzero? entity-nav-mesh)
         ;; We have a nav mesh, see if it needs initialization
         (when (zero? (-> entity-nav-mesh user-list))
           ;; Use the current process's level heap because process-level-heap is not guaranteed to
           ;; be established while navigation connections are built.
           (set! process-level-heap (-> self entity extra level heap))
           ;; Construct the user list with the resource-selected connection capacity.
           (set! (-> entity-nav-mesh user-list)
                 (new 'process-level-heap 'engine 'nav-engine (res-lump-value ent 'nav-max-users int :default (the-as uint128 32))))
           (initialize-mesh! entity-nav-mesh)
           ;; the route table in the nav-mesh is patched so adjacent triangles have a portal
           ;; edge index of 3. Unclear why this isn't done in advance.
           (update-route-table entity-nav-mesh))
         ;; param1 is the user process, param2 its nav-control, and param3 its transform or shape.
         (add-connection (-> entity-nav-mesh user-list) proc nothing proc nav-cont trans))
        (else
         ;; Mark an actor setup error and use the empty default mesh.
         (if (and nav-cont (-> proc entity))
             (logior! (-> proc entity extra perm status) (entity-perm-status error)))
         (set! entity-nav-mesh *default-nav-mesh*)))
      entity-nav-mesh)))

(defmethod new nav-control ((allocation symbol) (type-to-make type) (shape collide-shape) (sphere-count int) (nearest-y-threshold-default float))
  "Allocate per-actor navigation state with capacity for sphere-count avoidance spheres,
   connect it to shape's mesh, and load the nearest-Y threshold from the entity resource."
  (let ((this (object-new allocation type-to-make (the-as int (+ (-> type-to-make size) (* sphere-count 16))))))
    (when (zero? this)
      (go process-drawable-art-error "memory")
      (set! this (the-as nav-control 0))
      (goto cfg-4))
    (set! (-> this max-spheres) sphere-count)
    (set! (-> this flags) (nav-control-flags enable-sphere-avoidance avoid-static-spheres))
    (set! (-> this mesh) (nav-mesh-connect (-> shape process) shape this))
    (let ((ent (-> shape process entity)))
      (set! (-> this nearest-y-threshold) (res-lump-float ent 'nearest-y-threshold :default nearest-y-threshold-default)))
    (set! (-> this shape) shape)
    (set! (-> this process) (-> shape process))
    (set! (-> this gap-event) #f)
    (set! (-> this current-poly) #f)
    (set! (-> this next-poly) #f)
    (set! (-> this target-poly) #f)
    (set! (-> this user-poly) #f)
    (set! (-> this portal 0) #f)
    (set! (-> this portal 1) #f)
    (set! (-> this nav-cull-radius) 40960.0) ;; 10 meters
    (label cfg-4)
    (the-as nav-control this)))

(defmethod should-display? ((this nav-control))
  "Return whether global navigation-mark display and this control's display flag
   are both enabled."
  (and *display-nav-marks* (logtest? (-> this flags) (nav-control-flags display-marks))))

(defmethod point-in-bounds? ((this nav-control) (point vector))
  "Return whether point lies inside the navigation mesh's world-space bounding
   sphere."
  (let ((bounds (-> this mesh bounds)))
    ;; w is the sphere radius
    (>= (-> bounds w) (vector-vector-distance point bounds))))

(defmethod set-target-pos! ((this nav-control) (pos vector))
  "Copy pos into the steering target position."
  (set! (-> this target-pos quad) (-> pos quad))
  (none))

(defun has-nav-mesh? ((ent entity-actor))
  "Return whether the actor has loaded navigation data or a linked
   nav-mesh actor resource."
  (the-as symbol (or (-> ent nav-mesh) (res-lump-struct ent 'nav-mesh-actor structure))))

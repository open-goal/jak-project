;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "kernel-defs.gc")

;; Compile-time helpers for VU0 operations used by EE-era transform and rendering code. The PC
;; backend expands instructions it cannot encode directly into host vector operations.

(defmacro vu-clip (src clip-flags)
  "Emulate VCLIP and return its updated 24-bit clip history.
   The previous history shifts by six bits; the low bits record +x, -x, +y, -y, +z, and -z
   comparisons against the absolute w component."
  (with-gensyms (value flags w-limit neg-w-limit)
    `(let ((,value (new 'stack 'vector))
          (,flags ,clip-flags))
      (.svf ,value ,src)
      (let* ((,w-limit (fabs (-> ,value w)))
             (,neg-w-limit (- 0.0 ,w-limit)))
        (set! ,flags (logand #xffffff (shl ,flags 6)))
        (when (> (-> ,value x) ,w-limit)
          (logior! ,flags 1))
        (when (< (-> ,value x) ,neg-w-limit)
          (logior! ,flags 2))
        (when (> (-> ,value y) ,w-limit)
          (logior! ,flags 4))
        (when (< (-> ,value y) ,neg-w-limit)
          (logior! ,flags 8))
        (when (> (-> ,value z) ,w-limit)
          (logior! ,flags 16))
        (when (< (-> ,value z) ,neg-w-limit)
          (logior! ,flags 32)))
      ,flags)))

;; Jak 1 uses only whole-register XYZW forms of these fixed-point conversions.

(defmacro vftoi4.xyzw (dst src)
  "Convert every source lane from float to signed 28.4 fixed point."
  (with-gensyms (scaled)
    `(rlet ((,scaled :class vf)) (set! ,scaled 16.0) (.mul.x.vf ,scaled ,src ,scaled) (.ftoi.vf ,dst ,scaled))))

(defmacro vftoi12.xyzw (dst src)
  "Convert every source lane from float to signed 20.12 fixed point."
  (with-gensyms (scaled)
    `(rlet ((,scaled :class vf)) (set! ,scaled 4096.0) (.mul.x.vf ,scaled ,src ,scaled) (.ftoi.vf ,dst ,scaled))))

(defmacro vftoi15.xyzw (dst src)
  "Convert every source lane from float to signed 17.15 fixed point."
  (with-gensyms (scaled)
    `(rlet ((,scaled :class vf)) (set! ,scaled 32768.0) (.mul.x.vf ,scaled ,src ,scaled) (.ftoi.vf ,dst ,scaled))))

(defmacro vitof4.xyzw (dst src)
  "Convert every source lane from signed 28.4 fixed point to float."
  (with-gensyms (scale)
    `(rlet ((,scale :class vf)) (.itof.vf ,dst ,src) (set! ,scale 0.0625) (.mul.x.vf ,dst ,dst ,scale))))

(defmacro vitof12.xyzw (dst src)
  "Convert every source lane from signed 20.12 fixed point to float."
  (with-gensyms (scale)
    `(rlet ((,scale :class vf)) (.itof.vf ,dst ,src) (set! ,scale 0.000244140625) (.mul.x.vf ,dst ,dst ,scale))))

(defmacro vitof15.xyzw (dst src)
  "Convert every source lane from signed 17.15 fixed point to float."
  (with-gensyms (scale)
    `(rlet ((,scale :class vf)) (.itof.vf ,dst ,src) (set! ,scale 0.000030517578125) (.mul.x.vf ,dst ,dst ,scale))))

;; The EE transform setup keeps matrices and constants live in VU0 registers across function
;; calls. The PC ABI cannot reserve those host vector registers, so the port saves vf1-vf31 in a
;; static backing store. vf0 is the VU constant register and is reconstructed when needed.
(#when PC_PORT
  (deftype transform-regs (structure)
    ((vf1  uint128)
     (vf2  uint128)
     (vf3  uint128)
     (vf4  uint128)
     (vf5  uint128)
     (vf6  uint128)
     (vf7  uint128)
     (vf8  uint128)
     (vf9  uint128)
     (vf10 uint128)
     (vf11 uint128)
     (vf12 uint128)
     (vf13 uint128)
     (vf14 uint128)
     (vf15 uint128)
     (vf16 uint128)
     (vf17 uint128)
     (vf18 uint128)
     (vf19 uint128)
     (vf20 uint128)
     (vf21 uint128)
     (vf22 uint128)
     (vf23 uint128)
     (vf24 uint128)
     (vf25 uint128)
     (vf26 uint128)
     (vf27 uint128)
     (vf28 uint128)
     (vf29 uint128)
     (vf30 uint128)
     (vf31 uint128)))
  (define *transform-regs* (new 'static 'transform-regs)))

(defmacro with-vf0 (&rest body)
  "Bind and initialize the VU constant register vf0 for body."
  `(rlet ((vf0 :class vf)) (init-vf0-vector) ,@body))

(defmacro load-vf (reg)
  "Load reg from the PC backing store for persistent VU0 registers."
  `(.lvf ,reg (&-> *transform-regs* ,reg)))

(defmacro save-vf (reg)
  "Save reg to the PC backing store for persistent VU0 registers."
  `(.svf (&-> *transform-regs* ,reg) ,reg))

(defmacro with-vf (regs &key (rw 'read) &rest body)
  "Bind the named VU registers and optionally synchronize them with the PC backing store.
   rw may be 'read (the default), 'write, 'readwrite/'rw, or #f. vf0 is not allowed; use
   with-vf0. Write modes append stores after body, so the final store becomes the result."
  `(rlet (,@(apply (lambda (x) `(,x :class vf)) regs))
    ,@(if (or (eq? rw ''read) (eq? rw ''readwrite) (eq? rw ''rw)) (apply (lambda (y) `(load-vf ,y)) regs) '())
    ,@body
    ,@(if (or (eq? rw ''write) (eq? rw ''readwrite) (eq? rw ''rw)) (apply (lambda (y) `(save-vf ,y)) regs) '())))

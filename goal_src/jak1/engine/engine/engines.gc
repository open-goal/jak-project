;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "kernel/gkernel-h.gc")
(require "engine/engine/connect.gc")

;; Allocate the shared engine queues.

(defconstant MATRIX_ENGINE_AMOUNT (* 1024 PROCESS_HEAP_MULT))

;; Draw connections for the current level background.
(define *background-draw-engine* (new 'global 'engine 'draw 10))

;; The matrix engine is a per-frame queue of process handles rather than an engine.
;; Each queued process needs its joint transforms and bone matrices updated.
(define *matrix-engine* (new 'global 'boxed-array handle MATRIX_ENGINE_AMOUNT))

(set! (-> *matrix-engine* length) 0)

;; Connections for all active camera entities.
(define *camera-engine* (new 'global 'engine 'camera-eng 128))

;; Optional per-process debug hooks.
(if *debug-segment* (define *debug-engine* (new 'debug 'engine 'debug 512)))

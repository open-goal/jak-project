;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "kernel-defs.gc")

;; The hint system offers help when the player appears to be stuck.  Level hints
;; are selected by text ID and throttled by elapsed time, repeated requests, and
;; successful attempts.  Task hints advance a task into its hint stage after the
;; player has spent long enough in the level without completing it.

;; Clear the runtime timers and counters for every registered level hint.
(define-extern reset-all-hint-controls (function none))

;; Stop the active level-hint process and release its presentation resources.
(define-extern kill-current-level-hint (function pair pair symbol none))

;; Start a hint using localized text, an optional speaker, and its owning task.
(define-extern level-hint-spawn (function text-id string entity process-tree game-task none))

;; Commands embedded in a level-hint script.  The if-* commands conditionally
;; terminate the script according to the task's current stage.  The close-*
;; commands advance the task past the named stage.  if-at-most-need-reminder-a
;; accepts the contiguous hint stages from need-hint through need-reminder-a.
(defenum hint-command
  (if-unknown 0)
  (if-known 1)
  (if-resolved 2)
  (if-need-introduction 3)
  (if-need-reminder 4)
  (if-need-reminder-a 5)
  (if-need-reward-speech 6)
  (close-need-hint 7)
  (close-need-introduction 8)
  (close-need-reminder 9)
  (close-need-reminder-a 10)
  (close-need-reward-speech 11)
  (close-need-resolution 12)
  (if-at-most-need-reminder-a 13))

;; DECOMP BEGINS

;; Runtime policy and state for an in-level hint.  delay-before-playing is measured
;; from start-time.  A hint becomes eligible after the requested number of attempts;
;; num-success-before-killing suppresses it once enough successful attempts have
;; been reported, while -1 disables that cutoff.  last-time-called debounces rapid
;; repeated checks.  The signed byte counters saturate rather than wrapping.
(deftype level-hint-control (structure)
  ((delay-before-playing        time-frame)
   (id                          text-id)
   (num-attempts-before-playing int8)
   (num-success-before-killing  int8)
   (num-attempts                int8)
   (num-success                 int8)
   (start-time                  time-frame)
   (last-time-called            time-frame)))

;; Advance task toward its hint stage after delay has elapsed in the current level.
(deftype task-hint-control (structure)
  ((task  game-task)
   (delay time-frame)))

(deftype task-hint-control-group (structure)
  ;; The group selected for the current level through task-data-remap.
  ((tasks (array task-hint-control))))

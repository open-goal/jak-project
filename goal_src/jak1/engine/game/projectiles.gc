              (activate-projectile (the-as projectile-blue projectile-process) pp 'projectile-blue (the-as pointer #x70004000)))
            (let ((run-in-process run-function-in-process))
              (let ((initializer projectile-init-by-other)
                    (source-entity (-> pp entity)))

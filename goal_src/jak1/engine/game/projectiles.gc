(defbehavior projectile-init-by-other projectile ((source-entity entity-actor)
              (launch-position vector)
              (initial-velocity vector)
              (options uint)
              (last-target-handle handle))
  "Initialize the projectile from source-entity, launch-position, initial-velocity, launch-context
   option bits, and an optional last-target-handle. Create subtype collision and effects, seed the
   sixteen-sample stall history, snapshot the parent transform, check initial overlaps for non-blue
   projectiles, install the moving event hook, and enter the launch state."
  (stack-size-set! (-> self main-thread) 512)
  (set! (-> self entity) source-entity)
  (set! (-> self attack-mode) #f)
  (set! (-> self update-velocity) projectile-update-velocity-space-wars)
  (set! (-> self max-speed) 40960.0)
  (set! (-> self max-turn) 18204.445)
  (set! (-> self tween) 1.0)
  (set! (-> self last-target) last-target-handle)
  (set! (-> self timeout) (seconds 4))
  (set! (-> self options) options)
  (set! (-> self notify-handle) (the-as handle #f))
  (countdown (i 16)
    (set! (-> self old-dist i) 4095996000.0))
  (init-projectile-collision! self)
  (set! (-> self root dynam gravity y) 1228800.0)
  (set! (-> self root dynam gravity-length) 1228800.0)
  (set! (-> self root dynam gravity-max) 1228800.0)
  (vector-copy! (-> self root trans) launch-position)
  (vector-copy! (-> self base-trans) launch-position)
  (vector-copy! (-> self parent-base) launch-position)
  (quaternion-copy! (-> self root quat) (-> (the-as process-drawable (-> self parent 0)) root quat))
  (quaternion-copy! (-> self parent-quat) (-> (the-as process-drawable (-> self parent 0)) root quat))
  (vector-identity! (-> self root scale))
  (vector-copy! (-> self root transv) initial-velocity)
  (vector-normalize-copy! (-> self base-vector) initial-velocity 1.0)
  (vector+float*! (-> self target) (-> self root trans) (-> self root transv) 2.0)
  (vector-copy! (-> self target-base) (-> self target))
  (init-projectile-settings! self)
  (update-projectile-effects! self)
  (when (not (type-type? (-> self type) projectile-blue))
    (let ((overlap-params (new 'stack-no-clear 'overlaps-others-params)))
      (set! (-> overlap-params options) (overlaps-others-options solid-only))
      (set! (-> overlap-params tlist) *touching-list*)
      (find-overlapping-shapes (-> self root) overlap-params)))
  (set! (-> self event-hook) (-> (method-of-object self projectile-moving) event))
  (go-moving! self)
  (none))


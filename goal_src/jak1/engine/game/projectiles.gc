    (go (method-of-object this projectile-impact)))
  0
  (none))

(defmethod update-projectile-effects! ((this projectile-blue))
  "Update effects for this projectile type. The base spawns its particle trail; yellow also updates
   its shadow, transform, time-windowed trail, and tracking sound; blue randomly emits a blue-eco
   glow."
  (if (rand-vu-percent? 0.75) (eco-blue-glow (-> this root root-prim prim-core world-sphere)))
  0
  (none))

(defstate projectile-impact (projectile-blue)
  :virtual #t
  :code
    (behavior ()
      (cleanup-for-death self)))

(defstate projectile-dissipate (projectile-blue)
  :virtual #t
  :code
    (behavior ()
      (go-virtual projectile-die)))

(require "engine/target/target-util.gc")
(require "engine/common-obs/process-drawable.gc")

;; note: changed for high fps

;; DECOMP BEGINS

(deftype search-info (structure)
  ((point        vector :inline)
   (best-point   vector :inline)
   (match-handle handle)
   (match        process-drawable)
   (best         float)
   (radius       float)
   (rating       uint32)
   (require      uint32)
   (mask         uint32)
   (rot-base     vector :inline)
   (rot-range    float)))

(define *search-info* (new 'global 'search-info))

(defun find-nearest-attackable ((search-point vector)
        (search-radius float)
        (rating-mask uint)
        (required-rating uint)
        (forward-direction vector)
        (angle-range float))
  "Find the nearest attackable drawable whose bounding-sphere surface is inside search-radius and
   the cone around forward-direction. Candidate rating bit 0 means enemy and bit 1 means drawn;
   rating-mask selects the compared bits and required-rating may require one. A candidate replaces
   the current match only when its masked rating is at least as high and its surface is closer;
   therefore a farther higher-rated candidate does not displace an earlier closer match. An
   angle-range of 65536 disables the cone test."
  (let ((search *search-info*))
    (set! (-> search match) #f)
    (vector-copy! (-> search point) search-point)
    (set! (-> search radius) search-radius)
    (set! (-> search best) search-radius)
    (set! (-> search rating) (the-as uint 0))
    (set! (-> search require) required-rating)
    (set! (-> search mask) rating-mask)
    (vector-copy! (-> search rot-base) forward-direction)
    (set! (-> search rot-range) (if (= angle-range 65536.0) -2.0 (cos angle-range)))
    (iterate-process-tree *entity-pool*
                          (lambda ((candidate-process process))
                            (when (logtest? (process-mask crate enemy attackable) (-> candidate-process mask))
                              (let* ((search *search-info*)
                                     (candidate candidate-process)
                                     (candidate-drawable (if (and (nonzero? candidate) (type-type? (-> candidate type) process-drawable)) candidate)))
                                (when candidate-drawable
                                  (let* ((collision-root (-> (the-as process-drawable candidate-drawable) root))
                                         (moving-shape (if (and (nonzero? collision-root) (type-type? (-> collision-root type) collide-shape)) collision-root)))
                                    (when moving-shape
                                      (let* ((primitive-core (-> (the-as collide-shape moving-shape) root-prim prim-core))
                                             (surface-distance (- (vector-vector-distance (-> search point) (-> primitive-core world-sphere)) (-> primitive-core world-sphere w))))
                                        (when (nonzero? (-> (the-as collide-shape moving-shape) root-prim prim-core collide-as))
                                          (let ((rating 0)
                                                (direction-to-candidate (vector-normalize! (vector-! (new 'stack-no-clear 'vector) (-> primitive-core world-sphere) (-> search point)) 1.0)))
                                            (if (logtest? (process-mask enemy) (-> candidate-drawable mask)) (set! rating (logior rating 1)))
                                            (if (and (nonzero? (-> (the-as process-drawable candidate-drawable) draw))
                                                     (logtest? (-> (the-as process-drawable candidate-drawable) draw status) (draw-status was-drawn)))
                                              (set! rating (logior rating 2)))
                                            (let ((masked-rating (logand rating (-> search mask))))
                                              (when (and (>= masked-rating (the-as int (-> search rating)))
                                                         (or (zero? (-> search require)) (logtest? masked-rating (-> search require)))
                                                         (< surface-distance (-> search best))
                                                         (>= (vector-dot direction-to-candidate (-> search rot-base)) (-> search rot-range)))
                                                (set! (-> search match) (the-as process-drawable candidate-drawable))
                                                (set! (-> search best) surface-distance)
                                                (set! (-> search rating) (the-as uint masked-rating))
                                                masked-rating)))))))))))
                          *null-kernel-context*)
    (-> search match)))

(defun projectile-collision-reaction ((cshape collide-shape-moving) (isect collide-shape-intersect) (vel-out vector) (vel-in vector))
  "Move a projectile to its earliest collision, send its process a die event on stopproj materials,
   classify the contact, and reflect its incoming velocity above the surface. Store the reflected
   velocity in vel-out and return the collide-status bits produced by the contact."
  (let ((contact-direction (new-stack-vector0))
        (contact-normal (new-stack-vector0))
        (velocity-copy (new 'stack-no-clear 'matrix))
        (status-mask (collide-status)))
    (set! (-> velocity-copy vector 0 quad) (-> vel-in quad))
    (let ((move-amount (new 'stack-no-clear 'vector)))
      (vector-float*! move-amount (-> isect move-vec) (-> isect best-u))
      (move-by-vector! cshape move-amount))
    (set-and-handle-pat! cshape (-> isect best-tri pat))
    (case (-> isect best-tri pat material)
      (((pat-material stopproj)) (send-event (-> cshape process) 'die)))
    (vector-! contact-direction (-> isect best-from-prim prim-core world-sphere) (-> isect best-tri intersect))
    (set! (-> contact-direction w) 1.0)
    (vector-normalize! contact-direction 1.0)
    (set! (-> cshape coverage) (vector-dot contact-direction (-> isect best-tri normal)))
    (set! (-> contact-normal quad) (-> contact-direction quad))
    (when (= (-> isect best-u) 0.0)
      (let ((separation (vector-float*! (new 'stack-no-clear 'vector) contact-normal 32.0)))
        (move-by-vector! cshape separation)))
    (set! (-> cshape surface-normal quad) (-> contact-normal quad))
    (vector-copy! (-> cshape poly-normal) (-> isect best-tri normal))
    (set! (-> cshape surface-angle) (vector-dot contact-normal (-> cshape dynam gravity-normal)))
    (set! (-> cshape poly-angle) (vector-dot (-> cshape poly-normal) (-> cshape dynam gravity-normal)))
    (set! (-> cshape touch-angle)
          (vector-dot contact-normal (vector-normalize! (vector-negate! (new-stack-vector0) (the-as vector velocity-copy)) 1.0)))
    (if (< (-> cshape poly-angle) -0.2) (logior! status-mask (collide-status touch-ceiling)))
    (let ((wall? (< (fabs (-> cshape surface-angle)) (-> *pat-mode-info* (-> cshape cur-pat mode) wall-angle))))
      (if (not (logtest? (-> cshape prev-status) (collide-status on-surface)))
        (set! (-> cshape ground-impact-vel) (- (vector-dot (-> cshape transv) (-> cshape dynam gravity-normal)))))
      (logior! status-mask (collide-status touch-surface))
      (if (-> isect best-to-prim) (logior! status-mask (collide-status touch-actor)))
      (cond
        (wall?
         (logior! status-mask (collide-status touch-wall))
         (set! (-> cshape cur-pat mode) (pat-mode wall))
         (set! (-> cshape local-normal quad) (-> contact-normal quad)))
        (else (logior! status-mask (collide-status on-surface)) (set! (-> cshape local-normal quad) (-> contact-normal quad))))
      (vector-reflect-flat-above! vel-out (the-as vector velocity-copy) contact-normal)
      (when (and (not wall?) (>= (-> cshape coverage) 0.9))
        (logior! status-mask (collide-status on-ground))
        (vector-copy! (-> cshape ground-poly-normal) (-> cshape poly-normal))
        (when (!= (-> cshape poly-pat mode) (pat-mode wall))
          (set! (-> cshape ground-pat) (-> cshape poly-pat))
          (vector-copy! (-> cshape ground-touch-point) (-> isect best-tri intersect)))))
    (logior! (-> cshape status) status-mask)
    (the-as collide-status status-mask)))


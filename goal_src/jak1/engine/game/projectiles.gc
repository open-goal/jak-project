(defmethod update-projectile-effects! ((this projectile))
  "Update effects for this projectile type. The base spawns its particle trail; yellow also updates
   its shadow, transform, time-windowed trail, and tracking sound; blue randomly emits a blue-eco
   glow."
  (spawn (-> this part) (-> this root root-prim prim-core world-sphere))
  0
  (none))

(defmethod update-target! ((this projectile))
  "Refresh this projectile type's homing target. Yellow selects a rated nearby attackable or
   follows the player collision sphere; blue follows its chosen drawable joint and impacts within
   one meter. The base implementation does nothing."
  0
  (none))

(defstate projectile-moving (projectile)
  :virtual #t
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('touched)
         (when (-> self attack-mode)
           (when (cond
                   ((= (-> proc type) target)
                    (send-event proc 'attack (-> block param 0) (static-attack-info ((mode (-> self attack-mode))))))
                   (else
                    (let ((attack-message (new 'stack-no-clear 'event-message-block)))
                      (set! (-> attack-message from) self)
                      (set! (-> attack-message num-params) 4)
                      (set! (-> attack-message message) 'attack)
                      (set! (-> attack-message param 0) (-> block param 0))
                      (set! (-> attack-message param 1) (the-as uint (-> self attack-mode)))
                      (let ((attack-id (+ *global-attack-id* 1)))
                        (set! *global-attack-id* attack-id)
                        (set! (-> attack-message param 2) (the-as uint attack-id)))
                      (set! (-> attack-message param 3) (the-as uint 0))
                      (send-event-function proc attack-message))))
             (let ((notify-handle (-> self notify-handle)))
               (if (handle->process notify-handle) (send-event (-> notify-handle process 0) 'notify 'attack proc)))
             (+! (-> self hits) 1)
             (if (>= (-> self hits) (-> self max-hits)) (go-virtual projectile-impact)))))
        (('die) (go-virtual projectile-impact))))
  :enter
    (behavior ()
      (set-time! (-> self state-time)))
  :code
    (behavior ()
      (let ((gp-0 #f))
        (while (not (time-elapsed? (-> self state-time) (-> self timeout)))
          (let ((time-ratio (the int (-> *display* time-ratio))))
            (set-time-ratios *display* 1.0)
            (countdown (substep-count time-ratio)
              (if gp-0 (go-virtual projectile-impact))
              (update-target! self)
              ((-> self update-velocity) self)
              (when (logtest? (-> self options) 2)
                (seek! (-> self tween) 1.0 (* 0.5 (seconds-per-frame)))
                (let ((target-distance (vector-vector-distance (-> self root trans) (-> self target))))
                  (cond
                    ((< target-distance 20480.0) (seek! (-> self tween) 1.0 (* 3.0 (seconds-per-frame))))
                    ((< target-distance 40960.0) (seek! (-> self tween) 1.0 (seconds-per-frame))))))
              (let ((previous-position (new 'stack-no-clear 'vector)))
                (vector-copy! previous-position (-> self root trans))
                (fill-cache-integrate-and-collide! (-> self root) (-> self root transv) (-> self root root-prim collide-with))
                (set! (-> self old-dist (-> self old-dist-count))
                      (* 0.0625 (vector-vector-distance previous-position (-> self root trans)))))
              (set! (-> self old-dist-count) (logand (+ (-> self old-dist-count) 1) 15))
              (let ((f0-16 0.0))
                (countdown (i 16)
                  (+! f0-16 (-> self old-dist i)))
                ;; og:preserve-this changed for high fps. This fixes projectile collision issues
                (if (or (and (logtest? (-> self root status) (cshape-moving-flags twall))
                             (< f0-16 (* (-> *display* time-adjust-ratio) (meters 0.5))))
                        (< f0-16 (* (-> *display* time-adjust-ratio) (meters 0.05))))
                  (set! gp-0 #t))))
            (set-time-ratios *display* (the float time-ratio)))
          (update-projectile-effects! self)
          (suspend)))
      (go-virtual projectile-dissipate)))

(defun projectile-update-velocity-space-wars ((this projectile))
  "Steer this toward its target point while preserving its current speed, flattening the target
   offset along a contacted surface. Add the target offset and gravity, cap the result at max-speed,
   and apply the option which forces a fixed downward Y velocity. Dissipate when an invalid target
   lies behind the current direction."
  (let ((target-offset (vector-! (new 'stack-no-clear 'vector) (-> this target) (-> this root trans))))
    (let ((target-direction (new 'stack-no-clear 'vector))
          (velocity-direction (vector-normalize-copy! (new 'stack-no-clear 'vector) (-> this root transv) 1.0))
          (speed (vector-length (-> this root transv))))
      (if (logtest? (-> this root status) (collide-status touch-surface))
        (vector-flatten! target-offset target-offset (-> this root local-normal)))
      (vector-normalize-copy! target-direction target-offset 1.0)
      (if (and (or (not (handle->process (-> this last-target)))
                   (zero? (-> (the-as target (handle->process (-> this last-target))) control root-prim prim-core collide-as)))
               (< (vector-dot target-direction velocity-direction) 0.0))
        (go (method-of-object this projectile-dissipate)))
      (vector-deg-slerp (-> this root transv) velocity-direction target-direction (-> this tween))
      (vector-normalize! (-> this root transv) speed))
    (vector+! (-> this root transv) (-> this root transv) target-offset))
  (vector-v++! (-> this root transv) (compute-acc-due-to-gravity (-> this root) (new-stack-vector0) 0.0))
  (if (< (-> this max-speed) (vector-length (-> this root transv)))
    (vector-normalize! (-> this root transv) (-> this max-speed)))
  (if (logtest? (-> this options) 1) (set! (-> this root transv y) -40960.0))
  0
  (none))

(defstate projectile-impact (projectile)
  :virtual #t

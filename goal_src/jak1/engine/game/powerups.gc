;; DECOMP BEGINS

(defbehavior cloud-track process ((source process-tree)
              (destination process-tree)
              (update-position (function vector none))
              (delay time-frame)
              (transition-duration time-frame)
              (destination-duration time-frame))
  "Call update-position each frame at a random drawable point. Remain on source for delay, blend
   toward destination over transition-duration, then remain on destination for destination-duration.
   A zero destination-duration leaves the tracker alive after the transition without further updates."
  (change-parent self source)
  (let ((source-handle (process->handle source))
        (destination-handle (process->handle destination)))
    (suspend-for (+ delay transition-duration)
      (let ((endpoint-missing? (or (not (handle->process source-handle)) (not (handle->process destination-handle)))))
        (if endpoint-missing? (deactivate self)))
      (let* ((blend (fmax 0.0 (fmin 1.0 (/ (- (the float (- (current-time) time)) (the float delay)) (the float transition-duration)))))
             (transition-sample (process-drawable-pair-random-point! (the-as process-drawable (-> source-handle process 0))
                                                                     (the-as process-drawable (-> destination-handle process 0))
                                                                     (new-stack-vector0)
                                                                     blend)))
        (update-position transition-sample)))
    (cond
      ((zero? destination-duration) (loop (suspend)))
      (else
       (suspend-for destination-duration
         (let ((destination-sample (process-drawable-random-point! (the-as process-drawable (-> destination-handle process 0)) (new-stack-vector0))))
           (update-position destination-sample))))))
  (none))


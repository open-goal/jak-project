(defun eco-blue-glow ((position vector))
  "Emit the blue-eco flash at position, with an independent fifty-percent chance of adding
   lightning."
  (launch-particles (-> *part-id-table* 255) position)
  (if (rand-vu-percent? 0.5) (launch-particles (-> *part-id-table* 257) position))
  0
  (none))

(defbehavior target-powerup-process target ()
  "Update water and weather effects, ice-skid particles and sound, shadow direction, eco timeout,
   and the active yellow, red, blue, or green eco sound and particle effects. Red eco also refreshes
   danger-volume overlaps while active."
  (update-water-state! (-> self water))
  (when (not *weather-off*)
    (case (-> self current-level name)
      (('swamp) (update-rain self))
      (('snow) (update-snow self))))
  (cond
    ((and (= (-> self control ground-pat material) (pat-material ice))
          (and (>= (-> self control ctrl-xz-vel) 204.8)
               (not (time-elapsed? (-> self control last-time-on-surface) (seconds 0.05)))))
     (let ((right-toe-position (vector<-cspace! (new 'stack-no-clear 'vector) (joint-node eichar-lod0-jg RbigToe))))
       (if (and (< (fabs (vector-dot (-> self control dynam gravity-normal)
                                     (vector-! (new 'stack-no-clear 'vector) right-toe-position (-> self control trans))))
                   819.2)
                (rand-vu-percent? 0.5))
         (launch-particles :system *sp-particle-system-3d* (-> *part-id-table* 2391) right-toe-position)))
     (let ((left-toe-position (vector<-cspace! (new 'stack-no-clear 'vector) (joint-node eichar-lod0-jg LbigToe))))
       (if (and (< (fabs (vector-dot (-> self control dynam gravity-normal)
                                     (vector-! (new 'stack-no-clear 'vector) left-toe-position (-> self control trans))))
                   819.2)
                (rand-vu-percent? 0.5))
         (launch-particles :system *sp-particle-system-3d* (-> *part-id-table* 2391) left-toe-position)))
     ;; og:preserve-this PAL patch here
     (let ((target-ice-volume (lerp-scale 80.0 100.0 (-> self control ctrl-xz-vel) 0.0 81920.0)))
       (if (not (ja-group? eichar-ice-stance-ja)) (set! target-ice-volume (* 0.8 target-ice-volume)))
       (seek! (-> self control ice-loop-volume) target-ice-volume (* 100.0 (seconds-per-frame))))
     (let ((ice-volume (-> self control ice-loop-volume))
           (ice-pitch (lerp-scale -0.3 0.3 (-> self control ctrl-xz-vel) 0.0 81920.0)))
       (sound-play "ice-loop"
                   :id (-> self control ice-loop-sound-id)
                   :vol
                   ice-volume
                   :pitch
                   ice-pitch
                   :position
                   (the-as symbol (-> self control trans)))))
    ((< 0.0 (-> self control ice-loop-volume))
     (set! (-> self control ice-loop-volume) 0.0)
     (let ((sound-param (the-as sound-rpc-set-param (get-sound-buffer-entry))))
       (set! (-> sound-param command) (sound-command set-param))
       (set! (-> sound-param id) (-> self control ice-loop-sound-id))
       (set! (-> sound-param parms volume) -4)
       (set! (-> sound-param auto-time) 48)
       (set! (-> sound-param auto-from) 2)
       (set! (-> sound-param parms mask) (sound-mask volume time))
       (-> sound-param id))))
  (let ((shadow-direction (-> *time-of-day-context* current-shadow))
        (shadow-control (-> self draw shadow-ctrl)))
    (set! (-> shadow-control settings shadow-dir x) (-> shadow-direction x))
    (set! (-> shadow-control settings shadow-dir y) (-> shadow-direction y))
    (set! (-> shadow-control settings shadow-dir z) (-> shadow-direction z)))
  (when (and (!= (-> self fact eco-level) 0.0)
             (>= (- (-> *display* game-frame-counter) (-> self fact eco-pickup-time)) (the-as time-frame (-> self fact eco-timeout))))
    (set! (-> self fact eco-level) 0.0)
    (set! (-> self fact eco-timeout) 0)
    (logclear! (-> self state-flags) (state-flags invuln-powerup))
    (send-event self 'reset-collide)
    (stop! (-> self sound)))
  (when (and (< 0.0 (-> self fact eco-level))
             (not (logtest? (-> self state-flags) (state-flags first-person-mode)))
             (not (logtest? (-> self draw status) (draw-status hidden no-anim)))
             (not (movie?))
             (rand-vu-percent? (lerp-scale 0.0
                                           1.0
                                           (the float
                                                (- (-> self fact eco-timeout) (the-as uint (- (-> *display* game-frame-counter) (-> self fact eco-pickup-time)))))
                                           0.0
                                           900.0)))
    (case (-> self fact eco-type)
      (((pickup-type eco-yellow))
       (change-sound! (-> self sound) (static-sound-name "yel-eco-jak"))
       (let ((yellow-flash-joint (rand-vu-int-range 3 (+ (-> self node-list length) -1))))
         (launch-particles (-> *part-id-table* (if (rand-vu-percent? 0.5) 269 270))
                           (vector<-cspace! (new 'stack-no-clear 'vector) (-> self node-list data yellow-flash-joint))))
       (dotimes (yellow-i 2)
         (let ((yellow-spark-joint (rand-vu-int-range 3 (+ (-> self node-list length) -1))))
           (launch-particles (-> *part-id-table* 271)
                             (vector<-cspace! (new 'stack-no-clear 'vector) (-> self node-list data yellow-spark-joint))))))
      (((pickup-type eco-red))
       (target-danger-set! (-> self control danger-mode) #t)
       (update-transforms! (-> self control))
       (let ((overlap-params (new 'stack-no-clear 'touching-shapes-entry)))
         (set! (-> overlap-params cshape1) (the-as collide-shape 0))
         (set! (-> overlap-params cshape2) (the-as collide-shape *touching-list*))
         (find-overlapping-shapes (-> self control) (the-as overlaps-others-params overlap-params)))
       (target-danger-set! (-> self control danger-mode) #f)
       (update-transforms! (-> self control))
       (change-sound! (-> self sound) (static-sound-name "red-eco-jak"))
       (let ((red-flash-joint (rand-vu-int-range 3 (+ (-> self node-list length) -1))))
         (launch-particles (-> *part-id-table* (if (rand-vu-percent? 0.5) 273 274))
                           (vector<-cspace! (new 'stack-no-clear 'vector) (-> self node-list data red-flash-joint))))
       (dotimes (red-i 2)
         (let ((red-spark-joint (rand-vu-int-range 3 (+ (-> self node-list length) -1))))
           (launch-particles (-> *part-id-table* 275)
                             (vector<-cspace! (new 'stack-no-clear 'vector) (-> self node-list data red-spark-joint))))))
      (((pickup-type eco-blue))
       (change-sound! (-> self sound) (static-sound-name "blue-eco-jak"))
       (let ((blue-lightning-joint (rand-vu-int-range 3 (+ (-> self node-list length) -1))))
         (cond
           ((and (logtest? (-> self control mod-surface flags) (surface-flags jump))
                 (not (logtest? (-> self control status) (collide-status on-surface))))
            (set! (-> *part-id-table* 259 init-specs 4 initial-valuef) 0.0)
            (set! (-> *part-id-table* 259 init-specs 4 random-rangef) 65536.0))
           (else
            (set! (-> *part-id-table* 259 init-specs 4 initial-valuef) 40960.0)
            (set! (-> *part-id-table* 259 init-specs 4 random-rangef) 16384.0)))
         (launch-particles (-> *part-id-table* 259)
                           (vector<-cspace! (new 'stack-no-clear 'vector) (-> self node-list data blue-lightning-joint))))
       (let ((blue-flash-joint (rand-vu-int-range 3 (+ (-> self node-list length) -1))))
         (launch-particles (-> *part-id-table* (if (rand-vu-percent? 0.5) 255 256))
                           (vector<-cspace! (new 'stack-no-clear 'vector) (-> self node-list data blue-flash-joint)))
         (if (rand-vu-percent? 0.5)
           (launch-particles (-> *part-id-table* 257)
                             (vector<-cspace! (new 'stack-no-clear 'vector) (-> self node-list data blue-flash-joint)))))
       (let ((blue-falling-joint (rand-vu-int-range 3 (+ (-> self node-list length) -1))))
         (launch-particles (-> *part-id-table* 260)
                           (vector<-cspace! (new 'stack-no-clear 'vector) (-> self node-list data blue-falling-joint))))
       (cpad-set-buzz! (-> *cpad-list* cpads 0) 0 1 (seconds 0.1)))
      (((pickup-type eco-green))
       (change-sound! (-> self sound) (static-sound-name "green-eco-jak"))
       (let ((green-flash-joint (rand-vu-int-range 3 (+ (-> self node-list length) -1))))
         (launch-particles (-> *part-id-table* (if (rand-vu-percent? 0.5) 277 278))
                           (vector<-cspace! (new 'stack-no-clear 'vector) (-> self node-list data green-flash-joint))))
       (dotimes (green-i 2)
         (let ((green-spark-joint (rand-vu-int-range 3 (+ (-> self node-list length) -1))))
           (launch-particles (-> *part-id-table* 279)
                             (vector<-cspace! (new 'stack-no-clear 'vector) (-> self node-list data green-spark-joint)))))))
    (update-trans! (-> self sound) (-> self control trans))
    (update! (-> self sound)))
  0
  (none))

(defbehavior target-powerup-effect target ((effect symbol))
  "Dispatch a one-shot target powerup effect. eco-blue emits a blue glow from a random animated
   joint; other effect names do nothing."
  (case effect
    (('eco-blue)
     (let ((joint-index (rand-vu-int-range 3 (+ (-> self node-list length) -1))))
       (eco-blue-glow (vector<-cspace! (new 'stack-no-clear 'vector) (-> self node-list data joint-index))))))
  0
  (none))

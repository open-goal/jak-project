;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "kernel/gkernel-h.gc")
(require "engine/engine/connect.gc")

;; The settings system manages global presentation and game-state overrides.
;; Every request belongs to a process through a connection, so destroying the
;; process automatically withdraws the request. Each frame starts with the
;; defaults, resolves live requests from oldest to newest, and applies changes
;; that need side effects or gradual transitions.

;; DECOMP BEGINS

;; One complete resolved settings snapshot. Several fields are process pointers
;; so other systems can identify which process currently owns an activity.
(deftype setting-data (structure)
  ((border-mode          symbol)
   (sfx-volume           float)
   (music-volume         float)
   (dialog-volume        float)
   (process-mask         process-mask)
   (common-page          int32)
   (language             language-enum)
   (screenx              int32)
   (screeny              int32)
   (vibration            symbol)
   (play-hints           symbol)
   (movie                (pointer process))
   (talking              (pointer process))
   (spooling             (pointer process))
   (hint                 (pointer process))
   (ambient              (pointer process))
   (video-mode           symbol)
   (aspect-ratio         symbol)
   ;; A requested music-flava event until settings update resolves it to the
   ;; active music bank's concrete variation number.
   (sound-flava          uint8)
   (auto-save            symbol)
   (music-volume-movie   float)
   (sfx-volume-movie     float)
   (music                symbol)
   (bg-r                 float)
   (bg-g                 float)
   (bg-b                 float)
   (bg-a                 float)
   (bg-a-speed           float)
   (bg-a-force           float)
   (allow-progress       symbol)
   (allow-pause          symbol)
   (sound-flava-priority float)
   (ocean-off            symbol)
   (allow-look-around    symbol)
   (ambient-volume       float)
   (ambient-volume-movie float)
   (dialog-volume-hint   float)
   (dummy                uint32 11))
  (:methods
   (update-from-engine (_type_ engine) setting-data)))

;; There are three copies of setting data:
;; - default is the base state used when no process requests an override.
;; - target is rebuilt from default plus every live request.
;; - current is the state already applied to the game. Cheap fields are copied
;;   immediately; volumes, display mode, language, and other side effects are
;;   reconciled by the per-frame update.

;; The setting-control manages the current/target/default system.
;; The setting requests are managed by the engine.
(deftype setting-control (basic)
  ((current setting-data :inline)
   (target  setting-data :inline)
   (default setting-data :inline)
   (engine  engine))
  (:methods
   (new (symbol type int) _type_)
   (add-setting (_type_ process symbol object object object) none)
   (set-setting (_type_ process symbol object object object) none)
   (remove-setting (_type_ process symbol) none)
   (apply-settings (_type_) setting-data)
   (update (_type_) setting-data)))

(defmethod new setting-control ((allocation symbol) (type-to-make type) (max-connections int))
  "Allocate a setting controller with room for max-connections process-owned requests."
  (let ((this (object-new allocation type-to-make (the-as int (-> type-to-make size)))))
    (set! (-> this engine) ((method-of-type engine new) allocation engine 'setting-control max-connections))
    this))

;; The three request arguments occupy connection param1 through param3. Their
;; meanings depend on the setting: for example, volume requests use mode and
;; float value, while process masks use mode and integer bits.
(defmacro setting-control-func! (func setting-name &rest request-args)
  `(,func *setting-control* (with-pp pp) ,setting-name ,(car request-args) ,(cadr request-args) ,(caddr request-args)))

(defmacro add-setting! (setting-name &rest request-args)
  `(setting-control-func! add-setting ,setting-name ,@request-args))

(defmacro set-setting! (setting-name &rest request-args)
  `(setting-control-func! set-setting ,setting-name ,@request-args))

(defmacro remove-setting! (setting-name)
  `(remove-setting *setting-control* (with-pp pp) ,setting-name))

;; Raw system-clock result used for save metadata. The clock stores its time and
;; date digits in packed BCD; stat reports whether the read succeeded.
(deftype scf-time (structure)
  ((stat   uint8)
   (second uint8)
   (minute uint8)
   (hour   uint8)
   (week   uint8)
   (day    uint8)
   (month  uint8)
   (year   uint8)))

(define-extern *setting-control* setting-control)

;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/ps2/pad.gc")
(require "engine/gfx/ocean/ocean-h.gc")
(#when PC_PORT
  (define *progress-flava* -1))

;; DECOMP BEGINS

(defmethod update-from-engine ((this setting-data) (settings-engine engine))
  "Resolve the live requests in settings-engine into this snapshot, from oldest to newest so
   newer requests override older ones. Request parameters are setting-specific: param1 carries
   a symbol or pointer, param2 carries a numeric value or sound-flava priority, and param3
   carries mask bits, a language, or a music-flava event. Relative volumes are percentages of
   the value already resolved; process-mask requests set, clear, or replace bits, while
   common-page requests set or clear them. The highest sound-flava priority wins, with a newer
   request winning a tie. An sfx-volume request outside the progress process is ignored while
   progress is prevented from running."
  (let ((request (the-as connection (-> settings-engine alive-list-end)))
        (previous-request (-> settings-engine alive-list-end prev0)))
    (while (!= (the-as connectable request) (-> settings-engine alive-list))
      (case (-> request param0)
        (('border-mode) (set! (-> this border-mode) (the-as symbol (-> request param1))))
        (('allow-look-around) (set! (-> this allow-look-around) (the-as symbol (-> request param1))))
        (('ocean-off) (set! (-> this ocean-off) (the-as symbol (-> request param1))))
        (('music) (set! (-> this music) (the-as symbol (-> request param1))))
        (('process-mask)
         (case (the-as object (-> request param1))
           (('set) (logior! (-> this process-mask) (the-as int (-> request param3))))
           (('clear) (logclear! (-> this process-mask) (the-as uint (-> request param3))))
           (('abs) (set! (-> this process-mask) (the-as process-mask (the-as int (-> request param3)))))))
        (('sfx-volume)
         (when (or (not (logtest? (-> *kernel-context* prevent-from-run) (process-mask progress)))
                   (= (get-process request) (ppointer->process *progress-process*)))
           (case (the-as symbol (-> request param1))
             (('rel) (set! (-> this sfx-volume) (* 0.01 (the-as float (-> request param2)) (-> this sfx-volume))))
             (else (set! (-> this sfx-volume) (the-as float (-> request param2)))))))
        (('music-volume)
         (case (the-as symbol (-> request param1))
           (('rel) (set! (-> this music-volume) (* 0.01 (the-as float (-> request param2)) (-> this music-volume))))
           (else (set! (-> this music-volume) (the-as float (-> request param2))))))
        (('ambient-volume)
         (case (the-as symbol (-> request param1))
           (('rel) (set! (-> this ambient-volume) (* 0.01 (the-as float (-> request param2)) (-> this ambient-volume))))
           (else (set! (-> this ambient-volume) (the-as float (-> request param2))))))
        (('dialog-volume)
         (case (the-as symbol (-> request param1))
           (('rel) (set! (-> this dialog-volume) (* 0.01 (the-as float (-> request param2)) (-> this dialog-volume))))
           (else (set! (-> this dialog-volume) (the-as float (-> request param2))))))
        (('sfx-volume-movie)
         (case (the-as symbol (-> request param1))
           (('rel) (set! (-> this sfx-volume-movie) (* 0.01 (the-as float (-> request param2)) (-> this sfx-volume-movie))))
           (else (set! (-> this sfx-volume-movie) (the-as float (-> request param2))))))
        (('music-volume-movie)
         (case (the-as symbol (-> request param1))
           (('rel) (set! (-> this music-volume-movie) (* 0.01 (the-as float (-> request param2)) (-> this music-volume-movie))))
           (else (set! (-> this music-volume-movie) (the-as float (-> request param2))))))
        (('ambient-volume-movie)
         (case (the-as symbol (-> request param1))
           (('rel) (set! (-> this ambient-volume-movie) (* 0.01 (the-as float (-> request param2)) (-> this ambient-volume-movie))))
           (else (set! (-> this ambient-volume-movie) (the-as float (-> request param2))))))
        (('dialog-volume-hint)
         (case (the-as symbol (-> request param1))
           (('rel) (set! (-> this dialog-volume-hint) (* 0.01 (the-as float (-> request param2)) (-> this dialog-volume-hint))))
           (else (set! (-> this dialog-volume-hint) (the-as float (-> request param2))))))
        (('sound-flava)
         (when (>= (the-as float (-> request param2)) (-> this sound-flava-priority))
           (set! (-> this sound-flava) (the-as uint (the-as int (-> request param3))))
           (set! (-> this sound-flava-priority) (the-as float (-> request param2)))))
        (('bg-r) (set! (-> this bg-r) (the-as float (-> request param2))))
        (('bg-g) (set! (-> this bg-g) (the-as float (-> request param2))))
        (('bg-b) (set! (-> this bg-b) (the-as float (-> request param2))))
        (('bg-a) (set! (-> this bg-a) (the-as float (-> request param2))))
        (('bg-a-speed) (set! (-> this bg-a-speed) (the-as float (-> request param2))))
        (('bg-a-force) (set! (-> this bg-a-force) (the-as float (-> request param2))))
        (('language) (set! (-> this language) (the-as language-enum (the-as int (-> request param3)))))
        (('vibration) (set! (-> this vibration) (the-as symbol (-> request param1))))
        (('auto-save) (set! (-> this auto-save) (the-as symbol (-> request param1))))
        (('allow-pause) (set! (-> this allow-pause) (the-as symbol (-> request param1))))
        (('allow-progress) (set! (-> this allow-progress) (the-as symbol (-> request param1))))
        (('play-hints) (set! (-> this play-hints) (the-as symbol (-> request param1))))
        (('movie) (set! (-> this movie) (the-as (pointer progress) (-> request param1))))
        (('talking) (set! (-> this talking) (the-as (pointer progress) (-> request param1))))
        (('spooling) (set! (-> this spooling) (the-as (pointer progress) (-> request param1))))
        (('hint) (set! (-> this hint) (the-as (pointer process) (-> request param1))))
        (('ambient) (set! (-> this ambient) (the-as (pointer progress) (-> request param1))))
        (('common-page)
         (case (the-as object (-> request param1))
           (('set) (logior! (-> this common-page) (the-as int (-> request param3))))
           (('clear) (logclear! (-> this common-page) (the-as uint (-> request param3)))))))
      (set! request (the-as connection previous-request))
      (set! previous-request (-> (the-as connectable request) prev0))))
  this)

(defmethod add-setting ((this setting-control) (owner process) (setting-name symbol) (request-param1 object) (request-param2 object) (request-param3 object))
  "Add a setting request owned by owner. setting-name selects the setting, and request-param1
   through request-param3 carry its setting-specific mode, value, priority, pointer, or bits.
   The request is withdrawn automatically when owner is destroyed."
  (add-connection (-> this engine) owner setting-name request-param1 request-param2 request-param3)
  0
  (none))

(defmethod set-setting ((this setting-control) (owner process) (setting-name symbol) (request-param1 object) (request-param2 object) (request-param3 object))
  "Replace owner's existing request for setting-name, then add the new request-param1 through
   request-param3 payload. Other settings owned by the process are left alone."
  (remove-setting this owner setting-name)
  (add-connection (-> this engine) owner setting-name request-param1 request-param2 request-param3)
  0
  (none))

(defmethod remove-setting ((this setting-control) (owner process) (setting-name symbol))
  "Remove setting-name from owner. Passing #t as setting-name removes every setting request
   owned by that process."
  (when owner
    (let ((settings-engine (-> this engine))
          (request-link (-> owner connection-list next1)))
      (while request-link
        (if (and (belongs-to-engine? (the-as connection request-link) settings-engine)
                 (or (= setting-name #t) (= setting-name (-> (the-as connection request-link) param0))))
          (move-to-dead (the-as connection request-link)))
        (set! request-link (-> request-link next1)))))
  0
  (none))

(defmethod apply-settings ((this setting-control))
  "Rebuild the desired settings from the defaults and live requests, then copy fields without
   gradual transitions or external side effects into current. The default ambient volume is a
   percentage of the default sfx volume. Also installs the resolved process mask immediately."
  (let ((current-settings (-> this current)))
    (let ((desired-settings (-> this target)))
      ;; Start each pass from the defaults.
      (mem-copy! (the-as pointer desired-settings) (the-as pointer (-> this default)) 196)
      ;; Ambient is stored as a percentage of the effects volume.
      (set! (-> desired-settings ambient-volume) (* 0.01 (-> this default ambient-volume) (-> this default sfx-volume)))
      ;; Apply process-owned requests from oldest to newest.
      (update-from-engine desired-settings (-> this engine))
      ;; These settings are safe to update more than once per frame.
      (set! (-> current-settings border-mode) (-> desired-settings border-mode))
      (set! (-> current-settings common-page) (-> desired-settings common-page))
      (set! (-> current-settings vibration) (-> desired-settings vibration))
      (set! (-> current-settings auto-save) (-> desired-settings auto-save))
      (set! (-> current-settings play-hints) (-> desired-settings play-hints))
      (set! (-> current-settings movie) (-> desired-settings movie))
      (set! (-> current-settings talking) (-> desired-settings talking))
      (set! (-> current-settings spooling) (-> desired-settings spooling))
      (set! (-> current-settings hint) (-> desired-settings hint))
      (set! (-> current-settings ambient) (-> desired-settings ambient))
      (set! (-> current-settings allow-pause) (-> desired-settings allow-pause))
      (set! (-> current-settings allow-progress) (-> desired-settings allow-progress))
      (set! (-> current-settings allow-look-around) (-> desired-settings allow-look-around))
      (set! (-> current-settings ocean-off) (-> desired-settings ocean-off))
      (set! (-> current-settings ambient-volume-movie) (-> desired-settings ambient-volume-movie))
      (set! (-> current-settings music-volume-movie) (-> desired-settings music-volume-movie))
      (set! (-> current-settings sfx-volume-movie) (-> desired-settings sfx-volume-movie))
      (set! (-> current-settings dialog-volume-hint) (-> desired-settings dialog-volume-hint))
      (set! (-> current-settings process-mask) (-> desired-settings process-mask)))
    (set! (-> *kernel-context* prevent-from-run) (-> current-settings process-mask))
    current-settings))

(defmethod update ((this setting-control))
  "Resolve and apply the settings for this frame. Volumes and background alpha approach their
   desired values over time; language, music, sound flava, video, background, border, common
   texture pages, vibration, and ocean controls are sent to their owning systems as needed.
   Music changes wait until the sound RPC is idle and both music banks are available."
  ;; Compute the desired settings.
  (apply-settings this)
  ;; Reconcile settings that need a gradual transition or an external side effect.
  (let ((current-settings (-> this current)))
    (let ((desired-settings (-> this target)))
      ;; Move live mixer volumes at 100 volume units per second.
      (when *sound-player-enable*
        (when (!= (-> current-settings sfx-volume) (-> desired-settings sfx-volume))
          (seek! (-> current-settings sfx-volume) (-> desired-settings sfx-volume) (* 100.0 (seconds-per-frame)))
          (sound-set-volume (sound-group sfx) (-> current-settings sfx-volume))
          ;; og:preserve-this Fix for menu-close
          (sound-set-volume (sound-group sog3) (-> current-settings sfx-volume)))
        (when (!= (-> current-settings music-volume) (-> desired-settings music-volume))
          (seek! (-> current-settings music-volume) (-> desired-settings music-volume) (* 100.0 (seconds-per-frame)))
          (sound-set-volume (sound-group music) (-> current-settings music-volume)))
        (when (!= (-> current-settings dialog-volume) (-> desired-settings dialog-volume))
          (seek! (-> current-settings dialog-volume) (-> desired-settings dialog-volume) (* 100.0 (seconds-per-frame)))
          (sound-set-volume (sound-group dialog) (-> current-settings dialog-volume)))
        (when (!= (-> current-settings ambient-volume) (-> desired-settings ambient-volume))
          (seek! (-> current-settings ambient-volume) (-> desired-settings ambient-volume) (* 100.0 (seconds-per-frame)))
          (sound-set-volume (sound-group ambient) (-> current-settings ambient-volume))))
      ;; send language change to the IOP.
      (when (!= (-> current-settings language) (-> desired-settings language))
        ;; og:preserve-this pc port added this
        (#when PC_PORT
          (cond
            ((not *jak1-full-game*))
            ((= (language-enum japanese) (-> desired-settings language)) ;; old lang wasnt japanese
             (sound-bank-unload (static-sound-name "common"))
             (sound-bank-load (static-sound-name "commonj")))
            ((= (language-enum japanese) (-> current-settings language)) ;; old lang was japanese
             (sound-bank-unload (static-sound-name "commonj"))
             (sound-bank-load (static-sound-name "common")))))
        (set! (-> current-settings language) (-> desired-settings language))
        (set-language (-> current-settings language)))
      ;; A music change waits for an idle RPC channel and two available music banks.
      (when (and (!= (-> desired-settings music) (-> current-settings music))
                 (and (< 0.0 (-> *setting-control* current music-volume)) (zero? (rpc-busy? 1)) *sound-bank-1* *sound-bank-2*))
        (cond
          ((-> desired-settings music)
           (format 0 "Load music ~A~%" (-> desired-settings music))
           (sound-music-load (string->sound-name (symbol->string (-> desired-settings music)))))
          (else (format 0 "Unload music~%") (sound-music-unload)))
        (set! (-> current-settings music) (-> desired-settings music)))
      ;; Requests name a music-flava event. Resolve that event through the active
      ;; music bank, then replace it with the concrete variation number sent to
      ;; the sound player.
      (set! (-> desired-settings sound-flava)
            (the-as uint (flava-lookup (-> current-settings music) (the-as music-flava (-> desired-settings sound-flava)))))
      (set! (-> current-settings sound-flava) (-> desired-settings sound-flava))
      (if *sound-player-enable*
        (#if PC_PORT
          (sound-set-flava (if (>= *progress-flava* 0) (the uint *progress-flava*) (-> current-settings sound-flava)))
          (sound-set-flava (-> current-settings sound-flava))))
      ;; update display settings
      (when (!= (-> current-settings aspect-ratio) (-> desired-settings aspect-ratio))
        (set! (-> current-settings aspect-ratio) (-> desired-settings aspect-ratio))
        (set-aspect-ratio (-> current-settings aspect-ratio)))
      (when (!= (-> current-settings video-mode) (-> desired-settings video-mode))
        (set! (-> current-settings video-mode) (-> desired-settings video-mode))
        (set-video-mode (-> current-settings video-mode)))
      (when (!= (-> current-settings screenx) (-> desired-settings screenx))
        (set! (-> current-settings screenx) (-> desired-settings screenx))
        (set! (-> *video-parms* display-dx) (/ (-> desired-settings screenx) 2))
        (set! (-> *video-parms* set-video-mode) #t))
      (when (!= (-> current-settings screeny) (-> desired-settings screeny))
        (set! (-> current-settings screeny) (-> desired-settings screeny))
        ;; The vertical display offset must land on an even scanline.
        (set! (-> *video-parms* display-dy) (* (/ (-> desired-settings screeny) 2) 2))
        (set! (-> *video-parms* set-video-mode) #t))
      ;; update display bg color
      (set! (-> current-settings bg-a-speed) (-> desired-settings bg-a-speed))
      (set! (-> current-settings bg-a-force) (-> desired-settings bg-a-force))
      (set! (-> current-settings bg-r) (-> desired-settings bg-r))
      (set! (-> current-settings bg-g) (-> desired-settings bg-g))
      (set! (-> current-settings bg-b) (-> desired-settings bg-b))
      (seek! (-> current-settings bg-a) (-> desired-settings bg-a) (* (-> desired-settings bg-a-speed) (seconds-per-frame))))
    (let ((display-frame (-> *display* frames (-> *display* on-screen) display))
          (background-alpha (-> current-settings bg-a)))
      (if (!= (-> current-settings bg-a-force) 0.0) (set! background-alpha (-> current-settings bg-a-force)))
      (set! (-> display-frame bgcolor r) (the int (* 255.0 (-> current-settings bg-r))))
      (set! (-> display-frame bgcolor g) (the int (* 255.0 (-> current-settings bg-g))))
      (set! (-> display-frame bgcolor b) (the int (* 255.0 (-> current-settings bg-b))))
      ;; bg-a is the amount of background color, opposite the PMODE blend weight.
      (set! (-> display-frame pmode alp) (the int (* 255.0 (- 1.0 background-alpha)))))
    ;; ??
    (set! (-> *level* border?) (-> current-settings border-mode))
    ;; common pool texture page mask
    (set! (-> *texture-pool* common-page-mask) (-> current-settings common-page))
    (set! (-> *cpad-list* cpads 0 buzz) (-> current-settings vibration))
    (case (-> current-settings ocean-off)
      ((#t) (set! *ocean-off* #t))
      (('mid) (set! *ocean-mid-off* #t))
      (('near) (set! *ocean-near-off* #t)))
    current-settings))

;; Seed the defaults from the console configuration. Current values which own an
;; external side effect start deliberately different so the first update sends them.
(when (zero? *setting-control*)
  (set! *setting-control* (new 'global 'setting-control 32))
  (let ((default-settings (-> *setting-control* default))
        (current-settings (-> *setting-control* current)))
    (let ((system-volume (* 0.01 (the float (scf-get-volume)))))
      (set! (-> default-settings ocean-off) #f)
      (set! (-> default-settings allow-look-around) #t)
      (set! (-> default-settings border-mode) #f)
      (set! (-> default-settings sfx-volume) (the float (* 5 (the int (+ 0.5 (* 15.0 system-volume))))))
      (set! (-> default-settings music-volume) (the float (* 5 (the int (+ 0.5 (* 13.0 system-volume))))))
      (set! (-> default-settings dialog-volume) (the float (* 5 (the int (+ 0.5 (* 20.0 system-volume))))))
      (set! (-> default-settings ambient-volume) (the float (* 5 (the int (+ 0.5 (* 15.0 system-volume))))))
      (set! (-> default-settings sfx-volume-movie) (the float (* 5 (the int (+ 0.5 (* 11.0 system-volume))))))
      (set! (-> default-settings music-volume-movie) (the float (* 5 (the int (+ 0.5 (* 13.0 system-volume))))))
      (set! (-> default-settings ambient-volume-movie) (the float (* 5 (the int (+ 0.5 (* 11.0 system-volume))))))
      (set! (-> default-settings dialog-volume-hint) (the float (* 5 (the int (+ 0.5 (* 16.0 system-volume)))))))
    (set! (-> default-settings language) (scf-get-language))
    (set! (-> default-settings process-mask) (process-mask execute sleep))
    (set! (-> default-settings screenx) 0)
    (set! (-> default-settings screeny) 0)
    (set! (-> default-settings vibration) #t)
    (set! (-> default-settings auto-save) #f)
    (set! (-> default-settings play-hints) #t)
    (set! (-> default-settings movie) (the-as (pointer process) #f))
    (set! (-> default-settings talking) (the-as (pointer process) #f))
    (set! (-> default-settings spooling) (the-as (pointer process) #f))
    (set! (-> default-settings hint) (the-as (pointer process) #f))
    (set! (-> default-settings ambient) (the-as (pointer process) #f))
    ;; Begin with the default music event. update later replaces the event with
    ;; the active bank's concrete variation number.
    (set! (-> default-settings sound-flava) (the-as uint 49))
    (set! (-> default-settings sound-flava-priority) 0.0)
    (set! (-> default-settings music) #f)
    (set! (-> default-settings bg-a-speed) 8.0)
    (set! (-> default-settings allow-pause) #t)
    (set! (-> default-settings allow-progress) #t)
    (case (scf-get-aspect)
      ((2) (set! (-> default-settings aspect-ratio) 'aspect16x9))
      (else (set! (-> default-settings aspect-ratio) 'aspect4x3)))
    (if (zero? *boot-video-mode*) (set! (-> default-settings video-mode) 'ntsc) (set! (-> default-settings video-mode) 'pal))
    (set! (-> current-settings sfx-volume) (+ -1.0 (-> default-settings sfx-volume)))
    (set! (-> current-settings music-volume) (+ -1.0 (-> default-settings music-volume)))
    (set! (-> current-settings dialog-volume) (+ -1.0 (-> default-settings dialog-volume)))
    (set! (-> current-settings ambient-volume) (+ -1.0 (-> default-settings ambient-volume)))
    (set! (-> current-settings sfx-volume-movie) (-> default-settings sfx-volume-movie))
    (set! (-> current-settings music-volume-movie) (-> default-settings music-volume-movie))
    (set! (-> current-settings ambient-volume-movie) (-> default-settings ambient-volume-movie))
    (set! (-> current-settings dialog-volume-hint) (-> default-settings dialog-volume-hint))
    (set! (-> current-settings language) (+ (-> default-settings language) -1))
    (set! (-> current-settings aspect-ratio) #f)
    (set! (-> current-settings video-mode) #f)
    (set! (-> current-settings music) #f)
    (set! (-> current-settings bg-a-speed) (-> default-settings bg-a-speed))
    (set! (-> current-settings allow-pause) (-> default-settings allow-pause))
    (set! (-> current-settings allow-progress) (-> default-settings allow-progress))
    (set! (-> current-settings allow-look-around) (-> default-settings allow-look-around))
    (set! (-> current-settings ocean-off) (-> default-settings ocean-off))))

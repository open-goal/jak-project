;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/game/game-info.gc")
(require "engine/ui/text-h.gc")
(require "engine/gfx/sprite/sparticle/sparticle-launcher.gc")
(require "engine/ps2/memcard-h.gc")
(require "engine/load/loader.gc")

;; The game-save system implements background automatic saving.

;; The process works like this:
;;  - The useful parts of game-info are packed into a game-save (all at once)
;;  - The auto-save process runs a state machine to write this to memory card.
;;  - The main loop also calls mc-run to advance the PC memory-card backend.
;;
;; The GOAL process owns the user-facing operation and the backend owns each asynchronous card
;; request, so both state machines must advance while a save is in progress.

(define-extern mark-speedrun-started (function none))

;; version identifier
(defconstant SAVE_VERSION 1)

;; the C++ memory card functions also use these codes.
(defenum mc-status-code
  :type uint32
  (busy 0)
  (ok 1)
  (bad-handle 2)
  (format-failed 3)
  (internal-error 4)
  (write-error 5)
  (read-error 6)
  (new-game 7)
  (no-memory 8)
  (no-card 9)
  (no-last 10)
  (no-format 11)
  (no-file 12)
  (no-save 13)
  (no-space 14)
  (bad-version 15)
  (no-process 16)
  (no-auto-save 17))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; state serialization
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; identifier for game save fields
(defenum game-save-elt
  :type uint16
  (name 100)
  (base-time 101)
  (real-time 102)
  (game-time 103)
  (integral-time 104)
  (continue 200)
  (life 201)
  (money 202)
  (money-total 203)
  (money-per-level 204)
  (buzzer-total 205)
  (fuel-cell 206)
  (death-movie-tick 207)
  (task-list 300)
  (perm-list 301)
  (hint-list 303)
  (text-list 304)
  (level-open-list 305)
  (total-deaths 400)
  (continue-deaths 401)
  (fuel-cell-deaths 402)
  (game-start-time 403)
  (continue-timke 404) ;; typo in game
  (death-time 405)
  (hit-time 406)
  (fuel-cell-pickup-time 407)
  (continue-time 408)
  (fuel-cell-time 409)
  (enter-level-time 410)
  (deaths-per-level 411)
  (death-pos 412)
  (auto-save-count 413)
  (in-level-time 414)
  (sfx-volume 500)
  (music-volume 501)
  (dialog-volume 502)
  (language 503)
  (screenx 504)
  (screeny 505)
  (vibration 506)
  (play-hints 507)
  (video-mode 508)
  (aspect-ratio 509))

;; DECOMP BEGINS

(deftype game-save-tag (structure)
  "A 16-byte save-field header. Scalar values occupy the eight-byte user overlay; strings and
   arrays follow the header, with elt-count and elt-size describing their payload. The next header
   begins after the payload rounded up to a 16-byte boundary."
  ((user-object object 2)
   (user-uint64 uint64 :overlay-at (-> user-object 0))
   (user-float0 float :overlay-at (-> user-object 0))
   (user-float float 2 :overlay-at (-> user-object 0))
   (user-int32 int32 2 :overlay-at (-> user-object 0))
   (user-uint32 uint32 2 :overlay-at (-> user-object 0))
   (user-int16 int16 4 :overlay-at (-> user-object 0))
   (user-uint16 uint16 4 :overlay-at (-> user-object 0))
   (user-int8 int8 8 :overlay-at (-> user-object 0))
   (user-int80 int8 :overlay-at (-> user-object 0))
   (user-int81 int8 :overlay-at (-> user-int8 1))
   (user-uint8 uint8 8 :overlay-at (-> user-object 0))
   (elt-count int32)
   (elt-size uint16)
   (elt-type game-save-elt)))

(deftype game-save (basic)
  "A versioned save record with a fixed 64-byte summary followed by aligned game-save-tag records.
   The summary supports save-menu display without unpacking the dynamic payload."
  ((version int32)
   (allocated-length int32)
   (length int32)
   (info-int32 int32 16)
   (info-int8 int8 64 :overlay-at (-> info-int32 0))
   (level-index int32 :overlay-at (-> info-int32 0))
   (fuel-cell-count float :overlay-at (-> info-int32 1))
   (money-count float :overlay-at (-> info-int32 2))
   (buzzer-count float :overlay-at (-> info-int32 3))
   (completion-percentage float :overlay-at (-> info-int32 4))
   (minute uint8 :overlay-at (-> info-int32 5))
   (hour uint8 :overlay-at (-> info-int8 21))
   (week uint8 :overlay-at (-> info-int8 22))
   (day uint8 :overlay-at (-> info-int8 23))
   (month uint8 :overlay-at (-> info-int32 6))
   (year uint8 :overlay-at (-> info-int8 25))
   (new-game int32 :overlay-at (-> info-int32 7))
   (tag game-save-tag :inline :dynamic))
  (:methods
   (new (symbol type int) _type_)
   (save-to-file (_type_ string) _type_)
   (load-from-file! (_type_ string) _type_)
   (debug-print (_type_ symbol) _type_)))

(defmethod asize-of ((this game-save))
  "Return the fixed save header plus its allocated dynamic payload capacity."
  (the-as int (+ (-> game-save size) (the-as uint (-> this allocated-length)))))

(defmethod new game-save ((allocation symbol) (type-to-make type) (tag-capacity int))
  "Allocate a save with tag-capacity bytes of dynamic tagged payload storage."
  (let ((save (object-new allocation type-to-make (the-as int (+ (-> type-to-make size) (the-as uint tag-capacity))))))
    (set! (-> save version) SAVE_VERSION)
    (set! (-> save allocated-length) tag-capacity)
    save))

(defun-debug game-save-elt->string ((elt game-save-elt))
  "Return the debug name of a save tag kind."
  (enum->string game-save-elt elt))

(defun progress-level-index->string ((progress-level-index int))
  "Return the translated level name for a progress-table index, or #f when out of range."
  (if (< progress-level-index (-> *level-task-data* length))
    (lookup-text! *common-text* (-> *level-task-data* progress-level-index level-name-id) #f)
    (the-as string #f)))

(defmethod debug-print ((this game-save) (detail symbol))
  "Print the save summary and tag headers. When detail is true, also decode known array tags."
  (format #t "[~8x] ~A~%" this (-> this type))
  (format #t "~Tversion: ~D~%" (-> this version))
  (format #t "~Tallocated-length: ~D~%" (-> this allocated-length))
  (format #t "~Tlength: ~D~%" (-> this length))
  (format #t "~Tlevel-index: ~D~%" (-> this level-index))
  (format #t "~Tfuel-cell-count: ~f~%" (-> this fuel-cell-count))
  (format #t "~Tmoney-count: ~f~%" (-> this money-count))
  (format #t "~Tbuzzer-count: ~f~%" (-> this buzzer-count))
  (format #t "~Tcompletion-percentage: ~f~%" (-> this completion-percentage))
  (format #t "~Tsave-time: ~x:~x ~x/~x/~x~%" (-> this hour) (-> this minute) (-> this day) (-> this month) (-> this year))
  (format #t "~Ttag[]: @ #x~X~%" (-> this tag))
  ;; loop through tags
  (let ((tag (the-as game-save-tag (-> this tag)))
        (tag-idx 0))
    (while (< (the-as int tag) (the-as int (&-> this tag 0 user-int8 (-> this length))))
      (format #t
              "~T  [~3D] ~-32S [~3D/~3D]  ~12D ~8f    "
              tag-idx
              (game-save-elt->string (-> tag elt-type))
              (-> tag elt-count)
              (-> tag elt-size)
              (-> tag user-uint64)
              (-> tag user-float0))
      (let ((tag-kind (-> tag elt-type)))
        (if (or (= tag-kind (game-save-elt name)) (= tag-kind (game-save-elt continue)))
          (format #t "= \"~G\"~%" (&+ (the-as pointer tag) 16))
          (format #t "~%")))
      (when detail
        (case (-> tag elt-type)
          (((game-save-elt money-per-level)
            (game-save-elt deaths-per-level)
            ;; added in pc port
            (game-save-elt level-open-list))
           (dotimes (prog-lev-idx (-> tag elt-count))
             (let ((lev-name (progress-level-index->string prog-lev-idx)))
               (if lev-name
                 (format #t
                         "                 ~-32S: ~D~%"
                         lev-name
                         (-> (the-as (pointer uint8) (&+ (the-as pointer (&-> (the-as (pointer uint8) tag) 16)) prog-lev-idx))))))))
          (((game-save-elt enter-level-time))
           (dotimes (prog-lev-idx (-> tag elt-count))
             (let ((lev-name (progress-level-index->string prog-lev-idx)))
               (if lev-name
                 (format #t
                         "                 ~-32S: ~D~%"
                         lev-name
                         (-> (the-as (pointer uint64) (&+ (&+ (the-as pointer tag) 16) (* prog-lev-idx 8)))))))))
          (((game-save-elt in-level-time))
           (dotimes (prog-lev-idx (-> tag elt-count))
             (let ((lev-name (progress-level-index->string prog-lev-idx)))
               (if lev-name
                 (format #t
                         "                 ~-32S: ~D~%"
                         lev-name
                         (-> (the-as (pointer uint64) (&+ (&+ (the-as pointer tag) 16) (* prog-lev-idx 8)))))))))
          (((game-save-elt fuel-cell-time))
           (dotimes (task (-> tag elt-count))
             (let ((task-name (game-task->string (the-as game-task task))))
               (if task-name
                 (format #t
                         "                 ~-32S: ~D~%"
                         task-name
                         (-> (the-as (pointer uint64) (&+ (&+ (the-as pointer tag) 16) (* task 8)))))))))
          ;; below here were added for pc port
          (((game-save-elt hint-list))
           (dotimes (i (-> tag elt-count))
             (awhen (text-id->string (-> *game-info* hint-control i id))
               (format #t "                 ~-32S [~D]~%" it i)
               (format #t
                       "                 ~-32S: ~D~%"
                       "start-time"
                       (-> (the-as (pointer uint64) (&+ (&+ (the-as pointer tag) 16) (* i (-> tag elt-size)))) 0))
               (format #t
                       "                 ~-32S: ~D~%"
                       "last-time-called"
                       (-> (the-as (pointer uint64) (&+ (&+ (the-as pointer tag) 16) (* i (-> tag elt-size)))) 1))
               (format #t
                       "                 ~-32S: ~D~%"
                       "num-attempts"
                       (-> (the-as (pointer uint8) (&+ (&+ (the-as pointer tag) 16) (* i (-> tag elt-size)))) 16))
               (format #t
                       "                 ~-32S: ~D~%"
                       "num-success"
                       (-> (the-as (pointer uint8) (&+ (&+ (the-as pointer tag) 16) (* i (-> tag elt-size)))) 17)))))
          (((game-save-elt text-list))
           (dotimes (i (* 8 (-> tag elt-count)))
             (awhen (text-id->string (the text-id i))
               (unless (string= it "*unknown*")
                 (format #t
                         "                 ~-32S: ~A~%"
                         it
                         (logtest? (-> (the-as (pointer uint8) (&+ (the-as pointer tag) 16)) (/ i 8)) (ash 1 (mod i 8))))))))
          (((game-save-elt task-list) (game-save-elt perm-list))
           (dotimes (i (-> tag elt-count))
             (let ((perm (the-as entity-perm (&+ (the-as pointer tag) 16 (* i 16)))))
               (format #t
                       "~T    ~-4D: ~20D/#x~16x[~8f/~8f]"
                       i
                       (-> perm user-uint64)
                       (-> perm user-uint64)
                       (-> perm user-float 0)
                       (-> perm user-float 1))
               (format #t "  task: ~-32S #x~4x~%" (game-task->string (-> perm task)) (-> perm aid))
               (format #t "~T~T    (entity-perm-status ")
               (bit-enum->string entity-perm-status (-> perm status) #t)
               (format #t ")~%"))))))
      (set! tag
            (the-as game-save-tag
                    (&+ (the-as pointer tag) (logand -16 (+ (* (the-as int (-> tag elt-size)) (-> tag elt-count)) 31)))))
      (+! tag-idx 1)))
  this)

(defmethod inspect ((this game-save))
  (debug-print this #f))

(defmethod save-game! ((this game-info) (save game-save) (save-name string))
  "Pack the current persistent game state into save with save-name. Copy active-level entity
   permissions first, write the summary used by the save menu, then append aligned tagged payloads
   for progression, timers, settings, hints, tasks, and entity permissions."
  ;; some stuff lives in the levels and needs to be copied into game-info.
  (dotimes (i (-> *level* length))
    (let ((lev (-> *level* level i))) (if (= (-> lev status) 'active) (copy-perms-from-level! this lev))))
  ;; set common data
  (set! (-> save length) 0)
  (set! (-> save version) 1)
  (set! (-> save level-index) (-> (lookup-level-info (-> this current-continue level)) index))
  (set! (-> save fuel-cell-count) (-> this fuel))
  (set! (-> save money-count) (-> this money-total))
  (set! (-> save buzzer-count) (-> this buzzer-total))
  (set! (-> save completion-percentage) (calculate-completion (the-as progress #f)))
  (when (string= (-> this current-continue name) "title-start")
    (set! (-> save new-game) 1)
    (set! (-> save level-index) (-> (lookup-level-info 'training) index))
    (set! (-> save fuel-cell-count) 0.0)
    (set! (-> save money-count) 0.0)
    (set! (-> save buzzer-count) 0.0)
    (set! (-> save completion-percentage) 0.0))
  (let ((clock (new 'stack 'scf-time)))
    (scf-get-time clock)
    (when (zero? (-> clock stat))
      (set! (-> save minute) (-> clock minute))
      (set! (-> save hour) (-> clock hour))
      (set! (-> save day) (-> clock day))
      (set! (-> save week) (-> clock week))
      (set! (-> save month) (-> clock month))
      (set! (-> save year) (-> clock year))))
  (let ((tag-base (the-as object (-> save tag))))
    (let ((name-tag (-> (the-as (inline-array game-save-tag) tag-base) 0)))
      (set! (-> name-tag elt-type) (game-save-elt name))
      (set! (-> name-tag elt-count) (+ (length save-name) 1))
      (set! (-> name-tag elt-size) (the-as uint 1)))
    (copy-charp<-charp (-> (the-as (inline-array game-save-tag) tag-base) 1 user-uint8) (-> save-name data))
    (let ((base-time-pos (&+ (the-as pointer tag-base)
                             (+ (logand -16 (+ (-> (the-as (inline-array game-save-tag) tag-base) 0 elt-count) 15)) 16))))
      (let ((base-time-tag (the-as game-save-tag (&+ base-time-pos 0))))
        (set! (-> base-time-tag elt-type) (game-save-elt base-time))
        (set! (-> base-time-tag elt-count) 0)
        (set! (-> base-time-tag user-uint64) (the-as uint (current-time))))
      (let ((real-time-pos (&+ base-time-pos 16)))
        (let ((real-time-tag (the-as game-save-tag (&+ real-time-pos 0))))
          (set! (-> real-time-tag elt-type) (game-save-elt real-time))
          (set! (-> real-time-tag elt-count) 0)
          (set! (-> real-time-tag user-uint64) (the-as uint (-> *display* real-frame-counter))))
        (let ((game-time-pos (&+ real-time-pos 16)))
          (let ((game-time-tag (the-as game-save-tag (&+ game-time-pos 0))))
            (set! (-> game-time-tag elt-type) (game-save-elt game-time))
            (set! (-> game-time-tag elt-count) 0)
            (set! (-> game-time-tag user-uint64) (the-as uint (-> *display* game-frame-counter))))
          (let ((integral-time-pos (&+ game-time-pos 16)))
            (let ((integral-time-tag (the-as game-save-tag (&+ integral-time-pos 0))))
              (set! (-> integral-time-tag elt-type) (game-save-elt integral-time))
              (set! (-> integral-time-tag elt-count) 0)
              (set! (-> integral-time-tag user-uint64) (the-as uint (-> *display* integral-frame-counter))))
            (let ((continue-pos (the-as object (&+ integral-time-pos 16))))
              (let ((continue-name (-> this current-continue name)))
                (let ((continue-tag (the-as game-save-tag (-> (the-as game-save-tag continue-pos) user-object))))
                  (set! (-> continue-tag elt-type) (game-save-elt continue))
                  (set! (-> continue-tag elt-count) (+ ((method-of-type string length) continue-name) 1))
                  (set! (-> continue-tag elt-size) (the-as uint 1)))
                (copy-charp<-charp (-> (the-as game-save-tag (&+ (the-as game-save-tag continue-pos) 16)) user-uint8)
                                   (-> continue-name data)))
              (let ((life-pos (&+ (the-as pointer continue-pos) (+ (logand -16 (+ (-> (the-as game-save-tag continue-pos) elt-count) 15)) 16))))
                (let ((life-tag (the-as game-save-tag (&+ life-pos 0))))
                  (set! (-> life-tag elt-type) (game-save-elt life))
                  (set! (-> life-tag elt-count) 0)
                  (set! (-> life-tag user-float0) (-> this life)))
                (let ((buzzer-total-pos (&+ life-pos 16)))
                  (let ((buzzer-total-tag (the-as game-save-tag (&+ buzzer-total-pos 0))))
                    (set! (-> buzzer-total-tag elt-type) (game-save-elt buzzer-total))
                    (set! (-> buzzer-total-tag elt-count) 0)
                    (set! (-> buzzer-total-tag user-float0) (-> this buzzer-total)))
                  (let ((fuel-cell-pos (&+ buzzer-total-pos 16)))
                    (let ((fuel-cell-tag (the-as game-save-tag (&+ fuel-cell-pos 0))))
                      (set! (-> fuel-cell-tag elt-type) (game-save-elt fuel-cell))
                      (set! (-> fuel-cell-tag elt-count) 0)
                      (set! (-> fuel-cell-tag user-float0) (-> this fuel)))
                    (let ((death-movie-pos (&+ fuel-cell-pos 16)))
                      (let ((death-movie-tag (the-as game-save-tag (&+ death-movie-pos 0))))
                        (set! (-> death-movie-tag elt-type) (game-save-elt death-movie-tick))
                        (set! (-> death-movie-tag elt-count) 0)
                        (set! (-> death-movie-tag user-uint64) (the-as uint (-> this death-movie-tick))))
                      (let ((money-pos (&+ death-movie-pos 16)))
                        (let ((money-tag (the-as game-save-tag (&+ money-pos 0))))
                          (set! (-> money-tag elt-type) (game-save-elt money))
                          (set! (-> money-tag elt-count) 0)
                          (set! (-> money-tag user-float0) (-> this money)))
                        (let ((money-total-pos (&+ money-pos 16)))
                          (let ((money-total-tag (the-as game-save-tag (&+ money-total-pos 0))))
                            (set! (-> money-total-tag elt-type) (game-save-elt money-total))
                            (set! (-> money-total-tag elt-count) 0)
                            (set! (-> money-total-tag user-float0) (-> this money-total)))
                          (let ((money-per-level-pos (&+ money-total-pos 16)))
                            (let ((money-per-level-tag (the-as game-save-tag (&+ money-per-level-pos 0))))
                              (set! (-> money-per-level-tag elt-type) (game-save-elt money-per-level))
                              (set! (-> money-per-level-tag elt-count) 32)
                              (set! (-> money-per-level-tag elt-size) (the-as uint 1)))
                            (let ((money-per-level-data (&+ money-per-level-pos 16)))
                              (dotimes (i 32)
                                (set! (-> (the-as (pointer uint8) (&+ money-per-level-data i))) (-> this money-per-level i)))
                              (let ((level-open-pos (&+ money-per-level-data 32)))
                                (let ((level-open-tag (the-as object (&+ level-open-pos 0))))
                                  (set! (-> (the-as game-save-tag level-open-tag) elt-type) (game-save-elt level-open-list))
                                  (set! (-> (the-as game-save-tag level-open-tag) elt-count) 32)
                                  (set! (-> (the-as game-save-tag level-open-tag) elt-size) (the-as uint 1)))
                                (let ((level-open-data (&+ level-open-pos 16)))
                                  (dotimes (i 32)
                                    (set! (-> (the-as (pointer uint8) (&+ level-open-data i))) (-> this level-opened i)))
                                  (let ((perm-list-pos (&+ level-open-data 32))
                                        (perm-count (-> (the-as (pointer int32) (-> this perm-list)) 0)))
                                    (let ((perm-list-tag (the-as game-save-tag (&+ perm-list-pos 0))))
                                      (set! (-> perm-list-tag elt-type) (game-save-elt perm-list))
                                      (set! (-> perm-list-tag elt-count) perm-count)
                                      (set! (-> perm-list-tag elt-size) (the-as uint 16)))
                                    (let ((perm-data (&+ perm-list-pos 16)))
                                      (dotimes (i perm-count)
                                        (mem-copy! (the-as pointer (the-as game-save-tag (&+ perm-data (* i 16))))
                                                   (the-as pointer (-> this perm-list data i))
                                                   16))
                                      (let ((task-list-pos (&+ perm-data (logand -16 (+ (* perm-count 16) 15))))
                                            (task-count (-> this task-perm-list length)))
                                        (let ((task-list-tag (the-as game-save-tag (&+ task-list-pos 0))))
                                          (set! (-> task-list-tag elt-type) (game-save-elt task-list))
                                          (set! (-> task-list-tag elt-count) task-count)
                                          (set! (-> task-list-tag elt-size) (the-as uint 16)))
                                        (let ((task-data (&+ task-list-pos 16)))
                                          (dotimes (i task-count)
                                            (mem-copy! (the-as pointer (the-as game-save-tag (&+ task-data (* i 16))))
                                                       (the-as pointer (-> this task-perm-list data i))
                                                       16))
                                          (let ((text-list-pos (&+ task-data (logand -16 (+ (* task-count 16) 15))))
                                                (text-byte-count (/ (logand -8 (+ (-> this text-ids-seen allocated-length) 7)) 8)))
                                            (let ((text-list-tag (the-as object (&+ text-list-pos 0))))
                                              (set! (-> (the-as game-save-tag text-list-tag) elt-type) (game-save-elt text-list))
                                              (set! (-> (the-as game-save-tag text-list-tag) elt-count) text-byte-count)
                                              (set! (-> (the-as game-save-tag text-list-tag) elt-size) (the-as uint 1)))
                                            (let ((text-data (&+ text-list-pos 16)))
                                              (dotimes (i text-byte-count)
                                                (set! (-> (the-as (pointer uint8) (&+ text-data i))) (-> this text-ids-seen bytes i)))
                                              (let ((hint-list-pos (&+ text-data (logand -16 (+ text-byte-count 15))))
                                                    (hint-count (-> this hint-control length)))
                                                (let ((hint-list-tag (the-as game-save-tag (&+ hint-list-pos 0))))
                                                  (set! (-> hint-list-tag elt-type) (game-save-elt hint-list))
                                                  (set! (-> hint-list-tag elt-count) hint-count)
                                                  (set! (-> hint-list-tag elt-size) (the-as uint 32)))
                                                (let ((hint-data (&+ hint-list-pos 16)))
                                                  (dotimes (i hint-count)
                                                    (set! (-> (the-as (pointer int64) (&+ hint-data (* (* i 4) 8)))) (-> this hint-control i start-time))
                                                    (set! (-> (the-as (pointer int64) (&+ hint-data (* (+ (* i 4) 1) 8)))) (-> this hint-control i last-time-called))
                                                    (set! (-> (the-as (pointer int8) (&+ hint-data (+ (* i 32) 16)))) (-> this hint-control i num-attempts))
                                                    (set! (-> (the-as (pointer int8) (&+ hint-data (+ (* i 32) 17)))) (-> this hint-control i num-success)))
                                                  (let ((auto-save-count-pos (&+ hint-data (* hint-count 32))))
                                                    (let ((auto-save-count-tag (the-as game-save-tag (&+ auto-save-count-pos 0))))
                                                      (set! (-> auto-save-count-tag elt-type) (game-save-elt auto-save-count))
                                                      (set! (-> auto-save-count-tag elt-count) 0)
                                                      (set! (-> auto-save-count-tag user-uint64) (the-as uint (-> this auto-save-count))))
                                                    (let ((total-deaths-pos (&+ auto-save-count-pos 16)))
                                                      (let ((total-deaths-tag (the-as game-save-tag (&+ total-deaths-pos 0))))
                                                        (set! (-> total-deaths-tag elt-type) (game-save-elt total-deaths))
                                                        (set! (-> total-deaths-tag elt-count) 0)
                                                        (set! (-> total-deaths-tag user-uint64) (the-as uint (-> this total-deaths))))
                                                      (let ((continue-deaths-pos (&+ total-deaths-pos 16)))
                                                        (let ((continue-deaths-tag (the-as game-save-tag (&+ continue-deaths-pos 0))))
                                                          (set! (-> continue-deaths-tag elt-type) (game-save-elt continue-deaths))
                                                          (set! (-> continue-deaths-tag elt-count) 0)
                                                          (set! (-> continue-deaths-tag user-uint64) (the-as uint (-> this continue-deaths))))
                                                        (let ((fuel-cell-deaths-pos (&+ continue-deaths-pos 16)))
                                                          (let ((fuel-cell-deaths-tag (the-as game-save-tag (&+ fuel-cell-deaths-pos 0))))
                                                            (set! (-> fuel-cell-deaths-tag elt-type) (game-save-elt fuel-cell-deaths))
                                                            (set! (-> fuel-cell-deaths-tag elt-count) 0)
                                                            (set! (-> fuel-cell-deaths-tag user-uint64) (the-as uint (-> this fuel-cell-deaths))))
                                                          (let ((game-start-time-pos (&+ fuel-cell-deaths-pos 16)))
                                                            (let ((game-start-time-tag (the-as game-save-tag (&+ game-start-time-pos 0))))
                                                              (set! (-> game-start-time-tag elt-type) (game-save-elt game-start-time))
                                                              (set! (-> game-start-time-tag elt-count) 0)
                                                              (set! (-> game-start-time-tag user-uint64) (the-as uint (-> this game-start-time))))
                                                            (let ((continue-time-pos (&+ game-start-time-pos 16)))
                                                              (let ((continue-time-tag (the-as game-save-tag (&+ continue-time-pos 0))))
                                                                (set! (-> continue-time-tag elt-type) (game-save-elt continue-time))
                                                                (set! (-> continue-time-tag elt-count) 0)
                                                                (set! (-> continue-time-tag user-uint64) (the-as uint (-> this continue-time))))
                                                              (let ((death-time-pos (&+ continue-time-pos 16)))
                                                                (let ((death-time-tag (the-as game-save-tag (&+ death-time-pos 0))))
                                                                  (set! (-> death-time-tag elt-type) (game-save-elt death-time))
                                                                  (set! (-> death-time-tag elt-count) 0)
                                                                  (set! (-> death-time-tag user-uint64) (the-as uint (-> this death-time))))
                                                                (let ((hit-time-pos (&+ death-time-pos 16)))
                                                                  (let ((hit-time-tag (the-as game-save-tag (&+ hit-time-pos 0))))
                                                                    (set! (-> hit-time-tag elt-type) (game-save-elt hit-time))
                                                                    (set! (-> hit-time-tag elt-count) 0)
                                                                    (set! (-> hit-time-tag user-uint64) (the-as uint (-> this hit-time))))
                                                                  (let ((fuel-cell-pickup-time-pos (&+ hit-time-pos 16)))
                                                                    (let ((fuel-cell-pickup-time-tag (the-as game-save-tag (&+ fuel-cell-pickup-time-pos 0))))
                                                                      (set! (-> fuel-cell-pickup-time-tag elt-type) (game-save-elt fuel-cell-pickup-time))
                                                                      (set! (-> fuel-cell-pickup-time-tag elt-count) 0)
                                                                      (set! (-> fuel-cell-pickup-time-tag user-uint64) (the-as uint (-> this fuel-cell-pickup-time))))
                                                                    (let ((fuel-cell-time-pos (&+ fuel-cell-pickup-time-pos 16)))
                                                                      (let ((fuel-cell-time-tag (the-as game-save-tag (&+ fuel-cell-time-pos 0))))
                                                                        (set! (-> fuel-cell-time-tag elt-type) (game-save-elt fuel-cell-time))
                                                                        (set! (-> fuel-cell-time-tag elt-count) 116)
                                                                        (set! (-> fuel-cell-time-tag elt-size) (the-as uint 8)))
                                                                      (let ((fuel-cell-time-data (&+ fuel-cell-time-pos 16)))
                                                                        (let ((i (the-as object 0)))
                                                                          (while (< (the-as int i) 116)
                                                                            (set! (-> (the-as (pointer int64) (&+ fuel-cell-time-data (* (the-as int i) 8))))
                                                                                  (-> this fuel-cell-time (the-as int i)))
                                                                            (set! i (+ (the-as int i) 1))))
                                                                        (let ((deaths-per-level-pos (&+ fuel-cell-time-data 928)))
                                                                          (let ((deaths-per-level-tag (the-as game-save-tag (&+ deaths-per-level-pos 0))))
                                                                            (set! (-> deaths-per-level-tag elt-type) (game-save-elt deaths-per-level))
                                                                            (set! (-> deaths-per-level-tag elt-count) 32)
                                                                            (set! (-> deaths-per-level-tag elt-size) (the-as uint 1)))
                                                                          (let ((deaths-per-level-data (&+ deaths-per-level-pos 16)))
                                                                            (dotimes (i 32)
                                                                              (set! (-> (the-as (pointer uint8) (&+ deaths-per-level-data i))) (-> this deaths-per-level i)))
                                                                            (let ((enter-level-time-pos (&+ deaths-per-level-data 32)))
                                                                              (let ((enter-level-time-tag (the-as game-save-tag (&+ enter-level-time-pos 0))))
                                                                                (set! (-> enter-level-time-tag elt-type) (game-save-elt enter-level-time))
                                                                                (set! (-> enter-level-time-tag elt-count) 32)
                                                                                (set! (-> enter-level-time-tag elt-size) (the-as uint 8)))
                                                                              (let ((enter-level-time-data (&+ enter-level-time-pos 16)))
                                                                                (dotimes (i 32)
                                                                                  (set! (-> (the-as (pointer int64) (&+ enter-level-time-data (* i 8)))) (-> this enter-level-time i)))
                                                                                (let ((in-level-time-pos (&+ enter-level-time-data 256)))
                                                                                  (let ((in-level-time-tag (the-as game-save-tag (&+ in-level-time-pos 0))))
                                                                                    (set! (-> in-level-time-tag elt-type) (game-save-elt in-level-time))
                                                                                    (set! (-> in-level-time-tag elt-count) 32)
                                                                                    (set! (-> in-level-time-tag elt-size) (the-as uint 8)))
                                                                                  (let ((in-level-time-data (&+ in-level-time-pos 16)))
                                                                                    (dotimes (i 32)
                                                                                      (set! (-> (the-as (pointer int64) (&+ in-level-time-data (* i 8)))) (-> this in-level-time i)))
                                                                                    (let ((sfx-volume-pos (&+ in-level-time-data 256)))
                                                                                      (let ((sfx-volume-tag (the-as game-save-tag (&+ sfx-volume-pos 0))))
                                                                                        (set! (-> sfx-volume-tag elt-type) (game-save-elt sfx-volume))
                                                                                        (set! (-> sfx-volume-tag elt-count) 0)
                                                                                        (set! (-> sfx-volume-tag user-float0) (-> *setting-control* default sfx-volume)))
                                                                                      (let ((music-volume-pos (&+ sfx-volume-pos 16)))
                                                                                        (let ((music-volume-tag (the-as game-save-tag (&+ music-volume-pos 0))))
                                                                                          (set! (-> music-volume-tag elt-type) (game-save-elt music-volume))
                                                                                          (set! (-> music-volume-tag elt-count) 0)
                                                                                          (set! (-> music-volume-tag user-float0) (-> *setting-control* default music-volume)))
                                                                                        (let ((dialog-volume-pos (&+ music-volume-pos 16)))
                                                                                          (let ((dialog-volume-tag (the-as game-save-tag (&+ dialog-volume-pos 0))))
                                                                                            (set! (-> dialog-volume-tag elt-type) (game-save-elt dialog-volume))
                                                                                            (set! (-> dialog-volume-tag elt-count) 0)
                                                                                            (set! (-> dialog-volume-tag user-float0) (-> *setting-control* default dialog-volume)))
                                                                                          (let ((language-pos (&+ dialog-volume-pos 16)))
                                                                                            (let ((language-tag (the-as game-save-tag (&+ language-pos 0))))
                                                                                              (set! (-> language-tag elt-type) (game-save-elt language))
                                                                                              (set! (-> language-tag elt-count) 0)
                                                                                              (set! (-> language-tag user-uint64) (the-as uint (-> *setting-control* default language))))
                                                                                            (let ((screenx-pos (&+ language-pos 16)))
                                                                                              (let ((screenx-tag (the-as game-save-tag (&+ screenx-pos 0))))
                                                                                                (set! (-> screenx-tag elt-type) (game-save-elt screenx))
                                                                                                (set! (-> screenx-tag elt-count) 0)
                                                                                                (set! (-> screenx-tag user-float0) (the float (-> *setting-control* default screenx))))
                                                                                              (let ((screeny-pos (&+ screenx-pos 16)))
                                                                                                (let ((screeny-tag (the-as game-save-tag (&+ screeny-pos 0))))
                                                                                                  (set! (-> screeny-tag elt-type) (game-save-elt screeny))
                                                                                                  (set! (-> screeny-tag elt-count) 0)
                                                                                                  (set! (-> screeny-tag user-float0) (the float (-> *setting-control* default screeny))))
                                                                                                (let ((vibration-pos (&+ screeny-pos 16)))
                                                                                                  (let ((vibration-tag (the-as game-save-tag (&+ vibration-pos 0))))
                                                                                                    (set! (-> vibration-tag elt-type) (game-save-elt vibration))
                                                                                                    (set! (-> vibration-tag elt-count) 0)
                                                                                                    (set! (-> vibration-tag user-uint64) (the-as uint (if (-> *setting-control* default vibration) 1 0))))
                                                                                                  (let ((play-hints-pos (&+ vibration-pos 16)))
                                                                                                    (let ((play-hints-tag (the-as game-save-tag (&+ play-hints-pos 0))))
                                                                                                      (set! (-> play-hints-tag elt-type) (game-save-elt play-hints))
                                                                                                      (set! (-> play-hints-tag elt-count) 0)
                                                                                                      (set! (-> play-hints-tag user-uint64) (the-as uint (if (-> *setting-control* default play-hints) 1 0))))
                                                                                                    (let ((video-mode-pos (&+ play-hints-pos 16)))
                                                                                                      (let ((video-mode-tag (the-as game-save-tag (&+ video-mode-pos 0))))
                                                                                                        (set! (-> video-mode-tag elt-type) (game-save-elt video-mode))
                                                                                                        (set! (-> video-mode-tag elt-count) 0)
                                                                                                        (let ((video-mode (-> *setting-control* default video-mode)))
                                                                                                          (set! (-> video-mode-tag user-uint64)
                                                                                                                (the-as uint
                                                                                                                        (cond
                                                                                                                          ((= video-mode 'ntsc) 1)
                                                                                                                          ((= video-mode 'pal) 2)
                                                                                                                          (else 0))))))
                                                                                                      (let ((aspect-ratio-pos (&+ video-mode-pos 16)))
                                                                                                        (let ((aspect-ratio-tag (the-as object (&+ aspect-ratio-pos 0))))
                                                                                                          (set! (-> (the-as game-save-tag aspect-ratio-tag) elt-type) (game-save-elt aspect-ratio))
                                                                                                          (set! (-> (the-as game-save-tag aspect-ratio-tag) elt-count) 0)
                                                                                                          (let ((aspect-ratio (-> *setting-control* default aspect-ratio)))
                                                                                                            (set! (-> (the-as (pointer int64) aspect-ratio-tag))
                                                                                                                  (cond
                                                                                                                    ((= aspect-ratio 'aspect4x3) 1)
                                                                                                                    ((= aspect-ratio 'aspect16x9) 2)
                                                                                                                    (else 0)))))
                                                                                                        (set! (-> save length) (&- (&+ aspect-ratio-pos 16) (the-as uint (the-as pointer (-> save tag))))))))))))))))))))))))))))))))))))))))))))))))))))))))
  (if (< (-> save allocated-length) (-> save length))
    (format 0 "ERROR: SAVEGAME: fatal error, save is using ~D of ~D bytes." (-> save length) (-> save allocated-length)))
  (none))

(defmethod load-game! ((this game-info) (save game-save))
  "Restore persistent game state from save. Keep PC-owned settings and speedrun state, shift
   live display deadlines when the saved base clock is installed, bound variable-sized arrays to
   their current capacities, copy permissions back to active levels, and refresh task status."
  (let ((save-data (the-as game-save-tag (-> save tag))))
    ;; loop over all tags
    (while (< (the-as int save-data) (the-as int (+ (+ (-> save length) 76) (the-as int save))))
      (let ((setting-kind (-> save-data elt-type)))
        ;; og:preserve-this Moved these settings to pc-settings
        (cond
          ;; ((= setting-kind (game-save-elt sfx-volume)) (set! (-> *setting-control* default sfx-volume) (-> save-data user-float0)))
          ;; ((= setting-kind (game-save-elt music-volume)) (set! (-> *setting-control* default music-volume) (-> save-data user-float0)))
          ;; ((= setting-kind (game-save-elt dialog-volume)) (set! (-> *setting-control* default dialog-volume) (-> save-data user-float0)))
          ((= setting-kind (game-save-elt language))
           (set! (-> *setting-control* default language) (the-as language-enum (-> save-data user-uint64))))
          ;; ((= setting-kind (game-save-elt vibration)) (set! (-> *setting-control* default vibration) (= (-> save-data user-uint64) 1)))
          ;; ((= setting-kind (game-save-elt play-hints)) (set! (-> *setting-control* default play-hints) (= (-> save-data user-uint64) 1)))
          (else (format 0 "PC PORT: Skipping setting from game save, its stored in the pc-settings now~%"))))
      (set! save-data
            (the-as game-save-tag
                    (&+ (the-as pointer save-data) (logand -16 (+ (* (the-as int (-> save-data elt-size)) (-> save-data elt-count)) 31)))))))
  ;; og:preserve-this make sure loading a save doesn't reset speedrun state
  (when (and (-> *pc-settings* speedrunner-mode?) (zero? (-> save new-game)))
    (mark-speedrun-started))
  ;; if we're a new game, set our checkpoint.
  (when (nonzero? (-> save new-game))
    (set-continue! this "game-start")
    (set! save save)
    (goto cfg-134))
  ;; loop over all tags
  (let ((data (the-as game-save-tag (-> save tag))))
    (while (< (the-as int data) (the-as int (&-> save tag 0 user-int8 (-> save length))))
      (case (-> data elt-type)
        (((game-save-elt base-time))
         (let ((old-base-frame (current-time)))
           (set! (current-time) (the-as time-frame (-> data user-uint64)))
           (set! (-> *display* old-base-frame-counter) (+ (current-time) -1))
           (let ((frame-counter-diff (- (current-time) old-base-frame)))
             (if (nonzero? (-> this blackout-time)) (+! (-> this blackout-time) frame-counter-diff))
             (if (nonzero? (-> this letterbox-time)) (+! (-> this letterbox-time) frame-counter-diff))
             (if (nonzero? (-> this hint-play-time)) (+! (-> this hint-play-time) frame-counter-diff))
             (if (nonzero? (-> this display-text-time)) (+! (-> this display-text-time) frame-counter-diff))))
         (buzz-stop! 0))
        (((game-save-elt game-time))
         (set! (-> *display* game-frame-counter) (the-as time-frame (-> data user-uint64)))
         (set! (-> *display* old-game-frame-counter) (+ (-> *display* game-frame-counter) -1)))
        (((game-save-elt real-time))
         (set! (-> *display* real-frame-counter) (the-as time-frame (-> data user-uint64)))
         (set! (-> *display* old-real-frame-counter) (+ (-> *display* real-frame-counter) -1)))
        (((game-save-elt integral-time))
         (set! (-> *display* integral-frame-counter) (the-as time-frame (-> data user-uint64)))
         (set! (-> *display* old-integral-frame-counter) (+ (-> *display* integral-frame-counter) -1)))
        (((game-save-elt continue))
         (format (clear *temp-string*) "~G" (&+ (the-as pointer data) 16))
         (set-continue! this *temp-string*))
        (((game-save-elt life)) (set! (-> this life) (-> data user-float0)))
        (((game-save-elt buzzer-total)) (set! (-> this buzzer-total) (-> data user-float0)))
        (((game-save-elt fuel-cell)) (set! (-> this fuel) (-> data user-float0)))
        (((game-save-elt death-movie-tick)) (set! (-> this death-movie-tick) (the-as int (-> data user-uint64))))
        (((game-save-elt money)) (set! (-> this money) (-> data user-float0)))
        (((game-save-elt money-total)) (set! (-> this money-total) (-> data user-float0)))
        (((game-save-elt money-per-level))
         (let ((count (min 32 (-> data elt-count))))
           (dotimes (i count)
             (set! (-> this money-per-level i) (-> (the-as (pointer uint8) (&+ (the-as pointer data) 16)) i)))))
        (((game-save-elt level-open-list))
         (let ((count (min 32 (-> data elt-count))))
           (dotimes (i count)
             (set! (-> this level-opened i) (-> (the-as (pointer uint8) (&+ (the-as pointer data) 16)) i)))))
        (((game-save-elt perm-list))
         (let ((count (min (-> data elt-count) (-> this perm-list allocated-length))))
           (set! (-> this perm-list length) count)
           (dotimes (i count)
             (mem-copy! (the-as pointer (-> this perm-list data i)) (&+ (&+ (the-as pointer data) 16) (* i 16)) 16))))
        (((game-save-elt task-list))
         (let ((count (min (-> data elt-count) (-> this task-perm-list allocated-length))))
           (set! (-> this task-perm-list length) count)
           (dotimes (i count)
             (mem-copy! (the-as pointer (-> this task-perm-list data i)) (&+ (&+ (the-as pointer data) 16) (* i 16)) 16))))
        (((game-save-elt text-list))
         (let ((byte-count (/ (logand -8 (+ (-> this text-ids-seen allocated-length) 7)) 8))
               (saved-byte-count (-> data elt-count)))
           (dotimes (i byte-count)
             (cond
               ((>= i saved-byte-count) (set! (-> this text-ids-seen bytes i) (the-as uint 0)) 0)
               (else (set! (-> this text-ids-seen bytes i) (-> (the-as (pointer uint8) (&+ (the-as pointer data) 16)) i)))))))
        (((game-save-elt hint-list))
         (cond
           ((= (-> this hint-control length) (-> data elt-count))
            (let ((hint-data (&+ (the-as pointer data) 16)))
              (dotimes (i (-> data elt-count))
                (set! (-> this hint-control i start-time)
                      (the-as time-frame (-> (the-as (pointer uint64) (&+ hint-data (* (* i 4) 8))))))
                (set! (-> this hint-control i last-time-called)
                      (the-as time-frame (-> (the-as (pointer uint64) (&+ hint-data (* (+ (* i 4) 1) 8))))))
                (set! (-> this hint-control i num-attempts)
                      (-> (the-as (pointer int8) (&+ (the-as (pointer uint8) hint-data) (+ (* i 32) 16)))))
                (set! (-> this hint-control i num-success)
                      (-> (the-as (pointer int8) (&+ (the-as (pointer uint8) hint-data) (+ (* i 32) 17))))))))
           (else (format 0 "WARNING: SAVEGAME: hint control list did not match current, ignoring~%"))))
        (((game-save-elt auto-save-count)) (set! (-> this auto-save-count) (the-as int (-> data user-uint64))))
        (((game-save-elt total-deaths)) (set! (-> this total-deaths) (the-as int (-> data user-uint64))))
        (((game-save-elt continue-deaths)) (set! (-> this continue-deaths) (the-as int (-> data user-uint64))))
        (((game-save-elt fuel-cell-deaths)) (set! (-> this fuel-cell-deaths) (the-as int (-> data user-uint64))))
        (((game-save-elt game-start-time)) (set! (-> this game-start-time) (the-as time-frame (-> data user-uint64))))
        (((game-save-elt continue-time)) (set! (-> this continue-time) (the-as time-frame (-> data user-uint64))))
        (((game-save-elt death-time)) (set! (-> this death-time) (the-as time-frame (-> data user-uint64))))
        (((game-save-elt hit-time)) (set! (-> this hit-time) (the-as time-frame (-> data user-uint64))))
        (((game-save-elt fuel-cell-pickup-time))
         (set! (-> this fuel-cell-pickup-time) (the-as time-frame (-> data user-uint64))))
        (((game-save-elt deaths-per-level))
         (let ((count (min 32 (-> data elt-count))))
           (dotimes (i count)
             (set! (-> this deaths-per-level i) (-> (the-as (pointer uint8) (&+ (the-as pointer data) 16)) i)))))
        (((game-save-elt enter-level-time))
         (let ((count (min 32 (-> data elt-count))))
           (dotimes (i count)
             (set! (-> this enter-level-time i)
                   (the-as time-frame (-> (the-as (pointer uint64) (&+ (&+ (the-as pointer data) 16) (* i 8)))))))))
        (((game-save-elt in-level-time))
         (let ((count (min 32 (-> data elt-count))))
           (dotimes (i count)
             (set! (-> this in-level-time i)
                   (the-as time-frame (-> (the-as (pointer uint64) (&+ (&+ (the-as pointer data) 16) (* i 8)))))))))
        (((game-save-elt fuel-cell-time))
         (let ((count (min 32 (-> data elt-count))))
           (dotimes (i count)
             (set! (-> this fuel-cell-time i)
                   (the-as time-frame (-> (the-as (pointer uint64) (&+ (&+ (the-as pointer data) 16) (* i 8))))))))))
      (set! data
            (the-as game-save-tag
                    (&+ (the-as pointer data) (logand -16 (+ (* (the-as int (-> data elt-size)) (-> data elt-count)) 31)))))))
  ;; update entity stuff in levels that are active
  (dotimes (i (-> *level* length))
    (let ((lev (-> *level* level i))) (if (= (-> lev status) 'active) (copy-perms-to-level! this lev))))
  ;; update tasks
  (let ((task 2) ;; jungle eggtop
        (last-task 115) ;; max - 1
        )
    (while (>= (the-as uint last-task) (the-as uint task))
      ;; calling this will run the function to see if the task is done or not
      (get-task-status (the-as game-task task))
      (+! task 1)))
  (label cfg-134)
  save)

(defmethod save-to-file ((this game-save) (filename string))
  "Write this save's header and active tagged payload to filename for debugging."
  (let ((stream (new 'stack 'file-stream filename 'write)))
    (file-stream-write stream (&-> this type) (+ (-> this type size) (the-as uint (-> this length))))
    (file-stream-close stream))
  this)

(defmethod load-from-file! ((this game-save) (filename string))
  "Read a debug save from filename when it fits this object's allocated capacity. Restore this
   object's capacity after the read and invalidate its payload on a short read or version mismatch."
  (let ((stream (new 'stack 'file-stream filename 'read)))
    (let ((in-size (file-stream-length stream))
          (my-size (-> this allocated-length)))
      (cond
        ((>= (asize-of this) in-size)
         ;; thing in file is not bigger than we are, safe to read.
         (cond
           ((= (file-stream-read stream (&-> this type) in-size) in-size)
            ;; read success! set the type tag
            (set! (-> this type) game-save))
           (else
            ;; fail.
            (format 0 "ERROR: SAVEGAME: save file ~A did not read correctly.~%" stream)
            (set! (-> this length) 0)
            0)))
        (else
         ;; file is bigger than we are, just give up because we don't have
         ;; enough room to put the save
         (format 0 "ERROR: SAVEGAME: save file ~A is too big~%" stream)))
      (set! (-> this allocated-length) my-size))
    (when (!= (-> this version) SAVE_VERSION)
      ;; uh-oh, the version is wrong
      (format 0
              "ERROR: SAVEGAME: save file ~A was version ~d, but only ~d is supported.~%"
              stream
              (-> this version)
              SAVE_VERSION)
      (set! (-> this length) 0))
    (file-stream-close stream))
  this)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; particles
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; used for the flashing auto-save icon.

(defpartgroup group-part-save-icon
  :id 656
  :flags (screen-space)
  :bounds (static-bspherem 0 0 0 100)
  :parts ((sp-item 2662)))

(defpart 2662
  :init-specs
  ((:texture (checkpoint common))
   (:num 1.0)
   (:scale-x (meters 1.5))
   (:scale-y :copy scale-x)
   (:r 128.0)
   (:g 128.0)
   (:b 128.0)
   (:a 128.0)
   (:timer (seconds 0.017))
   (:flags (die-when-faded write-depth run-while-paused))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; auto-save process
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; the status of the memory cards.
(define *auto-save-info* (new 'global 'mc-slot-info))

(deftype auto-save (process)
  ((card       int32)
   (slot       int32)
   (which      int32)
   (buffer     kheap)
   (mode       basic)
   (result     mc-status-code)
   (save       game-save)
   (info       mc-slot-info :inline)
   (notify     handle)
   (state-time time-frame)
   (part       sparticle-launch-control))
  (:state-methods
   get-heap
   get-card
   format-card
   create-file
   save
   restore
   (error mc-status-code)
   done
   unformat-card))

(defmethod deactivate ((this auto-save))
  "Release the save-icon particles, then deactivate the process."
  ;; kill the particles
  (if (nonzero? (-> this part)) (kill-and-free-particles (-> this part)))
  ;; and do a normal deactivate.
  ((method-of-type process deactivate) this)
  (none))

(defmethod relocate ((this auto-save) (offset int))
  "Relocate the heap-owned save-icon launch control before relocating the process."
  ;; update our reference particle launch control, which is allocated on our process heap
  (if (nonzero? (-> this part)) (&+! (-> this part) offset))
  ;; then relocate the process. This will relocate the heap (memory, and basics on it).
  (the-as auto-save ((method-of-type process relocate) this offset)))

(defbehavior auto-save-post auto-save ()
  "Draw automatic-save status text and the flashing save icon after each auto-save state update."
  (when (and (= *cheat-mode* 'debug) (cpad-hold? 0 l3))
    (let ((debug-context (new 'stack 'font-context *font-default-matrix* 32 160 0.0 (font-color default) (font-flags shadow kerning))))
      (set-width! debug-context 440)
      (set-height! debug-context 80)
      (set-flags! debug-context (font-flags shadow kerning))
      (format (clear *temp-string*) "~S / ~S ~D~%" (-> self mode) (-> self state name) (-> self which))
      (print-game-text *temp-string* debug-context #f 128 22)))
  ;; auto-save drawing
  (when (and (= (-> self mode) 'auto-save) (!= (-> self next-state name) 'done))
    (let ((save-context (new 'stack 'font-context *font-default-matrix* 20 40 0.0 (font-color default) (font-flags shadow kerning))))
      (set-scale! save-context 0.8)
      (set-width! save-context 472)
      (set-height! save-context 20)
      (set-flags! save-context (font-flags shadow kerning middle middle-vert large))
      ;; if this is the first time saving, display a warning.
      (when (zero? (-> *game-info* auto-save-count))
        (print-game-text (lookup-text! *common-text* (text-id saving-data) #f) save-context #f 128 22)
        (set! (-> save-context origin x) 20.0)
        (set! (-> save-context origin y) 130.0)
        (set-scale! save-context 0.7)
        (set-height! save-context 40)
        (let ((print-text print-game-text))
          ((the-as (function object string object none) format)
           (clear *temp-string*)
           (lookup-text! *common-text* (text-id memcard-do-not-remove) #f)
           1)
          (print-text *temp-string* save-context #f 128 22))))
    ;; flash the icon.
    (when (< (mod (-> *display* real-frame-counter) 300) 270)
      (if (> (-> self part matrix) 0)
        (set-vector! (sprite-get-user-hvdf (-> self part matrix))
                     1842.0
                     (the float
                          (+ (the int
                                  (* 0.5
                                     (- (* (if (= (get-aspect-ratio) 'aspect16x9) 370.0 360.0) (-> *video-parms* relative-y-scale))
                                        (the float (-> *video-parms* screen-sy)))))
                             2048))
                     (+ -1024.0 (-> *math-camera* hvdf-off z))
                     (-> *math-camera* hvdf-off w)))
      (spawn (-> self part) *zero-vector*)))
  (none))

(defstatehandler auto-save :post auto-save-post)

(defbehavior auto-save-init-by-other auto-save ((desired-mode symbol) (notify-proc process-tree) (card-idx int) (file-idx int))
  "Initialize an auto-save process. Reject a concurrent process, establish its card, file, notify
   handle, and icon, apply automatic-save policy, then reserve a streaming heap."
  ;; trying to create multiple auto save procs, bad idea.
  (when (handle->process (-> *game-info* auto-save-proc))
    (send-event notify-proc 'notify 'error 16)
    (return #f))
  ;; set us as the auto save proc
  (set! (-> *game-info* auto-save-proc) (process->handle self))
  (set! (-> *game-info* auto-save-status) (mc-status-code ok))
  (stack-size-set! (-> self main-thread) 512)
  (logclear! (-> self mask) (process-mask pause menu progress))
  ;; setup ourself
  (set! (-> self card) card-idx)
  (set! (-> self which) file-idx)
  (set! (-> self buffer) #f)
  (set! (-> self mode) desired-mode)
  (set! (-> self result) (mc-status-code ok))
  (set! (-> self save) #f)
  (set! (-> self notify) (process->handle notify-proc))
  (set! (-> self part) (create-launch-control group-part-save-icon self))
  (set! (-> self part matrix) (sprite-allocate-user-hvdf))
  (cond
    ((= desired-mode 'auto-save)
     ;; also save pc settings.
     (with-pc
       (commit-to-file *pc-settings*))
     (if (not (-> *setting-control* current auto-save)) (go-virtual error (mc-status-code no-auto-save)))
     (when (and (zero? (-> self card)) (-> *setting-control* current auto-save))
       (set! (-> self card) (-> *game-info* auto-save-card))
       (set! (-> self which) (-> *game-info* auto-save-which))))
    ((= desired-mode 'error) (set! (-> *setting-control* default auto-save) #f) (go-virtual error (mc-status-code no-card))))
  (set! (-> *setting-control* default auto-save) #f)
  (go-virtual get-heap)
  (none))

;; Reserve memory for card data. The streaming heaps are large enough to hold the complete save.
(defstate get-heap (auto-save)
  :virtual #t
  :code
    (behavior ()
      (set! (-> self state-time) (-> *display* real-frame-counter))
      (let ((buffer (reserve-alloc *art-control*)))
        (while (not buffer)
          (if (>= (- (-> *display* real-frame-counter) (-> self state-time)) (seconds 60))
            (go-virtual error (mc-status-code no-memory)))
          (suspend)
          (set! buffer (reserve-alloc *art-control*)))
        (set! (-> self buffer) buffer))
      (go-virtual get-card)))

(defstate get-card (auto-save)
  :virtual #t
  :code
    (behavior ()
      (label cfg-0)
      (mc-get-slot-info (-> self slot) (-> self info))
      (when (zero? (-> self info known))
        (suspend)
        (goto cfg-0))
      (cond
        ((zero? (-> self info handle)) (go-virtual error (mc-status-code no-card)))
        ((zero? (-> self card)) (set! (-> self card) (-> self info handle)))
        ((!= (-> self info handle) (-> self card)) (go-virtual error (mc-status-code bad-handle))))
      (case (-> self mode)
        (('save 'auto-save) (go-virtual save))
        (('save-last)
         (set! (-> self which) (-> self info last-file))
         (if (= (-> self which) -1) (go-virtual error (mc-status-code no-last)) (go-virtual save)))
        (('restore) (go-virtual restore))
        (('format-card) (go-virtual format-card))
        (('unformat-card) (go-virtual unformat-card))
        (('create-file) (go-virtual create-file))
        (else (go-virtual done)))))

(defstate format-card (auto-save)
  :virtual #t
  :code
    (behavior ()
      (when (zero? (-> self info formatted))
        (label cfg-1)
        (set! (-> self result) (mc-format (-> self card)))
        (when (!= (-> self result) (mc-status-code ok))
          (suspend)
          (goto cfg-1))
        (label cfg-3)
        (set! (-> self result) (the-as mc-status-code (mc-check-result)))
        (case (-> self result)
          (((mc-status-code busy)))
          (((mc-status-code format-failed)) (goto cfg-1))
          (((mc-status-code ok)) (goto cfg-12))
          (else (go-virtual error (-> self result))))
        (suspend)
        (goto cfg-3))
      (label cfg-12)
      (case (-> self mode)
        (('create-file 'save 'save-last 'auto-save 'restore) (go-virtual create-file)))
      (go-virtual done)))

(defstate unformat-card (auto-save)
  :virtual #t
  :code
    (behavior ()
      (when (nonzero? (-> self info formatted))
        (label cfg-1)
        (set! (-> self result) (mc-unformat (-> self card)))
        (when (!= (-> self result) (mc-status-code ok))
          (suspend)
          (goto cfg-1))
        (loop
          (set! (-> self result) (the-as mc-status-code (mc-check-result)))
          (case (-> self result)
            (((mc-status-code busy)))
            (((mc-status-code ok)) (goto cfg-11))
            (else (go-virtual error (-> self result))))
          (suspend)))
      (label cfg-11)
      (go-virtual done)))

(defstate create-file (auto-save)
  :virtual #t
  :code
    (behavior ()
      (cond
        ((zero? (-> self info formatted)) (go-virtual error (mc-status-code no-format)))
        ((zero? (-> self info inited))
         (if (< (-> self info mem-actual) (-> self info mem-required)) (go-virtual error (mc-status-code no-space)))
         (let ((buffer (-> self buffer))) (set! (-> buffer current) (-> buffer base)))
         (label cfg-6)
         (set! (-> self result) (mc-create-file (-> self card) (the-as uint (-> self buffer base))))
         (when (!= (-> self result) (mc-status-code ok))
           (suspend)
           (goto cfg-6))
         (loop
           (set! (-> self result) (the-as mc-status-code (mc-check-result)))
           (case (-> self result)
             (((mc-status-code busy)))
             (((mc-status-code ok)) (goto cfg-16))
             (else (go-virtual error (-> self result))))
           (suspend))))
      (label cfg-16)
      (case (-> self mode)
        (('restore) (go-virtual restore))
        (('save 'save-last 'auto-save) (go-virtual save)))
      (go-virtual done)))

(defstate save (auto-save)
  :virtual #t
  :code
    (behavior ()
      (cond
        ((zero? (-> self info formatted)) (go-virtual error (mc-status-code no-format)))
        ((zero? (-> self info inited)) (go-virtual error (mc-status-code no-file))))
      (case (-> self mode)
        (('auto-save) (+! (-> *game-info* auto-save-count) 1)))
      (let ((buffer (-> self buffer))) (set! (-> buffer current) (-> buffer base)))
      (let ((old-loading-level (the-as object loading-level)))
        (set! loading-level (-> self buffer))
        ;; og:preserve-this
        ;; pc port note : the original game used 64K here's which is slightly too small for the save file.
        ;; the buffer being used here is one of the spool buffers which are much larger
        ;; this means that the original game only cleared the first 64K of that buffer when allocating
        ;; a new save file which would leave the last parts to be filled with garbage, which may or may not cause issues.
        ;; for the port we clear the entire spool buffer instead, entirely bypassing this potential issue.
        (set! (-> self save) (new 'loading-level 'game-save (- SPOOL_HEAP_SIZE (psize-of game-save))))
        (save-game! *game-info* (-> self save) "save")
        (set! loading-level (the-as kheap old-loading-level))
        ;0
        (when *debug-segment*
          (debug-print (-> self save) (user? dass)))
        (label cfg-7)
        (set! (-> self result)
              (mc-save (-> self card) (-> self which) (&-> self save type) (the-as int (-> self save info-int32))))
        (when (!= (-> self result) (mc-status-code ok))
          (suspend)
          (goto cfg-7))
        (loop
          (set! (-> self result) (the-as mc-status-code (mc-check-result)))
          (case (-> self result)
            (((mc-status-code busy)))
            (((mc-status-code ok)) (goto cfg-21))
            (((mc-status-code write-error)) (suspend))
            (else
             (case (-> self mode)
               (('auto-save) (seekl! (-> *game-info* auto-save-count) 0 1)))
             (go-virtual error (-> self result))))
          (suspend)))
      (label cfg-21)
      (go-virtual done)))

(defstate restore (auto-save)
  :virtual #t
  :code
    (behavior ()
      (cond
        ((zero? (-> self info formatted)) (go-virtual error (mc-status-code no-format)))
        ((zero? (-> self info inited)) (go-virtual error (mc-status-code no-file))))
      (let ((buffer (-> self buffer))) (set! (-> buffer current) (-> buffer base)))
      (if (zero? (-> self info file (-> self which) present)) (go-virtual error (mc-status-code no-save)))
      (label cfg-6)
      (set! (-> self result) (mc-load (-> self card) (-> self which) (-> self buffer base)))
      (when (!= (-> self result) (mc-status-code ok))
        (suspend)
        (goto cfg-6))
      (loop
        (set! (-> self result) (the-as mc-status-code (mc-check-result)))
        (case (-> self result)
          (((mc-status-code busy)))
          (((mc-status-code ok)) (goto cfg-20))
          (((mc-status-code read-error)) (suspend))
          (((mc-status-code new-game)) (go-virtual error (mc-status-code no-save)))
          (else (go-virtual error (-> self result))))
        (suspend))
      (label cfg-20)
      (set! (-> self save) (the-as game-save (&+ (-> self buffer base) 4)))
      (let ((save (-> self save)))
        (set! (-> save type) game-save)
        (if (!= (-> save version) 1) (go-virtual error (mc-status-code bad-version))))
      (set-setting! 'music-volume 'abs 0.0 0)
      (set-setting! 'sfx-volume 'abs 0.0 0)
      (set! (-> *game-info* mode) 'play)
      (initialize! *game-info* 'game (-> self save) (the-as string #f))
      (set-master-mode 'game)
      (add-setting! 'process-mask 'set 0.0 (process-mask progress))
      (apply-settings *setting-control*)
      (dotimes (i 15)
        (suspend))
      (go-virtual done)))

(defstate error (auto-save)
  :virtual #t
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('progress-allowed?) #t)
        (('die) (deactivate self))))
  :code
    (behavior ((status mc-status-code))
      (if (-> self buffer) (reserve-free *art-control* (-> self buffer)))
      (set! (-> self result) status)
      (let ((slot-info *auto-save-info*))
        (mem-copy! (the-as pointer slot-info) (the-as pointer (-> self info)) 300)
        (send-event (handle->process (-> self notify)) 'notify 'error (-> self result) slot-info))
      (format #t "SAVE ERROR: ~A~%" (enum->string mc-status-code (-> self result)))
      (if (= (-> self result) (mc-status-code no-auto-save)) (return #f))
      (case (-> self mode)
        (('auto-save 'error)
         (set! (-> self state-time) (-> *display* real-frame-counter))
         (set! (-> *game-info* auto-save-status) status)
         (while (< (- (-> *display* real-frame-counter) (-> self state-time)) (seconds 0.2))
           (if (not (progress-allowed?)) (set! (-> self state-time) (-> *display* real-frame-counter)))
           (suspend))
         (if (= status (mc-status-code no-card))
           (activate-progress *dproc* (progress-screen memcard-removed))
           (activate-progress *dproc* (progress-screen memcard-auto-save-error)))))))

(defstate done (auto-save)
  :virtual #t
  :code
    (behavior ()
      (if (and (-> self buffer) (-> *art-control* reserve-buffer)) (reserve-free *art-control* (-> self buffer)))
      (set! (-> *game-info* auto-save-status) (mc-status-code ok))
      (case (-> self mode)
        (('save 'save-last 'auto-save 'restore)
         (set! (-> *setting-control* default auto-save) #t)
         (set! (-> *game-info* auto-save-card) (-> self card))
         (set! (-> *game-info* auto-save-which) (-> self which))))
      (let ((slot-info *auto-save-info*))
        (mem-copy! (the-as pointer slot-info) (the-as pointer (-> self info)) 300)
        (send-event (handle->process (-> self notify)) 'notify 'done 1 slot-info))
      (case (-> self mode)
        (('auto-save)
         ;; og:preserve-this Don't display the first auto-save warning prompt if speedrunning
         (when (and (= (-> *game-info* auto-save-count) 1) (not (-> *pc-settings* speedrunner-mode?)))
           (set! (-> self event-hook) (-> (method-of-object self error) event))
           (set! (-> self state-time) (-> *display* real-frame-counter))
           (while (< (- (-> *display* real-frame-counter) (-> self state-time)) (seconds 0.2))
             (if (not (progress-allowed?)) (set! (-> self state-time) (-> *display* real-frame-counter)))
             (suspend))
           (activate-progress *dproc* (progress-screen auto-save)))))))

(defun auto-save-command ((mode symbol) (card int) (file int) (notify-proc process-tree))
  "Start an auto-save process for mode, card handle, and file index, notifying notify-proc when it
   finishes."
  (process-spawn auto-save mode notify-proc card file :stack *kernel-dram-stack*)
  (none))

(defun auto-save-check ()
  "Detect removal or replacement of the remembered automatic-save card and start an error process."
  (when (and (-> *setting-control* current auto-save) (not (handle->process (-> *game-info* auto-save-proc))))
    (mc-get-slot-info 0 *auto-save-info*)
    (if (and (nonzero? (-> *auto-save-info* known))
             (or (zero? (-> *auto-save-info* handle)) (!= (-> *auto-save-info* handle) (-> *game-info* auto-save-card))))
      (auto-save-command 'error 0 0 *default-pool*)))
  0
  (none))

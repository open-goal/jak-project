;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/collide/pat-h.gc")
(require "engine/debug/debug.gc")
(require "engine/collide/collide-mesh-h.gc")

;; Collision checks for collide-mesh, the foreground mesh type.
;; Collision code is rewritten for better readability, the original is still in collide-mesh-ee-asm.gc

(define *debug-collide-mesh-contacts* #f)
(define *debug-collide-mesh-transforms* #f)
(define *debug-collide-mesh-cache* #f)
(define *debug-collide-mesh-overlap* #f)

;; DECOMP BEGINS

(defmethod asize-of ((this collide-mesh))
  "Return the fixed collide-mesh header plus storage for its variable-length inline triangle
   array. The separately allocated vertex-data buffer is not part of this size."
  (the-as int (+ (-> collide-mesh size) (* (+ (-> this num-tris) -1) 8))))

(defmethod mem-usage ((this collide-mesh) (usage memory-usage-block) (flags mem-usage-flags))
  "Account for the mesh-and-triangle allocation and the separate sixteen-byte-per-vertex
   buffer as two allocations in the collide-mesh category."
  (mem-usage-add! usage collide-mesh 1 (asize-of this))
  (mem-usage-add! usage collide-mesh 1 (* (-> this num-verts) 16))
  (the-as collide-mesh 0))

(defmethod debug-draw-tris ((this collide-mesh) (draw-owner process-drawable) (joint-index int))
  "Draw every triangle after transforming its local vertices by the selected
   joint node, using the triangle's PAT-mode color with low alpha."
  (rlet ((acc :class vf)
         (vf0 :class vf)
         (vf1 :class vf)
         (vf2 :class vf)
         (vf3 :class vf)
         (vf4 :class vf)
         (vf5 :class vf)
         (vf6 :class vf)
         (vf7 :class vf))
    (init-vf0-vector)
    (let ((triangle-record (the-as object (-> this tris)))
          (joint-transform (-> draw-owner node-list data joint-index bone transform)))
      (countdown (triangles-left (-> this num-tris))
        (let ((world-vertex-0 (new 'stack-no-clear 'vector))
              (world-vertex-1 (new 'stack-no-clear 'vector))
              (world-vertex-2 (new 'stack-no-clear 'vector)))
          (.lvf vf4 (&-> joint-transform vector 0 quad))
          (.lvf vf5 (&-> joint-transform vector 1 quad))
          (.lvf vf6 (&-> joint-transform vector 2 quad))
          (.lvf vf7 (&-> joint-transform vector 3 quad))
          (.lvf vf1 (&-> (-> this vertex-data (-> (the-as collide-mesh-tri triangle-record) vertex-index 0)) quad))
          (.lvf vf2 (&-> (-> this vertex-data (-> (the-as collide-mesh-tri triangle-record) vertex-index 1)) quad))
          (.lvf vf3 (&-> (-> this vertex-data (-> (the-as collide-mesh-tri triangle-record) vertex-index 2)) quad))
          (let ((debug-color (copy-and-set-field (-> *pat-mode-info* (-> (the-as collide-mesh-tri triangle-record) pat mode) color) a 16)))
            ;; The mesh stores joint-local vertices. Apply the selected bone transform before
            ;; submitting the translucent PAT-colored triangle to the debug renderer.
            (.mul.w.vf acc vf7 vf0)
            (.add.mul.x.vf acc vf4 vf1 acc)
            (.add.mul.y.vf acc vf5 vf1 acc)
            (.add.mul.z.vf vf1 vf6 vf1 acc)
            (.mul.w.vf acc vf7 vf0)
            (.add.mul.x.vf acc vf4 vf2 acc)
            (.add.mul.y.vf acc vf5 vf2 acc)
            (.add.mul.z.vf vf2 vf6 vf2 acc)
            (.mul.w.vf acc vf7 vf0)
            (.add.mul.x.vf acc vf4 vf3 acc)
            (.add.mul.y.vf acc vf5 vf3 acc)
            (.add.mul.z.vf vf3 vf6 vf3 acc)
            (.svf (&-> world-vertex-0 quad) vf1)
            (.svf (&-> world-vertex-1 quad) vf2)
            (.svf (&-> world-vertex-2 quad) vf3)
            (add-debug-flat-triangle #t (bucket-id debug-no-zbuf) world-vertex-0 world-vertex-1 world-vertex-2 debug-color)))
        (set! triangle-record (-> (the-as (inline-array collide-mesh-tri) triangle-record) 1))))
    0
    (none)))

(defmethod sphere-on-platform-test ((this collide-mesh) (cache-tris collide-mesh-cache-tri) (result collide-tri-result) (query-sphere vector) (best-distance float))
  "Check if the sphere is on a platform. Find the smallest signed separation no greater than best-distance from
   a ground or obstacle triangle and store its contact. Equal candidates replace the local result,
   so the last equal triangle wins. Candidates must lie strictly between -1024 and 122.88 and
   point within about 45 degrees of the cached oriented face normal; the normal is not tested
   against world up. Sphere is encoded by center.xyz and radius.w."
  (let ((closest-point (new 'stack-no-clear 'vector))
        (center-delta (new 'stack-no-clear 'vector))
        (expanded-sphere (new 'stack-no-clear 'vector))
        (query-bounds (new 'stack-no-clear 'bounding-box4w))
        (cache-tri cache-tris)
        (selected-distance best-distance))
    ;; Platform selection is intentionally broader than sphere overlap: the extra 122.88 units
    ;; allow a rider to acquire a supporting triangle while still slightly above it.
    (vector-copy! expanded-sphere query-sphere)
    (set! (-> expanded-sphere w) (+ (-> expanded-sphere w) 122.88))
    ;; create bounding box query
    (rlet ((sphere-value :class vf)
           (query-min :class vf)
           (query-max :class vf))
      (.lvf sphere-value (&-> expanded-sphere quad))
      (.sub.w.vf query-min sphere-value sphere-value)
      (.add.w.vf query-max sphere-value sphere-value)
      (.ftoi.vf query-min query-min)
      (.ftoi.vf query-max query-max)
      (.svf (&-> query-bounds min quad) query-min)
      (.svf (&-> query-bounds max quad) query-max))
    ;; iterate mesh tris
    (dotimes (i (-> this num-tris))
      (let ((mode (-> cache-tri pat mode)))
        ;; only ground/obstacle tris:
        (when (and (or (= mode (pat-mode ground)) (= mode (pat-mode obstacle)))
                   ;; check triangle integer bbox
                   (<= (-> cache-tri bbox4w min x) (-> query-bounds max x))
                   (<= (-> cache-tri bbox4w min y) (-> query-bounds max y))
                   (<= (-> cache-tri bbox4w min z) (-> query-bounds max z))
                   (<= (-> cache-tri bbox4w min w) (-> query-bounds max w))
                   (<= (-> query-bounds min x) (-> cache-tri bbox4w max x))
                   (<= (-> query-bounds min y) (-> cache-tri bbox4w max y))
                   (<= (-> query-bounds min z) (-> cache-tri bbox4w max z))
                   (<= (-> query-bounds min w) (-> cache-tri bbox4w max w)))
          ;; check triangle
          (closest-pt-in-triangle closest-point query-sphere (the-as matrix (-> cache-tri vertex)) (-> cache-tri normal))
          (vector-! center-delta query-sphere closest-point)
          (let* ((center-distance (vector-length center-delta))
                 (signed-distance (if (< (vector-dot center-delta (-> cache-tri normal)) 0.0) (- center-distance) center-distance))
                 (separation (- signed-distance (-> query-sphere w))))
            ;; The facing test rejects edge/back-side candidates. A zero delta is already on the
            ;; triangle, so it is accepted without trying to normalize an undefined direction.
            (when (and (<= separation selected-distance) ;; better than best candidate (later wins)
                       (< -1024.0 separation) ;; not too far inside
                       (< separation 122.88) ;; not too far away
                       ;; must be roughly aligned with normal, "on" platform, not bumping
                       (or (= center-distance 0.0) (>= (/ (vector-dot center-delta (-> cache-tri normal)) center-distance) 0.707)))
              (set! selected-distance separation)
              (vector-copy! (-> result vertex 0) (-> cache-tri vertex 0))
              (vector-copy! (-> result vertex 1) (-> cache-tri vertex 1))
              (vector-copy! (-> result vertex 2) (-> cache-tri vertex 2))
              (vector-copy! (-> result intersect) closest-point)
              (vector-copy! (-> result normal) (-> cache-tri normal))
              (set! (-> result normal w) 1.0)
              (set! (-> result pat) (-> cache-tri pat))
              (when *debug-collide-mesh-contacts*
                (add-debug-flat-triangle #t
                                         (bucket-id debug-no-zbuf)
                                         (-> cache-tri vertex 0)
                                         (-> cache-tri vertex 1)
                                         (-> cache-tri vertex 2)
                                         (static-rgba #xff #xc0 0 #x40))
                (add-debug-sphere #t (bucket-id debug-no-zbuf) query-sphere (-> query-sphere w) (static-rgba #xff #xc0 0 #x40)))))))
      (&+! cache-tri 96))
    selected-distance))

(defmethod should-push-away-test ((this collide-mesh) (cache-tris collide-mesh-cache-tri) (result collide-tri-result) (query-sphere vector) (best-distance float))
  "Find the deepest sphere penetration no greater than best-distance, store
   its contact triangle, and return the selected signed separation. Equal candidates replace the
   local result, so the last equal triangle wins. A candidate must be penetrating and its
   closest-point direction must lie within about 45 degrees of the cached oriented face normal.
   Sphere is encoded by center.xyz and radius.w."
  (let ((closest-point (new 'stack-no-clear 'vector))
        (center-delta (new 'stack-no-clear 'vector))
        (query-bounds (new 'stack-no-clear 'bounding-box4w))
        (cache-tri cache-tris)
        (selected-distance best-distance))
    ;; Create bounding box query
    (rlet ((sphere-value :class vf)
           (query-min :class vf)
           (query-max :class vf))
      (.lvf sphere-value (&-> query-sphere quad))
      (.sub.w.vf query-min sphere-value sphere-value)
      (.add.w.vf query-max sphere-value sphere-value)
      (.ftoi.vf query-min query-min)
      (.ftoi.vf query-max query-max)
      (.svf (&-> query-bounds min quad) query-min)
      (.svf (&-> query-bounds max quad) query-max))
    ;; iterate mesh triangles
    (dotimes (i (-> this num-tris))
      ;; check triangle bounding box
      (when (and (<= (-> cache-tri bbox4w min x) (-> query-bounds max x))
                 (<= (-> cache-tri bbox4w min y) (-> query-bounds max y))
                 (<= (-> cache-tri bbox4w min z) (-> query-bounds max z))
                 (<= (-> cache-tri bbox4w min w) (-> query-bounds max w))
                 (<= (-> query-bounds min x) (-> cache-tri bbox4w max x))
                 (<= (-> query-bounds min y) (-> cache-tri bbox4w max y))
                 (<= (-> query-bounds min z) (-> cache-tri bbox4w max z))
                 (<= (-> query-bounds min w) (-> cache-tri bbox4w max w)))
        ;; get point
        (closest-pt-in-triangle closest-point query-sphere (the-as matrix (-> cache-tri vertex)) (-> cache-tri normal))
        (vector-! center-delta query-sphere closest-point)
        (let* ((center-distance (vector-length center-delta))
               (signed-distance (if (< (vector-dot center-delta (-> cache-tri normal)) 0.0) (- center-distance) center-distance))
               (separation (- signed-distance (-> query-sphere w))))
          ;; Only count actual penetration. Still has .707 (45 degrees) direction check.
          (when (and (<= separation selected-distance)
                     (< separation 0.0)
                     (or (= center-distance 0.0) 
                         (>= (/ (vector-dot center-delta (-> cache-tri normal)) center-distance) 0.707)))
            (set! selected-distance separation)
            (vector-copy! (-> result vertex 0) (-> cache-tri vertex 0))
            (vector-copy! (-> result vertex 1) (-> cache-tri vertex 1))
            (vector-copy! (-> result vertex 2) (-> cache-tri vertex 2))
            (vector-copy! (-> result intersect) closest-point)
            (vector-copy! (-> result normal) (-> cache-tri normal))
            (set! (-> result normal w) 1.0)
            (set! (-> result pat) (-> cache-tri pat))
            (when *debug-collide-mesh-contacts*
              (add-debug-flat-triangle #t
                                       (bucket-id debug-no-zbuf)
                                       (-> cache-tri vertex 0)
                                       (-> cache-tri vertex 1)
                                       (-> cache-tri vertex 2)
                                       (static-rgba #xff 0 #x40 #x40))
              (add-debug-sphere #t (bucket-id debug-no-zbuf) query-sphere (-> query-sphere w) (static-rgba #xff 0 #x40 #x40))))))
      (&+! cache-tri 96))
    selected-distance))

(defmethod transform-verts-1-matrix! ((this collide-mesh) (xform matrix) (output (pointer uint8)))
  "Use for queries whose floating-point vertices and integer bounds belong in the same space. 
   Transform the vertex buffer with xform, then write each result as both a float and integer vector."
  (rlet ((vf0 :class vf)
         (acc :class vf)
         (row-x :class vf)
         (row-y :class vf)
         (row-z :class vf)
         (translation :class vf)
         (source :class vf)
         (transformed :class vf)
         (integer-position :class vf))
    (init-vf0-vector)
    (.lvf row-x (&-> xform vector 0 quad))
    (.lvf row-y (&-> xform vector 1 quad))
    (.lvf row-z (&-> xform vector 2 quad))
    (.lvf translation (&-> xform vector 3 quad))
    (let ((source-vertices (-> this vertex-data))
          (logical-count (-> this num-verts))
          (padded-count (logand (+ (-> this num-verts) 3) -4))
          (output-cursor output))
      ;; iterate vertices
      (dotimes (i padded-count)
        (.lvf source (&-> source-vertices i quad))
        (.mul.w.vf acc translation vf0)
        (.add.mul.x.vf acc row-x source acc)
        (.add.mul.y.vf acc row-y source acc)
        (.add.mul.z.vf transformed row-z source acc)
        (.ftoi.vf integer-position transformed)
        (.svf output-cursor transformed)
        (.svf (&+ output-cursor 16) integer-position)
        (&+! output-cursor 32))

      (when *debug-collide-mesh-transforms*
        (dotimes (i logical-count)
          (add-debug-sphere #t (bucket-id debug-no-zbuf) (the-as vector (&+ output (* i 32))) 40.96 (static-rgba 0 #xff 0 #x80)))))
    0
    (none)))

(defmethod transform-verts-2-matrix! ((this collide-mesh) (float-xform matrix) (integer-xform matrix) (output (pointer uint8)))
  "Use for queries that need vertices and bounds in different spaces.
   Transform each local vertex with float-xform and store that float result, then transform
   it with integer-xform and store the integer result."
  (rlet ((vf0 :class vf)
         (acc :class vf)
         (float-x :class vf)
         (float-y :class vf)
         (float-z :class vf)
         (float-translation :class vf)
         (integer-x :class vf)
         (integer-y :class vf)
         (integer-z :class vf)
         (integer-translation :class vf)
         (source :class vf)
         (float-position :class vf)
         (integer-position :class vf))
    (init-vf0-vector)
    (.lvf float-x (&-> float-xform vector 0 quad))
    (.lvf float-y (&-> float-xform vector 1 quad))
    (.lvf float-z (&-> float-xform vector 2 quad))
    (.lvf float-translation (&-> float-xform vector 3 quad))
    (.lvf integer-x (&-> integer-xform vector 0 quad))
    (.lvf integer-y (&-> integer-xform vector 1 quad))
    (.lvf integer-z (&-> integer-xform vector 2 quad))
    (.lvf integer-translation (&-> integer-xform vector 3 quad))
    (let ((source-vertices (-> this vertex-data))
          (logical-count (-> this num-verts))
          (padded-count (logand (+ (-> this num-verts) 3) -4))
          (output-cursor output))
      ;; Iterate vertices
      (dotimes (i padded-count)
        (.lvf source (&-> source-vertices i quad))
        (.mul.w.vf acc float-translation vf0)
        (.add.mul.x.vf acc float-x source acc)
        (.add.mul.y.vf acc float-y source acc)
        (.add.mul.z.vf float-position float-z source acc)
        (.mul.w.vf acc integer-translation vf0)
        (.add.mul.x.vf acc integer-x float-position acc)
        (.add.mul.y.vf acc integer-y float-position acc)
        (.add.mul.z.vf integer-position integer-z float-position acc)
        (.ftoi.vf integer-position integer-position)
        (.svf output-cursor float-position)
        (.svf (&+ output-cursor 16) integer-position)
        (&+! output-cursor 32))
      (when *debug-collide-mesh-transforms*
        (dotimes (i logical-count)
          (add-debug-sphere #t
                            (bucket-id debug-no-zbuf)
                            (the-as vector (&+ output (* i 32)))
                            40.96
                            (static-rgba 0 #xff #xff #x80)))))
    0
    (none)))

(defmethod allocate! ((this collide-mesh-cache) (byte-count int))
  "Round byte-count up to sixteen and allocate it from the linear cache. Wrap to the
   beginning and advance the nonzero generation id when the remaining tail is too small; print an
   error and return false when one allocation exceeds the entire cache."
  (local-vars (next-used-size int) (next-id int))
  ;; Every cache entry begins on a quadword boundary; callers may therefore use aligned vector
  ;; loads even when the requested payload size was not itself a multiple of sixteen.
  (let* ((biased-byte-count (+ byte-count 15))
         (used-size (-> this used-size))
         (quadword-count (/ biased-byte-count 16))
         (cache-data (-> this data))
         (max-size (-> this max-size))
         (aligned-byte-count (* quadword-count 16))
         (result-address (&+ cache-data used-size)))
    ;; Oversized requests fail. Requests which fit the cache but not its remaining tail wrap to
    ;; the beginning and advance the generation so stale mesh-cache references stop matching.
    (let ((request-room (- max-size (the-as uint aligned-byte-count)))
          (current-id (-> this id)))
      (b! (< (the-as int request-room) 0) cfg-6 :delay (set! next-used-size (the-as int (+ used-size aligned-byte-count))))
      (b! (>= (the-as int (- max-size (the-as uint next-used-size))) 0)
          cfg-5
          :delay
          (set! next-id (the-as int (+ current-id 1)))))
    (b! (zero? (the-as uint next-id)) cfg-4 :likely-delay (set! next-id 1))
    (label cfg-4)
    (set! next-used-size aligned-byte-count)
    (set! result-address (-> this data))
    (set! (-> this id) (the-as uint next-id))
    (label cfg-5)
    (set! (-> this used-size) (the-as uint next-used-size))
    (let ((return-address result-address))
      (b! #t cfg-7 :delay (nop!))
      (label cfg-6)
      (format 0 "ERROR: Attempted to allocate something bigger than the entire mesh cache!~%")
      (set! return-address (the-as (pointer uint8) #f))
      (label cfg-7)
      return-address)))

(defmethod populate-cache! ((this collide-mesh) (cache-tris collide-mesh-cache-tri) (xform matrix))
  "Transform the local vertex table with xform into the scratchpad, then expand each indexed
   triangle into world-space vertices, a unit face normal, integer bounds, and overlaid surface
   properties in cache."
  ;; Triangle indices are bytes, so the complete transformed vertex table fits in the first four
  ;; kilobytes of scratchpad. Only logical vertices need staging in this source-level version.
  (let ((scratch-vertices (the-as (inline-array vector) (scratchpad-object int))))
    (rlet ((vf0 :class vf)
           (acc :class vf)
           (row-x :class vf)
           (row-y :class vf)
           (row-z :class vf)
           (translation :class vf)
           (source :class vf)
           (transformed :class vf))
      (init-vf0-vector)
      (.lvf row-x (&-> xform vector 0 quad))
      (.lvf row-y (&-> xform vector 1 quad))
      (.lvf row-z (&-> xform vector 2 quad))
      (.lvf translation (&-> xform vector 3 quad))
      ;; transform
      (dotimes (i (-> this num-verts))
        (.lvf source (&-> (-> this vertex-data i) quad))
        (.mul.w.vf acc translation vf0)
        (.add.mul.x.vf acc row-x source acc)
        (.add.mul.y.vf acc row-y source acc)
        (.add.mul.z.vf transformed row-z source acc)
        (.svf (&-> scratch-vertices i quad) transformed))))
  ;; Expand indexed triangles into the cache format used by the narrow-phase methods.
  (let ((source-tri (the-as collide-mesh-tri (-> this tris)))
        (cache-tri cache-tris)
        (scratch-vertices (the-as (inline-array vector) (scratchpad-object int))))
    (dotimes (i (-> this num-tris))
      (let ((vertex-0 (-> scratch-vertices (-> source-tri vertex-index 0)))
            (vertex-1 (-> scratch-vertices (-> source-tri vertex-index 1)))
            (vertex-2 (-> scratch-vertices (-> source-tri vertex-index 2))))
        (vector-copy! (-> cache-tri vertex 0) vertex-0)
        (vector-copy! (-> cache-tri vertex 1) vertex-1)
        (vector-copy! (-> cache-tri vertex 2) vertex-2)
        ;; Winding determines the cached oriented normal used by the contact-facing tests.
        (let ((edge-01 (vector-! (new 'stack-no-clear 'vector) vertex-1 vertex-0))
              (edge-02 (vector-! (new 'stack-no-clear 'vector) vertex-2 vertex-0)))
          (vector-normalize! (vector-cross! (-> cache-tri normal) edge-01 edge-02) 1.0))
        ;; Build bounding box per triangle
        (rlet ((point-0 :class vf)
               (point-1 :class vf)
               (point-2 :class vf)
               (bounds-min :class vf)
               (bounds-max :class vf))
          (.lvf point-0 (&-> vertex-0 quad))
          (.lvf point-1 (&-> vertex-1 quad))
          (.lvf point-2 (&-> vertex-2 quad))
          (.min.vf bounds-min point-0 point-1)
          (.max.vf bounds-max point-0 point-1)
          (.min.vf bounds-min bounds-min point-2)
          (.max.vf bounds-max bounds-max point-2)
          (.ftoi.vf bounds-min bounds-min)
          (.ftoi.vf bounds-max bounds-max)
          (.svf (&-> cache-tri bbox4w min quad) bounds-min)
          (.svf (&-> cache-tri bbox4w max quad) bounds-max))
        ;; Copy pat into the cache too
        (set! (-> cache-tri pat) (-> source-tri pat))
        (when *debug-collide-mesh-cache*
          (add-debug-flat-triangle #t
                                   (bucket-id debug-no-zbuf)
                                   (-> cache-tri vertex 0)
                                   (-> cache-tri vertex 1)
                                   (-> cache-tri vertex 2)
                                   (copy-and-set-field (-> *pat-mode-info* (-> cache-tri pat mode) color) a 48))))
      (&+! source-tri 8)
      (&+! cache-tri 96)))
  (none))

(defmethod overlap-test ((this collide-mesh) (cache-tris collide-mesh-cache-tri) (query-sphere vector))
  "Return true when the sphere encoded by center.xyz and radius.w strictly overlaps
   any cached triangle."
  (let ((query-bounds (new 'stack-no-clear 'bounding-box4w))
        (closest-point (new 'stack-no-clear 'vector))
        (cache-tri cache-tris))
    ;; Match cache bounds by truncating center +/- radius to packed signed integers.
    (rlet ((sphere-value :class vf)
           (query-min :class vf)
           (query-max :class vf))
      (.lvf sphere-value (&-> query-sphere quad))
      (.sub.w.vf query-min sphere-value sphere-value)
      (.add.w.vf query-max sphere-value sphere-value)
      (.ftoi.vf query-min query-min)
      (.ftoi.vf query-max query-max)
      (.svf (&-> query-bounds min quad) query-min)
      (.svf (&-> query-bounds max quad) query-max))
    (when *debug-collide-mesh-overlap*
      (add-debug-sphere #t (bucket-id debug-no-zbuf) query-sphere (-> query-sphere w) (static-rgba #xff #xff 0 #x40)))
    (dotimes (i (-> this num-tris))
      ;; Box check to quickly reject
      (when (and (<= (-> cache-tri bbox4w min x) (-> query-bounds max x))
                 (<= (-> cache-tri bbox4w min y) (-> query-bounds max y))
                 (<= (-> cache-tri bbox4w min z) (-> query-bounds max z))
                 (<= (-> cache-tri bbox4w min w) (-> query-bounds max w))
                 (<= (-> query-bounds min x) (-> cache-tri bbox4w max x))
                 (<= (-> query-bounds min y) (-> cache-tri bbox4w max y))
                 (<= (-> query-bounds min z) (-> cache-tri bbox4w max z))
                 (<= (-> query-bounds min w) (-> cache-tri bbox4w max w)))
        ;; Find point on triangle
        (closest-pt-in-triangle closest-point query-sphere (the-as matrix (-> cache-tri vertex)) (-> cache-tri normal))
        ;; Check distance for true sphere test.
        (when (< (vector-vector-distance-squared query-sphere closest-point) (square (-> query-sphere w)))
          (when *debug-collide-mesh-overlap*
            (add-debug-flat-triangle #t
                                     (bucket-id debug-no-zbuf)
                                     (-> cache-tri vertex 0)
                                     (-> cache-tri vertex 1)
                                     (-> cache-tri vertex 2)
                                     (static-rgba 0 #xff 0 #x60)))
          (return #t)))
      (&+! cache-tri 96)))
  #f)

;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/collide/pat-h.gc")
(require "engine/debug/debug.gc")
(require "engine/collide/collide-mesh-h.gc")

;; DECOMP BEGINS

(defmethod asize-of ((this collide-mesh))
  "Return the fixed collide-mesh header plus storage for its variable-length inline triangle
   array. The separately allocated vertex-data buffer is not part of this size."
  (the-as int (+ (-> collide-mesh size) (* (+ (-> this num-tris) -1) 8))))

(defmethod mem-usage ((this collide-mesh) (usage memory-usage-block) (flags mem-usage-flags))
  "Account for the mesh-and-triangle allocation and the separate sixteen-byte-per-vertex
   buffer as two allocations in the collide-mesh category."
  (mem-usage-add! usage collide-mesh 1 (asize-of this))
  (mem-usage-add! usage collide-mesh 1 (* (-> this num-verts) 16))
  (the-as collide-mesh 0))

(defmethod debug-draw-tris ((this collide-mesh) (draw-owner process-drawable) (joint-index int))
  "Draw every triangle after transforming its local vertices by the selected
   joint node, using the triangle's PAT-mode color with low alpha."
  (rlet ((acc :class vf)
         (vf0 :class vf)
         (vf1 :class vf)
         (vf2 :class vf)
         (vf3 :class vf)
         (vf4 :class vf)
         (vf5 :class vf)
         (vf6 :class vf)
         (vf7 :class vf))
    (init-vf0-vector)
    (let ((triangle-record (the-as object (-> this tris)))
          (joint-transform (-> draw-owner node-list data joint-index bone transform)))
      (countdown (triangles-left (-> this num-tris))
        (let ((world-vertex-0 (new 'stack-no-clear 'vector))
              (world-vertex-1 (new 'stack-no-clear 'vector))
              (world-vertex-2 (new 'stack-no-clear 'vector)))
          (.lvf vf4 (&-> joint-transform vector 0 quad))
          (.lvf vf5 (&-> joint-transform vector 1 quad))
          (.lvf vf6 (&-> joint-transform vector 2 quad))
          (.lvf vf7 (&-> joint-transform vector 3 quad))
          (.lvf vf1 (&-> (-> this vertex-data (-> (the-as collide-mesh-tri triangle-record) vertex-index 0)) quad))
          (.lvf vf2 (&-> (-> this vertex-data (-> (the-as collide-mesh-tri triangle-record) vertex-index 1)) quad))
          (.lvf vf3 (&-> (-> this vertex-data (-> (the-as collide-mesh-tri triangle-record) vertex-index 2)) quad))
          (let ((debug-color (copy-and-set-field (-> *pat-mode-info* (-> (the-as collide-mesh-tri triangle-record) pat mode) color) a 16)))
            (.mul.w.vf acc vf7 vf0)
            (.add.mul.x.vf acc vf4 vf1 acc)
            (.add.mul.y.vf acc vf5 vf1 acc)
            (.add.mul.z.vf vf1 vf6 vf1 acc)
            (.mul.w.vf acc vf7 vf0)
            (.add.mul.x.vf acc vf4 vf2 acc)
            (.add.mul.y.vf acc vf5 vf2 acc)
            (.add.mul.z.vf vf2 vf6 vf2 acc)
            (.mul.w.vf acc vf7 vf0)
            (.add.mul.x.vf acc vf4 vf3 acc)
            (.add.mul.y.vf acc vf5 vf3 acc)
            (.add.mul.z.vf vf3 vf6 vf3 acc)
            (.svf (&-> world-vertex-0 quad) vf1)
            (.svf (&-> world-vertex-1 quad) vf2)
            (.svf (&-> world-vertex-2 quad) vf3)
            (add-debug-flat-triangle #t (bucket-id debug-no-zbuf) world-vertex-0 world-vertex-1 world-vertex-2 debug-color)))
        (set! triangle-record (-> (the-as (inline-array collide-mesh-tri) triangle-record) 1))))
    0
    (none)))

(deftype sopt-work (structure)
  "Stack workspace for sphere-on-platform-test: the closest point followed by the integer-coordinate
   bounding box of the query sphere expanded by 122.88."
  ((intersect vector :inline)
   (sphere-bbox4w bounding-box4w :inline)))

(#unless PC_PORT
  ;; collide-mesh is a BASIC value, so its EE pointer is four bytes past the allocation's type word.
  (defconstant COLLIDE-MESH-BASIC-BIAS 4)
  (defconstant COLLIDE-MESH-NUM-TRIS (- (offset-of collide-mesh num-tris) COLLIDE-MESH-BASIC-BIAS)) ;; 4
  (defconstant COLLIDE-MESH-NUM-VERTS (- (offset-of collide-mesh num-verts) COLLIDE-MESH-BASIC-BIAS)) ;; 8
  (defconstant COLLIDE-MESH-VERTEX-DATA (- (offset-of collide-mesh vertex-data) COLLIDE-MESH-BASIC-BIAS)) ;; 12
  (defconstant COLLIDE-MESH-CACHE-TRI-STRIDE (type-size collide-mesh-cache-tri)) ;; 96
  (defconstant COLLIDE-MESH-CACHE-NORMAL (offset-of collide-mesh-cache-tri normal)) ;; 48
  (defconstant COLLIDE-MESH-CACHE-PAT (offset-of collide-mesh-cache-tri pat)) ;; 60
  (defconstant COLLIDE-MESH-CACHE-BBOX-MIN (offset-of collide-mesh-cache-tri bbox4w min)) ;; 64
  (defconstant COLLIDE-MESH-CACHE-BBOX-MAX (offset-of collide-mesh-cache-tri bbox4w max)) ;; 80
  (defconstant COLLIDE-TRI-RESULT-INTERSECT (offset-of collide-tri-result intersect)) ;; 48
  (defconstant COLLIDE-TRI-RESULT-NORMAL (offset-of collide-tri-result normal)) ;; 64
  (defconstant COLLIDE-TRI-RESULT-PAT (offset-of collide-tri-result pat)) ;; 80
  (defconstant COLLIDE-PLATFORM-MODE-MASK #x38)
  (defconstant COLLIDE-PLATFORM-OBSTACLE-MODE #x10)
  (defconstant COLLIDE-MESH-VERTEX-STRIDE (type-size vector)) ;; 16
  (defconstant COLLIDE-MESH-VERTEX-BANK-STRIDE (* 4 COLLIDE-MESH-VERTEX-STRIDE)) ;; 64
  (defconstant COLLIDE-MESH-VERTEX-PAGE-STRIDE (* 8 COLLIDE-MESH-VERTEX-STRIDE)) ;; 128
  ;; Each output vertex is a floating-point vector followed by its integer-coordinate copy.
  (defconstant COLLIDE-MESH-MATH-FLOAT 0)
  (defconstant COLLIDE-MESH-MATH-INTEGER 16)
  (defconstant COLLIDE-MESH-MATH-VERTEX-STRIDE 32)
  (defconstant COLLIDE-MESH-MATH-BANK-STRIDE (* 4 COLLIDE-MESH-MATH-VERTEX-STRIDE)) ;; 128
  (defconstant COLLIDE-MESH-MATH-PAGE-STRIDE (* 8 COLLIDE-MESH-MATH-VERTEX-STRIDE)) ;; 256
  ;; The cosine threshold is shared by both sphere/triangle tests. The separation limits are used
  ;; only when selecting a platform.
  (asm-data (label collide-mesh-platform-lower-limit)
            (word #xc4800000) ;; -1024.0
            (label collide-mesh-platform-padding)
            (word #x42f5c28f) ;; 122.88
            (label collide-mesh-contact-cosine)
            (word #x3f34fdf4))) ;; 0.707

(#when PC_PORT
  (defmethod-mips2c "(method 12 collide-mesh)" 12 collide-mesh))

(#unless PC_PORT
  (defmethod sphere-on-platform-test ((this collide-mesh) (cache-tris collide-mesh-cache-tri) (result collide-tri-result) (query-sphere vector) (best-distance float))
    "Find the smallest signed separation no greater than best-distance from
     a ground or obstacle triangle and store its contact. Equal candidates replace the local result,
     so the last equal triangle wins. Candidates must lie strictly between -1024 and 122.88 and
     point within about 45 degrees of the cached oriented face normal; the normal is not tested
     against world up. Sphere is encoded by center.xyz and radius.w."
    (declare (asm-func float))
    (rlet ((result :reg gp)
           (query-sphere :reg s5)
           (best-distance-bits :reg s2)
           (work :reg s4 :type sopt-work)
           (triangle :reg s3 :type collide-mesh-cache-tri)
           (remaining :reg s1)
           (function-base :reg fp)
           (sphere-value :reg vf3)
           (query-min :reg vf12)
           (query-max :reg vf13)
           (padding :reg vf14)
           (closest-point :reg vf2)
           (normal :reg vf1)
           (center-delta :reg vf4)
           (normal-products :reg vf5)
           (distance-products :reg vf6)
           (triangle-a :reg vf7)
           (triangle-b :reg vf8)
           (triangle-c :reg vf9)
           (signed-distance :reg vf10)
           (unit-direction :reg vf11)
           (Q :reg Q))
      ;; The broad phase uses an extra 122.88 units of radius so a platform can be selected while
      ;; the sphere is still slightly above it. The unmodified radius remains in query-sphere.w.
      (asm-block save-state-and-build-query
                 (add.i sp sp -160)
                 (s.d ra sp)
                 (s.d function-base sp 8)
                 (m function-base t9)
                 (s.q s1 sp 64)
                 (s.q s2 sp 80)
                 (s.q s3 sp 96)
                 (s.q s4 sp 112)
                 (s.q s5 sp 128)
                 (s.q gp sp 144)
                 (m result a2)
                 (m query-sphere a3)
                 (m best-distance-bits t0)
                 (add.i work sp 16)
                 (l.w v1 function-base collide-mesh-platform-padding)
                 (m triangle a1)
                 (l.vf sphere-value query-sphere)
                 (m padding v1)
                 (l.wu remaining a0 COLLIDE-MESH-NUM-TRIS)
                 (add.x.vf.w sphere-value sphere-value padding)
                 (nop!)
                 (sub.w.vf query-min sphere-value sphere-value)
                 (nop!)
                 (add.w.vf query-max sphere-value sphere-value)
                 (nop!)
                 (ftoi.vf query-min query-min)
                 (nop!)
                 (ftoi.vf query-max query-max)
                 (nop!)
                 (m v1 query-min)
                 (s.vf query-min work (offset-of sopt-work sphere-bbox4w min))
                 (m a0 query-max)
                 (s.vf query-max work (offset-of sopt-work sphere-bbox4w max)))
      ;; Only ground and obstacle PAT modes can support a platform contact; walls, poles, and
      ;; invalid modes are skipped. The full PAT is retained for the selected triangle. Its word is
      ;; loaded speculatively from the one-past triangle in the loop-exit delay slot.
      (asm-block choose-candidate
                 (label next-triangle)
                 (b.z remaining done :delay (l.wu a2 triangle COLLIDE-MESH-CACHE-PAT))
                 (add.i a3 r0 COLLIDE-PLATFORM-MODE-MASK)
                 (add.i a1 r0 0)
                 (and a2 a2 a3)
                 (add.i a3 r0 COLLIDE-PLATFORM-OBSTACLE-MODE)
                 (b.eq a2 a1 test-bounds :delay (add.i remaining remaining -1))
                 (b.nel a2 a3 next-triangle :delay (add.i triangle triangle COLLIDE-MESH-CACHE-TRI-STRIDE))
                 (label test-bounds)
                 (nop!)
                 (l.q a2 triangle COLLIDE-MESH-CACHE-BBOX-MIN)
                 (nop!)
                 (l.q a1 triangle COLLIDE-MESH-CACHE-BBOX-MAX)
                 (pcgt.w a2 a2 a0)
                 (mmi-nop!)
                 (pcgt.w a1 v1 a1)
                 (mmi-nop!)
                 (or.q a1 a2 a1)
                 (nop!)
                 (ppach a1 r0 a1)
                 (mmi-nop!)
                 (sll a1 a1 16)
                 (nop!)
                 (b.nzl a1 next-triangle :delay (add.i triangle triangle COLLIDE-MESH-CACHE-TRI-STRIDE)))
      ;; The closest point defines a signed sphere separation. Its sign follows the cached oriented
      ;; face normal; a contact is useful only when that direction is within roughly 45 degrees of
      ;; the normal, which avoids selecting a triangle through an edge or from its back side. The
      ;; cached normal's w component is forced to one for the result and is never flipped. The
      ;; reciprocal-length path assumes that the center and closest point are distinct.
      (asm-block evaluate-candidate
                 (m! t9 closest-pt-in-triangle)
                 (add a0 r0 work)
                 (m a1 query-sphere)
                 (add a2 r0 triangle)
                 (add.i a3 triangle COLLIDE-MESH-CACHE-NORMAL)
                 (jalr ra t9 :delay (sll v0 ra 0))
                 (l.vf closest-point work (offset-of sopt-work intersect))
                 (l.vf sphere-value query-sphere)
                 (l.vf normal triangle COLLIDE-MESH-CACHE-NORMAL)
                 (l.q v1 work (offset-of sopt-work sphere-bbox4w min))
                 (l.q a0 work (offset-of sopt-work sphere-bbox4w max))
                 (sub.vf center-delta sphere-value closest-point)
                 (l.wu a1 triangle COLLIDE-MESH-CACHE-PAT)
                 (mul.vf normal-products center-delta normal)
                 (l.vf triangle-a triangle (offset-of collide-mesh-cache-tri vertex 0))
                 (mul.vf distance-products center-delta center-delta)
                 (l.vf triangle-b triangle (offset-of collide-mesh-cache-tri vertex 1))
                 (move.w.vf normal vf0)
                 (l.vf triangle-c triangle (offset-of collide-mesh-cache-tri vertex 2))
                 (add.x.vf.y normal-products normal-products normal-products)
                 (add.i triangle triangle COLLIDE-MESH-CACHE-TRI-STRIDE)
                 (add.y.vf.x distance-products distance-products distance-products)
                 (m f5 best-distance-bits)
                 (add.z.vf.y normal-products normal-products normal-products)
                 (l.s f3 function-base collide-mesh-platform-padding)
                 (add.z.vf.x distance-products distance-products distance-products)
                 (l.s f4 function-base collide-mesh-platform-lower-limit)
                 (sqrt.x Q distance-products)
                 (m a2 normal-products)
                 (waitq)
                 (l.s f1 query-sphere (offset-of vector w))
                 (addq.x distance-products vf0 Q)
                 (vmove.xyzw signed-distance distance-products)
                 (b.ltl a2 r0 signed-distance-ready :delay (sub.vf signed-distance vf0 signed-distance))
                 (label signed-distance-ready)
                 (m a2 signed-distance)
                 (m f2 a2)
                 (sub.s f2 f2 f1)
                 (c.lt.s f5 f2)
                 (b.fpt next-triangle :delay (div.w.x Q vf0 distance-products))
                 (c.le.s f3 f2)
                 (b.fpt next-triangle :delay (nop!))
                 (c.le.s f2 f4)
                 (b.fpt next-triangle :delay (nop!))
                 (waitq)
                 (nop!)
                 (mulq.vf unit-direction center-delta Q)
                 (l.s f6 function-base collide-mesh-contact-cosine)
                 (mul.vf normal-products unit-direction normal)
                 (add.y.vf.x normal-products normal-products normal-products)
                 (add.z.vf.x normal-products normal-products normal-products)
                 (m a2 normal-products)
                 (m f7 a2)
                 (c.lt.s f7 f6)
                 (b.fpt next-triangle :delay (nop!)))
      (asm-block save-contact
                 (m best-distance-bits f2)
                 (s.vf triangle-a result (offset-of collide-tri-result vertex 0))
                 (s.vf triangle-b result (offset-of collide-tri-result vertex 1))
                 (s.vf triangle-c result (offset-of collide-tri-result vertex 2))
                 (s.vf closest-point result COLLIDE-TRI-RESULT-INTERSECT)
                 (s.vf normal result COLLIDE-TRI-RESULT-NORMAL)
                 (b next-triangle :delay (s.w a1 result COLLIDE-TRI-RESULT-PAT)))
      (asm-block restore-state
                 (label done)
                 (m v0 best-distance-bits)
                 (l.d ra sp)
                 (l.d function-base sp 8)
                 (l.q gp sp 144)
                 (l.q s5 sp 128)
                 (l.q s4 sp 112)
                 (l.q s3 sp 96)
                 (l.q s2 sp 80)
                 (l.q s1 sp 64)
                 (jr ra :delay (add.i sp sp 160))
                 (nop! :count 3)))))

(deftype spat-work (structure)
  "Stack workspace for should-push-away-test: the closest point followed by the query sphere's
   integer-coordinate bounding box."
  ((intersect vector :inline)
   (sphere-bbox4w bounding-box4w :inline)))

(#when PC_PORT
  (defmethod-mips2c "(method 11 collide-mesh)" 11 collide-mesh))

(#unless PC_PORT
  (defmethod should-push-away-test ((this collide-mesh) (cache-tris collide-mesh-cache-tri) (result collide-tri-result) (query-sphere vector) (best-distance float))
    "Find the deepest sphere penetration no greater than best-distance, store
     its contact triangle, and return the selected signed separation. Equal candidates replace the
     local result, so the last equal triangle wins. A candidate must be penetrating and its
     closest-point direction must lie within about 45 degrees of the cached oriented face normal.
     Sphere is encoded by center.xyz and radius.w."
    (declare (asm-func float))
    (rlet ((result :reg gp)
           (query-sphere :reg s5)
           (best-distance-bits :reg s1)
           (work :reg s4 :type spat-work)
           (triangle :reg s3 :type collide-mesh-cache-tri)
           (remaining :reg s2)
           (function-base :reg fp)
           (sphere-value :reg vf3)
           (query-min :reg vf12)
           (query-max :reg vf13)
           (closest-point :reg vf2)
           (normal :reg vf1)
           (center-delta :reg vf4)
           (normal-products :reg vf5)
           (distance-products :reg vf6)
           (triangle-a :reg vf7)
           (triangle-b :reg vf8)
           (triangle-c :reg vf9)
           (signed-distance :reg vf10)
           (unit-direction :reg vf11)
           (Q :reg Q))
      (asm-block save-state-and-build-query
                 (add.i sp sp -160)
                 (s.d ra sp)
                 (s.d function-base sp 8)
                 (m function-base t9)
                 (s.q s1 sp 64)
                 (s.q s2 sp 80)
                 (s.q s3 sp 96)
                 (s.q s4 sp 112)
                 (s.q s5 sp 128)
                 (s.q gp sp 144)
                 (m result a2)
                 (m query-sphere a3)
                 (m best-distance-bits t0)
                 (add.i work sp 16)
                 (nop!)
                 (m triangle a1)
                 (l.vf sphere-value query-sphere)
                 (nop!)
                 (l.wu remaining a0 COLLIDE-MESH-NUM-TRIS)
                 (sub.w.vf query-min sphere-value sphere-value)
                 (nop!)
                 (add.w.vf query-max sphere-value sphere-value)
                 (nop!)
                 (ftoi.vf query-min query-min)
                 (nop!)
                 (ftoi.vf query-max query-max)
                 (nop!)
                 (m v1 query-min)
                 (s.vf query-min work (offset-of spat-work sphere-bbox4w min))
                 (m a0 query-max)
                 (s.vf query-max work (offset-of spat-work sphere-bbox4w max)))
      ;; Integer boxes reject most triangles without touching the scalar FPU. Touching box
      ;; boundaries survive the test. A branch-likely skips the complete narrow phase and advances
      ;; the triangle cursor only on a rejected box; the exit delay slot makes one padded
      ;; one-past-triangle load.
      (asm-block reject-separated-boxes
                 (label next-triangle)
                 (b.z remaining done :delay (l.q a2 triangle COLLIDE-MESH-CACHE-BBOX-MIN))
                 (add.i remaining remaining -1)
                 (l.q a1 triangle COLLIDE-MESH-CACHE-BBOX-MAX)
                 (pcgt.w a2 a2 a0)
                 (mmi-nop!)
                 (pcgt.w a1 v1 a1)
                 (mmi-nop!)
                 (or.q a1 a2 a1)
                 (nop!)
                 (ppach a1 r0 a1)
                 (mmi-nop!)
                 (sll a1 a1 16)
                 (nop!)
                 (b.nzl a1 next-triangle :delay (add.i triangle triangle COLLIDE-MESH-CACHE-TRI-STRIDE)))
      ;; Measure from the closest point to the sphere center. The dot with the cached oriented face
      ;; normal gives the sign, while the normalized direction must agree with the normal by at least
      ;; 0.707. The normal's w component is forced to one for the result and is never flipped. The
      ;; reciprocal-length path assumes that the center and closest point are distinct.
      (asm-block evaluate-candidate
                 (m! t9 closest-pt-in-triangle)
                 (add a0 r0 work)
                 (m a1 query-sphere)
                 (add a2 r0 triangle)
                 (add.i a3 triangle COLLIDE-MESH-CACHE-NORMAL)
                 (jalr ra t9 :delay (sll v0 ra 0))
                 (l.vf closest-point work (offset-of spat-work intersect))
                 (l.vf sphere-value query-sphere)
                 (l.vf normal triangle COLLIDE-MESH-CACHE-NORMAL)
                 (l.q v1 work (offset-of spat-work sphere-bbox4w min))
                 (l.q a0 work (offset-of spat-work sphere-bbox4w max))
                 (sub.vf center-delta sphere-value closest-point)
                 (l.wu a1 triangle COLLIDE-MESH-CACHE-PAT)
                 (mul.vf normal-products center-delta normal)
                 (l.vf triangle-a triangle (offset-of collide-mesh-cache-tri vertex 0))
                 (mul.vf distance-products center-delta center-delta)
                 (l.vf triangle-b triangle (offset-of collide-mesh-cache-tri vertex 1))
                 (move.w.vf normal vf0)
                 (l.vf triangle-c triangle (offset-of collide-mesh-cache-tri vertex 2))
                 (add.x.vf.y normal-products normal-products normal-products)
                 (add.i triangle triangle COLLIDE-MESH-CACHE-TRI-STRIDE)
                 (add.y.vf.x distance-products distance-products distance-products)
                 (m f3 best-distance-bits)
                 (add.z.vf.y normal-products normal-products normal-products)
                 (add.z.vf.x distance-products distance-products distance-products)
                 (sqrt.x Q distance-products)
                 (m a2 normal-products)
                 (m f0 r0)
                 (waitq)
                 (l.s f1 query-sphere (offset-of vector w))
                 (addq.x distance-products vf0 Q)
                 (vmove.xyzw signed-distance distance-products)
                 (b.ltl a2 r0 signed-distance-ready :delay (sub.vf signed-distance vf0 signed-distance))
                 (label signed-distance-ready)
                 (m a2 signed-distance)
                 (m f2 a2)
                 (sub.s f2 f2 f1)
                 (div.w.x Q vf0 distance-products)
                 (c.lt.s f3 f2)
                 (b.fpt next-triangle :delay (nop!))
                 (c.le.s f0 f2)
                 (b.fpt next-triangle :delay (nop!))
                 (waitq)
                 (nop!)
                 (mulq.vf unit-direction center-delta Q)
                 (l.s f4 function-base collide-mesh-contact-cosine)
                 (mul.vf normal-products unit-direction normal)
                 (add.y.vf.x normal-products normal-products normal-products)
                 (add.z.vf.x normal-products normal-products normal-products)
                 (m a2 normal-products)
                 (m f5 a2)
                 (c.lt.s f5 f4)
                 (b.fpt next-triangle :delay (nop!)))
      (asm-block save-contact
                 (m best-distance-bits f2)
                 (s.vf triangle-a result (offset-of collide-tri-result vertex 0))
                 (s.vf triangle-b result (offset-of collide-tri-result vertex 1))
                 (s.vf triangle-c result (offset-of collide-tri-result vertex 2))
                 (s.vf closest-point result COLLIDE-TRI-RESULT-INTERSECT)
                 (s.vf normal result COLLIDE-TRI-RESULT-NORMAL)
                 (b next-triangle :delay (s.w a1 result COLLIDE-TRI-RESULT-PAT)))
      (asm-block restore-state
                 (label done)
                 (m v0 best-distance-bits)
                 (l.d ra sp)
                 (l.d function-base sp 8)
                 (l.q gp sp 144)
                 (l.q s5 sp 128)
                 (l.q s4 sp 112)
                 (l.q s3 sp 96)
                 (l.q s2 sp 80)
                 (l.q s1 sp 64)
                 (jr ra :delay (add.i sp sp 160))
                 (nop! :count 2)))))

(#when PC_PORT
  (defmethod-mips2c "(method 14 collide-mesh)" 14 collide-mesh))

(#unless PC_PORT
  (defmethod transform-verts-1-matrix! ((this collide-mesh) (xform matrix) (output (pointer uint8)))
    "Transform the nonempty padded vertex buffer in groups of four and
     write each result twice to output: first as a floating-point vector, then as an integer vector
     converted with truncation. Output provides 32 bytes for every padded vertex."
    (declare (asm-func none))
    (rlet ((remaining :reg a0)
           (xform-reg :reg a1)
           (output-cursor :reg a2)
           (vertex-source :reg v1)
           (xform-x :reg vf1)
           (xform-y :reg vf2)
           (xform-z :reg vf3)
           (xform-translation :reg vf4)
           (bank-a-0 :reg vf5)
           (bank-a-1 :reg vf6)
           (bank-a-2 :reg vf7)
           (bank-a-3 :reg vf8)
           (bank-b-0 :reg vf9)
           (bank-b-1 :reg vf10)
           (bank-b-2 :reg vf11)
           (bank-b-3 :reg vf12)
           (integer-a-0 :reg vf13)
           (integer-a-1 :reg vf14)
           (integer-a-2 :reg vf15)
           (integer-a-3 :reg vf16)
           (integer-b-0 :reg vf17)
           (integer-b-1 :reg vf18)
           (integer-b-2 :reg vf19)
           (integer-b-3 :reg vf20))
      ;; Two four-vertex banks overlap source loads, matrix multiplies, and output stores. Vertex
      ;; arrays are padded for these initial eight speculative loads; remaining controls which
      ;; completed four-vertex banks are committed.
      (asm-block load-transform-and-first-page
                 (nop! :count 2)
                 (l.wu vertex-source this COLLIDE-MESH-VERTEX-DATA)
                 (nop!)
                 (l.wu remaining this COLLIDE-MESH-NUM-VERTS)
                 (nop!)
                 (l.vf xform-x xform-reg (offset-of matrix vector 0))
                 (nop!)
                 (l.vf xform-y xform-reg (offset-of matrix vector 1))
                 (nop!)
                 (l.vf xform-z xform-reg (offset-of matrix vector 2))
                 (nop!)
                 (l.vf xform-translation xform-reg (offset-of matrix vector 3))
                 (nop!)
                 (l.vf bank-a-0 vertex-source)
                 (nop!)
                 (l.vf bank-a-1 vertex-source COLLIDE-MESH-VERTEX-STRIDE)
                 (nop!)
                 (l.vf bank-a-2 vertex-source (* 2 COLLIDE-MESH-VERTEX-STRIDE))
                 (nop!)
                 (l.vf bank-a-3 vertex-source (* 3 COLLIDE-MESH-VERTEX-STRIDE)))
      ;; Transform the first bank while fetching the second. Floating and integer copies are
      ;; interleaved in output so later triangle code can select either representation directly.
      (asm-block transform-first-bank
                 (mula.w.vf xform-translation vf0)
                 (l.vf bank-b-0 vertex-source COLLIDE-MESH-VERTEX-BANK-STRIDE)
                 (madda.x.vf xform-x bank-a-0)
                 (l.vf bank-b-1 vertex-source (+ COLLIDE-MESH-VERTEX-BANK-STRIDE COLLIDE-MESH-VERTEX-STRIDE))
                 (madda.y.vf xform-y bank-a-0)
                 (l.vf bank-b-2 vertex-source (+ COLLIDE-MESH-VERTEX-BANK-STRIDE (* 2 COLLIDE-MESH-VERTEX-STRIDE)))
                 (madd.z.vf bank-a-0 xform-z bank-a-0)
                 (l.vf bank-b-3 vertex-source (+ COLLIDE-MESH-VERTEX-BANK-STRIDE (* 3 COLLIDE-MESH-VERTEX-STRIDE)))
                 (mula.w.vf xform-translation vf0)
                 (nop!)
                 (madda.x.vf xform-x bank-a-1)
                 (nop!)
                 (madda.y.vf xform-y bank-a-1)
                 (nop!)
                 (madd.z.vf bank-a-1 xform-z bank-a-1)
                 (nop!)
                 (mula.w.vf xform-translation vf0)
                 (nop!)
                 (madda.x.vf xform-x bank-a-2)
                 (nop!)
                 (madda.y.vf xform-y bank-a-2)
                 (nop!)
                 (madd.z.vf bank-a-2 xform-z bank-a-2)
                 (nop!)
                 (mula.w.vf xform-translation vf0)
                 (nop!)
                 (madda.x.vf xform-x bank-a-3)
                 (nop!)
                 (madda.y.vf xform-y bank-a-3)
                 (nop!)
                 (madd.z.vf bank-a-3 xform-z bank-a-3)
                 (nop!)
                 (ftoi.vf integer-a-0 bank-a-0)
                 (s.vf bank-a-0 output-cursor COLLIDE-MESH-MATH-FLOAT)
                 (ftoi.vf integer-a-1 bank-a-1)
                 (s.vf bank-a-1 output-cursor COLLIDE-MESH-MATH-VERTEX-STRIDE)
                 (ftoi.vf integer-a-2 bank-a-2)
                 (s.vf bank-a-2 output-cursor (* 2 COLLIDE-MESH-MATH-VERTEX-STRIDE))
                 (ftoi.vf integer-a-3 bank-a-3)
                 (s.vf bank-a-3 output-cursor (* 3 COLLIDE-MESH-MATH-VERTEX-STRIDE))
                 (nop!)
                 (s.vf integer-a-0 output-cursor COLLIDE-MESH-MATH-INTEGER)
                 (add.i remaining remaining -4)
                 (s.vf integer-a-1 output-cursor (+ COLLIDE-MESH-MATH-VERTEX-STRIDE COLLIDE-MESH-MATH-INTEGER))
                 (add.i vertex-source vertex-source COLLIDE-MESH-VERTEX-PAGE-STRIDE)
                 (s.vf integer-a-2 output-cursor (+ (* 2 COLLIDE-MESH-MATH-VERTEX-STRIDE) COLLIDE-MESH-MATH-INTEGER))
                 (b.le remaining
                       r0
                       done
                       :delay
                       (s.vf integer-a-3 output-cursor (+ (* 3 COLLIDE-MESH-MATH-VERTEX-STRIDE) COLLIDE-MESH-MATH-INTEGER))))
      ;; Drain bank B while refilling bank A from the next page.
      (asm-block transform-second-bank
                 (label transform-second-bank)
                 (mula.w.vf xform-translation vf0)
                 (l.vf bank-a-0 vertex-source)
                 (madda.x.vf xform-x bank-b-0)
                 (l.vf bank-a-1 vertex-source COLLIDE-MESH-VERTEX-STRIDE)
                 (madda.y.vf xform-y bank-b-0)
                 (l.vf bank-a-2 vertex-source (* 2 COLLIDE-MESH-VERTEX-STRIDE))
                 (madd.z.vf bank-b-0 xform-z bank-b-0)
                 (l.vf bank-a-3 vertex-source (* 3 COLLIDE-MESH-VERTEX-STRIDE))
                 (mula.w.vf xform-translation vf0)
                 (nop!)
                 (madda.x.vf xform-x bank-b-1)
                 (nop!)
                 (madda.y.vf xform-y bank-b-1)
                 (nop!)
                 (madd.z.vf bank-b-1 xform-z bank-b-1)
                 (nop!)
                 (mula.w.vf xform-translation vf0)
                 (nop!)
                 (madda.x.vf xform-x bank-b-2)
                 (nop!)
                 (madda.y.vf xform-y bank-b-2)
                 (nop!)
                 (madd.z.vf bank-b-2 xform-z bank-b-2)
                 (nop!)
                 (mula.w.vf xform-translation vf0)
                 (nop!)
                 (madda.x.vf xform-x bank-b-3)
                 (nop!)
                 (madda.y.vf xform-y bank-b-3)
                 (nop!)
                 (madd.z.vf bank-b-3 xform-z bank-b-3)
                 (nop!)
                 (ftoi.vf integer-b-0 bank-b-0)
                 (s.vf bank-b-0 output-cursor COLLIDE-MESH-MATH-BANK-STRIDE)
                 (ftoi.vf integer-b-1 bank-b-1)
                 (s.vf bank-b-1 output-cursor (+ COLLIDE-MESH-MATH-BANK-STRIDE COLLIDE-MESH-MATH-VERTEX-STRIDE))
                 (ftoi.vf integer-b-2 bank-b-2)
                 (s.vf bank-b-2 output-cursor (+ COLLIDE-MESH-MATH-BANK-STRIDE (* 2 COLLIDE-MESH-MATH-VERTEX-STRIDE)))
                 (ftoi.vf integer-b-3 bank-b-3)
                 (s.vf bank-b-3 output-cursor (+ COLLIDE-MESH-MATH-BANK-STRIDE (* 3 COLLIDE-MESH-MATH-VERTEX-STRIDE)))
                 (nop!)
                 (s.vf integer-b-0 output-cursor (+ COLLIDE-MESH-MATH-BANK-STRIDE COLLIDE-MESH-MATH-INTEGER))
                 (add.i remaining remaining -4)
                 (s.vf integer-b-1
                       output-cursor
                       (+ COLLIDE-MESH-MATH-BANK-STRIDE COLLIDE-MESH-MATH-VERTEX-STRIDE COLLIDE-MESH-MATH-INTEGER))
                 (nop!)
                 (s.vf integer-b-2
                       output-cursor
                       (+ COLLIDE-MESH-MATH-BANK-STRIDE (* 2 COLLIDE-MESH-MATH-VERTEX-STRIDE) COLLIDE-MESH-MATH-INTEGER))
                 (b.le remaining
                       r0
                       done
                       :delay
                       (s.vf integer-b-3
                             output-cursor
                             (+ COLLIDE-MESH-MATH-BANK-STRIDE (* 3 COLLIDE-MESH-MATH-VERTEX-STRIDE) COLLIDE-MESH-MATH-INTEGER))))
      ;; Process the refilled A bank while fetching the next B bank, then advance both pages.
      (asm-block transform-refilled-first-bank
                 (mula.w.vf xform-translation vf0)
                 (l.vf bank-b-0 vertex-source COLLIDE-MESH-VERTEX-BANK-STRIDE)
                 (madda.x.vf xform-x bank-a-0)
                 (l.vf bank-b-1 vertex-source (+ COLLIDE-MESH-VERTEX-BANK-STRIDE COLLIDE-MESH-VERTEX-STRIDE))
                 (madda.y.vf xform-y bank-a-0)
                 (l.vf bank-b-2 vertex-source (+ COLLIDE-MESH-VERTEX-BANK-STRIDE (* 2 COLLIDE-MESH-VERTEX-STRIDE)))
                 (madd.z.vf bank-a-0 xform-z bank-a-0)
                 (l.vf bank-b-3 vertex-source (+ COLLIDE-MESH-VERTEX-BANK-STRIDE (* 3 COLLIDE-MESH-VERTEX-STRIDE)))
                 (mula.w.vf xform-translation vf0)
                 (add.i output-cursor output-cursor COLLIDE-MESH-MATH-PAGE-STRIDE)
                 (madda.x.vf xform-x bank-a-1)
                 (nop!)
                 (madda.y.vf xform-y bank-a-1)
                 (nop!)
                 (madd.z.vf bank-a-1 xform-z bank-a-1)
                 (nop!)
                 (mula.w.vf xform-translation vf0)
                 (nop!)
                 (madda.x.vf xform-x bank-a-2)
                 (nop!)
                 (madda.y.vf xform-y bank-a-2)
                 (nop!)
                 (madd.z.vf bank-a-2 xform-z bank-a-2)
                 (nop!)
                 (mula.w.vf xform-translation vf0)
                 (nop!)
                 (madda.x.vf xform-x bank-a-3)
                 (nop!)
                 (madda.y.vf xform-y bank-a-3)
                 (nop!)
                 (madd.z.vf bank-a-3 xform-z bank-a-3)
                 (nop!)
                 (ftoi.vf integer-a-0 bank-a-0)
                 (s.vf bank-a-0 output-cursor COLLIDE-MESH-MATH-FLOAT)
                 (ftoi.vf integer-a-1 bank-a-1)
                 (s.vf bank-a-1 output-cursor COLLIDE-MESH-MATH-VERTEX-STRIDE)
                 (ftoi.vf integer-a-2 bank-a-2)
                 (s.vf bank-a-2 output-cursor (* 2 COLLIDE-MESH-MATH-VERTEX-STRIDE))
                 (ftoi.vf integer-a-3 bank-a-3)
                 (s.vf bank-a-3 output-cursor (* 3 COLLIDE-MESH-MATH-VERTEX-STRIDE))
                 (nop!)
                 (s.vf integer-a-0 output-cursor COLLIDE-MESH-MATH-INTEGER)
                 (add.i remaining remaining -4)
                 (s.vf integer-a-1 output-cursor (+ COLLIDE-MESH-MATH-VERTEX-STRIDE COLLIDE-MESH-MATH-INTEGER))
                 (add.i vertex-source vertex-source COLLIDE-MESH-VERTEX-PAGE-STRIDE)
                 (s.vf integer-a-2 output-cursor (+ (* 2 COLLIDE-MESH-MATH-VERTEX-STRIDE) COLLIDE-MESH-MATH-INTEGER))
                 (b.gt remaining
                       r0
                       transform-second-bank
                       :delay
                       (s.vf integer-a-3 output-cursor (+ (* 3 COLLIDE-MESH-MATH-VERTEX-STRIDE) COLLIDE-MESH-MATH-INTEGER))))
      (asm-block finish (label done) (m v0 r0) (jr ra :delay (add sp sp r0)) (nop! :count 3)))))

(#when PC_PORT
  (defmethod-mips2c "(method 15 collide-mesh)" 15 collide-mesh))

(#unless PC_PORT
  (defmethod transform-verts-2-matrix! ((this collide-mesh) (float-xform matrix) (integer-xform matrix) (output (pointer uint8)))
    "Transform local vertices in groups of four. Write each result from
     float-xform as a floating-point vector, then transform that result by integer-xform
     and write its truncated integer vector. The input must be nonempty and padded to four vectors;
     output provides 32 bytes for every padded vertex."
    (declare (asm-func none))
    (rlet ((remaining :reg a0)
           (float-xform-reg :reg a1)
           (integer-xform-reg :reg a2)
           (output-cursor :reg a3)
           (vertex-source :reg v1)
           (float-x :reg vf1)
           (float-y :reg vf2)
           (float-z :reg vf3)
           (float-translation :reg vf4)
           (bank-a-0 :reg vf5)
           (bank-a-1 :reg vf6)
           (bank-a-2 :reg vf7)
           (bank-a-3 :reg vf8)
           (bank-b-0 :reg vf9)
           (bank-b-1 :reg vf10)
           (bank-b-2 :reg vf11)
           (bank-b-3 :reg vf12)
           (integer-x :reg vf13)
           (integer-y :reg vf14)
           (integer-z :reg vf15)
           (integer-translation :reg vf16))
      ;; Load both transforms and the first four source vertices. The second bank is fetched while
      ;; the first bank is transformed below.
      (asm-block load-transforms-and-first-bank
                 (nop! :count 2)
                 (l.wu vertex-source this COLLIDE-MESH-VERTEX-DATA)
                 (nop!)
                 (l.wu remaining this COLLIDE-MESH-NUM-VERTS)
                 (nop!)
                 (l.vf float-x float-xform-reg (offset-of matrix vector 0))
                 (nop!)
                 (l.vf float-y float-xform-reg (offset-of matrix vector 1))
                 (nop!)
                 (l.vf float-z float-xform-reg (offset-of matrix vector 2))
                 (nop!)
                 (l.vf float-translation float-xform-reg (offset-of matrix vector 3))
                 (nop!)
                 (l.vf integer-x integer-xform-reg (offset-of matrix vector 0))
                 (nop!)
                 (l.vf integer-y integer-xform-reg (offset-of matrix vector 1))
                 (nop!)
                 (l.vf integer-z integer-xform-reg (offset-of matrix vector 2))
                 (nop!)
                 (l.vf integer-translation integer-xform-reg (offset-of matrix vector 3))
                 (nop!)
                 (l.vf bank-a-0 vertex-source)
                 (nop!)
                 (l.vf bank-a-1 vertex-source COLLIDE-MESH-VERTEX-STRIDE)
                 (nop!)
                 (l.vf bank-a-2 vertex-source (* 2 COLLIDE-MESH-VERTEX-STRIDE))
                 (nop!)
                 (l.vf bank-a-3 vertex-source (* 3 COLLIDE-MESH-VERTEX-STRIDE)))
      ;; Produce the floating-point positions for bank A while filling bank B. Each floating result
      ;; is saved before the integer transform reuses the same register.
      (asm-block transform-first-bank-to-float
                 (mula.w.vf float-translation vf0)
                 (l.vf bank-b-0 vertex-source COLLIDE-MESH-VERTEX-BANK-STRIDE)
                 (madda.x.vf float-x bank-a-0)
                 (l.vf bank-b-1 vertex-source (+ COLLIDE-MESH-VERTEX-BANK-STRIDE COLLIDE-MESH-VERTEX-STRIDE))
                 (madda.y.vf float-y bank-a-0)
                 (l.vf bank-b-2 vertex-source (+ COLLIDE-MESH-VERTEX-BANK-STRIDE (* 2 COLLIDE-MESH-VERTEX-STRIDE)))
                 (madd.z.vf bank-a-0 float-z bank-a-0)
                 (l.vf bank-b-3 vertex-source (+ COLLIDE-MESH-VERTEX-BANK-STRIDE (* 3 COLLIDE-MESH-VERTEX-STRIDE)))
                 (mula.w.vf float-translation vf0)
                 (nop!)
                 (madda.x.vf float-x bank-a-1)
                 (nop!)
                 (madda.y.vf float-y bank-a-1)
                 (nop!)
                 (madd.z.vf bank-a-1 float-z bank-a-1)
                 (nop!)
                 (mula.w.vf float-translation vf0)
                 (nop!)
                 (madda.x.vf float-x bank-a-2)
                 (nop!)
                 (madda.y.vf float-y bank-a-2)
                 (nop!)
                 (madd.z.vf bank-a-2 float-z bank-a-2)
                 (nop!)
                 (mula.w.vf float-translation vf0)
                 (nop!)
                 (madda.x.vf float-x bank-a-3)
                 (nop!)
                 (madda.y.vf float-y bank-a-3)
                 (nop!)
                 (madd.z.vf bank-a-3 float-z bank-a-3)
                 (nop!))
      (asm-block transform-and-store-first-bank
                 (mula.w.vf integer-translation vf0)
                 (s.vf bank-a-0 output-cursor COLLIDE-MESH-MATH-FLOAT)
                 (madda.x.vf integer-x bank-a-0)
                 (s.vf bank-a-1 output-cursor COLLIDE-MESH-MATH-VERTEX-STRIDE)
                 (madda.y.vf integer-y bank-a-0)
                 (s.vf bank-a-2 output-cursor (* 2 COLLIDE-MESH-MATH-VERTEX-STRIDE))
                 (madd.z.vf bank-a-0 integer-z bank-a-0)
                 (s.vf bank-a-3 output-cursor (* 3 COLLIDE-MESH-MATH-VERTEX-STRIDE))
                 (mula.w.vf integer-translation vf0)
                 (nop!)
                 (madda.x.vf integer-x bank-a-1)
                 (nop!)
                 (madda.y.vf integer-y bank-a-1)
                 (nop!)
                 (madd.z.vf bank-a-1 integer-z bank-a-1)
                 (nop!)
                 (mula.w.vf integer-translation vf0)
                 (nop!)
                 (madda.x.vf integer-x bank-a-2)
                 (nop!)
                 (madda.y.vf integer-y bank-a-2)
                 (nop!)
                 (madd.z.vf bank-a-2 integer-z bank-a-2)
                 (nop!)
                 (mula.w.vf integer-translation vf0)
                 (nop!)
                 (madda.x.vf integer-x bank-a-3)
                 (nop!)
                 (madda.y.vf integer-y bank-a-3)
                 (nop!)
                 (madd.z.vf bank-a-3 integer-z bank-a-3)
                 (nop!)
                 (ftoi.vf bank-a-0 bank-a-0)
                 (nop!)
                 (ftoi.vf bank-a-1 bank-a-1)
                 (nop!)
                 (ftoi.vf bank-a-2 bank-a-2)
                 (nop!)
                 (ftoi.vf bank-a-3 bank-a-3)
                 (nop! :count 2)
                 (s.vf bank-a-0 output-cursor COLLIDE-MESH-MATH-INTEGER)
                 (add.i remaining remaining -4)
                 (s.vf bank-a-1 output-cursor (+ COLLIDE-MESH-MATH-VERTEX-STRIDE COLLIDE-MESH-MATH-INTEGER))
                 (add.i vertex-source vertex-source COLLIDE-MESH-VERTEX-PAGE-STRIDE)
                 (s.vf bank-a-2 output-cursor (+ (* 2 COLLIDE-MESH-MATH-VERTEX-STRIDE) COLLIDE-MESH-MATH-INTEGER))
                 (b.le remaining
                       r0
                       done
                       :delay
                       (s.vf bank-a-3 output-cursor (+ (* 3 COLLIDE-MESH-MATH-VERTEX-STRIDE) COLLIDE-MESH-MATH-INTEGER))))
      ;; Consume bank B while filling bank A from the next source page.
      (asm-block transform-second-bank-to-float
                 (label transform-second-bank)
                 (mula.w.vf float-translation vf0)
                 (l.vf bank-a-0 vertex-source)
                 (madda.x.vf float-x bank-b-0)
                 (l.vf bank-a-1 vertex-source COLLIDE-MESH-VERTEX-STRIDE)
                 (madda.y.vf float-y bank-b-0)
                 (l.vf bank-a-2 vertex-source (* 2 COLLIDE-MESH-VERTEX-STRIDE))
                 (madd.z.vf bank-b-0 float-z bank-b-0)
                 (l.vf bank-a-3 vertex-source (* 3 COLLIDE-MESH-VERTEX-STRIDE))
                 (mula.w.vf float-translation vf0)
                 (nop!)
                 (madda.x.vf float-x bank-b-1)
                 (nop!)
                 (madda.y.vf float-y bank-b-1)
                 (nop!)
                 (madd.z.vf bank-b-1 float-z bank-b-1)
                 (nop!)
                 (mula.w.vf float-translation vf0)
                 (nop!)
                 (madda.x.vf float-x bank-b-2)
                 (nop!)
                 (madda.y.vf float-y bank-b-2)
                 (nop!)
                 (madd.z.vf bank-b-2 float-z bank-b-2)
                 (nop!)
                 (mula.w.vf float-translation vf0)
                 (nop!)
                 (madda.x.vf float-x bank-b-3)
                 (nop!)
                 (madda.y.vf float-y bank-b-3)
                 (nop!)
                 (madd.z.vf bank-b-3 float-z bank-b-3)
                 (nop!))
      (asm-block transform-and-store-second-bank
                 (mula.w.vf integer-translation vf0)
                 (s.vf bank-b-0 output-cursor COLLIDE-MESH-MATH-BANK-STRIDE)
                 (madda.x.vf integer-x bank-b-0)
                 (s.vf bank-b-1 output-cursor (+ COLLIDE-MESH-MATH-BANK-STRIDE COLLIDE-MESH-MATH-VERTEX-STRIDE))
                 (madda.y.vf integer-y bank-b-0)
                 (s.vf bank-b-2 output-cursor (+ COLLIDE-MESH-MATH-BANK-STRIDE (* 2 COLLIDE-MESH-MATH-VERTEX-STRIDE)))
                 (madd.z.vf bank-b-0 integer-z bank-b-0)
                 (s.vf bank-b-3 output-cursor (+ COLLIDE-MESH-MATH-BANK-STRIDE (* 3 COLLIDE-MESH-MATH-VERTEX-STRIDE)))
                 (mula.w.vf integer-translation vf0)
                 (nop!)
                 (madda.x.vf integer-x bank-b-1)
                 (nop!)
                 (madda.y.vf integer-y bank-b-1)
                 (nop!)
                 (madd.z.vf bank-b-1 integer-z bank-b-1)
                 (nop!)
                 (mula.w.vf integer-translation vf0)
                 (nop!)
                 (madda.x.vf integer-x bank-b-2)
                 (nop!)
                 (madda.y.vf integer-y bank-b-2)
                 (nop!)
                 (madd.z.vf bank-b-2 integer-z bank-b-2)
                 (nop!)
                 (mula.w.vf integer-translation vf0)
                 (nop!)
                 (madda.x.vf integer-x bank-b-3)
                 (nop!)
                 (madda.y.vf integer-y bank-b-3)
                 (nop!)
                 (madd.z.vf bank-b-3 integer-z bank-b-3)
                 (nop!)
                 (ftoi.vf bank-b-0 bank-b-0)
                 (nop!)
                 (ftoi.vf bank-b-1 bank-b-1)
                 (nop!)
                 (ftoi.vf bank-b-2 bank-b-2)
                 (nop!)
                 (ftoi.vf bank-b-3 bank-b-3)
                 (nop! :count 2)
                 (s.vf bank-b-0 output-cursor (+ COLLIDE-MESH-MATH-BANK-STRIDE COLLIDE-MESH-MATH-INTEGER))
                 (add.i remaining remaining -4)
                 (s.vf bank-b-1
                       output-cursor
                       (+ COLLIDE-MESH-MATH-BANK-STRIDE COLLIDE-MESH-MATH-VERTEX-STRIDE COLLIDE-MESH-MATH-INTEGER))
                 (nop!)
                 (s.vf bank-b-2
                       output-cursor
                       (+ COLLIDE-MESH-MATH-BANK-STRIDE (* 2 COLLIDE-MESH-MATH-VERTEX-STRIDE) COLLIDE-MESH-MATH-INTEGER))
                 (b.le remaining
                       r0
                       done
                       :delay
                       (s.vf bank-b-3
                             output-cursor
                             (+ COLLIDE-MESH-MATH-BANK-STRIDE (* 3 COLLIDE-MESH-MATH-VERTEX-STRIDE) COLLIDE-MESH-MATH-INTEGER))))
      ;; Reuse the newly filled A bank and fetch the following B bank. Output advances only after
      ;; the first eight vertices have been committed, matching the two-bank source cadence.
      (asm-block transform-refilled-first-bank-to-float
                 (mula.w.vf float-translation vf0)
                 (l.vf bank-b-0 vertex-source COLLIDE-MESH-VERTEX-BANK-STRIDE)
                 (madda.x.vf float-x bank-a-0)
                 (l.vf bank-b-1 vertex-source (+ COLLIDE-MESH-VERTEX-BANK-STRIDE COLLIDE-MESH-VERTEX-STRIDE))
                 (madda.y.vf float-y bank-a-0)
                 (l.vf bank-b-2 vertex-source (+ COLLIDE-MESH-VERTEX-BANK-STRIDE (* 2 COLLIDE-MESH-VERTEX-STRIDE)))
                 (madd.z.vf bank-a-0 float-z bank-a-0)
                 (l.vf bank-b-3 vertex-source (+ COLLIDE-MESH-VERTEX-BANK-STRIDE (* 3 COLLIDE-MESH-VERTEX-STRIDE)))
                 (mula.w.vf float-translation vf0)
                 (add.i output-cursor output-cursor COLLIDE-MESH-MATH-PAGE-STRIDE)
                 (madda.x.vf float-x bank-a-1)
                 (nop!)
                 (madda.y.vf float-y bank-a-1)
                 (nop!)
                 (madd.z.vf bank-a-1 float-z bank-a-1)
                 (nop!)
                 (mula.w.vf float-translation vf0)
                 (nop!)
                 (madda.x.vf float-x bank-a-2)
                 (nop!)
                 (madda.y.vf float-y bank-a-2)
                 (nop!)
                 (madd.z.vf bank-a-2 float-z bank-a-2)
                 (nop!)
                 (mula.w.vf float-translation vf0)
                 (nop!)
                 (madda.x.vf float-x bank-a-3)
                 (nop!)
                 (madda.y.vf float-y bank-a-3)
                 (nop!)
                 (madd.z.vf bank-a-3 float-z bank-a-3)
                 (nop!))
      (asm-block transform-and-store-refilled-first-bank
                 (mula.w.vf integer-translation vf0)
                 (s.vf bank-a-0 output-cursor COLLIDE-MESH-MATH-FLOAT)
                 (madda.x.vf integer-x bank-a-0)
                 (s.vf bank-a-1 output-cursor COLLIDE-MESH-MATH-VERTEX-STRIDE)
                 (madda.y.vf integer-y bank-a-0)
                 (s.vf bank-a-2 output-cursor (* 2 COLLIDE-MESH-MATH-VERTEX-STRIDE))
                 (madd.z.vf bank-a-0 integer-z bank-a-0)
                 (s.vf bank-a-3 output-cursor (* 3 COLLIDE-MESH-MATH-VERTEX-STRIDE))
                 (mula.w.vf integer-translation vf0)
                 (nop!)
                 (madda.x.vf integer-x bank-a-1)
                 (nop!)
                 (madda.y.vf integer-y bank-a-1)
                 (nop!)
                 (madd.z.vf bank-a-1 integer-z bank-a-1)
                 (nop!)
                 (mula.w.vf integer-translation vf0)
                 (nop!)
                 (madda.x.vf integer-x bank-a-2)
                 (nop!)
                 (madda.y.vf integer-y bank-a-2)
                 (nop!)
                 (madd.z.vf bank-a-2 integer-z bank-a-2)
                 (nop!)
                 (mula.w.vf integer-translation vf0)
                 (nop!)
                 (madda.x.vf integer-x bank-a-3)
                 (nop!)
                 (madda.y.vf integer-y bank-a-3)
                 (nop!)
                 (madd.z.vf bank-a-3 integer-z bank-a-3)
                 (nop!)
                 (ftoi.vf bank-a-0 bank-a-0)
                 (nop!)
                 (ftoi.vf bank-a-1 bank-a-1)
                 (nop!)
                 (ftoi.vf bank-a-2 bank-a-2)
                 (nop!)
                 (ftoi.vf bank-a-3 bank-a-3)
                 (nop! :count 2)
                 (s.vf bank-a-0 output-cursor COLLIDE-MESH-MATH-INTEGER)
                 (add.i remaining remaining -4)
                 (s.vf bank-a-1 output-cursor (+ COLLIDE-MESH-MATH-VERTEX-STRIDE COLLIDE-MESH-MATH-INTEGER))
                 (add.i vertex-source vertex-source COLLIDE-MESH-VERTEX-PAGE-STRIDE)
                 (s.vf bank-a-2 output-cursor (+ (* 2 COLLIDE-MESH-MATH-VERTEX-STRIDE) COLLIDE-MESH-MATH-INTEGER))
                 (b.gt remaining
                       r0
                       transform-second-bank
                       :delay
                       (s.vf bank-a-3 output-cursor (+ (* 3 COLLIDE-MESH-MATH-VERTEX-STRIDE) COLLIDE-MESH-MATH-INTEGER))))
      (asm-block finish (label done) (m v0 r0) (jr ra :delay (add sp sp r0)) (nop! :count 3)))))

(defmethod allocate! ((this collide-mesh-cache) (byte-count int))
  "Round byte-count up to sixteen and allocate it from the linear cache. Wrap to the
   beginning and advance the nonzero generation id when the remaining tail is too small; print an
   error and return false when one allocation exceeds the entire cache."
  (local-vars (next-used-size int) (next-id int))
  (let* ((biased-byte-count (+ byte-count 15))
         (used-size (-> this used-size))
         (quadword-count (/ biased-byte-count 16))
         (cache-data (-> this data))
         (max-size (-> this max-size))
         (aligned-byte-count (* quadword-count 16))
         (result-address (&+ cache-data used-size)))
    (let ((request-room (- max-size (the-as uint aligned-byte-count)))
          (current-id (-> this id)))
      (b! (< (the-as int request-room) 0) cfg-6 :delay (set! next-used-size (the-as int (+ used-size aligned-byte-count))))
      (b! (>= (the-as int (- max-size (the-as uint next-used-size))) 0)
          cfg-5
          :delay
          (set! next-id (the-as int (+ current-id 1)))))
    (b! (zero? (the-as uint next-id)) cfg-4 :likely-delay (set! next-id 1))
    (label cfg-4)
    (set! next-used-size aligned-byte-count)
    (set! result-address (-> this data))
    (set! (-> this id) (the-as uint next-id))
    (label cfg-5)
    (set! (-> this used-size) (the-as uint next-used-size))
    (let ((return-address result-address))
      (b! #t cfg-7 :delay (nop!))
      (label cfg-6)
      (format 0 "ERROR: Attempted to allocate something bigger than the entire mesh cache!~%")
      (set! return-address (the-as (pointer uint8) #f))
      (label cfg-7)
      return-address)))

(defmethod populate-cache! ((this collide-mesh) (cache-tris collide-mesh-cache-tri) (xform matrix))
  "Transform the padded local vertex buffer through xform in four-vertex batches
   on scratchpad, then expand each indexed triangle into world-space vertices, a unit face normal,
   integer bounds, and overlaid surface properties in cache."
  (local-vars (vertex-index-0 uint))
  (rlet ((acc :class vf)
         (Q :class vf)
         (vf0 :class vf)
         (vf1 :class vf)
         (vf10 :class vf)
         (vf11 :class vf)
         (vf12 :class vf)
         (vf2 :class vf)
         (vf3 :class vf)
         (vf4 :class vf)
         (vf5 :class vf)
         (vf6 :class vf)
         (vf7 :class vf)
         (vf8 :class vf)
         (vf9 :class vf))
    (init-vf0-vector)
    (nop!)
    ;; Triangle indices are bytes, so at most 256 logical vertices occupy this four-kilobyte
    ;; scratchpad staging area. The source buffer is padded because this loop always loads and
    ;; transforms a complete group of four.
    (let ((scratch-vertices (scratchpad-object int))
          (vertices-left (-> this num-verts)))
      (nop!)
      (let ((source-vertices (-> this vertex-data)))
        (b! (zero? vertices-left) cfg-3 :delay (.lvf vf1 (&-> xform vector 0 quad)))
        (nop!)
        (.lvf vf2 (&-> xform vector 1 quad))
        (let ((scratch-output (+ scratch-vertices -64)))
          (.lvf vf3 (&-> xform vector 2 quad))
          (nop!)
          (.lvf vf4 (&-> xform vector 3 quad))
          (nop!)
          (.lvf vf5 (&-> source-vertices 0 quad))
          (nop!)
          (.lvf vf6 (&-> source-vertices 1 quad))
          (nop!)
          (.lvf vf7 (&-> source-vertices 2 quad))
          (nop!)
          (.lvf vf8 (&-> source-vertices 3 quad))
          (label cfg-2)
          (.mul.w.vf acc vf4 vf0)
          (set! source-vertices (the-as (inline-array vector) (-> source-vertices 4)))
          (.add.mul.x.vf acc vf1 vf5 acc)
          (+! scratch-output 64)
          (.add.mul.y.vf acc vf2 vf5 acc)
          (nop!)
          (.add.mul.z.vf vf9 vf3 vf5 acc)
          (nop!)
          (.mul.w.vf acc vf4 vf0)
          (.lvf vf5 (&-> source-vertices 0 quad))
          (.add.mul.x.vf acc vf1 vf6 acc)
          (nop!)
          (.add.mul.y.vf acc vf2 vf6 acc)
          (nop!)
          (.add.mul.z.vf vf10 vf3 vf6 acc)
          (nop!)
          (.mul.w.vf acc vf4 vf0)
          (.lvf vf6 (&-> source-vertices 1 quad))
          (.add.mul.x.vf acc vf1 vf7 acc)
          (nop!)
          (.add.mul.y.vf acc vf2 vf7 acc)
          (nop!)
          (.add.mul.z.vf vf11 vf3 vf7 acc)
          (nop!)
          (.mul.w.vf acc vf4 vf0)
          (.lvf vf7 (&-> source-vertices 2 quad))
          (.add.mul.x.vf acc vf1 vf8 acc)
          (nop!)
          (.add.mul.y.vf acc vf2 vf8 acc)
          (nop!)
          (.add.mul.z.vf vf12 vf3 vf8 acc)
          (nop!)
          (nop!)
          (.lvf vf8 (&-> source-vertices 3 quad))
          (+! vertices-left -4)
          (.svf scratch-output vf9)
          (nop!)
          (.svf (+ scratch-output 16) vf10)
          (nop!)
          (.svf (+ scratch-output 32) vf11)
          (b! (> (the-as int vertices-left) 0) cfg-2 :delay (.svf (+ scratch-output 48) vf12)))))
    (label cfg-3)
    ;; Each 96-byte cache record expands one indexed triangle into three vertices, exact integer
    ;; broad-phase bounds, a normalized face normal, and the mesh's packed surface properties.
    (let ((triangle-record (the-as collide-mesh-tri (-> this tris))))
      (nop!)
      (let ((scratch-vertices (scratchpad-object int))
            (triangles-left (-> this num-tris)))
        (b! (zero? triangles-left) cfg-6 :delay (set! vertex-index-0 (-> triangle-record vertex-index 0)))
        (let* ((cache-tri (&+ cache-tris -96))
               (vertex-index-1 (-> triangle-record vertex-index 1))
               (vertex-offset-0 (* vertex-index-0 16))
               (vertex-index-2 (-> triangle-record vertex-index 2))
               (vertex-offset-1 (* vertex-index-1 16))
               (triangle-pat (-> triangle-record pat)))
          (let* ((vertex-offset-2 (* vertex-index-2 16))
                 (vertex-address-0 (+ vertex-offset-0 scratch-vertices))
                 (vertex-address-1 (+ vertex-offset-1 scratch-vertices))
                 (vertex-address-2 (+ vertex-offset-2 scratch-vertices)))
            (label cfg-5)
            (+! triangles-left -1)
            (.lvf vf1 vertex-address-0)
            (&+! triangle-record 8)
            (.lvf vf2 vertex-address-1)
            (&+! cache-tri 96)
            (.lvf vf3 vertex-address-2)
            (.sub.vf vf4 vf2 vf1)
            (.svf (&-> cache-tri vertex 0 quad) vf1)
            (.min.vf vf8 vf1 vf2)
            (.svf (&-> cache-tri vertex 1 quad) vf2)
            (.sub.vf vf5 vf3 vf1)
            (.svf (&-> cache-tri vertex 2 quad) vf3)
            (.max.vf vf9 vf1 vf2)
            ;; Preload the following triangle's indices while the VU normal calculation runs.
            (let ((next-index-0 (-> triangle-record vertex-index 0)))
              (.outer.product.a.vf acc vf4 vf5)
              (let ((next-index-1 (-> triangle-record vertex-index 1)))
                (.outer.product.b.vf vf6 vf5 vf4 acc)
                (let ((next-index-2 (-> triangle-record vertex-index 2)))
                  (.mul.vf vf7 vf6 vf6)
                  (nop!)
                  (.min.vf vf8 vf8 vf3)
                  (let ((next-offset-0 (* next-index-0 16)))
                    (.max.vf vf9 vf9 vf3)
                    (let ((next-offset-1 (* next-index-1 16)))
                      (.mul.x.vf.w acc vf0 vf7)
                      (let ((next-offset-2 (* next-index-2 16)))
                        (.add.mul.y.vf.w acc vf0 vf7 acc)
                        (set! vertex-address-0 (+ next-offset-0 scratch-vertices))
                        (.add.mul.z.vf.w vf7 vf0 vf7 acc)
                        (set! vertex-address-1 (+ next-offset-1 scratch-vertices))
                        (.isqrt.vf Q vf0 vf7 :fsf #b11 :ftf #b11)
                        (set! vertex-address-2 (+ next-offset-2 scratch-vertices)))))))))
          (.ftoi.vf vf8 vf8)
          (nop!)
          (.ftoi.vf vf9 vf9)
          (nop!)
          (nop!)
          (.svf (&-> cache-tri bbox4w min quad) vf8)
          (.wait.vf)
          (.svf (&-> cache-tri bbox4w max quad) vf9)
          (.mul.vf.xyz vf6 vf6 Q)
          (nop!)
          (nop!)
          (.svf (&-> cache-tri normal quad) vf6)
          (nop!)
          (set! (-> cache-tri normal w) (the-as float triangle-pat))
          (b! (nonzero? triangles-left) cfg-5 :delay (set! triangle-pat (-> triangle-record pat))))))
    (label cfg-6)
    0
    (none)))

(deftype oot-work (structure)
  "Stack workspace for overlap-test: the closest point followed by the query sphere's
   integer-coordinate bounding box."
  ((intersect vector :inline)
   (sphere-bbox4w bounding-box4w :inline)))

(defmethod overlap-test ((this collide-mesh) (cache-tris collide-mesh-cache-tri) (query-sphere vector))
  "Return true when the sphere encoded by center.xyz and radius.w strictly overlaps
   any cached triangle. Box contact survives the broad phase, but exact distance equal to the
   radius is not an overlap."
  (local-vars
    (zero uint128)
    (sphere-min uint128)
    (sphere-max uint128)
    (max-outside-mask uint128)
    (outside-mask uint128)
    (packed-outside-mask uint128)
    (distance-test uint)
    (tri-min uint128)
    (min-outside-mask uint128))
  (rlet ((acc :class vf)
         (vf0 :class vf)
         (vf1 :class vf)
         (vf2 :class vf)
         (vf3 :class vf)
         (vf4 :class vf)
         (vf5 :class vf)
         (vf6 :class vf))
    (init-vf0-vector)
    (set! zero (the-as uint128 0))
    (let ((test-work (new 'stack-no-clear 'oot-work))
          (cache-tri cache-tris))
      (.lvf vf2 (&-> query-sphere quad))
      (let ((triangles-left (-> this num-tris)))
        (.sub.w.vf vf5 vf2 vf2)
        (.add.w.vf vf6 vf2 vf2)
        (.ftoi.vf vf5 vf5)
        (.ftoi.vf vf6 vf6)
        (.mov sphere-min vf5)
        (.svf (&-> test-work sphere-bbox4w min quad) vf5)
        (.mov sphere-max vf6)
        (.svf (&-> test-work sphere-bbox4w max quad) vf6)
        (label cfg-1)
        (b! (zero? triangles-left) cfg-7 :delay (set! tri-min (-> cache-tri bbox4w min quad)))
        (+! triangles-left -1))
      ;; Packed signed comparisons reject only a separating integer AABB axis, so face contact
      ;; proceeds to the exact closest-point test.
      (let ((tri-max (-> cache-tri bbox4w max quad)))
        (.pcgtw min-outside-mask tri-min sphere-max)
        (nop!)
        (.pcgtw max-outside-mask sphere-min tri-max))
      (nop!)
      (.por outside-mask min-outside-mask max-outside-mask)
      (nop!)
      (.ppach packed-outside-mask zero outside-mask)
      (nop!)
      (let ((outside? (shl (the-as int packed-outside-mask) 16)))
        (nop!)
        (b! (nonzero? outside?) cfg-1 :likely-delay (set! cache-tri (&+ cache-tri 96))))
      (closest-pt-in-triangle (-> test-work intersect)
                              query-sphere
                              (the-as matrix (-> cache-tri vertex))
                              (-> cache-tri normal))
      (.lvf vf1 (&-> test-work intersect quad))
      (.lvf vf2 (&-> query-sphere quad))
      (set! sphere-min (-> test-work sphere-bbox4w min quad))
      (set! sphere-max (-> test-work sphere-bbox4w max quad))
      (.sub.vf vf3 vf2 vf1)
      (.mul.w.vf.w vf4 vf2 vf2)
      (.mul.vf vf3 vf3 vf3)
      (.mul.x.vf.w acc vf0 vf3)
      (.add.mul.y.vf.w acc vf0 vf3 acc)
      (.add.mul.z.vf.w vf3 vf0 vf3 acc)
      (.sub.w.vf.w vf3 vf3 vf4)
      (.add.w.vf.y vf3 vf0 vf3)
      ;; Keep the bits in an integer register: a negative sign bit means squared center distance is
      ;; strictly smaller than radius squared. Equality is not an overlap.
      (.mov distance-test vf3)
      (b! (>= (the-as int distance-test) 0) cfg-1 :delay (set! cache-tri (&+ cache-tri 96))))
    (let ((overlaps? #t))
      (b! #t cfg-8 :delay (nop!))
      (the-as none 0)
      (label cfg-7)
      (set! overlaps? #f)
      (label cfg-8)
      overlaps?)))

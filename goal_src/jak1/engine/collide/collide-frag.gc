;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/level/bsp.gc")
(require "engine/collide/collide-frag-h.gc")

;; This file contains the drawable-tree implementation for collide-fragment

;; DECOMP BEGINS

(defmethod login ((this drawable-tree-collide-fragment))
  "No linked resources need initialization; return this collision tree unchanged."
  this)

(defmethod draw ((this drawable-tree-collide-fragment) (submitted-tree drawable-tree-collide-fragment) (frame display-frame))
  "When collision display is enabled, submit every child inline array for the current frame.
   Submitted-tree is part of the drawable interface and is unused."
  (when *display-render-collision*
    (dotimes (i (-> this length))
      (draw (-> this data i) (-> this data i) frame)))
  0
  (none))

(defmethod unpack-vis ((this drawable-tree-collide-fragment) (destination (pointer int8)) (source (pointer int8)))
  "Consume no visibility data, leave destination unchanged, and return source unchanged."
  source)

(defmethod collide-with-box ((this drawable-tree-collide-fragment) (count int) (result collide-list))
  "Ignore count and forward the active collision-box query across every inline array in this
   tree, appending matches to result."
  (collide-with-box (-> this data-override) (-> this length) result)
  0
  (none))

(defmethod collide-y-probe ((this drawable-tree-collide-fragment) (count int) (result collide-list))
  "Ignore count and forward the active vertical-probe query across every inline array in this
   tree, appending matches to result."
  (collide-y-probe (-> this data-override) (-> this length) result)
  0
  (none))

(defmethod collide-ray ((this drawable-tree-collide-fragment) (count int) (result collide-list))
  "Ignore count and forward the active swept-sphere ray query across every inline array in this
   tree, appending matches to result."
  (collide-ray (-> this data-override) (-> this length) result)
  0
  (none))

(defmethod mem-usage ((this collide-fragment) (usage memory-usage-block) (flags mem-usage-flags))
  "Account for the fragment and mesh headers, packed polygon stream and PAT indices, and packed
   vertex quadwords. Bit 0 of flags selects the prototype categories instead of the ordinary
   background-collision categories."
  (let ((category (if (logtest? flags (mem-usage-flags prototype-data)) (mem-usage-id collide-fragment-1) (mem-usage-id collide-fragment-0)))
        (mesh (-> this mesh)))
    (set! (-> usage data category name) (symbol->string 'collide-fragment))
    (+! (-> usage data category count) 1)
    (let ((combined-header-bytes (+ (asize-of this) (asize-of mesh))))
      (+! (-> usage data category used) combined-header-bytes)
      (+! (-> usage data category total) (logand -16 (+ combined-header-bytes 15))))
    (set! (-> usage data (+ category 1) name) "collision-poly")
    (+! (-> usage data (+ category 1) count) (-> mesh poly-count))
    (let ((polygon-data-bytes (+ (-> mesh strip-data-len) (-> mesh poly-count))))
      (+! (-> usage data (+ category 1) used) polygon-data-bytes)
      (+! (-> usage data (+ category 1) total) polygon-data-bytes))
    (set! (-> usage data (+ category 2) name) "collision-vertex")
    (+! (-> usage data (+ category 2) count) (-> mesh vertex-count))
    (let ((vertex-data-bytes (* (-> mesh vertex-data-qwc) 16)))
      (+! (-> usage data (+ category 2) used) vertex-data-bytes)
      (let ((new-vertex-total (+ (-> usage data (+ category 2) total) vertex-data-bytes)))
        (set! (-> usage data (+ category 2) total) new-vertex-total)
        (the-as collide-fragment new-vertex-total)))))

(defmethod login ((this drawable-inline-array-collide-fragment))
  "No linked resources need initialization; return this inline array unchanged."
  this)

(defmethod draw ((this collide-fragment) (submitted-fragment collide-fragment) (frame display-frame))
  "Leave this collision fragment invisible. The disabled debug block can draw its bounds."
  ;; Enable this block to display the bounding box of a nearby fragment.
  ;; (when (< (-> this bsphere w) (meters 22.))
  ;;   (format 0 "sp: ~m : ~D~%" (-> this bsphere w) (-> this mesh poly-count))
  ;;   (let ((mins (vector-copy! (new-stack-vector0) (-> this bsphere)))
  ;;         (maxs (vector-copy! (new-stack-vector0) (-> this bsphere))))
  ;;     (dotimes (i 3)
  ;;       (-! (-> mins data i) (-> this bsphere w))
  ;;       (+! (-> maxs data i) (-> this bsphere w)))
  ;;     (add-debug-box #t (bucket-id debug) mins maxs (new 'static 'rgba :r #x80 :a #x80))
  ;;     (add-debug-sphere
  ;;       #t
  ;;       (bucket-id debug)
  ;;       (-> this bsphere)
  ;;       (-> this bsphere w)
  ;;       (new 'static 'rgba :r #x80 :a #x80))))
  ;; (add-debug-point #t (bucket-id debug) (-> this bsphere))
  0
  (none))

(defmethod draw ((this drawable-inline-array-collide-fragment) (submitted-array drawable-inline-array-collide-fragment) (frame display-frame))
  "Sphere-cull every collision fragment and invoke draw on each survivor. Submitted-array is
   part of the drawable interface and is unused."
  (dotimes (i (-> this length))
    (let ((fragment (-> this data i))) (if (sphere-cull (-> fragment bsphere)) (draw fragment fragment frame))))
  0
  (none))

(defmethod collide-with-box ((this drawable-inline-array-collide-fragment) (count int) (result collide-list))
  "Ignore count and test every collision fragment in this inline array against the active box,
   appending matches to result."
  (collide-with-box (the-as collide-fragment (-> this data)) (-> this length) result)
  0
  (none))

(defmethod collide-y-probe ((this drawable-inline-array-collide-fragment) (count int) (result collide-list))
  "Ignore count and test every collision fragment in this inline array against the active
   vertical probe, appending matches to result."
  (collide-y-probe (the-as collide-fragment (-> this data)) (-> this length) result)
  0
  (none))

(defmethod collide-ray ((this drawable-inline-array-collide-fragment) (count int) (result collide-list))
  "Ignore count and test every collision fragment in this inline array against the active
   swept-sphere ray, appending matches to result."
  (collide-ray (the-as collide-fragment (-> this data)) (-> this length) result)
  0
  (none))

(defmethod mem-usage ((this drawable-inline-array-collide-fragment) (usage memory-usage-block) (flags mem-usage-flags))
  "Account for the inline-array header and delegate memory accounting to every collision
   fragment."
  (mem-usage-add-symbol! usage drawable-group 1 32)
  (dotimes (i (-> this length))
    (mem-usage (-> this data i) usage flags))
  this)

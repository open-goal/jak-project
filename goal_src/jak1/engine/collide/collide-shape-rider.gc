;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/collide/collide-shape.gc")

;; DECOMP BEGINS

(defmethod on-platform ((this collide-shape) (other-shape collide-shape) (overlap-result collide-overlap-result))
  "Test whether other-shape is supported by this platform within 122.88 game units
   (three centimeters). Fill overlap-result with the closest supporting primitive pair and return
   whether one was found."
  (let ((result-data overlap-result))
    (set! (-> result-data best-dist) 0.0)
    (set! (-> result-data best-from-prim) #f)
    (set! (-> result-data best-to-prim) #f))
  (set! (-> overlap-result best-dist) 122.88)
  (let ((platform-root (-> this root-prim))
        (other-root (-> other-shape root-prim)))
    (when (and (logtest? (-> platform-root collide-with) (-> other-root prim-core collide-as))
               (logtest? (-> platform-root prim-core action) (collide-action rider-plat-sticky))
               (logtest? (-> other-root prim-core action) (collide-action rider-target)))
      (let ((root-separation (- (- (vector-vector-distance (-> platform-root prim-core world-sphere) (-> other-root prim-core world-sphere))
                                   (-> platform-root prim-core world-sphere w))
                                (-> other-root prim-core world-sphere w))))
        (if (< root-separation 122.88) (on-platform-test platform-root other-root overlap-result root-separation)))))
  (< (-> overlap-result best-dist) 122.88))

(defmethod on-platform-test ((this collide-shape-prim) (other-prim collide-shape-prim) (overlap-result collide-overlap-result) (root-separation float))
  "Recursively test this platform primitive against other-prim and retain the
   closest supporting contact below the 122.88-unit (three-centimeter) tolerance in overlap-result."
  (format 0 "ERROR: collide-shape-prim::on-platform-test was called illegally!~%")
  (none))

(defmethod on-platform-test ((this collide-shape-prim-group) (other-prim collide-shape-prim) (overlap-result collide-overlap-result) (root-separation float))
  "Recursively test this platform primitive against other-prim and retain the
   closest supporting contact below the 122.88-unit (three-centimeter) tolerance in overlap-result."
  (let ((other-as (-> other-prim prim-core collide-as)))
    (dotimes (i (-> this num-prims))
      (let ((child-prim (-> this prims i)))
        (when (and (logtest? (-> child-prim collide-with) other-as)
                   (logtest? (-> child-prim prim-core action) (collide-action rider-plat-sticky)))
          (let ((separation (- (- (vector-vector-distance (-> child-prim prim-core world-sphere) (-> other-prim prim-core world-sphere))
                                  (-> child-prim prim-core world-sphere w))
                               (-> other-prim prim-core world-sphere w))))
            (if (< separation 122.88) (on-platform-test child-prim other-prim overlap-result separation)))))))
  (none))

(defmethod on-platform-test ((this collide-shape-prim-mesh) (other-prim collide-shape-prim) (overlap-result collide-overlap-result) (root-separation float))
  "Recursively test this platform primitive against other-prim and retain the
   closest supporting contact below the 122.88-unit (three-centimeter) tolerance in overlap-result."
  (case (-> other-prim type)
    ((collide-shape-prim-group)
     (let ((platform-with (-> this collide-with)))
       (dotimes (i (-> (the-as collide-shape-prim-group other-prim) num-prims))
         (let ((child-prim (-> (the-as collide-shape-prim-group other-prim) prims i)))
           (when (and (logtest? platform-with (-> child-prim prim-core collide-as))
                      (logtest? (-> child-prim prim-core action) (collide-action rider-target)))
             (let ((separation (- (- (vector-vector-distance (-> this prim-core world-sphere) (-> child-prim prim-core world-sphere))
                                     (-> this prim-core world-sphere w))
                                  (-> child-prim prim-core world-sphere w))))
               (if (< separation 122.88) (on-platform-test this child-prim overlap-result separation))))))))
    ((collide-shape-prim-sphere)
     (let ((platform-mesh (-> this mesh)))
       (when platform-mesh
         (let ((mesh-cache *collide-mesh-cache*))
           (when (!= (-> this mesh-cache-id) (-> mesh-cache id))
             (let ((cache-tris (allocate! mesh-cache (* 96 (-> platform-mesh num-tris)))))
               (cond
                 (cache-tris
                  (set! (-> this mesh-cache-tris) (the-as (inline-array collide-mesh-cache-tri) cache-tris))
                  (set! (-> this mesh-cache-id) (-> mesh-cache id))
                  (populate-cache! platform-mesh
                                   (-> this mesh-cache-tris 0)
                                   (-> this cshape process node-list data (-> this transform-index) bone transform)))
                 (else (return #f))))))
         (let* ((tri-result (new 'stack-no-clear 'collide-tri-result))
                (separation (sphere-on-platform-test platform-mesh
                                                     (-> this mesh-cache-tris 0)
                                                     tri-result
                                                     (-> other-prim prim-core world-sphere)
                                                     (-> overlap-result best-dist))))
           (when (< separation (-> overlap-result best-dist))
             (set! (-> overlap-result best-dist) separation)
             (set! (-> overlap-result best-from-prim) this)
             (set! (-> overlap-result best-to-prim) other-prim)
             (set! (-> overlap-result best-from-tri vertex 0 quad) (-> tri-result vertex 0 quad))
             (set! (-> overlap-result best-from-tri vertex 1 quad) (-> tri-result vertex 1 quad))
             (set! (-> overlap-result best-from-tri vertex 2 quad) (-> tri-result vertex 2 quad))
             (set! (-> overlap-result best-from-tri intersect quad) (-> tri-result intersect quad))
             (set! (-> overlap-result best-from-tri normal quad) (-> tri-result normal quad))
             (set! (-> overlap-result best-from-tri pat) (-> tri-result pat))))))))
  (none))

(defmethod add-rider! ((this collide-sticky-rider-group) (rider-process process-drawable))
  "Append rider-process, clear its sticky primitive, and return the new rider record.
   Print an error and return false when the fixed allocation is full."
  (let ((rider-entry (the-as collide-sticky-rider #f)))
    (cond
      ((< (-> this num-riders) (-> this allocated-riders))
       (set! rider-entry (-> this rider (-> this num-riders)))
       (+! (-> this num-riders) 1)
       (let ((entry-data rider-entry))
         (set! (-> entry-data rider-handle) (the-as handle rider-process))
         (set! (-> entry-data sticky-prim) #f)))
      (else (format 0 "ERROR: Exeeded max number of riders!~%")))
    rider-entry))

(defmethod detect-riders! ((this collide-shape))
  "Rebuild the rider list from the foreground collision lists selected by this
   shape's collide-with mask. For each compatible shape standing on a sticky platform primitive,
   save that primitive's angle and the rider position in its bone-local space, then send the platform
   a ridden event. Saving the local point lets later platform translation and rotation carry the
   rider."
  (let ((rider-group (-> this riders)))
    (when rider-group
      (let* ((mesh-cache *collide-mesh-cache*)
             (current-cache-id (-> mesh-cache id)))
        (set! (-> mesh-cache used-size) (the-as uint 0))
        (let ((next-cache-id (the-as int (+ current-cache-id 1))))
          (b! (zero? (the-as uint next-cache-id)) cfg-3 :likely-delay (set! next-cache-id 1))
          (label cfg-3)
          (set! (-> mesh-cache id) (the-as uint next-cache-id))))
      (set! (-> rider-group num-riders) 0)
      0
      (let ((with-mask (-> this root-prim collide-with)))
        (when (logtest? with-mask (collide-kind target))
          (let ((node (-> *collide-player-list* alive-list next0)))
            *collide-player-list*
            (let ((next-node (-> node next0)))
              (while (!= node (-> *collide-player-list* alive-list-end))
                (let* ((candidate-shape (the-as object (-> (the-as connection node) param1)))
                       (candidate-root (-> (the-as collide-shape candidate-shape) root-prim)))
                  (when (logtest? with-mask (-> candidate-root prim-core collide-as))
                    (when (and (logtest? (-> candidate-root prim-core action) (collide-action rider-target))
                               (!= (-> this process) (-> (the-as collide-shape candidate-shape) process)))
                      (let ((overlap-result (new 'stack-no-clear 'collide-overlap-result)))
                        (when (on-platform this (the-as collide-shape candidate-shape) overlap-result)
                          (let ((rider-entry (add-rider! rider-group (the-as process-drawable (process->handle (-> (the-as collide-shape candidate-shape) process))))))
                            (when rider-entry
                              (let ((platform-prim (-> overlap-result best-from-prim)))
                                (set! (-> rider-entry sticky-prim) platform-prim)
                                (let ((bone-transform (-> (the-as process-drawable (-> this process)) node-list data (-> platform-prim transform-index) bone transform)))
                                  (set! (-> rider-entry prim-ry) (matrix-y-angle bone-transform))
                                  (let ((inverse-transform (new 'stack-no-clear 'matrix)))
                                    (matrix-4x4-inverse! inverse-transform bone-transform)
                                    (vector-matrix*! (-> rider-entry rider-local-pos) (-> (the-as collide-shape candidate-shape) trans) inverse-transform))))
                              (send-event (-> this process) 'ridden rider-entry)))
                          (set! with-mask (-> this root-prim collide-with)))))))
                (set! node next-node)
                *collide-player-list*
                (set! next-node (-> next-node next0))))))
        (when (logtest? with-mask (collide-kind cak-1 cak-2 cak-3))
          (when (logtest? with-mask (collide-kind cak-1))
            (let ((node (-> *collide-hit-by-player-list* alive-list next0)))
              *collide-hit-by-player-list*
              (let ((next-node (-> node next0)))
                (while (!= node (-> *collide-hit-by-player-list* alive-list-end))
                  (let* ((candidate-shape (the-as object (-> (the-as connection node) param1)))
                         (candidate-root (-> (the-as collide-shape candidate-shape) root-prim)))
                    (when (logtest? with-mask (-> candidate-root prim-core collide-as))
                      (when (and (logtest? (-> candidate-root prim-core action) (collide-action rider-target))
                                 (!= (-> this process) (-> (the-as collide-shape candidate-shape) process)))
                        (let ((overlap-result (new 'stack-no-clear 'collide-overlap-result)))
                          (when (on-platform this (the-as collide-shape candidate-shape) overlap-result)
                            (let ((rider-entry (add-rider! rider-group (the-as process-drawable (process->handle (-> (the-as collide-shape candidate-shape) process))))))
                              (when rider-entry
                                (let ((platform-prim (-> overlap-result best-from-prim)))
                                  (set! (-> rider-entry sticky-prim) platform-prim)
                                  (let ((bone-transform (-> this process node-list data (-> platform-prim transform-index) bone transform)))
                                    (set! (-> rider-entry prim-ry) (matrix-y-angle bone-transform))
                                    (let ((inverse-transform (new 'stack-no-clear 'matrix)))
                                      (matrix-4x4-inverse! inverse-transform bone-transform)
                                      (vector-matrix*! (-> rider-entry rider-local-pos) (-> (the-as collide-shape candidate-shape) trans) inverse-transform))))
                                (send-event (-> this process) 'ridden rider-entry)))
                            (set! with-mask (-> this root-prim collide-with)))))))
                  (set! node next-node)
                  *collide-hit-by-player-list*
                  (set! next-node (-> next-node next0))))))
          (when (logtest? with-mask (collide-kind cak-2))
            (let ((node (-> *collide-usually-hit-by-player-list* alive-list next0)))
              *collide-usually-hit-by-player-list*
              (let ((next-node (-> node next0)))
                (while (!= node (-> *collide-usually-hit-by-player-list* alive-list-end))
                  (let* ((candidate-shape (the-as object (-> (the-as connection node) param1)))
                         (candidate-root (-> (the-as collide-shape candidate-shape) root-prim)))
                    (when (logtest? with-mask (-> candidate-root prim-core collide-as))
                      (when (and (logtest? (-> candidate-root prim-core action) (collide-action rider-target))
                                 (!= (-> this process) (-> (the-as collide-shape candidate-shape) process)))
                        (let ((overlap-result (new 'stack-no-clear 'collide-overlap-result)))
                          (when (on-platform this (the-as collide-shape candidate-shape) overlap-result)
                            (let ((rider-entry (add-rider! rider-group (the-as process-drawable (process->handle (-> (the-as collide-shape candidate-shape) process))))))
                              (when rider-entry
                                (let ((platform-prim (-> overlap-result best-from-prim)))
                                  (set! (-> rider-entry sticky-prim) platform-prim)
                                  (let ((bone-transform (-> this process node-list data (-> platform-prim transform-index) bone transform)))
                                    (set! (-> rider-entry prim-ry) (matrix-y-angle bone-transform))
                                    (let ((inverse-transform (new 'stack-no-clear 'matrix)))
                                      (matrix-4x4-inverse! inverse-transform bone-transform)
                                      (vector-matrix*! (-> rider-entry rider-local-pos) (-> (the-as collide-shape candidate-shape) trans) inverse-transform))))
                                (send-event (-> this process) 'ridden rider-entry)))
                            (set! with-mask (-> this root-prim collide-with)))))))
                  (set! node next-node)
                  *collide-usually-hit-by-player-list*
                  (set! next-node (-> next-node next0))))))
          (when (logtest? with-mask (collide-kind cak-3))
            (let ((node (-> *collide-hit-by-others-list* alive-list next0)))
              *collide-hit-by-others-list*
              (let ((next-node (-> node next0)))
                (while (!= node (-> *collide-hit-by-others-list* alive-list-end))
                  (let* ((candidate-shape (the-as object (-> (the-as connection node) param1)))
                         (candidate-root (-> (the-as collide-shape candidate-shape) root-prim)))
                    (when (logtest? with-mask (-> candidate-root prim-core collide-as))
                      (when (and (logtest? (-> candidate-root prim-core action) (collide-action rider-target))
                                 (!= (-> this process) (-> (the-as collide-shape candidate-shape) process)))
                        (let ((overlap-result (new 'stack-no-clear 'collide-overlap-result)))
                          (when (on-platform this (the-as collide-shape candidate-shape) overlap-result)
                            (let ((rider-entry (add-rider! rider-group (the-as process-drawable (process->handle (-> (the-as collide-shape candidate-shape) process))))))
                              (when rider-entry
                                (let ((platform-prim (-> overlap-result best-from-prim)))
                                  (set! (-> rider-entry sticky-prim) platform-prim)
                                  (let ((bone-transform (-> this process node-list data (-> platform-prim transform-index) bone transform)))
                                    (set! (-> rider-entry prim-ry) (matrix-y-angle bone-transform))
                                    (let ((inverse-transform (new 'stack-no-clear 'matrix)))
                                      (matrix-4x4-inverse! inverse-transform bone-transform)
                                      (vector-matrix*! (-> rider-entry rider-local-pos) (-> (the-as collide-shape candidate-shape) trans) inverse-transform))))
                                (send-event (-> this process) 'ridden rider-entry)))
                            (set! with-mask (-> this root-prim collide-with)))))))
                  (set! node next-node)
                  *collide-hit-by-others-list*
                  (set! next-node (-> next-node next0)))))
            #f))))))

(defmethod pull-riders! ((this collide-shape))
  "For every valid sticky rider, transform its saved bone-local point through the
   supporting primitive's current bone transform. Compute the change in that bone's Y angle, then move
   the rider to the resulting world-space point so it inherits both translation and rotation."
  (let ((rider-group (-> this riders)))
    (when rider-group
      (let ((pull-info (new 'stack-no-clear 'pull-rider-info)))
        (countdown (i (-> rider-group num-riders))
          (let* ((rider-entry (-> rider-group rider i))
                 (handle-value (-> rider-entry rider-handle)))
            (when (handle->process handle-value)
              (set! (-> pull-info rider) rider-entry)
              (set! (-> pull-info rider-cshape)
                    (the-as collide-shape-moving (-> (the-as process-drawable (-> handle-value process 0)) root)))
              (let ((sticky-prim (-> rider-entry sticky-prim)))
                (when sticky-prim
                  (let ((bone-transform (-> this process node-list data (-> sticky-prim transform-index) bone transform)))
                    (let ((rider-destination (-> pull-info rider-dest)))
                      (vector-matrix*! rider-destination (-> rider-entry rider-local-pos) bone-transform)
                      (vector-float*! rider-destination rider-destination (/ 1.0 (-> rider-destination w))))
                    (set! (-> pull-info rider-delta-ry) (deg- (matrix-y-angle bone-transform) (-> pull-info rider prim-ry))))
                  (pull-rider! this pull-info)))))))
      #f)))

(defmethod pull-rider! ((this collide-shape) (pull-info pull-rider-info))
  "Move one rider to its transformed platform-local destination. A solid platform
   fills the rider's collision cache out to two meters beyond the required displacement, converts that
   displacement to a frame velocity, and uses the rider's collision integration so carried riders
   still collide with the world; a non-solid platform translates the rider directly. For moving riders,
   save the actual resulting velocity for momentum after stepping off and update the sticky timestamp.
   Send the platform's angle change as a rotate-y-angle event."
  (local-vars (frames-per-second-bits int))
  (rlet ((vf0 :class vf)
         (vf1 :class vf)
         (vf2 :class vf))
    (init-vf0-vector)
    (let ((rider-shape (-> pull-info rider-cshape)))
      (let ((move-delta (new 'stack-no-clear 'vector))
            (old-position (new 'stack-no-clear 'vector)))
        (set! (-> old-position quad) (-> rider-shape trans quad))
        (vector-! move-delta (-> pull-info rider-dest) old-position)
        (cond
          ((logtest? (-> this root-prim prim-core action) (collide-action rider-plat))
           (let ((saved-platform-collide-as (-> this root-prim prim-core collide-as)))
             (set! (-> this root-prim prim-core collide-as) (collide-kind))
             (fill-cache-for-shape! rider-shape (+ 8192.0 (vector-length move-delta)) (-> rider-shape root-prim collide-with))
             (set! (-> this root-prim prim-core collide-as) saved-platform-collide-as))
           (let ((rider-velocity (new 'stack-no-clear 'vector)))
             (set! (-> rider-velocity quad) (-> move-delta quad))
             (let ((velocity-output rider-velocity))
               (.lvf vf1 (&-> rider-velocity quad))
               (let ((frames-per-second (-> *display* frames-per-second))) (.mov frames-per-second-bits frames-per-second))
               (.mov vf2 frames-per-second-bits)
               (.mov.vf.w vf1 vf0)
               (.mul.x.vf.xyz vf1 vf1 vf2)
               (.svf (&-> velocity-output quad) vf1))
             (cond
               ((type-type? (-> rider-shape type) collide-shape-moving)
                (let ((saved-status (-> rider-shape status)))
                  (integrate-and-collide! rider-shape rider-velocity)
                  (set! (-> rider-shape status) saved-status)))
               (else (integrate-and-collide! rider-shape rider-velocity)))))
          (else (move-by-vector! rider-shape move-delta)))
        (when (type-type? (-> rider-shape type) collide-shape-moving)
          (let ((actual-move (new 'stack-no-clear 'vector)))
            (vector-! actual-move (-> rider-shape trans) old-position)
            (vector-float*! (-> rider-shape rider-last-move) actual-move (-> *display* frames-per-second)))
          (set-time! (-> rider-shape rider-time))))
      (let ((angle-delta (-> pull-info rider-delta-ry)))
        (if (!= angle-delta 0.0) (send-event (-> rider-shape process) 'rotate-y-angle angle-delta))))
    (none)))

(defmethod alloc-riders ((this collide-shape) (rider-count int))
  "Allocate room for rider-count sticky riders. Report an error and preserve the
   existing allocation when called more than once."
  (if (-> this riders)
    (format 0 "ERROR: colide-shape::alloc-riders is being called multiple times!~%")
    (set! (-> this riders) (new 'process 'collide-sticky-rider-group rider-count)))
  (none))

;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/collide/collide-touch-h.gc")
(require "kernel/gstate.gc")
(require "engine/target/target-h.gc")
(require "engine/collide/collide-shape-h.gc")
(require "engine/collide/collide-mesh-h.gc")

;; DECOMP BEGINS

;;;;;;;;;;;;;;;;;;;;;
;; Touching List
;;;;;;;;;;;;;;;;;;;;;

;; Collision resolution can predict several contacts while deciding how far an object will actually
;; move. The touching list groups those primitive contacts by shape pair, discards predictions beyond
;; the chosen step, and keeps the confirmed pairs for gameplay queries and event delivery. A primitive
;; entry can also snapshot the triangle result when the contact came from a mesh.

;;;;;;;;;;;;;;;;;;;;
;; Entry Pool
;;;;;;;;;;;;;;;;;;;;

;; Primitive-pair nodes come from one global fixed pool.

(defmethod get-free-node-count ((this touching-prims-entry-pool))
  "Count the entries currently available in the free list."
  (let ((free-count 0))
    (let ((node (-> this head))) (while node (+! free-count 1) (set! node (-> node next)) (nop!) (nop!) (nop!)))
    free-count))

(defmethod alloc-node ((this touching-prims-entry-pool))
  "Remove and return the first entry in the free list, or #f when the pool is empty."
  (let ((node (-> this head)))
    (cond
      (node
       (let ((next-node (-> node next))) (set! (-> this head) next-node) (if next-node (set! (-> next-node prev) #f)))
       (set! (-> node allocated?) #t)
       (set! (-> node next) #f)
       (set! (-> node prev) #f))
      (else (format 0 "ERROR: touching-prims-entry-pool::alloc-node() failed!~%")))
    node))

(defmethod free-node ((this touching-prims-entry-pool) (node touching-prims-entry))
  "Return an allocated entry to the front of the free list. Releasing an already-free
   entry has no effect."
  (when (-> node allocated?)
    (set! (-> node allocated?) #f)
    (let ((old-head (-> this head)))
      (set! (-> node next) old-head)
      (set! (-> node prev) #f)
      (set! (-> this head) node)
      (when old-head
        (set! (-> old-head prev) node)
        node))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Shapes Entry
;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; A shape entry owns every touching primitive pair between the same two shapes.

(defmethod free-touching-prims-list ((this touching-shapes-entry))
  "Return every primitive pair in this shape entry to the shared pool
   and mark the shape entry unused."
  (when (-> this cshape1)
    (set! (-> this cshape1) #f)
    (let ((node (-> this head)))
      (when node
        (set! (-> this head) #f)
        (let ((pool *touching-prims-entry-pool*))
          (while node
            (let ((node-to-free node)) (set! node (-> node-to-free next)) (free-node pool node-to-free))))
        #f))))

;;;;;;;;;;;;;;;;;;;;;;
;; Touching List
;;;;;;;;;;;;;;;;;;;;;;

;; A touching list holds at most TOUCHING_LIST_LENGTH shape pairs.

(defmethod free-all-prim-nodes ((this touching-list))
  "Return every primitive-pair entry to the shared pool and empty this list."
  (let ((shape-entry (the-as touching-shapes-entry (-> this touching-shapes))))
    (countdown (entries-left (-> this num-touching-shapes))
      (free-touching-prims-list shape-entry)
      (&+! shape-entry 16)))
  (set! (-> this num-touching-shapes) 0)
  (set! (-> this resolve-u) 0)
  0
  (none))

(defmethod get-shapes-entry ((this touching-list) (shape-a collide-shape) (shape-b collide-shape))
  "Return the order-independent entry for shape-a and shape-b, reusing an empty
   slot or appending one when necessary. Return #f when all 32 slots are occupied."
  (let ((candidate (the-as touching-shapes-entry (-> this touching-shapes))))
    (let ((free-entry (the-as touching-shapes-entry #f)))
      (countdown (entries-left (-> this num-touching-shapes))
        (let ((first-shape (-> candidate cshape1)))
          (set! free-entry
                (cond
                  (first-shape
                   (if (or (and (= first-shape shape-a) (= (-> candidate cshape2) shape-b))
                           (and (= first-shape shape-b) (= (-> candidate cshape2) shape-a)))
                     (return candidate))
                   free-entry)
                  (else candidate))))
        (&+! candidate 16))
      (cond
        (free-entry (set! candidate free-entry))
        (else
         (when (>= (-> this num-touching-shapes) TOUCHING_LIST_LENGTH)
           (format 0 "ERROR: touching-list::get-shapes-entry() failed!~%")
           (return (the-as touching-shapes-entry #f)))
         (+! (-> this num-touching-shapes) 1))))
    (set! (-> candidate cshape1) shape-a)
    (set! (-> candidate cshape2) shape-b)
    (set! (-> candidate head) #f)
    (set! (-> candidate resolve-u) 1)
    (set! (-> this resolve-u) 1)
    (the-as touching-shapes-entry candidate)))

(deftype add-prims-touching-work (structure)
  "Stack workspace holding the optional triangle results while a touching-primitive pair is found
   or allocated."
  ((tri1 collide-tri-result)
   (tri2 collide-tri-result)))

;;;;;;;;;;;;;;;;;;;;;;;;;
;; Touching List Update
;;;;;;;;;;;;;;;;;;;;;;;;;

;; The collision solver predicts contacts for its proposed movement, chooses the earliest allowed
;; step, resolves that contact, and repeats with the remaining movement. add-touching-prims records
;; those predictions; update-from-step-size confirms only the contacts reached by the chosen step.

(defmethod add-touching-prims ((this touching-list) (prim-a collide-shape-prim) (prim-b collide-shape-prim) (step-u float) (tri-a collide-tri-result) (tri-b collide-tri-result))
  "Record a contact between two primitives at step-u, copying the 84-byte
   field payload of either optional triangle result without its tail padding. A nonnegative step-u is
   prospective until update-from-step-size confirms it; a negative value is already overlapping. A
   repeated primitive pair keeps its original u and replaces only its triangle data when the new step-u
   is smaller."
  ;; Keep the optional triangle pointers live across shape lookup and node allocation.
  (let ((work (new 'stack-no-clear 'add-prims-touching-work)))
    (set! (-> work tri1) tri-a)
    (set! (-> work tri2) tri-b)
    (let ((shape-entry (get-shapes-entry this (-> prim-a cshape) (-> prim-b cshape))))
      (when shape-entry
        ;; Match the primitive order to the order selected for the owning shape entry.
        (when (= (-> shape-entry cshape1) (-> prim-b cshape))
          (let ((swap-prim prim-a)) (set! prim-a prim-b) (set! prim-b swap-prim)))
        (let ((node (-> shape-entry head)))
          (while node
            (when (and (= (-> node prim1 cprim) prim-a) (= (-> node prim2 cprim) prim-b))
              (when (< step-u (-> node u))
                ;; A nearer duplicate refreshes its triangle payload but leaves the first recorded u.
                (-> node u)
                (let ((stored-prim-a (-> node prim1))
                      (tri-a-result (-> work tri1)))
                  (cond
                    (tri-a-result
                     (set! (-> stored-prim-a has-tri?) #t)
                     (mem-copy! (the-as pointer (-> stored-prim-a tri)) (the-as pointer tri-a-result) 84))
                    (else (set! (-> stored-prim-a has-tri?) #f))))
                (let ((stored-prim-b (-> node prim2))
                      (tri-b-result (-> work tri2)))
                  (cond
                    (tri-b-result
                     (set! (-> stored-prim-b has-tri?) #t)
                     (mem-copy! (the-as pointer (-> stored-prim-b tri)) (the-as pointer tri-b-result) 84))
                    (else (set! (-> stored-prim-b has-tri?) #f)))))
              (return 0))
            (set! node (-> node next))))
        (let ((new-node (alloc-node *touching-prims-entry-pool*)))
          (when new-node
            (let ((old-head (-> shape-entry head)))
              (set! (-> new-node next) old-head)
              (set! (-> new-node prev) #f)
              (set! (-> shape-entry head) new-node)
              (if old-head (set! (-> old-head prev) new-node)))
            (set! (-> new-node u) step-u)
            ;; A nonnegative u still depends on how far the solver ultimately moves. Negative u
            ;; means the primitives already overlap and needs no later confirmation.
            (when (>= step-u 0.0)
              (set! (-> shape-entry resolve-u) 1)
              (set! (-> this resolve-u) 1))
            (let ((new-prim-a (-> new-node prim1))
                  (new-tri-a (-> work tri1)))
              (set! (-> new-prim-a cprim) prim-a)
              (cond
                (new-tri-a
                 (set! (-> new-prim-a has-tri?) #t)
                 (mem-copy! (the-as pointer (-> new-prim-a tri)) (the-as pointer new-tri-a) 84))
                (else (set! (-> new-prim-a has-tri?) #f))))
            (let ((new-prim-b (-> new-node prim2))
                  (new-tri-b (-> work tri2)))
              (set! (-> new-prim-b cprim) prim-b)
              (cond
                (new-tri-b
                 (set! (-> new-prim-b has-tri?) #t)
                 (mem-copy! (the-as pointer (-> new-prim-b tri)) (the-as pointer new-tri-b) 84))
                (else (set! (-> new-prim-b has-tri?) #f)))))))))
  0
  (none))

(defmethod update-from-step-size ((this touching-list) (chosen-step float))
  "Confirm prospective contacts whose u is no greater than chosen-step by
   setting their u to -1, and unlink contacts beyond the chosen step. Already-negative contacts remain
   confirmed."
  (when (nonzero? (-> this resolve-u))
    (set! (-> this resolve-u) 0)
    (let ((shape-entry (the-as touching-shapes-entry (-> this touching-shapes))))
      (countdown (entries-left (-> this num-touching-shapes))
        (when (nonzero? (-> shape-entry resolve-u))
          (set! (-> shape-entry resolve-u) 0)
          (when (-> shape-entry cshape1)
            (let ((node (-> shape-entry head)))
              (while node
                (let ((contact-u (-> node u)))
                  (set! node
                        (cond
                          ((>= contact-u 0.0)
                           (cond
                             ((>= chosen-step contact-u) (set! (-> node u) -1.0) (set! node (-> node next)))
                             (else
                              ;; Splice a prediction beyond the chosen movement out of both linked
                              ;; lists before returning its node to the shared pool.
                              (let ((node-to-free node))
                                (let ((next-node (-> node next)))
                                  (let ((prev-node (-> node prev)))
                                    (if prev-node (set! (-> prev-node next) next-node) (set! (-> shape-entry head) next-node))
                                    (if next-node (set! (-> next-node prev) prev-node)))
                                  (set! node next-node))
                                (free-node *touching-prims-entry-pool* node-to-free))))
                           node)
                          (else (-> node next)))))))
            (if (not (-> shape-entry head)) (set! (-> shape-entry cshape1) #f))))
        (&+! shape-entry 16))))
  0
  (none))

(defmethod send-events-for-touching-shapes ((this touching-list))
  "Send the configured self and other events for every retained
   shape pair. When the second shape belongs to target, swap the pair first so target receives events
   in the first-shape role. Pair traversal otherwise follows touching-list order with no event priority."
  ;; og:preserve-this
  ;; PC port: an event from one pair can delete a process referenced by a later pair. Snapshot handles
  ;; for every process before sending anything, then resolve each handle immediately before use.
  ;; The 64-element array holds two handles for every TOUCHING_LIST_LENGTH slot.
  (let ((handles (new 'stack-no-clear 'array 'handle 64)))
    (let ((entry (the-as touching-shapes-entry (-> this touching-shapes))))
      (countdown (i (-> this num-touching-shapes))
        (let ((shape-a (-> entry cshape1)))
          (when shape-a
            (let ((shape-b (-> entry cshape2)))
              ;; Keep target in the first role when exactly the second shape belongs to target.
              (when (= (-> shape-b process type) target)
                (swap! shape-a shape-b))
              (set! (-> handles (+ 0 (* 2 i))) (process->handle (-> shape-a process)))
              (set! (-> handles (+ 1 (* 2 i))) (process->handle (-> shape-b process))))))
        (set! entry (-> (the-as (inline-array touching-shapes-entry) entry) 1))))
    (let ((entry (the-as touching-shapes-entry (-> this touching-shapes))))
      (countdown (i (-> this num-touching-shapes))
        (let ((shape-a (-> entry cshape1)))
          (when shape-a
            (let ((shape-b (-> entry cshape2)))
              (when (= (-> shape-b process type) target)
                (swap! shape-a shape-b))
              (let ((shape-a-process (handle->process (-> handles (+ 0 (* 2 i)))))
                    (shape-b-process (handle->process (-> handles (+ 1 (* 2 i))))))
                (let ((shape-a-self-event (-> shape-a event-self)))
                  (if shape-a-self-event (send-event shape-a-process shape-a-self-event :from shape-b-process entry)))
                (let ((shape-a-other-event (-> shape-a event-other)))
                  (if shape-a-other-event (send-event shape-b-process shape-a-other-event :from shape-a-process entry)))
                (let ((shape-b-self-event (-> shape-b event-self)))
                  (if shape-b-self-event (send-event shape-b-process shape-b-self-event :from shape-a-process entry)))
                (let ((shape-b-other-event (-> shape-b event-other)))
                  (if shape-b-other-event (send-event shape-a-process shape-b-other-event :from shape-b-process entry)))))))
        (set! entry (-> (the-as (inline-array touching-shapes-entry) entry) 1)))))
  0
  (none))

(defmethod prims-touching? ((this touching-shapes-entry) (shape collide-shape-moving) (prim-id-mask uint))
  "Find a touching primitive belonging to shape whose primitive-id shares a bit
   with prim-id-mask. Return #f when no primitive matches or shape is not in this pair."
  (cond
    ((= (-> this cshape1) shape)
     (let ((node (-> this head)))
       (while node
         (if (logtest? (-> node prim1 cprim prim-id) prim-id-mask) (return node))
         (set! node (-> node next)))))
    ((= (-> this cshape2) shape)
     (let ((node (-> this head)))
       (while node
         (if (logtest? (-> node prim2 cprim prim-id) prim-id-mask) (return node))
         (set! node (-> node next)))))
    (else (format 0 "ERROR: touching-shapes-entry::prims-touching? : Bogus cshape value!~%")))
  (the-as touching-prims-entry #f))

(defmethod prims-touching-action? ((this touching-shapes-entry) (shape collide-shape) (required-actions collide-action) (rejected-actions collide-action))
  "Find a touching primitive belonging to shape whose action has at least
   one required-actions bit and no rejected-actions bit. Return #f when none matches or shape is not
   in this pair."
  (cond
    ((= (-> this cshape1) shape)
     (let ((node (-> this head)))
       (while node
         (let ((prim (-> node prim1 cprim)))
           (if (and (logtest? required-actions (-> prim prim-core action))
                    (not (logtest? rejected-actions (-> prim prim-core action))))
             (return node)))
         (set! node (-> node next)))))
    ((= (-> this cshape2) shape)
     (let ((node (-> this head)))
       (while node
         (let ((prim (-> node prim2 cprim)))
           (if (and (logtest? required-actions (-> prim prim-core action))
                    (not (logtest? rejected-actions (-> prim prim-core action))))
             (return node)))
         (set! node (-> node next)))))
    (else (format 0 "ERROR: touching-shapes-entry::prims-touching-action? : Bogus cshape value!~%")))
  (the-as touching-prims-entry #f))

(defmethod get-touched-shape ((this touching-shapes-entry) (shape collide-shape))
  "Return the other shape in this touching pair, or #f when shape is not in
   the pair."
  (cond
    ((= (-> this cshape1) shape) (return (-> this cshape2)))
    ((= (-> this cshape2) shape) (return (-> this cshape1))))
  (the-as collide-shape #f))

(defmethod get-touched-prim ((this touching-prims-entry) (shape collide-shape) (shape-entry touching-shapes-entry))
  "Return the primitive in this pair that belongs to shape, or #f when shape is
   not one of the owning shape entry's two shapes."
  (cond
    ((= (-> shape-entry cshape1) shape) (return (-> this prim1 cprim)))
    ((= (-> shape-entry cshape2) shape) (return (-> this prim2 cprim))))
  (the-as collide-shape-prim #f))

(defmethod get-touched-tri ((this touching-prims-entry) (shape collide-shape) (shape-entry touching-shapes-entry))
  "Return the recorded collision triangle for shape, or #f when shape is not in
   the pair or its primitive did not come from a triangle."
  (let ((triangle (the-as collide-tri-result #f)))
    (cond
      ((= (-> shape-entry cshape1) shape)
       (let ((prim (-> this prim1))) (if (-> prim has-tri?) (set! triangle (-> prim tri)))))
      ((= (-> shape-entry cshape2) shape)
       (let ((prim (-> this prim2))) (if (-> prim has-tri?) (set! triangle (-> prim tri))))))
    triangle))

(defmethod get-middle-of-bsphere-overlap ((this touching-prims-entry) (output vector))
  "Store the midpoint of the center-line segment shared by the
   primitives' overlapping world spheres in output. The spheres are assumed to overlap and to have
   distinct centers."
  (let* ((prim-a (-> this prim1 cprim))
         (prim-b (-> this prim2 cprim))
         (center-offset (vector-! (new 'stack-no-clear 'vector) (-> prim-b prim-core world-sphere) (-> prim-a prim-core world-sphere))))
    ;; The signed gap is negative by the overlap depth. Move from A's center by its radius plus half
    ;; that gap to reach the midpoint of the segment lying inside both spheres.
    (let ((signed-gap (- (- (vector-length center-offset) (-> prim-b prim-core world-sphere w)) (-> prim-a prim-core world-sphere w))))
      (vector-normalize! center-offset (+ (-> prim-a prim-core world-sphere w) (/ signed-gap 2))))
    (vector+! output center-offset (-> prim-a prim-core world-sphere)))
  output)

;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/collide/surface-h.gc")
(require "engine/collide/collide-edge-grab-h.gc")
(require "kernel/gstate.gc")
(require "engine/collide/collide-cache-h.gc")
(require "engine/target/target-h.gc")
(require "engine/collide/collide-shape-h.gc")
(require "engine/debug/debug.gc")

;; Edge grabs are built from the collision geometry around Jak rather than from the low-coverage
;; probes used by ordinary collision reaction. The search selects upward supporting triangles,
;; extracts exposed boundary edges, rates reachable hold points, and finally checks both hand
;; placement and the space needed for Jak's hanging and pull-up poses.
;;
;; The search direction follows the stick when it is deflected. A second search along Jak's
;; facing direction is always available, so a nearby ledge can still be found without stick input.

;; DECOMP BEGINS

(#unless PC_PORT
  (defconstant EDGE-GRAB-BASIC-BIAS 4)
  (defconstant EDGE-GRAB-HOLD-CAPACITY 32)
  (defconstant EDGE-GRAB-VERTEX-CAPACITY 64)
  (defconstant EDGE-GRAB-EDGE-CAPACITY 96)
  (defconstant EDGE-GRAB-TRIANGLE-CAPACITY 48)
  (defconstant EDGE-GRAB-PAT-MODE-MASK #x38)
  (defconstant EDGE-GRAB-PAT-OBSTACLE #x10)
  (defconstant EDGE-GRAB-PAT-SKIP-MASK #x5)
  (defconstant EDGE-GRAB-ENDLESSFALL-EVENT 2)
  ;; BASIC values point four bytes past their displayed base.
  (defconstant EDGE-GRAB-CACHE-NUM-TRIS (- (offset-of collide-cache num-tris) EDGE-GRAB-BASIC-BIAS))
  (defconstant EDGE-GRAB-CACHE-TRIS (- (offset-of collide-cache tris) EDGE-GRAB-BASIC-BIAS))
  (defconstant EDGE-GRAB-CSHAPE-TRANS (- (offset-of collide-shape trans) EDGE-GRAB-BASIC-BIAS)))

(defmethod find-edge-grabs! ((this target) (ccache collide-cache))
  "Fill a collision cache around the target, select upward supporting
   triangles and their exposed boundary edges, and search for a reachable hold first in the stick
   direction and then in the target's facing direction. Fill *edge-grab-info* and send edge-grab
   when hand placement and hanging clearance succeed."
  (rlet ((vf1 :class vf)
         (vf2 :class vf)
         (vf3 :class vf)
         (vf4 :class vf)
         (vf5 :class vf)
         (vf6 :class vf)
         (vf7 :class vf))
    (let ((work *collide-edge-work*))
      (set! (-> work num-verts) (the-as uint 0))
      (set! (-> work num-edges) (the-as uint 0))
      (set! (-> work num-tris) (the-as uint 0))
      (let ((ctrl (-> this control)))
        (set! (-> work ccache) ccache)
        (.lvf vf1 (&-> work local-cache-fill-box min quad))
        (.lvf vf2 (&-> work local-cache-fill-box max quad))
        (set! (-> work cshape) ctrl)
        (.lvf vf3 (&-> ctrl trans quad)))
      (.add.vf.xyz vf1 vf1 vf3)
      (.add.vf.xyz vf2 vf2 vf3)
      (.svf (&-> work cache-fill-box min quad) vf1)
      (.svf (&-> work cache-fill-box max quad) vf2)
      (.lvf vf4 (&-> work local-within-reach-box min quad))
      (.lvf vf5 (&-> work local-within-reach-box max quad))
      (.add.vf.xyz vf4 vf4 vf3)
      (.add.vf.xyz vf5 vf5 vf3)
      (.ftoi.vf vf6 vf4)
      (.ftoi.vf vf7 vf5)
      (.svf (&-> work within-reach-box min quad) vf4)
      (.svf (&-> work within-reach-box max quad) vf5)
      (.svf (&-> work within-reach-box4w min quad) vf6)
      (.svf (&-> work within-reach-box4w max quad) vf7)
      (fill-using-bounding-box ccache
                               (-> work cache-fill-box)
                               (-> this control root-prim collide-with)
                               this
                               (new 'static 'pat-surface :noentity #x1))
      (find-grabbable-tris! work)
      (when (nonzero? (-> work num-tris))
        (find-grabbable-edges! work)
        (when (nonzero? (-> work num-edges))
          (set! (-> work search-pt quad) (-> *target* control midpoint-of-hands quad))
          (when (!= (-> *cpad-list* cpads (-> *target* control cpad number) stick0-speed) 0.0)
            (set! (-> work search-dir-vec quad) (-> *target* control to-target-pt-xz quad))
            (search-for-edges work (-> work hold-list))
            (when (find-best-grab! work (-> work hold-list) *edge-grab-info*)
              (send-event *target* 'edge-grab)
              (return (the-as object #f))))
          (vector-z-quaternion! (-> work search-dir-vec) (-> *target* control quat-for-control))
          (search-for-edges work (-> work hold-list))
          (if (find-best-grab! work (-> work hold-list) *edge-grab-info*) (send-event *target* 'edge-grab))
          0)))
    0))

(defmethod search-for-edges ((this collide-edge-work) (hold-list collide-edge-hold-list))
  "Project the search point onto each exposed edge, reject holds outside the
   reach, outward-distance, or facing limits, and build a rating-sorted list of at most 32 candidates."
  (set! (-> hold-list num-allocs) (the-as uint 0))
  (set! (-> hold-list num-attempts) (the-as uint 0))
  (set! (-> hold-list head) #f)
  (let ((hold-item (the-as collide-edge-hold-item (-> hold-list items)))
        (edge (the-as collide-edge-edge (-> this edges))))
    (countdown (edges-left (-> this num-edges))
      (when (not (-> edge ignore))
        (compute-center-point! this edge (-> hold-item center-pt))
        (when (should-add-to-list? this hold-item edge)
          (add-to-list! hold-list hold-item)
          (+! (-> hold-list num-allocs) 1)
          (when (= (-> hold-list num-allocs) 32)
            (format 0 "ERROR: Reached limit of edge grab hold items!~%")
            (return #f))
          (&+! hold-item 48)))
      (&+! edge 48)))
  #f)

;; The hold list is intrusive and sorted by squared xz distance from search-pt. Equal ratings
;; remain in their original insertion order.
(#when PC_PORT
  (defmethod-mips2c "(method 10 collide-edge-hold-list)" 10 collide-edge-hold-list))

(#unless PC_PORT
  (defmethod add-to-list! ((this collide-edge-hold-list) (item collide-edge-hold-item))
    "Save the candidate point for debug display and insert the hold in ascending
     rating order, preserving insertion order when ratings are equal."
    (declare (asm-func none))
    (rlet ((hold-list :reg a0 :type collide-edge-hold-list)
           (item :reg a1 :type collide-edge-hold-item)
           (attempt-slot :reg a2)
           (attempt-offset :reg a3)
           (attempt-count :reg t0)
           (current :reg v1 :type collide-edge-hold-item)
           (predecessor :reg a0 :type collide-edge-hold-item)
           (item-rating :reg f0)
           (current-rating :reg f1)
           (center :reg vf1))
      ;; Every insertion, including a split fallback, is recorded for the debug display.
      (asm-block record-attempt
                 (nop!)
                 (lea.field attempt-slot hold-list (attempts))
                 (l.wu.field attempt-count hold-list (num-attempts))
                 (nop!)
                 (l.vf center item (offset-of collide-edge-hold-item center-pt))
                 (sll attempt-offset attempt-count 4)
                 (l.wu.field current hold-list (head))
                 (add.i attempt-count attempt-count 1)
                 (l.s item-rating item (offset-of collide-edge-hold-item rating))
                 (add attempt-slot attempt-slot attempt-offset)
                 (s.w.field attempt-count hold-list (num-attempts))
                 (s.vf center attempt-slot))
      ;; Strict comparisons leave a new equal-rated item after every existing equal-rated item.
      (asm-block insert-by-rating
                 (b.eql current s7 empty-list :delay (s.w.field item hold-list (head)))
                 (l.s current-rating current (offset-of collide-edge-hold-item rating))
                 (c.lt.s item-rating current-rating)
                 (b.fptl prepend :delay (s.w.field item hold-list (head)))
                 (m predecessor current)
                 (label scan-next)
                 (l.wu.field current current (next))
                 (b.eql current s7 append :delay (s.w.field item predecessor (next)))
                 (l.s current-rating current (offset-of collide-edge-hold-item rating))
                 (c.lt.s item-rating current-rating)
                 (b.fpfl scan-next :delay (m predecessor current))
                 (s.w.field item predecessor (next))
                 (b done :delay (s.w.field current item (next)))
                 (label empty-list)
                 (b done :delay (s.w.field s7 item (next)))
                 (label prepend)
                 (b done :delay (s.w.field current item (next)))
                 (label append)
                 (s.w.field s7 item (next)))
      (asm-block finish (label done) (m v0 r0) (jr ra :delay (add sp sp r0)) (nop! :count 2)))))

(deftype pbhp-stack-vars (structure)
  "Deferred state used while find-best-grab! generates the negative-direction fallback for a
   failed center hold."
  ((edge collide-edge-edge)
   (allocated basic)
   (neg-hold-pt vector :inline)
   (split-vec vector :inline)))

(#when PC_PORT
  (defmethod-mips2c "(method 18 collide-edge-work)" 18 collide-edge-work))

(#unless PC_PORT
  (defmethod find-best-grab! ((this collide-edge-work) (hold-list collide-edge-hold-list) (grab-info edge-grab-info))
    "Try at most 16 holds in rating order. After a failed center hold, generate
     valid fallbacks in both directions at 1024 units, then add 1433.6 units for a second position
     2457.6 units from center. Reinsert every fallback by rating and return the first hold that
     passes full collision validation."
    (declare (asm-func symbol))
    (rlet ((work :reg gp :type collide-edge-work)
           (hold-list :reg s5 :type collide-edge-hold-list)
           (grab-info :reg s4 :type edge-grab-info)
           (split-work :reg s3 :type pbhp-stack-vars)
           (checks-left :reg s2)
           (item :reg s1 :type collide-edge-hold-item)
           (split :reg s0)
           (edge :reg a2 :type collide-edge-edge)
           (split-distance :reg vf1)
           (split-vector :reg vf2)
           (center :reg vf3)
           (edge-direction :reg vf4)
           (positive-point :reg vf5)
           (negative-point :reg vf6)
           (first-endpoint :reg vf7)
           (second-endpoint :reg vf8)
           (endpoint-products :reg vf9))
      (asm-block save-state
                 (add.i sp sp -176)
                 (s.d ra sp)
                 (s.q s0 sp 64)
                 (s.q s1 sp 80)
                 (s.q s2 sp 96)
                 (s.q s3 sp 112)
                 (s.q s4 sp 128)
                 (s.q s5 sp 144)
                 (s.q gp sp 160)
                 (m work a0)
                 (m hold-list a1)
                 (m grab-info a2)
                 (add.i split-work sp 16)
                 (add.i checks-left r0 16))
      ;; The list head is the nearest candidate in xz. Full hand and body collision checks are
      ;; capped at sixteen even when split fallbacks keep the list populated.
      (asm-block test-best-candidate
                 (label next-candidate)
                 (b.z checks-left no-valid-grab :delay (add.i checks-left checks-left -1))
                 (l.wu.field item hold-list (head))
                 (b.eq item s7 no-valid-grab :delay (nop!))
                 (m a0 work)
                 (m! v1 collide-edge-work)
                 (l.wu t9 v1 (method-offset collide-edge-work check-grab-for-collisions))
                 (m a1 item)
                 (m a2 grab-info)
                 (jalr ra t9 :delay (sll v0 ra 0))
                 (m v1 v0)
                 (b.eq v1 s7 expand-failed-candidate :delay (l.wu.field v1 item (next)))
                 (add.i v1 s7 #t)
                 (m v0 v1)
                 (b restore-and-return :delay (nop!)))
      ;; Pop the failed item before producing its next split position. Positive and negative split
      ;; states advance independently; zero creates both first positions.
      (asm-block dispatch-split
                 (label expand-failed-candidate)
                 (l.b split item (split))
                 (s.w.field v1 hold-list (head))
                 (b.gt split r0 continue-positive-side :delay (add.i v1 r0 2))
                 (b.ltl split r0 continue-negative-side :delay (sub split r0 split)))
      ;; A center failure first produces points 1024 units in each direction. The negative point
      ;; is held on the stack while the positive point is filtered and reinserted.
      (asm-block split-both-directions
                 (sll v1 split 2)
                 (lea.field a0 work (split-dists))
                 (add v1 a0 v1)
                 (l.w v1 v1)
                 (m split-distance v1)
                 (l.wu.field edge item (edge))
                 (vmove.xyzw positive-point vf0)
                 (l.vf center item (offset-of collide-edge-hold-item center-pt))
                 (vmove.xyzw negative-point vf0)
                 (l.vf edge-direction edge (offset-of collide-edge-edge edge-vec-norm))
                 (l.wu.field v1 edge (vertex-ptr 1))
                 (vmulx.xyz split-vector edge-direction split-distance)
                 (add.vf.xyz positive-point center split-vector)
                 (sub.vf.xyz negative-point center split-vector)
                 (l.vf second-endpoint v1)
                 (s.vf negative-point split-work (offset-of pbhp-stack-vars neg-hold-pt))
                 (s.vf split-vector split-work (offset-of pbhp-stack-vars split-vec))
                 (s.w.field edge split-work (edge))
                 (s.w.field s7 split-work (allocated))
                 ;; Keep the original integer sign test after the VU transfer. It determines whether
                 ;; the proposed point remains on the segment without changing float boundary cases.
                 (sub.vf.xyz endpoint-products second-endpoint positive-point)
                 (mul.vf.xyz endpoint-products endpoint-products split-vector)
                 (vaddy.x endpoint-products endpoint-products endpoint-products)
                 (vaddz.x endpoint-products endpoint-products endpoint-products)
                 (m v1 endpoint-products)
                 (b.lt v1 r0 try-negative-candidate :delay (nop!))
                 (s.vf positive-point item (offset-of collide-edge-hold-item center-pt))
                 (m a0 work)
                 (m! v1 collide-edge-work)
                 (l.wu t9 v1 (method-offset collide-edge-work should-add-to-list?))
                 (m a1 item)
                 (jalr ra t9 :delay (sll v0 ra 0))
                 (m v1 v0)
                 (b.eq v1 s7 try-negative-candidate :delay (nop!))
                 (m a0 hold-list)
                 (m! v1 collide-edge-hold-list)
                 (l.wu t9 v1 (method-offset collide-edge-hold-list add-to-list!))
                 (m a1 item)
                 (jalr ra t9 :delay (sll v0 ra 0))
                 (m v1 v0)
                 (add.i v1 r0 1)
                 (s.b v1 item (split))
                 (add.i v1 r0 EDGE-GRAB-HOLD-CAPACITY)
                 (l.wu.field a0 hold-list (num-allocs))
                 (add.i a1 r0 (type-size collide-edge-hold-item))
                 (b.eq a0 v1 next-candidate :delay (mult3 v1 a0 a1))
                 (add v1 v1 hold-list)
                 ;; Integer zero is true in GOAL. This marker means the negative fallback consumed
                 ;; a fresh item slot and must increment num-allocs after insertion.
                 (s.w.field r0 split-work (allocated))
                 (add.i item v1 (offset-of collide-edge-hold-list items)))
      (asm-block try-negative-candidate
                 (label try-negative-candidate)
                 (l.wu.field edge split-work (edge))
                 (l.vf negative-point split-work (offset-of pbhp-stack-vars neg-hold-pt))
                 (l.vf split-vector split-work (offset-of pbhp-stack-vars split-vec))
                 (l.wu.field v1 edge (vertex-ptr 0))
                 (l.vf first-endpoint v1)
                 (sub.vf.xyz endpoint-products negative-point first-endpoint)
                 (mul.vf.xyz endpoint-products endpoint-products split-vector)
                 (vaddy.x endpoint-products endpoint-products endpoint-products)
                 (vaddz.x endpoint-products endpoint-products endpoint-products)
                 (m v1 endpoint-products)
                 (b.lt v1 r0 next-candidate :delay (nop!))
                 (s.vf negative-point item (offset-of collide-edge-hold-item center-pt))
                 (m a0 work)
                 (m! v1 collide-edge-work)
                 (l.wu t9 v1 (method-offset collide-edge-work should-add-to-list?))
                 (m a1 item)
                 (jalr ra t9 :delay (sll v0 ra 0))
                 (m v1 v0)
                 (b.eq v1 s7 next-candidate :delay (nop!))
                 (m a0 hold-list)
                 (m! v1 collide-edge-hold-list)
                 (l.wu t9 v1 (method-offset collide-edge-hold-list add-to-list!))
                 (m a1 item)
                 (jalr ra t9 :delay (sll v0 ra 0))
                 (m v1 v0)
                 (l.wu.field v1 split-work (allocated))
                 (b.eq v1 s7 finish-negative-candidate :delay (l.wu.field v1 hold-list (num-allocs)))
                 (add.i v1 v1 1)
                 (s.w.field v1 hold-list (num-allocs))
                 (label finish-negative-candidate)
                 (add.i v1 r0 -1)
                 (b next-candidate :delay (s.b v1 item (split))))
      ;; The second positive fallback adds 1433.6 to the first 1024-unit displacement, landing
      ;; 2457.6 units from the original center. Split state two exhausts this side.
      (asm-block continue-positive-side
                 (label continue-positive-side)
                 (b.eq split v1 next-candidate :delay (l.wu.field edge item (edge)))
                 (sll v1 split 2)
                 (lea.field a0 work (split-dists))
                 (add v1 a0 v1)
                 (l.w v1 v1)
                 (m split-distance v1)
                 (l.vf center item (offset-of collide-edge-hold-item center-pt))
                 (vmove.xyzw positive-point vf0)
                 (l.vf edge-direction edge (offset-of collide-edge-edge edge-vec-norm))
                 (l.wu.field v1 edge (vertex-ptr 1))
                 (vmulx.xyz split-vector edge-direction split-distance)
                 (add.vf.xyz positive-point center split-vector)
                 (l.vf second-endpoint v1)
                 (sub.vf.xyz endpoint-products second-endpoint positive-point)
                 (mul.vf.xyz endpoint-products endpoint-products split-vector)
                 (vaddy.x endpoint-products endpoint-products endpoint-products)
                 (vaddz.x endpoint-products endpoint-products endpoint-products)
                 (m v1 endpoint-products)
                 (b.lt v1 r0 next-candidate :delay (nop!))
                 (s.vf positive-point item (offset-of collide-edge-hold-item center-pt))
                 (m a0 work)
                 (m! v1 collide-edge-work)
                 (l.wu t9 v1 (method-offset collide-edge-work should-add-to-list?))
                 (m a1 item)
                 (jalr ra t9 :delay (sll v0 ra 0))
                 (m v1 v0)
                 (b.eq v1 s7 next-candidate :delay (nop!))
                 (m a0 hold-list)
                 (m! v1 collide-edge-hold-list)
                 (l.wu t9 v1 (method-offset collide-edge-hold-list add-to-list!))
                 (m a1 item)
                 (jalr ra t9 :delay (sll v0 ra 0))
                 (m v1 v0)
                 (add.i v1 split 1)
                 (b next-candidate :delay (s.b v1 item (split))))
      ;; Negative split states use their magnitude as the incremental-distance index and restore
      ;; the sign after advancing the state.
      (asm-block continue-negative-side
                 (label continue-negative-side)
                 (b.eq split v1 next-candidate :delay (l.wu.field edge item (edge)))
                 (sll v1 split 2)
                 (lea.field a0 work (split-dists))
                 (add v1 a0 v1)
                 (l.w v1 v1)
                 (m split-distance v1)
                 (l.vf center item (offset-of collide-edge-hold-item center-pt))
                 (vmove.xyzw negative-point vf0)
                 (l.vf edge-direction edge (offset-of collide-edge-edge edge-vec-norm))
                 (l.wu.field v1 edge (vertex-ptr 0))
                 (vmulx.xyz split-vector edge-direction split-distance)
                 (sub.vf.xyz negative-point center split-vector)
                 (l.vf first-endpoint v1)
                 (sub.vf.xyz endpoint-products negative-point first-endpoint)
                 (mul.vf.xyz endpoint-products endpoint-products split-vector)
                 (vaddy.x endpoint-products endpoint-products endpoint-products)
                 (vaddz.x endpoint-products endpoint-products endpoint-products)
                 (m v1 endpoint-products)
                 (b.lt v1 r0 next-candidate :delay (nop!))
                 (s.vf negative-point item (offset-of collide-edge-hold-item center-pt))
                 (m a0 work)
                 (m! v1 collide-edge-work)
                 (l.wu t9 v1 (method-offset collide-edge-work should-add-to-list?))
                 (m a1 item)
                 (jalr ra t9 :delay (sll v0 ra 0))
                 (m v1 v0)
                 (b.eq v1 s7 next-candidate :delay (nop!))
                 (m a0 hold-list)
                 (m! v1 collide-edge-hold-list)
                 (l.wu t9 v1 (method-offset collide-edge-hold-list add-to-list!))
                 (m a1 item)
                 (jalr ra t9 :delay (sll v0 ra 0))
                 (m v1 v0)
                 (add.i v1 split 1)
                 (sub v1 r0 v1)
                 (b next-candidate :delay (s.b v1 item (split))))
      (asm-block finish
                 (label no-valid-grab)
                 (m v0 s7)
                 (label restore-and-return)
                 (l.d ra sp)
                 (l.q gp sp 160)
                 (l.q s5 sp 144)
                 (l.q s4 sp 128)
                 (l.q s3 sp 112)
                 (l.q s2 sp 96)
                 (l.q s1 sp 80)
                 (l.q s0 sp 64)
                 (jr ra :delay (add.i sp sp 176))
                 (nop! :count 2)))))

(defmethod check-grab-for-collisions ((this collide-edge-work) (hold-item collide-edge-hold-item) (grab-info edge-grab-info))
  "Place both hands along the edge and require each to remain within
   0.12 meters of a non-ignored edge on the same collision primitive. Fill the hanging frame and
   saved geometry, reject blocked hanging or pull-up clearance spheres, and save actor-local vertices
   and a process handle when the supporting primitive belongs to a moving actor."
  (let* ((edge (-> hold-item edge))
         (ctri (-> edge etri ctri))
         (prim-index (-> ctri prim-index)))
    (let ((hand-target (new 'stack-no-clear 'vector)))
      (vector+*! hand-target (-> hold-item center-pt) (-> edge edge-vec-norm) 1105.92)
      (let ((right-hand-distance (nearest-grab-edge-distance! this (-> grab-info right-hand-hold) hand-target (the-as int prim-index))))
        (if (< 491.52 right-hand-distance) (return #f)))
      (vector+*! hand-target
                 (-> hold-item center-pt)
                 (vector-negate! (new 'stack-no-clear 'vector) (-> edge edge-vec-norm))
                 1105.92)
      (let ((left-hand-distance (nearest-grab-edge-distance! this (-> grab-info left-hand-hold) hand-target (the-as int prim-index))))
        (if (< 491.52 left-hand-distance) (return #f))))
    (set! (-> grab-info tri-vertex 0 quad) (-> ctri vertex 0 quad))
    (set! (-> grab-info world-vertex 4 quad) (-> ctri vertex 1 quad))
    (set! (-> grab-info world-vertex 5 quad) (-> ctri vertex 2 quad))
    (set! (-> grab-info edge-tri-pat) (-> ctri pat))
    (set! (-> grab-info center-hold quad) (-> hold-item center-pt quad))
    (set! (-> grab-info world-vertex 0 quad) (-> edge vertex-ptr 0 0 quad))
    (set! (-> grab-info world-vertex 1 quad) (-> edge vertex-ptr 1 0 quad))
    (set! (-> grab-info hanging-matrix vector 1 quad) (-> *target* control dynam gravity-normal quad))
    (vector-normalize! (vector-! (-> grab-info hanging-matrix vector 2) (-> grab-info world-vertex 1) (-> grab-info world-vertex 0))
                       1.0)
    (vector-normalize! (vector-cross! (the-as vector (-> grab-info hanging-matrix))
                                      (-> grab-info hanging-matrix vector 2)
                                      (-> grab-info hanging-matrix vector 1))
                       1.0)
    (vector-cross! (-> grab-info hanging-matrix vector 2)
                   (the-as vector (-> grab-info hanging-matrix))
                   (-> grab-info hanging-matrix vector 1))
    (set! (-> grab-info hanging-matrix vector 3 quad) (-> grab-info center-hold quad))
    (transform-vectors! (-> grab-info hanging-matrix) (-> this world-player-spheres) (-> this local-player-spheres) 12)
    (let ((probe-params (new 'stack-no-clear 'collide-using-spheres-params)))
      (set! (-> probe-params spheres) (-> this world-player-spheres))
      (set! (-> probe-params num-spheres) (the-as uint 12))
      (set! (-> probe-params collide-with) (-> this cshape root-prim collide-with))
      (set! (-> probe-params proc) #f)
      (set! (-> probe-params ignore-pat) (new 'static 'pat-surface :noentity #x1))
      (set! (-> probe-params solid-only) #t)
      (if (probe-using-spheres (-> this ccache) probe-params) (return #f)))
    (let* ((prim (the-as object (-> this ccache prims prim-index prim)))
           (actor-cshape (-> (the-as collide-shape-prim prim) cshape)))
      (cond
        (actor-cshape
         (set! (-> grab-info actor-cshape-prim-offset)
               (- (the-as int prim) (the-as uint (the-as int (-> actor-cshape process)))))
         (set! (-> grab-info actor-handle) (process->handle (-> actor-cshape process)))
         (let ((bone-mat (-> actor-cshape process node-list data (-> (the-as collide-shape-prim prim) transform-index) bone transform))
               (inverse-bone-mat (new 'stack-no-clear 'matrix)))
           (matrix-4x4-inverse! inverse-bone-mat bone-mat)
           (dotimes (i 6)
             (vector-matrix*! (-> grab-info local-vertex i) (-> grab-info world-vertex i) inverse-bone-mat))))
        (else (set! (-> grab-info actor-cshape-prim-offset) 0) (set! (-> grab-info actor-handle) (the-as handle #f))))))
  #t)

(defmethod update-and-validate! ((this edge-grab-info))
  "Re-anchor an actor-backed hold from its saved bone-local vertices.
   Reject a missing or disabled actor, a supporting triangle tilted more than 45 degrees from up,
   or a hanging or leap-up pose whose clearance spheres now collide. Notify the actor when its hold
   remains valid."
  (local-vars (valid? symbol) (tri-normal-bits int))
  (rlet ((acc :class vf)
         (Q :class vf)
         (vf0 :class vf)
         (vf1 :class vf)
         (vf2 :class vf)
         (vf3 :class vf)
         (vf4 :class vf)
         (vf5 :class vf)
         (vf6 :class vf)
         (vf7 :class vf))
    (init-vf0-vector)
    (let ((actor-prim (the-as object #f)))
      (set! (-> this center-hold-old quad) (-> this center-hold quad))
      (let ((prim-offset (-> this actor-cshape-prim-offset)))
        (when (nonzero? prim-offset)
          (let ((actor-process (handle->process (-> this actor-handle))))
            (if (not (the-as process actor-process)) (return #f))
            (set! actor-prim (+ (the-as int actor-process) prim-offset))
            (if (zero? (-> (the-as collide-shape-prim actor-prim) prim-core collide-as)) (return #f))
            (let ((bone-mat (-> (the-as process-drawable actor-process)
                                node-list
                                data
                                (-> (the-as collide-shape-prim actor-prim) transform-index)
                                bone
                                transform)))
              (dotimes (i 6)
                (vector-matrix*! (-> this world-vertex i) (-> this local-vertex i) bone-mat))))
          (.lvf vf1 (&-> this world-vertex 3 quad))
          (.lvf vf2 (&-> this world-vertex 4 quad))
          (.lvf vf3 (&-> this world-vertex 5 quad))
          (.sub.vf vf4 vf2 vf1)
          (.sub.vf vf5 vf3 vf1)
          (.outer.product.a.vf acc vf4 vf5)
          (.outer.product.b.vf vf6 vf5 vf4 acc)
          (.mul.vf vf7 vf6 vf6)
          (.mul.x.vf.w acc vf0 vf7)
          (.add.mul.y.vf.w acc vf0 vf7 acc)
          (.add.mul.z.vf.w vf7 vf0 vf7 acc)
          (.isqrt.vf Q vf0 vf7 :fsf #b11 :ftf #b11)
          (let ((minimum-up-cosine 0.707))
            (.wait.vf)
            (nop!)
            (.mul.vf.xyz vf6 vf6 Q)
            (.mov tri-normal-bits vf6)
            (b! (>= (the-as float (sar tri-normal-bits 32)) minimum-up-cosine) cfg-17))
          (set! valid? #f)
          (b! #t cfg-27 :delay (nop!))
          (label cfg-17)
          (set! (-> this hanging-matrix vector 1 quad) (-> *target* control dynam gravity-normal quad))
          (vector-normalize! (vector-! (-> this hanging-matrix vector 2) (-> this world-vertex 1) (-> this world-vertex 0)) 1.0)
          (vector-normalize! (vector-cross! (the-as vector (-> this hanging-matrix))
                                            (-> this hanging-matrix vector 2)
                                            (-> this hanging-matrix vector 1))
                             1.0)
          (vector-cross! (-> this hanging-matrix vector 2)
                         (the-as vector (-> this hanging-matrix))
                         (-> this hanging-matrix vector 1))
          (set! (-> this hanging-matrix vector 3 quad) (-> this center-hold quad))
          (let ((work *collide-edge-work*))
            (transform-vectors! (-> this hanging-matrix) (-> work world-player-spheres) (-> work local-player-spheres) 12))))
      (let ((work *collide-edge-work*)
            (probe-params (new 'stack-no-clear 'collide-using-spheres-params)))
        (let ((leap-up-state 'target-edge-grab-jump)) (b! (!= (-> *target* next-state name) leap-up-state) cfg-20 :delay (nop!)))
        (set! (-> probe-params spheres) (-> work world-player-leap-up-spheres))
        (set! (-> probe-params num-spheres) (the-as uint 6))
        (set! (-> probe-params collide-with) (-> work cshape root-prim collide-with))
        (set! (-> probe-params proc) #f)
        (set! (-> probe-params ignore-pat) (new 'static 'pat-surface :noentity #x1))
        (set! (-> probe-params solid-only) #t)
        (b! #t cfg-21 :delay (nop!))
        (label cfg-20)
        (set! (-> probe-params spheres) (-> work world-player-spheres))
        (set! (-> probe-params num-spheres) (the-as uint 6))
        (set! (-> probe-params collide-with) (-> work cshape root-prim collide-with))
        (set! (-> probe-params proc) #f)
        (set! (-> probe-params ignore-pat) (new 'static 'pat-surface :noentity #x1))
        (set! (-> probe-params solid-only) #t)
        (label cfg-21)
        (b! (not (fill-and-probe-using-spheres *collide-cache* probe-params)) cfg-24 :delay (empty-form)))
      (set! valid? #f)
      (b! #t cfg-27 :delay (nop!))
      (the-as none 0)
      (label cfg-24)
      (b! (not (the-as int actor-prim)) cfg-26 :delay (empty-form))
      (let ((actor-cshape (-> (the-as collide-shape-prim actor-prim) cshape)))
        (send-event (-> actor-cshape process) 'edge-grabbed this)))
    (label cfg-26)
    (set! valid? #t)
    (label cfg-27)
    valid?))

(#when PC_PORT
  ;; A zero-area triangle is rejected regardless of its normal on EE. On PC, the reciprocal square
  ;; root of zero can produce a host NaN, so force Q to zero and let the resulting zero normal fail
  ;; the slope test.
  (defmethod-mips2c "(method 16 collide-edge-work)" 16 collide-edge-work))

(#unless PC_PORT
  (defmethod find-grabbable-tris! ((this collide-edge-work))
    "Collect up to 48 ground or obstacle cache triangles that overlap the reach
     box, permit edge and entity queries, are not endless-fall surfaces, and have an upward unit
     normal within about 45 degrees of vertical."
    (declare (asm-func none))
    (rlet ((this :reg gp :type collide-edge-work)
           (function-base :reg fp)
           (up-cosine :reg f0)
           (skip-mask :reg v1)
           (mode-mask :reg a0)
           (ground-mode :reg a1)
           (output-triangle :reg a2 :type collide-edge-tri)
           (obstacle-mode :reg a3)
           (cache-triangle :reg t3 :type collide-cache-tri)
           (triangles-left :reg t0)
           (output-count :reg t1)
           (reach-min :reg t2 :class i128)
           (reach-max :reg t4 :class i128)
           (pat :reg t5)
           (filter-bits :reg t6 :class i128)
           (comparison-bits :reg t7 :class i128)
           (vertex-a :reg vf1)
           (vertex-b :reg vf2)
           (vertex-c :reg vf3)
           (edge-ab :reg vf4)
           (edge-ac :reg vf5)
           (normal :reg vf6)
           (triangle-min :reg vf7)
           (triangle-max :reg vf8)
           (normal-length-squared :reg vf9)
           (Q :reg Q))
      (asm-block save-state-and-prepare
                 (add.i sp sp -32)
                 (s.d ra sp)
                 (s.d function-base sp 8)
                 (m function-base t9)
                 (s.q gp sp 16)
                 (m this a0)
                 (l.s up-cosine function-base L95)
                 (add.i skip-mask r0 EDGE-GRAB-PAT-SKIP-MASK)
                 (nop!)
                 (add.i mode-mask r0 EDGE-GRAB-PAT-MODE-MASK)
                 (l.wu.field cache-triangle this (ccache))
                 (add.i ground-mode r0 0)
                 (lea.field output-triangle this (tris))
                 (add.i obstacle-mode r0 EDGE-GRAB-PAT-OBSTACLE)
                 (l.wu triangles-left cache-triangle EDGE-GRAB-CACHE-NUM-TRIS)
                 (m output-count r0)
                 (l.q.field reach-min this (within-reach-box4w min))
                 (add.i cache-triangle cache-triangle EDGE-GRAB-CACHE-TRIS)
                 (l.q.field reach-max this (within-reach-box4w max)))
      ;; PAT mode must be ground or obstacle. The second bit test rejects noentity and noedge. Its
      ;; rejection path deliberately consumes another count without advancing the cursor; cache
      ;; filling already excludes noentity, and noedge faces are not expected in this candidate set.
      (asm-block filter-pat-and-bounds
                 (label next-cache-triangle)
                 (b.z triangles-left finish-triangle-scan :delay (l.wu.field pat cache-triangle (pat)))
                 (add.i triangles-left triangles-left -1)
                 (l.vf vertex-a cache-triangle (offset-of collide-cache-tri vertex 0))
                 (and filter-bits pat mode-mask)
                 (l.vf vertex-b cache-triangle (offset-of collide-cache-tri vertex 1))
                 (b.eq filter-bits
                       ground-mode
                       test-triangle
                       :delay
                       (l.vf vertex-c cache-triangle (offset-of collide-cache-tri vertex 2)))
                 (b.nel filter-bits
                        obstacle-mode
                        next-cache-triangle
                        :delay
                        (add.i cache-triangle cache-triangle (type-size collide-cache-tri)))
                 (label test-triangle)
                 (and filter-bits pat skip-mask)
                 (min.vf triangle-min vertex-a vertex-b)
                 (b.nz filter-bits next-cache-triangle :delay (vmax.xyzw triangle-max vertex-a vertex-b))
                 (sub.vf.xyz edge-ab vertex-b vertex-a)
                 (nop!)
                 (sub.vf.xyz edge-ac vertex-c vertex-a)
                 (nop!)
                 (min.vf triangle-min triangle-min vertex-c)
                 (nop!)
                 (vmax.xyzw triangle-max triangle-max vertex-c)
                 (nop!)
                 (vopmula.xyz acc edge-ab edge-ac)
                 (nop!)
                 (ftoi.vf triangle-min triangle-min)
                 (nop!)
                 (ftoi.vf triangle-max triangle-max)
                 (nop!)
                 (vopmsub.xyz normal edge-ac edge-ab)
                 (nop!)
                 (m comparison-bits triangle-min)
                 (nop!)
                 (m filter-bits triangle-max)
                 (nop!)
                 (pcgt.w comparison-bits comparison-bits reach-max)
                 (mmi-nop!)
                 (mul.vf normal-length-squared normal normal)
                 (nop!)
                 (pcgt.w filter-bits reach-min filter-bits)
                 (mmi-nop!)
                 (or.q filter-bits comparison-bits filter-bits)
                 (mmi-nop!)
                 (ppach filter-bits r0 filter-bits)
                 (mmi-nop!)
                 (sll filter-bits filter-bits 16)
                 (nop!)
                 (b.nzl filter-bits next-cache-triangle :delay (add.i cache-triangle cache-triangle (type-size collide-cache-tri))))
      ;; Normalize the face normal, require y >= cos(45 degrees), and reject endless-fall PAT
      ;; events. Only xyz of the stored normal is defined; its w lane is scratch.
      (asm-block test-slope-and-event
                 (vmulax.w acc vf0 normal-length-squared)
                 (nop!)
                 (vmadday.w acc vf0 normal-length-squared)
                 (nop!)
                 (vmaddz.w normal-length-squared vf0 normal-length-squared)
                 (nop!)
                 (vrsqrt Q vf0.w normal-length-squared.w)
                 (nop!)
                 (sll32 pat pat 12)
                 (srl32 pat pat 26)
                 (add.i filter-bits r0 EDGE-GRAB-ENDLESSFALL-EVENT)
                 (nop!)
                 (waitq)
                 (nop!)
                 (vmulq.xyz normal normal Q)
                 (nop!)
                 (m comparison-bits normal)
                 (nop!)
                 (sra32 comparison-bits comparison-bits 0)
                 (nop!)
                 (m f1 comparison-bits)
                 (nop!)
                 (c.lt.s f1 up-cosine)
                 (add.i comparison-bits r0 EDGE-GRAB-TRIANGLE-CAPACITY)
                 (b.fptl next-cache-triangle :delay (add.i cache-triangle cache-triangle (type-size collide-cache-tri)))
                 (b.eql pat filter-bits next-cache-triangle :delay (add.i cache-triangle cache-triangle (type-size collide-cache-tri))))
      (asm-block append-triangle
                 (b.eq output-count comparison-bits triangle-capacity-exceeded :delay (nop!))
                 (add.i output-count output-count 1)
                 (s.w.field cache-triangle output-triangle (ctri))
                 (nop!)
                 (s.vf normal output-triangle (offset-of collide-edge-tri normal))
                 (add.i output-triangle output-triangle (type-size collide-edge-tri))
                 (nop!)
                 (b next-cache-triangle :delay (add.i cache-triangle cache-triangle (type-size collide-cache-tri))))
      (asm-block finish
                 (label finish-triangle-scan)
                 (b find-grabbable-tris-done :delay (s.w.field output-count this (num-tris)))
                 (label triangle-capacity-exceeded)
                 (m! t9 format)
                 (add.i a0 r0 0)
                 (add.i a1 function-base L88)
                 (jalr ra t9 :delay (sll v0 ra 0))
                 (add.i v1 r0 EDGE-GRAB-TRIANGLE-CAPACITY)
                 (s.w.field v1 this (num-tris))
                 (label find-grabbable-tris-done)
                 (m v0 r0)
                 (l.d ra sp)
                 (l.d function-base sp 8)
                 (l.q gp sp 16)
                 (jr ra :delay (add.i sp sp 32))
                 (nop! :count 3)))))

(#when PC_PORT
  (defmethod-mips2c "(method 15 collide-edge-work)" 15 collide-edge-work))

(#unless PC_PORT
  (defmethod find-grabbable-edges! ((this collide-edge-work))
    "Weld accepted triangle vertices within one centimeter, cancel reversed shared
     edges, and collect up to 96 exposed edges whose horizontal outward side faces the target.
     Store normalized outward and along-edge directions."
    (declare (asm-func none))
    (rlet ((this :reg a0 :type collide-edge-work)
           (function-base :reg fp)
           (merge-distance-squared :reg f0)
           (zero-float :reg f2)
           (triangles-left :reg v1)
           (triangle :reg a1 :type collide-edge-tri)
           (player-at-reach-min :reg vf1)
           (player-at-reach-max :reg vf2)
           (reach-min :reg vf6)
           (reach-max :reg vf7)
           (triangle-a :reg vf3)
           (triangle-b :reg vf4)
           (triangle-c :reg vf5)
           (vertex-to-find :reg vf8)
           (vertex-a :reg a2)
           (vertex-b :reg a3)
           (vertex-c :reg t0))
      (asm-block save-state-and-prepare
                 (add.i sp sp -16)
                 (s.d ra sp)
                 (s.d function-base sp 8)
                 (m function-base t9)
                 (l.s merge-distance-squared function-base L90)
                 (m zero-float r0)
                 (l.wu.field a1 this (cshape))
                 (nop!)
                 (l.wu.field triangles-left this (num-tris))
                 (nop!)
                 (l.vf player-at-reach-min a1 EDGE-GRAB-CSHAPE-TRANS)
                 (lea.field triangle this (tris))
                 (l.vf reach-min this (offset-of collide-edge-work within-reach-box min))
                 (nop!)
                 (l.vf reach-max this (offset-of collide-edge-work within-reach-box max))
                 (vmove.xyzw player-at-reach-max player-at-reach-min)
                 (nop!)
                 (add.y.vf.y player-at-reach-min vf0 reach-min)
                 (nop!)
                 (add.y.vf.y player-at-reach-max vf0 reach-max)
                 (nop!))
      ;; Canonicalize each triangle's vertices, then submit its three directed edges. The prepared
      ;; upper-reach player point is intentionally unused; the outward half-plane test uses xz only.
      (asm-block process-supporting-triangles
                 (label next-support-triangle)
                 (b.z triangles-left find-grabbable-edges-done :delay (l.wu vertex-c triangle (offset-of collide-edge-tri ctri)))
                 (add.i triangles-left triangles-left -1)
                 (nop! :count 2)
                 (l.vf triangle-a vertex-c (offset-of collide-cache-tri vertex 0))
                 (nop!)
                 (l.vf triangle-b vertex-c (offset-of collide-cache-tri vertex 1))
                 (nop!)
                 (l.vf triangle-c vertex-c (offset-of collide-cache-tri vertex 2))
                 (bgezal r0 find-or-add-vertex :delay (vmove.xyzw vertex-to-find triangle-a))
                 (b.eq t0 s7 vertex-capacity-exceeded :delay (m vertex-a t0))
                 (bgezal r0 find-or-add-vertex :delay (vmove.xyzw vertex-to-find triangle-b))
                 (b.eq t0 s7 vertex-capacity-exceeded :delay (m vertex-b t0))
                 (bgezal r0 find-or-add-vertex :delay (vmove.xyzw vertex-to-find triangle-c))
                 (b.eq t0 s7 vertex-capacity-exceeded :delay (m vertex-c t0))
                 (m t1 vertex-a)
                 (nop!)
                 (bgezal r0 find-or-add-edge :delay (m t2 vertex-b))
                 (b.eq t4 s7 edge-capacity-exceeded :delay (m t1 vertex-b))
                 (bgezal r0 find-or-add-edge :delay (m t2 vertex-c))
                 (b.eq t4 s7 edge-capacity-exceeded :delay (m t1 vertex-c))
                 (bgezal r0 find-or-add-edge :delay (m t2 vertex-a))
                 ;; This last check uses the third edge's start pointer rather than the helper
                 ;; result. A final capacity failure may therefore be reported on the next triangle.
                 (b.eq t1 s7 edge-capacity-exceeded :delay (nop!))
                 (b next-support-triangle :delay (add.i triangle triangle (type-size collide-edge-tri))))
      ;; A reversed pointer pair identifies an interior edge shared by two consistently wound
      ;; eligible faces. Mark the existing edge ignored instead of adding a duplicate.
      (rlet ((edge-start :reg t1)
             (edge-end :reg t2)
             (edge-count :reg t3)
             (edge-result :reg t4 :type collide-edge-edge)
             (edge-index :reg t5)
             (reverse-pair-key :reg t6)
             (stored-pair-key :reg t7)
             (start-position :reg vf16)
             (end-position :reg vf17)
             (edge-vector :reg vf18)
             (player-offset :reg vf19)
             (edge-length-squared :reg vf20)
             (outward :reg vf13)
             (outward-length-squared :reg vf14)
             (outward-dot :reg vf15)
             (Q :reg Q))
        (asm-block find-or-add-edge-helper
                   (label find-or-add-edge)
                   (m edge-result edge-start)
                   (l.wu.field edge-count this (num-edges))
                   (sll32 edge-result edge-result 0)
                   (m edge-index r0)
                   (or reverse-pair-key edge-result edge-end)
                   (lea.field edge-result this (edges))
                   (label scan-existing-edges)
                   (b.eq edge-index
                         edge-count
                         allocate-edge
                         :delay
                         (l.d stored-pair-key edge-result (offset-of collide-edge-edge vertex-ptr)))
                   (add.i edge-index edge-index 1)
                   (nop! :count 3)
                   (b.nel reverse-pair-key
                          stored-pair-key
                          scan-existing-edges
                          :delay
                          (add.i edge-result edge-result (type-size collide-edge-edge)))
                   ;; Integer zero is true in GOAL, so it is a compact ignored marker.
                   (b return-from-edge-helper :delay (s.w.field r0 edge-result (ignore)))
                   (label allocate-edge)
                   (add.i edge-index r0 EDGE-GRAB-EDGE-CAPACITY)
                   (nop!)
                   (b.eql edge-count edge-index return-from-edge-helper :delay (m edge-result s7))
                   (add.i edge-count edge-count 1)
                   (s.w.field s7 edge-result (ignore))
                   (nop!)
                   (s.w.field edge-start edge-result (vertex-ptr 0))
                   (nop!)
                   (s.w.field edge-end edge-result (vertex-ptr 1))
                   (nop!)
                   (s.w.field triangle edge-result (etri))
                   (nop!)
                   (s.w.field edge-count this (num-edges))
                   (vmove.xyzw outward vf0)
                   (l.vf start-position edge-start)
                   (nop!)
                   (l.vf end-position edge-end)
                   (sub.vf edge-vector end-position start-position)
                   (nop!)
                   (sub.vf player-offset player-at-reach-min start-position)
                   (nop!)
                   (mul.vf edge-length-squared edge-vector edge-vector)
                   (nop!)
                   (sub.z.vf.x outward vf0 edge-vector)
                   (nop!)
                   (vaddy.x edge-length-squared edge-length-squared edge-length-squared)
                   (nop!)
                   (vaddx.z outward vf0 edge-vector)
                   (nop!)
                   (vaddz.x edge-length-squared edge-length-squared edge-length-squared)
                   (nop!)
                   (mul.vf outward-dot outward player-offset)
                   (nop!)
                   (mul.vf outward-length-squared outward outward)
                   (nop!)
                   (vaddz.x outward-dot outward-dot outward-dot)
                   (nop!)
                   (vaddz.x outward-length-squared outward-length-squared outward-length-squared)
                   (nop!)
                   (m t2 outward-dot)
                   (nop!)
                   (vrsqrt Q vf0.w outward-length-squared.x)
                   (nop!)
                   (m f3 t2)
                   (nop!)
                   (c.lt.s f3 zero-float)
                   (nop!)
                   (b.fptl return-from-edge-helper :delay (s.w.field r0 edge-result (ignore)))
                   (waitq)
                   (nop!)
                   (vmulq.xyz outward outward Q)
                   (nop!)
                   (vnop)
                   (nop!)
                   (vnop)
                   (nop!)
                   (vrsqrt Q vf0.w edge-length-squared.x)
                   (nop!)
                   (vmulw.w edge-vector vf0 vf0)
                   (s.vf outward edge-result (offset-of collide-edge-edge outward))
                   (waitq)
                   (nop!)
                   (vmulq.xyz edge-vector edge-vector Q)
                   (nop!)
                   (vnop)
                   (nop!)
                   (vnop)
                   (nop! :count 2)
                   (s.vf edge-vector edge-result (offset-of collide-edge-edge edge-vec-norm))
                   (label return-from-edge-helper)
                   (jr ra :delay (nop!))))
      ;; Vertex welding retains the first position within the one-centimeter threshold. The search
      ;; is unrolled four at a time and performs speculative loads, but count checks prevent an
      ;; out-of-range value from being compared.
      (rlet ((vertex-index :reg t2)
             (vertex-count :reg t1)
             (vertex-result :reg t0)
             (distance-bits :reg t3)
             (distance :reg f1)
             (distance-0 :reg vf9)
             (distance-1 :reg vf10)
             (distance-2 :reg vf11)
             (distance-3 :reg vf12))
        (asm-block find-or-add-vertex-helper
                   (label find-or-add-vertex)
                   (m vertex-index r0)
                   (l.wu.field vertex-count this (num-verts))
                   (lea.field vertex-result this (verts))
                   (nop!)
                   (label scan-vertex-batch)
                   (b.eq vertex-index vertex-count allocate-vertex :delay (l.vf distance-0 vertex-result))
                   (add.i vertex-index vertex-index 1)
                   (l.vf distance-1 vertex-result 16)
                   (sub.vf distance-0 distance-0 vertex-to-find)
                   (l.vf distance-2 vertex-result 32)
                   (sub.vf distance-1 distance-1 vertex-to-find)
                   (l.vf distance-3 vertex-result 48)
                   (sub.vf distance-2 distance-2 vertex-to-find)
                   (nop!)
                   (sub.vf distance-3 distance-3 vertex-to-find)
                   (nop!)
                   (mul.vf distance-0 distance-0 distance-0)
                   (nop!)
                   (mul.vf distance-1 distance-1 distance-1)
                   (nop!)
                   (mul.vf distance-2 distance-2 distance-2)
                   (nop!)
                   (mul.vf distance-3 distance-3 distance-3)
                   (nop!)
                   (vaddy.x distance-0 distance-0 distance-0)
                   (nop!)
                   (vaddy.x distance-1 distance-1 distance-1)
                   (nop!)
                   (vaddy.x distance-2 distance-2 distance-2)
                   (nop!)
                   (vaddy.x distance-3 distance-3 distance-3)
                   (nop!)
                   (vaddz.x distance-0 distance-0 distance-0)
                   (nop!)
                   (vaddz.x distance-1 distance-1 distance-1)
                   (nop!)
                   (vaddz.x distance-2 distance-2 distance-2)
                   (nop!)
                   (vaddz.x distance-3 distance-3 distance-3)
                   (nop!)
                   (m distance-bits distance-0)
                   (nop!)
                   (m distance distance-bits)
                   (nop!)
                   (c.le.s distance merge-distance-squared)
                   (nop!)
                   (b.fpt return-from-vertex-helper :delay (nop!))
                   (b.eq vertex-index vertex-count allocate-vertex :delay (add.i vertex-result vertex-result 16))
                   (m distance-bits distance-1)
                   (add.i vertex-index vertex-index 1)
                   (m distance distance-bits)
                   (nop!)
                   (c.le.s distance merge-distance-squared)
                   (nop!)
                   (b.fpt return-from-vertex-helper :delay (nop!))
                   (b.eq vertex-index vertex-count allocate-vertex :delay (add.i vertex-result vertex-result 16))
                   (m distance-bits distance-2)
                   (add.i vertex-index vertex-index 1)
                   (m distance distance-bits)
                   (nop!)
                   (c.le.s distance merge-distance-squared)
                   (nop!)
                   (b.fpt return-from-vertex-helper :delay (nop!))
                   (b.eq vertex-index vertex-count allocate-vertex :delay (add.i vertex-result vertex-result 16))
                   (m distance-bits distance-3)
                   (add.i vertex-index vertex-index 1)
                   (m distance distance-bits)
                   (nop!)
                   (c.le.s distance merge-distance-squared)
                   (nop!)
                   (b.fpt return-from-vertex-helper :delay (nop!))
                   (b scan-vertex-batch :delay (add.i vertex-result vertex-result 16))
                   (label allocate-vertex)
                   (add.i vertex-index r0 EDGE-GRAB-VERTEX-CAPACITY)
                   (nop!)
                   (b.eql vertex-index vertex-count return-from-vertex-helper :delay (m vertex-result s7))
                   (add.i vertex-count vertex-count 1)
                   (s.vf vertex-to-find vertex-result)
                   (nop!)
                   (s.w.field vertex-count this (num-verts))
                   (label return-from-vertex-helper)
                   (jr ra :delay (nop!))))
      (asm-block report-capacity-and-finish
                 (label vertex-capacity-exceeded)
                 (m! t9 format)
                 (add.i a0 r0 0)
                 (add.i a1 function-base L87)
                 (jalr ra t9 :delay (sll v0 ra 0))
                 (b find-grabbable-edges-done :delay (nop!))
                 (label edge-capacity-exceeded)
                 (m! t9 format)
                 (add.i a0 r0 0)
                 (add.i a1 function-base L86)
                 (jalr ra t9 :delay (sll v0 ra 0))
                 (label find-grabbable-edges-done)
                 (m v0 r0)
                 (l.d ra sp)
                 (l.d function-base sp 8)
                 (jr ra :delay (add.i sp sp 16))
                 (nop! :count 3)))))

(defmethod nearest-grab-edge-distance! ((this collide-edge-work) (output vector) (test-point vector) (prim-index int))
  "Find the nearest non-ignored edge belonging to one collision
   primitive, store the closest point on that edge, and return its distance from the test point.
   Return -1 when no matching edge exists."
  (let ((best-distance -1.0))
    (let ((closest-point (new 'stack-no-clear 'vector)))
      (dotimes (i (the-as int (-> this num-edges)))
        (let ((edge (-> this edges i)))
          (when (not (-> edge ignore))
            (when (= (-> edge etri ctri prim-index) prim-index)
              (let ((distance (vector-segment-distance-point! test-point (-> edge vertex-ptr 0 0) (-> edge vertex-ptr 1 0) closest-point)))
                (when (or (< best-distance 0.0) (< distance best-distance))
                  (set! best-distance distance)
                  (vector-copy! output closest-point))))))))
    best-distance))

(defmethod should-add-to-list? ((this collide-edge-work) (hold-item collide-edge-hold-item) (edge collide-edge-edge))
  "Accept a candidate only when its center lies inside the reach box, its
   outward test point lies within the configured xz distance, and its direction from the target
   meets the configured facing cosine. Fill its edge, points, zero split state, and squared xz
   distance rating on success."
  (local-vars
    (outside-mask uint128)
    (packed-outside-mask uint128)
    (outward-distance-squared float)
    (facing-cosine float)
    (rating float)
    (below-min-mask uint128)
    (center-int uint128)
    (above-max-mask uint128))
  (rlet ((Q :class vf)
         (vf0 :class vf)
         (vf1 :class vf)
         (vf10 :class vf)
         (vf11 :class vf)
         (vf2 :class vf)
         (vf3 :class vf)
         (vf4 :class vf)
         (vf5 :class vf)
         (vf6 :class vf)
         (vf7 :class vf)
         (vf8 :class vf)
         (vf9 :class vf))
    (init-vf0-vector)
    (nop!)
    (nop!)
    (.lvf vf1 (&-> hold-item center-pt quad))
    (nop!)
    (let ((reach-min (-> this within-reach-box4w min quad)))
      (nop!)
      (let ((reach-max (-> this within-reach-box4w max quad)))
        (.ftoi.vf vf2 vf1)
        (let ((target-cshape (-> this cshape)))
          (.mov center-int vf2)
          (.lvf vf3 (&-> edge outward quad))
          (.pcgtw above-max-mask center-int reach-max)
          (.lvf vf4 (&-> this outward-offset quad))
          (.pcgtw below-min-mask reach-min center-int)
          (.lvf vf5 (&-> target-cshape trans quad)))))
    (.por outside-mask above-max-mask below-min-mask)
    (let ((max-outward-distance-squared (-> this max-dist-sqrd-to-outward-pt)))
      (.ppach packed-outside-mask (the-as uint128 0) outside-mask)
      (let ((minimum-facing-cosine (-> this max-dir-cosa-delta)))
        (b! (nonzero? (shl (the-as int packed-outside-mask) 16)) cfg-4 :delay (.lvf vf6 (&-> this search-dir-vec quad)))
        (.mul.x.vf vf10 vf3 vf4)
        (.lvf vf11 (&-> this search-pt quad))
        (.add.vf vf10 vf10 vf1)
        (.sub.vf vf7 vf5 vf10)
        (.mul.vf vf7 vf7 vf7)
        (.add.z.vf.x vf7 vf7 vf7)
        (.mov outward-distance-squared vf7)
        (b! (< max-outward-distance-squared outward-distance-squared) cfg-4)
        (.sub.vf vf8 vf1 vf5)
        (.mul.vf vf7 vf8 vf8)
        (.add.z.vf.x vf7 vf7 vf7)
        (.isqrt.vf Q vf0 vf7 :fsf #b11 :ftf #b0)
        (nop!)
        (.wait.vf)
        (nop!)
        (.mul.vf.xz vf8 vf8 Q)
        (.mul.vf vf9 vf8 vf6)
        (.add.z.vf.x vf9 vf9 vf9)
        (.mov facing-cosine vf9)
        (b! (< facing-cosine minimum-facing-cosine) cfg-4)))
    (.sub.vf vf7 vf11 vf1)
    (.svf (&-> hold-item center-pt quad) vf1)
    (.mul.vf vf7 vf7 vf7)
    (set! (-> hold-item split) 0)
    (.svf (&-> hold-item outward-pt quad) vf10)
    (.add.z.vf.x vf7 vf7 vf7)
    (set! (-> hold-item edge) edge)
    (.mov rating vf7)
    (set! (-> hold-item rating) rating)
    (let ((accepted? #t))
      (b! #t cfg-6 :delay (nop!))
      (label cfg-4)
      (set! accepted? #f)
      (b! #t cfg-6 :delay (nop!))
      (set! accepted? (the-as symbol 0))
      (label cfg-6)
      accepted?)))

(defmethod compute-center-point! ((this collide-edge-work) (edge collide-edge-edge) (output vector))
  "Project the search point onto an edge in the xz plane, clamp the
   projection to the segment, and store the resulting point. The scalar return is the output x
   coordinate and is not used by the edge search."
  (local-vars
    (result-x float)
    (edge-length-result float)
    (inverse-edge-length-result float)
    (projected-distance-result float))
  (rlet ((Q :class vf)
         (vf0 :class vf)
         (vf1 :class vf)
         (vf10 :class vf)
         (vf11 :class vf)
         (vf2 :class vf)
         (vf3 :class vf)
         (vf4 :class vf)
         (vf5 :class vf)
         (vf6 :class vf)
         (vf7 :class vf)
         (vf8 :class vf)
         (vf9 :class vf))
    (init-vf0-vector)
    (.mov.vf vf7 vf0)
    (.lvf vf1 (&-> this search-pt quad))
    (let ((zero 0.0))
      (let ((edge-start (-> edge vertex-ptr 0))
            (edge-end (-> edge vertex-ptr 1)))
        (.lvf vf2 (&-> edge-start 0 quad))
        (.lvf vf3 (&-> edge-end 0 quad)))
      (.sub.vf vf4 vf1 vf2)
      (.sub.vf vf5 vf3 vf2)
      (.mul.vf vf6 vf5 vf5)
      (.add.z.vf.x vf6 vf6 vf6)
      (.sqrt.vf Q vf6 :ftf #b0)
      (nop!)
      (.wait.vf)
      (nop!)
      (.add.vf.x vf6 vf0 Q)
      (.nop.vf)
      (.mov edge-length-result vf6)
      (let ((edge-length edge-length-result))
        (.div.vf Q vf0 vf6 :fsf #b11 :ftf #b0)
        (.wait.vf)
        (nop!)
        (.add.vf.x vf8 vf0 Q)
        (.mul.x.vf vf9 vf5 vf8)
        (.mov inverse-edge-length-result vf8)
        (.mul.vf vf10 vf9 vf4)
        (.add.z.vf.x vf10 vf10 vf10)
        (let ((inverse-edge-length inverse-edge-length-result))
          (.mov projected-distance-result vf10)
          (let ((projected-distance projected-distance-result))
            (b! (< projected-distance zero) cfg-4 :likely-delay (set! projected-distance zero))
            (b! (< edge-length projected-distance) cfg-4 :likely-delay (set! projected-distance edge-length))
            (label cfg-4)
            (let ((edge-fraction (* projected-distance inverse-edge-length))) (.mov vf11 edge-fraction))))))
    (.mul.x.vf.xyz vf7 vf5 vf11)
    (.add.vf.xyz vf7 vf7 vf2)
    (.svf (&-> output quad) vf7)
    (.mov result-x vf7)
    result-x))

(defmethod debug-draw ((this edge-grab-info))
  "Draw the saved edge, triangle, hand holds, and hanging frame."
  (add-debug-line #t
                  (bucket-id debug-no-zbuf)
                  (-> this world-vertex 0)
                  (-> this world-vertex 1)
                  (new 'static 'rgba :r #xff :a #x60)
                  #f
                  (the-as rgba -1))
  (add-debug-sphere #t (bucket-id debug-no-zbuf) (-> this center-hold) 204.8 (new 'static 'rgba :r #xff :g #xff :a #x80))
  (add-debug-sphere #t (bucket-id debug-no-zbuf) (-> this left-hand-hold) 204.8 (new 'static 'rgba :r #xff :g #xff :a #x60))
  (add-debug-sphere #t
                    (bucket-id debug-no-zbuf)
                    (-> this right-hand-hold)
                    204.8
                    (new 'static 'rgba :r #xff :g #xff :a #x60))
  (add-debug-outline-triangle #t
                              (bucket-id debug-no-zbuf)
                              (-> this tri-vertex 0)
                              (-> this world-vertex 4)
                              (-> this world-vertex 5)
                              (new 'static 'rgba :r #xff :a #x30))
  (the-as symbol
          (cond
            ((nonzero? (-> this actor-cshape-prim-offset))
             (if (handle->process (-> this actor-handle))
               (format *stdcon* "grab: ~A~%" (-> this actor-handle process 0 name))
               (format *stdcon* "grab: invalid handle~%")))
            (else (format *stdcon* "grab: ground~%")))))

(defmethod debug-draw-edges ((this collide-edge-work))
  "Draw the extracted candidate edges."
  (let ((ignored-count 0))
    (dotimes (i (the-as int (-> this num-edges)))
      (let* ((edge (-> this edges i))
             (edge-start (-> edge vertex-ptr 0 0))
             (edge-end (-> edge vertex-ptr 1 0))
             (edge-midpoint (new 'stack-no-clear 'vector)))
        (vector+! edge-midpoint edge-start edge-end)
        (vector-float*! edge-midpoint edge-midpoint 0.5)
        (cond
          ((-> edge ignore)
           (add-debug-line #t
                           (bucket-id debug-no-zbuf)
                           edge-start
                           edge-end
                           (new 'static 'rgba :r #x7f :g #x7f :b #x7f :a #x50)
                           #f
                           (the-as rgba -1))
           (+! ignored-count 1))
          (else
           (add-debug-line #t
                           (bucket-id debug-no-zbuf)
                           edge-start
                           edge-end
                           (new 'static 'rgba :r #xff :g #xff :b #xff :a #x60)
                           #f
                           (the-as rgba -1))
           (add-debug-vector #t
                             (bucket-id debug-no-zbuf)
                             edge-midpoint
                             (-> edge outward)
                             (meters 0.3)
                             (new 'static 'rgba :r #xff :a #x80))))))
    (format *stdcon* "found ~D edges (and ~D ignored)~%" (- (-> this num-edges) (the-as uint ignored-count)) ignored-count)))

(defmethod debug-draw-sphere ((this collide-edge-work))
  "Draw the deduplicated vertices used by the candidate edge list."
  (dotimes (i (the-as int (-> this num-verts)))
    (let ((vertex (-> this verts i)))
      (add-debug-sphere #t (bucket-id debug-no-zbuf) vertex 819.2 (new 'static 'rgba :r #xff :g #xff :a #x80))))
  #f)

(defmethod debug-draw ((this collide-edge-hold-list))
  "Draw the candidate holds and attempted positions."
  (let ((item (-> this head))
        (item-count 0))
    (let ((marker (new 'stack-no-clear 'vector))
          (first-item? #t))
      (vector-copy! marker (-> *target* control midpoint-of-hands))
      (while item
        (+! item-count 1)
        (set! (-> marker y) (-> item center-pt y))
        (add-debug-sphere #t (bucket-id debug-no-zbuf) marker 409.6 (new 'static 'rgba :a #x80))
        (cond
          (first-item?
           (set! first-item? #f)
           (add-debug-sphere #t (bucket-id debug-no-zbuf) (-> item center-pt) 614.4 (new 'static 'rgba :r #xff :g #xff :a #x80))
           (add-debug-sphere #t (bucket-id debug-no-zbuf) (-> item outward-pt) 409.6 (new 'static 'rgba :r #xff :a #x80)))
          (else
           (add-debug-sphere #t (bucket-id debug-no-zbuf) (-> item center-pt) 614.4 (new 'static 'rgba :r #x7f :g #x7f :a #x40))
           (add-debug-sphere #t (bucket-id debug-no-zbuf) (-> item outward-pt) 409.6 (new 'static 'rgba :r #x7f :a #x40))))
        (set! item (-> item next))))
    (format *stdcon* "hold list has ~D item(s)~%" item-count))
  (dotimes (i (the-as int (-> this num-attempts)))
    (add-debug-sphere #t (bucket-id debug-no-zbuf) (-> this attempts i vector) 409.6 (new 'static 'rgba :a #x40)))
  (format *stdcon* "hold list has ~D attempt(s)~%" (-> this num-attempts)))

(defmethod debug-draw-tris ((this collide-edge-work))
  "Draw the accepted supporting triangles."
  (dotimes (i (the-as int (-> this num-tris)))
    (let* ((ctri (-> this tris i ctri))
           (tri-color (copy-and-set-field (-> *pat-mode-info* (-> ctri pat mode) color) a 64)))
      (add-debug-outline-triangle #t
                                  (bucket-id debug-no-zbuf)
                                  (-> ctri vertex 0)
                                  (-> ctri vertex 1)
                                  (-> ctri vertex 2)
                                  tri-color)))
  (none))

(let ((rotate-surface (new 'static
                           'surface
                           :name '*rotate-surface*
                           :turnv 1.0
                           :turnvv 1.0
                           :tiltv 1.0
                           :tiltvv 1.0
                           :transv-max 1.0
                           :target-speed 1.0
                           :seek0 153600.0
                           :seek90 153600.0
                           :seek180 256000.0
                           :fric 153600.0
                           :nonlin-fric-dist 5120.0
                           :slip-factor 1.0
                           :slope-down-factor 10240.0
                           :slope-slip-angle 8192.0
                           :impact-fric 1.0
                           :bend-factor 0.8
                           :bend-speed 4.0
                           :alignv 1.0
                           :slope-up-traction 1.0
                           :align-speed 1.0
                           :flags (surface-flags moving-ground))))
  ;; og:preserve-this added
  (define *rotate-surface* rotate-surface)
  (set! *rotate-surface* rotate-surface)
  ;; Rotating ground uses the ordinary movement response, with slightly less friction while two
  ;; surfaces are being combined for contact mode 1.
  (set! (-> rotate-surface mult-hook)
        (the-as (function surface surface surface int none)
                (lambda ((combined-surface surface) (_other-a object) (_other-b object) (mode int))
                  (if (= mode 1) (set! (-> combined-surface fric) 151756.8)))))
  (set! (-> rotate-surface touch-hook) nothing)
  (set! (-> rotate-surface active-hook) nothing))

(let ((no-walk-surface (new 'static
                            'surface
                            :name '*no-walk-surface*
                            :turnv 0.5
                            :turnvv 1.0
                            :tiltv 1.0
                            :tiltvv 1.0
                            :transv-max 0.7
                            :target-speed 0.7
                            :seek0 24576.0
                            :seek90 24576.0
                            :seek180 24576.0
                            :fric 23756.8
                            :nonlin-fric-dist 4091904.0
                            :slope-slip-angle 16384.0
                            :bend-speed 4.0
                            :alignv 0.5
                            :slope-up-traction 0.9
                            :align-speed 1.0
                            :flags (surface-flags no-turn-around always-rotate-toward-transv))))
  ;; og:preserve-this added
  (define *no-walk-surface* no-walk-surface)
  (set! *no-walk-surface* no-walk-surface)
  ;; Tube material keeps contact active but sharply limits steering and travel speed.
  (set! (-> no-walk-surface mult-hook) (the-as (function surface surface surface int none) nothing))
  (set! (-> no-walk-surface touch-hook) nothing)
  (set! (-> no-walk-surface active-hook) nothing))

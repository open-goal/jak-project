;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/collide/collide-shape-h.gc")

;; DECOMP BEGINS

;; History of collision from target, used for debugging.
(deftype collide-history (structure)
  ((intersect      vector :inline)
   (trans          vector :inline)
   (transv         vector :inline)
   (transv-out     vector :inline)
   (local-normal   vector :inline)
   (surface-normal vector :inline)
   (time           time-frame)
   (status         collide-status)
   (pat            pat-surface)
   (reaction-flag  cshape-reaction-flags))
  (:methods
   (update! (_type_ collide-shape-moving vector vector vector) _type_)))

;; Jak's collision shape and movement state.
;;
;; state-var0/1/2 and state-vector0/1 are deliberately shared between target states. The named
;; overlays select the interpretation used by each state. saved-launch-event through
;; launch-tracking-time is also one block copied from a launch event message.
(deftype control-info (collide-shape-moving)
  (;; Control-frame velocity, orientation, and animation offsets.
   (transv-ctrl                         vector :inline :offset 448)
   (target-transv                       vector :inline :offset 464)
   (bent-gravity-normal                 vector :inline :offset 480)
   (quat-for-control                    quaternion :inline :offset 496)
   (override-quat                       quaternion :inline :offset 512)
   (override-quat-alpha                 float :offset 528)
   (ctrl-xz-vel                         float :offset 532)
   (velocity-after-thrust               float :offset 536)
   (last-transv                         vector :inline :offset 544)
   (draw-offset                         vector :inline :offset 560)
   (cspace-offset                       vector :inline :offset 576)
   (anim-collide-offset-local           vector :inline :offset 592)
   (anim-collide-offset-world           vector :inline :offset 608)
   (old-anim-collide-offset-world       vector :inline :offset 624)
   (anim-collide-offset-delta-world     vector :inline :offset 640)
   ;; Surface tuning and controller intent.
   (standard-dynamics                   dynamics :offset 656)
   (mod-surface                         surface :offset 660)
   (current-surface                     surface :offset 664)
   (cpad                                cpad-info :offset 668)
   (turn-to-angle                       float :offset 672)
   (last-turn-to-angle                  float :offset 676)
   (turn-to-magnitude                   float :offset 680)
   (last-turn-to-magnitude              float :offset 684)
   (to-target-pt-xz                     vector :inline :offset 688)
   (last-to-target-pt-xz                vector :inline :offset 704)
   (turn-to-target                      vector :inline :offset 720)
   (last-turn-to-target                 vector :inline :offset 736)
   (turn-history-ctrl                   vector 8 :inline :offset 752)
   (pad-xz-dir                          vector :inline :offset 880)
   (last-pad-xz-dir                     vector :inline :offset 896)
   (pad-magnitude                       float :offset 912)
   (last-pad-magnitude                  float :offset 916)
   (time-of-last-pad-read               time-frame :offset 920)
   (w-R-c                               matrix :inline :offset 928)
   (c-R-w                               matrix :inline :offset 992)
   (root-orientation                    matrix :inline :offset 1056)
   (camera-pos-qword                    uint128 :offset 1136)
   (camera-pos                          vector :inline :overlay-at camera-pos-qword)
   (camera-pos-y                        float :overlay-at (-> camera-pos y))
   ;; Scripted movement-input override.
   (force-turn-to-direction             vector :inline :offset 1152)

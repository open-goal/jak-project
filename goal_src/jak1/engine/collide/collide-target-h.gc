   (low-coverage-probe2-dist            float :offset 1352)
   (low-coverage-probe2-pat             uint32 :offset 1356)
   (low-coverage-probe1-normal          vector :inline :offset 1376)
   (low-coverage-probe2-normal          vector :inline :offset 1392)
   (low-coverage-edge-dir               vector :inline :offset 1440)
   (low-coverage-across-edge-dir        vector :inline :offset 1456)
   (low-coverage-across-edge-xz         vector :inline :offset 1472)
   ;; Blocked motion, wall/actor contacts, and active collide prims.
   (btransv                             vector :inline :offset 1504)
   (blocked-factor                      float :offset 1520)
   (blocked-in-air-factor               float :offset 1524)
   (wall-contact-pt                     vector :inline :offset 1536)
   (wall-contact-poly-normal            vector :inline :offset 1552)

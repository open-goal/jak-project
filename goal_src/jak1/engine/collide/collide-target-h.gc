   (last-time-on-ground                 time-frame :offset 1280)
   (last-time-on-surface                time-frame :offset 1288)
   (ground-local-norm-dot-grav          float :offset 1300)
   (local-slope-z                       float :offset 1304)
   (local-slope-x                       float :offset 1308)
   (surface-slope-z                     float :offset 1312)
   (surface-slope-x                     float :offset 1316)
   (last-time-touching-actor            time-frame :offset 1320)

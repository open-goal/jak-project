   (ctrl-to-head-offset                 vector :inline :offset 1744)
   (hand-cspaces                        cspace :inline :offset 1760)
   (midpoint-of-hands                   vector :inline :offset 1776)
   (ctrl-to-hands-offset                vector :inline :offset 1792)
   (sidekick-root                       cspace :inline :offset 1808)
   (sidekick-root-pos                   vector :inline :offset 1824)
   (collide-mode                        symbol :offset 1840)
   (collide-mode-transition             float :offset 1844)
   (duck-tube-transition                float :offset 1848)
   (transv-history                      vector 16 :inline :offset 1856)
   (average-xz-vel                      float :offset 2112)
   (idx-of-fastest-xz-vel               int32 :offset 2116)
   (hand-to-edge-dist                   float :offset 2120)
   (edge-grab-edge-dir                  vector :inline :offset 2128)
   (edge-grab-across-edge-dir           vector :inline :offset 2144)
   (last-successful-compute-edge-time   time-frame :offset 2160)
   (edge-grab-start-time                time-frame :offset 2168)
   (swingpole-handle                    handle :offset 2176)
   (state-var0                          uint32 :offset 2184)
   (state-spool-anim                    spool-anim :overlay-at state-var0)
   (state-var0-int                      int32 :overlay-at state-spool-anim)
   (state-var0-symbol                   symbol :overlay-at state-var0-int)
   (state-var0-float                    float :overlay-at state-var0-symbol)
   (state-var1-int                      int32 :offset 2188)
   (did-move-to-pole-or-max-jump-height int32 :overlay-at state-var1-int)
   (state-var1                          uint32 :overlay-at did-move-to-pole-or-max-jump-height)
   (state-var1-float                    float :overlay-at state-var1)
   (state-var2                          uint32 :offset 2192)
   (state-var2-int                      int32 :overlay-at state-var2)
   (jump-forward-blend                  float :offset 2196)
   (var-jump-hold-time                  float :offset 2200)
   (var-jump-last-hold-time             float :offset 2204)
   (state-vector0                       vector :inline :offset 2224)
   (state-vector1                       vector :inline :offset 2240)
   (mount-start-quat                    quaternion :inline :offset 2256)
   (mount-end-quat                      quaternion :inline :offset 2272)
   (fishing-smush                       smush-control :inline :offset 2288)
   (last-trans-leaving-surf             vector :inline :offset 2320)
   (highest-jump-mark                   vector :inline :offset 2336)
   (danger-mode                         symbol :offset 2384)
   (target-attack-id                    int64 :offset 2392)
   (attack-count                        int64 :offset 2400)
   (saved-launch-event                  pointer :offset 2416)
   (jump-kind                           symbol :offset 2428)
   (launch-height                       int64 :offset 2432)
   (launch-camera-state                 int64 :offset 2440)
   (launch-dest                         int64 :offset 2448)
   (launch-tracking-time                int64 :offset 2456)
   (history-data-idx                    int16 :offset 2488)
   (history-length                      int16 :offset 2490)
   (history-data                        collide-history 128 :inline)
   (remaining-ctrl-iterations           int32 :offset 18880)
   (invulnerable-start-time             time-frame :offset 18888)
   (invulnerable-duration               time-frame :offset 18896)
   (swim-tilt-angle                     float :offset 18904)
   (swim-draw-offset-y                  float :offset 18908)
   (last-fire-time                      time-frame :offset 18912)
   (align-xz-vel                        vector :inline :offset 18928)
   (zx-vel-frac                         float :offset 18944)
   (time-of-last-clear-wall-in-jump     time-frame :offset 18952)
   (wall-contact-normal                 vector :inline :offset 18960)
   (wall-pat                            pat-surface :offset 18976)
   (ice-loop-sound-id                   sound-id :offset 18980)
   (ice-loop-volume                     float :offset 18984)
   (launch-sound-id                     sound-id :offset 18988)
   (unknown-int34                       int32 :offset 18992)
   (unknown-int35                       int32 :offset 18996)
   (unknown-int36                       int32 :offset 19000)))

(defmethod update! ((this collide-history) (shape collide-shape-moving) (intersect vector) (incoming-velocity vector) (outgoing-velocity vector))
  "Record a collision-history sample."
  (vector-copy! (-> this intersect) intersect)
  (vector-copy! (-> this transv) incoming-velocity)
  (vector-copy! (-> this transv-out) outgoing-velocity)
  (vector-copy! (-> this trans) (-> shape trans))
  (vector-copy! (-> this local-normal) (-> shape local-normal))
  (vector-copy! (-> this surface-normal) (-> shape surface-normal))
  (set-time! (-> this time))
  (set! (-> this status) (-> shape status))
  (set! (-> this reaction-flag) (-> shape reaction-flag))
  (set! (-> this pat) (-> shape cur-pat))
  this)

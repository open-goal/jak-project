          (.mov.vf vf19 vf14)
          (.mov.vf.yzw vf17 vf0)
          (.svf (&-> cwork collide-box4w max quad) vf16)
          (.mov.vf.xzw vf18 vf0)
          (.mov.vf.xyw vf19 vf0)
          (.add.x.vf.y vf17 vf17 vf13)
          (.add.y.vf.x vf18 vf18 vf12)
          (.add.z.vf.x vf19 vf19 vf12)

            (.ftoi.vf vf4 vf2)
            (nop!)
            (.ftoi.vf vf5 vf3)
            (nop!)
            (.mov a1-1 vf4)
            (nop!)
            (.mov v1-2 vf5)
            (nop!)
            (.pcgtw a1-2 a1-1 s2-0)
            (.pcgtw v1-3 s3-0 v1-2)
            (.por v1-4 a1-2 v1-3)
            (.ppach v1-5 zero v1-4)
            (let ((v1-6 (shl (the-as int v1-5) 16))) (nop!) (b! (nonzero? v1-6) cfg-1 :delay (nop!)))
            (add-fg-prim-using-box a0-1 cache)
            (b! (nonzero? s4-0) cfg-2 :delay (set! a0-1 s1-0))))))
    (label cfg-5)
    0
    (none)))

;;;;;;;;;;;;;;;;;;;;;;;;;
;; Foreground Y PROBE

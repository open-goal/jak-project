;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "kernel-defs.gc")

;; DECOMP BEGINS

;; Scratchpad workspace for visibility data decompression. The two 2 KiB byte buffers are followed
;; by two 2048-entry 16-bit index arrays, filling 12 KiB of the scratchpad.
(deftype decomp-work (structure)
  ((buffer0      uint8 2048)
   (buffer1      uint8 2048)
   (indices      uint16 2048)
   (temp-indices uint16 2048)))

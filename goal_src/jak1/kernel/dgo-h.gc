;;-*-Lisp-*-
(in-package goal)
(bundles "KERNEL.CGO")
(require "kernel-defs.gc")

#|@file
Legacy EE-side DGO layout definitions. Runtime DGO loading is handled by the IOP; these types
describe an older table format and are not used by the shipped loader.
|#

;; DECOMP BEGINS

(deftype dgo-entry (structure)
  ((offset uint32)
   (length uint32)))

(deftype dgo-file (basic)
  ((num-go-files uint32)
   (total-length uint32)
   (rsvd         uint32)
   (data         uint8 :dynamic)))

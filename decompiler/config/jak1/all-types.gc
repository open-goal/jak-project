(define-extern mistycannon-prebind-function
  "Write the cannon yaw and pitch into the main and muzzle joint quaternions before skeleton
   binding. Accumulate wheel rotation from the yaw change and write the four wheel quaternions."
  (function pointer int mistycannon none))
(define-extern mistycannon-postbind-function
  "After skeleton binding, copy the muzzle joint's world position into launch-origin and transform
   the camera's local eyepoint from the cannon's main joint into goggles."
  (function mistycannon none))
(define-extern angle-tracker-init-range!
  "Initialize a tracker with wrapped 16-bit angular bounds min-angle and max-angle, place its
   current value halfway through that range, and set its frame-scaled angular speed."
  (function angle-tracker float float float none))
(define-extern mistycannon-pick-random-target-point
  "Choose a uniformly distributed point in the horizontal target disk stored in center-point, and
   choose a random target pitch between 15 and 70 degrees."
  (function none :behavior mistycannon))
(define-extern angle-tracker-seek!
  "Move the tracker toward target-angle by at most speed times seconds-per-frame, using the shortest
   signed difference in 16-bit angle space. Return true only when the target is reached without
   crossing a bounded tracker's endpoint."
  (function angle-tracker float symbol))
(define-extern mistycannon-do-aim
  "Lead target-position by target-velocity using the current estimated flight time, add the
   configured horizontal accuracy error, and seek the cannon toward the resulting yaw and ballistic
   pitch. Fire at most once every three seconds when aimed; use a fixed fallback shot when no
   positive flight time can be found. Do nothing until postbinding is ready or while the target is
   too close to avoid-entity."
  (function vector vector none :behavior mistycannon)) ;; can return a #f is postbindinfo-ok is false
(define-extern mistycannon-find-trajectory
  "Clear the trajectory time, then solve speed and flight time for the trajectory's current theta."
  (function trajectory-params none :behavior mistycannon))
(define-extern solve-missile-velocity
  "For horizontal distance x, vertical displacement y, positive gravity magnitude, and launch
   angle theta, solve time^2 = (x * tan(theta) - y) / (gravity / 2). When the time is real and
   positive, store its square root and the required launch speed; otherwise leave time and speed
   unchanged."
  (function trajectory-params float none))
(define-extern spawn-mistycannon-missile
  "Package position, velocity, yaw, expected flight time, muzzle-growth time, and blast radius,
   then spawn a cannon missile under parent on behalf of source-entity."
  (function process-tree vector vector float float float float entity none))
(define-extern angle-tracker-apply-move!
  "Advance a tracker's relative angle by input times speed times seconds-per-frame. Clamp bounded
   trackers and wrap unbounded trackers in 16-bit angle space; return old value minus new value."
  (function angle-tracker float float))
(define-extern mistycannon-missile-init-by-other
  "Create the missile's moving spherical collision, copy its launch transform and velocity, derive
   its per-frame tumble from the expected flight time, initialize art and fuse/explosion particles,
   read the water height, and enter the airborne state."
  (function mistycannon-init-data entity-actor none :behavior mistycannon-missile))
(define-extern mistycannon-collision-reaction
  "Move through the collision's accepted fraction, reflect velocity about the hit triangle normal,
   damp the result to 15 percent, and report the contact status bits used to end the airborne loop."
  (function collide-shape-moving collide-shape-intersect vector vector collide-status))
(define-extern angle-tracker-get-value
  "Return the tracker's absolute angle, wrapping min plus its relative value to signed 16-bit angle
   space."
  (function angle-tracker float))
(define-extern angle-tracker-set-value
  "Set an absolute angle by subtracting the tracker's minimum and clamping the relative value when
   bounded. Return min plus the stored relative value."
  (function angle-tracker float float))
(define-extern solve-missile-tilt
  "Solve the two ballistic launch angles for launch speed, horizontal distance, vertical
   displacement, and positive gravity magnitude. The quadratic is expressed in tan(theta); return
   false when its discriminant is negative, otherwise store both angles and return true."
  (function quadratic-solution float float float float symbol))
(define-extern mistycannon-find-best-solution
  "Return the index of a ballistic angle within the cannon's tilt range, preferring the lower valid
   angle when both solutions fit; return -1 when neither fits."
  (function quadratic-solution int :behavior mistycannon))


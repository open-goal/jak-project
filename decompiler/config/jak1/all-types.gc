   )
  :method-count-assert 9
  :size-assert         #x80
  :flag-assert         #x900000080
  )

;; - Functions

(define-extern map-bsp-tree
  "Walk the BSP below node. Positive child values are pointers to another node; for each
   nonpositive child, call visit on the node that owns that terminal side. A node with two
   terminal children is therefore visited twice."
  (function (function bsp-node none) bsp-header bsp-node none)
  )
(define-extern inspect-bsp-tree
  "Recursively print the BSP below node, indenting each level. Positive child values are followed
   as node pointers; nonpositive children print a terminal divider."
  (function bsp-header bsp-node none)
  )



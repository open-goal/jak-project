  )

;; Per-effect features. Translucent geometry is moved to the final effect slot during login and its
;; bit is copied into the working header's use-translucent byte before drawing.
(defenum effect-bits
  :type uint8
  :bitfield #t
  (texscroll 0)
  (translucent 1)
  (ripple 2)
  (effect-bit3 3)
  (effect-bit4 4)
  (effect-bit5 5)
  (effect-bit6 6)
  (effect-bit7 7)
  )

(deftype merc-effect (structure)
  ((frag-geo         merc-fragment          :offset-assert 0) ;; ?

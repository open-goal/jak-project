  (function float :behavior flying-lurker))
(define-extern flying-lurker-calc-speed
  "Adjust flight speed from race pace, rank, the player's position, and the supplied minimum and
   maximum speeds. The two distance arguments are retained by the interface but unused here."
  (function meters meters meters meters none :behavior flying-lurker))


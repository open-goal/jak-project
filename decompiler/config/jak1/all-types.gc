      (_type_) none) ;; 24
    (level-status "Return the status of the loaded level matching level-name, or false."
                  (_type_ symbol)
                  symbol) ;; 25
    (level-get-most-disposable "Choose a slot for a new load. Prefer inactive, loading, or merely

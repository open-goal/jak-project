   (mood              symbol    :offset-assert 36)
   (mood-func         symbol    :offset-assert 40)
   (ocean             symbol    :offset-assert 44)
   (sky               symbol    :offset-assert 48)
   (sun-fade          float     :offset-assert 52)
   (continues         pair      :offset-assert 56)

(define-extern set-tfrag-dists!
  "Fill the affine distance coefficients for the first two tfragment LOD bands. For distance d in
   [near, far], y is (far - d) / (far - near), x is half of (d - near) / (far - near), and w stores
   the far boundary."
  (function tfrag-dists none))
(define-extern start-perf-stat-collection
  "Advance the rotating renderer performance sample, clear the selected bucket, and start its
   selected counter pair. The EE uses its hardware counters; the PC records elapsed CPU-clock
   ticks."

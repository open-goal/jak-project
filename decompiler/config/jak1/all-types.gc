  ((settings shadow-settings :inline :offset-assert 16)
   )
  :method-count-assert 16
  :size-assert         #x60
  :flag-assert         #x1000000060
  (:methods
    (new "Allocate shadow controls with horizontal clipping planes, a downward projection direction, packed flags, and a fade distance." (symbol type float float float float float) _type_) ;; 0
    (clear-offset-bit "Clear the disable-draw flag." (shadow-control) int) ;; 9
    (set-offset-bit "Set the disable-draw flag." (shadow-control) int) ;; 10
    (set-top-plane-offset "Set the horizontal top clipping plane to the given Y coordinate." (shadow-control float) int) ;; 11
    (set-bottom-plane-offset "Set the horizontal bottom clipping plane to the given Y coordinate." (shadow-control float) int) ;; 12
    (unused-13 (_type_) none) ;; 13
    (update-direction-from-time-of-day
      "Copy the current time-of-day shadow direction into this control."
      (_type_) none) ;; 14
    (collide-to-find-planes
      "Probe downward from origin and place the bottom and top clipping planes at the hit height plus
       their respective offsets. Disable drawing when no background surface is found within
       cast-length."
      (_type_ vector float float float) none) ;; 15
    )
  )


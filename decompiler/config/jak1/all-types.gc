(define-extern display-frame-start
  "Initialize display frame new-frame-index for drawing field odd-even. Update timing and frame
counters, reset its DMA buffers and debug state, reserve ordered render buckets, initialize the
debug bucket, update the draw environment, and service the controllers."
  (function display int int none))
(define-extern toggle-pause
  "Read pause and debug-menu controls, transition among game, menu, pause, and progress modes, and
   update the single-frame pause lock."
  (function int))
(define-extern deactivate-progress

(define-extern dma-from-spr
  "Wait for the from-scratchpad DMA channel, then copy qwc quadwords from scratchpad-src to dst."
  (function uint pointer pointer none))
(define-extern merc-dma-chain-to-spr
  "Wait for the to-scratchpad DMA channel, then run the source chain so its payload is written at
   scratchpad-dst."

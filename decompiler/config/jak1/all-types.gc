;; - Functions

(define-extern test-xz-point-on-line-segment?
  "Return whether point is within tolerance of the finite XZ segment. Endpoint proximity is tested
   first; otherwise the perpendicular projection must lie between segment-start and segment-end."
  (function vector vector vector float symbol))
(define-extern ray-ccw-line-segment-intersection?
  "Return whether the XZ ray from origin along direction crosses the directed segment from start to
   end on its counter-clockwise side."
  (function vector vector vector vector symbol))
(define-extern choose-travel-portal-vertex
  "Choose the current portal endpoint around which the remaining route bends. Walk later portals
   until both endpoints lie on one side of the current edge's perpendicular bisector; if the route
   ends first, use the endpoint nearest target-point to choose the side."
  (function nav-mesh nav-route-portal nav-poly vector int))
(define-extern init-ray
  "Reset ray's length and termination results, and normalize its current-to-destination XZ
   direction."
  (function nav-ray symbol))
(define-extern ray-line-segment-intersection?
  "Return whether the XZ ray from origin along direction intersects the segment from start to end,
   independent of segment winding."

  (:methods
    (new "Create links for proc from the first next-actor and prev-actor references on its entity." (symbol type process) _type_) ;; 0
    (relocate :override-doc
      "Adjust the owning process pointer after its process heap moves.")
    (get-matching-actor-type-mask "Return a mask whose nth bit is set when the

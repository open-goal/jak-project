  (function symbol string entity-actor none))
(define-extern cam-layout-save-campoints-flags
  "Write nonzero campoints-flags-on and campoints-flags-off override masks, optionally printing the
   base and effective masks."
  (function symbol string entity-actor none))
(define-extern cam-layout-save-focalpull-flags
  "Write nonzero focalpull-flags-on and focalpull-flags-off override masks, optionally printing the

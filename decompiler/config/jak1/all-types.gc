;; - Types

(deftype rigid-body (structure)
  ((mass                        float              :offset-assert 0)
   (inv-mass                    float              :offset-assert 4)
   (lin-momentum-damping-factor float              :offset-assert 8)
   (ang-momentum-damping-factor float              :offset-assert 12)
   (inertial-tensor             matrix     :inline :offset-assert 16)
   (inv-inertial-tensor         matrix     :inline :offset-assert 80)
   (cm-offset-joint             vector     :inline :offset-assert 144)
   (position                    vector     :inline :offset-assert 160)
   (rotation                    quaternion :inline :offset-assert 176)
   (lin-momentum                vector     :inline :offset-assert 192)
   (ang-momentum                vector     :inline :offset-assert 208)
   (lin-velocity                vector     :inline :offset-assert 224)
   (ang-velocity                vector     :inline :offset-assert 240)
   (inv-i-world                 matrix     :inline :offset-assert 256)
   (matrix                      matrix     :inline :offset-assert 320)
   (force                       vector     :inline :offset-assert 384)
   (torque                      vector     :inline :offset-assert 400)
   (max-ang-momentum            float              :offset-assert 416)
   (max-ang-velocity            float              :offset-assert 420)
   )
  :method-count-assert 23
  :size-assert         #x1a8
  :flag-assert         #x17000001a8
  (:methods
    (set-mass-and-box-inertia!
      "Set mass and its reciprocal, then compute diagonal inertia and inverse-inertia tensors for a
       solid box with the supplied X, Y, and Z dimensions."
      (_type_ float float float float) none) ;; 9
    (integrate!
      "Advance the body by dt. Integrate accumulated force and torque into damped momenta, derive
       linear and angular velocity, advance position and rotation, normalize the rotation, and
       rebuild the transform."
      (_type_ float) none) ;; 10
    (clear-force-torque!
      "Clear the accumulated world-space force and torque for the next simulation step."
      (_type_) none) ;; 11
    (clear-momentum!
      "Clear both linear and angular momentum."
      (_type_) none) ;; 12
    (apply-force-at-point!
      "Accumulate a world-space force at a world-space point. Add the force directly and add
       (point - center-of-mass) cross force to torque."
      (_type_ vector vector) none) ;; 13
    (apply-local-force-at-local-point!
      "Transform a body-local point and force to world space, then accumulate them as a force at a
       point."
      (_type_ vector vector) none) ;; 14
    (apply-force!
      "Accumulate a world-space force at the center of mass without adding torque."
      (_type_ vector) none) ;; 15
    (apply-force-at-point-clamped!
      "Accumulate a world-space force at a point, scaling its torque contribution when the point's
       lever arm exceeds max-arm."
      (_type_ vector vector float) none) ;; 16
    (velocity-at-point
      "Write and return the world-space velocity at point: linear velocity plus angular velocity
       crossed with the offset from the center of mass."
      (_type_ vector vector) vector) ;; 17
    (get-origin-position
      "Write and return the body's render origin by subtracting the rotated center-of-mass offset
       from its center-of-mass position."
      (_type_ vector) vector) ;; 18
    (print-stats
      "Print the body's force, torque, position, rotation, momentum, and velocity."
      (_type_) none) ;; 19
    (print-force-torque
      "Print the body's accumulated force and torque."
      (_type_) none) ;; 20
    (update-matrix!
      "Rebuild the rotation matrix from the body's quaternion and update its translation with the
       render origin."
      (_type_) none) ;; 21
    (reset!
      "Reset the body from position and rotation. Clear forces and momenta, install the damping
       factors, rebuild the transform, clear velocities and world inertia, and reset angular
       limits."
      (_type_ vector quaternion float float) none) ;; 22
    )
  )


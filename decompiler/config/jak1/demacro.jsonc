    "scratchpad-object-type": [
      {"type": "terrain-context"},
      {"type": "cam-dbg-scratch"},
      {"type": "terrain-bsp"},
      {"type": "collide-puss-work"},
      {"type": "vector"},
      {"type": "vector4w"},
      {"type": "bone-memory"},
      {"type": "joint"},
      {"type": "bone"},
      {"type": "vu-lights"},
      {"type": "bone-regs"},
      {"type": "matrix"},
      {"type": "generic-tie-shadow"},
      {"type": "generic-tie-calls"},
